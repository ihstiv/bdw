# Local mirror .htaccess — Invision Community 4.7 friendly URLs
# (prod redirect ruleset preserved in .htaccess.prod-bak)

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Block requests with non-ASCII user agents (parity with prod hardening)
# (disabled locally to avoid false positives)

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?/$1 [L,NC,QSA]
</IfModule>

<IfModule mod_headers.c>
Header set X-Local-Mirror "bestdestinationwedding.local"
</IfModule>
