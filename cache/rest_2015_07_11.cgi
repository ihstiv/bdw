Posts":0,"ArchivedTopics":0,"ArchivedPosts":0,"LastPoster":{"Id":232000,"Name":"acw271011","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"IsOnline":true},"LastTopic":{"Id":79362,"Title":"Anyone Getting Married At T...","LastPostDate":1436449478},"ShowForumRules":false,"ForumRulesTitle":"","ForumRulesText":"","RedirectUrl":"","RedirectOn":false,"RedirectHits":0,"LastUnread":"","HasUnread":false,"Permissions":[{"Type":"view","IsEnabled":true},{"Type":"read","IsEnabled":true},{"Type":"reply","IsEnabled":true},{"Type":"start","IsEnabled":true},{"Type":"upload","IsEnabled":true},{"Type":"download","IsEnabled":true}],"Announcements":[],"FirstSubForum":null,"SubForums":[],"Topics":[],"Id":129,"Name":"Canadian Destination Wedding Group","IsCategory":false,"IsFollowing":false,"CanFollow":true}]}],"Pages":null,"PushNotifications":[{"Key":"notifications","Value":1,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
