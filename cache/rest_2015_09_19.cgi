{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":12263,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a818a16a0776274fe56a8b3678c2b933","RawContent":"Hi Everyone!\n \n I am just getting started with this fun wedding planning and am really needing some software help. I have been looking at a few different planning softwares out there and was curious what people from here have used!\n \n I read the I Do link, and actually have that free trial, but am having problems finding something that works best for having a destination wedding, and then having a reception back at home a couple months later.\n \n Soooo....what have YOU used? What did you like\/not like? \n \n Thanks everyone for the help....and have a GREAT day!!!\n \n Amy","Attachments":[],"Id":214854,"PostDate":1204576186,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi Everyone!<br \/> <br \/> I am just getting started with this fun wedding planning and am really needing some software help. I have been looking at a few different planning softwares out there and was curious what people from here have used!<br \/> <br \/> I read the I Do link, and actually have that free trial, but am having problems finding something that works best for having a destination wedding, and then having a reception back at home a couple months later.<br \/> <br \/> Soooo....what have YOU used? What did you like\/not like? <br \/> <br \/> Thanks everyone for the help....and have a GREAT day!!!<br \/> <br \/> Amy\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/image.lafemmebonita.com\/c\/a741121.png\">http:\/\/image.lafemmebonita.com\/c\/a741121.png<\/a><\/div><\/div>","Email":"aimless911@aol.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1204119567,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208670.gif?_r=0","PhotoWidth":75,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Aimless911","Id":208670,"Name":"Aimless911","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":12263,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7198a78e508914ffe13124e649863e33","RawContent":"i used the free ones on theknot.com and weddingchannel.com","Attachments":[],"Id":214875,"PostDate":1204576860,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                i used the free ones on theknot.com and weddingchannel.com\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"alyssa.brantley@gmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1182295860,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\