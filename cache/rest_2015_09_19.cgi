{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":10,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":751,"MovedTo":null,"MovedOn":0,"FirstPostId":1896336,"Rating":0,"RatingHits":0,"Starter":{"Id":282732,"Name":"Lau11888","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1431643447,"LastPoster":{"Id":278581,"Name":"beckys98","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":23,"Preview":{"Id":1896336,"PostDate":1431643447,"PostContent":"Hello everyone! I'm planning September 2016 wedding and have narrowed it down to these two resort...","Author":{"Signature":"","Email":"lau11888@hotmail.com","IpAddress":"71.167.187.147","GroupId":39,"GroupName":"Newbie","JoinDate":1428981301,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Lau11888","Id":282732,"Name":"Lau11888","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"166.137.252.51","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79187,"EditedBy":"<strong>Edited by Lau11888, 14 May 2015 - 02:54 PM.<\/strong>","EditDate":1431644048,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4aa726545dde0fbabd9bc8058d34faba","RawContent":"Hello everyone! I&#039;m planning September 2016 wedding and have narrowed it down to these two resorts. I&#039;ve been talking with the wedding coordinators from both places and I looks like at either place I&#039;m going to do the semi private dinner then the bonfire after.\n\n\nHas anyone explored these options? Any opinions on it? Also the house photographers from both places... Anyone have prices for them?\n\n\nSome of the packages have things in them I&#039;m\n\nNot interested in. For example I think I&#039;m going to bring a bouquet. Anyone have an answer to the resorts flexibility on that? Will they give you a credit or something?","Attachments":[],"Id":1896336,"PostDate":1431643447,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hello everyone! I'm planning September 2016 wedding and have narrowed it down to these two resorts. I've been talking with the wedding coordinators from both places and I looks like at either place I'm going to do the semi private dinner then the bonfire after.<br><br>\nHas anyone explored these options? Any opinions on it? Also the house photographers from both places... Anyone have prices for them?<br><br>\nSome of the packages have things in them I'm<br>\nNot interested in. For example I think I'm going to bring a bouquet. Anyone have an answer to the resorts flexibility on that? Will they give you a credit or something?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lau11888@hotmail.com","IpAddress":"71.167.187.147","GroupId":39,"GroupName":"Newbie","JoinDate":1428981301,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Lau11888","Id":282732,"Name":"Lau11888","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.138.34.236","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79187,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"602f80b367a5983b6c9f0134381a5167","RawContent":"I got married at the Riu Montego Bay Jamaica last week Wednesday and it was fabulous! Once I get home I will be posting a review on my wedding thread [emoji4] I&#039;m at the Iberostar grand rose hall (not the beach)atm for our honeymoon and I&#039;d say the Rose hall beach isn&#039;t as nice. Now the grand is fantastic lol but pricey! I&#039;ve seen the beach version though and I&#039;m happy I chose the Riu myself!! \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1896340,"PostDate":1431647208,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I got married at the Riu Montego Bay Jamaica last week Wednesday and it was fabulous! Once I get home I will be posting a review on my wedding thread [emoji4] I'm at the Iberostar grand rose hall (not the beach)atm for our honeymoon and I'd say the Rose hall beach isn't as nice. Now the grand is fantastic lol but pricey! I've seen the beach version though and I'm happy I chose the Riu myself!! <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"izabella.david@gmail.com","IpAddress":"99.237.26.51","GroupId":40,"GroupName":"Jr. Member","JoinDate":1426465978,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282430.jpg?_r=1434377756","PhotoWidth":200,"PhotoHeight":287,"PhotoType":"custom"},"FormattedName":"IzzyDeee","Id":282430,"Name":"IzzyDeee","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.161.72.56","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79187,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e72269f962639580d482f7524591d826","RawContent":"Welcome to the site! I think you&#039;re looking at two very popular Jamaican resorts! I was married in Jamaica almost 4 years ago but at a different resort. We loved Jamaica and fell in love with this island.\n\n\nHave you looked up the resorts at all here for the reviews? It will give you an idea of what past brides have done and what they have to say about their experience. Do you have a travel agent yet? If not I would highly recommend getting one. They will become your newe best friend as you go through your planning journey and will help field guest questions as well as provide you with I formation to give you the best experience possible.\n\n\nGood luck and happy planning!","Attachments":[],"Id":1896490,"PostDate":1431886689,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Welcome to the site! I think you're looking at two very popular Jamaican resorts! I was married in Jamaica almost 4 years ago but at a different resort. We loved Jamaica and fell in love with this island.<br><br>\nHave you looked up the resorts at all here for the reviews? It will give you an idea of what past brides have done and what they have to say about their experience. Do you have a travel agent yet? If not I would highly recommend getting one. They will become your newe best friend as you go through your planning journey and will help field guest questions as well as provide you with I formation to give you the best experience possible.<br><br>\nGood luck and happy planning!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><em><span style=\"color:rgb(51,153,255);\">I'm lucky enough to say yes again....October 20, 2015\u00a0<\/span><\/em>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283462599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.165.141.121","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79187,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"871b4e45bd949f560f7a799e64274d91","RawContent":"&lt;p&gt;We did not consider RIU Montego Bay, though I honestly cannot remember why?! We&#039;re getting married in 3 short weeks at Iberostar Rose Hall Suites. I&#039;ve seen a ton of brides who had a fabulous time at Iberostar Rose Hall Beach and have seen zero complaints about the wedding coordinators and the wedding itself. We chose the adjacent \"Suites\" over the \"Beach\" resort because it was generally just nicer. Looked like the rooms at Iberostar Rose Hall Beach are a little older and there aren&#039;t quite as many amenities there like fewer restaurants. For us, it was worth the incremental increase in cost to go with Suites, which also gives your guests full access to the Beach resort.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;The Iberostars only do 1 wedding per day, which is a little bit of a plus. Not that I need to be the only bride - it is just that I got stressed out thinking about competing with other weddings for ceremony times, reception venues and spa appointments. I&#039;m sure it&#039;s generally fine, but that would have been really bad for my anxiety. I know myself :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;If you have any questions on Iberostar Rose Hall Suites, let me know!&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1896507,"PostDate":1431906921,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>We did not consider RIU Montego Bay, though I honestly cannot remember why?! We're getting married in 3 short weeks at Iberostar Rose Hall Suites. I've seen a ton of brides who had a fabulous time at Iberostar Rose Hall Beach and have seen zero complaints about the wedding coordinators and the wedding itself. We chose the adjacent \"Suites\" over the \"Beach\" resort because it was generally just nicer. Looked like the rooms at Iberostar Rose Hall Beach are a little older and there aren't quite as many amenities there like fewer restaurants. For us, it was worth the incremental increase in cost to go with Suites, which also gives your guests full access to the Beach resort.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>The Iberostars only do 1 wedding per day, which is a little bit of a plus. Not that I need to be the only bride - it is just that I got stressed out thinking about competing with other weddings for ceremony times, reception venues and spa appointments. I'm sure it's generally fine, but that would have been really bad for my anxiety. I know myself <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>If you have any questions on Iberostar Rose Hall Suites, let me know!\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rebecca.shaffer@gmail.com","IpAddress":"159.53.174.144","GroupId":3,"GroupName":"Member","JoinDate":1403119687,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"beckys98","Id":278581,"Name":"beckys98","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.82.4.242","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79187,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"694d3ae97047f2107414b4460e5b3569","RawContent":"Just got back from our Riu Mo Bay wedding\/honeymoon Sandals Mo Bay and it was perfect. I&#039;ll be posting a review soon. No info on the photographer. We hired an outside one. But he said he doesn&#039;t do a lot of business at the Riu Mo Bay because the photographer is better than most resort ones.","Attachments":[],"Id":1896531,"PostDate":1431971267,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Just got back from our Riu Mo Bay wedding\/honeymoon Sandals Mo Bay and it was perfect. I'll be posting a review soon. No info on the photographer. We hired an outside one. But he said he doesn't do a lot of business at the Riu Mo Bay because the photographer is better than most resort ones. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Meggan.Kole@gmail.com","IpAddress":"68.82.4.242","GroupId":39,"GroupName":"Newbie","JoinDate":1385156577,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275259.jpg?_r=1421618186","PhotoWidth":200,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"Megg","Id":275259,"Name":"Megg","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"166.137.252.108","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79187,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cd919b4181cbe928111d33dfa4cd985f","RawContent":"Thanks in the input! They sent me the info for the house photographers. They seems pretty reasonable.","Attachments":[],"Id":1896555,"PostDate":1431993311,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks in the input! They sent me the info for the house photographers. They seems pretty reasonable.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lau11888@hotmail.com","IpAddress":"71.167.187.147","GroupId":39,"GroupName":"Newbie","JoinDate":1428981301,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Lau11888","Id":282732,"Name":"Lau11888","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"38.116.36.205","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79187,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9dadf2b562ca1b4947d5cf5b28cecdd4","RawContent":"&lt;p&gt;@[member=\"beckys98\"] We have decided on Iberostar Rose Hall Suites for our vow renewal in October 2016. We&#039;ve sent in the deposit (yay!) and are pretty much planning a wedding. Do you mind if I reach out to you to get answers\/details\/inspiration on how everything went?&lt;\/p&gt;","Attachments":[],"Id":1901368,"PostDate":1438113352,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"278581\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/278581-beckys98\/' title='Member profile'><span itemprop=\"name\">beckys98<\/span><\/a> We have decided on Iberostar Rose Hall Suites for our vow renewal in October 2016. We've sent in the deposit (yay!) and are pretty much planning a wedding. Do you mind if I reach out to you to get answers\/details\/inspiration on how everything went?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sjnewme@gmail.com","IpAddress":"38.116.36.205","GroupId":39,"GroupName":"Newbie","JoinDate":1434653893,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283605.jpg?_r=1435663320","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"SJ10YearVowRenewal","Id":283605,"Name":"SJ10YearVowRenewal","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"159.53.174.144","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79187,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"26b90633b6a51fdeffd1cfe28a7dca47","RawContent":"Of course! Happy to help! I&#039;m still planning to put a thread on here with all my details to help future brides, I just haven&#039;t been able to get to it. But I&#039;ll answer any questions you have!\n\nCongratulations!\n\n[quote name=\"SJ10YearVowRenewal\" post=\"1901368\" timestamp=\"1438109752\"]\n@[member=\"beckys98\"] We have decided on Iberostar Rose Hall Suites for our vow renewal in October 2016. We&#039;ve sent in the deposit (yay!) and are pretty much planning a wedding. Do you mind if I reach out to you to get answers\/details\/inspiration on how everything went?[\/quote]","Attachments":[],"Id":1901519,"PostDate":1438207024,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Of course! Happy to help! I'm still planning to put a thread on here with all my details to help future brides, I just haven't been able to get to it. But I'll answer any questions you have!<\/p>\n<p>\u00a0<\/p>\n<p>Congratulations!<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>SJ10YearVowRenewal, on 28 July 2015 - 11:55 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"278581\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/278581-beckys98\/' title='Member profile'><span itemprop=\"name\">beckys98<\/span><\/a> We have decided on Iberostar Rose Hall Suites for our vow renewal in October 2016. We've sent in the deposit (yay!) and are pretty much planning a wedding. Do you mind if I reach out to you to get answers\/details\/inspiration on how everything went?<\/p>\n<\/div>\n<\/div><\/div>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rebecca.shaffer@gmail.com","IpAddress":"159.53.174.144","GroupId":3,"GroupName":"Member","JoinDate":1403119687,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"beckys98","Id":278581,"Name":"beckys98","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.87.3.126","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79187,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4cbb3fabda817532f345d63681c9c7df","RawContent":"[quote name=\"beckys98\" post=\"1901519\" timestamp=\"1438203424\"]\nOf course! Happy to help! I&#039;m still planning to put a thread on here with all my details to help future brides, I just haven&#039;t been able to get to it. But I&#039;ll answer any questions you have!\n\nCongratulations![\/quote]@[member=\"beckys98\"] thank you for the advice! Did  you end up having a private or semi-private reception? Did u use digipix for photos? I really want to use another company.  \n\nSent from my SM-G920P using Tapatalk","Attachments":[],"Id":1901532,"PostDate":1438214038,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>beckys98, on 29 July 2015 - 01:57 PM, said:<\/p><div class='blockquote'><div class='quote'><p>Of course! Happy to help! I'm still planning to put a thread on here with all my details to help future brides, I just haven't been able to get to it. But I'll answer any questions you have!<br><br>\nCongratulations!<\/p><\/div><\/div>\n@<a hovercard-ref=\"member\" hovercard-id=\"278581\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/278581-beckys98\/' title='Member profile'><span itemprop=\"name\">beckys98<\/span><\/a> thank you for the advice! Did  you end up having a private or semi-private reception? Did u use digipix for photos? I really want to use another company.  <br><br>\nSent from my SM-G920P using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"srjoseph23@gmail.com","IpAddress":"66.194.233.250","GroupId":3,"GroupName":"Member","JoinDate":1438194420,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"srjoseph23","Id":284189,"Name":"srjoseph23","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"159.53.46.143","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79187,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"5a509cfe6904048ff176448894bd2903","RawContent":"&lt;p&gt;@[member=\"srjoseph23\"] We did a private reception for our 66 guests at the gourmet restaurant (\"Calabash\"). We did see several semi-private receptions while we were there - they do literally have a wedding every single day - and they did seem private enough depending on what your priorities are. We did a welcome dinner at the steakhouse, which was technically \"semi-private\" but no one was seated anywhere near us so you never would have known!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;It was just important to us to do speeches and dancing during the reception - and I wanted to be inside with air conditioning - so it was an obvious choice for us. We also did the beach bonfire as part of our welcome event.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;For photography, we hired an outside photographer, Stacey Clarke. She covered the vendor fee so no issue there. Digipics is on the resort all the time just taking pictures of guests and then you can pick them up at a kiosk. They are RIDICULOUSLY expensive and the quality was not great. We purchased one image because it was our whole group on the grand staircase in the lobby and I wanted it - but it was like $30 or something for one printed picture! We didn&#039;t even get a digital version! Such a rip off.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I attached a few of our professional photos! We only have about 15 and are still waiting for the rest!&amp;nbsp; &lt;\/p&gt;","Attachments":[],"Id":1901534,"PostDate":1438215191,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"284189\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/284189-srjoseph23\/' title='Member profile'><span itemprop=\"name\">srjoseph23<\/span><\/a> We did a private reception for our 66 guests at the gourmet restaurant (\"Calabash\"). We did see several semi-private receptions while we were there - they do literally have a wedding every single day - and they did seem private enough depending on what your priorities are. We did a welcome dinner at the steakhouse, which was technically \"semi-private\" but no one was seated anywhere near us so you never would have known!<\/p>\n<p>\u00a0<\/p>\n<p>It was just important to us to do speeches and dancing during the reception - and I wanted to be inside with air conditioning - so it was an obvious choice for us. We also did the beach bonfire as part of our welcome event.<\/p>\n<p>\u00a0<\/p>\n<p>For photography, we hired an outside photographer, Stacey Clarke. She covered the vendor fee so no issue there. Digipics is on the resort all the time just taking pictures of guests and then you can pick them up at a kiosk. They are RIDICULOUSLY expensive and the quality was not great. We purchased one image because it was our whole group on the grand staircase in the lobby and I wanted it - but it was like $30 or something for one printed picture! We didn't even get a digital version! Such a rip off.<\/p>\n<p>\u00a0<\/p>\n<p>I attached a few of our professional photos! We only have about 15 and are still waiting for the rest!\u00a0 <a class='resized_img' rel='lightbox[1901534]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-278581-0-11051200-1438211451.jpg\" title=\"FB_IMG_1437402207658.jpg - Size: 89.61KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-278581-0-11051200-1438211451.jpg\" class='bbc_img linked-image' alt=\"FB_IMG_1437402207658.jpg\" \/><\/a>\n\n<a class='resized_img' rel='lightbox[1901534]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-278581-0-08522000-1438211464.jpg\" title=\"FB_IMG_1437402182200.jpg - Size: 95.17KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-278581-0-08522000-1438211464.jpg\" class='bbc_img linked-image' alt=\"FB_IMG_1437402182200.jpg\" \/><\/a>\n\n<a class='resized_img' rel='lightbox[1901534]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-278581-0-55478000-1438211482.jpg\" title=\"FB_IMG_1437402232144.jpg - Size: 79.31KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-278581-0-55478000-1438211482.jpg\" class='bbc_img linked-image' alt=\"FB_IMG_1437402232144.jpg\" \/><\/a>\n\n<a class='resized_img' rel='lightbox[1901534]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-278581-0-63769400-1438211502.jpg\" title=\"FB_IMG_1437402248951.jpg - Size: 101.53KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-278581-0-63769400-1438211502.jpg\" class='bbc_img linked-image' alt=\"FB_IMG_1437402248951.jpg\" \/><\/a>\n\n<a class='resized_img' rel='lightbox[1901534]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-278581-0-09650700-1438211520.jpg\" title=\"FB_IMG_1437402259623.jpg - Size: 136.5KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-278581-0-09650700-1438211520.jpg\" class='bbc_img linked-image' alt=\"FB_IMG_1437402259623.jpg\" \/><\/a>\n\n<a class='resized_img' rel='lightbox[1901534]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-278581-0-21678700-1438211536.jpg\" title=\"FB_IMG_1437402275791.jpg - Size: 63.73KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-278581-0-21678700-1438211536.jpg\" class='bbc_img linked-image' alt=\"FB_IMG_1437402275791.jpg\" \/><\/a>\n\n<a class='resized_img' rel='lightbox[1901534]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-278581-0-30262600-1438211568.jpg\" title=\"FB_IMG_1437402212786.jpg - Size: 91.1KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-278581-0-30262600-1438211568.jpg\" class='bbc_img linked-image' alt=\"FB_IMG_1437402212786.jpg\" \/><\/a>\n\n<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rebecca.shaffer@gmail.com","IpAddress":"159.53.174.144","GroupId":3,"GroupName":"Member","JoinDate":1403119687,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"beckys98","Id":278581,"Name":"beckys98","IsOnline":false}}],"Id":"79187","Title":"Riu Montego Bay & Iberostar  Rose Hall Beach","LastPostDate":1438215191},"Pages":{"TotalItems":10,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
