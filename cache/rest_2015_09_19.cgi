> User jacquewedding (283943)
Request Time: 1 seconds
{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"199.195.246.16","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76028,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d61f7a21a463c7b1bf03a35fca44bbc0","RawContent":"&lt;p&gt;Hi ladies, just wanted to update you all with our wedding video plan -- &amp;nbsp;Since we are having a long wedding week in Ixtapa, Mexico, I decided to get the app and 5 camera package so all my out of town guests can capture pre-wedding fun stuff all over the resort, as well as the ceremony and reception.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I especially wanted it because 20 of us are going spelunking and cave exploring as a post-wedding group activity, &amp;nbsp;and I know the footage from that is going to be PRICELESS :)&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I know my wedding is on the bigger side, but I definitely recommend your check out the &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.storymixmedia.com\/weddings\/wedding-video-pricing-comparison.html&#039;&gt;different WeddingMix packages &lt;\/a&gt;because they have a variety of based on the size of your wedding.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1839615,"PostDate":1395352782,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi ladies, just wanted to update you all with our wedding video plan -- \u00a0Since we are having a long wedding week in Ixtapa, Mexico, I decided to get the app and 5 camera package so all my out of town guests can capture pre-wedding fun stuff all over the resort, as well as the ceremony and reception.<\/p>\n<p>\u00a0<\/p>\n<p>I especially wanted it because 20 of us are going spelunking and cave exploring as a post-wedding group activity, \u00a0and I know the footage from that is going to be PRICELESS <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I know my wedding is on the bigger side, but I definitely recommend your check out the <a href='http:\/\/www.storymixmedia.com\/weddings\/wedding-video-pricing-comparison.html' class='bbc_url' title='External link' rel='nofollow external'>different WeddingMix packages <\/a>because they have a variety of based on the size of your wedding.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"chawkes@luc.edu","IpAddress":"162.229.106.6","GroupId":39,"GroupName":"Newbie","JoinDate":1387196524,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"ThisYearsGirl27","Id":275644,"Name":"ThisYearsGirl27","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"63.122.89.3","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76028,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"24092c5244dbe4097eed97cd80294584","RawContent":"&lt;p&gt;I love Ixtapa! What resort are you staying at?&lt;\/p&gt;","Attachments":[],"Id":1839674,"PostDate":1395405085,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I love Ixtapa! What resort are you staying at?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"shanna0487@hotmail.com","IpAddress":"63.122.89.3","GroupId":42,"GroupName":"Sr. Member","JoinDate":1294245874,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-235127.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"shan0487","Id":235127,"Name":"shan0487","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"147.126.10.40","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76028,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"487e6cb9b5408b20744765afec3a65fc","RawContent":"&lt;p&gt;Me too!! We are staying at the Capella Ixtapa :)&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1839675,"PostDate":1395405197,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Me too!! We are staying at the Capella Ixtapa <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"chawkes@luc.edu","IpAddress":"162.229.106.6","GroupId":39,"GroupName":"Newbie","JoinDate":1387196524,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"ThisYearsGirl27","Id":275644,"Name":"ThisYearsGirl27","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"63.122.89.3","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76028,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b6ca1da6af4bee4f4b79d761a0f5070f","RawContent":"How fun! Do you like the place?  My father in law always rents a condo when we stay there so I&#039;ve never done the all- inclusive vacation in Ixtapa. [quote name=\"ThisYearsGirl27\" post=\"1839675\" timestamp=\"1395419597\"]\nMe too!! We are staying at the Capella Ixtapa :)[\/quote]","Attachments":[],"Id":1840024,"PostDate":1395653835,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>How fun! Do you like the place?\u00a0 My father in law always rents a condo when we stay there so I've never done the all- inclusive vacation in Ixtapa.\u00a0<\/p>\n<p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>ThisYearsGirl27, on 21 March 2014 - 12:33 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Me too!! We are staying at the Capella Ixtapa <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<\/div>\n<\/div><\/div>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"shanna0487@hotmail.com","IpAddress":"63.122.89.3","GroupId":42,"GroupName":"Sr. Member","JoinDate":1294245874,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-235127.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"shan0487","Id":235127,"Name":"shan0487","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"205.132.110.2","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76028,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cf034b9e0c98a7cbaa918b31c8e249ed","RawContent":"&lt;p&gt;I agree that a wedding video is super important!!! We originally decided to have a family member record the ceremony, but after much consideration we decided to get a professional to do it... We just thought it was too great a memory to have a amateur video completed. &amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;In my opinion it is worth the splurge IF you can afford it!!! We were willing to make cutbacks as necessary to fit it in our wedding budget!!&lt;\/p&gt;","Attachments":[],"Id":1841473,"PostDate":1396265101,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I agree that a wedding video is super important!!! We originally decided to have a family member record the ceremony, but after much consideration we decided to get a professional to do it... We just thought it was too great a memory to have a amateur video completed. \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>In my opinion it is worth the splurge IF you can afford it!!! We were willing to make cutbacks as necessary to fit it in our wedding budget!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bambiderby@gmail.com","IpAddress":"205.132.110.2","GroupId":40,"GroupName":"Jr. Member","JoinDate":1395161860,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277216.jpg?_r=1395766815","PhotoWidth":200,"PhotoHeight":218,"PhotoType":"custom"},"FormattedName":"forevertogether","Id":277216,"Name":"forevertogether","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.192.65.98","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76028,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"460315dcd2398e9b0ebf965d842634a4","RawContent":"Mine is included with the package. We will be using an outside photographer and just let the resort do the video bc if it wasn&#039;t included I wouldn&#039;t bother with it....but I&#039;ll admit I kinda like the idea of having it","Attachments":[],"Id":1853669,"PostDate":1401819216,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Mine is included with the package. We will be using an outside photographer and just let the resort do the video bc if it wasn't included I wouldn't bother with it....but I'll admit I kinda like the idea of having it\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Jamie","Email":"lovinmylilone@yahoo.com","IpAddress":"70.192.94.81","GroupId":40,"GroupName":"Jr. Member","JoinDate":1400757982,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Nybride525","Id":278074,"Name":"Nybride525","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"184.147.34.19","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76028,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2da29773ce4fe5cc96d6dc9c44b28c83","RawContent":"&lt;p&gt;Still debating on the cost for one. Was thinking about having someone from our group record the events to save $&lt;\/p&gt;","Attachments":[],"Id":1853757,"PostDate":1401850328,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Still debating on the cost for one. Was thinking about having someone from our group record the events to save $<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"hot_choclate68@hotmail.com","IpAddress":"99.239.188.162","GroupId":40,"GroupName":"Jr. Member","JoinDate":1390958270,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"keezy","Id":276385,"Name":"keezy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"89.100.218.185","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76028,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"98511bd365775c3f96e5140265ce39df","RawContent":"We decided not to have a video, its a big cost, for something we&#039;ll probably only watch a few times... I&#039;m more of a photo person,  I hate seeing and hearing myself played back on video!!!","Attachments":[],"Id":1853814,"PostDate":1401884050,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We decided not to have a video, its a big cost, for something we'll probably only watch a few times... I'm more of a photo person,  I hate seeing and hearing myself played back on video!!! \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"prendest@tcd.ie","IpAddress":"89.100.218.185","GroupId":40,"GroupName":"Jr. Member","JoinDate":1382542889,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-274502.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"stefadile","Id":274502,"Name":"stefadile","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.155.94.124","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76028,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"60f62a240244684c075334ac1c019f21","RawContent":"&lt;p&gt;We originally thought the video was the least important part of the wedding. Then I found some old videos from when my brother and I were kids. These things were priceless! and that&#039;s when I realized that even though the pictures are nice, it&#039;s the videos that are so much fun to watch years down the road. I think in a way they&#039;re more special than the pictures. We decided to cut down on the pictures a bit and spend a little on a videographer :). I don&#039;t think we will regret it.&lt;\/p&gt;","Attachments":[],"Id":1854225,"PostDate":1402101161,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>We originally thought the video was the least important part of the wedding. Then I found some old videos from when my brother and I were kids. These things were priceless! and that's when I realized that even though the pictures are nice, it's the videos that are so much fun to watch years down the road. I think in a way they're more special than the pictures. We decided to cut down on the pictures a bit and spend a little on a videographer <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>. I don't think we will regret it.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<br><p><a data-ipb='nomediaparse' href='http:\/\/www.TickerFactory.com\/'><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;31;484\/st\/20150813\/e\/Wedding+time%21+\/dt\/-2\/k\/b92c\/event.png\" alt=\"event.png\"><\/a><\/p>\n<p style=\"text-align:center;\">\u00a0<\/p>\n<p style=\"text-align:center;\">\u00a0","Email":"sblopezb@gmail.com","IpAddress":"172.219.193.22","GroupId":42,"GroupName":"Sr. Member","JoinDate":1359748704,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265511.jpg?_r=1440029562","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"TinkerSofi","Id":265511,"Name":"TinkerSofi","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"76.253.50.168","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76028,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"aa725227ed8e79c0ce79d34b9374a9f2","RawContent":"&lt;p&gt;I think u should because my is going to be out of state so I want my family back home to see it&lt;\/p&gt;","Attachments":[],"Id":1865828,"PostDate":1407852336,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I think u should because my is going to be out of state so I want my family back home to see it<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cankem80@yahoo.com","IpAddress":"76.253.50.168","GroupId":40,"GroupName":"Jr. Member","JoinDate":1407523557,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279372.png?_r=1436816059","PhotoWidth":200,"PhotoHeight":209,"PhotoType":"custom"},"FormattedName":"cankem80","Id":279372,"Name":"cankem80","IsOnline":false}}],"Pages":{"TotalItems":40,"TotalPages":4,"CurrentPage":20,"NextPage":30,"PreviousPage":10,"LastPage":30},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
