{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":5,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":492,"MovedTo":null,"MovedOn":0,"FirstPostId":1895544,"Rating":0,"RatingHits":0,"Starter":{"Id":282892,"Name":"FutureMrsVanthof","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282892.jpg?_r=1434622094","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"StartDate":1430940743,"LastPoster":{"Id":284045,"Name":"Hydewedding","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":23,"Preview":{"Id":1895544,"PostDate":1430940743,"PostContent":"HI! Im thinking of getting married in Grand Bahia Principe Jamaica next March (2016) but cant fin...","Author":{"Signature":"","Email":"ton_03@hotmail.com","IpAddress":"142.67.2.225","GroupId":39,"GroupName":"Newbie","JoinDate":1430234976,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282892.jpg?_r=1434622094","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"FutureMrsVanthof","Id":282892,"Name":"FutureMrsVanthof","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"142.67.2.225","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79155,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"016d6a6c70eb02be8144fc29de62217d","RawContent":"&lt;p&gt;&lt;span style=\"font-size:18px;\"&gt;HI!&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:18px;\"&gt;Im thinking of getting married in G&lt;\/span&gt;&lt;span style=\"font-size:18px;\"&gt;rand Bahia Principe Jamaica next March (2016) but cant find any reviews on here!!! Anyone have any info about this resort? From what i have read, alot of mixed reviews .. but this seems like a resort that has the best price point.... help ! &lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1895544,"PostDate":1430940743,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span  style=\"font-size:18px\">HI!<\/span><\/p>\n<p><span  style=\"font-size:18px\">Im thinking of getting married in G<\/span><span  style=\"font-size:18px\">rand Bahia Principe Jamaica next March (2016) but cant find any reviews on here!!! Anyone have any info about this resort? From what i have read, alot of mixed reviews .. but this seems like a resort that has the best price point.... help ! <\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ton_03@hotmail.com","IpAddress":"142.67.2.225","GroupId":39,"GroupName":"Newbie","JoinDate":1430234976,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282892.jpg?_r=1434622094","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"FutureMrsVanthof","Id":282892,"Name":"FutureMrsVanthof","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"38.98.248.131","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79155,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"16f977fb2a421b862fe7297923d0a513","RawContent":"[quote name=\"FutureMrsVanthof\" post=\"1895544\" timestamp=\"1430937143\"]\n[size=5]HI![\/size]\n[size=5]Im thinking of getting married in G[\/size][size=5]rand Bahia Principe Jamaica next March (2016) but cant find any reviews on here!!! Anyone have any info about this resort? From what i have read, alot of mixed reviews .. but this seems like a resort that has the best price point.... help ! [\/size][\/quote]\nCongratulations! I almost got married at Gran Bahia Principe, and they do have a REALLY good price point. It all depends on what you&#039;re looking for in your wedding. They seem to have multiple weddings in a day and since they&#039;re wedding Gazebo is the #1 pick for location, you end up having a time limit after which you need to make room for the next wedding. It&#039;s a large resort, but they try to make it as private as possible, and you get the option of having a semi-private reception afterwards. It was a bit challenging for me to work with their wedding department to get info at first, but once we spoke over the phone it was much easier.\n\nUltimately I went with Jewel Runaway Bay, which is a short drive from Gran Bahia because the beach was an important factor for us (and this one has a much better beach), the resort was smaller which for me felt like it would lead to a more intimate experience, and they allow for customizations which sounded appealing and less cookie cutter. The price point at Jewel is also really good and they offer round trip airport transfers which was a nice add-on.\n\nRunaway Bay is great in general so you can&#039;t go wrong with that! Hope this helps!","Attachments":[],"Id":1895548,"PostDate":1430942448,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>FutureMrsVanthof, on 06 May 2015 - 11:32 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p><span  style=\"font-size:18px\">HI!<\/span><\/p>\n<p><span  style=\"font-size:18px\">Im thinking of getting married in G<\/span><span  style=\"font-size:18px\">rand Bahia Principe Jamaica next March (2016) but cant find any reviews on here!!! Anyone have any info about this resort? From what i have read, alot of mixed reviews .. but this seems like a resort that has the best price point.... help ! <\/span><\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>Congratulations! I almost got married at Gran Bahia Principe, and they do have a REALLY good price point. It all depends on what you're looking for in your wedding. They seem to have multiple weddings in a day and since they're wedding Gazebo is the #1 pick for location, you end up having a time limit after which you need to make room for the next wedding. It's a large resort, but they try to make it as private as possible, and you get the option of having a semi-private reception afterwards. It was a bit challenging for me to work with their wedding department to get info at first, but once we spoke over the phone it was much easier.<\/p>\n<p>\u00a0<\/p>\n<p>Ultimately I went with Jewel Runaway Bay, which is a short drive from Gran Bahia because the beach was an important factor for us (and this one has a much better beach), the resort was smaller which for me felt like it would lead to a more intimate experience, and they allow for customizations which sounded appealing and less cookie cutter. The price point at Jewel is also really good and they offer round trip airport transfers which was a nice add-on.<\/p>\n<p>\u00a0<\/p>\n<p>Runaway Bay is great in general so you can't go wrong with that! Hope this helps!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sashenie@gmail.com","IpAddress":"38.98.248.131","GroupId":39,"GroupName":"Newbie","JoinDate":1430758982,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"SashJAbride","Id":282975,"Name":"SashJAbride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.49.164.107","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79155,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"68dea4b7c05610db3c6ca73e46fb8067","RawContent":"Hiya!\n\nMy fianc\u00e9e and I are hoping to get married at Bahia Principe in Jamaica in 2016 too, we&#039;re aiming for May or June though to accommodate my sister who&#039;s still in school. My sister and her boyfriend went at the end of April and loved it, they couldn&#039;t say enough good things. \n\nHave you booked anything yet? I&#039;m worried that we haven&#039;t got anything set in stone yet. Has the resort sent you any useful info?? At this point anything would be helpful \n\nThanks and good luck","Attachments":[],"Id":1898989,"PostDate":1434924212,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hiya!<br>\nMy fianc\u00e9e and I are hoping to get married at Bahia Principe in Jamaica in 2016 too, we're aiming for May or June though to accommodate my sister who's still in school. My sister and her boyfriend went at the end of April and loved it, they couldn't say enough good things. <br>\nHave you booked anything yet? I'm worried that we haven't got anything set in stone yet. Has the resort sent you any useful info?? At this point anything would be helpful <br>\nThanks and good luck\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"stathers_k_@hotmail.com","IpAddress":"70.49.164.107","GroupId":39,"GroupName":"Newbie","JoinDate":1434921655,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"KatlynStather","Id":283630,"Name":"KatlynStather","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"100.11.189.52","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79155,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"345c5b55e622bf213e0bfee6bb70c2c5","RawContent":"&lt;p&gt;@[member=\"SashJAbride\"].....:Hi I am getting married at the Jewel Paradise Cove which is the sister resort to the Jewel Runaway Bay.&amp;nbsp; Please tell me how it has been working with the wedding planners.&amp;nbsp; I have been using the U.S. stateside planner.&amp;nbsp; Have you been contacted by the wedding planner in Jamaica yet?&amp;nbsp; Wondering how attentive they are?&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thank you,&lt;\/p&gt;\n&lt;p&gt;Letitia&lt;\/p&gt;","Attachments":[],"Id":1900710,"PostDate":1437271438,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"282975\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/282975-sashjabride\/' title='Member profile'><span itemprop=\"name\">SashJAbride<\/span><\/a>.....:Hi I am getting married at the Jewel Paradise Cove which is the sister resort to the Jewel Runaway Bay.\u00a0 Please tell me how it has been working with the wedding planners.\u00a0 I have been using the U.S. stateside planner.\u00a0 Have you been contacted by the wedding planner in Jamaica yet?\u00a0 Wondering how attentive they are?\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Thank you,<\/p>\n<p>Letitia<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"letitia_leaks@verizon.net","IpAddress":"63.119.183.254","GroupId":40,"GroupName":"Jr. Member","JoinDate":1397070122,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277534.jpg?_r=1397086760","PhotoWidth":160,"PhotoHeight":160,"PhotoType":"custom"},"FormattedName":"FutureMrsGlover","Id":277534,"Name":"FutureMrsGlover","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.247.243.11","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79155,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1979528653c026514b359f88742fd4ab","RawContent":"&lt;p&gt;I have also been looking into Grand Bahia in Jamaica, but not until 2017. They told me to book my wedding date by December 2015, but the price list will not be out until 2016. I would love to know what others thought of this resort!&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1900788,"PostDate":1437423638,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I have also been looking into Grand Bahia in Jamaica, but not until 2017. They told me to book my wedding date by December 2015, but the price list will not be out until 2016. I would love to know what others thought of this resort!\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"brittnoel448@gmail.com","IpAddress":"99.247.243.11","GroupId":3,"GroupName":"Member","JoinDate":1437422692,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Hydewedding","Id":284045,"Name":"Hydewedding","IsOnline":false}}],"Id":"79155","Title":"Any Grand Bahia Principe Jamaica Brides!?!","LastPostDate":1437423638},"Pages":{"TotalItems":5,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
