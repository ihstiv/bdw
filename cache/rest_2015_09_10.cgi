right.netdna-cdn.com\/cdn\/c\/cb\/cb051bff_user-6060-avatar?_r=0","PhotoWidth":180,"PhotoHeight":120,"PhotoType":"custom"},"FormattedName":"HaleGrifa","Id":209898,"Name":"HaleGrifa","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":24375,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ca71fe52cdbedafd6462d4b363af9120","RawContent":"Okay, my stupid computer is acting up so I can&#039;t quote anything right now but i&#039;ll try to answer everything. Lilpaisley is taking some of the stuff. \n JLwhite, I just PM&#039;d you to see what you are interested in. \n Latinalocany, I will let you know what is available after I hear from JLwhite.\n Vtello, they are right now but i am waiting to hear from JLwhite. \n Minde, the lanterns are gone. Sorry.\n HaleGrifa, I don&#039;t know why I hate the dress so much. It&#039;s actually really pretty... just not &#039;me&#039;. Y&#039;know? Anyway, I bought it for $150 and would love to get that but I&#039;d settle for less just to get rid of it... I don&#039;t have a clue how much shipping would be. It&#039;s not very heavy so it can&#039;t be THAT bad, right?!","Attachments":[],"Id":468017,"PostDate":1222819378,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Okay, my stupid computer is acting up so I can't quote anything right now but i'll try to answer everything. Lilpaisley is taking some of the stuff. <br \/> JLwhite, I just PM'd you to see what you are interested in. <br \/> Latinalocany, I will let you know what is available after I hear from JLwhite.<br \/> Vtello, they are right now but i am waiting to hear from JLwhite. <br \/> Minde, the lanterns are gone. Sorry.<br \/> HaleGrifa, I don't know why I hate the dress so much. It's actually really pretty... just not 'me'. Y'know? Anyway, I bought it for $150 and would love to get that but I'd settle for less just to get rid of it... I don't have a clue how much shipping would be. It's not very heavy so it can't be THAT bad, right?!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10730;103\/st\/20080831\/e\/Our+Wedding\/k\/ebb5\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...ebb5\/event.png<\/a><\/div><\/div>","Email":"dmdrapala@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1201548713,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208393.gif?_r=0","PhotoWidth":200,"PhotoHeight":166,"PhotoType":"custom"},"FormattedName":"dmarie17","Id":208393,"Name":"dmarie17","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":24375,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6feac646272410463bbc60625c9cae51","RawContent":"Hey if there&#039;s ANYTHING left, please PM me with the list. I&#039;d take just about anything!! Haha!!","Attachments":[],"Id":468307,"PostDate":1222841133,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n          