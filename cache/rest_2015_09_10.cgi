{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":8,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":346,"MovedTo":null,"MovedOn":0,"FirstPostId":1904000,"Rating":0,"RatingHits":0,"Starter":{"Id":284651,"Name":"aculmer","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284651.jpg?_r=1441208463","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"StartDate":1441194767,"LastPoster":{"Id":258213,"Name":"LasCaletas","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-258213.jpeg?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1904426,"PostDate":1441816280,"PostContent":"Dear Andrea, Congratulations on your engagement!\u00a0 We see that you are interested in having a beac...","Author":{"Signature":"","Email":"dennise@adventureweddingsvallarta.com","IpAddress":"187.146.166.254","GroupId":49,"GroupName":"Insiders","JoinDate":1343044403,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-258213.jpeg?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"LasCaletas","Id":258213,"Name":"LasCaletas","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.212.64.125","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79562,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"c43969bdddf17c02fb2279b80e266276","RawContent":"&lt;p&gt;Hey all!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;My name is Andrea and I just happened upon this website this morning. My fiance and I have enjoyed being engaged and are now ready to start the planning process and are beginning to look into a destination wedding. I&#039;m sure that I&#039;ll have lots of questions for you all and can&#039;t wait for your advice and tips for planning the ultimate destination wedding!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1904000,"PostDate":1441194767,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hey all!<\/p>\n<p>\u00a0<\/p>\n<p>My name is Andrea and I just happened upon this website this morning. My fiance and I have enjoyed being engaged and are now ready to start the planning process and are beginning to look into a destination wedding. I'm sure that I'll have lots of questions for you all and can't wait for your advice and tips for planning the ultimate destination wedding!<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"johnsonculmerwedding@gmail.com","IpAddress":"173.212.64.125","GroupId":39,"GroupName":"Newbie","JoinDate":1441193853,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284651.jpg?_r=1441208463","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"aculmer","Id":284651,"Name":"aculmer","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"177.237.80.72","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79562,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ba0d767af74c7a8ee197f97c4c8c77cb","RawContent":"&lt;p&gt;Welcome to our forum community aculmer and Congrats on your dw!!! You&#039;re right about finding a lot of resources here to help you with your planning decisions, so well done on joining up :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;For some added inspiration, here are a few beach wedding moments that matter we captured in our beautiful Mayan Riviera, taken from our &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10150695320839487.414941.18683524486&amp;amp;type=3&#039;&gt;Cover Photos Album.&lt;\/a&gt;.....enjoy!!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-mia1-1.xx.fbcdn.net\/hphotos-xpt1\/t31.0-8\/11845102_10153513729759487_3729843888491343933_o.jpg\" alt=\"11845102_10153513729759487_3729843888491\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-mia1-1.xx.fbcdn.net\/hphotos-xft1\/t31.0-8\/11427375_10153408854794487_4566310682341134022_o.jpg\" alt=\"11427375_10153408854794487_4566310682341\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-mia1-1.xx.fbcdn.net\/hphotos-xap1\/t31.0-8\/10931505_10153038436459487_8294167073024966098_o.jpg\" alt=\"10931505_10153038436459487_8294167073024\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Wishing you happy research and all the best with your plans - cheers!!! team mtm :)&lt;\/p&gt;","Attachments":[],"Id":1904011,"PostDate":1441199587,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome to our forum community aculmer and Congrats on your dw!!! You're right about finding a lot of resources here to help you with your planning decisions, so well done on joining up <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>For some added inspiration, here are a few beach wedding moments that matter we captured in our beautiful Mayan Riviera, taken from our <a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10150695320839487.414941.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>Cover Photos Album.<\/a>.....enjoy!!!<\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-mia1-1.xx.fbcdn.net\/hphotos-xpt1\/t31.0-8\/11845102_10153513729759487_3729843888491343933_o.jpg\" alt=\"11845102_10153513729759487_3729843888491\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-mia1-1.xx.fbcdn.net\/hphotos-xft1\/t31.0-8\/11427375_10153408854794487_4566310682341134022_o.jpg\" alt=\"11427375_10153408854794487_4566310682341\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-mia1-1.xx.fbcdn.net\/hphotos-xap1\/t31.0-8\/10931505_10153038436459487_8294167073024966098_o.jpg\" alt=\"10931505_10153038436459487_8294167073024\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>Wishing you happy research and all the best with your plans - cheers!!! team mtm <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280196260,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"200.79.251.123","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79562,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"81acfd4de783f47ab823399dc4e6ecee","RawContent":"[quote name=\"aculmer\" post=\"1904000\" timestamp=\"1441209167\"]\nHey all!\n\nMy name is Andrea and I just happened upon this website this morning. My fiance and I have enjoyed being engaged and are now ready to start the planning process and are beginning to look into a destination wedding. I&#039;m sure that I&#039;ll have lots of questions for you all and can&#039;t wait for your advice and tips for planning the ultimate destination wedding![\/quote]@[member=\"aculmer\"] Welcome to the forum,\n\nHave you decided on which destination would fit best for you?  ask away we are here for you !\n\nHappy Planning\nJoyce","Attachments":[],"Id":1904036,"PostDate":1441211988,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>aculmer, on 02 September 2015 - 11:52 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hey all!<\/p>\n<p>\u00a0<\/p>\n<p>My name is Andrea and I just happened upon this website this morning. My fiance and I have enjoyed being engaged and are now ready to start the planning process and are beginning to look into a destination wedding. I'm sure that I'll have lots of questions for you all and can't wait for your advice and tips for planning the ultimate destination wedding!<\/p>\n<\/div>\n<\/div><\/div>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"284651\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/284651-aculmer\/' title='Member profile'><span itemprop=\"name\">aculmer<\/span><\/a> Welcome to the forum,<\/p>\n<p>\u00a0<\/p>\n<p>Have you decided on which destination would fit best for you? \u00a0ask away we are here for you !<\/p>\n<p>\u00a0<\/p>\n<p>Happy Planning<\/p>\n<p>Joyce<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Dream Weddings Riviera Maya- We pay attention to your wishes and coordinate closely with you to ensure your wedding or event is planned to perfection!<\/p>\n<p>\u00a0<\/p>\n<p><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Dream Weddings Riviera Maya<\/span><\/span><\/span><br><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">weddingsinplayadelcarmen@gmail.com<\/span><\/span><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html'>http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html<\/a><\/p>\n<p>\u00a0<\/p>\n<p><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Happy Planning!<\/span><\/span><\/span><br><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Joyce<\/span><\/span><\/span><br>\n\u00a0","Email":"weddingsinplayadelcarmen@gmail.com","IpAddress":"187.252.44.28","GroupId":49,"GroupName":"Insiders","JoinDate":1326839987,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250090.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"dreamweddings","Id":250090,"Name":"dreamweddings","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.85.127.174","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79562,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"48f3672f45b9fed00c51c7759a9511c8","RawContent":"&lt;p&gt;Welcome @[member=\"aculmer\"]! Lots of help to be found here. Read through the forums and ask lots of questions! First steps (IMO) - narrowing down a general location and a travel agent. Good luck!&lt;\/p&gt;","Attachments":[],"Id":1904084,"PostDate":1441236660,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome @<a hovercard-ref=\"member\" hovercard-id=\"284651\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/284651-aculmer\/' title='Member profile'><span itemprop=\"name\">aculmer<\/span><\/a>! Lots of help to be found here. Read through the forums and ask lots of questions! First steps (IMO) - narrowing down a general location and a travel agent. Good luck!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>- Erin<\/p>\n<p>\u00a0<\/p>\n<p>My planning thread:\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268'>http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268<\/a>","Email":"ekjzwedding@gmail.com","IpAddress":"24.85.127.174","GroupId":40,"GroupName":"Jr. Member","JoinDate":1417435045,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281283.jpg?_r=1428779369","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"vancouverpetunia","Id":281283,"Name":"vancouverpetunia","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.212.64.125","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79562,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"3ee0750434aaece041cc04c70bec0d30","RawContent":"&lt;p&gt;Thank you all :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We haven&#039;t decided on a location but have narrowed a few places out such as Cuba and Mexico. What locations would other DW brides recommend as possible locations? We&#039;re looking for a nice all-inclusive resort, but are also trying to keep the costs down for other guests.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We&#039;re open to suggestions! :)&lt;\/p&gt;","Attachments":[],"Id":1904107,"PostDate":1441272266,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thank you all <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>We haven't decided on a location but have narrowed a few places out such as Cuba and Mexico. What locations would other DW brides recommend as possible locations? We're looking for a nice all-inclusive resort, but are also trying to keep the costs down for other guests.<\/p>\n<p>\u00a0<\/p>\n<p>We're open to suggestions! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"johnsonculmerwedding@gmail.com","IpAddress":"173.212.64.125","GroupId":39,"GroupName":"Newbie","JoinDate":1441193853,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284651.jpg?_r=1441208463","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"aculmer","Id":284651,"Name":"aculmer","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"67.17.215.182","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79562,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2806275a40a6e6ec7dfaa136fd1357ff","RawContent":"[quote name=\"aculmer\" post=\"1904107\" timestamp=\"1441286666\"]\nThank you all :)\n \nWe haven&#039;t decided on a location but have narrowed a few places out such as Cuba and Mexico. What locations would other DW brides recommend as possible locations? We&#039;re looking for a nice all-inclusive resort, but are also trying to keep the costs down for other guests.\n \nWe&#039;re open to suggestions! :)[\/quote]\n\n \n\n\nWelcome @[member=\"aculmer\"] and congratulations. You will find that these forums are full of useful information to help in your planning. I discovered this site late in planning but still love to read peoples stories, ideas and help when possible. The people here are so supportive, all you need to do is ask.\n\nBoth Cuba and Mexico as wonderful places each with their unique cultural and local features. Mexico is more accessible then Cuba depending which city the wedding is held in, and where your guests are flying from. This is just one thing to consider when planning. Price is comparable. Large resorts in the Riviera Maya and Cabos will generally have higher prices. For more affordable options you can look a smaller resorts, boutique resorts, locations such as Tulum, Puerto Escondido, Hautulco or Zihuatanejo just to name a few.\n\nHope to help out,\n\nLove Emma\n\n\n\n :)","Attachments":[],"Id":1904129,"PostDate":1441284528,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>aculmer, on 03 September 2015 - 09:24 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<p>Thank you all <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br>\n\u00a0<br>\nWe haven't decided on a location but have narrowed a few places out such as Cuba and Mexico. What locations would other DW brides recommend as possible locations? We're looking for a nice all-inclusive resort, but are also trying to keep the costs down for other guests.<br>\n\u00a0<br>\nWe're open to suggestions! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<\/div><\/div>\n<br><br><p>\u00a0<br><br><br>\nWelcome @<a hovercard-ref=\"member\" hovercard-id=\"284651\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/284651-aculmer\/' title='Member profile'><span itemprop=\"name\">aculmer<\/span><\/a> and congratulations. You will find that these forums are full of useful information to help in your planning. I discovered this site late in planning but still love to read peoples stories, ideas and help when possible. The people here are so supportive, all you need to do is ask.<br><br>\nBoth Cuba and Mexico as wonderful places each with their unique cultural and local features. Mexico is more accessible then Cuba depending which city the wedding is held in, and where your guests are flying from. This is just one thing to consider when planning. Price is comparable. Large resorts in the Riviera Maya and Cabos will generally have higher prices. For more affordable options you can look a smaller resorts, boutique resorts, locations such as Tulum, Puerto Escondido, Hautulco or Zihuatanejo just to name a few.<br><br>\nHope to help out,<br><br>\nLove Emma<br><br><br><br> <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Our\u00a0perfect wedding in the Riviera Maya.<\/p>\n<p>\u00a0<\/p>\n<p>Date:\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 01\/15\/2015<\/p>\n<p>Resort:\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 Occidental Grand Xcaret - Riviera Maya, Mexico<br>\nGuests:\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 \u00a070-80<br>\nPackage:\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0Custom<\/p>\n<p>Dress:\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 David's Bridal<br>\nMinister:\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0Family Friend<\/p>\n<p>Photographer:\u00a0\u00a0 \u00a0Decordova Photography ( <a data-ipb='nomediaparse' href='http:\/\/www.decordova.ca'>www.decordova.ca<\/a> )<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"emma.palmer@rogers.com","IpAddress":"67.17.215.182","GroupId":39,"GroupName":"Newbie","JoinDate":1419930757,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"emmapalmer","Id":281523,"Name":"emmapalmer","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.87.42.110","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79562,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ab2558191e027bf6b18e02e130857a44","RawContent":"&lt;p&gt;I would highly recommend Montego Bay. Jamaica. We are getting married at Secrets St. James\/ Wild Orchid it is a little pricier but when it comes to an all inclusive I truly feel like you get what you pay for. If you think about it your food drinks hotel are all included in that price. If you go in the summer months though the prices are more reasonable. I have stayed at the Dreams\/Secrets lines several times now and can not recommend them enough. Good lucky with all of your planning!!&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1904135,"PostDate":1441295244,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I would highly recommend Montego Bay. Jamaica. We are getting married at Secrets St. James\/ Wild Orchid it is a little pricier but when it comes to an all inclusive I truly feel like you get what you pay for. If you think about it your food drinks hotel are all included in that price. If you go in the summer months though the prices are more reasonable. I have stayed at the Dreams\/Secrets lines several times now and can not recommend them enough. Good lucky with all of your planning!!\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nicolechin4@yahoo.com","IpAddress":"68.87.42.110","GroupId":39,"GroupName":"Newbie","JoinDate":1407422509,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"JamaicaNicole","Id":279353,"Name":"JamaicaNicole","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"201.116.201.71","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79562,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3c2c2504aec1420242629e7a180f68e8","RawContent":"&lt;p&gt;&lt;span style=\"font-size:12px;\"&gt;&lt;span style=\"color:#696969;\"&gt;Dear Andrea,&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:12px;\"&gt;&lt;span style=\"color:#696969;\"&gt;Congratulations on your engagement!&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:12px;\"&gt;&lt;span style=\"color:#696969;\"&gt;We see that you are interested in having a beach wedding celebration,&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;span style=\"color:rgb(105,105,105);font-size:12px;\"&gt;let us share our wedding information:&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:12px;\"&gt;&lt;span style=\"color:rgb(89,89,89);\"&gt;Las Caletas is our private beach cove in the south bay of Puerto Vallarta M\u00e9xico and is only accessible by sea, giving it the seclusion and ambiance of an island hideaway. It covers an enormous area and features several beaches, a pyramid amphitheater built into the tropical forest and mountain side, various facilities\/buildings (spa, kitchens, eating areas\/restaurants, bars, restrooms, etc.), and several hundred acres of tropical forest.&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;div&gt;&lt;span style=\"font-size:12px;\"&gt;[sharedmedia=gallery:images:81815]&lt;\/span&gt;&lt;\/div&gt;\n&lt;div&gt;&lt;span style=\"font-size:12px;\"&gt;[sharedmedia=gallery:images:81803]&lt;\/span&gt;&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;p&gt;&lt;span style=\"font-size:12px;\"&gt;&lt;span style=\"color:rgb(89,89,89);\"&gt;For more information visit: &amp;nbsp;&lt;\/span&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.vallarta-adventures.com\/%C2%A0&#039;&gt;http:\/\/www.vallarta-adventures.com\/&amp;nbsp;&lt;\/a&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:12px;\"&gt;and : &amp;nbsp;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.vallarta-adventures.com\/weddings%C2%A0&#039;&gt;http:\/\/www.vallarta-adventures.com\/weddings&amp;nbsp;&lt;\/a&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:12px;\"&gt;Have a nice day&amp;nbsp; :)&lt;\/span&gt;&lt;span style=\"font-size:12px;\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1904426,"PostDate":1441816280,"PostContent":null,"Author":{"Signature":"","Email":"dennise@adventureweddingsvallarta.com","IpAddress":"187.146.166.254","GroupId":49,"GroupName":"Insiders","JoinDate":1343044403,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-258213.jpeg?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"LasCaletas","Id":258213,"Name":"LasCaletas","IsOnline":false}}],"Id":"79562","Title":"Newbie Planning For A 2017 Wedding!","LastPostDate":1441816280},"Pages":{"TotalItems":8,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
