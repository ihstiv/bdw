{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":79,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":28812,"MovedTo":null,"MovedOn":0,"FirstPostId":1758222,"Rating":0,"RatingHits":0,"Starter":{"Id":236680,"Name":"OceanPhoto","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-236680.png?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"StartDate":1368644696,"LastPoster":{"Id":279087,"Name":"Msmimi","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":60,"Preview":{"Id":1884886,"PostDate":1422824940,"PostContent":"Great ideas!","Author":{"Signature":"","Email":"njwood000@gmail.com","IpAddress":"71.7.173.185","GroupId":40,"GroupName":"Jr. Member","JoinDate":1405810391,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Msmimi","Id":279087,"Name":"Msmimi","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"192.154.140.158","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73951,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bade68286a065b49fb9223743c64402c","RawContent":"&lt;p&gt;I love the barefoot sandals, but i&#039;m short so I want to have some type of heel. I think a wedge is the best way to go. Haven&#039;t looked for any yet, but I have the feeling it will not be an easy task to find something I like.&lt;\/p&gt;","Attachments":[],"Id":1863677,"PostDate":1406816744,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I love the barefoot sandals, but i'm short so I want to have some type of heel. I think a wedge is the best way to go. Haven't looked for any yet, but I have the feeling it will not be an easy task to find something I like.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><em><span style=\"font-family:arial, helvetica, sans-serif;\">I'm lucky I'm in love with my best friend<\/span><\/em>","Email":"lily_1202@hotmail.com","IpAddress":"24.157.233.83","GroupId":40,"GroupName":"Jr. Member","JoinDate":1406376249,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279175.jpg?_r=1406605860","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"Lilian84","Id":279175,"Name":"Lilian84","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"205.143.69.5","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73951,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5cedbc9076c7c617f47e092d3710207f","RawContent":"&lt;p&gt;Thanks for sharing!&lt;\/p&gt;","Attachments":[],"Id":1868241,"PostDate":1408713137,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thanks for sharing!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jolie.vidal@gmail.com","IpAddress":"205.143.69.5","GroupId":40,"GroupName":"Jr. Member","JoinDate":1408543857,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"BrideToBeJolie","Id":279500,"Name":"BrideToBeJolie","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.162.162.45","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73951,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cbc9c5cc4a40054a8af30f735f6020e2","RawContent":"&lt;p&gt;Those are gorgeous options&lt;\/p&gt;","Attachments":[],"Id":1880660,"PostDate":1418852440,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Those are gorgeous options<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"vsschick@gmail.com","IpAddress":"162.208.80.15","GroupId":40,"GroupName":"Jr. Member","JoinDate":1404469910,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"vsschick1234","Id":278832,"Name":"vsschick1234","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.99.18.219","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73951,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c9c7ebf630a9333dbf9b0f0de95c1af9","RawContent":"&lt;p&gt;I&#039;m doing wedges. I need height! lol.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1880747,"PostDate":1418898850,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I'm doing wedges. I need height! lol.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"robynbrooke81@gmail.com","IpAddress":"75.99.18.219","GroupId":40,"GroupName":"Jr. Member","JoinDate":1403532989,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278661.jpg?_r=1404161707","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"jeffandrobyn","Id":278661,"Name":"jeffandrobyn","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"143.58.161.6","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73951,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"66a9908cdc58bc83602e202dbdd0d371","RawContent":"&lt;p&gt;I am going barefoot on the beach (or barefoot sandals), but I got these for the cocktail hour and reception! ;)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;div&gt;[sharedmedia=gallery:images:79862]&lt;\/div&gt;","Attachments":[],"Id":1883767,"PostDate":1421948783,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I am going barefoot on the beach (or barefoot sandals), but I got these for the cocktail hour and reception! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/><\/p>\n<p>\u00a0<\/p>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/index.phpgallery\/image\/79862-5\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17950\/sml_gallery_278395_17950_4907.png' class='galattach galimageview sharedmedia_screenshot' title='5'  width='169' height='200'  alt='5' id='sml_image_view_79862' \/><\/a>\n<br \/><\/div>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jhowe114@gmail.com","IpAddress":"38.98.131.98","GroupId":40,"GroupName":"Jr. Member","JoinDate":1402411989,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278395.jpg?_r=1421871115","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"JenniferH114","Id":278395,"Name":"JenniferH114","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.72.4.186","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73951,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"42a800d567eb36c0fe4ba717916f3adf","RawContent":"[quote name=\"JenniferH114\" post=\"1883767\" timestamp=\"1421963183\"]\nI am going barefoot on the beach (or barefoot sandals), but I got these for the cocktail hour and reception! ;)\n[\/quote]Beautiful shoes! do you have a long dress? I would love to go bare foot and then have high heels for the reception but am stumped as to which length to hem my dress.","Attachments":[],"Id":1883801,"PostDate":1421969194,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>JenniferH114, on 22 January 2015 - 05:46 PM, said:<\/p><div class='blockquote'><div class='quote'><p>I am going barefoot on the beach (or barefoot sandals), but I got these for the cocktail hour and reception! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/><br><\/p><\/div><\/div>\n<br>\nBeautiful shoes! do you have a long dress? I would love to go bare foot and then have high heels for the reception but am stumped as to which length to hem my dress. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tinsisienmay@gmail.com","IpAddress":"184.71.74.195","GroupId":39,"GroupName":"Newbie","JoinDate":1413541955,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"starbx123","Id":280691,"Name":"starbx123","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"107.77.87.63","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73951,"EditedBy":"<strong>Edited by JenniferH114, 23 January 2015 - 09:35 AM.<\/strong>","EditDate":1422005759,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1487161310762afffa5f115f2c5ab2e5","RawContent":"@[member=\"starbx123\"]\n\n\nThanks! Yes, I have a long dress with a train. I based the hemming on the shoes because the ceremony is only about 15-20 minutes. Also, the dress would look silly if I hemmed it too short for the rest of the night. The shoes aren&#039;t sky high, so the dress isn&#039;t crazy-long without them on anyways. :)","Attachments":[],"Id":1883826,"PostDate":1422005719,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"280691\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/280691-starbx123\/' title='Member profile'><span itemprop=\"name\">starbx123<\/span><\/a><br><br>\nThanks! Yes, I have a long dress with a train. I based the hemming on the shoes because the ceremony is only about 15-20 minutes. Also, the dress would look silly if I hemmed it too short for the rest of the night. The shoes aren't sky high, so the dress isn't crazy-long without them on anyways. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jhowe114@gmail.com","IpAddress":"38.98.131.98","GroupId":40,"GroupName":"Jr. Member","JoinDate":1402411989,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278395.jpg?_r=1421871115","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"JenniferH114","Id":278395,"Name":"JenniferH114","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.34.236.241","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73951,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f18632d97b6667f920f170d0ca6873b8","RawContent":"&lt;p&gt;I&#039;m also wondering what to do about my dress hem! Going barefoot for my ceremony on the beach and then wearing heels for the rest of the night.. I&#039;d love to do high heels but I&#039;m scared the dress hem will be a problem.. I found shoes I like with a 2\" heel... I wonder how that will look...&lt;\/p&gt;","Attachments":[],"Id":1884595,"PostDate":1422532615,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I'm also wondering what to do about my dress hem! Going barefoot for my ceremony on the beach and then wearing heels for the rest of the night.. I'd love to do high heels but I'm scared the dress hem will be a problem.. I found shoes I like with a 2\" heel... I wonder how that will look...<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lauramthistle@gmail.com","IpAddress":"24.34.236.241","GroupId":40,"GroupName":"Jr. Member","JoinDate":1391606556,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276518.jpg?_r=1394639305","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"LauraM","Id":276518,"Name":"LauraM","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.89.236.44","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73951,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d0ea6f610ac0ac20d101b4e78442f3f5","RawContent":"&lt;p&gt;Great ideas!&lt;\/p&gt;","Attachments":[],"Id":1884886,"PostDate":1422824940,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Great ideas!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"njwood000@gmail.com","IpAddress":"71.7.173.185","GroupId":40,"GroupName":"Jr. Member","JoinDate":1405810391,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Msmimi","Id":279087,"Name":"Msmimi","IsOnline":false}}],"Id":"73951","Title":"Beach Wedding Shoes: What to look out for ...","LastPostDate":1422824940},"Pages":{"TotalItems":79,"TotalPages":8,"CurrentPage":70,"NextPage":-1,"PreviousPage":60,"LastPage":70},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
