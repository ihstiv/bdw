{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":7,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":420,"MovedTo":null,"MovedOn":0,"FirstPostId":1906163,"Rating":0,"RatingHits":0,"Starter":{"Id":279902,"Name":"RivieraBride15","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"custom"},"IsOnline":false},"StartDate":1444655807,"LastPoster":{"Id":277873,"Name":"calgarybride2015","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":60,"Preview":{"Id":1906163,"PostDate":1444655807,"PostContent":"Hi ladies,  \u00a0 Looking for some tipping advice.\u00a0 We are a very small wedding party of 7 heading to...","Author":{"Signature":"<p>My Planning Thread:<\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79575-rivierabrides-planning-thread-102715\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79575-rivierabrides-planning-thread-102715\/<\/a>","Email":"erind285@gmail.com","IpAddress":"63.86.124.4","GroupId":39,"GroupName":"Newbie","JoinDate":1411109203,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"custom"},"FormattedName":"RivieraBride15","Id":279902,"Name":"RivieraBride15","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"63.86.124.4","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79647,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8fdf73d4dae178c4d51417293e310338","RawContent":"&lt;p&gt;&lt;span style=\"font-size:medium;\"&gt;&lt;span style=\"font-family:calibri;\"&gt;Hi ladies, &lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:medium;\"&gt;&lt;span style=\"font-family:calibri;\"&gt;Looking for some tipping advice.&amp;nbsp; We are a very small wedding party of 7 heading to Riviera Maya in just 2 weeks.&amp;nbsp; We are having a cocktail hour accompanied with a Mariachi band followed by a sit down semi-private dinner.&amp;nbsp; All of this is being done at an all-inclusive resort.  &amp;nbsp; I\u2019ve seen many answers to this question, and I am starting to get confused.&amp;nbsp; Who, if anyone, should I be tipping and how much?&amp;nbsp; Thanks for any help!! &lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1906163,"PostDate":1444655807,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span  style=\"font-size:medium\"><span  style=\"font-family:calibri\">Hi ladies, <\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-size:medium\"><span  style=\"font-family:calibri\">Looking for some tipping advice.\u00a0 We are a very small wedding party of 7 heading to Riviera Maya in just 2 weeks.\u00a0 We are having a cocktail hour accompanied with a Mariachi band followed by a sit down semi-private dinner.\u00a0 All of this is being done at an all-inclusive resort.\u00a0\u00a0\u00a0 I\u2019ve seen many answers to this question, and I am starting to get confused.\u00a0 Who, if anyone, should I be tipping and how much?\u00a0 Thanks for any help!! <\/span><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>My Planning Thread:<\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79575-rivierabrides-planning-thread-102715\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79575-rivierabrides-planning-thread-102715\/<\/a>","Email":"erind285@gmail.com","IpAddress":"63.86.124.4","GroupId":39,"GroupName":"Newbie","JoinDate":1411109203,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"custom"},"FormattedName":"RivieraBride15","Id":279902,"Name":"RivieraBride15","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.146.146.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79647,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"1935ee9f9af3c2348b401715fc4bf245","RawContent":"&lt;p&gt;From all my time on the boards and researching this myself, I think it is a very personal decision.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We tipped the&lt;\/p&gt;\n&lt;p&gt;- wedding coordinator&lt;\/p&gt;\n&lt;p&gt;- hair stylist&lt;\/p&gt;\n&lt;p&gt;- servers\/bartender\/dj (all resort staff)&lt;\/p&gt;\n&lt;p&gt;- photographer&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;The only &#039;hindsite&#039; I have is that I would have tipped the service staff a lot more. &amp;nbsp;I tried to count who I saw .... but I am SURE there was way more people behind the scenes I didn&#039;t account for. &amp;nbsp; Too late now, but just a thought :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck! &amp;nbsp;and congrats! 2 weeks will fly by. &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1906164,"PostDate":1444656125,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>From all my time on the boards and researching this myself, I think it is a very personal decision.<\/p>\n<p>\u00a0<\/p>\n<p>We tipped the<\/p>\n<p>- wedding coordinator<\/p>\n<p>- hair stylist<\/p>\n<p>- servers\/bartender\/dj (all resort staff)<\/p>\n<p>- photographer<\/p>\n<p>\u00a0<\/p>\n<p>The only 'hindsite' I have is that I would have tipped the service staff a lot more. \u00a0I tried to count who I saw .... but I am SURE there was way more people behind the scenes I didn't account for. \u00a0 Too late now, but just a thought <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Good luck! \u00a0and congrats! 2 weeks will fly by. \u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.42.38","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79647,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"4343ee4eed705513b0998f6d4fd511a0","RawContent":"&lt;p&gt;I agree with @[member=\"calgarybride2015\"]&amp;nbsp; I think it&#039;s a very personal decision and obviously will depend on how happy you are with the service you get. Definitely the WC if you feel they&#039;ve helped you, and your wait staff which I think since you&#039;re in one of the resort restaurants should be fairly simple to do. Usually you&#039;ll get dedicated staff since you&#039;re in one of the restaurants.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We leave in 6 days and @[member=\"calgarybride2015\"] actually reminded me of one I hadn&#039;t thought of.&lt;\/p&gt;","Attachments":[],"Id":1906174,"PostDate":1444692591,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I agree with @<a hovercard-ref=\"member\" hovercard-id=\"277873\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277873-calgarybride2015\/' title='Member profile'><span itemprop=\"name\">calgarybride2015<\/span><\/a>\u00a0 I think it's a very personal decision and obviously will depend on how happy you are with the service you get. Definitely the WC if you feel they've helped you, and your wait staff which I think since you're in one of the resort restaurants should be fairly simple to do. Usually you'll get dedicated staff since you're in one of the restaurants.<\/p>\n<p>\u00a0<\/p>\n<p>We leave in 6 days and @<a hovercard-ref=\"member\" hovercard-id=\"277873\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277873-calgarybride2015\/' title='Member profile'><span itemprop=\"name\">calgarybride2015<\/span><\/a> actually reminded me of one I hadn't thought of.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><em><span style=\"color:rgb(51,153,255);\">I'm lucky enough to\u00a0tell my husband how much I love him and say yes again\u00a0on October 20, 2015 at Grand Coral Beach Club!\u00a0<\/span><\/em>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"63.86.124.4","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79647,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"a6b0093558fc40ea62a9566260ad1761","RawContent":"&lt;p&gt;Unfortunately, my experience with my WC isn&#039;t one to write home about.&amp;nbsp; I think I am just going to have to see how everything goes once I get there.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;@[member=\"acw271011\"]&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;6 days!!! Sooo close!!&lt;\/p&gt;","Attachments":[],"Id":1906187,"PostDate":1444723828,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Unfortunately, my experience with my WC isn't one to write home about.\u00a0 I think I am just going to have to see how everything goes once I get there.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"232000\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/232000-acw271011\/' title='Member profile'><span itemprop=\"name\">acw271011<\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>6 days!!! Sooo close!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>My Planning Thread:<\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79575-rivierabrides-planning-thread-102715\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79575-rivierabrides-planning-thread-102715\/<\/a>","Email":"erind285@gmail.com","IpAddress":"63.86.124.4","GroupId":39,"GroupName":"Newbie","JoinDate":1411109203,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"custom"},"FormattedName":"RivieraBride15","Id":279902,"Name":"RivieraBride15","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.87.237.201","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79647,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"605ceaab4c81e9c37514998d4ffbdc16","RawContent":"&lt;p&gt;@RivieraBride15&amp;nbsp; Nobody can tell you how much to tip so absolutely if you feel a good tip is well deserved, then go for it. If the service has left something to be desired, then that&#039;s one of the ways to let them know is through the gratuity. Thankfully I&#039;ve had the opposite situation and mine has been a complete and total success!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;5 days today!! lol You&#039;re close too! I&#039;m getting excited just to get there. The renewal is a bonus of the trip lol&amp;nbsp; Now I&#039;m ready for sun, sand, and drinks!!!&lt;\/p&gt;","Attachments":[],"Id":1906206,"PostDate":1444745889,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@RivieraBride15\u00a0 Nobody can tell you how much to tip so absolutely if you feel a good tip is well deserved, then go for it. If the service has left something to be desired, then that's one of the ways to let them know is through the gratuity. Thankfully I've had the opposite situation and mine has been a complete and total success!<\/p>\n<p>\u00a0<\/p>\n<p>5 days today!! lol You're close too! I'm getting excited just to get there. The renewal is a bonus of the trip lol\u00a0 Now I'm ready for sun, sand, and drinks!!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><em><span style=\"color:rgb(51,153,255);\">I'm lucky enough to\u00a0tell my husband how much I love him and say yes again\u00a0on October 20, 2015 at Grand Coral Beach Club!\u00a0<\/span><\/em>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"63.86.124.4","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79647,"EditedBy":"<strong>Edited by RivieraBride15, 15 October 2015 - 08:41 AM.<\/strong>","EditDate":1444898508,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b74243da5c48d2fd7572ab9955497689","RawContent":"&lt;p&gt;@[member=\"acw271011\"]&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am jealous of your connection with your WC.&amp;nbsp; I pratically have to pull details out of her.&amp;nbsp; I have asked her a million times for my wedding calculator and she said she will get it to me.&amp;nbsp; They can&#039;t be too concerned about getting their money!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Have you checked the weather at all? I am trying not to watch the weather too much, because it just makes me panic.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Are you all set to go??&lt;\/p&gt;","Attachments":[],"Id":1906289,"PostDate":1444898405,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"232000\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/232000-acw271011\/' title='Member profile'><span itemprop=\"name\">acw271011<\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>I am jealous of your connection with your WC.\u00a0 I pratically have to pull details out of her.\u00a0 I have asked her a million times for my wedding calculator and she said she will get it to me.\u00a0 They can't be too concerned about getting their money!<\/p>\n<p>\u00a0<\/p>\n<p>Have you checked the weather at all? I am trying not to watch the weather too much, because it just makes me panic.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Are you all set to go??<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>My Planning Thread:<\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79575-rivierabrides-planning-thread-102715\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79575-rivierabrides-planning-thread-102715\/<\/a>","Email":"erind285@gmail.com","IpAddress":"63.86.124.4","GroupId":39,"GroupName":"Newbie","JoinDate":1411109203,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"custom"},"FormattedName":"RivieraBride15","Id":279902,"Name":"RivieraBride15","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.146.146.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79647,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f7721cd0523b2ff0c349f578fa18bc68","RawContent":"Don&#039;t panic! Mine showed rain all week and it rained once during the night. It will be beautiful sunshine for both of you!\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1906292,"PostDate":1444900852,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Don't panic! Mine showed rain all week and it rained once during the night. It will be beautiful sunshine for both of you!<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}}],"Id":"79647","Title":"Tipping Advice Needed For Small Wedding","LastPostDate":1444900852},"Pages":{"TotalItems":7,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
