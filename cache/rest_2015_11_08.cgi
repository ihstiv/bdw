":1250227,"PostDate":1281534835,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <span  style=\"font-family: arial\"><span  style=\"color: black\"><span  style=\"font-size: 10pt\">I plan on wearing a garter, but we aren't doing the bouquet or garter toss. My FI and I had a bad experience at a wedding during that and vowed to never participate in it again. <\/span><\/span><\/span><\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> <span  style=\"font-family: arial\"><span  style=\"color: black\"><span  style=\"font-size: 10pt\">Now I did buy a garter, but I have thick thighs (from dancing for 12 years) so I will only wear it if I lose some more weight and I don\u2019t feel like it is going to cut off my circulation. <\/span><\/span><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Wedding 10\/22\/10 Westin Aruba<\/span><br><br><span>I love being a Mrs.!<\/span><\/div><\/div>","Email":"hat0112@gmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1256743460,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-222905.jpg?_r=0","PhotoWidth":198,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"hat0112","Id":222905,"Name":"hat0112","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":16561,"EditedBy":""