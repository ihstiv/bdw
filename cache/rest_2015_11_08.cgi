e":"custom"},"FormattedName":"forevertogether","Id":277216,"Name":"forevertogether","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"97.91.185.236","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73951,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"e82748570f7f6bb82a0fd9042a4a6742","RawContent":"&lt;p&gt;what a cool site,&amp;nbsp;@[member=\"forevertogether\"]! thanks!&lt;\/p&gt;","Attachments":[],"Id":1847914,"PostDate":1398980989,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>what a cool site,\u00a0@<a hovercard-ref=\"member\" hovercard-id=\"277216\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/277216-forevertogether\/' title='Member profile'><span itemprop=\"name\">forevertogether<\/span><\/a>! thanks!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-size:14px;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><strong><span style=\"color:#ff6666;\">I love him & he loves me, we'll be married by the sea.<\/span><\/strong><\/span><\/span><br>\n\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77696-our-dw-dreams-riviera-cancun-17-apr-2015\/'>Planning\u00a0Journal<\/a>\u00a0& <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/blog\/86-my-destination-wedding-blog\/'>Blog<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/delsolphotography.com\/beach-wedding-dreams-riviera-cancun-tj\/'>My wedding pictures from Del Sol Photography<\/a><\/p>\n<p>\u00a0","Email":"tricia.d.davis@gmail.com","IpAddress":"97.91.185.236","GroupId":3,"GroupName":"Member","JoinDate":1396266119,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277418.jpg?_r=1429976005","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"pddcmc","Id":277418,"Name":"pddcmc","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"205.132.110.2","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73951,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"492947f9efc9b7d9c4be097324cee59a","RawContent":"&lt;p&gt;@[member=\"pddcmc\"]&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;She actually just finished my products!! They look fantastic!! And she made them super quick and she is SO lovely to work with! Please check her out!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Here&#039;s my finished products... I got the sandal and a haircomb. I&#039;m so excited!!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;div&gt;[sharedmedia=gallery:images:75056]&lt;\/div&gt;","Attachments":[],"Id":1847981,"PostDate":1399034205,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"277418\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/277418-pddcmc\/' title='Member profile'><span itemprop=\"name\">pddcmc<\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>She actually just finished my products!! They look fantastic!! And she made them super quick and she is SO lovely to work with! Please check her out!!<\/p>\n<p>\u00a0<\/p>\n<p>Here's my finished products... I got the sandal and a haircomb. I'm so excited!!!<\/p>\n<p>\u00a0<\/p>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/index.phpgallery\/image\/75056-barefootsandalandhaircomb\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17634\/sml_gallery_277216_17634_190636.jpg' class='galattach galimageview sharedmedia_screenshot' title='barefootsandalandhaircomb'  width='200' height='200'  alt='barefootsandalandhaircomb' id='sml_image_view_75056' \/><\/a>\n<br \/><\/div>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bambiderby@gmail.com","IpAddress":"205.132.110.2","GroupId":40,"GroupName":"Jr. Member","JoinDate":1395161860,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277216.jpg?_r=1395766815","PhotoWidth":200,"PhotoHeight":218,"PhotoType":"custom"},"FormattedName":"forevertogether","Id":277216,"Name":"forevertogether","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.51.180.235","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73951,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"520178d3e990da0fa5a77396bb949fea","RawContent":"&lt;p&gt;sassy! that hair comb really stands out to me! thanks for sharing! did you send the designer photos of your \"vision\" for your sandals, or how did she come up with the design?&lt;\/p&gt;","Attachments":[],"Id":1848184,"PostDate":1399202429,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>sassy! that hair comb really stands out to me! thanks for sharing! did you send the designer photos of your \"vision\" for your sandals, or how did she come up with the design?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-size:14px;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><strong><span style=\"color:#ff6666;\">I love him & he loves me, we'll be married by the sea.<\/span><\/strong><\/span><\/span><br>\n\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77696-our-dw-dreams-riviera-cancun-17-apr-2015\/'>Planning\u00a0Journal<\/a>\u00a0& <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/blog\/86-my-destination-wedding-blog\/'>Blog<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/delsolphotography.com\/beach-wedding-dreams-riviera-cancun-tj\/'>My wedding pictures from Del Sol Photography<\/a><\/p>\n<p>\u00a0","Email":"tricia.d.davis@gmail.com","IpAddress":"97.91.185.236","GroupId":3,"GroupName":"Member","JoinDate":1396266119,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277418.jpg?_r=1429976005","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"pddcmc","Id":277418,"Name":"pddcmc","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"97.119.88.23","IsFirstPost":false,"