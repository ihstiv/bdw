{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":61226,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9fdd1ec5829a3fa0622687f903eec603","RawContent":"&lt;p&gt; Everything looks great, u did a wonderful job.&amp;nbsp; ur guest r going to love it.&lt;\/p&gt;","Attachments":[],"Id":1456521,"PostDate":1306152315,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Everything looks great, u did a wonderful job.\u00a0 ur guest r going to love it.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"magz0201@yahoo.com","IpAddress":"","GroupId":47,"GroupName":"Site Supporter","JoinDate":1305277025,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/1\/18\/18ac277e_fb-user-514072616-avatar?_r=0","PhotoWidth":200,"PhotoHeight":171,"PhotoType":"custom"},"FormattedName":"Cammi0201","Id":239960,"Name":"Cammi0201","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":61226,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1fd53aac4577c495658d79e94e0069bf","RawContent":"&lt;p&gt; Very nice Marichu! The designs are very pretty! You did a really great job! I&#039;m sure your guests will love them!!&lt;\/p&gt;","Attachments":[],"Id":1456751,"PostDate":1306171870,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Very nice Marichu! The designs are very pretty! You did a really great job! I'm sure your guests will love them!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Kbodchill@videotron.ca","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1293880502,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-234961.JPG?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Kbodchill","Id":234961,"Name":"Kbodchill","IsOnline":false}}],"Pages":{"TotalItems":232,"TotalPages":24,"CurrentPage":10,"NextPage":20,"PreviousPage":0,"LastPage":230},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
