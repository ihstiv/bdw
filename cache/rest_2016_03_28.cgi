.58","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79774,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"c8be7aa975e771c69a7987cc3263f31f","RawContent":"Everyone looks great! I love your room key holder inserts!","Attachments":[],"Id":1908843,"PostDate":1451738346,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Everyone looks great! I love your room key holder inserts!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"townsendsmithwed@gmail.com","IpAddress":"173.66.3.166","GroupId":39,"GroupName":"Newbie","JoinDate":1427024404,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282503.jpeg?_r=1444096181","PhotoWidth":200,"PhotoHeight":217,"PhotoType":"custom"},"FormattedName":"tiffanyt","Id":282503,"Name":"tiffanyt","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.155.33.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79774,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"afb9ba0023fa4ec1cf4ac5999a12c0ac","RawContent":"&lt;p&gt;@[member=\"tiffanyt\"] Thanks so much. I made them on Vistaprint for free with a coupon I had! Just paid shipping...and FREE makes me like them even more lol&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;@[member=\"kelbiiztd\"] and @[member=\"acw271011\"] Thanks girlies!!!&amp;nbsp;:-)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;@[member=\"tinren\"] your wedding day is the day before mine! We are 6 months away... time is flying for me lol&lt;\/p&gt;","Attachments":[],"Id":1908926,"PostDate":1451899954,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"282503\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282503-tiffanyt\/' title='Member profile'><span itemprop=\"name\">tiffanyt<\/span><\/a> Thanks so much. I made them on Vistaprint for free with a coupon I had! Just paid shipping...and FREE makes me like them even more lol<\/p>\n<p>\u00a0<\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"284817\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/284817-kelbiiztd\/' title='Member profile'><span itemprop=\"name\">kelbiiztd<\/span><\/a> and @<a hovercard-ref=\"member\" hovercard-id=\"232000\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/232000-acw271011\/' title='Member profile'><span itemprop=\"name\">acw271011<\/span><\/a> Thanks girlies!!!\u00a0:-)<\/p>\n<p>\u00a0<\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"283266\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/283266-tinren\/' title='Member profile'><span itemprop=\"name\">tinren<\/span><\/a> your wedding day is the day before mine! We are 6 months away... time is flying for me lol<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ana.avant87@gmail.com","IpAddress":"72.35.67.10","GroupId":39,"GroupName":"Newbie","JoinDate":1437720137,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284112.jpg?_r=1437784941","PhotoWidth":200,"PhotoHeight":258,"PhotoType":"custom"},"FormattedName":"CaboBride6252016","Id":284112,"Name":"CaboBride6252016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"137.200.32.22","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79774,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"b0db5db4af3ddbe37850b8b83bf6abe9","RawContent":"&lt;p&gt;I know, it will be here before we know it! I took a break in planning but I&#039;m trying to crack down on plans now :-)&lt;\/p&gt;","Attachments":[],"Id":1908937,"PostDate":1451911245,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I know, it will be here before we know it! I took a break in planning but I'm trying to crack down on plans now :-)<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tinea2002@hotmail.com","IpAddress":"199.173.226.235","GroupId":39,"GroupName":"Newbie","JoinDate":1432722686,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"tinren","Id":283266,"Name":"tinren","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.100.237.180","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79774,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7d76d0b705d546d01ac8bd4c7e00c5e5","RawContent":"&lt;p&gt;@[member=\"CaboBride6252016\"]..... I sent my save the dates around June\/July 2015....as of today I have 35 guests sailing with us to St Thomas USVI.... question did you send an invitation to the guests who have not booked or just to those that booked? We are planning a AHR when we return and we will invite everyone that received a save the date.&amp;nbsp; thank you! Everything you have done looks GREAT!!&lt;\/p&gt;","Attachments":[],"Id":1909183,"PostDate":1452295479,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"284112\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/284112-cabobride6252016\/' title='Member profile'><span itemprop=\"name\">CaboBride6252016<\/span><\/a>..... I sent my save the dates around June\/July 2015....as of today I have 35 guests sailing with us to St Thomas USVI.... question did you send an invitation to the guests who have not booked or just to those that booked? We are planning a AHR when we return and we will invite everyone that received a save the date.\u00a0 thank you! Everything you have done looks GREAT!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"atwater7@yahoo.com","IpAddress":"98.240.19.233","GroupId":39,"GroupName":"Newbie","JoinDate":1389463919,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276017.jpg?_r=1452312783","PhotoWidth":200,"PhotoHeight":139,"PhotoType":"custom"},"FormattedName":"LADYJUSTICE","Id":276017,"Name":"LADYJUSTICE","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.87.238.180","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79774,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"98bd7cee1817cbbf6c7fa5528b6f17f4","RawContent":"&lt;p&gt;@[member=\"LADYJUSTICE\"] Thanks!!! I sent them out to everyone who had paid their deposit already. We have 65 guests paid and ready to go. I wanted to give everyone more info, but I couldn&#039;t figure out a way to do it on an invitation. That&#039;s how I ended up with the \"brochures\" lol&lt;\/p&gt;","Attachments":[],"Id":1909221,"PostDate":1452369820,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"276017\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/276017-ladyjustice\/' title='Member profile'><span itemprop=\"name\">LADYJUSTICE<\/span><\/a> Thanks!!! I sent them out to everyone who had paid their deposit already. We have 65 guests paid and ready to go. I wanted to give everyone more info, but I couldn't figure out a way to do it on an invitation. That's how I ended up with the \"brochures\" lol<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ana.avant87@gmail.com","IpAddress":"72.35.67.10","GroupId":39,"GroupName":"Newbie","JoinDate":1437720137,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284112.jpg?_r=1437784941","PhotoWidth":200,"PhotoHeight":258,"PhotoType":"custom"},"FormattedName":"CaboBride6252016","Id":284112,"Name":"CaboBride6252016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"171.248.128.69","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79774,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"847570cccb199052737b386d5822565d","RawContent":"&lt;p&gt;&lt;span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\"&gt;Great Job!!! thanks for sharing!!!&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1911163,"PostDate":1456113001,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span  style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif\">Great Job!!! thanks for sharing!!!<\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><a data-ipb='nomediaparse' href='http:\/\/u99bet.net\/ca-do-bong-da-online-ca-cuoc-the-thao-truc-tuyen\/'>7m<\/a>","Email":"kelbiiz001@gmail.com","IpAddress":"14.161.15.242","GroupId":39,"GroupName":"Newbie","JoinDate":1454564397,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286134.jpg?_r=1458458071","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"kelbiiz11","Id":286134,"Name":"kelbiiz11","IsOnline":false}}],"Id":"79774","Title":"Diy Std, Door Hangers, Info Pamphlet, Etc (Pics Included)","LastPostDate":1458753741},"Pages":{"TotalItems":13,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
