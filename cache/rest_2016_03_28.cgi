{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":2,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":348,"MovedTo":null,"MovedOn":0,"FirstPostId":1911798,"Rating":0,"RatingHits":0,"Starter":{"Id":282063,"Name":"Cablelove11","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1457729325,"LastPoster":{"Id":232000,"Name":"acw271011","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":44,"Preview":{"Id":1911798,"PostDate":1457729325,"PostContent":"I purchased the $.89 canvas bags from Cheaptotes.com February 23rd. The website states that it wo...","Author":{"Signature":"","Email":"lmf0408@gmail.com","IpAddress":"208.54.64.217","GroupId":39,"GroupName":"Newbie","JoinDate":1423558366,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Cablelove11","Id":282063,"Name":"Cablelove11","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.180.52.177","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79991,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"4a1f5099a43fb98de1574f2d53578e34","RawContent":"I purchased the $.89 canvas bags from Cheaptotes.com February 23rd. The website states that it would be 7-14 days ($9.99 shipping). Time past and l looked up this past Monday the7th and realized that I didn&#039;t even get an email stating my order shipped. I emailed them and received the response that their shipping system went down, however they could see that it shipped the 24th... Mmmmkay so where&#039;s my stuff? I emailed them back and called the next day with no response. Finally got ahold of them yesterday and the lady said that their warehouse flooded and she would ship them out 3 day mail. Miraculously 3 hrs later their system was back up and I had the package at my door :-\/ I didn&#039;t like the response time and felt as if I was getting the run around. I haven&#039;t started with the iron on transfers however so far I am satisfied with the overal quality.","Attachments":[],"Id":1911798,"PostDate":1457729325,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I purchased the $.89 canvas bags from Cheaptotes.com February 23rd. The website states that it would be 7-14 days ($9.99 shipping). Time past and l looked up this past Monday the7th and realized that I didn't even get an email stating my order shipped. I emailed them and received the response that their shipping system went down, however they could see that it shipped the 24th... Mmmmkay so where's my stuff? I emailed them back and called the next day with no response. Finally got ahold of them yesterday and the lady said that their warehouse flooded and she would ship them out 3 day mail. Miraculously 3 hrs later their system was back up and I had the package at my door :-\/ I didn't like the response time and felt as if I was getting the run around. I haven't started with the iron on transfers however so far I am satisfied with the overal quality.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lmf0408@gmail.com","IpAddress":"208.54.64.217","GroupId":39,"GroupName":"Newbie","JoinDate":1423558366,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Cablelove11","Id":282063,"Name":"Cablelove11","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"204.138.126.13","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79991,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e3124fa4e0e70e447cdd6b44f2d1c126","RawContent":"&lt;p&gt;@cablelove11&amp;nbsp; I looked at this site too but not the canvas bags. A different style. I ended up with bags from dealrack.com I think was the sit and the bags are awesome. We had a really small group though so I got away with ordering a small number. I think I ordered 8. Thanks for the review on the shipping thing you went through. It&#039;s always nice to have feedback so other brides to be are aware of what&#039;s out there.&lt;\/p&gt;","Attachments":[],"Id":1911910,"PostDate":1458032088,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@cablelove11\u00a0 I looked at this site too but not the canvas bags. A different style. I ended up with bags from dealrack.com I think was the sit and the bags are awesome. We had a really small group though so I got away with ordering a small number. I think I ordered 8. Thanks for the review on the shipping thing you went through. It's always nice to have feedback so other brides to be are aware of what's out there.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span><\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/ann.chadwick.5\/media_set?set=a.10153262834771016.1073741828.569791015&type=3'><span style=\"color:#ff0099;\"><em>https:\/\/www.facebook.com\/ann.chadwick.5\/media_set?set=a.10153262834771016.1073741828.569791015&type=3<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/'><span style=\"color:#ff0099;\"><em>http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283440999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}}],"Id":"79991","Title":"Cheaptotes.com","LastPostDate":1458032088},"Pages":{"TotalItems":2,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
