Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":21,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":4715,"MovedTo":null,"MovedOn":0,"FirstPostId":1897157,"Rating":0,"RatingHits":0,"Starter":{"Id":283227,"Name":"blissfulbride7","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1432502229,"LastPoster":{"Id":279694,"Name":"rbehlke","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279694.jpg?_r=1425843817","PhotoWidth":200,"PhotoHeight":171,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":44,"Preview":{"Id":1897157,"PostDate":1432502229,"PostContent":"Hi Lovely Ladies, \u00a0 I absolutely love looking at wedding welcome bags! I think they're such an aw...","Author":{"Signature":"","Email":"baggedandloaded@gmail.com","IpAddress":"24.104.193.230","GroupId":39,"GroupName":"Newbie","JoinDate":1432501138,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"blissfulbride7","Id":283227,"Name":"blissfulbride7","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.104.193.230","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79210,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":3,"IsLiked":false,"PostKey":"f6c4582b6d6401b2d73e81c56b52e53e","RawContent":"&lt;p&gt;Hi Lovely Ladies,&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I absolutely love looking at wedding welcome bags! I think they&#039;re such an awesome idea for welcoming guests to a destination wedding. I&#039;m getting married in June 2016 (yay!) and I&#039;ve been looking at the cutest totes on baggedandloaded.etsy.com . I&#039;m torn between deciding on a few of the designs (see the images). Which design do you like best?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Have any of you thought of using welcome totes? Which do you think is better, paper or canvas? Do you know of any other sites that sell great designs? I&#039;d love to know what you think.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;","Attachments":[{"Id":32357,"Name":"Bagged + Loaded Totes 1.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2015\/post-283227-0-29038900-1432520133.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2015\/post-283227-0-29038900-1432520133_thumb.jpg","Width":700,"Height":700}],"Id":1897157,"PostDate":1432502229,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Lovely Ladies,<\/p>\n<p>\u00a0<\/p>\n<p>I absolutely love looking at wedding welcome bags! I think they're such an awesome idea for welcoming guests to a destination wedding. I'm getting married in June 2016 (yay!) and I've been looking at the cutest totes on baggedandloaded.etsy.com . I'm torn between deciding on a few of the designs (see the images). Which design do you like best?<\/p>\n<p>\u00a0<\/p>\n<p>Have any of you thought of using welcome totes? Which do you think is better, paper or canvas? Do you know of any other sites that sell great designs? I'd love to know what you think.<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"baggedandloaded@gmail.com","IpAddress":"24.104.193.230","GroupId":39,"GroupName":"Newbie","JoinDate":1432501138,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"blissfulbride7","Id":283227,"Name":"blissfulbride7","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.51.152.147","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79210,"EditedBy":"<strong>Edited by perianjay, 24 May 2015 - 09:24 PM.<\/strong>","EditDate":1432502659,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6b135d677ffcc4768f6ed45f06ada5d0","RawContent":"&lt;p&gt;Love the pineapple design!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Have you had a look at www.weddingchicks.com ? They have some adorable ones as well! :)&lt;\/p&gt;","Attachments":[],"Id":1897158,"PostDate":1432502636,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Love the pineapple design!<\/p>\n<p>\u00a0<\/p>\n<p>Have you had a look at www.weddingchicks.com ? They have some adorable ones as well! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419419814,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1453235488","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.15.187","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79210,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fe0e51e12eb1ea98c00c05517796e828","RawContent":"&lt;p&gt;Those are totally cute! Love the colours! @[member=\"perianjay\"] beat me to it! lol I was going to suggest weddingchicks.com too. There&#039;s also another site that I&#039;ve looked at&amp;nbsp; www.bagiva.com&amp;nbsp; I don&#039;t know how many guests you have but their prices are pretty reasonable but I&#039;m not sure about the design part of it.&lt;\/p&gt;","Attachments":[],"Id":1897162,"PostDate":1432508712,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Those are totally cute! Love the colours! @<a hovercard-ref=\"member\" hovercard-id=\"281478\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281478-perianjay\/' title='Member profile'><span itemprop=\"name\">perianjay<\/span><\/a> beat me to it! lol I was going to suggest weddingchicks.com too. There's also another site that I've looked at\u00a0 www.bagiva.com\u00a0 I don't know how many guests you have but their prices are pretty reasonable but I'm not sure about the design part of it.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span><\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/ann.chadwick.5\/media_set?set=a.10153262834771016.1073741828.569791015&type=3'><span style=\"color:#ff0099;\"><em>https:\/\/www.facebook.com\/ann.chadwick.5\/media_set?set=a.10153262834771016.1073741828.569791015&type=3<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/'><span style=\"color:#ff0099;\"><em>http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283440999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.82.4.242","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79210,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"746faff48a51b446cd25a8cc693d273c","RawContent":"Definitely do canvas. All of our guests used their welcome bags as beach bags which was really nice to see! We made our own bags. Bought everything at a craft store and ironed on an image we found online.","Attachments":[],"Id":1897176,"PostDate":1432546778,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Definitely do canvas. All of our guests used their welcome bags as beach bags which was really nice to see! We made our own bags. Bought everything at a craft store and ironed on an image we found online. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Meggan.Kole@gmail.com","IpAddress":"68.82.4.242","GroupId":39,"GroupName":"Newbie","JoinDate":1385134977,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275259.jpg?_r=1421618186","PhotoWidth":200,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"Megg","Id":275259,"Name":"Megg","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.72.232.255","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79210,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"6a4583fc1256a283b09df7e089ad8cc3","RawContent":"Canvas is the way to go ! Our guests loved them and reused them. We spent like 1.50$ per bag by doing them ourselves","Attachments":[],"Id":1897184,"PostDate":1432558318,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Canvas is the way to go ! Our guests loved them and reused them. We spent like 1.50$ per bag by doing them ourselves \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nadia.bozanich@gmail.com","IpAddress":"75.112.200.126","GroupId":40,"GroupName":"Jr. Member","JoinDate":1406718672,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"nadiakat17","Id":279229,"Name":"nadiakat17","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.90.222.12","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79210,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6ef20e04511408edd479d70c41bac57b","RawContent":"Love all the designs :) my fave is the bottom right corner. \n\nI&#039;d suggest canvas over paper too then your guests can use them as beach bags.\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1897185,"PostDate":1432558333,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Love all the designs <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> my fave is the bottom right corner. <br>\nI'd suggest canvas over paper too then your guests can use them as beach bags.<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399410602,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.196.44.37","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79210,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a853ee029082e5318bfa322fc8b8f795","RawContent":"I love these! I haven&#039;t seen one with pineapples before...super cute! I struggled with the canvas decision for a while but thanks to the ladies on this site I ordered them last week from weddingchicks.com. They had a 40% off sale so if you decide to buy from them you can wait for the coupon to come up again!\n\n\nI figured our guest will use the canvas ones throughout their stay and for groceries and shopping afterwards. They will also be able to identify other guest using them while onsite which will be fun.\n\n\nGood luck and let us know what you decide!","Attachments":[],"Id":1897188,"PostDate":1432559108,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I love these! I haven't seen one with pineapples before...super cute! I struggled with the canvas decision for a while but thanks to the ladies on this site I ordered them last week from weddingchicks.com. They had a 40% off sale so if you decide to buy from them you can wait for the coupon to come up again!<br><br>\nI figured our guest will use the canvas ones throughout their stay and for groceries and shopping afterwards. They will also be able to identify other guest using them while onsite which will be fun.<br><br>\nGood luck and let us know what you decide!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sandra_co8@icloud.com","IpAddress":"50.162.188.193","GroupId":39,"GroupName":"Newbie","JoinDate":1421689270,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Sandraco8","Id":281796,"Name":"Sandraco8","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.94.109.103","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79210,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c11055a6e98caff90b815090310662fe","RawContent":"love the 3 pineapple design!","Attachments":[],"Id":1897616,"PostDate":1433085813,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                love the 3 pineapple design! \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jaspbri0317@aol.com","IpAddress":"71.58.144.195","GroupId":39,"GroupName":"Newbie","JoinDate":1296670027,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-236302.jpg?_r=1429022808","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"jaspbri0317","Id":236302,"Name":"jaspbri0317","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.104.193.230","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79210,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"67642e149ec48b9f93c95e9c95a9ee38","RawContent":"&lt;p&gt;Thank you all so very much for your input!&lt;\/p&gt;","Attachments":[],"Id":1901841,"PostDate":1438715356,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thank you all so very much for your input!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"baggedandloaded@gmail.com","IpAddress":"24.104.193.230","GroupId":39,"GroupName":"Newbie","JoinDate":1432501138,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"blissfulbride7","Id":283227,"Name":"blissfulbride7","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"47.54.132.97","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79210,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"c282663460829c9be3d555a5407e6f89","RawContent":"&lt;p&gt;I just got mine in the mail today. Ordered them from Vistaprint when they had a sale :) I love them!&lt;\/p&gt;\n&lt;div&gt;[sharedmedia=gallery:images:81829]&lt;\/div&gt;","Attachments":[],"Id":1902032,"PostDate":1438873497,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I just got mine in the mail today. Ordered them from Vistaprint when they had a sale <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> I love them!<\/p>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/81829-oot-bags\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_18075\/sml_gallery_283685_18075_1160369.jpg' class='galattach galimageview sharedmedia_screenshot' title='OOT Bags'  width='200' height='200'  alt='OOT Bags' id='sml_image_view_81829' \/><\/a>\n<br \/><\/div>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sarah_e_collier@hotmail.com","IpAddress":"142.176.60.154","GroupId":39,"GroupName":"Newbie","JoinDate":1435222562,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283685.jpg?_r=1437401496","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"streelbride","Id":283685,"Nam