{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":10,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":1320,"MovedTo":null,"MovedOn":0,"FirstPostId":1901369,"Rating":0,"RatingHits":0,"Starter":{"Id":284175,"Name":"vfosho","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284175.png?_r=1438111502","PhotoWidth":170,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":false},"StartDate":1438092419,"LastPoster":{"Id":285199,"Name":"swalker7979","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1901369,"PostDate":1438092419,"PostContent":"Hi Everyone, \u00a0 This is my first time on a forum site so please bare with me! I have just finished...","Author":{"Signature":"","Email":"vfaucheux@ymail.com","IpAddress":"167.230.140.9","GroupId":39,"GroupName":"Newbie","JoinDate":1438090297,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284175.png?_r=1438111502","PhotoWidth":170,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"vfosho","Id":284175,"Name":"vfosho","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"167.230.140.9","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79442,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"583d01ef059780eb62fb97c74076b41d","RawContent":"&lt;p&gt;Hi Everyone,&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;This is my first time on a forum site so please bare with me! I have just finished my confirmation for my beach destination wedding at Melia Caribe Tropical in Punta Cana, DR for May 28th 2016. I am just starting, as I have just booked my room, paid the deposit, chosen the beach gazebo and Tropical Convention Center for the wedding\/reception at 5pm. I have chosen the Fairy Tale Tropical package and am expecting arounf 40 guests.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;There are a few things I am still very curious on, like decor thats used there, flowers, name tags, DJ for the reception (costs associated with all these)? Photographer? Make up and hair (they have a salon there but...if anyone has used them or has any feedback on their services that would be greatly appreciated.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;What kind of items do I need to be brining there as far as the ceremony and reception?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Just finding a place with the available date has been so much work in itself, and just like everyone else my time is limited as I go to work FT and am pursuing the Masters in the evening with school. Talk about a stress diet that will keep my thin for the wedding :P .&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am going to try and continue to stay as active and invloved on this site!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Conrats to everyone who is planning their special day as well!&lt;\/p&gt;","Attachments":[],"Id":1901369,"PostDate":1438092419,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Everyone,<\/p>\n<p>\u00a0<\/p>\n<p>This is my first time on a forum site so please bare with me! I have just finished my confirmation for my beach destination wedding at Melia Caribe Tropical in Punta Cana, DR for May 28th 2016. I am just starting, as I have just booked my room, paid the deposit, chosen the beach gazebo and Tropical Convention Center for the wedding\/reception at 5pm. I have chosen the Fairy Tale Tropical package and am expecting arounf 40 guests.<\/p>\n<p>\u00a0<\/p>\n<p>There are a few things I am still very curious on, like decor thats used there, flowers, name tags, DJ for the reception (costs associated with all these)? Photographer? Make up and hair (they have a salon there but...if anyone has used them or has any feedback on their services that would be greatly appreciated.<\/p>\n<p>\u00a0<\/p>\n<p>What kind of items do I need to be brining there as far as the ceremony and reception?<\/p>\n<p>\u00a0<\/p>\n<p>Just finding a place with the available date has been so much work in itself, and just like everyone else my time is limited as I go to work FT and am pursuing the Masters in the evening with school. Talk about a stress diet that will keep my thin for the wedding <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/tongue.png' class='bbc_emoticon' alt=':P' \/> .<\/p>\n<p>\u00a0<\/p>\n<p>I am going to try and continue to stay as active and invloved on this site!!<\/p>\n<p>\u00a0<\/p>\n<p>Conrats to everyone who is planning their special day as well!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"vfaucheux@ymail.com","IpAddress":"167.230.140.9","GroupId":39,"GroupName":"Newbie","JoinDate":1438090297,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284175.png?_r=1438111502","PhotoWidth":170,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"vfosho","Id":284175,"Name":"vfosho","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79442,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"a12c266e26881045a3b77915941d8e61","RawContent":"&lt;p&gt;Congrats and welcome to the forum! :D&lt;\/p&gt;","Attachments":[],"Id":1901373,"PostDate":1438093347,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats and welcome to the forum! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/biggrin.png' class='bbc_emoticon' alt=':D' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419419814,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1453235488","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.49.243.226","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79442,"EditedBy":"<strong>Edited by snswedding2016, 28 July 2015 - 04:22 PM.<\/strong>","EditDate":1438100567,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"61833e48a1602a9a285e303baf2c51d6","RawContent":"&lt;p&gt;@[member=\"vfosho\"] congrats on your engagement and welcome to the fun part of wedding planning. I agree finding the resort and the dates and the right price is the hardest and most frustrating part. Now you get to do the fun stuff.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Have you checked out @[member=\"kcole123\"] &#039;s planning thread? I believe she was married at the same resort.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Happy planning!!&lt;\/p&gt;","Attachments":[],"Id":1901389,"PostDate":1438100548,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"284175\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/284175-vfosho\/' title='Member profile'><span itemprop=\"name\">vfosho<\/span><\/a> congrats on your engagement and welcome to the fun part of wedding planning. I agree finding the resort and the dates and the right price is the hardest and most frustrating part. Now you get to do the fun stuff.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Have you checked out @<a hovercard-ref=\"member\" hovercard-id=\"277264\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277264-kcole123\/' title='Member profile'><span itemprop=\"name\">kcole123<\/span><\/a> 's planning thread? I believe she was married at the same resort.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Happy planning!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>My planning thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78916-snswedding2016-planning-thread-jan-9-2016-azul-fives\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78916-snswedding2016-planning-thread-jan-9-2016-azul-fives\/<\/a><\/p>\n<p>\u00a0<\/p>\n<div><a class='bbc_url' href='http:\/\/www.TickerFactory.com\/'><\/div>\n<div><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10730;0\/st\/20160109\/e\/Our+Wedding\/k\/9fa9\/event.png\" alt=\"event.png\"><\/div>\n<div><\/a><\/div>\n","Email":"sean.n.steph2016@gmail.com","IpAddress":"74.12.52.42","GroupId":3,"GroupName":"Member","JoinDate":1415529511,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281055.jpg?_r=1455040720","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"snswedding2016","Id":281055,"Name":"snswedding2016","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.209.124.182","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79442,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"f070b552151d0c6c9bafcb3a4d7c3b6b","RawContent":"&lt;p&gt;@[member=\"vfosho\"] Welcome to the forum girl. Oh the fun you will have.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I got married at that resort just this April past. The resort was gorgeous. Have you ever been there. You won&#039;t be sorry. I had an awesome time on that resort and ALL my guests loved our choice.&lt;\/p&gt;\n&lt;p&gt;I didn&#039;t have my reception there so I wouldn&#039;t be able to help you out there but any questions you have feel free. Eeeeeek so exciting. What have you done so far?&lt;\/p&gt;","Attachments":[],"Id":1901400,"PostDate":1438105412,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"284175\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/284175-vfosho\/' title='Member profile'><span itemprop=\"name\">vfosho<\/span><\/a> Welcome to the forum girl. Oh the fun you will have.<\/p>\n<p>\u00a0<\/p>\n<p>I got married at that resort just this April past. The resort was gorgeous. Have you ever been there. You won't be sorry. I had an awesome time on that resort and ALL my guests loved our choice.<\/p>\n<p>I didn't have my reception there so I wouldn't be able to help you out there but any questions you have feel free. Eeeeeek so exciting. What have you done so far?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p style=\"text-align:center;\"><strong>Kristy and Nathan<\/strong><\/p>\n<p style=\"text-align:center;\"><strong>Melia Caribe Tropical <\/strong><\/p>\n<p style=\"text-align:center;\"><strong>April 17, 2015<\/strong>","Email":"colek_64@hotmail.com","IpAddress":"199.180.174.8","GroupId":3,"GroupName":"Member","JoinDate":1395328614,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277264.jpg?_r=1429937323","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"kcole123","Id":277264,"Name":"kcole123","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"98.199.5.113","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79442,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"46c746b428e89c434be4e7ab22062576","RawContent":"&lt;p&gt;Hey Ladies!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;So sweet you guys had time to get on here and respond! I know, @[member=\"kcole123\"]! I searched weddings at this resort and your thread popped up and now I feel like I have access to this secret wedding club! lol!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I havent done much though, just getting the place down and date, but after reading y&#039;alls threads I feel like I really need to make a checklist on the extras...i didnt realize there are so many extras!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;@[member=\"kcole123\"] did you end up using the beach gazebo? I saw someone who had posted about Melia stated they felt rushed after the ceremony at the gazebo and that the staff was pushing them to move on. Did you expereince any of this!?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;What did you end up doing for your reception?! I saw one user on your thread mention the private boat reception...was that something you looked into\/did?!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I have never been to Punta Cana period, but the pictures had me al..... :wub:&amp;nbsp; !! Did you end up reserving rooms through the hotel or TA for your guests? I got a quote from the hotel and it just substantially higher than what I see on expedia, travelocity, etc. So I am at a crossroad already on how to go about rooms and guests!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Once again I greatly appreciate y&#039;alls feedback and responses!&lt;\/p&gt;","Attachments":[],"Id":1901402,"PostDate":1438107472,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hey Ladies!<\/p>\n<p>\u00a0<\/p>\n<p>So sweet you guys had time to get on here and respond! I know, @<a hovercard-ref=\"member\" hovercard-id=\"277264\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277264-kcole123\/' title='Member profile'><span itemprop=\"name\">kcole123<\/span><\/a>! I searched weddings at this resort and your thread popped up and now I feel like I have access to this secret wedding club! lol!<\/p>\n<p>\u00a0<\/p>\n<p>I havent done much though, just getting the place down and date, but after reading y'alls threads I feel like I really need to make a checklist on the extras...i didnt realize there are so many extras!!<\/p>\n<p>\u00a0<\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"277264\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277264-kcole123\/' title='Member profile'><span itemprop=\"name\">kcole123<\/span><\/a> did you end up using the beach gazebo? I saw someone who had posted about Melia stated they felt rushed after the ceremony at the gazebo and that the staff was pushing them to move on. Did you expereince any of this!?<\/p>\n<p>\u00a0<\/p>\n<p>What did you end up doing for your reception?! I saw one user on your thread mention the private boat reception...was that something you looked into\/did?!<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I have never been to Punta Cana period, but the pictures had me al..... <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wub.png' class='bbc_emoticon' alt=':wub:' \/>\u00a0 !! Did you end up reserving rooms through the hotel or TA for your guests? I got a quote from the hotel and it just substantially higher than what I see on expedia, travelocity, etc. So I am at a crossroad already on how to go about rooms and guests!<\/p>\n<p>\u00a0<\/p>\n<p>Once again I greatly appreciate y'alls feedback and responses!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"vfaucheux@ymail.com","IpAddress":"167.230.140.9","GroupId":39,"GroupName":"Newbie","JoinDate":1438090297,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284175.png?_r=1438111502","PhotoWidth":170,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"vfosho","Id":284175,"Name":"vfosho","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.114.25.40","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79442,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"966429dfa79bb3d5ccc3da30e54b78f2","RawContent":"&lt;p&gt;Welcome to our forum community and your upcoming DR wedding, vfosho!!! as you can see already, you&#039;ll find lots of great info, advice and support from everyone here, so well done on a great start already :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Wishing you happy reserach, and all the very best with your plans - cheers!!! team MTM :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;....for some added inspiration, here are a few magical beach wedding moments that matter to ramp up your creativitiy even more.......enjoy!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;....from our &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10150695320839487.414941.18683524486&amp;amp;type=3&#039;&gt;Cover Photo Album: &lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xtp1\/t31.0-8\/11700881_10153435265859487_8330476870717087827_o.jpg\" alt=\"11700881_10153435265859487_8330476870717\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xft1\/t31.0-8\/11427375_10153408854794487_4566310682341134022_o.jpg\" alt=\"11427375_10153408854794487_4566310682341\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xap1\/t31.0-8\/10535668_10153339199499487_2051666274939383076_o.jpg\" alt=\"10535668_10153339199499487_2051666274939\"&gt;&lt;\/p&gt;","Attachments":[],"Id":1901669,"PostDate":1438421994,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome to our forum community and your upcoming DR wedding, vfosho!!! as you can see already, you'll find lots of great info, advice and support from everyone here, so well done on a great start already <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Wishing you happy reserach, and all the very best with your plans - cheers!!! team MTM <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>....for some added inspiration, here are a few magical beach wedding moments that matter to ramp up your creativitiy even more.......enjoy!<\/p>\n<p>\u00a0<\/p>\n<p>....from our <a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10150695320839487.414941.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>Cover Photo Album: <\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xtp1\/t31.0-8\/11700881_10153435265859487_8330476870717087827_o.jpg\" alt=\"11700881_10153435265859487_8330476870717\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xft1\/t31.0-8\/11427375_10153408854794487_4566310682341134022_o.jpg\" alt=\"11427375_10153408854794487_4566310682341\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xap1\/t31.0-8\/10535668_10153339199499487_2051666274939383076_o.jpg\" alt=\"10535668_10153339199499487_2051666274939\"><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography , Cancun, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving the Riviera Maya<\/p>\n<p>\u00a0<\/p>\n<p>Email: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p><span style=\"color:#0000cd;\"><strong>Why we're Ranked #1<\/strong><\/span> ~ Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21512-moments-that-matter-photography\/'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a><\/p>\n<p>\u00a0<\/p>\n<p><strong><span style=\"color:#0000cd;\"><span style=\"font-family:'comic sans ms', cursive;\">We Offer<\/span><\/span><\/strong>: <strong><em><u>100% Vendor Fee Discount<\/u><br>\n\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 <u>100% Deposit Guarantee<\/u><\/em><\/strong><\/p>\n<p><strong><em>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 \u00a0 <u>100% Satisfaction Guarantee<\/u><\/em><\/strong>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280192660,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"76.111.43.145","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79442,"EditedBy":"<strong>Edited by addysmitty, 29 September 2015 - 01:36 PM.<\/strong>","EditDate":1443533809,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"18b974db15832eb786c7ae33ce6b8d8e","RawContent":"&lt;p&gt;I can not believe how hard it is to get in touch with the Melia Caribe Tropical. I want the wedding Sept 2016 and can not get anyone to call me back! I see where may of you say you have to book the date ASAP. Any help would be appreciated!!&lt;\/p&gt;","Attachments":[],"Id":1905610,"PostDate":1443533437,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I can not believe how hard it is to get in touch with the Melia Caribe Tropical. I want the wedding Sept 2016 and can not get anyone to call me back! I see where may of you say you have to book the date ASAP. Any help would be appreciated!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"adoads@comcast.net","IpAddress":"76.111.43.145","GroupId":39,"GroupName":"Newbie","JoinDate":1443533216,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"addysmitty","Id":284962,"Name":"addysmitty","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"98.197.237.79","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79442,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"45512784525463831cd26bd625d09f54","RawContent":"Hello ladies! I am looking to book Melia  10\/2016 as it looks like a beautiful resort! I was wondering if there are options to add on to any package and if anyone has received a la cart pricing? They have sent me their wedding guide and banquet menu but that&#039;s all.","Attachments":[],"Id":1907626,"PostDate":1447720661,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hello ladies! I am looking to book Melia  10\/2016 as it looks like a beautiful resort! I was wondering if there are options to add on to any package and if anyone has received a la cart pricing? They have sent me their wedding guide and banquet menu but that's all.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"swalker7979@gmail.com","IpAddress":"159.53.46.141","GroupId":39,"GroupName":"Newbie","JoinDate":1446032380,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"swalker7979","Id":285199,"Name":"swalker7979","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"42.117.114.232","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79442,"EditedBy":"<strong>Edited by kelbiiztd, 17 November 2015 - 02:17 AM.<\/strong>","EditDate":1447726648,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8a4bd51153b2a6a4dea4424bb4540c93","RawContent":"&lt;p&gt;Nice to meet you!!!&amp;nbsp; :P&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\"&gt;Congrats and welcome to the forum!&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1907629,"PostDate":1447726635,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n      