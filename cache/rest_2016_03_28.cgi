{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":1,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":0,"MovedTo":null,"MovedOn":0,"FirstPostId":1912252,"Rating":0,"RatingHits":0,"Starter":{"Id":286588,"Name":"2110Sophia","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286588.jpg?_r=1459179715","PhotoWidth":170,"PhotoHeight":300,"PhotoType":"facebook"},"IsOnline":true},"StartDate":1459162398,"LastPoster":{"Id":286588,"Name":"2110Sophia","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286588.jpg?_r=1459179715","PhotoWidth":170,"PhotoHeight":300,"PhotoType":"facebook"},"IsOnline":true},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1912252,"PostDate":1459162398,"PostContent":"Hello lovely BDW brides! \u00a0 I am super new to the forum, and recently got engaged (woop!) \u00a0 \u00a0 My p...","Author":{"Signature":"","Email":"sophiaa47@hotmail.com","IpAddress":"209.29.21.179","GroupId":39,"GroupName":"Newbie","JoinDate":1459161716,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286588.jpg?_r=1459179715","PhotoWidth":170,"PhotoHeight":300,"PhotoType":"facebook"},"FormattedName":"2110Sophia","Id":286588,"Name":"2110Sophia","IsOnline":true}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"209.29.21.179","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80013,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cb2ad0d2ce37108621b6590bc9c15fe6","RawContent":"&lt;p&gt;Hello lovely BDW brides!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am super new to the forum, and recently got engaged (woop!) :)&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;My partner is Dominican - we are living in Toronto - and we are hoping to get married in Punta Cana. We are looking at doing it off-site from a hotel, hopefully a beach front restaurant.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;So far we have The Jellyfish in mind, it looks gorgeous! Does anyone have any experiences with The Jellyfish or other similar recommendations?&lt;\/p&gt;\n&lt;p&gt;Any advice, experiences or info you guys could share would be so very appreciated.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We are hoping to get married December 2017\/Jan 2018.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;All the best to you ladies!!&lt;\/p&gt;\n&lt;p&gt;Sophia :)&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1912252,"PostDate":1459162398,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello lovely BDW brides!<\/p>\n<p>\u00a0<\/p>\n<p>I am super new to the forum, and recently got engaged (woop!) <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>My partner is Dominican - we are living in Toronto - and we are hoping to get married in Punta Cana. We are looking at doing it off-site from a hotel, hopefully a beach front restaurant.<\/p>\n<p>\u00a0<\/p>\n<p>So far we have The Jellyfish in mind, it looks gorgeous! Does anyone have any experiences with The Jellyfish or other similar recommendations?<\/p>\n<p>Any advice, experiences or info you guys could share would be so very appreciated.<\/p>\n<p>\u00a0<\/p>\n<p>We are hoping to get married December 2017\/Jan 2018.<\/p>\n<p>\u00a0<\/p>\n<p>All the best to you ladies!!<\/p>\n<p>Sophia <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sophiaa47@hotmail.com","IpAddress":"209.29.21.179","GroupId":39,"GroupName":"Newbie","JoinDate":1459161716,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286588.jpg?_r=1459179715","PhotoWidth":170,"PhotoHeight":300,"PhotoType":"facebook"},"FormattedName":"2110Sophia","Id":286588,"Name":"2110Sophia","IsOnline":true}}],"Id":"80013","Title":"Punta Cana Venue 2017","LastPostDate":1459162398},"Pages":{"TotalItems":1,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
