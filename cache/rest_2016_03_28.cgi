> Time: 1459190669 / Mon, 28 Mar 2016 18:44:29 +0000
> URL: /index.php?/REST/Forums/topic?startFromPostId=1897192&SessionId=a9326f85c2db646ff4289780dcc8da53
> User lorishultz2016 (284536)
Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":9,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":597,"MovedTo":null,"MovedOn":0,"FirstPostId":1897192,"Rating":0,"RatingHits":0,"Starter":{"Id":281796,"Name":"Sandraco8","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1432562259,"LastPoster":{"Id":277873,"Name":"calgarybride2015","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":44,"Preview":{"Id":1897192,"PostDate":1432562259,"PostContent":"Hello all. I'm having a hard time deciding on the type of cup to include in my OOT bags. After vi...","Author":{"Signature":"","Email":"sandra_co8@icloud.com","IpAddress":"50.162.188.193","GroupId":39,"GroupName":"Newbie","JoinDate":1421689270,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Sandraco8","Id":281796,"Name":"Sandraco8","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.196.44.37","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79213,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"67006dd4dd321a5801843f3d4881d597","RawContent":"Hello all. I&#039;m having a hard time deciding on the type of cup to include in my OOT bags. After visiting the resort last month I decided it was a must to add for our guests. I&#039;ve been pricing them out and personalized stadium cups are by far less expensive and will be easiest to transport.\n\n\nI do think an insulated mug or cup with a lid or straw would be even better but do you think anyone would be disapointed with the stadium cups? I don&#039;t want to spend too much but also want to make sure they&#039;re used. I saw a lot of people with Bubba&#039;s and it just makes perfect sense to include as a gift. Do you think a cup with no lid or straw would be used as much? I saw some insulated cups with straws at Dollar Tree but it might be difficult to transport 40 since they don&#039;t nest perfectly inside each other. \n\n\nHelp!!!!","Attachments":[],"Id":1897192,"PostDate":1432562259,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hello all. I'm having a hard time deciding on the type of cup to include in my OOT bags. After visiting the resort last month I decided it was a must to add for our guests. I've been pricing them out and personalized stadium cups are by far less expensive and will be easiest to transport.<br><br>\nI do think an insulated mug or cup with a lid or straw would be even better but do you think anyone would be disapointed with the stadium cups? I don't want to spend too much but also want to make sure they're used. I saw a lot of people with Bubba's and it just makes perfect sense to include as a gift. Do you think a cup with no lid or straw would be used as much? I saw some insulated cups with straws at Dollar Tree but it might be difficult to transport 40 since they don't nest perfectly inside each other. <br><br>\nHelp!!!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sandra_co8@icloud.com","IpAddress":"50.162.188.193","GroupId":39,"GroupName":"Newbie","JoinDate":1421689270,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Sandraco8","Id":281796,"Name":"Sandraco8","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.87.237.180","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79213,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"34b983c98b4cfe5fad40b1b40053c916","RawContent":"&lt;p&gt;@calgrybride2015 did an awesome job transporting hers and she had about 40 of them. I know she found a way for it to work. I really think a cup with a lid works great. Obviously you won&#039;t want bubbas for 40 people since the cost can really add up but a lot of the ladies here are doing the Dollar Tree ones and from what I&#039;m hearing guests seem to love them!&lt;\/p&gt;","Attachments":[],"Id":1897194,"PostDate":1432565579,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@calgrybride2015 did an awesome job transporting hers and she had about 40 of them. I know she found a way for it to work. I really think a cup with a lid works great. Obviously you won't want bubbas for 40 people since the cost can really add up but a lot of the ladies here are doing the Dollar Tree ones and from what I'm hearing guests seem to love them!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span><\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/ann.chadwick.5\/media_set?set=a.10153262834771016.1073741828.569791015&type=3'><span style=\"color:#ff0099;\"><em>https:\/\/www.facebook.com\/ann.chadwick.5\/media_set?set=a.10153262834771016.1073741828.569791015&type=3<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/'><span style=\"color:#ff0099;\"><em>http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283440999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"159.18.168.1","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79213,"EditedBy":"<strong>Edited by vancouverpetunia, 25 May 2015 - 05:41 PM.<\/strong>","EditDate":1432575663,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"ad6241cfaa59d4ca56b6a8b24f0bc538","RawContent":"&lt;p&gt;I&#039;ll answer this as a guest and not a bride. We have decided not to do OOT bags, so I haven&#039;t investigated prices, options, etc.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;But as guests, we always take our own insulated cups with lids\/straws. And since we started doing this a few years ago, we recommend it to anyone else who is heading to an all-inclusive resort. While non-insulated cups with no lid could allow you to get a larger drink than the resort throw-away cups, they won&#039;t keep the drinks cold, the ice will melt, etc. I don&#039;t know that it would be the greatest investment, as people may not use them a lot (just as easy to use the resort cups rather than haul your own around if there is no real benefit).&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;If I was planning to do OOT bags, I would actually probably do insulated mugs of some sort and stuff them with some goodies. That would keep the costs down by not having an actual bag. Of course, it depends on what you want to include in your OOT as to whether that idea would work for you or not.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1897208,"PostDate":1432575635,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I'll answer this as a guest and not a bride. We have decided not to do OOT bags, so I haven't investigated prices, options, etc.<\/p>\n<p>\u00a0<\/p>\n<p>But as guests, we always take our own insulated cups with lids\/straws. And since we started doing this a few years ago, we recommend it to anyone else who is heading to an all-inclusive resort. While non-insulated cups with no lid could allow you to get a larger drink than the resort throw-away cups, they won't keep the drinks cold, the ice will melt, etc. I don't know that it would be the greatest investment, as people may not use them a lot (just as easy to use the resort cups rather than haul your own around if there is no real benefit).\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>If I was planning to do OOT bags, I would actually probably do insulated mugs of some sort and stuff them with some goodies. That would keep the costs down by not having an actual bag. Of course, it depends on what you want to include in your OOT as to whether that idea would work for you or not.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>- Erin<\/p>\n<p>\u00a0<\/p>\n<p>My planning thread:\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268'>http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268<\/a>","Email":"ekjzwedding@gmail.com","IpAddress":"24.85.127.174","GroupId":3,"GroupName":"Member","JoinDate":1417431445,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281283.jpg?_r=1428779369","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"vancouverpetunia","Id":281283,"Name":"vancouverpetunia","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.82.4.242","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79213,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2788959f827f679ebe508d121277f039","RawContent":"When we got married, there were a lot of things we second guessed for budget. But everything we did, we were so happy we decided to do. I wish we would have got the insulated cups for the wedding guests. I had no idea how often they would have been used! One couple wanted to buy them at the gift shop but they were charging an arm and a leg so they passed. You&#039;ll be so happy to see all of your guests gathered around the pool with proper mugs and know it was worth it. Just my opinion","Attachments":[],"Id":1897214,"PostDate":1432583431,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                When we got married, there were a lot of things we second guessed for budget. But everything we did, we were so happy we decided to do. I wish we would have got the insulated cups for the wedding guests. I had no idea how often they would have been used! One couple wanted to buy them at the gift shop but they were charging an arm and a leg so they passed. You'll be so happy to see all of your guests gathered around the pool with proper mugs and know it was worth it. Just my opinion \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Meggan.Kole@gmail.com","IpAddress":"68.82.4.242","GroupId":39,"GroupName":"Newbie","JoinDate":1385134977,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275259.jpg?_r=1421618186","PhotoWidth":200,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"Megg","Id":275259,"Name":"Megg","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.35.109.240","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79213,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5f26bf35d0b90f35754c1f284480b657","RawContent":"@[member=\"Sandraco8\"] I transported 85 personalized 20oz stadium cups to Dominican Republic at the beginning of the month with no prob! They fit perfectly in my carry on amongst everything else!! Pricing was great and all of my guest loved\/love them!!","Attachments":[],"Id":1897218,"PostDate":1432589201,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"281796\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281796-sandraco8\/' title='Member profile'><span itemprop=\"name\">Sandraco8<\/span><\/a> I transported 85 personalized 20oz stadium cups to Dominican Republic at the beginning of the month with no prob! They fit perfectly in my carry on amongst everything else!! Pricing was great and all of my guest loved\/love them!! \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"May 01, 2015- complete!! 73 guests+bride & groom! Now Larimar Punta Cana! ","Email":"cooper.tyshelle@gmail.com","IpAddress":"108.50.56.179","GroupId":40,"GroupName":"Jr. Member","JoinDate":1375995069,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272393.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"DR2015","Id":272393,"Name":"DR2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.41.59","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79213,"EditedBy":"<strong>Edited by calgarybride2015, 25 May 2015 - 10:03 PM.<\/strong>","EditDate":1432591436,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"485c39f9cdd3acd6f361e215beb72e85","RawContent":"Hey!\n\n\nI really wanted bubba&#039;s for all my guests but at $6 a pop I just couldn&#039;t afford it. Looking back I should have just made it work. \n\n\nThat said I did the tumblers with lid and straw. I had to bring 45 + of them. I had my kits inside the cups so I couldn&#039;t stack the cups. I bubbled wrapped each one and fit almost all in one 30 inch suitcase.  More than 1\/2 my guests used the cups! The others had brought their own bubba&#039;s. \n\n\nTruth be told though - had I have known about a stadium cup before I bought the tumblers I would have went this route.   I think it&#039;s a fabulous idea although another poster is right - won&#039;t keep them cold all day But they would also get used at home after too. More than the tumbler will. \n\n\nIf you are a US bride you should check out discount mugs as they have great prices. Unfortunately to Canada the shipping was absurd. \n\n\nThat said I don&#039;t think you can go wrong with any of them. Personally if you can make the bubba&#039;s work price wise that would be my first suggestion, otherwise tumblers or stadium cups are both a good alternative. \n\n\nI don&#039;t regret our decision to do tumblers whatsoever and our guests loved them. \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1897222,"PostDate":1432591278,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hey!<br><br>\nI really wanted bubba's for all my guests but at $6 a pop I just couldn't afford it. Looking back I should have just made it work. <br><br>\nThat said I did the tumblers with lid and straw. I had to bring 45 + of them. I had my kits inside the cups so I couldn't stack the cups. I bubbled wrapped each one and fit almost all in one 30 inch suitcase.  More than 1\/2 my guests used the cups! The others had brought their own bubba's. <br><br>\nTruth be told though - had I have known about a stadium cup before I bought the tumblers I would have went this route.   I think it's a fabulous idea although another poster is right - won't keep them cold all day But they would also get used at home after too. More than the tumbler will. <br><br>\nIf you are a US bride you should check out discount mugs as they have great prices. Unfortunately to Canada the shipping was absurd. <br><br>\nThat said I don't think you can go wrong with any of them. Personally if you can make the bubba's work price wise that would be my first suggestion, otherwise tumblers or stadium cups are both a good alternative. <br><br>\nI don't regret our decision to do tumblers whatsoever and our guests loved them. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399410602,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.15.187","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79213,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"db4cd847d87290eb465cdf8241443c94","RawContent":"&lt;p&gt;@[member=\"calgarybride2015\"] I knew you had the right words!!! I&#039;m only packing 6 at this point so I&#039;m absolutely no help from a packing perspective! lol&lt;\/p&gt;","Attachments":[],"Id":1897309,"PostDate":1432679861,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"277873\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277873-calgarybride2015\/' title='Member profile'><span itemprop=\"name\">calgarybride2015<\/span><\/a> I knew you had the right words!!! I'm only packing 6 at this point so I'm absolutely no help from a packing perspective! lol<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span><\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/ann.chadwick.5\/media_set?set=a.10153262834771016.1073741828.569791015&type=3'><span style=\"color:#ff0099;\"><em>https:\/\/www.facebook.com\/ann.chadwick.5\/media_set?set=a.10153262834771016.1073741828.569791015&type=3<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/'><span style=\"color:#ff0099;\"><em>http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283440999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.196.44.37","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79213,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c3b017ee92f96f0cf1f74696ae519c61","RawContent":"Thank you ladies for all of your great advice! It&#039;s great to hear all of your perspectives. My guests are not accustomed to AI&#039;s so I know none will think of bringing their own cups so these will be a huge hit. My FI is so practical (and sometimes cheap) so although I appreciated his opinion he was probably focused on the numbers adding up. I do secretely agree these OOT bags are getting a bit pricey :( \n\n\nThanks to your guidance I&#039;ve decided to purchase the insulated tumblers with straws. I did some research and totallypromotional.com has good prices and reviews and don&#039;t seem to have minimum orders. I emailed their customer service and they suggested not putting them in a checked bag but in a carry on instead. We will figure out how to make it work!!\n\n\nThanks again ladies and on to the next wedding decision lol!!","Attachments":[],"Id":1897323,"PostDate":1432712177,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thank you ladies for all of your great advice! It's great to hear all of your perspectives. My guests are not accustomed to AI's so I know none will think of bringing their own cups so these will be a huge hit. My FI is so practical (and sometimes cheap) so although I appreciated his opinion he was probably focused on the numbers adding up. I do secretely agree these OOT bags are getting a bit pricey <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/sad.png' class='bbc_emoticon' alt=':(' \/> <br><br>\nThanks to your guidance I've decided to purchase the insulated tumblers with straws. I did some research and totallypromotional.com has good prices and reviews and don't seem to have minimum orders. I emailed their customer service and they suggested not putting them in a checked bag but in a carry on instead. We will figure out how to make it work!!<br><br>\nThanks again ladies and on to the next wedding decision lol!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sandra_co8@icloud.com","IpAddress":"50.162.188.193","GroupId":39,"GroupName":"Newbie","JoinDate":1421689270,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Sandraco8","Id":281796,"Name":"Sandraco8","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.41.59","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79213,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b1ff9df850ddde71155e6dbf54f41e74","RawContent":"[quote name=\"Sandraco8\" post=\"1897323\" timestamp=\"1432730177\"]\nThank you ladies for all of your great advice! It&#039;s great to hear all of your perspectives. My guests are not accustomed to AI&#039;s so I know none will think of bringing their own cups so these will be a huge hit. My FI is so practical (and sometimes cheap) so although I appreciated his opinion he was probably focused on the numbers adding up. I do secretely agree these OOT bags are getting a bit pricey :( \n\nThanks to your guidance I&#039;ve decided to purchase the insulated tumblers with straws. I did some research and totallypromotional.com has good prices and reviews and don&#039;t seem to have minimum orders. I emailed their customer service and they suggested not putting them in a checked bag but in a carry on instead. We will figure out how to make it work!!\n\nThanks again ladies and on to the next wedding decision lol!![\/quote]Congrats on making a decision.  There was so way I could have brought my 48 on carry one. If you end up doing checked let me know as I brought all mine and none cracked :) I bubble wrapped everything though!!! Good luck! \n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1897326,"PostDate":1432714435,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Sandraco8, on 27 May 2015 - 07:36 AM, said:<\/p><div class='blockquote'><div class='quote'><p>Thank you ladies for all of your great advice! It's great to hear all of your perspectives. My guests are not accustomed to AI's so I know none will think of bringing their own cups so these will be a huge hit. My FI is so practical (and sometimes cheap) so although I appreciated his opinion he was probably focused on the numbers adding up. I do secretely agree these OOT bags are getting a bit pricey <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/sad.png' class='bbc_emoticon' alt=':(' \/> <br><br>\nThanks to your guidance I've decided to purchase the insulated tumblers with straws. I did some research and totallypromotional.com has good prices and reviews and don't seem to have minimum orders. I emailed their customer service and they suggested not putting them in a checked bag but in a carry on instead. We will figure out how to make it work!!<br><br>\nThanks again ladies and on to the next wedding decision lol!!<\/p><\/div><\/div>\n<br>\nCongrats on making a decision.  There was so way I could have brought my 48 on carry one. If you end up doing checked let me know as I brought all mine and none cracked <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> I bubble wrapped everything though!!! Good luck! <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399410602,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}}],"Id":"79213","Title":"Need Advice For Oot Bag - Stadium Cups?","LastPostDate":1432714435},"Pages":{"TotalItems":9,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
