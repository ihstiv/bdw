":200,"PhotoHeight":197,"PhotoType":"custom"},"FormattedName":"acireta","Id":233628,"Name":"acireta","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":66214,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":4,"IsLiked":false,"PostKey":"3a81b3a6bc10e88db9143bb02a5b4b67","RawContent":"&lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;I absolutely loved making these bags! I think this was one of my favorite projects throughout this planning process, and I\u00e2\u20ac\u2122m really excited to share them with you all.&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;We got the bags from Cheap Totes, and they were totally worth the price ($2.89). They\u00e2\u20ac\u2122re a nice large size with a big pocket on the outside, and the quality is great.&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;img alt=\"DSC00330.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747755\/width\/600\/height\/450\" \/&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;I made tags for each bag on shimmer cardstock, and used a 3\u00e2\u20ac\u009d punch from Michaels (with a coupon of course!)&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;img alt=\"DSC00155.JPG\" height=\"392\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747759\/width\/600\/height\/450\" width=\"543\" \/&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span face=\"\"&gt;I did separate welcome packets for cruising guests and St. Thomas guests. I ended up making my own folders from black cardstock because I couldn\u00e2\u20ac\u2122t find the right size folders I needed. I tied each folder with ribbon and a welcome monogram.&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;u&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Welcome Packet Contents&lt;\/span&gt;&lt;\/span&gt;&lt;\/u&gt;&lt;\/p&gt; &lt;ul&gt; &lt;li&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Welcome postcard (Vistaprint) &lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt; &lt;\/ul&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;img alt=\"welcome postcard liberty.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747764\/width\/600\/height\/242\" \/&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;ul&gt; &lt;li&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Wedding week events (Vistaprint) &lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt; &lt;\/ul&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;img alt=\"wedding week events.JPG\" height=\"605\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747766\/width\/450\/height\/700\" style=\"width: 295px; height: 481px\" width=\"354\" \/&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;ul&gt; &lt;li&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Wedding day timeline (Vistaprint) &lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt; &lt;\/ul&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;img alt=\"wedding day timeline cruising guests.JPG\" height=\"560\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747769\/width\/306\/height\/672\" style=\"width: 224px; height: 512px\" width=\"223\" \/&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;ul&gt; &lt;li&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Photoshare business cards glued to one of the pockets (Vistaprint)&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt; &lt;\/ul&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;img alt=\"photoshare cards for oot bag.JPG\" height=\"256\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747771\/width\/600\/height\/344\" style=\"width: 381px; height: 212px\" width=\"470\" \/&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;ul&gt; &lt;li&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;St. Thomas postcards (&lt;img alt=\"postcards from paradise.jpg\" height=\"323\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747773\/width\/312\/height\/402\" width=\"245\" \/&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;ul&gt; &lt;li&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Door hangers (Vistaprint)&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt; &lt;\/ul&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;img alt=\"door hangers.jpg\" height=\"490\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747775\/width\/278\/height\/604\" style=\"width: 199px; height: 396px\" width=\"196\" \/&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;ul&gt; &lt;li&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Photo release form for the cruising guests (from Carnival, see templates below)&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt; &lt;li&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Recipe cards (from Jules23, Vistaprint)&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt; &lt;\/ul&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;img alt=\"DSC00228.JPG\" height=\"592\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747779\/width\/404\/height\/700\" style=\"width: 309px; height: 557px\" width=\"308\" \/&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;ul&gt; &lt;li&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Keycard\/tip holder on lanyard (&lt;img alt=\"photo 1.JPG\" height=\"347\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747781\/width\/600\/height\/448\" style=\"width: 444px; height: 312px\" width=\"489\" \/&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Here&#039;s the whole welcome packet all put together:&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;img alt=\"DSC00158.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747783\/width\/600\/height\/450\" \/&gt;&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;img alt=\"DSC00159.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747785\/width\/600\/height\/450\" \/&gt;&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;img alt=\"DSC00162.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747788\/width\/600\/height\/450\" \/&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;img alt=\"DSC00161.JPG\" height=\"595\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747790\/width\/525\/height\/700\" style=\"width: 404px; height: 560px\" width=\"436\" \/&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span id=\"cke_bm_51S\" style=\"display: none\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;em&gt;To be continued...&lt;\/em&gt;&lt;span id=\"cke_bm_51E\" style=\"display: none\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1590191,"PostDate":1330898279,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">I absolutely loved making these bags! I think this was one of my favorite projects throughout this planning process, and I\u00e2\u20ac\u2122m really excited to share them with you all.<\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">We got the bags from Cheap Totes, and they were totally worth the price ($2.89). They\u00e2\u20ac\u2122re a nice large size with a big pocket on the outside, and the quality is great.<\/span><\/span><\/p> <p> \u00a0<\/p> <p> \u00a0<span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span rel='lightbox'><img class='bbc_img' alt=\"DSC00330.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747755\/width\/600\/height\/450\" \/><\/span><\/span><\/span><\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">\u00a0<\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">I made tags for each bag on shimmer cardstock, and used a 3\u00e2\u20ac\u009d punch from Michaels (with a coupon of course!)<\/span><\/span><\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span rel='lightbox'><img class='bbc_img' alt=\"DSC00155.JPG\" height=\"392\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747759\/width\/600\/height\/450\" width=\"543\" \/><\/span><\/span><\/span><\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span face=\"\">I did separate welcome packets for cruising guests and St. Thomas guests. I ended up making my own folders from black cardstock because I couldn\u00e2\u20ac\u2122t find the right size folders I needed. I tied each folder with ribbon and a welcome monogram.<\/span><\/span><\/span><\/span><\/span><\/p> <p> \u00a0<\/p> <p> <u><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Welcome Packet Contents<\/span><\/span><\/u><\/p> <ul> <li> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Welcome postcard (Vistaprint) <\/span><\/span><\/span><\/span><\/li> <\/ul> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span rel='lightbox'><img class='bbc_img' alt=\"welcome postcard liberty.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747764\/width\/600\/height\/242\" \/><\/span><\/span><\/span><\/p> <ul> <li> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Wedding week events (Vistaprint) <\/span><\/span><\/span><\/span><\/li> <\/ul> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span rel='lightbox'><img class='bbc_img' alt=\"wedding week events.JPG\" height=\"605\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747766\/width\/450\/height\/700\" style=\"width: 295px; height: 481px\" width=\"354\" \/><\/span><\/span><\/span><\/span><\/span><\/p> <ul> <li> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Wedding day timeline (Vistaprint) <\/span><\/span><\/span><\/span><\/li> <\/ul> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span rel='lightbox'><img class='bbc_img' alt=\"wedding day timeline cruising guests.JPG\" height=\"560\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747769\/width\/306\/height\/672\" style=\"width: 224px; height: 512px\" width=\"223\" \/><\/span><\/span><\/span><\/span><\/span><\/p> <ul> <li> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Photoshare business cards glued to one of the pockets (Vistaprint)<\/span><\/span><\/span><\/span><\/li> <\/ul> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span rel='lightbox'><img class='bbc_img' alt=\"photoshare cards for oot bag.JPG\" height=\"256\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747771\/width\/600\/height\/344\" style=\"width: 381px; height: 212px\" width=\"470\" \/><\/span><\/span><\/span><\/span><\/span><\/p> <ul> <li> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">St. Thomas postcards (<span rel='lightbox'><img class='bbc_img' alt=\"postcards from paradise.jpg\" height=\"323\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747773\/width\/312\/height\/402\" width=\"245\" \/><\/span><\/span><\/span><\/span><\/p> <ul> <li> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Door hangers (Vistaprint)<\/span><\/span><\/span><\/span><\/li> <\/ul> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span rel='lightbox'><img class='bbc_img' alt=\"door hangers.jpg\" height=\"490\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747775\/width\/278\/height\/604\" style=\"width: 199px; height: 396px\" width=\"196\" \/><\/span><\/span><\/span><\/span><\/span><\/p> <ul> <li> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Photo release form for the cruising guests (from Carnival, see templates below)<\/span><\/span><\/span><\/span><\/li> <li> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Recipe cards (from Jules23, Vistaprint)<\/span><\/span><\/span><\/span><\/li> <\/ul> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span rel='lightbox'><img class='bbc_img' alt=\"DSC00228.JPG\" height=\"592\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747779\/width\/404\/height\/700\" style=\"width: 309px; height: 557px\" width=\"308\" \/><\/span><\/span><\/span><\/span><\/span><\/p> <ul> <li> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Keycard\/tip holder on lanyard (<span rel='lightbox'><img class='bbc_img' alt=\"photo 1.JPG\" height=\"347\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747781\/width\/600\/height\/448\" style=\"width: 444px; height: 312px\" width=\"489\" \/><\/span><\/span><\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">\u00a0<\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">\u00a0<\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Here's the whole welcome packet all put together:<\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">\u00a0<\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span rel='lightbox'><img class='bbc_img' alt=\"DSC00158.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747783\/width\/600\/height\/450\" \/><\/span>\u00a0<\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">\u00a0<\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span rel='lightbox'><img class='bbc_img' alt=\"DSC00159.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747785\/width\/600\/height\/450\" \/><\/span>\u00a0<\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">\u00a0<\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span rel='lightbox'><img class='bbc_img' alt=\"DSC00162.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747788\/width\/600\/height\/450\" \/><\/span><\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">\u00a0<\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span rel='lightbox'><img class='bbc_img' alt=\"DSC00161.JPG\" height=\"595\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747790\/width\/525\/height\/700\" style=\"width: 404px; height: 560px\" width=\"436\" \/><\/span><\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">\u00a0<\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">\u00a0<\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span id=\"cke_bm_51S\"  style=\"display: none\">\u00a0<\/span><em>To be continued...<\/em><span id=\"cke_bm_51E\"  style=\"display: none\">\u00a0<\/span><\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">\u00a0<\/span><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><p><span>Erica & Al - April 3, 2012 - St. Thomas, USVI<\/span><\/p><span><\/span><p><strong><span><em><a data-ipb='nomediaparse' href=\"http:\/\/www.bestdestinationwedding.com\/t\/78715\/aciretas-planning-journal-april-3-2012-cruise-wedding\">Planning Thread<\/a><\/em><\/span><\/strong><\/p><span><\/span><p><a data-ipb='nomediaparse' href=\"http:\/\/www.bestdestinationwedding.com\/t\/79320\/aciretas-wedding-ahr-pics\"><strong><span><em>Wedding & AHR Pics<\/em><\/span><\/strong><\/a><\/p><span><\/span><\/div><\/div>","Email":"ericataffs@gmail.com","IpAddress":"99.11.245.41","GroupId":47,"GroupName":"Site Supporter","JoinDate":1288602966,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-233628.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":197,"PhotoType":"custom"},"FormattedName":"acireta","Id":233628,"Name":"acireta","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":66214,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":3,"IsLiked":false,"PostKey":"81d8d6d727ad617f076d57b1e349d648","RawContent":"&lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span face=\"\"&gt;I included a few different bags with stuff for the guests in the OOT bags. Brandy\u00e2\u20ac\u2122s kit labels by Rebecca were a huge inspiration for the toppers for these kits. &lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;u&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span face=\"\"&gt;In Sickness and In Health \u00e2\u20ac\u201c Carnival Liberty\/St. Thomas Survival Kit&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/u&gt;&lt;\/p&gt; &lt;ul style=\"list-style-type: circle\"&gt; &lt;li&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span face=\"\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Dramamine (www.cheaptravelsizes.com)&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt; &lt;li&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span face=\"\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Advil (www.minimus.biz)&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt; &lt;li&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span face=\"\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Band-aids (www.minimus.biz)&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt; &lt;li&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span face=\"\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Neosporin (www.minimus.biz)&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt; &lt;li&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span face=\"\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Mints &amp;amp; gum (Dollar Tree) &lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt; &lt;li&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span face=\"\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Purell (Dollar Tree)&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt; &lt;li&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span face=\"\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Tissues (Other BDW brides)&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt; &lt;li&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span face=\"\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span face=\"\"&gt;Mustang soaps (stores.ebay.com\/silkybathnbody)&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt; &lt;li&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span face=\"\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Shout wipes (www.minimus.biz)&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt; &lt;\/ul&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;u&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span face=\"\"&gt;&lt;img alt=\"DSC00283.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747817\/width\/600\/height\/450\" \/&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/u&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;u&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span face=\"\"&gt;&lt;img alt=\"DSC00280.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747819\/width\/600\/height\/450\" \/&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/u&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;u&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span face=\"\"&gt;For Better or For Worse \u00e2\u20ac\u201c Sun, Sand &amp;amp; Fun Kit&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/u&gt;&lt;\/p&gt; &lt;ul style=\"list-style-type: circle\"&gt; &lt;li&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Sunscreen (www.cheaptravelsizes.com)&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt; &lt;li&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Aloe (www.cheaptravelsizes.com)&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt; &lt;li&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Chapsticks, inspired by Rebecca&#039;s design for Brandy&amp;nbsp;(Dollar Tree, shrinkwraps from &lt;img alt=\"photo 5.JPG\" height=\"366\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747825\/width\/600\/height\/461\" style=\"width: 382px; height: 271px\" width=\"502\" \/&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;ul style=\"list-style-type: circle\"&gt; &lt;li&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Flip-flop Playing cards (Oriental Trading)&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt; &lt;li&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Mini personal fans (Oriental Trading)&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt; &lt;\/ul&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"DSC00289.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747821\/width\/600\/height\/685\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"DSC00295.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747823\/width\/600\/height\/535\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;u&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span face=\"\"&gt;In Good Times and In Bad \u00e2\u20ac\u201c Live, Laugh, Love Kit&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/u&gt;&lt;\/p&gt; &lt;ul style=\"list-style-type: circle\"&gt; &lt;li&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Star Wars Pez (Amazon)&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt; &lt;li&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Personalized shotglasses (Discount Mugs)&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt; &lt;\/ul&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;img alt=\"DSC00313.JPG\" height=\"350\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747828\/width\/600\/height\/450\" style=\"width: 367px; height: 246px\" width=\"491\" \/&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;ul style=\"list-style-type: circle\"&gt; &lt;li&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Personalized guitar picks (www.claytoncustom.com)&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt; &lt;\/ul&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;img alt=\"DSC00306.JPG\" height=\"366\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747830\/width\/600\/height\/502\" style=\"width: 360px; height: 277px\" width=\"465\" \/&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;ul style=\"list-style-type: circle\"&gt; &lt;li&gt; Starfish wine stoppers (BDW bride a long time ago)&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt; &lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt;    &lt;\/ul&gt; &lt;p&gt; &lt;img alt=\"DSC00299.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747832\/width\/600\/height\/360\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"DSC00318.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747834\/width\/600\/height\/393\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;We included Sudoku\/wordsearch books (Dollar Tree) and cosmetics bags (dollar bins at Joann\u00e2\u20ac\u2122s Fabric). We got black pashminas for the ladies from Sears, bought on a day when they were ridiculously on sale. I printed the tags on shimmer cardstock and used blue ribbon to tie them.&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"DSC00176.JPG\" height=\"360\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747837\/width\/600\/height\/450\" width=\"517\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"DSC00175.JPG\" height=\"569\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747839\/width\/525\/height\/700\" style=\"width: 355px; height: 455px\" width=\"419\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;em&gt;To be continued...&amp;nbsp;&lt;\/em&gt;&lt;\/p&gt;","Attachments":[],"Id":1590203,"PostDate":1330900193,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span face=\"\">I included a few different bags with stuff for the guests in the OOT bags. Brandy\u00e2\u20ac\u2122s kit labels by Rebecca were a huge inspiration for the toppers for these kits. <\/span><\/span><\/span><\/p> <p> \u00a0<\/p> <p> <u><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span face=\"\">In Sickness and In Health \u00e2\u20ac\u201c Carnival Liberty\/St. Thomas Survival Kit<\/span><\/span><\/span><\/u><\/p> <ul style=\"list-style-type: circle\"> <li> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span face=\"\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Dramamine (www.cheaptravelsizes.com)<\/span><\/span><\/span><\/span><\/span><\/li> <li> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span face=\"\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Advil (www.minimus.biz)<\/span><\/span><\/span><\/span><\/span><\/li> <li> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span face=\"\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Band-aids (www.minimus.biz)<\/span><\/span><\/span><\/span><\/span><\/li> <li> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span face=\"\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Neosporin (www.minimus.biz)<\/span><\/span><\/span><\/span><\/span><\/li> <li> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span face=\"\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Mints & gum (Dollar Tree) <\/span><\/span><\/span><\/span><\/span><\/li> <li> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span face=\"\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Purell (Dollar Tree)<\/span><\/span><\/span><\/span><\/span><\/li> <li> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span face=\"\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Tissues (Other BDW brides)<\/span><\/span><\/span><\/span><\/span><\/li> <li> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span face=\"\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span face=\"\">Mustang soaps (stores.ebay.com\/silkybathnbody)<\/span><\/span><\/span><\/span><\/span><\/span><\/span><\/span><\/li> <li> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span face=\"\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Shout wipes (www.minimus.biz)<\/span><\/span><\/span><\/span><\/span><\/li> <\/ul> <p> \u00a0<\/p> <p> <u><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span face=\"\"><span rel='lightbox'><img class='bbc_img' alt=\"DSC00283.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747817\/width\/600\/height\/450\" \/><\/span><\/span><\/span><\/span><\/u><\/p> <p> \u00a0<\/p> <p> <u><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span face=\"\"><span rel='lightbox'><img class='bbc_img' alt=\"DSC00280.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747819\/width\/600\/height\/450\" \/><\/span><\/span><\/span><\/span><\/u><\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> <u><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span face=\"\">For Better or For Worse \u00e2\u20ac\u201c Sun, Sand & Fun Kit<\/span><\/span><\/span><\/u><\/p> <ul style=\"list-style-type: circle\"> <li> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Sunscreen (www.cheaptravelsizes.com)<\/span><\/span><\/li> <li> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Aloe (www.cheaptravelsizes.com)<\/span><\/span><\/li> <li> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Chapsticks, inspired by Rebecca's design for Brandy\u00a0(Dollar Tree, shrinkwraps from <span rel='lightbox'><img class='bbc_img' alt=\"photo 5.JPG\" height=\"366\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747825\/width\/600\/height\/461\" style=\"width: 382px; height: 271px\" width=\"502\" \/><\/span><\/span><\/p> <ul style=\"list-style-type: circle\"> <li> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Flip-flop Playing cards (Oriental Trading)<\/span><\/span><\/li> <li> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Mini personal fans (Oriental Trading)<\/span><\/span><\/li> <\/ul> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"DSC00289.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747821\/width\/600\/height\/685\" \/><\/span><\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"DSC00295.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747823\/width\/600\/height\/535\" \/><\/span><\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> <u><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span face=\"\">In Good Times and In Bad \u00e2\u20ac\u201c Live, Laugh, Love Kit<\/span><\/span><\/span><\/u><\/p> <ul style=\"list-style-type: circle\"> <li> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Star Wars Pez (Amazon)<\/span><\/span><\/li> <li> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Personalized shotglasses (Discount Mugs)<\/span><\/span><\/li> <\/ul> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span rel='lightbox'><img class='bbc_img' alt=\"DSC00313.JPG\" height=\"350\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747828\/width\/600\/height\/450\" style=\"width: 367px; height: 246px\" width=\"491\" \/><\/span><\/span><\/span><\/p> <ul style=\"list-style-type: circle\"> <li> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Personalized guitar picks (www.claytoncustom.com)<\/span><\/span><\/li> <\/ul> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span rel='lightbox'><img class='bbc_img' alt=\"DSC00306.JPG\" height=\"366\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747830\/width\/600\/height\/502\" style=\"width: 360px; height: 277px\" width=\"465\" \/><\/span><\/span><\/span><\/p> <ul style=\"list-style-type: circle\"> <li> Starfish wine stoppers (BDW bride a long time ago)<span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"> <\/span><\/span><\/li> \u00a0\u00a0 <\/ul> <p> <span rel='lightbox'><img class='bbc_img' alt=\"DSC00299.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747832\/width\/600\/height\/360\" \/><\/span><\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"DSC00318.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747834\/width\/600\/height\/393\" \/><\/span><\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">We included Sudoku\/wordsearch books (Dollar Tree) and cosmetics bags (dollar bins at Joann\u00e2\u20ac\u2122s Fabric). We got black pashminas for the ladies from Sears, bought on a day when they were ridiculously on sale. I printed the tags on shimmer cardstock and used blue ribbon to tie them.<\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"DSC00176.JPG\" height=\"360\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747837\/width\/600\/height\/450\" width=\"517\" \/><\/span><\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"DSC00175.JPG\" height=\"569\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747839\/width\/525\/height\/700\" style=\"width: 355px; height: 455px\" width=\"419\" \/><\/span><\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> <em>To be continued...\u00a0<\/em><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><p><span>Erica & Al - April 3, 2012 - St. Thomas, USVI<\/span><\/p><span><\/span><p><strong><span><em><a data-ipb='nomediaparse' href=\"http:\/\/www.bestdestinationwedding.com\/t\/78715\/aciretas-planning-journal-april-3-2012-cruise-wedding\">Planning Thread<\/a><\/em><\/span><\/strong><\/p><span><\/span><p><a data-ipb='nomediaparse' href=\"http:\/\/www.bestdestinationwedding.com\/t\/79320\/aciretas-wedding-ahr-pics\"><strong><span><em>Wedding & AHR Pics<\/em><\/span><\/strong><\/a><\/p><span><\/span><\/div><\/div>","Email":"ericataffs@gmail.com","IpAddress":"99.11.245.41","GroupId":47,"GroupName":"Site Supporter","JoinDate":1288602966,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-233628.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":197,"PhotoType":"custom"},"FormattedName":"acireta","Id":233628,"Name":"acireta","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":66214,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":3,"IsLiked":false,"PostKey":"42ef9548abcc78311cb561626befcbdc","RawContent":"&lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;I put in a bunch of extras for our parents and bridesmaids.&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span face=\"\"&gt;For my mom and stepdad, MOB hat and totebag and Team Bride shirt for my stepdad (Vistaprint)&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;img alt=\"DSC00192.JPG\" height=\"393\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747857\/width\/600\/height\/450\" width=\"549\" \/&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span face=\"\"&gt;For Al\u00e2\u20ac\u2122s mom, Mother of the Groom shirt and Carnival Liberty totebag (Vistaprint)&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;img alt=\"DSC00193.JPG\" height=\"388\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747859\/width\/600\/height\/450\" width=\"550\" \/&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Extras for my bridesmaids:&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;ul style=\"list-style-type: circle\"&gt; &lt;li&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Bridesmaids shirts with nicknames on the back (Target, Michaels)&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt; &lt;\/ul&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;img alt=\"DSC00064.JPG\" height=\"338\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747864\/width\/600\/height\/450\" style=\"width: 438px; height: 299px\" width=\"474\" \/&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;ul style=\"list-style-type: circle\"&gt; &lt;li&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Flip-flops for wedding day (Old Navy)&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt; &lt;li&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Bridesmaids cosmetics bags (Michaels)&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt; &lt;li&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Monogrammed jewelry rolls (David\u00e2\u20ac\u2122s Bridal)&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt; &lt;\/ul&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;img alt=\"jewelry pouch outer.jpg\" height=\"195\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747868\/width\/600\/height\/225\" width=\"551\" \/&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;ul style=\"list-style-type: circle\"&gt; &lt;li&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Notebooks and monogrammed post-it notes&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt; &lt;\/ul&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Bridesmaids&#039; stuff all together:&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"bridesmaids packages.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747871\/width\/600\/height\/237\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Finally ready to start packing the bags!&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"DSC00328.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747875\/width\/600\/height\/450\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; The Total Package&amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"DSC00333.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747877\/width\/600\/height\/450\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;em&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Templates and pricing coming up!&lt;\/span&gt;&lt;\/span&gt;&lt;\/em&gt;&lt;\/p&gt;","Attachments":[],"Id":1590206,"PostDate":1330901565,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">I put in a bunch of extras for our parents and bridesmaids.<\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span face=\"\">For my mom and stepdad, MOB hat and totebag and Team Bride shirt for my stepdad (Vistaprint)<\/span><\/span><\/span><\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span rel='lightbox'><img class='bbc_img' alt=\"DSC00192.JPG\" height=\"393\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747857\/width\/600\/height\/450\" width=\"549\" \/><\/span><\/span><\/span><\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span face=\"\">For Al\u00e2\u20ac\u2122s mom, Mother of the Groom shirt and Carnival Liberty totebag (Vistaprint)<\/span><\/span><\/span><\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span rel='lightbox'><img class='bbc_img' alt=\"DSC00193.JPG\" height=\"388\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747859\/width\/600\/height\/450\" width=\"550\" \/><\/span><\/span><\/span><\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Extras for my bridesmaids:<\/span><\/span><\/p> <ul style=\"list-style-type: circle\"> <li> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Bridesmaids shirts with nicknames on the back (Target, Michaels)<\/span><\/span><\/span><\/span><\/li> <\/ul> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span rel='lightbox'><img class='bbc_img' alt=\"DSC00064.JPG\" height=\"338\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747864\/width\/600\/height\/450\" style=\"width: 438px; height: 299px\" width=\"474\" \/><\/span><\/span><\/span><\/span><\/span><\/p> <ul style=\"list-style-type: circle\"> <li> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Flip-flops for wedding day (Old Navy)<\/span><\/span><\/span><\/span><\/li> <li> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Bridesmaids cosmetics bags (Michaels)<\/span><\/span><\/span><\/span><\/li> <li> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Monogrammed jewelry rolls (David\u00e2\u20ac\u2122s Bridal)<\/span><\/span><\/span><\/span><\/li> <\/ul> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span rel='lightbox'><img class='bbc_img' alt=\"jewelry pouch outer.jpg\" height=\"195\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747868\/width\/600\/height\/225\" width=\"551\" \/><\/span><\/span><\/span><\/span><\/span><\/p> <ul style=\"list-style-type: circle\"> <li> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Notebooks and monogrammed post-it notes<\/span><\/span><\/span><\/span><\/li> <\/ul> <p> \u00a0<\/p> <p> Bridesmaids' stuff all together:<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"bridesmaids packages.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747871\/width\/600\/height\/237\" \/><\/span><\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> Finally ready to start packing the bags!<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"DSC00328.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747875\/width\/600\/height\/450\" \/><\/span><\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> The Total Package\u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"DSC00333.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/747877\/width\/600\/height\/450\" \/><\/span><\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> <em><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Templates and pricing coming up!<\/span><\/span><\/em><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><p><span>Erica & Al - April 3, 2012 - St. Thomas, USVI<\/span><\/p><span><\/span><p><strong><span><em><a data-ipb='nomediaparse' href=\"http:\/\/www.bestdestinationwedding.com\/t\/78715\/aciretas-planning-journal-april-3-2012-cruise-wedding\">Planning Thread<\/a><\/em><\/span><\/strong><\/p><span><\/span><p><a data-ipb='nomediaparse' href=\"http:\/\/www.bestdestinationwedding.com\/t\/79320\/aciretas-wedding-ahr-pics\"><strong><span><em>Wedding & AHR Pics<\/em><\/span><\/strong><\/a><\/p><span><\/span><\/div><\/div>","Email":"ericataffs@gmail.com","IpAddress":"99.11.245.41","GroupId":47,"GroupName":"Site Supporter","JoinDate":1288602966,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-233628.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":197,"PhotoType":"custom"},"FormattedName":"acireta","Id":233628,"Name":"acireta","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":66214,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"517e00ae07b0b3dee4d7db4df6b5245b","RawContent":"&lt;p&gt; &lt;u&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Price Breakdown&lt;\/span&gt;&lt;\/span&gt;&lt;\/u&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Totebags - $2.89&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Keycard\/tip holder and lanyard - $.70&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Sudoku\/word search book - $1&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Dramamine - $1.29&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Advil - $.44&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Band-aids - $1.25&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Neosporin - $.69&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Mints &amp;amp; gum - $.58&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Purell - $.33&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Tissues - $.25&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Shout wipes - $.39&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Mustang soaps - $.40&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Sunscreen - $1.79&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Aloe - $.99&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Chapstick and shrink wrap - $.55&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Flip-flop Playing cards - $.67&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Mini personal fan and batteries - $1.50 &lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Star Wars Pez - $1.92&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Starfish wine stopper - $3&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Personalized shotglass - $2.77&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Personalized guitar picks - $.15 (5 picks per bag)&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Pashmina - $4.95&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Cosmetics bag - $.50&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Everything from Vistaprint was free&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Not including paper for kit toppers\/folders, ribbon, BM extras and shipping costs, these worked out to $29 per bag, give or take a buck or two for doubling lanyards, soaps and chapsticks in the couples\u00e2\u20ac\u2122 bags. We only had to make 12, so it was perfect for our budget.&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;I know I went a bit overboard with the pictures, but this thread has really helped me to get organized. I cannot wait to give these bags to our guests at dinner on the first night of the cruise!!&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1590209,"PostDate":1330902011,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <u><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Price Breakdown<\/span><\/span><\/u><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Totebags - $2.89<\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Keycard\/tip holder and lanyard - $.70<\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Sudoku\/word search book - $1<\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Dramamine - $1.29<\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Advil - $.44<\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Band-aids - $1.25<\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Neosporin - $.69<\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Mints & gum - $.58<\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Purell - $.33<\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Tissues - $.25<\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Shout wipes - $.39<\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Mustang soaps - $.40<\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Sunscreen - $1.79<\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Aloe - $.99<\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Chapstick and shrink wrap - $.55<\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Flip-flop Playing cards - $.67<\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Mini personal fan and batteries - $1.50 <\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Star Wars Pez - $1.92<\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Starfish wine stopper - $3<\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Personalized shotglass - $2.77<\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Personalized guitar picks - $.15 (5 picks per bag)<\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Pashmina - $4.95<\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Cosmetics bag - $.50<\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Everything from Vistaprint was free<\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Not including paper for kit toppers\/folders, ribbon, BM extras and shipping costs, these worked out to $29 per bag, give or take a buck or two for doubling lanyards, soaps and chapsticks in the couples\u00e2\u20ac\u2122 bags. We only had to make 12, so it was perfect for our budget.<\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">I know I went a bit overboard with the pictures, but this thread has really helped me to get organized. I cannot wait to give these bags to our guests at dinner on the first night of the cruise!!<\/span><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><p><span>Erica & Al - April 3, 2012 - St. Thomas, USVI<\/span><\/p><span><\/span><p><strong><span><em><a data-ipb='nomediaparse' href=\"http:\/\/www.bestdestinationwedding.com\/t\/78715\/aciretas-planning-journal-april-3-2012-cruise-wedding\">Planning Thread<\/a><\/em><\/span><\/strong><\/p><span><\/span><p><a data-ipb='nomediaparse' href=\"http:\/\/www.bestdestinationwedding.com\/t\/79320\/aciretas-wedding-ahr-pics\"><strong><span><em>Wedding & AHR Pics<\/em><\/span><\/strong><\/a><\/p><span><\/span><\/div><\/div>","Email":"ericataffs@gmail.com","IpAddress":"99.11.245.41","GroupId":47,"GroupName":"Site Supporter","JoinDate":1288602966,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-233628.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":197,"PhotoType":"custom"},"FormattedName":"acireta","Id":233628,"Name":"acireta","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":66214,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"98395c91d0c8adf9c3223c72315d02e2","RawContent":"&lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;span huddler_attributes=\"{&amp;quot;plugin&amp;quot;:&amp;quot;attachment&amp;quot;,&amp;quot;params&amp;quot;:{&amp;quot;id&amp;quot;:&amp;quot;11543&amp;quot;,&amp;quot;name&amp;quot;:&amp;quot;w