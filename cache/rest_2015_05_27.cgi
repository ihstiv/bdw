PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Wafflesmom","Id":279721,"Name":"Wafflesmom","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.85.127.174","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79157,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"023274c70443aa0b927e4ac40efb859e","RawContent":"&lt;p&gt;Tough call! I think I like #2 a bit better, but I tend to like simpler dresses. More my style, which doesn&#039;t mean it is yours.&amp;nbsp; :) They are both beautiful.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1895600,"PostDate":1430969912,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Tough call! I think I like #2 a bit better, but I tend to like simpler dresses. More my style, which doesn't mean it is yours.\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> They are both beautiful.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>- Erin<\/p>\n<p>\u00a0<\/p>\n<p>My planning thread:\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268'>http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268<\/a>","Email":"ekjzwedding@gmail.com","IpAddress":"24.85.127.174","GroupId":40,"GroupName":"Jr. Member","JoinDate":1417449445,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281283.jpg?_r=1428779369","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"vancouverpetunia","Id":281283,"Name":"vancouverpetunia","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"158.82.202.5","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79157,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"648b3ce4e32ce718effbc9c83d19704e","RawContent":"&lt;p&gt;Wow, you look amazing in both and I really think you can&#039;t go wrong with either.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;m partial to lace usually, but something about the way the second dress fits on you is making me pick that dress... I think it&#039;s the smoother visual line where the dress flares out at the bottom.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I think dress #2 with a sparkly belt like you have on dress #1 would make it look less \"plain\" since you were worried about that.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1895602,"PostDate":1430970314,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Wow, you look amazing in both and I really think you can't go wrong with either.<\/p>\n<p>\u00a0<\/p>\n<p>I'm partial to lace usually, but something about the way the second dress fits on you is making me pick that dress... I think it's the smoother visual line where the dress flares out at the bottom.<\/p>\n<p>\u00a0<\/p>\n<p>I think dress #2 with a sparkly belt like you have on dress #1 would make it look less \"plain\" since you were worried about that.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div>\u00a0<\/div>\n<div>\u00a0<\/div>\n<div><a class='bbc_url' href='http:\/\/www.TickerFactory.com\/'><\/div>\n<div><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;6\/st\/20160409\/e\/our+Wedding+Day\/k\/a16a\/event.png\" alt=\"event.png\"><\/div>\n<div><\/a><\/div>\n<div>\u00a0<\/div>\n","Email":"krystalball@gmail.com","IpAddress":"158.82.202.5","GroupId":39,"GroupName":"Newbie","JoinDate":1421864163,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281820.jpg?_r=1429976010","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"facebook"},"FormattedName":"krystalball","Id":281820,"Name":"krystalball","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79157,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"f060ce8d2d842873486280c997b7daa5","RawContent":"&lt;p&gt;Both are beautiful gowns. Love the lace one with the tiered skirt!&lt;\/p&gt;","Attachments":[],"Id":1895608,"PostDate":1431002930,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Both are beautiful gowns. Love the lace one with the tiered skirt!<\/p>\n\r\n 