{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":85,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":true,"Views":5518,"MovedTo":null,"MovedOn":0,"FirstPostId":1834002,"Rating":0,"RatingHits":0,"Starter":{"Id":276272,"Name":"CurlyKristen","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276272.jpg?_r=1423510309","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"IsOnline":false},"StartDate":1392587102,"LastPoster":{"Id":282430,"Name":"IzzyDeee","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282430.jpg?_r=1426462827","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":33,"Preview":{"Id":1834002,"PostDate":1392587102,"PostContent":"Please give your advice! Should I plan to wear a veil at our beach wedding or not? I am worried i...","Author":{"Signature":"","Email":"kristennicole20040@gmail.com","IpAddress":"72.197.155.252","GroupId":40,"GroupName":"Jr. Member","JoinDate":1390423743,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276272.jpg?_r=1423510309","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"CurlyKristen","Id":276272,"Name":"CurlyKristen","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.197.201.69","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76383,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"5657f51fc15d618b0afab7f764dd0ee3","RawContent":"&lt;p&gt;&lt;span style=\"font-family:&#039;comic sans ms&#039;, cursive;\"&gt;Please give your advice! Should I plan to wear a veil at our beach wedding or not? I am worried it will get a lil crazy with the wind at the ceremony on the beach but I do really like the pictures with the bride and groom kissing under the veil. &lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1834002,"PostDate":1392587102,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span  style=\"font-family:'comic sans ms', cursive;\">Please give your advice! Should I plan to wear a veil at our beach wedding or not? I am worried it will get a lil crazy with the wind at the ceremony on the beach but I do really like the pictures with the bride and groom kissing under the veil. <\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kristennicole20040@gmail.com","IpAddress":"72.197.155.252","GroupId":40,"GroupName":"Jr. Member","JoinDate":1390423743,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276272.jpg?_r=1423510309","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"CurlyKristen","Id":276272,"Name":"CurlyKristen","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.249.122.85","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76383,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8de74901b96c7257bb19f9d2d60b7bea","RawContent":"&lt;p&gt;I&#039;m wondering the same thing actually! You could always get a veil and just wear it for pictures afterwards?&lt;\/p&gt;","Attachments":[],"Id":1834010,"PostDate":1392588038,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I'm wondering the same thing actually! You could always get a veil and just wear it for pictures afterwards?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kelly_miller_@hotmail.com","IpAddress":"99.249.122.85","GroupId":40,"GroupName":"Jr. Member","JoinDate":1390772931,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kellymiller","Id":276338,"Name":"kellymiller","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.197.201.69","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76383,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"24822fb325e0dbcb9df9fac83f7b410d","RawContent":"&lt;p&gt;Yeah I think you&#039;re right, maybe just use it like a photo prop. Just have to keep cost in mind if it&#039;s only for pictures :) Thanks!&lt;\/p&gt;","Attachments":[],"Id":1834022,"PostDate":1392588912,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Yeah I think you're right, maybe just use it like a photo prop. Just have to keep cost in mind if it's only for pictures <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> Thanks!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kristennicole20040@gmail.com","IpAddress":"72.197.155.252","GroupId":40,"GroupName":"Jr. Member","JoinDate":1390423743,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276272.jpg?_r=1423510309","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"CurlyKristen","Id":276272,"Name":"CurlyKristen","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"184.64.53.132","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76383,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3c2100b548f19ef7e6e718c2f2d6b290","RawContent":"[quote name=\"kellymiller\" post=\"1834010\" timestamp=\"1392588038\"]\nI&#039;m wondering the same thing actually! You could always get a veil and just wear it for pictures afterwards?[\/quote]@[member=\"kellymiller\"] you read my mind! If you don&#039;t want it for the ceremony, then use it for photos! I think a veil can make for beautiful pictures, and a fun prop!","Attachments":[],"Id":1834048,"PostDate":1392601665,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>kellymiller, on 16 February 2014 - 02:00 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>I'm wondering the same thing actually! You could always get a veil and just wear it for pictures afterwards?<\/p>\n<\/div>\n<\/div><\/div>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"276338\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/276338-kellymiller\/' title='Member profile'><span itemprop=\"name\">kellymiller<\/span><\/a> you\u00a0read my mind!\u00a0If you don't want it for the ceremony, then use it for photos! I think a veil can make for beautiful pictures, and a fun prop!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jackieshaynewedding@gmail.com","IpAddress":"184.64.43.144","GroupId":40,"GroupName":"Jr. Member","JoinDate":1369770017,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270054.jpg?_r=1391705350","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"jackshayne0123","Id":270054,"Name":"jackshayne0123","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.185.207.107","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76383,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"067b4e6aa98710e484cb625afe417447","RawContent":"&lt;p&gt;I&#039;m not doing a veil as I&#039;m worried about the wind too. It&#039;s the same thing as hair up\/down? I love the outdoors and am so excited about my beach wedding, but there will always be a sea breeze.&lt;\/p&gt;","Attachments":[],"Id":1834051,"PostDate":1392603450,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I'm not doing a veil as I'm worried about the wind too. It's the same thing as hair up\/down? I love the outdoors and am so excited about my beach wedding, but there will always be a sea breeze.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cd_rain79@yahoo.com","IpAddress":"68.185.207.107","GroupId":40,"GroupName":"Jr. Member","JoinDate":1384727619,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275126.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Rainmaker","Id":275126,"Name":"Rainmaker","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.181.5.152","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76383,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":4,"IsLiked":false,"PostKey":"d4b677d9418d794f064bf42998ad701c","RawContent":"I was thinking about wearing a birdcage veil, so it still looks cute, but too short to blow crazy in the wind.","Attachments":[],"Id":1834059,"PostDate":1392605491,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I was thinking about wearing a birdcage veil, so it still looks cute, but too short to blow crazy in the wind. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"pinkiesup08@gmail.com","IpAddress":"75.181.5.152","GroupId":47,"GroupName":"Site Supporter","JoinDate":1374614124,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-271841.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"RandL2015","Id":271841,"Name":"RandL2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.222.63.146","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76383,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"06ec29f6c06a84111a23846680d7bcca","RawContent":"&lt;p&gt;I was debating between this as well. A friend of mine gave me a veil she didn&#039;t end up wearing for her wedding, so my plan is to take it and wear it; however, if it ends up being too windy, I just won&#039;t wear it. I have a large flower I am going to wear in my hair with (or without the veil). I am hoping it won&#039;t be too windy though as I do love the look of a veil, but I don&#039;t want to be distracted by it throughout the ceremony.&lt;\/p&gt;","Attachments":[],"Id":1834133,"PostDate":1392654604,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I was debating between this as well. A friend of mine gave me a veil she didn't end up wearing for her wedding, so my plan is to take it and wear it; however, if it ends up being too windy, I just won't wear it. I have a large flower I am going to wear in my hair with (or without the veil). I am hoping it won't be too windy though as I do love the look of a veil, but I don't want to be distracted by it throughout the ceremony.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Happily Married!<\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/74669-destination-engagement-photos-dubrovnik-croatia\/?hl=%2Bcroatia+%2Bengagement+%2Bphotos'>http:\/\/www.bestdestinationwedding.com\/topic\/74669-destination-engagement-photos-dubrovnik-croatia\/?hl=%2Bcroatia+%2Bengagement+%2Bphotos<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/76346-carinas-csho-iberostar-laguna-azul-planning-journal-050514\/'>http:\/\/www.bestdestinationwedding.com\/topic\/76346-carinas-csho-iberostar-laguna-azul-planning-journal-050514\/<\/a>","Email":"crins_15@hotmail.com","IpAddress":"24.222.63.146","GroupId":42,"GroupName":"Sr. Member","JoinDate":1351780968,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-261965.jpg?_r=1400781457","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"csho","Id":261965,"Name":"csho","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.92.141.111","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76383,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"7ac590aeebab313f990ebf1584dd070b","RawContent":"&lt;p&gt;I found veil weights on Pinterest by savetheveil.com, I&#039;m thinking about using them myself haven&#039;t made a final decision though, &amp;nbsp;might be a good option if the wind is too bad.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1834288,"PostDate":1392685711,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I found veil weights on Pinterest by savetheveil.com, I'm thinking about using them myself haven't made a final decision though, \u00a0might be a good option if the wind is too bad.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"srw69@sbcglobal.net","IpAddress":"207.8.149.178","GroupId":47,"GroupName":"Site Supporter","JoinDate":1354720545,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-262964.jpeg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"CDC-SRW","Id":262964,"Name":"CDC-SRW","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.197.201.69","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76383,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bf503df4e5f0fc6d796405964b1678b5","RawContent":"&lt;p&gt;@[member=\"CDC-SRW\"] I didn&#039;t even know they made veil weights!&lt;\/p&gt;","Attachments":[],"Id":1834350,"PostDate":1392731312,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"262964\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/262964-cdc-srw\/' title='Member profile'><span itemprop=\"name\">CDC-SRW<\/span><\/a> I didn't even know they made veil weights!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kristennicole20040@gmail.com","IpAddress":"72.197.155.252","GroupId":40,"GroupName":"Jr. Member","JoinDate":1390423743,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276272.jpg?_r=1423510309","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"CurlyKristen","Id":276272,"Name":"CurlyKristen","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.177.132.210","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76383,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"5028f3cd9164494202d7344a0eaab855","RawContent":"&lt;p&gt;yes they do, mostly in a silver finish with a silver stone, some pale shades but they are meant to be seen so they worked fine.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;My mom really wanted me to wear a veil so I wore one and was actually happy I did.&amp;nbsp; It completed the look.&amp;nbsp; I took it off mid way through pictures for a little bit of a different look.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;The weights really made a difference.&lt;\/p&gt;","Attachments":[],"Id":1834461,"PostDate":1392763687,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>yes they do, mostly in a silver finish with a silver stone, some pale shades but they are meant to be seen so they worked fine.<\/p>\n<p>\u00a0<\/p>\n<p>My mom really wanted me to wear a veil so I wore one and was actually happy I did.\u00a0 It completed the look.\u00a0 I took it off mid way through pictures for a little bit of a different look.<\/p>\n<p>\u00a0<\/p>\n<p>The weights really made a difference.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mvee1025@gmail.com","IpAddress":"99.177.132.210","GroupId":40,"GroupName":"Jr. Member","JoinDate":1359865300,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265570.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"mvee1025","Id":265570,"Name":"mvee1025","IsOnline":false}}],"Id":"76383","Title":"Veil Vs No Veil For Beach Wedding?","LastPostDate":1432584632},"Pages":{"TotalItems":85,"TotalPages":9,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":80},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
