{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":2,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":351,"MovedTo":null,"MovedOn":0,"FirstPostId":1910496,"Rating":0,"RatingHits":0,"Starter":{"Id":284804,"Name":"kdepass2","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1454551362,"LastPoster":{"Id":282406,"Name":"Lisa35","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282406.jpg?_r=1426179017","PhotoWidth":177,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":23,"Preview":{"Id":1910496,"PostDate":1454551362,"PostContent":"Hi ladies, \u00a0 All the posts I see are in the past and I need some NEW and up-to-date info. \u00a0 Looki...","Author":{"Signature":"","Email":"kdepass2@gmail.com","IpAddress":"208.73.76.65","GroupId":39,"GroupName":"Newbie","JoinDate":1442201669,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kdepass2","Id":284804,"Name":"kdepass2","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.228.101.80","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79921,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d8a174afcdceabe9333886708410ff8f","RawContent":"&lt;p&gt;Hi ladies,&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;All the posts I see are in the past and I need some NEW and up-to-date info.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Looking to get married at GP in Jamaica during the week of October 24-28 (awaiting wedding coordinator to confirm a date).&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We are looking to use the Palladium Sapphire Package. We would be having more than 25 guests..(more like 50) and want to do a private reception at Blue Lagoon. Does any know the additional costs for these and the menus that are served for private events?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Getting excited. We have been through so many ups and downs trying to choose a resort for our wedding but we PRAYING this is \"the one\"&lt;\/p&gt;","Attachments":[],"Id":1910496,"PostDate":1454551362,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi ladies,<\/p>\n<p>\u00a0<\/p>\n<p>All the posts I see are in the past and I need some NEW and up-to-date info.<\/p>\n<p>\u00a0<\/p>\n<p>Looking to get married at GP in Jamaica during the week of October 24-28 (awaiting wedding coordinator to confirm a date).<\/p>\n<p>\u00a0<\/p>\n<p>We are looking to use the Palladium Sapphire Package. We would be having more than 25 guests..(more like 50) and want to do a private reception at Blue Lagoon. Does any know the additional costs for these and the menus that are served for private events?<\/p>\n<p>\u00a0<\/p>\n<p>Getting excited. We have been through so many ups and downs trying to choose a resort for our wedding but we PRAYING this is \"the one\"<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kdepass2@gmail.com","IpAddress":"208.73.76.65","GroupId":39,"GroupName":"Newbie","JoinDate":1442201669,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kdepass2","Id":284804,"Name":"kdepass2","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.15.166.172","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79921,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a0d646bb8577d6bb1feab5cc552d6f96","RawContent":"&lt;p&gt;Weren&#039;t your getting married at the Royalton White Sands? Did you end up switching?&lt;\/p&gt;","Attachments":[],"Id":1910612,"PostDate":1454954923,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Weren't your getting married at the Royalton White Sands? Did you end up switching?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>The Future Mrs. Rodrigues","Email":"lisapereira11@hotmail.com","IpAddress":"74.15.166.172","GroupId":39,"GroupName":"Newbie","JoinDate":1426176386,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282406.jpg?_r=1426179017","PhotoWidth":177,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Lisa35","Id":282406,"Name":"Lisa35","IsOnline":false}}],"Id":"79921","Title":"Grand Palladium Wedding 2016","LastPostDate":1454954923},"Pages":{"TotalItems":2,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
