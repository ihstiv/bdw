{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":46,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":13709,"MovedTo":null,"MovedOn":0,"FirstPostId":2671,"Rating":0,"RatingHits":0,"Starter":{"Id":206696,"Name":"TammyWright","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"IsOnline":false},"StartDate":1160353627,"LastPoster":{"Id":279711,"Name":"Bride2b15","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279711.jpg?_r=1410256327","PhotoWidth":200,"PhotoHeight":125,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":57,"Preview":{"Id":2671,"PostDate":1160353627,"PostContent":"source: www.goarticles.com  Destination weddings to Hawaii, the Bahamas, the Virgin Islands, Maui...","Author":{"Signature":"<p><span style=\"font-family:arial, helvetica, sans-serif;\">Founder and Owner of BestDestinationWedding.com \u00a0\/ \u00a0<\/span><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/'><strong><span style=\"font-family:arial, helvetica, sans-serif;\">Bride & Groom Fly FREE Promotion<\/span><\/strong><\/a><\/p>\n<p>\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><strong><a data-ipb='nomediaparse' href='http:\/\/wrighttravelagency.com\/inquiry\/'><span style=\"color:#008080;\">Looking for a travel agency that specializes in Destination Weddings<\/span><\/a><\/strong><span style=\"color:#008080;\"><strong>?<\/strong> \u00a0We are an award winning travel agency and you can <\/span><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style=\"color:#008080;\">read our reviews\u00a0here.<\/span><\/a><\/strong><\/span><br>\n\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"color:#008080;\"><strong>Awards and recognition:\u00a0<\/strong><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Palace Resorts Winner \"Top Travel Agent\", \"Top Homebased Travel Agency\" PRO Platinum Agency (Top Award) \u00a0 \u00a0 | \u00a0 \u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">AMResorts Master Agent & Top Agency \u00a0<\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/68050-karisma-hotels-givc-and-gi-wedding-consultants-wright-travel-agency\/'><strong>Wright Travel & Karisma GIVC Benefits<\/strong><\/a><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Travel Impressions Best of the Best Globe Winner \u00a0 \u00a0| \u00a0 \u00a0\u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Apple Vacations Golden Apple Winner \u00a0<\/span><\/span><br><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17612\/sml_gallery_206696_17612_13451.png\" alt=\"sml_gallery_206696_17612_13451.png\"><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"> \u00a0 \u00a0<img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"font-size:14px;\"><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010'>Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><\/span><\/span><strong><span style=\"color:#b22222;\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a data-ipb='nomediaparse' href='mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com'>ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"admin@bestdestinationwedding.com","IpAddress":"71.202.225.11","GroupId":4,"GroupName":"Administrators","JoinDate":1137224220,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"FormattedName":"TammyWright","Id":206696,"Name":"TammyWright","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":390,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"c15473408b5c8051cc8b314170b84ba7","RawContent":"source: &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.goarticles.com\"&gt;www.goarticles.com&lt;\/a&gt;\n \n Destination weddings to Hawaii, the Bahamas, the Virgin Islands, Maui, Jamaica and more are becoming more and more popular as destination wedding planning online has become easier and easier. The beach is the most popular destination wedding theme these days and many brides want to start their wedding theme off right with a beautiful beach theme wedding invitation.\n \n Many beach wedding invitation sites like BeachWedlockInvitations.com exist to offer hundreds of beach wedding invitations, but beach brides aren&#039;t worried about finding the right beach invitation as much as they are worried about their beach wedding invitation wording.\n \n Every bride wants her wedding to be unique and her wedding invitation is no different. Finding the perfect beach wedding invitation wording is as important as finding the perfect beach wedding invitation itself, so here are 5 beach wedding invitation wording tips.\n \n 1. Know yourself and your spouse to be - Your beach invitation wording should reflect you and your future spouses personalities, love and quirkiness ... yes, quirkiness. Wedding invitations have been done for millions of years, if you want to be original, you are going to have to capture what makes you and your beach love different than other couples.\n \n 2. There is no wrong wording - Certain wedding invitation wording ethics exist, but most people don&#039;t know them and wouldn&#039;t notice if you went according to the rules or not. Besides, more and more brides and grooms are throwing the rules to the wind these days and just writing what they want. Don&#039;t worry about trying to follow all the rules. The reason you&#039;re probably having a beach wedding is because you didn&#039;t want the traditional wedding ceremony anyway, so have your beach wedding invitation reflect the same free flowing spirit that the beach has.\n \n 3. Know your audience - Even though we just mentioned that your beach wedding invitation wording should be about you and your future beach spouse by placing your quirkiness in your beach invitation wording, remember who your audience is. If you are sending this invitation to an 80-year-old grandma, you probably don&#039;t want to use profanity or other inappropriate language.\n \n 4. Beach phrases - Find a single beach phrase that fits you and your spouse but also suits the beach setting you will be married in. &amp;quot;Once upon a time on a beach ...&amp;quot; or &amp;quot;What happens on the beach ... stays in our hearts,&amp;quot; are just some examples. More examples can be found at BeachWedlockInvitations.com.\n \n 5. Match your wording to your invitation - Simple beach weddings with simple beach themes should have simple beach wedding invitation themes as well. A beach wedding with 10 - 50 people is an intimate setting and the invitations should reflect that. Don&#039;t bog down the wording with a 20 line poem to begin the invitation. A beach wedding with over 500 people can be reason for the 20 line poem.\n \n Good luck with your beach weddings, your beach wedding invitations, and your beach wedding invitation wording. To see the most beach wedding invitations in the world on one Web site go to: BeachWedlockInvitations.com.\n \n Renae C. Judkins is the owner of the largest Web site for beach themed wedding invitations in the world, &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.BeachWedlockInvitations.com\"&gt;www.BeachWedlockInvitations.com&lt;\/a&gt;.\n \n \n About the Author\n Renae C. Judkins is the owner of the largest Web site for beach themed wedding invitations in the world, &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.BeachWedlockInvitations.com\"&gt;www.BeachWedlockInvitations.com&lt;\/a&gt;.","Attachments":[],"Id":2671,"PostDate":1160353627,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                source: <a href='http:\/\/www.goarticles.com' class='bbc_url' title='External link' rel='nofollow external'>www.goarticles.com<\/a><br \/> <br \/> Destination weddings to Hawaii, the Bahamas, the Virgin Islands, Maui, Jamaica and more are becoming more and more popular as destination wedding planning online has become easier and easier. The beach is the most popular destination wedding theme these days and many brides want to start their wedding theme off right with a beautiful beach theme wedding invitation.<br \/> <br \/> Many beach wedding invitation sites like BeachWedlockInvitations.com exist to offer hundreds of beach wedding invitations, but beach brides aren't worried about finding the right beach invitation as much as they are worried about their beach wedding invitation wording.<br \/> <br \/> Every bride wants her wedding to be unique and her wedding invitation is no different. Finding the perfect beach wedding invitation wording is as important as finding the perfect beach wedding invitation itself, so here are 5 beach wedding invitation wording tips.<br \/> <br \/> 1. Know yourself and your spouse to be - Your beach invitation wording should reflect you and your future spouses personalities, love and quirkiness ... yes, quirkiness. Wedding invitations have been done for millions of years, if you want to be original, you are going to have to capture what makes you and your beach love different than other couples.<br \/> <br \/> 2. There is no wrong wording - Certain wedding invitation wording ethics exist, but most people don't know them and wouldn't notice if you went according to the rules or not. Besides, more and more brides and grooms are throwing the rules to the wind these days and just writing what they want. Don't worry about trying to follow all the rules. The reason you're probably having a beach wedding is because you didn't want the traditional wedding ceremony anyway, so have your beach wedding invitation reflect the same free flowing spirit that the beach has.<br \/> <br \/> 3. Know your audience - Even though we just mentioned that your beach wedding invitation wording should be about you and your future beach spouse by placing your quirkiness in your beach invitation wording, remember who your audience is. If you are sending this invitation to an 80-year-old grandma, you probably don't want to use profanity or other inappropriate language.<br \/> <br \/> 4. Beach phrases - Find a single beach phrase that fits you and your spouse but also suits the beach setting you will be married in. \"Once upon a time on a beach ...\" or \"What happens on the beach ... stays in our hearts,\" are just some examples. More examples can be found at BeachWedlockInvitations.com.<br \/> <br \/> 5. Match your wording to your invitation - Simple beach weddings with simple beach themes should have simple beach wedding invitation themes as well. A beach wedding with 10 - 50 people is an intimate setting and the invitations should reflect that. Don't bog down the wording with a 20 line poem to begin the invitation. A beach wedding with over 500 people can be reason for the 20 line poem.<br \/> <br \/> Good luck with your beach weddings, your beach wedding invitations, and your beach wedding invitation wording. To see the most beach wedding invitations in the world on one Web site go to: BeachWedlockInvitations.com.<br \/> <br \/> Renae C. Judkins is the owner of the largest Web site for beach themed wedding invitations in the world, <a href='http:\/\/www.BeachWedlockInvitations.com' class='bbc_url' title='External link' rel='nofollow external'>www.BeachWedlockInvitations.com<\/a>.<br \/> <br \/> <br \/> About the Author<br \/> Renae C. Judkins is the owner of the largest Web site for beach themed wedding invitations in the world, <a href='http:\/\/www.BeachWedlockInvitations.com' class='bbc_url' title='External link' rel='nofollow external'>www.BeachWedlockInvitations.com<\/a>.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-family:arial, helvetica, sans-serif;\">Founder and Owner of BestDestinationWedding.com \u00a0\/ \u00a0<\/span><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/'><strong><span style=\"font-family:arial, helvetica, sans-serif;\">Bride & Groom Fly FREE Promotion<\/span><\/strong><\/a><\/p>\n<p>\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><strong><a data-ipb='nomediaparse' href='http:\/\/wrighttravelagency.com\/inquiry\/'><span style=\"color:#008080;\">Looking for a travel agency that specializes in Destination Weddings<\/span><\/a><\/strong><span style=\"color:#008080;\"><strong>?<\/strong> \u00a0We are an award winning travel agency and you can <\/span><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style=\"color:#008080;\">read our reviews\u00a0here.<\/span><\/a><\/strong><\/span><br>\n\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"color:#008080;\"><strong>Awards and recognition:\u00a0<\/strong><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Palace Resorts Winner \"Top Travel Agent\", \"Top Homebased Travel Agency\" PRO Platinum Agency (Top Award) \u00a0 \u00a0 | \u00a0 \u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">AMResorts Master Agent & Top Agency \u00a0<\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/68050-karisma-hotels-givc-and-gi-wedding-consultants-wright-travel-agency\/'><strong>Wright Travel & Karisma GIVC Benefits<\/strong><\/a><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Travel Impressions Best of the Best Globe Winner \u00a0 \u00a0| \u00a0 \u00a0\u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Apple Vacations Golden Apple Winner \u00a0<\/span><\/span><br><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17612\/sml_gallery_206696_17612_13451.png\" alt=\"sml_gallery_206696_17612_13451.png\"><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"> \u00a0 \u00a0<img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"font-size:14px;\"><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010'>Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><\/span><\/span><strong><span style=\"color:#b22222;\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a data-ipb='nomediaparse' href='mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com'>ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"admin@bestdestinationwedding.com","IpAddress":"71.202.225.11","GroupId":4,"GroupName":"Administrators","JoinDate":1137224220,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"FormattedName":"TammyWright","Id":206696,"Name":"TammyWright","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":390,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"56bcac8d6023a4380bdf30b110397f1c","RawContent":"&lt;strong&gt;Quote&lt;\/strong&gt;:&lt;font size=\"1\"&gt;Make it a &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/sandiego.nyctourist.com\/sandiego-weddings.php\"&gt;Wedding Vegas&lt;\/a&gt; or &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/lasvegas.nyctourist.com\/las-vegas-weddings.php\"&gt;Wedding San Diego&lt;\/a&gt;&lt;\/font&gt;\n Every bride wants her wedding to be unique and her wedding invitation is no different. Finding the perfect beach wedding invitation wording is as important as finding the perfect beach wedding invitation itself...\n \n \n \n This is so very true! I do believe that the wording is just as important as the actual invitation. It is a package deal... \n I have always wanted a &amp;quot;destination wedding&amp;quot; and hope that one day, my dream will come true. I am 24 and feel that time is ticking and I don&#039;t have any solid commitment from my boyfriend of 2 years. My family tells me to be patient but I am having a really hard time with it. All of my close friends are or already have planned their weddings. I want my turn!!!!!!!","Attachments":[],"Id":832604,"PostDate":1252353250,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <strong>Quote<\/strong>:<font size=\"1\">Make it a <a href='http:\/\/sandiego.nyctourist.com\/sandiego-weddings.php' class='bbc_url' title='External link' rel='nofollow external'>Wedding Vegas<\/a> or <a href='http:\/\/lasvegas.nyctourist.com\/las-vegas-weddings.php' class='bbc_url' title='External link' rel='nofollow external'>Wedding San Diego<\/a><\/font><br \/> Every bride wants her wedding to be unique and her wedding invitation is no different. Finding the perfect beach wedding invitation wording is as important as finding the perfect beach wedding invitation itself...<br \/> <br \/> <br \/> <br \/> This is so very true! I do believe that the wording is just as important as the actual invitation. It is a package deal... <br \/> I have always wanted a \"destination wedding\" and hope that one day, my dream will come true. I am 24 and feel that time is ticking and I don't have any solid commitment from my boyfriend of 2 years. My family tells me to be patient but I am having a really hard time with it. All of my close friends are or already have planned their weddings. I want my turn!!!!!!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"marejada@live.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1244492554,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-218233.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"jadamar","Id":218233,"Name":"jadamar","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":390,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"685da1b12bc14566400eda4d118c3da9","RawContent":"This is wonderful, thank you for sharing. Definitely good advise.\n \n Dea","Attachments":[],"Id":832608,"PostDate":1252353649,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                This is wonderful, thank you for sharing. Definitely good advise.<br \/> <br \/> Dea\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"d.ronnie@rogers.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1250903645,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-220814.gif?_r=0","PhotoWidth":199,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Stamperamma","Id":220814,"Name":"Stamperamma","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":390,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"11ab6b92c81d3c7faf20b25cbc33a4e2","RawContent":"This is good advice, thanks for sharing. I am nervous about what invitations to send out and what they should say, so this will help I am going to check out the links that you suggested.","Attachments":[],"Id":833292,"PostDate":1252386422,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                This is good advice, thanks for sharing. I am nervous about what invitations to send out and what they should say, so this will help I am going to check out the links that you suggested.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"christylaughs@aol.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1245998022,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-218816.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Christylaughs","Id":218816,"Name":"Christylaughs","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":390,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5cf38921f7ef46ec847498bc4b06b849","RawContent":"Thanks Tammy this is great advice! Thanks so much for sharing :)","Attachments":[],"Id":833499,"PostDate":1252396770,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks Tammy this is great advice! Thanks so much for sharing <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>~ Mmm cupcakes ~<\/span><br \/>\n<span>[url=<\/span><a data-ipb='nomediaparse' href=\"http:\/\/www.TickerFactory.com\/%5D\">http:\/\/www.TickerFactory.com\/]<\/a><br \/>\n<a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;32;2\/st\/20100919\/e\/Our+Italian+Family+Recept\/dt\/-3\/k\/79dd\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...79dd\/event.png<\/a><\/div><\/div>","Email":"johnnygirl777@yahoo.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1219273560,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211300.jpg?_r=0","PhotoWidth":200,"PhotoHeight":278,"PhotoType":"custom"},"FormattedName":"KittenHeart","Id":211300,"Name":"KittenHeart","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":390,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e52f3e2fdc75c81b6fe430454d71a4d6","RawContent":"Thanks for the post","Attachments":[],"Id":838799,"PostDate":1252636042,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks for the post\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/t\/w18LMZT\/weight.png\">http:\/\/tickers.TickerFactory.com\/ezt...MZT\/weight.png<\/a><\/div><\/div>","Email":"jennybell1@hotmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1250891804,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-220805.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Jennybell1","Id":220805,"Name":"Jennybell1","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":390,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"06db65ab2cba08177364923f06579b34","RawContent":"[SIZE=&amp;quot;1&amp;quot;]&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;jadamar&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;&lt;strong&gt;Quote&lt;\/strong&gt;:&lt;font size=\"1\"&gt;Make it a lovely &lt;a data-ipb=&#039;nomediaparse&#039; href=\"[url=\"http:\/\/sandiego.nyctourist.com\/sandiego-weddings.php%22&gt;Wedding\"]http:\/\/sandiego.nyctourist.com\/sandiego-weddings.php\"&gt;Wedding[\/url] San Diego&lt;\/a&gt; or &lt;a data-ipb=&#039;nomediaparse&#039; href=\"[url=\"http:\/\/lasvegas.nyctourist.com\/las-vegas-weddings.php%22&gt;Wedding\"]http:\/\/lasvegas.nyctourist.com\/las-vegas-weddings.php\"&gt;Wedding[\/url] Vegas&lt;\/a&gt;\n Every bride wants her wedding to be unique and her wedding invitation is no different. Finding the perfect beach wedding invitation wording is as important as finding the perfect beach wedding invitation itself...&lt;\/font&gt;\n \n This is so very true! I do believe that the wording is just as important as the actual invitation. It is a package deal... \n I have always wanted a &amp;quot;destination wedding&amp;quot; and hope that one day, my dream will come true. I am 24 and feel that time is ticking and I don&#039;t have any solid commitment from my boyfriend of 2 years. My family tells me to be patient but I am having a really hard time with it. All of my close friends are or already have planned their weddings. I want my turn!!!!!!!&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;&lt;font face=\"Comic Sans MS\"&gt;&lt;font color=\"DarkOrchid\"&gt;Amen Sister!!!&lt;\/font&gt;&lt;\/font&gt;","Attachments":[],"Id":852992,"PostDate":1253518502,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                [SIZE=\"1\"]<div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>jadamar<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\"><strong>Quote<\/strong>:<font size=\"1\">Make it a lovely <a href='http:\/\/sandiego.nyctourist.com\/sandiego-weddings.php' class='bbc_url' title='External link' rel='nofollow external'>Wedding San Diego<\/a> or <a href='http:\/\/lasvegas.nyctourist.com\/las-vegas-weddings.php' class='bbc_url' title='External link' rel='nofollow external'>Wedding Vegas<\/a><br \/> Every bride wants her wedding to be unique and her wedding invitation is no different. Finding the perfect beach wedding invitation wording is as important as finding the perfect beach wedding invitation itself...<\/font><br \/> <br \/> This is so very true! I do believe that the wording is just as important as the actual invitation. It is a package deal... <br \/> I have always wanted a \"destination wedding\" and hope that one day, my dream will come true. I am 24 and feel that time is ticking and I don't have any solid commitment from my boyfriend of 2 years. My family tells me to be patient but I am having a really hard time with it. All of my close friends are or already have planned their weddings. I want my turn!!!!!!!<\/div> <\/td> <\/tr> <\/table> <\/div><font face=\"Comic Sans MS\"><font color=\"DarkOrchid\">Amen Sister!!!<\/font><\/font>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"marejada@live.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1244492554,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-218233.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"jadamar","Id":218233,"Name":"jadamar","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":390,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8365313525192337941cbd96f799631e","RawContent":"Thanks for the post tammy! I completely agree, your weddings should reflect you and your FI with your audience in mind. Make sure to post pics of your invitations once they&#039;re done, ladies!! It&#039;s a huge accomplishment and who deserves more credit than you for all your hard labor - plus us girls love to see those pics!","Attachments":[],"Id":852994,"PostDate":1253518713,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks for the post tammy! I completely agree, your weddings should reflect you and your FI with your audience in mind. Make sure to post pics of your invitations once they're done, ladies!! It's a huge accomplishment and who deserves more credit than you for all your hard labor - plus us girls love to see those pics!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"chelseapope@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1242181114,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-217486.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"ChelseaRose","Id":217486,"Name":"ChelseaRose","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":390,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ce87672cd4e5b9072d8a2c9953b37f19","RawContent":"Thanks for the words of wisdom!","Attachments":[],"Id":855322,"PostDate":1253643432,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks for the words of wisdom!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tlogan00@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1239768566,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-216735.jpg?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"tlogan00","Id":216735,"Name":"tlogan00","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":390,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fb8eb9617e268baa94f078fc9e40980a","RawContent":"Great advice! Thanks!","Attachments":[],"Id":855470,"PostDate":1253647323,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Great advice! Thanks!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"carlyfye@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1251946720,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-221269.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"CarlyChristine","Id":221269,"Name":"CarlyChristine","IsOnline":false}}],"Id":"390","Title":"Beach Weddings - 5 Musts for Beach Invitation Wording","LastPostDate":1410116955},"Pages":{"TotalItems":46,"TotalPages":5,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":40},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
