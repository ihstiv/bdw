false,"CanLike":true,"TopicId":24985,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"49ea02b9e3ebfa4af455aa41087c0b8d","RawContent":"&lt;p&gt;they seem nice&lt;\/p&gt;","Attachments":[],"Id":1865834,"PostDate":1407867084,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>they seem nice<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cankem80@yahoo.com","IpAddress":"76.253.50.168","GroupId":40,"GroupName":"Jr. Member","JoinDate":1407537957,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279372.png?_r=1436816059","PhotoWidth":200,"PhotoHeight":209,"PhotoType":"custom"},"FormattedName":"cankem80","Id":279372,"Name":"cankem80","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"184.186.219.123","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":24985,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f6366404c99cbde5abcecbc31412e159","RawContent":"&lt;p&gt;If anyone has an updated link for this, it would be greatly appreciated ~ Thank you ladies!&lt;\/p&gt;","Attachments":[],"Id":1891480,"PostDate":1427843319,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>If anyone has an updated link for this, it would be greatly appreciated ~ Thank you ladies!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-size:14px;\"><span style=\"font-family:verdana, geneva, sans-serif;\">\u201c...And it is an interesting biological fact that all of us have in our veins the exact same percentage of salt in our blood that exists in the ocean, and, therefore, we have salt in our blood, in our sweat, in our tears. We are tied to the ocean. And when we go back to the sea - whether it is to sail or to watch it - we are going back from whence we came.\" -John F Kennedy<\/span><\/span>","Email":"mhagedon05@hotmail.com","IpAddress":"67.171.182.209","GroupId":47,"GroupName":"Site Supporter","JoinDate":1310744369,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"none"},"FormattedName":"MissMeg","Id":242372,"Name":"MissMeg","IsOnline":false}}],"Pages":{"TotalItems":19,"TotalPages":2,"CurrentPage":10,"NextPage":-1,"PreviousPage":0,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
