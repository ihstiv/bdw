VoWBVFEXYubNuPitk_5oiahTAAAYFIkUn9L%24FKtULhSx1KiUq1WRlKlWDBSv1t4Up1eplJ1YjklKdYqcFLNYtZFKdYxSFIzY0klJ1Y3rlKlY%24RlLLZBkFKtZFpFKhZHjlK5ZKsVRRHf0kTbj4rZP%24aImoUwAAGBRZSb1pwUsVdRFKzYhMFLNYjLFI9YotFJLYrHFIzYuwlI_Yx3FI7Y1YlI9Y5flJFY752haEo0SQAACNEkAAAwaCYGaLAmBg0EwNQA-&hash=275201&3drollangle=0&3drotation=0&page=1&width=245\" alt=\"lp.aspx?doc_sig=QSH_hwgUgUTYFgSSGRslhKIM\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><a href='https:\/\/www.groupon.com\/browse\/boston?lat=42.3589&lng=-71.0578&query=vistaprint&address=Boston&locale=en_US' class='bbc_url' title='External link' rel='nofollow external'>https:\/\/www.groupon....on&locale=en_US<\/a><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"candice.french@gmail.com","IpAddress":"24.62.169.169","GroupId":39,"GroupName":"Newbie","JoinDate":1415121095,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280992.jpg?_r=1421507914","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"MissFrench","Id":280992,"Name":"MissFrench","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.52.135.61","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79076,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"741c31e50ef1cad4b2e357b70179a5c5","RawContent":"&lt;p&gt;Ooo awesome!! How many bags did you get? did you end up paying much after the coupon?&lt;\/p&gt;","Attachments":[],"Id":1893435,"PostDate":1429235549,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Ooo awesome!! How many bags did you get? did you end up paying much after the coupon?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419437814,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1450791654","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"76.119.165.154","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79076,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3a67695939b561a79c433d81fc71293c","RawContent":"This is actually my second time using a Groupon deal for our Vistaprint bags.  I ordered the first batch back in February but still need a few more. We ordered the deluxe tote bags which are $13 each.  They have a smaller version for $10 each.  I think it ends up costing around $6 each (not including the cost of the groupon deal).  Hope this helps! \n\n\nI am really impressed with the way they came out. :)","Attachments":[],"Id":1893450,"PostDate":1429262799,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                This is actually my second time using a Groupon deal for our Vistaprint bags.  I ordered the first batch back in February but still need a few more. We ordered the deluxe tote bags which are $13 each.  They have a smaller version for $10 each.  I think it ends up costing around $6 each (not including the cost of the groupon deal).  Hope this helps! <br><br>\nI am really impressed with the way they came out. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"candice.french@gmail.com","IpAddress":"24.62.169.169","GroupId":39,"GroupName":"Newbie","JoinDate":1415121095,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280992.jpg?_r=1421507914","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"MissFrench","Id":280992,"Name":"MissFrench","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"64.53.250.35","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79076,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"cc4b48f857c432557dfb9f3847c3e007","RawContent":"&lt;p&gt;I used a Vistaprint Groupon to print my invitations (I got the design from Etsy), and I&#039;m beyond thrilled with how they turned out, and brag to anyone who will listen about how much money I saved! Definitely a great option for people who don&#039;t want to spend $300+ on invitations.&lt;\/p&gt;","Attachments":[],"Id":1893452,"PostDate":1429272404,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I used a Vistaprint Groupon to print my invitations (I got the design from Etsy), and I'm beyond thrilled with how they turned out, and brag to anyone who will listen about how much money I saved! Definitely a great option for people who don't want to spend $300+ on invitations.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rachelia160@aim.com","IpAddress":"66.61.104.237","GroupId":40,"GroupName":"Jr. Member","JoinDate":1388731897,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275855.jpg?_r=1435853657","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"rachelia160","Id":275855,"Name":"rachelia160","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.41.59","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79076,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"a47b981d2e7a9adf9eb9270177db3d6f","RawContent":"I used this deal for all my my paper items for our wedding. Such an awesome deal and great quality. \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1893456,"PostDate":1429275292,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I used this deal for all my my paper items for our wedding. Such an awesome deal and great quality. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399428602,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"161.185.150.180","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79076,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"658fefe23a23bcac325d31fd128b7c6e","RawContent":"&lt;p&gt;@[member=\"rachelia160\"] may you please share your invite.&lt;\/p&gt;","Attachments":[],"Id":1893475,"PostDate":1429286896,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"275855\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/275855-rachelia160\/' title='Member profile'><span itemprop=\"name\">rachelia160<\/span><\/a> may you please share your invite.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p style=\"text-align:center;\">\u00a0 \u00a0 \u00a0 \u00a0 \u00a0 Future Mrs. Bonitto 12\/14\/16<\/p>\n<div><br><div style=\"text-align:center;\"><br><div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.weddingcountdown.com\/\"><img src=\"http:\/\/img.weddingcountdown.com\/ticker\/30ag12yqu333h.png\" alt=\"30ag12yqu333h.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<\/div>\n<\/div>\n<p>\u00a0","Email":"shamicaglover@yahoo.com","IpAddress":"161.185.157.23","GroupId":40,"GroupName":"Jr. Member","JoinDate":1394133176,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277031.jpg?_r=1397251056","PhotoWidth":200,"PhotoHeight":203,"PhotoType":"custom"},"FormattedName":"MrandMrsBonitto2016","Id":277031,"Name":"MrandMrsBonitto2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"64.53.250.35","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79076,"EditedBy":"<strong>Edited by rachelia160, 17 April 2015 - 08:27 AM.<\/strong>","EditDate":1429288056,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"29305f758c8c0cf983bcf9492fcaa047","RawContent":"&lt;div&gt;@[member=\"MrandMrsBonitto2016\"]&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:80986]&lt;\/div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:80987]&lt;\/div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:80988]&lt;\/div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:80989]&lt;\/div&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I got my design from CourtneyJonesDesign on Etsy, and he was wonderful. He tweaked everything to just how I wanted it and even designed menus and place cards for me to match the invitations.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I cut the RSVP card to look like a luggage tag and punched a hole for a piece of twine. They turned out so cute!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I upgraded my Vistaprint order to the&amp;nbsp;&lt;span style=\"color:rgb(56,69,79);font-family:MarkPro, sans-serif;\"&gt;Premium White Matte Stock&lt;\/span&gt;&amp;nbsp;and it was perfect for the invitations. I used the linen finish for the menus which I love, too. Very happy with everything all around!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;(PS - This made me realize my date is two months from today....AHHHH!!!)&lt;\/p&gt;","Attachments":[],"Id":1893477,"PostDate":1429287969,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div>@<a hovercard-ref=\"member\" hovercard-id=\"277031\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277031-mrandmrsbonitto2016\/' title='Member profile'><span itemprop=\"name\">MrandMrsBonitto2016<\/span><\/a><\/div>\n<div>\u00a0<\/div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/80986-img-4363\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_18013\/sml_gallery_275855_18013_998028.jpg' class='galattach galimageview sharedmedia_screenshot' title='IMG 4363'  width='200' height='151'  alt='IMG 4363' id='sml_image_view_80986' \/><\/a>\n<br \/><\/div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/80987-info-card\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_18013\/sml_gallery_275855_18013_15959.jpg' class='galattach galimageview sharedmedia_screenshot' title='Info Card'  width='145' height='200'  alt='Info Card' id='sml_image_view_80987' \/><\/a>\n<br \/><\/div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/80988-invitation\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_18013\/sml_gallery_275855_18013_111507.jpg' class='galattach galimageview sharedmedia_screenshot' title='Invitation'  width='145' height='200'  alt='Invitation' id='sml_image_view_80988' \/><\/a>\n<br \/><\/div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/80989-rsvp\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_18013\/sml_gallery_275855_18013_47761.jpg' class='galattach galimageview sharedmedia_screenshot' title='RSVP'  width='148' height='200'  alt='RSVP' id='sml_image_view_80989' \/><\/a>\n<br \/><\/div>\n<p>\u00a0<\/p>\n<p>I got my design from CourtneyJonesDesign on Etsy, and he was wonderful. He tweaked everything to just how I wanted it and even designed menus and place cards for me to match the invitations.<\/p>\n<p>\u00a0<\/p>\n<p>I cut the RSVP card to look like a luggage tag and punched a hole for a piece of twine. They turned out so cute!<\/p>\n<p>\u00a0<\/p>\n<p>I upgraded my Vistaprint order to the\u00a0<span  style=\"color:rgb(56,69,79);font-family:MarkPro, sans-serif\">Premium White Matte Stock<\/span>\u00a0and it was perfect for the invitations. I used the linen finish for the menus which I love, too. Very happy with everything all around!<\/p>\n<p>\u00a0<\/p>\n<p>(PS - This made me realize my date is two months from today....AHHHH!!!)<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rachelia160@aim.com","IpAddress":"66.61.104.237","GroupId":40,"GroupName":"Jr. Member","JoinDate":1388731897,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275855.jpg?_r=1435853657","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"rachelia160","Id":275855,"Name":"rachelia160","IsOnline":false}}],"Id":"79076","Title":"Groupon Vistaprint Deal!","LastPostDate":1429287969},"Pages":{"TotalItems":7,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
