Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":12,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":1411,"MovedTo":null,"MovedOn":0,"FirstPostId":415313,"Rating":0,"RatingHits":0,"Starter":{"Id":209401,"Name":"Shay2679","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209401.gif?_r=0","PhotoWidth":66,"PhotoHeight":100,"PhotoType":"custom"},"IsOnline":false},"StartDate":1218486115,"LastPoster":{"Id":285438,"Name":"jonesharry","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-285438.gif?_r=1450860155","PhotoWidth":200,"PhotoHeight":144,"PhotoType":"custom"},"IsOnline":true},"PollState":"0","LastVote":0,"ForumId":34,"Preview":{"Id":415313,"PostDate":1218486115,"PostContent":"Hey everyone...  We've just ordered our paper supplies\/envelopes for our Invitations and RSVP car...","Author":{"Signature":"","Email":"shannon.johnston@pwc.ca","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1210797953,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209401.gif?_r=0","PhotoWidth":66,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Shay2679","Id":209401,"Name":"Shay2679","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":21725,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f12069ec514ecff6195c2c2d17338c74","RawContent":"Hey everyone...\n \n We&#039;ve just ordered our paper supplies\/envelopes for our Invitations and RSVP cards (to be mailed end of January - for AHR only)\n \n It has just come to my attention, that our RSVP envelopes, size A4 (I thought this was a pretty standard size) envelopes (3 5\/8&amp;quot; x 5 1\/8&amp;quot;) will be too small to come back through the mail?!?\n \n All of our invites are within Canada...and I am having a really hard time finding anything about the minimum dimension requirements...\n \n Does anyone know, or has anyone used this size RSVP envelope with or without problems? I&#039;d hate to have to spend more now on new envelopes...I&#039;ve spent enough!!!","Attachments":[],"Id":415313,"PostDate":1218486115,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hey everyone...<br \/> <br \/> We've just ordered our paper supplies\/envelopes for our Invitations and RSVP cards (to be mailed end of January - for AHR only)<br \/> <br \/> It has just come to my attention, that our RSVP envelopes, size A4 (I thought this was a pretty standard size) envelopes (3 5\/8\" x 5 1\/8\") will be too small to come back through the mail?!?<br \/> <br \/> All of our invites are within Canada...and I am having a really hard time finding anything about the minimum dimension requirements...<br \/> <br \/> Does anyone know, or has anyone used this size RSVP envelope with or without problems? I'd hate to have to spend more now on new envelopes...I've spent enough!!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"shannon.johnston@pwc.ca","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1210797953,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209401.gif?_r=0","PhotoWidth":66,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Shay2679","Id":209401,"Name":"Shay2679","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":21725,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b8cad2854ece251c1070bcdb6817ba82","RawContent":"Wow, so if something is too small they wont mail it? that seems like a normal size envelope. Can you call your post office and ask them? What a PITA!","Attachments":[],"Id":415326,"PostDate":1218486337,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Wow, so if something is too small they wont mail it? that seems like a normal size envelope. Can you call your post office and ask them? What a PITA!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i244.photobucket.com\/albums\/gg28\/lucy8144\/DSC_0825.jpg\">http:\/\/i244.photobucket.com\/albums\/g...4\/DSC_0825.jpg<\/a><\/div><\/div>","Email":"dakota144@sbcglobal.net","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1198306953,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208052.gif?_r=0","PhotoWidth":90,"PhotoHeight":90,"PhotoType":"custom"},"FormattedName":"lucy106","Id":208052,"Name":"lucy106","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":21725,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"53c3095f12567ea46d23ea40af7568fd","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;lucy106&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Wow, so if something is too small they wont mail it? that seems like a normal size envelope. Can you call your post office and ask them? What a PITA!&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;Okay..so...kinda funny story...I am currently living in Montreal, but speak very little french (I&#039;m lucky I&#039;m able to manage MOSTLY without it)!...\n \n I called the post office (two different ones actually)...and...LANGUAGE BARRIER. It was hilarious trying to ask about A4 envelopes, trying to give dimensions in french...and...translating. Apparently all the english speakers were on lunch...\n \n SO...I came here. You guys usually answer me quicker than any phone anyways!\n \n And yes, apparently, if its too small (or doesn&#039;t meet their minimums) they simply will NOT mail them...they will return them to the sender?? asking for additional postage, or, if return address is not included, they just simply do not get sent. Lost mail...go figure.","Attachments":[],"Id":415340,"PostDate":1218486702,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>lucy106<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Wow, so if something is too small they wont mail it? that seems like a normal size envelope. Can you call your post office and ask them? What a PITA!<\/div> <\/td> <\/tr> <\/table> <\/div>Okay..so...kinda funny story...I am currently living in Montreal, but speak very little french (I'm lucky I'm able to manage MOSTLY without it)!...<br \/> <br \/> I called the post office (two different ones actually)...and...LANGUAGE BARRIER. It was hilarious trying to ask about A4 envelopes, trying to give dimensions in french...and...translating. Apparently all the english speakers were on lunch...<br \/> <br \/> SO...I came here. You guys usually answer me quicker than any phone anyways!<br \/> <br \/> And yes, apparently, if its too small (or doesn't meet their minimums) they simply will NOT mail them...they will return them to the sender?? asking for additional postage, or, if return address is not included, they just simply do not get sent. Lost mail...go figure.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"shannon.johnston@pwc.ca","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1210797953,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209401.gif?_r=0","PhotoWidth":66,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Shay2679","Id":209401,"Name":"Shay2679","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":21725,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0fe9de47f2e92ed327a507ef4c7040e3","RawContent":"I don&#039;t know what Canadian Post rules are, but I know A4 can be mailed in the US.\n \n If they return them to sender, why don&#039;t you just put the return address as your address as well, that way it comes to you!","Attachments":[],"Id":415454,"PostDate":1218490256,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I don't know what Canadian Post rules are, but I know A4 can be mailed in the US.<br \/> <br \/> If they return them to sender, why don't you just put the return address as your address as well, that way it comes to you!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><strong><a  class=\"bbc_url\" href=\"http:\/\/bestdestinationwedding.com\/forum\/blogs\/erinb\">Visit My BDW Blog!<\/a><\/strong><br><strong><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/21100-couples-swept-away-review-insanely-long-and-detailed\/\">My CSA Wedding Review<\/a><\/strong><br><strong><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/20334-erinbs-csa-pro-pics-better-late-than-never\/\">Wedding Pictures<\/a><\/strong> & <strong><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/20335-erinbs-ttd-pic-heavy\/\">My TTD<\/a><\/strong><br><strong><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/18150-erinbs-planning-thread\/\">My Planning Thread<\/a><\/strong><\/p>\n","Email":"arynn2@aol.com","IpAddress":"74.138.76.73","GroupId":46,"GroupName":"VIP Member","JoinDate":1196806800,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208007.gif?_r=0","PhotoWidth":71,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"ErinB","Id":208007,"Name":"ErinB","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":21725,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cfe8b77b5aef678fdea78a2141ef7a59","RawContent":"Have you tried searching the webiste for package dimension guidelines?\n \n &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.canadapost.ca\/Personal\/RatesPrices\/\"&gt;Canada Post - Rates and Prices&lt;\/a&gt;","Attachments":[],"Id":415463,"PostDate":1218490608,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Have you tried searching the webiste for package dimension guidelines?<br \/> <br \/> <a href='http:\/\/www.canadapost.ca\/Personal\/RatesPrices\/' class='bbc_url' title='External link' rel='nofollow external'>Canada Post - Rates and Prices<\/a>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><strong><a  class=\"bbc_url\" href=\"http:\/\/bestdestinationwedding.com\/forum\/blogs\/erinb\">Visit My BDW Blog!<\/a><\/strong><br><strong><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/21100-couples-swept-away-review-insanely-long-and-detailed\/\">My CSA Wedding Review<\/a><\/strong><br><strong><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/20334-erinbs-csa-pro-pics-better-late-than-never\/\">Wedding Pictures<\/a><\/strong> & <strong><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/20335-erinbs-ttd-pic-heavy\/\">My TTD<\/a><\/strong><br><strong><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/18150-erinbs-planning-thread\/\">My Planning Thread<\/a><\/strong><\/p>\n","Email":"arynn2@aol.com","IpAddress":"74.138.76.73","GroupId":46,"GroupName":"VIP Member","JoinDate":1196806800,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208007.gif?_r=0","PhotoWidth":71,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"ErinB","Id":208007,"Name":"ErinB","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":21725,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"89cbc7c2df811e8351c2a7f39aa754e3","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;ErinB&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;If they return them to sender, why don&#039;t you just put the return address as your address as well, that way it comes to you!&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;HAHA!! I wonder if that would work?! That is awesome...LOL\n \n I&#039;d probably just confuse all my guests by putting our address on the envelope twice!! But...I COULD try to explain somewhere...LOL\n \n Oh...and yes, I have searched the canadapost.ca website, but I had no luck finding basic envelope dimensions...parcels, yes. Envelopes, no. I&#039;ll try again, thanks!","Attachments":[],"Id":415534,"PostDate":1218492037,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>ErinB<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">If they return them to sender, why don't you just put the return address as your address as well, that way it comes to you!<\/div> <\/td> <\/tr> <\/table> <\/div>HAHA!! I wonder if that would work?! That is awesome...LOL<br \/> <br \/> I'd probably just confuse all my guests by putting our address on the envelope twice!! But...I COULD try to explain somewhere...LOL<br \/> <br \/> Oh...and yes, I have searched the canadapost.ca website, but I had no luck finding basic envelope dimensions...parcels, yes. Envelopes, no. I'll try again, thanks!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"shannon.johnston@pwc.ca","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1210797953,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209401.gif?_r=0","PhotoWidth":66,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Shay2679","Id":209401,"Name":"Shay2679","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":21725,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5cb6be0b8195064e2cac23e78a83da0b","RawContent":"I never knew there was a minimum envelope size for mail","Attachments":[],"Id":415538,"PostDate":1218492157,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I never knew there was a minimum envelope size for mail\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;130\/st\/20090522\/e\/Our+Beach+Wedding\/dt\/1\/k\/b0da\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...b0da\/event.png<\/a><\/div><\/div>","Email":"KrysNelson@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1216060888,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-210522.gif?_r=0","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"FormattedName":"KrysNelson","Id":210522,"Name":"KrysNelson","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":21725,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"53f506066a60083186e2cb789ef4328b","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;KrysNelson&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;I never knew there was a minimum envelope size for mail&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;I know! ME either...I knew about over-weight or over-sized parcels...but never put much thought into them being too small...\n \n Grr.","Attachments":[],"Id":415554,"PostDate":1218492886,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>KrysNelson<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">I never knew there was a minimum envelope size for mail<\/div> <\/td> <\/tr> <\/table> <\/div>I know! ME either...I knew about over-weight or over-sized parcels...but never put much thought into them being too small...<br \/> <br \/> Grr.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"shannon.johnston@pwc.ca","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1210797953,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209401.gif?_r=0","PhotoWidth":66,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Shay2679","Id":209401,"Name":"Shay2679","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":21725,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d648aca44fa01ba6531daff80a0aef4b","RawContent":"Ok I found this:\n \n &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.canadapost.ca\/textonly\/personal\/tools\/pg\/prices\/CPcanada-e.asp#1392319\"&gt;Canada Post - Canada&lt;\/a&gt;\n \n Size and Speed \n Size Speed \n Maximum:\n Envelope and Self-mailer: 245 mm x 156 mm x 5 mm \n Card: 235 mm x 120 mm x 5 mm \n Other Lettermail: 380 mm x 270 mm x 20 mm \n Local \u00e2\u20ac\u201c 2 days\n Provincial \u00e2\u20ac\u201c 3 days\n National \u00e2\u20ac\u201c 4 days \n &lt;font color=\"Red\"&gt;Minimum: 140 mm x 90 mm x 0.18 mm &lt;\/font&gt;\n \n It looks like your envelopes are just under the requirements but that might be for the sorting equipment. I&#039;d try one just to see what happens?\n \n BTW I send stamped addressed envelopes out quite often with the sender and return address the same with no problem.","Attachments":[],"Id":415833,"PostDate":1218503323,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Ok I found this:<br \/> <br \/> <a href='http:\/\/www.canadapost.ca\/textonly\/personal\/tools\/pg\/prices\/CPcanada-e.asp#1392319' class='bbc_url' title='External link' rel='nofollow external'>Canada Post - Canada<\/a><br \/> <br \/> Size and Speed <br \/> Size Speed <br \/> Maximum:<br \/> Envelope and Self-mailer: 245 mm x 156 mm x 5 mm <br \/> Card: 235 mm x 120 mm x 5 mm <br \/> Other Lettermail: 380 mm x 270 mm x 20 mm <br \/> Local \u00e2\u20ac\u201c 2 days<br \/> Provincial \u00e2\u20ac\u201c 3 days<br \/> National \u00e2\u20ac\u201c 4 days <br \/> <font color=\"Red\">Minimum: 140 mm x 90 mm x 0.18 mm <\/font><br \/> <br \/> It looks like your envelopes are just under the requirements but that might be for the sorting equipment. I'd try one just to see what happens?<br \/> <br \/> BTW I send stamped addressed envelopes out quite often with the sender and return address the same with no problem.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"helen_s81@hotmail.com","IpAddress":"69.157.125.20","GroupId":3,"GroupName":"Member","JoinDate":1194759234,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207919.jpeg?_r=0","PhotoWidth":180,"PhotoHeight":224,"PhotoType":"custom"},"FormattedName":"Helen_S81","Id":207919,"Name":"Helen_S81","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":21725,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"14fd956c234a833d2da59846942cb51e","RawContent":"Hi,\n \n Not to add insult to injury but I think you mean 4Bar, an A4 envelope size is\n 4 1\/4 x 6 1\/4 which would probably work but might be to big, there is also an A2 which is close in size to a 4Bar, A2s are 4 3\/8x 5 3\/4.\n \n Hope this helps","Attachments":[],"Id":416543,"PostDate":1218563145,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi,<br \/> <br \/> Not to add insult to injury but I think you mean 4Bar, an A4 envelope size is<br \/> 4 1\/4 x 6 1\/4 which would probably work but might be to big, there is also an A2 which is close in size to a 4Bar, A2s are 4 3\/8x 5 3\/4.<br \/> <br \/> Hope this helps\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"hitchedinvites@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1212018468,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209624.gif?_r=0","PhotoWidth":100,"PhotoHeight":27,"PhotoType":"custom"},"FormattedName":"Hitched Invites","Id":209624,"Name":"Hitched Invites","IsOnline":false}}],"Id":"21725","Title":"3 5\/8\" x 5 1\/8\" RSVP Envelopes...","LastPostDate":1450255050},"Pages":{"TotalItems":12,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
