hat a great idea!!!&lt;\/p&gt;","Attachments":[],"Id":1836419,"PostDate":1393864753,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"264077\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/264077-njbride2014\/' title='Member profile'><span itemprop=\"name\">NJBride2014<\/span><\/a> What a great idea!!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nicolefioravanti@gmail.com","IpAddress":"76.125.148.169","GroupId":40,"GroupName":"Jr. Member","JoinDate":1386338618,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"none"},"FormattedName":"nicofio22","Id":275505,"Name":"nicofio22","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.249.122.85","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76069,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"317c06c81bce328ccb832cc340fcb676","RawContent":"&lt;p&gt;I am going to print directly onto the envelope. If you google it there are lots of tutorials.&lt;\/p&gt;","Attachments":[],"Id":1836702,"PostDate":1393978566,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I am going to print directly onto the envelope. If you google it there are lots of tutorials.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kelly_miller_@hotmail.com","IpAddress":"99.249.122.85","GroupId":40,"GroupName":"Jr. Member","JoinDate":1390772931,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kellymiller","Id":276338,"Name":"kellymiller","IsOnline":false}}],"Id":"76069","Title":"Addressing Envelopes For Invitations","LastPostDate":1450860044},"Pages":{"TotalItems":24,"TotalPages":3,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":20},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
