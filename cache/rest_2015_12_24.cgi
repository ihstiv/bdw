photo-281478.jpg?_r=1450791654","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.134.141.162","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79164,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"7330bf798550313a70d2986e3064cc93","RawContent":"&lt;p&gt;Thanks @[member=\"perianjay\"]!!! &amp;nbsp;haha oh my goodness, my mind is already racing nonstop!&lt;\/p&gt;","Attachments":[],"Id":1895747,"PostDate":1431092681,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thanks @<a hovercard-ref=\"member\" hovercard-id=\"281478\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281478-perianjay\/' title='Member profile'><span itemprop=\"name\">perianjay<\/span><\/a>!!! \u00a0haha oh my goodness, my mind is already racing nonstop!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div><img src=\"http:\/\/\" alt=\"\"><\/div>\n<div><br><div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;0\/st\/20160423\/e\/we+leave+for+Mexico%21\/k\/c059\/event.png\" alt=\"event.png\"><\/a>\u00a0 \u00a0\u00a0\u00a0 \u00a0\u00a0<a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;32;116\/st\/20160430\/e\/we+say+I+do%21\/k\/8afc\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<\/div>\n<p>\u00a0<\/p>\n<p>My Planning Thread:<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79580-deecols-planning-thread-gbp-april-30th-2016\/#entry1904529'>http:\/\/www.bestdestinationwedding.com\/topic\/79580-deecols-planning-thread-gbp-april-30th-2016\/#entry1904529<\/a>","Email":"deannaproteau@hotmail.com","IpAddress":"207.134.141.162","GroupId":3,"GroupName":"Member","JoinDate":1421442569,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281751.jpg?_r=1443808962","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"deecol","Id":281751,"Name":"deecol","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79164,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e82d1b9638ca79627abde9c494d512d7","RawContent":"&lt;p&gt;@[member=\"deecol\"] haha I totally understand where you&#039;re at. We all go through the same phases. I remeber when I had just sent out my STD&#039;s and I just kept thinking omg.. where to start now!?!? haha.. the very beginning is so overwhelming, but once you start&amp;nbsp;chipping away at things to do it gets better. I booked a lot of things early so that I could spend these months just dealing with the smaller details. Definitely try and get some of the big stuff out of the way early (photgrapher, DJ etc)&lt;\/p&gt;","Attachments":[],"Id":1895748,"PostDate":1431092785,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"281751\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281751-deecol\/' title='Member profile'><span itemprop=\"name\">deecol<\/span><\/a> haha I totally understand where you're at. We all go through the same phases. I remeber when I had just sent out my STD's and I just kept thinking omg.. where to start now!?!? haha.. the very beginning is so overwhelming, but once you start\u00a0chipping away at things to do it gets better. I booked a lot of things early so that I could spend these months just dealing with the smaller details. Definitely try and get some of the big stuff out of the way early (photgrapher, DJ etc)<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419437814,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1450791654","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.134.141.162","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79164,"EditedBy":"<strong>Edited by deecol, 08 May 2015 - 05:56 AM.<\/strong>","EditDate":1431093374,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"562c24bbb20aa630199045081d2e4206","RawContent":"&lt;p&gt;@[member=\"perianjay\"] Oh for sure! Colin thinks I&#039;m crazy for always thinking about the wedding and talking about it... but things need to get done! lol &amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Half my battle is convincing my frugal fianc\u00e9 about needing things like chairs... no I&#039;m kidding, he&#039;s not that bad lol he&#039;s loving all of this too. &amp;nbsp;But he still thinks I&#039;m wedding-crazy right now. &amp;nbsp;Which I am :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I knew once we had the resort booked it would all start happening from there. &amp;nbsp;It&#039;s so exciting!!! &amp;nbsp;I already got my dress though so at least that&#039;s one big item crossed off my list. &amp;nbsp;Once I get more done I&#039;ll start a planning thread to help me stay organized.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;This website is a god-send. &amp;nbsp;Tips I&#039;ve heard of on here I&#039;ve shared with my best friend who is also getting married in April 2016, her wedding is local and she&#039;s always saying \"Dee, you are so on top of things, I wouldn&#039;t know about any of this stuff\" &amp;nbsp;thanks to this website!&lt;\/p&gt;","Attachments":[],"Id":1895749,"PostDate":1431093203,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"281478\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281478-perianjay\/' title='Member profile'><span itemprop=\"name\">perianjay<\/span><\/a> Oh for sure! Colin thinks I'm crazy for always thinking about the wedding and talking about it... but things need to get done! lol \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Half my battle is convincing my frugal fianc\u00e9 about needing things like chairs... no I'm kidding, he's not that bad lol he's loving all of this too. \u00a0But he still thinks I'm wedding-crazy right now. \u00a0Which I am <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>I knew once we had the resort booked it would all start happening from there. \u00a0It's so exciting!!! \u00a0I already got my dress though so at least that's one big item crossed off my list. \u00a0Once I get more done I'll start a planning thread to help me stay organized.<\/p>\n<p>\u00a0<\/p>\n<p>This website is a god-send. \u00a0Tips I've heard of on here I've shared with my best friend who is also getting married in April 2016, her wedding is local and she's always saying \"Dee, you are so on top of things, I wouldn't know about any of this stuff\" \u00a0thanks to this website!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div><img src=\"http:\/\/\" alt=\"\"><\/div>\n<div><br><div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;0\/st\/20160423\/e\/we+leave+for+Mexico%21\/k\/c059\/event.png\" alt=\"event.png\"><\/a>\u00a0 \u00a0\u00a0\u00a0 \u00a0\u00a0<a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;32;116\/st\/20160430\/e\/we+say+I+do%21\/k\/8afc\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<\/div>\n<p>\u00a0<\/p>\n<p>My Planning Thread:<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79580-deecols-planning-thread-gbp-april-30th-2016\/#entry1904529'>http:\/\/www.bestdestinationwedding.com\/topic\/79580-deecols-planning-thread-gbp-april-30th-2016\/#entry1904529<\/a>","Email":"deannaproteau@hotmail.com","IpAddress":"207.134.141.162","GroupId":3,"GroupName":"Member","JoinDate":1421442569,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281751.jpg?_r=1443808962","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"deecol","Id":281751,"Name":"deecol","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79164,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"8c67d7121f11f8a424bc4c22ff417455","RawContent":"&lt;p&gt;@[member=\"deecol\"] That&#039;s so funny. Sounds like my fianc\u00e9 and I. He questioned me for so long about wanting gold chiavari chairs and said why can&#039;t we just keep the white garden chairs. Eventually he just stopped bothering when I told him I have a vision and it&#039;s very specific lol.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Yay for getting your dress out of the way!! I bought mine back in October right after we got engaged, but now i&#039;m selling it. I think it was too impulsive because I got such a good deal. It isn&#039;t even my size haha.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I agree that this website is a godsend! Can&#039;t wait to see your planning thread. I love having a planning thread it&#039;s such a great place to chat with everyone and share ideas! :)&lt;\/p&gt;","Attachments":[],"Id":1895752,"PostDate":1431093915,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"281751\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281751-deecol\/' title='Member profile'><span itemprop=\"name\">deecol<\/span><\/a> That's so funny. Sounds like my fianc\u00e9 and I. He questioned me for so long about wanting gold chiavari chairs and said why can't we just keep the white garden chairs. Eventually he just stopped bothering when I told him I have a vision and it's very specific lol.<\/p>\n<p>\u00a0<\/p>\n<p>Yay for getting your dress out of the way!! I bought mine back in October right after we got engaged, but now i'm selling it. I think it was too impulsive because I got such a good deal. It isn't even my size haha.<\/p>\n<p>\u00a0<\/p>\n<p>I agree that this website is a godsend! Can't wait to see your planning thread. I love having a planning thread it's such a great place to chat with everyone and share ideas! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419437814,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1450791654","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.134.141.162","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79164,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"3d0451e111a9e44b4995e0ed7490527d","RawContent":"&lt;p&gt;Again - thank god for this site:&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I looked back at the pic I posted above of my invite and realized I made a mistake on the date! &amp;nbsp;Thank goodness I was able to catch vistaprint in time and change it. &amp;nbsp;Phewwww!&lt;\/p&gt;","Attachments":[],"Id":1895787,"PostDate":1431112775,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Again - thank god for this site:<\/p>\n<p>\u00a0<\/p>\n<p>I looked back at the pic I posted above of my invite and realized I made a mistake on the date! \u00a0Thank goodness I was able to catch vistaprint in time and change it. \u00a0Phewwww!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div><img src=\"http:\/\/\" alt=\"\"><\/div>\n<div><br><div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;0\/st\/20160423\/e\/we+leave+for+Mexico%21\/k\/c059\/event.png\" alt=\"event.png\"><\/a>\u00a0 \u00a0\u00a0\u00a0 \u00a0\u00a0<a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;32;116\/st\/20160430\/e\/we+say+I+do%21\/k\/8afc\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<\/div>\n<p>\u00a0<\/p>\n<p>My Planning Thread:<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79580-deecols-planning-thread-gbp-april-30th-2016\/#entry1904529'>http:\/\/www.bestdestinationwedding.com\/topic\/79580-deecols-planning-thread-gbp-april-30th-2016\/#entry1904529<\/a>","Email":"deannaproteau@hotmail.com","IpAddress":"207.134.141.162","GroupId":3,"GroupName":"Member","JoinDate":1421442569,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281751.jpg?_r=1443808962","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"deecol","Id":281751,"Name":"deecol","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.41.59","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79164,"EditedBy":"","EditDate":0,"EditRea