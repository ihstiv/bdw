09-16 15.04.45.png\" \/><\/a>\n\n<p>]<a class='resized_img' rel='lightbox[1872696]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_09_2014\/post-277818-0-68365300-1411421904.png\" title=\"2014-09-16 15.08.38.png - Size: 938.09KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_09_2014\/post-277818-0-68365300-1411421904.png\" class='bbc_img linked-image' alt=\"2014-09-16 15.08.38.png\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Love over 50 is still LOVE!!!<\/p>\n<p>Invitations out! RSVPs in<\/p>\n<p>Us, them (bridal party), + 48 guests!!\u00a0<\/p>\n<p>\u00a0","Email":"dldincali@yahoo.com","IpAddress":"173.8.177.213","GroupId":40,"GroupName":"Jr. Member","JoinDate":1399064137,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277818.jpg?_r=1408642386","PhotoWidth":200,"PhotoHeight":143,"PhotoType":"custom"},"FormattedName":"VegasBride121314","Id":277818,"Name":"VegasBride121314","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"186.203.234.17","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78070,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"09e8a4ec8dea44575c735053df305039","RawContent":"Nice!","Attachments":[],"Id":1873224,"PostDate":1411701349,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Nice!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"dimagama@hotmail.com","IpAddress":"186.203.234.17","GroupId":40,"GroupName":"Jr. Member","JoinDate":1411697070,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"dimagama","Id":280018,"Name":"dimagama","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.187.255.21","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78070,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"8037d7928ef478dc8dd63d5ac91d9dae","RawContent":"&lt;p&gt;Wow these are amazing!!! Great work!&lt;\/p&gt;","Attachments":[],"Id":1875977,"PostDate":1413561637,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Wow these are amazing!!! Great work!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"asmoudianis@aol.com","IpAddress":"24.187.255.21","GroupId":39,"GroupName":"Newbie","JoinDate":1389121638,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"ASmooth","Id":275923,"Name":"ASmooth","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.67.77.101","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78070,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"e60223c6325a4d73118c5353a0a52836","RawContent":"&lt;p&gt;They look great! We are doing something similar as ours will be a pocket-fold!&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1876045,"PostDate":1413596556,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>They look great! We are doing something similar as ours will be a pocket-fold!\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ashleyandjesse2015@gmail.com","IpAddress":"50.67.77.101","GroupId":39,"GroupName":"Newbie","JoinDate":1412130898,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280150.png?_r=1412131075","PhotoWidth":200,"PhotoHeight":275,"PhotoType":"custom"},"FormattedName":"cometgirl","Id":280150,"Name":"cometgirl","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.8.177.213","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78070,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"82befeda346cede6428bd2d361b35eb5","RawContent":"&lt;p&gt;@[member=\"cometgirl\"], I actually did 50 pocket and 100 non pocket. Since there was a huge price difference and most of the invitees are not coming, I chose to send them the cheaper ones. It was funny cause some households got 2 different invites; pocket &amp;amp; non pocket! And I used two colors, red &amp;amp; black just for shits &amp;amp; giggles!!&amp;nbsp;&lt;\/p&gt;\n\n&lt;p&gt;And crazier...is that I didn&#039;t even keep a pocket one for myself!!!&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1876440,"PostDate":1413917043,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"280150\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/280150-cometgirl\/' title='Member profile'><span itemprop=\"name\">cometgirl<\/span><\/a>, I actually did 50 pocket and 100 non pocket. Since there was a huge price difference and most of the invitees are not coming, I chose to send them the cheaper ones. It was funny cause some households got 2 different invites; pocket & non pocket! And I used two colors, red & black just for shits & giggles!!\u00a0<\/p>\n<br \/><p>And crazier...is that I didn't even keep a pocket one for myself!!!\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Love over 50 is still LOVE!!!<\/p>\n<p>Invitations out! RSVPs in<\/p>\n<p>Us, them (bridal party), + 48 guests!!\u00a0<\/p>\n<p>\u00a0","Email":"dldincali@yahoo.com","IpAddress":"173.8.177.213","GroupId":40,"GroupName":"Jr. Member","JoinDate":1399064137,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277818.jpg?_r=1408642386","PhotoWidth":200,"PhotoHeight":143,"PhotoType":"custom"},"FormattedName":"VegasBride121314","Id":277818,"Name":"VegasBride121314","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.67.77.101","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78070,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e37f2ca76a8f06b5bbd1bc960416fdac","RawContent":"&lt;p&gt;@[member=\"VegasBride121314\"] so did you do pocketfold to the ones coming (that you knew of) or not coming?&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1876688,"PostDate":1414036443,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"277818\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277818-vegasbride121314\/' title='Member profile'><span itemprop=\"name\">VegasBride121314<\/span><\/a> so did you do pocketfold to the ones coming (that you knew of) or not coming?\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ashleyandjesse2015@gmail.com","IpAddress":"50.67.77.101","GroupId":39,"GroupName":"Newbie","JoinDate":1412130898,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280150.png?_r=1412131075","PhotoWidth":200,"PhotoHeight":275,"PhotoType":"custom"},"FormattedName":"cometgirl","Id":280150,"Name":"cometgirl","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.6.126.88","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78070,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"14940c874c87ec537db37a86b6489107","RawContent":"&lt;p&gt;@[member=\"cometgirl\"], I did pocket ones for the bridal party, and ticketed guest at the time of mailing. The remaining pockets went to worthy family and close friends. All family members I knew were not coming were mailed the cheaper ones. It worked out perfectly and honestly, I would have been just as happy with all cheap ones. I mean honestly, who really keeps invitations other than our moms!!! LOL!&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1877249,"PostDate":1414595879,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"280150\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/280150-cometgirl\/' title='Member profile'><span itemprop=\"name\">cometgirl<\/span><\/a>, I did pocket ones for the bridal party, and ticketed guest at the time of mailing. The remaining pockets went to worthy family and close friends. All family members I knew were not coming were mailed the cheaper ones. It worked out perfectly and honestly, I would have been just as happy with all cheap ones. I mean honestly, who really keeps invitations other than our moms!!! LOL!\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Love over 50 is still LOVE!!!<\/p>\n<p>Invitations out! RSVPs in<\/p>\n<p>Us, them (bridal party), + 48 guests!!\u00a0<\/p>\n<p>\u00a0","Email":"dldincali@yahoo.com","IpAddress":"173.8.177.213","GroupId":40,"GroupName":"Jr. Member","JoinDate":1399064137,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277818.jpg?_r=1408642386","PhotoWidth":200,"PhotoHeight":143,"PhotoType":"custom"},"FormattedName":"VegasBride121314","Id":277818,"Name":"VegasBride121314","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.162.162.45","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78070,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"595778a83836013509099cdf845514e5","RawContent":"&lt;p&gt;These look great. I can&#039;t wait it get to the point where I finish mine. It&#039;s a long, arduous process but you should be very proud of yourself&lt;\/p&gt;","Attachments":[],"Id":1880714,"PostDate":1418876018,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>These look great. I can't wait it get to the point where I finish mine. It's a long, arduous process but you should be very proud of yourself<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"vsschick@gmail.com","IpAddress":"162.208.80.15","GroupId":40,"GroupName":"Jr. Member","JoinDate":1404484310,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"vsschick1234","Id":278832,"Name":"vsschick1234","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.41.59","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78070,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fdb7e7b4e7579159b6c73661d8300668","RawContent":"[quote name=\"VegasBride121314\" post=\"1877249\" timestamp=\"1414595879\"]\n@[member=\"cometgirl\"], I did pocket ones for the bridal party, and ticketed guest at the time of mailing. The remaining pockets went to worthy family and close friends. All family members I knew were not coming were mailed the cheaper ones. It worked out perfectly and honestly, I would have been just as happy with all cheap ones. I mean honestly, who really keeps invitations other than our moms!!! LOL![\/quote]Congrats on your wedding\n\nHope to see you back to hear all\nAbout it. I still have a small part in my heart that wanted a Vegas marriage so can&#039;t wait to see all your pics \/) \n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1880853,"PostDate":1419086780,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>VegasBride121314, on 29 October 2014 - 07:17 AM, said:<\/p><div class='blockquote'><div class='quote'><p>@<a hovercard-ref=\"member\" hovercard-id=\"280150\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/280150-cometgirl\/' title='Member profile'><span itemprop=\"name\">cometgirl<\/span><\/a>, I did pocket ones for the bridal party, and ticketed guest at the time of mailing. The remaining pockets went to worthy family and close friends. All family members I knew were not coming were mailed the cheaper ones. It worked out perfectly and honestly, I would have been just as happy with all cheap ones. I mean honestly, who really keeps invitations other than our moms!!! LOL!<\/p><\/div><\/div>\n<br>\nCongrats on your wedding<br><br>\nHope to see you back to hear all<br>\nAbout it. I still have a small part in my heart that wanted a Vegas marriage so can't wait to see all your pics \/) <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399428602,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}}],"Id":"78070","Title":"Diy Pocket Invitations","LastPostDate":1419086780},"Pages":{"TotalItems":9,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}