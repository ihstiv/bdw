Request Time: 1 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":14,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":1167,"MovedTo":null,"MovedOn":0,"FirstPostId":1855908,"Rating":0,"RatingHits":0,"Starter":{"Id":278411,"Name":"rizzoroxx","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278411.jpg?_r=1404525221","PhotoWidth":200,"PhotoHeight":268,"PhotoType":"facebook"},"IsOnline":false},"StartDate":1403066639,"LastPoster":{"Id":285896,"Name":"Harper370","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":2,"Preview":{"Id":1855908,"PostDate":1403066639,"PostContent":"Hey there! I really want to do a destination wedding but my folks are insisting that I should ha...","Author":{"Signature":"","Email":"rozette.anterola@gmail.com","IpAddress":"96.246.210.8","GroupId":39,"GroupName":"Newbie","JoinDate":1402468691,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278411.jpg?_r=1404525221","PhotoWidth":200,"PhotoHeight":268,"PhotoType":"facebook"},"FormattedName":"rizzoroxx","Id":278411,"Name":"rizzoroxx","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"96.246.210.8","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77351,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3ef63d0b06190a9e0f3ca713ceb03941","RawContent":"&lt;div style=\"font-family:&#039;Helvetica Neue&#039;, Arial, Verdana, sans-serif;font-size:14px;color:rgb(34,34,34);background-color:rgb(255,255,255);\"&gt;\n&lt;p style=\"margin-left:0px;\"&gt;Hey there! I really want to do a destination wedding but my folks are insisting that I should have a catholic wedding ceremony. Based on my research, I have found Gran Caribe Real as one of my options. I&#039;ve looked into Xcaret weddings as well. I&#039;ve contacted TAs already just waiting on their response. Anybody have any suggestions on other places that offer catholic ceremonies or have experienced weddings at GCR? Please let me know, a brief review of the resorts such as their food and services would be great! Thanks so much!&amp;nbsp;&lt;\/p&gt;\n&lt;\/div&gt;","Attachments":[],"Id":1855908,"PostDate":1403066639,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"font-family:'Helvetica Neue', Arial, Verdana, sans-serif;font-size:14px;color:rgb(34,34,34);background-color:rgb(255,255,255);\">\n<p  style=\"margin-left:0px\">Hey there! I really want to do a destination wedding but my folks are insisting that I should have a catholic wedding ceremony. Based on my research, I have found Gran Caribe Real as one of my options. I've looked into Xcaret weddings as well. I've contacted TAs already just waiting on their response. Anybody have any suggestions on other places that offer catholic ceremonies or have experienced weddings at GCR? Please let me know, a brief review of the resorts such as their food and services would be great! Thanks so much!\u00a0<\/p>\n<\/div>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rozette.anterola@gmail.com","IpAddress":"96.246.210.8","GroupId":39,"GroupName":"Newbie","JoinDate":1402468691,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278411.jpg?_r=1404525221","PhotoWidth":200,"PhotoHeight":268,"PhotoType":"facebook"},"FormattedName":"rizzoroxx","Id":278411,"Name":"rizzoroxx","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"187.153.119.218","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77351,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":3,"IsLiked":false,"PostKey":"63b223bc0f7d04ccdf24ad6955a80dce","RawContent":"&lt;p&gt;@[member=\"rizzoroxx\"] - You have many options for a Catholic ceremony in the Cancun &amp;amp; Riviera Maya area.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;The first option is to have it all at the hotel that has a chapel. Gran Caribe, Moon Palace, Valentin Imperial Maya, Dreams Tulum would be our top picks from our experiences.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Your other option is to pick any hotel you wish and hold the Ceremony at one of the many wonderful churches we have in the area.&amp;nbsp;&lt;span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\"&gt;Nuestra Senora Del Carmen in Playa or another in&amp;nbsp;&lt;\/span&gt;&lt;span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\"&gt;Puerto Morelos called Iglesia de San Jose&lt;\/span&gt;&lt;span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\"&gt;&amp;nbsp;There is also a private chapel next too Maroma beach !&amp;nbsp;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;You can also have an offsite location for your ceremony for after the Church or go back to the hotel.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Lots of options. Perhaps looking through the &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/topic\/35015-churcheschapels-in-riviera-maya\/&#039;&gt;forums&lt;\/a&gt; you can find some help or contact one of the many &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/reviews\/c\/73-coordinator-reviews\/&#039;&gt;wedding coordinators&lt;\/a&gt; that live here and makes things easy on yourself !&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Best of luck in your planning !&lt;\/p&gt;","Attachments":[],"Id":1855947,"PostDate":1403098944,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"278411\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/278411-rizzoroxx\/' title='Member profile'><span itemprop=\"name\">rizzoroxx<\/span><\/a> - You have many options for a Catholic ceremony in the Cancun & Riviera Maya area.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>The first option is to have it all at the hotel that has a chapel. Gran Caribe, Moon Palace, Valentin Imperial Maya, Dreams Tulum would be our top picks from our experiences.<\/p>\n<p>\u00a0<\/p>\n<p>Your other option is to pick any hotel you wish and hold the Ceremony at one of the many wonderful churches we have in the area.\u00a0<span  style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif\">Nuestra Senora Del Carmen in Playa or another in\u00a0<\/span><span  style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif\">Puerto Morelos called Iglesia de San Jose<\/span><span  style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif\">\u00a0There is also a private chapel next too Maroma beach !\u00a0<\/span><\/p>\n<p>\u00a0<\/p>\n<p>You can also have an offsite location for your ceremony for after the Church or go back to the hotel.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Lots of options. Perhaps looking through the <a href='http:\/\/www.bestdestinationwedding.com\/topic\/35015-churcheschapels-in-riviera-maya\/' class='bbc_url' title=''>forums<\/a> you can find some help or contact one of the many <a href='http:\/\/www.bestdestinationwedding.com\/reviews\/c\/73-coordinator-reviews\/' class='bbc_url' title=''>wedding coordinators<\/a> that live here and makes things easy on yourself !<\/p>\n<p>\u00a0<\/p>\n<p>Best of luck in your planning !<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lorenajaimes@gmail.com","IpAddress":"187.153.138.202","GroupId":39,"GroupName":"Newbie","JoinDate":1351802196,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-261977.jpg?_r=1431101988","PhotoWidth":200,"PhotoHeight":291,"PhotoType":"custom"},"FormattedName":"Lorena Jaimes","Id":261977,"Name":"Lorena Jaimes","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"206.223.185.220","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77351,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"1a35236a6715c35c459bd7259a4b03a2","RawContent":"&lt;p&gt;If you&#039;re looking at a Real resort, there is also Gran Porto Real in Playa del Carmen that is apprently right down the street from a catholic chapel in PDC! And of course the Real resorts list the option of a catholic chapel in their wedding package designs so you could build it right in as you design your package.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck!&lt;\/p&gt;","Attachments":[],"Id":1855961,"PostDate":1403103394,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>If you're looking at a Real resort, there is also Gran Porto Real in Playa del Carmen that is apprently right down the street from a catholic chapel in PDC! And of course the Real resorts list the option of a catholic chapel in their wedding package designs so you could build it right in as you design your package.<\/p>\n<p>\u00a0<\/p>\n<p>Good luck!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span><\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/ann.chadwick.5\/media_set?set=a.10153262834771016.1073741828.569791015&type=3'><span style=\"color:#ff0099;\"><em>https:\/\/www.facebook.com\/ann.chadwick.5\/media_set?set=a.10153262834771016.1073741828.569791015&type=3<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/'><span style=\"color:#ff0099;\"><em>http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283458999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"177.237.115.25","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77351,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"5cba584ecf69436c14a033e7454dc4ea","RawContent":"[quote name=\"rizzoroxx\" post=\"1855908\" timestamp=\"1403066639\"]\n[size=4][background=rgb(255,255,255)]\n\nHey there! I really want to do a destination wedding but my folks are insisting that I should have a catholic wedding ceremony. Based on my research, I have found Gran Caribe Real as one of my options. I&#039;ve looked into Xcaret weddings as well. I&#039;ve contacted TAs already just waiting on their response. Anybody have any suggestions on other places that offer catholic ceremonies or have experienced weddings at GCR? Please let me know, a brief review of the resorts such as their food and services would be great! Thanks so much! [\/background][\/size]\n[\/quote]Hey rizzoroxx,\n\nAs wedding planners in the Riviera Maya, here is our advice, You have nothing to worry about its so common for brides to have their catholic ceremony at the church on 5th avenue and then go back to the hotel for the reception or take it to an off resort location.\n\nSee below links of catholic ceremonies we had a fun time planning for our past brides\n\n\n\n\n[font=arial][url=\"http:\/\/delsolphotography.com\/playa-del-carmen-church-wedding-dd-01232014\/\"]http:\/\/delsolphotography.com\/playa-del-carmen-church-wedding-dd-01232014\/[\/url][\/font]\n\n\n[font=arial][url=\"https:\/\/www.facebook.com\/media\/set\/?set=a.695238747181761.1073741926.116179758420999&amp;amp;type=1\"]https:\/\/www.facebook.com\/media\/set\/?set=a.695238747181761.1073741926.116179758420999&amp;amp;type=1[\/url][\/font]","Attachments":[],"Id":1856078,"PostDate":1403148324,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>rizzoroxx, on 17 June 2014 - 08:43 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>\u00a0<\/p>\n<div  style=\"font-size:14px;background-color:rgb(255,255,255)\">\n<p>Hey there! I really want to do a destination wedding but my folks are insisting that I should have a catholic wedding ceremony. Based on my research, I have found Gran Caribe Real as one of my options. I've looked into Xcaret weddings as well. I've contacted TAs already just waiting on their response. Anybody have any suggestions on other places that offer catholic ceremonies or have experienced weddings at GCR? Please let me know, a brief review of the resorts such as their food and services would be great! Thanks so much!\u00a0<\/p>\n<\/div>\n<p>\u00a0<\/p>\n<\/div>\n<\/div><\/div>\n<p>Hey rizzoroxx,<\/p>\n<p>\u00a0<\/p>\n<p>As wedding planners in the Riviera Maya, here is our advice, You have nothing to worry about its so common for brides to have their catholic ceremony at the church on 5th avenue and then go back to the hotel for the reception or take it to an off resort location.<\/p>\n<p>\u00a0<\/p>\n<p>See below links of catholic ceremonies we had a fun time planning for our past brides<\/p>\n<p>\u00a0<\/p>\n<div>\u00a0<\/div>\n<div>\n<p>\u00a0<\/p>\n<p><span  style=\"font-family:arial, sans-serif\"><a href='http:\/\/delsolphotography.com\/playa-del-carmen-church-wedding-dd-01232014\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/delsolphotogr...ng-dd-01232014\/<\/a><\/span><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-family:arial, sans-serif\"><a href='https:\/\/www.facebook.com\/media\/set\/?set=a.695238747181761.1073741926.116179758420999&type=1' class='bbc_url' title='External link' rel='nofollow external'>https:\/\/www.facebook...58420999&type=1<\/a><\/span><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<\/div>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Dream Weddings Riviera Maya- We pay attention to your wishes and coordinate closely with you to ensure your wedding or event is planned to perfection! Supporting you brides and help you feel less overwhelmed during the wedding planning process.<\/p>\n<p>Have fun the best is yet to come!<\/p>\n<p>\u00a0<\/p>\n<p>This is where I will be posting all videos about most common question about Destination wedding<\/p>\n<p> <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0\u00a0<a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/groups\/1664036763874450\/'>https:\/\/www.facebook.com\/groups\/1664036763874450\/<\/a><br><br><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Dream Weddings Riviera Maya<\/span><\/span><\/span><br><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">weddingsinplayadelcarmen@gmail.com<\/span><\/span><br><a  class=\"bbc_url\" href=\"http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html\">http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html<\/a><br><br><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Happy Planning!<\/span><\/span><\/span><br><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Joyce<\/span><\/span><\/span>","Email":"weddingsinplayadelcarmen@gmail.com","IpAddress":"187.252.44.28","GroupId":84,"GroupName":"Insiders w\/ Articles","JoinDate":1326854387,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250090.jpg?_r=1451923195","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"dreamweddings","Id":250090,"Name":"dreamweddings","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"198.53.129.168","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77351,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"264a862377c7113a85e8e1973b820145","RawContent":"&lt;p&gt;Joyce has great advice, rizzoroxx - hope you find all the answers from the vast array of resources here.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;This is one of the magical wedding \"moments that matter\" Linc caught recently at &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10152443957034487.1073741893.18683524486&amp;amp;type=3&#039;&gt;The Royal Playa del Carmen Wedding&lt;\/a&gt; showing this wedding couple&#039;s Catholic ceremony....to inspire you.....enjoy!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-a-sea.xx.fbcdn.net\/hphotos-xpa1\/t1.0-9\/10438417_10152443963689487_4142329497186284199_n.jpg\" alt=\"10438417_10152443963689487_4142329497186\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;all the best with your plans, cheers! team MTM :)&lt;\/p&gt;","Attachments":[],"Id":1856268,"PostDate":1403202474,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Joyce has great advice, rizzoroxx - hope you find all the answers from the vast array of resources here.<\/p>\n<p>\u00a0<\/p>\n<p>This is one of the magical wedding \"moments that matter\" Linc caught recently at <a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10152443957034487.1073741893.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>The Royal Playa del Carmen Wedding<\/a> showing this wedding couple's Catholic ceremony....to inspire you.....enjoy!<\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-a-sea.xx.fbcdn.net\/hphotos-xpa1\/t1.0-9\/10438417_10152443963689487_4142329497186284199_n.jpg\" alt=\"10438417_10152443963689487_4142329497186\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>all the best with your plans, cheers! team MTM <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280210660,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.37.176.165","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77351,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5ecad1ec43435855a2d4743ac0fa80f5","RawContent":"In short, I have done similar research\n\n\nGrab Caribe Real\n\nMoon Palace Cancun\n\nDreams Tulum\n\nGrand Pallidium Kantenah\n\nBarcelo Maya Palace\n\nRiu Palace Rivera Maya\n\nHard Rock Hotel Riviera Maya\n\nValentin Imperial Maya\n\nXcaret Park\n\nAmarte Maroma Beach (not all inclusive)\n\n\nHope this helps!","Attachments":[],"Id":1856955,"PostDate":1403749639,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                In short, I have done similar research<br><br>\nGrab Caribe Real<br>\nMoon Palace Cancun<br>\nDreams Tulum<br>\nGrand Pallidium Kantenah<br>\nBarcelo Maya Palace<br>\nRiu Palace Rivera Maya<br>\nHard Rock Hotel Riviera Maya<br>\nValentin Imperial Maya<br>\nXcaret Park<br>\nAmarte Maroma Beach (not all inclusive)<br><br>\nHope this helps!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"stefnani@gmail.com","IpAddress":"68.37.176.165","GroupId":39,"GroupName":"Newbie","JoinDate":1403740130,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278696.jpg?_r=1403802469","PhotoWidth":200,"PhotoHeight":284,"PhotoType":"custom"},"FormattedName":"stefnani","Id":278696,"Name":"stefnani","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.136.194.145","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77351,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d9f9a4bf3fd071ef414cca96ba93fe47","RawContent":"My recommendation would be to have a catholic service at one of the churches on 5th in playa del Carmen. I think that there are a few. That would be really cool! Just a thought!","Attachments":[],"Id":1857034,"PostDate":1403809482,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                My recommendation would be to have a catholic service at one of the churches on 5th in playa del Carmen. I think that there are a few. That would be really cool! Just a thought! \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lisananth@yahoo.com","IpAddress":"166.137.101.169","GroupId":40,"GroupName":"Jr. Member","JoinDate":1401136433,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278120.jpg?_r=1421810202","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"LisaAnthonyPoppy","Id":278120,"Name":"LisaAnthonyPoppy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"187.153.128.185","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77351,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"6580bab642da930939f282649debc6ab","RawContent":"&lt;p&gt;There are 3 gorgeous chapels in Playa del Carmen, different sizes and styles. All great options!&lt;\/p&gt;","Attachments":[],"Id":1857050,"PostDate":1403814159,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>There are 3 gorgeous chapels in Playa del Carmen, different sizes and styles. All great options!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<strong class='bbc'><em class='bbc'><span style='color: #696969'>iWedding Mexico <\/span><\/em><\/strong><span style='color: #696969'>takes the stress out of wedding planning! Always available and ready to help you achieve your dream wedding in paradise!<\/span><br \/>\n<br \/>\n<strong class='bbc'><span style='font-size: 12px;'><span style='color: #000000'>iWedding Mexico, Playa del Carmen<\/span><\/span><\/strong><br \/>\n<span style='font-size: 12px;'>daniela@iweddingmexico.com<\/span><br \/>\n<strong class='bbc'><span style='font-size: 12px;'><a class='bbc_url' href='http:\/\/www.iweddingmexico.com'>http:\/\/www.iweddingmexico.com<\/a><\/span><\/strong><br \/>\n<br \/>\n<strong class='bbc'><span style='font-size: 12px;'>xoxoxo<\/span><\/strong>","Email":"daniela@iweddingmexico.com","IpAddress":"187.153.148.127","GroupId":49,"GroupName":"Insiders","JoinDate":1397240595,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277556.png?_r=1402077292","PhotoWidth":200,"PhotoHeight":157,"PhotoType":"custom"},"FormattedName":"iWeddingMexico","Id":277556,"Name":"iWeddingMexico","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"209.95.50.90","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77351,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"220be9c06d0b79e0bb7b83c62fec333d","RawContent":"HOla Rizzoroxx... yep, happy to help w\/ our 2 cents worth.   This is a common question, and since many people ask about churches, we have put together a list.  [quote name=\"rizzoroxx\" post=\"1855908\" timestamp=\"1403066639\"]\n[size=4][background=rgb(255,255,255)]\n\nHey there! I really want to do a destination wedding but my folks are insisting that I should have a catholic wedding ceremony. Based on my research, I have found Gran Caribe Real as one of my options. I&#039;ve looked into Xcaret weddings as well. I&#039;ve contacted TAs already just waiting on their response. Anybody have any suggestions on other places that offer catholic ceremonies or have experienced weddings at GCR? Please let me know, a brief review of the resorts such as their food and services would be great! Thanks so much! [\/background][\/size]\n[\/quote]YES,  we have many suggestions :)  Actually we prepared a list of hotels \/ venues with chapels and wrote about them here, all organized w\/ photos and links to actual real weddings. \n\nSince wedding planning IS VERY VISUAL, and your likely thousands of miles away, hope this helps.\n\n[url=\"http:\/\/delsolphotography.com\/top-10-cancun-riviera-maya-church-wedding-venues\/\"]http:\/\/delsolphotography.com\/top-10-cancun-riviera-maya-church-wedding-venues\/[\/url]\n\n[img]http:\/\/delsolphotography.com\/wp-content\/uploads\/2015\/01\/Top-Ten-Riviera-Maya-Church-Wedding-Venues_0018.jpg[\/img]\n\n\n[img]http:\/\/delsolphotography.com\/wp-content\/uploads\/2015\/02\/Evelyn-Logan_JE_W_0742.jpg[\/img]","Attachments":[],"Id":1902214,"PostDate":1439216771,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>HOla Rizzoroxx... yep, happy to help w\/ our 2 cents worth. \u00a0 This is a common question, and since many people ask about churches, we have put together a list. \u00a0<\/p>\n<p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>rizzoroxx, on 17 June 2014 - 08:43 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>\u00a0<\/p>\n<div  style=\"font-size:14px;background-color:rgb(255,255,255)\">\n<p>Hey there! I really want to do a destination wedding but my folks are insisting that I should have a catholic wedding ceremony. Based on my research, I have found Gran Caribe Real as one of my options. I've looked into Xcaret weddings as well. I've contacted TAs already just waiting on their response. Anybody have any suggestions on other places that offer catholic ceremonies or have experienced weddings at GCR? Please let me know, a brief review of the resorts such as their food and services would be great! Thanks so much!\u00a0<\/p>\n<\/div>\n<p>\u00a0<\/p>\n<\/div>\n<\/div><\/div>\n<p>\nYES, \u00a0we have many suggestions <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> \u00a0Actually we prepared a list of hotels \/ venues with chapels and wrote about them here, all organized w\/ photos and links to actual real weddings.\u00a0<br><br>\nSince wedding planning IS VERY VISUAL, and your likely thousands of miles away, hope this helps.<br><br>\n<a href='http:\/\/delsolphotography.com\/top-10-cancun-riviera-maya-church-wedding-venues\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/delsolphotogr...wedding-venues\/<\/a><br><br><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/delsolphotography.com\/wp-content\/uploads\/2015\/01\/Top-Ten-Riviera-Maya-Church-Wedding-Venues_0018.jpg\" alt=\"Top-Ten-Riviera-Maya-Church-Wedding-Venu\"><\/span><br><br><br><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/delsolphotography.com\/wp-content\/uploads\/2015\/02\/Evelyn-Logan_JE_W_0742.jpg\" alt=\"Evelyn-Logan_JE_W_0742.jpg\"><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"info@delsolphotography.com","IpAddress":"189.221.144.61","GroupId":49,"GroupName":"Insiders","JoinDate":1175019240,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207303.gif?_r=0","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"custom"},"FormattedName":"Matt Adcock","Id":207303,"Name":"Matt Adcock","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"4.26.24.250","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77351,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"c51d523bf370a9496fa1ba81b33ab438","RawContent":"&lt;p&gt;Hi! I am actually having a Catholic wedding at the chapel on 5th avenue in Playa del Carmen on October 10 this year! It was definitely difficult to plan it, but I am beyond grateful that we dediced to do it! If you need any advice, let me know and I would be more than willing to help you!!&lt;\/p&gt;","Attachments":[],"Id":1905320,"PostDate":1443101219,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi! I am actually having a Catholic wedding at the chapel on 5th avenue in Playa del Carmen on October 10 this year! It was definitely difficult to plan it, but I am beyond grateful that we dediced to do it! If you need any advice, let me know and I would be more than willing to help you!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"softballchica48@yahoo.com","IpAddress":"4.26.24.250","GroupId":39,"GroupName":"Newbie","JoinDate":1442502967,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284847.jpg?_r=1444326998","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"sgleba25","Id":284847,"Name":"sgleba25","IsOnline":false}}],"Id":"77351","Title":"Catholic Wedding Ceremony Help!","LastPostDate":1453421222},"Pages":{"TotalItems":14,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
