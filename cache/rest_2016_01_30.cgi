{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":10,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":545,"MovedTo":null,"MovedOn":0,"FirstPostId":1908760,"Rating":0,"RatingHits":0,"Starter":{"Id":285316,"Name":"Jbwilli","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"none"},"IsOnline":false},"StartDate":1451431028,"LastPoster":{"Id":285230,"Name":"Deannak","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1908760,"PostDate":1451431028,"PostContent":"Hey Brides,\u00a0 My name is Jasmine. I got engaged to the love of my life in September. At first I wa...","Author":{"Signature":"","Email":"jbw@mail.sfsu.edu","IpAddress":"172.56.33.25","GroupId":39,"GroupName":"Newbie","JoinDate":1447353369,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"none"},"FormattedName":"Jbwilli","Id":285316,"Name":"Jbwilli","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.16.147.166","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79822,"EditedBy":"<strong>Edited by Jbwilli, 29 December 2015 - 03:18 PM.<\/strong>","EditDate":1451431088,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9bb1dfe3ca24ec56f2eecb97ed80bbcd","RawContent":"&lt;p&gt;Hey Brides,&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;My name is Jasmine. I got engaged to the love of my life in September. At first I was really excited about wedding planning and was having a good time, but I just found the whole process of trying to pick a resort sooooooooooo overwhelming. I took a long 2 month break :-) and didn&#039;t think about anything wedding. But i think i should stop avoiding this and get started.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;So we are looking to get married in April of 2017. What I am struggling &amp;nbsp;the most with is finding something that offers the most bang for our buck for the wedding without having our guest pay more than $200 a night, which is still a lot of money.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;It&#039;s really hard to get pricing so far in advance. Is it possible to plan a destination wedding for about 50-60 people for about $7000(not including flight and hotel)?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I really love Moon Palace because all that is included in the basic wedding package and love all the resort has to offer, but the cost of the rooms is well over $200\/person\/ night.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Can anyone offer some advice with their budget and some economical resort choices?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thanks in advance,&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Jasmine&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1908760,"PostDate":1451431028,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hey Brides,\u00a0<\/p>\n<p>My name is Jasmine. I got engaged to the love of my life in September. At first I was really excited about wedding planning and was having a good time, but I just found the whole process of trying to pick a resort sooooooooooo overwhelming. I took a long 2 month break :-) and didn't think about anything wedding. But i think i should stop avoiding this and get started.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>So we are looking to get married in April of 2017. What I am struggling \u00a0the most with is finding something that offers the most bang for our buck for the wedding without having our guest pay more than $200 a night, which is still a lot of money.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>It's really hard to get pricing so far in advance. Is it possible to plan a destination wedding for about 50-60 people for about $7000(not including flight and hotel)?<\/p>\n<p>\u00a0<\/p>\n<p>I really love Moon Palace because all that is included in the basic wedding package and love all the resort has to offer, but the cost of the rooms is well over $200\/person\/ night.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Can anyone offer some advice with their budget and some economical resort choices?<\/p>\n<p>\u00a0<\/p>\n<p>Thanks in advance,\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Jasmine\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jbw@mail.sfsu.edu","IpAddress":"172.56.33.25","GroupId":39,"GroupName":"Newbie","JoinDate":1447353369,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"none"},"FormattedName":"Jbwilli","Id":285316,"Name":"Jbwilli","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.146.146.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79822,"EditedBy":"<strong>Edited by calgarybride2015, 29 December 2015 - 04:16 PM.<\/strong>","EditDate":1451434615,"EditReason":"","DeleteDate":0,"TotalLikes":3,"IsLiked":false,"PostKey":"6485f2f96651b2065cebed496da27251","RawContent":"Hi Jasmine\n\n\nPicking the resort is the hardest part for sure. \n\nMy advice is to get a good travel agent (one who does destination weddings is even better) as she can help you narrow your choices based on your must have list. She can also suggest ones you may not have considered. \n\n\nThat said, I got married at the Grand Sirenis Riviera Maya \/Mayan Beach and we had 45 people total. I took the free package and upgraded my location to the palapa and all the extras I wanted. Their base packages - even the free one - offered all the basics and some good extras.  None the less we paid under $6000 and had A LOT of extras. Like 4 extra hours of reception, flowers for the girls, mariachi band, hair and makeup etc. \n\n\nIf you want more info let me know :) good luck. \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1908765,"PostDate":1451434182,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi Jasmine<br><br>\nPicking the resort is the hardest part for sure. <br>\nMy advice is to get a good travel agent (one who does destination weddings is even better) as she can help you narrow your choices based on your must have list. She can also suggest ones you may not have considered. <br><br>\nThat said, I got married at the Grand Sirenis Riviera Maya \/Mayan Beach and we had 45 people total. I took the free package and upgraded my location to the palapa and all the extras I wanted. Their base packages - even the free one - offered all the basics and some good extras.  None the less we paid under $6000 and had A LOT of extras. Like 4 extra hours of reception, flowers for the girls, mariachi band, hair and makeup etc. <br><br>\nIf you want more info let me know <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> good luck. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399428602,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"200.79.251.123","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79822,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"0ba89d6b1de577be7f5467c62b1380fc","RawContent":"[quote name=\"Jbwilli\" post=\"1908760\" timestamp=\"1451431028\"]\nHey Brides, \nMy name is Jasmine. I got engaged to the love of my life in September. At first I was really excited about wedding planning and was having a good time, but I just found the whole process of trying to pick a resort sooooooooooo overwhelming. I took a long 2 month break :-) and didn&#039;t think about anything wedding. But i think i should stop avoiding this and get started. \n\nSo we are looking to get married in April of 2017. What I am struggling  the most with is finding something that offers the most bang for our buck for the wedding without having our guest pay more than $200 a night, which is still a lot of money. \n\nIt&#039;s really hard to get pricing so far in advance. Is it possible to plan a destination wedding for about 50-60 people for about $7000(not including flight and hotel)?\n\nI really love Moon Palace because all that is included in the basic wedding package and love all the resort has to offer, but the cost of the rooms is well over $200\/person\/ night. \n\nCan anyone offer some advice with their budget and some economical resort choices?\n\nThanks in advance, \n\nJasmine[\/quote]@[member=\"Jbwilli\"] Welcome to the forum, \n\nI cannot stress it enough to all Destination Bride, having a TA who can advice you on resorts takes away a lots of overwhelming from you.  Let the pros help you find the right resort that is a best fit for you.  There are plenty of resort to choose from. \n\nOne thing you also need to look out for is the season.  For example in the Riviera Maya we have low and high season.  Make sure you find out the prices, for the low season just so you can compare price points for the resorts.\n\n\nHappy Planning!\nJoyce","Attachments":[],"Id":1908770,"PostDate":1451448538,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Jbwilli, on 29 December 2015 - 03:17 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hey Brides,\u00a0<\/p>\n<p>My name is Jasmine. I got engaged to the love of my life in September. At first I was really excited about wedding planning and was having a good time, but I just found the whole process of trying to pick a resort sooooooooooo overwhelming. I took a long 2 month break :-) and didn't think about anything wedding. But i think i should stop avoiding this and get started.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>So we are looking to get married in April of 2017. What I am struggling \u00a0the most with is finding something that offers the most bang for our buck for the wedding without having our guest pay more than $200 a night, which is still a lot of money.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>It's really hard to get pricing so far in advance. Is it possible to plan a destination wedding for about 50-60 people for about $7000(not including flight and hotel)?<\/p>\n<p>\u00a0<\/p>\n<p>I really love Moon Palace because all that is included in the basic wedding package and love all the resort has to offer, but the cost of the rooms is well over $200\/person\/ night.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Can anyone offer some advice with their budget and some economical resort choices?<\/p>\n<p>\u00a0<\/p>\n<p>Thanks in advance,\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Jasmine\u00a0<\/p>\n<\/div>\n<\/div><\/div>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"285316\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/285316-jbwilli\/' title='Member profile'><span itemprop=\"name\">Jbwilli<\/span><\/a> Welcome to the forum,\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I cannot stress it enough to all Destination Bride, having a TA who can advice you on resorts takes away a lots of overwhelming from you. \u00a0Let the pros help you find the right resort that is a best fit for you. \u00a0There are plenty of resort to choose from.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>One thing you also need to look out for is the season. \u00a0For example in the Riviera Maya we have low and high season. \u00a0Make sure you find out the prices, for the low season just so you can compare price points for the resorts.<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Happy Planning!<\/p>\n<p>Joyce<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Dream Weddings Riviera Maya- We pay attention to your wishes and coordinate closely with you to ensure your wedding or event is planned to perfection! Supporting you brides and help you feel less overwhelmed during the wedding planning process.<\/p>\n<p>Have fun the best is yet to come!<\/p>\n<p>\u00a0<\/p>\n<p>This is where I will be posting all videos about most common question about Destination wedding<\/p>\n<p> <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0\u00a0<a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/groups\/1664036763874450\/'>https:\/\/www.facebook.com\/groups\/1664036763874450\/<\/a><br><br><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Dream Weddings Riviera Maya<\/span><\/span><\/span><br><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">weddingsinplayadelcarmen@gmail.com<\/span><\/span><br><a  class=\"bbc_url\" href=\"http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html\">http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html<\/a><br><br><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Happy Planning!<\/span><\/span><\/span><br><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Joyce<\/span><\/span><\/span>","Email":"weddingsinplayadelcarmen@gmail.com","IpAddress":"187.252.44.28","GroupId":84,"GroupName":"Insiders w\/ Articles","JoinDate":1326854387,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250090.jpg?_r=1451923195","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"dreamweddings","Id":250090,"Name":"dreamweddings","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"104.245.163.146","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79822,"EditedBy":"<strong>Edited by Moments That Matter, 30 December 2015 - 11:13 AM.<\/strong>","EditDate":1451502814,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d424c58b563980fb4a851260ddbfa74c","RawContent":"&lt;p&gt;Welcome to our forum community Jasmine, and Congrats on your upcoming dw in 2017!!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;You&#039;ve come to the right place for excellent info, advice, suggestions + support - like Joyce&#039;s post above - so well done on your great start already :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;To show you what kind of backdrop the Grand Sirenis (where calgarybride2015 had her wedding) would make for your Wedding Day Love Story in photos, here are some magical wedding moments that matter we captured there.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;...from our &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10150951039939487.436910.18683524486&amp;amp;type=3&#039;&gt;Grand Sirenis Wedding Album:&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xap1\/t31.0-8\/278158_10150951044889487_1793527625_o.jpg\" alt=\"278158_10150951044889487_1793527625_o.jp\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xaf1\/t31.0-8\/277377_10150951046954487_486207691_o.jpg\" alt=\"277377_10150951046954487_486207691_o.jpg\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xfa1\/v\/t1.0-9\/270816_10150951047479487_48048558_n.jpg?oh=b5e05f1aac5f5f1c753604bdede645ad&amp;amp;oe=57147D5D\" alt=\"270816_10150951047479487_48048558_n.jpg?\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xfl1\/t31.0-8\/338751_10150951048374487_246483711_o.jpg\" alt=\"338751_10150951048374487_246483711_o.jpg\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xpa1\/t31.0-8\/278039_10150951048789487_1212638472_o.jpg\" alt=\"278039_10150951048789487_1212638472_o.jp\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Wishing you happy research, all the best with your plans and .....HAPPY New YEAR!!! cheers, team MTM :)&lt;\/p&gt;","Attachments":[],"Id":1908785,"PostDate":1451502776,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome to our forum community Jasmine, and Congrats on your upcoming dw in 2017!!!<\/p>\n<p>\u00a0<\/p>\n<p>You've come to the right place for excellent info, advice, suggestions + support - like Joyce's post above - so well done on your great start already <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>To show you what kind of backdrop the Grand Sirenis (where calgarybride2015 had her wedding) would make for your Wedding Day Love Story in photos, here are some magical wedding moments that matter we captured there.<\/p>\n<p>\u00a0<\/p>\n<p>...from our <a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10150951039939487.436910.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>Grand Sirenis Wedding Album:<\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xap1\/t31.0-8\/278158_10150951044889487_1793527625_o.jpg\" alt=\"278158_10150951044889487_1793527625_o.jp\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xaf1\/t31.0-8\/277377_10150951046954487_486207691_o.jpg\" alt=\"277377_10150951046954487_486207691_o.jpg\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xfa1\/v\/t1.0-9\/270816_10150951047479487_48048558_n.jpg?oh=b5e05f1aac5f5f1c753604bdede645ad&oe=57147D5D\" alt=\"270816_10150951047479487_48048558_n.jpg?\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xfl1\/t31.0-8\/338751_10150951048374487_246483711_o.jpg\" alt=\"338751_10150951048374487_246483711_o.jpg\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xpa1\/t31.0-8\/278039_10150951048789487_1212638472_o.jpg\" alt=\"278039_10150951048789487_1212638472_o.jp\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>Wishing you happy research, all the best with your plans and .....HAPPY New YEAR!!! cheers, team MTM <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280210660,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.51.43.112","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79822,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"616385dc8bb210abffc10ccb7c891e4f","RawContent":"&lt;p&gt;&lt;span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\"&gt;I would definitely suggest reaching out to&amp;nbsp;&lt;a  class=\"bbc_url\" href=\"http:\/\/www.wrighttravelagency.com\/leads\/inquiry\/\" title=\"External link\"&gt;Wright Travel Agency&lt;\/a&gt;&amp;nbsp;-- the official BDW travel agents -- &amp;nbsp;and consider utilizing their services. They have so much knowledge about the different resorts and will help you greatly in providing you with suggestions for the price point range you&#039;re looking for.&amp;nbsp;&lt;span style=\"color:rgb(24,24,24);background-color:rgb(253,252,250);\"&gt;They&amp;nbsp;&lt;\/span&gt;s&lt;span style=\"color:rgb(24,24,24);background-color:rgb(253,252,250);\"&gt;pecialize in Destination weddings and you can&amp;nbsp;&lt;\/span&gt;&lt;a  class=\"bbc_url\" href=\"http:\/\/www.wrighttravelagency.com\/leads\/inquiry\/\" title=\"External link\"&gt;contact them HERE!&lt;\/a&gt;   :)&lt;\/span&gt;&lt;span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\"&gt;Also consider maybe even looking at a different time of year when the rates will be less and fall into your price range -- again a skilled Travel Agent will be able to help you with that. Wright Travel happens to do A LOT of business with Moon Palace so I&#039;m sure they will be able to give you all the ins and outs when it comes to that resort if that&#039;s your first choice!! Hope that helps ;)&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1908786,"PostDate":1451506240,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span  style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif\">I would definitely suggest reaching out to\u00a0<a href='http:\/\/www.wrighttravelagency.com\/leads\/inquiry\/' class='bbc_url' title='External link' rel='nofollow external'>Wright Travel Agency<\/a>\u00a0-- the official BDW travel agents -- \u00a0and consider utilizing their services. They have so much knowledge about the different resorts and will help you greatly in providing you with suggestions for the price point range you're looking for.\u00a0<span  style=\"color:rgb(24,24,24);background-color:rgb(253,252,250)\">They\u00a0<\/span>s<span  style=\"color:rgb(24,24,24);background-color:rgb(253,252,250)\">pecialize in Destination weddings and you can\u00a0<\/span><a href='http:\/\/www.wrighttravelagency.com\/leads\/inquiry\/' class='bbc_url' title='External link' rel='nofollow external'>contact them HERE!<\/a>\u00a0\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/span><span  style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif\">\u00a0<\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif\">Also consider maybe even looking at a different time of year when the rates will be less and fall into your price range -- again a skilled Travel Agent will be able to help you with that. Wright Travel happens to do A LOT of business with Moon Palace so I'm sure they will be able to give you all the ins and outs when it comes to that resort if that's your first choice!! Hope that helps <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-size:18px;\"><span style=\"font-family:georgia;\"><strong>MARIESAM SANCHEZ PHOTOGRAPHY<\/strong><\/span><\/span><br>\nWEBSITE: <a  class=\"bbc_url\" href=\"http:\/\/www.mariesamsanchez.com\">www.mariesamsanchez.com<\/a><br>\nBLOG: <a  class=\"bbc_url\" href=\"http:\/\/www.mariesamsanchezblog.com\">www.mariesamsanchez.com<\/a><a data-ipb='nomediaparse' href='http:\/\/www.mariesamsanchez.com\/blog'>\/blog<\/a><br>\nCONTACT ME: <a  class=\"bbc_email\" href=\"mailto:mariesam.sanchez@gmail.com?subject=BDW%20Inquiry\" title=\"E-mail Link\">mariesam.sanchez@gmail.com<\/a><br><br><img src=\"http:\/\/i287.photobucket.com\/albums\/ll150\/msam007562\/063cb5c8-dbda-4822-87fe-ba3c0ebcdb7f.jpg\" alt=\"063cb5c8-dbda-4822-87fe-ba3c0ebcdb7f.jpg\">","Email":"mariesam.sanchez@gmail.com","IpAddress":"74.100.61.37","GroupId":38,"GroupName":"Moderators","JoinDate":1285954345,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232833.jpg?_r=1422091823","PhotoWidth":200,"PhotoHeight":220,"PhotoType":"custom"},"FormattedName":"MarieSamSanchezPhoto","Id":232833,"Name":"MarieSamSanchezPhoto","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"96.231.40.58","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79822,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"91a77f0d80c0839f307ff191e87e2b22","RawContent":"Hi Jasmine,\n\nFinally another 2017 bride! :) I am also looking into getting married in April 2017. After getting frustrated looking for prices and packages on my own for that time, I hired a travel agent and have felt better about the entire process ever since. Since hiring her, I have been able to narrow my list down to 3 resorts in Jamaica. She has even set up meetings for us to visit them at the end of January. She was also able to get us quotes for the packages available at the resorts for 2017 and estimates on how much our guests will have to pay to stay there. I definitely think that speaking with a travel agent will help ease the process. Good luck!","Attachments":[],"Id":1908798,"PostDate":1451536825,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi Jasmine,<br>\nFinally another 2017 bride! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> I am also looking into getting married in April 2017. After getting frustrated looking for prices and packages on my own for that time, I hired a travel agent and have felt better about the entire process ever since. Since hiring her, I have been able to narrow my list down to 3 resorts in Jamaica. She has even set up meetings for us to visit them at the end of January. She was also able to get us quotes for the packages available at the resorts for 2017 and estimates on how much our guests will have to pay to stay there. I definitely think that speaking with a travel agent will help ease the process. Good luck!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"townsendsmithwed@gmail.com","IpAddress":"173.66.3.166","GroupId":39,"GroupName":"Newbie","JoinDate":1427042404,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282503.jpeg?_r=1444096181","PhotoWidth":200,"PhotoHeight":217,"PhotoType":"custom"},"FormattedName":"tiffanyt","Id":282503,"Name":"tiffanyt","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.224.81.241","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79822,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"59874d94f3d03a14b54396b3297e093a","RawContent":"Yay another April 2017 bride ! I&#039;m having trouble picking a resort as well ! As the others said above, a travel agent will be your best friend ! We have narrowed our choices to azul fives, now jade, and beach palace . Leaning more toward azul fives right now . It&#039;s so hard!","Attachments":[],"Id":1908800,"PostDate":1451567302,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Yay another April 2017 bride ! I'm having trouble picking a resort as well ! As the others said above, a travel agent will be your best friend ! We have narrowed our choices to azul fives, now jade, and beach palace . Leaning more toward azul fives right now . It's so hard! \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"deannakawecki@hotmail.com","IpAddress":"99.224.81.241","GroupId":39,"GroupName":"Newbie","JoinDate":1446521008,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Deannak","Id":285230,"Name":"Deannak","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.16.147.166","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79822,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"51dc3d38bb6bd1806af69591cb276c0a","RawContent":"Hi Ladies~\nI took all of your advice and contacted Barbara from Wright Travel. She has been a lot of help! I think we have narrowed it down to the Riu Palace Peninsula. I already feel a lot better and more excited about wedding planning, having narrowed it down. I just hope we can put a deposit in soon, so I can get to the fun stuff... like save the dates and the wedding website!\n\nHas anyone been to the Riu resorts yet, especially the Palace Peninsula?\n[quote name=\"Deannak\" post=\"1908800\" timestamp=\"1451567302\"]\nYay another April 2017 bride ! I&#039;m having trouble picking a resort as well ! As the others said above, a travel agent will be your best friend ! We have narrowed our choices to azul fives, now jade, and beach palace . Leaning more toward azul fives right now . It&#039;s so hard![\/quote]@[member=\"Deannak\"] Good luck with picking a place! I absolutely Loved those choices, especially the Beach Palace. I just think it was a little too pricey for my guest to come, and the fiance and I decided that we really wanted as many people as we could to be there. But I think all of your choices are amazing!!!\nHave you decided on one yet?","Attachments":[],"Id":1908862,"PostDate":1451791036,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Ladies~<\/p>\n<p>I took all of your advice and contacted Barbara from Wright Travel. She has been a lot of help! I think we have narrowed it down to the Riu Palace Peninsula. I already feel a lot better and more excited about wedding planning, having narrowed it down. I just hope we can put a deposit in soon, so I can get to the fun stuff... like save the dates and the wedding website!<\/p>\n<p>\u00a0<\/p>\n<p>Has anyone been to the Riu resorts yet, especially the Palace Peninsula?<\/p>\n<br \/><p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Deannak, on 31 December 2015 - 05:08 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Yay another April 2017 bride ! I'm having trouble picking a resort as well ! As the others said above, a travel agent will be your best friend ! We have narrowed our choices to azul fives, now jade, and beach palace . Leaning more toward azul fives right now . It's so hard!<\/p>\n<\/div>\n<\/div><\/div>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"285230\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/285230-deannak\/' title='Member profile'><span itemprop=\"name\">Deannak<\/span><\/a> Good luck with picking a place! I absolutely Loved those choices, especially the Beach Palace. I just think it was a little too pricey for my guest to come, and the fiance and I decided that we really wanted as many people as we could to be there. But I think all of your choices are amazing!!!<\/p>\n<p>Have you decided on one yet?<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jbw@mail.sfsu.edu","IpAddress":"172.56.33.25","GroupId":39,"GroupName":"Newbie","JoinDate":1447353369,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"none"},"FormattedName":"Jbwilli","Id":285316,"Name":"Jbwilli","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.224.81.241","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79822,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f20bc7dbabfb1bc6a7c32cb71eacaff2","RawContent":"[quote name=\"Jbwilli\" post=\"1908862\" timestamp=\"1451791036\"]\nHi Ladies~\nI took all of your advice and contacted Barbara from Wright Travel. She has been a lot of help! I think we have narrowed it down to the Riu Palace Peninsula. I already feel a lot better and more excited about wedding planning, having narrowed it down. I just hope we can put a deposit in soon, so I can get to the fun stuff... like save the dates and the wedding website!\n \nHas anyone been to the Riu resorts yet, especially the Palace Peninsula?\n\n@[member=\"Deannak\"] Good luck with picking a place! I absolutely Loved those choices, especially the Beach Palace. I just think it was a little too pricey for my guest to come, and the fiance and I decided that we really wanted as many people as we could to be there. But I think all of your choices are amazing!!!\nHave you decided on one yet?[\/quote]@[member=\"Jbwilli\"] I haven&#039;t 100% chosen. Leaning toward azul fives, it&#039;s just so hard to make a final decision !!! I love beach palace as well but my fianc\u00e9 thinks it might be too small. We wanted smaller but he says it just feels like a hotel and not a resort . Also apparently it can get crowded when the other palace guests decide to visit ...","Attachments":[],"Id":1908863,"PostDate":1451791418,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Jbwilli, on 02 January 2016 - 07:17 PM, said:<\/p><div class='blockquote'><div class='quote'><p>Hi Ladies~<br>\nI took all of your advice and contacted Barbara from Wright Travel. She has been a lot of help! I think we have narrowed it down to the Riu Palace Peninsula. I already feel a lot better and more excited about wedding planning, having narrowed it down. I just hope we can put a deposit in soon, so I can get to the fun stuff... like save the dates and the wedding website!<br>\n\u00a0<br>\nHas anyone been to the Riu resorts yet, especially the Palace Peninsula?<br><br>\n@<a hovercard-ref=\"member\" hovercard-id=\"285230\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/285230-deannak\/' title='Member profile'><span itemprop=\"name\">Deannak<\/span><\/a> Good luck with picking a place! I absolutely Loved those choices, especially the Beach Palace. I just think it was a little too pricey for my guest to come, and the fiance and I decided that we really wanted as many people as we could to be there. But I think all of your choices are amazing!!!<br>\nHave you decided on one yet?<\/p><\/div><\/div>\n<br>\n@<a hovercard-ref=\"member\" hovercard-id=\"285316\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/285316-jbwilli\/' title='Member profile'><span itemprop=\"name\">Jbwilli<\/span><\/a> I haven't 100% chosen. Leaning toward azul fives, it's just so hard to make a final decision !!! I love beach palace as well but my fianc\u00e9 thinks it might be too small. We wanted smaller but he says it just feels like a hotel and not a resort . Also apparently it can get crowded when the other palace guests decide to visit ...\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"deannakawecki@hotmail.com","IpAddress":"99.224.81.241","GroupId":39,"GroupName":"Newbie","JoinDate":1446521008,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Deannak","Id":285230,"Name":"Deannak","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.224.81.241","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79822,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"ea1ca5d9895e9d39659886a2d4fe2de7","RawContent":"[quote name=\"Deannak\" post=\"1908863\" timestamp=\"1451791418\"]\n@[member=\"Jbwilli\"] I haven&#039;t 100% chosen. Leaning toward azul fives, it&#039;s just so hard to make a final decision !!! I love beach palace as well but my fianc\u00e9 thinks it might be too small. We wanted smaller but he says it just feels like a hotel and not a resort . Also apparently it can get crowded when the other palace guests decide to visit ...[\/quote]Oh and another thing in common, i got engaged in september as well, haha","Attachments":[],"Id":1908864,"PostDate":1451794074,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Deannak, on 02 January 2016 - 07:23 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"285316\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/285316-jbwilli\/' title='Member profile'><span itemprop=\"name\">Jbwilli<\/span><\/a> I haven't 100% chosen. Leaning toward azul fives, it's just so hard to make a final decision !!! I love beach palace as well but my fianc\u00e9 thinks it might be too small. We wanted smaller but he says it just feels like a hotel and not a resort . Also apparently it can get crowded when the other palace guests decide to visit ...<\/p>\n<\/div>\n<\/div><\/div>\n<p>Oh and another thing in common, i got engaged in september as well, haha<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"deannakawecki@hotmail.com","IpAddress":"99.224.81.241","GroupId":39,"GroupName":"Newbie","JoinDate":1446521008,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Deannak","Id":285230,"Name":"Deannak","IsOnline":false}}],"Id":"79822","Title":"Need Help Picking A Resort For April 2017","LastPostDate":1451794074},"Pages":{"TotalItems":10,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
