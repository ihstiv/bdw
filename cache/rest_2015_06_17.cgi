PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"MissFrench","Id":280992,"Name":"MissFrench","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.249.133.244","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79255,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ecf51921b8dfe8c9fb551ba74c70865e","RawContent":"&lt;p&gt;I think any of the AM resorts would be a good fit for you (they include Dreams, Secrets, Now resorts). They offer a complementary wedding package if you have a certain number of rooms booked for 3 nights.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1898098,"PostDate":1433788962,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I think any of the AM resorts would be a good fit for you (they include Dreams, Secrets, Now resorts). They offer a complementary wedding package if you have a certain number of rooms booked for 3 nights.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kelly_miller_@hotmail.com","IpAddress":"99.249.122.85","GroupId":40,"GroupName":"Jr. Member","JoinDate":1390772931,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kellymiller","Id":276338,"Name":"kellymiller","IsOnline":false}}],"Id":"79255","Title":"Small Destination Wedding In Cabo","LastPostDate":143378