{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":464,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":true,"Views":60287,"MovedTo":null,"MovedOn":0,"FirstPostId":1725682,"Rating":0,"RatingHits":0,"Starter":{"Id":264243,"Name":"Kristina Simms","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-264243.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"StartDate":1361850659,"LastPoster":{"Id":282892,"Name":"FutureMrsVanthof","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282892.jpg?_r=1434622094","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":22,"Preview":{"Id":1725682,"PostDate":1361850659,"PostContent":"Any Now brides out there getting married in 2014?  \u00a0  Let's start planning!","Author":{"Signature":"","Email":"kristinasimms@hotmail.com","IpAddress":"68.150.70.86","GroupId":39,"GroupName":"Newbie","JoinDate":1357867978,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-264243.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Kristina Simms","Id":264243,"Name":"Kristina Simms","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"922146e59a13521d4eb0d5d35dd6c2e9","RawContent":"&lt;p&gt; Any Now brides out there getting married in 2014?&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Let&#039;s start planning!&lt;\/p&gt;","Attachments":[],"Id":1725682,"PostDate":1361850659,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Any Now brides out there getting married in 2014?<\/p> <p> \u00a0<\/p> <p> Let's start planning!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kristinasimms@hotmail.com","IpAddress":"68.150.70.86","GroupId":39,"GroupName":"Newbie","JoinDate":1357867978,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-264243.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Kristina Simms","Id":264243,"Name":"Kristina Simms","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"039019669f4f1f00a69605b9b95e6526","RawContent":"&lt;p&gt; Yes!! I&#039;m in April 2014!! :)&lt;\/p&gt;","Attachments":[],"Id":1733049,"PostDate":1363176114,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Yes!! I'm in April 2014!! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mjouellette0@hotmail.com","IpAddress":"174.118.194.63","GroupId":39,"GroupName":"Newbie","JoinDate":1361236226,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-266253.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"MJ Ouellette","Id":266253,"Name":"MJ Ouellette","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"02336468b7058994e2757fde47f3a2c4","RawContent":"&lt;p&gt; I&#039;m trying to decide between NOW Larimar and Dreams La Romana, can you girls please share with me what tipped the scales and made you pick NOW?&amp;nbsp;\n &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1735627,"PostDate":1363707437,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I'm trying to decide between NOW Larimar and Dreams La Romana, can you girls please share with me what tipped the scales and made you pick NOW?\u00a0<br \/> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"karinbean@pgatourhq.com","IpAddress":"67.190.225.116","GroupId":47,"GroupName":"Site Supporter","JoinDate":1363558492,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-267461.jpg?_r=1430657102","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"JaxBchKay","Id":267461,"Name":"JaxBchKay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4e1282e6025ec25175d11746a43efde5","RawContent":"&lt;p&gt; Hello!&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Congratulations on your upcoming weddings!&lt;\/p&gt; &lt;p&gt; We look forward to working with all of you next year for your big event!&lt;\/p&gt; &lt;p&gt; We are here for any question about the pictures and Resort.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Happy planning! :)&lt;\/p&gt;","Attachments":[],"Id":1736364,"PostDate":1363807544,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hello!<\/p> <p> \u00a0<\/p> <p> Congratulations on your upcoming weddings!<\/p> <p> We look forward to working with all of you next year for your big event!<\/p> <p> We are here for any question about the pictures and Resort.<\/p> <p> \u00a0<\/p> <p> Happy planning! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"weddings@wbastudio.com","IpAddress":"186.6.222.235","GroupId":44,"GroupName":"Vendor","JoinDate":1350747395,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-261572.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"WBA Weddings","Id":261572,"Name":"WBA Weddings","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1c66cc8db9b61676e338da2294d3505c","RawContent":"&lt;p&gt; I&#039;m in Jan 2014. Do you have your wedding booked with the resort yet?&lt;\/p&gt;","Attachments":[],"Id":1740082,"PostDate":1364580835,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I'm in Jan 2014. Do you have your wedding booked with the resort yet?<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kristinasimms@hotmail.com","IpAddress":"68.150.70.86","GroupId":39,"GroupName":"Newbie","JoinDate":1357867978,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-264243.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Kristina Simms","Id":264243,"Name":"Kristina Simms","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c937d275589a1deb2d5c55720806a73e","RawContent":"&lt;p&gt; JaxBchKay, there were a few things that made me personally choose the Now. First of all, I really liked the wedding packages that the NOW\/Dreams\/Secrets offers. My fiance and I had originally wanted an adults only resort but because of the price point we decided to go with a family resort. I really liked the NOW Larimar because it is literally right next to the Secrets (adults only) so our guests can have the choice of which side to stay at according to their preferences\/budgets. We will be staying a week at each. I have never been to the DR, but I have heard that Punta Cana is a nicer area than La Romana. However it is the DR so i&#039;m sure any place is awesome! I looked at so many resorts but just kept coming back the the AMResorts because of the wedding packages. I&#039;ve heard a lot of good things about the Secrets resorts and my travel agent has sent couples to the NOW Larimar in the past and actually toured it herself which helped me feel better about our decision. I&#039;m sure whatever resort you pick will be fantastic. Good luck!&lt;\/p&gt;","Attachments":[],"Id":1740086,"PostDate":1364581472,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> JaxBchKay, there were a few things that made me personally choose the Now. First of all, I really liked the wedding packages that the NOW\/Dreams\/Secrets offers. My fiance and I had originally wanted an adults only resort but because of the price point we decided to go with a family resort. I really liked the NOW Larimar because it is literally right next to the Secrets (adults only) so our guests can have the choice of which side to stay at according to their preferences\/budgets. We will be staying a week at each. I have never been to the DR, but I have heard that Punta Cana is a nicer area than La Romana. However it is the DR so i'm sure any place is awesome! I looked at so many resorts but just kept coming back the the AMResorts because of the wedding packages. I've heard a lot of good things about the Secrets resorts and my travel agent has sent couples to the NOW Larimar in the past and actually toured it herself which helped me feel better about our decision. I'm sure whatever resort you pick will be fantastic. Good luck!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kristinasimms@hotmail.com","IpAddress":"68.150.70.86","GroupId":39,"GroupName":"Newbie","JoinDate":1357867978,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-264243.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Kristina Simms","Id":264243,"Name":"Kristina Simms","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"a71b6f1916038173ed3b08ddd0714efb","RawContent":"&lt;p&gt; Hi ladies!!&amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; We&#039;ve worked with Now Larimar on a number of weddings and they always do a fabulous job. This resort has some of the best wedding planners around! I love that there&#039;s the Now Larimar and the Secrets Royal Beach sides. Your guests can choose where they prefer to stay and both sides are very accommodating. It&#039;s also awesome that there are no bracelets. The resort is fairly small, it&#039;s easy to get around and connect with all your wedding guests. It&#039;s the perfect choice!!!&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Just to let you know, they have recently changed the &#039;outside vendor&#039; policy and it&#039;s now $500 to bring your own photographer\/videographer team. Rob &amp;amp; I do both photo &amp;amp; video and have a special deal for our Now Larimar brides - we pay half of this fee for you (or simply give you a $250 reduction on your favourite Collection). From the perspective of both a photographer AND a recent bride, I invite you to do your homework and make sure you absolutely love whomever you hire to document your love!!&amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Here&#039;s some eye candy from our recent wedding there...&amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p id=\"yui_3_7_3_1_1365450354555_1921\"&gt; &lt;img alt=\" \" data-id=\"197875\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/197875\/width\/500\/height\/1000\" \/&gt;&lt;img alt=\" \" data-id=\"197876\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/197876\/width\/500\/height\/1000\" \/&gt;&lt;img alt=\" \" data-id=\"197877\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/197877\/width\/500\/height\/1000\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p id=\"yui_3_7_3_1_1365450354555_8381\"&gt; &lt;img alt=\" \" data-id=\"197879\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/197879\/width\/500\/height\/1000\" \/&gt;&lt;img alt=\" \" data-id=\"197884\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/197884\/width\/500\/height\/1000\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; For more, check out these other weddings:&amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p style=\"margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Helvetica\"&gt; &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.katyanovablog.com\/now-larimar-punta-cana-wedding-taylor-scott\/\"&gt;http:\/\/www.katyanovablog.com\/now-larimar-punta-cana-wedding-taylor-scott\/&lt;\/a&gt;&lt;\/p&gt; &lt;p style=\"margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Helvetica\"&gt; &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.katyanovablog.com\/secrets-royal-beach-wedding-photographer-laura-jeff\/\"&gt;http:\/\/www.katyanovablog.com\/secrets-royal-beach-wedding-photographer-laura-jeff\/&lt;\/a&gt;&lt;\/p&gt; &lt;p style=\"margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Helvetica\"&gt; &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.katyanovablog.com\/tamara-jeff-now-larimar-wedding-punta-cana\/\"&gt;http:\/\/www.katyanovablog.com\/tamara-jeff-now-larimar-wedding-punta-cana\/&lt;\/a&gt;&lt;\/p&gt; &lt;p style=\"margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Helvetica\"&gt; &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.katyanovablog.com\/samantha-travis-now-larimar-engagement-punta-cana-dr\/\"&gt;http:\/\/www.katyanovablog.com\/samantha-travis-now-larimar-engagement-punta-cana-dr\/&lt;\/a&gt;&lt;\/p&gt; &lt;p style=\"margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Helvetica\"&gt; &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.katyanovablog.com\/now-larimar-punta-cana-wedding-jen-jack\/\"&gt;http:\/\/www.katyanovablog.com\/now-larimar-punta-cana-wedding-jen-jack\/&lt;\/a&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I&#039;m here for you if you have any questions about the place!!!&amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Hugs from Punta Cana,&amp;nbsp;&lt;\/p&gt; &lt;p&gt; \n Katya.&amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;a data-ipb=&#039;nomediaparse&#039; href=\"mailto:katya@katyanova.com?subject=hello!\"&gt;katya@katyanova.com&lt;\/a&gt;&lt;\/p&gt;","Attachments":[],"Id":1743272,"PostDate":1365445594,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hi ladies!!\u00a0<\/p> <p> \u00a0<\/p> <p> We've worked with Now Larimar on a number of weddings and they always do a fabulous job. This resort has some of the best wedding planners around! I love that there's the Now Larimar and the Secrets Royal Beach sides. Your guests can choose where they prefer to stay and both sides are very accommodating. It's also awesome that there are no bracelets. The resort is fairly small, it's easy to get around and connect with all your wedding guests. It's the perfect choice!!!<\/p> <p> \u00a0<\/p> <p> Just to let you know, they have recently changed the 'outside vendor' policy and it's now $500 to bring your own photographer\/videographer team. Rob & I do both photo & video and have a special deal for our Now Larimar brides - we pay half of this fee for you (or simply give you a $250 reduction on your favourite Collection). From the perspective of both a photographer AND a recent bride, I invite you to do your homework and make sure you absolutely love whomever you hire to document your love!!\u00a0<\/p> <p> \u00a0<\/p> <p> Here's some eye candy from our recent wedding there...\u00a0<\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p id=\"yui_3_7_3_1_1365450354555_1921\"> <span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"197875\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/197875\/width\/500\/height\/1000\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"197876\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/197876\/width\/500\/height\/1000\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"197877\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/197877\/width\/500\/height\/1000\" \/><\/span><\/p> <p> \u00a0<\/p> <p id=\"yui_3_7_3_1_1365450354555_8381\"> <span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"197879\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/197879\/width\/500\/height\/1000\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"197884\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/197884\/width\/500\/height\/1000\" \/><\/span><\/p> <p> \u00a0<\/p> <p> For more, check out these other weddings:\u00a0<\/p> <p> \u00a0<\/p> <p  style=\"margin: 0.0px 0.0px 0.0px 0.0px\"> <a href='http:\/\/www.katyanovablog.com\/now-larimar-punta-cana-wedding-taylor-scott\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.katyanova...g-taylor-scott\/<\/a><\/p> <p  style=\"margin: 0.0px 0.0px 0.0px 0.0px\"> <a href='http:\/\/www.katyanovablog.com\/secrets-royal-beach-wedding-photographer-laura-jeff\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.katyanova...her-laura-jeff\/<\/a><\/p> <p  style=\"margin: 0.0px 0.0px 0.0px 0.0px\"> <a href='http:\/\/www.katyanovablog.com\/tamara-jeff-now-larimar-wedding-punta-cana\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.katyanova...ing-punta-cana\/<\/a><\/p> <p  style=\"margin: 0.0px 0.0px 0.0px 0.0px\"> <a href='http:\/\/www.katyanovablog.com\/samantha-travis-now-larimar-engagement-punta-cana-dr\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.katyanova...-punta-cana-dr\/<\/a><\/p> <p  style=\"margin: 0.0px 0.0px 0.0px 0.0px\"> <a href='http:\/\/www.katyanovablog.com\/now-larimar-punta-cana-wedding-jen-jack\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.katyanova...dding-jen-jack\/<\/a><\/p> <p> \u00a0<\/p> <p> I'm here for you if you have any questions about the place!!!\u00a0<\/p> <p> \u00a0<\/p> <p> Hugs from Punta Cana,\u00a0<\/p> <p> <br \/> Katya.\u00a0<\/p> <p> <a href='mailto:katya@katyanova.com?subject=hello!' class='bbc_url' title='External link' rel='nofollow external'>katya@katyanova.com<\/a><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kzheleznova@yahoo.com","IpAddress":"61.19.236.122","GroupId":44,"GroupName":"Vendor","JoinDate":1261912145,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-224102.jpg?_r=0","PhotoWidth":180,"PhotoHeight":270,"PhotoType":"custom"},"FormattedName":"KatyaNova","Id":224102,"Name":"KatyaNova","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"56e4459e6bfda0e4764edb8e8440b801","RawContent":"&lt;p&gt; I just booked for January 2014 as well, what day is your wedding? we have the 15th at 4:00pm.&amp;nbsp;Have you booked your location for the reception or cermony yet?&lt;\/p&gt;","Attachments":[],"Id":1744431,"PostDate":1365705413,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I just booked for January 2014 as well, what day is your wedding? we have the 15th at 4:00pm.\u00a0Have you booked your location for the reception or cermony yet?<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"amanda.kemp@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1365704804,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268451.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"amanda15012014","Id":268451,"Name":"amanda15012014","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fff4360a86d15776b2c000649bacb73a","RawContent":"@amanda15012014 We have Jan 28 booked, well we are still waiting on the confirmation from the resort. On those request forms I did include location for ceremony and reception. Did you book yours yet?","Attachments":[],"Id":1744740,"PostDate":1365785148,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @amanda15012014 We have Jan 28 booked, well we are still waiting on the confirmation from the resort. On those request forms I did include location for ceremony and reception. Did you book yours yet?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kristinasimms@hotmail.com","IpAddress":"68.150.70.86","GroupId":39,"GroupName":"Newbie","JoinDate":1357867978,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-264243.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Kristina Simms","Id":264243,"Name":"Kristina Simms","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2b9fa1ea55d99c5fbeb8efdd7d8b609d","RawContent":"We got confirmation last week but I didn&#039;t include locations on that page cause we weren&#039;t sure. I emailed a request for the eclipse terrace and pool side reception today so we will see, I&#039;ve been waiting almost a week now to hear if they can find more preferred rooms for our reservation so we will see.","Attachments":[],"Id":1744801,"PostDate":1365791295,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We got confirmation last week but I didn't include locations on that page cause we weren't sure. I emailed a request for the eclipse terrace and pool side reception today so we will see, I've been waiting almost a week now to hear if they can find more preferred rooms for our reservation so we will see.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"amanda.kemp@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1365704804,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268451.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"amanda15012014","Id":268451,"Name":"amanda15012014","IsOnline":false}}],"Id":"72826","Title":"Now Larimar 2014 Brides","LastPostDate":1455820611},"Pages":{"TotalItems":464,"TotalPages":47,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":460},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
