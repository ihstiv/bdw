{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":3925,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":true,"Views":293410,"MovedTo":null,"MovedOn":0,"FirstPostId":635048,"Rating":0,"RatingHits":0,"Starter":{"Id":215390,"Name":"VallieR","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-215390.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"IsOnline":false},"StartDate":1238272763,"LastPoster":{"Id":284131,"Name":"MegLeLy","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":22,"Preview":{"Id":635048,"PostDate":1238272763,"PostContent":"I've been researching Dreams La Romana for our wedding. Has anyone or is anyone getting married t...","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;130\/st\/20100529\/e\/Our+Wedding\/k\/9605\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...9605\/event.png<\/a><\/div><\/div>","Email":"jbval@comcast.net","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1236031828,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-215390.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"VallieR","Id":215390,"Name":"VallieR","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":33667,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ced814b8fad5e12865e09925331ea226","RawContent":"I&#039;ve been researching Dreams La Romana for our wedding. Has anyone or is anyone getting married there and has pictures or advice. I have all the information from the resort. Just want to make sure this is the place I really want.","Attachments":[],"Id":635048,"PostDate":1238272763,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I've been researching Dreams La Romana for our wedding. Has anyone or is anyone getting married there and has pictures or advice. I have all the information from the resort. Just want to make sure this is the place I really want.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;130\/st\/20100529\/e\/Our+Wedding\/k\/9605\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...9605\/event.png<\/a><\/div><\/div>","Email":"jbval@comcast.net","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1236031828,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-215390.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"VallieR","Id":215390,"Name":"VallieR","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":33667,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"604b0920a55806223ad64ffb6f3783da","RawContent":"Hi!\n \n I am actually planning on doing a site there next month while i am in DR. i can let you know my thoughts when I return. can you forward me the information you have?","Attachments":[],"Id":635058,"PostDate":1238273473,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi!<br \/> <br \/> I am actually planning on doing a site there next month while i am in DR. i can let you know my thoughts when I return. can you forward me the information you have?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"laybar2143@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1203384178,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208574.gif?_r=0","PhotoWidth":75,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"laybar","Id":208574,"Name":"laybar","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":33667,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7efa63e7cda8e4475dceb1667898a9f6","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;laybar&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Hi!\n \n I am actually planning on doing a site there next month while i am in DR. i can let you know my thoughts when I return. can you forward me the information you have?&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;sent you a pm","Attachments":[],"Id":635065,"PostDate":1238273978,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>laybar<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Hi!<br \/> <br \/> I am actually planning on doing a site there next month while i am in DR. i can let you know my thoughts when I return. can you forward me the information you have?<\/div> <\/td> <\/tr> <\/table> <\/div>sent you a pm\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;130\/st\/20100