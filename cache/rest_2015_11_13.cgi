{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":2,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":68,"MovedTo":null,"MovedOn":0,"FirstPostId":1907332,"Rating":0,"RatingHits":0,"Starter":{"Id":285292,"Name":"gerber50","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1447180632,"LastPoster":{"Id":232000,"Name":"acw271011","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"IsOnline":true},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1907332,"PostDate":1447180632,"PostContent":"Hi everyone! \u00a0 I am very excited to meet you all and hope your wedding plans are coming along smo...","Author":{"Signature":"","Email":"jamieleeit@gmail.com","IpAddress":"104.173.22.205","GroupId":39,"GroupName":"Newbie","JoinDate":1447179695,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"gerber50","Id":285292,"Name":"gerber50","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"104.173.22.205","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79724,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"488c9ccb29a7938cca872a67a548885c","RawContent":"&lt;p&gt;Hi everyone!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am very excited to meet you all and hope your wedding plans are coming along smoothly.&amp;nbsp; I am hoping also to connect with those who may have information about photographers in Nicaragua.&amp;nbsp; This seems to be the biggest challenge for me as we just cannot afford to fly a photographer from the US and additionally pay their fees. If anyone has any advice or suggestions, i am open to them!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Happy planning everyone!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Jamie&lt;\/p&gt;","Attachments":[],"Id":1907332,"PostDate":1447180632,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi everyone!<\/p>\n<p>\u00a0<\/p>\n<p>I am very excited to meet you all and hope your wedding plans are coming along smoothly.\u00a0 I am hoping also to connect with those who may have information about photographers in Nicaragua.\u00a0 This seems to be the biggest challenge for me as we just cannot afford to fly a photographer from the US and additionally pay their fees. If anyone has any advice or suggestions, i am open to them!<\/p>\n<p>\u00a0<\/p>\n<p>Happy planning everyone!<\/p>\n<p>\u00a0<\/p>\n<p>Jamie<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jamieleeit@gmail.com","IpAddress":"104.173.22.205","GroupId":39,"GroupName":"Newbie","JoinDate":1447179695,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"gerber50","Id":285292,"Name":"gerber50","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.42.38","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79724,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3cc84e2b73105d5a7002863d3364e6fb","RawContent":"&lt;p&gt;@[member=\"gerber50\"] Congrats and welcome. I have to say you&#039;re the first bride I&#039;ve seen here getting married in Nicaragua! What a wonderful idea! Unfortunately I haven&#039;t seen anyone post here with a photographer there. If you can&#039;t afford to fly one from the US, what about reaching out to someone in another country where the cost of a flight will be cheaper? As well, did you speak with any photographers in the US? Sometimes for paying their way, they&#039;ll reduce the cost of their fees. I remember speaking with a photographer here when we were planning our wedding in 2011 in Jamaica, and they offered to cut their costs by more than half to go with us to Jamaica. They would have stayed the whole week with us and taken photos of the whole trip, not just our wedding day. That might be something worth looking into. As well, have you checked the photographer reviews on this site? There might be something there worth checking.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck!&lt;\/p&gt;","Attachments":[],"Id":1907364,"PostDate":1447215273,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"285292\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/285292-gerber50\/' title='Member profile'><span itemprop=\"name\">gerber50<\/span><\/a> Congrats and welcome. I have to say you're the first bride I've seen here getting married in Nicaragua! What a wonderful idea! Unfortunately I haven't seen anyone post here with a photographer there. If you can't afford to fly one from the US, what about reaching out to someone in another country where the cost of a flight will be cheaper? As well, did you speak with any photographers in the US? Sometimes for paying their way, they'll reduce the cost of their fees. I remember speaking with a photographer here when we were planning our wedding in 2011 in Jamaica, and they offered to cut their costs by more than half to go with us to Jamaica. They would have stayed the whole week with us and taken photos of the whole trip, not just our wedding day. That might be something worth looking into. As well, have you checked the photographer reviews on this site? There might be something there worth checking.<\/p>\n<p>\u00a0<\/p>\n<p>Good luck!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><em><span style=\"color:rgb(51,153,255);\">I'm lucky enough to\u00a0tell my husband how much I love him and say yes again\u00a0on October 20, 2015 at Grand Coral Beach Club!\u00a0<\/span><\/em>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283458999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}}],"Id":"79724","Title":"Newbie June 2016 Bride Managua Nicaragua!","LastPostDate":1447215273},"Pages":{"TotalItems":2,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
