Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":6,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":92,"MovedTo":null,"MovedOn":0,"FirstPostId":1907333,"Rating":0,"RatingHits":0,"Starter":{"Id":285199,"Name":"swalker7979","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1447181949,"LastPoster":{"Id":277873,"Name":"calgarybride2015","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1907333,"PostDate":1447181949,"PostContent":"Hello everyone! I just got engaged last month and I have always wanted a destination wedding. We...","Author":{"Signature":"","Email":"swalker7979@gmail.com","IpAddress":"159.53.46.141","GroupId":39,"GroupName":"Newbie","JoinDate":1446050380,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"swalker7979","Id":285199,"Name":"swalker7979","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"159.53.174.141","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79725,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"0baf85001e8787ce302054a0fad28b01","RawContent":"&lt;p&gt;Hello everyone! I just got engaged last month and I have always wanted a destination wedding. We want to get married in Sept\/Oct 2016 and have selected Punta Cana b\/c my fiance&#039; and I visited 2 years ago and really loved it. In looking at reviews, pictures, and posts on this site we have a really big interest in Melia Caribe Tropical. I really love their gazebos and it seems to be budget friendly. Has anyone gotten married there recently or planning to within the next year? Where did you or planning to have your reception ? We are looking to have around 50 guests. To anyone who has stayed here, what was your overall feel of the resort? I am currently working w\/ a TA who is getting quotes from Melia, Royalton, and NOW Larimar as a comparison. I am so excited to begin planning!&lt;\/p&gt;","Attachments":[],"Id":1907333,"PostDate":1447181949,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello everyone! I just got engaged last month and I have always wanted a destination wedding. We want to get married in Sept\/Oct 2016 and have selected Punta Cana b\/c my fiance' and I visited 2 years ago and really loved it. In looking at reviews, pictures, and posts on this site we have a really big interest in Melia Caribe Tropical. I really love their gazebos and it seems to be budget friendly. Has anyone gotten married there recently or planning to within the next year? Where did you or planning to have your reception ? We are looking to have around 50 guests. To anyone who has stayed here, what was your overall feel of the resort? I am currently working w\/ a TA who is getting quotes from Melia, Royalton, and NOW Larimar as a comparison. I am so excited to begin planning!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"swalker7979@gmail.com","IpAddress":"159.53.46.141","GroupId":39,"GroupName":"Newbie","JoinDate":1446050380,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"swalker7979","Id":285199,"Name":"swalker7979","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.146.146.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79725,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"732ef4defd1ec448aa3760759018216d","RawContent":"Welcome and congrats. We had a recent bride for your resort. I can&#039;t think of her username (sorry Kristy) so I sent her a FB msg to come help you out :)\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1907359,"PostDate":1447211853,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Welcome and congrats. We had a recent bride for your resort. I can't think of her username (sorry Kristy) so I sent her a FB msg to come help you out <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399428602,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"137.186.98.6","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79725,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"e79b06050828759f8ba6349eafcd78e6","RawContent":"Facebook message received and now here I am. Sorry I have been MIA in a while. @[member=\"swalker7979\"]\n\n@[member=\"calgarybride2015\"]\n\n\nI just got married at Melia in April of this year. I had a total of 29 guests and all of them loved the resort. Not one complaint from my guests. They loved it. Even with it being such a big resort (it&#039;s huge, so if you aren&#039;t into the really big resorts then maybe opt out). But honestly it might be huge but it&#039;s beautiful and lots of restaurant options.\n\nMy husband and I stayed at the level adult only section of the resort (would highly recommend the upgrade).\n\nSo I chose to have the ceremony at the garden gazebo just cause I loved the way it looked and the garden surrounding it. And it went with the package I chose which was the basic package aka free wedding. The reason I chose this is because I had the reception off the resort. My reception was on La Barcaza wedding boat (which I also highly recommend if you are looking for laid back kind of reception). Anyway, Geraldy was my wedding coordinator and I tell you he is simply the best. He did everything so great and made us feel so special. He does a lot of these weddings and simple put, I didn&#039;t feel like I was just a number to him. We had a cocktail hour right near the garden gazebo and the food (which I didn&#039;t have because I was busy either pictures) was excellent according to the guests. My brother said that the cocktail hour food that he had was the best he had at the resort. \n\n\nAnymore questions feel free to ask but I honestly don&#039;t think you will go wrong at all at booking this resort. It&#039;s simply breathtaking in my mind. The landscaping is beautiful and for a wedding it is just amazing.","Attachments":[],"Id":1907361,"PostDate":1447213459,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Facebook message received and now here I am. Sorry I have been MIA in a while. @<a hovercard-ref=\"member\" hovercard-id=\"285199\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/285199-swalker7979\/' title='Member profile'><span itemprop=\"name\">swalker7979<\/span><\/a><br>\n@<a hovercard-ref=\"member\" hovercard-id=\"277873\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277873-calgarybride2015\/' title='Member profile'><span itemprop=\"name\">calgarybride2015<\/span><\/a><br><br>\nI just got married at Melia in April of this year. I had a total of 29 guests and all of them loved the resort. Not one complaint from my guests. They loved it. Even with it being such a big resort (it's huge, so if you aren't into the really big resorts then maybe opt out). But honestly it might be huge but it's beautiful and lots of restaurant options.<br>\nMy husband and I stayed at the level adult only section of the resort (would highly recommend the upgrade).<br>\nSo I chose to have the ceremony at the garden gazebo just cause I loved the way it looked and the garden surrounding it. And it went with the package I chose which was the basic package aka free wedding. The reason I chose this is because I had the reception off the resort. My reception was on La Barcaza wedding boat (which I also highly recommend if you are looking for laid back kind of reception). Anyway, Geraldy was my wedding coordinator and I tell you he is simply the best. He did everything so great and made us feel so special. He does a lot of these weddings and simple put, I didn't feel like I was just a number to him. We had a cocktail hour right near the garden gazebo and the food (which I didn't have because I was busy either pictures) was excellent according to the guests. My brother said that the cocktail hour food that he had was the best he had at the resort. <br><br>\nAnymore questions feel free to ask but I honestly don't think you will go wrong at all at booking this resort. It's simply breathtaking in my mind. The landscaping is beautiful and for a wedding it is just amazing. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p style=\"text-align:center;\"><strong>Kristy and Nathan<\/strong><\/p>\n<p style=\"text-align:center;\"><strong>Melia Caribe Tropical <\/strong><\/p>\n<p style=\"text-align:center;\"><strong>April 17, 2015<\/strong>","Email":"colek_64@hotmail.com","IpAddress":"199.180.174.8","GroupId":3,"GroupName":"Member","JoinDate":1395346614,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277264.jpg?_r=1429937323","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"kcole123","Id":277264,"Name":"kcole123","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.42.38","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79725,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3f96205bdc5da19a21036bc72baba42a","RawContent":"&lt;p&gt;Weeeeeee!! Kristy!!! @kcole123&amp;nbsp; Hey girl! How&#039;s married life??? I wish you would stop in now and then and say hi!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;@[member=\"swalker7979\"] I&#039;ve posted the link to Kristy&#039;s thread since it&#039;s so totally amazing! And her photos are absolutely stunning!! She wrote a great review so I&#039;m sure you&#039;ll find tons of info that should be helpful.&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/topic\/78626-kcole123-planning-thread-april-17-2015-melia-caribe-tropical\/&#039;&gt;http:\/\/www.bestdestinationwedding.com\/topic\/78626-kcole123-planning-thread-april-17-2015-melia-caribe-tropical\/&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;As well, if you type in the resort name in the search bar at the top, you&#039;ll get several forums to read through.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck and happy planning!&lt;\/p&gt;","Attachments":[],"Id":1907365,"PostDate":1447215867,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Weeeeeee!! Kristy!!! @kcole123\u00a0 Hey girl! How's married life??? I wish you would stop in now and then and say hi!<\/p>\n<p>\u00a0<\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"285199\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/285199-swalker7979\/' title='Member profile'><span itemprop=\"name\">swalker7979<\/span><\/a> I've posted the link to Kristy's thread since it's so totally amazing! And her photos are absolutely stunning!! She wrote a great review so I'm sure you'll find tons of info that should be helpful.<\/p>\n<p><a href='http:\/\/www.bestdestinationwedding.com\/topic\/78626-kcole123-planning-thread-april-17-2015-melia-caribe-tropical\/' class='bbc_url' title=''>http:\/\/www.bestdesti...aribe-tropical\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>As well, if you type in the resort name in the search bar at the top, you'll get several forums to read through.<\/p>\n<p>\u00a0<\/p>\n<p>Good luck and happy planning!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><em><span style=\"color:rgb(51,153,255);\">I'm lucky enough to\u00a0tell my husband how much I love him and say yes again\u00a0on October 20, 2015 at Grand Coral Beach Club!\u00a0<\/span><\/em>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283458999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"137.186.98.6","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79725,"EditedBy":"<strong>Edited by kcole123, 10 November 2015 - 09:27 PM.<\/strong>","EditDate":1447219638,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"602c235879c1efcf8d75d0f52c767eec","RawContent":"@[member=\"acw271011\"]\n\nHey sweetheart how are you doing?\n\n\nMarried life for me is going great. I am actually helping my new sister in law somewhat plan her wedding, well giving her advice or helpful tips. She isn&#039;t having a destination wedding though (they are the way to go in my opinion).\n\nIt&#039;s only been like since April but I found it so hard to just be \"no more planning.\" It seems you get so consumed with it that it&#039;s just sad when it ends. So I have taken up photography to fulfil that void. Haha I wanted a hobby after all the wedding planning was over anyway and I have always had an interest in photography. I absolutely am loving it.\n\n\nHow is everything with you? I must go visit your planning thread to see all our pictures.","Attachments":[],"Id":1907372,"PostDate":1447219544,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"232000\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/232000-acw271011\/' title='Member profile'><span itemprop=\"name\">acw271011<\/span><\/a><br>\nHey sweetheart how are you doing?<br><br>\nMarried life for me is going great. I am actually helping my new sister in law somewhat plan her wedding, well giving her advice or helpful tips. She isn't having a destination wedding though (they are the way to go in my opinion).<br>\nIt's only been like since April but I found it so hard to just be \"no more planning.\" It seems you get so consumed with it that it's just sad when it ends. So I have taken up photography to fulfil that void. Haha I wanted a hobby after all the wedding planning was over anyway and I have always had an interest in photography. I absolutely am loving it.<br><br>\nHow is everything with you? I must go visit your planning thread to see all our pictures. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p style=\"text-align:center;\"><strong>Kristy and Nathan<\/strong><\/p>\n<p style=\"text-align:center;\"><strong>Melia Caribe Tropical <\/strong><\/p>\n<p style=\"text-align:center;\"><strong>April 17, 2015<\/strong>","Email":"colek_64@hotmail.com","IpAddress":"199.180.174.8","GroupId":3,"GroupName":"Member","JoinDate":1395346614,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277264.jpg?_r=1429937323","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"kcole123","Id":277264,"Name":"kcole123","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.146.146.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79725,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d2dcbeef5e7d5d7313c7d1f893c54cef","RawContent":"@[member=\"kcole123\"] we upgraded to the level at our Melia resort in Cuba for our one year.  Looks fantastic and is brand new to this hotel so excited to see what it&#039;s like.   At another melia it was concierge service and we felt like royalty but by the sounds of it this will be way better.  Did you have a different wrist band?\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1907400,"PostDate":1447256461,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"277264\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277264-kcole123\/' title='Member profile'><span itemprop=\"name\">kcole123<\/span><\/a> we upgraded to the level at our Melia resort in Cuba for our one year.  Looks fantastic and is brand new to this hotel so excited to see what it's like.   At another melia it was concierge service and we felt like royalty but by the sounds of it this will be way better.  Did you have a different wrist band?<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399428602,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}}],"Id":"79725","Title":"Newbie Interested In Melia Caribe","LastPostDate":1447256461},"Pages":{"TotalItems":6,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
