{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":6,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":96,"MovedTo":null,"MovedOn":0,"FirstPostId":1907388,"Rating":0,"RatingHits":0,"Starter":{"Id":285300,"Name":"BowenBarak","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1447229366,"LastPoster":{"Id":250090,"Name":"dreamweddings","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250090.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1907388,"PostDate":1447229419,"PostContent":"So, I am going dress shopping tomorrow! It's so soon - we haven't even been engaged a week and we...","Author":{"Signature":"","Email":"maddoxjenna8263676@gmail.com","IpAddress":"43.228.158.54","GroupId":39,"GroupName":"Newbie","JoinDate":1447229139,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"BowenBarak","Id":285300,"Name":"BowenBarak","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"43.228.158.54","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79731,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c8833a5edf3bc1508cc4a67a79814bff","RawContent":"&lt;p&gt;&lt;span style=\"color:#141414;\"&gt;&lt;span style=\"font-family:calibri, sans-serif;\"&gt;&lt;span style=\"font-size:14pt;\"&gt;So, I am going dress shopping tomorrow! It&#039;s so soon - we haven&#039;t even been engaged a week and we have nothing planned whatsoever. But my sister leaves on the 23rd and I thought it would be fun to go so she can be involved just because I have no idea how involved she will be able to be while in the Peace Corps. I am definitely not buying anything because my mom won&#039;t be able to be with us tomorrow, so it will just be a preliminary trip. But hopefully it will give me some ideas for the big day.&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;\n\n&lt;span style=\"color:#141414;\"&gt;&lt;span style=\"font-family:calibri, sans-serif;\"&gt;&lt;span style=\"font-size:14pt;\"&gt;Anyone have any tips for dress shopping?&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"color:#141414;\"&gt;&lt;span style=\"font-family:calibri, sans-serif;\"&gt;&lt;span style=\"font-size:14pt;\"&gt;what do u think about these two?&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"color:#141414;\"&gt;&lt;span style=\"font-family:calibri, sans-serif;\"&gt;&lt;span style=\"font-size:14pt;\"&gt;&lt;img src=\"http:\/\/www.promhope.com\/media\/catalog\/resized\/268x402\/6\/5\/w65741-1.jpg\" alt=\"w65741-1.jpg\"&gt;&lt;img src=\"http:\/\/www.promhope.com\/media\/catalog\/resized\/268x402\/6\/5\/w65736-1.jpg\" alt=\"w65736-1.jpg\"&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n\n&lt;p&gt;the website is &amp;nbsp;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;\/&#039;&gt;http:\/\/www,promhope.com\/&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;Consider each of the web sites that provide &lt;\/span&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.promhope.com\/cheap-prom-dresses.html&#039;&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;cheap prom dresses&lt;\/span&gt;&lt;\/a&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt; and &lt;\/span&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;assistance&lt;\/span&gt; &lt;span style=\"font-family:arial, sans-serif;\"&gt;one another decide on the dresses which will look best.&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1907388,"PostDate":1447229419,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span  style=\"color:#141414\"><span  style=\"font-family:calibri, sans-serif\"><span  style=\"font-size:14pt\">So, I am going dress shopping tomorrow! It's so soon - we haven't even been engaged a week and we have nothing planned whatsoever. But my sister leaves on the 23rd and I thought it would be fun to go so she can be involved just because I have no idea how involved she will be able to be while in the Peace Corps. I am definitely not buying anything because my mom won't be able to be with us tomorrow, so it will just be a preliminary trip. But hopefully it will give me some ideas for the big day.\u00a0<\/span><\/span><\/span><br><br><span  style=\"color:#141414\"><span  style=\"font-family:calibri, sans-serif\"><span  style=\"font-size:14pt\">Anyone have any tips for dress shopping?\u00a0<\/span><\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"color:#141414\"><span  style=\"font-family:calibri, sans-serif\"><span  style=\"font-size:14pt\">what do u think about these two?<\/span><\/span><\/span><\/p>\n<p><span  style=\"color:#141414\"><span  style=\"font-family:calibri, sans-serif\"><span  style=\"font-size:14pt\"><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/www.promhope.com\/media\/catalog\/resized\/268x402\/6\/5\/w65741-1.jpg\" alt=\"w65741-1.jpg\"><\/span><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/www.promhope.com\/media\/catalog\/resized\/268x402\/6\/5\/w65736-1.jpg\" alt=\"w65736-1.jpg\"><\/span><\/span><\/span><\/span><\/p>\n<br \/><p>the website is \u00a0<a href='\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www,promhope.com\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-family:arial, sans-serif\">Consider each of the web sites that provide <\/span><a href='http:\/\/www.promhope.com\/cheap-prom-dresses.html' class='bbc_url' title='External link' rel='nofollow external'><span  style=\"font-family:arial, sans-serif\">cheap prom dresses<\/span><\/a><span  style=\"font-family:arial, sans-serif\"> and <\/span><span  style=\"font-family:arial, sans-serif\">assistance<\/span> <span  style=\"font-family:arial, sans-serif\">one another decide on the dresses which will look best.<\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"maddoxjenna8263676@gmail.com","IpAddress":"43.228.158.54","GroupId":39,"GroupName":"Newbie","JoinDate":1447229139,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"BowenBarak","Id":285300,"Name":"BowenBarak","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"172.73.229.33","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79731,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"820668b84709ee4023a0e164d7f97686","RawContent":"Try on all the different style of dresses, i.e ball, sheath, fit and flare...etc., and see what style dress fits you best. Once you know what style looks good on you, then you can try various dresses in that style. That will help narrow your focus.\n\n\nHappy planning!!","Attachments":[],"Id":1907390,"PostDate":1447232826,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Try on all the different style of dresses, i.e ball, sheath, fit and flare...etc., and see what style dress fits you best. Once you know what style looks good on you, then you can try various dresses in that style. That will help narrow your focus.<br><br>\nHappy planning!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"pinkiesup08@gmail.com","IpAddress":"75.181.5.152","GroupId":47,"GroupName":"Site Supporter","JoinDate":1374614124,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-271841.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"RandL2015","Id":271841,"Name":"RandL2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79731,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f9deba8aa7e0a51ab5d714d0f9d1c97f","RawContent":"&lt;p&gt;Definitely try on different styles! I went in with the vision of a mermaid and only a mermaid and I ended up walking away with a beautiful ball gown. Just keep an open mind :)&lt;\/p&gt;","Attachments":[],"Id":1907395,"PostDate":1447251042,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Definitely try on different styles! I went in with the vision of a mermaid and only a mermaid and I ended up walking away with a beautiful ball gown. Just keep an open mind <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419437814,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1436293677","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"190.166.35.237","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79731,"EditedBy":"<strong>Edited by Moments That Matter, Yesterday, 06:52 AM.<\/strong>","EditDate":1447253552,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bd73dc00cd297edd1b0e27ad3a6ffeb9","RawContent":"&lt;p&gt;What an exciting time for you, BowaenBarak - Congrats!!! welcome to our forum community too - it&#039;s a great place to find tons of helpful info, suggestions and advice for your planning questions - well done :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Wishing you happy research, and all the best with your plans - cheers!!! team MTM :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;.....here are some magical wedding moments that matter we&#039;ve captured in our magnificnet Mayan Riviera for futher inspiration - enjoy :)&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-atl3-1.xx.fbcdn.net\/hphotos-xta1\/t31.0-8\/11054385_10153183987754487_7185985408347092447_o.jpg\" alt=\"11054385_10153183987754487_7185985408347\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-atl3-1.xx.fbcdn.net\/hphotos-xfa1\/v\/t1.0-9\/308273_10151481707999487_247000733_n.jpg?oh=c9c9354de96d911006c041cd8d457f7d&amp;amp;oe=56B1F938\" alt=\"308273_10151481707999487_247000733_n.jpg\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-atl3-1.xx.fbcdn.net\/hphotos-xap1\/t31.0-8\/1404421_10151930921414487_1941082145_o.jpg\" alt=\"1404421_10151930921414487_1941082145_o.j\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-atl3-1.xx.fbcdn.net\/hphotos-xta1\/t31.0-8\/12138500_10153669083714487_4821308431407090820_o.jpg\" alt=\"12138500_10153669083714487_4821308431407\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-atl3-1.xx.fbcdn.net\/hphotos-xpa1\/t31.0-8\/241661_10151105662974487_681651964_o.jpg\" alt=\"241661_10151105662974487_681651964_o.jpg\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-atl3-1.xx.fbcdn.net\/hphotos-xfa1\/t31.0-8\/279254_10151108235734487_1331932816_o.jpg\" alt=\"279254_10151108235734487_1331932816_o.jp\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-atl3-1.xx.fbcdn.net\/hphotos-xap1\/t31.0-8\/169611_10151009320999487_1579582819_o.jpg\" alt=\"169611_10151009320999487_1579582819_o.jp\"&gt;&lt;\/p&gt;","Attachments":[],"Id":1907398,"PostDate":1447252310,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>What an exciting time for you, BowaenBarak - Congrats!!! welcome to our forum community too - it's a great place to find tons of helpful info, suggestions and advice for your planning questions - well done <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Wishing you happy research, and all the best with your plans - cheers!!! team MTM <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>.....here are some magical wedding moments that matter we've captured in our magnificnet Mayan Riviera for futher inspiration - enjoy <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-atl3-1.xx.fbcdn.net\/hphotos-xta1\/t31.0-8\/11054385_10153183987754487_7185985408347092447_o.jpg\" alt=\"11054385_10153183987754487_7185985408347\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-atl3-1.xx.fbcdn.net\/hphotos-xfa1\/v\/t1.0-9\/308273_10151481707999487_247000733_n.jpg?oh=c9c9354de96d911006c041cd8d457f7d&oe=56B1F938\" alt=\"308273_10151481707999487_247000733_n.jpg\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-atl3-1.xx.fbcdn.net\/hphotos-xap1\/t31.0-8\/1404421_10151930921414487_1941082145_o.jpg\" alt=\"1404421_10151930921414487_1941082145_o.j\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-atl3-1.xx.fbcdn.net\/hphotos-xta1\/t31.0-8\/12138500_10153669083714487_4821308431407090820_o.jpg\" alt=\"12138500_10153669083714487_4821308431407\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-atl3-1.xx.fbcdn.net\/hphotos-xpa1\/t31.0-8\/241661_10151105662974487_681651964_o.jpg\" alt=\"241661_10151105662974487_681651964_o.jpg\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-atl3-1.xx.fbcdn.net\/hphotos-xfa1\/t31.0-8\/279254_10151108235734487_1331932816_o.jpg\" alt=\"279254_10151108235734487_1331932816_o.jp\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-atl3-1.xx.fbcdn.net\/hphotos-xap1\/t31.0-8\/169611_10151009320999487_1579582819_o.jpg\" alt=\"169611_10151009320999487_1579582819_o.jp\"><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280210660,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"65.92.76.98","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79731,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"23ca684f1879225d924236bd4625c876","RawContent":"I agree with the ladies above! \n\n\n1. Keep an open mind. \n\n2. Shop with a group that will be considerate of what YOU want. \n\n3. Don&#039;t feel like you have to get a \"destination wedding dress\" if that isn&#039;t your vision. \n\n4. Have fun and don&#039;t let yourself get discouraged if you don&#039;t find the one. There are SO many dress shops out there. \n\n\nENJOY!","Attachments":[],"Id":1907436,"PostDate":1447295005,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I agree with the ladies above! <br><br>\n1. Keep an open mind. <br>\n2. Shop with a group that will be considerate of what YOU want. <br>\n3. Don't feel like you have to get a \"destination wedding dress\" if that isn't your vision. <br>\n4. Have fun and don't let yourself get discouraged if you don't find the one. There are SO many dress shops out there. <br><br>\nENJOY!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"Ashley<br><br>\nMy Planning Thread: <a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/79377-ashhtayys-planning-thread-azul-fives-june-7-2016\/\">http:\/\/www.bestdestinationwedding.com\/topic\/79377-ashhtayys-planning-thread-azul-fives-june-7-2016\/<\/a> <p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;0;116\/st\/20160607\/e\/Our+Wedding\/dt\/1\/k\/bb99\/event.png\" alt=\"event.png\"><\/a>","Email":"ashley.taylor@live.ca","IpAddress":"184.147.135.4","GroupId":40,"GroupName":"Jr. Member","JoinDate":1423105061,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282006.png?_r=1423373502","PhotoWidth":200,"PhotoHeight":138,"PhotoType":"custom"},"FormattedName":"ashhtayy","Id":282006,"Name":"ashhtayy","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"200.79.251.123","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79731,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7219623a84809928a59773c06816d54c","RawContent":"[quote name=\"BowenBarak\" post=\"1907388\" timestamp=\"1447229419\"]\n[color=#141414][font=calibri][size=4]So, I am going dress shopping tomorrow! It&#039;s so soon - we haven&#039;t even been engaged a week and we have nothing planned whatsoever. But my sister leaves on the 23rd and I thought it would be fun to go so she can be involved just because I have no idea how involved she will be able to be while in the Peace Corps. I am definitely not buying anything because my mom won&#039;t be able to be with us tomorrow, so it will just be a preliminary trip. But hopefully it will give me some ideas for the big day. [\/size][\/font][\/color]\n\n[color=#141414][font=calibri][size=4]Anyone have any tips for dress shopping? [\/size][\/font][\/color]\n\n\n[color=#141414][font=calibri][size=4]what do u think about these two?[\/size][\/font][\/color]\n[color=#141414][font=calibri][size=4][img]http:\/\/www.promhope.com\/media\/catalog\/resized\/268x402\/6\/5\/w65741-1.jpg[\/img][img]http:\/\/www.promhope.com\/media\/catalog\/resized\/268x402\/6\/5\/w65736-1.jpg[\/img][\/size][\/font][\/color]\n\nthe website is  [url=\"http:\/\/www,promhope.com\/\"]http:\/\/www,promhope.com\/[\/url]\n\n[font=arial]Consider each of the web sites that provide [\/font][url=\"http:\/\/www.promhope.com\/cheap-prom-dresses.html\"][font=arial]cheap prom dresses[\/font][\/url][font=arial] and [\/font][font=arial]assistance[\/font] [font=arial]one another decide on the dresses which will look best.[\/font][\/quote]@[member=\"BowenBarak\"] first dress shopping its usually the most fun.  How did it go ? did you try out all styles?  \n\nCant wait to hear about it.","Attachments":[],"Id":1907454,"PostDate":1447304968,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>BowenBarak, on Yesterday, 12:10 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p><span  style=\"color:#141414\"><span  style=\"font-family:calibri, sans-serif\"><span  style=\"font-size:14pt\">So, I am going dress shopping tomorrow! It's so soon - we haven't even been engaged a week and we have nothing planned whatsoever. But my sister leaves on the 23rd and I thought it would be fun to go so she can be involved just because I have no idea how involved she will be able to be while in the Peace Corps. I am definitely not buying anything because my mom won't be able to be with us tomorrow, so it will just be a preliminary trip. But hopefully it will give me some ideas for the big day.\u00a0<\/span><\/span><\/span><br><br><span  style=\"color:#141414\"><span  style=\"font-family:calibri, sans-serif\"><span  style=\"font-size:14pt\">Anyone have any tips for dress shopping?\u00a0<\/span><\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"color:#141414\"><span  style=\"font-family:calibri, sans-serif\"><span  style=\"font-size:14pt\">what do u think about these two?<\/span><\/span><\/span><\/p>\n<p><span  style=\"color:#141414\"><span  style=\"font-family:calibri, sans-serif\"><span  style=\"font-size:14pt\"><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/www.promhope.com\/media\/catalog\/resized\/268x402\/6\/5\/w65741-1.jpg\" alt=\"w65741-1.jpg\"><\/span><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/www.promhope.com\/media\/catalog\/resized\/268x402\/6\/5\/w65736-1.jpg\" alt=\"w65736-1.jpg\"><\/span><\/span><\/span><\/span><\/p>\n<br><p>the website is \u00a0<a href='\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www,promhope.com\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-family:arial, sans-serif\">Consider each of the web sites that provide <\/span><a href='http:\/\/www.promhope.com\/cheap-prom-dresses.html' class='bbc_url' title='External link' rel='nofollow external'><span  style=\"font-family:arial, sans-serif\">cheap prom dresses<\/span><\/a><span  style=\"font-family:arial, sans-serif\"> and <\/span><span  style=\"font-family:arial, sans-serif\">assistance<\/span> <span  style=\"font-family:arial, sans-serif\">one another decide on the dresses which will look best.<\/span><\/p>\n<\/div>\n<\/div><\/div>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"285300\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/285300-bowenbarak\/' title='Member profile'><span itemprop=\"name\">BowenBarak<\/span><\/a> first dress shopping its usually the most fun. \u00a0How did it go ? did you try out all styles? \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Cant wait to hear about it. \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"Dream Weddings Riviera Maya- We pay attention to your wishes and coordinate closely with you to ensure your wedding or event is planned to perfection!<br \/>\n<br \/>\n<span style='color: rgb(40,40,40)'><span style='font-family: arial'><span style='font-size: 12px;'>Dream Weddings Riviera Maya<\/span><\/span><\/span><br \/>\n<span style='font-family: arial'><span style='font-size: 12px;'>weddingsinplayadelcarmen@gmail.com<\/span><\/span><br \/>\n<a class='bbc_url' href='http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html'>http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html<\/a><br \/>\n<br \/>\n<span style='color: rgb(40,40,40)'><span style='font-family: arial'><span style='font-size: 12px;'>Happy Planning!<\/span><\/span><\/span><br \/>\n<span style='color: rgb(40,40,40)'><span style='font-family: arial'><span style='font-size: 12px;'>Joyce<\/span><\/span><\/span>","Email":"weddingsinplayadelcarmen@gmail.com","IpAddress":"187.252.44.28","GroupId":84,"GroupName":"Insiders w\/ Articles","JoinDate":1326854387,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250090.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"dreamweddings","Id":250090,"Name":"dreamweddings","IsOnline":false}}],"Id":"79731","Title":"Hey Everyone","LastPostDate":1447304968},"Pages":{"TotalItems":6,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
