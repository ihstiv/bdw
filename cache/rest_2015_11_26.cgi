FormattedName":"KitCat77","Id":231734,"Name":"KitCat77","IsOnline":false}},"Posts":[],"Id":"57862","Title":"Barcelo Bavaro Palace Deluxe","LastPostDate":1442331903}],"Pages":{"TotalItems":2356,"TotalPages":158,"CurrentPage":15,"NextPage":30,"PreviousPage":0,"LastPage":2355},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
