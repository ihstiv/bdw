{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"204.63.55.228","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78994,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4b0ad8a437f15d88d60e7e3c7aeb93eb","RawContent":"&lt;p&gt;@[member=\"AshleyNYC323\"] I am!!! We are getting married April 29th!!! EEEkkkkkk.&amp;nbsp;&lt;\/p&gt;\n\n&lt;p&gt;@[member=\"becksnfx\"] We are April 29th!!! So we will be there together! Nice to meet you :)&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1902368,"PostDate":1439386723,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"282492\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282492-ashleynyc323\/' title='Member profile'><span itemprop=\"name\">AshleyNYC323<\/span><\/a> I am!!! We are getting married April 29th!!! EEEkkkkkk.\u00a0<\/p>\n<br \/><p>@<a hovercard-ref=\"member\" hovercard-id=\"283173\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/283173-becksnfx\/' title='Member profile'><span itemprop=\"name\">becksnfx<\/span><\/a> We are April 29th!!! So we will be there together! Nice to meet you <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"itsjustmetrish@gmail.com","IpAddress":"204.63.55.228","GroupId":39,"GroupName":"Newbie","JoinDate":1439377741,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284383.jpg?_r=1439433185","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"fijiangel15","Id":284383,"Name":"fijiangel15","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"216.99.65.82","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78994,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"83f2ac08130447721a1ee0488f7c77cd","RawContent":"&lt;p&gt;In case anyone else was wondering.....&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;You can do an extended cocktail hour. Luisa said it&#039;s an extra 12$ per person&lt;\/p&gt;","Attachments":[],"Id":1903244,"PostDate":1440419583,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>In case anyone else was wondering.....<\/p>\n<p>\u00a0<\/p>\n<p>You can do an extended cocktail hour. Luisa said it's an extra 12$ per person<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"alison.hardy1@gmail.com","IpAddress":"216.99.65.83","GroupId":39,"GroupName":"Newbie","JoinDate":1422356723,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281894.jpg?_r=1422907392","PhotoWidth":200,"PhotoHeight":226,"PhotoType":"custom"},"FormattedName":"hardyali","Id":281894,"Name":"hardyali","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"142.67.2.225","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78994,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"040a8c2a7ae806a17ca310b514e8720b","RawContent":"&lt;p&gt;we are March 16th 2016 :) :)&lt;\/p&gt;","Attachments":[],"Id":1903320,"PostDate":1440509623,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>we are March 16th 2016 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ton_03@hotmail.com","IpAddress":"142.67.2.225","GroupId":39,"GroupName":"Newbie","JoinDate":1430213376,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282892.jpg?_r=1434622094","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"FutureMrsVanthof","Id":282892,"Name":"FutureMrsVanthof","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.45.141.241","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78994,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3722812ff1a3e9d8ec1a6d8454732301","RawContent":"&lt;p&gt;Hello everyone! I&#039;m looking like crazy and almost ready to book at NOW for Aug 6th 2016. I&#039;m so stressed out planning and trying to pick the right resort!&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;m a little confused about the private reception and the drinks? Is alcohol included with the dinner. If anyone knows that would be great. &amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Also if anyone could email me the spread sheet they received that would be a wonderful help. any extra info is appreciated!&lt;\/p&gt;\n&lt;p&gt;Good luck to everyone and there planing!&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1903640,"PostDate":1440753303,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello everyone! I'm looking like crazy and almost ready to book at NOW for Aug 6th 2016. I'm so stressed out planning and trying to pick the right resort!\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I'm a little confused about the private reception and the drinks? Is alcohol included with the dinner. If anyone knows that would be great. \u00a0<\/p>\n<p>Also if anyone could email me the spread sheet they received that would be a wonderful help. any extra info is appreciated!<\/p>\n<p>Good luck to everyone and there planing!\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"pannelisse@gmail.com","IpAddress":"99.45.141.241","GroupId":39,"GroupName":"Newbie","JoinDate":1440602997,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284576.jpg?_r=1443546094","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"Soon2beJara","Id":284576,"Name":"Soon2beJara","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"172.56.13.22","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78994,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"7bef84aad55efa836ac637e9130a3e4b","RawContent":"Hey everyone!\n\nI&#039;m getting married at Now Larimer May 11th 2016!! I was able meet with my wedding coordinator, go over my wedding packet and take a tour the resort in July. It was beautiful! I can&#039;t wait till may!!\n\n\nAlso wanted to let you guys know they have a bridal room you can rent for the day of your wedding. I already reserved it for my day and  highly recommend it. Its a great place to get ready with your bridesmaids. Included is champagne, fruit and snacks. :) any questions just ask. I also have a ton of pictures I took when I was there.","Attachments":[],"Id":1903651,"PostDate":1440757172,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hey everyone!<br>\nI'm getting married at Now Larimer May 11th 2016!! I was able meet with my wedding coordinator, go over my wedding packet and take a tour the resort in July. It was beautiful! I can't wait till may!!<br><br>\nAlso wanted to let you guys know they have a bridal room you can rent for the day of your wedding. I already reserved it for my day and  highly recommend it. Its a great place to get ready with your bridesmaids. Included is champagne, fruit and snacks. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> any questions just ask. I also have a ton of pictures I took when I was there.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"melissa.laurel.ripley@gmail.com","IpAddress":"192.54.222.28","GroupId":39,"GroupName":"Newbie","JoinDate":1437631381,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"MelissaLaurel","Id":284093,"Name":"MelissaLaurel","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.65.74.207","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78994,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"da7015ed604e7d2c86f26e4e4a84179f","RawContent":"[quote name=\"MelissaLaurel\" post=\"1903651\" timestamp=\"1440775172\"]\nHey everyone!\nI&#039;m getting married at Now Larimer May 11th 2016!! I was able meet with my wedding coordinator, go over my wedding packet and take a tour the resort in July. It was beautiful! I can&#039;t wait till may!!\n\nAlso wanted to let you guys know they have a bridal room you can rent for the day of your wedding. I already reserved it for my day and highly recommend it. Its a great place to get ready with your bridesmaids. Included is champagne, fruit and snacks. :) any questions just ask. I also have a ton of pictures I took when I was there.[\/quote]How were you able to reserve it so early? I was told that I couldn&#039;t do that until February for my April 9 wedding.","Attachments":[],"Id":1904360,"PostDate":1441744656,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>MelissaLaurel, on 28 August 2015 - 10:19 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hey everyone!<br>\nI'm getting married at Now Larimer May 11th 2016!! I was able meet with my wedding coordinator, go over my wedding packet and take a tour the resort in July. It was beautiful! I can't wait till may!!<br><br>\nAlso wanted to let you guys know they have a bridal room you can rent for the day of your wedding. I already reserved it for my day and highly recommend it. Its a great place to get ready with your bridesmaids. Included is champagne, fruit and snacks. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> any questions just ask. I also have a ton of pictures I took when I was there.<\/p>\n<\/div>\n<\/div><\/div>\n<p>How were you able to reserve it so early? I was told that I couldn't do that until February for my April 9 wedding.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ashley225@gmail.com","IpAddress":"66.87.117.140","GroupId":39,"GroupName":"Newbie","JoinDate":1426927785,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282492.jpg?_r=1447288455","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"AshleyNYC323","Id":282492,"Name":"AshleyNYC323","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"192.54.222.12","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78994,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"dda9174ed31975854f6f6036a0593dcc","RawContent":"&lt;p&gt;@&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/user\/282492-ashleynyc323\/&#039; title=\"\"&gt;AshleyNYC323&lt;\/a&gt;&amp;nbsp;I was able to reserve the date in June. I just had to put down the deposit. &amp;nbsp;I originally wanted to get married in April but there was only one open day. I hope you already put your deposit down and have the date you wanted. :)&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1904394,"PostDate":1441775896,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a href='http:\/\/www.bestdestinationwedding.com\/user\/282492-ashleynyc323\/' class='bbc_url' title=''>AshleyNYC323<\/a>\u00a0I was able to reserve the date in June. I just had to put down the deposit. \u00a0I originally wanted to get married in April but there was only one open day. I hope you already put your deposit down and have the date you wanted. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"melissa.laurel.ripley@gmail.com","IpAddress":"192.54.222.28","GroupId":39,"GroupName":"Newbie","JoinDate":1437631381,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"MelissaLaurel","Id":284093,"Name":"MelissaLaurel","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.65.74.207","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78994,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6d3fc8dcfe9680e794811cd683e480a5","RawContent":"[quote name=\"MelissaLaurel\" post=\"1904394\" timestamp=\"1441793896\"]\n@[url=\"http:\/\/www.bestdestinationwedding.com\/user\/282492-ashleynyc323\/\"]AshleyNYC323[\/url] I was able to reserve the date in June. I just had to put down the deposit.  I originally wanted to get married in April but there was only one open day. I hope you already put your deposit down and have the date you wanted. :)[\/quote]Sorry, I wasn&#039;t clear. I didn&#039;t mean the date, I meant the bridal suite.  I was told that it couldn&#039;t be reserved until 90 days before the ceremony date.","Attachments":[],"Id":1904608,"PostDate":1442153833,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>MelissaLaurel, on 09 September 2015 - 05:18 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>@<a href='http:\/\/www.bestdestinationwedding.com\/user\/282492-ashleynyc323\/' class='bbc_url' title=''>AshleyNYC323<\/a>\u00a0I was able to reserve the date in June. I just had to put down the deposit. \u00a0I originally wanted to get married in April but there was only one open day. I hope you already put your deposit down and have the date you wanted. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<\/div>\n<\/div><\/div>\n<p>Sorry, I wasn't clear. I didn't mean the date, I meant the bridal suite. \u00a0I was told that it couldn't be reserved until 90 days before the ceremony date. \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ashley225@gmail.com","IpAddress":"66.87.117.140","GroupId":39,"GroupName":"Newbie","JoinDate":1426927785,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282492.jpg?_r=1447288455","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"AshleyNYC323","Id":282492,"Name":"AshleyNYC323","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.163.4.3","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78994,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2c5d7f012bf76568ddaaf9191340a840","RawContent":"@[member=\"AshleyNYC323\"] I would recommend speaking with Mercy and pushing for it! We locked in our May 1, 2015 date in August of 2013 and they gave us the same trouble saying 90 days well on the 92nd day I tried again and of course it was booked, interestingly enough no one knew how....","Attachments":[],"Id":1904636,"PostDate":1442184999,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"282492\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282492-ashleynyc323\/' title='Member profile'><span itemprop=\"name\">AshleyNYC323<\/span><\/a> I would recommend speaking with Mercy and pushing for it! We locked in our May 1, 2015 date in August of 2013 and they gave us the same trouble saying 90 days well on the 92nd day I tried again and of course it was booked, interestingly enough no one knew how....\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"May 01, 2015- complete!! 73 guests+bride & groom! Now Larimar Punta Cana! ","Email":"cooper.tyshelle@gmail.com","IpAddress":"108.50.56.179","GroupId":40,"GroupName":"Jr. Member","JoinDate":1375995069,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272393.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"DR2015","Id":272393,"Name":"DR2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"1.52.36.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78994,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6075e2e4bb7efe72b834299f19e6fc71","RawContent":"&lt;p&gt;thanks all&lt;\/p&gt;","Attachments":[],"Id":1904996,"PostDate":1442574504,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>thanks all<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>t\u1ed5ng \u0111\u00e0i \u0111\u0103ng k\u00fd <a data-ipb='nomediaparse' href='http:\/\/fpttelecomvn.info\/lap-dat-mang\/cap-quang-ftth\/vn'>cap quang fpt<\/a>","Email":"nguyenwanthanh476@gmail.com","IpAddress":"1.52.36.23","GroupId":39,"GroupName":"Newbie","JoinDate":1442573989,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284858.jpg?_r=1444846629","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"thanhnv20","Id":284858,"Name":"thanhnv20","IsOnline":false}}],"Pages":{"TotalItems":32,"TotalPages":4,"CurrentPage":20,"NextPage":30,"PreviousPage":10,"LastPage":30},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
