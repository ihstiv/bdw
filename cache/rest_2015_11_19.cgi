{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":1,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":31,"MovedTo":null,"MovedOn":0,"FirstPostId":1907696,"Rating":0,"RatingHits":0,"Starter":{"Id":285228,"Name":"Vjohana","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":true},"StartDate":1447926747,"LastPoster":{"Id":285228,"Name":"Vjohana","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":true},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1907696,"PostDate":1447926747,"PostContent":"Hi Everyone, \u00a0 I am a newbie and I am completely overwhelmed during my search for a resort. I do...","Author":{"Signature":"","Email":"vrichani@gmail.com","IpAddress":"70.208.70.11","GroupId":39,"GroupName":"Newbie","JoinDate":1446498797,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Vjohana","Id":285228,"Name":"Vjohana","IsOnline":true}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"96.242.17.69","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79751,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fda665e3a80c46992934f22e20412fcb","RawContent":"&lt;p&gt;Hi Everyone,&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am a newbie and I am completely overwhelmed during my search for a resort. I do not know where to begin! Right now I am looking at getting married either in May or August 2016 with approximately &amp;nbsp;35-50 guests. &amp;nbsp;I am looking at places in Mexico (still trying to decide where).&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;While looking at wedding packages online, I wanted to know what are some additional costs that you can expect?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I always thought that packages included everything you need (I REALLY WISH!) but I am slowly beginning to notice that some really important items are missing from packages such as photography, videography, DJ, and reception! For those experienced brides, how much did you incur in additional expenses?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;It is worth working with a complimentary wedding package and then working to upgrade or input extra costs towards all the extras?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thanks so much :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1907696,"PostDate":1447926747,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Everyone,<\/p>\n<p>\u00a0<\/p>\n<p>I am a newbie and I am completely overwhelmed during my search for a resort. I do not know where to begin! Right now I am looking at getting married either in May or August 2016 with approximately \u00a035-50 guests. \u00a0I am looking at places in Mexico (still trying to decide where).<\/p>\n<p>\u00a0<\/p>\n<p>While looking at wedding packages online, I wanted to know what are some additional costs that you can expect?<\/p>\n<p>\u00a0<\/p>\n<p>I always thought that packages included everything you need (I REALLY WISH!) but I am slowly beginning to notice that some really important items are missing from packages such as photography, videography, DJ, and reception! For those experienced brides, how much did you incur in additional expenses?<\/p>\n<p>\u00a0<\/p>\n<p>It is worth working with a complimentary wedding package and then working to upgrade or input extra costs towards all the extras?<\/p>\n<p>\u00a0<\/p>\n<p>Thanks so much <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"vrichani@gmail.com","IpAddress":"70.208.70.11","GroupId":39,"GroupName":"Newbie","JoinDate":1446498797,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Vjohana","Id":285228,"Name":"Vjohana","IsOnline":true}}],"Id":"79751","Title":"Wedding Packages And Additional Costs","LastPostDate":1447926747},"Pages":{"TotalItems":1,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
