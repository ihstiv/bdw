{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":15,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":2028,"MovedTo":null,"MovedOn":0,"FirstPostId":1900645,"Rating":0,"RatingHits":0,"Starter":{"Id":281751,"Name":"deecol","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281751.jpg?_r=1443808962","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":false},"StartDate":1437132760,"LastPoster":{"Id":281751,"Name":"deecol","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281751.jpg?_r=1443808962","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":13,"Preview":{"Id":1901361,"PostDate":1438092992,"PostContent":"@TinkerSofi Sounds good! \u00a0Thanks for the advice. \u00a0I'm Italian, always better to have more than no...","Author":{"Signature":"<div><img src=\"http:\/\/\" alt=\"\"><\/div>\n<div><br><div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;0\/st\/20160423\/e\/we+leave+for+Mexico%21\/k\/c059\/event.png\" alt=\"event.png\"><\/a>\u00a0 \u00a0\u00a0\u00a0 \u00a0\u00a0<a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;32;116\/st\/20160430\/e\/we+say+I+do%21\/k\/8afc\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<\/div>\n<p>\u00a0<\/p>\n<p>My Planning Thread:<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79580-deecols-planning-thread-gbp-april-30th-2016\/#entry1904529'>http:\/\/www.bestdestinationwedding.com\/topic\/79580-deecols-planning-thread-gbp-april-30th-2016\/#entry1904529<\/a>","Email":"deannaproteau@hotmail.com","IpAddress":"207.134.141.162","GroupId":40,"GroupName":"Jr. Member","JoinDate":1421428169,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281751.jpg?_r=1443808962","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"deecol","Id":281751,"Name":"deecol","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.134.141.162","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79405,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"716d023eb0061203da64016efdeabbab","RawContent":"&lt;p&gt;@[member=\"calgarybride2015\"] &amp;nbsp;Crazy isn&#039;t it! lol can&#039;t help but laugh.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We&#039;re expecting a few guests to book on their own after the deadline, and we still have a few from the UK that need to book, and may have some stragglers book in towards the end. &amp;nbsp;When do you think I should make my final RSVP date for? I&#039;ve accepted that those people who book super last minute won&#039;t get favours etc that I need to preorder.&lt;\/p&gt;","Attachments":[],"Id":1901323,"PostDate":1438081321,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"277873\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277873-calgarybride2015\/' title='Member profile'><span itemprop=\"name\">calgarybride2015<\/span><\/a> \u00a0Crazy isn't it! lol can't help but laugh.<\/p>\n<p>\u00a0<\/p>\n<p>We're expecting a few guests to book on their own after the deadline, and we still have a few from the UK that need to book, and may have some stragglers book in towards the end. \u00a0When do you think I should make my final RSVP date for? I've accepted that those people who book super last minute won't get favours etc that I need to preorder.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div><img src=\"http:\/\/\" alt=\"\"><\/div>\n<div><br><div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;0\/st\/20160423\/e\/we+leave+for+Mexico%21\/k\/c059\/event.png\" alt=\"event.png\"><\/a>\u00a0 \u00a0\u00a0\u00a0 \u00a0\u00a0<a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;32;116\/st\/20160430\/e\/we+say+I+do%21\/k\/8afc\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<\/div>\n<p>\u00a0<\/p>\n<p>My Planning Thread:<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79580-deecols-planning-thread-gbp-april-30th-2016\/#entry1904529'>http:\/\/www.bestdestinationwedding.com\/topic\/79580-deecols-planning-thread-gbp-april-30th-2016\/#entry1904529<\/a>","Email":"deannaproteau@hotmail.com","IpAddress":"207.134.141.162","GroupId":40,"GroupName":"Jr. Member","JoinDate":1421428169,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281751.jpg?_r=1443808962","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"deecol","Id":281751,"Name":"deecol","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.90.223.12","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79405,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"a75e91487f194ebb800b7f1b38ecf3f5","RawContent":"We had ours November 1st ish for our January 21st wedding.  3 months out my resort wanted a final head count so we said that after that date we couldn&#039;t change it. That said by that point we only have 2 couples unsure and they had booked by then. I actually ended up just buying 50 of everything so had 5 to many!  Just because I ordered stuff early on!  I&#039;d say 2-3 months before is reasonable and if people can&#039;t commit by then I would assume it&#039;s a no. Ie most people need to book holidays off work, the trip, etc. But we made special exceptions where needed.  We had one couple would couldn&#039;t request 2015 holidays until November 1st 2014 so we chose that date for for them. That said they approached us about it early on. They didn&#039;t come to us last minute.  \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1901343,"PostDate":1438087594,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We had ours November 1st ish for our January 21st wedding.  3 months out my resort wanted a final head count so we said that after that date we couldn't change it. That said by that point we only have 2 couples unsure and they had booked by then. I actually ended up just buying 50 of everything so had 5 to many!  Just because I ordered stuff early on!  I'd say 2-3 months before is reasonable and if people can't commit by then I would assume it's a no. Ie most people need to book holidays off work, the trip, etc. But we made special exceptions where needed.  We had one couple would couldn't request 2015 holidays until November 1st 2014 so we chose that date for for them. That said they approached us about it early on. They didn't come to us last minute.  <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.134.141.162","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79405,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0a8ffc21a9913afd9ff4c54da98bc384","RawContent":"&lt;p&gt;@[member=\"calgarybride2015\"] Great advice thanks! &amp;nbsp;I was thinking 2-3 months. &amp;nbsp;3 sounds great.&lt;\/p&gt;","Attachments":[],"Id":1901348,"PostDate":1438088960,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"277873\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277873-calgarybride2015\/' title='Member profile'><span itemprop=\"name\">calgarybride2015<\/span><\/a> Great advice thanks! \u00a0I was thinking 2-3 months. \u00a03 sounds great.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div><img src=\"http:\/\/\" alt=\"\"><\/div>\n<div><br><div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;0\/st\/20160423\/e\/we+leave+for+Mexico%21\/k\/c059\/event.png\" alt=\"event.png\"><\/a>\u00a0 \u00a0\u00a0\u00a0 \u00a0\u00a0<a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;32;116\/st\/20160430\/e\/we+say+I+do%21\/k\/8afc\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<\/div>\n<p>\u00a0<\/p>\n<p>My Planning Thread:<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79580-deecols-planning-thread-gbp-april-30th-2016\/#entry1904529'>http:\/\/www.bestdestinationwedding.com\/topic\/79580-deecols-planning-thread-gbp-april-30th-2016\/#entry1904529<\/a>","Email":"deannaproteau@hotmail.com","IpAddress":"207.134.141.162","GroupId":40,"GroupName":"Jr. Member","JoinDate":1421428169,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281751.jpg?_r=1443808962","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"deecol","Id":281751,"Name":"deecol","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.98.196.2","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79405,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"a234d7d97e141aa1082596c996d87fd8","RawContent":"&lt;p&gt;We did 3 months as well when the final payment was due. It worked out and we were able to get final numbers then :)&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I also had a few extras of everything because I had bought them so far in advanced, but oh well. Better to be prepared.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1901355,"PostDate":1438091425,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>We did 3 months as well when the final payment was due. It worked out and we were able to get final numbers then <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I also had a few extras of everything because I had bought them so far in advanced, but oh well. Better to be prepared.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<br><p><a data-ipb='nomediaparse' href='http:\/\/www.TickerFactory.com\/'><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;31;484\/st\/20150813\/e\/Wedding+time%21+\/dt\/-2\/k\/b92c\/event.png\" alt=\"event.png\"><\/a><\/p>\n<p style=\"text-align:center;\">\u00a0<\/p>\n<p style=\"text-align:center;\">\u00a0","Email":"sblopezb@gmail.com","IpAddress":"172.219.193.22","GroupId":42,"GroupName":"Sr. Member","JoinDate":1359748704,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265511.jpg?_r=1442890536","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"TinkerSofi","Id":265511,"Name":"TinkerSofi","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.134.141.162","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79405,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"59c2e2e7a2ea9da417bcde8b1c9abd29","RawContent":"&lt;p&gt;@[member=\"TinkerSofi\"] Sounds good! &amp;nbsp;Thanks for the advice. &amp;nbsp;I&#039;m Italian, always better to have more than not enough lol&lt;\/p&gt;","Attachments":[],"Id":1901361,"PostDate":1438092992,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"265511\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/265511-tinkersofi\/' title='Member profile'><span itemprop=\"name\">TinkerSofi<\/span><\/a> Sounds good! \u00a0Thanks for the advice. \u00a0I'm Italian, always better to have more than not enough lol<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div><img src=\"http:\/\/\" alt=\"\"><\/div>\n<div><br><div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;0\/st\/20160423\/e\/we+leave+for+Mexico%21\/k\/c059\/event.png\" alt=\"event.png\"><\/a>\u00a0 \u00a0\u00a0\u00a0 \u00a0\u00a0<a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;32;116\/st\/20160430\/e\/we+say+I+do%21\/k\/8afc\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<\/div>\n<p>\u00a0<\/p>\n<p>My Planning Thread:<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79580-deecols-planning-thread-gbp-april-30th-2016\/#entry1904529'>http:\/\/www.bestdestinationwedding.com\/topic\/79580-deecols-planning-thread-gbp-april-30th-2016\/#entry1904529<\/a>","Email":"deannaproteau@hotmail.com","IpAddress":"207.134.141.162","GroupId":40,"GroupName":"Jr. Member","JoinDate":1421428169,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281751.jpg?_r=1443808962","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"deecol","Id":281751,"Name":"deecol","IsOnline":false}}],"Id":"79405","Title":"Need To Vent!","LastPostDate":1438092992},"Pages":{"TotalItems":15,"TotalPages":2,"CurrentPage":10,"NextPage":-1,"PreviousPage":0,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
