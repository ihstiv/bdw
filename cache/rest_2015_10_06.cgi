a-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> very exciting for sure! you have lots of time to check out these boards and research info to help you plan your Perfect Big Day!!!<\/p> <p> \u00a0<\/p> <p> wishing you all the best with your journey - cheers!<\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"&#10;\" data-id=\"215154\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/215154\/width\/500\/height\/1000\" \/><\/span><\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"*&#10;\" data-id=\"215155\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/215155\/width\/500\/height\/1000\" \/><\/span><\/p> <p id=\"yui_3_10_0_1_1375478876765_1223\"> <span rel='lightbox'><img class='bbc_img' alt=\"*&#10;\" data-id=\"215156\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/215156\/width\/500\/height\/1000\" \/><\/span><\/p> <p> \u00a0<\/p> <p> team MTM <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280196260,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":74739,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bbba49a3fcec2c088e363843a0710dce","RawContent":"Thank you!! Just absorbing and enjoying the process. Love the community feeling of this website.","Attachments":[],"Id":1786747,"PostDate":1375483853,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thank you!! Just absorbing and enjoying the process. Love the community feeling of this website.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"pinkiesup08@gmail.com","IpAddress":"75.181.5.152","GroupId":47,"GroupName":"Site Supporter","JoinDate":1374599724,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-271841.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"RandL2015","Id":271841,"Name":"RandL2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":74739,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"dc6503f69323b6c857995d6ea3cffd87","RawContent":"&lt;p&gt; Congrats RandL2015!!! - on setting your Wedding Date for Thanksgiving - wow! gives a whole new meaning to the day :) plus so easy for people to remember....all kinds of benefits - well done!&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Also welcome to our forum community - as you say - it has a great feeling, as well as being an excellent resource for everyone to share ideas, insights + experiences - Enjoy :)&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p id=\"yui_3_10_0_1_1375558654566_1086\"&gt; &lt;img alt=\" \" data-id=\"215286\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/215286\/width\/500\/height\/1000\" \/&gt;&lt;\/p&gt; &lt;p id=\"yui_3_10_0_1_1375558654566_1508\"&gt; &lt;img alt=\" \" data-id=\"215287\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/215287\/width\/500\/height\/1000\" \/&gt;&lt;\/p&gt; &lt;p id=\"yui_3_10_0_1_1375558654566_1895\"&gt; &lt;img alt=\" \" data-id=\"215288\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/215288\/width\/500\/height\/1000\" \/&gt;&lt;\/p&gt; &lt;p id=\"yui_3_10_0_1_1375558654566_2303\"&gt; &lt;img alt=\" \" data-id=\"215289\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/215289\/width\/500\/height\/1000\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p id=\"yui_3_10_0_1_1375558654566_2702\"&gt; Photography Is Forever Studios&amp;nbsp; &lt;img alt=\" \" data-id=\"215290\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/215290\/width\/200\/height\/400\" \/&gt;&lt;\/p&gt;","Attachments":[],"Id":1786905,"PostDate":1375541096,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Congrats RandL2015!!! - on setting your Wedding Date for Thanksgiving - wow! gives a whole new meaning to the day <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> plus so easy for people to remember....all kinds of benefits - well done!<\/p> <p> \u00a0<\/p> <p> Also welcome to our forum community - as you say - it has a great feeling, as well as being an excellent resource for everyone to share ideas, insights + experiences - Enjoy <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p> <p> \u00a0<\/p> <p id=\"yui_3_10_0_1_1375558654566_1086\"> <span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"215286\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/215286\/width\/500\/height\/1000\" \/><\/span><\/p> <p id=\"yui_3_10_0_1_1375558654566_1508\"> <span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"215287\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/215287\/width\/500\/height\/1000\" \/><\/span><\/p> <p id=\"yui_3_10_0_1_1375558654566_1895\"> <span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"215288\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/215288\/width\/500\/height\/1000\" \/><\/span><\/p> <p id=\"yui_3_10_0_1_1375558654566_2303\"> <span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"215289\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/215289\/width\/500\/height\/1000\" \/><\/span><\/p> <p> \u00a0<\/p> <p id=\"yui_3_10_0_1_1375558654566_2702\"> Photography Is Forever Studios\u00a0 <span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"215290\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/215290\/width\/200\/height\/400\" \/><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"contact@photographyisforever.com","IpAddress":"204.112.154.75","GroupId":44,"GroupName":"Vendor","JoinDate":1372797157,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-271141.png?_r=1386613206","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"photoisforever","Id":271141,"Name":"photoisforever","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":74739,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1400e6fffa7a395891e67edbdb1f09c5","RawContent":"Congrats!","Attachments":[],"Id":1797036,"PostDate":1378154943,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Congrats!\r\n              <\/body>\r\n            <\/html>","