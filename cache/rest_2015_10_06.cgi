> Time: 1444103661 / Tue, 06 Oct 2015 03:54:21 +0000
> URL: /index.php?/REST/Forums/topic?startFromPostId=1877590&SessionId=9804c983c9ccaace9c43d754388879b7
> User jacquewedding (283943)
Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":9,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":698,"MovedTo":null,"MovedOn":0,"FirstPostId":1876382,"Rating":0,"RatingHits":0,"Starter":{"Id":279936,"Name":"amanda2016","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279936.jpg?_r=1414239845","PhotoWidth":200,"PhotoHeight":246,"PhotoType":"custom"},"IsOnline":false},"StartDate":1413879451,"LastPoster":{"Id":278661,"Name":"jeffandrobyn","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278661.jpg?_r=1404161707","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":13,"Preview":{"Id":1877590,"PostDate":1414965012,"PostContent":"Your heart is in the right place but I think you need to squash this. Is she paying? If not....no...","Author":{"Signature":"","Email":"robynbrooke81@gmail.com","IpAddress":"75.99.18.219","GroupId":40,"GroupName":"Jr. Member","JoinDate":1403532989,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278661.jpg?_r=1404161707","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"jeffandrobyn","Id":278661,"Name":"jeffandrobyn","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"41.218.253.169","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78255,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"32dabca2a398c36fde85baddb7335305","RawContent":"&lt;p&gt;Well ladies.. I was hoping it wouldn&#039;t come down to this but it has. We have changed our date 3 times, have changed the venue that we both like to one that would be good for kids (which we don&#039;t have any yet), She also hasn&#039;t like any of the templates for the save the date that my FI and I put together. I sent the link to our website to her just to get her opinion as I am trying to be super nice and make her feel as if she is apart of the process. She unfortunately will not see her daughter get married as she is piece of work and will never find a man that could deal with her CRAZINESS..So I have been trying to involve the mother in law as much as possible. Anyways after sending her the wedding website she emailed me back and asked me if there was other templates to work with as she had something else in mind. Something bright and fun.. I asked her if she wouldn&#039;t mind to send me what she had in mind and the stuff she sent was HORRIBLE.. I just don&#039;t know how to deal with her anymore. My fiance and I decided on the 11th of October but after he talk to him mother she requested we make it 10-10 as she thought it would be easier for us to remember.. REALLY!!!!! I can&#039;t..&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;The mother is just the beginning.. The sister in Law and neice are a story for another time. Any advice from you ladies would be greatly appreciated.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thanks for reading.&lt;\/p&gt;","Attachments":[],"Id":1876382,"PostDate":1413879451,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Well ladies.. I was hoping it wouldn't come down to this but it has. We have changed our date 3 times, have changed the venue that we both like to one that would be good for kids (which we don't have any yet), She also hasn't like any of the templates for the save the date that my FI and I put together. I sent the link to our website to her just to get her opinion as I am trying to be super nice and make her feel as if she is apart of the process. She unfortunately will not see her daughter get married as she is piece of work and will never find a man that could deal with her CRAZINESS..So I have been trying to involve the mother in law as much as possible. Anyways after sending her the wedding website she emailed me back and asked me if there was other templates to work with as she had something else in mind. Something bright and fun.. I asked her if she wouldn't mind to send me what she had in mind and the stuff she sent was HORRIBLE.. I just don't know how to deal with her anymore. My fiance and I decided on the 11th of October but after he talk to him mother she requested we make it 10-10 as she thought it would be easier for us to remember.. REALLY!!!!! I can't..<\/p>\n<p>\u00a0<\/p>\n<p>The mother is just the beginning.. The sister in Law and neice are a story for another time. Any advice from you ladies would be greatly appreciated.<\/p>\n<p>\u00a0<\/p>\n<p>Thanks for reading.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p style=\"text-align:center;\"><img src=\"http:\/\/www.tickerclub.com\/tickers\/wedding\/preview\/idTicker\/206838\/rulerId\/\/sliderId\/\/\" alt=\"sliderId\"><\/p>\n<p style=\"text-align:center;\">\u00a0","Email":"amanda@roamcanada.com","IpAddress":"41.218.252.222","GroupId":39,"GroupName":"Newbie","JoinDate":1411393687,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279936.jpg?_r=1414239845","PhotoWidth":200,"PhotoHeight":246,"PhotoType":"custom"},"FormattedName":"amanda2016","Id":279936,"Name":"amanda2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.208.82","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78255,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":5,"IsLiked":false,"PostKey":"416677062cdc82682c63c20d488814e5","RawContent":"Thank her for her input and do what you and your FI want. Stop including her in things...it&#039;s not her wedding it&#039;s yours. \n\n\nif she pushes for information, have your FI stand up to her and say that you guys have the planning process covered here on out. \n\n\nIs she paying for the wedding? If not- then she has no say. I would stop asking for her opinion... Even if you are only trying to be nice!","Attachments":[],"Id":1876383,"PostDate":1413879618,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thank her for her input and do what you and your FI want. Stop including her in things...it's not her wedding it's yours. <br><br>\nif she pushes for information, have your FI stand up to her and say that you guys have the planning process covered here on out. <br><br>\nIs she paying for the wedding? If not- then she has no say. I would stop asking for her opinion... Even if you are only trying to be nice!  \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kmkwedding2016@gmail.com","IpAddress":"70.72.195.234","GroupId":38,"GroupName":"Moderators","JoinDate":1390242208,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kmk2016","Id":276231,"Name":"kmk2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"41.218.253.169","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78255,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3c80caa4a287ab4d3a65755ad83d758f","RawContent":"[quote name=\"kmk2016\" post=\"1876383\" timestamp=\"1413894018\"]\nThank her for her input and do what you and your FI want. Stop including her in things...it&#039;s not her wedding it&#039;s yours.\n\nif she pushes for information, have your FI stand up to her and say that you guys have the planning process covered here on out.\n\nIs she paying for the wedding? If not- then she has no say. I would stop asking for her opinion... Even if you are only trying to be nice![\/quote]\nYou are so right.. As far as I know she isn&#039;t paying for the wedding.. HAHA- that made me remember she said in the very beginning \"If you decide on Mexico I am not coming.\" Damnit.. We should have picked mexico!! LOL just kidding. She is very controlling in every sistuation.. My fiance is a bit stand offish when it comes to standing up to her. She is so use to getting her way and will pull out all stops until she gets what she wants. I told the Fiance last night that I am getting to the point where I no longer care if she like something or will even attend. I know I sounded really harsh when I said it but it&#039;s the truth. I think it kind of hurt his feelings but Damn.. This is our day.. I want it to be everything WE want not what her vision is.\nI am just going to have to stand up to her and tell her I have everything under control and I really appreciate her opinion.\nThanks for the response and I really hope when the time comes I can be strong.\nShe is a scary one! =)","Attachments":[],"Id":1876384,"PostDate":1413880066,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>kmk2016, on 21 October 2014 - 08:20 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Thank her for her input and do what you and your FI want. Stop including her in things...it's not her wedding it's yours.<br><br>\nif she pushes for information, have your FI stand up to her and say that you guys have the planning process covered here on out.<br><br>\nIs she paying for the wedding? If not- then she has no say. I would stop asking for her opinion... Even if you are only trying to be nice!<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>You are so right.. As far as I know she isn't paying for the wedding.. HAHA- that made me remember she said in the very beginning \"If you decide on Mexico I am not coming.\" Damnit.. We should have picked mexico!! LOL just kidding. She is very controlling in every sistuation.. My fiance is a bit stand offish when it comes to standing up to her. She is so use to getting her way and will pull out all stops until she gets what she wants. I told the Fiance last night that I am getting to the point where I no longer care if she like something or will even attend. I know I sounded really harsh when I said it but it's the truth. I think it kind of hurt his feelings but Damn.. This is our day.. I want it to be everything WE want not what her vision is.<\/p>\n<p>I am just going to have to stand up to her and tell her I have everything under control and I really appreciate her opinion.<\/p>\n<p>\nThanks for the response and I really hope when the time comes I can be strong.<\/p>\n<p>\nShe is a scary one! =)<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p style=\"text-align:center;\"><img src=\"http:\/\/www.tickerclub.com\/tickers\/wedding\/preview\/idTicker\/206838\/rulerId\/\/sliderId\/\/\" alt=\"sliderId\"><\/p>\n<p style=\"text-align:center;\">\u00a0","Email":"amanda@roamcanada.com","IpAddress":"41.218.252.222","GroupId":39,"GroupName":"Newbie","JoinDate":1411393687,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279936.jpg?_r=1414239845","PhotoWidth":200,"PhotoHeight":246,"PhotoType":"custom"},"FormattedName":"amanda2016","Id":279936,"Name":"amanda2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.208.82","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78255,"EditedBy":"<strong>Edited by kmk2016, 21 October 2014 - 08:54 AM.<\/strong>","EditDate":1413881676,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"b46ab03b58303fd28743bd8ca689396b","RawContent":"[quote name=\"amandankeith\" post=\"1876384\" timestamp=\"1413894466\"]\nYou are so right.. As far as I know she isn&#039;t paying for the wedding.. HAHA- that made me remember she said in the very beginning \"If you decide on Mexico I am not coming.\" Damnit.. We should have picked mexico!! LOL just kidding. She is very controlling in every sistuation.. My fiance is a bit stand offish when it comes to standing up to her. She is so use to getting her way and will pull out all stops until she gets what she wants. I told the Fiance last night that I am getting to the point where I no longer care if she like something or will even attend. I know I sounded really harsh when I said it but it&#039;s the truth. I think it kind of hurt his feelings but Damn.. This is our day.. I want it to be everything WE want not what her vision is.\nI am just going to have to stand up to her and tell her I have everything under control and I really appreciate her opinion.\nThanks for the response and I really hope when the time comes I can be strong.\nShe is a scary one! =)[\/quote]Your FI needs to be strong too- this is as much his \"fight\" as yours.... He needs to stand up to her and protect you, your relationship and your (FI &amp;amp; you) decisions. You don&#039;t want to start the marriage with your mil getting the impression that you are \"mean\" because if didn&#039;t put his foot down with her and defend you. His priority needs to be you and him.... It&#039;s no longer about doing what mommy wants. \n\nJust don&#039;t engage her in any more of the process... Or give her a job that doesn&#039;t mean as much to you... Or that won&#039;t impact your vision and have her work on that project so she feels important, but one that has no creative control.\n\nI dealt with this in my first marriage and in the end I was the bad guy since my then-DH didn&#039;t know how to say no to his mother, making it look like I was pushing him to decisions that were mine and not ours (he would appease his mom- which to someone who was controlling like herself, was taken as him siding with her and making me stand alone in defending OUR decisions.) It&#039;s even more important for a healthy marriage (and a happy and wonderful wedding celebration), that he doesn&#039;t just speak up\/agree with you when you are alone... But also in front of his mom!","Attachments":[],"Id":1876385,"PostDate":1413880495,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>amandankeith, on 21 October 2014 - 08:27 AM, said:<\/p><div class='blockquote'><div class='quote'><p>\nYou are so right.. As far as I know she isn't paying for the wedding.. HAHA- that made me remember she said in the very beginning \"If you decide on Mexico I am not coming.\" Damnit.. We should have picked mexico!! LOL just kidding. She is very controlling in every sistuation.. My fiance is a bit stand offish when it comes to standing up to her. She is so use to getting her way and will pull out all stops until she gets what she wants. I told the Fiance last night that I am getting to the point where I no longer care if she like something or will even attend. I know I sounded really harsh when I said it but it's the truth. I think it kind of hurt his feelings but Damn.. This is our day.. I want it to be everything WE want not what her vision is.<br>\nI am just going to have to stand up to her and tell her I have everything under control and I really appreciate her opinion.<br>\nThanks for the response and I really hope when the time comes I can be strong.<br>\nShe is a scary one! =)<\/p><\/div><\/div>Your FI needs to be strong too- this is as much his \"fight\" as yours.... He needs to stand up to her and protect you, your relationship and your (FI & you) decisions. You don't want to start the marriage with your mil getting the impression that you are \"mean\" because if didn't put his foot down with her and defend you. His priority needs to be you and him.... It's no longer about doing what mommy wants. <br><br>\nJust don't engage her in any more of the process... Or give her a job that doesn't mean as much to you... Or that won't impact your vision and have her work on that project so she feels important, but one that has no creative control.<br><br>\nI dealt with this in my first marriage and in the end I was the bad guy since my then-DH didn't know how to say no to his mother, making it look like I was pushing him to decisions that were mine and not ours (he would appease his mom- which to someone who was controlling like herself, was taken as him siding with her and making me stand alone in defending OUR decisions.) It's even more important for a healthy marriage (and a happy and wonderful wedding celebration), that he doesn't just speak up\/agree with you when you are alone... But also in front of his mom!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kmkwedding2016@gmail.com","IpAddress":"70.72.195.234","GroupId":38,"GroupName":"Moderators","JoinDate":1390242208,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kmk2016","Id":276231,"Name":"kmk2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.41.59","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78255,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"109d216713c9641dd888a18a0d2b6b74","RawContent":"&lt;p&gt;I agree with the ladies above!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;This is a day for you and your fiance, and it should reflect you, noone else.&lt;\/p&gt;\n&lt;p&gt;I would hate for any of us to look back and be disappointed in our choices because we were pleasing everyone else except ourselves.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I would just not include her in things. &amp;nbsp;Don&#039;t email her things to ask for her opinion, because you are just allowing her response. &amp;nbsp;Why not do what you two want to do, then send her the final product? &amp;nbsp;Or better yet, just let her wait until it comes in the mail or whatever.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Find something small that doesn&#039;t mean as much to you that you can include her in, if you feel the need. &amp;nbsp;But remember this is your day, NOT HERS! and don&#039;t feel bad, especially if she is not paying -- and you should know this!!!. &amp;nbsp;Your fiance needs to learn to stand up to her, because from her on out it&#039;s about you two and your new family.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck&lt;\/p&gt;","Attachments":[],"Id":1876387,"PostDate":1413883116,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I agree with the ladies above!<\/p>\n<p>\u00a0<\/p>\n<p>This is a day for you and your fiance, and it should reflect you, noone else.<\/p>\n<p>I would hate for any of us to look back and be disappointed in our choices because we were pleasing everyone else except ourselves.<\/p>\n<p>\u00a0<\/p>\n<p>I would just not include her in things. \u00a0Don't email her things to ask for her opinion, because you are just allowing her response. \u00a0Why not do what you two want to do, then send her the final product? \u00a0Or better yet, just let her wait until it comes in the mail or whatever.<\/p>\n<p>\u00a0<\/p>\n<p>Find something small that doesn't mean as much to you that you can include her in, if you feel the need. \u00a0But remember this is your day, NOT HERS! and don't feel bad, especially if she is not paying -- and you should know this!!!. \u00a0Your fiance needs to learn to stand up to her, because from her on out it's about you two and your new family.<\/p>\n<p>\u00a0<\/p>\n<p>Good luck<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.85.216.127","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78255,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"cb14869690dd08597485141c0b3c0e8c","RawContent":"&lt;p&gt;I am so lucky that I have a great mother in law to be, and she helps me with EVERY detail of my wedding. I am not close to my step mom however, but to make her feel included, I normally show her things AFTER the fact of making decisions. I sent her my website when it was done, I have offered to have her hair and make up done with the team we hired, I hired a DJ and then asked her to give me ideas for songs for them to play, etc. It is an easy answer to say, oh we have already made the decision and it cannot be changed now. Also, tell your FI he does need to stick up for the both of you! Mothers and mother in laws are important, but their opinion is not more important than the bride and groom! Good luck :)&lt;\/p&gt;","Attachments":[],"Id":1876390,"PostDate":1413884862,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I am so lucky that I have a great mother in law to be, and she helps me with EVERY detail of my wedding. I am not close to my step mom however, but to make her feel included, I normally show her things AFTER the fact of making decisions. I sent her my website when it was done, I have offered to have her hair and make up done with the team we hired, I hired a DJ and then asked her to give me ideas for songs for them to play, etc. It is an easy answer to say, oh we have already made the decision and it cannot be changed now. Also, tell your FI he does need to stick up for the both of you! Mothers and mother in laws are important, but their opinion is not more important than the bride and groom! Good luck <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"hoopers2901@yahoo.com","IpAddress":"71.85.216.127","GroupId":40,"GroupName":"Jr. Member","JoinDate":1410909188,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279867.jpg?_r=1411696267","PhotoWidth":200,"PhotoHeight":275,"PhotoType":"custom"},"FormattedName":"cfinkenbine","Id":279867,"Name":"cfinkenbine","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"41.218.252.79","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78255,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6faf43c6c5960a0f007bab404d290a64","RawContent":"&lt;p&gt;Thank you ladies for the responses. I guess i know what i need to do.. Going to talk to the fiance tonight and set in stone how I feel and how I think we should move forward. Hopefully he agrees. :wacko:&lt;\/p&gt;","Attachments":[],"Id":1876393,"PostDate":1413887352,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thank you ladies for the responses. I guess i know what i need to do.. Going to talk to the fiance tonight and set in stone how I feel and how I think we should move forward. Hopefully he agrees. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wacko.png' class='bbc_emoticon' alt=':wacko:' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p style=\"text-align:center;\"><img src=\"http:\/\/www.tickerclub.com\/tickers\/wedding\/preview\/idTicker\/206838\/rulerId\/\/sliderId\/\/\" alt=\"sliderId\"><\/p>\n<p style=\"text-align:center;\">\u00a0","Email":"amanda@roamcanada.com","IpAddress":"41.218.252.222","GroupId":39,"GroupName":"Newbie","JoinDate":1411393687,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279936.jpg?_r=1414239845","PhotoWidth":200,"PhotoHeight":246,"PhotoType":"custom"},"FormattedName":"amanda2016","Id":279936,"Name":"amanda2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.101.83.185","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78255,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"24ab615b36c0bd88e54a8b64767654bf","RawContent":"[quote name=\"kmk2016\" post=\"1876383\" timestamp=\"1413894018\"]\nThank her for her input and do what you and your FI want. Stop including her in things...it&#039;s not her wedding it&#039;s yours.\n\nif she pushes for information, have your FI stand up to her and say that you guys have the planning process covered here on out.\n\nIs she paying for the wedding? If not- then she has no say. I would stop asking for her opinion... Even if you are only trying to be nice![\/quote]\nBang on Kim. I totally agree. There being nice then there is bending over backwards. You can tell her the plans are well in hand with a smile on your face. That&#039;s being nice and as nice as you need to be. Do what you both want and just let her know after the fact. If she doesn&#039;t like it, tough.\n\nGood luck!","Attachments":[],"Id":1876414,"PostDate":1413894887,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>kmk2016, on 21 October 2014 - 08:20 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Thank her for her input and do what you and your FI want. Stop including her in things...it's not her wedding it's yours.<br><br>\nif she pushes for information, have your FI stand up to her and say that you guys have the planning process covered here on out.<br><br>\nIs she paying for the wedding? If not- then she has no say. I would stop asking for her opinion... Even if you are only trying to be nice!<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>Bang on Kim. I totally agree. There being nice then there is bending over backwards. You can tell her the plans are well in hand with a smile on your face. That's being nice and as nice as you need to be. Do what you both want and just let her know after the fact. If she doesn't like it, tough.<\/p>\n<p>\u00a0<\/p>\n<p>Good luck!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><em><span style=\"color:rgb(51,153,255);\">I'm lucky enough to\u00a0tell my husband how much I love him and say yes again\u00a0on October 20, 2015 at Grand Coral Beach Club!\u00a0<\/span><\/em>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"100.2.229.196","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78255,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"ea03b39ebbc7360bbf34a622ca449d92","RawContent":"Your heart is in the right place but I think you need to squash this. Is she paying? If not....no pay no say.","Attachments":[],"Id":1877590,"PostDate":1414965012,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Your heart is in the right place but I think you need to squash this. Is she paying? If not....no pay no say. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"robynbrooke81@gmail.com","IpAddress":"75.99.18.219","GroupId":40,"GroupName":"Jr. Member","JoinDate":1403532989,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278661.jpg?_r=1404161707","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"jeffandrobyn","Id":278661,"Name":"jeffandrobyn","IsOnline":false}}],"Id":"78255","Title":"The Control Freak Mother In Law","LastPostDate":1414965012},"Pages":{"TotalItems":9,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
