Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":8,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":1147,"MovedTo":null,"MovedOn":0,"FirstPostId":1907838,"Rating":0,"RatingHits":0,"Starter":{"Id":284728,"Name":"OttawaBride2017","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284728.jpg?_r=1448387511","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"IsOnline":false},"StartDate":1448363734,"LastPoster":{"Id":286918,"Name":"AdamnJenn17","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286918.jpg?_r=1462901352","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1913619,"PostDate":1462907133,"PostContent":"Azuls five or Moon palace seem to have what you need","Author":{"Signature":"","Email":"adamphall@ymail.com","IpAddress":"131.137.245.206","GroupId":40,"GroupName":"Jr. Member","JoinDate":1462868136,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286918.jpg?_r=1462901352","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"AdamnJenn17","Id":286918,"Name":"AdamnJenn17","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.26.14.237","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79760,"EditedBy":"<strong>Edited by OttawaBride2017, 24 November 2015 - 11:17 AM.<\/strong>","EditDate":1448363844,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"4f29cec644a606ac3b777bce1b9d7cb6","RawContent":"&lt;p&gt;Hello Everyone!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;m at the beginning stage of planning\/booking. &amp;nbsp;Only thing set in stone is my dress! lol. &amp;nbsp;I&#039;ve been looking through this forum for months trying to narrow down which resorts to book for January 2017. &amp;nbsp;I am going this coming January to Mexico for vacation at the Platinum Yucatan and hoping to book with GSP if they offer rooftop weddings.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Here&#039;s my list of must-haves:&lt;\/p&gt;\n&lt;p&gt;large all-inclusive resort with multiple buffets and restaurants&lt;\/p&gt;\n&lt;p&gt;disco&lt;\/p&gt;\n&lt;p&gt;family friendly with an adult side&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Things that are negotiable:&lt;\/p&gt;\n&lt;p&gt;unique ceremony site (preferably a rooftop; place where I can wear heels)&lt;\/p&gt;\n&lt;p&gt;contemporary looking&lt;\/p&gt;\n&lt;p&gt;close to Playa Del Carmen&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Here&#039;s my list of AI resorts:&lt;\/p&gt;\n&lt;p&gt;1. Moon Palace - Although it doesn&#039;t offer a rooftop wedding, Beach palace (a sister site) does. Was wondering if anyone has ever stayed at Moon Palace and had their ceremony at Beach Palace?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;2. G&lt;span style=\"color:rgb(0,0,0);\"&gt;rand sirenis Mayan beach&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;&lt;span style=\"color:rgb(0,0,0);\"&gt;3.&lt;\/span&gt;&lt;\/span&gt;&lt;span style=\"color:rgb(0,0,0);font-family:Arial;\"&gt;Paradisus Playa Del Carmen La Esmeralda\/La Perla&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"color:rgb(0,0,0);font-family:Arial;\"&gt;4.Grand Sunset Princess\/Yucatan&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"color:rgb(0,0,0);font-family:Arial;\"&gt;Anyone have any recommendations on resorts to check out?&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1907838,"PostDate":1448363734,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello Everyone!<\/p>\n<p>\u00a0<\/p>\n<p>I'm at the beginning stage of planning\/booking. \u00a0Only thing set in stone is my dress! lol. \u00a0I've been looking through this forum for months trying to narrow down which resorts to book for January 2017. \u00a0I am going this coming January to Mexico for vacation at the Platinum Yucatan and hoping to book with GSP if they offer rooftop weddings.<\/p>\n<p>\u00a0<\/p>\n<p>Here's my list of must-haves:<\/p>\n<p>large all-inclusive resort with multiple buffets and restaurants<\/p>\n<p>disco<\/p>\n<p>family friendly with an adult side<\/p>\n<p>\u00a0<\/p>\n<p>Things that are negotiable:<\/p>\n<p>unique ceremony site (preferably a rooftop; place where I can wear heels)<\/p>\n<p>contemporary looking<\/p>\n<p>close to Playa Del Carmen<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Here's my list of AI resorts:<\/p>\n<p>1. Moon Palace - Although it doesn't offer a rooftop wedding, Beach palace (a sister site) does. Was wondering if anyone has ever stayed at Moon Palace and had their ceremony at Beach Palace?<\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-size:14px\"><span  style=\"font-family:arial, helvetica, sans-serif\">2. G<span  style=\"color:rgb(0,0,0)\">rand sirenis Mayan beach<\/span><\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-size:14px\"><span  style=\"font-family:arial, helvetica, sans-serif\"><span  style=\"color:rgb(0,0,0)\">3.<\/span><\/span><span  style=\"color:rgb(0,0,0);font-family:Arial\">Paradisus Playa Del Carmen La Esmeralda\/La Perla<\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-size:14px\"><span  style=\"color:rgb(0,0,0);font-family:Arial\">4.Grand Sunset Princess\/Yucatan<\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-size:14px\"><span  style=\"color:rgb(0,0,0);font-family:Arial\">Anyone have any recommendations on resorts to check out?<\/span><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"falleneight@gmail.com","IpAddress":"70.26.14.237","GroupId":39,"GroupName":"Newbie","JoinDate":1441716631,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284728.jpg?_r=1448387511","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"OttawaBride2017","Id":284728,"Name":"OttawaBride2017","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.142.4.206","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79760,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"8850ec1180984c43457aac9f47b5ef9b","RawContent":"&lt;p&gt;Welcome to the forum and congrats on your planning!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;m having my wedding at Beach Palace, but we&#039;re also staying there. I&#039;ve stayed at Moon Palace before, also a very beautiful resort!&lt;\/p&gt;\n&lt;p&gt;I don&#039;t believe that you can stay at one resort and have your wedding at another as I do think there are restrictions on visiting sister resorts. I know that when we stayed at Moon Palace and we visited Beach Palace for the day, they restricted us for time as I think a lot of people go to Beach Palace for the better beach.&lt;\/p&gt;\n&lt;p&gt;It is a unique situation though, so maybe email the Palace weddings dept and see :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I don&#039;t know much about the other resorts you have listed, but I do know a past bride who had her wedding at the Grand Sunset Princess and she loves the resort.&lt;\/p&gt;","Attachments":[],"Id":1907839,"PostDate":1448364173,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome to the forum and congrats on your planning!<\/p>\n<p>\u00a0<\/p>\n<p>I'm having my wedding at Beach Palace, but we're also staying there. I've stayed at Moon Palace before, also a very beautiful resort!<\/p>\n<p>I don't believe that you can stay at one resort and have your wedding at another as I do think there are restrictions on visiting sister resorts. I know that when we stayed at Moon Palace and we visited Beach Palace for the day, they restricted us for time as I think a lot of people go to Beach Palace for the better beach.<\/p>\n<p>It is a unique situation though, so maybe email the Palace weddings dept and see <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>I don't know much about the other resorts you have listed, but I do know a past bride who had her wedding at the Grand Sunset Princess and she loves the resort.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419423414,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1453235488","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"200.79.251.123","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79760,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"9c3811e7506de0168e41c229af17c453","RawContent":"[quote name=\"OttawaBride2017\" post=\"1907838\" timestamp=\"1448378134\"]\nHello Everyone!\n\nI&#039;m at the beginning stage of planning\/booking.  Only thing set in stone is my dress! lol.  I&#039;ve been looking through this forum for months trying to narrow down which resorts to book for January 2017.  I am going this coming January to Mexico for vacation at the Platinum Yucatan and hoping to book with GSP if they offer rooftop weddings.\n\nHere&#039;s my list of must-haves:\nlarge all-inclusive resort with multiple buffets and restaurants\ndisco\nfamily friendly with an adult side\n\nThings that are negotiable:\nunique ceremony site (preferably a rooftop; place where I can wear heels)\ncontemporary looking\nclose to Playa Del Carmen\n\n\nHere&#039;s my list of AI resorts:\n1. Moon Palace - Although it doesn&#039;t offer a rooftop wedding, Beach palace (a sister site) does. Was wondering if anyone has ever stayed at Moon Palace and had their ceremony at Beach Palace?\n\n[size=4][font=arial]2. G[color=rgb(0,0,0)]rand sirenis Mayan beach[\/color][\/font][\/size]\n\n[size=4][font=arial][color=rgb(0,0,0)]3.[\/color][\/font][color=rgb(0,0,0)][font=Arial]Paradisus Playa Del Carmen La Esmeralda\/La Perla[\/font][\/color][\/size]\n\n[size=4][color=rgb(0,0,0)][font=Arial]4.Grand Sunset Princess\/Yucatan[\/font][\/color][\/size]\n\n\n[size=4][color=rgb(0,0,0)][font=Arial]Anyone have any recommendations on resorts to check out?[\/font][\/color][\/size][\/quote]@[member=\"OttawaBride2017\"] I love that you have listed your must have, this makes narrowing down easy.  you can also check out Barcelo resort in the riviera maya.  \n\nI have done a wedding this past August at Paradisus. this resort has all your must have. They have beautiful bridge overlooking the ocean,. you can sure wear your heels.  Food is excellent.  They also offer plenty options on to choose from for your reception. Plus its closer to playa del carmen :)\n\nPalace resort, you cannot stay at one and have your wedding at the other.   Beach palace is beautiful the rooftop amazing, please follow link to see a wedding I did last May [url=\"http:\/\/www.juaneuan.com\/m-k-2\/\"]http:\/\/www.juaneuan.com\/m-k-2\/[\/url]food was amazing too.","Attachments":[],"Id":1907844,"PostDate":1448369047,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>OttawaBride2017, on 24 November 2015 - 11:15 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hello Everyone!<\/p>\n<p>\u00a0<\/p>\n<p>I'm at the beginning stage of planning\/booking. \u00a0Only thing set in stone is my dress! lol. \u00a0I've been looking through this forum for months trying to narrow down which resorts to book for January 2017. \u00a0I am going this coming January to Mexico for vacation at the Platinum Yucatan and hoping to book with GSP if they offer rooftop weddings.<\/p>\n<p>\u00a0<\/p>\n<p>Here's my list of must-haves:<\/p>\n<p>large all-inclusive resort with multiple buffets and restaurants<\/p>\n<p>disco<\/p>\n<p>family friendly with an adult side<\/p>\n<p>\u00a0<\/p>\n<p>Things that are negotiable:<\/p>\n<p>unique ceremony site (preferably a rooftop; place where I can wear heels)<\/p>\n<p>contemporary looking<\/p>\n<p>close to Playa Del Carmen<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Here's my list of AI resorts:<\/p>\n<p>1. Moon Palace - Although it doesn't offer a rooftop wedding, Beach palace (a sister site) does. Was wondering if anyone has ever stayed at Moon Palace and had their ceremony at Beach Palace?<\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-size:14px\"><span  style=\"font-family:arial, helvetica, sans-serif\">2. G<span  style=\"color:rgb(0,0,0)\">rand sirenis Mayan beach<\/span><\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-size:14px\"><span  style=\"font-family:arial, helvetica, sans-serif\"><span  style=\"color:rgb(0,0,0)\">3.<\/span><\/span><span  style=\"color:rgb(0,0,0);font-family:Arial\">Paradisus Playa Del Carmen La Esmeralda\/La Perla<\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-size:14px\"><span  style=\"color:rgb(0,0,0);font-family:Arial\">4.Grand Sunset Princess\/Yucatan<\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-size:14px\"><span  style=\"color:rgb(0,0,0);font-family:Arial\">Anyone have any recommendations on resorts to check out?<\/span><\/span><\/p>\n<\/div>\n<\/div><\/div>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"284728\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/284728-ottawabride2017\/' title='Member profile'><span itemprop=\"name\">OttawaBride2017<\/span><\/a> I love that you have listed your must have, this makes narrowing down easy. \u00a0you can also check out Barcelo resort in the riviera maya. \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I have done a wedding this past August at Paradisus. this resort has all your must have. They have beautiful bridge overlooking the ocean,. you can sure wear your heels. \u00a0Food is excellent. \u00a0They also offer plenty options on to choose from for your reception. Plus its closer to playa del carmen <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Palace resort, you cannot stay at one and have your wedding at the other. \u00a0 Beach palace is beautiful the rooftop amazing, please follow link to see a wedding I did last May\u00a0<a href='http:\/\/www.juaneuan.com\/m-k-2\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.juaneuan.com\/m-k-2\/<\/a>food was amazing too. <\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Dream Weddings Riviera Maya- We pay attention to your wishes and coordinate closely with you to ensure your wedding or event is planned to perfection! Supporting you brides and help you feel less overwhelmed during the wedding planning process.<\/p>\n<p>Have fun the best is yet to come!<\/p>\n<p>\u00a0<\/p>\n<p>This is where I will be posting all videos about most common question about Destination wedding<\/p>\n<p> <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0\u00a0<a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/groups\/1664036763874450\/'>https:\/\/www.facebook.com\/groups\/1664036763874450\/<\/a><br><br><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Dream Weddings Riviera Maya<\/span><\/span><\/span><br><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">weddingsinplayadelcarmen@gmail.com<\/span><\/span><br><a  class=\"bbc_url\" href=\"http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html\">http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html<\/a><br><br><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Happy Planning!<\/span><\/span><\/span><br><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Joyce<\/span><\/span><\/span>","Email":"weddingsinplayadelcarmen@gmail.com","IpAddress":"187.252.44.28","GroupId":84,"GroupName":"Insiders w\/ Articles","JoinDate":1326839987,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250090.jpg?_r=1451923195","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"dreamweddings","Id":250090,"Name":"dreamweddings","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"190.167.79.154","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79760,"EditedBy":"<strong>Edited by Moments That Matter, 24 November 2015 - 02:22 PM.<\/strong>","EditDate":1448374976,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5af5e764d0b68d6ca04c33d680eacad3","RawContent":"&lt;p&gt;Welcome to our forum community OttawaBride2017 and Congrats on your dw coming up in Mexico!!! You&#039;ve come to the right place for lots of great info, ideas, suggestions and support from everyone here - so well done on joining up :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;You&#039;ve picked some beautiful venues to consider too. To show you what each one would look like as the backdrop to your wedding photos, here are some magical wedding moments that matter we captured at each one.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10153058061334487.1073741919.18683524486&amp;amp;type=3&#039;&gt;Moon Palace Wedding Album:&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-lga3-1.xx.fbcdn.net\/hphotos-xfp1\/t31.0-8\/10943767_10153058065349487_7445590650785489943_o.jpg\" alt=\"10943767_10153058065349487_7445590650785\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-lga3-1.xx.fbcdn.net\/hphotos-xfp1\/t31.0-8\/10955789_10153058069679487_5709901704532276152_o.jpg\" alt=\"10955789_10153058069679487_5709901704532\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-lga3-1.xx.fbcdn.net\/hphotos-frc3\/t31.0-8\/10904548_10153058072764487_833388014720734260_o.jpg\" alt=\"10904548_10153058072764487_8333880147207\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10150951039939487.436910.18683524486&amp;amp;type=3&#039;&gt;Grand Sirenis Wedding Album:&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-lga3-1.xx.fbcdn.net\/hphotos-xfa1\/t31.0-8\/456756_10150951043974487_952250364_o.jpg\" alt=\"456756_10150951043974487_952250364_o.jpg\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-lga3-1.xx.fbcdn.net\/hphotos-xfa1\/v\/t1.0-9\/270816_10150951047479487_48048558_n.jpg?oh=ce8031a044e6ad1278cc8e12d95627cb&amp;amp;oe=56ECF05D\" alt=\"270816_10150951047479487_48048558_n.jpg?\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-lga3-1.xx.fbcdn.net\/hphotos-xfa1\/t31.0-8\/338751_10150951048374487_246483711_o.jpg\" alt=\"338751_10150951048374487_246483711_o.jpg\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10152890297574487.1073741914.18683524486&amp;amp;type=3&#039;&gt;Grand Sunset Princess Wedding Album: &lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-lga3-1.xx.fbcdn.net\/hphotos-prn2\/t31.0-8\/10750114_10152890299414487_3575364687095664686_o.jpg\" alt=\"10750114_10152890299414487_3575364687095\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-lga3-1.xx.fbcdn.net\/hphotos-ash2\/t31.0-8\/10838047_10152890301179487_5289249448519652514_o.jpg\" alt=\"10838047_10152890301179487_5289249448519\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-lga3-1.xx.fbcdn.net\/hphotos-xfa1\/t31.0-8\/10382618_10152890301224487_4630599895385100321_o.jpg\" alt=\"10382618_10152890301224487_4630599895385\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10153701889049487.1073741950.18683524486&amp;amp;type=3&#039;&gt;Barcelo Maya Palace Wedding Album: &lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-lga3-1.xx.fbcdn.net\/hphotos-xfa1\/t31.0-8\/12052591_10153701891304487_2102274556900521361_o.jpg\" alt=\"12052591_10153701891304487_2102274556900\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-lga3-1.xx.fbcdn.net\/hphotos-xtf1\/t31.0-8\/12182935_10153701893169487_7539535003310558157_o.jpg\" alt=\"12182935_10153701893169487_7539535003310\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-lga3-1.xx.fbcdn.net\/hphotos-xfa1\/t31.0-8\/12182441_10153701893924487_4998861185181823873_o.jpg\" alt=\"12182441_10153701893924487_4998861185181\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-lga3-1.xx.fbcdn.net\/hphotos-xlp1\/t31.0-8\/12028776_10153701896399487_7792500556898099465_o.jpg\" alt=\"12028776_10153701896399487_7792500556898\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Wishing you happy research and all the best with your plans - cheers!!! team MTM :)&lt;\/p&gt;","Attachments":[],"Id":1907848,"PostDate":1448374911,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome to our forum community OttawaBride2017 and Congrats on your dw coming up in Mexico!!! You've come to the right place for lots of great info, ideas, suggestions and support from everyone here - so well done on joining up <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>You've picked some beautiful venues to consider too. To show you what each one would look like as the backdrop to your wedding photos, here are some magical wedding moments that matter we captured at each one.<\/p>\n<p>\u00a0<\/p>\n<p><a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10153058061334487.1073741919.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>Moon Palace Wedding Album:<\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-lga3-1.xx.fbcdn.net\/hphotos-xfp1\/t31.0-8\/10943767_10153058065349487_7445590650785489943_o.jpg\" alt=\"10943767_10153058065349487_7445590650785\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-lga3-1.xx.fbcdn.net\/hphotos-xfp1\/t31.0-8\/10955789_10153058069679487_5709901704532276152_o.jpg\" alt=\"10955789_10153058069679487_5709901704532\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-lga3-1.xx.fbcdn.net\/hphotos-frc3\/t31.0-8\/10904548_10153058072764487_833388014720734260_o.jpg\" alt=\"10904548_10153058072764487_8333880147207\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10150951039939487.436910.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>Grand Sirenis Wedding Album:<\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-lga3-1.xx.fbcdn.net\/hphotos-xfa1\/t31.0-8\/456756_10150951043974487_952250364_o.jpg\" alt=\"456756_10150951043974487_952250364_o.jpg\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-lga3-1.xx.fbcdn.net\/hphotos-xfa1\/v\/t1.0-9\/270816_10150951047479487_48048558_n.jpg?oh=ce8031a044e6ad1278cc8e12d95627cb&oe=56ECF05D\" alt=\"270816_10150951047479487_48048558_n.jpg?\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-lga3-1.xx.fbcdn.net\/hphotos-xfa1\/t31.0-8\/338751_10150951048374487_246483711_o.jpg\" alt=\"338751_10150951048374487_246483711_o.jpg\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10152890297574487.1073741914.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>Grand Sunset Princess Wedding Album: <\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-lga3-1.xx.fbcdn.net\/hphotos-prn2\/t31.0-8\/10750114_10152890299414487_3575364687095664686_o.jpg\" alt=\"10750114_10152890299414487_3575364687095\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-lga3-1.xx.fbcdn.net\/hphotos-ash2\/t31.0-8\/10838047_10152890301179487_5289249448519652514_o.jpg\" alt=\"10838047_10152890301179487_5289249448519\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-lga3-1.xx.fbcdn.net\/hphotos-xfa1\/t31.0-8\/10382618_10152890301224487_4630599895385100321_o.jpg\" alt=\"10382618_10152890301224487_4630599895385\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10153701889049487.1073741950.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>Barcelo Maya Palace Wedding Album: <\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-lga3-1.xx.fbcdn.net\/hphotos-xfa1\/t31.0-8\/12052591_10153701891304487_2102274556900521361_o.jpg\" alt=\"12052591_10153701891304487_2102274556900\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-lga3-1.xx.fbcdn.net\/hphotos-xtf1\/t31.0-8\/12182935_10153701893169487_7539535003310558157_o.jpg\" alt=\"12182935_10153701893169487_7539535003310\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-lga3-1.xx.fbcdn.net\/hphotos-xfa1\/t31.0-8\/12182441_10153701893924487_4998861185181823873_o.jpg\" alt=\"12182441_10153701893924487_4998861185181\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-lga3-1.xx.fbcdn.net\/hphotos-xlp1\/t31.0-8\/12028776_10153701896399487_7792500556898099465_o.jpg\" alt=\"12028776_10153701896399487_7792500556898\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>Wishing you happy research and all the best with your plans - cheers!!! team MTM <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography , Cancun, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving the Riviera Maya<\/p>\n<p>\u00a0<\/p>\n<p>Email: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p><span style=\"color:#0000cd;\"><strong>Why we're Ranked #1<\/strong><\/span> ~ Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21512-moments-that-matter-photography\/'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a><\/p>\n<p>\u00a0<\/p>\n<p><strong><span style=\"color:#0000cd;\"><span style=\"font-family:'comic sans ms', cursive;\">We Offer<\/span><\/span><\/strong>: <strong><em><u>100% Vendor Fee Discount<\/u><br>\n\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 <u>100% Deposit Guarantee<\/u><\/em><\/strong><\/p>\n<p><strong><em>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 \u00a0 <u>100% Satisfaction Guarantee<\/u><\/em><\/strong>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280196260,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.146.146.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79760,"EditedBy":"<strong>Edited by calgarybride2015, 25 November 2015 - 12:52 AM.<\/strong>","EditDate":1448412769,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"f16d5b08029e7f22ed17350c8ebc8894","RawContent":"Welcome\n\n\nI got married at the Grand Sirenis. We stayed on the Riviera Maya side. \n\nThey don&#039;t have an adults only section that I&#039;m aware of just a members only area (think time share not upgraded package). \n\n\nThey do have a beautiful unique private beach for ceremony with palapa for the reception. It&#039;s breath taking. They don&#039;t have a roof top so wearing heals may be tricky. You can get the sand\/grass heal bottoms though and an isle runner would help. \n\n\nYou can check out my review and pics below. Willing to answer any questions you have. \n\n\nGood luck. \n\n\n\nSent from my iPad using Tapatalk","Attachments":[],"Id":1907858,"PostDate":1448412712,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Welcome<br><br>\nI got married at the Grand Sirenis. We stayed on the Riviera Maya side. <br>\nThey don't have an adults only section that I'm aware of just a members only area (think time share not upgraded package). <br><br>\nThey do have a beautiful unique private beach for ceremony with palapa for the reception. It's breath taking. They don't have a roof top so wearing heals may be tricky. You can get the sand\/grass heal bottoms though and an isle runner would help. <br><br>\nYou can check out my review and pics below. Willing to answer any questions you have. <br><br>\nGood luck. <br><br><br>\nSent from my iPad using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.2.49.178","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79760,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"45e8112fd56b077376024420181b01bb","RawContent":"&lt;p&gt;HI&amp;nbsp;@[member=\"OttawaBride2017\"],&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Congrats on your engagement and welcome to the forum!&lt;\/p&gt;\n&lt;p&gt;I&#039;m also a January 2017 bride, and we&#039;re booked at Moon Palace in Cancun. MP definitely ticks of all of your &#039;must-have&#039; boxes, and we&#039;re actually hosting our reception at the Caribbean Terrace which is some-what of a rooftop type\/deck terrace (it lives above the Caribbean Restaurant and is outdoors). I wouldn&#039;t say that MP is really &#039;contemporary looking&#039;, I feel like it lends a little more to the &#039;Mayan&#039; feel, but it&#039;s sister resorts Sun Palace, Beach Palace, and Le Blanc (adults-only) definitely are!&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Palace resorts as a group offers a lot of great group incentives, like the unlimited private events, based off of room nights and Moon Palace is a huge resort so if you&#039;re looking for lots to do to keep your guests entertained, you definitely won&#039;t have any problems here!&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;You&#039;ll find a lot of helpful forums and blogs here to help with your planning! @[member=\"perianjay\"], @[member=\"Wafflesmom\"] and @[member=\"tygrrlily\"] are 3 just to name a few, and are really great reads esp. if you&#039;re considering Palace Resorts :)&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Let us know if we can help, I&#039;m sure you have lots of questions :)&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1908091,"PostDate":1449163402,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>HI\u00a0@<a hovercard-ref=\"member\" hovercard-id=\"284728\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/284728-ottawabride2017\/' title='Member profile'><span itemprop=\"name\">OttawaBride2017<\/span><\/a>,<\/p>\n<p>\u00a0<\/p>\n<p>Congrats on your engagement and welcome to the forum!<\/p>\n<p>I'm also a January 2017 bride, and we're booked at Moon Palace in Cancun. MP definitely ticks of all of your 'must-have' boxes, and we're actually hosting our reception at the Caribbean Terrace which is some-what of a rooftop type\/deck terrace (it lives above the Caribbean Restaurant and is outdoors). I wouldn't say that MP is really 'contemporary looking', I feel like it lends a little more to the 'Mayan' feel, but it's sister resorts Sun Palace, Beach Palace, and Le Blanc (adults-only) definitely are!\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Palace resorts as a group offers a lot of great group incentives, like the unlimited private events, based off of room nights and Moon Palace is a huge resort so if you're looking for lots to do to keep your guests entertained, you definitely won't have any problems here!\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>You'll find a lot of helpful forums and blogs here to help with your planning! @<a hovercard-ref=\"member\" hovercard-id=\"281478\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/281478-perianjay\/' title='Member profile'><span itemprop=\"name\">perianjay<\/span><\/a>, @<a hovercard-ref=\"member\" hovercard-id=\"279721\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/279721-wafflesmom\/' title='Member profile'><span itemprop=\"name\">Wafflesmom<\/span><\/a> and @<a hovercard-ref=\"member\" hovercard-id=\"277296\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/277296-tygrrlily\/' title='Member profile'><span itemprop=\"name\">tygrrlily<\/span><\/a> are 3 just to name a few, and are really great reads esp. if you're considering Palace Resorts <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Let us know if we can help, I'm sure you have lots of questions <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Jess<\/p>\n<p>\u00a0<\/p>\n<p>My Planning Thread:\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79659-jes0912-moon-palace-planning-thread\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79659-jes0912-moon-palace-planning-thread\/<\/a>","Email":"jessica.so@icloud.com","IpAddress":"70.36.49.204","GroupId":39,"GroupName":"Newbie","JoinDate":1444264103,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"none"},"FormattedName":"jes0912","Id":285044,"Name":"jes0912","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.114.59.65","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79760,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"698d769eb5f9926f9055acb6b668c53e","RawContent":"I&#039;ve been to both Moon and Beach. They are the exact same when it comes to decor and I have to slightly disagree about the mayan feel. I think Moon Palace is actually contemporary as well! I&#039;d say most Palace Resorts are pretty consistent with their style, but it&#039;s definitely a more luxurious feel!","Attachments":[],"Id":1908095,"PostDate":1449171877,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I've been to both Moon and Beach. They are the exact same when it comes to decor and I have to slightly disagree about the mayan feel. I think Moon Palace is actually contemporary as well! I'd say most Palace Resorts are pretty consistent with their style, but it's definitely a more luxurious feel! \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419423414,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1453235488","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"131.137.245.208","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79760,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b9a2b8fc56d0ac6ce0e4a9686e799f11","RawContent":"&lt;p&gt;Azuls five or Moon palace seem to have what you need&lt;\/p&gt;","Attachments":[],"Id":1913619,"PostDate":1462907133,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Azuls five or Moon palace seem to have what you need<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"adamphall@ymail.com","IpAddress":"131.137.245.206","GroupId":40,"GroupName":"Jr. Member","JoinDate":1462868136,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286918.jpg?_r=1462901352","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"AdamnJenn17","Id":286918,"Name":"AdamnJenn17","IsOnline":false}}],"Id":"79760","Title":"Noob Bride- January 2017 Riviera Maya","LastPostDate":1462907133},"Pages":{"TotalItems":8,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
