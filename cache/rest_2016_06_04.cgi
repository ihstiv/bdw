{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"162.238.130.192","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":74459,"EditedBy":"","EditDate":1406934750,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f6fa9c08fc0d454b3e1db4d65f5c62a4","RawContent":"&lt;p&gt;@[member=\"susie q\"] Our wedding turned out perfect! HCC is such a beautiful place to get married! Our guests kept commenting on how gorgeous the venue was! &amp;nbsp;The service was great and we got many compliments on the food. &amp;nbsp;I definitely recommend all my vendors too! Let me know if you need any recommendations. &amp;nbsp;I haven&#039;t gotten the professional pics back yet, but here are a few pics that my relatives took:&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.flickr.com\/photos\/125558902@N06\/sets\/72157645698860900\/&#039;&gt;https:\/\/www.flickr.com\/photos\/125558902@N06\/sets\/72157645698860900\/&lt;\/a&gt;&lt;\/p&gt;","Attachments":[],"Id":1864104,"PostDate":1406934466,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"236660\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/236660-susie-q\/' title='Member profile'><span itemprop=\"name\">susie q<\/span><\/a> Our wedding turned out perfect! HCC is such a beautiful place to get married! Our guests kept commenting on how gorgeous the venue was! \u00a0The service was great and we got many compliments on the food. \u00a0I definitely recommend all my vendors too! Let me know if you need any recommendations. \u00a0I haven't gotten the professional pics back yet, but here are a few pics that my relatives took:<\/p>\n<p>\u00a0<\/p>\n<p><a href='https:\/\/www.flickr.com\/photos\/125558902@N06\/sets\/72157645698860900\/' class='bbc_url' title='External link' rel='nofollow external'>https:\/\/www.flickr.c...57645698860900\/<\/a><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"h_preece@yahoo.com","IpAddress":"162.238.130.192","GroupId":39,"GroupName":"Newbie","JoinDate":1372631272,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-271076.jpg?_r=1420341074","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"hpreece","Id":271076,"Name":"hpreece","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.105.98.82","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":74459,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5f942c623756e985fb929ae55b3da396","RawContent":"&lt;p&gt;@hpreece&amp;nbsp; Thanks for sharing the pictures!&amp;nbsp; The setup looks absolutely gorgeous!&amp;nbsp; Who did you get your flowers from?&lt;\/p&gt;","Attachments":[],"Id":1870433,"PostDate":1409763308,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@hpreece\u00a0 Thanks for sharing the pictures!\u00a0 The setup looks absolutely gorgeous!\u00a0 Who did you get your flowers from?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jasminearceo@gmail.com","IpAddress":"74.105.98.82","GroupId":39,"GroupName":"Newbie","JoinDate":1398959405,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277804.jpg?_r=1416936614","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"jazzzy23","Id":277804,"Name":"jazzzy23","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"162.238.130.113","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":74459,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0ca4a4bd9e60ab8037e8c98f4b5c8b77","RawContent":"&lt;p&gt;@[member=\"jazzzy23\"] Hi! Sorry it took so long for me to respond. &amp;nbsp;I haven&#039;t been on here in awhile. &amp;nbsp;I used Sergio from \"Flowers and Events\". &amp;nbsp;He was reasonably priced and the flowers turned out much better than I thought they were going to. &amp;nbsp;I loved them! He made everything exactly like the pictures I had shown him. &amp;nbsp;He isn&#039;t very quick to responding to emails, but my wedding coordinator would get in contact with him if I didn&#039;t hear back from him.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1878250,"PostDate":1415803712,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"277804\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277804-jazzzy23\/' title='Member profile'><span itemprop=\"name\">jazzzy23<\/span><\/a> Hi! Sorry it took so long for me to respond. \u00a0I haven't been on here in awhile. \u00a0I used Sergio from \"Flowers and Events\". \u00a0He was reasonably priced and the flowers turned out much better than I thought they were going to. \u00a0I loved them! He made everything exactly like the pictures I had shown him. \u00a0He isn't very quick to responding to emails, but my wedding coordinator would get in contact with him if I didn't hear back from him.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"h_preece@yahoo.com","IpAddress":"162.238.130.192","GroupId":39,"GroupName":"Newbie","JoinDate":1372631272,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-271076.jpg?_r=1420341074","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"hpreece","Id":271076,"Name":"hpreece","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.105.98.82","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":74459,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"31ddeec2f335d83719bf4703f26e7223","RawContent":"&lt;p&gt;@[member=\"hpreece\"] thanks so much for getting back to me!!&amp;nbsp; I will look into Sergio!&lt;\/p&gt;","Attachments":[],"Id":1878727,"PostDate":1416412154,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"271076\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/271076-hpreece\/' title='Member profile'><span itemprop=\"name\">hpreece<\/span><\/a> thanks so much for getting back to me!!\u00a0 I will look into Sergio!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jasminearceo@gmail.com","IpAddress":"74.105.98.82","GroupId":39,"GroupName":"Newbie","JoinDate":1398959405,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277804.jpg?_r=1416936614","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"jazzzy23","Id":277804,"Name":"jazzzy23","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"97.77.254.234","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":74459,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c1f3b187f38e109fd5c3dfee06838d51","RawContent":"&lt;p&gt;@[member=\"jazzzy23\"]&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am using Sergio as well! He has been pretty good at getting back to me. I have the quote from him, and we are actually paying cash when we get there. This is the only thing that makes me nervous, because I dont have a \"contract\" but I am planning on emailing him every 2-3 months until the wedding. :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am also going the \"cheaper\" route to save money and I am buying them all separate, and putting them together myself the day of with ribbon etc. However, I am just getting sunflowers and babys breathe.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Because of this, and not telling him I was a bride, my flowers only cost $230!!!! :) :) :) I felt like I needed to party after seeing that number compared to $1000&#039;s I was seeing from other people.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1879963,"PostDate":1418060720,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"277804\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277804-jazzzy23\/' title='Member profile'><span itemprop=\"name\">jazzzy23<\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>I am using Sergio as well! He has been pretty good at getting back to me. I have the quote from him, and we are actually paying cash when we get there. This is the only thing that makes me nervous, because I dont have a \"contract\" but I am planning on emailing him every 2-3 months until the wedding. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>I am also going the \"cheaper\" route to save money and I am buying them all separate, and putting them together myself the day of with ribbon etc. However, I am just getting sunflowers and babys breathe.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Because of this, and not telling him I was a bride, my flowers only cost $230!!!! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> I felt like I needed to party after seeing that number compared to $1000's I was seeing from other people.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>me and the fiance + 61 guests + 1 week in Cabo while getting married = 1 happy girl <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/cool.png' class='bbc_emoticon' alt='B)' \/>","Email":"cassie.trudeau@gmail.com","IpAddress":"107.77.66.33","GroupId":47,"GroupName":"Site Supporter","JoinDate":1398901702,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277793.jpg?_r=1398917495","PhotoWidth":144,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"cassie06","Id":277793,"Name":"cassie06","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.167.7.154","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":74459,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7a9ed27e2b4bf51cdafa0930c23b1820","RawContent":"&lt;p&gt;Hi ladies,&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am looking to get married at Hacienda Cocina after all of your great reviews!&amp;nbsp;\n\n\nWhere did all of your guests stay for the weekend?&amp;nbsp;\n\n\nAny advice for keeping the wedding under $12000 would be great! It is for 60 guests.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1888927,"PostDate":1426008936,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi ladies,\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I am looking to get married at Hacienda Cocina after all of your great reviews!\u00a0<br><br>\nWhere did all of your guests stay for the weekend?\u00a0<br><br>\nAny advice for keeping the wedding under $12000 would be great! It is for 60 guests.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ash.m.berry@gmail.com","IpAddress":"70.167.7.154","GroupId":39,"GroupName":"Newbie","JoinDate":1426008718,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282383.jpg?_r=1436828369","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"AshBerry","Id":282383,"Name":"AshBerry","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"98.199.162.92","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":74459,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0b1ae97736b88bd2aadff78ccff135db","RawContent":"&lt;p&gt;Hey Ladies!&lt;\/p&gt;\n&lt;p&gt;I know you were all on a budget around what we are looking at. What did you end up spending @[member=\"AshBerry\"] @[member=\"hpreece\"] @[member=\"cassie06\"] ?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thanks so much in advance!&lt;\/p&gt;","Attachments":[],"Id":1909025,"PostDate":1452041705,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hey Ladies!<\/p>\n<p>I know you were all on a budget around what we are looking at. What did you end up spending @<a hovercard-ref=\"member\" hovercard-id=\"282383\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282383-ashberry\/' title='Member profile'><span itemprop=\"name\">AshBerry<\/span><\/a> @<a hovercard-ref=\"member\" hovercard-id=\"271076\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/271076-hpreece\/' title='Member profile'><span itemprop=\"name\">hpreece<\/span><\/a> @<a hovercard-ref=\"member\" hovercard-id=\"277793\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277793-cassie06\/' title='Member profile'><span itemprop=\"name\">cassie06<\/span><\/a> ?<\/p>\n<p>\u00a0<\/p>\n<p>Thanks so much in advance!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"happilyurbanafter@gmail.com","IpAddress":"98.199.162.92","GroupId":39,"GroupName":"Newbie","JoinDate":1452039795,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"AlmostDrMrsUrban","Id":285791,"Name":"AlmostDrMrsUrban","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.146.146.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":74459,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d261ee0d422501b0878000b3a8b95e32","RawContent":"I spent just over $5000. Maybe $5500 for a wedding with 45 people and a private palapa location. The reception was 6 hours and I had many add ons\/extras. \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1909270,"PostDate":1452505784,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I spent just over $5000. Maybe $5500 for a wedding with 45 people and a private palapa location. The reception was 6 hours and I had many add ons\/extras. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}}],"Pages":{"TotalItems":18,"TotalPages":2,"CurrentPage":10,"NextPage":-1,"PreviousPage":0,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
