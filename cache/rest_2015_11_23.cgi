ly.com\/media\/47b8cc01b3127ccec5bd800e20a600000060O08YaNWzVw4B7efCQ\/cC\/f%3D0\/ps%3D50\/r%3D0\/rx%3D400\/ry%3D200\/\">http:\/\/im1.shutterfly.com\/media\/47b8...D400\/ry%3D200\/<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;130\/st\/20081122\/e\/Our+Wedding\/k\/6784\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...6784\/event.png<\/a><\/div><\/div>","Email":"misstorres13@aol.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1199513791,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208131.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"LadyCheese","Id":208131,"Name":"LadyCheese","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":11205,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ec024db48296b35f7e5ee85d8500423d","RawContent":"When you get a private reception, they set up a bar (not a actually bar but they get a table with a white table cloth and stock it up with premium domestic and international drinks) as told to me by the WC. They do not charge extra for this, it is included.","Attachments":[],"Id":192023,"PostDate":1202760485,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                When you get a private reception, they set up a bar (not a actually bar but they get a table with a white table cloth and stock it up with premium domestic and international drinks) as told to me by the WC. They do not charge extra for this, it is included.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jduran186@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1201808848,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208423.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"jen419","Id":208423,"Name":"jen419","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":11205,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"86f83c099a349e26b4b39789d266eebc","RawContent":"\n Thx, thats what they did for my friends wedding in Puerto Plata and that sounds more reasonable that what another resort was offering to me.","Attachments":[],"Id":192036,"PostDate":1202761620,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <br \/> Thx, thats what they did for my friends wedding in Puerto Plata and that sounds more reasonable that what another resort was offering to me.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/im1.shutterfly.com\/media\/47b8cc39b3127ccec5b04ffd9d7100000060O08YaNWzVw4B7efCQ\/cC\/f%3D0\/ps%3D50\/r%3D0\/rx%3D400\/ry%3D300\/\">http:\/\/im1.shutterfly.com\/media\/47b8...D400\/ry%3D300\/<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/im1.shutterfly.com\/media\/47b8cc01b3127ccec5bd800e20a600000060O08YaNWzVw4B7efCQ\/cC\/f%3D0\/ps%3D50\/r%3D0\/rx%3D400\/ry%3D200\/\">http:\/\/im1.shutterfly.com\/media\/47b8...D400\/ry%3D200\/<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;130\/st\/20081122\/e\/Our+Wedding\/k\/6784\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...6784\/event.png<\/a><\/div><\/div>","Email":"misstorres13@aol.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1199513791,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208131.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"LadyCheese","Id":208131,"Name":"LadyCheese","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":11205,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e193f09852d77b7a5a402c0be6d8f786","RawContent":"I&#039;m not getting married at Dreams, but I would think there would be different package options.\n \n Included in our beach reception is a buffett and open bar (3 hours) for $2500.\n \n We are also doing a private bar 1\/2 before and 1\/2 hour after the ceremony right next to the gazebo. That is priced per person\/per hour.","Attachments":[],"Id":192106,"PostDate":1202764770,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n      