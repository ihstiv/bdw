awContent":"Congrats \nAlso planning for April 2016 giving guests time to save","Attachments":[],"Id":1850924,"PostDate":1400356400,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Congrats <br \/>Also planning for April 2016 giving guests time to save\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kdevries@shaw.ca","IpAddress":"50.65.17.253","GroupId":39,"GroupName":"Newbie","JoinDate":1359762644,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265520.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Kardev","Id":265520,"Name":"Kardev","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.114.24.237","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75627,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4d8cb88eae10768ec5f96c4cd6951dd6","RawContent":"Feb 2016 here! We are planning ahead to allow our guests to save as well! Looks like there are a few of us doing the same thing! In the meantime it allows me to try and save some money by keeping my eye out for deals... Try DIY projects and find the perfect dress all without feeling the panic! We have our resort 99% confirmed (going down for a site visit in 3 weeks to make sure it&#039;s perfect)... And then invites are going out in July to allow early deposits. \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1850927,"PostDate":1400356845,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Feb 2016 here! We are planning ahead to allow our guests to save as well! Looks like there are a few of us doing the same thing! In the meantime it allows me to try and save some money by keeping my eye out for deals... Try DIY projects and find the perfect dress all without feeling the panic! We have our resort 99% confirmed (going down for a site visit in 3 weeks to make sure it's perfect)... And then invites are going out in July to allow early deposits. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kmkwedding2016@gmail.com","IpAddress":"70.72.195.234","GroupId":38,"GroupName":"Moderators","JoinDate":1390242208,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kmk2016","Id":276231,"Name":"kmk2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.65.17.253","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75627,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"48f8eb5b413321f493bafa8803dd2771","RawContent":"Congrats everyone","Attachments":[],"Id":1850997,"PostDate":1400404564,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n           