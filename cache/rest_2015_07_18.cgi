Request Time: 1 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":19,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":1164,"MovedTo":null,"MovedOn":0,"FirstPostId":1872203,"Rating":0,"RatingHits":0,"Starter":{"Id":279766,"Name":"MorganRene","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279766.jpg?_r=1410362818","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"IsOnline":false},"StartDate":1411046305,"LastPoster":{"Id":281404,"Name":"Karryl","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281404.jpg?_r=1437212587","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":44,"Preview":{"Id":1872203,"PostDate":1411046305,"PostContent":"I've seen a lot of bridesmaids gifts posts, but haven't seen a lot of \"parents gifts\" posts. \u00a0Wha...","Author":{"Signature":"","Email":"morgan.rene1@gmail.com","IpAddress":"66.87.153.227","GroupId":40,"GroupName":"Jr. Member","JoinDate":1410347199,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279766.jpg?_r=1410362818","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"FormattedName":"MorganRene","Id":279766,"Name":"MorganRene","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.87.234.180","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78048,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"de57e56f4105147a76e0015a3241d34c","RawContent":"&lt;p&gt;I&#039;ve seen a lot of bridesmaids gifts posts, but haven&#039;t seen a lot of \"parents gifts\" posts. &amp;nbsp;What are you planning on giving your parents and your groom&#039;s parents?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Are you opting to take it to the resort, or give it to them later so they don&#039;t have to take it down?&lt;\/p&gt;","Attachments":[],"Id":1872203,"PostDate":1411046305,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I've seen a lot of bridesmaids gifts posts, but haven't seen a lot of \"parents gifts\" posts. \u00a0What are you planning on giving your parents and your groom's parents?<\/p>\n<p>\u00a0<\/p>\n<p>Are you opting to take it to the resort, or give it to them later so they don't have to take it down?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"morgan.rene1@gmail.com","IpAddress":"66.87.153.227","GroupId":40,"GroupName":"Jr. Member","JoinDate":1410347199,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279766.jpg?_r=1410362818","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"FormattedName":"MorganRene","Id":279766,"Name":"MorganRene","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"184.69.200.21","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78048,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6bf8c29c5d9ecc7ef5d601e158ad15af","RawContent":"&lt;p&gt;We aren&#039;t doing any gifts for our parents.&lt;\/p&gt;\n&lt;p&gt;I am not sure the &#039;tradition&#039; behind it, but we have decided not too.&lt;\/p&gt;\n&lt;p&gt;If it makes a difference they aren&#039;t helping pay for our wedding but that is not the reason we decided against it, just didn&#039;t think it was necessary.&lt;\/p&gt;\n&lt;p&gt;I had considered giving my dad something small as he is walking me down the isle, but decided on a nice card\/message.&lt;\/p&gt;","Attachments":[],"Id":1872224,"PostDate":1411050226,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>We aren't doing any gifts for our parents.<\/p>\n<p>I am not sure the 'tradition' behind it, but we have decided not too.<\/p>\n<p>If it makes a difference they aren't helping pay for our wedding but that is not the reason we decided against it, just didn't think it was necessary.<\/p>\n<p>I had considered giving my dad something small as he is walking me down the isle, but decided on a nice card\/message.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.18.213.150","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78048,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8b4e3580a9438db4530f75c36c8fdf4b","RawContent":"I opted to just because my parents are sentimental but it wasn&#039;t big by any means. I ordered handkerchiefs from a vendor on etsy and got a personalized message on each one.. One for mom, one for my dad, one for FI mom and one for his dad. They were about 20.00 each. We are paying for things ourselves but I thought it would be a nice touch. To each their own though!","Attachments":[],"Id":1872240,"PostDate":1411055838,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I opted to just because my parents are sentimental but it wasn't big by any means. I ordered handkerchiefs from a vendor on etsy and got a personalized message on each one.. One for mom, one for my dad, one for FI mom and one for his dad. They were about 20.00 each. We are paying for things ourselves but I thought it would be a nice touch. To each their own though!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lcboyko@ualberta.ca","IpAddress":"23.17.180.191","GroupId":47,"GroupName":"Site Supporter","JoinDate":1304957891,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-239790.jpg?_r=1434572414","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Mrsktobe","Id":239790,"Name":"Mrsktobe","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"184.151.222.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78048,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b356c2935ad0b52b5910f33bab6e89db","RawContent":"[quote name=\"Mrsktobe\" post=\"1872240\" timestamp=\"1411070238\"]\nI opted to just because my parents are sentimental but it wasn&#039;t big by any means. I ordered handkerchiefs from a vendor on etsy and got a personalized message on each one.. One for mom, one for my dad, one for FI mom and one for his dad. They were about 20.00 each. We are paying for things ourselves but I thought it would be a nice touch. To each their own though![\/quote]I asked fianc\u00e9 if he wanted to do this and he said they wouldn&#039;t use them :(   Unless I can think of something else we will probably stick with no!  My dad loves bandanas but can&#039;t find a funny and\/or cute one. \n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1872264,"PostDate":1411068510,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Mrsktobe, on 18 September 2014 - 03:57 PM, said:<\/p><div class='blockquote'><div class='quote'><p>I opted to just because my parents are sentimental but it wasn't big by any means. I ordered handkerchiefs from a vendor on etsy and got a personalized message on each one.. One for mom, one for my dad, one for FI mom and one for his dad. They were about 20.00 each. We are paying for things ourselves but I thought it would be a nice touch. To each their own though!<\/p><\/div><\/div>\n<br>\nI asked fianc\u00e9 if he wanted to do this and he said they wouldn't use them <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/sad.png' class='bbc_emoticon' alt=':(' \/>   Unless I can think of something else we will probably stick with no!  My dad loves bandanas but can't find a funny and\/or cute one. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"96.227.239.208","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78048,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2f14e55e82052b3c354445ea81270af2","RawContent":"Probably not. Our gift was basically just paying for their trip. If we do anything else it will probably a small sentimental gift.","Attachments":[],"Id":1872265,"PostDate":1411069160,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Probably not. Our gift was basically just paying for their trip. If we do anything else it will probably a small sentimental gift. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"keishaandjimmy@gmail.com","IpAddress":"192.31.106.34","GroupId":40,"GroupName":"Jr. Member","JoinDate":1409076707,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"puravida2015","Id":279580,"Name":"puravida2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"162.1.213.79","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78048,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cdca32df58f67313d5aed6e66a4c47d8","RawContent":"&lt;p&gt;I have no idea what to get them. They are helping to pay for my wedding, so I feel like I should definitely do something. I dont know whether to get them an \"experience\" which could be there or something thanking them when we get back to the states...or I could do something sentimental or just a nice gift but I have no idea what I would get them- something together or separate, and also I feel maybe we should get my FI parents a little something, they are exerting a lot of effot to pay for his immediate family to be able to come, and also paying for the rehearsal dinner.&lt;\/p&gt;","Attachments":[],"Id":1872267,"PostDate":1411069595,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I have no idea what to get them. They are helping to pay for my wedding, so I feel like I should definitely do something. I dont know whether to get them an \"experience\" which could be there or something thanking them when we get back to the states...or I could do something sentimental or just a nice gift but I have no idea what I would get them- something together or separate, and also I feel maybe we should get my FI parents a little something, they are exerting a lot of effot to pay for his immediate family to be able to come, and also paying for the rehearsal dinner.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nadia.bozanich@gmail.com","IpAddress":"75.112.200.126","GroupId":40,"GroupName":"Jr. Member","JoinDate":1406722272,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"nadiakat17","Id":279229,"Name":"nadiakat17","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"198.89.250.179","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78048,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"8f184265dbb22f406671c36aff28c8e1","RawContent":"&lt;p&gt;I have been thinking about this too. What is the tradition, so to speak? Do I get&amp;nbsp; gift for my own parents, or is it from FI to them and then from me to his parents? Or are all the gifts from both of us? I have seen some cute ideas on Pinterest. Particularly some personalize hankies or keychains, with sentimental messages that I thought were cute. I also thought I would personalize their glasses and get them a little different than the tumblers we are getting everyone else. Like have them say Mother of the Bride, Mother of the Groom, etc.&lt;\/p&gt;","Attachments":[],"Id":1872283,"PostDate":1411075363,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I have been thinking about this too. What is the tradition, so to speak? Do I get\u00a0 gift for my own parents, or is it from FI to them and then from me to his parents? Or are all the gifts from both of us? I have seen some cute ideas on Pinterest. Particularly some personalize hankies or keychains, with sentimental messages that I thought were cute. I also thought I would personalize their glasses and get them a little different than the tumblers we are getting everyone else. Like have them say Mother of the Bride, Mother of the Groom, etc.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"dm@eawifi.com","IpAddress":"198.89.250.179","GroupId":39,"GroupName":"Newbie","JoinDate":1395171111,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"danielleandryan2015","Id":277219,"Name":"danielleandryan2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.65.179.70","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78048,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7fe9b9b3ae51ced6c87a09e8dbc12cf2","RawContent":"@[member=\"danielleandryan2015\"] I like the idea of doing a little different cup, were you thinking just an extra sticker?","Attachments":[],"Id":1872311,"PostDate":1411113306,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"277219\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277219-danielleandryan2015\/' title='Member profile'><span itemprop=\"name\">danielleandryan2015<\/span><\/a> I like the idea of doing a little different cup, were you thinking just an extra sticker?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"morgan.rene1@gmail.com","IpAddress":"66.87.153.227","GroupId":40,"GroupName":"Jr. Member","JoinDate":1410347199,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279766.jpg?_r=1410362818","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"FormattedName":"MorganRene","Id":279766,"Name":"MorganRene","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"198.89.250.179","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78048,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4e128d1e65b6a46c24669dda6441ea49","RawContent":"&lt;p&gt;@[member=\"MorganRene\"] &amp;nbsp;honestly I had not thought that far ahead! I know I saw some tumblers that were like made for that and they said mother of groom, etc. without having to use a sticker. I thought they looked a little nicer. Probably was something I found on Pinterest or Etsy! I&#039;m sure if you google search it lots of ideas will come up.&lt;\/p&gt;","Attachments":[],"Id":1872317,"PostDate":1411118473,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"279766\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/279766-morganrene\/' title='Member profile'><span itemprop=\"name\">MorganRene<\/span><\/a> \u00a0honestly I had not thought that far ahead! I know I saw some tumblers that were like made for that and they said mother of groom, etc. without having to use a sticker. I thought they looked a little nicer. Probably was something I found on Pinterest or Etsy! I'm sure if you google search it lots of ideas will come up.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"dm@eawifi.com","IpAddress":"198.89.250.179","GroupId":39,"GroupName":"Newbie","JoinDate":1395171111,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"danielleandryan2015","Id":277219,"Name":"danielleandryan2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.87.234.180","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78048,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"17eda99ce91202d73c1f91af279b9c87","RawContent":"&lt;p&gt;I&#039;ve seen those. &amp;nbsp;I can&#039;t decide if I want to get them something completely different, or something that looks like what I am getting the group&lt;\/p&gt;","Attachments":[],"Id":1872321,"PostDate":1411119055,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I've seen those. \u00a0I can't decide if I want to get them something completely different, or something that looks like what I am getting the group<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"morgan.rene1@gmail.com","IpAddress":"66.87.153.227","GroupId":40,"GroupName":"Jr. Member","JoinDate":1410347199,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279766.jpg?_r=1410362818","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"FormattedName":"MorganRene","Id":279766,"Name":"MorganRene","IsOnline":false}}],"Id":"78048","Title":"Gifts For Parents","LastPostDate":1432248065},"Pages":{"TotalItems":19,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
