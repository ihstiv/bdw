{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":1231,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":191309,"MovedTo":null,"MovedOn":0,"FirstPostId":570689,"Rating":0,"RatingHits":0,"Starter":{"Id":209491,"Name":"KLC77","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209491.jpg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"StartDate":1232778070,"LastPoster":{"Id":277873,"Name":"calgarybride2015","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":44,"Preview":{"Id":1844332,"PostDate":1397494984,"PostContent":"Things that were a hit: \u00a0 Personal Misty Mate misters Beach bags-everyone used them Hangover kits...","Author":{"Signature":"","Email":"themessanos@gmail.com","IpAddress":"65.51.190.98","GroupId":40,"GroupName":"Jr. Member","JoinDate":1345710871,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-259528.jpg?_r=1387568711","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"KK2013","Id":259528,"Name":"KK2013","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"65.51.190.98","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":29980,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"c0204272f264176a3bc8a0a840e0d870","RawContent":"&lt;p&gt;Things that were a hit:&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Personal Misty Mate misters&lt;\/p&gt;\n&lt;p&gt;Beach bags-everyone used them&lt;\/p&gt;\n&lt;p&gt;Hangover kits&lt;\/p&gt;\n&lt;p&gt;informational booklets (we made a brochure on Vistaprint with all of the events mapped on the hotel map)&lt;\/p&gt;\n&lt;p&gt;Hair ties&lt;\/p&gt;\n&lt;p&gt;shower poof&lt;\/p&gt;\n&lt;p&gt;gatorade singles&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Weren&#039;t used:&lt;\/p&gt;\n&lt;p&gt;Self addressed and stamped postcards with a request to send your favorite memory (this was a sad one...was hoping to get them all back and make a book...only got 5 back).&amp;nbsp; Glad I didn&#039;t sub this as the guest book as I originally intended!&lt;\/p&gt;\n&lt;p&gt;Key card holders&lt;\/p&gt;\n&lt;p&gt;Cups for drinks (the hotel cups were large enough)&lt;\/p&gt;","Attachments":[],"Id":1844332,"PostDate":1397494984,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Things that were a hit:<\/p>\n<p>\u00a0<\/p>\n<p>Personal Misty Mate misters<\/p>\n<p>Beach bags-everyone used them<\/p>\n<p>Hangover kits<\/p>\n<p>informational booklets (we made a brochure on Vistaprint with all of the events mapped on the hotel map)<\/p>\n<p>Hair ties<\/p>\n<p>shower poof<\/p>\n<p>gatorade singles<\/p>\n<p>\u00a0<\/p>\n<p>Weren't used:<\/p>\n<p>Self addressed and stamped postcards with a request to send your favorite memory (this was a sad one...was hoping to get them all back and make a book...only got 5 back).\u00a0 Glad I didn't sub this as the guest book as I originally intended!<\/p>\n<p>Key card holders<\/p>\n<p>Cups for drinks (the hotel cups were large enough)<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"themessanos@gmail.com","IpAddress":"65.51.190.98","GroupId":40,"GroupName":"Jr. Member","JoinDate":1345710871,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-259528.jpg?_r=1387568711","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"KK2013","Id":259528,"Name":"KK2013","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"159.251.7.4","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":29980,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"28c992f9e8a23059139c59df120d63a3","RawContent":"&lt;p&gt;Do most brides carry-on their OOT bags and goodies?&lt;\/p&gt;","Attachments":[],"Id":1844492,"PostDate":1397575090,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Do most brides carry-on their OOT bags and goodies?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-size:14px;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><strong><span style=\"color:#ff6666;\">I love him & he loves me, we'll be married by the sea.<\/span><\/strong><\/span><\/span><br>\n\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77696-our-dw-dreams-riviera-cancun-17-apr-2015\/'>Planning\u00a0Journal<\/a>\u00a0& <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/blog\/86-my-destination-wedding-blog\/'>Blog<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/delsolphotography.com\/beach-wedding-dreams-riviera-cancun-tj\/'>My wedding pictures from Del Sol Photography<\/a><\/p>\n<p>\u00a0","Email":"tricia.d.davis@gmail.com","IpAddress":"97.91.185.236","GroupId":3,"GroupName":"Member","JoinDate":1396266119,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277418.jpg?_r=1429976005","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"pddcmc","Id":277418,"Name":"pddcmc","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"205.132.110.2","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":29980,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6eb3d94c4a602a22a3bd2777cea0cd8d","RawContent":"&lt;p&gt;@[member=\"jkkc\"]&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am planning to take my stuff myself... My resort does NOT allow for me to ship prior to arrival so that helped make that decision!! You may want to email you WC at your resort or call directly and ask their policy on this!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;:)&lt;\/p&gt;\n\n&lt;p&gt;@[member=\"pddcmc\"]&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am checking these items... I will have my dress to carry on, so I am not going to worry about the OOT bag contents... it would be far too much for carry on regulations for me anyhow! :)&lt;\/p&gt;","Attachments":[],"Id":1844520,"PostDate":1397579600,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"277591\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277591-jkkc\/' title='Member profile'><span itemprop=\"name\">jkkc<\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>I am planning to take my stuff myself... My resort does NOT allow for me to ship prior to arrival so that helped make that decision!! You may want to email you WC at your resort or call directly and ask their policy on this!!<\/p>\n<p>\u00a0<\/p>\n<p><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<br \/><p>@<a hovercard-ref=\"member\" hovercard-id=\"277418\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277418-pddcmc\/' title='Member profile'><span itemprop=\"name\">pddcmc<\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>I am checking these items... I will have my dress to carry on, so I am not going to worry about the OOT bag contents... it would be far too much for carry on regulations for me anyhow! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bambiderby@gmail.com","IpAddress":"205.132.110.2","GroupId":40,"GroupName":"Jr. Member","JoinDate":1395161860,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277216.jpg?_r=1395766815","PhotoWidth":200,"PhotoHeight":218,"PhotoType":"custom"},"FormattedName":"forevertogether","Id":277216,"Name":"forevertogether","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"97.91.185.236","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":29980,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"2ea3097a3a5918a8e3fff3cf23b216b4","RawContent":"&lt;p&gt;@[member=\"forevertogether\"] - That&#039;s such a great point about carrying on the dress! That kind of slipped my mind, maybe because I don&#039;t have my dress yet. Thanks for the suggestion&lt;\/p&gt;","Attachments":[],"Id":1844545,"PostDate":1397593234,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"277216\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277216-forevertogether\/' title='Member profile'><span itemprop=\"name\">forevertogether<\/span><\/a> - That's such a great point about carrying on the dress! That kind of slipped my mind, maybe because I don't have my dress yet. Thanks for the suggestion<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-size:14px;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><strong><span style=\"color:#ff6666;\">I love him & he loves me, we'll be married by the sea.<\/span><\/strong><\/span><\/span><br>\n\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77696-our-dw-dreams-riviera-cancun-17-apr-2015\/'>Planning\u00a0Journal<\/a>\u00a0& <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/blog\/86-my-destination-wedding-blog\/'>Blog<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/delsolphotography.com\/beach-wedding-dreams-riviera-cancun-tj\/'>My wedding pictures from Del Sol Photography<\/a><\/p>\n<p>\u00a0","Email":"tricia.d.davis@gmail.com","IpAddress":"97.91.185.236","GroupId":3,"GroupName":"Member","JoinDate":1396266119,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277418.jpg?_r=1429976005","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"pddcmc","Id":277418,"Name":"pddcmc","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"205.132.110.2","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":29980,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"56a2c3b8548fabedf55a852a7bef18b3","RawContent":"&lt;p&gt;@[member=\"pddcmc\"]&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;No problem!!! I def don&#039;t want my dress put under that plane!!!! It&#039;s going to be with me along with the grooms suit!!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Basically I am carrying on everything we will be wearing on the wedding day and my swim suits!! I figured if all my other clothes get lost, I&#039;ll be fine with these items!!!LOL &amp;nbsp;:)&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1844625,"PostDate":1397639884,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"277418\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277418-pddcmc\/' title='Member profile'><span itemprop=\"name\">pddcmc<\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>No problem!!! I def don't want my dress put under that plane!!!! It's going to be with me along with the grooms suit!!!<\/p>\n<p>\u00a0<\/p>\n<p>Basically I am carrying on everything we will be wearing on the wedding day and my swim suits!! I figured if all my other clothes get lost, I'll be fine with these items!!!LOL \u00a0<img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bambiderby@gmail.com","IpAddress":"205.132.110.2","GroupId":40,"GroupName":"Jr. Member","JoinDate":1395161860,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277216.jpg?_r=1395766815","PhotoWidth":200,"PhotoHeight":218,"PhotoType":"custom"},"FormattedName":"forevertogether","Id":277216,"Name":"forevertogether","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"199.19.250.7","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":29980,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"363608ac537d559bd834ee060167ba3e","RawContent":"&lt;p&gt;Thanks for all of the great suggestions! I have been trying to figure out whether or not to carry on my dress as well as what to put in my OOT bags!&lt;\/p&gt;","Attachments":[],"Id":1844663,"PostDate":1397647541,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thanks for all of the great suggestions! I have been trying to figure out whether or not to carry on my dress as well as what to put in my OOT bags!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lijohn66@gmail.com","IpAddress":"199.19.250.19","GroupId":39,"GroupName":"Newbie","JoinDate":1395397397,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"soontobeONE","Id":277271,"Name":"soontobeONE","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"199.19.250.7","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":29980,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"9af52876ac6852d76efdccd743b75c20","RawContent":"&lt;p&gt;Thanks for the helpful information ladies! I feel like I&#039;m going way overboard with the items for my OOT bags! Good thing I have a small wedding party!&lt;\/p&gt;\n\n&lt;p&gt;Does anyone have the template for the Wedding First Aid Kit and the Wedding Survival Kit Labels? If so, please email to me at &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;mailto:Lijohn66@[member=\"gmail\"].com&#039;&gt;Lijohn66@[member=\"gmail\"].com&lt;\/a&gt;.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thanks!&lt;\/p&gt;\n\n&lt;p&gt;Thanks for the great advice! It&#039;s good to know which items were the biggest hits.&lt;\/p&gt;\n\n&lt;p&gt;Thanks for the information about ebates!&lt;\/p&gt;","Attachments":[],"Id":1844700,"PostDate":1397655694,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thanks for the helpful information ladies! I feel like I'm going way overboard with the items for my OOT bags! Good thing I have a small wedding party!<\/p>\n<br \/><p>Does anyone have the template for the Wedding First Aid Kit and the Wedding Survival Kit Labels? If so, please email to me at <a href='mailto:Lijohn66@<a hovercard-ref=' class='bbc_url' title='External link' rel='nofollow external'><span itemprop=\"name\">gmail<\/span><\/a>.com'>Lijohn66@<a hovercard-ref=\"member\" hovercard-id=\"219734\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/219734-gmail\/' title='Member profile'><span itemprop=\"name\">gmail<\/span><\/a>.com<\/a>.<\/p>\n<p>\u00a0<\/p>\n<p>Thanks!<\/p>\n<br \/><p>Thanks for the great advice! It's good to know which items were the biggest hits.<\/p>\n<br \/><p>Thanks for the information about ebates!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lijohn66@gmail.com","IpAddress":"199.19.250.19","GroupId":39,"GroupName":"Newbie","JoinDate":1395397397,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"soontobeONE","Id":277271,"Name":"soontobeONE","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.87.82.35","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":29980,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e932908307779f318cd451164f831eb0","RawContent":"This is a great thread! Took like 4 hrs to read through but glad I did. I like the pashminas for the bridesmaids MotB and MotG idea. We will be in Jamaica in November so not sure how chilly it gets. Def want to get flip flops too. Maybe get the flip flops for just bridesmaids since I don&#039;t want people getting the wrong sizes.","Attachments":[],"Id":1844709,"PostDate":1397656636,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                This is a great thread! Took like 4 hrs to read through but glad I did. I like the pashminas for the bridesmaids MotB and MotG idea. We will be in Jamaica in November so not sure how chilly it gets. Def want to get flip flops too. Maybe get the flip flops for just bridesmaids since I don't want people getting the wrong sizes.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"dana.bonuomo@gmail.com","IpAddress":"66.87.81.59","GroupId":39,"GroupName":"Newbie","JoinDate":1392042477,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276608.jpg?_r=1399217554","PhotoWidth":64,"PhotoHeight":148,"PhotoType":"custom"},"FormattedName":"MontegoBayBridePA","Id":276608,"Name":"MontegoBayBridePA","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.17.169.5","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":29980,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":3,"IsLiked":false,"PostKey":"0d53f856ed8d7e9479d2d1cdb4dc4370","RawContent":"&lt;p&gt;What a helpful thread!! Initially I wasn&#039;t planning on putting travel mugs in my OOT bags but after reading through all these posts I&#039;ve decided it&#039;s a necessity at an all-inclusive resort!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Here&#039;s what I have so far-&lt;\/p&gt;\n&lt;p&gt;-Jute travel bags that I designed to say Cabo San Lucas with a picture and our date from discountmugs.com - I didn&#039;t personalize them too much because I&#039;m hoping my guests will use them again&lt;\/p&gt;\n&lt;p&gt;-personalized wedding koozies from totallyweddingkoozie.com&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;-mini flipflop notebooks and palm tree pens from oriental trading&lt;\/p&gt;\n&lt;p&gt;-flipflop cellophane bags that I&#039;m going to attach a note to that says \"Oh Shit! Kit\" which will contain: &amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;advil, sunscreen, aloe, tums, tissue, shout wipes, bandaids and SPF chapstick&lt;\/p&gt;\n&lt;p&gt;-Welcome letter&lt;\/p&gt;\n&lt;p&gt;-Itinerary&lt;\/p&gt;\n&lt;p&gt;-Map of &amp;nbsp;Cabo&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;ll be adding&lt;\/p&gt;\n&lt;p&gt;-the free mini language translation book that was earlier noted in a post-What a great find!&lt;\/p&gt;\n&lt;p&gt;-Meet the Guests list&lt;\/p&gt;","Attachments":[],"Id":1845224,"PostDate":1397920968,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>What a helpful thread!! Initially I wasn't planning on putting travel mugs in my OOT bags but after reading through all these posts I've decided it's a necessity at an all-inclusive resort!<\/p>\n<p>\u00a0<\/p>\n<p>Here's what I have so far-<\/p>\n<p>-Jute travel bags that I designed to say Cabo San Lucas with a picture and our date from discountmugs.com - I didn't personalize them too much because I'm hoping my guests will use them again<\/p>\n<p>-personalized wedding koozies from totallyweddingkoozie.com\u00a0<\/p>\n<p>-mini flipflop notebooks and palm tree pens from oriental trading<\/p>\n<p>-flipflop cellophane bags that I'm going to attach a note to that says \"Oh Shit! Kit\" which will contain: \u00a0<\/p>\n<p>advil, sunscreen, aloe, tums, tissue, shout wipes, bandaids and SPF chapstick<\/p>\n<p>-Welcome letter<\/p>\n<p>-Itinerary<\/p>\n<p>-Map of \u00a0Cabo<\/p>\n<p>\u00a0<\/p>\n<p>I'll be adding<\/p>\n<p>-the free mini language translation book that was earlier noted in a post-What a great find!<\/p>\n<p>-Meet the Guests list<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ahellevang@gmail.com","IpAddress":"174.17.169.5","GroupId":39,"GroupName":"Newbie","JoinDate":1397919537,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277652.jpeg?_r=1397934146","PhotoWidth":166,"PhotoHeight":166,"PhotoType":"custom"},"FormattedName":"ashleyrose5","Id":277652,"Name":"ashleyrose5","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.128.224.8","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":29980,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"01612a0cb4683db15d5bb87484d71af4","RawContent":"@[member=\"sarafish81\"]\n\n\nThanks for the reminder about the Avon products.","Attachments":[],"Id":1845473,"PostDate":1398117231,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"212442\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/212442-sarafish81\/' title='Member profile'><span itemprop=\"name\">sarafish81<\/span><\/a><br><br>\nThanks for the reminder about the Avon products.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"flemonsc@yahoo.com","IpAddress":"108.128.192.217","GroupId":40,"GroupName":"Jr. Member","JoinDate":1394820202,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"ChristienEarnest","Id":277145,"Name":"ChristienEarnest","IsOnline":false}}],"Id":"29980","Title":"My OOT Bags~ the big hits and the things that weren't used","LastPostDate":1432594380},"Pages":{"TotalItems":1231,"TotalPages":124,"CurrentPage":1090,"NextPage":1100,"PreviousPage":1080,"LastPage":1230},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
