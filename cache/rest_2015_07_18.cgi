{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":4,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":454,"MovedTo":null,"MovedOn":0,"FirstPostId":1898041,"Rating":0,"RatingHits":0,"Starter":{"Id":281404,"Name":"Karryl","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281404.jpg?_r=1437212587","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"StartDate":1433670594,"LastPoster":{"Id":281404,"Name":"Karryl","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281404.jpg?_r=1437212587","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":44,"Preview":{"Id":1898041,"PostDate":1433670594,"PostContent":"I really wanted to do a welcome bag for my guest list of 18 that's going to Jamaica and a Oh Sh%t...","Author":{"Signature":"","Email":"karryl_tolle1@eku.edu","IpAddress":"50.166.74.181","GroupId":39,"GroupName":"Newbie","JoinDate":1418482887,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281404.jpg?_r=1437212587","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"Karryl","Id":281404,"Name":"Karryl","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.166.74.181","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79254,"EditedBy":"<strong>Edited by Karryl, 07 June 2015 - 09:56 AM.<\/strong>","EditDate":1433670992,"EditReason":"","DeleteDate":0,"TotalLikes":4,"IsLiked":false,"PostKey":"c165ca9a7ad1ea90986ac84f9ce5bfd4","RawContent":"I really wanted to do a welcome bag for my guest list of 18 that&#039;s going to Jamaica and a Oh Sh%t kit. However bags are costly then I feel like u need enough items to fill the bags. Which will include items they don&#039;t really need and wasted space in my luggage. I also live 15 hours from my family so I can&#039;t get others to carrier them or hand them out earlier. \n\n\nSo next best thing is to do miniature canvas bags and use iron-ons to complete the look. They turned out great!!! No bag will have the same contents. Everyone will get the \"airline ticket\" of the weeks plans, q-tips, hand sanitizer, band-aids, floss, wedding party koozie. I found some cheap baggies that self sealed to put everything in. Then others will also get a flask, and joke gifts that the person who receives will understand. Like a PT test, condoms and so on. Each item will have a sticker with a funny note to them. \n\n\n\n\nThat&#039;s what the bags look like as u can tell they are not that big. Perfect for an Oh Sh%t kit. \n\n\n\nThat&#039;s what the bagged items look like. One thing I like about them is the fact that they are not zip lock bags. And here are what the stickers will look like. I haven&#039;t picked up the sticker paper yet so it&#039;s printed on normal paper.\n","Attachments":[],"Id":1898041,"PostDate":1433670594,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I really wanted to do a welcome bag for my guest list of 18 that's going to Jamaica and a Oh Sh%t kit. However bags are costly then I feel like u need enough items to fill the bags. Which will include items they don't really need and wasted space in my luggage. I also live 15 hours from my family so I can't get others to carrier them or hand them out earlier. <br><br>\nSo next best thing is to do miniature canvas bags and use iron-ons to complete the look. They turned out great!!! No bag will have the same contents. Everyone will get the \"airline ticket\" of the weeks plans, q-tips, hand sanitizer, band-aids, floss, wedding party koozie. I found some cheap baggies that self sealed to put everything in. Then others will also get a flask, and joke gifts that the person who receives will understand. Like a PT test, condoms and so on. Each item will have a sticker with a funny note to them. <br><br>\n<a class='resized_img' rel='lightbox[1898041]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_06_2015\/post-281404-0-61763300-1433684766.jpg\" title=\"image.jpg - Size: 112.42KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_06_2015\/post-281404-0-61763300-1433684766.jpg\" class='bbc_img linked-image' alt=\"image.jpg\" \/><\/a>\n\n<br>\nThat's what the bags look like as u can tell they are not that big. Perfect for an Oh Sh%t kit. <br>\n<a class='resized_img' rel='lightbox[1898041]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_06_2015\/post-281404-0-79126700-1433684818.jpg\" title=\"image.jpg - Size: 89.02KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_06_2015\/post-281404-0-79126700-1433684818.jpg\" class='bbc_img linked-image' alt=\"image.jpg\" \/><\/a>\n\n<br>\nThat's what the bagged items look like. One thing I like about them is the fact that they are not zip lock bags. And here are what the stickers will look like. I haven't picked up the sticker paper yet so it's printed on normal paper.<br>\n<a class='resized_img' rel='lightbox[1898041]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_06_2015\/post-281404-0-47598600-1433684834.jpg\" title=\"image.jpg - Size: 133.08KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_06_2015\/post-281404-0-47598600-1433684834.jpg\" class='bbc_img linked-image' alt=\"image.jpg\" \/><\/a>\n\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"karryl_tolle1@eku.edu","IpAddress":"50.166.74.181","GroupId":39,"GroupName":"Newbie","JoinDate":1418482887,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281404.jpg?_r=1437212587","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"Karryl","Id":281404,"Name":"Karryl","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"142.56.86.35","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"55ca6b21eb1ca0a97376313cd5268157","RawContent":"&lt;p&gt;@[member=\"Karryl\"]&lt;\/p&gt;\n&lt;p&gt;Those look amazing! And what a great idea to customize each one for all of your guests! Very cute! I&#039;m only making them for our wedding party thank goodness. But even that felt like a lot of work,&amp;nbsp;I can&#039;t imagine how much work personalizing them is! Good for you.&lt;\/p&gt;","Attachments":[],"Id":1898482,"PostDate":1434129960,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"281404\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281404-karryl\/' title='Member profile'><span itemprop=\"name\">Karryl<\/span><\/a><\/p>\n<p>Those look amazing! And what a great idea to customize each one for all of your guests! Very cute! I'm only making them for our wedding party thank goodness. But even that felt like a lot of work,\u00a0I can't imagine how much work personalizing them is! Good for you.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>~*~YYCBRIDE2016~*~<\/p><p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79227-yycbride2016-grand-sirenis-planning-thread-february-2016\/'>My planning thread\u00a0<\/a><\/p><p>\u00a0<\/p><p><a class='bbc_url' href='http:\/\/www.TickerFactory.com\/'><br><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10730;484\/st\/20160223\/e\/Our+Wedding\/dt\/-1\/k\/4bd8\/event.png\" alt=\"event.png\"><br><\/a><br>\u00a0","Email":"janellepaquin@hotmail.com","IpAddress":"162.157.216.37","GroupId":40,"GroupName":"Jr. Member","JoinDate":1432086904,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283167.jpg?_r=1432133572","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"yycbride2016","Id":283167,"Name":"yycbride2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.15.187","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"60b7f219054d878b3a5f231cbae0b32f","RawContent":"&lt;p&gt;I like those! What a cute size! And really, just big enough for putting a few important things into!&lt;\/p&gt;","Attachments":[],"Id":1898562,"PostDate":1434314441,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I like those! What a cute size! And really, just big enough for putting a few important things into!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"107.77.70.87","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"e4d24ba0827134560098b20e88b27d07","RawContent":"Thank you ladies. I think they really turned out nice. Plus everyone likes miniature items right lol.","Attachments":[],"Id":1898589,"PostDate":1434359994,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thank you ladies. I think they really turned out nice. Plus everyone likes miniature items right lol. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"karryl_tolle1@eku.edu","IpAddress":"50.166.74.181","GroupId":39,"GroupName":"Newbie","JoinDate":1418482887,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281404.jpg?_r=1437212587","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"Karryl","Id":281404,"Name":"Karryl","IsOnline":false}}],"Id":"79254","Title":"Mini Oot Canvas Bags","LastPostDate":1434359994},"Pages":{"TotalItems":4,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
