{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":2,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":66,"MovedTo":null,"MovedOn":0,"FirstPostId":1900595,"Rating":0,"RatingHits":0,"Starter":{"Id":283914,"Name":"Kaitlyncrossley","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283914.jpg?_r=1437234970","PhotoWidth":188,"PhotoHeight":300,"PhotoType":"facebook"},"IsOnline":false},"StartDate":1437065881,"LastPoster":{"Id":283472,"Name":"jenrogers","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1900595,"PostDate":1437065881,"PostContent":"We have been planning to have our Spring 2016 wedding at Akiin Beach but I'm finding myself overw...","Author":{"Signature":"","Email":"kaitlyncrossley@yahoo.com","IpAddress":"24.210.150.55","GroupId":39,"GroupName":"Newbie","JoinDate":1436600648,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283914.jpg?_r=1437234970","PhotoWidth":188,"PhotoHeight":300,"PhotoType":"facebook"},"FormattedName":"Kaitlyncrossley","Id":283914,"Name":"Kaitlyncrossley","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.210.150.55","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79402,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b234baac4e23bcb56384575aa558f2ff","RawContent":"&lt;p&gt;We have been planning to have our Spring 2016 wedding at Akiin Beach but I&#039;m finding myself overwhelmed with many things. I wanted to stay away from a \"resort\" wedding and wanted the more private intimate options that Akiin would be able to give us. Now with all the overwhelming details and trying to figure out accommodations for our guests we are reconsidering all inclusive resort options. We are looking into Iberostar Paraiso Lindo but based off their \"wedding packages\" I don&#039;t see any anything for a reception or different decor options\/choices. If anyone has any info from personal experiences I would love to hear!&lt;\/p&gt;","Attachments":[],"Id":1900595,"PostDate":1437065881,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>We have been planning to have our Spring 2016 wedding at Akiin Beach but I'm finding myself overwhelmed with many things. I wanted to stay away from a \"resort\" wedding and wanted the more private intimate options that Akiin would be able to give us. Now with all the overwhelming details and trying to figure out accommodations for our guests we are reconsidering all inclusive resort options. We are looking into Iberostar Paraiso Lindo but based off their \"wedding packages\" I don't see any anything for a reception or different decor options\/choices. If anyone has any info from personal experiences I would love to hear!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kaitlyncrossley@yahoo.com","IpAddress":"24.210.150.55","GroupId":39,"GroupName":"Newbie","JoinDate":1436600648,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283914.jpg?_r=1437234970","PhotoWidth":188,"PhotoHeight":300,"PhotoType":"facebook"},"FormattedName":"Kaitlyncrossley","Id":283914,"Name":"Kaitlyncrossley","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.230.250.195","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79402,"EditedBy":"<strong>Edited by jenrogers, Today, 09:26 AM.<\/strong>","EditDate":1437211564,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"737a1743e0109cea41ab19341647e74c","RawContent":"Hi Kaitlyn-\n\nCONGRATULATIONS !!!\n\nI am a travel agent and I work on groups for destination weddings.  We have programs with wedding coordinators that can plan intimate weddings and not just a typical resort package, if that&#039;s what your interested in.  I would be happy to help you with resort options, then our wedding coordinators will help you plan the wedding you&#039;ve dreamed of, and I would coordinate all the travel and reservations for you guests (there are not additional fees for my services).  If you are interested in seeing if I could help you and reduce your stress, please send me your contact info (phone and email address) and the best time to contact you .  You can email me at Jen.Rogers@cruiseplanners.com. \n\n\n\nThanks and best of luck!\n\nJen Rogers\n\nwww.cruisingtovacation.com\n\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1900695,"PostDate":1437211406,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi Kaitlyn-<br>\nCONGRATULATIONS !!!<br>\nI am a travel agent and I work on groups for destination weddings.  We have programs with wedding coordinators that can plan intimate weddings and not just a typical resort package, if that's what your interested in.  I would be happy to help you with resort options, then our wedding coordinators will help you plan the wedding you've dreamed of, and I would coordinate all the travel and reservations for you guests (there are not additional fees for my services).  If you are interested in seeing if I could help you and reduce your stress, please send me your contact info (phone and email address) and the best time to contact you .  You can email me at Jen.Rogers@cruiseplanners.com. <br><br><br>\nThanks and best of luck!<br>\nJen Rogers<br>\nwww.cruisingtovacation.com<br><br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jenrogerstravel@yahoo.com","IpAddress":"45.46.212.222","GroupId":3,"GroupName":"Member","JoinDate":1433919245,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"jenrogers","Id":283472,"Name":"jenrogers","IsOnline":false}}],"Id":"79402","Title":"Newbie Akiin Vs Iberostar Paraiso Lindo","LastPostDate":1437211406},"Pages":{"TotalItems":2,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
