{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":18,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":1724,"MovedTo":null,"MovedOn":0,"FirstPostId":1886539,"Rating":0,"RatingHits":0,"Starter":{"Id":282047,"Name":"dathotgal","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282047.jpg?_r=1436938666","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"StartDate":1424141844,"LastPoster":{"Id":279353,"Name":"JamaicaNicole","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1886539,"PostDate":1424141844,"PostContent":"im planning a wedding in jamaica for 60 persons is it realistic to have a wedding budget of 10k....","Author":{"Signature":"","Email":"dathotgal51@yahoo.com","IpAddress":"173.77.182.126","GroupId":39,"GroupName":"Newbie","JoinDate":1423457925,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282047.jpg?_r=1436938666","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"dathotgal","Id":282047,"Name":"dathotgal","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"151.202.19.97","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78802,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c03988ea7be5251ef6f1792f7bb0a10a","RawContent":"&lt;p&gt;im planning a wedding in jamaica for 60 persons&lt;\/p&gt;\n&lt;p&gt;is it realistic to have a wedding budget of 10k.&lt;\/p&gt;\n&lt;p&gt;i feel like im quoted more just for being an american from vendors.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1886539,"PostDate":1424141844,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>im planning a wedding in jamaica for 60 persons<\/p>\n<p>is it realistic to have a wedding budget of 10k.<\/p>\n<p>i feel like im quoted more just for being an american from vendors.<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"dathotgal51@yahoo.com","IpAddress":"173.77.182.126","GroupId":39,"GroupName":"Newbie","JoinDate":1423457925,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282047.jpg?_r=1436938666","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"dathotgal","Id":282047,"Name":"dathotgal","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"64.32.119.158","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78802,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c02a6d99ca1ddce2662a5e441d9d697a","RawContent":"&lt;p&gt;Welcome to the forum, and Congrats on your upcoming Jamaican destination wedding, dathotgal !!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;You&#039;ve come to the right place for lots of great resources to assist with your wedding plans, so well done on a great start already :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Here are some magical wedding \"moments that matter\" to inspire you further.....enjoy :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord.xx.fbcdn.net\/hphotos-xfa1\/v\/t1.0-9\/p417x417\/10354809_10152664882419487_1728880669268284102_n.jpg?oh=a809c9a69021efcf7e3e3f9c46c22168&amp;amp;oe=55929B32\" alt=\"10354809_10152664882419487_1728880669268\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/fbcdn-sphotos-e-a.akamaihd.net\/hphotos-ak-xap1\/v\/t1.0-9\/p417x417\/10302257_10152554171919487_661902947592730776_n.jpg?oh=a9e0e30503a08c90bec074186b8b0739&amp;amp;oe=558A5BBA&amp;amp;__gda__=1435528834_589a53f3324d9da87e88ce381bd542df\" alt=\"10302257_10152554171919487_6619029475927\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/fbcdn-sphotos-f-a.akamaihd.net\/hphotos-ak-xfp1\/v\/t1.0-9\/p417x417\/1454681_10153038436459487_8294167073024966098_n.jpg?oh=b28964f95e3470f04269822b2ba6434d&amp;amp;oe=5593CD8F&amp;amp;__gda__=1431570526_46df225de28afa454468cd8c905db676\" alt=\"1454681_10153038436459487_82941670730249\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Wishing you all the best with your plans - cheers!!! team MTM :)&lt;\/p&gt;","Attachments":[],"Id":1886580,"PostDate":1424174184,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome to the forum, and Congrats on your upcoming Jamaican destination wedding, dathotgal !!!<\/p>\n<p>\u00a0<\/p>\n<p>You've come to the right place for lots of great resources to assist with your wedding plans, so well done on a great start already <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Here are some magical wedding \"moments that matter\" to inspire you further.....enjoy <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord.xx.fbcdn.net\/hphotos-xfa1\/v\/t1.0-9\/p417x417\/10354809_10152664882419487_1728880669268284102_n.jpg?oh=a809c9a69021efcf7e3e3f9c46c22168&oe=55929B32\" alt=\"10354809_10152664882419487_1728880669268\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/fbcdn-sphotos-e-a.akamaihd.net\/hphotos-ak-xap1\/v\/t1.0-9\/p417x417\/10302257_10152554171919487_661902947592730776_n.jpg?oh=a9e0e30503a08c90bec074186b8b0739&oe=558A5BBA&__gda__=1435528834_589a53f3324d9da87e88ce381bd542df\" alt=\"10302257_10152554171919487_6619029475927\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/fbcdn-sphotos-f-a.akamaihd.net\/hphotos-ak-xfp1\/v\/t1.0-9\/p417x417\/1454681_10153038436459487_8294167073024966098_n.jpg?oh=b28964f95e3470f04269822b2ba6434d&oe=5593CD8F&__gda__=1431570526_46df225de28afa454468cd8c905db676\" alt=\"1454681_10153038436459487_82941670730249\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>Wishing you all the best with your plans - cheers!!! team MTM <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280196260,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"159.53.110.141","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78802,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b28e9555059a2ffa0a6ee5961a8df038","RawContent":"&lt;p&gt;Hi! We&#039;re getting married at Iberostar Rose Hall Suites and will be around 75 guests - our budget including EVERYTHING (dress, travel, rings, photography, etc.) is like $18k and I wouldn&#039;t say we are skimping on things, so I think $10k is do-able depending on how fancy your tastes are! We are actually paying for 2 people to stay too.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I know Iberostar has a ton of flexible options for the wedding itself. Doing a private tent on the beach is most expensive because of the rentals, but a lot of brides just do a semi-private dinner (which they say is really quite private) and then rent out the disco for like $800 including the DJ and drinks. Or do a bonfire on the beach after dinner. We&#039;re renting one of the a la carte restaurants for a private reception, which ends up somewhere in the middle cost-wise.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck! Just pay close attention to the \"add-on\" costs when deciding on a resort. Some seem like a total steal but then they charge you crazy amounts for every single tiny thing! Also inquire about group booking incentives. For example, we get every 21st person&#039;s stay rebated back to us.&lt;\/p&gt;","Attachments":[],"Id":1886786,"PostDate":1424303920,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi! We're getting married at Iberostar Rose Hall Suites and will be around 75 guests - our budget including EVERYTHING (dress, travel, rings, photography, etc.) is like $18k and I wouldn't say we are skimping on things, so I think $10k is do-able depending on how fancy your tastes are! We are actually paying for 2 people to stay too.<\/p>\n<p>\u00a0<\/p>\n<p>I know Iberostar has a ton of flexible options for the wedding itself. Doing a private tent on the beach is most expensive because of the rentals, but a lot of brides just do a semi-private dinner (which they say is really quite private) and then rent out the disco for like $800 including the DJ and drinks. Or do a bonfire on the beach after dinner. We're renting one of the a la carte restaurants for a private reception, which ends up somewhere in the middle cost-wise.<\/p>\n<p>\u00a0<\/p>\n<p>Good luck! Just pay close attention to the \"add-on\" costs when deciding on a resort. Some seem like a total steal but then they charge you crazy amounts for every single tiny thing! Also inquire about group booking incentives. For example, we get every 21st person's stay rebated back to us.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rebecca.shaffer@gmail.com","IpAddress":"159.53.174.144","GroupId":40,"GroupName":"Jr. Member","JoinDate":1403101687,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"beckys98","Id":278581,"Name":"beckys98","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.100.61.37","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78802,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1d10180b20ecddff0c07af8cf136b715","RawContent":"&lt;p&gt;Though I&#039;ve never been to Jamaica, I do think your budget is doable. It really just depends on what type of wedding you&#039;re planning on having -- on a resort, at an all-inclusive, on a private estate, etc.? I know a lot of the resorts\/all-inclusives offer wedding packages so you they&#039;ll supply you with vendor options and those prices are set. If you haven&#039;t already, I would suggest reaching out to the BDW travel agents as they can not only help you with picking the perfect place to stay, they can also be great sources for finding out approx. how much weddings costs at the different locations!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"color:rgb(24,24,24);font-family:arial, helvetica, sans-serif;background-color:rgb(253,252,250);\"&gt;If you want to get some ideas of pricing, you might want to try one of the&amp;nbsp;&lt;\/span&gt;&lt;a  class=\"bbc_url\" href=\"http:\/\/www.wrighttravelagency.com\/leads\/inquiry\/\" title=\"External link\"&gt;BDW Travel Agents.&lt;\/a&gt;&lt;span style=\"color:rgb(24,24,24);font-family:arial, helvetica, sans-serif;background-color:rgb(253,252,250);\"&gt;  They Specialize in Destination weddings. You can&amp;nbsp;&lt;\/span&gt;&lt;a  class=\"bbc_url\" href=\"http:\/\/www.wrighttravelagency.com\/leads\/inquiry\/\" title=\"External link\"&gt;contact them HERE!&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Hope that helps!!&amp;nbsp; ;)&lt;\/p&gt;","Attachments":[],"Id":1886943,"PostDate":1424415194,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Though I've never been to Jamaica, I do think your budget is doable. It really just depends on what type of wedding you're planning on having -- on a resort, at an all-inclusive, on a private estate, etc.? I know a lot of the resorts\/all-inclusives offer wedding packages so you they'll supply you with vendor options and those prices are set. If you haven't already, I would suggest reaching out to the BDW travel agents as they can not only help you with picking the perfect place to stay, they can also be great sources for finding out approx. how much weddings costs at the different locations!<\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"color:rgb(24,24,24);font-family:arial, helvetica, sans-serif;background-color:rgb(253,252,250)\">If you want to get some ideas of pricing, you might want to try one of the\u00a0<\/span><a href='http:\/\/www.wrighttravelagency.com\/leads\/inquiry\/' class='bbc_url' title='External link' rel='nofollow external'>BDW Travel Agents.<\/a><span  style=\"color:rgb(24,24,24);font-family:arial, helvetica, sans-serif;background-color:rgb(253,252,250)\">\u00a0\u00a0They Specialize in Destination weddings. You can\u00a0<\/span><a href='http:\/\/www.wrighttravelagency.com\/leads\/inquiry\/' class='bbc_url' title='External link' rel='nofollow external'>contact them HERE!<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Hope that helps!!\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<span style='font-size: 18px;'><span style='font-family: georgia'><strong class='bbc'>MARIESAM SANCHEZ PHOTOGRAPHY<\/strong><\/span><\/span><br \/>\nWEBSITE: <a class='bbc_url' href='http:\/\/www.mariesamsanchez.com'>www.mariesamsanchez.com<\/a><br \/>\nBLOG: <a class='bbc_url' href='http:\/\/www.mariesamsanchezblog.com'>www.mariesamsanchezblog.com<\/a><br \/>\nCONTACT: <a href='mailto:mariesam.sanchez@gmail.com?subject=BDW%20Inquiry' title='E-mail Link' class='bbc_email'>mariesam.sanchez@gmail.com<\/a><br \/>\n<br \/>\n<img src='http:\/\/i287.photobucket.com\/albums\/ll150\/msam007562\/063cb5c8-dbda-4822-87fe-ba3c0ebcdb7f.jpg' alt='Posted Image' class='bbc_img' \/>","Email":"mariesam.sanchez@gmail.com","IpAddress":"74.100.61.37","GroupId":38,"GroupName":"Moderators","JoinDate":1285939945,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232833.jpg?_r=1422091823","PhotoWidth":200,"PhotoHeight":220,"PhotoType":"custom"},"FormattedName":"MarieSamSanchezPhoto","Id":232833,"Name":"MarieSamSanchezPhoto","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78802,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"12b66568627037f523a4ea9225556ca0","RawContent":"&lt;p&gt;I think that 10k is a doable budget for sure.&lt;\/p&gt;\n&lt;p&gt;My wedding has 30-40 guests and I am expecting to pay around 8k with my rings etc.&lt;\/p&gt;\n&lt;p&gt;I did skimp on some things that were really NEEDED.. Ie. Extra decor for my additional private events. I spent a lot of my decor budget on the reception and ceremony because I felt it was more important to spend that money on the day of the wedding when I have a photographer etc.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I also was very cautious with photography.. I sourced out a lot of photographers and most of them are very high in price. I did a lot of research online for photographers in the area I am getting married and I stumbled accross one who has fantastic pricing and great work. If you do the research and take the time to find the best and most economical options, it will definitely help you to keep the cost down.&lt;\/p&gt;","Attachments":[],"Id":1886953,"PostDate":1424431386,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I think that 10k is a doable budget for sure.<\/p>\n<p>My wedding has 30-40 guests and I am expecting to pay around 8k with my rings etc.<\/p>\n<p>I did skimp on some things that were really NEEDED.. Ie. Extra decor for my additional private events. I spent a lot of my decor budget on the reception and ceremony because I felt it was more important to spend that money on the day of the wedding when I have a photographer etc.<\/p>\n<p>\u00a0<\/p>\n<p>I also was very cautious with photography.. I sourced out a lot of photographers and most of them are very high in price. I did a lot of research online for photographers in the area I am getting married and I stumbled accross one who has fantastic pricing and great work. If you do the research and take the time to find the best and most economical options, it will definitely help you to keep the cost down.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":3,"GroupName":"Member","JoinDate":1419423414,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1436293677","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"143.58.161.6","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78802,"EditedBy":"<strong>Edited by JenniferH114, 20 February 2015 - 11:28 AM.<\/strong>","EditDate":1424431698,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"09fc64af394aaf9b673211fd5aafc8e6","RawContent":"&lt;p&gt;@&lt;span&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/user\/282047-dathotgal\/&#039; title=\"\"&gt;&lt;span&gt;dathotgal&lt;\/span&gt;&lt;\/a&gt;&lt;\/span&gt;&amp;nbsp;- Every resort is different, but one thing I&#039;d recommend checking right away is how many people are included in whatever package you may get and then how much it is per additional person. From what I&#039;ve been hearing, many resort wedding packages only include 20-25 people. I know our resort (not in Jamaica) includes 20 people and we have to pay $45 per person after that. Also, as someone else mentioned, be careful of resorts that charge for every little thing (e.g. chairs, linens, etc.). That will add up very quickly, especially with sixty guests.&lt;\/p&gt;","Attachments":[],"Id":1886955,"PostDate":1424431652,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<span><a href='http:\/\/www.bestdestinationwedding.com\/user\/282047-dathotgal\/' class='bbc_url' title=''><span>dathotgal<\/span><\/a><\/span>\u00a0- Every resort is different, but one thing I'd recommend checking right away is how many people are included in whatever package you may get and then how much it is per additional person. From what I've been hearing, many resort wedding packages only include 20-25 people. I know our resort (not in Jamaica) includes 20 people and we have to pay $45 per person after that. Also, as someone else mentioned, be careful of resorts that charge for every little thing (e.g. chairs, linens, etc.). That will add up very quickly, especially with sixty guests.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jhowe114@gmail.com","IpAddress":"38.98.131.98","GroupId":40,"GroupName":"Jr. Member","JoinDate":1402411989,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278395.jpg?_r=1421871115","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"JenniferH114","Id":278395,"Name":"JenniferH114","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.137.211.49","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78802,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"dae59e53bac35534e22538a6a783ca2a","RawContent":"&lt;p&gt;This is my fear! That add on charges will put my over our $10,000 budget&lt;\/p&gt;","Attachments":[],"Id":1889135,"PostDate":1426203010,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>This is my fear! That add on charges will put my over our $10,000 budget<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"phimoez@yahoo.com","IpAddress":"50.137.211.49","GroupId":39,"GroupName":"Newbie","JoinDate":1425862236,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"MNsunseeker","Id":282367,"Name":"MNsunseeker","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.225.204.185","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78802,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"b0ba5e4c09d0f261adf069a91ef4a735","RawContent":"@[member=\"dathotgal\"] My budget was 10k for a.wedding in Riviera Maya. We expected 75 guests. We have 97 confirmed and booked. Our final bill is looking to be around 21k. The things that ate our budget the most was: DJ, photographer, our airfare and acccomodations. Anything that has to do with wedding is included in this number. Im bringing my own decor and using silk flowers. Id probably cushion your budget with another 5 to 8k","Attachments":[],"Id":1889143,"PostDate":1426205516,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"282047\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282047-dathotgal\/' title='Member profile'><span itemprop=\"name\">dathotgal<\/span><\/a> My budget was 10k for a.wedding in Riviera Maya. We expected 75 guests. We have 97 confirmed and booked. Our final bill is looking to be around 21k. The things that ate our budget the most was: DJ, photographer, our airfare and acccomodations. Anything that has to do with wedding is included in this number. Im bringing my own decor and using silk flowers. Id probably cushion your budget with another 5 to 8k\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"keredondo@gmail.com","IpAddress":"108.225.204.185","GroupId":39,"GroupName":"Newbie","JoinDate":1403631619,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278682.jpg?_r=1414954781","PhotoWidth":187,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"BecomingaRiggio","Id":278682,"Name":"BecomingaRiggio","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78802,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"94b893ed40efed063b6501a0c5c21d82","RawContent":"&lt;p&gt;@[member=\"BecomingaRiggio\"] I had the same thing happen here except it&#039;s worse for us Canadians because of how terrible our dollar is right now VS the US dollar. My resort and vendors want all payments made in USD and our dollar is .20-.30 lower that USD.. so I basically have to add 30% to everything on my budget now.&lt;\/p&gt;\n&lt;p&gt;My budget for 30 guests was originally under 7k and now it&#039;s over 10k USD.. so 13k Canadian.&lt;\/p&gt;","Attachments":[],"Id":1889163,"PostDate":1426239797,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"278682\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/278682-becomingariggio\/' title='Member profile'><span itemprop=\"name\">BecomingaRiggio<\/span><\/a> I had the same thing happen here except it's worse for us Canadians because of how terrible our dollar is right now VS the US dollar. My resort and vendors want all payments made in USD and our dollar is .20-.30 lower that USD.. so I basically have to add 30% to everything on my budget now.<\/p>\n<p>My budget for 30 guests was originally under 7k and now it's over 10k USD.. so 13k Canadian.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":3,"GroupName":"Member","JoinDate":1419423414,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1436293677","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.52.105.170","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78802,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d3e477857ecbddf19d4e71e1ac7f8f40","RawContent":"&lt;p&gt;I sure hope a Destination wedding budget of 10k for 30guests is good! I&#039;m in the planning stages now but all of the hotels and packages seem so expensive when you look at the add ons.&lt;\/p&gt;","Attachments":[],"Id":1889274,"PostDate":1426369857,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I sure hope a Destination wedding budget of 10k for 30guests is good! I'm in the planning stages now but all of the hotels and packages seem so expensive when you look at the add ons.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tiffanysmorales@gmail.com","IpAddress":"173.52.105.170","GroupId":39,"GroupName":"Newbie","JoinDate":1426100801,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"mssundai","Id":282397,"Name":"mssundai","IsOnline":false}}],"Id":"78802","Title":"Wedding Budgets","LastPostDate":1433161681},"Pages":{"TotalItems":18,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
