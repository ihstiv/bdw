{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"142.162.81.35","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6bdc44318efa128dbc14fb48f5821e5e","RawContent":"&lt;p&gt;Hi Girls! Does anybody have an Email address for the Now Larimar Spa? or know of any local Spa&#039;s near the resort?&amp;nbsp;Thank you, Angelina&lt;\/p&gt;","Attachments":[],"Id":1829284,"PostDate":1390865860,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Girls! Does anybody have an Email address for the Now Larimar Spa? or know of any local Spa's near the resort?\u00a0Thank you, Angelina<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"angelina_plichie_@hotmail.com","IpAddress":"142.162.72.82","GroupId":39,"GroupName":"Newbie","JoinDate":1390333594,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276248.jpg?_r=1395191656","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"PuntaCanaBride14","Id":276248,"Name":"PuntaCanaBride14","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"67.173.180.132","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"00d15566594b68fbafa31e7b70f2af97","RawContent":"This is the email I have for the spa:\n\nspa.serpc@secretsresorts.com","Attachments":[],"Id":1829285,"PostDate":1390866196,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                This is the email I have for the spa:<br>\nspa.serpc@secretsresorts.com\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jsconner1983@yahoo.com","IpAddress":"67.173.180.132","GroupId":40,"GroupName":"Jr. Member","JoinDate":1362999807,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-267190.jpeg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Jahanee Conner","Id":267190,"Name":"Jahanee Conner","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"142.162.81.35","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"12284db0091359218e97adce1b280949","RawContent":"&lt;p&gt;Thank you Jahanee :)&lt;\/p&gt;\n\n&lt;p&gt;How long did it take for the Spa to email you back?&lt;\/p&gt;","Attachments":[],"Id":1829286,"PostDate":1390866456,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thank you Jahanee <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<br \/><p>How long did it take for the Spa to email you back?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"angelina_plichie_@hotmail.com","IpAddress":"142.162.72.82","GroupId":39,"GroupName":"Newbie","JoinDate":1390333594,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276248.jpg?_r=1395191656","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"PuntaCanaBride14","Id":276248,"Name":"PuntaCanaBride14","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"67.173.180.132","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ee7e7c3fb5807338f044dff100ca6a96","RawContent":"You&#039;re welcome!! They emailed me back the next day.","Attachments":[],"Id":1829288,"PostDate":1390866732,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                You're welcome!! They emailed me back the next day.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jsconner1983@yahoo.com","IpAddress":"67.173.180.132","GroupId":40,"GroupName":"Jr. Member","JoinDate":1362999807,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-267190.jpeg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Jahanee Conner","Id":267190,"Name":"Jahanee Conner","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"142.162.81.35","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"65a6fbb17ee400948ea55603ab615de9","RawContent":"&lt;p&gt;&lt;em&gt;Hi everyone, I was just wondering if anyone had some contact information for a judge able to perform a civil ceremony&amp;nbsp;in the PC area.&amp;nbsp; We are still trying to decide between the symbolic and civil ceremony, but both FI and I&amp;nbsp;seem to be leaning towards the civil.&amp;nbsp; Also if&amp;nbsp;anyone knows the costs associated with&amp;nbsp;a judge performing the ceremony that would be great as well!&lt;\/em&gt;&lt;\/p&gt;","Attachments":[],"Id":1829289,"PostDate":1390868080,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><em>Hi everyone, I was just wondering if anyone had some contact information for a judge able to perform a civil ceremony\u00a0in the PC area.\u00a0 We are still trying to decide between the symbolic and civil ceremony, but both FI and I\u00a0seem to be leaning towards the civil.\u00a0 Also if\u00a0anyone knows the costs associated with\u00a0a judge performing the ceremony that would be great as well!<\/em><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"angelina_plichie_@hotmail.com","IpAddress":"142.162.72.82","GroupId":39,"GroupName":"Newbie","JoinDate":1390333594,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276248.jpg?_r=1395191656","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"PuntaCanaBride14","Id":276248,"Name":"PuntaCanaBride14","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.91.162.106","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"cdc6b174b78debf4fbb61ebc32799001","RawContent":"&lt;p&gt;@[member=\"PuntaCanaBride14\"]&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We chose to do the symbolic wedding because it costs $540 to do civil and you have to be in the Dominican 3 business days before you get married... not to mention all the paperwork that needs to be done AND I *think* you have to have it all translated too.&lt;\/p&gt;","Attachments":[],"Id":1829456,"PostDate":1390928081,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"276248\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/276248-puntacanabride14\/' title='Member profile'><span itemprop=\"name\">PuntaCanaBride14<\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>We chose to do the symbolic wedding because it costs $540 to do civil and you have to be in the Dominican 3 business days before you get married... not to mention all the paperwork that needs to be done AND I *think* you have to have it all translated too.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"telli26@gmail.com","IpAddress":"207.91.162.106","GroupId":39,"GroupName":"Newbie","JoinDate":1373114870,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-271235.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":139,"PhotoType":"custom"},"FormattedName":"Tiffany Ellison","Id":271235,"Name":"Tiffany Ellison","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"142.162.77.11","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2abe835fadc88d168c073dd6249aa8db","RawContent":"&lt;p&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;sub&gt;@[member=\"Tiffany Ellison\"]&lt;\/sub&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;sub&gt;&lt;span style=\"font-size:14px;\"&gt;Thanks Tiffany! How is your planning going? Your wedding is 3 weeks after ours &lt;\/span&gt; :D&amp;nbsp;&lt;\/sub&gt;&lt;\/p&gt;","Attachments":[],"Id":1829596,"PostDate":1390950599,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span  style=\"font-size:14px\"><sub>@<a hovercard-ref=\"member\" hovercard-id=\"271235\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/271235-tiffany-ellison\/' title='Member profile'><span itemprop=\"name\">Tiffany Ellison<\/span><\/a><\/sub><\/span><\/p>\n<p>\u00a0<\/p>\n<p><sub><span  style=\"font-size:14px\">Thanks Tiffany! How is your planning going? Your wedding is 3 weeks after ours <\/span> <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/biggrin.png' class='bbc_emoticon' alt=':D' \/>\u00a0<\/sub><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"angelina_plichie_@hotmail.com","IpAddress":"142.162.72.82","GroupId":39,"GroupName":"Newbie","JoinDate":1390333594,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276248.jpg?_r=1395191656","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"PuntaCanaBride14","Id":276248,"Name":"PuntaCanaBride14","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"65.94.196.198","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":1391273181,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"55a18b90a947588fa7869f26fff13580","RawContent":"&lt;p&gt;I am getting married at Now&amp;nbsp;on November 14th 2014 :) Congrats to all of you on your engagements as well!&lt;\/p&gt;","Attachments":[],"Id":1831041,"PostDate":1391273169,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I am getting married at Now\u00a0on November 14th 2014 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> Congrats to all of you on your engagements as well!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ooohgirlnailsalon@gmail.com","IpAddress":"65.94.196.198","GroupId":39,"GroupName":"Newbie","JoinDate":1370802708,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270404.jpg?_r=1391287760","PhotoWidth":200,"PhotoHeight":167,"PhotoType":"custom"},"FormattedName":"MXMom","Id":270404,"Name":"MXMom","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.251.225.60","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e82278fd72cd47ff770c79057a3f5c4b","RawContent":"&lt;p&gt;Hi Ladies!! Im a new gal on this forum!! Its really helpful to be able to read your posts!! I am just about positive that I will be having my wedding at Now Larimar, but in 2015. Im thinking April, but have to do a little more research on weather and what not. I sent them an email in hopes of starting the booking process.&amp;nbsp; :D&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am trying to find pictures of the locations for ceremony and reception, and for some reason can&#039;t find them!! They are probably right in front of me...if anyone can tell me where to look that would be such a huge help!! :)&amp;nbsp; :)&lt;\/p&gt;","Attachments":[],"Id":1831351,"PostDate":1391349210,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Ladies!! Im a new gal on this forum!! Its really helpful to be able to read your posts!! I am just about positive that I will be having my wedding at Now Larimar, but in 2015. Im thinking April, but have to do a little more research on weather and what not. I sent them an email in hopes of starting the booking process.\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/biggrin.png' class='bbc_emoticon' alt=':D' \/><\/p>\n<p>\u00a0<\/p>\n<p>I am trying to find pictures of the locations for ceremony and reception, and for some reason can't find them!! They are probably right in front of me...if anyone can tell me where to look that would be such a huge help!! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"linds4836@yahoo.com","IpAddress":"24.251.225.60","GroupId":39,"GroupName":"Newbie","JoinDate":1391216663,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"LindsT","Id":276428,"Name":"LindsT","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"142.162.85.135","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5202eac26de26be33c574d9c6c6238c8","RawContent":"&lt;p&gt;@[member=\"Jahanee Conner\"]&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Hey Jahanee! I was wondering if you booked any appointments at the Spa for May 31st?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;ve been trying to book Spa appointments for hair\/make&amp;nbsp;up for our Wedding Day on May 7th. The ladies at the resort Spa email me back right away, but both emails were the exact same with prices and the form. I even emailed them the Reservation Form and asked them a few times if I could book my appointments, but I&#039;m yet to&amp;nbsp;get a yes or no answer :(&amp;nbsp;.....&lt;\/p&gt;\n\n&lt;p&gt;@[member=\"LindsT\"]&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Hi Linds! Once we were assigned a wedding coordinator, we received an email from her with pictures\/names of Ceremony and Reception locations @ the&amp;nbsp;Now Larimar Resort :)&lt;\/p&gt;","Attachments":[],"Id":1831558,"PostDate":1391437710,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"267190\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/267190-jahanee-conner\/' title='Member profile'><span itemprop=\"name\">Jahanee Conner<\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>Hey Jahanee! I was wondering if you booked any appointments at the Spa for May 31st?<\/p>\n<p>\u00a0<\/p>\n<p>I've been trying to book Spa appointments for hair\/make\u00a0up for our Wedding Day on May 7th. The ladies at the resort Spa email me back right away, but both emails were the exact same with prices and the form. I even emailed them the Reservation Form and asked them a few times if I could book my appointments, but I'm yet to\u00a0get a yes or no answer <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/sad.png' class='bbc_emoticon' alt=':(' \/>\u00a0.....<\/p>\n<br \/><p>@<a hovercard-ref=\"member\" hovercard-id=\"276428\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/276428-lindst\/' title='Member profile'><span itemprop=\"name\">LindsT<\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>Hi Linds! Once we were assigned a wedding coordinator, we received an email from her with pictures\/names of Ceremony and Reception locations @ the\u00a0Now Larimar Resort <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"angelina_plichie_@hotmail.com","IpAddress":"142.162.72.82","GroupId":39,"GroupName":"Newbie","JoinDate":1390333594,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276248.jpg?_r=1395191656","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"PuntaCanaBride14","Id":276248,"Name":"PuntaCanaBride14","IsOnline":false}}],"Pages":{"TotalItems":460,"TotalPages":46,"CurrentPage":270,"NextPage":280,"PreviousPage":260,"LastPage":450},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
