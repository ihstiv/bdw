{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.35.109.240","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77311,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"80a77d3a1d0c22774fe4f00a872ed220","RawContent":"Hello everyone and congratulations!! If anyone is looking for favors we used Jimmy with Dominican favors for our 70 personalized bottle of Brugal rum! We had no problems with communication through out the entire process. I emailed him a week before we left to confirm date, time, and location of delivery- he confirmed date, time, and met us in the lobby of the resort. All of our guests loved the favors our coordinator was even blown away. Good luck and happy planning!","Attachments":[{"Id":32460,"Name":"image.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2015\/post-272393-0-33863000-1433075880.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2015\/post-272393-0-33863000-1433075880_thumb.jpg","Width":640,"Height":1136}],"Id":1897602,"PostDate":1433061484,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hello everyone and congratulations!! If anyone is looking for favors we used Jimmy with Dominican favors for our 70 personalized bottle of Brugal rum! We had no problems with communication through out the entire process. I emailed him a week before we left to confirm date, time, and location of delivery- he confirmed date, time, and met us in the lobby of the resort. All of our guests loved the favors our coordinator was even blown away. Good luck and happy planning!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"May 01, 2015- complete!! 73 guests+bride & groom! Now Larimar Punta Cana! ","Email":"cooper.tyshelle@gmail.com","IpAddress":"108.50.56.179","GroupId":39,"GroupName":"Newbie","JoinDate":1375998669,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272393.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"DR2015","Id":272393,"Name":"DR2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.215.119.66","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77311,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"dc59836dc9d327d58ad77f092aa7c69c","RawContent":"&lt;p&gt;@[member=\"DR2015\"]&lt;\/p&gt;\n&lt;p&gt;Do you have contact information for Jimmy and maybe some pricing information! That sounds like an awesome idea for a favor!&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1897638,"PostDate":1433120421,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"272393\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/272393-dr2015\/' title='Member profile'><span itemprop=\"name\">DR2015<\/span><\/a><\/p>\n<p>Do you have contact information for Jimmy and maybe some pricing information! That sounds like an awesome idea for a favor!\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"abrinton8811@gmail.com","IpAddress":"70.196.206.150","GroupId":39,"GroupName":"Newbie","JoinDate":1419021825,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"abrinton8811","Id":281451,"Name":"abrinton8811","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"73.43.251.19","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77311,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"7f5220196b5952eb7a7c89751761a7e7","RawContent":"&lt;p&gt;&lt;span style=\"color:#000000;\"&gt;&lt;span style=\"font-family:helvetica, sans-serif;\"&gt;&lt;span style=\"font-size:12pt;\"&gt;Hey everyone!&amp;nbsp; We\u2019re back from our AMAZING wedding and I wanted to write a detailed review to help any future brides.&amp;nbsp; This website was so helpful throughout the planning process so please let me know if you have any questions and I\u2019ll do my best to help!&amp;nbsp; &lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"color:#000000;\"&gt;&lt;span style=\"font-family:helvetica, sans-serif;\"&gt;&lt;span style=\"font-size:12pt;\"&gt;We signed up for &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/destinationweddings.com\/&#039;&gt;&lt;span style=\"color:#196ad4;\"&gt;DestinationWeddings.com&lt;\/span&gt;&lt;\/a&gt;&lt;\/span&gt; and our travel agent&amp;nbsp;Sharon Fein was super nice and very knowledgeable and helped us every step of the way. &amp;nbsp;Once we settled on Now Larimar, she worked with all of our guests to get their travel arrangements set up. &amp;nbsp;We ended up having 45 guests total and we had a few that changed their mind, were late to pay, or cancelled all together and Sharon was so helpful and happy to accommodate them.&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"color:#000000;\"&gt;&lt;span style=\"font-family:helvetica, sans-serif;\"&gt;&lt;span style=\"font-size:12pt;\"&gt;We got to the resort on the Wednesday before our wedding and we met with our wedding coordinator, Yeomandry, Thursday morning.&amp;nbsp; She was super nice!&amp;nbsp; She went through our wedding planner spreadsheet step by step to finalize all of our details and calculate the final cost based on our choices and number of guests. &amp;nbsp;We also gave her all of the decorations that we brought from home.&amp;nbsp; We brought small lanterns, candles, vases, menus and easels for the menus.&amp;nbsp; We purchased flowers from the resort and the centerpieces turned out great.&amp;nbsp; We also brought Mr. and Mrs. signs for our chairs and programs for the reception.&amp;nbsp; They did a great job setting everything up, but in hindsight, I would\u2019ve had one of my bridesmaids go look at everything during cocktail hour while we were getting our pictures taken. &amp;nbsp;The pool closes at 6 and our reception started at 7 so they set everything up really quickly.&amp;nbsp; That may make some people nervous, but they literally do 3 weddings every day so they\u2019re like a machine.&amp;nbsp; We were able to see several weddings in the same spot ours was the 2 days leading up to ours so it was cool to see before our big day.&amp;nbsp; Back to the centerpieces\u2026they looked completely fine, but they weren\u2019t placed exactly like I wanted, but nobody knew that except for me.&amp;nbsp; You also couldn\u2019t see our Mr. &amp;amp; Mrs. signs b\/c our bridal party table was under the wooden canopy by the pool and the back of the chairs were facing the bushes.&amp;nbsp; Not a big deal at all, but if my bridesmaids would\u2019ve gone over to look at it, they probably would\u2019ve hung them off the front of the table so you could see them.&amp;nbsp; My sister also made some really cute floating flower balls to put in the pool and they turned out great, but they all floated to the side of the pool so it didn\u2019t really turn out the way I envisioned, but it wasn\u2019t a big deal at all.&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"color:#000000;\"&gt;&lt;span style=\"font-family:helvetica, sans-serif;\"&gt;&lt;span style=\"font-size:12pt;\"&gt;Our wedding was literally perfect\u2026I couldn\u2019t ask for a better experience!&amp;nbsp; Our ceremony started at 5:30 at the fountain, cocktail hour was at 6 and the reception started at 7 at the pool.&amp;nbsp; The only thing I would change is to make it longer.&amp;nbsp; We thought about extending our ceremony to 4 hours but we didn\u2019t and it went by soooo fast.&amp;nbsp; I think every couple says that though so one more hour probably wouldn\u2019t have made a huge difference.&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"color:#000000;\"&gt;&lt;span style=\"font-family:helvetica, sans-serif;\"&gt;&lt;span style=\"font-size:12pt;\"&gt;We used the resort DJ and MC and they were both great.&amp;nbsp; The resort photographer and videographer were also great\u2026our photos and video turned out so great!&amp;nbsp; The resort photographer only covered our ceremony, not the reception or anything before.&amp;nbsp; We hired HDC Photography (&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.hdcphoto.com&#039;&gt;www.hdcphoto.com&lt;\/a&gt;) and I\u2019m soooo glad we did.&amp;nbsp; I don\u2019t think I\u2019ve ever been happier with a service in my life.&amp;nbsp; Arnaud was quick to respond to all of my emails leading up to the day.&amp;nbsp; Our photographer was Miljan and he was AMAZING.&amp;nbsp; He was like a drill sergeant telling us exactly how to pose, where to look, etc. which was so awesome.&amp;nbsp; I\u2019m not great at posing for pictures so it was so helpful to have him tell us exactly what to do.&amp;nbsp; He was also really great at making sure we got all the normal wedding photos and kept a close eye on the time to make sure we got pictures with everyone, pictures of the cake, dancing, etc. before his time was up.&amp;nbsp; Here\u2019s a link to some of our pictures: &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/bit.ly\/LightHartWedding&#039;&gt;http:\/\/bit.ly\/LightHartWedding&lt;\/a&gt;.&amp;nbsp; A few days after the wedding, Arnaud came to the resort to meet with us and show us the pictures.&amp;nbsp; He was so nice and I think he was the only person that didn\u2019t try to up-sell us or get us to buy something while we were there.&amp;nbsp; He gave us some great local information and even offered to drive us to a restaurant he recommended.&amp;nbsp; We had over 400 pictures from them!&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"color:#000000;\"&gt;&lt;span style=\"font-family:helvetica, sans-serif;\"&gt;&lt;span style=\"font-size:12pt;\"&gt;The photography package that came with our wedding package (Divine) provided 24 pictures.&amp;nbsp; I didn\u2019t want to regret not getting all of them so we ended up paying $300 for all of the pictures the resort photographer took during our ceremony\u2026that was almost 200 more so we have a ton of great pictures!&amp;nbsp; The prints didn\u2019t turn out great, but we have them all on a CD so we can get them reprinted somewhere else.&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"color:#000000;\"&gt;&lt;span style=\"font-family:helvetica, sans-serif;\"&gt;&lt;span style=\"font-size:12pt;\"&gt;We also hired Pastor Rick York and I\u2019m sooooo glad we did!&amp;nbsp; He\u2019s American and so funny and personable.&amp;nbsp; Several guests thought we knew him b\/c the ceremony seemed so personal.&amp;nbsp; We didn\u2019t have to pay the outside vendor fee for him and we paid him cash right after the ceremony.&amp;nbsp; My mom and aunt saw another wedding at the beach and they said it was beautiful, but it was very short and the wedding coordinator performed the ceremony and English isn\u2019t their first language so they were glad we hired Pastor York.&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"color:#000000;\"&gt;&lt;span style=\"font-family:helvetica, sans-serif;\"&gt;&lt;span style=\"font-size:12pt;\"&gt;A few things to note: If you bring your own decorations, they pretty much just shove them in to a bag and return them to you.&amp;nbsp; I read that before so it didn\u2019t surprise me but I\u2019ve seen other people get upset about that.&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"color:#000000;\"&gt;&lt;span style=\"font-family:helvetica, sans-serif;\"&gt;&lt;span style=\"font-size:12pt;\"&gt;There was a wedding reception on the beach on the Thursday after our ceremony (we went to Secrets for our honeymoon) and it was the same night as the big beach party.&amp;nbsp; I felt terrible for that couple b\/c there were literally 200 people about 30 feet away from their reception.&amp;nbsp; Their reception area was \u2018blocked off\u2019 by beach chairs laying sideways to build a barrier.&amp;nbsp; There was also a reception that same night at Castaways which is also right by the area where the beach reception was so there were TONS of people in that area and it didn\u2019t seem very private.&amp;nbsp; Our reception at the pool was completely private.&amp;nbsp; Our ceremony was also much more private at the fountain, but I know a lot of people want to be on the beach.&amp;nbsp; That wasn\u2019t an option for us b\/c my hubby is 6\u20194\u201d and I\u2019m 5\u20191\u201d so I had to be able to wear heels!&amp;nbsp; I believe they have beach parties on Thursday and Sunday nights so I would check with your wedding coordinator to make sure they\u2019re not having one the same night of your wedding if you are planning on having your reception at the beach or at Castaways. From looking at all the pictures, I thought Castaways looked like a great place to have our reception, but I didn\u2019t want to pay $3K for it and I don\u2019t think it\u2019s worth it at all.&amp;nbsp; I think the pool was a much better venue and it\u2019s more private and no extra cost.&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"color:#000000;\"&gt;&lt;span style=\"font-family:helvetica, sans-serif;\"&gt;&lt;span style=\"font-size:12pt;\"&gt;Our wedding was sooo AMAZING and I\u2019m so happy we did it there.&amp;nbsp; It turned out so perfect and I couldn\u2019t be happier!&amp;nbsp; I hope this helps everyone.&amp;nbsp; Let me know if you have any questions and I\u2019m happy to help if I can.&amp;nbsp; Good luck planning and congratulations!&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"color:#000000;\"&gt;&lt;span style=\"font-family:helvetica, sans-serif;\"&gt;&lt;span style=\"font-size:12pt;\"&gt;~ Rebecca&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1897690,"PostDate":1433189527,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span  style=\"color:#000000\"><span  style=\"font-family:helvetica, sans-serif\"><span  style=\"font-size:12pt\">Hey everyone!\u00a0 We\u2019re back from our AMAZING wedding and I wanted to write a detailed review to help any future brides.\u00a0 This website was so helpful throughout the planning process so please let me know if you have any questions and I\u2019ll do my best to help!\u00a0 <\/span><\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"color:#000000\"><span  style=\"font-family:helvetica, sans-serif\"><span  style=\"font-size:12pt\">We signed up for <a href='http:\/\/destinationweddings.com\/' class='bbc_url' title='External link' rel='nofollow external'><span  style=\"color:#196ad4\">DestinationWeddings.com<\/span><\/a><\/span> and our travel agent\u00a0Sharon Fein was super nice and very knowledgeable and helped us every step of the way. \u00a0Once we settled on Now Larimar, she worked with all of our guests to get their travel arrangements set up. \u00a0We ended up having 45 guests total and we had a few that changed their mind, were late to pay, or cancelled all together and Sharon was so helpful and happy to accommodate them.<\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"color:#000000\"><span  style=\"font-family:helvetica, sans-serif\"><span  style=\"font-size:12pt\">We got to the resort on the Wednesday before our wedding and we met with our wedding coordinator, Yeomandry, Thursday morning.\u00a0 She was super nice!\u00a0 She went through our wedding planner spreadsheet step by step to finalize all of our details and calculate the final cost based on our choices and number of guests. \u00a0We also gave her all of the decorations that we brought from home.\u00a0 We brought small lanterns, candles, vases, menus and easels for the menus.\u00a0 We purchased flowers from the resort and the centerpieces turned out great.\u00a0 We also brought Mr. and Mrs. signs for our chairs and programs for the reception.\u00a0 They did a great job setting everything up, but in hindsight, I would\u2019ve had one of my bridesmaids go look at everything during cocktail hour while we were getting our pictures taken. \u00a0The pool closes at 6 and our reception started at 7 so they set everything up really quickly.\u00a0 That may make some people nervous, but they literally do 3 weddings every day so they\u2019re like a machine.\u00a0 We were able to see several weddings in the same spot ours was the 2 days leading up to ours so it was cool to see before our big day.\u00a0 Back to the centerpieces\u2026they looked completely fine, but they weren\u2019t placed exactly like I wanted, but nobody knew that except for me.\u00a0 You also couldn\u2019t see our Mr. & Mrs. signs b\/c our bridal party table was under the wooden canopy by the pool and the back of the chairs were facing the bushes.\u00a0 Not a big deal at all, but if my bridesmaids would\u2019ve gone over to look at it, they probably would\u2019ve hung them off the front of the table so you could see them.\u00a0 My sister also made some really cute floating flower balls to put in the pool and they turned out great, but they all floated to the side of the pool so it didn\u2019t really turn out the way I envisioned, but it wasn\u2019t a big deal at all.<\/span><\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"color:#000000\"><span  style=\"font-family:helvetica, sans-serif\"><span  style=\"font-size:12pt\">Our wedding was literally perfect\u2026I couldn\u2019t ask for a better experience!\u00a0 Our ceremony started at 5:30 at the fountain, cocktail hour was at 6 and the reception started at 7 at the pool.\u00a0 The only thing I would change is to make it longer.\u00a0 We thought about extending our ceremony to 4 hours but we didn\u2019t and it went by soooo fast.\u00a0 I think every couple says that though so one more hour probably wouldn\u2019t have made a huge difference.<\/span><\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"color:#000000\"><span  style=\"font-family:helvetica, sans-serif\"><span  style=\"font-size:12pt\">We used the resort DJ and MC and they were both great.\u00a0 The resort photographer and videographer were also great\u2026our photos and video turned out so great!\u00a0 The resort photographer only covered our ceremony, not the reception or anything before.\u00a0 We hired HDC Photography (<a href='http:\/\/www.hdcphoto.com' class='bbc_url' title='External link' rel='nofollow external'>www.hdcphoto.com<\/a>) and I\u2019m soooo glad we did.\u00a0 I don\u2019t think I\u2019ve ever been happier with a service in my life.\u00a0 Arnaud was quick to respond to all of my emails leading up to the day.\u00a0 Our photographer was Miljan and he was AMAZING.\u00a0 He was like a drill sergeant telling us exactly how to pose, where to look, etc. which was so awesome.\u00a0 I\u2019m not great at posing for pictures so it was so helpful to have him tell us exactly what to do.\u00a0 He was also really great at making sure we got all the normal wedding photos and kept a close eye on the time to make sure we got pictures with everyone, pictures of the cake, dancing, etc. before his time was up.\u00a0 Here\u2019s a link to some of our pictures: <a href='http:\/\/bit.ly\/LightHartWedding' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/bit.ly\/LightHartWedding<\/a>.\u00a0 A few days after the wedding, Arnaud came to the resort to meet with us and show us the pictures.\u00a0 He was so nice and I think he was the only person that didn\u2019t try to up-sell us or get us to buy something while we were there.\u00a0 He gave us some great local information and even offered to drive us to a restaurant he recommended.\u00a0 We had over 400 pictures from them!<\/span><\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"color:#000000\"><span  style=\"font-family:helvetica, sans-serif\"><span  style=\"font-size:12pt\">The photography package that came with our wedding package (Divine) provided 24 pictures.\u00a0 I didn\u2019t want to regret not getting all of them so we ended up paying $300 for all of the pictures the resort photographer took during our ceremony\u2026that was almost 200 more so we have a ton of great pictures!\u00a0 The prints didn\u2019t turn out great, but we have them all on a CD so we can get them reprinted somewhere else.<\/span><\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"color:#000000\"><span  style=\"font-family:helvetica, sans-serif\"><span  style=\"font-size:12pt\">We also hired Pastor Rick York and I\u2019m sooooo glad we did!\u00a0 He\u2019s American and so funny and personable.\u00a0 Several guests thought we knew him b\/c the ceremony seemed so personal.\u00a0 We didn\u2019t have to pay the outside vendor fee for him and we paid him cash right after the ceremony.\u00a0 My mom and aunt saw another wedding at the beach and they said it was beautiful, but it was very short and the wedding coordinator performed the ceremony and English isn\u2019t their first language so they were glad we hired Pastor York.<\/span><\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"color:#000000\"><span  style=\"font-family:helvetica, sans-serif\"><span  style=\"font-size:12pt\">A few things to note: If you bring your own decorations, they pretty much just shove them in to a bag and return them to you.\u00a0 I read that before so it didn\u2019t surprise me but I\u2019ve seen other people get upset about that.<\/span><\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"color:#000000\"><span  style=\"font-family:helvetica, sans-serif\"><span  style=\"font-size:12pt\">There was a wedding reception on the beach on the Thursday after our ceremony (we went to Secrets for our honeymoon) and it was the same night as the big beach party.\u00a0 I felt terrible for that couple b\/c there were literally 200 people about 30 feet away from their reception.\u00a0 Their reception area was \u2018blocked off\u2019 by beach chairs laying sideways to build a barrier.\u00a0 There was also a reception that same night at Castaways which is also right by the area where the beach reception was so there were TONS of people in that area and it didn\u2019t seem very private.\u00a0 Our reception at the pool was completely private.\u00a0 Our ceremony was also much more private at the fountain, but I know a lot of people want to be on the beach.\u00a0 That wasn\u2019t an option for us b\/c my hubby is 6\u20194\u201d and I\u2019m 5\u20191\u201d so I had to be able to wear heels!\u00a0 I believe they have beach parties on Thursday and Sunday nights so I would check with your wedding coordinator to make sure they\u2019re not having one the same night of your wedding if you are planning on having your reception at the beach or at Castaways. From looking at all the pictures, I thought Castaways looked like a great place to have our reception, but I didn\u2019t want to pay $3K for it and I don\u2019t think it\u2019s worth it at all.\u00a0 I think the pool was a much better venue and it\u2019s more private and no extra cost.<\/span><\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"color:#000000\"><span  style=\"font-family:helvetica, sans-serif\"><span  style=\"font-size:12pt\">Our wedding was sooo AMAZING and I\u2019m so happy we did it there.\u00a0 It turned out so perfect and I couldn\u2019t be happier!\u00a0 I hope this helps everyone.\u00a0 Let me know if you have any questions and I\u2019m happy to help if I can.\u00a0 Good luck planning and congratulations!<\/span><\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"color:#000000\"><span  style=\"font-family:helvetica, sans-serif\"><span  style=\"font-size:12pt\">~ Rebecca<\/span><\/span><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rebeccalightsey@yahoo.com","IpAddress":"74.190.197.204","GroupId":39,"GroupName":"Newbie","JoinDate":1405539863,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279045.jpg?_r=1434956018","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"RebeLight","Id":279045,"Name":"RebeLight","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.35.109.240","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77311,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bdf3f06f0b16e5ef4ffd0779efa84133","RawContent":"@[member=\"abrinton8811\"] we paid a little over $400 U.S. for 70 personalized bottles- there are many other options on the site &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.dominicanfavors.com&#039;&gt;http:\/\/www.dominicanfavors.com&lt;\/a&gt;","Attachments":[],"Id":1897698,"PostDate":1433197884,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"281451\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281451-abrinton8811\/' title='Member profile'><span itemprop=\"name\">abrinton8811<\/span><\/a> we paid a little over $400 U.S. for 70 personalized bottles- there are many other options on the site <a href='http:\/\/www.dominicanfavors.com' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.dominicanfavors.com<\/a>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"May 01, 2015- complete!! 73 guests+bride & groom! Now Larimar Punta Cana! ","Email":"cooper.tyshelle@gmail.com","IpAddress":"108.50.56.179","GroupId":39,"GroupName":"Newbie","JoinDate":1375998669,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272393.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"DR2015","Id":272393,"Name":"DR2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.65.74.207","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77311,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"36e5ca405c152a653c5544af801331fd","RawContent":"[quote name=\"RebeLight\" post=\"1897690\" timestamp=\"1433203927\"]\n\n\n\n[color=#000000][font=helvetica][size=3]We also hired Pastor Rick York and I\u2019m sooooo glad we did!  He\u2019s American and so funny and personable.  Several guests thought we knew him b\/c the ceremony seemed so personal.  We didn\u2019t have to pay the outside vendor fee for him and we paid him cash right after the ceremony.  My mom and aunt saw another wedding at the beach and they said it was beautiful, but it was very short and the wedding coordinator performed the ceremony and English isn\u2019t their first language so they were glad we hired Pastor York.[\/size][\/font][\/color]\n[\/quote]\nThank you so much for sharing!  Can you share the contact information for Pastor Rick?  Also how did you get around the outside vendor fee?   thank you!","Attachments":[],"Id":1897700,"PostDate":1433199014,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>RebeLight, on 01 June 2015 - 08:12 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"color:#000000\"><span  style=\"font-family:helvetica, sans-serif\"><span  style=\"font-size:12pt\">We also hired Pastor Rick York and I\u2019m sooooo glad we did!\u00a0 He\u2019s American and so funny and personable.\u00a0 Several guests thought we knew him b\/c the ceremony seemed so personal.\u00a0 We didn\u2019t have to pay the outside vendor fee for him and we paid him cash right after the ceremony.\u00a0 My mom and aunt saw another wedding at the beach and they said it was beautiful, but it was very short and the wedding coordinator performed the ceremony and English isn\u2019t their first language so they were glad we hired Pastor York.<\/span><\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>Thank you so much for sharing! \u00a0Can you share the contact information for Pastor Rick? \u00a0Also how did you get around the outside vendor fee? \u00a0 thank you!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ashley225@gmail.com","IpAddress":"66.87.117.140","GroupId":39,"GroupName":"Newbie","JoinDate":1426931385,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282492.jpg?_r=1436650511","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"AshleyNYC323","Id":282492,"Name":"AshleyNYC323","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.8.84.124","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77311,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"32899b883476fd37e24f4ddda28b04f9","RawContent":"@[member=\"RebeLight\"] if you could please share the contact information for pastor Rick? Also do you know if he is able to do a legal ceremony?","Attachments":[],"Id":1897701,"PostDate":1433203886,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"279045\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/279045-rebelight\/' title='Member profile'><span itemprop=\"name\">RebeLight<\/span><\/a> if you could please share the contact information for pastor Rick? Also do you know if he is able to do a legal ceremony?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"dibo930@aol.com","IpAddress":"50.8.84.124","GroupId":39,"GroupName":"Newbie","JoinDate":1432767962,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283278.jpg?_r=1439751768","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"Dina821","Id":283278,"Name":"Dina821","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.141.176.66","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77311,"EditedBy":"","EditDate":1433255639,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"11e9e2ee53b6d112e88e6633a710946e","RawContent":"&lt;p&gt;@[member=\"AshleyNYC323\"] &amp;amp; @[member=\"Dina821\"] Here&#039;s Pastor York&#039;s email address:&amp;nbsp;&lt;a&gt;rickandsuzanneyork@[member=\"gmail\"].com.&amp;nbsp;&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Ashley--I didn&#039;t try to get around the outside vendor fee...they just didn&#039;t charge it. &amp;nbsp;I would just ask your WC about it!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Dina--I&#039;m not sure if he can do a legal ceremony or not. &amp;nbsp;I believe you have to go through the Dominican government just like you do in the US. &amp;nbsp;He does have you both sign a document and two witnesses sign as well. &amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck!&lt;\/p&gt;","Attachments":[],"Id":1897753,"PostDate":1433255549,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"282492\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282492-ashleynyc323\/' title='Member profile'><span itemprop=\"name\">AshleyNYC323<\/span><\/a> & @<a hovercard-ref=\"member\" hovercard-id=\"283278\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/283278-dina821\/' title='Member profile'><span itemprop=\"name\">Dina821<\/span><\/a> Here's Pastor York's email address:\u00a0<a>rickandsuzanneyork@<a hovercard-ref=\"member\" hovercard-id=\"219734\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/219734-gmail\/' title='Member profile'><span itemprop=\"name\">gmail<\/span><\/a>.com.\u00a0<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Ashley--I didn't try to get around the outside vendor fee...they just didn't charge it. \u00a0I would just ask your WC about it!<\/p>\n<p>\u00a0<\/p>\n<p>Dina--I'm not sure if he can do a legal ceremony or not. \u00a0I believe you have to go through the Dominican government just like you do in the US. \u00a0He does have you both sign a document and two witnesses sign as well. \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Good luck!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rebeccalightsey@yahoo.com","IpAddress":"74.190.197.204","GroupId":39,"GroupName":"Newbie","JoinDate":1405539863,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279045.jpg?_r=1434956018","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"RebeLight","Id":279045,"Name":"RebeLight","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"199.200.25.52","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77311,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3b42b080b2b1200aa64d2e04426dc704","RawContent":"[quote name=\"RebeLight\" post=\"1897690\" timestamp=\"1433203927\"]\n\n\n\n[color=rgb(0,0,0)][font=helvetica][size=3]We used the resort DJ and MC and they were both great.  The resort photographer and videographer were also great\u2026our photos and video turned out so great!  The resort photographer only covered our ceremony, not the reception or anything before.  We hired HDC Photography ([url=\"http:\/\/www.hdcphoto.com\"]www.hdcphoto.com[\/url]) and I\u2019m soooo glad we did.  I don\u2019t think I\u2019ve ever been happier with a service in my life.  Arnaud was quick to respond to all of my emails leading up to the day.  Our photographer was Miljan and he was AMAZING.  He was like a drill sergeant telling us exactly how to pose, where to look, etc. which was so awesome.  I\u2019m not great at posing for pictures so it was so helpful to have him tell us exactly what to do.  He was also really great at making sure we got all the normal wedding photos and kept a close eye on the time to make sure we got pictures with everyone, pictures of the cake, dancing, etc. before his time was up.  Here\u2019s a link to some of our pictures: [url=\"http:\/\/bit.ly\/LightHartWedding\"]http:\/\/bit.ly\/LightHartWedding[\/url].  A few days after the wedding, Arnaud came to the resort to meet with us and show us the pictures.  He was so nice and I think he was the only person that didn\u2019t try to up-sell us or get us to buy something while we were there.  He gave us some great local information and even offered to drive us to a restaurant he recommended.  We had over 400 pictures from them![\/size][\/font][\/color]\n\n[color=rgb(0,0,0)][font=helvetica][size=3]The photography package that came with our wedding package (Divine) provided 24 pictures.  I didn\u2019t want to regret not getting all of them so we ended up paying $300 for all of the pictures the resort photographer took during our ceremony\u2026that was almost 200 more so we have a ton of great pictures!  The prints didn\u2019t turn out great, but we have them all on a CD so we can get them reprinted somewhere else.[\/size][\/font][\/color]\n\n\n[\/quote]Thanks for the detailed review!!!  Lots of great points.  I will be emailing Pastor Risk ASAP. \n\nI had a question regarding your photography choice, if you don&#039;t mind me asking.  Why didn&#039;t you elect to use the photographer that came with the package for before ceremony and reception? \n\nDid you bring your decorations with you on the plane or did you ship them ahead of time.  Between the dress, the welcome bags and welcome stuff, and decorations, I don&#039;t think I will have any room for anything else!  LOL.","Attachments":[],"Id":1897771,"PostDate":1433264695,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>RebeLight, on 01 June 2015 - 08:12 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"color:rgb(0,0,0)\"><span  style=\"font-family:helvetica, sans-serif\"><span  style=\"font-size:12pt\">We used the resort DJ and MC and they were both great.\u00a0 The resort photographer and videographer were also great\u2026our photos and video turned out so great!\u00a0 The resort photographer only covered our ceremony, not the reception or anything before.\u00a0 We hired HDC Photography (<a href='http:\/\/www.hdcphoto.com' class='bbc_url' title='External link' rel='nofollow external'>www.hdcphoto.com<\/a>) and I\u2019m soooo glad we did.\u00a0 I don\u2019t think I\u2019ve ever been happier with a service in my life.\u00a0 Arnaud was quick to respond to all of my emails leading up to the day.\u00a0 Our photographer was Miljan and he was AMAZING.\u00a0 He was like a drill sergeant telling us exactly how to pose, where to look, etc. which was so awesome.\u00a0 I\u2019m not great at posing for pictures so it was so helpful to have him tell us exactly what to do.\u00a0 He was also really great at making sure we got all the normal wedding photos and kept a close eye on the time to make sure we got pictures with everyone, pictures of the cake, dancing, etc. before his time was up.\u00a0 Here\u2019s a link to some of our pictures: <a href='http:\/\/bit.ly\/LightHartWedding' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/bit.ly\/LightHartWedding<\/a>.\u00a0 A few days after the wedding, Arnaud came to the resort to meet with us and show us the pictures.\u00a0 He was so nice and I think he was the only person that didn\u2019t try to up-sell us or get us to buy something while we were there.\u00a0 He gave us some great local information and even offered to drive us to a restaurant he recommended.\u00a0 We had over 400 pictures from them!<\/span><\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"color:rgb(0,0,0)\"><span  style=\"font-family:helvetica, sans-serif\"><span  style=\"font-size:12pt\">The photography package that came with our wedding package (Divine) provided 24 pictures.\u00a0 I didn\u2019t want to regret not getting all of them so we ended up paying $300 for all of the pictures the resort photographer took during our ceremony\u2026that was almost 200 more so we have a ton of great pictures!\u00a0 The prints didn\u2019t turn out great, but we have them all on a CD so we can get them reprinted somewhere else.<\/span><\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<\/div>\n<\/div><\/div>\n<p>Thanks for the detailed review!!!\u00a0 Lots of great points.\u00a0 I will be emailing Pastor Risk ASAP.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I had a question regarding your photography choice, if you don't mind me asking.\u00a0 Why didn't you elect to use the photographer that came with the package for before ceremony and reception?\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Did you bring your decorations with you on the plane or did you ship them ahead of time.\u00a0 Between the dress, the welcome bags and welcome stuff, and decorations, I don't think I will have any room for anything else!\u00a0 LOL.\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"amandagguerra@gmail.com","IpAddress":"199.200.25.52","GroupId":39,"GroupName":"Newbie","JoinDate":1433264299,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"agg1975","Id":283358,"Name":"agg1975","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"73.43.251.19","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77311,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e39a59d0cf182a9237eeff90c1277017","RawContent":"&lt;p&gt;@[member=\"agg1975\"] I saw pictures from HDC Photo and thought they looked amazing and I saw a lot of great reviews on here about them. &amp;nbsp;I also read a few reviews on here about people not loving the pictures from the resort. &amp;nbsp;I thought our pictures by the resort photographer turned out fine, but I&#039;m really happy we hired HDC...I loved how much direction he provided! &amp;nbsp;You also have to pay to upgrade your package with the resort photographer if you want any pictures other than just pictures of your ceremony b\/c that&#039;s all that&#039;s included with the wedding package, so either way, you&#039;ll pay more, and I felt like that was something that was worth splurging on since pictures and memories are all you have after it&#039;s all over. &amp;nbsp;Their prices were extremely good...especially compared to photographers in the US. &amp;nbsp;Hope this helps!&lt;\/p&gt;","Attachments":[],"Id":1897780,"PostDate":1433276025,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"283358\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/283358-agg1975\/' title='Member profile'><span itemprop=\"name\">agg1975<\/span><\/a> I saw pictures from HDC Photo and thought they looked amazing and I saw a lot of great reviews on here about them. \u00a0I also read a few reviews on here about people not loving the pictures from the resort. \u00a0I thought our pictures by the resort photographer turned out fine, but I'm really happy we hired HDC...I loved how much direction he provided! \u00a0You also have to pay to upgrade your package with the resort photographer if you want any pictures other than just pictures of your ceremony b\/c that's all that's included with the wedding package, so either way, you'll pay more, and I felt like that was something that was worth splurging on since pictures and memories are all you have after it's all over. \u00a0Their prices were extremely good...especially compared to photographers in the US. \u00a0Hope this helps!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rebeccalightsey@yahoo.com","IpAddress":"74.190.197.204","GroupId":39,"GroupName":"Newbie","JoinDate":1405539863,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279045.jpg?_r=1434956018","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"RebeLight","Id":279045,"Name":"RebeLight","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.8.84.124","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77311,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"96d0ebcc9862b16d6588a0fc103cef03","RawContent":"@[member=\"RebeLight\"] did you have to pay the outside vendor charge to have HDC take your photos","Attachments":[],"Id":1897787,"PostDate":1433280123,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"279045\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/279045-rebelight\/' title='Member profile'><span itemprop=\"name\">RebeLight<\/span><\/a> did you have to pay the outside vendor charge to have HDC take your photos\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"dibo930@aol.com","IpAddress":"50.8.84.124","GroupId":39,"GroupName":"Newbie","JoinDate":1432767962,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283278.jpg?_r=1439751768","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"Dina821","Id":283278,"Name":"Dina821","IsOnline":false}}],"Pages":{"TotalItems":208,"TotalPages":21,"CurrentPage":180,"NextPage":190,"PreviousPage":170,"LastPage":200},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
