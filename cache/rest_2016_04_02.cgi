{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":6,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":true,"Views":705,"MovedTo":null,"MovedOn":0,"FirstPostId":1892289,"Rating":0,"RatingHits":0,"Starter":{"Id":279723,"Name":"lornj29","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1428502340,"LastPoster":{"Id":286134,"Name":"kelbiiz11","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286134.jpg?_r=1458458071","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":34,"Preview":{"Id":1892289,"PostDate":1428502340,"PostContent":"Hi Everyone, just wondering if anyone can share with \u00a0me information they are either putting on t...","Author":{"Signature":"","Email":"lornj29@aim.com","IpAddress":"68.192.37.147","GroupId":39,"GroupName":"Newbie","JoinDate":1410109020,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"lornj29","Id":279723,"Name":"lornj29","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.192.32.8","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79034,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"a3766077e80d04f33d846d91c37f7d77","RawContent":"&lt;p&gt;Hi Everyone, just wondering if anyone can share with &amp;nbsp;me information they are either putting on their invitations for guests or their welcome letter if you are getting married in Mexico. I am making a little luggage tag insert in with my invites and I wanted to put some information on there like what to bring, money tips etc. Any suggestions. Also, I am going to start typing my welcome letter and any information on there I should put? I am getting &amp;nbsp;Married at Now Sapphire in Mexico. Also, any suggestions for Welcome bags?? I know I am putting a customized drink holder, hangover kit\/first aid kit, maybe a cell phone waterproof case? Thanks!! I attached my tags what I&#039;ve started already..not much...&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;  &lt;\/p&gt;\n\n\t\t\t\t&amp;nbsp;\n\t\t\n\t\t\t\t&amp;nbsp;\n\t\t\t\n\t\t\t\t\n\n\t\t\t\t\t\t\t\t&amp;nbsp;\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t&amp;nbsp;\n\t\t\t\t\t\t\n\t\t&lt;p&gt;&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1892289,"PostDate":1428502340,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Everyone, just wondering if anyone can share with \u00a0me information they are either putting on their invitations for guests or their welcome letter if you are getting married in Mexico. I am making a little luggage tag insert in with my invites and I wanted to put some information on there like what to bring, money tips etc. Any suggestions. Also, I am going to start typing my welcome letter and any information on there I should put? I am getting \u00a0Married at Now Sapphire in Mexico. Also, any suggestions for Welcome bags?? I know I am putting a customized drink holder, hangover kit\/first aid kit, maybe a cell phone waterproof case? Thanks!! I attached my tags what I've started already..not much...<a class='resized_img' rel='lightbox[1892289]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_04_2015\/post-279723-0-11713800-1428502307.jpg\" title=\"tag.jpg - Size: 270.18KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_04_2015\/post-279723-0-11713800-1428502307.jpg\" class='bbc_img linked-image' alt=\"tag.jpg\" \/><\/a>\n\n<a class='resized_img' rel='lightbox[1892289]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_04_2015\/post-279723-0-03054400-1428502311.jpg\" title=\"tagback.JPG - Size: 167.64KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_04_2015\/post-279723-0-03054400-1428502311.jpg\" class='bbc_img linked-image' alt=\"tagback.JPG\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0\u00a0<\/p>\n\n\t\t\t\t\u00a0\n\t\t\n\t\t\t\t\u00a0\n\t\t\t\n\t\t\t\t<br>\n\t\t\t\t\t\t\t\t\u00a0\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\u00a0\n\t\t\t\t\t\t\n\t\t<p>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lornj29@aim.com","IpAddress":"68.192.37.147","GroupId":39,"GroupName":"Newbie","JoinDate":1410109020,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"lornj29","Id":279723,"Name":"lornj29","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.51.123.197","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79034,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"7406819ef20e8ecbef726073c0bff9d8","RawContent":"&lt;p&gt;@[member=\"lornj29\"]&lt;\/p&gt;\n&lt;p&gt;I am getting married in Mexico next week!&lt;\/p&gt;\n&lt;p&gt;I posted photos of my invitation under my gallery.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;As far as the welcome letter, I also posted a photo of it on my planning journal (I think page 16).&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I hope this helps!&lt;\/p&gt;","Attachments":[],"Id":1892340,"PostDate":1428515540,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"279723\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/279723-lornj29\/' title='Member profile'><span itemprop=\"name\">lornj29<\/span><\/a><\/p>\n<p>I am getting married in Mexico next week!<\/p>\n<p>I posted photos of my invitation under my gallery.\u00a0<\/p>\n<p>As far as the welcome letter, I also posted a photo of it on my planning journal (I think page 16).\u00a0<\/p>\n<p>I hope this helps!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-size:14px;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><strong><span style=\"color:#ff6666;\">I love him & he loves me, we'll be married by the sea.<\/span><\/strong><\/span><\/span><br>\n\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77696-our-dw-dreams-riviera-cancun-17-apr-2015\/'>Planning\u00a0Journal<\/a>\u00a0& <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/blog\/86-my-destination-wedding-blog\/'>Blog<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/delsolphotography.com\/beach-wedding-dreams-riviera-cancun-tj\/'>My wedding pictures from Del Sol Photography<\/a><\/p>\n<p>\u00a0","Email":"tricia.d.davis@gmail.com","IpAddress":"97.91.185.236","GroupId":3,"GroupName":"Member","JoinDate":1396280519,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277418.jpg?_r=1429976005","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"pddcmc","Id":277418,"Name":"pddcmc","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.192.32.8","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79034,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"24c630764043d708f2547856d39521c3","RawContent":"&lt;p&gt;@[member=\"pddcmc\"]&lt;\/p&gt;\n&lt;p&gt;thanks so much! I don&#039;t see it on page 16, but i do love your water bottles! what did you put inside and do you have a list of what your bringing for welcome bags and your favors? You seem so organized. Congratulations! I am getting married in August and I feel so behind!!&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1892372,"PostDate":1428519060,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"277418\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277418-pddcmc\/' title='Member profile'><span itemprop=\"name\">pddcmc<\/span><\/a><\/p>\n<p>thanks so much! I don't see it on page 16, but i do love your water bottles! what did you put inside and do you have a list of what your bringing for welcome bags and your favors? You seem so organized. Congratulations! I am getting married in August and I feel so behind!!\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lornj29@aim.com","IpAddress":"68.192.37.147","GroupId":39,"GroupName":"Newbie","JoinDate":1410109020,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"lornj29","Id":279723,"Name":"lornj29","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.51.123.197","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79034,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"afdb82bf898a7450d89425c4dede125a","RawContent":"&lt;p&gt;1. Don&#039;t worry about feeling behind (easier said than done!), we are STILL working on things...and we leave Wednesday!!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;2. Welcome Letter - sorry, page 18&amp;nbsp; ;)&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/topic\/77696-our-dw-dreams-riviera-cancun-17-apr-2015\/?p=1892314&#039;&gt;http:\/\/www.bestdestinationwedding.com\/topic\/77696-our-dw-dreams-riviera-cancun-17-apr-2015\/?p=1892314&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;3. Welcome Gifts&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/topic\/77696-our-dw-dreams-riviera-cancun-17-apr-2015\/?p=1891194&#039;&gt;http:\/\/www.bestdestinationwedding.com\/topic\/77696-our-dw-dreams-riviera-cancun-17-apr-2015\/?p=1891194&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/topic\/77696-our-dw-dreams-riviera-cancun-17-apr-2015\/?p=1891179&#039;&gt;http:\/\/www.bestdestinationwedding.com\/topic\/77696-our-dw-dreams-riviera-cancun-17-apr-2015\/?p=1891179&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;We aren&#039;t doing actual bags..&lt;\/p&gt;\n&lt;p&gt;If you are talking about tote bags, beach bags, what have you and putting the OOT items in it, I think it is a sweet idea, but impractical\/needless money expense. For example, I&#039;ve noticed that usually the people who want to use a bag, bring their own. Also, most of the time the men won&#039;t use them, and furthermore, chances are, guests will never use them again. And as far as simple, party gift bags, again, guests will look at them for 5 secs and toss them- waste of money in my eyes.\n\nSo, I&#039;ve decided to spend a little more on double wall insulated cups that I know all of our guests will use while they are there and \"stuff\" them with the OOT items and Welcome Letter. As far as gifts, well, see my response \"#1.\" lol&lt;\/p&gt;","Attachments":[],"Id":1892400,"PostDate":1428529790,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>1. Don't worry about feeling behind (easier said than done!), we are STILL working on things...and we leave Wednesday!!!<\/p>\n<p>\u00a0<\/p>\n<p>2. Welcome Letter - sorry, page 18\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/><\/p>\n<p><a href='http:\/\/www.bestdestinationwedding.com\/topic\/77696-our-dw-dreams-riviera-cancun-17-apr-2015\/?p=1892314' class='bbc_url' title=''>http:\/\/www.bestdesti...2015\/?p=1892314<\/a><\/p>\n<p>\u00a0<\/p>\n<p>3. Welcome Gifts<\/p>\n<p><a href='http:\/\/www.bestdestinationwedding.com\/topic\/77696-our-dw-dreams-riviera-cancun-17-apr-2015\/?p=1891194' class='bbc_url' title=''>http:\/\/www.bestdesti...2015\/?p=1891194<\/a><\/p>\n<p><a href='http:\/\/www.bestdestinationwedding.com\/topic\/77696-our-dw-dreams-riviera-cancun-17-apr-2015\/?p=1891179' class='bbc_url' title=''>http:\/\/www.bestdesti...2015\/?p=1891179<\/a><\/p>\n<p>We aren't doing actual bags..<\/p>\n<p>If you are talking about tote bags, beach bags, what have you and putting the OOT items in it, I think it is a sweet idea, but impractical\/needless money expense. For example, I've noticed that usually the people who want to use a bag, bring their own. Also, most of the time the men won't use them, and furthermore, chances are, guests will never use them again. And as far as simple, party gift bags, again, guests will look at them for 5 secs and toss them- waste of money in my eyes.<br>\nSo, I've decided to spend a little more on double wall insulated cups that I know all of our guests will use while they are there and \"stuff\" them with the OOT items and Welcome Letter. As far as gifts, well, see my response \"#1.\" lol<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-size:14px;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><strong><span style=\"color:#ff6666;\">I love him & he loves me, we'll be married by the sea.<\/span><\/strong><\/span><\/span><br>\n\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77696-our-dw-dreams-riviera-cancun-17-apr-2015\/'>Planning\u00a0Journal<\/a>\u00a0& <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/blog\/86-my-destination-wedding-blog\/'>Blog<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/delsolphotography.com\/beach-wedding-dreams-riviera-cancun-tj\/'>My wedding pictures from Del Sol Photography<\/a><\/p>\n<p>\u00a0","Email":"tricia.d.davis@gmail.com","IpAddress":"97.91.185.236","GroupId":3,"GroupName":"Member","JoinDate":1396280519,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277418.jpg?_r=1429976005","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"pddcmc","Id":277418,"Name":"pddcmc","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.41.59","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79034,"EditedBy":"<strong>Edited by calgarybride2015, 08 April 2015 - 02:53 PM.<\/strong>","EditDate":1428533637,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"dbfa3b0a97a1b4c6f73b614d41b70c8d","RawContent":"&lt;p&gt;hello!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;On our invites we just directed people to our wedding website for more information.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;On our website we had information on booking, the prices, RSVP, resort information\/good to know tips, etc. As we went along we had an updates page for things that changed or were being firmed up and had the wedding day timeline. Also had the bridal party, pictures, etc. &amp;nbsp;The tips page had things like what types of clothes to bring, what extras to bring like bubba mug, enough sunscreen and such, meds, tipping money, not to drink their water, things we had learned about the resort (bring snorkeling gear, water shoes, etc.) &amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;In our pre-travel brochure we did the wedding day timeline, welcome drinks, what an all inclusive means, things to remember - reiterated what was on the website, then talked about tipping, having your passport, immigration card, where to get transfers, etc. &amp;nbsp;Also mentioned our wedpics account.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;A couple days before we left we also emailed everyone and reiterated most things and firmed up times.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We did a welcome gift - we did a tumbler with a hangover kit inside (advil, tums, pepto, mentos, hand sani, nail file, emergen c, bandaids, etc.)&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;d show you my wedding website but I deleted it -- I know I cut and paste my list in here somewhere if I can find the post. You can see my pre travel brochure in my planning thread on page 1&lt;\/p&gt;","Attachments":[],"Id":1892404,"PostDate":1428533376,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>hello!<\/p>\n<p>\u00a0<\/p>\n<p>On our invites we just directed people to our wedding website for more information.<\/p>\n<p>\u00a0<\/p>\n<p>On our website we had information on booking, the prices, RSVP, resort information\/good to know tips, etc. As we went along we had an updates page for things that changed or were being firmed up and had the wedding day timeline. Also had the bridal party, pictures, etc. \u00a0The tips page had things like what types of clothes to bring, what extras to bring like bubba mug, enough sunscreen and such, meds, tipping money, not to drink their water, things we had learned about the resort (bring snorkeling gear, water shoes, etc.) \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>In our pre-travel brochure we did the wedding day timeline, welcome drinks, what an all inclusive means, things to remember - reiterated what was on the website, then talked about tipping, having your passport, immigration card, where to get transfers, etc. \u00a0Also mentioned our wedpics account.<\/p>\n<p>\u00a0<\/p>\n<p>A couple days before we left we also emailed everyone and reiterated most things and firmed up times.<\/p>\n<p>\u00a0<\/p>\n<p>We did a welcome gift - we did a tumbler with a hangover kit inside (advil, tums, pepto, mentos, hand sani, nail file, emergen c, bandaids, etc.)\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I'd show you my wedding website but I deleted it -- I know I cut and paste my list in here somewhere if I can find the post. You can see my pre travel brochure in my planning thread on page 1<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399428602,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"171.248.131.151","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79034,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d20fa6f8e59dcc1bc26b8ffbc80de78d","RawContent":"&lt;p&gt;Very cool!!! it&#039;s beautiful... :wub:&lt;\/p&gt;","Attachments":[],"Id":1911627,"PostDate":1457335425,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Very cool!!! it's beautiful... <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wub.png' class='bbc_emoticon' alt=':wub:' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><a data-ipb='nomediaparse' href='http:\/\/u99bet.net\/ca-do-bong-da-online-ca-cuoc-the-thao-truc-tuyen\/'>7m<\/a>","Email":"kelbiiz001@gmail.com","IpAddress":"14.161.15.242","GroupId":39,"GroupName":"Newbie","JoinDate":1454582397,"Photo":{"HasPhoto":true,"PhotoUr