{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":336,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":71361,"MovedTo":null,"MovedOn":0,"FirstPostId":682794,"Rating":0,"RatingHits":0,"Starter":{"Id":211850,"Name":"sstotz","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211850.gif?_r=0","PhotoWidth":100,"PhotoHeight":80,"PhotoType":"custom"},"IsOnline":false},"StartDate":1241698287,"LastPoster":{"Id":287072,"Name":"DJSE","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-287072.jpg?_r=1466551557","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":45,"Preview":{"Id":1914180,"PostDate":1464981784,"PostContent":"Hey everyone. I DJ weddings quite often. Here is one of my playlists. If you play these songs in...","Author":{"Signature":"","Email":"mpmayo@hotmail.com","IpAddress":"99.246.167.113","GroupId":39,"GroupName":"Newbie","JoinDate":1464981291,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-287072.jpg?_r=1466551557","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"DJSE","Id":287072,"Name":"DJSE","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":35820,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8ffd160f686daed1edc3a94b9502c27d","RawContent":"44 days to go, and we are FINALLY starting to get together our playlist for our Ipod wedding.. \n \n A while back Tammy put her playlist out and that really helped.. I&#039;ve tried to find more, but I only see individual song suggestions.\n \n If you wrote out your complete playlist, please respond with it. I&#039;d love to check it out! THANK YOU SO MUCH!","Attachments":[],"Id":682794,"PostDate":1241698287,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                44 days to go, and we are FINALLY starting to get together our playlist for our Ipod wedding.. <br \/> <br \/> A while back Tammy put her playlist out and that really helped.. I've tried to find more, but I only see individual song suggestions.<br \/> <br \/> If you wrote out your complete playlist, please respond with it. I'd love to check it out! THANK YOU SO MUCH!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>~Soon to be Shanny May<\/span><br><span>June 20th, 2009<\/span><br><span>Cabo San Lucas, MX<\/span><br><br><a data-ipb='nomediaparse' href=\"http:\/\/ticker.7910.org\/as1cEXY0g410000MTAwMzM1bHN8MDE1NnN8T3VyIFdlZGRpbmcgQ291bnRkb3duISE.gif\">http:\/\/ticker.7910.org\/as1cEXY0g4100...nRkb3duISE.gif<\/a><\/div><\/div>","Email":"sstotz@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1221948803,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211850.gif?_r=0","PhotoWidth":100,"PhotoHeight":80,"PhotoType":"custom"},"FormattedName":"sstotz","Id":211850,"Name":"sstotz","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":35820,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":6,"IsLiked":false,"PostKey":"6dbe6841850e597ef55a5440d0a42fb5","RawContent":"Here is my entire list:\n &lt;strong&gt;Prelude: &lt;\/strong&gt;\n Lost in This Moment &#8211; Big &amp;amp; Rich &#8211; Guests seated\n I&#8217;ll Stand By You &#8211; Carry Underwood (Mom&#8217;s pouring sand foundation)\n Burning Love &#8211; Elvis (2:57) &#8211; Boys take their places\n \n &lt;strong&gt;Processional:&lt;\/strong&gt;\n Over the Rainbow\/&#8211; Israel Kamakawiwo&#8217;ole (4:49)\n \n &lt;strong&gt;Ceremony:&lt;\/strong&gt;\n Bless the Broken Road &#8211; Rascal Flatts (4:0&lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cool.gif\" border=\"0\" alt=\"\" title=\"Cool\" class=\"inlineimg\" \/&gt;\n \n &lt;strong&gt;Recessional:&lt;\/strong&gt;\n Walking on Sunshine &#8211; Aly &amp;amp; AJ (3:53)\n \n &lt;strong&gt;Dinner:&lt;\/strong&gt;\n Better Together &#8211; Jack Johnson\n Bubbly &#8211; Colbie Caillat\n Build Me Up Buttercup &#8211; The Foundations\n Ever Ever After &#8211; Carrie Underwood\n Every Little Thing She Does is Magic &#8211; The Police\n Heaven &#8211; DJ Sammy\n I Got You &#8211; James Brown\n I Wanna Grow Old with You &#8211; Adam Sandler\n If You Wanna Be Happy &#8211; Jimmy Soul\n Isn&#8217;t She Lovely &#8211; Stevie Wonder\n Kiss the Girl &#8211; Disney\n Landslide &#8211; Fleetwood Mac\n Mexico &#8211; James Taylor\n One Love &#8211; Bob Marley\n Over the Rainbow\/&#8211; Israel Kamakawiwo&#8217;ole\n Red Wine &#8211; UB40\n Then He Kissed Me &#8211; The Crystals\n Volcano &#8211; Jimmy Buffet\n Would You Go With Me? &#8211; Josh Turner\n Wouldn&#8217;t it be Nice &#8211; Beach Boys\n \n &lt;strong&gt;Reception:&lt;\/strong&gt;\n Baby got Back &#8211; Sir Mix A Lot\n Brown Eyed Girl &#8211; Van Morrison\n Blister In the Sun &#8211; Violent Femmes\n Celebration &#8211; Kool &amp;amp; the Gang\n Cha Cha Slide &#8211; Casper C\n Come on Eileen &#8211; Dexy&#8217;s Midnight Runners\n Come What May &#8211; Moulin Rouge Soundtrack\n Dancing in the Dark &#8211; Bruce Springsteen\n Footloose &#8211; Kenny Loggins \n Dancing Queen &#8211; Abba\n Do you Wanna Dance &#8211; Beach Boys\n Every Breath you Take &#8211; UB40\n Get the Party Started &#8211; Pink\n Girls Just Want to Have Fun &#8211; Cyndi Lauper\n Glamorous &#8211; Fergie\n Hey Ya - Outkast\n Hot, Hot, Hot &#8211; Buster Poindexter\n I Love Rock N&#8217; Roll &#8211; Britney Spears\n Let&#8217;s Hear it for the Boy &#8211; Deniece Williams\n Life is a Highway &#8211; Rascal Flatts\n Margaritaville &#8211; Jimmy Buffet\n Mony, Mony &#8211; Billy Idol\n Pon De Replay &#8211; Rihanna\n Pour Some Sugar on Me &#8211; Def Leopard\n Shout &#8211; Otis Day\n SOS &#8211; Rihanna\n Sugar Pie Honey Bunch (I Can&#8217;t Help Myself)\n Summer of 69 &#8211; Bryan Adams\n Sweet Caroline &#8211; Neil Diamond\n The Way we Are &#8211; Timbaland\n What I like About You &#8211; Romantics\n Yeah - Usher\n YMCA &#8211; Village People\n I&#8217;ve Had the Time of My Life &#8211; Dirty Dancing Soundtrack\n Last Dance &#8211; Donna Summers\n \n &lt;strong&gt;Slow Songs:&lt;\/strong&gt;\n You Are &#8211; Jimmy Wayne &#8211; First Dance\n Can&#8217;t Help Falling in Love &#8211; Elvis\n Lost in this Moment &#8211; Big &amp;amp; Rich\n Love of a Lifetime &#8211; Firehouse\n I&#8217;ll Stand by You &#8211; Carrie Underwood\n I Got You &#8211; James Brown\n I&#8217;ll Be &#8211; Edwin McCain\n Satellite &#8211; Dave Matthews\n Sunday Morning &#8211; Maroon 5\n The Way you Look Tonight &#8211; Michael Buble\n When the Stars Go Blue &#8211; Tim McGraw\n When You Say Nothing At All &#8211; Ronan Keating","Attachments":[],"Id":683177,"PostDate":1241715945,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"te