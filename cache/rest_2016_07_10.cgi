> URL: /index.php?/REST/users/messenger/addReply?SessionId=e83435c5c09f884e32b8e889735a4e09
> User lorishultz2016 (284536)
array (
  '/REST/users/messenger/addReply?SessionId' => 'e83435c5c09f884e32b8e889735a4e09',
  'module' => 'REST',
  'section' => 'run',
  'request_method' => 'post',
  'app' => 'REST_Service',
  'application' => 'users',
  'class' => 'messenger',
  'operation' => 'addReply',
  'SessionId' => 'e83435c5c09f884e32b8e889735a4e09',
  'conversationId' => '13828',
  'messageContent' => 'I do not have kids going. And you could have weather but most if the time it is and out in the matter of mins. I would compare the rates from April and June. I just know that a lot if people travel in April . and I would really check out with a travel agent. I can tell you the one that supports thus website is really good. I know the rate we got for person per night was 129.00 and the airline tickets were about 750. Round trip. But that could be less or more for you depending on where you start from. And why the kids are only 50 dollars different to me sounds way to high. But like I said I don\'t have kids going. Only teenagers. If you need more help please let me know. I don\'t mind helping you at all.😊',
  'sessionId' => 'e83435c5c09f884e32b8e889735a4e09',
)
