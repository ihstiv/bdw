3b9978e8197fa212dab427f","RawContent":"&lt;p&gt;No problem!!&lt;\/p&gt;","Attachments":[],"Id":1889763,"PostDate":1426609928,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>No problem!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"katie_mcbride48@yahoo.ca","IpAddress":"199.85.228.129","GroupId":39,"GroupName":"Newbie","JoinDate":1424096250,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282132.jpg?_r=1437519508","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"KatieMcBride","Id":282132,"Name":"KatieMcBride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"131.137.245.208","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78920,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6e33bb4242a7d9288d1c85b4b504e52d","RawContent":"&lt;p&gt;Downtown by Macklemoor&lt;\/p&gt;","Attachments":[],"Id":1913514,"PostDate":1462885240,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Downtown by Macklemoor<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"adamphall@ymail.com","IpAddress":"131.137.245.206","GroupId":40,"GroupName":"Jr. Member","JoinDate":1462864536,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286918.jpg?_r=1462901352","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"AdamnJenn17","Id":286918,"Name":"AdamnJenn17","IsOnline":false}}],"Id":"78920","Title":"Fun Songs For The Reception?!","LastPostDate":1462885240},"Pages":{"TotalItems":9,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
