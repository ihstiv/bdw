{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":527,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":true,"Views":25847,"MovedTo":null,"MovedOn":0,"FirstPostId":1896780,"Rating":0,"RatingHits":0,"Starter":{"Id":281803,"Name":"Ruzanna","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281803.jpg?_r=1431571558","PhotoWidth":200,"PhotoHeight":160,"PhotoType":"custom"},"IsOnline":false},"StartDate":1432216355,"LastPoster":{"Id":287791,"Name":"SamanthaElizabeth","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-287791.jpg?_r=1474569584","PhotoWidth":200,"PhotoHeight":199,"PhotoType":"facebook"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1914932,"PostDate":1468977502,"PostContent":"I'll be in ON in a week! My only date is Aug 5 and that comes after a long day at Canada's Wonder...","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.142.4.206","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79202,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"98c157668b9b4a549d23a38a6c0d4040","RawContent":"&lt;p&gt;I&#039;m pretty much a maybe at this point. May and June can tend to me really busy for me. Let me know what you girls decide on.&lt;\/p&gt;","Attachments":[],"Id":1913364,"PostDate":1462524565,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I'm pretty much a maybe at this point. May and June can tend to me really busy for me. Let me know what you girls decide on.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419423414,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1453235488","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"pjay","Id":281478,"Name":"pjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"158.106.64.94","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79202,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3dd9df77e5d08b340b4ebb839310addf","RawContent":"&lt;p&gt;Hi ladies. I definitely am looking forward to the next meet up. I had to leave early from the last one just with not feeling great. But we will have 2 new brides and the last bride to be to meet up with! I can&#039;t believe that will be the entire group covered!! Wow.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Dates for me for may are a bit tough. We leave for Vancouver on Tuesday night for my dad&#039;s 95th on Wednesday so the 13h is no good for me. As Ashley said, the long weekend is the 20th and we&#039;re already booked with the trailer for the first camping weekend so that poofs the 20th too. We&#039;re doing a concert in Niagara Falls on the 27th so that trashes that date for me too. Our entire month of May for weekends has been booked. It&#039;s nuts.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;What about another night of the week, and maybe just making it an earlier night? Would that work for anyone? I&#039;m fine through June but I&#039;m sure we would all like to see @[member=\"ashhtayy\"] before she leaves. If we can&#039;t do a date, then definitely one when she&#039;s back.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;The other thing is @[member=\"calgarybride2015\"] is going to be visiting in August so we definitely need to put a date together for when she&#039;s here!!!&lt;\/p&gt;","Attachments":[],"Id":1913375,"PostDate":1462543601,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi ladies. I definitely am looking forward to the next meet up. I had to leave early from the last one just with not feeling great. But we will have 2 new brides and the last bride to be to meet up with! I can't believe that will be the entire group covered!! Wow.<\/p>\n<p>\u00a0<\/p>\n<p>Dates for me for may are a bit tough. We leave for Vancouver on Tuesday night for my dad's 95th on Wednesday so the 13h is no good for me. As Ashley said, the long weekend is the 20th and we're already booked with the trailer for the first camping weekend so that poofs the 20th too. We're doing a concert in Niagara Falls on the 27th so that trashes that date for me too. Our entire month of May for weekends has been booked. It's nuts.<\/p>\n<p>\u00a0<\/p>\n<p>What about another night of the week, and maybe just making it an earlier night? Would that work for anyone? I'm fine through June but I'm sure we would all like to see @<a hovercard-ref=\"member\" hovercard-id=\"282006\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282006-ashhtayy\/' title='Member profile'><span itemprop=\"name\">ashhtayy<\/span><\/a> before she leaves. If we can't do a date, then definitely one when she's back.<\/p>\n<p>\u00a0<\/p>\n<p>The other thing is @<a hovercard-ref=\"member\" hovercard-id=\"277873\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277873-calgarybride2015\/' title='Member profile'><span itemprop=\"name\">calgarybride2015<\/span><\/a> is going to be visiting in August so we definitely need to put a date together for when she's here!!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/'><span style=\"color:#ff0099;\"><em>http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;484\/st\/20111020\/e\/Our+Wedding\/k\/6168\/event.png\" alt=\"event.png\"><\/a>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.66.68.111","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79202,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"0ba80b85267bd647804c1194b0fd99f7","RawContent":"Thanks for thinking of me. I&#039;ve been MIA around here and Facebook (apologize for no responses to some things. Trying to catch up). \n\n\nWe are booked for July 28-Aug 6.   Given our timeline (Shawn&#039;s family doesn&#039;t live in Toronto) I would be looking at August 5 Friday evening after Canada&#039;s Wonderland. \n\n\nIf it doesn&#039;t work it doesn&#039;t. I totally understand and can&#039;t really give much more for flexibility lol. \n\n\nIf it does yay!\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1913387,"PostDate":1462584300,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks for thinking of me. I've been MIA around here and Facebook (apologize for no responses to some things. Trying to catch up). <br><br>\nWe are booked for July 28-Aug 6.   Given our timeline (Shawn's family doesn't live in Toronto) I would be looking at August 5 Friday evening after Canada's Wonderland. <br><br>\nIf it doesn't work it doesn't. I totally understand and can't really give much more for flexibility lol. <br><br>\nIf it does yay!<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.13.219","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79202,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7f909ae899203853861e51c5561576a2","RawContent":"@[member=\"calgarybride2015\"]  ha ha that&#039;s perfect for me!!! We get home on the Monday, which is the long weekend here, from Boston by way of Saint John NB and Doug&#039;s parents 60th wedding anniversary so that would be great!!!","Attachments":[],"Id":1913398,"PostDate":1462640924,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"277873\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277873-calgarybride2015\/' title='Member profile'><span itemprop=\"name\">calgarybride2015<\/span><\/a>  ha ha that's perfect for me!!! We get home on the Monday, which is the long weekend here, from Boston by way of Saint John NB and Doug's parents 60th wedding anniversary so that would be great!!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/'><span style=\"color:#ff0099;\"><em>http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;484\/st\/20111020\/e\/Our+Wedding\/k\/6168\/event.png\" alt=\"event.png\"><\/a>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.66.68.111","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79202,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"ff84b226dfadd66185021693cce276cb","RawContent":"That&#039;s good! I think it will work. I have no idea what&#039;s at Canada&#039;s wonderland and how long it takes but after you are all done work and such I think we&#039;d be done. \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1913400,"PostDate":1462642123,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                That's good! I think it will work. I have no idea what's at Canada's wonderland and how long it takes but after you are all done work and such I think we'd be done. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.134.141.162","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79202,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"11cb0309bb06e8d5748f7bed329f482b","RawContent":"&lt;p&gt;Sorry I missed all this! &amp;nbsp;May 13th I have a work function, let me know if there are any other dates on the table.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Would love to you&amp;nbsp;@[member=\"calgarybride2015\"] and Aug 5th looks good for me at the moment!&lt;\/p&gt;","Attachments":[],"Id":1913676,"PostDate":1463059494,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Sorry I missed all this! \u00a0May 13th I have a work function, let me know if there are any other dates on the table.<\/p>\n<p>\u00a0<\/p>\n<p>Would love to you\u00a0@<a hovercard-ref=\"member\" hovercard-id=\"277873\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277873-calgarybride2015\/' title='Member profile'><span itemprop=\"name\">calgarybride2015<\/span><\/a> and Aug 5th looks good for me at the moment!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div><img src=\"http:\/\/\" alt=\"\"><\/div>\n<div><br><div>\u00a0<a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;32;116\/st\/20160430\/e\/we+say+I+do%21\/k\/8afc\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<\/div>\n<p>\u00a0<\/p>\n<p>My Planning Thread:<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79580-deecols-planning-thread-gbp-april-30th-2016\/#entry1904529'>http:\/\/www.bestdestinationwedding.com\/topic\/79580-deecols-planning-thread-gbp-april-30th-2016\/#entry1904529<\/a>","Email":"deannaproteau@hotmail.com","IpAddress":"207.134.141.162","GroupId":3,"GroupName":"Member","JoinDate":1421428169,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281751.jpg?_r=1463440164","PhotoWidth":200,"PhotoHeight":136,"PhotoType":"custom"},"FormattedName":"deecol","Id":281751,"Name":"deecol","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"158.106.64.94","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79202,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"667c6db8e9a90f5793b38dfbe29ea9b5","RawContent":"&lt;p&gt;Ladies - any ideas? We seem to be sort of stuck here lol&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Idea maybe to meet up with Ashley after her wedding? Doesn&#039;t seem like there is a date that&#039;s going to work before she leaves. @[member=\"deecol\"] &amp;nbsp;@[member=\"perianjay\"] &amp;nbsp;@[member=\"krystalball\"] &amp;nbsp;@[member=\"diadiamond\"] &amp;nbsp;@[member=\"Meandhim\"] &amp;nbsp;@[member=\"ashhtayy\"] &amp;nbsp;@[member=\"snswedding2016\"] &amp;nbsp; &amp;nbsp;I know I&#039;m missing somebody.....&lt;\/p&gt;","Attachments":[],"Id":1913784,"PostDate":1463485160,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Ladies - any ideas? We seem to be sort of stuck here lol<\/p>\n<p>\u00a0<\/p>\n<p>Idea maybe to meet up with Ashley after her wedding? Doesn't seem like there is a date that's going to work before she leaves. @<a hovercard-ref=\"member\" hovercard-id=\"281751\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281751-deecol\/' title='Member profile'><span itemprop=\"name\">deecol<\/span><\/a> \u00a0@perianjay \u00a0@<a hovercard-ref=\"member\" hovercard-id=\"281820\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281820-krystalball\/' title='Member profile'><span itemprop=\"name\">krystalball<\/span><\/a> \u00a0@<a hovercard-ref=\"member\" hovercard-id=\"276748\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/276748-diadiamond\/' title='Member profile'><span itemprop=\"name\">diadiamond<\/span><\/a> \u00a0@<a hovercard-ref=\"member\" hovercard-id=\"268499\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/268499-meandhim\/' title='Member profile'><span itemprop=\"name\">Meandhim<\/span><\/a> \u00a0@<a hovercard-ref=\"member\" hovercard-id=\"282006\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282006-ashhtayy\/' title='Member profile'><span itemprop=\"name\">ashhtayy<\/span><\/a> \u00a0@<a hovercard-ref=\"member\" hovercard-id=\"281055\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281055-snswedding2016\/' title='Member profile'><span itemprop=\"name\">snswedding2016<\/span><\/a> \u00a0 \u00a0I know I'm missing somebody.....<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/'><span style=\"color: