shavonne@live.com","IpAddress":"70.30.85.211","GroupId":3,"GroupName":"Member","JoinDate":1365777659,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268499.jpg?_r=1448996983","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"Meandhim","Id":268499,"Name":"Meandhim","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.88.50.208","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79202,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"4e0f690fbd73dc86e525a352762f2b51","RawContent":"I&#039;m so sorry ladies but I can&#039;t make it after all :( Enjoy your night and I hope to see you all at the next meet up.","Attachments":[],"Id":1912708,"PostDate":1460107326,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm so sorry ladies but I can't make it after all <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/sad.png' class='bbc_emoticon' alt=':(' \/> Enjoy your night and I hope to see you all at the next meet up. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ashley.taylor@live.ca","IpAddress":"184.147.135.4","GroupId":3,"GroupName":"Member","JoinDate":1423090661,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282006.jpg?_r=1468890791","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"ashhtayy","Id":282006,"Name":"ashhtayy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.54.142.13","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79202,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"2733f1a14d97dd41761110de384886c0","RawContent":"&lt;p&gt;Hey ladies! I should be there by 6pm. I worked from home today so I&#039;ll be a little later than if I was coming from work but I&#039;ll be there pretty close to the same time. :)&lt;\/p&gt;","Attachments":[],"Id":1912724,"PostDate":1460133932,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hey ladies! I should be there by 6pm. I worked from home today so I'll be a little later than if I was coming from work but I'll be there pretty close to the same time. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>My planning thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78916-snswedding2016-planning-thread-jan-9-2016-azul-fives\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78916-snswedding2016-planning-thread-jan-9-2016-azul-fives\/<\/a><\/p>\n<p>\u00a0<\/p>\n<div><a class='bbc_url' href='http:\/\/www.TickerFactory.com\/'><\/div>\n<div><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10730;0\/st\/20160109\/e\/Our+Wedding\/k\/9fa9\/event.png\" alt=\"event.png\"><\/div>\n<div><\/a><\/div>\n","Email":"sean.n.steph2016@gmail.com","IpAddress":"74.12.52.42","GroupId":3,"GroupName":"Member","JoinDate":1415533111,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281055.jpg?_r=1455040720","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"snswedding2016","Id":281055,"Name":"snswedding2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"142.169.78.71","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79202,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"e0eaac92a150c12502b9e26d3cb09455","RawContent":"I&#039;m here :)\n\n\n\nSent from my iPhone using Tapatalk\n&lt;img src=\"http:\/\/uploads.tapatalk-cdn.com\/20160408\/6e0fde183696b4ced4a669c8cdc96034.jpg\" alt=\"6e0fde183696b4ced4a669c8cdc96034.jpg\"&gt;\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1912727,"PostDate":1460138047,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm here <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br><br><br>\nSent from my iPhone using Tapatalk<br \/><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/uploads.tapatalk-cdn.com\/20160408\/6e0fde183696b4ced4a669c8cdc96034.jpg\" alt=\"6e0fde183696b4ced4a669c8cdc96034.jpg\"><\/span><br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div>\u00a0<\/div>\n<div><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78914-meandhim-grand-palladium-bavaro-nov-2015\/'>My Planning Thread<\/a>\u00a0- MeandHim - Grand Palladium Bavaro - Nov 25 2015<\/div>\n<div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10765;116\/st\/20151125\/e\/Our+Wedding\/k\/461e\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"markandshavonne@live.com","IpAddress":"70.30.85.211","GroupId":3,"GroupName":"Member","JoinDate":1365777659,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268499.jpg?_r=1448996983","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"Meandhim","Id":268499,"Name":"Meandhim","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.13.219","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79202,"EditedBy":"","EditDate":1460725020,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"1e12dd199775f410afb06f7435b7c15d","RawContent":"&lt;p&gt;@[member=\"ashhtayy\"] Ashley I&#039;m so sorry we didn&#039;t get to see you last night. But we all said we would try to have another met up before you leave for you wedding! We would have @[member=\"deecol\"] and @[member=\"krystalball\"] back by then too! Fingers crossed we can work something out!&lt;\/p&gt;","Attachments":[],"Id":1912737,"PostDate":1460200743,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"282006\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282006-ashhtayy\/' title='Member profile'><span itemprop=\"name\">ashhtayy<\/span><\/a> Ashley I'm so sorry we didn't get to see you last night. But we all said we would try to have another met up before you leave for you wedding! We would have @<a hovercard-ref=\"member\" hovercard-id=\"281751\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281751-deecol\/' title='Member profile'><span itemprop=\"name\">deecol<\/span><\/a> and @<a hovercard-ref=\"member\" hovercard-id=\"281820\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281820-krystalball\/' title='Member profile'><span itemprop=\"name\">krystalball<\/span><\/a> back by then too! Fingers crossed we can work something out!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/'><span style=\"color:#ff0099;\"><em>http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;484\/st\/20111020\/e\/Our+Wedding\/k\/6168\/event.png\" alt=\"event.png\"><\/a>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.88.50.208","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79202,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"762e2c987892a624179c7bafaa5b2352","RawContent":"@[member=\"acw271011\"] Sorry Ann - I saw this post and forgot to pop back and reply. I&#039;m sorry I had to bail last minute. Unforunately in my line of work it&#039;s a lot of flying by the seat of your pants. I actually didn&#039;t end up getting home until 9:30 Friday night. I would love to see you all before we go :)\n\n\n@[member=\"krystalball\"] When are you back? We can&#039;t wait to hear about your trip and read about your wedding :)","Attachments":[],"Id":1912852,"PostDate":1460623021,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"232000\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/232000-acw271011\/' title='Member profile'><span itemprop=\"name\">acw271011<\/span><\/a> Sorry Ann - I saw this post and forgot to pop back and reply. I'm sorry I had to bail last minute. Unforunately in my line of work it's a lot of flying by the seat of your pants. I actually didn't end up getting home until 9:30 Friday night. I would love to see you all before we go <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br><br>\n@<a hovercard-ref=\"member\" hovercard-id=\"281820\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281820-krystalball\/' title='Member profile'><span itemprop=\"name\">krystalball<\/span><\/a> When are you back? We can't wait to hear about your trip and read about your wedding <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ashley.taylor@live.ca","IpAddress":"184.147.135.4","GroupId":3,"GroupName":"Member","JoinDate":1423090661,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282006.jpg?_r=1468890791","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"ashhtayy","Id":282006,"Name":"ashhtayy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"200.78.138.245","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79202,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":5,"IsLiked":false,"PostKey":"bb59e54409ce8dab1c9716db6e788df3","RawContent":"[quote name=\"ashhtayy\" post=\"1912852\" timestamp=\"1460637421\"]\n@[member=\"acw271011\"] Sorry Ann - I saw this post and forgot to pop back and reply. I&#039;m sorry I had to bail last minute. Unforunately in my line of work it&#039;s a lot of flying by the seat of your pants. I actually didn&#039;t end up getting home until 9:30 Friday night. I would love to see you all before we go :)\n\n@[member=\"krystalball\"] When are you back? We can&#039;t wait to hear about your trip and read about your wedding :)[\/quote]We fly back on Monday. Just sitting on the beach at Mamita&#039;s Beach Club in Playa taking in as much Mexico as we can. All our guests have gone back home now and we&#039;re  settling in to our Airbnb in Playa del Carmen [emoji4]\n\n[img]http:\/\/uploads.tapatalk-cdn.com\/20160414\/9cc29e1fd295a21ee45aef8bbf4e9f62.jpg[\/img]","Attachments":[],"Id":1912859,"PostDate":1460636112,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>ashhtayy, on 14 April 2016 - 08:37 AM, said:<\/p><div class='blockquote'><div class='quote'><p>@<a hovercard-ref=\"member\" hovercard-id=\"232000\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/232000-acw271011\/' title='Member profile'><span itemprop=\"name\">acw271011<\/span><\/a> Sorry Ann - I saw this post and forgot to pop back and reply. I'm sorry I had to bail last minute. Unforunately in my line of work it's a lot of flying by the seat of your pants. I actually didn't end up getting home until 9:30 Friday night. I would love to see you all before we go <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br><br>\n@<a hovercard-ref=\"member\" hovercard-id=\"281820\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281820-krystalball\/' title='Member profile'><span itemprop=\"name\">krystalball<\/span><\/a> When are you back? We can't wait to hear about your trip and read about your wedding <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p><\/div><\/div>\n<br>\nWe fly back on Monday. Just sitting on the beach at Mamita's Beach Club in Playa taking in as much Mexico as we can. All our guests have gone back home now and we're  settling in to our Airbnb in Playa del Carmen [emoji4]<br><br><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/uploads.tapatalk-cdn.com\/20160414\/9cc29e1fd295a21ee45aef8bbf4e9f62.jpg\" alt=\"9cc29e1fd295a21ee45aef8bbf4e9f62.jpg\"><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div>\u00a0<\/div>\n<div>\u00a0<\/div>\n<div><a class='bbc_url' href='http:\/\/www.TickerFactory.com\/'><\/div>\n<div><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;6\/st\/20160409\/e\/our+Wedding+Day\/k\/a16a\/event.png\" alt=\"event.png\"><\/div>\n<div><\/a><\/div>\n<div>\u00a0<\/div>\n","Email":"krystalball@gmail.com","IpAddress":"158.82.202.5","GroupId":40,"GroupName":"Jr. Member","JoinDate":1421849763,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281820.jpg?_r=1440261411","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"krystalball","Id":281820,"Name":"krystalball","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"158.106.64.94","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79202,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8f831e11ef5c3664e2659bd599b721c4","RawContent":"[quote name=\"krystalball\" post=\"1912859\" timestamp=\"1460650512\"]\nWe fly back on Monday. Just sitting on the beach at Mamita&#039;s Beach Club in Playa taking in as much Mexico as we can. All our guests have gone back home now and we&#039;re settling in to our Airbnb in Playa del Carmen [emoji4]\n\n[img]http:\/\/uploads.tapatalk-cdn.com\/20160414\/9cc29e1fd295a21ee45aef8bbf4e9f62.jpg[\/img][\/quote]\nCan&#039;t wait to see pictures!!! Definitely looks like you&#039;re having a great time.... (thank you for not sending a post card that says \"wish you were here!\")","Attachments":[],"Id":1912884,"PostDate":1460725127,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>krystalball, on 14 April 2016 - 12:15 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>We fly back on Monday. Just sitting on the beach at Mamita's Beach Club in Playa taking in as much Mexico as we can. All our guests have gone back home now and we're settling in to our Airbnb in Playa del Carmen [emoji4]<br><br><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/uploads.tapatalk-cdn.com\/20160414\/9cc29e1fd295a21ee45aef8bbf4e9f62.jpg\" alt=\"9cc29e1fd295a21ee45aef8bbf4e9f62.jpg\"><\/span><\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>Can't wait to see pictures!!! Definitely looks like you're having a great time.... (thank you for not sending a post card that says \"wish you were here!\")<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/'><span style=\"color:#ff0099;\"><em>http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;484\/st\/20111020\/e\/Our+Wedding\/k\/6168\/event.png\" alt=\"event.png\"><\/a>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"158.82.202.5","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79202,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"ff1754e039e36c87755e8077e413eac3","RawContent":"&lt;p&gt;Hi Ladies - wondering if any dates are floating around for another meetup? I missed the last one and miss you all - it&#039;s been a few months since I last saw you!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I know we wanted to have another meetup before Ashley leaves for her wedding, which only gives us a few weeks. I&#039;m free May 20th and June 3rd (possibly May 27th if that&#039;s the consensus, but I&#039;m likely moving that day and Jesse might disagree if I leave to go drinking, lol).&lt;\/p&gt;","Attachments":[],"Id":1913350,"PostDate":1462456197,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Ladies - wondering if any dates are floating around for another meetup? I missed the last one and miss you all - it's been a few months since I last saw you!<\/p>\n<p>\u00a0<\/p>\n<p>I know we wanted to have another meetup before Ashley leaves for her wedding, which only gives us a few weeks. I'm free May 20th and June 3rd (possibly May 27th if that's the consensus, but I'm likely moving that day and Jesse might disagree if I leave to go drinking, lol).<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div>\u00a0<\/div>\n<div>\u00a0<\/div>\n<div><a class='bbc_url' href='http:\/\/www.TickerFactory.com\/'><\/div>\n<div><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;6\/st\/20160409\/e\/our+Wedding+Day\/k\/a16a\/event.png\" alt=\"event.png\"><\/div>\n<div><\/a><\/div>\n<div>\u00a0<\/div>\n","Email":"krystalball@gmail.com","IpAddress":"158.82.202.5","GroupId":40,"GroupName":"Jr. Member","JoinDate":1421849763,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281820.jpg?_r=1440261411","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"krystalball","Id":281820,"Name":"krystalball","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.88.50.208","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79202,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"fc656db1d6aa3c593b3dd065b2662679","RawContent":"My thoughts on proposed dates:\n\n\n- May 20th is the long weekend so I doubt that will work for many people. I am staying local because of the 1000 things I have left on my to do list so if by chance it does work, I could make it work too. \n\n- May 27th is my dads birthday but we likely won&#039;t celebrate until Saturday so that may work for me. \n\n- June 3rd won&#039;t work for me because we will be in Mexico :) We leave the 3rd and return the 17th. \n\n\nMay 13th is super soon but could work for me as well. \n\n\nWhat does everyone think?","Attachments":[],"Id":1913359,"PostDate":1462489111,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                My thoughts on proposed dates:<br><br>\n- May 20th is the long weekend so I doubt that will work for many people. I am staying local because of the 1000 things I have left on my to do list so if by chance it does work, I could make it work too. <br>\n- May 27th is my dads birthday but we likely won't celebrate until Saturday so that may work for me. <br>\n- June 3rd won't work for me because we will be in Mexico <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> We leave the 3rd and return the 17th. <br><br>\nMay 13th is super soon but could work for me as well. <br><br>\nWhat does everyone think?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ashley.taylor@live.ca","IpAddress":"184.147.135.4","GroupId":3,"GroupName":"Member","JoinDate":1423090661,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282006.jpg?_r=1468890791","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"ashhtayy","Id":282006,"Name":"ashhtayy","IsOnline":false}}],"Pages":{"TotalItems":527,"TotalPages":53,"CurrentPage":500,"NextPage":510,"PreviousPage":490,"LastPage":520},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
