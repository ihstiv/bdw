no","LastPostDate":1427275684},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":1,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":558,"MovedTo":null,"MovedOn":0,"FirstPostId":1888108,"Rating":0,"RatingHits":0,"Starter":{"Id":282301,"Name":"wim","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1425361847,"LastPoster":{"Id":282301,"Name":"wim","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":37,"Preview":{"Id":1888108,"PostDate":1425361847,"PostContent":"Dear all, \u00a0 We would like to promote our small Island in the indian ocean named \"Mauritius\" as on...","Author":{"Signature":"","Email":"shane.ramnarain@gmail.com","IpAddress":"41.212.142.73","GroupId":39,"GroupName":"Newbie","JoinDate":1425360909,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"wim","Id":282301,"Name":"wim","IsOnline":false}},"Posts":[],"Id":"78871","Title":"Wedding In Mauritius","LastPostDate":1425361847}],"Pages":{"TotalItems":469,"TotalPages":32,"CurrentPage":0,"NextPage":15,"PreviousPage":-1,"LastPage":465},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
