Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":45,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":3514,"MovedTo":null,"MovedOn":0,"FirstPostId":1896110,"Rating":0,"RatingHits":0,"Starter":{"Id":278120,"Name":"LisaAnthonyPoppy","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278120.jpg?_r=1421810202","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"IsOnline":false},"StartDate":1431519275,"LastPoster":{"Id":278603,"Name":"Sabes44","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278603.jpg?_r=1405559586","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":57,"Preview":{"Id":1896110,"PostDate":1431519275,"PostContent":"Anyone else have cold feet the last 2-3 months before wedding? My fianc\u00e9 is not to blame 100%. ....","Author":{"Signature":"","Email":"lisananth@yahoo.com","IpAddress":"166.137.101.169","GroupId":40,"GroupName":"Jr. Member","JoinDate":1401136433,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278120.jpg?_r=1421810202","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"LisaAnthonyPoppy","Id":278120,"Name":"LisaAnthonyPoppy","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.132.39.247","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79180,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"64dba60d0b93755b4be4a0af473084bc","RawContent":"Anyone else have cold feet the last 2-3 months before wedding? My fianc\u00e9 is not to blame 100%. . I just wish he worked a lot harder and was more manly. It&#039;s been digging at me. We have been together for 4 years we have a daughter together , a great family unit if you will..l I had a 4 year old when we met. Things change now I&#039;m older I want more and he is content living paycheck to  paycheck going to chain restuarants and watch football all night.  I&#039;m a bitch I know but I like to talk have introspective conversations, experience exploration, grow, change. Anyways I met someone a couple months ago who threw a wrench into everything but most importantly they taught me that I do have a good man in Scott and all off this is making me wonder if I&#039;m ready to get married. If I need to feed my garden and watch it bloom.  16 days before we leave and I&#039;m like not even responding to vendors aside from letting them know I&#039;m busy and I&#039;m working on the plans. Is this normal to have doubts? To be scared? Wondering if marriage is where its at? I&#039;m going to start working on plans today, aggggggghhhh why is my mind so critical? I hate it. No judgement please. Thx","Attachments":[],"Id":1896110,"PostDate":1431519275,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Anyone else have cold feet the last 2-3 months before wedding? My fianc\u00e9 is not to blame 100%. . I just wish he worked a lot harder and was more manly. It's been digging at me. We have been together for 4 years we have a daughter together , a great family unit if you will..l I had a 4 year old when we met. Things change now I'm older I want more and he is content living paycheck to  paycheck going to chain restuarants and watch football all night.  I'm a bitch I know but I like to talk have introspective conversations, experience exploration, grow, change. Anyways I met someone a couple months ago who threw a wrench into everything but most importantly they taught me that I do have a good man in Scott and all off this is making me wonder if I'm ready to get married. If I need to feed my garden and watch it bloom.  16 days before we leave and I'm like not even responding to vendors aside from letting them know I'm busy and I'm working on the plans. Is this normal to have doubts? To be scared? Wondering if marriage is where its at? I'm going to start working on plans today, aggggggghhhh why is my mind so critical? I hate it. No judgement please. Thx \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lisananth@yahoo.com","IpAddress":"166.137.101.169","GroupId":40,"GroupName":"Jr. Member","JoinDate":1401136433,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278120.jpg?_r=1421810202","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"LisaAnthonyPoppy","Id":278120,"Name":"LisaAnthonyPoppy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"192.249.47.212","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79180,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":3,"IsLiked":false,"PostKey":"ef3a82cfe236ba4246714a9329248886","RawContent":"&lt;p&gt;@[member=\"LisaAnthonyPoppy\"] Im honestly not even that far into planning or even close to our wedding date but I can already see how stress builds into everything. We have gotten so stressed just picking a resort that we have blown up on each other and I have even questioned should we get married now? Because how wild things have gotten and we arent even into the actual swing of things. Sometimes we allow the small things to cover over the bigger things I guess.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Maybe you need to have a nice talk.. I know that&#039;s so much easier said than done. But communication is key. He needs to know how you feel as you also need to hear how he feels. Maybe hes going out and watching the game to get away. Maybe he overwhelmed as well and has doubts. But you&#039;ll never know unless you speak about it. AS you stated you saw how green your grass truly is. No need to go into the next garden . Your garden has stayed green through these years, you have loved and honored each other and it has brought you to this moment!! To where you want to join together forever. I hope just talking it out even with everyone here on the forum will help ease your stress and worries.!!! Hugs**** :)&lt;\/p&gt;","Attachments":[],"Id":1896112,"PostDate":1431520802,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"278120\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/278120-lisaanthonypoppy\/' title='Member profile'><span itemprop=\"name\">LisaAnthonyPoppy<\/span><\/a> Im honestly not even that far into planning or even close to our wedding date but I can already see how stress builds into everything. We have gotten so stressed just picking a resort that we have blown up on each other and I have even questioned should we get married now? Because how wild things have gotten and we arent even into the actual swing of things. Sometimes we allow the small things to cover over the bigger things I guess.<\/p>\n<p>\u00a0<\/p>\n<p>Maybe you need to have a nice talk.. I know that's so much easier said than done. But communication is key. He needs to know how you feel as you also need to hear how he feels. Maybe hes going out and watching the game to get away. Maybe he overwhelmed as well and has doubts. But you'll never know unless you speak about it. AS you stated you saw how green your grass truly is. No need to go into the next garden . Your garden has stayed green through these years, you have loved and honored each other and it has brought you to this moment!! To where you want to join together forever. I hope just talking it out even with everyone here on the forum will help ease your stress and worries.!!! Hugs**** <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>57 Guest","Email":"racht33@yahoo.com","IpAddress":"192.249.47.212","GroupId":3,"GroupName":"Member","JoinDate":1422632988,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281952.jpg?_r=1424197509","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"racht33","Id":281952,"Name":"racht33","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79180,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"df16d3808cd1ef86d75097c4fe2534e6","RawContent":"&lt;p&gt;I can&#039;t totally relate, but I can say that this wedding planning has been an added stress on my relationship for sure. We are paying for the wedding ourselves and it has really added some stress and unneeded arguments sometimes. I think we all have those moments of questioning as well. I&#039;ve also asked myself if I&#039;m ready to get married, but I&#039;m not sure anyone is really ready. It&#039;s a new stage in life that (most of the time) we aren&#039;t 100% prepared for nor have we experienced before.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I think marriage aside, you should just think about what is it that you love about him and what got you to this point. I don&#039;t think what you are feeling is uncommon because you&#039;re about to make a big commitment. By no means should that be taken lightly.&lt;\/p&gt;","Attachments":[],"Id":1896122,"PostDate":1431523445,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I can't totally relate, but I can say that this wedding planning has been an added stress on my relationship for sure. We are paying for the wedding ourselves and it has really added some stress and unneeded arguments sometimes. I think we all have those moments of questioning as well. I've also asked myself if I'm ready to get married, but I'm not sure anyone is really ready. It's a new stage in life that (most of the time) we aren't 100% prepared for nor have we experienced before.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I think marriage aside, you should just think about what is it that you love about him and what got you to this point. I don't think what you are feeling is uncommon because you're about to make a big commitment. By no means should that be taken lightly.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419437814,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1436293677","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"209.195.165.194","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79180,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"d88370f5244257b585b38387e98e3a14","RawContent":"&lt;p&gt;My fianc\u00e9 and I have been together for almost seven years.&amp;nbsp; I don&#039;t doubt for a second being together forever.&amp;nbsp; Maybe it is because we compliment each other so well but the wedding planning has been a breeze.&amp;nbsp; We are having fun with the planning.&amp;nbsp; He has brought a lot of great ideas to the table (like a shadow box in the shape of Mexico for our guest book alternate-- I would have never thought of that) and he has been really involved which has made it more for us than just for me.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;When you say you met someone what does that mean?&amp;nbsp; Acquaintance? Secret lover? Friend?&amp;nbsp; If your mind is wandering before the wedding that should be a red flag.&amp;nbsp; I don&#039;t think you should&amp;nbsp;blame wedding planning for straining your relationship.&amp;nbsp; This is supposed to be fun.&amp;nbsp; My sister called off her wedding 48 hours before it was supposed to happen.&amp;nbsp; She said she didn&#039;t want to spend the rest of her life sitting on the couch watching TV.&amp;nbsp; She wanted to go out and see the world.&amp;nbsp; If you are unhappy with how he is then it is important to re-evaluate what you want.&amp;nbsp; His job situation likely will not change after the wedding and it&#039;s a lot more expensive to walk away after the wedding than it is to walk away before.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1896130,"PostDate":1431525559,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>My fianc\u00e9 and I have been together for almost seven years.\u00a0 I don't doubt for a second being together forever.\u00a0 Maybe it is because we compliment each other so well but the wedding planning has been a breeze.\u00a0 We are having fun with the planning.\u00a0 He has brought a lot of great ideas to the table (like a shadow box in the shape of Mexico for our guest book alternate-- I would have never thought of that) and he has been really involved which has made it more for us than just for me.<\/p>\n<p>\u00a0<\/p>\n<p>When you say you met someone what does that mean?\u00a0 Acquaintance? Secret lover? Friend?\u00a0 If your mind is wandering before the wedding that should be a red flag.\u00a0 I don't think you should\u00a0blame wedding planning for straining your relationship.\u00a0 This is supposed to be fun.\u00a0 My sister called off her wedding 48 hours before it was supposed to happen.\u00a0 She said she didn't want to spend the rest of her life sitting on the couch watching TV.\u00a0 She wanted to go out and see the world.\u00a0 If you are unhappy with how he is then it is important to re-evaluate what you want.\u00a0 His job situation likely will not change after the wedding and it's a lot more expensive to walk away after the wedding than it is to walk away before.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"andreapurcell1@gmail.com","IpAddress":"73.174.154.76","GroupId":39,"GroupName":"Newbie","JoinDate":1428265257,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282640.png?_r=1433807300","PhotoWidth":200,"PhotoHeight":179,"PhotoType":"custom"},"FormattedName":"andreapurcell1","Id":282640,"Name":"andreapurcell1","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"107.220.24.175","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79180,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"3e6139047b2609285cb86382fb91e2b7","RawContent":"[quote name=\"andreapurcell1\" post=\"1896130\" timestamp=\"1431525559\"]\nMy fianc\u00e9 and I have been together for almost seven years.  I don&#039;t doubt for a second being together forever.  Maybe it is because we compliment each other so well but the wedding planning has been a breeze.  We are having fun with the planning.  He has brought a lot of great ideas to the table (like a shadow box in the shape of Mexico for our guest book alternate-- I would have never thought of that) and he has been really involved which has made it more for us than just for me.\n\nWhen you say you met someone what does that mean?  Acquaintance? Secret lover? Friend?  If your mind is wandering before the wedding that should be a red flag.  I don&#039;t think you should blame wedding planning for straining your relationship.  This is supposed to be fun.  My sister called off her wedding 48 hours before it was supposed to happen.  She said she didn&#039;t want to spend the rest of her life sitting on the couch watching TV.  She wanted to go out and see the world.  If you are unhappy with how he is then it is important to re-evaluate what you want.  His job situation likely will not change after the wedding and it&#039;s a lot more expensive to walk away after the wedding than it is to walk away before.[\/quote]I&#039;m glad you guys are having such a breeze planning but it&#039;s important to remember everyone&#039;s experience is different. I have loved the planning part even though it has mostly been me and I didn&#039;t expect him to care about all the details going into it. Has it been stressfree? Absolutely not! The finances and paying for everything has been super stressful. Has it caused fights? Absolutely! But we work it out together. He prob doesn&#039;t even know we&#039;re supposed to have a guest book! Haha\n\nWe have been together for 5 years, lived together for 2 and we&#039;ve had discussions about not being just roommates. As you get more comfortable there&#039;s not as much effort hence watching tv. Relationships do take effort and it&#039;s important the longer you are together to still take time out and go on dates. Maybe take a break from planning, get a sitter and just spend some quality time together. If the loving feelings are there then yes cold feet. If while you&#039;re with him and your mind wanders to that other person then maybe it does need looked into more. You&#039;re human, other people have crossed my mind but they cross right out of it as well and it goes back to FI. My advice would be to reevaluate how you feel after a date night.","Attachments":[],"Id":1896157,"PostDate":1431534525,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>andreapurcell1, on 13 May 2015 - 05:59 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>My fianc\u00e9 and I have been together for almost seven years.\u00a0 I don't doubt for a second being together forever.\u00a0 Maybe it is because we compliment each other so well but the wedding planning has been a breeze.\u00a0 We are having fun with the planning.\u00a0 He has brought a lot of great ideas to the table (like a shadow box in the shape of Mexico for our guest book alternate-- I would have never thought of that) and he has been really involved which has made it more for us than just for me.<\/p>\n<p>\u00a0<\/p>\n<p>When you say you met someone what does that mean?\u00a0 Acquaintance? Secret lover? Friend?\u00a0 If your mind is wandering before the wedding that should be a red flag.\u00a0 I don't think you should\u00a0blame wedding planning for straining your relationship.\u00a0 This is supposed to be fun.\u00a0 My sister called off her wedding 48 hours before it was supposed to happen.\u00a0 She said she didn't want to spend the rest of her life sitting on the couch watching TV.\u00a0 She wanted to go out and see the world.\u00a0 If you are unhappy with how he is then it is important to re-evaluate what you want.\u00a0 His job situation likely will not change after the wedding and it's a lot more expensive to walk away after the wedding than it is to walk away before.\u00a0<\/p>\n<\/div>\n<\/div><\/div>\n<p>I'm glad you guys are having such a breeze planning but it's important to remember everyone's experience is different. I have loved the planning part even though it has mostly been me and I didn't expect him to care about all the details going into it. Has it been stressfree? Absolutely not! The finances and paying for everything has been super stressful. Has it caused fights? Absolutely! But we work it out together. He prob doesn't even know we're supposed to have a guest book! Haha<\/p>\n<p>\u00a0<\/p>\n<p>We have been together for 5 years, lived together for 2 and we've had discussions about not being just roommates. As you get more comfortable there's not as much effort hence watching tv. Relationships do take effort and it's important the longer you are together to still take time out and go on dates. Maybe take a break from planning, get a sitter and just spend some quality time together. If the loving feelings are there then yes cold feet. If while you're with him and your mind wanders to that other person then maybe it does need looked into more. You're human, other people have crossed my mind but they cross right out of it as well and it goes back to FI. My advice would be to reevaluate how you feel after a date night.\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jsparrow@kent.edu","IpAddress":"74.218.117.250","GroupId":47,"GroupName":"Site Supporter","JoinDate":1400517942,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"jsparrow10","Id":278025,"Name":"jsparrow10","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"64.147.11.58","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79180,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"08fa1dfac8987e6acdaa62213a723815","RawContent":"&lt;p&gt;I am sorry you are going through all this and although I have not had the same feelings I have have had a few \"moments\". &amp;nbsp;I had a big one yesterday and took it out on my fiance and the dog and even told him I didn&#039;t think I could have children anymore. &amp;nbsp;I am just totally overwhelmed with all the planning (which I did 95% by myself, but I do this for a living so hard for him to do much) and I have a work trip across the country next week, which is a week before the wedding. &amp;nbsp;But, I have never thought about not marrying him, I was just having a bad day.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I feel a lot better today, so I know it was just a bad moment for me. &amp;nbsp;That being said, if you have been having these thoughts for months you should probably talk about it. &amp;nbsp;You don&#039;t want to go through with something you are already doubting. &amp;nbsp;Hopefully talking about it will help, sometimes just getting it out in the open helps me and eases my fears even though nothing changed. &amp;nbsp;Good Luck!!!&lt;\/p&gt;","Attachments":[],"Id":1896158,"PostDate":1431534653,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I am sorry you are going through all this and although I have not had the same feelings I have have had a few \"moments\". \u00a0I had a big one yesterday and took it out on my fiance and the dog and even told him I didn't think I could have children anymore. \u00a0I am just totally overwhelmed with all the planning (which I did 95% by myself, but I do this for a living so hard for him to do much) and I have a work trip across the country next week, which is a week before the wedding. \u00a0But, I have never thought about not marrying him, I was just having a bad day.<\/p>\n<p>\u00a0<\/p>\n<p>I feel a lot better today, so I know it was just a bad moment for me. \u00a0That being said, if you have been having these thoughts for months you should probably talk about it. \u00a0You don't want to go through with something you are already doubting. \u00a0Hopefully talking about it will help, sometimes just getting it out in the open helps me and eases my fears even though nothing changed. \u00a0Good Luck!!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sabrabenes@gmail.com","IpAddress":"64.147.11.58","GroupId":40,"GroupName":"Jr. Member","JoinDate":1403208876,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278603.jpg?_r=1405559586","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"Sabes44","Id":278603,"Name":"Sabes44","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"38.112.94.76","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79180,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":5,"IsLiked":false,"PostKey":"f449482a46acafad0ee5b0e53cc48b2b","RawContent":"&lt;p&gt;I just wanted to commend you for being brave and opening up about a topic that is so personal and can make you feel very vulnerable.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I would say talk things out.&amp;nbsp; Be open to talking.&amp;nbsp; I think we all have moments where we just feel like, Omg, l&#039;m getting married.&amp;nbsp; Not just wearing an engagement ring, but actually getting married.&amp;nbsp; It sounds like you are re-evaluating what you value and maybe finding out that things aren&#039;t in line as much as you thought.&amp;nbsp; As another girl said earlier, he could be just retreating because he also feels the stress.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;when&amp;nbsp; you think about your fianc\u00e9, think about him during your entire relationship...all those years count.&amp;nbsp; Evaluate your situation based on the entire picture not just recent feelings of doubt.&amp;nbsp; Stress can do the strangest things to our feelings.&amp;nbsp; I find that sometimes if I dont&#039; open up with people, I tend to get isolated and by talking to people I can usually find my way again.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I hope that you can really sit down with him and discuss things.&amp;nbsp; I wish you happiness regardless of what you decide to do.&amp;nbsp; :)&lt;\/p&gt;","Attachments":[],"Id":1896160,"PostDate":1431535324,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I just wanted to commend you for being brave and opening up about a topic that is so personal and can make you feel very vulnerable.<\/p>\n<p>\u00a0<\/p>\n<p>I would say talk things out.\u00a0 Be open to talking.\u00a0 I think we all have moments where we just feel like, Omg, l'm getting married.\u00a0 Not just wearing an engagement ring, but actually getting married.\u00a0 It sounds like you are re-evaluating what you value and maybe finding out that things aren't in line as much as you thought.\u00a0 As another girl said earlier, he could be just retreating because he also feels the stress.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>when\u00a0 you think about your fianc\u00e9, think about him during your entire relationship...all those years count.\u00a0 Evaluate your situation based on the entire picture not just recent feelings of doubt.\u00a0 Stress can do the strangest things to our feelings.\u00a0 I find that sometimes if I dont' open up with people, I tend to get isolated and by talking to people I can usually find my way again.<\/p>\n<p>\u00a0<\/p>\n<p>I hope that you can really sit down with him and discuss things.\u00a0 I wish you happiness regardless of what you decide to do.\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div><br><div>\u00a0<\/div>\n<div>\u00a0<\/div>\n<div>Married on June 20th, 2015 at the Grand Sunset Princess Riviera Gazebo & Reception at the Chill Out with 60 guests<\/div>\n<div>\u00a0<\/div>\n<\/div>\n<div>\u00a0<\/div>\n<p>My planning thread:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/<\/a><\/p>\n<p>My review thread: \u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/<\/a>","Email":"rebecca.valero@gmail.com","IpAddress":"38.112.94.76","GroupId":3,"GroupName":"Member","JoinDate":1396982852,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277519.jpg?_r=1435850174","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"veryvalentine","Id":277519,"Name":"veryvalentine","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"159.53.78.143","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79180,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":4,"IsLiked":false,"PostKey":"aa21cd9bef665034b6dc9bf4d6dde5fc","RawContent":"&lt;p&gt;I also commend you for being honest. I have a friend who cancelled her wedding a month before because she wasn&#039;t ready to be married. Guess what? Her NOW HUSBAND stayed with her afterward and they got married 2 years later and now have 3 kids. She didn&#039;t want to break up, she just wasn&#039;t ready to be married. I am always in awe of both of them - that she was brave enough to be honest and that he was understanding enough to stick with her.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I do think there are valid times when we shouldn&#039;t ignore our feelings, even when it is the easier thing to do. So I think a \"cold feet\" explanation is probably not productive without real introspection and communication with your partner. I will definitely say there have been a few times over the last couple months where I got MUCH MORE upset over something my fiance did or didn&#039;t do than I ever have before. My sister reminded me that in advance of the wedding you start to think \"I&#039;M GOING TO BE DEALING WITH THIS FOR THE REST OF MY LIFE!\" and it causes some panic. I always say - I&#039;ve only been alive 34 years and I&#039;m making a decision that (with any luck) could last almost double that! Kind of terrifying when you put it that way.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;All the ladies above have already given you great advice, but I just say be really honest with yourself about the root of your feelings and where they are coming from. Even when I&#039;m at my angriest with my fiance, I still have the certainty that I want to marry him and believe that we&#039;ll be one of the couples that make it a lifetime!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck to you. Isn&#039;t great to have so many supportive comments!?! Hope this has brought you some peace today :)&lt;\/p&gt;","Attachments":[],"Id":1896176,"PostDate":1431539197,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I also commend you for being honest. I have a friend who cancelled her wedding a month before because she wasn't ready to be married. Guess what? Her NOW HUSBAND stayed with her afterward and they got married 2 years later and now have 3 kids. She didn't want to break up, she just wasn't ready to be married. I am always in awe of both of them - that she was brave enough to be honest and that he was understanding enough to stick with her.<\/p>\n<p>\u00a0<\/p>\n<p>I do think there are valid times when we shouldn't ignore our feelings, even when it is the easier thing to do. So I think a \"cold feet\" explanation is probably not productive without real introspection and communication with your partner. I will definitely say there have been a few times over the last couple months where I got MUCH MORE upset over something my fiance did or didn't do than I ever have before. My sister reminded me that in advance of the wedding you start to think \"I'M GOING TO BE DEALING WITH THIS FOR THE REST OF MY LIFE!\" and it causes some panic. I always say - I've only been alive 34 years and I'm making a decision that (with any luck) could last almost double that! Kind of terrifying when you put it that way.<\/p>\n<p>\u00a0<\/p>\n<p>All the ladies above have already given you great advice, but I just say be really honest with yourself about the root of your feelings and where they are coming from. Even when I'm at my angriest with my fiance, I still have the certainty that I want to marry him and believe that we'll be one of the couples that make it a lifetime!<\/p>\n<p>\u00a0<\/p>\n<p>Good luck to you. Isn't great to have so many supportive comments!?! Hope this has brought you some peace today <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rebecca.shaffer@gmail.com","IpAddress":"159.53.174.144","GroupId":40,"GroupName":"Jr. Member","JoinDate":1403116087,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"beckys98","Id":278581,"Name":"beckys98","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.132.39.247","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79180,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":6,"IsLiked":false,"PostKey":"d7ca25f8436037e199ad2087b49dfbfc","RawContent":"Thank you women for ALL of your responses. I really really appreciate the fair and considerate responses. It has been on my mind for so long. The person I met came into my life and is no longer in my life. It was a total emotional affair, . I fell for the illusion of this person that wasn&#039;t real. But before that happened I had been talking to Scott about working out a way to make each other happier. Scott asks nothing of me in return. He&#039;s content with whatever. It&#039;s me who wants him to not be counting on me to do everything. I want to feel like a woman. I want to feel like I can relax and I don&#039;t have to do everything. He hasn&#039;t made me feel like a woman in years. Damnit I wanna put on a pair of high heels.Sure if I tell Scott to do something he will do it, but then again I have to essentially beg. He is open to go to counseling with me. My mother walked away from everything even us kids when things got tough. I&#039;m praying that meeting this person and seeing this person out of my life exactly one month 5\/2\/2015  before my wedding is a sign that Scott is my true love and I hope that Scott now sees how serious I am about my feelings of neglect and unfulfillment bc I told him everything about this other person. He cried, I cried and I asked if we should still do this. He said he loves me more than life and he still wants to marry me and he is open to talking to someone and learning how to be more of an emotional and physical provider. Gosh I can&#039;t believe I confessed this all. I&#039;m going to kick it around the whole wedding thing and let you all know. Everyone who knows me tells me he is a great man and loves me unconditionally and this is all very true but I want to feel alive.","Attachments":[],"Id":1896188,"PostDate":1431545666,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thank you women for ALL of your responses. I really really appreciate the fair and considerate responses. It has been on my mind for so long. The person I met came into my life and is no longer in my life. It was a total emotional affair, . I fell for the illusion of this person that wasn't real. But before that happened I had been talking to Scott about working out a way to make each other happier. Scott asks nothing of me in return. He's content with whatever. It's me who wants him to not be counting on me to do everything. I want to feel like a woman. I want to feel like I can relax and I don't have to do everything. He hasn't made me feel like a woman in years. Damnit I wanna put on a pair of high heels.Sure if I tell Scott to do something he will do it, but then again I have to essentially beg. He is open to go to counseling with me. My mother walked away from everything even us kids when things got tough. I'm praying that meeting this person and seeing this person out of my life exactly one month 5\/2\/2015  before my wedding is a sign that Scott is my true love and I hope that Scott now sees how serious I am about my feelings of neglect and unfulfillment bc I told him everything about this other person. He cried, I cried and I asked if we should still do this. He said he loves me more than life and he still wants to marry me and he is open to talking to someone and learning how to be more of an emotional and physical provider. Gosh I can't believe I confessed this all. I'm going to kick it around the whole wedding thing and let you all know. Everyone who knows me tells me he is a great man and loves me unconditionally and this is all very true but I want to feel alive. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lisananth@yahoo.com","IpAddress":"166.137.101.169","GroupId":40,"GroupName":"Jr. Member","JoinDate":1401136433,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278120.jpg?_r=1421810202","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"LisaAnthonyPoppy","Id":278120,"Name":"LisaAnthonyPoppy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"38.112.94.76","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79180,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":3,"IsLiked":false,"PostKey":"9e2f3c551c5eda4f6c7382b5f1f377bb","RawContent":"&lt;p&gt;ughh, wow, you&#039;ve left in me in tears.&amp;nbsp; Again, I commend you for being honest with yourself.  It would&amp;nbsp;be so easy to&amp;nbsp;just focus on the wedding day and ignore the marriage or the after but you are staying true to your heart and good for you.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;m sooo happy you were soo honest.&amp;nbsp; Just from what you wrote I can tell that he loves you.&amp;nbsp; My mom once told me that just because someone doesn&#039;t love you the way YOU want them to love you, doesn&#039;t mean that they don&#039;t love you.&amp;nbsp; (This was probably a direct quote from Oprah I&#039;m sure!) :D&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;All the best !xoxo&lt;\/p&gt;","Attachments":[],"Id":1896189,"PostDate":1431545943,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>ughh, wow, you've left in me in tears.\u00a0 Again, I commend you for being honest with yourself.\u00a0\u00a0It would\u00a0be so easy to\u00a0just focus on the wedding day and ignore the marriage or the after but you are staying true to your heart and good for you.<\/p>\n<p>\u00a0<\/p>\n<p>I'm sooo happy you were soo honest.\u00a0 Just from what you wrote I can tell that he loves you.\u00a0 My mom once told me that just because someone doesn't love you the way YOU want them to love you, doesn't mean that they don't love you.\u00a0 (This was probably a direct quote from Oprah I'm sure!) <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/biggrin.png' class='bbc_emoticon' alt=':D' \/><\/p>\n<p>\u00a0<\/p>\n<p>All the best !xoxo<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div><br><div>\u00a0<\/div>\n<div>\u00a0<\/div>\n<div>Married on June 20th, 2015 at the Grand Sunset Princess Riviera Gazebo & Reception at the Chill Out with 60 guests<\/div>\n<div>\u00a0<\/div>\n<\/div>\n<div>\u00a0<\/div>\n<p>My planning thread:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/<\/a><\/p>\n<p>My review thread: \u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/<\/a>","Email":"rebecca.valero@gmail.com","IpAddress":"38.112.94.76","GroupId":3,"GroupName":"Member","JoinDate":1396982852,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277519.jpg?_r=1435850174","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"veryvalentine","Id":277519,"Name":"veryvalentine","IsOnline":false}}],"Id":"79180","Title":"Cold Feet?","LastPostDate":1433873765},"Pages":{"TotalItems":45,"TotalPages":5,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":40},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
