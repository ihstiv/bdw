{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":10,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":true,"Views":246,"MovedTo":null,"MovedOn":0,"FirstPostId":1900893,"Rating":0,"RatingHits":0,"Starter":{"Id":283920,"Name":"nkavanaugh","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283920.jpg?_r=1436649199","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"StartDate":1437515860,"LastPoster":{"Id":279721,"Name":"Wafflesmom","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279721.jpg?_r=1431039162","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":2,"Preview":{"Id":1900893,"PostDate":1437515860,"PostContent":"Hi All, \u00a0 I am someone who is so unable to make decisions on my own, I also lack the creativity g...","Author":{"Signature":"","Email":"nkavanaugh@bayshore.ca","IpAddress":"174.5.52.216","GroupId":39,"GroupName":"Newbie","JoinDate":1436627144,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283920.jpg?_r=1436649199","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"nkavanaugh","Id":283920,"Name":"nkavanaugh","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"142.169.78.98","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79423,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":4,"IsLiked":false,"PostKey":"219f4088e6e565b370ef6ffe679087d1","RawContent":"&lt;p&gt;Hi All,&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am someone who is so unable to make decisions on my own, I also lack the creativity gene. I have spent countless hours going through the planning threads here and I feel like I have already learned so much. So I thought I would start one myself both to hold my self accountable and to keep track of where I am at in terms of planning. My fianc\u00e9 Steven and I are getting married on May 3rd, 2016 at the Grand Sirenis Rivera Maya.&lt;\/p&gt;","Attachments":[],"Id":1900893,"PostDate":1437515860,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi All,<\/p>\n<p>\u00a0<\/p>\n<p>I am someone who is so unable to make decisions on my own, I also lack the creativity gene. I have spent countless hours going through the planning threads here and I feel like I have already learned so much. So I thought I would start one myself both to hold my self accountable and to keep track of where I am at in terms of planning. My fianc\u00e9 Steven and I are getting married on May 3rd, 2016 at the Grand Sirenis Rivera Maya.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nkavanaugh@bayshore.ca","IpAddress":"174.5.52.216","GroupId":39,"GroupName":"Newbie","JoinDate":1436627144,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283920.jpg?_r=1436649199","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"nkavanaugh","Id":283920,"Name":"nkavanaugh","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.146.146.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79423,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"0982e61fdec56b6248d9ba06e1fc370e","RawContent":"Welcome!!! Looking forward to following all you GS brides :)\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1900894,"PostDate":1437516352,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Welcome!!! Looking forward to following all you GS brides <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399407002,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"142.169.78.79","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79423,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":3,"IsLiked":false,"PostKey":"617e391256d55564488456a4175bf380","RawContent":"Our Story:\n\nSteven and I got engaged in April of 2014 in Costa RIca, it has taken us a bit to finally start planning! We met in 2009, we had attended the same small university in Cape Breton, Nova Scotia but didn&#039;t meet until around the time we graduated. We had a mutual friend who was killed in a car accident the day before graduation, this brought several groups of friends together in the following weeks leaning on each other to cope and also to celebrate the life of a guy who was truly a really special person. I had dated someone basically throughout university (who in hind sight was a whole lot of crazy lol) we split a couple of months prior to this and I vowed I would stay single for a while (not so much lol).\n\nSteven moved to Ottawa shortly after graduation for work and we did long distance for about a year at which time we decided this relationship was worth taking a risk for, and so I moved. We have moved quite a bit in our 6 years, to Ottawa, Red Deer and in Thunder Bay where we are now (temporarily) settled. I consider myself incredibly lucky to have found someone like Steven to spend the rest of my life with, he is honestly one of the most kind, compassionate, selfless people I have ever met.\n\nA destination wedding seemed to be the obvious choice for us as we both have a passion for travel, we have spent time in Mexico, Thailand, Cambodia, Cuba, D.R, Vietnam, Costa Rica, and all over Canada and the U,S. We&#039;ve been pretty lucky these last few years, this year Steven decided to go back to school and complete his engineering degree so our travel days are currently on hiatus. Destination wedding is the perfect fix to that!\n\nWe attended a wedding in May 2014 at the Grand Sirenis and it was seriously the best time, it made sense for us to use this resort because we had been there before and it had been such a fantastic time. We are getting married in the church on site which was another bonus for us since our families are both Catholic!\n\n\n\nThe Booking Process:\n\nI had gone through several travel agents until I finally found one I felt would work well with us, he has been god sent through this process let me tell you! I really felt like destination weddings were supposed to be stress free, the booking process and waiting for deposits has been a lot more stressful then I anticipated. However it is finally coming to an end! We are one week away from our deadline and currently has 53 people booked! I can&#039;t believe how great the response has been its so exciting to know all these people want to come out to support us! We shall see what this last week brings, I can&#039;t wait to have a final number.\n\nWedding Party:\n\nI must say after reading some of the forums on here about wedding party drama I am a bit nervous. We have 4 people each standing for us my little sister is my MOH and Stevens older brother is his BM, 3 of m best friends are my BMs and 3 of his are his GMs, our friends are generally really laid back people and all but two of them are booked right now so hopefully there won&#039;t be any issues with the last two GM&#039;s!\n[quote name=\"calgarybride2015\" post=\"1900894\" timestamp=\"1437537952\"]\nWelcome!!! Looking forward to following all you GS brides :)\n\n\nSent from my iPhone using Tapatalk[\/quote] Thank you @[member=\"calgarybride2015\"] I am hoping if I do this I will actually start making some decisions!! Lol\nThe dress:\n\nI so thought I knew what I wanted for a dress, lace kind of a vintage feel not super fitted. Boy was I wrong. I ended up getting a dress with a jacket type of thing to wear over it so I can mix it up for the ceremony should I choose too. I wanted to wear something that would surprise Steven and our guests because I can honestly be super predictable and boring sometimes. Lol so here it is! Ignore my ridiculous face in these photos. I can&#039;t wait until I get it in my size to get a real feeling for how it will fit!attachment=33141:ImageUploadedByTapatalk1437610457.989386.jpg]\n\n\n\n\nSent from my iPhone using Tapatalk\nI am really needing an opinion on these bridesmaids dresses! I am pretty sure I want to do coral with Aqua and gold accents, I&#039;m hoping to somewhat go for an under the sea theme. I ordered these dresses from lulus.com they were 68 usd. My whole bridal party still lives in Nova Scotia so that process is a little tough but I am thinking on doing this dress, it is a little big on me which makes it hard to tell but I think the color is beautiful and all my girls are tiny so they will look good in pretty much anything. What do you guys think of this dress?\n\n\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[{"Id":33141,"Name":"ImageUploadedByTapatalk1437610457.989386.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-283920-143761054884.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-283920-143761054884_thumb.jpg","Width":826,"Height":827}],"Id":1900974,"PostDate":1437589420,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Our Story:<\/p>\n<p>\u00a0<\/p>\n<p>Steven and I got engaged in April of 2014 in Costa RIca, it has taken us a bit to finally start planning! We met in 2009, we had attended the same small university in Cape Breton, Nova Scotia but didn't meet until around the time we graduated. We had a mutual friend who was killed in a car accident the day before graduation, this brought several groups of friends together in the following weeks leaning on each other to cope and also to celebrate the life of a guy who was truly a really special person. I had dated someone basically throughout university (who in hind sight was a whole lot of crazy lol) we split a couple of months prior to this and I vowed I would stay single for a while (not so much lol).<\/p>\n<p>\u00a0<\/p>\n<p>Steven moved to Ottawa shortly after graduation for work and we did long distance for about a year at which time we decided this relationship was worth taking a risk for, and so I moved. We have moved quite a bit in our 6 years, to Ottawa, Red Deer and in Thunder Bay where we are now (temporarily) settled. I consider myself incredibly lucky to have found someone like Steven to spend the rest of my life with, he is honestly one of the most kind, compassionate, selfless people I have ever met.<\/p>\n<p>\u00a0<\/p>\n<p>A destination wedding seemed to be the obvious choice for us as we both have a passion for travel, we have spent time in Mexico, Thailand, Cambodia, Cuba, D.R, Vietnam, Costa Rica, and all over Canada and the U,S. We've been pretty lucky these last few years, this year Steven decided to go back to school and complete his engineering degree so our travel days are currently on hiatus. Destination wedding is the perfect fix to that!<\/p>\n<p>\u00a0<\/p>\n<p>We attended a wedding in May 2014 at the Grand Sirenis and it was seriously the best time, it made sense for us to use this resort because we had been there before and it had been such a fantastic time. We are getting married in the church on site which was another bonus for us since our families are both Catholic!<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<br \/><p>The Booking Process:<\/p>\n<p>\u00a0<\/p>\n<p>I had gone through several travel agents until I finally found one I felt would work well with us, he has been god sent through this process let me tell you! I really felt like destination weddings were supposed to be stress free, the booking process and waiting for deposits has been a lot more stressful then I anticipated. However it is finally coming to an end! We are one week away from our deadline and currently has 53 people booked! I can't believe how great the response has been its so exciting to know all these people want to come out to support us! We shall see what this last week brings, I can't wait to have a final number.<\/p>\n<p>\u00a0<\/p>\n<p>Wedding Party:<\/p>\n<p>\u00a0<\/p>\n<p>I must say after reading some of the forums on here about wedding party drama I am a bit nervous. We have 4 people each standing for us my little sister is my MOH and Stevens older brother is his BM, 3 of m best friends are my BMs and 3 of his are his GMs, our friends are generally really laid back people and all but two of them are booked right now so hopefully there won't be any issues with the last two GM's!<\/p>\n<br \/><p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>calgarybride2015, on 21 July 2015 - 10:05 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Welcome!!! Looking forward to following all you GS brides <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br><br><br>\nSent from my iPhone using Tapatalk<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0Thank you @<a hovercard-ref=\"member\" hovercard-id=\"277873\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277873-calgarybride2015\/' title='Member profile'><span itemprop=\"name\">calgarybride2015<\/span><\/a> I am hoping if I do this I will actually start making some decisions!! Lol<\/p><br \/>The dress:<br><br>\nI so thought I knew what I wanted for a dress, lace kind of a vintage feel not super fitted. Boy was I wrong. I ended up getting a dress with a jacket type of thing to wear over it so I can mix it up for the ceremony should I choose too. I wanted to wear something that would surprise Steven and our guests because I can honestly be super predictable and boring sometimes. Lol so here it is! Ignore my ridiculous face in these photos. I can't wait until I get it in my size to get a real feeling for how it will fit!attachment=33141:ImageUploadedByTapatalk1437610457.989386.jpg]<a class='resized_img' rel='lightbox[1900974]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-283920-143761066837.jpg\" title=\"ImageUploadedByTapatalk1437610583.336191.jpg - Size: 295.67KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-283920-143761066837.jpg\" class='bbc_img linked-image' alt=\"ImageUploadedByTapatalk1437610583.336191.jpg\" \/><\/a>\n\n<br><br>\n<a class='resized_img' rel='lightbox[1900974]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-283920-1437609507.jpg\" title=\"ImageUploadedByTapatalk1437609440.095706.jpg - Size: 281.78KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-283920-1437609507.jpg\" class='bbc_img linked-image' alt=\"ImageUploadedByTapatalk1437609440.095706.jpg\" \/><\/a>\n\n<br><br><br>\nSent from my iPhone using Tapatalk<br \/>I am really needing an opinion on these bridesmaids dresses! I am pretty sure I want to do coral with Aqua and gold accents, I'm hoping to somewhat go for an under the sea theme. I ordered these dresses from lulus.com they were 68 usd. My whole bridal party still lives in Nova Scotia so that process is a little tough but I am thinking on doing this dress, it is a little big on me which makes it hard to tell but I think the color is beautiful and all my girls are tiny so they will look good in pretty much anything. What do you guys think of this dress?<br><br>\n<a class='resized_img' rel='lightbox[1900974]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-283920-143761090008.jpg\" title=\"ImageUploadedByTapatalk1437610862.221910.jpg - Size: 140.13KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-283920-143761090008.jpg\" class='bbc_img linked-image' alt=\"ImageUploadedByTapatalk1437610862.221910.jpg\" \/><\/a>\n\n<br>\n<a class='resized_img' rel='lightbox[1900974]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-283920-143761096972.jpg\" title=\"ImageUploadedByTapatalk1437610939.544164.jpg - Size: 155.32KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-283920-143761096972.jpg\" class='bbc_img linked-image' alt=\"ImageUploadedByTapatalk1437610939.544164.jpg\" \/><\/a>\n\n<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nkavanaugh@bayshore.ca","IpAddress":"174.5.52.216","GroupId":39,"GroupName":"Newbie","JoinDate":1436627144,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283920.jpg?_r=1436649199","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"nkavanaugh","Id":283920,"Name":"nkavanaugh","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.146.146.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79423,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"4f0415619687d6eefd5c14eff19f163b","RawContent":"I think your dress is gorgeous and your little &#039;jacket&#039; is stunning and will go well with your color palette. \n\n\nPersonally I love your BMs dresses. Gorgeous and that price is stellar!!\n\n\nI know a few people from Cape Breton actually. And I don&#039;t believe it&#039;s a large place is it?   You&#039;ve been all over you were lying!!\n\n\nI look forward to hearing more!!\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1900983,"PostDate":1437592443,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I think your dress is gorgeous and your little 'jacket' is stunning and will go well with your color palette. <br><br>\nPersonally I love your BMs dresses. Gorgeous and that price is stellar!!<br><br>\nI know a few people from Cape Breton actually. And I don't believe it's a large place is it?   You've been all over you were lying!!<br><br>\nI look forward to hearing more!!<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399407002,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79423,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"50b4b41a250ee6e96164909ed3b37d4e","RawContent":"&lt;p&gt;Welcome to the forum! Planning threads are definitely super helpful. I&#039;ve gotten a lot of great tips from the brides here.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Your wedding dress is really pretty!! Also, I love that dress from lulus. My girls are wearing convertible style dresses in the exact same colour. :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I also hope you don&#039;t run into any type of wedding drama! I certainly thought my whole process was going to be pretty drama free, but sometimes people can surprise you.. especially around a big life event. I&#039;m definitely over it now and hopefully we don&#039;t have anymore issues leading up to the wedding.. we&#039;re getting pretty close now and everyone put their deposits in.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Can&#039;t wait to see more from your thread!&lt;\/p&gt;","Attachments":[],"Id":1901025,"PostDate":1437643657,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome to the forum! Planning threads are definitely super helpful. I've gotten a lot of great tips from the brides here.<\/p>\n<p>\u00a0<\/p>\n<p>Your wedding dress is really pretty!! Also, I love that dress from lulus. My girls are wearing convertible style dresses in the exact same colour. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>I also hope you don't run into any type of wedding drama! I certainly thought my whole process was going to be pretty drama free, but sometimes people can surprise you.. especially around a big life event. I'm definitely over it now and hopefully we don't have anymore issues leading up to the wedding.. we're getting pretty close now and everyone put their deposits in.<\/p>\n<p>\u00a0<\/p>\n<p>Can't wait to see more from your thread!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419416214,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1436293677","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.10.251.70","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79423,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c980ee27488c948a502fa5499d637489","RawContent":"Hi and welcome! I&#039;ve been a bit MIA since we&#039;re on holiday this week and oh my lord I&#039;m going to have SO much to get caught up on when I get home!\n\n\nYour dress is beautiful and I love the jacket over it!! Bridesmaid dresses are great for that kind of price? Definitely can&#039;t complain! The colour is really pretty and with Aqua will be gorgeous! \n\n\nLook forward to reading more!!","Attachments":[],"Id":1901060,"PostDate":1437689992,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi and welcome! I've been a bit MIA since we're on holiday this week and oh my lord I'm going to have SO much to get caught up on when I get home!<br><br>\nYour dress is beautiful and I love the jacket over it!! Bridesmaid dresses are great for that kind of price? Definitely can't complain! The colour is really pretty and with Aqua will be gorgeous! <br><br>\nLook forward to reading more!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283437399,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.114.38.100","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79423,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2dac846f589c486d906b35a1373082a8","RawContent":"Hi and welcome to the forum! Your wedding dress is gorgeous! I love the jacket that comes with dress, and I love that it gives you the option to change your look for the ceremony and reception. \n\n\nI&#039;m gonna look at lulus.com right now. That&#039;s a great price for bridesmaids dresses, and it looks beautiful.","Attachments":[],"Id":1901092,"PostDate":1437727833,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi and welcome to the forum! Your wedding dress is gorgeous! I love the jacket that comes with dress, and I love that it gives you the option to change your look for the ceremony and reception. <br><br>\nI'm gonna look at lulus.com right now. That's a great price for bridesmaids dresses, and it looks beautiful.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"My planning thread: <a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/79425-wafflesmom-moon-palace-planning-thread-january-23-2016\/\">http:\/\/www.bestdestinationwedding.com\/topic\/79425-wafflesmom-moon-palace-planning-thread-january-23-2016\/<\/a><br><br>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;4;484\/st\/20160123\/e\/Our+Wedding\/dt\/-2\/k\/44c5\/event.png\" alt=\"event.png\"><\/a>","Email":"jerilee.valenzuela@shaw.ca","IpAddress":"24.114.26.77","GroupId":40,"GroupName":"Jr. Member","JoinDate":1410076985,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279721.jpg?_r=1431039162","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Wafflesmom","Id":279721,"Name":"Wafflesmom","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"158.82.202.5","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79423,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"495e7dc47c853bdd05cb81b5983fbae9","RawContent":"&lt;p&gt;Yay, another planning thread - and another Grand Sirenis bride! Can&#039;t wait to see your pictures of the wedding in the Church on site, it&#039;s a beautiful spot for the ceremony.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\"&gt;I really like your wedding dress and the bridesmaid dress from lulus. I will have to check out that site - the prices are really great!&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\"&gt;Looking forward to reading more as your planning continues!&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1901100,"PostDate":1437730032,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Yay, another planning thread - and another Grand Sirenis bride! Can't wait to see your pictures of the wedding in the Church on site, it's a beautiful spot for the ceremony.<\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif\">I really like your wedding dress and the bridesmaid dress from lulus. I will have to check out that site - the prices are really great!<\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif\">Looking forward to reading more as your planning continues!<\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div>\u00a0<\/div>\n<div>\u00a0<\/div>\n<div><a class='bbc_url' href='http:\/\/www.TickerFactory.com\/'><\/div>\n<div><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;6\/st\/20160409\/e\/our+Wedding+Day\/k\/a16a\/event.png\" alt=\"event.png\"><\/div>\n<div><\/a><\/div>\n<div>\u00a0<\/div>\n","Email":"krystalball@gmail.com","IpAddress":"158.82.202.5","GroupId":39,"GroupName":"Newbie","JoinDate":1421842563,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281820.jpg?_r=1429976010","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"facebook"},"FormattedName":"krystalball","Id":281820,"Name":"krystalball","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.114.27.13","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79423,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8cb6604c4932f1498deca57abfef4bc4","RawContent":"&lt;p&gt;Wow~! welcome to our forum community nkavanaugh and congrats on your upcoming Grand Sirenis Wedding!!! what a Gorgeous dress you&#039;ve picked - well done - it&#039;s Amazing!!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;You&#039;ve also picked a great resort that will make such a picturesque backdrop to your wedding photos, as you can see in these magical wedding \"moments that matter\" Linc captured at one of his weddings there.......enjoy!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;....from the &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10150951039939487.436910.18683524486&amp;amp;type=3&#039;&gt;Grand Sirenis Wedding Album: &lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xaf1\/t31.0-8\/458807_10150951046074487_238330196_o.jpg\" alt=\"458807_10150951046074487_238330196_o.jpg\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xfa1\/t31.0-8\/471608_10150951047664487_1873271255_o.jpg\" alt=\"471608_10150951047664487_1873271255_o.jp\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xaf1\/t31.0-8\/278039_10150951048789487_1212638472_o.jpg\" alt=\"278039_10150951048789487_1212638472_o.jp\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Wishing you happy research, and all the best with your plans - cheers!!! team MTM :)&lt;\/p&gt;","Attachments":[],"Id":1901111,"PostDate":1437739326,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Wow~! welcome to our forum community nkavanaugh and congrats on your upcoming Grand Sirenis Wedding!!! what a Gorgeous dress you've picked - well done - it's Amazing!!!<\/p>\n<p>\u00a0<\/p>\n<p>You've also picked a great resort that will make such a picturesque backdrop to your wedding photos, as you can see in these magical wedding \"moments that matter\" Linc captured at one of his weddings there.......enjoy!<\/p>\n<p>\u00a0<\/p>\n<p>....from the <a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10150951039939487.436910.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>Grand Sirenis Wedding Album: <\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xaf1\/t31.0-8\/458807_10150951046074487_238330196_o.jpg\" alt=\"458807_10150951046074487_238330196_o.jpg\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xfa1\/t31.0-8\/471608_10150951047664487_1873271255_o.jpg\" alt=\"471608_10150951047664487_1873271255_o.jp\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xaf1\/t31.0-8\/278039_10150951048789487_1212638472_o.jpg\" alt=\"278039_10150951048789487_1212638472_o.jp\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>Wishing you happy research, and all the best with your plans - cheers!!! team MTM <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280189060,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"96.48.159.21","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79423,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"daa14cc46380c405e186752c201e5628","RawContent":"@[member=\"nkavanaugh\"], how was the sizing on the bridesmaid&#039;s dress? I&#039;ve never ordered from lulus.com and was wondering if their dresses fit true to size or run small or big. Thanks in advance","Attachments":[],"Id":1901135,"PostDate":1437758153,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"283920\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/283920-nkavanaugh\/' title='Member profile'><span itemprop=\"name\">nkavanaugh<\/span><\/a>, how was the sizing on the bridesmaid's dress? I've never ordered from lulus.com and was wondering if their dresses fit true to size or run small or big. Thanks in advance\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"My planning thread: <a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/79425-wafflesmom-moon-palace-planning-thread-january-23-2016\/\">http:\/\/www.bestdestinationwedding.com\/topic\/79425-wafflesmom-moon-palace-planning-thread-january-23-2016\/<\/a><br><br>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;4;484\/st\/20160123\/e\/Our+Wedding\/dt\/-2\/k\/44c5\/event.png\" alt=\"event.png\"><\/a>","Email":"jerilee.valenzuela@shaw.ca","IpAddress":"24.114.26.77","GroupId":40,"GroupName":"Jr. Member","JoinDate":1410076985,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279721.jpg?_r=1431039162","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Wafflesmom","Id":279721,"Name":"Wafflesmom","IsOnline":false}}],"Id":"79423","Title":"Nkavanaugh Grand Sirenis Planning Thread-May 3Rd,2016","LastPostDate":1437758153},"Pages":{"TotalItems":10,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
