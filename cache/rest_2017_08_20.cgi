{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":4,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":871,"MovedTo":null,"MovedOn":0,"FirstPostId":1913651,"Rating":0,"RatingHits":0,"Starter":{"Id":286907,"Name":"BritML0121","Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1462988963,"LastPoster":{"Id":287113,"Name":"DreamArtPhotography","Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-287113.jpg?_r=1475417295","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"none"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":67,"Preview":{"Id":1914436,"PostDate":1466179300,"PostContent":"@BritML0121 Congrats!! \u00a0 Please feel free to check our work & reviews. \u00a0 Jamaica Video https:\/\/yo...","Author":{"Signature":"","Email":"contact@dreamartphotography.com","IpAddress":"189.221.43.89","GroupId":44,"GroupName":"Vendor","JoinDate":1465494801,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-287113.jpg?_r=1475417295","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"none"},"FormattedName":"DreamArtPhotography","Id":287113,"Name":"DreamArtPhotography","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"96.90.48.73","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80086,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e579d96d0d6b0becf8a4938a40d62825","RawContent":"&lt;p&gt;Hi!&lt;\/p&gt;\n&lt;p&gt;I am looking for a videographer for our December 2017 wedding in Jamaica. &amp;nbsp;Has anyone ever used Lexon Productions - Adrian McDonald?? &amp;nbsp;I don&#039;t see very many reviews on here. &amp;nbsp; Our photographer is travelling with us, so we will only need video and I was wondering if anyone has any feedback from this vendor?? &amp;nbsp;The videos on their website look great... just wanted a direct opinion!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thanks !!&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1913651,"PostDate":1462988963,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi!<\/p>\n<p>I am looking for a videographer for our December 2017 wedding in Jamaica. \u00a0Has anyone ever used Lexon Productions - Adrian McDonald?? \u00a0I don't see very many reviews on here. \u00a0 Our photographer is travelling with us, so we will only need video and I was wondering if anyone has any feedback from this vendor?? \u00a0The videos on their website look great... just wanted a direct opinion!<\/p>\n<p>\u00a0<\/p>\n<p>Thanks !!\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bthomps1203@aol.com","IpAddress":"96.90.48.73","GroupId":39,"GroupName":"Newbie","JoinDate":1462822254,"Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"BritML0121","Id":286907,"Name":"BritML0121","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.248.156.197","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80086,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"74f4cf5b53c760326b81484202860173","RawContent":"I have them booked for videography for my upcoming 6\/28\/16 wedding, I had already booked a different photographer or I would have used him for both. He was actually recommended to me by my photographer, Misha Earle. I&#039;ve been very happy with communication so far and everything on his site looks beautiful, so I am anticipating a good experience. I&#039;ll be sure to review when it&#039;s all over!","Attachments":[],"Id":1913763,"PostDate":1463418581,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I have them booked for videography for my upcoming 6\/28\/16 wedding, I had already booked a different photographer or I would have used him for both. He was actually recommended to me by my photographer, Misha Earle. I've been very happy with communication so far and everything on his site looks beautiful, so I am anticipating a good experience. I'll be sure to review when it's all over!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kristinfarrell89@yahoo.com","IpAddress":"73.160.45.46","GroupId":39,"GroupName":"Newbie","JoinDate":1423588105,"Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedNam