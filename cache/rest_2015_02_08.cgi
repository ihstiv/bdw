{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":true,"CanReply":true,"CanFollow":true,"TotalPosts":998,"QueuedPosts":0,"DeletedPosts":7,"HasUnreadPosts":true,"HasAttachments":true,"Views":73724,"MovedTo":null,"MovedOn":0,"FirstPostId":1699849,"Rating":0,"RatingHits":0,"Starter":{"Id":263113,"Name":"superlawyer87","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-263113.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"IsOnline":false},"StartDate":1357116433,"LastPoster":{"Id":281371,"Name":"lovetrice23","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281371.jpg?_r=1418358537","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":2,"Preview":{"Id":1699849,"PostDate":1357116433,"PostContent":"I just got engaged on Thanksgiving 2012, and my fiance and I are working with a travel agent to...","Author":{"Signature":"","Email":"brunsonamanda@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1355124120,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-263113.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"superlawyer87","Id":263113,"Name":"superlawyer87","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":false,"CanLike":true,"TopicId":71504,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"3f0e1e1b6ccd0bf71f86cea20e507f05","RawContent":"&lt;p&gt; I just got engaged on Thanksgiving 2012, and my fiance and I are working with a travel agent to plan a destination wedding on May 17, 2014. Anyone had an experience with Moon Palace, good or bad?? I&#039;m pretty sure this is the one we are going to go with.&lt;\/p&gt;","Attachments":[],"Id":1699849,"PostDate":1357116433,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I just got engaged on Thanksgiving 2012, and my fiance and I are working with a travel agent to plan a destination wedding on May 17, 2014. Anyone had an experience with Moon Palace, good or bad?? I'm pretty sure this is the one we are going to go with.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"brunsonamanda@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1355124120,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-263113.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"superlawyer87","Id":263113,"Name":"superlawyer87","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":71504,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"055ade1a5110c0aecb53394c8b679a7c","RawContent":"Congrats! \n \n I just got married at Sun Palace on November 23rd and us and 40 of our guests stayed at Moon Palace for a week and loved it!!!!  Let me know if you have any questions or comments and I&#039;d be happy to answer! Happy Planning! :) \n [quote]\nOriginally Posted by [b]superlawyer87[\/b] \/img\/forum\/go_quote.gif\n \n \n I just got engaged on Thanksgiving 2012, and my fiance and I are working with a travel agent to plan a destination wedding on May 17, 2014. Anyone had an experience with Moon Palace, good or bad?? I&#039;m pretty sure this is the one we are going to go with.[\/quote]","Attachments":[],"Id":1699873,"PostDate":1357118391,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Congrats!<\/p> <p> \u00a0<\/p> <p> I just got married at Sun Palace on November 23rd and us and 40 of our guests stayed at Moon Palace for a week and loved it!!!!\u00a0 Let me know if you have any questions or comments and I'd be happy to answer! Happy Planning! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p> <p> \u00a0<\/p> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>superlawyer87<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <p> I just got engaged on Thanksgiving 2012, and my fiance and I are working with a travel agent to plan a destination wedding on May 17, 2014. Anyone had an experience with Moon Palace, good or bad?? I'm pretty sure this is the one we are going to go with.<\/p> <\/blockquote>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"shanna0487@hotmail.com","IpAddress":"63.122.89.3","GroupId":42,"GroupName":"Sr. Member","JoinDate":1294231474,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-235127.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"shan0487","Id":235127,"Name":"shan0487","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":71504,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e66d24f05a8a2517426d77d0e3a8f37a","RawContent":"&lt;p&gt; Yes, Moon Palace lives up to its&#039; name for a beautiful wedding venue - as seen here. Best of luck all you Moon Palace couples, enjoy your journey and have an amazing life together!&lt;\/p&gt; &lt;p&gt; \n Happy New Year to ALL !&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p id=\"yui_3_7_3_1_1357158996428_1021\"&gt; &lt;img data-id=\"178452\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/178452\/width\/500\/height\/1000\" \/&gt;&lt;\/p&gt; &lt;p id=\"yui_3_7_3_1_1357158996428_1396\"&gt; &lt;img data-id=\"178453\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/178453\/width\/500\/height\/1000\" \/&gt;&lt;\/p&gt; &lt;p id=\"yui_3_7_3_1_1357158996428_1757\"&gt; &lt;img data-id=\"178454\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/178454\/width\/500\/height\/1000\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; team MTM asst, Lynda :)&lt;\/p&gt;","Attachments":[],"Id":1699917,"PostDate":1357123254,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Yes, Moon Palace lives up to its' name for a beautiful wedding venue - as seen here. Best of luck all you Moon Palace couples, enjoy your journey and have an amazing life together!<\/p> <p> <br \/> Happy New Year to ALL !<\/p> <p> \u00a0<\/p> <p id=\"yui_3_7_3_1_1357158996428_1021\"> <span rel='lightbox'><img class='bbc_img' data-id=\"178452\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/178452\/width\/500\/height\/1000\" \/><\/span><\/p> <p id=\"yui_3_7_3_1_1357158996428_1396\"> <span rel='lightbox'><img class='bbc_img' data-id=\"178453\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/178453\/width\/500\/height\/1000\" \/><\/span><\/p> <p id=\"yui_3_7_3_1_1357158996428_1757\"> <span rel='lightbox'><img class='bbc_img' data-id=\"178454\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/178454\/width\/500\/height\/1000\" \/><\/span><\/p> <p> \u00a0<\/p> <p> team MTM asst, Lynda <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280181860,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":71504,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"45c65191f63afd51005f96e22aabe8c9","RawContent":"Hi The photos are amazing! We got engaged at the moon last year and we just have to go back to go back for the big day! How many weeks ahead can contact them we were looking at july 2014 ?","Attachments":[],"Id":1702675,"PostDate":1357654402,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi The photos are amazing! We got engaged at the moon last year and we just have to go back to go back for the big day! How many weeks ahead can contact them we were looking at july 2014 ?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Geeandken@hotmail.co.uk","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1357651863,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-264089.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Geegee","Id":264089,"Name":"Geegee","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":71504,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"12e9cb318bcdc2a574e86b0e4399f893","RawContent":"I think you can book your date a year in advance- but that may have changed since I booked in Feb 2012.  [quote]\nOriginally Posted by [b]Geegee[\/b] \/img\/forum\/go_quote.gif\n \n Hi\n The photos are amazing! We got engaged at the moon last year and we just have to go back to go back for the big day! How many weeks ahead can contact them we were looking at july 2014 ?[\/quote]","Attachments":[],"Id":1702960,"PostDate":1357713387,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I think you can book your date a year in advance- but that may have changed since I booked in Feb 2012.\u00a0<\/p> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>Geegee<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> Hi<br \/> The photos are amazing! We got engaged at the moon last year and we just have to go back to go back for the big day! How many weeks ahead can contact them we were looking at july 2014 ?<\/blockquote>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"shanna0487@hotmail.com","IpAddress":"63.122.89.3","GroupId":42,"GroupName":"Sr. Member","JoinDate":1294231474,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-235127.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"shan0487","Id":235127,"Name":"shan0487","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":71504,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0deb75088399f52469f5e633b6841131","RawContent":"&lt;p&gt; I am also getting married at Moon Palace in July 2014 and I already have my date booked. If you are working with a TA, they should be able to go ahead and contact the WC and send you the contract. If you are going this on your own, then submit an information request on their website and they should get back to you with all of the information.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Good luck!&lt;\/p&gt;","Attachments":[],"Id":1707401,"PostDate":1358426224,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I am also getting married at Moon Palace in July 2014 and I already have my date booked. If you are working with a TA, they should be able to go ahead and contact the WC and send you the contract. If you are going this on your own, then submit an information request on their website and they should get back to you with all of the information.<\/p> <p> \u00a0<\/p> <p> Good luck!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jenvens7@gmail.com","IpAddress":"24.227.210.51","GroupId":39,"GroupName":"Newbie","JoinDate":1358426148,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-264628.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":211,"PhotoType":"custom"},"FormattedName":"jenvens7","Id":264628,"Name":"jenvens7","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":71504,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"325fadc0efdf9b148fd9301b9a6222da","RawContent":"&lt;p&gt; We recommend our wedding couples book whatever they can as soon as they have a firm date. This is the best timing, as the venues \/ vendors have ample advance notice and bookings, and the wedding couple has the optimal chance of their preferred dates \/ times being available........win \/ win all around.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; All the best with your plans and wishing you the amazing wedding celebrations you dream of! Cheers :)&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p id=\"yui_3_7_3_1_1358534749193_1138\"&gt; &lt;img alt=\"&#10;\" data-id=\"182106\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/182106\/width\/500\/height\/1000\" \/&gt;&lt;\/p&gt; &lt;p&gt; team MTM asst, Lynda :)&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; p.s. a Big THX to Geegee for the accolades........ :)&lt;\/p&gt;","Attachments":[],"Id":1707768,"PostDate":1358499186,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> We recommend our wedding couples book whatever they can as soon as they have a firm date. This is the best timing, as the venues \/ vendors have ample advance notice and bookings, and the wedding couple has the optimal chance of their preferred dates \/ times being available........win \/ win all around.<\/p> <p> \u00a0<\/p> <p> All the best with your plans and wishing you the amazing wedding celebrations you dream of! Cheers <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p> <p> \u00a0<\/p> <p id=\"yui_3_7_3_1_1358534749193_1138\"> <span rel='lightbox'><img class='bbc_img' alt=\"&#10;\" data-id=\"182106\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/182106\/width\/500\/height\/1000\" \/><\/span><\/p> <p> team MTM asst, Lynda <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p> <p> \u00a0<\/p> <p> p.s. a Big THX to Geegee for the accolades........ <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280181860,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":71504,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"badcedb75ea630ff6f98383adff9d25e","RawContent":"&lt;p&gt; Me and my fiance are hoping to get married at Moon Palace in early May 2014 and are hoping to book a stay long enough to honeymoon and use the complimentary wedding package. &amp;nbsp;Has anyone else chosen the complimentary package? What were your thoughts? &amp;nbsp;Also, our guestlist is only going to be 10-15 people. &amp;nbsp;Are there any suggestions on things I should ask the WC? &amp;nbsp;I am new to this and need all the help I can get! Please, lol!&lt;\/p&gt;","Attachments":[],"Id":1731697,"PostDate":1362872702,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Me and my fiance are hoping to get married at Moon Palace in early May 2014 and are hoping to book a stay long enough to honeymoon and use the complimentary wedding package. \u00a0Has anyone else chosen the complimentary package? What were your thoughts? \u00a0Also, our guestlist is only going to be 10-15 people. \u00a0Are there any suggestions on things I should ask the WC? \u00a0I am new to this and need all the help I can get! Please, lol!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"fbodyplaytoy1017@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1362858900,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-267136.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":144,"PhotoType":"custom"},"FormattedName":"JennyLynn824","Id":267136,"Name":"JennyLynn824","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":71504,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"ffc3d0c9952eb456ef22465bc17d135c","RawContent":"I had the complentary package and thought it was great! Here is a pic! :) Congrats! and feel free to private message me if you have any questions! :) \n \n [img]http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/191817\/width\/350\/height\/700[\/img] \n \n [quote]\nOriginally Posted by [b]JennyLynn824[\/b] \/img\/forum\/go_quote.gif\n \n \n Me and my fiance are hoping to get married at Moon Palace in early May 2014 and are hoping to book a stay long enough to honeymoon and use the complimentary wedding package.  Has anyone else chosen the complimentary package? What were your thoughts?  Also, our guestlist is only going to be 10-15 people.  Are there any suggestions on things I should ask the WC?  I am new to this and need all the help I can get! Please, lol![\/quote]","Attachments":[],"Id":1732130,"PostDate":1362988384,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I had the complentary package and thought it was great! Here is a pic! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> Congrats! and feel free to private message me if you have any questions! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p> <p> \u00a0<\/p> <p id=\"yui_3_7_3_1_1363017097596_1026\"> <span rel='lightbox'><img class='bbc_img' alt=\"ProcGalleryTrueAspectServlet (params=[sc=0&pa=0.5&sa=0&ry=1066&rx=1600&cr=0.0,0.0,1.0,1.0&nocredit=1&py=1066&px=1600&r=0&q=0&cb=16777215&p=1&ps=23&dsbg=221&po=0&g=2.2&bw=0.2&f=0&b=1&ph=65535&si=00409390326720130122023624285.JPG&gc=1&vtype=g] actions=[CachedCanvas (RawOrProxyraw(com.shutterfly.imaging.rendering.imageref.ReferenceManager$Ref@6d91f5d8, 1600) | FitToSize(java.awt.Dimension[width=1600,height=1066], 2) | ScaleRGB(1.0, 1.0, 1.0) | Sharpen(1.2999999523162842) | ShowPrint(java.awt.Dimension[width=1600,height=1066], 221, 1.0, 1.0, 1.0, 0, 0.800000011920929, 0.800000011920929, 0.800000011920929, 0) -> NativeCanvas(2AAAD507D7B0))]) PixSense Recompression: PX_COMP_STD 172.16.17.68 2013\/01\/29 07:06:59.185&#10;\" data-id=\"191817\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/191817\/width\/350\/height\/700\" \/><\/span><\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>JennyLynn824<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <p> Me and my fiance are hoping to get married at Moon Palace in early May 2014 and are hoping to book a stay long enough to honeymoon and use the complimentary wedding package. \u00a0Has anyone else chosen the complimentary package? What were your thoughts? \u00a0Also, our guestlist is only going to be 10-15 people. \u00a0Are there any suggestions on things I should ask the WC? \u00a0I am new to this and need all the help I can get! Please, lol!<\/p> <\/blockquote>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"shanna0487@hotmail.com","IpAddress":"63.122.89.3","GroupId":42,"GroupName":"Sr. Member","JoinDate":1294231474,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-235127.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"shan0487","Id":235127,"Name":"shan0487","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":71504,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"469528d10ef37896ba78c8280db1330e","RawContent":"&lt;p&gt; Hi all, congrats to everyone! I&#039;m hoping to be a 2014 MP bride :) Does anyone know what the initial holding deposit is? I&#039;m signed up for the webinar, but it&#039;s not until April, and MP still hasn&#039;t responded to my email.&lt;\/p&gt;","Attachments":[],"Id":1732224,"PostDate":1362998872,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hi all, congrats to everyone! I'm hoping to be a 2014 MP bride <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> Does anyone know what the initial holding deposit is? I'm signed up for the webinar, but it's not until April, and MP still hasn't responded to my email.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kjano99@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1362814203,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-267109.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"KJRAZZLE","Id":267109,"Name":"KJRAZZLE","IsOnline":false}}],"Id":"71504","Title":"Moon Palace- 2014","LastPostDate":1423238690},"Pages":{"TotalItems":998,"TotalPages":100,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":990},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
