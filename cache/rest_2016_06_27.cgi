d6b1\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...d6b1\/event.png<\/a><\/div><\/div>","Email":"coreygirl75@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1189623610,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207722.gif?_r=0","PhotoWidth":100,"PhotoHeight":93,"PhotoType":"custom"},"FormattedName":"coreyphil","Id":207722,"Name":"coreyphil","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":7140,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"105e2cd1ef7e58afde9358966b5e2f2f","RawContent":"Glad I could help you out!! The napkins sound great along with those bamboo runners!! The colors will really pop against them!","Attachments":[],"Id":123173,"PostDate":1192087901,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Glad I could help you out!! The napkins sound great along with those bamboo runners!! The colors will really pop against them!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div>\n<div>\u00a0<\/div>\n<\/div>\n<p>\u00a0<\/p>\n","Email":"jmnicely@sbcglobal.net","IpAddress":"71.94.78.145","GroupId":44,"GroupName":"Vendor","JoinDate":1175935560,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207330.jpg?_r=0","PhotoWidth":200,"PhotoHeight":197,"PhotoType":"custom"},"FormattedName":