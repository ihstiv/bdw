{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":40,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":8696,"MovedTo":null,"MovedOn":0,"FirstPostId":1879893,"Rating":0,"RatingHits":0,"Starter":{"Id":280665,"Name":"JennyZ","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280665.jpg?_r=1413805399","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"StartDate":1417991262,"LastPoster":{"Id":287249,"Name":"SvitlanaG","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":13,"Preview":{"Id":1914613,"PostDate":1467432120,"PostContent":"I am so sorry for that! Hugs! \u00a0 How was your wedding?","Author":{"Signature":"<p><span><span style=\"font-size:14.6667px;font-family:Arial;color:rgb(0,0,0);background-color:transparent;\">Event planner and curator at <a data-ipb='nomediaparse' href='http:\/\/www.poptop.uk.com'>http:\/\/www.poptop.uk.com<\/a>\u00a0<\/span><span style=\"font-size:14.6667px;font-family:Arial;color:rgb(0,0,0);background-color:transparent;\"><strong>Poptop <\/strong>event marketplace <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/span><\/span>","Email":"svitlanapoptop@gmail.com","IpAddress":"95.158.49.2","GroupId":39,"GroupName":"Newbie","JoinDate":1467098318,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"SvitlanaG","Id":287249,"Name":"SvitlanaG","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"159.53.110.140","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78454,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":6,"IsLiked":false,"PostKey":"642da9c9abdaf2a8dff34063026ea0be","RawContent":"&lt;p&gt;Wow. Wow. Wow. There are so many things at the tip of my tongue I&#039;d like to say here - but out of the respect for the respect and decorum I enjoy on this forum I won&#039;t.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;What I will say is please go find another site to troll. As @[member=\"MissJen3\"] states, this site is for us brides to be supportive and helpful to one another. Nothing you have said fits the bill so please spare us.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;@[member=\"JennyZ\"], I&#039;m sorry this thread has taken this turn and probably caused you more angst. It has me fired up and it wasn&#039;t even my OP. You sound like you have been very thoughtful and considerate and I&#039;m sure you&#039;ll find a way to make everything work in the way you and your fiance want for YOUR special day. I highly doubt they are, but if your future in-laws are anything like the above commenter you wouldn&#039;t be able to please them anyway! Hang in there!&lt;\/p&gt;","Attachments":[],"Id":1887374,"PostDate":1424793580,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Wow. Wow. Wow. There are so many things at the tip of my tongue I'd like to say here - but out of the respect for the respect and decorum I enjoy on this forum I won't.<\/p>\n<p>\u00a0<\/p>\n<p>What I will say is please go find another site to troll. As @<a hovercard-ref=\"member\" hovercard-id=\"278914\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/278914-missjen3\/' title='Member profile'><span itemprop=\"name\">MissJen3<\/span><\/a> states, this site is for us brides to be supportive and helpful to one another. Nothing you have said fits the bill so please spare us.<\/p>\n<p>\u00a0<\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"280665\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/280665-jennyz\/' title='Member profile'><span itemprop=\"name\">JennyZ<\/span><\/a>, I'm sorry this thread has taken this turn and probably caused you more angst. It has me fired up and it wasn't even my OP. You sound like you have been very thoughtful and considerate and I'm sure you'll find a way to make everything work in the way you and your fiance want for YOUR special day. I highly doubt they are, but if your future in-laws are anything like the above commenter you wouldn't be able to please them anyway! Hang in there!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rebecca.shaffer@gmail.com","IpAddress":"159.53.174.144","GroupId":3,"GroupName":"Member","JoinDate":1403101687,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"beckys98","Id":278581,"Name":"beckys98","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"216.16.242.102","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78454,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":9,"IsLiked":false,"PostKey":"a726a745703fa1bc21c376ad94e7050e","RawContent":"&lt;p&gt;With all due respect ladies, I am kind of glad she wrote what she did... It has actually helped out and made me feel a lot better about my situation... I feel WAYYYY more badly, for the poor Bride who gets that MIL!... All of a sudden, financial reasons don&#039;t seem quite so bad anymore! lol ;)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thanks for all your kind words&lt;\/p&gt;\n&lt;p&gt;xo&lt;\/p&gt;","Attachments":[],"Id":1887387,"PostDate":1424796271,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>With all due respect ladies, I am kind of glad she wrote what she did... It has actually helped out and made me feel a lot better about my situation... I feel WAYYYY more badly, for the poor Bride who gets that MIL!... All of a sudden, financial reasons don't seem quite so bad anymore! lol <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Thanks for all your kind words<\/p>\n<p>xo<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p style=\"text-align:center;\"><span style=\"color:#0066cc;\"><strong>- Jennifer and Fr<span><em>\u00e9<\/em><\/span>d<span><em>\u00e9<\/em><\/span>ric -<\/strong><\/span><\/p>\n<p style=\"text-align:center;\"><span style=\"font-size:12px;\"><span style=\"color:rgb(0,204,204);\"><strong>Playa del Carmen Mexico<\/strong><\/span><\/span><\/p>\n<p style=\"text-align:center;\"><span style=\"font-size:12px;\"><span style=\"color:rgb(0,204,204);\"><strong>December 1st, 2015<\/strong><\/span><\/span>","Email":"wedding@jennyfer.ca","IpAddress":"216.16.242.102","GroupId":39,"GroupName":"Newbie","JoinDate":1413457548,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280665.jpg?_r=1413805399","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"JennyZ","Id":280665,"Name":"JennyZ","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.28.245.116","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78454,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":3,"IsLiked":false,"PostKey":"731a60d5e1a2d52a6ac82e862096ffdc","RawContent":"[quote name=\"JennyZ\" post=\"1887387\" timestamp=\"1424810671\"]\nWith all due respect ladies, I am kind of glad she wrote what she did... It has actually helped out and made me feel a lot better about my situation... I feel WAYYYY more badly, for the poor Bride who gets that MIL!... All of a sudden, financial reasons don&#039;t seem quite so bad anymore! lol ;)\n\nThanks for all your kind words\nxo[\/quote]Hugs and LOL I was thinking the same - glad she isn&#039;t my MIL :) I held my tongue too!\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1887388,"PostDate":1424796718,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>JennyZ, on 24 February 2015 - 04:44 PM, said:<\/p><div class='blockquote'><div class='quote'><p>With all due respect ladies, I am kind of glad she wrote what she did... It has actually helped out and made me feel a lot better about my situation... I feel WAYYYY more badly, for the poor Bride who gets that MIL!... All of a sudden, financial reasons don't seem quite so bad anymore! lol <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/><br><br>\nThanks for all your kind words<br>\nxo<\/p><\/div><\/div>\n<br>\nHugs and LOL I was thinking the same - glad she isn't my MIL <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> I held my tongue too!<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.177.38.169","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78454,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":5,"IsLiked":false,"PostKey":"d841ea8222e5f824d186d3679074377e","RawContent":"&lt;p&gt;I honestly have no words. Well. I have them but they are not appropriate to post here. I am so sorry @[member=\"JennyZ\"] that you are dealing with this. I am sure your FI feels horrible as well. Who wants to have the family who causes all the drama? I speak from personal experience when I say, it stinks to have family members who are less than supportive. But, he is exactly right when he points to how positive your family is and views them as his own.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;If by chance, this is all due to similar feelings as have been posted previously, then at least you know that it is their stupidity and selfishness that are preventing them from attending and you can&#039;t fix either of those.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I think what gets lost in planning a wedding is who it really is about. It is NOT about your wishes, comforts, cups, beds, or anything else. How utterly selfish to seem so put out by a happy occasion. Unfortunately, life is short and I would bet my last dollar that many parents wish they could attend their child&#039;s wedding and likewise, many children wish their parents were ALIVE to share that special day with them as well. So forgive me, but china and a bed should not be the priority. YOUR CHILD and what he or she has chosen should be. The lack of support is absolutely disgusting to me.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1887397,"PostDate":1424799246,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I honestly have no words. Well. I have them but they are not appropriate to post here. I am so sorry @<a hovercard-ref=\"member\" hovercard-id=\"280665\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/280665-jennyz\/' title='Member profile'><span itemprop=\"name\">JennyZ<\/span><\/a> that you are dealing with this. I am sure your FI feels horrible as well. Who wants to have the family who causes all the drama? I speak from personal experience when I say, it stinks to have family members who are less than supportive. But, he is exactly right when he points to how positive your family is and views them as his own.\u00a0<\/p>\n<p>If by chance, this is all due to similar feelings as have been posted previously, then at least you know that it is their stupidity and selfishness that are preventing them from attending and you can't fix either of those.\u00a0<\/p>\n<p>I think what gets lost in planning a wedding is who it really is about. It is NOT about your wishes, comforts, cups, beds, or anything else. How utterly selfish to seem so put out by a happy occasion. Unfortunately, life is short and I would bet my last dollar that many parents wish they could attend their child's wedding and likewise, many children wish their parents were ALIVE to share that special day with them as well. So forgive me, but china and a bed should not be the priority. YOUR CHILD and what he or she has chosen should be. The lack of support is absolutely disgusting to me.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div><a class='bbc_url' href='http:\/\/www.TickerFactory.com\/'><\/div>\n<div><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;0;6\/st\/20150314\/e\/Our+Wedding\/k\/c1c3\/event.png\" alt=\"event.png\"><\/div>\n<div><\/a><\/div>\n","Email":"tiffmedeiros@gmail.com","IpAddress":"50.177.38.169","GroupId":40,"GroupName":"Jr. Member","JoinDate":1361723426,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-266526.jpg?_r=1427840086","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"MrsCtoB","Id":266526,"Name":"MrsCtoB","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"159.53.110.143","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78454,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"b3f88e8f84240ee247ba29fa2d27adf0","RawContent":"Haha!!!! Yes, a little perspective is always helpful, right? I was going to say the same thing but you put it in a nicer way than I could muster ;)\n[quote name=\"JennyZ\" post=\"1887387\" timestamp=\"1424810671\"]\nWith all due respect ladies, I am kind of glad she wrote what she did... It has actually helped out and made me feel a lot better about my situation... I feel WAYYYY more badly, for the poor Bride who gets that MIL!... All of a sudden, financial reasons don&#039;t seem quite so bad anymore! lol ;)\n\nThanks for all your kind words\nxo[\/quote]","Attachments":[],"Id":1887411,"PostDate":1424803241,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Haha!!!! Yes, a little perspective is always helpful, right? I was going to say the same thing but you put it in a nicer way than I could muster <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/><\/p>\n<p>\u00a0<\/p>\n<p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>JennyZ, on 24 February 2015 - 04:44 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>With all due respect ladies, I am kind of glad she wrote what she did... It has actually helped out and made me feel a lot better about my situation... I feel WAYYYY more badly, for the poor Bride who gets that MIL!... All of a sudden, financial reasons don't seem quite so bad anymore! lol <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Thanks for all your kind words<\/p>\n<p>xo<\/p>\n<\/div>\n<\/div><\/div>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rebecca.shaffer@gmail.com","IpAddress":"159.53.174.144","GroupId":3,"GroupName":"Member","JoinDate":1403101687,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"beckys98","Id":278581,"Name":"beckys98","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.249.133.244","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78454,"EditedBy":"<strong>Edited by kellymiller, 30 March 2015 - 08:41 PM.<\/strong>","EditDate":1427748098,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9a85e459d7db76b2af0f15a9ec76f98f","RawContent":"&lt;p&gt;I just picked up reading this tread and all I can say is WOW! I can&#039;t believe the turn it took, but am pleased that it made you think about your situation better @[member=\"JennyZ\"]!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;That MIL seems to have forgotten the whole point of her sons wedding....to watch her son get married! All she seemed concerned about is how much of an inconvenience it is for them. She also seems to be in the opinion that her future DIL is making all the decisions....while that is mostly true for weddings, I never made a decision without consulting my husband first. Even if&amp;nbsp;I knew he answer would be \"Do\/get whatever you want\" I would still make the point of asking or showing him so he knew what was going on. I&#039;m sure this bride also did the same, and if her husband really had an issue with the location of the wedding he would have said something.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We just got back from our wedding about 2 weeks ago, and to be honest we didn&#039;t think about the people who didn&#039;t attend. Well, we did think of one groomsman who had to back out that it was probably for the best he didn&#039;t come as he is pretty intolerant of other people and different cultures, so it was for the best that we didn&#039;t have to deal with that! My husband and more family attend than from my side (he had about 10 and I had 7) and the only friends that attended were my MOH and her boyfriend. I can feel for your FI not having many relatives attending, but if they clearly don&#039;t want to be there they won&#039;t be any fun to be around!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;One last thing, when we first told our parents about having a destination wedding they weren&#039;t thrilled with the idea. If they did grumble about it no one said anything to us about it. I think my parents really changed their tune after dealing with my sister&#039;s wedding in September and all the stress and tears that it caused Turns out all of our guests have the times of their lives and are already planning their trip back next year! Now I can foresee a future&amp;nbsp;awkward situation&amp;nbsp;about having to pick which family to go on vacation with :S&lt;\/p&gt;","Attachments":[],"Id":1891356,"PostDate":1427747599,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I just picked up reading this tread and all I can say is WOW! I can't believe the turn it took, but am pleased that it made you think about your situation better @<a hovercard-ref=\"member\" hovercard-id=\"280665\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/280665-jennyz\/' title='Member profile'><span itemprop=\"name\">JennyZ<\/span><\/a>!!<\/p>\n<p>\u00a0<\/p>\n<p>That MIL seems to have forgotten the whole point of her sons wedding....to watch her son get married! All she seemed concerned about is how much of an inconvenience it is for them. She also seems to be in the opinion that her future DIL is making all the decisions....while that is mostly true for weddings, I never made a decision without consulting my husband first. Even if\u00a0I knew he answer would be \"Do\/get whatever you want\" I would still make the point of asking or showing him so he knew what was going on. I'm sure this bride also did the same, and if her husband really had an issue with the location of the wedding he would have said something.<\/p>\n<p>\u00a0<\/p>\n<p>We just got back from our wedding about 2 weeks ago, and to be honest we didn't think about the people who didn't attend. Well, we did think of one groomsman who had to back out that it was probably for the best he didn't come as he is pretty intolerant of other people and different cultures, so it was for the best that we didn't have to deal with that! My husband and more family attend than from my side (he had about 10 and I had 7) and the only friends that attended were my MOH and her boyfriend. I can feel for your FI not having many relatives attending, but if they clearly don't want to be there they won't be any fun to be around!!<\/p>\n<p>\u00a0<\/p>\n<p>One last thing, when we first told our parents about having a destination wedding they weren't thrilled with the idea. If they did grumble about it no one said anything to us about it. I think my parents really changed their tune after dealing with my sister's wedding in September and all the stress and tears that it caused Turns out all of our guests have the times of their lives and are already planning their trip back next year! Now I can foresee a future\u00a0awkward situation\u00a0about having to pick which family to go on vacation with :S<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kelly_miller_@hotmail.com","IpAddress":"99.249.122.85","GroupId":40,"GroupName":"Jr. Member","JoinDate":1390758531,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kellymiller","Id":276338,"Name":"kellymiller","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.236.130.168","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78454,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9d286dff3cad72b085e745c31f208b89","RawContent":"I can&#039;t get over how ignorant people are! (Also I couldn&#039;t stop laughing at that MIL statements!! [emoji23]) I am SO GLAD she is not my MIL; if I was her DIL and read what she had wrote I&#039;d tell her to stay home in her own bed and enjoy her coffee, while all the family that care and support me are with me and my FI! \n\n\nHer statements here upset me so much being an adopted daughter; if my mother felt like that I would be crushed! How rude of you to only think of yourself? I feel badly for your son and I hope you didn&#039;t put a damper on their special day! \n\n\n@[member=\"JennyZ\"] keep on doing you and making sure you and your FI are happy!! [emoji5]\ufe0f\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1891367,"PostDate":1427755376,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I can't get over how ignorant people are! (Also I couldn't stop laughing at that MIL statements!! [emoji23]) I am SO GLAD she is not my MIL; if I was her DIL and read what she had wrote I'd tell her to stay home in her own bed and enjoy her coffee, while all the family that care and support me are with me and my FI! <br><br>\nHer statements here upset me so much being an adopted daughter; if my mother felt like that I would be crushed! How rude of you to only think of yourself? I feel badly for your son and I hope you didn't put a damper on their special day! <br><br>\n@<a hovercard-ref=\"member\" hovercard-id=\"280665\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/280665-jennyz\/' title='Member profile'><span itemprop=\"name\">JennyZ<\/span><\/a> keep on doing you and making sure you and your FI are happy!! [emoji5]\ufe0f<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"izabella.david@gmail.com","IpAddress":"99.237.26.51","GroupId":40,"GroupName":"Jr. Member","JoinDate":1426447978,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282430.jpg?_r=1434377756","PhotoWidth":200,"PhotoHeight":287,"PhotoType":"custom"},"FormattedName":"IzzyDeee","Id":282430,"Name":"IzzyDeee","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"38.112.94.76","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78454,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"441d36fb3d7560089d6d7776ba257126","RawContent":"&lt;p&gt;How am I only seeing this thread now??&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;@[member=\"JennyZ\"] you kept it classy.  &amp;nbsp;I am going to give my MIL the biggest hug when I see her today.&lt;\/p&gt;","Attachments":[],"Id":1891420,"PostDate":1427803438,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>How am I only seeing this thread now??<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"280665\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/280665-jennyz\/' title='Member profile'><span itemprop=\"name\">JennyZ<\/span><\/a> you kept it classy.\u00a0\u00a0\u00a0I am going to give my MIL the biggest hug when I see her today.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div><br><div>\u00a0<\/div>\n<div>\u00a0<\/div>\n<div>Married on June 20th, 2015 at the Grand Sunset Princess Riviera Gazebo & Reception at the Chill Out with 60 guests<\/div>\n<div>\u00a0<\/div>\n<\/div>\n<div>\u00a0<\/div>\n<p>My planning thread:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/<\/a><\/p>\n<p>My review thread: \u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/<\/a>","Email":"rebecca.valero@gmail.com","IpAddress":"38.112.94.76","GroupId":3,"GroupName":"Member","JoinDate":1396968452,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277519.jpg?_r=1439827749","PhotoWidth":200,"PhotoHeight":132,"PhotoType":"custom"},"FormattedName":"veryvalentine","Id":277519,"Name":"veryvalentine","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"67.17.215.182","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78454,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9c970fb612f3825a80b183a374bd9275","RawContent":"&lt;p&gt;@[member=\"JennyZ\"] I read every post. Glad to see the all your struggles in having your love ones attend are slowly coming together. Wish you the best wedding in the Riviera Maya with your friends and family.&lt;\/p&gt;","Attachments":[],"Id":1894897,"PostDate":1430325713,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"280665\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/280665-jennyz\/' title='Member profile'><span itemprop=\"name\">JennyZ<\/span><\/a> I read every post. Glad to see the all your struggles in having your love ones attend are slowly coming together. Wish you the best wedding in the Riviera Maya with your friends and family.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Our\u00a0perfect wedding in the Riviera Maya.<\/p>\n<p>\u00a0<\/p>\n<p>Date:\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 01\/15\/2015<\/p>\n<p>Resort:\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 Occidental Grand Xcaret - Riviera Maya, Mexico<br>\nGuests:\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 \u00a070-80<br>\nPackage:\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0Custom<\/p>\n<p>Dress:\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 David's Bridal<br>\nMinister:\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0Family Friend<\/p>\n<p>Photographer:\u00a0\u00a0 \u00a0Decordova Photography ( <a data-ipb='nomediaparse' href='http:\/\/www.decordova.ca'>www.decordova.ca<\/a> )<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"emma.palmer.love@gmail.com","IpAddress":"67.17.215.182","GroupId":39,"GroupName":"Newbie","JoinDate":1419930757,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"emmapalmer","Id":281523,"Name":"emmapalmer","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"95.158.49.2","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78454,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b84759bd5d86552144bd9785885e702a","RawContent":"&lt;p&gt;I am so sorry for that!&lt;\/p&gt;\n&lt;p&gt;Hugs!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;How was your wedding?&lt;\/p&gt;","Attachments":[],"Id":1914613,"PostDate":1467432120,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I am so sorry for that!<\/p>\n<p>Hugs!<\/p>\n<p>\u00a0<\/p>\n<p>How was your wedding?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span><span style=\"font-size:14.6667px;font-family:Arial;color:rgb(0,0,0);background-color:transparent;\">Event planner and curator at <a data-ipb='nomediaparse' href='http:\/\/www.poptop.uk.com'>http:\/\/www.poptop.uk.com<\/a>\u00a0<\/span><span style=\"font-size:14.6667px;font-family:Arial;color:rgb(0,0,0);background-color:transparent;\"><strong>Poptop <\/strong>event marketplace <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/span><\/span>","Email":"svitlanapoptop@gmail.com","IpAddress":"95.158.49.2","GroupId":39,"GroupName":"Newbie","JoinDate":1467098318,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"SvitlanaG","Id":287249,"Name":"SvitlanaG","IsOnline":false}}],"Id":"78454","Title":"Mother And Father Of The Groom Not Attending?!?!","LastPostDate":1467432120},"Pages":{"TotalItems":40,"TotalPages":4,"CurrentPage":30,"NextPage":-1,"PreviousPage":20,"LastPage":30},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
