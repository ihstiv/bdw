{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":8,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":622,"MovedTo":null,"MovedOn":0,"FirstPostId":1847003,"Rating":0,"RatingHits":0,"Starter":{"Id":273327,"Name":"kay2015","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-273327.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"IsOnline":false},"StartDate":1398696579,"LastPoster":{"Id":273327,"Name":"kay2015","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-273327.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":28,"Preview":{"Id":1847003,"PostDate":1398696579,"PostContent":"Anyone have any advice regarding travelling with kids. We have a daughter that will be 3 at the t...","Author":{"Signature":"","Email":"kay.vaillancourt@gmail.com","IpAddress":"173.252.61.182","GroupId":40,"GroupName":"Jr. Member","JoinDate":1378745169,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-273327.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"kay2015","Id":273327,"Name":"kay2015","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.252.61.182","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76950,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d471a0f8bdc1d5787491aabbdfbd53c7","RawContent":"&lt;p&gt;Anyone have any advice regarding travelling with kids. We have a daughter that will be 3 at the time and I am looking for advice on the plane, to resort, to if i should bring a stroller, what to pack? anything at all helps!!! Thanks&lt;\/p&gt;","Attachments":[],"Id":1847003,"PostDate":1398696579,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Anyone have any advice regarding travelling with kids. We have a daughter that will be 3 at the time and I am looking for advice on the plane, to resort, to if i should bring a stroller, what to pack? anything at all helps!!! Thanks<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kay.vaillancourt@gmail.com","IpAddress":"173.252.61.182","GroupId":40,"GroupName":"Jr. Member","JoinDate":1378745169,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-273327.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"kay2015","Id":273327,"Name":"kay2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.161.201.33","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76950,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9a6f69baedd22c3d979f33541f4be6d8","RawContent":"[quote name=\"kay2015\" post=\"1847003\" timestamp=\"1398696579\"]\nAnyone have any advice regarding travelling with kids. We have a daughter that will be 3 at the time and I am looking for advice on the plane, to resort, to if i should bring a stroller, what to pack? anything at all helps!!! Thanks[\/quote]I&#039;d love to know the answer to this too :) My daughter will also be 3 by the time our wedding comes around","Attachments":[],"Id":1847423,"PostDate":1398811713,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>kay2015, on 28 April 2014 - 06:49 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Anyone have any advice regarding travelling with kids. We have a daughter that will be 3 at the time and I am looking for advice on the plane, to resort, to if i should bring a stroller, what to pack? anything at all helps!!! Thanks<\/p>\n<\/div>\n<\/div><\/div>\n<p>I'd love to know the answer to this too <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> My daughter will also be 3 by the time our wedding comes around<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"dnyomba@gmail.com","IpAddress":"207.161.66.184","GroupId":40,"GroupName":"Jr. Member","JoinDate":1390115858,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"FutureMrsSam","Id":276191,"Name":"FutureMrsSam","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.252.61.182","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76950,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9a8ee5cebdb0c18c6241936c445d0d3e","RawContent":"[quote name=\"Dido77\" post=\"1847423\" timestamp=\"1398811713\"]\nI&#039;d love to know the answer to this too :) My daughter will also be 3 by the time our wedding comes around[\/quote]I know the obvious such as what to pack and whatnot but looking for maybe ppl that been there already and can provide a insight of whats necessary and whats not...we had our daughter in the DR when she was 6 weeks but obviously we dont need the same stuff lol and let me know that she was very good, this time around im not so sure where she will be older.\n\nif we dont get responses maybe we can help each other lol...where are you getting married?","Attachments":[],"Id":1847518,"PostDate":1398860707,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Dido77, on 29 April 2014 - 02:48 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>I'd love to know the answer to this too <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> My daughter will also be 3 by the time our wedding comes around<\/p>\n<\/div>\n<\/div><\/div>\n<p>I know the obvious such as what to pack and whatnot but looking for maybe ppl that been there already and can provide a insight of whats necessary and whats not...we had our daughter in the DR when she was 6 weeks but obviously we dont need the same stuff lol and let me know that she was very good, this time around im not so sure where she will be older.<\/p><br \/><p>if we dont get responses maybe we can help each other lol...where are you getting married?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kay.vaillancourt@gmail.com","IpAddress":"173.252.61.182","GroupId":40,"GroupName":"Jr. Member","JoinDate":1378745169,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-273327.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"kay2015","Id":273327,"Name":"kay2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"96.227.248.106","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76950,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"235e6e98a69989d5eeaa9733d0de58b3","RawContent":"&lt;p&gt;Well I have children but I&#039;m not going to your resort. My youngest just turned 2 in February. The resort I chose is very kid friendly and has a kids club he can spend time in. Besides that,all of our parents will be going so they will help out as well.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Not sure if we&#039;ll be packing a stroller but I doubt it. Can&#039;t use it on the beach anyway &amp;amp; I&#039;m trying to pack light. I&#039;m going to check to see if my resort has stroller rentals.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Out of nowhere, he&amp;nbsp;just started going to the potty consistently &lt;strong&gt;this week&lt;\/strong&gt;. 4 days in a row now with no accidents :Dso pampers will be out by the time June rolls around.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;My resort was featured in PARENTS Magazine as the 4th best kid friendly&amp;nbsp;resort. So glad I chose this spot! My teens and little one will have lots of fun as well as the adults.&lt;\/p&gt;","Attachments":[],"Id":1847522,"PostDate":1398862912,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Well I have children but I'm not going to your resort. My youngest just turned 2 in February. The resort I chose is very kid friendly and has a kids club he can spend time in. Besides that,all of our parents will be going so they will help out as well.<\/p>\n<p>\u00a0<\/p>\n<p>Not sure if we'll be packing a stroller but I doubt it. Can't use it on the beach anyway & I'm trying to pack light. I'm going to check to see if my resort has stroller rentals.<\/p>\n<p>\u00a0<\/p>\n<p>Out of nowhere, he\u00a0just started going to the potty consistently <strong>this week<\/strong>. 4 days in a row now with no accidents :Dso pampers will be out by the time June rolls around.<\/p>\n<p>\u00a0<\/p>\n<p>My resort was featured in PARENTS Magazine as the 4th best kid friendly\u00a0resort. So glad I chose this spot! My teens and little one will have lots of fun as well as the adults.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mrswithclass@aol.com","IpAddress":"96.227.248.106","GroupId":40,"GroupName":"Jr. Member","JoinDate":1376890503,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272718.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"1BeachBride","Id":272718,"Name":"1BeachBride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.161.201.33","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76950,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9224c037b14f2ddbe8727388de90fcf5","RawContent":"[quote name=\"kay2015\" post=\"1847518\" timestamp=\"1398860707\"]\nI know the obvious such as what to pack and whatnot but looking for maybe ppl that been there already and can provide a insight of whats necessary and whats not...we had our daughter in the DR when she was 6 weeks but obviously we dont need the same stuff lol and let me know that she was very good, this time around im not so sure where she will be older.\n\nif we dont get responses maybe we can help each other lol...where are you getting married?[\/quote]That works for me :) My wedding will at the Moon Palace in August 2016.. Wow! 6 weeks.. how was she on the plane and on the resort? Did she take to the heat or did it bother her?","Attachments":[],"Id":1847698,"PostDate":1398901253,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>kay2015, on 30 April 2014 - 04:25 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>I know the obvious such as what to pack and whatnot but looking for maybe ppl that been there already and can provide a insight of whats necessary and whats not...we had our daughter in the DR when she was 6 weeks but obviously we dont need the same stuff lol and let me know that she was very good, this time around im not so sure where she will be older.<\/p>\n<br><p>if we dont get responses maybe we can help each other lol...where are you getting married?<\/p>\n<\/div>\n<\/div><\/div>\n<p>That works for me <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> My wedding will at the Moon Palace in August 2016.. Wow! 6 weeks.. how was she on the plane and on the resort? Did she take to the heat or did it bother her?<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"dnyomba@gmail.com","IpAddress":"207.161.66.184","GroupId":40,"GroupName":"Jr. Member","JoinDate":1390115858,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"FutureMrsSam","Id":276191,"Name":"FutureMrsSam","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.252.61.182","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76950,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"937e42f2e78a983509d5acaf8b368c59","RawContent":"[quote name=\"1BeachBride\" post=\"1847522\" timestamp=\"1398862912\"]\nWell I have children but I&#039;m not going to your resort. My youngest just turned 2 in February. The resort I chose is very kid friendly and has a kids club he can spend time in. Besides that,all of our parents will be going so they will help out as well.\n\nNot sure if we&#039;ll be packing a stroller but I doubt it. Can&#039;t use it on the beach anyway &amp;amp; I&#039;m trying to pack light. I&#039;m going to check to see if my resort has stroller rentals.\n\nOut of nowhere, he just started going to the potty consistently [b]this week[\/b]. 4 days in a row now with no accidents :Dso pampers will be out by the time June rolls around.\n\nMy resort was featured in PARENTS Magazine as the 4th best kid friendly resort. So glad I chose this spot! My teens and little one will have lots of fun as well as the adults.[\/quote]Good Idea about checking to see if the resort rents the strollers.. I was more concerned about bringing it for the airport and for the evenings somewhere she can fall asleep while we are watching the entainment and whatnot, but I am going to check the resort first. Thanks\n[quote name=\"Dido77\" post=\"1847698\" timestamp=\"1398901253\"]\nThat works for me :) My wedding will at the Moon Palace in August 2016.. Wow! 6 weeks.. how was she on the plane and on the resort? Did she take to the heat or did it bother her?[\/quote]oh Nice..how much Planning have you done soo far? have you booked your resort or is it still to early? yes she was 6 weeks...it was a family reunion and we booked last minute because I was due in April but she came 4 weeks early so with the ok from our doc. and a healthy baby we booked and she was the best person on the plane and the resort lol..she slept the way there and back on the plane and as far as we know the plane didnt bother her ears at all. The heat didnt seem to bother her either she was a really good baby.. thatswhy im soo scared about this time around she will be 3 and lets just say im not sure how she will do on the plane lol.","Attachments":[],"Id":1847782,"PostDate":1398945879,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>1BeachBride, on 30 April 2014 - 05:01 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Well I have children but I'm not going to your resort. My youngest just turned 2 in February. The resort I chose is very kid friendly and has a kids club he can spend time in. Besides that,all of our parents will be going so they will help out as well.<\/p>\n<p>\u00a0<\/p>\n<p>Not sure if we'll be packing a stroller but I doubt it. Can't use it on the beach anyway & I'm trying to pack light. I'm going to check to see if my resort has stroller rentals.<\/p>\n<p>\u00a0<\/p>\n<p>Out of nowhere, he\u00a0just started going to the potty consistently <strong>this week<\/strong>. 4 days in a row now with no accidents :Dso pampers will be out by the time June rolls around.<\/p>\n<p>\u00a0<\/p>\n<p>My resort was featured in PARENTS Magazine as the 4th best kid friendly\u00a0resort. So glad I chose this spot! My teens and little one will have lots of fun as well as the adults.<\/p>\n<\/div>\n<\/div><\/div>\n<p>Good Idea about checking to see if the resort rents the strollers.. I was more concerned about bringing it for the airport and for the evenings somewhere she can fall asleep while we are watching the entainment and whatnot, but I am going to check the resort first. Thanks<\/p><br \/><p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Dido77, on 30 April 2014 - 03:40 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>That works for me <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> My wedding will at the Moon Palace in August 2016.. Wow! 6 weeks.. how was she on the plane and on the resort? Did she take to the heat or did it bother her?<\/p>\n<\/div>\n<\/div><\/div>\n<p>oh Nice..how much Planning have you done soo far? have you booked your resort or is it still to early? yes she was 6 weeks...it was a family reunion and we booked last minute because I was due in April but she came 4 weeks early so with the ok from our doc. and a healthy baby we booked and she was the best person on the plane and the resort lol..she slept the way there and back on the plane and as far as we know the plane didnt bother her ears at all. The heat didnt seem to bother her either she was a really good baby.. thatswhy im soo scared about this time around she will be 3 and lets just say im not sure how she will do on the plane lol.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kay.vaillancourt@gmail.com","IpAddress":"173.252.61.182","GroupId":40,"GroupName":"Jr. Member","JoinDate":1378745169,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-273327.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"kay2015","Id":273327,"Name":"kay2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.40.73","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76950,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6c754be19d4e21a85b8d261477ae1cd3","RawContent":"I&#039;m going to be bringing my 3 year old and 18 month old with me to my wedding in November. Are you brining a car seat? I may bring two light umbrella strollers for walking in town, but doubt we will use them otherwise. I&#039;m really hoping the resort upgrades us to a 1 bedroom suite so we have somewhere to hang out once they go to sleep. We have a swim out room so I know we will have good outdoor space, but I really am hopeful fur the upgrade!!\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1852941,"PostDate":1401506185,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm going to be bringing my 3 year old and 18 month old with me to my wedding in November. Are you brining a car seat? I may bring two light umbrella strollers for walking in town, but doubt we will use them otherwise. I'm really hoping the resort upgrades us to a 1 bedroom suite so we have somewhere to hang out once they go to sleep. We have a swim out room so I know we will have good outdoor space, but I really am hopeful fur the upgrade!!<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"chelseapjohnson@yahoo.ca","IpAddress":"70.72.57.238","GroupId":40,"GroupName":"Jr. Member","JoinDate":1361494468,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-266402.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"chelseapaige37","Id":266402,"Name":"chelseapaige37","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.252.61.182","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76950,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"25d246fb4f9002293264b4a60d76a80d","RawContent":"&lt;p&gt;@[member=\"chelseapaige37\"] we aint bringing her carseat just a umbrella stroller more for the night time, when there are shows and whatnot going on she can lay down if she gets tired, but other then that I know she will probably be walking around to the beach and pool lol...oh and also for the airport, its important to me that shes strapped in while walking throught the airport so I dont need to wonder where shes at, at least until we get through customs anyway.&lt;\/p&gt;","Attachments":[],"Id":1853770,"PostDate":1401885149,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"266402\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/266402-chelseapaige37\/' title='Member profile'><span itemprop=\"name\">chelseapaige37<\/span><\/a> we aint bringing her carseat just a umbrella stroller more for the night time, when there are shows and whatnot going on she can lay down if she gets tired, but other then that I know she will probably be walking around to the beach and pool lol...oh and also for the airport, its important to me that shes strapped in while walking throught the airport so I dont need to wonder where shes at, at least until we get through customs anyway.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kay.vaillancourt@gmail.com","IpAddress":"173.252.61.182","GroupId":40,"GroupName":"Jr. Member","JoinDate":1378745169,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-273327.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"kay2015","Id":273327,"Name":"kay2015","IsOnline":false}}],"Id":"76950","Title":"Travelling With Kids!","LastPostDate":1401885149},"Pages":{"TotalItems":8,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
