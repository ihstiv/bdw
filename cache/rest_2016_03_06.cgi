{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c06d31fdf217d3c048a0cc6b95af642b","RawContent":"Okay just sent an e-mail to TA so I can do the arrive Thursday leave Sunday option, I think if guest leave the following day it will really feel more like a honeymoon.","Attachments":[],"Id":802256,"PostDate":1250377572,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Okay just sent an e-mail to TA so I can do the arrive Thursday leave Sunday option, I think if guest leave the following day it will really feel more like a honeymoon.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;130\/st\/20100417\/e\/the+wedding+of+my+dreams\/dt\/-1\/k\/0f53\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...0f53\/event.png<\/a><br><br><i><strong>Excellence Playa Mujeres Bride<br>April 17, 2010<\/strong><\/i><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/t\/wukvjpB\/weight.png\">http:\/\/tickers.TickerFactory.com\/ezt...jpB\/weight.png<\/a><\/div><\/div>","Email":"s_katrese@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1229629965,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213251.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"s_katrese","Id":213251,"Name":"s_katrese","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"54a856d7e85959a3f1cd31ee3154591e","RawContent":"We chartered a catamaran for Friday and our wedding is Saturday.\n \n Me, my fiance and my MOH + her date are arriving Tuesday so we can be there ahead of all the guests. We are not featuring any special group rate and let people book with our TA on their own so they could stay as short a time or as long a time as they wanted.. About 1\/2 of our guests are arriving Wednesday and the other half on Thursday (We have 40 total). All are leaving on Sunday or Monday with the exception of 6 people who are staying until Tuesday. Kenny and I are staying for 12 nights and will not depart until the following Sunday.","Attachments":[],"Id":802851,"PostDate":1250459982,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We chartered a catamaran for Friday and our wedding is Saturday.<br \/> <br \/> Me, my fiance and my MOH + her date are arriving Tuesday so we can be there ahead of all the guests. We are not featuring any special group rate and let people book with our TA on their own so they could stay as short a time or as long a time as they wanted.. About 1\/2 of our guests are arriving Wednesday and the other half on Thursday (We have 40 total). All are leaving on Sunday or Monday with the exception of 6 people who are staying until Tuesday. Kenny and I are staying for 12 nights and will not depart until the following Sunday.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i30.photobucket.com\/albums\/c336\/dmbstolio\/Dec122009238-1.jpg\">http:\/\/i30.photobucket.com\/albums\/c3...22009238-1.jpg<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/www.jenandken2009.com\">www.jenandken2009.com<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;130\/st\/20091212\/e\/Jen+%26amp%3B+Kenny%27s+wedding\/k\/02c3\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...02c3\/event.png<\/a><\/div><\/div>","Email":"davis1974@gmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1215061237,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-210302.gif?_r=0","PhotoWidth":98,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Jennifer Davis","Id":210302,"Name":"Jennifer Davis","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5a2dbea89c6f84253a72b2becc3ec2ad","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;s_katrese&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;I wanted to ask what type of rooms you ladies booked for yourselves during your stay at EPM and how long will you stay in Mexico (weeks, days, etc...)?\n \n Also for those brides who have already returned how was the food honestly... for myself and fi food quality and taste is a must. We even let our TA know that with our resort we were looking for one that served great food. Is it a hit or miss thing?&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;We booked the honeymoon suite for 12 nights. I am so excited!","Attachments":[],"Id":802856,"PostDate":1250460215,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>s_katrese<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">I wanted to ask what type of rooms you ladies booked for yourselves during your stay at EPM and how long will you stay in Mexico (weeks, days, etc...)?<br \/> <br \/> Also for those brides who have already returned how was the food honestly... for myself and fi food quality and taste is a must. We even let our TA know that with our resort we were looking for one that served great food. Is it a hit or miss thing?<\/div> <\/td> <\/tr> <\/table> <\/div>We booked the honeymoon suite for 12 nights. I am so excited!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i30.photobucket.com\/albums\/c336\/dmbstolio\/Dec122009238-1.jpg\">http:\/\/i30.photobucket.com\/albums\/c3...22009238-1.jpg<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/www.jenandken2009.com\">www.jenandken2009.com<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;130\/st\/20091212\/e\/Jen+%26amp%3B+Kenny%27s+wedding\/k\/02c3\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...02c3\/event.png<\/a><\/div><\/div>","Email":"davis1974@gmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1215061237,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-210302.gif?_r=0","PhotoWidth":98,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Jennifer Davis","Id":210302,"Name":"Jennifer Davis","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"089e67d56bd585398b24d9e12dcd6060","RawContent":"We are honeymooning in one of the roottop terrace jacuzzi suites!!!","Attachments":[],"Id":806987,"PostDate":1250706874,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We are honeymooning in one of the roottop terrace jacuzzi suites!!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i210.photobucket.com\/albums\/bb46\/nadinecloss\/rocks.jpg\">http:\/\/i210.photobucket.com\/albums\/b...loss\/rocks.jpg<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f77\/nadine-s-dreams-huatulco-review-12-29-09-a-53920\/\">My Dreams Huatulco Wedding Review<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f128\/nadine-s-planning-thread-52947\/\">My Planning Thread<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f76\/nadine-s-wedding-day-after-photots-54891\/#post1161576\">Photographer Review<\/a><\/div><\/div>","Email":"nadinecloss@hotmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1215636060,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-210423.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"*Nadine*","Id":210423,"Name":"*Nadine*","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"03b9269864b68ea36ff7c77aad03ff93","RawContent":"Hi everyone, \n Me and my fiance are trying to decide whether to get married at Excellence playa mujeres or punta cana. I was wondering if someone could email me the options available at playa. I would like to be able to see cake, seating, color options etc. . I&#039;m sure it would help me to make my decision! My email is &lt;a data-ipb=&#039;nomediaparse&#039; href=\"mailto:maria_2825@yahoo.com\"&gt;maria_2825@yahoo.com&lt;\/a&gt;. Thanks so much!","Attachments":[],"Id":809232,"PostDate":1250826439,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi everyone, <br \/> Me and my fiance are trying to decide whether to get married at Excellence playa mujeres or punta cana. I was wondering if someone could email me the options available at playa. I would like to be able to see cake, seating, color options etc. . I'm sure it would help me to make my decision! My email is <a href='mailto:maria_2825@yahoo.com' class='bbc_url' title='External link' rel='nofollow external'>maria_2825@yahoo.com<\/a>. Thanks so much!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"maria_2825@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1249873436,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-220354.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"maria_2825","Id":220354,"Name":"maria_2825","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ba977c600ec867dac4f0d9fd63983a09","RawContent":"Hey there.\n \n I believe that the wedding packages and options for all Excellence resorts are the same. If you go through this thread, you will be able to find all the information you are looking for! Happy planning!","Attachments":[],"Id":810676,"PostDate":1250908625,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hey there.<br \/> <br \/> I believe that the wedding packages and options for all Excellence resorts are the same. If you go through this thread, you will be able to find all the information you are looking for! Happy planning!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i30.photobucket.com\/albums\/c336\/dmbstolio\/Dec122009238-1.jpg\">http:\/\/i30.photobucket.com\/albums\/c3...22009238-1.jpg<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/www.jenandken2009.com\">www.jenandken2009.com<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;130\/st\/20091212\/e\/Jen+%26amp%3B+Kenny%27s+wedding\/k\/02c3\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...02c3\/event.png<\/a><\/div><\/div>","Email":"davis1974@gmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1215061237,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-210302.gif?_r=0","PhotoWidth":98,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Jennifer Davis","Id":210302,"Name":"Jennifer Davis","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"15638fbf3c1210765f0685fba27c0d62","RawContent":"OMG girls! Excellence was GORGEOUS!! It was not overcrowded like the other resorts in Cancun that I have been to....there was always a swinging bed, hammock or palapa to take a nap in on the beach or by the pool. We stayed 5 nights in an Excellence Club Swim up Beachside Suite and 4 In an Excellence Club Rooftop Terrace...we stayed directly above the Honeymoon suite...and the view was AMAZING. I really liked being at the swim up suite because I was close to everything..one push on a raft and I could have anything I wanted! Moving on the wedding day was a litle hectic, but the staff helped a lot!\n \n Yamina is beautiful and makes everything perfect! I honestly decided every little detail with her in a meeting the day afer I gt there..and even I was surprised by how perfect everything was! BTW...if you don&#039;t want to spring for the floral arch ($500)..there are other options including just the bamboo w\/ draperies for $200. I wanted more of a simpler look, and the fact that is was cheaper was just icing on the cake....speaking of cake, I asked for a smaller cake since there were only 8 of us, but the choices were decadent. You can get anything you can think of! My cake was chocolate mousse and butter cake layers on the bottom, and a rasberry ganache-filled cheesecake on top. We had fondant on half and whipped cream on the cheesecake (I am not fond of traditional cake, and I don&#039;t like the taste of icing usually...)\n \n We chose our hors d&#039;ouvres from the gold menu since there were so few of us and Yamina let me make a few exceptions to the dinner for my mom and sister who don&#039;t like filet of beef (they wanted chicken). The rest of us had filet of beef. Every one of the four courses was delicious!!!! We had a private spot on the beach (X Lounge) for the cocktail hour, and the SOl bar all to ourselves for the reception. The IPOD thing wrked out for us...but if you have a larger group, I would suggest bringing your own speakers or getting a dj or a band...the volume wasn&#039;t very loud. They provide the wedding songs for the wedding, too. We had a religious ceremony and did the sand thing (I used to think it was cheesy..but it felt right :) The Minister spoke in English and I couldn&#039;t have asked for a more meaningful ceremony.\n \n The Excellence Club upgrade was worth it for us for only 3 reasons.....24 hour room service from an extended menu (evreryone else gets a smaller menu and it is from 7:00 am to 11:00 pm only), bottles of liqour brought to your room (worked well to have cognac brought ot our room when we had eaten too much) and the Excellence Club &amp;quot;lobby&amp;quot; always had a lught buffet going. It was so quick and easy to run in, grab a plate of food, and still catch our taxi, texas holdem gae, dance lesson, etc) By the middle of the week, we were grabbing plateS of food for everyone else too, so we could all snack on the run!\n \n he food at the resort wasn&#039;t bad at all....but I am a food snob, and the only restaurant that had my full approval was Spice, the Asian one. Everyone else loved Chez Isabelle and the Italian restaurant. The grill and the lobster house are great for lunches, though...all of the wraps, salads, french fries, sandwiches, etc were fantastic. The lobster was HUGE! The desserts were the best part...make sure you get the chocolate cake somewhere...it&#039;s actually like a little chocolate mousse filled truffle-style thing. i can&#039;t describe it really, but it was AMAZING!\n \n We went t Isla Mujeres and went mopedding one day...I wan&#039;t impressed. You couldn&#039;t really swim anywhere but Garafon Park (a tourist trap) and a taxi ran my husband off the road and hauled ass. Noone asked if he was ok, we had to pay $250 for $30 worth of damages, and the guy who ran the rental place refused to call the policia and even tried to pretend that he knew no other English except...&amp;quot;give me $250 or I will not give you back your license&amp;quot; They really ticked me off. That was the pnly place we went the entire time where we didn&#039;t feel safe. Tulum was beatiful, but I have been a few times....downtown shopping is still fun, and the hotel zone is worth seeing if you have time. We parasailed and rented jet skis...that was really fun, too. The snorkeling wasn&#039;t great where we went (isla mujeres) but it was fantastic the last time I went to Cancun when we rented the little two-seater power boats on the &amp;quot;Jungle Tour&amp;quot;. They offer this package in the lobby..I would DEFINAELY recommend it.\n \n What else....oh yeah, the rooftop pools are freezing...kind of a buzzkill late at night...the resort is clothing optional (which I did not realize) and 1 out of every 15 women will be topless (mostly the 40 and over crowd) . Everyone there seemed extremely friendly and relaxed...making friends was constant! The service was impeccable..I have NEVER felt so pampered and I have vacationed quite a lot in the arribean and Mexico in luxury resorts...this one is my FAVORITE! We left our sliding glass door inlocked a lot, and never had anything bothered with in our room. The shows are great, and a little risque....the staff made everything fun. Im usually not an &amp;quot;activities&amp;quot; person, but I got a little addicted....ping pong tournaments, tequila tastings, I even volunteered as the assistant in a magic show. Fun was totally contageous!!! \n \n Don&#039;t buy anything from the gift shop...you can get a taxi downtown for $20 and buy it all there for 1\/30th of the prices. Keep your head down when getting out of the Cancun airport..those people are NOT your ide..they are lying, and will say\/do ANYTHING to get your attention so they can try to sell you timeshare....walk OUTSIDE and look for the placard with your name on it being held by one of the guys out there...this is your ride!\n \n um...make sure u ask for ketchup when u order fries..that doesn&#039;t just come with it, dont get caught in the pools or jacuzzis (the publi ones...not the ones in your room) after 8:30 pm or the head honcho guy comes out and makes you sign a clipboard saying that you have broken the rules and this is your final warning. We sat on our terrace every night and watched someone getting written up. Just go in the ocean if you feel like a late-night dip...its netted around the swimming area...so no worries.\n \n Sand is beautiful...there were no bugs....no problems with seaweed, temperature, weather, or anything else. Just PRFECTION all around! Ya&#039;ll will see when u get there!\n Congrats to everyone!","Attachments":[],"Id":819517,"PostDate":1251512356,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                OMG girls! Excellence was GORGEOUS!! It was not overcrowded like the other resorts in Cancun that I have been to....there was always a swinging bed, hammock or palapa to take a nap in on the beach or by the pool. We stayed 5 nights in an Excellence Club Swim up Beachside Suite and 4 In an Excellence Club Rooftop Terrace...we stayed directly above the Honeymoon suite...and the view was AMAZING. I really liked being at the swim up suite because I was close to everything..one push on a raft and I could have anything I wanted! Moving on the wedding day was a litle hectic, but the staff helped a lot!<br \/> <br \/> Yamina is beautiful and makes everything perfect! I honestly decided every little detail with her in a meeting the day afer I gt there..and even I was surprised by how perfect everything was! BTW...if you don't want to spring for the floral arch ($500)..there are other options including just the bamboo w\/ draperies for $200. I wanted more of a simpler look, and the fact that is was cheaper was just icing on the cake....speaking of cake, I asked for a smaller cake since there were only 8 of us, but the choices were decadent. You can get anything you can think of! My cake was chocolate mousse and butter cake layers on the bottom, and a rasberry ganache-filled cheesecake on top. We had fondant on half and whipped cream on the cheesecake (I am not fond of traditional cake, and I don't like the taste of icing usually...)<br \/> <br \/> We chose our hors d'ouvres from the gold menu since there were so few of us and Yamina let me make a few exceptions to the dinner for my mom and sister who don't like filet of beef (they wanted chicken). The rest of us had filet of beef. Every one of the four courses was delicious!!!! We had a private spot on the beach (X Lounge) for the cocktail hour, and the SOl bar all to ourselves for the reception. The IPOD thing wrked out for us...but if you have a larger group, I would suggest bringing your own speakers or getting a dj or a band...the volume wasn't very loud. They provide the wedding songs for the wedding, too. We had a religious ceremony and did the sand thing (I used to think it was cheesy..but it felt right <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> The Minister spoke in English and I couldn't have asked for a more meaningful ceremony.<br \/> <br \/> The Excellence Club upgrade was worth it for us for only 3 reasons.....24 hour room service from an extended menu (evreryone else gets a smaller menu and it is from 7:00 am to 11:00 pm only), bottles of liqour brought to your room (worked well to have cognac brought ot our room when we had eaten too much) and the Excellence Club \"lobby\" always had a lught buffet going. It was so quick and easy to run in, grab a plate of food, and still catch our taxi, texas holdem gae, dance lesson, etc) By the middle of the week, we were grabbing plateS of food for everyone else too, so we could all snack on the run!<br \/> <br \/> he food at the resort wasn't bad at all....but I am a food snob, and the only restaurant that had my full approval was Spice, the Asian one. Everyone else loved Chez Isabelle and the Italian restaurant. The grill and the lobster house are great for lunches, though...all of the wraps, salads, french fries, sandwiches, etc were fantastic. The lobster was HUGE! The desserts were the best part...make sure you get the chocolate cake somewhere...it's actually like a little chocolate mousse filled truffle-style thing. i can't describe it really, but it was AMAZING!<br \/> <br \/> We went t Isla Mujeres and went mopedding one day...I wan't impressed. You couldn't really swim anywhere but Garafon Park (a tourist trap) and a taxi ran my husband off the road and hauled ass. Noone asked if he was ok, we had to pay $250 for $30 worth of damages, and the guy who ran the rental place refused to call the policia and even tried to pretend that he knew no other English except...\"give me $250 or I will not give you back your license\" They really ticked me off. That was the pnly place we went the entire time where we didn't feel safe. Tulum was beatiful, but I have been a few times....downtown shopping is still fun, and the hotel zone is worth seeing if you have time. We parasailed and rented jet skis...that was really fun, too. The snorkeling wasn't great where we went (isla mujeres) but it was fantastic the last time I went to Cancun when we rented the little two-seater power boats on the \"Jungle Tour\". They offer this package in the lobby..I would DEFINAELY recommend it.<br \/> <br \/> What else....oh yeah, the rooftop pools are freezing...kind of a buzzkill late at night...the resort is clothing optional (which I did not realize) and 1 out of every 15 women will be topless (mostly the 40 and over crowd) . Everyone there seemed extremely friendly and relaxed...making friends was constant! The service was impeccable..I have NEVER felt so pampered and I have vacationed quite a lot in the arribean and Mexico in luxury resorts...this one is my FAVORITE! We left our sliding glass door inlocked a lot, and never had anything bothered with in our room. The shows are great, and a little risque....the staff made everything fun. Im usually not an \"activities\" person, but I got a little addicted....ping pong tournaments, tequila tastings, I even volunteered as the assistant in a magic show. Fun was totally contageous!!! <br \/> <br \/> Don't buy anything from the gift shop...you can get a taxi downtown for $20 and buy it all there for 1\/30th of the prices. Keep your head down when getting out of the Cancun airport..those people are NOT your ide..they are lying, and will say\/do ANYTHING to get your attention so they can try to sell you timeshare....walk OUTSIDE and look for the placard with your name on it being held by one of the guys out there...this is your ride!<br \/> <br \/> um...make sure u ask for ketchup when u order fries..that doesn't just come with it, dont get caught in the pools or jacuzzis (the publi ones...not the ones in your room) after 8:30 pm or the head honcho guy comes out and makes you sign a clipboard saying that you have broken the rules and this is your final warning. We sat on our terrace every night and watched someone getting written up. Just go in the ocean if you feel like a late-night dip...its netted around the swimming area...so no worries.<br \/> <br \/> Sand is beautiful...there were no bugs....no problems with seaweed, temperature, weather, or anything else. Just PRFECTION all around! Ya'll will see when u get there!<br \/> Congrats to everyone!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;80\/st\/20090822\/e\/Lori+%26amp%3B+Alex+\/k\/bc54\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...bc54\/event.png<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/images\/smilies\/smile29.gif\">http:\/\/bestdestinationwedding.com\/fo...es\/smile29.gif<\/a><\/div><\/div>","Email":"bumblebee_287@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1238842852,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-216453.jpg?_r=0","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"bumblebee_287","Id":216453,"Name":"bumblebee_287","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1db601748a0b946528d2cd22a40cfca1","RawContent":"Oh yeah..I forgot breakfast...a Mimosa bar, bloody mary bar, and 3 rooms of buffet food at Barcelona!! YUM!","Attachments":[],"Id":819519,"PostDate":1251512473,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Oh yeah..I forgot breakfast...a Mimosa bar, bloody mary bar, and 3 rooms of buffet food at Barcelona!! YUM!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;80\/st\/20090822\/e\/Lori+%26amp%3B+Alex+\/k\/bc54\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...bc54\/event.png<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/images\/smilies\/smile29.gif\">http:\/\/bestdestinationwedding.com\/fo...es\/smile29.gif<\/a><\/div><\/div>","Email":"bumblebee_287@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1238842852,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-216453.jpg?_r=0","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"bumblebee_287","Id":216453,"Name":"bumblebee_287","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c8df53495bcc8832903880dd619a99f4","RawContent":"Bumblebee Im glad your wedding was beautiful and everything worked out with Yamina. I have two questions. Were you saying that people at EPM were topless? What was going on with the swimming policy (you can&#039;t swim after 8:30)? Oh and show us the pics :)","Attachments":[],"Id":819966,"PostDate":1251543966,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Bumblebee Im glad your wedding was beautiful and everything worked out with Yamina. I have two questions. Were you saying that people at EPM were topless? What was going on with the swimming policy (you can't swim after 8:30)? Oh and show us the pics <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;130\/st\/20100417\/e\/the+wedding+of+my+dreams\/dt\/-1\/k\/0f53\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...0f53\/event.png<\/a><br><br><i><strong>Excellence Playa Mujeres Bride<br>April 17, 2010<\/strong><\/i><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/t\/wukvjpB\/weight.png\">http:\/\/tickers.TickerFactory.com\/ezt...jpB\/weight.png<\/a><\/div><\/div>","Email":"s_katrese@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1229629965,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213251.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"s_katrese","Id":213251,"Name":"s_katrese","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b3fbf1bfb08ba66d9d255f65fc61691e","RawContent":"Yeah....there were topless women...not a lot...just 5-10 a day. There were all European and above 30 -- and after the first two days...we all quit noticing...they just kind of blurred into the scenery. There was this one 50 or 60 something woman topless in the pool on the 2nd to last day. She was DRUNK and trying to get up on a raft...I noticed her! You can&#039;t swim in any of the pools from 8 pm until 8 am. I was pissed when I found out...but then never really had the urge and the energy to go swimming late night anyway. We went swimming in the ocean one night..that was nice..and we had our own jacuzzi and pool upstairs..so it wasn&#039;t really a big deal. You&#039;d be surprised at how early you will be cutting out at night....I didn&#039;t make it passed 1:00 am any night :) \n \n I haven\/t figured out how to upload pics...but I&#039;ll try to get them on my wedding site today. \n \n Katrese...I haven&#039;t forgotton about you..I know I have to email you all my stuff...It&#039;s just taking me a while to get it all together..I&#039;ve used so many different computers (2 laptops...paretn&#039;s computer...work computer) and I have so many removeable disks and stuff with the stuff stored....Im scattered all over the place. I WILL email them to you this weekend though :)","Attachments":[],"Id":820209,"PostDate":1251579670,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Yeah....there were topless women...not a lot...just 5-10 a day. There were all European and above 30 -- and after the first two days...we all quit noticing...they just kind of blurred into the scenery. There was this one 50 or 60 something woman topless in the pool on the 2nd to last day. She was DRUNK and trying to get up on a raft...I noticed her! You can't swim in any of the pools from 8 pm until 8 am. I was pissed when I found out...but then never really had the urge and the energy to go swimming late night anyway. We went swimming in the ocean one night..that was nice..and we had our own jacuzzi and pool upstairs..so it wasn't really a big deal. You'd be surprised at how early you will be cutting out at night....I didn't make it passed 1:00 am any night <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> <br \/> <br \/> I haven\/t figured out how to upload pics...but I'll try to get them on my wedding site today. <br \/> <br \/> Katrese...I haven't forgotton about you..I know I have to email you all my stuff...It's just taking me a while to get it all together..I've used so many different computers (2 laptops...paretn's computer...work computer) and I have so many removeable disks and stuff with the stuff stored....Im scattered all over the place. I WILL email them to you this weekend though <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;80\/st\/20090822\/e\/Lori+%26amp%3B+Alex+\/k\/bc54\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...bc54\/event.png<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/images\/smilies\/smile29.gif\">http:\/\/bestdestinationwedding.com\/fo...es\/smile29.gif<\/a><\/div><\/div>","Email":"bumblebee_287@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1238842852,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-216453.jpg?_r=0","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"bumblebee_287","Id":216453,"Name":"bumblebee_287","IsOnline":false}}],"Pages":{"TotalItems":2876,"TotalPages":288,"CurrentPage":290,"NextPage":300,"PreviousPage":280,"LastPage":2870},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
