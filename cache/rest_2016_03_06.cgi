:\/\/tickers.TickerFactory.com\/ezt\/t\/wukvjpB\/weight.png\">http:\/\/tickers.TickerFactory.com\/ezt...jpB\/weight.png<\/a><\/div><\/div>","Email":"s_katrese@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1229629965,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213251.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"s_katrese","Id":213251,"Name":"s_katrese","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c294adf1750856ffa5fa085758ebe0d0","RawContent":"so, im not getting married here but we do plan on honeymooning here after our wedding in Huatulco. Do you guys know how the weather typically is in Jan?? We would get there on Jan 1st. I hope its not cold?!","Attachments":[],"Id":796212,"PostDate":1250019556,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                so, im not getting married here but we do plan on honeymooning here after our wedding in Huatulco. Do you guys know how the weather typically is in Jan?? We would get there on Jan 1st. I hope its not cold?!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i210.photobucket.com\/albums\/bb46\/nadinecloss\/rocks.jpg\">http:\/\/i210.photobucket.com\/albums\/b...loss\/rocks.jpg<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f77\/nadine-s-dreams-huatulco-review-12-29-09-a-53920\/\">My Dreams Huatulco Wedding Review<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f128\/nadine-s-planning-thread-52947\/\">My Planning Thread<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f76\/nadine-s-wedding-day-after-photots-54891\/#post1161576\">Photographer Review<\/a><\/div><\/div>","Email":"nadinecloss@hotmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1215636060,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-210423.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"*Nadine*","Id":210423,"Name":"*Nadine*","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"dffd4d487d9f2f008624e03171b73204","RawContent":"I am getting married at EPM on March 27, 2010! I will let you know how it goes since you will be there shortly after me.","Attachments":[],"Id":797254,"PostDate":1250092334,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I am getting married at EPM on March 27, 2010! I will let you know how it goes since you will be there shortly after me.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/img.weddingcountdown.com\/ticker\/pwa8adxad.png\">http:\/\/img.weddingcountdown.com\/ticker\/pwa8adxad.png<\/a><\/div><\/div>","Email":"weimsrking@comcast.net","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1248402182,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-219759.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"weimsrking","Id":219759,"Name":"weimsrking","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cc0130458d4c80b92939a616854f6fa7","RawContent":"Nadine, I don&#039;t think you will have anything to worry about the weather will probably be perfect not too cold or hot. It can&#039;t be worse than summer weather right?\n \n Hey ladies after you made deposits with your TAs how long did it take to hear from EPM wedding coordinator or did you make contact first. I really want to start looking at my wedding options (cake, flowers, etc...) I haven&#039;t done enough post to open the links on here yet.","Attachments":[],"Id":798807,"PostDate":1250153577,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Nadine, I don't think you will have anything to worry about the weather will probably be perfect not too cold or hot. It can't be worse than summer weather right?<br \/> <br \/> Hey ladies after you made deposits with your TAs how long did it take to hear from EPM wedding coordinator or did you make contact first. I really want to start looking at my wedding options (cake, flowers, etc...) I haven't done enough post to open the links on here yet.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;130\/st\/20100417\/e\/the+wedding+of+my+dreams\/dt\/-1\/k\/0f53\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...0f53\/event.png<\/a><br><br><i><strong>Excellence Playa Mujeres Bride<br>April 17, 2010<\/strong><\/i><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/t\/wukvjpB\/weight.png\">http:\/\/tickers.TickerFactory.com\/ezt...jpB\/weight.png<\/a><\/div><\/div>","Email":"s_katrese@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1229629965,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213251.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"s_katrese","Id":213251,"Name":"s_katrese","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e68b1a6b9fc433607df9a0ec32e0a652","RawContent":"Katrese, \n \n If you give me your email address, I&#039;ll send you all of the stuff I&#039;ve been collecting from everyone here, my TA, and Yamina (the wedding coordinator at EPM). It&#039;s A LOT :)\n Don&#039;t get stressed about Yamina not responding quickly....we&#039;ve all had this problem starting up--she gets WAY more attentive the closer you come to the wedding. The truth is, aside from collecting pictures, color swatches and ideas, there is not much you can do after you pick out your package and menu from EPM now.....almost everything gets finalized upon your arrival...which is why you should make sure you get these a few days beforehand even if you aren&#039;t having a &amp;quot;legal&amp;quot; ceremony.\n \n Anyhoo...I&#039;m pretty bummed that I haven&#039;t been able to get my picture of me and Alex to load properly....\n \n I leave for Mexico this Sunday---SO EXCITED!!!! If someone will teach me how to attach files to comments, I&#039;ll post pics everyday of the resort -- I know I loved seeing everyone else&#039;s pictures when they came back...it was like Christmas every time!!! :)\n \n Katrese, I&#039;ll check before I go and see if you have posted your email address and Ill send all my stuff on over before I go...\n \n Wish me luck girls!","Attachments":[],"Id":799285,"PostDate":1250193920,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Katrese, <br \/> <br \/> If you give me your email address, I'll send you all of the stuff I've been collecting from everyone here, my TA, and Yamina (the wedding coordinator at EPM). It's A LOT <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br \/> Don't get stressed about Yamina not responding quickly....we've all had this problem starting up--she gets WAY more attentive the closer you come to the wedding. The truth is, aside from collecting pictures, color swatches and ideas, there is not much you can do after you pick out your package and menu from EPM now.....almost everything gets finalized upon your arrival...which is why you should make sure you get these a few days beforehand even if you aren't having a \"legal\" ceremony.<br \/> <br \/> Anyhoo...I'm pretty bummed that I haven't been able to get my picture of me and Alex to load properly....<br \/> <br \/> I leave for Mexico this Sunday---SO EXCITED!!!! If someone will teach me how to attach files to comments, I'll post pics everyday of the resort -- I know I loved seeing everyone else's pictures when they came back...it was like Christmas every time!!! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br \/> <br \/> Katrese, I'll check before I go and see if you have posted your email address and Ill send all my stuff on over before I go...<br \/> <br \/> Wish me luck girls!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;80\/st\/20090822\/e\/Lori+%26amp%3B+Alex+\/k\/bc54\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...bc54\/event.png<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/images\/smilies\/smile29.gif\">http:\/\/bestdestinationwedding.com\/fo...es\/smile29.gif<\/a><\/div><\/div>","Email":"bumblebee_287@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1238842852,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-216453.jpg?_r=0","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"bumblebee_287","Id":216453,"Name":"bumblebee_287","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"df392ed2547f6da399e9b9861a47deab","RawContent":"Ps Yamina sent me some really different and pretty seating for the weddings...they are like golden, overstuffed, soft benches. They have a very minimalist\/modern look--I haven&#039;t seen these before yesterday...also, she has he amazing pics of different themes and colors that she has put together!","Attachments":[],"Id":799292,"PostDate":1250194178,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Ps Yamina sent me some really different and pretty seating for the weddings...they are like golden, overstuffed, soft benches. They have a very minimalist\/modern look--I haven't seen these before yesterday...also, she has he amazing pics of different themes and colors that she has put together!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;80\/st\/20090822\/e\/Lori+%26amp%3B+Alex+\/k\/bc54\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...bc54\/event.png<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/images\/smilies\/smile29.gif\">http:\/\/bestdestinationwedding.com\/fo...es\/smile29.gif<\/a><\/div><\/div>","Email":"bumblebee_287@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1238842852,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-216453.jpg?_r=0","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"bumblebee_287","Id":216453,"Name":"bumblebee_287","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a46a3a8f4676314f44974dafa758adfa","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;bumblebee_287&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Katrese, \n \n If you give me your email address, I&#039;ll send you all of the stuff I&#039;ve been collecting from everyone here, my TA, and Yamina (the wedding coordinator at EPM). It&#039;s A LOT :)\n Don&#039;t get stressed about Yamina not responding quickly....we&#039;ve all had this problem starting up--she gets WAY more attentive the closer you come to the wedding. The truth is, aside from collecting pictures, color swatches and ideas, there is not much you can do after you pick out your package and menu from EPM now.....almost everything gets finalized upon your arrival...which is why you should make sure you get these a few days beforehand even if you aren&#039;t having a &amp;quot;legal&amp;quot; ceremony.\n \n Anyhoo...I&#039;m pretty bummed that I haven&#039;t been able to get my picture of me and Alex to load properly....\n \n I leave for Mexico this Sunday---SO EXCITED!!!! If someone will teach me how to attach files to comments, I&#039;ll post pics everyday of the resort -- I know I loved seeing everyone else&#039;s pictures when they came back...it was like Christmas every time!!! :)\n \n Katrese, I&#039;ll check before I go and see if you have posted your email address and Ill send all my stuff on over before I go...\n \n Wish me luck girls!&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;\n Good luck! You must be so excited! Yippeee for you! Have the best time and promise to telll us everything upon your return!","Attachments":[],"Id":799304,"PostDate":1250194581,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>bumblebee_287<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Katrese, <br \/> <br \/> If you give me your email address, I'll send you all of the stuff I've been collecting from everyone here, my TA, and Yamina (the wedding coordinator at EPM). It's A LOT <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br \/> Don't get stressed about Yamina not responding quickly....we've all had this problem starting up--she gets WAY more attentive the closer you come to the wedding. The truth is, aside from collecting pictures, color swatches and ideas, there is not much you can do after you pick out your package and menu from EPM now.....almost everything gets finalized upon your arrival...which is why you should make sure you get these a few days beforehand even if you aren't having a \"legal\" ceremony.<br \/> <br \/> Anyhoo...I'm pretty bummed that I haven't been able to get my picture of me and Alex to load properly....<br \/> <br \/> I leave for Mexico this Sunday---SO EXCITED!!!! If someone will teach me how to attach files to comments, I'll post pics everyday of the resort -- I know I loved seeing everyone else's pictures when they came back...it was like Christmas every time!!! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br \/> <br \/> Katrese, I'll check before I go and see if you have posted your email address and Ill send all my stuff on over before I go...<br \/> <br \/> Wish me luck girls!<\/div> <\/td> <\/tr> <\/table> <\/div><br \/> Good luck! You must be so excited! Yippeee for you! Have the best time and promise to telll us everything upon your return!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i30.photobucket.com\/albums\/c336\/dmbstolio\/Dec122009238-1.jpg\">http:\/\/i30.photobucket.com\/albums\/c3...22009238-1.jpg<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/www.jenandken2009.com\">www.jenandken2009.com<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;130\/st\/20091212\/e\/Jen+%26amp%3B+Kenny%27s+wedding\/k\/02c3\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...02c3\/event.png<\/a><\/div><\/div>","Email":"davis1974@gmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1215061237,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-210302.gif?_r=0","PhotoWidth":98,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Jennifer Davis","Id":210302,"Name":"Jennifer Davis","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a805c2c1ee1650fd229028aeafb82235","RawContent":"I will!!! I&#039;ll give you every beautiful juicy detail about the place...I&#039;m also spending a day mopedding around Isla Mujeres, I&#039;m going to go see the 200 acre aMayan ruins (it&#039;s the only one I haven&#039;t seen yet from previous vacations) and I&#039;m going to spend a day in Playa del Carmen...there&#039;s a bar\/restaurant there that is literally in a cave...you drink cocktails under stalagmites, and eat next to cave-streams...It looks AWESOME and there are really good reviews on Trip Advisor for it.\n \n Thanks!","Attachments":[],"Id":799445,"PostDate":1250199996,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I will!!! I'll give you every beautiful juicy detail about the place...I'm also spending a day mopedding around Isla Mujeres, I'm going to go see the 200 acre aMayan ruins (it's the only one I haven't seen yet from previous vacations) and I'm going to spend a day in Playa del Carmen...there's a bar\/restaurant there that is literally in a cave...you drink cocktails under stalagmites, and eat next to cave-streams...It looks AWESOME and there are really good reviews on Trip Advisor for it.<br \/> <br \/> Thanks!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;80\/st\/20090822\/e\/Lori+%26amp%3B+Alex+\/k\/bc54\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...bc54\/event.png<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/images\/smilies\/smile29.gif\">http:\/\/bestdestinationwedding.com\/fo...es\/smile29.gif<\/a><\/div><\/div>","Email":"bumblebee_287@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1238842852,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-216453.jpg?_r=0","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"bumblebee_287","Id":216453,"Name":"bumblebee_287","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"74f578d07776a5cd0bedf78e77a65e69","RawContent":"Lori, Good luck I am sooooo excited for you&lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile29.gif\" border=\"0\" alt=\"\" title=\"Smile29\" class=\"inlineimg\" \/&gt;...hurry back with lots of info and pics. The cave restaurant sounds amazing let us know how that goes too. I will PM you my e-mail address.\n \n Another question, for those of you having Saturday weddings when are your guest arriving and leaving? Right now the package suggestion I have is arrive on Friday leave on Monday... I think I want to change it to arrive on Thursday leave on Sunday.","Attachments":[],"Id":799462,"PostDate":1250200644,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Lori, Good luck I am sooooo excited for you<span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile29.gif\" border=\"0\" alt=\"\" title=\"Smile29\" class=\"inlineimg\" \/><\/span>...hurry back with lots of info and pics. The cave restaurant sounds amazing let us know how that goes too. I will PM you my e-mail address.<br \/> <br \/> Another question, for those of you having Saturday weddings when are your guest arriving and leaving? Right now the package suggestion I have is arrive on Friday leave on Monday... I think I want to change it to arrive on Thursday leave on Sunday.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;130\/st\/20100417\/e\/the+wedding+of+my+dreams\/dt\/-1\/k\/0f53\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...0f53\/event.png<\/a><br><br><i><strong>Excellence Playa Mujeres Bride<br>April 17, 2010<\/strong><\/i><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/t\/wukvjpB\/weight.png\">http:\/\/tickers.TickerFactory.com\/ezt...jpB\/weight.png<\/a><\/div><\/div>","Email":"s_katrese@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1229629965,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213251.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"s_katrese","Id":213251,"Name":"s_katrese","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cf9797539380975b31dca850e22d4130","RawContent":"My girls are coming in on Thursday and leaving Sunday. My family is coming in on tuesday and leaving Sunday-- there is some kind of special deal my TA got me for 3 night guest stays :) I am only having about 10 guests, though....we&#039;re having a Southern style throwdown when we get back :)","Attachments":[],"Id":801721,"PostDate":1250314431,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                My girls are coming in on Thursday and leaving Sunday. My family is coming in on tuesday and leaving Sunday-- there is some kind of special deal my TA got me for 3 night guest stays <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> I am only having about 10 guests, though....we're having a Southern style throwdown when we get back <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;80\/st\/20090822\/e\/Lori+%26amp%3B+Alex+\/k\/bc54\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...bc54\/event.png<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/images\/smilies\/smile29.gif\">http:\/\/bestdestinationwedding.com\/fo...es\/smile29.gif<\/a><\/div><\/div>","Email":"bumblebee_287@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1238842852,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-216453.jpg?_r=0","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"bumblebee_287","Id":216453,"Name":"bumblebee_287","IsOnline":false}}],"Pages":{"TotalItems":2876,"TotalPages":288,"CurrentPage":280,"NextPage":290,"PreviousPage":270,"LastPage":2870},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
