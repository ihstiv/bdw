t":false,"CanDelete":false,"CanLike":true,"TopicId":79825,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"d588307db5d88f45fba2a3dc57576f5c","RawContent":"I just ordered mine from There yesterday!  I can&#039;t wait!   Yours look awesome","Attachments":[],"Id":1909198,"PostDate":1452347951,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I just ordered mine from There yesterday!  I can't wait!   Yours look awesome \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"amyzig2@hotmail.com","IpAddress":"24.131.215.221","GroupId":3,"GroupName":"Member","JoinDate":1435842463,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"amyzig2","Id":283791,"Name":"amyzig2","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.15.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79825,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a52acfba52c794b044f34d93ec9018a7","RawContent":"&lt;p&gt;Those turned out beautifully! They&#039;re a favourite of the brides to be here. It&#039;s so appropriate for a destination wedding!&lt;\/p&gt;","Attachments":[],"Id":1909212,"PostDate":1452375363,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Those turned out beautifully! They're a favourite of the brides to be here. It's so appropriate for a destination wedding!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span><\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/ann.chadwick.5\/media_set?set=a.10153262834771016.1073741828.569791015&type=3'><span style=\"color:#ff0099;\"><em>https:\/\/www.facebook.com\/ann.chadwick.5\/media_set?set=a.10153262834771016.1073741828.569791015&type=3<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/'><span style=\"color:#ff0099;\"><em>http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283458999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"204.124.239.6","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79825,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"37e4a31283398a5a77d260625e8d272c","RawContent":"&lt;p&gt;@[member=\"AlmostDrMrsUrban\"] lets just say they were pricey! But I&#039;d do it over again because it really does set the mood for a destination wedding. ALL of my family and friends were very impressed.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I tried to DIY it by buying the template, but I couldnt understand the software needed to complete it.&lt;\/p&gt;","Attachments":[],"Id":1909275,"PostDate":1452531356,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"285791\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/285791-almostdrmrsurban\/' title='Member profile'><span itemprop=\"name\">AlmostDrMrsUrban<\/span><\/a> lets just say they were pricey! But I'd do it over again because it really does set the mood for a destination wedding. ALL of my family and friends were very impressed.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I tried to DIY it by buying the template, but I couldnt understand the software needed to complete it.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rhomes.jones@gmail.com","IpAddress":"174.21.125.83","GroupId":39,"GroupName":"Newbie","JoinDate":1428717291,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282697.jpg?_r=1436371862","PhotoWidth":75,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"dandi76","Id":282697,"Name":"dandi76","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.202.203.126","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79825,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8160576a625bebeb31902b4e893fdf57","RawContent":"&lt;p&gt;Yeah, I think I&#039;m going to have to try to do them myself with the template since I&#039;m sending out so many...The list keeps growing when I need it to get smaller&lt;\/p&gt;","Attachments":[],"Id":1909342,"PostDate":1452621300,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Yeah, I think I'm going to have to try to do them myself with the template since I'm sending out so many...The list keeps growing when I need it to get smaller<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"townsendsmithwed@gmail.com","IpAddress":"173.66.3.166","GroupId":39,"GroupName":"Newbie","JoinDate":1427042404,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282503.jpeg?_r=1444096181","PhotoWidth":200,"PhotoHeight":217,"PhotoType":"custom"},"FormattedName":"tiffanyt","Id":282503,"Name":"tiffanyt","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"204.124.239.6","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79825,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"38fd1ac81e367588348aabf13a5db75e","RawContent":"&lt;p&gt;@[member=\"tiffanyt\"] There is a free 30 day trial with illistrator. I would recommend buying the template and watching all of the videos you can find about how to use it. The 30 days goes by fast. If you are having trouble it can eat into your free trial.&lt;\/p&gt;","Attachments":[],"Id":1909343,"PostDate":1452623990,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"282503\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282503-tiffanyt\/' title='Member profile'><span itemprop=\"name\">tiffanyt<\/span><\/a> There is a free 30 day trial with illistrator. I would recommend buying the template and watching all of the videos you can find about how to use it. The 30 days goes by fast. If you are having trouble it can eat into your free trial.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rhomes.jones@gmail.com","IpAddress":"174.21.125.83","GroupId":39,"GroupName":"Newbie","JoinDate":1428717291,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282697.jpg?_r=1436371862","PhotoWidth":75,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"dandi76","Id":282697,"Name":"dandi76","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.202.203.126","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79825,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"9ec8618f5f12188d8cc19fad9c8adafa","RawContent":"&lt;p&gt;@[member=\"dandi76\"] Good to know! Thanks for the tip! :)&lt;\/p&gt;","Attachments":[],"Id":1909348,"PostDate":1452626825,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"282697\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282697-dandi76\/' title='Member profile'><span itemprop=\"name\">dandi76<\/span><\/a> Good to know! Thanks for the tip! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"townsendsmithwed@gmail.com","IpAddress":"173.66.3.166","GroupId":39,"GroupName":"Newbie","JoinDate":1427042404,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282503.jpeg?_r=1444096181","PhotoWidth":200,"PhotoHeight":217,"PhotoType":"custom"},"FormattedName":"tiffanyt","Id":282503,"Name":"tiffanyt","IsOnline":false}}],"Id":"79825","Title":"Passport Wedding Invitations","LastPostDate":1454124553},"Pages":{"TotalItems":11,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
