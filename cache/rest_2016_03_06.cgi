{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"995acdbdf40b6d3597d5e44b64f17451","RawContent":"Greetings fellow EPM brides!\n \n My fiancee and I are planning on getting married there May 8, 2010. Reading through all of the posts has been very helpful. It has made me feel both reassured and stressed:) There are many things I had not considered, but it seems like it is a fairly stress-free experience. Thank you all for posting your experiences.\n \n Does anyone know of somewhere I can look for ideas on OOT bags?\n \n Thanks,\n Cat","Attachments":[],"Id":822485,"PostDate":1251780588,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Greetings fellow EPM brides!<br \/> <br \/> My fiancee and I are planning on getting married there May 8, 2010. Reading through all of the posts has been very helpful. It has made me feel both reassured and stressed:) There are many things I had not considered, but it seems like it is a fairly stress-free experience. Thank you all for posting your experiences.<br \/> <br \/> Does anyone know of somewhere I can look for ideas on OOT bags?<br \/> <br \/> Thanks,<br \/> Cat\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/img.weddingcountdown.com\/ticker\/tyxkfsxwd.png\">http:\/\/img.weddingcountdown.com\/ticker\/tyxkfsxwd.png<\/a><\/div><\/div>","Email":"cat_geraghty@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1240827506,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-217077.gif?_r=0","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"FormattedName":"cathleen10","Id":217077,"Name":"cathleen10","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bb7773974359aa6210decfc77c3c7534","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;cathleen10&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Greetings fellow EPM brides!\n \n My fiancee and I are planning on getting married there May 8, 2010. Reading through all of the posts has been very helpful. It has made me feel both reassured and stressed:) There are many things I had not considered, but it seems like it is a fairly stress-free experience. Thank you all for posting your experiences.\n \n Does anyone know of somewhere I can look for ideas on OOT bags?\n \n Thanks,\n Cat&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;I bought my oot bags from Ebay and used Minimus and harmon discount for the fillings. My guest loved them.","Attachments":[],"Id":823163,"PostDate":1251830773,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>cathleen10<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Greetings fellow EPM brides!<br \/> <br \/> My fiancee and I are planning on getting married there May 8, 2010. Reading through all of the posts has been very helpful. It has made me feel both reassured and stressed:) There are many things I had not considered, but it seems like it is a fairly stress-free experience. Thank you all for posting your experiences.<br \/> <br \/> Does anyone know of somewhere I can look for ideas on OOT bags?<br \/> <br \/> Thanks,<br \/> Cat<\/div> <\/td> <\/tr> <\/table> <\/div>I bought my oot bags from Ebay and used Minimus and harmon discount for the fillings. My guest loved them.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/www.weddingcountdown.com\/ticker\/6qscsou.png\">http:\/\/www.weddingcountdown.com\/ticker\/6qscsou.png<\/a><br><span>[\/CENTER]<\/span><\/div><\/div>","Email":"reeveswedding@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1219377984,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211327.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"reevesbride","Id":211327,"Name":"reevesbride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"698035650bbf6ee6dab66587cc9b27bc","RawContent":"Thanks for the suggestions. Depending on how many people come we are also planning on putting an iPod shuffle in the bag with some of our favorite songs (we&#039;ll have to see when we get closer what the budget looks like). I know the room provides an iPod player. Does anyone know if it will play a shuffle??\n \n Thanks!","Attachments":[],"Id":823181,"PostDate":1251831299,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks for the suggestions. Depending on how many people come we are also planning on putting an iPod shuffle in the bag with some of our favorite songs (we'll have to see when we get closer what the budget looks like). I know the room provides an iPod player. Does anyone know if it will play a shuffle??<br \/> <br \/> Thanks!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/img.weddingcountdown.com\/ticker\/tyxkfsxwd.png\">http:\/\/img.weddingcountdown.com\/ticker\/tyxkfsxwd.png<\/a><\/div><\/div>","Email":"cat_geraghty@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1240827506,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-217077.gif?_r=0","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"FormattedName":"cathleen10","Id":217077,"Name":"cathleen10","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f9957c072eeacd14ae7b1bc30dbcda71","RawContent":"I&#039;m not sure if this will help anyone, but here is the letter that we sent out with the save the date magnet.&lt;p&gt;&amp;nbsp;&lt;\/p&gt;&lt;span huddler_attributes=\"{&amp;quot;plugin&amp;quot;:&amp;quot;attachment&amp;quot;,&amp;quot;params&amp;quot;:{&amp;quot;id&amp;quot;:&amp;quot;6500&amp;quot;,&amp;quot;name&amp;quot;:&amp;quot;weddingletter.pdf&amp;quot;,&amp;quot;description&amp;quot;:&amp;quot;&amp;quot;,&amp;quot;size&amp;quot;:1810.87890625,&amp;quot;type&amp;quot;:&amp;quot;pdf&amp;quot;}}\" huddler_plugin=\"attachment\"&gt;&amp;nbsp;&lt;\/span&gt;","Attachments":[],"Id":823242,"PostDate":1251832744,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm not sure if this will help anyone, but here is the letter that we sent out with the save the date magnet.<p>\u00a0<\/p><span huddler_attributes=\"{\"plugin\":\"attachment\",\"params\":{\"id\":\"6500\",\"name\":\"weddingletter.pdf\",\"description\":\"\",\"size\":1810.87890625,\"type\":\"pdf\"}}\" huddler_plugin=\"attachment\">\u00a0<\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/img.weddingcountdown.com\/ticker\/tyxkfsxwd.png\">http:\/\/img.weddingcountdown.com\/ticker\/tyxkfsxwd.png<\/a><\/div><\/div>","Email":"cat_geraghty@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1240827506,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-217077.gif?_r=0","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"FormattedName":"cathleen10","Id":217077,"Name":"cathleen10","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fbdcf8092c2c039eb3218bce4923fc12","RawContent":"Hi everyone~ I am actually getting married at the Riu Palace but leaving the next morning to Honeymoon at EPM. I really want to do a TTD and cant see where to fit it in while at the RPRM- I was wondering if the EPM has it&#039;s own photographer anyone has used or if I should just book a non affiliated photog? Also, it that&#039;s the case do they have any rules against me bringing in an outside vendor for an hour or so? Any info is appreciated!!","Attachments":[],"Id":824718,"PostDate":1251872058,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi everyone~ I am actually getting married at the Riu Palace but leaving the next morning to Honeymoon at EPM. I really want to do a TTD and cant see where to fit it in while at the RPRM- I was wondering if the EPM has it's own photographer anyone has used or if I should just book a non affiliated photog? Also, it that's the case do they have any rules against me bringing in an outside vendor for an hour or so? Any info is appreciated!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i83.photobucket.com\/albums\/j307\/PAChumley\/Engaged\/CabofbMay2009XOXO089-1.jpg\">http:\/\/i83.photobucket.com\/albums\/j3...9XOXO089-1.jpg<\/a><\/div><\/div>","Email":"pachumley@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1244684485,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-218326.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Paige2010","Id":218326,"Name":"Paige2010","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"772a4fc2b3aa9091efcc0c51df93b68f","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;Paige2010&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Hi everyone~ I am actually getting married at the Riu Palace but leaving the next morning to Honeymoon at EPM. I really want to do a TTD and cant see where to fit it in while at the RPRM- I was wondering if the EPM has it&#039;s own photographer anyone has used or if I should just book a non affiliated photog? Also, it that&#039;s the case do they have any rules against me bringing in an outside vendor for an hour or so? Any info is appreciated!!&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;Yes, Excellence Playa Mujeres has it&#039;s own photographer. If you are interested in getting pricing scroll through this thread - I posted the information. If you would like to bring in an outside vendor for your session, the charge is $100.00.\n \n Good luck!","Attachments":[],"Id":826770,"PostDate":1251951912,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>Paige2010<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Hi everyone~ I am actually getting married at the Riu Palace but leaving the next morning to Honeymoon at EPM. I really want to do a TTD and cant see where to fit it in while at the RPRM- I was wondering if the EPM has it's own photographer anyone has used or if I should just book a non affiliated photog? Also, it that's the case do they have any rules against me bringing in an outside vendor for an hour or so? Any info is appreciated!!<\/div> <\/td> <\/tr> <\/table> <\/div>Yes, Excellence Playa Mujeres has it's own photographer. If you are interested in getting pricing scroll through this thread - I posted the information. If you would like to bring in an outside vendor for your session, the charge is $100.00.<br \/> <br \/> Good luck!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i30.photobucket.com\/albums\/c336\/dmbstolio\/Dec122009238-1.jpg\">http:\/\/i30.photobucket.com\/albums\/c3...22009238-1.jpg<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/www.jenandken2009.com\">www.jenandken2009.com<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;130\/st\/20091212\/e\/Jen+%26amp%3B+Kenny%27s+wedding\/k\/02c3\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...02c3\/event.png<\/a><\/div><\/div>","Email":"davis1974@gmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1215061237,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-210302.gif?_r=0","PhotoWidth":98,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Jennifer Davis","Id":210302,"Name":"Jennifer Davis","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fb959579da28ff194db83702d2183b0e","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;cathleen10&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;I&#039;m not sure if this will help anyone, but here is the letter that we sent out with the save the date magnet.&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;I just checked out your wedding letter! Amazing job! Thanks for sharing. I am actually working on something similar right now!","Attachments":[],"Id":832815,"PostDate":1252363516,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>cathleen10<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">I'm not sure if this will help anyone, but here is the letter that we sent out with the save the date magnet.<\/div> <\/td> <\/tr> <\/table> <\/div>I just checked out your wedding letter! Amazing job! Thanks for sharing. I am actually working on something similar right now!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i30.photobucket.com\/albums\/c336\/dmbstolio\/Dec122009238-1.jpg\">http:\/\/i30.photobucket.com\/albums\/c3...22009238-1.jpg<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/www.jenandken2009.com\">www.jenandken2009.com<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;130\/st\/20091212\/e\/Jen+%26amp%3B+Kenny%27s+wedding\/k\/02c3\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...02c3\/event.png<\/a><\/div><\/div>","Email":"davis1974@gmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1215061237,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-210302.gif?_r=0","PhotoWidth":98,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Jennifer Davis","Id":210302,"Name":"Jennifer Davis","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c1077c66956a3c352e0b0a3e34cbc0a7","RawContent":"Did anyone who has already gotten married use the mariachi band at cocktail hour? I am torn between mariachi and just getting the DJ to do everything (ceremony, cocktail hour, reception). Thoughts?","Attachments":[],"Id":832830,"PostDate":1252363880,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Did anyone who has already gotten married use the mariachi band at cocktail hour? I am torn between mariachi and just getting the DJ to do everything (ceremony, cocktail hour, reception). Thoughts?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i30.photobucket.com\/albums\/c336\/dmbstolio\/Dec122009238-1.jpg\">http:\/\/i30.photobucket.com\/albums\/c3...22009238-1.jpg<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/www.jenandken2009.com\">www.jenandken2009.com<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;130\/st\/20091212\/e\/Jen+%26amp%3B+Kenny%27s+wedding\/k\/02c3\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...02c3\/event.png<\/a><\/div><\/div>","Email":"davis1974@gmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1215061237,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-210302.gif?_r=0","PhotoWidth":98,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Jennifer Davis","Id":210302,"Name":"Jennifer Davis","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c5c13403608b61c66dbc3a8965fd897a","RawContent":"Jennifer, I think the DJ will be your best bet if you have a nice size group coming...if your group is small then the Mariachi band may suite you better.\n Just want to say welcome to all the new faces(Cathleen10 and Paige2010)\n Also Yamina finally got in touch with me a few weeks back so I was able to get her to send over all the attachments I needed.","Attachments":[],"Id":834934,"PostDate":1252471750,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Jennifer, I think the DJ will be your best bet if you have a nice size group coming...if your group is small then the Mariachi band may suite you better.<br \/> Just want to say welcome to all the new faces(Cathleen10 and Paige2010)<br \/> Also Yamina finally got in touch with me a few weeks back so I was able to get her to send over all the attachments I needed.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;130\/st\/20100417\/e\/the+wedding+of+my+dreams\/dt\/-1\/k\/0f53\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...0f53\/event.png<\/a><br><br><i><strong>Excellence Playa Mujeres Bride<br>April 17, 2010<\/strong><\/i><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/t\/wukvjpB\/weight.png\">http:\/\/tickers.TickerFactory.com\/ezt...jpB\/weight.png<\/a><\/div><\/div>","Email":"s_katrese@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1229629965,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213251.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"s_katrese","Id":213251,"Name":"s_katrese","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"520a7626c0755db2f1932287ae888f47","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;Jennifer Davis&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Did anyone who has already gotten married use the mariachi band at cocktail hour? I am torn between mariachi and just getting the DJ to do everything (ceremony, cocktail hour, reception). Thoughts?&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;Hey Jennifer, \n \n I actually used both the mariachi and a DJ. I used Disco Movil Cancun and loved him. Its really up to you but the mariachi was festive and interactive people seemed to enjoy them. The Mariachi was good for pictures too. Just a thought! \n \n Lauren","Attachments":[],"Id":835044,"PostDate":1252476189,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>Jennifer Davis<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Did anyone who has already gotten married use the mariachi band at cocktail hour? I am torn between mariachi and just getting the DJ to do everything (ceremony, cocktail hour, reception). Thoughts?<\/div> <\/td> <\/tr> <\/table> <\/div>Hey Jennifer, <br \/> <br \/> I actually used both the mariachi and a DJ. I used Disco Movil Cancun and loved him. Its really up to you but the mariachi was festive and interactive people seemed to enjoy them. The Mariachi was good for pictures too. Just a thought! <br \/> <br \/> Lauren\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/www.weddingcountdown.com\/ticker\/6qscsou.png\">http:\/\/www.weddingcountdown.com\/ticker\/6qscsou.png<\/a><br><span>[\/CENTER]<\/span><\/div><\/div>","Email":"reeveswedding@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1219377984,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211327.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"reevesbride","Id":211327,"Name":"reevesbride","IsOnline":false}}],"Pages":{"TotalItems":2876,"TotalPages":288,"CurrentPage":300,"NextPage":310,"PreviousPage":290,"LastPage":2870},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
