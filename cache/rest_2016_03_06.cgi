{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0f93bf7c73fb3983e4e510c64a6b2c6b","RawContent":"Welcom Traci and congrats on your engagement!\n \n Lauren, when I asked Nayeli about what time my guest could come onto the resort I believe she said a couple of hours before. I dont&#039; have it in writing because it was a phone conversation but I hope it still holds to be true. Only our photographer is staying at this resort and I need my mom and bridesmaids to get there way before to help me get ready! Hopefully Nayeli will make an exception for me.","Attachments":[],"Id":643501,"PostDate":1238994467,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Welcom Traci and congrats on your engagement!<br \/> <br \/> Lauren, when I asked Nayeli about what time my guest could come onto the resort I believe she said a couple of hours before. I dont' have it in writing because it was a phone conversation but I hope it still holds to be true. Only our photographer is staying at this resort and I need my mom and bridesmaids to get there way before to help me get ready! Hopefully Nayeli will make an exception for me.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Mesita and Durante<\/span><br><span>June 18, 2009<\/span><br><span>Excellence Playa Mujeres<\/span><br><br><span>My wedding review:<\/span><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t45032#post857892\">http:\/\/bestdestinationwedding.com\/fo...032#post857892<\/a><span>My wedding pro slideshow:<\/span><a data-ipb='nomediaparse' href=\"http:\/\/www.keithcephus.com\/mesita\">http:\/\/www.keithcephus.com\/mesita<\/a><a data-ipb='nomediaparse' href=\"http:\/\/www.ezticker.com\/ticker\/947\/192\/20090618\/Our+Swine+Flu+Free+Wedding%21\/ticker.png\">http:\/\/www.ezticker.com\/ticker\/947\/1...%21\/ticker.png<\/a><\/div><\/div>","Email":"mesita.simms@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1221110745,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211672.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Sensatori Bride","Id":211672,"Name":"Sensatori Bride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8e72e1f7f5220a7445bc43976cfd1492","RawContent":"After having such a pleasant sight visit and raving about how wonderful the planning experience with excellence. I&#8217;m just so frustrated with going back and forth with my questions and the new planner. I&#8217;m just tired and frustrated. I&#8217;m now just going to have my travel agent deal with the hotel directly because I can&#8217;t seem to get my questions answered. Sorry Ladies, just venting. But I keep going back and forth with this new planner. I know there is nothing I can do about it but I miss Nayeli, I had a lot more confidence in her. Especially, she was the one who I interviewed in the very beginning who gained my trust and faith.","Attachments":[],"Id":644661,"PostDate":1239079853,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                After having such a pleasant sight visit and raving about how wonderful the planning experience with excellence. I&#8217;m just so frustrated with going back and forth with my questions and the new planner. I&#8217;m just tired and frustrated. I&#8217;m now just going to have my travel agent deal with the hotel directly because I can&#8217;t seem to get my questions answered. Sorry Ladies, just venting. But I keep going back and forth with this new planner. I know there is nothing I can do about it but I miss Nayeli, I had a lot more confidence in her. Especially, she was the one who I interviewed in the very beginning who gained my trust and faith.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/www.weddingcountdown.com\/ticker\/6qscsou.png\">http:\/\/www.weddingcountdown.com\/ticker\/6qscsou.png<\/a><br><span>[\/CENTER]<\/span><\/div><\/div>","Email":"reeveswedding@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1219377984,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211327.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"reevesbride","Id":211327,"Name":"reevesbride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4a8a6edf13b0563a23e5eb2092809117","RawContent":"&lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile29.gif\" border=\"0\" alt=\"\" title=\"Smile29\" class=\"inlineimg\" \/&gt; Hmm, I dont think it will get better with your travel agent....I am using a coordinator and we are trying to book my date...its been a week no response.","Attachments":[],"Id":645407,"PostDate":1239137087,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile29.gif\" border=\"0\" alt=\"\" title=\"Smile29\" class=\"inlineimg\" \/><\/span> Hmm, I dont think it will get better with your travel agent....I am using a coordinator and we are trying to book my date...its been a week no response.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/www.ezticker.com\/ticker\/1159\/1768\/20100522\/Until+I+Marry+My+Love\/ticker.png\">http:\/\/www.ezticker.com\/ticker\/1159\/...ove\/ticker.png<\/a><\/div><\/div>","Email":"tracihopeis@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1238572485,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-216339.gif?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"thope","Id":216339,"Name":"thope","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b52badfe7392272828cb0ba34dbd945d","RawContent":"Lauren,\n \n I would suggest emailing Nayeli requesting to work with her since you started planning with her and that is where your comfort level is. It&#039;s getting close to crnch time for you. You don&#039;t need the added stress of having a lack of confidence in Yamina. She is new and still learning I&#039;m sure. I received my first email back from Yamina tonight and she was able to answer my questions. I CCed Nayeli though, as I do on all my notes. Maybe that had something to do with it?\n \n Good luck!","Attachments":[],"Id":646034,"PostDate":1239164675,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Lauren,<br \/> <br \/> I would suggest emailing Nayeli requesting to work with her since you started planning with her and that is where your comfort level is. It's getting close to crnch time for you. You don't need the added stress of having a lack of confidence in Yamina. She is new and still learning I'm sure. I received my first email back from Yamina tonight and she was able to answer my questions. I CCed Nayeli though, as I do on all my notes. Maybe that had something to do with it?<br \/> <br \/> Good luck!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i30.photobucket.com\/albums\/c336\/dmbstolio\/Dec122009238-1.jpg\">http:\/\/i30.photobucket.com\/albums\/c3...22009238-1.jpg<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/www.jenandken2009.com\">www.jenandken2009.com<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;130\/st\/20091212\/e\/Jen+%26amp%3B+Kenny%27s+wedding\/k\/02c3\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...02c3\/event.png<\/a><\/div><\/div>","Email":"davis1974@gmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1215061237,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-210302.gif?_r=0","PhotoWidth":98,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Jennifer Davis","Id":210302,"Name":"Jennifer Davis","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7637510d2375793e29e83bf9a4fbdfd1","RawContent":"Just wanted to let you girls know that I confirmed today via email that my guests are allowed to come onto the resort 2 hours prior to the start of my wedding. I&#039;m printing out that email and taking it with me in case I have any issues!\n \n Lauren, Yamina is pretty responsive. Maybe it&#039;s because my wedding is getting pretty close. You have any questions you want me to ask?\n \n Mesita","Attachments":[],"Id":647553,"PostDate":1239256101,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Just wanted to let you girls know that I confirmed today via email that my guests are allowed to come onto the resort 2 hours prior to the start of my wedding. I'm printing out that email and taking it with me in case I have any issues!<br \/> <br \/> Lauren, Yamina is pretty responsive. Maybe it's because my wedding is getting pretty close. You have any questions you want me to ask?<br \/> <br \/> Mesita\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Mesita and Durante<\/span><br><span>June 18, 2009<\/span><br><span>Excellence Playa Mujeres<\/span><br><br><span>My wedding review:<\/span><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t45032#post857892\">http:\/\/bestdestinationwedding.com\/fo...032#post857892<\/a><span>My wedding pro slideshow:<\/span><a data-ipb='nomediaparse' href=\"http:\/\/www.keithcephus.com\/mesita\">http:\/\/www.keithcephus.com\/mesita<\/a><a data-ipb='nomediaparse' href=\"http:\/\/www.ezticker.com\/ticker\/947\/192\/20090618\/Our+Swine+Flu+Free+Wedding%21\/ticker.png\">http:\/\/www.ezticker.com\/ticker\/947\/1...%21\/ticker.png<\/a><\/div><\/div>","Email":"mesita.simms@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1221110745,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211672.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Sensatori Bride","Id":211672,"Name":"Sensatori Bride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"65f995cc554c132e25eb01b10bc5ce37","RawContent":"its going to be beautiful! congrats to all brides","Attachments":[],"Id":647560,"PostDate":1239256334,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                its going to be beautiful! congrats to all brides\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"chulzle@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1239164292,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-216554.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"chulzle","Id":216554,"Name":"chulzle","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"15e312c5fcf7ce207b165cceb12c7f32","RawContent":"Mestia, \n Are you getting married in the Gazebo, if so will you post pix after. I love the look of it but the set up seems a little odd so I am very interested to see an actual wedding there. \n ~Thanks and have a great wedding!","Attachments":[],"Id":647747,"PostDate":1239276000,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Mestia, <br \/> Are you getting married in the Gazebo, if so will you post pix after. I love the look of it but the set up seems a little odd so I am very interested to see an actual wedding there. <br \/> ~Thanks and have a great wedding!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/www.ezticker.com\/ticker\/1159\/1768\/20100522\/Until+I+Marry+My+Love\/ticker.png\">http:\/\/www.ezticker.com\/ticker\/1159\/...ove\/ticker.png<\/a><\/div><\/div>","Email":"tracihopeis@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1238572485,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-216339.gif?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"thope","Id":216339,"Name":"thope","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e1f615a5f5ef7bf634da94d1758dd81a","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;Sensatori Bride&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Just wanted to let you girls know that I confirmed today via email that my guests are allowed to come onto the resort 2 hours prior to the start of my wedding. I&#039;m printing out that email and taking it with me in case I have any issues!\n \n Lauren, Yamina is pretty responsive. Maybe it&#039;s because my wedding is getting pretty close. You have any questions you want me to ask?\n \n Mesita&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;Intresting, when I asked what time my guest could arrive I was told they could arrive an hour prior to the wedding. What time are you getting married Mesita? Anyway, I got the answer to my question via my travel agent. I just got tired of rephrasing the question so I asked her to find out for me, which she sucessfully did.","Attachments":[],"Id":648461,"PostDate":1239323737,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>Sensatori Bride<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Just wanted to let you girls know that I confirmed today via email that my guests are allowed to come onto the resort 2 hours prior to the start of my wedding. I'm printing out that email and taking it with me in case I have any issues!<br \/> <br \/> Lauren, Yamina is pretty responsive. Maybe it's because my wedding is getting pretty close. You have any questions you want me to ask?<br \/> <br \/> Mesita<\/div> <\/td> <\/tr> <\/table> <\/div>Intresting, when I asked what time my guest could arrive I was told they could arrive an hour prior to the wedding. What time are you getting married Mesita? Anyway, I got the answer to my question via my travel agent. I just got tired of rephrasing the question so I asked her to find out for me, which she sucessfully did.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/www.weddingcountdown.com\/ticker\/6qscsou.png\">http:\/\/www.weddingcountdown.com\/ticker\/6qscsou.png<\/a><br><span>[\/CENTER]<\/span><\/div><\/div>","Email":"reeveswedding@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1219377984,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211327.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"reevesbride","Id":211327,"Name":"reevesbride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ccd75ee40be438ac8eb00f34787c223d","RawContent":"Hi Ladies,\n \n I am getting married at 2pm...I wanted to do it later but there is another wedding that day. I am hoping its not too hot or that girl decides to change her time!\n \n Traci, if you go back a few pages there is a review and pictures of a gazebo wedding. \n \n Mesita","Attachments":[],"Id":649117,"PostDate":1239384827,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi Ladies,<br \/> <br \/> I am getting married at 2pm...I wanted to do it later but there is another wedding that day. I am hoping its not too hot or that girl decides to change her time!<br \/> <br \/> Traci, if you go back a few pages there is a review and pictures of a gazebo wedding. <br \/> <br \/> Mesita\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Mesita and Durante<\/span><br><span>June 18, 2009<\/span><br><span>Excellence Playa Mujeres<\/span><br><br><span>My wedding review:<\/span><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t45032#post857892\">http:\/\/bestdestinationwedding.com\/fo...032#post857892<\/a><span>My wedding pro slideshow:<\/span><a data-ipb='nomediaparse' href=\"http:\/\/www.keithcephus.com\/mesita\">http:\/\/www.keithcephus.com\/mesita<\/a><a data-ipb='nomediaparse' href=\"http:\/\/www.ezticker.com\/ticker\/947\/192\/20090618\/Our+Swine+Flu+Free+Wedding%21\/ticker.png\">http:\/\/www.ezticker.com\/ticker\/947\/1...%21\/ticker.png<\/a><\/div><\/div>","Email":"mesita.simms@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1221110745,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211672.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Sensatori Bride","Id":211672,"Name":"Sensatori Bride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"166f41b29c9ccc7c0538bbf1e0467eb0","RawContent":"You guys I leave for Mexico in one month from today! I am soooo excited but I still have so much to do!!\n \n ~Mesita","Attachments":[],"Id":651073,"PostDate":1239575988,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                You guys I leave for Mexico in one month from today! I am soooo excited but I still have so much to do!!<br \/> <br \/> ~Mesita\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Mesita and Durante<\/span><br><span>June 18, 2009<\/span><br><span>Excellence Playa Mujeres<\/span><br><br><span>My wedding review:<\/span><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t45032#post857892\">http:\/\/bestdestinationwedding.com\/fo...032#post857892<\/a><span>My wedding pro slideshow:<\/span><a data-ipb='nomediaparse' href=\"http:\/\/www.keithcephus.com\/mesita\">http:\/\/www.keithcephus.com\/mesita<\/a><a data-ipb='nomediaparse' href=\"http:\/\/www.ezticker.com\/ticker\/947\/192\/20090618\/Our+Swine+Flu+Free+Wedding%21\/ticker.png\">http:\/\/www.ezticker.com\/ticker\/947\/1...%21\/ticker.png<\/a><\/div><\/div>","Email":"mesita.simms@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1221110745,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211672.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Sensatori Bride","Id":211672,"Name":"Sensatori Bride","IsOnline":false}}],"Pages":{"TotalItems":2876,"TotalPages":288,"CurrentPage":80,"NextPage":90,"PreviousPage":70,"LastPage":2870},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
