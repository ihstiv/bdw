{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":19,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":523,"MovedTo":null,"MovedOn":0,"FirstPostId":1885466,"Rating":0,"RatingHits":0,"Starter":{"Id":281952,"Name":"racht33","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281952.jpg?_r=1424197509","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"StartDate":1423226066,"LastPoster":{"Id":275598,"Name":"kellymenning","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275598.jpg?_r=1426649427","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":43,"Preview":{"Id":1885466,"PostDate":1423226066,"PostContent":"I currently am helping my friend with her upcoming wedding at Dreams Riveria Maya this Sept. Whil...","Author":{"Signature":"","Email":"racht33@yahoo.com","IpAddress":"192.249.47.212","GroupId":3,"GroupName":"Member","JoinDate":1422607788,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281952.jpg?_r=1424197509","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"racht33","Id":281952,"Name":"racht33","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"192.249.47.212","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78748,"EditedBy":"<strong>Edited by racht33, 06 February 2015 - 12:51 PM.<\/strong>","EditDate":1423227117,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2f821808092842e1bbdecf85222c4cd5","RawContent":"&lt;p&gt;I currently am helping my friend with her upcoming wedding at Dreams Riveria Maya this Sept. While also slowly planning my Riveria Maya wedding for next Fall. We&#039;ve been looking at photographers and nothing is working into our budget. Everyone is stating 3K and up. Anyone know of great photographers to hire for much lower budget who can still give us great pictures ?&lt;\/p&gt;","Attachments":[],"Id":1885466,"PostDate":1423226066,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I currently am helping my friend with her upcoming wedding at Dreams Riveria Maya this Sept. While also slowly planning my Riveria Maya wedding for next Fall. We've been looking at photographers and nothing is working into our budget. Everyone is stating 3K and up. Anyone know of great photographers to hire for much lower budget who can still give us great pictures ?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"racht33@yahoo.com","IpAddress":"192.249.47.212","GroupId":3,"GroupName":"Member","JoinDate":1422607788,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281952.jpg?_r=1424197509","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"racht33","Id":281952,"Name":"racht33","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"107.77.87.34","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78748,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"26f74abdb0f4bb5411a20bcf32a82b5b","RawContent":"Dean Sanderson, is very nice and affordable, but Adventure Photos at Dreams is excellent too. If you have an outside photog though you will get charged a vendor fee (Dreams is $300)","Attachments":[],"Id":1885479,"PostDate":1423229100,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Dean Sanderson, is very nice and affordable, but Adventure Photos at Dreams is excellent too. If you have an outside photog though you will get charged a vendor fee (Dreams is $300) \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"natalie.zaval@gmail.com","IpAddress":"67.184.87.109","GroupId":40,"GroupName":"Jr. Member","JoinDate":1389106552,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275926.jpg?_r=1418313578","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"nattiegams325","Id":275926,"Name":"nattiegams325","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.87.237.180","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78748,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"25e4bca5d131088a00c694ca80f60be7","RawContent":"&lt;p&gt;Don&#039;t know what your budget is but there are several photographers that I looked into that are below the $3k mark and they&#039;re photos are beautiful! It will depend on how much time you want as well. Look through the vendor review section here under photographers and it will give you an idea of who to contact. Look at their websites and email them for pricing info. Most of the ladies here find someone who&#039;s style works with what they want.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck!&lt;\/p&gt;","Attachments":[],"Id":1885503,"PostDate":1423237022,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Don't know what your budget is but there are several photographers that I looked into that are below the $3k mark and they're photos are beautiful! It will depend on how much time you want as well. Look through the vendor review section here under photographers and it will give you an idea of who to contact. Look at their websites and email them for pricing info. Most of the ladies here find someone who's style works with what they want.<\/p>\n<p>\u00a0<\/p>\n<p>Good luck!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283433799,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1426134867","PhotoWidth":668,"PhotoHeight":600,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.0.198.224","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78748,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"55fba4920541c128a9599d89a1a247af","RawContent":"&lt;p&gt;@[member=\"nattiegams325\"] are tese photographers that are on the preferred list for Dream ? Or just work for them ? I dont believe she has gotten a list and will be asking for one to work off that.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thank you both for the info!! We will continue the search :)&lt;\/p&gt;","Attachments":[],"Id":1885508,"PostDate":1423240117,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"275926\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/275926-nattiegams325\/' title='Member profile'><span itemprop=\"name\">nattiegams325<\/span><\/a> are tese photographers that are on the preferred list for Dream ? Or just work for them ? I dont believe she has gotten a list and will be asking for one to work off that.<\/p>\n<p>\u00a0<\/p>\n<p>Thank you both for the info!! We will continue the search <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"racht33@yahoo.com","IpAddress":"192.249.47.212","GroupId":3,"GroupName":"Member","JoinDate":1422607788,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281952.jpg?_r=1424197509","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"racht33","Id":281952,"Name":"racht33","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"67.184.85.100","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78748,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fc2a53a0f893b34c8333a4bba665fb0a","RawContent":"@[member=\"racht33\"] the only vendor for photog for dreams is adventure photos. Anyone else gets the external vendor fee","Attachments":[],"Id":1885577,"PostDate":1423317437,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"281952\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/281952-racht33\/' title='Member profile'><span itemprop=\"name\">racht33<\/span><\/a> the only vendor for photog for dreams is adventure photos. Anyone else gets the external vendor fee\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"natalie.zaval@gmail.com","IpAddress":"67.184.87.109","GroupId":40,"GroupName":"Jr. Member","JoinDate":1389106552,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275926.jpg?_r=1418313578","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"nattiegams325","Id":275926,"Name":"nattiegams325","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.100.61.37","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78748,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f9e308ef5f6e3ef39598dbf89027e37a","RawContent":"[quote name=\"racht33\" post=\"1885466\" timestamp=\"1423251266\"]\nI currently am helping my friend with her upcoming wedding at Dreams Riveria Maya this Sept. While also slowly planning my Riveria Maya wedding for next Fall. We&#039;ve been looking at photographers and nothing is working into our budget. Everyone is stating 3K and up. Anyone know of great photographers to hire for much lower budget who can still give us great pictures ?[\/quote]\nFortunately, there are photographers these days for nearly almost every budget. I think the first thing is finding a photographer whose style you love, then reaching out to them for a quote. Definitely utilize the vendor sections on this site and take a look at the reviews and recommendations. Cancun\/Riviera Maya has tons of awesome photographers for various price point ranges.\n\nAnother option is to reach out to a photographer that might be local to you or located in the US. Plenty of brides, including myself, have actually hired a photographer to travel to their destination and photograph their wedding. Sometimes this actually becomes economically feasible if the photographer is willing to work with your budget. It&#039;s just a matter of finding the one that fits your needs.\n\nGood luck!  ;)","Attachments":[],"Id":1885616,"PostDate":1423359655,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>racht33, on 06 February 2015 - 12:34 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>I currently am helping my friend with her upcoming wedding at Dreams Riveria Maya this Sept. While also slowly planning my Riveria Maya wedding for next Fall. We've been looking at photographers and nothing is working into our budget. Everyone is stating 3K and up. Anyone know of great photographers to hire for much lower budget who can still give us great pictures ?<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>Fortunately, there are photographers these days for nearly almost every budget. I think the first thing is finding a photographer whose style you love, then reaching out to them for a quote. Definitely utilize the vendor sections on this site and take a look at the reviews and recommendations. Cancun\/Riviera Maya has tons of awesome photographers for various price point ranges.<\/p>\n<p>\u00a0<\/p>\n<p>Another option is to reach out to a photographer that might be local to you or located in the US. Plenty of brides, including myself, have actually hired a photographer to travel to their destination and photograph their wedding. Sometimes this actually becomes economically feasible if the photographer is willing to work with your budget. It's just a matter of finding the one that fits your needs.<\/p>\n<p>\u00a0<\/p>\n<p>Good luck!\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<span style='font-size: 18px;'><span style='font-family: georgia'><strong class='bbc'>MARIESAM SANCHEZ PHOTOGRAPHY<\/strong><\/span><\/span><br \/>\nWEBSITE: <a class='bbc_url' href='http:\/\/www.mariesamsanchez.com'>www.mariesamsanchez.com<\/a><br \/>\nBLOG: <a class='bbc_url' href='http:\/\/www.mariesamsanchezblog.com'>www.mariesamsanchezblog.com<\/a><br \/>\nCONTACT: <a href='mailto:mariesam.sanchez@gmail.com?subject=BDW%20Inquiry' title='E-mail Link' class='bbc_email'>mariesam.sanchez@gmail.com<\/a><br \/>\n<br \/>\n<img src='http:\/\/i287.photobucket.com\/albums\/ll150\/msam007562\/063cb5c8-dbda-4822-87fe-ba3c0ebcdb7f.jpg' alt='Posted Image' class='bbc_img' \/>","Email":"mariesam.sanchez@gmail.com","IpAddress":"74.100.61.37","GroupId":38,"GroupName":"Moderators","JoinDate":1285929145,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232833.jpg?_r=1422091823","PhotoWidth":200,"PhotoHeight":220,"PhotoType":"custom"},"FormattedName":"MarieSamSanchezPhoto","Id":232833,"Name":"MarieSamSanchezPhoto","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78748,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9da108849924db816388cace7c395985","RawContent":"[quote name=\"racht33\" post=\"1885466\" timestamp=\"1423251266\"]\nI currently am helping my friend with her upcoming wedding at Dreams Riveria Maya this Sept. While also slowly planning my Riveria Maya wedding for next Fall. We&#039;ve been looking at photographers and nothing is working into our budget. Everyone is stating 3K and up. Anyone know of great photographers to hire for much lower budget who can still give us great pictures ?[\/quote]Try Lancelotti Photography. I&#039;m using them for my wedding in December and his prices are really great especially for the quality of photos he produces. I did a TON of research because I ran into the exact same issue. Although beautiful, some photographers were extremely expensive and I also have to pay a vendor fee just to have a photographer.. so it wasn&#039;t really an option to spend 3K plus a vendor fee. I&#039;ve heard great reviews about Lancelotti and he&#039;s been amazing so far at getting back to me and he&#039;s also very open to my vision. I told him i&#039;d like to show him the photography shots I found on Pinterest for inspiration and he said he encourages it!\n\nI&#039;m sure he would travel to Mayan Riviera.. Cancun and Mayan are very close.","Attachments":[],"Id":1885812,"PostDate":1423551655,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>racht33, on 06 February 2015 - 12:34 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>I currently am helping my friend with her upcoming wedding at Dreams Riveria Maya this Sept. While also slowly planning my Riveria Maya wedding for next Fall. We've been looking at photographers and nothing is working into our budget. Everyone is stating 3K and up. Anyone know of great photographers to hire for much lower budget who can still give us great pictures ?<\/p>\n<\/div>\n<\/div><\/div>\n<p>Try Lancelotti Photography. I'm using them for my wedding in December and his prices are really great especially for the quality of photos he produces. I did a TON of research because I ran into the exact same issue. Although beautiful, some photographers were extremely expensive and I also have to pay a vendor fee just to have a photographer.. so it wasn't really an option to spend 3K plus a vendor fee. I've heard great reviews about Lancelotti and he's been amazing so far at getting back to me and he's also very open to my vision. I told him i'd like to show him the photography shots I found on Pinterest for inspiration and he said he encourages it!<\/p>\n<p>\u00a0<\/p>\n<p>I'm sure he would travel to Mayan Riviera.. Cancun and Mayan are very close.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":3,"GroupName":"Member","JoinDate":1419412614,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1428347017","PhotoWidth":169,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.41.59","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78748,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c7d2d82154c41051fb645d2c048369d4","RawContent":"&lt;p&gt;There are a good handful of photographers in the Mayan that come in under $2500. I did a lot of research myself.&lt;\/p&gt;\n&lt;p&gt;I ended up going with Perla Brambila \/ Adventure Photos (my resort&#039;s photographer) but if you want some recommendations I would suggest (in addition to the ones above) Samual Luna, Bohemia Photography, Dean Sanderson.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1885814,"PostDate":1423553324,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>There are a good handful of photographers in the Mayan that come in under $2500. I did a lot of research myself.<\/p>\n<p>I ended up going with Perla Brambila \/ Adventure Photos (my resort's photographer) but if you want some recommendations I would suggest (in addition to the ones above) Samual Luna, Bohemia Photography, Dean Sanderson.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399403402,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"192.249.47.212","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78748,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"aaaa6e21d59e5a48ed8cdd42a5f97933","RawContent":"&lt;p&gt;Thank you so much ladies!!! All this addtional Info has been a big help! :)&lt;\/p&gt;","Attachments":[],"Id":1885817,"PostDate":1423554291,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thank you so much ladies!!! All this addtional Info has been a big help! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"racht33@yahoo.com","IpAddress":"192.249.47.212","GroupId":3,"GroupName":"Member","JoinDate":1422607788,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281952.jpg?_r=1424197509","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"racht33","Id":281952,"Name":"racht33","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78748,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b2d2edf4b4fb6b71a6d0db8919897a8e","RawContent":"[quote name=\"racht33\" post=\"1885817\" timestamp=\"1423579491\"]\nThank you so much ladies!!! All this addtional Info has been a big help! :)[\/quote]No worries. Good Luck!","Attachments":[],"Id":1886333,"PostDate":1423829072,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>racht33, on 10 February 2015 - 07:44 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Thank you so much ladies!!! All this addtional Info has been a big help! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<\/div>\n<\/div><\/div>\n<p>No worries. Good Luck!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":3,"GroupName":"Member","JoinDate":1419412614,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1428347017","PhotoWidth":169,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}}],"Id":"78748","Title":"Photography","LastPostDate":1426668616},"Pages":{"TotalItems":19,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":2,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
