d the answer to almost all of your questions about EDR\/EDCR...","Author":{"Signature":"<div>\u00a0<\/div>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/73076-official-el-dorado-royaleel-dorado-casitas-royale-thread\/'>Official El Dorado Royale\/El Dorado Casitas Royale Thread<\/a>\u00a0<---check here for all info about EDR\/EDCR<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'>Wright Travel Agency<\/a> <--for all your Destination Wedding needs! Contact the experts and reduce your stress.\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/5182-el-dorado-royale-edr-brides-post-here\/'>El Dorado Royale Brides Thread<\/a> <---come chat with other EDR brides<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/69372-allie-hs-edr-rm-mexico-11-5-2012-planning-thread\/'>AllieH's EDR 11-5-2012 Planning Thread<\/a> <--because it was so awesome","Email":"allisonmoore817@gmail.com","IpAddress":"75.20.174.181","GroupId":55,"GroupName":"Resort\/Area Ambassadors","JoinDate":1309632680,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-241884.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"AllieH","Id":241884,"Name":"AllieH","IsOnline":false}},"Posts":[],"Id":"73076","Title":"OFFICIAL El Dorado Royale\/El Dorado Casitas Royale Thread! ","LastPostDate":1428564883},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":9,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":202,"MovedTo":null,"MovedOn":0,"FirstPostId":1889304,"Rating":0,"RatingHits":0,"Starter":{"Id":282394,"Name":"Catface1027","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282394.jpg?_r=1426444073","PhotoWidth":189,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":false},"StartDate":1426416843,"LastPoster":{"Id":282394,"Name":"Catface1027","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282394.jpg?_r=1426444073","PhotoWidth":189,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":2,"Preview":{"Id":1889304,"PostDate":1426416843,"PostContent":"Hi ladies!\u00a0 \u00a0 We've booked our wedding at the Grand Sirenis for 19\/04\/2016 (I like to plan ahead!...","Author":{"Signature":"","Email":"cat.sanchez27@yahoo.com","IpAddress":"87.114.176.158","GroupId":39,"GroupName":"Newbie","JoinDate":1426061082,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282394.jpg?_r=1426444073","PhotoWidth":189,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Catface1027","Id":282394,"Name":"Catface1027","IsOnline":false}},"Posts":[],"Id":"78905","Title":"Grand Sirenis - From The Uk - Silver Package!","LastPostDate":1428415368},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":8,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":294,"MovedTo":null,"MovedOn":0,"FirstPostId":1889354,"Rating":0,"RatingHits":0,"Starter":{"Id":276354,"Name":"has31","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1426446847,"LastPoster":{"Id":278120,"Name":"LisaAnthonyPoppy","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com