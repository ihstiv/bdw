{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":51,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":true,"Views":2847,"MovedTo":null,"MovedOn":0,"FirstPostId":1882795,"Rating":0,"RatingHits":0,"Starter":{"Id":280946,"Name":"SusanMarie813","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280946.jpg?_r=1429419208","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"StartDate":1421179690,"LastPoster":{"Id":280946,"Name":"SusanMarie813","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280946.jpg?_r=1429419208","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":2,"Preview":{"Id":1882795,"PostDate":1421179690,"PostContent":"Hi well I am officially booked September 13th 2015! \u00a0Engaged NYE officially. \u00a0 I wanted to start...","Author":{"Signature":"<p>Gian-Luigi & Susan September 13, 2015 Finest Resort <a data-ipb='nomediaparse' href='http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A'>http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A<\/a>","Email":"susanlaurelli@yahoo.com","IpAddress":"47.17.228.244","GroupId":39,"GroupName":"Newbie","JoinDate":1414833004,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280946.jpg?_r=1429419208","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"SusanMarie813","Id":280946,"Name":"SusanMarie813","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"47.17.228.244","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78597,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b779eedacb4488b267401bb8006ecac2","RawContent":"&lt;p&gt;Hi well I am officially booked September 13th 2015! &amp;nbsp;Engaged NYE officially. &amp;nbsp;:)&lt;\/p&gt;\n&lt;p&gt;I wanted to start some place for us to talk about this brand new hotel. &amp;nbsp;I know some ladies are getting married at the resort early spring.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Let&#039;s get it started! &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1882795,"PostDate":1421179690,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi well I am officially booked September 13th 2015! \u00a0Engaged NYE officially. \u00a0<img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>I wanted to start some place for us to talk about this brand new hotel. \u00a0I know some ladies are getting married at the resort early spring.<\/p>\n<p>\u00a0<\/p>\n<p>Let's get it started! \u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Gian-Luigi & Susan September 13, 2015 Finest Resort <a data-ipb='nomediaparse' href='http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A'>http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A<\/a>","Email":"susanlaurelli@yahoo.com","IpAddress":"47.17.228.244","GroupId":39,"GroupName":"Newbie","JoinDate":1414833004,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280946.jpg?_r=1429419208","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"SusanMarie813","Id":280946,"Name":"SusanMarie813","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.166.154.81","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78597,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cebf291db82ced9df2756b0fa2550ffb","RawContent":"&lt;p&gt;Congrats @[member=\"SusanMarie813\"] ! We are getting married there on May 30, 2015 and are expecting around 60 guests. We&#039;re doing a planning visit in late March and meeting with Teresa to decide on packages, flowers, do tastings, look at the venues, talk about rehearsal dinner spots, etc. I am thinking I may do a hair\/makeup trial then as well. Have you made any decisions about this stuff?&lt;\/p&gt;","Attachments":[],"Id":1883652,"PostDate":1421845923,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats @<a hovercard-ref=\"member\" hovercard-id=\"280946\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/280946-susanmarie813\/' title='Member profile'><span itemprop=\"name\">SusanMarie813<\/span><\/a> ! We are getting married there on May 30, 2015 and are expecting around 60 guests. We're doing a planning visit in late March and meeting with Teresa to decide on packages, flowers, do tastings, look at the venues, talk about rehearsal dinner spots, etc. I am thinking I may do a hair\/makeup trial then as well. Have you made any decisions about this stuff?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"susieylee@hotmail.com","IpAddress":"173.166.154.81","GroupId":39,"GroupName":"Newbie","JoinDate":1415002859,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280976.jpg?_r=1424642440","PhotoWidth":200,"PhotoHeight":230,"PhotoType":"custom"},"FormattedName":"airsusie","Id":280976,"Name":"airsusie","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"47.17.228.244","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78597,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"45d1ed58b9a54a6495ee2de46dc1f429","RawContent":"&lt;p&gt;Hi @[member=\"airsusie\"] so excited to see someone else join! &amp;nbsp;I am signing my contract this week. &amp;nbsp;I wanted to have it ready for Feb 1 for the group block. &amp;nbsp;I am using Destination Weddings as my travel agent. &amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;No decisions yet. &amp;nbsp;Once I know how many people will be coming then I can see what we will do. &amp;nbsp;The only decision I have to make is what room choice. &amp;nbsp;We think we are going with the swimup walk out. &amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Going to sign for the silver package but pretty sure we will upgrade to Gold&lt;\/p&gt;\n&lt;p&gt;And we are going to do a bonfire for sure.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I have been to beloved it almost chose them, but they did not do a Sunday wedding. &amp;nbsp;We needed the Sunday for the holiday days off. &amp;nbsp;Teacher friends here in NY have off.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I would love to hear all about what you see, venue spots inside\/outside etc. &amp;nbsp;I can not have it by the ocean nor a pool I have a little one.&lt;\/p&gt;","Attachments":[],"Id":1883703,"PostDate":1421870536,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi @<a hovercard-ref=\"member\" hovercard-id=\"280976\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/280976-airsusie\/' title='Member profile'><span itemprop=\"name\">airsusie<\/span><\/a> so excited to see someone else join! \u00a0I am signing my contract this week. \u00a0I wanted to have it ready for Feb 1 for the group block. \u00a0I am using Destination Weddings as my travel agent. \u00a0<\/p>\n<p>No decisions yet. \u00a0Once I know how many people will be coming then I can see what we will do. \u00a0The only decision I have to make is what room choice. \u00a0We think we are going with the swimup walk out. \u00a0<\/p>\n<p>Going to sign for the silver package but pretty sure we will upgrade to Gold<\/p>\n<p>And we are going to do a bonfire for sure.<\/p>\n<p>\u00a0<\/p>\n<p>I have been to beloved it almost chose them, but they did not do a Sunday wedding. \u00a0We needed the Sunday for the holiday days off. \u00a0Teacher friends here in NY have off.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I would love to hear all about what you see, venue spots inside\/outside etc. \u00a0I can not have it by the ocean nor a pool I have a little one.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Gian-Luigi & Susan September 13, 2015 Finest Resort <a data-ipb='nomediaparse' href='http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A'>http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A<\/a>","Email":"susanlaurelli@yahoo.com","IpAddress":"47.17.228.244","GroupId":39,"GroupName":"Newbie","JoinDate":1414833004,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280946.jpg?_r=1429419208","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"SusanMarie813","Id":280946,"Name":"SusanMarie813","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.166.154.81","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78597,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fa777feb7171d707c367879e5837fd55","RawContent":"&lt;p&gt;@[member=\"SusanMarie813\"] So excited for you! &amp;nbsp;You are talking about signing a contract for the room block, right? &amp;nbsp;We haven&#039;t signed anything with the resort -- got a confirmation letter from them saying our date was reserved. &amp;nbsp;We also did a group block contract, but through Wright Travel. &amp;nbsp;Approx. how many people are you expecting? &amp;nbsp;We are expecting around 60 people. &amp;nbsp;I will let you know how it goes in March. &amp;nbsp;Let me know if you want me to check anything out specifically. &amp;nbsp;I have a long list of things to go over that I sent to Teresa (venue spot, flowers, decorations, group excursion, etc). &amp;nbsp;She has been great so far. &amp;nbsp;I am pretty sure we will be getting married on the beach, but will take a look at the other options obviously. &amp;nbsp;Our biggest stress right now is music. &amp;nbsp;We have been looking into getting a band -- I wasn&#039;t crazy about the Youtube clip that Teresa sent me for the house band. &amp;nbsp;We are talking to someone else on Saturday and keeping our fingers crossed   &lt;\/p&gt;","Attachments":[],"Id":1883768,"PostDate":1421938076,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"280946\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/280946-susanmarie813\/' title='Member profile'><span itemprop=\"name\">SusanMarie813<\/span><\/a> So excited for you! \u00a0You are talking about signing a contract for the room block, right? \u00a0We haven't signed anything with the resort -- got a confirmation letter from them saying our date was reserved. \u00a0We also did a group block contract, but through Wright Travel. \u00a0Approx. how many people are you expecting? \u00a0We are expecting around 60 people. \u00a0I will let you know how it goes in March. \u00a0Let me know if you want me to check anything out specifically. \u00a0I have a long list of things to go over that I sent to Teresa (venue spot, flowers, decorations, group excursion, etc). \u00a0She has been great so far. \u00a0I am pretty sure we will be getting married on the beach, but will take a look at the other options obviously. \u00a0Our biggest stress right now is music. \u00a0We have been looking into getting a band -- I wasn't crazy about the Youtube clip that Teresa sent me for the house band. \u00a0We are talking to someone else on Saturday and keeping our fingers crossed \u00a0\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"susieylee@hotmail.com","IpAddress":"173.166.154.81","GroupId":39,"GroupName":"Newbie","JoinDate":1415002859,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280976.jpg?_r=1424642440","PhotoWidth":200,"PhotoHeight":230,"PhotoType":"custom"},"FormattedName":"airsusie","Id":280976,"Name":"airsusie","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.68.253.198","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78597,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"19f42d77eed8e809ac9be9c9bb93db4e","RawContent":"&lt;p&gt;@[member=\"airsusie\"]&lt;\/p&gt;\n&lt;p&gt;We signed the contract for the room block I am using destinationweddings.com. &amp;nbsp;So far so good.&lt;\/p&gt;\n&lt;p&gt;We inviting about 200 people.. I am budgeting for 60 people as well. &amp;nbsp;We will see once the invite goes out this week. &amp;nbsp;We are sending out our booking \"save the booking\" for the block of rooms ASAP. &amp;nbsp;This way I can get an idea on how many people and people have time to pay it off. &amp;nbsp;Our final balance for the room block is due July 10th. &amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;When it gets closer to your visit I would be truly interested in the reception and cocktail options. &amp;nbsp;We will get married on the beach (weather premitting) but our reception I want indoor\/outdoor not near a pool. &amp;nbsp;I have a little one and need to be really concerned about him running into the water... Its something I have nightmares about. &amp;nbsp;One of the big reasons I did not go with Sensatori. &amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;:)&lt;\/p&gt;","Attachments":[],"Id":1884538,"PostDate":1422471800,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"280976\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/280976-airsusie\/' title='Member profile'><span itemprop=\"name\">airsusie<\/span><\/a><\/p>\n<p>We signed the contract for the room block I am using destinationweddings.com. \u00a0So far so good.<\/p>\n<p>We inviting about 200 people.. I am budgeting for 60 people as well. \u00a0We will see once the invite goes out this week. \u00a0We are sending out our booking \"save the booking\" for the block of rooms ASAP. \u00a0This way I can get an idea on how many people and people have time to pay it off. \u00a0Our final balance for the room block is due July 10th. \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>When it gets closer to your visit I would be truly interested in the reception and cocktail options. \u00a0We will get married on the beach (weather premitting) but our reception I want indoor\/outdoor not near a pool. \u00a0I have a little one and need to be really concerned about him running into the water... Its something I have nightmares about. \u00a0One of the big reasons I did not go with Sensatori. \u00a0<\/p>\n<p>\u00a0<\/p>\n<p><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Gian-Luigi & Susan September 13, 2015 Finest Resort <a data-ipb='nomediaparse' href='http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A'>http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A<\/a>","Email":"susanlaurelli@yahoo.com","IpAddress":"47.17.228.244","GroupId":39,"GroupName":"Newbie","JoinDate":1414833004,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280946.jpg?_r=1429419208","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"SusanMarie813","Id":280946,"Name":"SusanMarie813","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.89.236.44","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78597,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b7d43866d960b50b19153bc764410660","RawContent":"&lt;p&gt;Congratulations on your engagement and choosing a resort.&lt;\/p&gt;","Attachments":[],"Id":1885243,"PostDate":1423074501,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congratulations on your engagement and choosing a resort.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"njwood000@gmail.com","IpAddress":"71.7.173.185","GroupId":40,"GroupName":"Jr. Member","JoinDate":1405799591,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Msmimi","Id":279087,"Name":"Msmimi","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"47.17.228.244","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78597,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5b09d319de463229c0a28a1512e93999","RawContent":"&lt;p&gt;@[member=\"airsusie\"] HI! when you go in March can you check out spots for 30 people as well if you can. &amp;nbsp; &amp;nbsp;Now that the invites are out we maybe closer to 30\/40 then 60.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Ill appreciate any info you find out.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thanks&lt;\/p&gt;","Attachments":[],"Id":1886733,"PostDate":1424264016,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"280976\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/280976-airsusie\/' title='Member profile'><span itemprop=\"name\">airsusie<\/span><\/a> HI! when you go in March can you check out spots for 30 people as well if you can. \u00a0 \u00a0Now that the invites are out we maybe closer to 30\/40 then 60.<\/p>\n<p>\u00a0<\/p>\n<p>Ill appreciate any info you find out.\u00a0<\/p>\n<p>Thanks<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Gian-Luigi & Susan September 13, 2015 Finest Resort <a data-ipb='nomediaparse' href='http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A'>http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A<\/a>","Email":"susanlaurelli@yahoo.com","IpAddress":"47.17.228.244","GroupId":39,"GroupName":"Newbie","JoinDate":1414833004,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280946.jpg?_r=1429419208","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"SusanMarie813","Id":280946,"Name":"SusanMarie813","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.166.154.81","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78597,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8c2fb78fd84cb5aec3dd00b44b489e36","RawContent":"@[member=\"SusanMarie813\"] yes, definitely will do and will try to take pix too!  i just finished addressing all our formal invitations and sending them out tomorrow.  our first deadline for hotel payment was actually due a couple of days ago and i think we&#039;re still on track for about 60, maybe closer to 70 actually.  i think people are keen on having a vacation with this crazy cold weather on the east coast!","Attachments":[],"Id":1886799,"PostDate":1424330689,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"280946\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/280946-susanmarie813\/' title='Member profile'><span itemprop=\"name\">SusanMarie813<\/span><\/a> yes, definitely will do and will try to take pix too!  i just finished addressing all our formal invitations and sending them out tomorrow.  our first deadline for hotel payment was actually due a couple of days ago and i think we're still on track for about 60, maybe closer to 70 actually.  i think people are keen on having a vacation with this crazy cold weather on the east coast! \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"susieylee@hotmail.com","IpAddress":"173.166.154.81","GroupId":39,"GroupName":"Newbie","JoinDate":1415002859,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280976.jpg?_r=1424642440","PhotoWidth":200,"PhotoHeight":230,"PhotoType":"custom"},"FormattedName":"airsusie","Id":280976,"Name":"airsusie","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.42.29.14","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78597,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"f215a49f0446a377569f53171cce7ca1","RawContent":"&lt;p&gt;Hi Everyone!&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I just signed my contract as well, Is the group room block something that you contact the resort about or does the travel agent deal with that?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Also, does anyone know where the ceremony locations are besides the beach?&lt;\/p&gt;","Attachments":[],"Id":1886876,"PostDate":1424363037,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Everyone!\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I just signed my contract as well, Is the group room block something that you contact the resort about or does the travel agent deal with that?<\/p>\n<p>\u00a0<\/p>\n<p>Also, does anyone know where the ceremony locations are besides the beach?<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"p1x1st1ck@hotmail.com","IpAddress":"70.42.29.14","GroupId":39,"GroupName":"Newbie","JoinDate":1422371644,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Pixistick","Id":281906,"Name":"Pixistick","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"64.102.249.14","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78597,"EditedBy":"<strong>Edited by amandapanda, 19 February 2015 - 07:31 PM.<\/strong>","EditDate":1424374289,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3201d6e9481cf806298ec402ae33e421","RawContent":"&lt;p&gt;@[member=\"airsusie\"] I am getting married May 23rd, right before you! I am not doing a site visit so I am very very nervous. Any help and insight you can provide when you visit in March would be amazing!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;So I know with the package I am getting hair and make up is included but I am just not sure how high quality it will be. Are you all getting the hair and make up there?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Also, I have sent (several) emails to Teresa asking for pics of locations for reception and welcome\/rehearsal dinner and she still hasnt responded so any pics and thoughts on these locations when you visit would be a savior. I am glad to hear that she has been more responsive with you girls so hopefully she has just been busy lately.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;What do you guys have planned so far? What are your thoughts for the rehersal dinner and reception? I know that for the ceremony i want to have it on the beach (decorations no idea yet).&amp;nbsp; For the welcome dinner I was thinking something beached themed with the bonfire and trio band perhaps.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I invited 85 ppl and I have 40 guests book so far and will most likely have 45-50. I know what I want in my OOT bags (haha for the most part anyways). I need help and inspiration for the remainder of the wedding!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I do have my photographer booked. I tried to booked the DJ with Teresa through the resort but she said I need to book the lighting when booking the DJ. ahh! So bad at planning events that&#039;s why I wanted destination however there is more involved than I was anticipating. Bouncing ideas off you girls would be so awesome!&lt;\/p&gt;","Attachments":[],"Id":1886912,"PostDate":1424373719,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"280976\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/280976-airsusie\/' title='Member profile'><span itemprop=\"name\">airsusie<\/span><\/a> I am getting married May 23rd, right before you! I am not doing a site visit so I am very very nervous. Any help and insight you can provide when you visit in March would be amazing!!<\/p>\n<p>\u00a0<\/p>\n<p>So I know with the package I am getting hair and make up is included but I am just not sure how high quality it will be. Are you all getting the hair and make up there?<\/p>\n<p>\u00a0<\/p>\n<p>Also, I have sent (several) emails to Teresa asking for pics of locations for reception and welcome\/rehearsal dinner and she still hasnt responded so any pics and thoughts on these locations when you visit would be a savior. I am glad to hear that she has been more responsive with you girls so hopefully she has just been busy lately.<\/p>\n<p>\u00a0<\/p>\n<p>What do you guys have planned so far? What are your thoughts for the rehersal dinner and reception? I know that for the ceremony i want to have it on the beach (decorations no idea yet).\u00a0 For the welcome dinner I was thinking something beached themed with the bonfire and trio band perhaps.<\/p>\n<p>\u00a0<\/p>\n<p>I invited 85 ppl and I have 40 guests book so far and will most likely have 45-50. I know what I want in my OOT bags (haha for the most part anyways). I need help and inspiration for the remainder of the wedding!<\/p>\n<p>\u00a0<\/p>\n<p>I do have my photographer booked. I tried to booked the DJ with Teresa through the resort but she said I need to book the lighting when booking the DJ. ahh! So bad at planning events that's why I wanted destination however there is more involved than I was anticipating. Bouncing ideas off you girls would be so awesome!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"amandaipelletier@gmail.com","IpAddress":"24.163.113.199","GroupId":39,"GroupName":"Newbie","JoinDate":1422304913,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"amandapanda","Id":281888,"Name":"amandapanda","IsOnline":false}}],"Id":"78597","Title":"Finest 2015\/2016 Brides","LastPostDate":1429086130},"Pages":{"TotalItems":51,"TotalPages":6,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":50},"PushNotifications":[{"Key":"notifications","Value":2,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
