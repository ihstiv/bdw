te":false,"CanLike":true,"TopicId":79050,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b160b30b45f81b14e813500ca187622e","RawContent":"I would also love to see everything! If you wouldnt mind...my email is jaspbri0317@aol.com thank you [emoji2]","Attachments":[],"Id":1893159,"PostDate":1429068530,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I would also love to see everything! If you wouldnt mind...my email is jaspbri0317@aol.com thank you [emoji2] \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jaspbri0317@aol.com","IpAddress":"71.58.144.195","GroupId":39,"GroupName":"Newbie","JoinDate":1296688027,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-236302.jpg?_r=1429022808","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"jaspbri0317","Id":236302,"Name":"jaspbri0317","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"206.74.64.116","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79050,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"607356033be3aa092c816e0df5b9789b","RawContent":"&lt;p&gt;@&lt;span&gt;&lt;a  class=\"\" href=\"http:\/\/www.bestdestinationwedding.com\/user\/282082-jnvoigt\/\" title=\"\"&gt;&lt;span&gt;jnvoigt&lt;\/span&gt;&lt;\/a&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thank you so much for sharing! You had the cutest ideas!!&amp;nbsp; Looks like you had an amazing wedding!&amp;nbsp; Its so funny you said that about the dress, because I just posted on here about flying with your dress!!&amp;nbsp; I have one- question?&amp;nbsp; How did you do with the heat?&amp;nbsp; Were your guests very hot sitting in the sun during the ceremony.&amp;nbsp; How was the reception outdoors?&amp;nbsp; Thank you so much!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Christine&lt;\/p&gt;","Attachments":[],"Id":1893590,"PostDate":1429424104,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<span><a href='http:\/\/www.bestdestinationwedding.com\/user\/282082-jnvoigt\/' class='bbc_url' title=''><span>jnvoigt<\/span><\/a><\/span><\/p>\n<p>\u00a0<\/p>\n<p>Thank you so much for sharing! You had the cutest ideas!!\u00a0 Looks like you had an amazing wedding!\u00a0 Its so funny you said that about the dress, because I just posted on here about flying with your dress!!\u00a0 I have one- question?\u00a0 How did you do with the heat?\u00a0 Were your guests very hot sitting in the sun during the ceremony.\u00a0 How was the reception outdoors?\u00a0 Thank you so much!<\/p>\n<p>\u00a0<\/p>\n<p>Christine<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cwright1320@yahoo.com","IpAddress":"72.230.115.231","GroupId":39,"GroupName":"Newbie","JoinDate":1388165078,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Cwright","Id":275744,"Name":"Cwright","IsOnline":false}}],"Id":"79050","Title":"Now Larimar Review !","LastPostDate":1429424104},"Pages":{"TotalItems":6,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
