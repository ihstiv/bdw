{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":10,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":311,"MovedTo":null,"MovedOn":0,"FirstPostId":1883446,"Rating":0,"RatingHits":0,"Starter":{"Id":276518,"Name":"LauraM","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276518.jpg?_r=1394639305","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"StartDate":1421745798,"LastPoster":{"Id":277873,"Name":"calgarybride2015","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":true},"PollState":"0","LastVote":0,"ForumId":43,"Preview":{"Id":1883446,"PostDate":1421745798,"PostContent":"We do not have a bridal party. We're not sure if we should still give boutonnieres to our fathers...","Author":{"Signature":"","Email":"lauramthistle@gmail.com","IpAddress":"24.34.236.241","GroupId":40,"GroupName":"Jr. Member","JoinDate":1391595756,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276518.jpg?_r=1394639305","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"LauraM","Id":276518,"Name":"LauraM","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.34.236.241","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78642,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"af28ac3437d134c934a02cfffa96f5cf","RawContent":"&lt;p&gt;We do not have a bridal party. We&#039;re not sure if we should still give boutonnieres to our fathers and corsages to our mothers? And if they get them, should we be giving flowers to our siblings? And then do we have to get flowers for their dates?&lt;\/p&gt;","Attachments":[],"Id":1883446,"PostDate":1421745798,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>We do not have a bridal party. We're not sure if we should still give boutonnieres to our fathers and corsages to our mothers? And if they get them, should we be giving flowers to our siblings? And then do we have to get flowers for their dates?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lauramthistle@gmail.com","IpAddress":"24.34.236.241","GroupId":40,"GroupName":"Jr. Member","JoinDate":1391595756,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276518.jpg?_r=1394639305","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"LauraM","Id":276518,"Name":"LauraM","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.51.123.197","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78642,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c2485e8aa45ee5cb483017c489d05bbc","RawContent":"&lt;p&gt;@[member=\"LauraM\"] - Are the bouts and corsages included in your package?&lt;\/p&gt;","Attachments":[],"Id":1883449,"PostDate":1421746317,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"276518\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/276518-lauram\/' title='Member profile'><span itemprop=\"name\">LauraM<\/span><\/a> - Are the bouts and corsages included in your package?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-size:14px;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><strong><span style=\"color:#ff6666;\">I love him & he loves me, we'll be married by the sea.<\/span><\/strong><\/span><\/span><br>\n\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77696-our-dw-dreams-riviera-cancun-17-apr-2015\/'>Planning\u00a0Journal<\/a>\u00a0& <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/blog\/86-my-destination-wedding-blog\/'>Blog<\/a><\/p>\n<p>\u00a0","Email":"tricia.d.davis@gmail.com","IpAddress":"97.91.185.236","GroupId":3,"GroupName":"Member","JoinDate":1396255319,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277418.jpg?_r=1418322086","PhotoWidth":200,"PhotoHeight":179,"PhotoType":"custom"},"FormattedName":"pddcmc","Id":277418,"Name":"pddcmc","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.34.236.241","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78642,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8181fb965a9137be6fd629696f04e92f","RawContent":"&lt;p&gt;Only for the bride and groom - and they&#039;re rather unattractive. We&#039;re hiring an outside florist for everything, but not sure etiquette wise if we should order flowers for family?&lt;\/p&gt;","Attachments":[],"Id":1883450,"PostDate":1421746526,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Only for the bride and groom - and they're rather unattractive. We're hiring an outside florist for everything, but not sure etiquette wise if we should order flowers for family?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lauramthistle@gmail.com","IpAddress":"24.34.236.241","GroupId":40,"GroupName":"Jr. Member","JoinDate":1391595756,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276518.jpg?_r=1394639305","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"LauraM","Id":276518,"Name":"LauraM","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.249.106.58","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78642,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ce751b0f3f4707f080213c885c8bb1ed","RawContent":"&lt;p&gt;I would get them for your parents, that is pretty standard wedding tradition. As for your siblings, that is up to you!&lt;\/p&gt;","Attachments":[],"Id":1883451,"PostDate":1421746583,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I would get them for your parents, that is pretty standard wedding tradition. As for your siblings, that is up to you!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kelly_miller_@hotmail.com","IpAddress":"99.249.122.85","GroupId":40,"GroupName":"Jr. Member","JoinDate":1390747731,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kellymiller","Id":276338,"Name":"kellymiller","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.51.123.197","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78642,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a0f67dd6e2cf424fc55c8a2893a89e8c","RawContent":"&lt;p&gt;I agree with&amp;nbsp;@[member=\"kellymiller\"]. That&#039;s a shame that your resort&#039;s flowers aren&#039;t much to write home about. Are they charging you to hire an outside vendor?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Our resort charges a ton to upgrade our flowers and to add on...I voted against that.. I mean, we aren&#039;t going to have the chance to enjoy them a whole lot...so I figure we can better spend the money elsewhere.&lt;\/p&gt;","Attachments":[],"Id":1883455,"PostDate":1421747063,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I agree with\u00a0@<a hovercard-ref=\"member\" hovercard-id=\"276338\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/276338-kellymiller\/' title='Member profile'><span itemprop=\"name\">kellymiller<\/span><\/a>. That's a shame that your resort's flowers aren't much to write home about. Are they charging you to hire an outside vendor?<\/p>\n<p>\u00a0<\/p>\n<p>Our resort charges a ton to upgrade our flowers and to add on...I voted against that.. I mean, we aren't going to have the chance to enjoy them a whole lot...so I figure we can better spend the money elsewhere.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-size:14px;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><strong><span style=\"color:#ff6666;\">I love him & he loves me, we'll be married by the sea.<\/span><\/strong><\/span><\/span><br>\n\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77696-our-dw-dreams-riviera-cancun-17-apr-2015\/'>Planning\u00a0Journal<\/a>\u00a0& <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/blog\/86-my-destination-wedding-blog\/'>Blog<\/a><\/p>\n<p>\u00a0","Email":"tricia.d.davis@gmail.com","IpAddress":"97.91.185.236","GroupId":3,"GroupName":"Member","JoinDate":1396255319,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277418.jpg?_r=1418322086","PhotoWidth":200,"PhotoHeight":179,"PhotoType":"custom"},"FormattedName":"pddcmc","Id":277418,"Name":"pddcmc","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"162.1.2.13","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78642,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e02dc1ced3788229332e0a893a5b2a21","RawContent":"I am just doing our bouquets and bout for the groom... I don&#039;t think its worth it to spend money esp for parents ( I personally think wrist corsages are hideous)","Attachments":[],"Id":1883456,"PostDate":1421747176,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I am just doing our bouquets and bout for the groom... I don't think its worth it to spend money esp for parents ( I personally think wrist corsages are hideous)\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nadia.bozanich@gmail.com","IpAddress":"75.112.200.126","GroupId":40,"GroupName":"Jr. Member","JoinDate":1406711472,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"nadiakat17","Id":279229,"Name":"nadiakat17","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.34.236.241","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78642,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"6590f61e7af0be402e39ff5afc834781","RawContent":"&lt;p&gt;lol&amp;nbsp;@[member=\"nadiakat17\"] I agree! I hate the wrist corsage! I feel like it makes ppl look like old women! ugh! But I think bouts are so classy.... it makes the decision tough. I don&#039;t want to break tradition any more than we already are, and I don&#039;t want to offend my parents either...&lt;\/p&gt;","Attachments":[],"Id":1883460,"PostDate":1421747938,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>lol\u00a0@<a hovercard-ref=\"member\" hovercard-id=\"279229\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/279229-nadiakat17\/' title='Member profile'><span itemprop=\"name\">nadiakat17<\/span><\/a> I agree! I hate the wrist corsage! I feel like it makes ppl look like old women! ugh! But I think bouts are so classy.... it makes the decision tough. I don't want to break tradition any more than we already are, and I don't want to offend my parents either...<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lauramthistle@gmail.com","IpAddress":"24.34.236.241","GroupId":40,"GroupName":"Jr. Member","JoinDate":1391595756,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276518.jpg?_r=1394639305","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"LauraM","Id":276518,"Name":"LauraM","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.113.233.65","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78642,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"bc2cb9dc5aa51809b1dde43d8eb66ce2","RawContent":"&lt;p&gt;We got bouts and corsages (pinned) for our parents but not siblings. My mom wanted us to but the costs would have been too high.&amp;nbsp; Our siblings didn&#039;t care&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We got bouts for the groomsmen (who ended up not wearing them - bleh), ring bearers and our parents.&amp;nbsp; We gave the free one from BP to our officiant - it is pretty ugly btw haha.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We used our free bouquet on table at our ceremony.&amp;nbsp; It was not bad, but the one I used was a lot nicer (even Marco, the wedding coordinator) commented&lt;\/p&gt;","Attachments":[],"Id":1883462,"PostDate":1421748412,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>We got bouts and corsages (pinned) for our parents but not siblings. My mom wanted us to but the costs would have been too high.\u00a0 Our siblings didn't care<\/p>\n<p>\u00a0<\/p>\n<p>We got bouts for the groomsmen (who ended up not wearing them - bleh), ring bearers and our parents.\u00a0 We gave the free one from BP to our officiant - it is pretty ugly btw haha.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>We used our free bouquet on table at our ceremony.\u00a0 It was not bad, but the one I used was a lot nicer (even Marco, the wedding coordinator) commented<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Married December 19, 2014 at Beach Palace Resort in Cancun, Mexico<\/p>\n<p>\u00a0<\/p>\n<p>My Planning Thread - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/'>http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>My Wedding Review<\/p>\n<p>Part 1 - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881197'>http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881197<\/a><\/p>\n<p>Part 2 - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881590'>http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881590<\/a><\/p>\n<p>Part 3 - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881861'>http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881861<\/a><\/p>\n<p>\u00a0","Email":"lilyluu83@gmail.com","IpAddress":"174.119.162.30","GroupId":3,"GroupName":"Member","JoinDate":1395584148,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277296.jpg?_r=1421643766","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"tygrrlily","Id":277296,"Name":"tygrrlily","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.87.237.180","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78642,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"839291cab7a31b559c59a523280e939e","RawContent":"&lt;p&gt;I like the idea of a bout and corsage for parents 9pin if you prefer), or grandparents if they&#039;re attending. I think it&#039;s just a signal that hey, we&#039;re happy you&#039;re here and just want to acknowledge that we appreciate it. Especially if they&#039;re kicking in money!! Nothing says they have to be fancy. just a simple basic bout is fine, but I think it&#039;s a nice gesture.&lt;\/p&gt;","Attachments":[],"Id":1883495,"PostDate":1421757327,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I like the idea of a bout and corsage for parents 9pin if you prefer), or grandparents if they're attending. I think it's just a signal that hey, we're happy you're here and just want to acknowledge that we appreciate it. Especially if they're kicking in money!! Nothing says they have to be fancy. just a simple basic bout is fine, but I think it's a nice gesture.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283433799,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1426134867","PhotoWidth":668,"PhotoHeight":600,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"12.130.116.160","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78642,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"83fe329ccf595cbf259d7186cdc7b2b0","RawContent":"Honestly our resorts photos kinda sucked too but I may have shed a tear when I saw my bouquet. I couldn&#039;t have dreamed anything more perfect for my wedding.  Gorgeous. \n\n\nI got my bouquet and bout for fianc\u00e9 in my package. \n\nI purchased 5 more bouts - dad, ring bearer, and 3 groomsmen. \n\n\nI also got the ladies a bouquet and I ordered an extra so in the end we had 4 and could use one on each table as centrepieces. \n\n\nI didn&#039;t do anything for any other parents as there are a lot of step parents and wasn&#039;t sure where it would end.  And honestly they aren&#039;t cheap!!! No one noticed or cared. \n\n\n\nSent from my iPad using Tapatalk","Attachments":[],"Id":1883988,"PostDate":1422118767,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Honestly our resorts photos kinda sucked too but I may have shed a tear when I saw my bouquet. I couldn't have dreamed anything more perfect for my wedding.  Gorgeous. <br><br>\nI got my bouquet and bout for fianc\u00e9 in my package. <br>\nI purchased 5 more bouts - dad, ring bearer, and 3 groomsmen. <br><br>\nI also got the ladies a bouquet and I ordered an extra so in the end we had 4 and could use one on each table as centrepieces. <br><br>\nI didn't do anything for any other parents as there are a lot of step parents and wasn't sure where it would end.  And honestly they aren't cheap!!! No one noticed or cared. <br><br><br>\nSent from my iPad using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399403402,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":true}}],"Id":"78642","Title":"Who Gets Flowers?","LastPostDate":1422118767},"Pages":{"TotalItems":10,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":2,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
