Photo":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1436293677","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.87.237.201","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79202,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"eda2031dc447bc07d059fcb7540528e1","RawContent":"&lt;p&gt;It definitely works for me! Hopefully we hear from @[member=\"snswedding2016\"] on the chance of that rooftop on that date. That would be great and sounds like it can accommodate a big group!&lt;\/p&gt;","Attachments":[],"Id":1898909,"PostDate":1434727748,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>It definitely works for me! Hopefully we hear from @<a hovercard-ref=\"member\" hovercard-id=\"281055\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/281055-snswedding2016\/' title='Member profile'><span itemprop=\"name\">snswedding2016<\/span><\/a> on the chance of that rooftop on that date. That would be great and sounds like it can accommodate a big group!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"184.149.182.226","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79202,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"11fcd9934cdb0e7f426fb95a945ae513","RawContent":"&lt;p&gt;hey ladies! Yay so glad the date seems to be working out. I&#039;m pretty sure the rooftop patio should be ready for Aug 14. I&#039;ll keep you all posted. They should be up and running by July 1st! That&#039;s the plan as of right now anyway. It&#039;s a huge space so if it is open then we&#039;ll have no problem getting a table.&amp;nbsp; :)&lt;\/p&gt;\n\n&lt;p&gt;Just starting to do a headcount - I have 6 total so far (including me) do I have that right?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;@[member=\"acw271011\"]&lt;\/p&gt;\n&lt;p&gt;@[member=\"perianjay\"]&lt;\/p&gt;\n&lt;p&gt;@[member=\"krystalball\"]&lt;\/p&gt;\n&lt;p&gt;@[member=\"Meandhim\"]&lt;\/p&gt;\n&lt;p&gt;@[member=\"deecol\"]&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Am I missing anyone??&lt;\/p&gt;","Attachments":[],"Id":1898910,"PostDate":1434728682,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>hey ladies! Yay so glad the date seems to be working out. I'm pretty sure the rooftop patio should be ready for Aug 14. I'll keep you all posted. They should be up and running by July 1st! That's the plan as of right now anyway. It's a huge space so if it is open then we'll have no problem getting a table.\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<br \/><p>Just starting to do a headcount - I have 6 total so far (including me) do I have that right?<\/p>\n<p>\u00a0<\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"232000\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/232000-acw271011\/' title='Member profile'><span itemprop=\"name\">acw271011<\/span><\/a><\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"281478\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/281478-perianjay\/' title='Member profile'><span itemprop=\"name\">perianjay<\/span><\/a><\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"281820\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/281820-krystalball\/' title='Member profile'><span itemprop=\"name\">krystalball<\/span><\/a><\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"268499\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/268499-meandhim\/' title='Member profile'><span itemprop=\"name\">Meandhim<\/span><\/a><\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"281751\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/281751-deecol\/' title='Member profile'><span itemprop=\"name\">deecol<\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>Am I missing anyone??<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>My planning thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78916-snswedding2016-planning-thread-jan-9-2016-azul-fives\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78916-snswedding2016-planning-thread-jan-9-2016-azul-fives\/<\/a><\/p>\n<p>\u00a0<\/p>\n<div><a class='bbc_url' href='http:\/\/www.TickerFactory.com\/'><\/div>\n<div><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10730;0\/st\/20160109\/e\/Our+Wedding\/k\/9fa9\/event.png\" alt=\"event.png\"><\/div>\n<div><\/a><\/div>\n","Email":"sean.n.steph2016@gmail.com","IpAddress":"74.12.52.42","GroupId":40,"GroupName":"Jr. Member","JoinDate":1415533111,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281055.jpg?_r=1415590512","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"snswedding2016","Id":281055,"Name":"snswedding2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.87.237.201","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79202,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"7f16a12a9f72953850ba680b8a1e0aee","RawContent":"&lt;p&gt;Only one I can think of off the top is @veryvalentine&amp;nbsp; Her wedding is tomorrow&amp;nbsp;but I think she mentioned wanting to join. That could be my old age bad memory though....&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Not sure about anyone else....&lt;\/p&gt;","Attachments":[],"Id":1898915,"PostDate":1434731262,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n              