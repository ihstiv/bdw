397086760","PhotoWidth":160,"PhotoHeight":160,"PhotoType":"custom"},"FormattedName":"FutureMrsGlover","Id":277534,"Name":"FutureMrsGlover","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"199.85.228.129","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79276,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d05d41d0f4ddbebbd607479a431ea594","RawContent":"&lt;p&gt;Congrats!! One of the hardest decisions is picking the resort....now you can breathe, since that&#039;s done :)&lt;\/p&gt;","Attachments":[],"Id":1898627,"PostDate":1434391532,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats!! One of the hardest decisions is picking the resort....now you can breathe, since that's done <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"katie_mcbride48@yahoo.ca","IpAddress":"199.85.228.129","GroupId":39,"GroupName":"Newbie","JoinDate":1424099850,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282132.jpg?_r=1437519508","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"KatieMcBride","Id":282132,"Name":"KatieMcBride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"184.147.121.183","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79276,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c051e3d83758a5837c3e9d180757acb9","RawContent":"Congrats! It sure takes a load off actually selecting a resort :) Good luck with the bookings!","Attachments":[],"Id":1898632,"PostDate":1434399125,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Congrats! It sure takes a load off actually selecting a resort <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> Good luck with the bookings!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>My Planning Thread: <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79377-ashhtayys-planning-thread-azul-fives-june-7-2016\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79377-ashhtayys-planning-thread-azul-fives-june-7-2016\/<\/a><br>\n\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;0;116\/st\/20160607\/e\/Our+Wedding\/dt\/1\/k\/bb99\/event.png\" alt=\"event.png\"><\/a>","Email":"ashley.taylor@live.ca","IpAddress":"184.147.135.4","GroupId":40,"GroupName":"Jr. Member","JoinDate":1423090661,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282006.png?_r=1423373502","PhotoWidth":200,"PhotoHeight":138,"PhotoType":"custom"},"FormattedName":"ashhtayy","Id":282006,"Name":"ashhtayy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.134.141.162","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79276,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"813e64826c1234cb957c9c1252cbee5c","RawContent":"&lt;p&gt;@[member=\"dathotgal\"] &amp;nbsp;Congratulations!!! &amp;nbsp;We have the same wedding date!&lt;\/p&gt;","Attachments":[],"Id":1898649,"PostDate":1434441960,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"282047\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282047-dathotgal\/' title='Member profile'><span itemprop=\"name\">dathotgal<\/span><\/a> \u00a0Congratulations!!! \u00a0We have the same wedding date!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"deannaproteau@hotmail.com","IpAddress":"207.134.141.162","GroupId":40,"GroupName":"Jr. Member","JoinDate":1421428169,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281751.jpg?_r=1438177324","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"deecol","Id":281751,"Name":"deecol","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.101.223.7","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79276,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"050142aad72146c39709fad9e95cc409","RawContent":"i decided to go the villa route as the resorts are too restrictive and i am an out of the box woman per say.  my villa is in mammee bay\n[quote name=\"deecol\" post=\"1898649\" timestamp=\"1434456360\"]\n@[member=\"dathotgal\"]  Congratulations!!!  We have the same wedding date![\/quote]get this deecol.  wedding date april 30th, my bday may 1st his bday may 2nd\n[quote name=\"FutureMrsGlover\" post=\"1898618\" timestamp=\"1434396037\"]\n@[member=\"dathotgal\"].....congratulations on setting your date!!!   Have you decided on a resort?   I am getting married not far from Ocho Rios in Runaway Bay.[\/quote]maybe we will run into each other.  and maybe you can help me out.  im going at this wedding stuff alone.  thanks to all the help on this website","Attachments":[],"Id":1898733,"PostDate":1434514366,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>i decided to go the villa route as the resorts are too restrictive and i am an out of the box woman per say. \u00a0my villa is in mammee bay<\/p>\n<br \/><p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>deecol, on 16 June 2015 - 08:06 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"282047\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282047-dathotgal\/' title='Member profile'><span itemprop=\"name\">dathotgal<\/span><\/a> \u00a0Congratulations!!! \u00a0We have the same wedding date!<\/p>\n<\/div>\n<\/div><\/div>\n<p>get this deecol. \u00a0wedding date april 30th, my bday may 1st his bday may 2nd<\/p><br \/><p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>FutureMrsGlover, on 15 June 2015 - 03:20 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"282047\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282047-dathotgal\/' title='Member profile'><span itemprop=\"name\">dathotgal<\/span><\/a>.....congratulations on setting your date!!!\u00a0\u00a0 Have you decided on a resort?\u00a0\u00a0 I am getting married not far from Ocho Rios in Runaway Bay.\u00a0\u00a0<\/p>\n<\/div>\n<\/div><\/div>\n<p>maybe we will run into each other. \u00a0and maybe you can help me out. \u00a0im going at this wedding stuff alone. \u00a0thanks to all the help on this website<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"dathotgal51@yahoo.com","IpAddress":"173.77.182.126","GroupId":39,"GroupName":"Newbie","JoinDate":1423457925,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282047.jpg?_r=1436938666","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"dathotgal","Id":282047,"Name":"dathotgal","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"201.116.201.71","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79276,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4da2024dc9bcaad15157992e2d2c1908","RawContent":"&lt;p&gt;@[member=\"dathotgal\"] Congratulations on choosing the date!&lt;\/p&gt;\n&lt;p&gt;As you said, it can be difficult to find the date that suits you and your guests to start your travel plans.&lt;\/p&gt;\n&lt;p&gt;We know you will find many tips in this forums and some brides that already had their wedding are truly generous on giving out advice.&lt;\/p&gt;\n&lt;p&gt;Best of luck with the planning!&lt;\/p&gt;\n&lt;div&gt;[sharedmedia=gallery:images:80832]&lt;\/div&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;div&gt;[sharedmedia=gallery:images:79107]&lt;\/div&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;div&gt;[sharedmedia=gallery:images:81125]&lt;\/div&gt;\n&lt;p&gt;&lt;span style=\"color:#595959;\"&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.adventureweddingsvallarta.com\/&#039;&gt;&lt;strong&gt;&lt;span style=\"color:#548dd4;\"&gt;&lt;span style=\"font-family:garamond, serif;\"&gt;&lt;span style=\"font-size:10.5pt;\"&gt;www.adventureweddingsvallarta.com&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/a&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;&lt;span style=\"color:#548dd4;\"&gt;&lt;span style=\"font-family:garamond, serif;\"&gt;&lt;span style=\"font-size:10.5pt;\"&gt;Toll Free: 1 866.731.8152&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;&lt;span style=\"color:#548dd4;\"&gt;&lt;span style=\"font-family:garamond, serif;\"&gt;&lt;span style=\"font-size:10.5pt;\"&gt;Phone: +52 (322) 297.1212 ext. 1468&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;&lt;span style=\"font-size:9.5pt;\"&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1898864,"PostDate":1434647828,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"282047\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282047-dathotgal\/' title='Member profile'><span itemprop=\"name\">dathotgal<\/span><\/a> Congratulations on choosing the date!<\/p>\n<p>As you said, it can be difficult to find the date that suits you and your guests to start your travel plans.<\/p>\n<p>We know you will find many tips in this forums and some brides that already had their wedding are truly generous on giving out advice.<\/p>\n<p>Best of luck with the planning!<\/p>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/80832-romantic-beach-wedding\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17896\/sml_gallery_258213_17896_51244.jpg' class='galattach galimageview sharedmedia_screenshot' title='Romantic Beach Wedding'  width='200' height='200'  alt='Romantic Beach Wedding' id='sml_image_view_80832' \/><\/a>\n<br \/><\/div>\n<p>\u00a0<\/p>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/79107-all\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17896\/sml_gallery_258213_17896_13408.jpg' class='galattach galimageview sharedmedia_screenshot' title='All'  width='200' height='134'  alt='All' id='sml_image_view_79107' \/><\/a>\n<br \/><\/div>\n<p>\u00a0<\/p>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/81125-table-set-up-and-flowers\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_10944\/sml_gallery_258213_10944_165714.jpg' class='galattach galimageview sharedmedia_screenshot' title='Table Set up and Flowers'  width='200' height='168'  alt='Table Set up and Flowers' id='sml_image_view_81125' \/><\/a>\n<br \/><\/div>\n<p><span  style=\"color:#595959\"><a href='http:\/\/www.adventureweddingsvallarta.com\/' class='bbc_url' title='External link' rel='nofollow external'><strong><span  style=\"color:#548dd4\"><span  style=\"font-family:garamond, serif\"><span  style=\"font-size:10.5pt\">www.adventureweddingsvallarta.com<\/span><\/span><\/span><\/strong><\/a><\/span><\/p>\n<p><strong><span  style=\"color:#548dd4\"><span  style=\"font-family:garamond, serif\"><span  style=\"font-size:10.5pt\">Toll Free: 1 866.731.8152<\/span><\/span><\/span><\/strong><\/p>\n<p><strong><span  style=\"color:#548dd4\"><span  style=\"font-family:garamond, serif\"><span  style=\"font-size:10.5pt\">Phone: +52 (322) 297.1212 ext. 1468<\/span><\/span><\/span><\/strong><\/p>\n<p><span  style=\"font-family:arial, sans-serif\"><span  style=\"font-size:9.5pt\"><\/span><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"dennise@adventureweddingsvallarta.com","IpAddress":"187.146.166.254","GroupId":49,"GroupName":"Insiders","JoinDate":1343044403,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-258213.jpeg?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"LasCaletas","Id":258213,"Name":"LasCaletas","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.31.30.53","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79276,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0dda49036a8d1cf63c7f0420e8ae4ec4","RawContent":"&lt;p&gt;I just can say you \"congratulations\" ... May you have happy living&lt;\/p&gt;","Attachments":[],"Id":1899288,"PostDate":1435