r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile120.gif\" border=\"0\" alt=\"\" title=\"Smile120\" class=\"inlineimg\" \/><\/span><div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>beachbride<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">talk about a bridezilla!!! let me catch that person! <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile105.gif\" border=\"0\" alt=\"\" title=\"Smile105\" class=\"inlineimg\" \/><\/span><\/div> <\/td> <\/tr> <\/table> <\/div>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mmc7997@yahoo.com","IpAddress":"","GroupId":46,"GroupName":"VIP Member","JoinDate":1180415160,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207426.png?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"michelle08","Id":207426,"Name":"michelle08","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":5164,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6f3b4122d00d24a2263e1d4e6898bafa","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;foxytv&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;I am going to have to have my dress steamed by the resort once we rrive anyway ... so I guess it&#039;s not such a big deal if it has to go in an overhead bin. But, I&#039;ve only heard good things from other former bride friends who say they were treated like Queens and moved to First Class (space available, etc. We are likely flying US Airways out of Charlotte (I&#039;d rather drive an hour for a non-stop flight than risk having ANY luggage get lost) ... since we are bringing so much with us (flowers, centerpieces, OOT bags, etc).\n \n Thanks for this thread!!!&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;I hope that&#039;s the case!!!","Attachments":[],"Id":84927,"PostDate":1185889125,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>foxytv<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">I am going to have to have my dress steamed by the resort once we rrive anyway ... so I guess it's not such a big deal if it has to go in an overhead bin. But, I've only heard good things from other former bride friends who say they were treated like Queens and moved to First Class (space available, etc. We are likely flying US Airways out of Charlotte (I'd rather drive an hour for a non-stop flight than risk having ANY luggage get lost) ... since we are bringing so much with us (flowers, centerpieces, OOT bags, etc).<br \/> <br \/> Thanks for this thread!!!<\/div> <\/td> <\/tr> <\/table> <\/div>I hope that's the case!!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<a class='bbc_url' href='http:\/\/i641.photobucket.com\/albums\/uu135\/dieselpug\/AdamMay2010226-1.jpg'>http:\/\/i641.photobucket.com\/albums\/u...y2010226-1.jpg<\/a>","Email":"shelleyringrose@hotmail.com","IpAddress":"96.234.167.104","GroupId":46,"GroupName":"VIP Member","JoinDate":1181252160,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207447.jpg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"MsShelley","Id":207447,"Name":"MsShelley","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":5164,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9ab1978064a9d17abdc47fd9ded5a65c","RawContent":"Lose the dress when it&#039;s in the closet? Is it like a magic trick? Perhaps there is a secret hatch which will drop the dress from 5,000 miles in the air. &amp;quot;It&#039;s raining brides, halleluiah, it&#039;s raining brides.&amp;quot;","Attachments":[],"Id":84932,"PostDate":1185889333,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Lose the dress when it's in the closet? Is it like a magic trick? Perhaps there is a secret hatch which will drop the dress from 5,000 miles in the air. \"It's raining brides, halleluiah, it's raining brides.\"\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"~Trisha~<br \/>\n<a class='bbc_url' href='http:\/\/www.faberphotography.com'>www.faberphotography.com<\/a><br \/>\n<br \/>\nMy latest destination wedding photos can be found <a class='bbc_url' href='http:\/\/faberphotography.com\/destination-wedding\/'>HERE<\/a>","Email":"tfaber@wbmi.com","IpAddress":"12.24.226.126","GroupId":46,"GroupName":"VIP Member","JoinDate":1171995300,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207201.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"Tlseege","Id":207201,"Name":"Tlseege","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":5164,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d80b1b647fe744c64228d79f9629d037","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;Tlseege&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Lose the dress when it&#039;s in the closet? Is it like a magic trick? Perhaps there is a secret hatch which will drop the dress from 5,000 miles in the air. &amp;quot;It&#039;s raining brides, halleluiah, it&#039;s raining brides.&amp;quot;&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;&lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile120.gif\" border=\"0\" alt=\"\" title=\"Smile120\" class=\"inlineimg\" \/&gt;&lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile120.gif\" border=\"0\" alt=\"\" title=\"Smile120\" class=\"inlineimg\" \/&gt;&lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile120.gif\" border=\"0\" alt=\"\" title=\"Smile120\" class=\"inlineimg\" \/&gt;&lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile120.gif\" border=\"0\" alt=\"\" title=\"Smile120\" class=\"inlineimg\" \/&gt;\n \n yeah!!! I think she meant like, other people took your items instead of hers... who knows... Maybe the airline did secretly pay her!!!","Attachments":[],"Id":84934,"PostDate":1185889427,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>Tlseege<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Lose the dress when it's in the closet? Is it like a magic trick? Perhaps there is a secret hatch which will drop the dress from 5,000 miles in the air. \"It's raining brides, halleluiah, it's raining brides.\"<\/div> <\/td> <\/tr> <\/table> <\/div><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile120.gif\" border=\"0\" alt=\"\" title=\"Smile120\" class=\"inlineimg\" \/><\/span><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile120.gif\" border=\"0\" alt=\"\" title=\"Smile120\" class=\"inlineimg\" \/><\/span><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile120.gif\" border=\"0\" alt=\"\" title=\"Smile120\" class=\"inlineimg\" \/><\/span><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile120.gif\" border=\"0\" alt=\"\" title=\"Smile120\" class=\"inlineimg\" \/><\/span><br \/> <br \/> yeah!!! I think she meant like, other people took your items instead of hers... who knows... Maybe the airline did secretly pay her!!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<a class='bbc_url' href='http:\/\/i641.photobucket.com\/albums\/uu135\/dieselpug\/AdamMay2010226-1.jpg'>http:\/\/i641.photobucket.com\/albums\/u...y2010226-1.jpg<\/a>","Email":"shelleyringrose@hotmail.com","IpAddress":"96.234.167.104","GroupId":46,"GroupName":"VIP Member","JoinDate":1181252160,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207447.jpg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"MsShelley","Id":207447,"Name":"MsShelley","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":5164,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9614d4f32d433470a83282dde032605a","RawContent":"For those who carried on their dresses, did you buy a dress\/garmet bag? If so, where did you get it?","Attachments":[],"Id":84954,"PostDate":1185890849,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                For those who carried on their dresses, did you buy a dress\/garmet bag? If so, where did you get it?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/ticker.7910.org\/as1cA9D00000610Mjc2bHN8NTY5bHxXZVwndmUgYmVlbiBtYXJyaWVk.gif\">http:\/\/ticker.7910.org\/as1cA9D000006...BtYXJyaWVk.gif<\/a><\/div><\/div>","Email":"sanchez0014@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1166131615,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206971.gif?_r=0","PhotoWidth":75,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Mrs.Morley","Id":206971,"Name":"Mrs.Morley","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":5164,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"27c33b189f9f565fe8f24f3314907e4f","RawContent":"I&#039;ve never heard of anyone ever buying an extra ticket just for their dress. That is beyond excessive! She definitely had to be getting commission from the airline companies! lol...","Attachments":[],"Id":84999,"PostDate":1185892624,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I've never heard of anyone ever buying an extra ticket just for their dress. That is beyond excessive! She definitely had to be getting commission from the airline companies! lol...\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"deltagirl_30@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1182189025,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207477.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"dlou","Id":207477,"Name":"dlou","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":5164,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8ffdde3d7b11643c273fc124c4becebe","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;gkashmira&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;I walked right onto an American Airlines flight with no problem at all. I called ahead of time and they told me just to carry it on and ask to hang it in the front coat closet.\n \n In fact by doing this we also brought it to the stewardess&#039; attention and later they moved us to first class... I swear I&#039;m carrying a large white garment bag whenever I travel - even if it&#039;s empty! &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/wink.gif\" border=\"0\" alt=\"\" title=\"Wink\" class=\"inlineimg\" \/&gt;&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;Good to hear as we&#039;re flying America as well. Phew!","Attachments":[],"Id":85002,"PostDate":1185892724,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>gkashmira<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">I walked right onto an American Airlines flight with no problem at all. I called ahead of time and they told me just to carry it on and ask to hang it in the front coat closet.<br \/> <br \/> In fact by doing this we also brought it to the stewardess' attention and later they moved us to first class... I swear I'm carrying a large white garment bag whenever I travel - even if it's empty! <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/wink.gif\" border=\"0\" alt=\"\" title=\"Wink\" class=\"inlineimg\" \/><\/span><\/div> <\/td> <\/tr> <\/table> <\/div>Good to hear as we're flying America as well. Phew!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"melissa.ayotte@gmail.com","IpAddress":"174.27.238.196","GroupId":46,"GroupName":"VIP Member","JoinDate":1169948520,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207103.jpg?_r=0","PhotoWidth":180,"PhotoHeight":270,"PhotoType":"custom"},"FormattedName":"~Melissa~","Id":207103,"Name":"~Melissa~","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":5164,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a2855b2e4f438d477489724f3c3a687d","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;starchild&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Alaska Airlines was the best! They put my dress in the empty first class closet, announced us to the whole plane, gave us free champagne, and went around and got advice from married couples then announced it on the PA.....it was above what we expected for sure!!\n \n If you call they&#039;ll say it&#039;s on a space available basis, but if the closets are full you can still carry it on, you&#039;ll just have to lay it flat in the overhead which isn&#039;t a big problem.&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;This makes me feel better. I think we are going through Alaska.\n \n Thanks for all the feedback girls. I just want to know what to expect!","Attachments":[],"Id":85055,"PostDate":1185895326,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>starchild<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Alaska Airlines was the best! They put my dress in the empty first class closet, announced us to the whole plane, gave us free champagne, and went around and got advice from married couples then announced it on the PA.....it was above what we expected for sure!!<br \/> <br \/> If you call they'll say it's on a space available basis, but if the closets are full you can still carry it on, you'll just have to lay it flat in the overhead which isn't a big problem.<\/div> <\/td> <\/tr> <\/table> <\/div>This makes me feel better. I think we are going through Alaska.<br \/> <br \/> Thanks for all the feedback girls. I just want to know what to expect!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Happily married since 2008<\/span><\/div><\/div>","Email":"rachie021@yahoo.com","IpAddress":"70.173.241.167","GroupId":46,"GroupName":"VIP Member","JoinDate":1179191760,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207401.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"jajajaja","Id":207401,"Name":"jajajaja","IsOnline":false}}],"Pages":{"TotalItems":84,"TotalPages":9,"CurrentPage":10,"NextPage":20,"PreviousPage":0,"LastPage":80},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
