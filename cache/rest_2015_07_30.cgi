.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Feath07","Id":276610,"Name":"Feath07","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.202.225.11","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76752,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"820707b8a1bfef38b07f8a045e8d64c3","RawContent":"We have a few.  Try TA patty.  Or you can fill out the inquiry link in my signature and I can get her to contact you.","Attachments":[],"Id":1845964,"PostDate":1398299814,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We have a few.  Try TA patty.  Or you can fill out the inquiry link in my signature and I can get her to contact you.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-family:arial, helvetica, sans-serif;\">Founder and Owner of BestDestinationWedding.com \u00a0\/ \u00a0<\/span><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/'><strong><span style=\"font-family:arial, helvetica, sans-serif;\">Bride & Groom Fly FREE Promotion<\/span><\/strong><\/a><\/p>\n<p>\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><strong><a data-ipb='nomediaparse' href='http:\/\/wrighttravelagency.com\/inquiry\/'><span style=\"color:#008080;\">Looking for a travel agency that specializes in Destination Weddings<\/span><\/a><\/strong><span style=\"color:#008080;\"><strong>?<\/strong> \u00a0We are an award winning travel agency and you can <\/span><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style=\"color:#008080;\">read our reviews\u00a0here.<\/span><\/a><\/strong><\/span><br>\n\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"color:#008080;\"><strong>Awards and recognition:\u00a0<\/strong><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Palace Resorts PRO Platinum Agency (Top Award) \u00a0 \u00a0 | \u00a0 \u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">AMResorts Master Agent & Top Agency \u00a0<\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/68050-karisma-hotels-givc-and-gi-wedding-consultants-wright-travel-agency\/'><strong>Wright Travel & Karisma GIVC Benefits<\/strong><\/a><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Travel Impressions Best of the Best Globe Winner \u00a0 \u00a0| \u00a0 \u00a0\u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Apple Vacations Golden Apple Winner \u00a0<\/span><\/span><br><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"> \u00a0 \u00a0<img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"font-size:14px;\"><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010'>Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><\/span><\/span><strong><span style=\"color:#b22222;\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a data-ipb='nomediaparse' href='mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com'>ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"admin@bestdestinationwedding.com","IpAddress":"71.202.225.11","GroupId":4,"GroupName":"Administrators","JoinDate":1137209820,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"FormattedName":"TammyWright","Id":206696,"Name":"TammyWright","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"76.95.91.65","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76752,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"2d763e2d287bea39c00d67b642bb9994","RawContent":"&lt;p&gt;Hi - I just sent you a PM. My email is patt@wrighttravelagency.com. Look forward to speaking with you! Thanks TA Patty&lt;\/p&gt;","Attachments":[],"Id":1845965,"PostDate":1398301880,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi - I just sent you a PM. My email is patt@wrighttravelagency.com. Look forward to speaking with you! Thanks TA Patty<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><a class='bbc_url' href='http:\/\/wrighttravelagency.com\/inquiry\/'><span style='color: rgb(0,128,128)'>Looking for a travel agency that specializes in Destination Weddings<\/span><\/a><span style='color: rgb(0,128,128)'>? We are an award winning travel agency and you can read our reviews <\/span><a class='bbc_url' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style='color: rgb(0,128,128)'><strong class='bbc'>HERE.<\/strong><\/span><\/a><\/span><\/span><br \/>\n<br \/>\n<span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'><strong class='bbc'>Awards and recognition: <\/strong><\/span><\/span><\/span><\/span><br \/>\n<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'>Palace Resorts Top PRO Agency <\/span><\/span><\/span><\/span><br \/>\n<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'>Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator <\/span><\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>AMResorts Master Agent & Top Agency<\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>Travel Impressions Best of the Best Globe Winner<\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>Apple Vacations Golden Apple Winner<\/span><\/span><\/span><span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='font-size: 12px;'><span style='color: rgb(0,128,128)'>5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | AMResorts Master Agent & Top Agency | <\/span><span style='color: rgb(0,128,128)'>Travel Impressions Best of the Best Globe Winner | Apple Vacations Golden Apple Winner <\/span><\/span><\/span><\/span>","Email":"patty@wrighttravelagency.com","IpAddress":"76.95.92.213","GroupId":49,"GroupName":"Insiders","JoinDate":1278643080,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230028.jpg?_r=1398727965","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"TA Patty","Id":230028,"Name":"TA Patty","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.77.36.17","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76752,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"840bc2ce9c401744bebb076cb09c166f","RawContent":"&lt;p&gt;Congrats on your engagement, Feath07!!! how is your search going for a DR wedding venue for your wedding next April?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;yes, there are some gorgeous beaches and tropical vistas there......all the best with your research + plans!&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-a-ord.xx.fbcdn.net\/hphotos-ash3\/t1.0-9\/1454722_10151997425014487_1167867365_n.jpg\" alt=\"1454722_10151997425014487_1167867365_n.j\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;cheers! team MTM :)&lt;\/p&gt;","Attachments":[],"Id":1846078,"PostDate":1398358616,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats on your engagement, Feath07!!! how is your search going for a DR wedding venue for your wedding next April?<\/p>\n<p>\u00a0<\/p>\n<p>yes, there are some gorgeous beaches and tropical vistas there......all the best with your research + plans!<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-a-ord.xx.fbcdn.net\/hphotos-ash3\/t1.0-9\/1454722_10151997425014487_1167867365_n.jpg\" alt=\"1454722_10151997425014487_1167867365_n.j\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>cheers! team MTM <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280196260,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"198.232.50.172","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76752,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1078ad59a6ed4b1675da99054084af2b","RawContent":"[quote name=\"Feath07\" post=\"1842180\" timestamp=\"1396503347\"]\nHello Ladies!!\n\nI&#039;m recently engaged and planning my wedding in the DR, Punta Cana.  The beaches look incredible and my fiance and I are all about the Tropical Paradise feel for our wedding!  :)   I&#039;ve doing quite a bit of research on the all-inclusive resorts (crazy how many there are, but love the options) and would love to receive recommendations for recent weddings in Punta Cana.  \n\nI was in contact with Stephany at the Sanctuary Cap Cana, yet have just been informed that she is no longer with them and the resort is not available for weddings in April 2015, which was very disappointing since this resort was top on my list.  I loved the fact that it was more private and less of a \"wedding factory\" feel per se.  The new coordinator, Hector, did however recommend the other two sister properties of the resort (ALSO Luxury Village and ALSO Del Mar).  Has anyone gotten married or stayed at either of these two resorts?\n\nAny feedback would be extremely helpful!!\n\nThanks so much!![\/quote]","Attachments":[],"Id":1846088,"PostDate":1398361872,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Feath07, on 03 April 2014 - 01:35 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hello Ladies!!<\/p>\n<p>\u00a0<\/p>\n<p>I'm recently engaged and planning my wedding in the DR, Punta Cana. \u00a0The beaches look incredible and my fiance and I are all about the Tropical Paradise feel for our wedding!\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> \u00a0 I've doing quite a bit of research on the all-inclusive resorts (crazy how many there are, but love the options) and would love to receive recommendations for recent weddings in Punta Cana. \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I was in contact with Stephany at the Sanctuary Cap Cana, yet have just been informed that she is no longer with them and the resort is not available for weddings in April 2015, which was very disappointing since this resort was top on my list. \u00a0I loved the fact that it was more private and less of a \"wedding factory\" feel per se. \u00a0The new coordinator, Hector, did however recommend the other two sister properties of the resort (ALSO Luxury Village and ALSO Del Mar). \u00a0Has anyone gotten married or stayed at either of these two resorts?<\/p>\n<p>\u00a0<\/p>\n<p>Any feedback would be extremely helpful!!<\/p>\n<p>\u00a0<\/p>\n<p>Thanks so much!!<\/p>\n<\/div>\n<\/div><\/div>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"courtneyaurora@yahoo.com","IpAddress":"198.232.50.162","GroupId":39,"GroupName":"Newbie","JoinDate":1355435227,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-263234.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"divatrotter","Id":263234,"Name":"divatrotter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"184.178.26.150","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76752,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1ae406b2a15a019ae394313126687d2b","RawContent":"&lt;p&gt;@TA Patty Thanks so much! &amp;nbsp;I just sent you an email Patty. &amp;nbsp;Can&#039;t wait to be in touch&amp;nbsp; :D&lt;\/p&gt;","Attachments":[],"Id":1846095,"PostDate":1398363209,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@TA Patty Thanks so much! \u00a0I just sent you an email Patty. \u00a0Can't wait to be in touch\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/biggrin.png' class='bbc_emoticon' alt=':D' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"erskinetoczkowedding@gmail.com","IpAddress":"184.178.26.150","GroupId":39,"GroupName":"Newbie","JoinDate":1392050727,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Feath07","Id":276610,"Name":"Feath07","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"199.180.174.8","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76752,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4cfb81359c0cc285c42693064ca9505f","RawContent":"&lt;p&gt;@[member=\"Feath07\"] I am getting married April 17, 2015 at the Melia Caribe Tropical in Punta Cana. I have never visited this resort but it looks beautiful for weddings. Some reasons why I chose this resort:&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;- Seems to be a lot of restaurant options for my guests (most of them are picky eaters, well my family anyway)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;- The gardens are beautiful and would look great for pictures&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;- There is an adult only section to this resort which is where my fianc\u00e9 and I will be staying. But it also gives people the opportunity to take their kids too. best of both worlds.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;- They seem to have a good selection for wedding packages.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;- The price was right when we booked&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;- The only downfall I would say of booking at this resort is what the resort charges for a fee in order for you to have an outside photographer. If you want to have an outside photographer come to take photos it costs $1000 just to get them on the resort. This I found was outrageous but we are booking HDC photography anyway and their prices are pretty reasonable.&lt;\/p&gt;","Attachments":[],"Id":1846097,"PostDate":1398363315,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"276610\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/276610-feath07\/' title='Member profile'><span itemprop=\"name\">Feath07<\/span><\/a> I am getting married April 17, 2015 at the Melia Caribe Tropical in Punta Cana. I have never visited this resort but it looks beautiful for weddings. Some reasons why I chose this resort:<\/p>\n<p>\u00a0<\/p>\n<p>- Seems to be a lot of restaurant options for my guests (most of them are picky eaters, well my family anyway)<\/p>\n<p>\u00a0<\/p>\n<p>- The gardens are beautiful and would look great for pictures<\/p>\n<p>\u00a0<\/p>\n<p>- There is an adult only section to this resort which is where my fianc\u00e9 and I will be staying. But it also gives people the opportunity to take their kids too. best of both worlds.<\/p>\n<p>\u00a0<\/p>\n<p>- They seem to have a good selection for wedding packages.<\/p>\n<p>\u00a0<\/p>\n<p>- The price was right when we booked<\/p>\n<p>\u00a0<\/p>\n<p>- The only downfall I would say of booking at this resort is what the resort charges for a fee in order for you to have an outside photographer. If you want to have an outside photographer come to take photos it costs $1000 just to get them on the resort. This I found was outrageous but we are booking HDC photography anyway and their prices are pretty reasonable.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p style=\"text-align:center;\"><strong>Kristy and Nathan<\/strong><\/p>\n<p style=\"text-align:center;\"><strong>Melia Caribe Tropical <\/strong><\/p>\n<p style=\"text-align:center;\"><strong>April 17, 2015<\/strong>","Email":"colek_64@hotmail.com","IpAddress":"199.180.174.8","GroupId":3,"GroupName":"Member","JoinDate":1395332214,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277264.jpg?_r=1429937323","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"kcole123","Id":277264,"Name":"kcole123","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"184.178.26.150","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76752,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"32aad7d342f7b95bd09ede84ceedfbed","RawContent":"&lt;p&gt;@[member=\"Moments That Matter\"] &amp;nbsp;Thanks, it&#039;s definitely keeping me busy, but a lot of fun as well. &amp;nbsp;I&#039;m excited to talk with Patty at Wright Travel Agency, since all the reviews have been amazing and I could definitely use the help!&lt;\/p&gt;\n\n&lt;p&gt;@[member=\"kcole123\"] &amp;nbsp;Thanks so much for the feedback. &amp;nbsp;Do you know if they charge a fee if your photographers are also guests at your wedding? &amp;nbsp;My close friends are professional photographers and will be taking our photos as our wedding gift.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Also, what other resorts were you considering?&lt;\/p&gt;","Attachments":[],"Id":1846098,"PostDate":1398365184,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"230711\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/230711-moments-that-matter\/' title='Member profile'><span itemprop=\"name\">Moments That Matter<\/span><\/a> \u00a0Thanks, it's definitely keeping me busy, but a lot of fun as well. \u00a0I'm excited to talk with Patty at Wright Travel Agency, since all the reviews have been amazing and I could definitely use the help!<\/p>\n<br \/><p>@<a hovercard-ref=\"member\" hovercard-id=\"277264\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277264-kcole123\/' title='Member profile'><span itemprop=\"name\">kcole123<\/span><\/a> \u00a0Thanks so much for the feedback. \u00a0Do you know if they charge a fee if your photographers are also guests at your wedding? \u00a0My close friends are professional photographers and will be taking our photos as our wedding gift.<\/p>\n<p>\u00a0<\/p>\n<p>Also, what other resorts were you considering?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"erskinetoczkowedding@gmail.com","IpAddress":"184.178.26.150","GroupId":39,"GroupName":"Newbie","JoinDate":1392050727,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Feath07","Id":276610,"Name":"Feath07","IsOnline":false}}],"Id":"76752","Title":"April 2015 Wedding In Punta Cana","LastPostDate":1432600544},"Pages":{"TotalItems":26,"TotalPages":3,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":20},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
