ts & accommodations) - $2,980.75<br \/> <br \/> Obviously, staying for two weeks is a great deal...if you can afford it! lol\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"signaorion@hotmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1221775800,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211816.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"~*Kathy*~","Id":211816,"Name":"~*Kathy*~","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"209.91.107.211","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27846,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"412f3b3675f6e2adb981c8f74209ed1b","RawContent":"Price hasn&#039;t changed much for April 2015...We are just starting to plan and are quoted around 1800.00 AI with Air Transit staying at Now Amber in PV Mexico...","Attachments":[],"Id":1832876,"PostDate":1391984124,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Price hasn't changed much for April 2015...We are just starting to plan and are quoted around 1800.00 AI with Air Transit staying at Now Amber in PV Mexico...\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kdevries@shaw.ca","IpAddress":"50.65.17.253","GroupId":39,"GroupName":"Newbie","JoinDate":1359762644,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265520.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Kardev","Id":265520,"Name":"Kardev","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"216.118.82.254","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27846,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1f5e77d9181c7bc27910c3ef8d33b6d6","RawContent":"&lt;p&gt;About $1000 for 5 nights&lt;\/p&gt;","Attachments":[],"Id":1850722,"PostDate":1400263581,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>About $1000 for 5 nights<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"latanyabryant@hotmail.com","IpAddress":"68.37.216.36","GroupId":40,"GroupName":"Jr. Member","JoinDate":1391296404,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276443.jpg?_r=1391315507","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Tanya81","Id":276443,"Name":"Tanya81","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.101.152.253","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27846,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d60233833097860cc38dd90b6bf2dfec","RawContent":"Our guests are paying $1575 pp\/dbl occ an