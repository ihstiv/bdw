{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":1,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":0,"MovedTo":null,"MovedOn":0,"FirstPostId":1904175,"Rating":0,"RatingHits":0,"Starter":{"Id":284683,"Name":"NG1515","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284683.jpg?_r=1441394632","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"IsOnline":false},"StartDate":1441377014,"LastPoster":{"Id":284683,"Name":"NG1515","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284683.jpg?_r=1441394632","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1904175,"PostDate":1441377014,"PostContent":"Hey there ladies! \u00a0 I'm new on this site and I found it because of the amazing topic trend on her...","Author":{"Signature":"","Email":"nelsygomez15@gmail.com","IpAddress":"208.54.249.196","GroupId":39,"GroupName":"Newbie","JoinDate":1441375839,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284683.jpg?_r=1441394632","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"NG1515","Id":284683,"Name":"NG1515","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.54.249.196","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79565,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ca5fc19ceb86a518d0f87c4f3bc0d768","RawContent":"&lt;p&gt;&lt;span style=\"font-size:12px;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;Hey there ladies!&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:12px;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;I&#039;m new on this site and I found it because of the amazing topic trend on here regarding Paradisus La Perla in Playa del Carmen. &amp;nbsp;Our wedding is scheduled for April 16, 2016 and we booked the venue (and signed a contract) back in May of this year. &amp;nbsp;Well we just found out that somehow the resort double booked our ceremony venue and unilaterally was going to move us to a different venue location that we did not select, nor did we want to utilize for the ceremony. &amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;&lt;span style=\"font-size:12px;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;Suffice it to say, we are very upset, disappointed, and frankly, insulted by how cavalier they were about the change. &amp;nbsp;It was our understanding that they never host two weddings at the same time. &amp;nbsp;We are now being left with the option of either using the Gazebo to host our 80-100 guest wedding on the 16th while another wedding is going on at our original ceremony venue, move the date of the wedding to the following day (keeping in mind that guests have already booked rooms, we have already sent save the dates and had our invitations printed) in order to use the bridge while a potential corporate event is going on behind us at Gabi Club, or pursue legal action for breach of contract. &amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;&lt;span style=\"font-size:12px;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;It would be great to know if anyone else has had similar issues with the Romance Department and how it was resolved. &amp;nbsp;This has been a very stressful and upsetting week to say the least!&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1904175,"PostDate":1441377014,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span  style=\"font-size:12px\"><span  style=\"font-family:arial, helvetica, sans-serif\">Hey there ladies!<\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-size:12px\"><span  style=\"font-family:arial, helvetica, sans-serif\">I'm new on this site and I found it because of the amazing topic trend on here regarding Paradisus La Perla in Playa del Carmen. \u00a0Our wedding is scheduled for April 16, 2016 and we booked the venue (and signed a contract) back in May of this year. \u00a0Well we just found out that somehow the resort double booked our ceremony venue and unilaterally was going to move us to a different venue location that we did not select, nor did we want to utilize for the ceremony. \u00a0<\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\"><span  style=\"font-size:12px\"><span  style=\"font-family:arial, helvetica, sans-serif\">Suffice it to say, we are very upset, disappointed, and frankly, insulted by how cavalier they were about the change. \u00a0It was our understanding that they never host two weddings at the same time. \u00a0We are now being left with the option of either using the Gazebo to host our 80-100 guest wedding on the 16th while another wedding is going on at our original ceremony venue, move the date of the wedding to the following day (keeping in mind that guests have already booked rooms, we have already sent save the dates and had our invitations printed) in order to use the bridge while a potential corporate event is going on behind us at Gabi Club, or pursue legal action for breach of contract. \u00a0<\/span><\/span><\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\"><span  style=\"font-size:12px\"><span  style=\"font-family:arial, helvetica, sans-serif\">It would be great to know if anyone else has had similar issues with the Romance Department and how it was resolved. \u00a0This has been a very stressful and upsetting week to say the least!<\/span><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nelsygomez15@gmail.com","IpAddress":"208.54.249.196","GroupId":39,"GroupName":"Newbie","JoinDate":1441375839,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284683.jpg?_r=1441394632","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"NG1515","Id":284683,"Name":"NG1515","IsOnline":false}}],"Id":"79565","Title":"Newbie - Already Having Wedding Drama With Paradisus Pdc","LastPostDate":1441377014},"Pages":{"TotalItems":1,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
