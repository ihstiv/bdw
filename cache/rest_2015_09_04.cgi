{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":37,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":1872,"MovedTo":null,"MovedOn":0,"FirstPostId":1902093,"Rating":0,"RatingHits":0,"Starter":{"Id":273789,"Name":"cora4600","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-273789.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":115,"PhotoType":"custom"},"IsOnline":false},"StartDate":1438971973,"LastPoster":{"Id":283070,"Name":"KG1990","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283070.jpg?_r=1432102786","PhotoWidth":200,"PhotoHeight":201,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":23,"Preview":{"Id":1902093,"PostDate":1438971973,"PostContent":"Hey Guys,\u00a0 \u00a0 I always meant to write a review of my wedding but just never got around to it. So i...","Author":{"Signature":"","Email":"cora4600@yahoo.com","IpAddress":"205.173.217.10","GroupId":39,"GroupName":"Newbie","JoinDate":1380213689,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-273789.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":115,"PhotoType":"custom"},"FormattedName":"cora4600","Id":273789,"Name":"cora4600","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"205.173.217.10","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79475,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"bed29064c26e8d48519b2a0a9f2c4e20","RawContent":"&lt;p&gt;Hey Guys,&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I always meant to write a review of my wedding but just never got around to it. So instead I thought I&#039;d offer a couple pics (some are iPhone pics, so ignore the quality) and a video a friend made for us while we were there, and see if anyone had any questions that I could answer.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Video:&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;https:\/\/vimeo.com\/111876328&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Let me know if you have any questions! We had the best time and I would HIGHLY recommend this location to anyone!&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;-Cora&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent.xx.fbcdn.net\/hphotos-xpf1\/v\/t1.0-9\/10420365_10205533871131353_8379456398308487032_n.jpg?oh=3b7838f73992808c0e5af2df8474f5f5&amp;amp;oe=56482416\" alt=\"10420365_10205533871131353_8379456398308\"&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent.xx.fbcdn.net\/hphotos-xpf1\/v\/t1.0-9\/10418871_10205533897492012_1833775241637928914_n.jpg?oh=363e084d9b4a9fbadc75efecefe7bdbc&amp;amp;oe=563EAD6B\" alt=\"10418871_10205533897492012_1833775241637\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent.xx.fbcdn.net\/hphotos-xap1\/v\/t1.0-9\/10300150_10205307512672533_6574930723271596520_n.jpg?oh=81d6eef0f9b73e6c897114ab1cdd003a&amp;amp;oe=56837811\" alt=\"10300150_10205307512672533_6574930723271\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent.xx.fbcdn.net\/hphotos-xtp1\/v\/t1.0-9\/10487394_10205533902612140_3236210462410996349_n.jpg?oh=cad9a6c06e37f6ef57d0af80be8b18e1&amp;amp;oe=56566445\" alt=\"10487394_10205533902612140_3236210462410\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent.xx.fbcdn.net\/hphotos-xaf1\/v\/t1.0-9\/10731078_10205419887761698_5298009650918647868_n.jpg?oh=1e27ae168abdec38987db7820b7c597a&amp;amp;oe=563ADCC4\" alt=\"10731078_10205419887761698_5298009650918\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent.xx.fbcdn.net\/hphotos-xfp1\/v\/t1.0-9\/10610723_10153406470797565_5391508959781032912_n.jpg?oh=756fd180ff3b72d03a856aaebafb3376&amp;amp;oe=564DBE94\" alt=\"10610723_10153406470797565_5391508959781\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent.xx.fbcdn.net\/hphotos-xpf1\/v\/t1.0-9\/10532974_10205420022445065_5435476892896122466_n.jpg?oh=df2a4ea9ab919f9c4899d4edd36a81e8&amp;amp;oe=565647D8\" alt=\"10532974_10205420022445065_5435476892896\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent.xx.fbcdn.net\/hphotos-xaf1\/v\/t1.0-9\/1535461_10205533870491337_2524546101112165283_n.jpg?oh=a14be27d13be026b28e37eaa0c4ae844&amp;amp;oe=564A6926\" alt=\"1535461_10205533870491337_25245461011121\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent.xx.fbcdn.net\/hphotos-xtp1\/v\/t1.0-9\/10731058_10153406469892565_2178721631020914188_n.jpg?oh=fdb140f79ac45907476b3b2b30b889f9&amp;amp;oe=567E748D\" alt=\"10731058_10153406469892565_2178721631020\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent.xx.fbcdn.net\/hphotos-xpa1\/v\/t1.0-9\/1794562_10205533929932823_2889369561359979855_n.jpg?oh=2c3c57e163ffdb004796f6afeff173f4&amp;amp;oe=563C8303\" alt=\"1794562_10205533929932823_28893695613599\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent.xx.fbcdn.net\/hphotos-xpt1\/v\/t1.0-9\/10857892_10205533720567589_4267769764944657039_n.jpg?oh=82c8f3ee1aa3c56a6b946794f8c08b47&amp;amp;oe=563AB95A\" alt=\"10857892_10205533720567589_4267769764944\"&gt;&lt;\/p&gt;","Attachments":[],"Id":1902093,"PostDate":1438971973,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hey Guys,\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I always meant to write a review of my wedding but just never got around to it. So instead I thought I'd offer a couple pics (some are iPhone pics, so ignore the quality) and a video a friend made for us while we were there, and see if anyone had any questions that I could answer.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Video:\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><iframe src=\"https:\/\/player.vimeo.com\/video\/111876328\" class=\"EmbeddedVideo\" width=\"400\" height=\"250\" frameborder=\"0\"><\/iframe><\/p>\n<p>\u00a0<\/p>\n<p>Let me know if you have any questions! We had the best time and I would HIGHLY recommend this location to anyone!\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>-Cora<\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent.xx.fbcdn.net\/hphotos-xpf1\/v\/t1.0-9\/10420365_10205533871131353_8379456398308487032_n.jpg?oh=3b7838f73992808c0e5af2df8474f5f5&oe=56482416\" alt=\"10420365_10205533871131353_8379456398308\"><\/span><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent.xx.fbcdn.net\/hphotos-xpf1\/v\/t1.0-9\/10418871_10205533897492012_1833775241637928914_n.jpg?oh=363e084d9b4a9fbadc75efecefe7bdbc&oe=563EAD6B\" alt=\"10418871_10205533897492012_1833775241637\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent.xx.fbcdn.net\/hphotos-xap1\/v\/t1.0-9\/10300150_10205307512672533_6574930723271596520_n.jpg?oh=81d6eef0f9b73e6c897114ab1cdd003a&oe=56837811\" alt=\"10300150_10205307512672533_6574930723271\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent.xx.fbcdn.net\/hphotos-xtp1\/v\/t1.0-9\/10487394_10205533902612140_3236210462410996349_n.jpg?oh=cad9a6c06e37f6ef57d0af80be8b18e1&oe=56566445\" alt=\"10487394_10205533902612140_3236210462410\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent.xx.fbcdn.net\/hphotos-xaf1\/v\/t1.0-9\/10731078_10205419887761698_5298009650918647868_n.jpg?oh=1e27ae168abdec38987db7820b7c597a&oe=563ADCC4\" alt=\"10731078_10205419887761698_5298009650918\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent.xx.fbcdn.net\/hphotos-xfp1\/v\/t1.0-9\/10610723_10153406470797565_5391508959781032912_n.jpg?oh=756fd180ff3b72d03a856aaebafb3376&oe=564DBE94\" alt=\"10610723_10153406470797565_5391508959781\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent.xx.fbcdn.net\/hphotos-xpf1\/v\/t1.0-9\/10532974_10205420022445065_5435476892896122466_n.jpg?oh=df2a4ea9ab919f9c4899d4edd36a81e8&oe=565647D8\" alt=\"10532974_10205420022445065_5435476892896\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent.xx.fbcdn.net\/hphotos-xaf1\/v\/t1.0-9\/1535461_10205533870491337_2524546101112165283_n.jpg?oh=a14be27d13be026b28e37eaa0c4ae844&oe=564A6926\" alt=\"1535461_10205533870491337_25245461011121\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent.xx.fbcdn.net\/hphotos-xtp1\/v\/t1.0-9\/10731058_10153406469892565_2178721631020914188_n.jpg?oh=fdb140f79ac45907476b3b2b30b889f9&oe=567E748D\" alt=\"10731058_10153406469892565_2178721631020\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent.xx.fbcdn.net\/hphotos-xpa1\/v\/t1.0-9\/1794562_10205533929932823_2889369561359979855_n.jpg?oh=2c3c57e163ffdb004796f6afeff173f4&oe=563C8303\" alt=\"1794562_10205533929932823_28893695613599\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent.xx.fbcdn.net\/hphotos-xpt1\/v\/t1.0-9\/10857892_10205533720567589_4267769764944657039_n.jpg?oh=82c8f3ee1aa3c56a6b946794f8c08b47&oe=563AB95A\" alt=\"10857892_10205533720567589_4267769764944\"><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cora4600@yahoo.com","IpAddress":"205.173.217.10","GroupId":39,"GroupName":"Newbie","JoinDate":1380213689,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-273789.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":115,"PhotoType":"custom"},"FormattedName":"cora4600","Id":273789,"Name":"cora4600","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.87.42.110","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79475,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"718079a820b53be7de7751e2a98a40d7","RawContent":"&lt;p&gt;Thank you so much for posting, I have a ton of questions. Did you get any of the packages I noticed that your chairs did not have the white covers on them I thought they were included with the packages. Also did you upgrade your cake or is that the standard. Was it extra to get a tent on the beach, did you do that through Secrets?&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Also did they put those black lamp post lights out for you was there any additional charge for it?&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1902102,"PostDate":1438980050,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thank you so much for posting, I have a ton of questions. Did you get any of the packages I noticed that your chairs did not have the white covers on them I thought they were included with the packages. Also did you upgrade your cake or is that the standard. Was it extra to get a tent on the beach, did you do that through Secrets?\u00a0<\/p><br \/><p>Also did they put those black lamp post lights out for you was there any additional charge for it?\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nicolechin4@yahoo.com","IpAddress":"68.87.42.110","GroupId":39,"GroupName":"Newbie","JoinDate":1407440509,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"JamaicaNicole","Id":279353,"Name":"JamaicaNicole","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"205.173.217.10","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79475,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"4fcb9d391e29ac1454c691b052d1115f","RawContent":"&lt;p&gt;@[member=\"JamaicaNicole\"]&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I got the Ultimate Package. BUT I upgraded our chairs. Personally I didn&#039;t like the white covers, so I paid extra for those. If you do not upgrade to specific chairs, the white covers are included.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;The cake was not upgraded, we just brought our own wedding topper and they did the rest. I will also say that it was honestly some of the best cake I have had at a wedding! I was so sad that I didn&#039;t have more! They also saved the top tier for us to order for room service but we completely forgot. Still bummed! Ha!&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We rented the tent on the beach. We had the 2pm time slot and I was worried about the heat with no shade. It was honestly really reasonable compared to all the other price gauging they do. It was $1,000 for the whole night and was their largest tent. I paid Secrets, but they rent them through a third party, so they only need about 72 hours notice to set up. &amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;They put the black lamps up. I didn&#039;t request them or pay extra for them, so I&#039;m assuming they are included in all the packages for beach weddings. &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1902105,"PostDate":1438980548,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"279353\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/279353-jamaicanicole\/' title='Member profile'><span itemprop=\"name\">JamaicaNicole<\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>I got the Ultimate Package. BUT I upgraded our chairs. Personally I didn't like the white covers, so I paid extra for those. If you do not upgrade to specific chairs, the white covers are included.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>The cake was not upgraded, we just brought our own wedding topper and they did the rest. I will also say that it was honestly some of the best cake I have had at a wedding! I was so sad that I didn't have more! They also saved the top tier for us to order for room service but we completely forgot. Still bummed! Ha!\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>We rented the tent on the beach. We had the 2pm time slot and I was worried about the heat with no shade. It was honestly really reasonable compared to all the other price gauging they do. It was $1,000 for the whole night and was their largest tent. I paid Secrets, but they rent them through a third party, so they only need about 72 hours notice to set up. \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>They put the black lamps up. I didn't request them or pay extra for them, so I'm assuming they are included in all the packages for beach weddings. \u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cora4600@yahoo.com","IpAddress":"205.173.217.10","GroupId":39,"GroupName":"Newbie","JoinDate":1380213689,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-273789.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":115,"PhotoType":"custom"},"FormattedName":"cora4600","Id":273789,"Name":"cora4600","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.87.42.110","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79475,"EditedBy":"<strong>Edited by JamaicaNicole, 07 August 2015 - 12:51 PM.<\/strong>","EditDate":1438980713,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e41c54eaaba17d9a985ebedd52b0512e","RawContent":"&lt;p&gt;Thank you so much for the feedback!&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1902107,"PostDate":1438980684,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thank you so much for the feedback!\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nicolechin4@yahoo.com","IpAddress":"68.87.42.110","GroupId":39,"GroupName":"Newbie","JoinDate":1407440509,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"JamaicaNicole","Id":279353,"Name":"JamaicaNicole","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"205.173.217.10","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79475,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bc904a296f83b2f685a8310806243814","RawContent":"&lt;p&gt;@[member=\"JamaicaNicole\"] No Problem! I totally understand, I was in your shoes too. There is almost nothing out there about Secrets weddings, so I was so lost! I&#039;m such a planner and it drove me crazy!&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We got married November 8, 2014. Weather was PERFECT! It was hot but we had a nice breeze, and it didn&#039;t rain on us. I will say that it almost always rained everyday we were there between 2pm and 4pm, so I was worried, but lucky for us, it skipped that day.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1902109,"PostDate":1438980860,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"279353\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/279353-jamaicanicole\/' title='Member profile'><span itemprop=\"name\">JamaicaNicole<\/span><\/a> No Problem! I totally understand, I was in your shoes too. There is almost nothing out there about Secrets weddings, so I was so lost! I'm such a planner and it drove me crazy!\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>We got married November 8, 2014. Weather was PERFECT! It was hot but we had a nice breeze, and it didn't rain on us. I will say that it almost always rained everyday we were there between 2pm and 4pm, so I was worried, but lucky for us, it skipped that day.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cora4600@yahoo.com","IpAddress":"205.173.217.10","GroupId":39,"GroupName":"Newbie","JoinDate":1380213689,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-273789.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":115,"PhotoType":"custom"},"FormattedName":"cora4600","Id":273789,"Name":"cora4600","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.87.42.110","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79475,"EditedBy":"<strong>Edited by JamaicaNicole, 07 August 2015 - 12:57 PM.<\/strong>","EditDate":1438981024,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"85fde5d5982e0f51b984b6f09beef65c","RawContent":"&lt;p&gt;One more question during the ceremony did you rent the sound system for music going down the aisle. If you did they play it for you or did you have to have someone you knew work it.&amp;nbsp;&lt;\/p&gt;\n\n&lt;p&gt;Awe that is awesome your pictures are beautiful!! I can not wait to our wedding and I am the same way I am a huge planner and they take a while to get back to me about things which drives me crazy!&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Oh also how was the food with the ultimate package.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1902110,"PostDate":1438980985,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>One more question during the ceremony did you rent the sound system for music going down the aisle. If you did they play it for you or did you have to have someone you knew work it.\u00a0<\/p>\n<br><p>Awe that is awesome your pictures are beautiful!! I can not wait to our wedding and I am the same way I am a huge planner and they take a while to get back to me about things which drives me crazy!\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Oh also how was the food with the ultimate package.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nicolechin4@yahoo.com","IpAddress":"68.87.42.110","GroupId":39,"GroupName":"Newbie","JoinDate":1407440509,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"JamaicaNicole","Id":279353,"Name":"JamaicaNicole","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"205.173.217.10","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79475,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"68a514dc613a66d50e550a3cd2175381","RawContent":"&lt;p&gt;@[member=\"JamaicaNicole\"] We did neither. I refused to pay $200 for 20 mins, when a DJ was $150 for a full hour. We just brought our Jambox and had a friend play music for us, easy peasy. What I didn&#039;t know until I got up to the alter was they had mic&#039;ed my husband so the guests could hear us. It was either that or the video peeps. Either way, it wasn&#039;t something I paid for, and a nice surprise.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1902112,"PostDate":1438981074,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"279353\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/279353-jamaicanicole\/' title='Member profile'><span itemprop=\"name\">JamaicaNicole<\/span><\/a> We did neither. I refused to pay $200 for 20 mins, when a DJ was $150 for a full hour. We just brought our Jambox and had a friend play music for us, easy peasy. What I didn't know until I got up to the alter was they had mic'ed my husband so the guests could hear us. It was either that or the video peeps. Either way, it wasn't something I paid for, and a nice surprise.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cora4600@yahoo.com","IpAddress":"205.173.217.10","GroupId":39,"GroupName":"Newbie","JoinDate":1380213689,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-273789.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":115,"PhotoType":"custom"},"FormattedName":"cora4600","Id":273789,"Name":"cora4600","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.87.42.110","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79475,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6dce6e1cb0b942798656dbd642302914","RawContent":"&lt;p&gt;I know it is absolutely ridiculous that a sound system to play your wedding music is not included. We were thinking about my the the pill xl speaker to play our music. Was the jambox loud enough where everyone to hear. Did you do that for the reception also or did you get a DJ. &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1902114,"PostDate":1438981212,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I know it is absolutely ridiculous that a sound system to play your wedding music is not included. We were thinking about my the the pill xl speaker to play our music. Was the jambox loud enough where everyone to hear. Did you do that for the reception also or did you get a DJ. \u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nicolechin4@yahoo.com","IpAddress":"68.87.42.110","GroupId":39,"GroupName":"Newbie","JoinDate":1407440509,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"JamaicaNicole","Id":279353,"Name":"JamaicaNicole","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"205.173.217.10","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79475,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7c044d8c7eda537eb712f23c6a352659","RawContent":"&lt;p&gt;@[member=\"JamaicaNicole\"] The food was actually really good. I mean it&#039;s still all inclusive food, so it wasn&#039;t gourmet dining, but definitely better then some of the restaurants we ate while we were there. In fact people are still raving about the mushroom soup that was served. I don&#039;t particularly like mushroom soup, but my husband does, do I picked it solely off that fact, but apparently it was the best some people have had. Who would have known?! So if you have the option, do the mushroom soup!&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1902116,"PostDate":1438981281,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"279353\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/279353-jamaicanicole\/' title='Member profile'><span itemprop=\"name\">JamaicaNicole<\/span><\/a> The food was actually really good. I mean it's still all inclusive food, so it wasn't gourmet dining, but definitely better then some of the restaurants we ate while we were there. In fact people are still raving about the mushroom soup that was served. I don't particularly like mushroom soup, but my husband does, do I picked it solely off that fact, but apparently it was the best some people have had. Who would have known?! So if you have the option, do the mushroom soup!\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cora4600@yahoo.com","IpAddress":"205.173.217.10","GroupId":39,"GroupName":"Newbie","JoinDate":1380213689,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-273789.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":115,"PhotoType":"custom"},"FormattedName":"cora4600","Id":273789,"Name":"cora4600","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.87.42.110","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79475,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d92fc2f0bb78b542e10a52c10ff22744","RawContent":"&lt;p&gt;Were your flowers an upgrade, if so were they expensive I want to upgrade mine to the blue and purple ones in the wedding planning guide but I am nervous on how much they will be and they will not give me any set prices for that until closer to the wedding.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1902118,"PostDate":1438981324,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Were your flowers an upgrade, if so were they expensive I want to upgrade mine to the blue and purple ones in the wedding planning guide but I am nervous on how much they will be and they will not give me any set prices for that until closer to the wedding.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nicolechin4@yahoo.com","IpAddress":"68.87.42.110","GroupId":39,"GroupName":"Newbie","JoinDate":1407440509,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"JamaicaNicole","Id":279353,"Name":"JamaicaNicole","IsOnline":false}}],"Id":"79475","Title":"Secrets Montego Bay Wedding W\/pics- Any Questions?","LastPostDate":1441336635},"Pages":{"TotalItems":37,"TotalPages":4,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":30},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
