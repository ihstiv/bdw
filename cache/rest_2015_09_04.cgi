DestinationGirl","Id":255973,"Name":"DestinationGirl","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":67731,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b0d24f8c536c49c5a0a692e9b5c25a28","RawContent":"&lt;p&gt; I think I&#039;m doing the coral &amp;amp; grey. I love the way they pair, might also throw some aqua in there :)&lt;\/p&gt;","Attachments":[],"Id":1664051,"PostDate":1347919545,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I think I'm doing the coral & grey. I love the way they pair, might also throw some aqua in there <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sometimeinoctober@gmail.com","IpAddress":"63.73.199.69","GroupId":39,"GroupName":"Newbie","JoinDate":1334673437,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-254151.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":260,"PhotoType":"custom"},"FormattedName":"shes2013","Id":254151,"Name":"shes2013","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":67731,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"9293ea414c5141da1c5d3fbe79ec541a","RawContent":"&lt;p id=\"user_yui_3_10_0_1_1374170187542_678\" style=\"margin: 0cm 0cm 0.0001pt; color: rgb(24, 24, 24); font-family: arial, helvetica, sans-serif; background-color: rgb(253, 252, 250); line-height: 13.5pt;\"&gt; &lt;span id=\"user_yui_3_10_0_1_1374170187542_763\" style=\"line-height: normal; font-size: 9pt; color: rgb(51, 51, 51);\"&gt;We are doing something a bit different then what I\u00e2\u20ac\u2122ve seen for a beach wedding.&amp;nbsp; We are doing PINK TONES AND GOLD.&amp;nbsp; We will also have some white accents.\n \n I absolutely love the palette and think it exudes luxury.&amp;nbsp; My FI is Indian so gold is very traditional they usually pair it with red but to give it a twist and also add my favorite colour we have decided to do pink.&amp;nbsp; But not just one colour of pink, a variety of pinks!&lt;\/span&gt;&lt;\/p&gt; &lt;p id=\"user_yui_3_10_0_1_1374170187542_765\" style=\"margin: 0cm 0cm 0.0001pt; color: rgb(24, 24, 24); font-family: arial, helvetica, sans-serif; background-color: rgb(253, 252, 250); line-height: 13.5pt;\"&gt; &lt;span style=\"line-height: normal; font-size: 9pt; color: rgb(51, 51, 51);\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;\/p&gt; &lt;p id=\"user_yui_3_10_0_1_1374170187542_681\" style=\"margin: 0cm 0cm 0.0001pt; color: rgb(24, 24, 24); font-family: arial, helvetica, sans-serif; background-color: rgb(253, 252, 250); line-height: 13.5pt;\"&gt; &lt;span id=\"user_yui_3_10_0_1_1374170187542_680\" style=\"line-height: normal; font-size: 9pt; color: rgb(51, 51, 51);\"&gt;I\u00e2\u20ac\u2122ve found a pink (blush) dress for my wedding dress so my bridesmaids are going to wear white or gold dresses (they are choosing their own dress)&lt;\/span&gt;&lt;\/p&gt; &lt;p id=\"user_yui_3_10_0_1_1374170187542_651\" style=\"margin: 0cm 0cm 0.0001pt; color: rgb(24, 24, 24); font-family: arial, helvetica, sans-serif; background-color: rgb(253, 252, 250); line-height: 13.5pt;\"&gt; &lt;span style=\"line-height: normal; font-size: 9pt; color: rgb(51, 51, 51);\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;\/p&gt; &lt;p id=\"user_yui_3_10_0_1_1374170187542_599\" style=\"margin: 0cm 0cm 0.0001pt; color: rgb(24, 24, 24); font-family: arial, helvetica, sans-serif; background-color: rgb(253, 252, 250); line-height: 13.5pt;\"&gt; &lt;span id=\"user_yui_3_10_0_1_1374170187542_649\" style=\"line-height: normal; font-size: 9pt; color: rgb(51, 51, 51);\"&gt;I just love that nothing about our wedding is going to be predictable!&amp;nbsp; What do you guys think?&amp;nbsp; I\u00e2\u20ac\u2122ve attached photos of my inspiration!&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p style=\"margin: 0cm 0cm 0.0001pt; color: rgb(24, 24, 24); font-family: arial, helvetica, sans-serif; background-color: rgb(253, 252, 250); line-height: 13.5pt;\"&gt; &amp;nbsp;&lt;\/p&gt; &lt;span huddler_attributes=\"{&amp;quot;plugin&amp;quot;:&amp;quot;attachment&amp;quot;,&amp;quot;params&amp;quot;:{&amp;quot;id&amp;quot;:&amp;quot;14160&amp;quot;,&amp;quot;name&amp;quot;:&amp;quot;Pink1.jpg&amp;quot;,&amp;quot;description&amp;quot;:&amp;quot;&amp;quot;,&amp;quot;size&amp;quot;:&amp;quot;68&amp;quot;,&amp;quot;type&amp;quot;:&amp;quot;jpg&amp;quot;}}\" huddler_plugin=\"attachment\"&gt;&amp;nbsp;&lt;\/span&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;span huddler_attributes=\"{&amp;quot;plugin&amp;quot;:&amp;quot;attachment&amp;quot;,&amp;quot;params&amp;quot;:{&amp;quot;id&amp;quot;:&amp;quot;14161&amp;quot;,&amp;quot;name&amp;quot;:&amp;quot;Pink2.jpg&amp;quot;,&amp;quot;description&amp;quot;:&amp;quot;&amp;quot;,&amp;quot;size&amp;quot;:&amp;quot;84&amp;quot;,&amp;quot;type&amp;quot;:&amp;quot;jpg&amp;quot;}}\" huddler_plugin=\"attachment\"&gt;&amp;nbsp;&lt;\/span&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;span huddler_attributes=\"{&amp;quot;plugin&amp;quot;:&amp;quot;attachment&amp;quot;,&amp;quot;params&amp;quot;:{&amp;quot;id&amp;quot;:&amp;quot;14162&amp;quot;,&amp;quot;name&amp;quot;:&amp;quot;Pink3.jpg&amp;quot;,&amp;quot;description&amp;quot;:&amp;quot;&amp;quot;,&amp;quot;size&amp;quot;:&amp;quot;62&amp;quot;,&amp;quot;type&amp;quot;:&amp;quot;jpg&amp;quot;}}\" huddler_plugin=\"attachment\"&gt;&amp;nbsp;&lt;\/span&gt;","Attachments":[{"Id":24875,"Name":"Pink1.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2013\/post-45026-13862252036.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2013\/post-45026-13862252036_thumb.jpg","Width":582,"Height":890},{"Id":24876,"Name":"Pink2.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2013\/post-45026-138622520367.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2013\/post-45026-138622520367_thumb.jpg","Width":736,"Height":694},{"Id":24877,"Name":"Pink3.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2013\/post-45026-138622520373.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2013\/post-45026-138622520373_thumb.jpg","Width":510,"Height":480}],"Id":1780137,"PostDate":1374157695,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p id=\"user_yui_3_10_0_1_1374170187542_678\"  style=\"margin: 0cm 0cm 0.0001pt;color: rgb(24, 24, 24);font-family: arial, helvetica, sans-serif;background-color: rgb(253, 252, 250)\"> <span id=\"user_yui_3_10_0_1_1374170187542_763\"  style=\"font-si