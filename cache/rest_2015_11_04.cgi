      <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"maryrjones007@outlook.com","IpAddress":"209.44.96.58","GroupId":39,"GroupName":"Newbie","JoinDate":1445303335,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-285135.jpg?_r=1445318516","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"mary007","Id":285135,"Name":"mary007","IsOnline":false}}],"Id":"79665","Title":"Packing Wedding Favours","LastPostDate":1445304569},"Pages":{"TotalItems":1,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":1,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
