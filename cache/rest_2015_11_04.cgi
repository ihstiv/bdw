\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"2ndTimeMrs","Id":284050,"Name":"2ndTimeMrs","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"32.214.84.114","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78217,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4f94848d82f2337f264d61a46367af20","RawContent":"These are awesome! Thanks for sharing your ideas.","Attachments":[],"Id":1906345,"PostDate":1444956132,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                These are awesome! Thanks for sharing your ideas.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rhonda3839@aol.com","IpAddress":"32.214.84.114","GroupId":39,"GroupName":"Newbie","JoinDate":1433621117,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283419.jpg?_r=1443402934","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"Rhonda3839","Id":283419,"Name":"Rhonda3839","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"209.44.96.58","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78217,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"98125a89050cef21f82fe09009504d48","RawContent":"&lt;p&gt;Wow.They look really amazing&lt;\/p&gt;","Attachments":[],"Id":1906588,"PostDate":1445304370,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Wow.They look really amazing<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"maryrjones007@outlook.com","IpAddress":"209.44.96.58","GroupId":39,"GroupName":"Newbie","JoinDate":1445303335,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-285135.jpg?_r=1445318516","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"mary007","Id":285135,"Name":"mary007","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.67.60.33","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78217,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bbabc582033e24a851504b9e9b776b25","RawContent":"&lt;p&gt;Incredible!! &amp;nbsp;Brilliant Job!!! &amp;nbsp;I know it&#039;s been a while since your wedding and this post but I&#039;m curious about 3 things:&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;* The actual items you put in each bag (pics hard to see all the details :-)&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;* The excel \"documentation\" that was created incase customs tried to stop you and charge you. &amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;* The Room key keeper?!? &amp;nbsp;Do you happen to have a link to where you got this and\/or what it looks like? &amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;m JUST getting to the gift bag planning phase of our April 2016 wedding and would LOVE any tips, tricks, ideas you can share about your experience.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;A #GratefulBridetoBe&amp;nbsp; :D&lt;\/p&gt;","Attachments":[],"Id":1906892,"PostDate":1445996133,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Incredible!! \u00a0Brilliant Job!!! \u00a0I know it's been a while since your wedding and this post but I'm curious about 3 things:<\/p>\n<p>\u00a0<\/p>\n<p>* The actual items you put in each bag (pics hard to see all the details :-)\u00a0<\/p>\n<p>* The excel \"documentation\" that was created incase customs tried to stop you and charge you. \u00a0<\/p>\n<p>* The Room key keeper?!? \u00a0Do you happen to have a link to where you got this and\/or what it looks like? \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I'm JUST getting to the gift bag planning phase of our April 2016 wedding and would LOVE any tips, tricks, ideas you can share about your experience.<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0A #GratefulBridetoBe\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/biggrin.png' class='bbc_emoticon' alt=':D' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jeffandshauna2015@gmail.com","IpAddress":"99.67.60.33","GroupId":39,"GroupName":"Newbie","JoinDate":1435385811,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283718.png?_r=1446004687","PhotoWidth":200,"PhotoHeight":152,"PhotoType":"custom"},"FormattedName":"SparkyM","Id":283718,"Name":"SparkyM","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.148.255.86","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78217,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"b6bdb55256a740ade9c01b76a35e9935","RawContent":"[quote name=\"SparkyM\" post=\"1906892\" timestamp=\"1446010533\"]\nIncredible!!  Brilliant Job!!!  I know it&#039;s been a while since your wedding and this post but I&#039;m curious about 3 things:\n\n* The actual items you put in each bag (pics hard to see all the details :-) \n* The excel \"documentation\" that was created incase customs tried to stop you and charge you.  \n* The Room key keeper?!?  Do you happen to have a link to where you got this and\/or what it looks like?  \n\nI&#039;m JUST getting to the gift bag planning phase of our April 2016 wedding and would LOVE any tips, tricks, ideas you can share about your experience.\n\n A #GratefulBridetoBe  :D[\/quote]Thank you so much!!  Let&#039;s see if I can answer your questions...\n1) Items in each bag: \n\nSan, Sun &amp;amp; Fun Kit - The Topper said \"For Better or For Worse.... San, Sun &amp;amp; Fun Kit.\" The items in it were two insect repellent spray pens with our logo on them, a deck of cards with a bride and groom and our names and date, aloe vera gel, sunscreen, two chapsticks with our logo on them and crayons for a coloring book I included in the main tote bag.\n\nSo Fresh &amp;amp; So Clean - The Topper say \"In Good Times and Bad....So Fresh and So Clean.\" The items were a lint roller, tic tacs with our logo on them, shout wipes, gum, hand sanitizer and tissues that say \"Tears of Joy, Tears of Laughter, Tears for Happily Ever After. Kelly &amp;amp; Trent and the date\".  \n\nWedding Weekend Survival Kit. The Topper Said \"In Sickness and In Health...Wedding Weekend Survival Kit\". Items in it were a Recovery Bag with alka seltzer, blowfish, advil, tylenol and pepto, and a Wedding Weekend Survival Kit with bandaids, gauze, etc. It&#039;s the Johnson &amp;amp; Johnson First Aid Kit. I made the labels that said \"Too much booze, too much sun, too much food and too much fun\" and it had the stick figures above those and our logo. \n\nThen in the main tote bag there was also a crossword puzzle that was about us, a koozie, the room key card holder that said \"To Have and To Hold Your Room Key and Money\" and our logo on one side and the other side had common words translated from English to Spanish. It also had a map of the resort with the areas where each event were, the coloring book and then the usual welcome letter, itineraries, social media info thing, Things to Do in Mexico thing. \n\n2) The excel document is somewhere on my old computer. I don&#039;t even know if I still have it. I basically just made a fake list of items and the cost. They didn&#039;t even check in my bags so I wouldn&#039;t worry about that. \n\n3) The room key holder I got from Amazon. The plastic holder part is here - [url=\"http:\/\/www.amazon.com\/gp\/product\/B000J09IH2?ref_=cm_sw_r_awd_bA68vb7BAZZVV\"]http:\/\/www.amazon.com\/gp\/product\/B000J09IH2?ref_=cm_sw_r_awd_bA68vb7BAZZVV[\/url]. And the coil for the wrist which I attached to them is here - [url=\"http:\/\/www.amazon.com\/gp\/product\/B00443T6RC?ref_=cm_sw_r_awd_-A68vb0CJPEJW.\"]http:\/\/www.amazon.com\/gp\/product\/B00443T6RC?ref_=cm_sw_r_awd_-A68vb0CJPEJW.[\/url] Then I made the insert.  \n\nGood luck!!! Let me know if you have any more questions. :)","Attachments":[],"Id":1906975,"PostDate":1446212368,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>SparkyM, on 28 October 2015 - 01:35 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Incredible!! \u00a0Brilliant Job!!! \u00a0I know it's been a while since your wedding and this post but I'm curious about 3 things:<\/p>\n<p>\u00a0<\/p>\n<p>* The actual items you put in each bag (pics hard to see all the details :-)\u00a0<\/p>\n<p>* The excel \"documentation\" that was created incase customs tried to stop you and charge you. \u00a0<\/p>\n<p>* The Room key keeper?!? \u00a0Do you happen to have a link to where you got this and\/or what it looks like? \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I'm JUST getting to the gift bag planning phase of our April 2016 wedding and would LOVE any tips, tricks, ideas you can share about your experience.<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0A #GratefulBridetoBe\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/biggrin.png' class='bbc_emoticon' alt=':D' \/><\/p>\n<\/div>\n<\/div><\/div>\n<p>Thank you so much!! \u00a0Let's see if I can answer your questions...<\/p>\n<p>1) Items in each bag:\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>San, Sun & Fun Kit - The Topper said \"For Better or For Worse.... San, Sun & Fun Kit.\" The items in it were two insect repellent spray pens with our logo on them, a deck of cards with a bride and groom and our names and date, aloe vera gel, sunscreen, two chapsticks with our logo on them and crayons for a coloring book I included in the main tote bag.<\/p>\n<p>\u00a0<\/p>\n<p>So Fresh & So Clean - The Topper say \"In Good Times and Bad....So Fresh and So Clean.\" The items were a lint roller, tic tacs with our logo on them, shout wipes, gum, hand sanitizer and tissues that say \"Tears of Joy, Tears of Laughter, Tears for Happily Ever After. Kelly & Trent and the date\". \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Wedding Weekend Survival Kit. The Topper Said \"In Sickness and In Health...Wedding Weekend Survival Kit\". Items in it were a Recovery Bag with alka seltzer, blowfish, advil, tylenol and pepto, and a Wedding Weekend Survival Kit with bandaids, gauze, etc. It's the Johnson & Johnson First Aid Kit. I made the labels that said \"Too much booze, too much sun, too much food and too much fun\" and it had the stick figures above those and our logo.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Then in the main tote bag there was also a crossword puzzle that was about us, a koozie, the room key card holder that said \"To Have and To Hold Your Room Key and Money\" and our logo on one side and the other side had common words translated from English to Spanish. It also had a map of the resort with the areas where each event were, the coloring book and then the usual welcome letter, itineraries, social media info thing, Things to Do in Mexico thing.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>2) The excel document is somewhere on my old computer. I don't even know if I still have it. I basically just made a fake list of items and the cost. They didn't even check in my bags so I wouldn't worry about that.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>3) The room key holder I got from Amazon. The plastic holder part is here -\u00a0<a href='http:\/\/www.amazon.com\/gp\/product\/B000J09IH2?ref_=cm_sw_r_awd_bA68vb7BAZZVV' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.amazon.co...d_bA68vb7BAZZVV<\/a>. And the coil for the wrist which I attached to them is here <a>-\u00a0http:\/\/www.amazon.com\/gp\/product\/B00443T6RC?ref_=cm_sw_r_awd_-A68vb0CJPEJW.<\/a> Then I made the insert.\u00a0 <\/p>\n<p>\u00a0<\/p>\n<p>Good luck!!! Let me know if you have any more questions. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br>\n\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Wedding Date: November 1, 2015<br>\nWedding Location: Azul Fives Hotel in Playa del Carmen<\/p>\n<p>Photographer: Photos in Cancun - Derek Campbell<br>\n<a data-ipb='nomediaparse' href='http:\/\/www.photosincancun.com'>http:\/\/www.photosincancun.com<\/a><\/p>\n<p>Decoration Rentals: Love & Lace Wedding Decor<br>\n<a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/loveandlacedecor'>https:\/\/www.facebook.com\/loveandlacedecor<\/a><\/p>\n<div>Wedding Photo Album: <a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/media\/set\/?set=a.10100809953124424.1073741834.18310150&type=1&l=581de87d2f'>https:\/\/www.facebook.com\/media\/set\/?set=a.10100809953124424.1073741834.18310150&type=1&l=581de87d2f<\/a><\/div>\n","Email":"khmciver@gmail.com","IpAddress":"108.223.176.224","GroupId":47,"GroupName":"Site Supporter","JoinDate":1386793154,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275598.jpg?_r=1426649427","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"kellymenning","Id":275598,"Name":"kellymenning","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.67.60.33","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78217,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"425daa9aa05dacaa8e7406a2b676d93d","RawContent":"[quote name=\"kellymenning\" post=\"1906975\" timestamp=\"1446226768\"]\nThank you so much!!  Let&#039;s see if I can answer your questions...\n1) Items in each bag: \n\nSan, Sun &amp;amp; Fun Kit - The Topper said \"For Better or For Worse.... San, Sun &amp;amp; Fun Kit.\" The items in it were two insect repellent spray pens with our logo on them, a deck of cards with a bride and groom and our names and date, aloe vera gel, sunscreen, two chapsticks with our logo on them and crayons for a coloring book I included in the main tote bag.\n\nSo Fresh &amp;amp; So Clean - The Topper say \"In Good Times and Bad....So Fresh and So Clean.\" The items were a lint roller, tic tacs with our logo on them, shout wipes, gum, hand sanitizer and tissues that say \"Tears of Joy, Tears of Laughter, Tears for Happily Ever After. Kelly &amp;amp; Trent and the date\".  \n\nWedding Weekend Survival Kit. The Topper Said \"In Sickness and In Health...Wedding Weekend Survival Kit\". Items in it were a Recovery Bag with alka seltzer, blowfish, advil, tylenol and pepto, and a Wedding Weekend Survival Kit with bandaids, gauze, etc. It&#039;s the Johnson &amp;amp; Johnson First Aid Kit. I made the labels that said \"Too much booze, too much sun, too much food and too much fun\" and it had the stick figures above those and our logo. \n\nThen in the main tote bag there was also a crossword puzzle that was about us, a koozie, the room key card holder that said \"To Have and To Hold Your Room Key and Money\" and our logo on one side and the other side had common words translated from English to Spanish. It also had a map of the resort with the areas where each event were, the coloring book and then the usual welcome letter, itineraries, social media info thing, Things to Do in Mexico thing. \n\n2) The excel document is somewhere on my old computer. I don&#039;t even know if I still have it. I basically just made a fake list of items and the cost. They didn&#039;t even check in my bags so I wouldn&#039;t worry about that. \n\n3) The room key holder I got from Amazon. The plastic holder part is here - [url=\"http:\/\/www.amazon.com\/gp\/product\/B000J09IH2?ref_=cm_sw_r_awd_bA68vb7BAZZVV\"]http:\/\/www.amazon.com\/gp\/product\/B000J09IH2?ref_=cm_sw_r_awd_bA68vb7BAZZVV[\/url]. And the coil for the wrist which I attached to them is here - [url=\"http:\/\/www.amazon.com\/gp\/product\/B00443T6RC?ref_=cm_sw_r_awd_-A68vb0CJPEJW.\"]http:\/\/www.amazon.com\/gp\/product\/B00443T6RC?ref_=cm_sw_r_awd_-A68vb0CJPEJW.[\/url] Then I made the insert. \n\nGood luck!!! Let me know if you have any more questions. :)\n[\/quote]This is Beyond Fantastic!!!  You Rock :-)  Thank you thank you thank you  :P","Attachments":[],"Id":1907034,"PostDate":1446469890,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>kellymenning, on 30 October 2015 - 01:39 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Thank you so much!! \u00a0Let's see if I can answer your questions...<\/p>\n<p>1) Items in each bag:\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>San, Sun & Fun Kit - The Topper said \"For Better or For Worse.... San, Sun & Fun Kit.\" The items in it were two insect repellent spray pens with our logo on them, a deck of cards with a bride and groom and our names and date, aloe vera gel, sunscreen, two chapsticks with our logo on them and crayons for a coloring book I included in the main tote bag.<\/p>\n<p>\u00a0<\/p>\n<p>So Fresh & So Clean - The Topper say \"In Good Times and Bad....So Fresh and So Clean.\" The items were a lint roller, tic tacs with our logo on them, shout wipes, gum, hand sanitizer and tissues that say \"Tears of Joy, Tears of Laughter, Tears for Happily Ever After. Kelly & Trent and the date\". \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Wedding Weekend Survival Kit. The Topper Said \"In Sickness and In Health...Wedding Weekend Survival Kit\". Items in it were a Recovery Bag with alka seltzer, blowfish, advil, tylenol and pepto, and a Wedding Weekend Survival Kit with bandaids, gauze, etc. It's the Johnson & Johnson First Aid Kit. I made the labels that said \"Too much booze, too much sun, too much food and too much fun\" and it had the stick figures above those and our logo.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Then in the main tote bag there was also a crossword puzzle that was about us, a koozie, the room key card holder that said \"To Have and To Hold Your Room Key and Money\" and our logo on one side and the other side had common words translated from English to Spanish. It also had a map of the resort with the areas where each event were, the coloring book and then the usual welcome letter, itineraries, social media info thing, Things to Do in Mexico thing.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>2) The excel document is somewhere on my old computer. I don't even know if I still have it. I basically just made a fake list of items and the cost. They didn't even check in my bags so I wouldn't worry about that.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>3) The room key holder I got from Amazon. The plastic holder part is here -\u00a0<a href='http:\/\/www.amazon.com\/gp\/product\/B000J09IH2?ref_=cm_sw_r_awd_bA68vb7BAZZVV' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.amazon.co...d_bA68vb7BAZZVV<\/a>. And the coil for the wrist which I attached to them is here <a>-\u00a0http:\/\/www.amazon.com\/gp\/product\/B00443T6RC?ref_=cm_sw_r_awd_-A68vb0CJPEJW.<\/a> Then I made the insert.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Good luck!!! Let me know if you have any more questions. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br>\n\u00a0<\/p>\n<\/div>\n<\/div><\/div>\n<p>This is Beyond Fantastic!!! \u00a0You Rock :-) \u00a0Thank you thank you thank you\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/tongue.png' class='bbc_emoticon' alt=':P' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jeffandshauna2015@gmail.com","IpAddress":"99.67.60.33","GroupId":39,"GroupName":"Newbie","JoinDate":1435385811,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283718.png?_r=1446004687","PhotoWidth":200,"PhotoHeight":152,"PhotoType":"custom"},"FormattedName":"SparkyM","Id":283718,"Name":"SparkyM","IsOnline":true}}],"Pages":{"TotalItems":68,"TotalPages":7,"CurrentPage":60,"NextPage":-1,"PreviousPage":50,"LastPage":60},"PushNotifications":[{"Key":"notifications","Value":1,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
