{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":4,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":85,"MovedTo":null,"MovedOn":0,"FirstPostId":1907184,"Rating":0,"RatingHits":0,"Starter":{"Id":285229,"Name":"KimmSullivan","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-285229.jpg?_r=1446927630","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"StartDate":1446762504,"LastPoster":{"Id":232000,"Name":"acw271011","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1907184,"PostDate":1446762504,"PostContent":"Hi All!  I am from Ontario and I have been planning my wedding for close to a year now.  In the f...","Author":{"Signature":"","Email":"kimmmakesmoney@hotmail.com","IpAddress":"47.54.53.70","GroupId":39,"GroupName":"Newbie","JoinDate":1446506255,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-285229.jpg?_r=1446927630","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"KimmSullivan","Id":285229,"Name":"KimmSullivan","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"47.54.53.70","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79712,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5fd120bae55062bc90a2ecde8865a7e5","RawContent":"Hi All! \n\n\nI am from Ontario and I have been planning my wedding for close to a year now.  In the final stages... \n\nAlmost have all my OOT bags done.  :)\n\nSo excited to get this done! Lol\n\n\nKimm :)","Attachments":[],"Id":1907184,"PostDate":1446762504,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi All! <br><br>\nI am from Ontario and I have been planning my wedding for close to a year now.  In the final stages... <br>\nAlmost have all my OOT bags done.  <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br>\nSo excited to get this done! Lol<br><br>\nKimm <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kimmmakesmoney@hotmail.com","IpAddress":"47.54.53.70","GroupId":39,"GroupName":"Newbie","JoinDate":1446506255,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-285229.jpg?_r=1446927630","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"KimmSullivan","Id":285229,"Name":"KimmSullivan","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.146.146.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79712,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"47c55728f77f6669cfd5361b7d09526f","RawContent":"Welcome and congrats. Not many Puerto Plata brides here so that&#039;s awesome you are one!!! Lots of Canadians though :) good luck with your wedding. \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1907201,"PostDate":1446808538,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Welcome and congrats. Not many Puerto Plata brides here so that's awesome you are one!!! Lots of Canadians though <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> good luck with your wedding. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"190.166.34.208","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79712,"EditedBy":"<strong>Edited by Moments That Matter, Yesterday, 11:22 AM.<\/strong>","EditDate":1446808922,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"35ebe1913cbe67510f05231e3e610f81","RawContent":"&lt;p&gt;Welcome Kimm, and Congrats on your DR wedding in Jan!!! You&#039;ve come to the right place for lots of great info, advice, suggestions and support in finding the answers to the rest of your planning questions - so well done :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;The DR is a gorgeous destination, and Jan is perfect - in terms of great temps and timing!&lt;\/p&gt;\n&lt;p&gt;To ramp up your creativity even more, here are some magical wedding moments that matter we captured in our beautiful Mayan Riviera - with very similar climate and lush tropical vegetation as the DR.......Enjoy!!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;....taken from our&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10150344652834487.362195.18683524486&amp;amp;type=3&#039;&gt; Timeline Photo Album:&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xtf1\/t31.0-8\/11249771_10153726882474487_2556243875033153344_o.jpg\" alt=\"11249771_10153726882474487_2556243875033\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xpf1\/t31.0-8\/12194594_10153720511309487_8212918459677470835_o.jpg\" alt=\"12194594_10153720511309487_8212918459677\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xpf1\/t31.0-8\/12027120_10153678336099487_4242342793019899157_o.jpg\" alt=\"12027120_10153678336099487_4242342793019\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Wishing you happy research, and all the best with the rest of your plans - cheers!!! team MTM :)&lt;\/p&gt;","Attachments":[],"Id":1907202,"PostDate":1446808856,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome Kimm, and Congrats on your DR wedding in Jan!!! You've come to the right place for lots of great info, advice, suggestions and support in finding the answers to the rest of your planning questions - so well done <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>The DR is a gorgeous destination, and Jan is perfect - in terms of great temps and timing!<\/p>\n<p>To ramp up your creativity even more, here are some magical wedding moments that matter we captured in our beautiful Mayan Riviera - with very similar climate and lush tropical vegetation as the DR.......Enjoy!!!<\/p>\n<p>\u00a0<\/p>\n<p>....taken from our<a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10150344652834487.362195.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'> Timeline Photo Album:<\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xtf1\/t31.0-8\/11249771_10153726882474487_2556243875033153344_o.jpg\" alt=\"11249771_10153726882474487_2556243875033\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xpf1\/t31.0-8\/12194594_10153720511309487_8212918459677470835_o.jpg\" alt=\"12194594_10153720511309487_8212918459677\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xpf1\/t31.0-8\/12027120_10153678336099487_4242342793019899157_o.jpg\" alt=\"12027120_10153678336099487_4242342793019\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>Wishing you happy research, and all the best with the rest of your plans - cheers!!! team MTM <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280196260,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.42.38","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79712,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d85fa84060f15ed03ed9f1c24f3a73a6","RawContent":"&lt;p&gt;Congrats and welcome! Your wedding date is getting very close! Hope the planning is going well. If you can, post some picks of your OOT bags. The ladies love to see photos (me included)!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck! Lots of DR brides but I&#039;ve never seen any for Puerto Plata. I hope you post a review after your wedding. It&#039;s good info for future brides.&lt;\/p&gt;","Attachments":[],"Id":1907224,"PostDate":1446859976,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats and welcome! Your wedding date is getting very close! Hope the planning is going well. If you can, post some picks of your OOT bags. The ladies love to see photos (me included)!<\/p>\n<p>\u00a0<\/p>\n<p>Good luck! Lots of DR brides but I've never seen any for Puerto Plata. I hope you post a review after your wedding. It's good info for future brides.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><em><span style=\"color:rgb(51,153,255);\">I'm lucky enough to\u00a0tell my husband how much I love him and say yes again\u00a0on October 20, 2015 at Grand Coral Beach Club!\u00a0<\/span><\/em>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}}],"Id":"79712","Title":"Newbie - Cofresi Palm Beach, Puerto Plata - Jan 2016","LastPostDate":1446859976},"Pages":{"TotalItems":4,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":1,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
