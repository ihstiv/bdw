{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":1,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":272,"MovedTo":null,"MovedOn":0,"FirstPostId":1917107,"Rating":0,"RatingHits":0,"Starter":{"Id":288359,"Name":"CMojica","Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-288359.jpg?_r=1486396221","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"StartDate":1485200118,"LastPoster":{"Id":288359,"Name":"CMojica","Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-288359.jpg?_r=1486396221","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":38,"Preview":{"Id":1917107,"PostDate":1485200118,"PostContent":"If you're looking for a photographer for your Los Cabos wedding, please highly consider Juan Carl...","Author":{"Signature":"","Email":"cmojica22@hotmail.com","IpAddress":"137.229.153.93","GroupId":39,"GroupName":"Newbie","JoinDate":1485199313,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-288359.jpg?_r=1486396221","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"CMojica","Id":288359,"Name":"CMojica","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"137.229.153.93","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80925,"EditedBy":"<strong>Edited by CMojica, 23 January 2017 - 11:37 AM.<\/strong>","EditDate":1485200229,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a287ff82aa9a2bb1dee93a553d2c736e","RawContent":"&lt;p&gt;If you&#039;re looking for a photographer for your Los Cabos wedding, please highly consider Juan Carlos Tapia. I first heard his name from a makeup artist and while searching for a pre-wedding dinner location, I found that Juan Carlos Tapia took the photos of the restaurant. I contacted him via email and we were able to connect, reserve the date, etc. very easily. He was also gracious in taking the photo shots&amp;nbsp;we requested. We ABSOLUTELY loved our wedding photos! Juan did an amazing job!&amp;nbsp;A wedding&amp;nbsp;is a&amp;nbsp;celebration you cannot get back and you&amp;nbsp;should have&amp;nbsp;quality photos to remind you of that special day! So please check out...&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;www.juancarlostapia.com&lt;\/p&gt;","Attachments":[{"Id":36596,"Name":"PB301554 revised.jpg","Url":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/monthly_01_2017\/post-288359-0-15885300-1485196459.jpg","ScaledUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/monthly_01_2017\/post-288359-0-15885300-1485196459_thumb.jpg","Width":1000,"Height":750}],"Id":1917107,"PostDate":1485200118,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>If you're looking for a photographer for your Los Cabos wedding, please highly consider Juan Carlos Tapia. I first heard his name from a makeup artist and while searching for a pre-wedding dinner location, I found that Juan Carlos Tapia took the photos of the restaurant. I contacted him via email and we were able to connect, reserve the date, etc. very easily. He was also gracious in taking the photo shots\u00a0we requested. We ABSOLUTELY loved our wedding photos! Juan did an amazing job!\u00a0A wedding\u00a0is a\u00a0celebration you cannot get back and you\u00a0should have\u00a0quality photos to remind you of that special day! So please check out...<\/p>\n<p>\u00a0<\/p>\n<p>www.juancarlostapia.com<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cmojica22@hotmail.com","IpAddress":"137.229.153.93","GroupId":39,"GroupName":"Newbie","JoinDate":1485199313,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-288359.jpg?_r=1486396221","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"CMojica","Id":288359,"Name":"CMojica","IsOnline":false}}],"Id":"80925","Title":"Photographer For Cabo Weddings","LastPostDate":1485200118},"Pages":{"TotalItems":1,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
