{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":94,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":11128,"MovedTo":null,"MovedOn":0,"FirstPostId":1564893,"Rating":0,"RatingHits":0,"Starter":{"Id":246920,"Name":"riusantefebride","Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-246920.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"IsOnline":false},"StartDate":1325909496,"LastPoster":{"Id":285022,"Name":"Lilako10","Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-285022.jpg?_r=1445709424","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":38,"Preview":{"Id":1906066,"PostDate":1444329861,"PostContent":"Hello everyone. My fiance and i will be getting married at the riu santa fe in january of 2016. I...","Author":{"Signature":"","Email":"lindsey_alexay@hotmail.com","IpAddress":"207.161.64.62","GroupId":39,"GroupName":"Newbie","JoinDate":1444092625,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-285022.jpg?_r=1445709424","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"Lilako10","Id":285022,"Name":"Lilako10","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":65148,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"04f82fe68815f331dbdc27e8928f52ac","RawContent":"Suzanne Morel does eyelash extensions I believe.","Attachments":[],"Id":1796496,"PostDate":1377970456,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Suzanne Morel does eyelash extensions I believe.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"golden_011@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1358152522,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-264394.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"golden011","Id":264394,"Name":"golden011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":65148,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7c00d5106d88f5107357a70ea072b67c","RawContent":"[quote name=\"golden011\"]\nHey, So I am getting married 12 nov 2013, so it&#039;s comin up quickly!! I am looking into where to get my hair and makeup done along with my bridesmaids. I have heard the spa on the resort is not so good and there was a place in town, where is the place in town and how do you get a hold of them? Thanks!!![\/quote] I was married at the Santa Fe in January of this year and used Suzanne Morel&#039;s salon (suzannemorel.com). I would highly, HIGHLY recommend them. My hair and makeup turned out even better than I could have imagined. I had originally booked the salon at the resort, but after going for my trial 2 days before, I was so disappointed and devastated with the result. I ended up emailing Suzanne Morel, and she contacted the resort to find my room to speak with me directly. Luckily, she was able to fit me in on the wedding day. It is only about an 8 minute taxi ride from the resort, and I had the salon talk to reception at the resort to give directions to the taxi driver (although everyone seemed to know where the salon was located). It really did not cost that much more than the resort salon, especially when you factor in the obvious difference in quality of services, and level of expertise. Please let me know i you have any other questions and I would be happy ro help. Good luck with the rest of your planning!","Attachments":[],"Id":1796620,"PostDate":1378069370,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <blockquote class='ipsBlockquote' data-author=\"golden011\" url=\"\/t\/77416\/2012&#045;riu&#045;sante&#045;fe&#045;brides\/70#post_1913683\"><p>Hey, So I am getting married 12 nov 2013, so it's comin up quickly!! I am looking into where to get my hair and makeup done along with my bridesmaids. I have heard the spa on the resort is not so good and there was a place in town, where is the place in town and how do you get a hold of them? Thanks!!!<\/p><\/blockquote> I was married at the Santa Fe in January of this year and used Suzanne Morel's salon (suzannemorel.com). I would highly, HIGHLY recommend them. My hair and makeup turned out even better than I could have imagined. I had originally booked the salon at the resort, but after going for my trial 2 days before, I was so disappointed and devastated with the result. I ended up emailing Suzanne Morel, and she contacted the resort to find my room to speak with me directly. Luckily, she was able to fit me in on the wedding day. It is only about an 8 minute taxi ride from the resort, and I had the salon talk to reception at the resort to give directions to the taxi driver (although everyone seemed to know where the salon was located). It really did not cost that much more than the resort salon, especially when you factor in the obvious difference in quality of services, and level of expertise. Please let me know i you have any other questions and I would be happy ro help. Good luck with the rest of your planning!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kerri.rouleau9@gmail.com","IpAddress":"72.38.1.64","GroupId":39,"GroupName":"Newbie","JoinDate":1337822010,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-255764.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"kerri85","Id":255764,"Name":"kerri85","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":65148,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b505c190cb7dfe1c411aa8bc743a4392","RawContent":"&lt;p&gt; Hey all you super helpful ladies!! I&#039;m getting married on 10\/4\/13 and I&#039;ve read that a lot of you have gotten your flowers\/bridesmaids bouquets at Costco. &amp;nbsp;How early before the wedding do you have to select them for them to be ready? Also, do they have a big variety?&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Thanks again in advance!&lt;\/p&gt;","Attachments":[],"Id":1796679,"PostDate":1378094553,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hey all you super helpful ladies!! I'm getting married on 10\/4\/13 and I've read that a lot of you have gotten your flowers\/bridesmaids bouquets at Costco. \u00a0How early before the wedding do you have to select them for them to be ready? Also, do they have a big variety?<\/p> <p> \u00a0<\/p> <p> Thanks again in advance!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sandyloo117@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1351251446,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-261789.jpeg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"sandyloo117","Id":261789,"Name":"sandyloo117","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"209.202.4.164","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":65148,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5d382c5775ba094153aa464abf1d10c3","RawContent":"Hello everyone. My fiance and i will be getting married at the riu santa fe in january of 2016. I am patiently waiting for thw information package from them but have not received any response. I was wondering if any information that they could send me. We got the caprice package. If you could email me any information that you have that would be awesome! My email is lindsey_alexay@hotmail.com. thanks!!","Attachments":[],"Id":1906066,"PostDate":1444329861,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hello everyone. My fiance and i will be getting married at the riu santa fe in january of 2016. I am patiently waiting for thw information package from them but have not received any response. I was wondering if any information that they could send me. We got the caprice package. If you could email me any information that you have that would be awesome! My email is lindsey_alexay@hotmail.com. thanks!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lindsey_alexay@hotmail.com","IpAddress":"207.161.64.62","GroupId":39,"GroupName":"Newbie","JoinDate":1444092625,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-285022.jpg?_r=1445709424","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"Lilako10","Id":285022,"Name":"Lilako10","IsOnline":false}}],"Id":"65148","Title":"2012 Riu Sante Fe Brides","LastPostDate":1444329861},"Pages":{"TotalItems":94,"TotalPages":10,"CurrentPage":90,"NextPage":-1,"PreviousPage":80,"LastPage":90},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
