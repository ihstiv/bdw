destinationwedding.com\/index.phpuser\/281478-perianjay\/' title='Member profile'><span itemprop=\"name\">perianjay<\/span><\/a> that does mean I'll still be at work. Maybe I should leave early lol\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"My planning thread: <a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/79425-wafflesmom-moon-palace-planning-thread-january-23-2016\/\">http:\/\/www.bestdestinationwedding.com\/topic\/79425-wafflesmom-moon-palace-planning-thread-january-23-2016\/<\/a><br><br>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;4;484\/st\/20160123\/e\/Our+Wedding\/dt\/-2\/k\/44c5\/event.png\" alt=\"event.png\"><\/a>","Email":"jerilee.valenzuela@shaw.ca","IpAddress":"24.114.26.77","GroupId":3,"GroupName":"Member","JoinDate":1410084185,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279721.jpg?_r=1431039162","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Wafflesmom","Id":279721,"Name":"Wafflesmom","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.49.243.226","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79202,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":4,"IsLiked":true,"PostKey":"98f86f5aa46e496211aa4aac732c912c","RawContent":"&lt;p&gt;ladies I&#039;m heading over to O&amp;amp;B. I ended up working from home today so I&#039;m leaving now! :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;ll be the one in the black and white polka dot top (this sounds like I&#039;m on my way to a blind date) :P&lt;\/p&gt;","Attachments":[],"Id":1902546,"PostDate":1439568882,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>ladies I'm heading over to O&B. I ended up working from home today so I'm leaving now! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>I'll be the one in the black and white polka dot top (this sounds like I'm on my way to a blind date) <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/tongue.png' class='bbc_emoticon' alt=':P' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>My planning thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78916-snswedding2016-planning-thread-jan-9-2016-azul-fives\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78916-snswedding2016-planning-thread-jan-9-2016-azul-fives\/<\/a><\/p>\n<p>\u00a0<\/p>\n<div><a class='bbc_url' href='http:\/\/www.TickerFactory.com\/'><\/div>\n<div><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10730;0\/st\/20160109\/e\/Our+Wedding\/k\/9fa9\/event.png\" alt=\"event.png\"><\/div>\n<div><\/a><\/div>\n","Email":"sean.n.steph2016@gmail.com","IpAddress":"74.12.52.42","GroupId":40,"GroupName":"Jr. Member","JoinDate":1415533111,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281055.jpg?_r=1415590512","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"snswedding2016","Id":281055,"Name":"snswedding2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.207.201.18","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDel