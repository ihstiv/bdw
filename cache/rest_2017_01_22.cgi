finder.com\/data\/icons\/free-social-icons\/67\/twitter_circle_color-20.png\" alt=\"twitter_circle_color-20.png\"><\/a>\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.twitter.com\/WeddingDayStory'>Follow Us on Twitter<\/a><\/p>\n<p><span style=\"font-size:12px;\"><a data-ipb='nomediaparse' href='http:\/\/www.pinterest.com\/WeddingDayStory'><img src=\"https:\/\/ci3.googleusercontent.com\/proxy\/glAA6LOTxAKNN-UBWmQK8Xhf1S1UWklxsl-P151ZqApvRLXxEve692AoWIg1Ovkr7ChUpg-UGA7prQFa83wWZNbvF6-EfXDfa482daVmplpp3mbHXjOMAG2JDZAObzQTE1mFxzgeWdV4vkLWXvInmyHLlY-0JXmsYC6R4ToKwVSQDsZOuu8=s0-d-e1-ft#http:\/\/i1054.photobucket.com\/albums\/s495\/weddingdaystory\/Transparent-Pinterest-Logo-Icon-660x660_zpscrfyjxqm.png\" alt=\"Transparent-Pinterest-Logo-Icon-660x660_\"><\/a>\u00a0<\/span><a data-ipb='nomediaparse' href='https:\/\/es.pinterest.com\/weddingdaystory\/'>Follow Our Pinterest Boards For Destination Wedding Inspiration<\/a><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.weddingwire.com\/reviews\/weddingdaystory-playa-del-carmen-guanacaste\/a22bb30fa39d365c.html'><img src=\"https:\/\/ci4.googleusercontent.com\/proxy\/Yn8ddso_hGdrAOxFk0Zr2iPASI0Zf2mQmXGnilQfDqIhUWXveEKq4WVegJEZRBkWN8OdepvzwiyU5CXXSuIGpLjZp5sIj1x_fVQaWblobBC1KpwPogokAH4gHd56anNO0lfoarqq3ahajmY=s0-d-e1-ft#http:\/\/i1042.photobucket.com\/albums\/b425\/Macky_Garcia\/WW_zpssx812lgw.png?t=1448898098\" alt=\"WW_zpssx812lgw.png?t=1448898098\">Read Our #WeddingDayStoryCouples Rave<\/a><\/p>\n<p><a data-ipb='nomediaparse' href='https:\/\/www.linkedin.com\/company\/weddingdaystory'><img src=\"https:\/\/ci4.googleusercontent.com\/proxy\/TgfKCWnrqjAdFkF1u1HLssLiSur_iZGjmMLyrzdhfDL8SIuxweTCVlTuAZDJ1eHujXOiJClqqY4Wj3-RgkRBc8v8fvn-52xdcngb7E6GsyJjfErN_nogFD07qKQSMbchiP8mQg=s0-d-e1-ft#http:\/\/i1042.photobucket.com\/albums\/b425\/Macky_Garcia\/linkedin_zpsji7hbqld.png\" alt=\"linkedin_zpsji7hbqld.png\"><\/a><span style=\"font-size:12px;\">\u00a0<\/span><a data-ipb='nomediaparse' href='https:\/\/www.linkedin.com\/company\/weddingdaystory'>Find Us on Linkedin<\/a><\/p>\n<p>\u00a0<\/p>\n<p><span style=\"font-size:12px;\">Office (MX): +52 984 148 8653 \u00a0<\/span><span style=\"color:rgb(153,153,153);font-family:Arial, Helvetica, sans-serif;font-size:11px;\">\u00b7\u00a0<\/span><span style=\"font-size:12px;\">\u00a0<\/span><span style=\"font-size:12px;\">Skype: WeddingDayStoryPhotoVideo<\/span><\/p>\n<p><b>Latest on the blog!\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.weddingdaystory.com\/blog\/2016\/05\/25\/4781\/unique-riviera-maya-wedding\/'>Adventurous & Unique Riviera Maya Wedding Ideas<\/a><\/b><\/p>\n<p style=\"font-family:Arial, Helvetica, sans-serif;font-size:10px;\"><b><a data-ipb='nomediaparse' href='http:\/\/www.weddingdaystory.com\/blog\/2016\/05\/19\/4722\/best-etsy-wedding-shops-beach-weddings-1\/'>Best Etsy Wedding Shops For Beach Wedding Goodies<\/a><\/b><\/p>\n<p style=\"font-family:Arial, Helvetica, sans-serif;font-size:10px;\">\u00a0<img src=\"https:\/\/ci6.googleusercontent.com\/proxy\/IC58KLPvjx5qiFte9UCG8NlhvcBdgOzn0K4IOlwBSmkbzmLneMh7qISqOeNo8VadocIGTEm5ckJxfNvPI-1Ao1gcjrfbj3q5r2X_oDgmUJS1HwuGEwS_JKE8VP2LvORLKw=s0-d-e1-ft#http:\/\/i1042.photobucket.com\/albums\/b425\/Macky_Garcia\/Firma_zpsl6xjfcjx.jpg\" alt=\"Firma_zpsl6xjfcjx.jpg\"><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='mailto:info@weddingdaystory.com?subject=Please%20send%20me%20information%20on%20your%20wedding%20photography%20packages'>info@weddingdaystory.com<\/a> <a data-ipb='nomediaparse' href='http:\/\/www.weddingdaystory.com\/blog'>www.weddingdaystory.com\/blog<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p style=\"font-family:arial, helvetica, sans-serif;color:rgb(164,164,164);\">\u00a0","Email":"info@weddingdaystory.com","IpAddress":"187.185.71.174","GroupId":49,"GroupName":"Insiders","JoinDate":1429741888,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-282827.jpg?_r=1431453768","PhotoWidth":200,"PhotoHeight":161,"PhotoType":"custom"},"FormattedName":"WeddingDayStory","Id":282827,"Name":"WeddingDayStory","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":48153,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cc9a96c376eabbd5e1b744488a49419d","RawContent":"If I am getting married in Turks &amp;amp; Caicos, how do I go about getting my marriage legally recognized in the US? Do I need to take the paperwork somewhere? Anyone have a clue? I live in New York City. Thanks! :)","Attachments":[],"Id":1028389,"PostDate":1265745195,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                If I am getting married in Turks & Caicos, how do I go about getting my marriage legally recognized in the US? Do I need to take the paperwork somewhere? Anyone have a clue? I live in New York City. Thanks! <img src='https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"anne_zink@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1264208497,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-224959.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"PandaNYC","Id":224959,"Name":"PandaNYC","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":48153,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"5929ee22bbb4addea78703cdba134a22","RawContent":"Hi Panda it is my understanding that marriages performed outside of the US are legally binding and recognized within the US by presenting you certificate of marriage. You will be given a certificate of marriage in TC which you can then register here in the US or not. I know that here in Miami I can register mine at the County Clerk&#039;s office but not sure what the procedures are in NY. I did a bit of a search and I think that if you try contacting the Marriage Bureau at the Office of the City Clerk for New York City they may be able to answer any questions you may have. If you live outside of the five boroughs the phone number is 212-NEW-YORK. If you live within the boroughs simply dial 311.\n Here is a link to their website &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.cityclerk.nyc.gov\/html\/marriage\/marriage_bureau.shtml\"&gt;City Clerk&#039;s Office - Marriage Bureau&lt;\/a&gt;\n \n I hope you find all the info you need. Good Luck!","Attachments":[],"Id":1029503,"PostDate":1265777059,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi Panda it is my understanding that marriages performed outside of the US are legally binding and recognized within the US by presenting you certificate of marriage. You will be given a certificate of marriage in TC which you can then register here in the US or not. I know that here in Miami I can register mine at the County Clerk's office but not sure what the procedures are in NY. I did a bit of a search and I think that if you try contacting the Marriage Bureau at the Office of the City Clerk for New York City they may be able to answer any questions you may have. If you live outside of the five boroughs the phone number is 212-NEW-YORK. If you live within the boroughs simply dial 311.<br \/> Here is a link to their website <a href='http:\/\/www.cityclerk.nyc.gov\/html\/marriage\/marriage_bureau.shtml' class='bbc_url' title='External link' rel='nofollow external'>City Clerk's Office - Marriage Bureau<\/a><br \/> <br \/> I hope you find all the info you need. Good Luck!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"janinelatkinson@gmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1263768922,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-224781.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"JanineA","Id":224781,"Name":"JanineA","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":48153,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1ca7ec0f967a8e0bcb9958f8719d6edf","RawContent":"The reason I said you can register it or not is because in Miami you have the option also of not registering and simply presenting your TC marriage certificate whenever asked for it. Of course with the growing suspicion of most agencies it is advisable that you register it and use the US registered copy to do any name changes etc. Once it has an official govt seal from the issuing country, in this case TC it is usually not questioned though. New York may not share the same policy as I have found NY and DC to always be a bit stricter in policy.","Attachments":[],"Id":1029507,"PostDate":1265777170,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                The reason I said you can register it or not is because in Miami you have the option also of not registering and simply presenting your TC marriage certificate whenever asked for it. Of course with the growing suspicion of most agencies it is advisable that you register it and use the US registered copy to do any name changes etc. Once it has an official govt seal from the issuing country, in this case TC it is usually not questioned though. New York may not share the same policy as I have found NY and DC to always be a bit stricter in policy.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"janinelatkinson@gmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1263768922,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-224781.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"JanineA","Id":224781,"Name":"JanineA","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":48153,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"96442b82f876124a424cac6b9e7817f2","RawContent":"I was able to do everything in NY with my St. Lucia marriage certificate. It&#039;ll be recognized, no need to worry about it.","Attachments":[],"Id":1031576,"PostDate":1265936156,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I was able to do everything in NY with my St. Lucia marriage certificate. It'll be recognized, no need to worry about it.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<a class='bbc_url' href='http:\/\/www.klkphotography-clients.com\/slideshows\/Kristy_Chris_WED'>Wedding slideshow by KLK Photography<\/a><br \/>\n<a class='bbc_url' href='http:\/\/www.klkphotography-clients.com\/slideshows\/Kristy_Chris_TTD'>TTD slideshow by KLK Photography<\/a>","Email":"froggie1013@hotmail.com","IpAddress":"174.232.197.88","GroupId":46,"GroupName":"VIP Member","JoinDate":1203022080,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-208549.jpg?_r=0","PhotoWidth":200,"PhotoHeight":192,"PhotoType":"custom"},"FormattedName":"Kristy!","Id":208549,"Name":"Kristy!","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":48153,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"238f74546eec6b9420a7c44dedc72a57","RawContent":"&lt;p&gt; Thank you for asking this question, I was about to ask it. We are getting married in Antigua.&lt;\/p&gt; &lt;p&gt;  &lt;\/p&gt; &lt;p&gt; Thanks Ladies.&lt;\/p&gt;","Attachments":[],"Id":1252183,"PostDate":1281655742,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Thank you for asking this question, I was about to ask it. We are getting married in Antigua.<\/p> <p> \u00a0<\/p> <p> Thanks Ladies.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"capt2bspv@aol.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1277318766,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-229464.jpg?_r=0","PhotoWidth":90,"PhotoHeight":72,"PhotoType":"custom"},"FormattedName":"capt2bspv","Id":229464,"Name":"capt2bspv","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":48153,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8a7ae38c1e231449a4158a4f39531cf0","RawContent":"&lt;p&gt; I live in PA &amp;amp; got married in T&amp;amp;C but when I got back &amp;amp; called our County Clerk they informed me we didn&#039;t need to do anything.&amp;nbsp; To change everything over we just showed our T&amp;amp;C marriage license.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1261963,"PostDate":1282482885,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I live in PA & got married in T&C but when I got back & called our County Clerk they informed me we didn't need to do anything.\u00a0 To change everything over we just showed our T&C marriage license.\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Chrissy & Jeremiah's Blog with Pictures...<\/span><br><br><a data-ipb='nomediaparse' href=\"http:\/\/www.brilliant.tc\/2010\/05\/chrissy-jeremiah-island-escape\/\">http:\/\/www.brilliant.tc\/2010\/05\/chri...island-escape\/<\/a><\/div><\/div>","Email":"christinambucko@aol.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1258064938,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-223252.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Girasole","Id":223252,"Name":"Girasole","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":48153,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d231580dcf9c01d8a7feef741eccc2c3","RawContent":"&lt;p&gt; I guess all of us BDW brides really think a lot. I must say that this particular question has popped into my head once or twice as well.&lt;\/p&gt;","Attachments":[],"Id":1291894,"PostDate":1285027190,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I guess all of us BDW brides really think a lot. I must say that this particular question has popped into my head once or twice as well.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>**Beaches Turks & Caicos- March 12, 2011**<\/span><\/div><\/div>","Email":"mistibuard@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1279241667,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-230302.jpg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"mistibuard","Id":230302,"Name":"mistibuard","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"187.185.71.174","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":48153,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3c1b81e3c8c1babd3279da91583c8b2b","RawContent":"&lt;p&gt;Hi brides!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Here&#039;s some info about the marriage licenses and their validity internationally:&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Validity Outside of Mexico:\n\n\"Your Marriage Certificate will be valid world-wide, BUT you should\n\nget your certificate &#039;legalised&#039; in Mexico to ensure it is legally\n\naccepted when you get back home. The process is the reverse of getting\n\nyour Native documentation legalised by the necessary authorities (e.g.\n\nForeign Office) for marriage in Mexico (see below); The registry\n\noffice in Mexico will tell you where this can be done locally.\"\n&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/usmarriagelaws.com\/search\/caribbean\/mexico_city\/index.shtml&#039;&gt;http:\/\/usmarriagelaws.com\/search\/caribbean\/mexico_city\/index.shtml&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.mexicolaw.com\/Marriage%20in%20Mexico.htm&#039;&gt;http:\/\/www.mexicolaw.com\/Marriage%20in%20Mexico.htm&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Though that&#039;s specific to Mexico, where we operate, you can find general info here for US citizens getting married elsewhere:&amp;nbsp;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/travel.state.gov\/content\/passports\/en\/abroad\/events-and-records\/marriage.html&#039;&gt;https:\/\/travel.state.gov\/content\/passports\/en\/abroad\/events-and-records\/marriage.html&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck tying the knot!&amp;nbsp; B)&lt;\/p&gt;","Attachments":[],"Id":1915149,"PostDate":1470255621,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi brides!<\/p>\n<p>\u00a0<\/p>\n<p>Here's some info about the marriage licenses and their validity internationally:<\/p>\n<p>\u00a0<\/p>\n<p>Validity Outside of Mexico:<br>\n\"Your Marriage Certificate will be valid world-wide, BUT you should<br>\nget your certificate 'legalised' in Mexico to ensure it is legally<br>\naccepted when you get back home. The process is the reverse of getting<br>\nyour Native documentation legalised by the necessary authorities (e.g.<br>\nForeign Office) for marriage in Mexico (see below); The registry<br>\noffice in Mexico will tell you where this can be done locally.\"<br><a href='http:\/\/usmarriagelaws.com\/search\/caribbean\/mexico_city\/index.shtml' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/usmarriagelaw...ity\/index.shtml<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a href='http:\/\/www.mexicolaw.com\/Marriage%20in%20Mexico.htm' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.mexicolaw...e in Mexico.htm<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Though that's specific to Mexico, where we operate, you can find general info here for US citizens getting married elsewhere:\u00a0<a href='https:\/\/travel.state.gov\/content\/passports\/en\/abroad\/events-and-records\/marriage.html' class='bbc_url' title='External link' rel='nofollow external'>https:\/\/travel.state...s\/marriage.html<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Good luck tying the knot!\u00a0 <img src='https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_emoticons\/default\/cool.png' class='bbc_emoticon' alt='B)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><strong><span style=\"font-size:15px;\">WeddingDayStory Photo & Video<\/span><\/strong><\/p>\n<p><em>Celebrating the Simple Romance of Weddings in the Sun<\/em><\/p>\n<p>\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7<\/p>\n<p><span style=\"font-size:12px;\"><a data-ipb='