{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":5,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":1091,"MovedTo":null,"MovedOn":0,"FirstPostId":1897449,"Rating":0,"RatingHits":0,"Starter":{"Id":283286,"Name":"kalahreynolds","Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-283286.jpg?_r=1434736013","PhotoWidth":106,"PhotoHeight":159,"PhotoType":"custom"},"IsOnline":false},"StartDate":1432848121,"LastPoster":{"Id":283286,"Name":"kalahreynolds","Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-283286.jpg?_r=1434736013","PhotoWidth":106,"PhotoHeight":159,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":38,"Preview":{"Id":1897449,"PostDate":1432848121,"PostContent":"Hello Ladies!\u00a0 \u00a0 I am planning a wedding at the Riu Santa Fe in Cabo March 11, 2016 and want to h...","Author":{"Signature":"","Email":"kalahreynolds@gmail.com","IpAddress":"97.88.255.178","GroupId":39,"GroupName":"Newbie","JoinDate":1432847534,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-283286.jpg?_r=1434736013","PhotoWidth":106,"PhotoHeight":159,"PhotoType":"custom"},"FormattedName":"kalahreynolds","Id":283286,"Name":"kalahreynolds","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"97.88.255.178","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79223,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1683fced14f9641ec49139399ae61b88","RawContent":"&lt;p&gt;Hello Ladies!&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am planning a wedding at the Riu Santa Fe in Cabo March 11, 2016 and want to hear all of your thoughts and information! :)&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Did you or are you:&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Bringing your own photographer&lt;\/p&gt;\n&lt;p&gt;Having a beach ceremony&lt;\/p&gt;\n&lt;p&gt;Private reception&lt;\/p&gt;\n&lt;p&gt;Using their hairdressers&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Are there any add-on&#039;s I should know about? We are going through a travel agent but I want to hear from you all!&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thanks in advance and please throw any information my way that you can!&lt;\/p&gt;","Attachments":[],"Id":1897449,"PostDate":1432848121,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello Ladies!\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I am planning a wedding at the Riu Santa Fe in Cabo March 11, 2016 and want to hear all of your thoughts and information! <img src='https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Did you or are you:<\/p>\n<p>\u00a0<\/p>\n<p>Bringing your own photographer<\/p>\n<p>Having a beach ceremony<\/p>\n<p>Private reception<\/p>\n<p>Using their hairdressers<\/p>\n<p>\u00a0<\/p>\n<p>Are there any add-on's I should know about? We are going through a travel agent but I want to hear from you all!\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Thanks in advance and please throw any information my way that you can!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kalahreynolds@gmail.com","IpAddress":"97.88.255.178","GroupId":39,"GroupName":"Newbie","JoinDate":1432847534,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-283286.jpg?_r=1434736013","PhotoWidth":106,"PhotoHeight":159,"PhotoType":"custom"},"FormattedName":"kalahreynolds","Id":283286,"Name":"kalahreynolds","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.75.34.56","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79223,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"ca3ff37cfca2aab827420c428db585f6","RawContent":"&lt;p&gt;Hello! I am a Riu Santa Fe bride too! We are getting married on Feb. 1, 2016. We are flying our own photographer down and having our ceremony on the beach. My bridesmaids and I are getting our hair and makeup done by Suzanne morel (they have a great reputation in Cabo!).&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;As for the reception, we have not decided yet.. I&#039;m confused about what to do as we want private but I don&#039;t want to pay an arm and a leg! We were interested in the English patio for a private reception by they require you to pay 13$ per person for open bar, at least 36$&amp;nbsp; a person for dinner, and 600$ to rent out the space. That just seems a bit much when we can get it for free at the Steakhouse (which I hear is a quite private anyways and has a great view and atmosphere). The only thing with the steakhouse is they do not allow dancing or microphones for speeches so we would have to move the reception elsewhere after dinner. An option is to rent out the disco, but I am not really interested in that either as I hear it smells like puke and booze!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I would love to hear your ideas too!&lt;\/p&gt;","Attachments":[],"Id":1897475,"PostDate":1432872715,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello! I am a Riu Santa Fe bride too! We are getting married on Feb. 1, 2016. We are flying our own photographer down and having our ceremony on the beach. My bridesmaids and I are getting our hair and makeup done by Suzanne morel (they have a great reputation in Cabo!).\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>As for the reception, we have not decided yet.. I'm confused about what to do as we want private but I don't want to pay an arm and a leg! We were interested in the English patio for a private reception by they require you to pay 13$ per person for open bar, at least 36$\u00a0 a person for dinner, and 600$ to rent out the space. That just seems a bit much when we can get it for free at the Steakhouse (which I hear is a quite private anyways and has a great view and atmosphere). The only thing with the steakhouse is they do not allow dancing or microphones for speeches so we would have to move the reception elsewhere after dinner. An option is to rent out the disco, but I am not really interested in that either as I hear it smells like puke and booze!<\/p>\n<p>\u00a0<\/p>\n<p>I would love to hear your ideas too!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"millar_devon@hotmail.com","IpAddress":"154.20.36.21","GroupId":39,"GroupName":"Newbie","JoinDate":1423329313,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-282027.jpg?_r=1429713632","PhotoWidth":169,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Victoriabride","Id":282027,"Name":"Victoriabride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"97.88.255.178","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79223,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"04b5f22b03872a38c8b9155259147d3e","RawContent":"&lt;p&gt;@[member=\"Victoriabride\"] I will probably just do our reception at the steakhouse so that we don&#039;t have to pay an arm and a leg for food, etc. Also, we are actually having a reception back home in STL 3 weeks after our ceremony so I don&#039;t know that we will do speeches in Mexico or not...haven&#039;t decided! I am doing a beach ceremony though and am excited to email the wedding coordinator at the resort to see what options I have there. Are you doing videography too? I looked into flying our photographer down and its totally doable but videography is SO expensive and its the one thing I really want for the ceremony!&lt;\/p&gt;","Attachments":[],"Id":1897854,"PostDate":1433362722,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"282027\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='https:\/\/www.bestdestinationwedding.com\/user\/282027-victoriabride\/' title='Member profile'><span itemprop=\"name\">Victoriabride<\/span><\/a> I will probably just do our reception at the steakhouse so that we don't have to pay an arm and a leg for food, etc. Also, we are actually having a reception back home in STL 3 weeks after our ceremony so I don't know that we will do speeches in Mexico or not...haven't decided! I am doing a beach ceremony though and am excited to email the wedding coordinator at the resort to see what options I have there. Are you doing videography too? I looked into flying our photographer down and its totally doable but videography is SO expensive and its the one thing I really want for the ceremony!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kalahreynolds@gmail.com","IpAddress":"97.88.255.178","GroupId":39,"GroupName":"Newbie","JoinDate":1432847534,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-283286.jpg?_r=1434736013","PhotoWidth":106,"PhotoHeight":159,"PhotoType":"custom"},"FormattedName":"kalahreynolds","Id":283286,"Name":"kalahreynolds","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"163.188.148.240","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79223,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"65a8f3ba663d0ecf4f00996016d0a303","RawContent":"&lt;p&gt;Hi @[member=\"kalahreynolds\"] ! I am getting married at Santa Fe 10\/17\/15. I have all the same questions you do....I am having a beach wedding and I THINK I am going to have dinner at teh steak house - its free! I have 41 guests I just dont want to pay for per plate charge and open bar. I am leaning towards reserving the tequila bar for reception...how is your planning coming?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Did you chose a photographer...I am opting to go with the hotel one, but not sure.&lt;\/p&gt;","Attachments":[],"Id":1901036,"PostDate":1437670901,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi @<a hovercard-ref=\"member\" hovercard-id=\"283286\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='https:\/\/www.bestdestinationwedding.com\/user\/283286-kalahreynolds\/' title='Member profile'><span itemprop=\"name\">kalahreynolds<\/span><\/a> ! I am getting married at Santa Fe 10\/17\/15. I have all the same questions you do....I am having a beach wedding and I THINK I am going to have dinner at teh steak house - its free! I have 41 guests I just dont want to pay for per plate charge and open bar. I am leaning towards reserving the tequila bar for reception...how is your planning coming?<\/p>\n<p>\u00a0<\/p>\n<p>Did you chose a photographer...I am opting to go with the hotel one, but not sure.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jaygurl99@gmail.com","IpAddress":"163.188.148.240","GroupId":39,"GroupName":"Newbie","JoinDate":1437670176,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-284097.jpg?_r=1438615074","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"Mrsdelagarza01","Id":284097,"Name":"Mrsdelagarza01","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"97.88.255.178","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79223,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4da1a6648d066c53e1052952406bd11b","RawContent":"&lt;p&gt;Hey @[member=\"Mrsdelagarza01\"] ! Congratulations! I am also leaning towards having dinner at the steak house because I&#039;ve seen a couple reviews that said it was really good and I don&#039;t want to have to pay any extra. So far we have 20 guests that have booked but over half of our wedding party still needs to book so my guess is that we will be right around 40-50 too. I haven&#039;t looked at reserving the tequila bar for the reception--how much extra does that cost? My planning is going...we are also have a reception back home so that&#039;s where a majority of our money is going to be spent.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I just booked Gonzalo Verdeja for photography and videography. His website is&amp;nbsp;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.gvphotographer.com\/&#039;&gt;http:\/\/www.gvphotographer.com\/&lt;\/a&gt;. I love his photography style and that is the one thing I didn&#039;t want to go cheap on because your photos are the only thing you will have forever...you know? He did give me a really good deal though-- 2 photographers for the day of the wedding and a Videographer for $4000 total which includes 6 hours of photography and videography, all rights to the photos which he will put in an online album for us to download, a coffee book table and then a 5-7 minute video from the day. How much is the hotel photographer? I haven&#039;t seen anything from them yet... &lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Did you email them or did they contact you? And how far out did they contact you? Are you doing any extras?&lt;\/p&gt;","Attachments":[],"Id":1901823,"PostDate":1438712467,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hey @<a hovercard-ref=\"member\" hovercard-id=\"284097\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='https:\/\/www.bestdestinationwedding.com\/user\/284097-mrsdelagarza01\/' title='Member profile'><span itemprop=\"name\">Mrsdelagarza01<\/span><\/a> ! Congratulations! I am also leaning towards having dinner at the steak house because I've seen a couple reviews that said it was really good and I don't want to have to pay any extra. So far we have 20 guests that have booked but over half of our wedding party still needs to book so my guess is that we will be right around 40-50 too. I haven't looked at reserving the tequila bar for the reception--how much extra does that cost? My planning is going...we are also have a reception back home so that's where a majority of our money is going to be spent.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I just booked Gonzalo Verdeja for photography and videography. His website is\u00a0<a href='http:\/\/www.gvphotographer.com\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.gvphotographer.com\/<\/a>. I love his photography style and that is the one thing I didn't want to go cheap on because your photos are the only thing you will have forever...you know? He did give me a really good deal though-- 2 photographers for the day of the wedding and a Videographer for $4000 total which includes 6 hours of photography and videography, all rights to the photos which he will put in an online album for us to download, a coffee book table and then a 5-7 minute video from the day. How much is the hotel photographer? I haven't seen anything from them yet... <\/p>\n<p>\u00a0<\/p>\n<p>Did you email them or did they contact you? And how far out did they contact you? Are you doing any extras?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kalahreynolds@gmail.com","IpAddress":"97.88.255.178","GroupId":39,"GroupName":"Newbie","JoinDate":1432847534,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-283286.jpg?_r=1434736013","PhotoWidth":106,"PhotoHeight":159,"PhotoType":"custom"},"FormattedName":"kalahreynolds","Id":283286,"Name":"kalahreynolds","IsOnline":false}}],"Id":"79223","Title":"Riu Santa Fe","LastPostDate":1438712467},"Pages":{"TotalItems":5,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
