{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":4,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":1359,"MovedTo":null,"MovedOn":0,"FirstPostId":1906140,"Rating":0,"RatingHits":0,"Starter":{"Id":285022,"Name":"Lilako10","Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-285022.jpg?_r=1445709424","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"StartDate":1444504232,"LastPoster":{"Id":288729,"Name":"Soon2beMrsH","Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":true},"PollState":"0","LastVote":0,"ForumId":38,"Preview":{"Id":0,"PostDate":0,"PostContent":"","Author":{"Signature":"","Email":"","IpAddress":"","GroupId":0,"GroupName":"","JoinDate":0,"Photo":{"HasPhoto":false,"PhotoUrl":null,"PhotoWidth":0,"PhotoHeight":0,"PhotoType":""},"FormattedName":"","Id":0,"Name":"","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.215.196.5","IsFirstPost":false,"IsQueued":false,"IsVisible":false,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":false,"TopicId":79643,"EditedBy":null,"EditDate":0,"EditReason":null,"DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"970bdeea2b8b438e2089f49d765fe34b","RawContent":"","Attachments":[],"Id":1917535,"PostDate":1491846848,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Lilako10, on 10 October 2015 - 11:10 AM, said:<\/p><div class='blockquote'><div class='quote'><p>We are getting married at the riu santa fe this coming January and we have selected the caprice package with a semi private dinner and then we are considering have speeches, first dance, and reception in the disco bar. Is this a good idea? Any suggestions? We have been patiently awaiting information from the resort but have received nothing yet. If anyone has any information on weddings at the santa fe could you please send it to lindsey_alexay@hotmail.com.<\/p><\/div><\/div>\n<br>\nHi, i seen that you got married bacj in January at the Riu Santa Fe.. How did everything go? I am getting married this August at the same resort. I am a bit anxious about it because i don't know what to expect.. So far i have decided to have a semi private dinner at the steakhouse for us and 20 of my guests.   I am still debating if i should have a reception or not. I kind of feel that since it isn't too many people having to spend over $600 for the reception is a bit much. What do you think? And do you have any suggestions?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"afoster516@gmail.com","IpAddress":"207.215.196.5","GroupId":39,"GroupName":"Newbie","JoinDate":1491845006,"Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Soon2beMrsH","Id":288729,"Name":"Soon2beMrsH","IsOnline":true}}],"Id":"79643","Title":"Riu Santa Fe January 2016","LastPostDate":1491846848},"Pages":null,"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
