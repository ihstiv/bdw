\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"toriw83","Id":280772,"Name":"toriw83","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.15.193.73","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78482,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4ba06b3f498699ec706075450f0fc49f","RawContent":"&lt;p&gt;Sure! I will send you the Palace extras list. Again, it is for 2014 so I&#039;m sure prices will change. I also have all the info for the Santa Fe If you need anything! I&#039;m getting married on July 20, 2015.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Jenna&lt;\/p&gt;","Attachments":[],"Id":1880506,"PostDate":1418776795,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Sure! I will send you the Palace extras list. Again, it is for 2014 so I'm sure prices will change. I also have all the info for the Santa Fe If you need anything! I'm getting married on July 20, 2015.<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Jenna<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jenna32schap@yahoo.com","IpAddress":"75.97.32.162","GroupId":39,"GroupName":"Newbie","JoinDate":1394387100,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-277065.jpg?_r=1438546602","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"jenna32schap","Id":277065,"Name":"jenna32schap","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"69.42.28.220","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78482,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"965ffbcddba3204224d9ebbb797a266c","RawContent":"&lt;p&gt;@[member=\"toriw83\"]&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I also emailed you the Riu Palace&#039;s 2015 information which includes the pricing list for extras, banquet menu, etc.&amp;nbsp; Hope it helps with your research and decision making.&lt;\/p&gt;","Attachments":[],"Id":1880539,"PostDate":1418783081,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"280772\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='https:\/\/www.bestdestinationwedding.com\/user\/280772-toriw83\/' title='Member profile'><span itemprop=\"name\">toriw83<\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>I also emailed you the Riu Palace's 2015 information which includes the pricing list for extras, banquet menu, etc.\u00a0 Hope it helps with your research and decision making.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jrcorrales@gmail.com","IpAddress":"69.42.28.220","GroupId":39,"GroupName":"Newbie","JoinDate":1413956046,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-280778.jpg?_r=1421562169","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"AmorDeMiVida","Id":280778,"Name":"AmorDeMiVida","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.62.214.10","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78482,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2f15f00707b1ddfb9d80115effe2c7e3","RawContent":"&lt;p&gt;Thanks so much for the information - it is very helpful!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Are either of you using a Travel Agent?&lt;\/p&gt;","Attachments":[],"Id":1880620,"PostDate":1418858705,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thanks so much for the information - it is very helpful!<\/p>\n<p>\u00a0<\/p>\n<p>Are either of you using a Travel Agent?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"toriw83@gmail.com","IpAddress":"74.62.214.10","GroupId":39,"GroupName":"Newbie","JoinDate":1413936462,"Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"toriw83","Id":280772,"Name":"toriw83","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"69.42.28.220","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78482,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"684537a08f74d2117ce819f53a9bc54e","RawContent":"&lt;p&gt;@[member=\"toriw83\"] and @[member=\"sbodnar4\"] I emailed the both of you some additional information that I received from Ana Maria today.&amp;nbsp; @[member=\"toriw83\"] I am using Teresa Stauring from Vacations 4 Less (Los Angeles, CA) after hearing so many great things about her on this forum.&amp;nbsp; After speaking with her and emailing, I knew she was someone I definitely wanted to work with.&amp;nbsp; She has been very helpful, responsive and has answered all my questions via email and phone.&amp;nbsp; There was instance when I emailed her on a Saturday afternoon thinking I would get a response the following Monday.&amp;nbsp; She responded immediately and from that I can tell she is very dedicated to her clients. I&#039;m glad that there are other Riu Palace brides so we can help each other out.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;- Janice &amp;nbsp; &amp;nbsp;   &lt;\/p&gt;","Attachments":[],"Id":1880703,"PostDate":1418874848,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"280772\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='https:\/\/www.bestdestinationwedding.com\/user\/280772-toriw83\/' title='Member profile'><span itemprop=\"name\">toriw83<\/span><\/a> and @<a hovercard-ref=\"member\" hovercard-id=\"281338\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='https:\/\/www.bestdestinationwedding.com\/user\/281338-sbodnar4\/' title='Member profile'><span itemprop=\"name\">sbodnar4<\/span><\/a> I emailed the both of you some additional information that I received from Ana Maria today.\u00a0 @<a hovercard-ref=\"member\" hovercard-id=\"280772\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='https:\/\/www.bestdestinationwedding.com\/user\/280772-toriw83\/' title='Member profile'><span itemprop=\"name\">toriw83<\/span><\/a> I am using Teresa Stauring from Vacations 4 Less (Los Angeles, CA) after hearing so many great things about her on this forum.\u00a0 After speaking with her and emailing, I knew she was someone I definitely wanted to work with.\u00a0 She has been very helpful, responsive and has answered all my questions via email and phone.\u00a0 There was instance when I emailed her on a Saturday afternoon thinking I would get a response the following Monday.\u00a0 She responded immediately and from that I can tell she is very dedicated to her clients. I'm glad that there are other Riu Palace brides so we can help each other out.<\/p>\n<p>\u00a0<\/p>\n<p>- Janice \u00a0 \u00a0 \u00a0\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jrcorrales@gmail.com","IpAddress":"69.42.28.220","GroupId":39,"GroupName":"Newbie","JoinDate":1413956046,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-280778.jpg?_r=1421562169","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"AmorDeMiVida","Id":280778,"Name":"AmorDeMiVida","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.15.193.236","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78482,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"babb4d56cd1ade731332faf519d220d9","RawContent":"&lt;p&gt;@toriw83&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We are using Apple Vacations. I would definitely recommend using a Travel Agent. A lot of our guests have reached out to Apple with a wide variety of questions (both prior to booking and after). They provide a room discount if you book your flight through them. They also provide transportation to and from the airport (which I&#039;m sure most places do). I couldn&#039;t imagine having all of our guests book on their own and then having them asking us questions that we may not have answers to! I think having a Travel Agent takes away some of the stress! Also, there is an Apple representative at the resort for any on sight questions.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Jenna&lt;\/p&gt;","Attachments":[],"Id":1880775,"PostDate":1418938995,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@toriw83\u00a0<\/p>\n<p>We are using Apple Vacations. I would definitely recommend using a Travel Agent. A lot of our guests have reached out to Apple with a wide variety of questions (both prior to booking and after). They provide a room discount if you book your flight through them. They also provide transportation to and from the airport (which I'm sure most places do). I couldn't imagine having all of our guests book on their own and then having them asking us questions that we may not have answers to! I think having a Travel Agent takes away some of the stress! Also, there is an Apple representative at the resort for any on sight questions.<\/p>\n<p>\u00a0<\/p>\n<p>Jenna<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jenna32schap@yahoo.com","IpAddress":"75.97.32.162","GroupId":39,"GroupName":"Newbie","JoinDate":1394387100,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-277065.jpg?_r=1438546602","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"jenna32schap","Id":277065,"Name":"jenna32schap","IsOnline":false}}],"Id":"78482","Title":"Riu Package Extras","LastPostDate":1454042028},"Pages":{"TotalItems":50,"TotalPages":5,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":40},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
