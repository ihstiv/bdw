{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":1,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":590,"MovedTo":null,"MovedOn":0,"FirstPostId":1914446,"Rating":0,"RatingHits":0,"Starter":{"Id":285591,"Name":"Sdevore138","Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-285591.jpg?_r=1466200976","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"StartDate":1466201348,"LastPoster":{"Id":285591,"Name":"Sdevore138","Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-285591.jpg?_r=1466200976","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":38,"Preview":{"Id":1914446,"PostDate":1466201348,"PostContent":"Hello fellow brides! \u00a0 I am hoping to book a nice excursion for all of our guests the night befor...","Author":{"Signature":"","Email":"sdevore138@hotmail.com","IpAddress":"209.242.148.242","GroupId":39,"GroupName":"Newbie","JoinDate":1450131304,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-285591.jpg?_r=1466200976","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"Sdevore138","Id":285591,"Name":"Sdevore138","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"107.223.113.91","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80139,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6f19431c882e7cfd61a58c94bbe525e8","RawContent":"&lt;p&gt;Hello fellow brides!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am hoping to book a nice excursion for all of our guests the night before the wedding. &amp;nbsp;Kind of like a welcome\/thank you for traveling so far. &amp;nbsp;We were planning on doing a sunset cruise with hosted apps and drinks. &amp;nbsp;Has anyone else looked into this? &amp;nbsp;We are having more guests than I originally planned so I&#039;m struggling to find a boat that can fit around 70 people! &amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Or has anyone planned another type of excursion for their guests? &amp;nbsp;I&#039;m totally open to other ideas! &amp;nbsp;But I&#039;m straying away from a rehearsal dinner because we are hosting a farewell brunch on the last day.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thank you!&lt;\/p&gt;","Attachments":[],"Id":1914446,"PostDate":1466201348,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello fellow brides!<\/p>\n<p>\u00a0<\/p>\n<p>I am hoping to book a nice excursion for all of our guests the night before the wedding. \u00a0Kind of like a welcome\/thank you for traveling so far. \u00a0We were planning on doing a sunset cruise with hosted apps and drinks. \u00a0Has anyone else looked into this? \u00a0We are having more guests than I originally planned so I'm struggling to find a boat that can fit around 70 people! \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Or has anyone planned another type of excursion for their guests? \u00a0I'm totally open to other ideas! \u00a0But I'm straying away from a rehearsal dinner because we are hosting a farewell brunch on the last day.<\/p>\n<p>\u00a0<\/p>\n<p>Thank you!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sdevore138@hotmail.com","IpAddress":"209.242.148.242","GroupId":39,"GroupName":"Newbie","JoinDate":1450131304,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-285591.jpg?_r=1466200976","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"Sdevore138","Id":285591,"Name":"Sdevore138","IsOnline":false}}],"Id":"80139","Title":"Welcome Event For Guests In Cabo","LastPostDate":1466201348},"Pages":{"TotalItems":1,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
