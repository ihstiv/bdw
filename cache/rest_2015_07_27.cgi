m\/cdn\/profile\/photo-207776.gif?_r=0","PhotoWidth":100,"PhotoHeight":99,"PhotoType":"custom"},"FormattedName":"BillysBride","Id":207776,"Name":"BillysBride","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"afcad454cfb0fcfe78a20a066356f4b7","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;Jacilynda&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;LOL we&#039;ve missed you jean-marcus!\n \n Dee I really like this! I first saw it when roo posted about the designer and wasnt to sure about it. But I really like it! The colors are alot brighter than I thought! \n \n Roo i say get it! I think you can rock this dress at 40!&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;thank you. i have been doing a lot of destintion weddings and editing so hard to keep in touch the last two months. plus i had to get my vendor status back up and running. i miss my siggy pics &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/sad.gif\" border=\"0\" alt=\"\" title=\"Sad\" class=\"inlineimg\" \/&gt;","Attachments":[],"Id":693137,"PostDate":1242418717,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>Jacilynda<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">LOL we've missed you jean-marcus!<br \/> <br \/> Dee I really like this! I first saw it when roo posted about the designer and wasnt to sure about it. But I really like it! The colors are alot brighter than I thought! <br \/> <br \/> Roo i say get it! I think you can rock this dress at 40!<\/div> <\/td> <\/tr> <\/table> <\/div>thank you. i have been doing a lot of destintion weddings and editing so hard to keep in touch the last two months. plus i had to get my vendor status back up and running. i miss my siggy pics <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/sad.gif\" border=\"0\" alt=\"\" title=\"Sad\" class=\"inlineimg\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jean-marcus@jean-marcus.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1190143380,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207758.gif?_r=0","PhotoWidth":100,"PhotoHeight":67,"PhotoType":"custom"},"FormattedName":"jean-marcus","Id":207758,"Name":"jean-marcus","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"89e858324996b6c45905c84824b7c11d","RawContent":"Dee you wedding gown is very very pretty i love all the bead work it looks very expensive x.Can i please ask is the bottom of the liteinthe box dress as full as the website picture looks,and what about fit what size did you go with,did you custom order it,ummm you went with the white? oh and delivery were tou charged import duty and last but not least did it arrive wrinkled or as good as it looks hanging up.Could you post a pic with you in it thanks maria x","Attachments":[],"Id":693631,"PostDate":1242459863,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Dee you wedding gown is very very pretty i love all the bead work it looks very expensive x.Can i please ask is the bottom of the liteinthe box dress as full as the website picture looks,and what about fit what size did you go with,did you custom order it,ummm you went with the white? oh and delivery were tou charged import duty and last but not least did it arrive wrinkled or as good as it looks hanging up.Could you post a pic with you in it thanks maria x\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"roo6637@aol.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1208337577,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209110.jpg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"roo66","Id":209110,"Name":"roo66","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"559eba95bf2b83b29c5967ad44ead86c","RawContent":"wahhhoo my son has just come in he was out partying last nite and i showed him the pics and he said the dress was nice xx dont you just love um xx","Attachments":[],"Id":693633,"PostDate":1242460026,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                wahhhoo my son has just come in he was out partying last nite and i showed him the pics and he said the dress was nice xx dont you just love um xx\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"roo6637@aol.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1208337577,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209110.jpg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"roo66","Id":209110,"Name":"roo66","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7aec665ba0dc4ff19ebe8fe7262c39b6","RawContent":"Landy Bridal never responded to my email asking if they could make my dress (San Patrick- Binefar). I found the dress I was looking for at Duosheng. I&#039;m confused though because it only shows photos of the dress and doesn&#039;t have any information about price or ordering it! It&#039;s not from 2009, maybe they don&#039;t make it anymore&lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/huh.gif\" border=\"0\" alt=\"\" title=\"Huh\" class=\"inlineimg\" \/&gt; What do you guys think?\n &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.duosheng.cn\/shangweb\/xihun\/CHIC-171.html\"&gt;\u0160\u00b1\u008f\u2014\u00ae\u02c6\u00a8\u008d\u00be\u00b5\u201e\u0160\u00b1\u2030\u0090\u2020\u00b7\u2026\u2020\u00b7\u00be\u0160\u017d&lt;\/a&gt;","Attachments":[],"Id":693781,"PostDate":1242489318,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Landy Bridal never responded to my email asking if they could make my dress (San Patrick- Binefar). I found the dress I was looking for at Duosheng. I'm confused though because it only shows photos of the dress and doesn't have any information about price or ordering it! It's not from 2009, maybe they don't make it anymore<span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/huh.gif\" border=\"0\" alt=\"\" title=\"Huh\" class=\"inlineimg\" \/><\/span> What do you guys think?<br \/> <a href='http:\/\/www.duosheng.cn\/shangweb\/xihun\/CHIC-171.html' class='bbc_url' title='External link' rel='nofollow external'>\u0160\u00b1\u008f\u2014\u00ae\u02c6\u00a8\u008d\u00be\u00b5\u201e\u0160\u00b1\u2030\u0090\u2020\u00b7\u2026\u2020\u00b7\u00be\u0160\u017d<\/a>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"geminigem615@aol.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1231200988,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213622.gif?_r=0","PhotoWidth":75,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"KimmyG","Id":213622,"Name":"KimmyG","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cf99f77d6d325333d516500a6d6ebb77","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;roo66&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Can i please ask is the bottom of the liteinthe box dress as full as the website picture looks,&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;The bottom of the dress is very full, it has a lot of tulle...but it is not as full as the picture shows\n \n &lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;roo66&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;and what about fit what size did you go with,did you custom order it,ummm you went with the white?&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;I went with size 14, (Im a street size 12) it came out really big so I have to get it taken it, I would suggest you custom order it so you dont have to get it tailored, and yes it is in white.\n \n &lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;roo66&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;oh and delivery were tou charged import duty&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;I was charged import duty, something like $30 Canadian\n \n &lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;roo66&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;and last but not least did it arrive wrinkled or as good as it looks hanging up.&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;Thats the way it come, I just hung it up.\n \n &lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;roo66&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Could you post a pic with you in it thanks maria x&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;The dress is in my parents house in Halifax, Im in Toronto so next time I go back home I will take pics\n \n Hope I answered all your questions, let me know if you have any more","Attachments":[],"Id":693814,"PostDate":1242493479,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>roo66<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Can i please ask is the bottom of the liteinthe box dress as full as the website picture looks,<\/div> <\/td> <\/tr> <\/table> <\/div>The bottom of the dress is very full, it has a lot of tulle...but it is not as full as the picture shows<br \/> <br \/> <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>roo66<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">and what about fit what size did you go with,did you custom order it,ummm you went with the white?<\/div> <\/td> <\/tr> <\/table> <\/div>I went with size 14, (Im a 