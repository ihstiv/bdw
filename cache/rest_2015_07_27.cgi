{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":1,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":573,"MovedTo":null,"MovedOn":0,"FirstPostId":1895733,"Rating":0,"RatingHits":0,"Starter":{"Id":283024,"Name":"Poya","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283024.png?_r=1431078728","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"StartDate":1431065445,"LastPoster":{"Id":283024,"Name":"Poya","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283024.png?_r=1431078728","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":7,"Preview":{"Id":1895733,"PostDate":1431065445,"PostContent":"Hi All, \u00a0 I\u2019m doing some research to see how people hire live musicians for their weddings, and w...","Author":{"Signature":"","Email":"poya@musoalley.com","IpAddress":"203.206.24.52","GroupId":39,"GroupName":"Newbie","JoinDate":1431064199,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283024.png?_r=1431078728","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"Poya","Id":283024,"Name":"Poya","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"203.206.24.52","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79163,"EditedBy":"<strong>Edited by Poya, 08 May 2015 - 06:11 AM.<\/strong>","EditDate":1431065483,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4934c7a2394eefc59c0644ac0caca397","RawContent":"&lt;p style=\"color:rgb(0,0,0);font-family:&#039;Helvetica Neue&#039;, Helvetica, Arial, sans-serif;\"&gt;Hi All,&lt;\/p&gt;\n&lt;p style=\"color:rgb(0,0,0);font-family:&#039;Helvetica Neue&#039;, Helvetica, Arial, sans-serif;\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"color:rgb(0,0,0);font-family:&#039;Helvetica Neue&#039;, Helvetica, Arial, sans-serif;\"&gt;I\u2019m doing some research to see how people hire live musicians for their weddings, and whether or not the process can be improved. I would love to hear from anyone who has gone through the process (for a past or upcoming wedding). I have put together a simple survey here:&lt;\/p&gt;\n&lt;p style=\"color:rgb(0,0,0);font-family:&#039;Helvetica Neue&#039;, Helvetica, Arial, sans-serif;\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"color:rgb(0,0,0);font-family:&#039;Helvetica Neue&#039;, Helvetica, Arial, sans-serif;\"&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/docs.google.com\/forms\/d\/1EIB1pB69Q5DGC4VYjJ-qKXpbC2CTgdPJ1TYYqwlnY2s\/viewform&#039;&gt;Live wedding music survey&lt;\/a&gt;&lt;\/p&gt;\n&lt;p style=\"color:rgb(0,0,0);font-family:&#039;Helvetica Neue&#039;, Helvetica, Arial, sans-serif;\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"color:rgb(0,0,0);font-family:&#039;Helvetica Neue&#039;, Helvetica, Arial, sans-serif;\"&gt;If you have any questions please let me know.&lt;\/p&gt;\n&lt;p style=\"color:rgb(0,0,0);font-family:&#039;Helvetica Neue&#039;, Helvetica, Arial, sans-serif;\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"color:rgb(0,0,0);font-family:&#039;Helvetica Neue&#039;, Helvetica, Arial, sans-serif;\"&gt;Thanks heaps,&amp;nbsp;\n\nPoya&lt;\/p&gt;\n&lt;p style=\"color:rgb(0,0,0);font-family:&#039;Helvetica Neue&#039;, Helvetica, Arial, sans-serif;\"&gt;&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1895733,"PostDate":1431065445,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p  style=\"color:rgb(0,0,0);font-family:'Helvetica Neue', Helvetica, Arial, sans-serif;\">Hi All,<\/p>\n<p  style=\"color:rgb(0,0,0);font-family:'Helvetica Neue', Helvetica, Arial, sans-serif;\">\u00a0<\/p>\n<p  style=\"color:rgb(0,0,0);font-family:'Helvetica Neue', Helvetica, Arial, sans-serif;\">I\u2019m doing some research to see how people hire live musicians for their weddings, and whether or not the process can be improved. I would love to hear from anyone who has gone through the process (for a past or upcoming wedding). I have put together a simple survey here:<\/p>\n<p  style=\"color:rgb(0,0,0);font-family:'Helvetica Neue', Helvetica, Arial, sans-serif;\">\u00a0<\/p>\n<p  style=\"color:rgb(0,0,0);font-family:'Helvetica Neue', Helvetica, Arial, sans-serif;\"><a href='https:\/\/docs.google.com\/forms\/d\/1EIB1pB69Q5DGC4VYjJ-qKXpbC2CTgdPJ1TYYqwlnY2s\/viewform' class='bbc_url' title='External link' rel='nofollow external'>Live wedding music survey<\/a><\/p>\n<p  style=\"color:rgb(0,0,0);font-family:'Helvetica Neue', Helvetica, Arial, sans-serif;\">\u00a0<\/p>\n<p  style=\"color:rgb(0,0,0);font-family:'Helvetica Neue', Helvetica, Arial, sans-serif;\">If you have any questions please let me know.<\/p>\n<p  style=\"color:rgb(0,0,0);font-family:'Helvetica Neue', Helvetica, Arial, sans-serif;\">\u00a0<\/p>\n<p  style=\"color:rgb(0,0,0);font-family:'Helvetica Neue', Helvetica, Arial, sans-serif;\">Thanks heaps,\u00a0<br>\nPoya<\/p>\n<p  style=\"color:rgb(0,0,0);font-family:'Helvetica Neue', Helvetica, Arial, sans-serif;\">\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"poya@musoalley.com","IpAddress":"203.206.24.52","GroupId":39,"GroupName":"Newbie","JoinDate":1431064199,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283024.png?_r=1431078728","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"Poya","Id":283024,"Name":"Poya","IsOnline":false}}],"Id":"79163","Title":"Your Experience With Hiring A Live Band \/ Musician","LastPostDate":1431065445},"Pages":{"TotalItems":1,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
