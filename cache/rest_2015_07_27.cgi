Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":4,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":226,"MovedTo":null,"MovedOn":0,"FirstPostId":1899073,"Rating":0,"RatingHits":0,"Starter":{"Id":283644,"Name":"Heidz1234","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1435015359,"LastPoster":{"Id":282006,"Name":"ashhtayy","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282006.png?_r=1423373502","PhotoWidth":200,"PhotoHeight":138,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":23,"Preview":{"Id":1899073,"PostDate":1435015359,"PostContent":"Hi everyone I'm thinking of doing a small destination wedding. When I say small, I mean about ten...","Author":{"Signature":"","Email":"hjacobus1@gmail.com","IpAddress":"76.222.121.236","GroupId":39,"GroupName":"Newbie","JoinDate":1435014826,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Heidz1234","Id":283644,"Name":"Heidz1234","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"76.222.121.236","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79306,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8e83624c8f48ef0cd16b61f102d3302d","RawContent":"Hi everyone\n\nI&#039;m thinking of doing a small destination wedding. When I say small, I mean about ten to fifteen people. I want to have music, food, open bar. How do I keep the party started with a small group? Who has done a small wedding.?\n\nThank you!!","Attachments":[],"Id":1899073,"PostDate":1435015359,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi everyone<br>\nI'm thinking of doing a small destination wedding. When I say small, I mean about ten to fifteen people. I want to have music, food, open bar. How do I keep the party started with a small group? Who has done a small wedding.?<br>\nThank you!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"hjacobus1@gmail.com","IpAddress":"76.222.121.236","GroupId":39,"GroupName":"Newbie","JoinDate":1435014826,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Heidz1234","Id":283644,"Name":"Heidz1234","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"201.116.201.71","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79306,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ab38cae42950637279bf900642b6e832","RawContent":"&lt;p&gt;&lt;span style=\"font-size:14px;\"&gt;Hello @[member=\"Heidz1234\"] Congratulation for your wedding !!&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"color:rgb(31,31,31);font-family:Georgia;\"&gt;When it comes wedding celebrations, many couples agree: size matters. Fewer people can mean a more personal celebration. There is more time for the bride and groom to spend with their guests, the group really gets to know one another, and everyone contributes to the event in his or her own way. Intimate celebrations, it seems, have certain advantages.&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"color:rgb(31,31,31);font-family:Georgia;\"&gt;Party of course it is very important!! We suggest bring some funny party supplies, maracas, sunglasses, fans &amp;nbsp;and use it when the party start or when a great song start! You can add a tequila or shot station, also you can bring glowing sticks, sky lanterns or sparkles light &amp;nbsp;to have an awesome and bright night .&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;div&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.adventureweddingsvallarta.com\/es\/&#039;&gt;http:\/\/www.adventureweddingsvallarta.com\/es\/&lt;\/a&gt;&lt;\/div&gt;","Attachments":[],"Id":1900421,"PostDate":1436889142,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span  style=\"font-size:14px\">Hello @<a hovercard-ref=\"member\" hovercard-id=\"283644\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/283644-heidz1234\/' title='Member profile'><span itemprop=\"name\">Heidz1234<\/span><\/a> Congratulation for your wedding !!<\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-size:14px\"><span  style=\"color:rgb(31,31,31);font-family:Georgia\">When it comes wedding celebrations, many couples agree: size matters. Fewer people can mean a more personal celebration. There is more time for the bride and groom to spend with their guests, the group really gets to know one another, and everyone contributes to the event in his or her own way. Intimate celebrations, it seems, have certain advantages.\u00a0<\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-size:14px\"><span  style=\"color:rgb(31,31,31);font-family:Georgia\">Party of course it is very important!! We suggest bring some funny party supplies, maracas, sunglasses, fans \u00a0and use it when the party start or when a great song start! You can add a tequila or shot station, also you can bring glowing sticks, sky lanterns or sparkles light \u00a0to have an awesome and bright night .\u00a0<\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<div><a href='http:\/\/www.adventureweddingsvallarta.com\/es\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.adventure...allarta.com\/es\/<\/a><\/div>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"dennise@adventureweddingsvallarta.com","IpAddress":"187.146.166.254","GroupId":49,"GroupName":"Insiders","JoinDate":1343058803,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-258213.jpeg?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"LasCaletas","Id":258213,"Name":"LasCaletas","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.98.196.2","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79306,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"b32642e86626772caee7fd922739e12d","RawContent":"&lt;p&gt;I think it will be great! I&#039;ve had parties at home with that many people and as long as you have some partiers in your group it will be a lot easier to get it started because they make it super fun.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I think it all comes down to having good music that will get people going, and a bit of alcohol doesn&#039;t hurt to get the social juices flowing. It&#039;s always fun if you have some party props like the post above mentioned, but it&#039;s not necessary. I also think that if you and your hubby are having fun, people just kind of follow.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I was at a wedding a couple of weeks ago and the DJ made us play this game called \"snowball\". So the bride and groom started dancing, and then when he said snowball, they had to get someone else to come to the dance floor, then when he said snowball again, everyone on the dance floor grabbed someone else, and so on. It was fun, and the rule was that people couldn&#039;t refuse to dance ;). I think with a smaller wedding, just you and\/or your hubby can say snowball if you don&#039;t have a DJ. People should be able to hear you.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1900426,"PostDate":1436891789,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I think it will be great! I've had parties at home with that many people and as long as you have some partiers in your group it will be a lot easier to get it started because they make it super fun.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I think it all comes down to having good music that will get people going, and a bit of alcohol doesn't hurt to get the social juices flowing. It's always fun if you have some party props like the post above mentioned, but it's not necessary. I also think that if you and your hubby are having fun, people just kind of follow.<\/p>\n<p>\u00a0<\/p>\n<p>I was at a wedding a couple of weeks ago and the DJ made us play this game called \"snowball\". So the bride and groom started dancing, and then when he said snowball, they had to get someone else to come to the dance floor, then when he said snowball again, everyone on the dance floor grabbed someone else, and so on. It was fun, and the rule was that people couldn't refuse to dance <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/>. I think with a smaller wedding, just you and\/or your hubby can say snowball if you don't have a DJ. People should be able to hear you.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<br><p><a data-ipb='nomediaparse' href='http:\/\/www.TickerFactory.com\/'><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;31;484\/st\/20150813\/e\/Wedding+time%21+\/dt\/-2\/k\/b92c\/event.png\" alt=\"event.png\"><\/a><\/p>\n<p style=\"text-align:center;\">\u00a0<\/p>\n<p style=\"text-align:center;\">\u00a0","Email":"sblopezb@gmail.com","IpAddress":"172.219.193.22","GroupId":42,"GroupName":"Sr. Member","JoinDate":1359763104,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265511.jpg?_r=1427386564","PhotoWidth":200,"PhotoHeight":153,"PhotoType":"custom"},"FormattedName":"TinkerSofi","Id":265511,"Name":"TinkerSofi","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"184.147.133.33","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79306,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"03b464fb531484b9376839ec4892cf34","RawContent":"&lt;p&gt;@[member=\"TinkerSofi\"] you just brought me back to my elementary school days at our favourite spot \"Wheelies\". we used to play snowball on the roller rink. we spent every friday night there...and everyone&#039;s birthday parties. SO MUCH FUN! i would love to do something silly like that at our wedding because it would bring all my friends back to our younger days. great idea!&lt;\/p&gt;","Attachments":[],"Id":1900468,"PostDate":1436922336,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"265511\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/265511-tinkersofi\/' title='Member profile'><span itemprop=\"name\">TinkerSofi<\/span><\/a> you just brought me back to my elementary school days at our favourite spot \"Wheelies\". we used to play snowball on the roller rink. we spent every friday night there...and everyone's birthday parties. SO MUCH FUN! i would love to do something silly like that at our wedding because it would bring all my friends back to our younger days. great idea!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>My Planning Thread: <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79377-ashhtayys-planning-thread-azul-fives-june-7-2016\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79377-ashhtayys-planning-thread-azul-fives-june-7-2016\/<\/a><br>\n\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;0;116\/st\/20160607\/e\/Our+Wedding\/dt\/1\/k\/bb99\/event.png\" alt=\"event.png\"><\/a>","Email":"ashley.taylor@live.ca","IpAddress":"184.147.135.4","GroupId":40,"GroupName":"Jr. Member","JoinDate":1423105061,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282006.png?_r=1423373502","PhotoWidth":200,"PhotoHeight":138,"PhotoType":"custom"},"FormattedName":"ashhtayy","Id":282006,"Name":"ashhtayy","IsOnline":false}}],"Id":"79306","Title":"Small Wedding","LastPostDate":1436922336},"Pages":{"TotalItems":4,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
