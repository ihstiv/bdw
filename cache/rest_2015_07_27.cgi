","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"FormattedName":"christie272","Id":207205,"Name":"christie272","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e29faa09be72aa8c8484f883bad4de4d","RawContent":"&lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/C:Documents and SettingsDFIF170My DocumentsMy Pictures\"&gt;http:\/\/C:Documents and SettingsDFI...tsMy Pictures&lt;\/a&gt;","Attachments":[],"Id":40393,"PostDate":1175786179,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <a href='http:\/\/C:Documents and SettingsDFIF170My DocumentsMy Pictures' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/C:Documents a.....tsMy Pictures<\/a>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lisa.gatzke@rbccm.com","IpAddress":"","GroupId":46,"GroupName":"VIP Member","JoinDate":1166032860,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206967.gif?_r=0","PhotoWidth":100,"PhotoHeight":67,"PhotoType":"custom"},"FormattedName":"LisaG","Id":206967,"Name":"LisaG","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b332222b0d67640bf586a51a6370c912","RawContent":"&lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/bunny_4.gif\" border=\"0\" alt=\"\" title=\"Bunny 4\" class=\"inlineimg\" \/&gt; Finally got my dress! I ordered this back in October and just picked it up last week. I needed a tango friendly dress and a version of this dress was only the 2nd one I tried on! There is a version of it available without the lace overlay; and the model shown in the catalogs has a black lace overlay over the ivory lining. The crinoline comes off and both the front and the back bustle up for dancing. And yes, those are shorts underneath the skirt. There was the options of a mini skirt or a longer A-line skirt, but I needed the freedom of movement (plus I love saying that I&#039;m getting married in shorts - it raises a few eyebrows.) If anyone else needs a somewhat less traditional dress, I found this at Cymbeline.\n \n -V-\n \n Sorry this picture isn&#039;t the clearest but this was the 2nd fitting in one day and we were in a hurry. I have better pictures of the dresses I did not buy!\n \n &lt;img src=\"http:\/\/bestdestinationwedding.com\/forum\/imagehosting\/thum_119746168bb714807.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;&lt;\/a&gt;","Attachments":[],"Id":40827,"PostDate":1175883749,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/bunny_4.gif\" border=\"0\" alt=\"\" title=\"Bunny 4\" class=\"inlineimg\" \/><\/span> Finally got my dress! I ordered this back in October and just picked it up last week. I needed a tango friendly dress and a version of this dress was only the 2nd one I tried on! There is a version of it available without the lace overlay; and the model shown in the catalogs has a black lace overlay over the ivory lining. The crinoline comes off and both the front and the back bustle up for dancing. And yes, those are shorts underneath the skirt. There was the options of a mini skirt or a longer A-line skirt, but I needed the freedom of movement (plus I love saying that I'm getting married in shorts - it raises a few eyebrows.) If anyone else needs a somewhat less traditional dress, I found this at Cymbeline.<br \/> <br \/> -V-<br \/> <br \/> Sorry this picture isn't the clearest but this was the 2nd fitting in one day and we were in a hurry. I have better pictures of the dresses I did not buy!<br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bestdestinationwedding.com\/forum\/imagehosting\/thum_119746168bb714807.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><\/a>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Tulum - November 3, 2007<\/span><\/div><\/div>","Email":"wedding@vxnguy.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1172171592,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207210.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"calyx6","Id":207210,"Name":"calyx6","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bda287c583743002ffa3028ca707c980","RawContent":"Let&#039;s see if this works! My first time trying to post a pic!\n \n Here&#039;s my dress (maybe! :))\n \n &lt;img src=\"http:\/\/i172.photobucket.com\/albums\/w8\/amymichalsen\/backofmydress.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n &lt;img src=\"http:\/\/i172.photobucket.com\/albums\/w8\/amymichalsen\/WeddingDresses007_r1.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n I think it looks a lot better &amp;quot;in person&amp;quot;, but you get the idea!\n \n Amy","Attachments":[],"Id":43177,"PostDate":1176595531,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Let's see if this works! My first time trying to post a pic!<br \/> <br \/> Here's my dress (maybe! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>)<br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i172.photobucket.com\/albums\/w8\/amymichalsen\/backofmydress.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i172.photobucket.com\/albums\/w8\/amymichalsen\/WeddingDresses007_r1.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> I think it looks a lot better \"in person\", but you get the idea!<br \/> <br \/> Amy\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i172.photobucket.com\/albums\/w8\/amymichalsen\/Picture2.jpg\">http:\/\/i172.photobucket.com\/albums\/w...n\/Picture2.jpg<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.baby-gaga.com\/t\/dogdogsrd20080522_-7_Austin+is.png\">http:\/\/tickers.baby-gaga.com\/t\/dogdo..._Austin+is.png<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.baby-gaga.com\/p\/dev014prs__.png\">http:\/\/tickers.baby-gaga.com\/p\/dev014prs__.png<\/a><\/div><\/div>","Email":"lsjewelry@msn.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1172125835,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207209.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"amym567","Id":207209,"Name":"amym567","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3866824dded251713e3a3b70636e40f4","RawContent":"Hmm, hope I did this right. \n \n This is my dress, it&#039;s a Ramona Keveza and it&#039;s 2 pieces (they&#039;ll make it one for me). I&#039;m actually not sure that the bottom in this pic is the exact one, but it&#039;s damn close. \n \n ETA: Oh the color is color of the skirt. And the part numbers (hee) are: L640 (top) and L673 (bottom)\n \n I have one question, maybe I&#039;ll do a poll for it. For those of you who ended up with a more traditional dress, did you have the train altered off or did you just bustle it? Other suggestions are appreciated as well.\n \n Thanks-\n Alisha\n \n \n &lt;img src=\"http:\/\/bestdestinationwedding.com\/forum\/vbpgimage.php?do=full&amp;amp;p=441&amp;amp;d=1174949516\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;","Attachments":[],"Id":44844,"PostDate":1177019249,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hmm, hope I did this right. <br \/> <br \/> This is my dress, it's a Ramona Keveza and it's 2 pieces (they'll make it one for me). I'm actually not sure that the bottom in this pic is the exact one, but it's damn close. <br \/> <br \/> ETA: Oh the color is color of the skirt. And the part numbers (hee) are: L640 (top) and L673 (bottom)<br \/> <br \/> I have one question, maybe I'll do a poll for it. For those of you who ended up with a more traditional dress, did you have the train altered off or did you just bustle it? Other suggestions are appreciated as well.<br \/> <br \/> Thanks-<br \/> Alisha<br \/> <br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bestdestinationwedding.com\/forum\/vbpgimage.php?do=full&p=441&d=1174949516\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>TTD :: Tortola, BVI<\/span><\/div><\/div>","Email":"alisha@805jessie.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1174603711,"Photo":{"HasPhoto":true,"PhotoUrl