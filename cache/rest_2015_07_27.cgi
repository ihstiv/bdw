{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":1,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":536,"MovedTo":null,"MovedOn":0,"FirstPostId":1896438,"Rating":0,"RatingHits":0,"Starter":{"Id":278138,"Name":"lvaldez","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1431730963,"LastPoster":{"Id":278138,"Name":"lvaldez","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":22,"Preview":{"Id":1896438,"PostDate":1431730963,"PostContent":"Hello, \u00a0 This website helped me out quite a bit so I would like to give back! I got married at th...","Author":{"Signature":"","Email":"valdez.ramon85@yahoo.com","IpAddress":"24.189.235.186","GroupId":39,"GroupName":"Newbie","JoinDate":1401219737,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"lvaldez","Id":278138,"Name":"lvaldez","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"69.124.36.17","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79189,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a7bf826275b381f96fac264fa32e7fd1","RawContent":"&lt;p&gt;Hello,&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;This website helped me out quite a bit so I would like to give back! I got married at the Royalton Hotel and Casino this April, just a few points:&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Location: Beautiful&lt;\/p&gt;\n&lt;p&gt;Food: Good&lt;\/p&gt;\n&lt;p&gt;Service: Disorganized, poor&lt;\/p&gt;\n&lt;p&gt;Spa: Good Makeup and hair&lt;\/p&gt;\n&lt;p&gt;DJ: Good in house DJ&lt;\/p&gt;\n&lt;p&gt;Cocktail Hour:&amp;nbsp; not enough food provided&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I had a great time because I tried to not focus on the things they did wrong and focus more on that I was getting to marry the love of my life. However, there were quite a few mistakes (not enough food at cocktail hour, not enough lighting for reception (they would not turn on candles bc of the wind which they never told me, bridesmaid bouquet was incorrect and they were missing one bouquet, spa scheduling was completely off, among a few other things)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Probably the worst thing from this experience is their customer service. For all the errors on their part they took no responsibility instead blamed me the bride, I was really disappointed with this. If you book this resort be sure your on top of EVERYTHING. One word of advice they will ask you to fill out a survey on your experience in my case right before I had to leave for my flight whatever you DO NOT complete this form till you get back home. it seems like a generic enough simple form but they will use this form against you if you have any complaints. Give yourself time to reflect on the whole experience in order to complete this form thoughtfully. If you have any questions feel free to ask!&lt;\/p&gt;","Attachments":[],"Id":1896438,"PostDate":1431730963,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello,<\/p>\n<p>\u00a0<\/p>\n<p>This website helped me out quite a bit so I would like to give back! I got married at the Royalton Hotel and Casino this April, just a few points:<\/p>\n<p>\u00a0<\/p>\n<p>Location: Beautiful<\/p>\n<p>Food: Good<\/p>\n<p>Service: Disorganized, poor<\/p>\n<p>Spa: Good Makeup and hair<\/p>\n<p>DJ: Good in house DJ<\/p>\n<p>Cocktail Hour:\u00a0 not enough food provided<\/p>\n<p>\u00a0<\/p>\n<p>I had a great time because I tried to not focus on the things they did wrong and focus more on that I was getting to marry the love of my life. However, there were quite a few mistakes (not enough food at cocktail hour, not enough lighting for reception (they would not turn on candles bc of the wind which they never told me, bridesmaid bouquet was incorrect and they were missing one bouquet, spa scheduling was completely off, among a few other things)<\/p>\n<p>\u00a0<\/p>\n<p>Probably the worst thing from this experience is their customer service. For all the errors on their part they took no responsibility instead blamed me the bride, I was really disappointed with this. If you book this resort be sure your on top of EVERYTHING. One word of advice they will ask you to fill out a survey on your experience in my case right before I had to leave for my flight whatever you DO NOT complete this form till you get back home. it seems like a generic enough simple form but they will use this form against you if you have any complaints. Give yourself time to reflect on the whole experience in order to complete this form thoughtfully. If you have any questions feel free to ask!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"valdez.ramon85@yahoo.com","IpAddress":"24.189.235.186","GroupId":39,"GroupName":"Newbie","JoinDate":1401219737,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"lvaldez","Id":278138,"Name":"lvaldez","IsOnline":false}}],"Id":"79189","Title":"Royalton Casino And Resort Punta Cana","LastPostDate":1431730963},"Pages":{"TotalItems":1,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
