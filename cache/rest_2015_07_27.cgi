jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_04_2015\/post-282082-0-61761400-1428850027.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_04_2015\/post-282082-0-61761400-1428850027_thumb.jpg","Width":550,"Height":400},{"Id":31545,"Name":"ry=4006LYZYBFJ.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_04_2015\/post-282082-0-36258900-1428850028.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_04_2015\/post-282082-0-36258900-1428850028_thumb.jpg","Width":550,"Height":400},{"Id":31546,"Name":"ry=400493VEFAP.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_04_2015\/post-282082-0-02512800-1428850029.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_04_2015\/post-282082-0-02512800-1428850029_thumb.jpg","Width":550,"Height":400},{"Id":31547,"Name":"ry=400ODRRWDE2.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_04_2015\/post-282082-0-33290400-1428850030.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_04_2015\/post-282082-0-33290400-1428850030_thumb.jpg","Width":550,"Height":400}],"Id":1892824,"PostDate":1428835274,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hey there Everyone !<\/p>\n<p>\u00a0<\/p>\n<p>We just got back and I have a full review of the resort along with pictures and the wedding process and lots of helpful tricks for your trip and planning<\/p>\n<p>I couldn't get the paste from word function to work so I attached the review entitled Blog below<\/p>\n<p>\u00a0<\/p>\n<p>Bring on any questions you may have and I included templates for OOT bag stuff here too !<\/p>\n<p>\u00a0<\/p>\n<p>Hope this helps everyone and it was amazing so hope your special day is just as great !<\/p>\n<p>\u00a0<\/p>\n<p>xoxo<\/p>\n<p>Jess<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jnvoigt@yahoo.com","IpAddress":"66.56.187.156","GroupId":39,"GroupName":"Newbie","JoinDate":1423648807,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282082.jpg?_r=1428850100","PhotoWidth":200,"PhotoHeight":146,"PhotoType":"custom"},"FormattedName":"jnvoigt","Id":282082,"Name":"jnvoigt","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.65.74.207","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79050,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"34ef3a57f4d1507344ad388422df157f","RawContent":"&lt;p&gt;This is so helpful - thank you very much for sharing!&lt;\/p&gt;","Attachments":[],"Id":1892832,"PostDate":1428845132,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>This is so helpful - thank you very much for sharing!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ashley225@gmail.com","IpAddress":"66.87.117.140","GroupId":39,"GroupName":"Newbie","JoinDate":1426931385,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282492.jpg?_r=1436650511","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"AshleyNYC323","Id":282492,"Name":"AshleyNYC323","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"156.57.21.15","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79050,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ff1355ddfec918113d5a0fd5cc0e69d3","RawContent":"&lt;p&gt;I can&#039;t view any of your attachments, is there anyway you can you email me directly - VERY interested!!! &amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;danamarielouise@hotmail.com&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;THANKS!!!&lt;\/p&gt;","Attachments":[],"Id":1892843,"PostDate":1428854758,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I can't view any of your attachments, is there anyway you can you email me directly - VERY interested!!! \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>danamarielouise@hotmail.com<\/p>\n<p>\u00a0<\/p>\n<p>THANKS!!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"danamarielouise@hotmail.com","IpAddress":"24.89.226.42","GroupId":39,"GroupName":"Newbie","JoinDate":1393261367,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Danamarielouise","Id":276863,"Name":"Danamarielouise","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"73.43.251.19","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79050,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9e1a15875b693d08d72d735d87e6670b","RawContent":"@[member=\"jnvoigt\"] Thanks so much for posting! I can&#039;t open the attachments. Can you please email them to me at rebeccalightsey@yahoo.com? Thank you!!!","Attachments":[],"Id":1893135,"PostDate":1429041980,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"282082\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282082-jnvoigt\/' title='Member profile'><span itemprop=\"name\">jnvoigt<\/span><\/a> Thanks so much for posting! I can't open the attachments. Can you please email them to me at rebeccalightsey@yahoo.com? Thank you!!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rebeccalightsey@yahoo.com","IpAddress":"74.190.197.204","GroupId":39,"GroupName":"Newbie","JoinDate":1405539863,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279045.jpg?_r=1434956018","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"RebeLight","Id":279045,"Name":"RebeLight","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.94.109.103","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79050,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b160b30b45f81b14e813500ca187622e","RawContent":"I would also love to see everything! If you wouldnt mind...my email is jaspbri0317@aol.com thank you [emoji2]","Attachments":[],"Id":1893159,"PostDate":1429054130,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I would also love to see everything! If you wouldnt mind...my email is jaspbri0317@aol.com thank you [emoji2] \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jaspbri0317@aol.com","IpAddress":"71.58.144.195","GroupId":39,"GroupName":"Newbie","JoinDate":1296673627,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-236302.jpg?_r=1429022808","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"jaspbri0317","Id":236302,"Name":"jaspbri0317","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"206.74.64.116","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79050,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"607356033be3aa092c816e0df5b9789b","RawContent":"&lt;p&gt;@&lt;span&gt;&lt;a  class=\"\" href=\"http:\/\/www.bestdestinationwedding.com\/user\/282082-jnvoigt\/\" title=\"\"&gt;&lt;span&gt;jnvoigt&lt;\/span&gt;&lt;\/a&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thank you so much for sharing! You had the cutest ideas!!&amp;nbsp; Looks like you had an amazing wedding!&amp;nbsp; Its so funny you said that about the dress, because I just posted on here about flying with your dress!!&amp;nbsp; I have one- question?&amp;nbsp; How did you do with the heat?&amp;nbsp; Were your guests very hot sitting in the sun during the ceremony.&amp;nbsp; How was the reception outdoors?&amp;nbsp; Thank you so much!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Christine&lt;\/p&gt;","Attachments":[],"Id":1893590,"PostDate":1429409704,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<span><a href='http:\/\/www.bestdestinationwedding.com\/user\/282082-jnvoigt\/' class='bbc_url' title=''><span>jnvoigt<\/span><\/a><\/span><\/p>\n<p>\u00a0<\/p>\n<p>Thank you so much for sharing! You had the cutest ideas!!\u00a0 Looks like you had an amazing wedding!\u00a0 Its so funny you said that about the dress, because I just posted on here about flying with your dress!!\u00a0 I have one- question?\u00a0 How did you do with the heat?\u00a0 Were your guests very hot sitting in the sun during the ceremony.\u00a0 How was the reception outdoors?\u00a0 Thank you so much!<\/p>\n<p>\u00a0<\/p>\n<p>Christine<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cwright1320@yahoo.com","IpAddress":"72.230.115.231","GroupId":39,"GroupName":"Newbie","JoinDate":1388150678,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Cwright","Id":275744,"Name":"Cwright","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"98.25.136.128","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79050,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"64dcca95979dc28396a39e7cfa2a68b2","RawContent":"Hey Christine\n\nThanks and yes it was ! The heat was only bad at the ceremony  which was at 430 pm and it felt like it was beating on us. I gave everyone paper fans so they were ok but we were hot. My hubby was sweating when he walked back down the Isle with me for sure ! But as soon as we were done and could get some shade we were good. The reception was great and it didn&#039;t feel too hot at all. Some guys did change to shorts though !\n\nHope that helps and good luck with the planning !","Attachments":[],"Id":1893871,"PostDate":1429649125,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hey Christine<br>\nThanks and yes it was ! The heat was only bad at the ceremony  which was at 430 pm and it felt like it was beating on us. I gave everyone paper fans so they were ok but we were hot. My hubby was sweating when he walked back down the Isle with me for sure ! But as soon as we were done and could get some shade we were good. The reception was great and it didn't feel too hot at all. Some guys did change to shorts though !<br>\nHope that helps and good luck with the planning !\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jnvoigt@yahoo.com","IpAddress":"66.56.187.156","GroupId":39,"GroupName":"Newbie","JoinDate":1423648807,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282082.jpg?_r=1428850100","PhotoWidth":200,"PhotoHeight":146,"PhotoType":"custom"},"FormattedName":"jnvoigt","Id":282082,"Name":"jnvoigt","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.90.27.19","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79050,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a86030e1175449a81915c0f63f6a6d8b","RawContent":"&lt;p&gt;Hey Jess-&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp; I couldn&#039;t open the attachments either. &amp;nbsp;Mind emailing them to me? &amp;nbsp;Becksnfx@[member=\"gmail\"].com. &amp;nbsp;I&#039;m an April 2016 bride.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thanks!&lt;\/p&gt;","Attachments":[],"Id":1896662,"PostDate":1432123379,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hey Jess-<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0 I couldn't open the attachments either. \u00a0Mind emailing them to me? \u00a0Becksnfx@<a hovercard-ref=\"member\" hovercard-id=\"219734\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/219734-gmail\/' title='Member profile'><span itemprop=\"name\">gmail<\/span><\/a>.com. \u00a0I'm an April 2016 bride.<\/p>\n<p>\u00a0<\/p>\n<p>Thanks!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"becksnfx@gmail.com","IpAddress":"70.90.27.19","GroupId":39,"GroupName":"Newbie","JoinDate":1432123228,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"becksnfx","Id":283173,"Name":"becksnfx","IsOnline":false}}],"Id":"79050","Title":"Now Larimar Review !","LastPostDate":1432123379},"Pages":{"TotalItems":8,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
