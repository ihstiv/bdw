Request Time: 1 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":10,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":575,"MovedTo":null,"MovedOn":0,"FirstPostId":1895929,"Rating":0,"RatingHits":0,"Starter":{"Id":282892,"Name":"FutureMrsVanthof","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282892.jpg?_r=1434622094","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"StartDate":1431355944,"LastPoster":{"Id":284150,"Name":"CassM0130","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":22,"Preview":{"Id":1901195,"PostDate":1437946624,"PostContent":"I'm in Truro and planning for May 2017 at either Memories or Royalton. We are meeting with a TA t...","Author":{"Signature":"","Email":"cass_y123@msn.com","IpAddress":"156.57.9.30","GroupId":39,"GroupName":"Newbie","JoinDate":1437946354,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"CassM0130","Id":284150,"Name":"CassM0130","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"142.67.2.225","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79175,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9cff4073248853ecdcd8e925f2cd000a","RawContent":"&lt;p&gt;Hi Brides!&lt;\/p&gt;\n&lt;p&gt;Just wondering if there are any brides on here currently in the process of deciding on a resort for March 2016? I am having a hard time deciding between Punta Cana, Jamacia, or Cuba!! Anyone have any info on whether they have been given a group rate that matches with my own budget ($1200-$1500pp).&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I LOVE Now Larimar in Punta Cana, and the Majestic Colonal Punta Cana .. not so struck on any other resorts yet..&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;any feedback is appreciated :) :)&lt;\/p&gt;","Attachments":[],"Id":1895929,"PostDate":1431355944,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Brides!<\/p>\n<p>Just wondering if there are any brides on here currently in the process of deciding on a resort for March 2016? I am having a hard time deciding between Punta Cana, Jamacia, or Cuba!! Anyone have any info on whether they have been given a group rate that matches with my own budget ($1200-$1500pp).<\/p>\n<p>\u00a0<\/p>\n<p>I LOVE Now Larimar in Punta Cana, and the Majestic Colonal Punta Cana .. not so struck on any other resorts yet..<\/p>\n<p>\u00a0<\/p>\n<p>any feedback is appreciated <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ton_03@hotmail.com","IpAddress":"142.67.2.225","GroupId":39,"GroupName":"Newbie","JoinDate":1430216976,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282892.jpg?_r=1434622094","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"FutureMrsVanthof","Id":282892,"Name":"FutureMrsVanthof","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"47.55.202.50","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79175,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"f6e6a4320f0028b3cbfb06de9845de3a","RawContent":"&lt;p&gt;Hey, from Truro and just got married at the Now Larimar! &amp;nbsp;Haven&#039;t written a full wedding review yet, but inbox me any qs you may have and I&#039;ll try to help :)&lt;\/p&gt;","Attachments":[],"Id":1895946,"PostDate":1431362493,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hey, from Truro and just got married at the Now Larimar! \u00a0Haven't written a full wedding review yet, but inbox me any qs you may have and I'll try to help <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"danamarielouise@hotmail.com","IpAddress":"24.89.226.42","GroupId":39,"GroupName":"Newbie","JoinDate":1393261367,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Danamarielouise","Id":276863,"Name":"Danamarielouise","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.228.60.204","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79175,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"01ae9d444a8421e50f0b43b60e90dac2","RawContent":"[quote name=\"FutureMrsVanthof\" post=\"1895929\" timestamp=\"1431370344\"]\nHi Brides!\nJust wondering if there are any brides on here currently in the process of deciding on a resort for March 2016? I am having a hard time deciding between Punta Cana, Jamacia, or Cuba!! Anyone have any info on whether they have been given a group rate that matches with my own budget ($1200-$1500pp).\n\nI LOVE Now Larimar in Punta Cana, and the Majestic Colonal Punta Cana .. not so struck on any other resorts yet..\n\nany feedback is appreciated :) :)[\/quote]Congrats on your engagement! You&#039;ve picked great destinations. When in March will you be traveling? To stay within\/close to budget be sure to avoid March Break otherwise you may be limited to just Cuba. March can get really expensive.","Attachments":[],"Id":1895953,"PostDate":1431378179,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>FutureMrsVanthof, on 11 May 2015 - 02:52 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hi Brides!<\/p>\n<p>Just wondering if there are any brides on here currently in the process of deciding on a resort for March 2016? I am having a hard time deciding between Punta Cana, Jamacia, or Cuba!! Anyone have any info on whether they have been given a group rate that matches with my own budget ($1200-$1500pp).<\/p>\n<p>\u00a0<\/p>\n<p>I LOVE Now Larimar in Punta Cana, and the Majestic Colonal Punta Cana .. not so struck on any other resorts yet..<\/p>\n<p>\u00a0<\/p>\n<p>any feedback is appreciated <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<\/div>\n<\/div><\/div>\n<p>Congrats on your engagement! You've picked great destinations. When in March will you be traveling? To stay within\/close to budget be sure to avoid March Break otherwise you may be limited to just Cuba. March can get really expensive.\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"theniylife@gmail.com","IpAddress":"99.228.60.204","GroupId":39,"GroupName":"Newbie","JoinDate":1430519880,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"1weddingirl","Id":282948,"Name":"1weddingirl","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.192.100.183","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79175,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"eb33f0171dc2f2e5f8093790ad58defb","RawContent":"Thank you!! We are actually going march break!! One of my good friends is a teacher so we have to !! \n\nI know it sucks the prices are higher and resorts will be filled with kids probably ... But I have no other choice !","Attachments":[],"Id":1895978,"PostDate":1431407047,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thank you!! We are actually going march break!! One of my good friends is a teacher so we have to !! <br>\nI know it sucks the prices are higher and resorts will be filled with kids probably ... But I have no other choice !\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ton_03@hotmail.com","IpAddress":"142.67.2.225","GroupId":39,"GroupName":"Newbie","JoinDate":1430216976,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282892.jpg?_r=1434622094","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"FutureMrsVanthof","Id":282892,"Name":"FutureMrsVanthof","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79175,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ca70785c882c759e3475dfa42e53cd4b","RawContent":"&lt;p&gt;@[member=\"FutureMrsVanthof\"] This is probably one of the most overwhelming stages of planning a destination wedding - all of the choices! Have you connected with a travel agent yet? If not, that&#039;s one of the first things you should do so that you can get some expert advice\/guidance. Once you secure your location it will get a bit easier :)&lt;\/p&gt;","Attachments":[],"Id":1895990,"PostDate":1431420464,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"282892\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282892-futuremrsvanthof\/' title='Member profile'><span itemprop=\"name\">FutureMrsVanthof<\/span><\/a> This is probably one of the most overwhelming stages of planning a destination wedding - all of the choices! Have you connected with a travel agent yet? If not, that's one of the first things you should do so that you can get some expert advice\/guidance. Once you secure your location it will get a bit easier <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419423414,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1436293677","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"142.67.2.225","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79175,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"583679dd2b6c3e8dffc5637f3219a558","RawContent":"&lt;p&gt;@&lt;span&gt;&lt;a  class=\"\" href=\"http:\/\/www.bestdestinationwedding.com\/user\/281478-perianjay\/\" title=\"\"&gt;&lt;span&gt;perianjay&lt;\/span&gt;&lt;\/a&gt;&lt;\/span&gt; .. it is SOOO overwhelming :huh: !! I just met with a travel agent yesterday, she sent off some resorts for quotes to her suppliers, now just waiting to hear back! I hope it will be easier to narrow it down based on the rates i get back! and I&#039;m really hoping my dreams aren&#039;t crushed by unrealistic expectations for rates! :wacko:&lt;\/p&gt;","Attachments":[],"Id":1895993,"PostDate":1431422530,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<span><a href='http:\/\/www.bestdestinationwedding.com\/user\/281478-perianjay\/' class='bbc_url' title=''><span>perianjay<\/span><\/a><\/span> .. it is SOOO overwhelming <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/huh.png' class='bbc_emoticon' alt=':huh:' \/> !! I just met with a travel agent yesterday, she sent off some resorts for quotes to her suppliers, now just waiting to hear back! I hope it will be easier to narrow it down based on the rates i get back! and I'm really hoping my dreams aren't crushed by unrealistic expectations for rates! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wacko.png' class='bbc_emoticon' alt=':wacko:' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ton_03@hotmail.com","IpAddress":"142.67.2.225","GroupId":39,"GroupName":"Newbie","JoinDate":1430216976,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282892.jpg?_r=1434622094","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"FutureMrsVanthof","Id":282892,"Name":"FutureMrsVanthof","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79175,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"4dd24d432db931c2a0029a9d36447792","RawContent":"&lt;p&gt;@[member=\"FutureMrsVanthof\"] I&#039;ll be honest with you, my expecations of rates were a lot lower than what I ended up going with. I didn&#039;t want to base it solely on price because I still wanted to have my wedding somewhere that I loved. Price is definitely a factor, but if you get quotes back and the resort you really love isn&#039;t that much more than the others, then maybe just think it over and weigh out the pros and cons.&lt;\/p&gt;","Attachments":[],"Id":1895996,"PostDate":1431425647,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"282892\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282892-futuremrsvanthof\/' title='Member profile'><span itemprop=\"name\">FutureMrsVanthof<\/span><\/a> I'll be honest with you, my expecations of rates were a lot lower than what I ended up going with. I didn't want to base it solely on price because I still wanted to have my wedding somewhere that I loved. Price is definitely a factor, but if you get quotes back and the resort you really love isn't that much more than the others, then maybe just think it over and weigh out the pros and cons.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419423414,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1436293677","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"216.13.70.77","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79175,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"ca126a56d8fa03d6d9aad7aff063877e","RawContent":"&lt;p&gt;@[member=\"FutureMrsVanthof\"]&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;like @[member=\"perianjay\"], i also planned on my guests paying less than what they are being asked to pay. at the end of the day, the price is still reasonable and checked off every \"must have\" on our list.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;initially i was set on march break (because of my teacher friends) and&amp;nbsp;anywhere but cuba. the rates i was getting back for \"smaller\" resorts that met our criteria&amp;nbsp;were astronomical. i couldn&#039;t imagine my wedding without two of my best friends there (the teachers), but i also couldnt imagine asking guests to pay $2200+. i talked to my girls and they both said \"i will make this work\". we are still in the process of having people put down their deposits for our june 2016 wedding and my one teacher friends is able to come saturday through wednesday and my other teacher friend has applied for the days off.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;anything is possible. i made sure we were getting married at the beginning of our trip so that even if they could only get away for a few days, they could be there with us on the big day.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;if the rates you get back are much higher than you expect, don&#039;t be discouraged...play around with the dates (maybe over a long weekend so the teacher doesn&#039;t have to take so many days off?). picking a resort and trying to make everyone happy is SUPER hard...as is getting people to pay their deposit. thats as far as i&#039;ve gotten in our planning but from what i read on here, these are the two toughest things.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;good luck!&lt;\/p&gt;","Attachments":[],"Id":1896016,"PostDate":1431437987,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"282892\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282892-futuremrsvanthof\/' title='Member profile'><span itemprop=\"name\">FutureMrsVanthof<\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>like @<a hovercard-ref=\"member\" hovercard-id=\"281478\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281478-perianjay\/' title='Member profile'><span itemprop=\"name\">perianjay<\/span><\/a>, i also planned on my guests paying less than what they are being asked to pay. at the end of the day, the price is still reasonable and checked off every \"must have\" on our list.<\/p>\n<p>\u00a0<\/p>\n<p>initially i was set on march break (because of my teacher friends) and\u00a0anywhere but cuba. the rates i was getting back for \"smaller\" resorts that met our criteria\u00a0were astronomical. i couldn't imagine my wedding without two of my best friends there (the teachers), but i also couldnt imagine asking guests to pay $2200+. i talked to my girls and they both said \"i will make this work\". we are still in the process of having people put down their deposits for our june 2016 wedding and my one teacher friends is able to come saturday through wednesday and my other teacher friend has applied for the days off.<\/p>\n<p>\u00a0<\/p>\n<p>anything is possible. i made sure we were getting married at the beginning of our trip so that even if they could only get away for a few days, they could be there with us on the big day.<\/p>\n<p>\u00a0<\/p>\n<p>if the rates you get back are much higher than you expect, don't be discouraged...play around with the dates (maybe over a long weekend so the teacher doesn't have to take so many days off?). picking a resort and trying to make everyone happy is SUPER hard...as is getting people to pay their deposit. thats as far as i've gotten in our planning but from what i read on here, these are the two toughest things.<\/p>\n<p>\u00a0<\/p>\n<p>good luck!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>My Planning Thread: <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79377-ashhtayys-planning-thread-azul-fives-june-7-2016\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79377-ashhtayys-planning-thread-azul-fives-june-7-2016\/<\/a><br>\n\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;0;116\/st\/20160607\/e\/Our+Wedding\/dt\/1\/k\/bb99\/event.png\" alt=\"event.png\"><\/a>","Email":"ashley.taylor@live.ca","IpAddress":"184.147.135.4","GroupId":40,"GroupName":"Jr. Member","JoinDate":1423090661,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282006.png?_r=1423373502","PhotoWidth":200,"PhotoHeight":138,"PhotoType":"custom"},"FormattedName":"ashhtayy","Id":282006,"Name":"ashhtayy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.15.187","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79175,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b01b0610e8b42ec945b5635ec1bcee47","RawContent":"&lt;p&gt;What about the possibility of going when school is out in June? Don&#039;t know if that&#039;s an option that might work for you. Do you have a travel agent yet that you&#039;re working with? They will become your best friend over the next while and will help you with choosing your destination and trying to get you a price point close to what you want. I will say this - getting a rate of $1200 - $1500 during March break, south, out of Nova Scotia sounds like a tall order to me. I don&#039;t know if you can even get a rate like that out of Toronto.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck!&lt;\/p&gt;","Attachments":[],"Id":1896098,"PostDate":1431476459,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>What about the possibility of going when school is out in June? Don't know if that's an option that might work for you. Do you have a travel agent yet that you're working with? They will become your best friend over the next while and will help you with choosing your destination and trying to get you a price point close to what you want. I will say this - getting a rate of $1200 - $1500 during March break, south, out of Nova Scotia sounds like a tall order to me. I don't know if you can even get a rate like that out of Toronto.<\/p>\n<p>\u00a0<\/p>\n<p>Good luck!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"156.57.9.30","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79175,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6497a2acfcdc9381a4de0fb782776bff","RawContent":"I&#039;m in Truro and planning for May 2017 at either Memories or Royalton. We are meeting with a TA this week to get some quotes and to get the ball rolling with planning for our guests!","Attachments":[],"Id":1901195,"PostDate":1437946624,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm in Truro and planning for May 2017 at either Memories or Royalton. We are meeting with a TA this week to get some quotes and to get the ball rolling with planning for our guests!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cass_y123@msn.com","IpAddress":"156.57.9.30","GroupId":39,"GroupName":"Newbie","JoinDate":1437946354,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"CassM0130","Id":284150,"Name":"CassM0130","IsOnline":false}}],"Id":"79175","Title":"2016 Brides From Nova Scotia, Canada?","LastPostDate":1437946624},"Pages":{"TotalItems":10,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
