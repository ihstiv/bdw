":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-216180.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"pvbeachbride10","Id":216180,"Name":"pvbeachbride10","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"541c25b9c82d327a88bb0728e3d8259c","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;Dee83&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;This is my TTD dress...I think it would look gorgeous in pictures\n &lt;img src=\"http:\/\/image.lightinthebox.com\/images\/v\/200903\/156922191849ba650d6c6e9.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;\n That is a cool dress!!!","Attachments":[],"Id":700321,"PostDate":1243054654,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>Dee83<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">This is my TTD dress...I think it would look gorgeous in pictures<br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/image.lightinthebox.com\/images\/v\/200903\/156922191849ba650d6c6e9.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><\/div> <\/td> <\/tr> <\/table> <\/div><br \/> That is a cool dress!!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>I have a fabulous photographer I can share in the United States Virgin Islands in late April\/early MayP.M. if interested!<\/span><a data-ipb='nomediaparse' href=\"http:\/\/img.weddingcountdown.com\/ticker\/goppvbh7hxc5u.png\">http:\/\/img.weddingcountdown.com\/tick...pvbh7hxc5u.png<\/a><\/div><\/div>","Email":"cjmcdowell16@yahoo.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1241916601,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-217403.gif?_r=0","PhotoWidth":100,"PhotoHeight":33,"PhotoType":"custom"},"FormattedName":"CrystalM","Id":217403,"Name":"CrystalM","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a19d93fdc5cab935c8f5c0af1351209d","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;pvbeachbride10&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;I found a dress from Landy Bridal that I am thinking about ordering: &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.landybridal.com\/Product\/Pro2654.html\"&gt;wedding dress (HS1583)-wedding dress,prom gown and bridesmaid dress by landy bridal&lt;\/a&gt;. I wish I knew who the original person was. Anyways, it&#039;s so pretty!\n \n This thread is awesome!&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;I searched and could not figure it out, so I emailed her to see who the original designer is. Some other people asked on the site but she had not answered. She told me its an old Linea Raffaelli. I couldn&#039;t find pics so it must discontinued. I hadn&#039;t heard of this designer, but thats probably cause the dresses arent sold in the US. But I looked up the designers site and the dresses are AMAZING!","Attachments":[],"Id":700356,"PostDate":1243064632,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>pvbeachbride10<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">I found a dress from Landy Bridal that I am thinking about ordering: <a href='http:\/\/www.landybridal.com\/Product\/Pro2654.html' class='bbc_url' title='External link' rel='nofollow external'>wedding dress (HS1583)-wedding dress,prom gown and bridesmaid dress by landy bridal<\/a>. I wish I knew who the original person was. Anyways, it's so pretty!<br \/> <br \/> This thread is awesome!<\/div> <\/td> <\/tr> <\/table> <\/div>I searched and could not figure it out, so I emailed her to see who the original designer is. Some other people asked on the site but she had not answered. She told me its an old Linea Raffaelli. I couldn't find pics so it must discontinued. I hadn't heard of this designer, but thats probably cause the dresses arent sold in the US. But I looked up the designers site and the dresses are AMAZING!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Photo by <\/span><a data-ipb='nomediaparse' href=\"http:\/\/www.dlweddings.com\">www.dlweddings.com<\/a><br><br><span>My Planning Thread<\/span><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t46588\">http:\/\/bestdestinationwedding.com\/forum\/t46588<\/a><span>My Wedding Review w\/ Lots of Pics<\/span><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t48352\">http:\/\/bestdestinationwedding.com\/forum\/t48352<\/a><span>Our TTD pics<\/span><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t48445\">http:\/\/bestdestinationwedding.com\/forum\/t48445<\/a><\/div><\/div>","Email":"jacilyn.m.gannon@gmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1212460200,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209727.jpg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Jacilynda","Id":209727,"Name":"Jacilynda","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c483861a19b0ad54ccd8b9abf921ad81","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;Jacilynda&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Savannah what is the name of this ebay seller?&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;They are listed as gianinarbridal on Ebay. The email responses come back thru as &lt;a data-ipb=&#039;nomediaparse&#039; href=\"mailto:ebridalstore@hotmail.com\"&gt;ebridalstore@hotmail.com&lt;\/a&gt;.\n \n I gotta ask (since I love the organization of the web site!) has anyone on BDW that we know if actually ordered and received a duoshong dress yet? And what are the prices like? I&#039;m trying to weed through posts now..","Attachments":[],"Id":700386,"PostDate":1243081971,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>Jacilynda<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Savannah what is the name of this ebay seller?<\/div> <\/td> <\/tr> <\/table> <\/div>They are listed as gianinarbridal on Ebay. The email responses come back thru as <a href='mailto:ebridalstore@hotmail.com' class='bbc_url' title='External link' rel='nofollow external'>ebridalstore@hotmail.com<\/a>.<br \/> <br \/> I gotta ask (since I love the organization of the web site!) has anyone on BDW that we know if actually ordered and received a duoshong dress yet? And what are the prices like? I'm trying to weed through posts now..\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"Savannah<br \/>\n<br \/>\n<a class='bbc_url' href='http:\/\/i17.photobucket.com\/albums\/b85\/QuadMom\/Kids1linecollage.jpg'>http:\/\/i17.photobucket.com\/albums\/b8...inecollage.jpg<\/a><strong class='bbc'>The Fab Four (my quads) Meryn, Kellen, Nico & Layla<\/strong><br \/>\n<a class='bbc_url' href='http:\/\/global.theknot.com\/tools\/tickers\/tt265ad.aspx'>http:\/\/global.theknot.com\/tools\/tickers\/tt265ad.aspx<\/a><a class='bbc_url' href='http:\/\/www.mywedding.com\/williamandsavannah\/index.html'>http:\/\/www.mywedding.com\/williamandsavannah\/index.html<\/a><strong class='bbc'>20 STD's w. pre-lim RSVP sent 6\/15\/09: 7 \"Yes\" so far\/10 guests total!<\/strong>","Email":"savvy1120@yahoo.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1190575920,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207776.gif?_r=0","PhotoWidth":100,"PhotoHeight":99,"PhotoType":"custom"},"FormattedName":"BillysBride","Id":207776,"Name":"BillysBride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"28e94d0fb6ee4f9259fe7060355804da","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;Jacilynda&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;I searched and could not figure it out, so I emailed her to see who the original designer is. Some other people asked on the site but she had not answered. She told me its an old Linea Raffaelli. I couldn&#039;t find pics so it must discontinued. I hadn&#039;t heard of this designer, but thats probably cause the dresses arent sold in the US. But I looked up the designers site and the dresses are AMAZING!&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;Thanks so much! That&#039;s very helpful. I am running off to check out their website now. Woohoo!","Attachments":[],"Id":700513,"PostDate":1243099340,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>Jacilynda<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">I searched and could not figure it out, so I emailed her to see who the original designer is. Some other people asked on the site but she had not answered. She told me its an old Linea Raffaelli. I couldn't find pics so it must discontinued. I hadn't heard of this designer, but thats probably cause the dresses arent sold in the US. But I looked up the designers site and the dresses are AMAZING!<\/div> <\/td> <\/tr> <\/table> <\/div>Thanks so much! That's very helpful. I am running off to check out their website now. Woohoo!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"meghan.havill@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1238089405,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-216180.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"pvbeachbride10","Id":216180,"Name":"pvbeachbride10","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"57d69eedea08833ee7e94a6887029b52","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;pvbeachbride10&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;I found a dress from Landy Bridal that I am thinking about ordering: &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.landybridal.com\/Product\/Pro2654.html\"&gt;wedding dress (HS1583)-wedding dress,prom gown and bridesmaid dress by landy bridal&lt;\/a&gt;. I wish I knew who the original person was. Anyways, it&#039;s so pretty!\n \n This thread is awesome!&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;I really like this dress!! Let us know how it turns out if you order it.","Attachments":[],"Id":700531,"PostDate":1243102507,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>pvbeachbride10<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">I found a dress from Landy Bridal that I am thinking about ordering: <a href='http:\/\/www.landybridal.com\/Product\/Pro2654.html' class='bbc_url' title='External link' rel='nofollow external'>wedding dress (HS1583)-wedding dress,prom gown and bridesmaid dress by landy bridal<\/a>. I wish I knew who the original person was. Anyways, it's so pretty!<br \/> <br \/> This thread is awesome!<\/div> <\/td> <\/tr> <\/table> <\/div>I really like this dress!! Let us know how it turns out if you order it.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/img.weddingcountdown.com\/ticker\/8vbdydmgt.png\">http:\/\/img.weddingcountdown.com\/ticker\/8vbdydmgt.png<\/a><br><br><br><span>[SIGPIC][SIGPIC][\/SIGP<\/span><br><span>[\/SIGPIC] <\/span><strong><i>40 PEOPLE BOOKED!!!<\/i><\/strong><\/div><\/div>","Email":"djade14@msn.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1230659343,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213429.gif?_r=0","PhotoWidth":75,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"DarcyJAde","Id":213429,"Name":"DarcyJAde","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bdccbac38c0d066097ea9424425a4d4c","RawContent":"I&#039;m still deciding between 2 styles...\n Paloma Blanca 3802- &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.landybridal.com\/Product\/Pro2572.html\"&gt;wedding dress (HS8145)-wedding dress,prom gown and bridesmaid dress by landy bridal&lt;\/a&gt; and \n San Patrick- Binefar \n &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.kaersen.com\/shopexd.asp?id=8966\"&gt;- San Patrick Wedding Dresses Style 8854 Wedding Dresses, Bridesmaid Gowns, Mother of the Bride Dresses, Flower Girl Dresses&lt;\/a&gt; - the dress was listed as $299 for weeks and suddenly now it&#039;s $345, whaaat?\n &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.duosheng.cn\/shangweb\/xihun\/CHIC-171.html\"&gt;\u0160\u00b1\u008f\u2014\u00ae\u02c6\u00a8\u008d\u00be\u00b5\u201e\u0160\u00b1\u2030\u0090\u2020\u00b7\u2026\u2020\u00b7\u00be\u0160\u017d&lt;\/a&gt; - (it&#039;s Duosheng) Should I be weirded out that the website is showing up in characters and not in English?","Attachments":[],"Id":701257,"PostDate":1243217544,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm still deciding between 2 styles...<br \/> Paloma Blanca 3802- <a href='http:\/\/www.landybridal.com\/Product\/Pro2572.html' class='bbc_url' title='External link' rel='nofollow external'>wedding dress (HS8145)-wedding dress,prom gown and bridesmaid dress by landy bridal<\/a> and <br \/> San Patrick- Binefar <br \/> <a href='http:\/\/www.kaersen.com\/shopexd.asp?id=8966' class='bbc_url' title='External link' rel='nofollow external'>- San Patrick Wedding Dresses Style 8854 Wedding Dresses, Bridesmaid Gowns, Mother of the Bride Dresses, Flower Girl Dresses<\/a> - the dress was listed as $299 for weeks and suddenly now it's $345, whaaat?<br \/> <a href='http:\/\/www.duosheng.cn\/shangweb\/xihun\/CHIC-171.html' class='bbc_url' title='External link' rel='nofollow external'>\u0160\u00b1\u008f\u2014\u00ae\u02c6\u00a8\u008d\u00be\u00b5\u201e\u0160\u00b1\u2030\u0090\u2020\u00b7\u2026\u2020\u00b7\u00be\u0160\u017d<\/a> - (it's Duosheng) Should I be weirded out that the website is showing up in characters and not in English?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"geminigem615@aol.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1231200988,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213622.gif?_r=0","PhotoWidth":75,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"KimmyG","Id":213622,"Name":"KimmyG","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d66a4ce6cc89bda11e7dc61e21bb1fc1","RawContent":"Kimmy I really like the Paloma. the only thing that really bothers me about Duoscheng is that they have to send you a payment request or you have to pay thru western union (I&#039;m not fond of ) or bank transfer which I&#039;m also not fond of that, maybe if it was to my mom, but not some random company. I found out Duosheng has an ebay store from an australian wedding forum here is their store:\n \n &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/myworld.ebay.com\/smt-weddingstore\"&gt;eBay My World - smt-weddingstore&lt;\/a&gt;\n \n So you can see some feedback. Most of their ebay transactions are shoes. all I&#039;ve read about their dresses is they seem to have measurements off a few inches.","Attachments":[],"Id":701303,"PostDate":1243221608,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Kimmy I really like the Paloma. the only thing that really bothers me about Duoscheng is that they have to send you a payment request or you have to pay thru western union (I'm not fond of ) or bank transfer which I'm also not fond of that, maybe if it was to my mom, but not some random company. I found out Duosheng has an ebay store from an australian wedding forum here is their store:<br \/> <br \/> <a href='http:\/\/myworld.ebay.com\/smt-weddingstore' class='bbc_url' title='External link' rel='nofollow external'>eBay My World - smt-weddingstore<\/a><br \/> <br \/> So you can see some feedback. Most of their ebay transactions are shoes. all I've read about their dresses is they seem to have measurements off a few inches.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Photo by <\/span><a data-ipb='nomediaparse' href=\"http:\/\/www.dlweddings.com\">www.dlweddings.com<\/a><br><br><span>My Planning Thread<\/span><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t46588\">http:\/\/bestdestinationwedding.com\/forum\/t46588<\/a><span>My Wedding Review w\/ Lots of Pics<\/span><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t48352\">http:\/\/bestdestinationwedding.com\/forum\/t48352<\/a><span>Our TTD pics<\/span><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t48445\">http:\/\/bestdestinationwedding.com\/forum\/t48445<\/a><\/div><\/div>","Email":"jacilyn.m.gannon@gmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1212460200,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209727.jpg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Jacilynda","Id":209727,"Name":"Jacilynda","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f0561a13e2c33df3b18e193437f4371f","RawContent":"Thanks for the advice, Jacilynda. I wouldn&#039;t trust a bank transfer for something like this. I wouldn&#039;t work with someone who doesn&#039;t accept paypal\/credit card, just to play it safe. \n The Paloma Blanca was the first dress I tried on and fell in love with so I know I would be happy with it. I took my FMIL dress shopping and we picked out the San Patrick and I fell in love with that one too! Such hard decisions. I&#039;d be temped to get both, but even as knock-offs it wouldn&#039;t be cheap to get both!! Or maybe it would? $600 (+shipping) to have 2 options, hmmm.... Still a lot of moolahh","Attachments":[],"Id":701308,"PostDate":1243222071,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks for the advice, Jacilynda. I wouldn't trust a bank transfer for something like this. I wouldn't work with someone who doesn't accept paypal\/credit card, just to play it safe. <br \/> The Paloma Blanca was the first dress I tried on and fell in love with so I know I would be happy with it. I took my FMIL dress shopping and we picked out the San Patrick and I fell in love with that one too! Such hard decisions. I'd be temped to get both, but even as knock-offs it wouldn't be cheap to get both!! Or maybe it would? $600 (+shipping) to have 2 options, hmmm.... Still a lot of moolahh\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"geminigem615@aol.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1231200988,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213622.gif?_r=0","PhotoWidth":75,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"KimmyG","Id":213622,"Name":"KimmyG","IsOnline":false}}],"Pages":{"TotalItems":6399,"TotalPages":640,"CurrentPage":70,"NextPage":80,"PreviousPage":60,"LastPage":6390},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
