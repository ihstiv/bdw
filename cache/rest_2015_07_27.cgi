Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":4,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":840,"MovedTo":null,"MovedOn":0,"FirstPostId":1888652,"Rating":0,"RatingHits":0,"Starter":{"Id":281612,"Name":"Alicia328","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1425730573,"LastPoster":{"Id":282047,"Name":"dathotgal","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282047.jpg?_r=1436938666","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":23,"Preview":{"Id":1888652,"PostDate":1425730573,"PostContent":"Hi everyone! Has anyone worked with a wedding planner known as Wedding Belles Jamaica? There is b...","Author":{"Signature":"","Email":"alicia.wm.yeh@gmail.com","IpAddress":"184.151.179.189","GroupId":39,"GroupName":"Newbie","JoinDate":1420495609,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Alicia328","Id":281612,"Name":"Alicia328","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.162.169.120","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78882,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"212bebb51e2f1ac4b39ca285ca261cb5","RawContent":"Hi everyone!\n\n\nHas anyone worked with a wedding planner known as Wedding Belles Jamaica? There is barely any independent reviews on this company, however they claim to be executive producers of te Jamaican bridal expo, which is apparently a big deal in Jamaica?  \n\n\nI&#039;ve been corresponding with the owner of Wedding Belles Jamaica named Jo-Anne. I wanted read more reviews before deciding whether or not I should use this wedding planner. \n\n\nIf anyone has an input\/reviews on this wedding planning company, please share. \n\n\nThank you in advance for your help!","Attachments":[],"Id":1888652,"PostDate":1425730573,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi everyone!<br><br>\nHas anyone worked with a wedding planner known as Wedding Belles Jamaica? There is barely any independent reviews on this company, however they claim to be executive producers of te Jamaican bridal expo, which is apparently a big deal in Jamaica?  <br><br>\nI've been corresponding with the owner of Wedding Belles Jamaica named Jo-Anne. I wanted read more reviews before deciding whether or not I should use this wedding planner. <br><br>\nIf anyone has an input\/reviews on this wedding planning company, please share. <br><br>\nThank you in advance for your help! \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"alicia.wm.yeh@gmail.com","IpAddress":"184.151.179.189","GroupId":39,"GroupName":"Newbie","JoinDate":1420495609,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Alicia328","Id":281612,"Name":"Alicia328","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.244.36.137","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78882,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a6e4d6db561f474cf097ed0803fec336","RawContent":"&lt;p&gt;Hey dear, I have worked with Belles Jamaica. This planning company is wonderful. For my son\u2019s birthday party I hired them. The &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/eventup.com\/&#039;&gt;party planner&lt;\/a&gt; was very talented. She was very polite too. You can use their services without any worries.&lt;\/p&gt;","Attachments":[],"Id":1888840,"PostDate":1425983470,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hey dear, I have worked with Belles Jamaica. This planning company is wonderful. For my son\u2019s birthday party I hired them. The <a href='https:\/\/eventup.com\/' class='bbc_url' title='External link' rel='nofollow external'>party planner<\/a> was very talented. She was very polite too. You can use their services without any worries.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"garon.parer345@gmail.com","IpAddress":"155.94.227.158","GroupId":39,"GroupName":"Newbie","JoinDate":1425970344,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Kyln09","Id":282377,"Name":"Kyln09","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.186.242.129","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78882,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2fbb5b201206385272379f77f07d8df6","RawContent":"I&#039;m glad to read this! I&#039;ve been working with Joanne for a few months and she seems so amazing. Dream come true even! But I got very nervous when she informed me they only take payment via western union!","Attachments":[],"Id":1891383,"PostDate":1427780135,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm glad to read this! I've been working with Joanne for a few months and she seems so amazing. Dream come true even! But I got very nervous when she informed me they only take payment via western union! \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"isaidyes3114@gmail.com","IpAddress":"24.186.242.129","GroupId":39,"GroupName":"Newbie","JoinDate":1427779636,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282585.jpg?_r=1427779871","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"Docfabulous","Id":282585,"Name":"Docfabulous","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.101.223.7","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78882,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"173659d55a34013eca651190ffbcd4f9","RawContent":"&lt;p&gt;i would not work with them. &amp;nbsp;they wanted money up front. &amp;nbsp;i wouldnt put a deposit down if i dont know you can give me what i want.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1898573,"PostDate":1434343437,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>i would not work with them. \u00a0they wanted money up front. \u00a0i wouldnt put a deposit down if i dont know you can give me what i want.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"dathotgal51@yahoo.com","IpAddress":"173.77.182.126","GroupId":39,"GroupName":"Newbie","JoinDate":1423472325,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282047.jpg?_r=1436938666","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"dathotgal","Id":282047,"Name":"dathotgal","IsOnline":false}}],"Id":"78882","Title":"Wedding Belles Jamaica Wedding Planner","LastPostDate":1434343437},"Pages":{"TotalItems":4,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
