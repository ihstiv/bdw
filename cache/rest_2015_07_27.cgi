{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":9,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":498,"MovedTo":null,"MovedOn":0,"FirstPostId":1893490,"Rating":0,"RatingHits":0,"Starter":{"Id":279604,"Name":"Andrea2015","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"custom"},"IsOnline":false},"StartDate":1429279756,"LastPoster":{"Id":279604,"Name":"Andrea2015","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":7,"Preview":{"Id":1893490,"PostDate":1429279756,"PostContent":"Hi all, \u00a0 My wedding is about 2 and a half months away and I'm just wondering of anyone has any i...","Author":{"Signature":"","Email":"andreacorsi2012@gmail.com","IpAddress":"174.0.176.157","GroupId":39,"GroupName":"Newbie","JoinDate":1409175969,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"custom"},"FormattedName":"Andrea2015","Id":279604,"Name":"Andrea2015","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.35.26.189","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79083,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c7734aceca20f29d712792fea69779a9","RawContent":"&lt;p&gt;Hi all,&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;My wedding is about 2 and a half months away and I&#039;m just wondering of anyone has any ideas on how to keep the party going at the reception. I&#039;m just worried people won&#039;t dance or they&#039;ll get bored so if anyone has some fun ideas that would be great. I was thinking of maybe bringing fun props or something. &amp;nbsp;The resort does have a list of entertainment I can hire but it costs an arm and a leg! There will be a fun crowd going down so I&#039;m not tooooo stressed about this but now that the wedding is right around the corner I&#039;m starting to worry!!!&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1893490,"PostDate":1429279756,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi all,<\/p>\n<p>\u00a0<\/p>\n<p>My wedding is about 2 and a half months away and I'm just wondering of anyone has any ideas on how to keep the party going at the reception. I'm just worried people won't dance or they'll get bored so if anyone has some fun ideas that would be great. I was thinking of maybe bringing fun props or something. \u00a0The resort does have a list of entertainment I can hire but it costs an arm and a leg! There will be a fun crowd going down so I'm not tooooo stressed about this but now that the wedding is right around the corner I'm starting to worry!!!\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"andreacorsi2012@gmail.com","IpAddress":"174.0.176.157","GroupId":39,"GroupName":"Newbie","JoinDate":1409175969,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"custom"},"FormattedName":"Andrea2015","Id":279604,"Name":"Andrea2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.41.59","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79083,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"6567533356e1440b05444f4a10589142","RawContent":"Sorry I don&#039;t have any ideas. We just had the DJ to play music for us to dance and the dance floor was full all night. He did a lot of interactive songs - like YMCA and we had a blast. \n\n\nCongrats!!\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1893499,"PostDate":1429297981,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Sorry I don't have any ideas. We just had the DJ to play music for us to dance and the dance floor was full all night. He did a lot of interactive songs - like YMCA and we had a blast. <br><br>\nCongrats!!<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.85.127.174","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79083,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":3,"IsLiked":false,"PostKey":"7f57e13c05b465b10542219608a53673","RawContent":"&lt;p&gt;I was reading an article somewhere that suggested setting up games to play, such as croquet, giant jenga, hopscotch, etc. Some of these would require renting equipment and some may not be suitable at night, but maybe it gives you some other ideas.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;What about a photobooth? You can even set up a DIY photobooth so you don&#039;t have to rent an actual booth. Get props and let people take selfies or have a standard digital camera set up on a tripod. I&#039;ve seen brides talk about ordering props on ETSY.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.hgtv.com\/design\/make-and-celebrate\/entertaining\/how-to-set-up-your-own-diy-photo-booth&#039;&gt;http:\/\/www.hgtv.com\/design\/make-and-celebrate\/entertaining\/how-to-set-up-your-own-diy-photo-booth&lt;\/a&gt;&lt;\/p&gt;","Attachments":[],"Id":1893500,"PostDate":1429301854,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I was reading an article somewhere that suggested setting up games to play, such as croquet, giant jenga, hopscotch, etc. Some of these would require renting equipment and some may not be suitable at night, but maybe it gives you some other ideas.<\/p>\n<p>\u00a0<\/p>\n<p>What about a photobooth? You can even set up a DIY photobooth so you don't have to rent an actual booth. Get props and let people take selfies or have a standard digital camera set up on a tripod. I've seen brides talk about ordering props on ETSY.<\/p>\n<p>\u00a0<\/p>\n<p><a href='http:\/\/www.hgtv.com\/design\/make-and-celebrate\/entertaining\/how-to-set-up-your-own-diy-photo-booth' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.hgtv.com\/...diy-photo-booth<\/a><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>- Erin<\/p>\n<p>\u00a0<\/p>\n<p>My planning thread:\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268'>http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268<\/a>","Email":"ekjzwedding@gmail.com","IpAddress":"24.85.127.174","GroupId":40,"GroupName":"Jr. Member","JoinDate":1417435045,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281283.jpg?_r=1428779369","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"vancouverpetunia","Id":281283,"Name":"vancouverpetunia","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"209.91.107.210","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79083,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"50f3712eccc1ba13d02ada9885002479","RawContent":"I like the diy photo booth! My moh did that for my shower and it was a hit! I like the idea of games though!! I&#039;ll have to do some research! Thanks for the ideas!","Attachments":[],"Id":1893507,"PostDate":1429306438,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I like the diy photo booth! My moh did that for my shower and it was a hit! I like the idea of games though!! I'll have to do some research! Thanks for the ideas!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"andreacorsi2012@gmail.com","IpAddress":"174.0.176.157","GroupId":39,"GroupName":"Newbie","JoinDate":1409175969,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"custom"},"FormattedName":"Andrea2015","Id":279604,"Name":"Andrea2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.88.104.254","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79083,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"ca3ac1d0e6ace949dea9bfb4cac9de16","RawContent":"Glow sticks! I even had glow glasses","Attachments":[],"Id":1893536,"PostDate":1429347902,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Glow sticks! I even had glow glasses \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nadia.bozanich@gmail.com","IpAddress":"75.112.200.126","GroupId":40,"GroupName":"Jr. Member","JoinDate":1406722272,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"nadiakat17","Id":279229,"Name":"nadiakat17","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.41.59","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79083,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"91cc2930ab2a8a1450fb47fb5de743b1","RawContent":"Ohhh yes we had glow bracelets that we made into necklaces and head bands and people loved them.  We also had maracas as our favors that got used on the dance floor all night. \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1893538,"PostDate":1429351267,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Ohhh yes we had glow bracelets that we made into necklaces and head bands and people loved them.  We also had maracas as our favors that got used on the dance floor all night. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"187.252.52.125","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79083,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"33341e4192b210117a412daef485beb4","RawContent":"[quote name=\"Andrea2015\" post=\"1893490\" timestamp=\"1429294156\"]\nHi all,\n\nMy wedding is about 2 and a half months away and I&#039;m just wondering of anyone has any ideas on how to keep the party going at the reception. I&#039;m just worried people won&#039;t dance or they&#039;ll get bored so if anyone has some fun ideas that would be great. I was thinking of maybe bringing fun props or something.  The resort does have a list of entertainment I can hire but it costs an arm and a leg! There will be a fun crowd going down so I&#039;m not tooooo stressed about this but now that the wedding is right around the corner I&#039;m starting to worry!!![\/quote]Hey andrea2015, if you have a fun crowd they will be on the dance floor the whole night. here some of the games we have seen at some of the weddings we have planned.\nthe shoe game, super fun\ncorn hole game\nphotobooth\nwaterdrum show for your guests\n\nHappy Planning!","Attachments":[],"Id":1893542,"PostDate":1429356520,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Andrea2015, on 17 April 2015 - 02:09 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hi all,<\/p>\n<p>\u00a0<\/p>\n<p>My wedding is about 2 and a half months away and I'm just wondering of anyone has any ideas on how to keep the party going at the reception. I'm just worried people won't dance or they'll get bored so if anyone has some fun ideas that would be great. I was thinking of maybe bringing fun props or something. \u00a0The resort does have a list of entertainment I can hire but it costs an arm and a leg! There will be a fun crowd going down so I'm not tooooo stressed about this but now that the wedding is right around the corner I'm starting to worry!!!\u00a0<\/p>\n<\/div>\n<\/div><\/div>\n<p>Hey andrea2015, if you have a fun crowd they will be on the dance floor the whole night. here some of the games we have seen at some of the weddings we have planned.<\/p>\n<p>the shoe game, super fun<\/p>\n<p>corn hole game<\/p>\n<p>photobooth<\/p>\n<p>waterdrum show for your guests<\/p>\n<p>\u00a0<\/p>\n<p>Happy Planning!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Dream Weddings Riviera Maya- We pay attention to your wishes and coordinate closely with you to ensure your wedding or event is planned to perfection!<\/p>\n<p>\u00a0<\/p>\n<p><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Dream Weddings Riviera Maya<\/span><\/span><\/span><br><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">weddingsinplayadelcarmen@gmail.com<\/span><\/span><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html'>http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html<\/a><\/p>\n<p>\u00a0<\/p>\n<p><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Happy Planning!<\/span><\/span><\/span><br><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Joyce<\/span><\/span><\/span><br>\n\u00a0","Email":"weddingsinplayadelcarmen@gmail.com","IpAddress":"187.252.44.28","GroupId":49,"GroupName":"Insiders","JoinDate":1326839987,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250090.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"dreamweddings","Id":250090,"Name":"dreamweddings","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.155.94.124","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79083,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"231e2c04313be666ce521a1ebb1a6f29","RawContent":"&lt;p&gt;We&#039;re planning on doing a DIY photobooth :) but other than that just playing music all night. Maybe we&#039;ll do a scavenger hunt for pictures but I don&#039;t know if that will carry on during the reception. Maybe.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I like the idea of games but my group loves to dance so much that I think they&#039;d actually be somewhat annoyed if I kept interrupting the party for games haha. However, if there can be games set up aside and people just come and go it would be fun!&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1893560,"PostDate":1429361470,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>We're planning on doing a DIY photobooth <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> but other than that just playing music all night. Maybe we'll do a scavenger hunt for pictures but I don't know if that will carry on during the reception. Maybe.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I like the idea of games but my group loves to dance so much that I think they'd actually be somewhat annoyed if I kept interrupting the party for games haha. However, if there can be games set up aside and people just come and go it would be fun!\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<br><p><a data-ipb='nomediaparse' href='http:\/\/www.TickerFactory.com\/'><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;31;484\/st\/20150813\/e\/Wedding+time%21+\/dt\/-2\/k\/b92c\/event.png\" alt=\"event.png\"><\/a><\/p>\n<p style=\"text-align:center;\">\u00a0<\/p>\n<p style=\"text-align:center;\">\u00a0","Email":"sblopezb@gmail.com","IpAddress":"172.219.193.22","GroupId":42,"GroupName":"Sr. Member","JoinDate":1359748704,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265511.jpg?_r=1427386564","PhotoWidth":200,"PhotoHeight":153,"PhotoType":"custom"},"FormattedName":"TinkerSofi","Id":265511,"Name":"TinkerSofi","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.0.176.157","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79083,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0e7d192a9a25d7195f5e89bf65fba8ff","RawContent":"Thank you for all the ideas! \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1893570,"PostDate":1429365823,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thank you for all the ideas! <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"andreacorsi2012@gmail.com","IpAddress":"174.0.176.157","GroupId":39,"GroupName":"Newbie","JoinDate":1409175969,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"custom"},"FormattedName":"Andrea2015","Id":279604,"Name":"Andrea2015","IsOnline":false}}],"Id":"79083","Title":"Reception Ideas","LastPostDate":1429365823},"Pages":{"TotalItems":9,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
