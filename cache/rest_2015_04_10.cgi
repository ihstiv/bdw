{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":true,"CanEdit":true,"CanReply":true,"CanFollow":true,"TotalPosts":1,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":0,"MovedTo":null,"MovedOn":0,"FirstPostId":1892542,"Rating":0,"RatingHits":0,"Starter":{"Id":282681,"Name":"Shaylala","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":true},"StartDate":1428627152,"LastPoster":{"Id":282681,"Name":"Shaylala","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":true},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1892542,"PostDate":1428627152,"PostContent":"Hi All. I've been so overwhelmed with trying to choose a resort. My fianc\u00e9 and I really want to g...","Author":{"Signature":"","Email":"shayla.mcmahon@shaw.ca","IpAddress":"70.73.72.212","GroupId":39,"GroupName":"Newbie","JoinDate":1428547145,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Shaylala","Id":282681,"Name":"Shaylala","IsOnline":true}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.73.72.212","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":false,"CanLike":false,"TopicId":79042,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9a7ef94c7b8dd05c605078111d5a6f32","RawContent":"Hi All. I&#039;ve been so overwhelmed with trying to choose a resort. My fianc\u00e9 and I really want to get married in the Dominican, we have tentatively set May 2016 as our date, I figured slightly off season would be a bit cheaper..\n\nI&#039;m really struggling with the cost that guests have to pay, all my quotes have come back around $2000-$2200. I just think this is far too much..I was hoping for the $1600-$1800 range. Seems that to get this I have to lower my resort expectation which isn&#039;t really something I want to do.\n\nWhat price has everyone else seen and what&#039;s fair?! Or what have your\n\n guests said about cost?? This is the only factor in holding me back from booking :(\n\n\nThanks ladies!!","Attachments":[],"Id":1892542,"PostDate":1428627152,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi All. I've been so overwhelmed with trying to choose a resort. My fianc\u00e9 and I really want to get married in the Dominican, we have tentatively set May 2016 as our date, I figured slightly off season would be a bit cheaper..<br>\nI'm really struggling with the cost that guests have to pay, all my quotes have come back around $2000-$2200. I just think this is far too much..I was hoping for the $1600-$1800 range. Seems that to get this I have to lower my resort expectation which isn't really something I want to do.<br>\nWhat price has everyone else seen and what's fair?! Or what have your<br>\n guests said about cost?? This is the only factor in holding me back from booking <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/sad.png' class='bbc_emoticon' alt=':(' \/><br><br>\nThanks ladies!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"shayla.mcmahon@shaw.ca","IpAddress":"70.73.72.212","GroupId":39,"GroupName":"Newbie","JoinDate":1428547145,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Shaylala","Id":282681,"Name":"Shaylala","IsOnline":true}}],"Id":"79042","Title":"Cost For Guests","LastPostDate":1428627152},"Pages":{"TotalItems":1,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
