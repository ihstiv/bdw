color:#0066cc;\"><strong>- Jennifer and Fr<span><em>\u00e9<\/em><\/span>d<span><em>\u00e9<\/em><\/span>ric -<\/strong><\/span><\/p>\n<p style=\"text-align:center;\"><span style=\"font-size:12px;\"><span style=\"color:rgb(0,204,204);\"><strong>Playa del Carmen Mexico<\/strong><\/span><\/span><\/p>\n<p style=\"text-align:center;\"><span style=\"font-size:12px;\"><span style=\"color:rgb(0,204,204);\"><strong>December 1st, 2015<\/strong><\/span><\/span>","Email":"wedding@jennyfer.ca","IpAddress":"216.16.242.102","GroupId":39,"GroupName":"Newbie","JoinDate":1413471948,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280665.jpg?_r=1413805399","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"JennyZ","Id":280665,"Name":"JennyZ","IsOnline":false}},"Posts":[],"Id":"78249","Title":"The Story: How We Met, Fell In Love And Got Engaged! <3","LastPostDate":1413859364},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":1,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":295,"MovedTo":null,"MovedOn":0,"FirstPostId":1876175,"Rating":0,"RatingHits":0,"Starter":{"Id":279936,"Name":"amanda2016","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279936.jpg?_r=1414239845","PhotoWidth":200,"PhotoHeight":246,"PhotoType":"custom"},"IsOnline":false},"StartDate":1413736887,"LastPoster":{"Id":279936,"Name":"amanda2016","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279936.jpg?_r=1414239845","PhotoWidth":200,"PhotoHeight":246,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":37,"Preview":{"Id":1876175,"PostDate":1413736887,"PostContent":"September 9, 2014- Istanbul Turkey On a beautiful breezy night we made our way to the docks to me...","Author":{"Signature":"<p style=\"text-align:center;\"><img src=\"http:\/\/www.tickerclub.com\/tickers\/wedding\/preview\/idTicker\/206838\/rulerId\/\/sliderId\/\/\" alt=\"sliderId\"><\/p>\n<p style=\"text-align:center;\">\u00a0","Email":"amanda@roamcanada.com","IpAddress":"41.218.252.222","GroupId":39,"GroupName":"Newbie","JoinDate":1411408087,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279936.jpg?_r=1414239845","PhotoWidth":200,"PhotoHeight":246,"PhotoType":"custom"},"FormattedName":"amanda2016","Id":279936,"Name":"amanda2016","IsOnline":false}},"Posts":[],"Id":"78246","Title":"Our Engagement Story","LastPostDate":1413736887},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":47,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":3323,"MovedTo":null,"MovedOn":0,"FirstPostId":1187750,"Rating":0,"RatingHits":0,"Starter":{"Id":229026,"Name":"clgriffi7","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-229026.JPG?_r=0","PhotoWidth":150,"PhotoHeight":100,"PhotoType":"custom"},"IsOnline":false},"StartDate":1276805593,"LastPoster":{"Id":276518,"Name":"LauraM","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276518.jpg?_r=1394639305","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":37,"Preview":{"Id":1187750,"PostDate":1276805593,"PostContent":"I thought a few of you might find it amusing, so I am sharing my proposal story. My fiance went r...","Author":{"Signature":"","Email":"clgriffi7@yahoo.com","IpAddress":"","GroupId":5,"GroupName":"Banned","JoinDate":1276125730,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-229026.JPG?_r=0","PhotoWidth":150,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"clgriffi7","Id":229026,"Name":"clgriffi7","IsOnline":false}},"Posts":[],"Id":"53288","Title":"I made him propose 5 more times...","LastPostDate":1409680354},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":17,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":771,"MovedTo":null,"MovedOn":0,"FirstPostId":1866453,"Rating":0,"RatingHits":0,"Starter":{"Id":279435,"Name":"Tiffany1221","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279435.jpg?_r=1409501389","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"StartDate":1408061328,"LastPoster":{"Id":279650,"Name":"Ksarnowski","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":37,"Preview":{"Id":1866453,"PostDate":1408061328,"PostContent":"My Fiance and I have been together since High School. Since then we haven't left each others side...","Author":{"Signature":"<p><b>The Future Mrs. Santos\u00a0<\/b>","Email":"tljubainville@yahoo.com","IpAddress":"96.233.153.252","GroupId":40,"GroupName":"Jr. Member","JoinDate":1408025216,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279435.jpg?_r=1409501389","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"Tiffany1221","Id":279435,"Name":"Tiffany1221","IsOnline":false}},"Posts":[],"Id":"77817","Title":"It Only Took Him 9 Years To Propose <3 *video*","LastPostDate":1409628153}],"Pages":{"TotalItems":463,"TotalPages":31,"