Request Time: 1 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":6,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":80,"MovedTo":null,"MovedOn":0,"FirstPostId":1908746,"Rating":0,"RatingHits":0,"Starter":{"Id":285230,"Name":"Deannak","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1451387451,"LastPoster":{"Id":250090,"Name":"dreamweddings","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250090.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1908746,"PostDate":1451387451,"PostContent":"Hello fellow brides! \u00a0 Getting excited to finally start planning our destination wedding! I have...","Author":{"Signature":"","Email":"deannakawecki@hotmail.com","IpAddress":"99.224.81.241","GroupId":39,"GroupName":"Newbie","JoinDate":1446503008,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Deannak","Id":285230,"Name":"Deannak","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.224.81.241","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79821,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ec854416c7ffc167533b6993e0d53609","RawContent":"&lt;p&gt;Hello fellow brides!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Getting excited to finally start planning our destination wedding! I have my travel agent\/destination wedding planner already. Im just having a really hard time trying to choose a resort! We would like a smaller 5* resort with great food. Ive narrowed down things to Beach Palace, Azul Fives and Now Jade. Can any of you ladies provide some insight and recommendations to help me choose a resort! Also im open to hear recommendations for other resorts as well.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thanks so much&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1908746,"PostDate":1451387451,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello fellow brides!<\/p>\n<p>\u00a0<\/p>\n<p>Getting excited to finally start planning our destination wedding! I have my travel agent\/destination wedding planner already. Im just having a really hard time trying to choose a resort! We would like a smaller 5* resort with great food. Ive narrowed down things to Beach Palace, Azul Fives and Now Jade. Can any of you ladies provide some insight and recommendations to help me choose a resort! Also im open to hear recommendations for other resorts as well.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Thanks so much\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"deannakawecki@hotmail.com","IpAddress":"99.224.81.241","GroupId":39,"GroupName":"Newbie","JoinDate":1446503008,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Deannak","Id":285230,"Name":"Deannak","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.140.35.139","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79821,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"612ed09ea91625808e594ec35ddd3202","RawContent":"&lt;p&gt;Hi Deanna,&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Welcome to BDW!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Beach Palace, Azul Fives, and NOW Jade are all great resorts but very different from each other. We are a top agency with all those resorts.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;They offer different pros and cons.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We usually work with the bride and groom to go over what their needs are, price point, etc. to see what resort would work best for them.&lt;\/p&gt;","Attachments":[],"Id":1908749,"PostDate":1451387690,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Deanna,<\/p>\n<p>\u00a0<\/p>\n<p>Welcome to BDW!<\/p>\n<p>\u00a0<\/p>\n<p>Beach Palace, Azul Fives, and NOW Jade are all great resorts but very different from each other. We are a top agency with all those resorts.<\/p>\n<p>\u00a0<\/p>\n<p>They offer different pros and cons.<\/p>\n<p>\u00a0<\/p>\n<p>We usually work with the bride and groom to go over what their needs are, price point, etc. to see what resort would work best for them.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-family:arial, helvetica, sans-serif;\">Founder and Owner of BestDestinationWedding.com \u00a0\/ \u00a0<\/span><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/'><strong><span style=\"font-family:arial, helvetica, sans-serif;\">Bride & Groom Fly FREE Promotion<\/span><\/strong><\/a><\/p>\n<p>\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><strong><a data-ipb='nomediaparse' href='http:\/\/wrighttravelagency.com\/inquiry\/'><span style=\"color:#008080;\">Looking for a travel agency that specializes in Destination Weddings<\/span><\/a><\/strong><span style=\"color:#008080;\"><strong>?<\/strong> \u00a0We are an award winning travel agency and you can <\/span><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style=\"color:#008080;\">read our reviews\u00a0here.<\/span><\/a><\/strong><\/span><br>\n\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"color:#008080;\"><strong>Awards and recognition:\u00a0<\/strong><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Palace Resorts Winner \"Top Travel Agent\", \"Top Homebased Travel Agency\" PRO Platinum Agency (Top Award) \u00a0 \u00a0 | \u00a0 \u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">AMResorts Master Agent & Top Agency \u00a0<\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/68050-karisma-hotels-givc-and-gi-wedding-consultants-wright-travel-agency\/'><strong>Wright Travel & Karisma GIVC Benefits<\/strong><\/a><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Travel Impressions Best of the Best Globe Winner \u00a0 \u00a0| \u00a0 \u00a0\u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Apple Vacations Golden Apple Winner \u00a0<\/span><\/span><br><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"> \u00a0 \u00a0<img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"font-size:14px;\"><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010'>Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><\/span><\/span><strong><span style=\"color:#b22222;\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a data-ipb='nomediaparse' href='mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com'>ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"admin@bestdestinationwedding.com","IpAddress":"71.202.225.11","GroupId":4,"GroupName":"Administrators","JoinDate":1137206220,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"FormattedName":"TammyWright","Id":206696,"Name":"TammyWright","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.224.81.241","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79821,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"140b16611cafcd1755c9181dc17cbef9","RawContent":"[quote name=\"TammyWright\" post=\"1908749\" timestamp=\"1451405690\"]\nHi Deanna,\n\nWelcome to BDW!\n\nBeach Palace, Azul Fives, and NOW Jade are all great resorts but very different from each other. We are a top agency with all those resorts.\n\nThey offer different pros and cons.\n\nWe usually work with the bride and groom to go over what their needs are, price point, etc. to see what resort would work best for them.[\/quote]how should i reply to you? should i email","Attachments":[],"Id":1908750,"PostDate":1451388004,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>TammyWright, on Yesterday, 11:14 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hi Deanna,<\/p>\n<p>\u00a0<\/p>\n<p>Welcome to BDW!<\/p>\n<p>\u00a0<\/p>\n<p>Beach Palace, Azul Fives, and NOW Jade are all great resorts but very different from each other. We are a top agency with all those resorts.<\/p>\n<p>\u00a0<\/p>\n<p>They offer different pros and cons.<\/p>\n<p>\u00a0<\/p>\n<p>We usually work with the bride and groom to go over what their needs are, price point, etc. to see what resort would work best for them.<\/p>\n<\/div>\n<\/div><\/div>\n<p>how should i reply to you? should i email<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"deannakawecki@hotmail.com","IpAddress":"99.224.81.241","GroupId":39,"GroupName":"Newbie","JoinDate":1446503008,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Deannak","Id":285230,"Name":"Deannak","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.142.4.206","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79821,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"ba0b5c9d098449102aeae6022a90cd32","RawContent":"&lt;p&gt;Hi @[member=\"Deannak\"]&lt;\/p&gt;\n&lt;p&gt;Welcome to the forum!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I just recently had my wedding at Beach Palace and it was fantastic. If you are looking for a smaller resort, it&#039;s perfect. It&#039;s more of a hotel style high rise, but the property itself is not large at all which made it perfect for our &#039;intimate&#039; wedding week. We wanted to be able to run into people, have an easy time meeting up etc. It was great.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I posted all about it in my planning thread (link below) if you want to have a look! The last 10 pages have my review, pictures etc&lt;\/p&gt;","Attachments":[],"Id":1908757,"PostDate":1451397329,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi @<a hovercard-ref=\"member\" hovercard-id=\"285230\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/285230-deannak\/' title='Member profile'><span itemprop=\"name\">Deannak<\/span><\/a><\/p>\n<p>Welcome to the forum!<\/p>\n<p>\u00a0<\/p>\n<p>I just recently had my wedding at Beach Palace and it was fantastic. If you are looking for a smaller resort, it's perfect. It's more of a hotel style high rise, but the property itself is not large at all which made it perfect for our 'intimate' wedding week. We wanted to be able to run into people, have an easy time meeting up etc. It was great.<\/p>\n<p>\u00a0<\/p>\n<p>I posted all about it in my planning thread (link below) if you want to have a look! The last 10 pages have my review, pictures etc<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419419814,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1450791654","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"104.245.163.146","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79821,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"dc4eeb77de8e1c163622b5fc52666049","RawContent":"&lt;p&gt;HAPPY New Year, and Welcome to our forum community Deannak!&lt;\/p&gt;\n&lt;p&gt;Congrats on your upcoming dw in 2017 - you&#039;ve come to the right place for lots of great info, ideas, support and suggestions from everyone here - so great start already :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;To show you what your venue choices would look as a backdrop for your Wedding Day Love Story in photos, here are some magical wedding moments that matter we captured recently.....enjoy!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;...from &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10153681635889487.1073741949.18683524486&amp;amp;type=3&#039;&gt;Azul Fives Wedding Album:&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xtp1\/t31.0-8\/12091401_10153681638734487_7944233725687063293_o.jpg\" alt=\"12091401_10153681638734487_7944233725687\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xal1\/t31.0-8\/12068422_10153681639319487_859050653259270216_o.jpg\" alt=\"12068422_10153681639319487_8590506532592\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xat1\/t31.0-8\/11224348_10153681639504487_358800014038396685_o.jpg\" alt=\"11224348_10153681639504487_3588000140383\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xtl1\/t31.0-8\/12068422_10153681641079487_8016697710294099699_o.jpg\" alt=\"12068422_10153681641079487_8016697710294\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;....from &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10153455288424487.1073741940.18683524486&amp;amp;type=3&#039;&gt;NOW Jade Wedding Album: &lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xta1\/t31.0-8\/11705723_10153455292729487_5708464463776955092_o.jpg\" alt=\"11705723_10153455292729487_5708464463776\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xpa1\/t31.0-8\/11700726_10153455296239487_8193843878115225725_o.jpg\" alt=\"11700726_10153455296239487_8193843878115\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xfa1\/t31.0-8\/11741091_10153455297229487_7090297919879045525_o.jpg\" alt=\"11741091_10153455297229487_7090297919879\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Wishing you happy research, and all the best with your plans - cheers!!! team MTM :)&lt;\/p&gt;","Attachments":[],"Id":1908759,"PostDate":1451402234,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>HAPPY New Year, and Welcome to our forum community Deannak!<\/p>\n<p>Congrats on your upcoming dw in 2017 - you've come to the right place for lots of great info, ideas, support and suggestions from everyone here - so great start already <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>To show you what your venue choices would look as a backdrop for your Wedding Day Love Story in photos, here are some magical wedding moments that matter we captured recently.....enjoy!<\/p>\n<p>\u00a0<\/p>\n<p>...from <a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10153681635889487.1073741949.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>Azul Fives Wedding Album:<\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xtp1\/t31.0-8\/12091401_10153681638734487_7944233725687063293_o.jpg\" alt=\"12091401_10153681638734487_7944233725687\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xal1\/t31.0-8\/12068422_10153681639319487_859050653259270216_o.jpg\" alt=\"12068422_10153681639319487_8590506532592\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xat1\/t31.0-8\/11224348_10153681639504487_358800014038396685_o.jpg\" alt=\"11224348_10153681639504487_3588000140383\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xtl1\/t31.0-8\/12068422_10153681641079487_8016697710294099699_o.jpg\" alt=\"12068422_10153681641079487_8016697710294\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>....from <a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10153455288424487.1073741940.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>NOW Jade Wedding Album: <\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xta1\/t31.0-8\/11705723_10153455292729487_5708464463776955092_o.jpg\" alt=\"11705723_10153455292729487_5708464463776\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xpa1\/t31.0-8\/11700726_10153455296239487_8193843878115225725_o.jpg\" alt=\"11700726_10153455296239487_8193843878115\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xfa1\/t31.0-8\/11741091_10153455297229487_7090297919879045525_o.jpg\" alt=\"11741091_10153455297229487_7090297919879\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>Wishing you happy research, and all the best with your plans - cheers!!! team MTM <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280192660,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"200.79.251.123","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79821,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f2b83c59a6c81d8bcb27031a304aced5","RawContent":"[quote name=\"Deannak\" post=\"1908746\" timestamp=\"1451405451\"]\nHello fellow brides!\n\nGetting excited to finally start planning our destination wedding! I have my travel agent\/destination wedding planner already. Im just having a really hard time trying to choose a resort! We would like a smaller 5* resort with great food. Ive narrowed down things to Beach Palace, Azul Fives and Now Jade. Can any of you ladies provide some insight and recommendations to help me choose a resort! Also im open to hear recommendations for other resorts as well. \n\nThanks so much[\/quote]@[member=\"Deannak\"],  the 3 resorts are good all inclusive resorts.  my favorite has to be [url=\"https:\/\/dreamweddingsrivieramayablogdotcom.wordpress.com\/2015\/11\/14\/mahsa-and-kiarash-beach-palace-cancun-resort-cancun-destination-wedding\/\"]https:\/\/dreamweddingsrivieramayablogdotcom.wordpress.com\/2015\/11\/14\/mahsa-and-kiarash-beach-palace-cancun-resort-cancun-destination-wedding\/[\/url]\n\nI loved the roof top terrace.service was excellent. \n\n@[member=\"TammyWright\"] will sure lead you into the right direction. \n\nHappy Planning!","Attachments":[],"Id":1908771,"PostDate":1451430966,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Deannak, on Yesterday, 11:10 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hello fellow brides!<\/p>\n<p>\u00a0<\/p>\n<p>Getting excited to finally start planning our destination wedding! I have my travel agent\/destination wedding planner already. Im just having a really hard time trying to choose a resort! We would like a smaller 5* resort with great food. Ive narrowed down things to Beach Palace, Azul Fives and Now Jade. Can any of you ladies provide some insight and recommendations to help me choose a resort! Also im open to hear recommendations for other resorts as well.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Thanks so much\u00a0<\/p>\n<\/div>\n<\/div><\/div>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"285230\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/285230-deannak\/' title='Member profile'><span itemprop=\"name\">Deannak<\/span><\/a>, \u00a0the 3 resorts are good all inclusive resorts. \u00a0my favorite has to be\u00a0<a href='https:\/\/dreamweddingsrivieramayablogdotcom.wordpress.com\/2015\/11\/14\/mahsa-and-kiarash-beach-palace-cancun-resort-cancun-destination-wedding\/' class='bbc_url' title='External link' rel='nofollow external'>https:\/\/dreamwedding...nation-wedding\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>I loved the roof top terrace.service was excellent.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"206696\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/206696-tammywright\/' title='Member profile'><span itemprop=\"name\">TammyWright<\/span><\/a> will sure lead you into the right direction.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Happy Planning!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"Dream Weddings Riviera Maya- We pay attention to your wishes and coordinate closely with you to ensure your wedding or event is planned to perfection!<br \/>\n<br \/>\n<span style='color: rgb(40,40,40)'><span style='font-family: arial'><span style='font-size: 12px;'>Dream Weddings Riviera Maya<\/span><\/span><\/span><br \/>\n<span style='font-family: arial'><span style='font-size: 12px;'>weddingsinplayadelcarmen@gmail.com<\/span><\/span><br \/>\n<a class='bbc_url' href='http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html'>http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html<\/a><br \/>\n<br \/>\n<span style='color: rgb(40,40,40)'><span style='font-family: arial'><span style='font-size: 12px;'>Happy Planning!<\/span><\/span><\/span><br \/>\n<span style='color: rgb(40,40,40)'><span style='font-family: arial'><span style='font-size: 12px;'>Joyce<\/span><\/span><\/span>","Email":"weddingsinplayadelcarmen@gmail.com","IpAddress":"187.252.44.28","GroupId":84,"GroupName":"Insiders w\/ Articles","JoinDate":1326836387,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250090.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"dreamweddings","Id":250090,"Name":"dreamweddings","IsOnline":false}}],"Id":"79821","Title":"Mexico Wedding April 2017","LastPostDate":1451430966},"Pages":{"TotalItems":6,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
