{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":16,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":615,"MovedTo":null,"MovedOn":0,"FirstPostId":1908507,"Rating":0,"RatingHits":0,"Starter":{"Id":279721,"Name":"Wafflesmom","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279721.jpg?_r=1444491864","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":true},"StartDate":1450556849,"LastPoster":{"Id":250090,"Name":"dreamweddings","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250090.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":2,"Preview":{"Id":1908507,"PostDate":1450556849,"PostContent":"31 days, my guests and I are exactly 1 month away from boarding a plane to celebrate our wedding...","Author":{"Signature":"My planning thread: <a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/79425-wafflesmom-moon-palace-planning-thread-january-23-2016\/\">http:\/\/www.bestdestinationwedding.com\/topic\/79425-wafflesmom-moon-palace-planning-thread-january-23-2016\/<\/a><br><br>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;4;484\/st\/20160123\/e\/Our+Wedding\/dt\/-2\/k\/44c5\/event.png\" alt=\"event.png\"><\/a>","Email":"jerilee.valenzuela@shaw.ca","IpAddress":"24.114.26.77","GroupId":3,"GroupName":"Member","JoinDate":1410080585,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279721.jpg?_r=1444491864","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Wafflesmom","Id":279721,"Name":"Wafflesmom","IsOnline":true}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"96.48.159.21","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79801,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"db0fd734264448039cedd21a79c5ed93","RawContent":"&lt;p&gt;31 days, my guests and I are exactly 1 month away from boarding a plane to celebrate our wedding week. In the lead up to the wedding\/trip, I thought it would be fun to do a countdown on our wedding website of tips, tricks and advice surrounding travel to Mexico, specifically the Cancun and Riviera Maya area. We&#039;ve never been to that side of Mexico so I thought I would reach out to my bride and bride-to-be friends on the forum. If you could help me come up with tips, tricks and advice for our trip, I would really appreciate it. This can be anything from tips at the airport (e.g. stay away from timeshares), must-see places (e.g. touristy areas, restaurants, beaches, etc) and if anyone has any tips for Moon Palace (our wedding resort) that would be fantastic.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thanks in advance :wub:&lt;\/p&gt;","Attachments":[],"Id":1908507,"PostDate":1450556849,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>31 days, my guests and I are exactly 1 month away from boarding a plane to celebrate our wedding week. In the lead up to the wedding\/trip, I thought it would be fun to do a countdown on our wedding website of tips, tricks and advice surrounding travel to Mexico, specifically the Cancun and Riviera Maya area. We've never been to that side of Mexico so I thought I would reach out to my bride and bride-to-be friends on the forum. If you could help me come up with tips, tricks and advice for our trip, I would really appreciate it. This can be anything from tips at the airport (e.g. stay away from timeshares), must-see places (e.g. touristy areas, restaurants, beaches, etc) and if anyone has any tips for Moon Palace (our wedding resort) that would be fantastic.<\/p>\n<p>\u00a0<\/p>\n<p>Thanks in advance <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wub.png' class='bbc_emoticon' alt=':wub:' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"My planning thread: <a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/79425-wafflesmom-moon-palace-planning-thread-january-23-2016\/\">http:\/\/www.bestdestinationwedding.com\/topic\/79425-wafflesmom-moon-palace-planning-thread-january-23-2016\/<\/a><br><br>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;4;484\/st\/20160123\/e\/Our+Wedding\/dt\/-2\/k\/44c5\/event.png\" alt=\"event.png\"><\/a>","Email":"jerilee.valenzuela@shaw.ca","IpAddress":"24.114.26.77","GroupId":3,"GroupName":"Member","JoinDate":1410080585,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279721.jpg?_r=1444491864","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Wafflesmom","Id":279721,"Name":"Wafflesmom","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.0.142.65","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79801,"EditedBy":"<strong>Edited by Moments That Matter, 20 December 2015 - 01:05 PM.<\/strong>","EditDate":1450616703,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"0f89e44adbd3c5fa9d5ea0cb35384b8a","RawContent":"&lt;p&gt;WOw - how exciting to be so close to the BIG Day - fun!!! Good thing the holiday season is here too - for a sweet distraction and to help pass the time to departure :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;In case you haven&#039;t already seen this, here&#039;s a link to some &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.lonelyplanet.com\/mexico\/travel-tips-and-articles&#039;&gt;Mexico travel tips and articles&lt;\/a&gt; to share with your guests. Here&#039;s a link to some specific &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.arrivalguides.com\/en\/Travelguides\/North_America\/Mexico\/Rivieramaya&#039;&gt;Mayan Riviera travel tips&lt;\/a&gt; too....for added info.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Hope you have the most amazing holiday season and all the best with your Special Celebration - cheers!!! team MTM :)&lt;\/p&gt;\n&lt;p&gt;...this greeting from our &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10150344652834487.362195.18683524486&amp;amp;type=3&#039;&gt;Timeline Photos Album:&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-frc3\/t31.0-8\/10887520_10152928701404487_3240177822190211982_o.jpg\" alt=\"10887520_10152928701404487_3240177822190\"&gt;&lt;\/p&gt;","Attachments":[],"Id":1908515,"PostDate":1450616648,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>WOw - how exciting to be so close to the BIG Day - fun!!! Good thing the holiday season is here too - for a sweet distraction and to help pass the time to departure <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>In case you haven't already seen this, here's a link to some <a href='http:\/\/www.lonelyplanet.com\/mexico\/travel-tips-and-articles' class='bbc_url' title='External link' rel='nofollow external'>Mexico travel tips and articles<\/a> to share with your guests. Here's a link to some specific <a href='http:\/\/www.arrivalguides.com\/en\/Travelguides\/North_America\/Mexico\/Rivieramaya' class='bbc_url' title='External link' rel='nofollow external'>Mayan Riviera travel tips<\/a> too....for added info.<\/p>\n<p>\u00a0<\/p>\n<p>Hope you have the most amazing holiday season and all the best with your Special Celebration - cheers!!! team MTM <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>...this greeting from our <a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10150344652834487.362195.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>Timeline Photos Album:<\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-frc3\/t31.0-8\/10887520_10152928701404487_3240177822190211982_o.jpg\" alt=\"10887520_10152928701404487_3240177822190\"><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280192660,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.143.233.104","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79801,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"a0951daa6a572e4893eb00aeebfc5dbd","RawContent":"So exciting!! The countdown is on for us too!! \n\n We have many people going with us that have never even been to Mexico so I&#039;ve also been thinking about a list so far.\n\nTips for newbies?\n\n-Bring a bubba or travel mug\n\n-Get pesos early at home\n\n-Pack lots of extra sunscreen, it&#039;s so pricey if you run out!\n\n- for resort pool\/ocean it is fun to bring a cheap floaty to relax \n\n-tell your guests to meet your group outside by bus, at airport after security go straight outside and don&#039;t get stopped by timeshare sharks or cab people.  \n\n\nIf I think of more I&#039;ll add , these just came to mind right away from things I wish I knew my first trip.  \n\n\nKim","Attachments":[],"Id":1908522,"PostDate":1450658491,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                So exciting!! The countdown is on for us too!! <br>\n We have many people going with us that have never even been to Mexico so I've also been thinking about a list so far.<br>\nTips for newbies?<br>\n-Bring a bubba or travel mug<br>\n-Get pesos early at home<br>\n-Pack lots of extra sunscreen, it's so pricey if you run out!<br>\n- for resort pool\/ocean it is fun to bring a cheap floaty to relax <br>\n-tell your guests to meet your group outside by bus, at airport after security go straight outside and don't get stopped by timeshare sharks or cab people.  <br><br>\nIf I think of more I'll add , these just came to mind right away from things I wish I knew my first trip.  <br><br>\nKim \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#cc6666;\"><span style=\"font-family:georgia, serif;\"><em>Forever can never be long enough for me, to feel like I've had long enough with you...19\/01\/2016<\/em><\/span><\/span>","Email":"kimberlydiana@hotmail.com","IpAddress":"24.76.172.36","GroupId":39,"GroupName":"Newbie","JoinDate":1412286687,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280238.png?_r=1412619945","PhotoWidth":80,"PhotoHeight":60,"PhotoType":"custom"},"FormattedName":"kimmyd2","Id":280238,"Name":"kimmyd2","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.114.42.152","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79801,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9925523ca07d848dbfca95d1ac46c525","RawContent":"Thank you @[member=\"MomentsThatMatter\"] and @[member=\"kimmyd2\"]\n\n\n@[member=\"kimmyd2\"] eeek your wedding date is sooner than mine! How&#039;s wedding planning? Thanks for the tips, those are definitely great to know","Attachments":[],"Id":1908535,"PostDate":1450692082,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thank you @<a hovercard-ref=\"member\" hovercard-id=\"210808\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/210808-momentsthatmatter\/' title='Member profile'><span itemprop=\"name\">MomentsThatMatter<\/span><\/a> and @<a hovercard-ref=\"member\" hovercard-id=\"280238\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/280238-kimmyd2\/' title='Member profile'><span itemprop=\"name\">kimmyd2<\/span><\/a><br><br>\n@<a hovercard-ref=\"member\" hovercard-id=\"280238\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/280238-kimmyd2\/' title='Member profile'><span itemprop=\"name\">kimmyd2<\/span><\/a> eeek your wedding date is sooner than mine! How's wedding planning? Thanks for the tips, those are definitely great to know\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"My planning thread: <a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/79425-wafflesmom-moon-palace-planning-thread-january-23-2016\/\">http:\/\/www.bestdestinationwedding.com\/topic\/79425-wafflesmom-moon-palace-planning-thread-january-23-2016\/<\/a><br><br>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;4;484\/st\/20160123\/e\/Our+Wedding\/dt\/-2\/k\/44c5\/event.png\" alt=\"event.png\"><\/a>","Email":"jerilee.valenzuela@shaw.ca","IpAddress":"24.114.26.77","GroupId":3,"GroupName":"Member","JoinDate":1410080585,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279721.jpg?_r=1444491864","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Wafflesmom","Id":279721,"Name":"Wafflesmom","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"200.79.251.123","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79801,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"4662ee64aa337a1eed34094a5fdf033c","RawContent":"&lt;p&gt;I would also add its not necessary to change US dollars to pesos. &amp;nbsp;In mexico we use both, and you get a super great exchange right now. &amp;nbsp;make sure you have smaller bills for tipping.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Bride to be tip:&lt;\/p&gt;\n&lt;p&gt;make sure you wear strapless bikini tops ,especially if your dress is strapless you just dont want to have lines showing on your wedding pictures.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;be in the sun in moderation, you can cook yourself after the wedding day ;) you just dont want to look burned on your wedding pictures.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;make sure you pre order your lunch the day before , so it arrives an a specific time you want make sure you eat while getting ready. (ask your coordinator about this)&lt;\/p&gt;","Attachments":[],"Id":1908539,"PostDate":1450693525,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I would also add its not necessary to change US dollars to pesos. \u00a0In mexico we use both, and you get a super great exchange right now. \u00a0make sure you have smaller bills for tipping.<\/p>\n<p>\u00a0<\/p>\n<p>Bride to be tip:<\/p>\n<p>make sure you wear strapless bikini tops ,especially if your dress is strapless you just dont want to have lines showing on your wedding pictures.<\/p>\n<p>\u00a0<\/p>\n<p>be in the sun in moderation, you can cook yourself after the wedding day <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/> you just dont want to look burned on your wedding pictures.<\/p>\n<p>\u00a0<\/p>\n<p>make sure you pre order your lunch the day before , so it arrives an a specific time you want make sure you eat while getting ready. (ask your coordinator about this)<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"Dream Weddings Riviera Maya- We pay attention to your wishes and coordinate closely with you to ensure your wedding or event is planned to perfection!<br \/>\n<br \/>\n<span style='color: rgb(40,40,40)'><span style='font-family: arial'><span style='font-size: 12px;'>Dream Weddings Riviera Maya<\/span><\/span><\/span><br \/>\n<span style='font-family: arial'><span style='font-size: 12px;'>weddingsinplayadelcarmen@gmail.com<\/span><\/span><br \/>\n<a class='bbc_url' href='http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html'>http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html<\/a><br \/>\n<br \/>\n<span style='color: rgb(40,40,40)'><span style='font-family: arial'><span style='font-size: 12px;'>Happy Planning!<\/span><\/span><\/span><br \/>\n<span style='color: rgb(40,40,40)'><span style='font-family: arial'><span style='font-size: 12px;'>Joyce<\/span><\/span><\/span>","Email":"weddingsinplayadelcarmen@gmail.com","IpAddress":"187.252.44.28","GroupId":84,"GroupName":"Insiders w\/ Articles","JoinDate":1326836387,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250090.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"dreamweddings","Id":250090,"Name":"dreamweddings","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.114.42.152","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79801,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"b31a8f29f0c3d4f1dc4932e55ce5eb4e","RawContent":"@[member=\"dreamweddings\"] thank you so much for the tips and advice! Yonatan from Styling Trio also told me to make sure I keep the alcohol drinking down, especially before the wedding as it dries the skin. \n\n\nOne question I had is regarding tipping. Is there a preference when it comes to currency used for tipping vendors, especially our photographer and WC. Our Canadian dollar is pretty bad right now and we lose a lot if exchanging to US dollars. Would it be ok to tip in Mexican pesos or just stick to US?","Attachments":[],"Id":1908540,"PostDate":1450694122,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"250090\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/250090-dreamweddings\/' title='Member profile'><span itemprop=\"name\">dreamweddings<\/span><\/a> thank you so much for the tips and advice! Yonatan from Styling Trio also told me to make sure I keep the alcohol drinking down, especially before the wedding as it dries the skin. <br><br>\nOne question I had is regarding tipping. Is there a preference when it comes to currency used for tipping vendors, especially our photographer and WC. Our Canadian dollar is pretty bad right now and we lose a lot if exchanging to US dollars. Would it be ok to tip in Mexican pesos or just stick to US? \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"My planning thread: <a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/79425-wafflesmom-moon-palace-planning-thread-january-23-2016\/\">http:\/\/www.bestdestinationwedding.com\/topic\/79425-wafflesmom-moon-palace-planning-thread-january-23-2016\/<\/a><br><br>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;4;484\/st\/20160123\/e\/Our+Wedding\/dt\/-2\/k\/44c5\/event.png\" alt=\"event.png\"><\/a>","Email":"jerilee.valenzuela@shaw.ca","IpAddress":"24.114.26.77","GroupId":3,"GroupName":"Member","JoinDate":1410080585,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279721.jpg?_r=1444491864","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Wafflesmom","Id":279721,"Name":"Wafflesmom","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"200.79.251.123","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79801,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"168516047ef2fc9923edb9783f05969e","RawContent":"&lt;p&gt;@[member=\"Wafflesmom\"] the is no preference , we accept both peso or US dollar.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Your big day is around the corner lady :)!&lt;\/p&gt;","Attachments":[],"Id":1908544,"PostDate":1450696182,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"279721\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/279721-wafflesmom\/' title='Member profile'><span itemprop=\"name\">Wafflesmom<\/span><\/a> the is no preference , we accept both peso or US dollar.<\/p>\n<p>\u00a0<\/p>\n<p>Your big day is around the corner lady <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"Dream Weddings Riviera Maya- We pay attention to your wishes and coordinate closely with you to ensure your wedding or event is planned to perfection!<br \/>\n<br \/>\n<span style='color: rgb(40,40,40)'><span style='font-family: arial'><span style='font-size: 12px;'>Dream Weddings Riviera Maya<\/span><\/span><\/span><br \/>\n<span style='font-family: arial'><span style='font-size: 12px;'>weddingsinplayadelcarmen@gmail.com<\/span><\/span><br \/>\n<a class='bbc_url' href='http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html'>http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html<\/a><br \/>\n<br \/>\n<span style='color: rgb(40,40,40)'><span style='font-family: arial'><span style='font-size: 12px;'>Happy Planning!<\/span><\/span><\/span><br \/>\n<span style='color: rgb(40,40,40)'><span style='font-family: arial'><span style='font-size: 12px;'>Joyce<\/span><\/span><\/span>","Email":"weddingsinplayadelcarmen@gmail.com","IpAddress":"187.252.44.28","GroupId":84,"GroupName":"Insiders w\/ Articles","JoinDate":1326836387,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250090.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"dreamweddings","Id":250090,"Name":"dreamweddings","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.114.42.152","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79801,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"43824945f7c22192ea4eeb3683380de3","RawContent":"@[member=\"dreamweddings\"] thank you so much! And I know, countdown is definitely on now :)","Attachments":[],"Id":1908548,"PostDate":1450698587,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"250090\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/250090-dreamweddings\/' title='Member profile'><span itemprop=\"name\">dreamweddings<\/span><\/a> thank you so much! And I know, countdown is definitely on now <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"My planning thread: <a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/79425-wafflesmom-moon-palace-planning-thread-january-23-2016\/\">http:\/\/www.bestdestinationwedding.com\/topic\/79425-wafflesmom-moon-palace-planning-thread-january-23-2016\/<\/a><br><br>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;4;484\/st\/20160123\/e\/Our+Wedding\/dt\/-2\/k\/44c5\/event.png\" alt=\"event.png\"><\/a>","Email":"jerilee.valenzuela@shaw.ca","IpAddress":"24.114.26.77","GroupId":3,"GroupName":"Member","JoinDate":1410080585,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279721.jpg?_r=1444491864","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Wafflesmom","Id":279721,"Name":"Wafflesmom","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.142.4.206","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79801,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"ab4e4b01347b17e05bdd8ca979161900","RawContent":"&lt;p&gt;-Know how much Pesos are if you use them hahaha. I totally tipped a guy at the airport way more than I should&#039;ve.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;-Use PESOS. lol (we saved so much money with tipping in pesos, buying things in pesos)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Careful of jellyfish!!! If you guys are going to be swimming in the ocean. I don&#039;t understand what it is with Mexico this year because every time that i&#039;ve gone the water has been pretty calm, but this year the waves were massive and there was a huge undertow. We went in a few times and I think because the current is much stronger, it&#039;s pulling the jellyfish into the shore line. A lot of us got small jellyfish stings (including me).&lt;\/p&gt;","Attachments":[],"Id":1908581,"PostDate":1450773568,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>-Know how much Pesos are if you use them hahaha. I totally tipped a guy at the airport way more than I should've.\u00a0<\/p>\n<p>-Use PESOS. lol (we saved so much money with tipping in pesos, buying things in pesos)<\/p>\n<p>\u00a0<\/p>\n<p>Careful of jellyfish!!! If you guys are going to be swimming in the ocean. I don't understand what it is with Mexico this year because every time that i've gone the water has been pretty calm, but this year the waves were massive and there was a huge undertow. We went in a few times and I think because the current is much stronger, it's pulling the jellyfish into the shore line. A lot of us got small jellyfish stings (including me).<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419419814,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1450791654","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.146.146.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79801,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"590708c3a0fd4bdac771434a9c58771f","RawContent":"Hahaha @[member=\"perianjay\"] for that reason before we went we said 10 to 1 for easy math :)\n\n\nShawn&#039;s aunt was just in Cuba and a huge jellyfish issue there too. \n\n\nMy only caution to strapless is that it really depends the style of your strapless and the style of your dress. Just use a lot of sunscreen. You&#039;ll be fine either way. \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1908582,"PostDate":1450773807,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hahaha @<a hovercard-ref=\"member\" hovercard-id=\"281478\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281478-perianjay\/' title='Member profile'><span itemprop=\"name\">perianjay<\/span><\/a> for that reason before we went we said 10 to 1 for easy math <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br><br>\nShawn's aunt was just in Cuba and a huge jellyfish issue there too. <br><br>\nMy only caution to strapless is that it really depends the style of your strapless and the style of your dress. Just use a lot of sunscreen. You'll be fine either way. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399410602,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}}],"Id":"79801","Title":"Mexico Travel: Tips, Tricks And Advice","LastPostDate":1450800589},"Pages":{"TotalItems":16,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
