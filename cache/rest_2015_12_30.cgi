{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":4,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":578,"MovedTo":null,"MovedOn":0,"FirstPostId":1480002,"Rating":0,"RatingHits":0,"Starter":{"Id":234882,"Name":"Evgal","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-234882.jpeg?_r=0","PhotoWidth":180,"PhotoHeight":270,"PhotoType":"custom"},"IsOnline":false},"StartDate":1309586467,"LastPoster":{"Id":282278,"Name":"RitvikSehgal","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282278.png?_r=1425103909","PhotoWidth":200,"PhotoHeight":242,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":45,"Preview":{"Id":1480002,"PostDate":1309586467,"PostContent":"I have a small group (15) dinner reception so we aren't planning to privatize the restaurant. \u00a0W...","Author":{"Signature":"","Email":"bella715@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1293627679,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-234882.jpeg?_r=0","PhotoWidth":180,"PhotoHeight":270,"PhotoType":"custom"},"FormattedName":"Evgal","Id":234882,"Name":"Evgal","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62081,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"14b433606050e7265195de1ab1c36dc6","RawContent":"&lt;p&gt; I have a small group (15) dinner reception so we aren&#039;t planning to privatize the restaurant. &amp;nbsp;What should we do for dinner music? Bring an ipod or no music? &amp;nbsp;And we won&#039;t have a dance floor, should we go to a nearby club to party? &amp;nbsp;Our group is really mixed (old and young). &amp;nbsp;What should I do?&lt;\/p&gt;","Attachments":[],"Id":1480002,"PostDate":1309586467,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I have a small group (15) dinner reception so we aren't planning to privatize the restaurant. \u00a0What should we do for dinner music? Bring an ipod or no music? \u00a0And we won't have a dance floor, should we go to a nearby club to party? \u00a0Our group is really mixed (old and young). \u00a0What should I do?<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bella715@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1293627679,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-234882.jpeg?_r=0","PhotoWidth":180,"PhotoHeight":270,"PhotoType":"custom"},"FormattedName":"Evgal","Id":234882,"Name":"Evgal","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62081,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"afac67a3c95a3fde771489a9f123f264","RawContent":"We also have a small group (16) and we arent doing a private reception.  Our dinner is in one of the restraunts at our resort so we can&#039;t play an ipod.  Check with your resort.  We won&#039;t have a dance floor either so I think we will go to the disco at the resort.\n   [quote]\nOriginally Posted by [b]Evgal[\/b] \/img\/forum\/go_quote.gif\n \n \n I have a small group (15) dinner reception so we aren&#039;t planning to privatize the restaurant.  What should we do for dinner music? Bring an ipod or no music?  And we won&#039;t have a dance floor, should we go to a nearby club to party?  Our group is really mixed (old and young).  What should I do?[\/quote]","Attachments":[],"Id":1483473,"PostDate":1310155970,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <br \/> We also have a small group (16) and we arent doing a private reception.\u00a0 Our dinner is in one of the restraunts at our resort so we can't play an ipod.\u00a0 Check with your resort.\u00a0 We won't have a dance floor either so I think we will go to the disco at the resort.<br \/> \u00a0<\/p> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>Evgal<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" style=\"border-bottom: 0px solid; border-left: 0px solid; border-top: 0px solid; border-right: 0px solid\" \/><\/span><br \/> <br \/> <p> I have a small group (15) dinner reception so we aren't planning to privatize the restaurant. \u00a0What should we do for dinner music? Bring an ipod or no music? \u00a0And we won't have a dance floor, should we go to a nearby club to party? \u00a0Our group is really mixed (old and young). \u00a0What should I do?<\/p> <\/blockquote> <br \/> <br \/> <p> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jkergen@hotmail.com","IpAddress":"137.186.71.240","GroupId":42,"GroupName":"Sr. Member","JoinDate":1293141900,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-234788.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"JayKay","Id":234788,"Name":"JayKay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"188.29.166.86","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62081,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"04270819c1ac021990d729943b7a78b4","RawContent":"&lt;p&gt;We won&#039;t be having a dance floor either I think most of my guests (older) will just be happy with relaxing and not be too worried about dancing&lt;\/p&gt;","Attachments":[],"Id":1872954,"PostDate":1411546321,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>We won't be having a dance floor either I think most of my guests (older) will just be happy with relaxing and not be too worried about dancing<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"justineatack@gmail.com","IpAddress":"31.54.1.116","GroupId":40,"GroupName":"Jr. Member","JoinDate":1409993856,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279711.jpg?_r=1410256327","PhotoWidth":200,"PhotoHeight":125,"PhotoType":"custom"},"FormattedName":"Bride2b15","Id":279711,"Name":"Bride2b15","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"122.15.103.61","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62081,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c16ffb4f6e2a611107906fff58c5371e","RawContent":"&lt;p&gt;It will be well and good if things will go simultaneously.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1892268,"PostDate":1428461715,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>It will be well and good if things will go simultaneously.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"katherineriverace@gmail.com","IpAddress":"122.15.103.61","GroupId":39,"GroupName":"Newbie","JoinDate":1425082717,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282278.png?_r=1425103909","PhotoWidth":200,"PhotoHeight":242,"PhotoType":"custom"},"FormattedName":"RitvikSehgal","Id":282278,"Name":"RitvikSehgal","IsOnline":false}}],"Id":"62081","Title":"Music and Entertainment during dinner and after?","LastPostDate":1428461715},"Pages":{"TotalItems":4,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
