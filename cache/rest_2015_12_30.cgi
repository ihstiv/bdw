8c9e221b","RawContent":"&lt;p&gt; Would love to have a copy of the breakdown of the prices. Please email them to ksnifong@hotmail.com Thanks!&lt;\/p&gt;","Attachments":[],"Id":1789909,"PostDate":1376173107,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Would love to have a copy of the breakdown of the prices. Please email them to ksnifong@hotmail.com Thanks!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ksnifong@hotmail.com","IpAddress":"24.217.145.109","GroupId":39,"GroupName":"Newbie","JoinDate":1376172947,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272449.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"ksnbjs14","Id":272449,"Name":"ksnbjs14","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73031,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f33a5a2907fd354af36b65563ad17883","RawContent":"I would love a copy as well. I&#039;m currently considering having my reception at Jellyfish too. My email is d.christopher03@gmail.com","Attachments":[],"Id":1798521,"PostDate":1378670199,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n  