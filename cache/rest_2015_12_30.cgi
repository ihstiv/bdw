727272033691406px; line-height: 15.454545021057129px; \" \/> <br style=\"color: rgb(51, 51, 51); font-family: 'lucida grande', tahoma, verdana, arial, sans-serif; font-size: 12.727272033691406px; line-height: 15.454545021057129px; \" \/> <span  style=\"color: rgb(51, 51, 51);font-family:'lucida grande', tahoma, verdana, arial, sans-serif; line-height: 15.454545021057129px; \">E-mail : info@caribbeanemotions.com\u00a0<\/span><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"info@caibbeanemotions.com","IpAddress":"","GroupId":44,"GroupName":"Vendor","JoinDate":1321631029,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-247824.jpeg?_r=0","PhotoWidth":199,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"caribbeanmotion","Id":247824,"Name":"caribbeanmotion","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":69414,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"627353f5fda9f4ea2624c8e86e405246","RawContent":"&lt;p&gt; I just had my wedding on August 11th and using HDC was the best decision I made.&amp;nbsp; They are absolutely hands down, the BEST in Punta Cana!!!!!&lt;\/p&gt;","Attachments":[],"Id":1667540,"PostDate":1348740892,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I just had my wedding on August 11th and using HDC was the best decision I made.\u00a0 They are absolutely hands down, the BEST in Punta Cana!!!!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lpyrcz@aol.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1311111946,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-242547.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"larissa","Id":242547,"Name":"larissa","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":69414,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d2ecbaa4709538e1cb8f4901d9eb3a3b","RawContent":"&lt;p&gt; HDC is the best. They were punctual, friendly, and the best at their craft!!&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1679623,"PostDate":1351372134,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> HDC is the best. They were punctual, friendly, and the best at their craft!!\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mdf1us@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1323042170,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-248341.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"mdf1us","Id":248341,"Name":"mdf1us","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":69414,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3089f2be22c760d16732e50f338f55de","RawContent":"We just booked them for our 11-12-13 wedding next year. I would love to hear other people&#039;s thoughts on them.","Attachments":[],"Id":1681995,"PostDate":1351875856,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We just booked them for our 11-12-13 wedding next year. I would love to hear other people's thoughts on them.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"britne_johnson@hotmail.com","IpAddress":"75.155.92.158","GroupId":39,"GroupName":"Newbie","JoinDate":1351316524,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-261823.jpg?_r=1396239549","PhotoWidth":200,"PhotoHeight":235,"PhotoType":"custom"},"FormattedName":"britter08","Id":261823,"Name":"britter08","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":69414,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a13704d1619c1a8151260a45b1d9e888","RawContent":"&lt;p&gt; They are amazing they did our wedding in October 2012, absolutly amazing!!! And get the video you wont regret it!!!!&lt;\/p&gt;","Attachments":[],"Id":1683180,"PostDate":1352214758,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> They are amazing they did our wedding in October 2012, absolutly amazing!!! And get the video you wont regret it!!!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mavieroxie@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1352213765,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-262142.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"KasieKane","Id":262142,"Name":"KasieKane","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":69414,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ac47d0a706a78d2fa30aff08012cd253","RawContent":"&lt;p&gt; We had HDC film only the video for our wedding. A video is not something that I originally wanted, but my now-husband convinced me that we would regret not having that memory caught on film...and he was SO right. I am so happy that we decided to get the video, that we can share it with the people who couldn&#039;t be there with us, and even more happy that we decided to go with HDC.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; The communication is outstanding. Although Arnaud did not personally film our wedding, he was super fast with responses (always in the same day, and usually within the hour!) to any e-mail that I sent him. I&#039;m sure everyone understands how important this can be leading up to the wedding day.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Carlos arrived to my room on the on the wedding day a quickly got to work, not wasting any time. He was quiet, and I barely noticed him, but somehow he managed to capture so many beautiful shots of at the little \"details\" that you would want to remember on your wedding day. A handful of times throughout the day he asked me a few questions or to do a few things for the camera, but he was not overbearing in any way and we were more than happy to work with him. He also told me that he was going to stay a a few mintues extra to capture the cake cutting, dress change, and dancing. It meant a lot to me that he didnt even ask, he just did it and now we will have that footage forever. Thank you so much Carlos for your professionalism and your beautiful work!&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; The turn around time is remarkable, especially for the quality of work. Our wedding was friday night and the video was delivered at 9am on Sunday morning. Again, the great communication by this company was KEY, because we had originally planned to meet in the hotel lobby at 9:30, but the next day I realized that our bus would be comming at 9:25 to take us to the airport. Arnaud arranged for Carlos to come at 9am. It was so nice to watch the video on the place ride home.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; The value for money was incredible. Very comparable prices and worth every penny. We also just decided to spend the extra $250 for the highlight video. I think it will be worth it so that you can share the wedding with loved ones without making them sit through 1.5 hours of footage ;) I can&#039;t wait to see it!&lt;\/p&gt;","Attachments":[],"Id":1685595,"PostDate":1352801910,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> We had HDC film only the video for our wedding. A video is not something that I originally wanted, but my now-husband convinced me that we would regret not having that memory caught on film...and he was SO right. I am so happy that we decided to get the video, that we can share it with the people who couldn't be there with us, and even more happy that we decided to go with HDC.<\/p> <p> \u00a0<\/p> <p> The communication is outstanding. Although Arnaud did not personally film our wedding, he was super fast with responses (always in the same day, and usually within the hour!) to any e-mail that I sent him. I'm sure everyone understands how important this can be leading up to the wedding day.<\/p> <p> \u00a0<\/p> <p> Carlos arrived to my room on the on the wedding day a quickly got to work, not wasting any time. He was quiet, and I barely noticed him, but somehow he managed to capture so many beautiful shots of at the little \"details\" that you would want to remember on your wedding day. A handful of times throughout the day he asked me a few questions or to do a few things for the camera, but he was not overbearing in any way and we were more than happy to work with him. He also told me that he was going to stay a a few mintues extra to capture the cake cutting, dress change, and dancing. It meant a lot to me that he didnt even ask, he just did it and now we will have that footage forever. Thank you so much Carlos for your professionalism and your beautiful work!<\/p> <p> \u00a0<\/p> <p> The turn around time is remarkable, especially for the quality of work. Our wedding was friday night and the video was delivered at 9am on Sunday morning. Again, the great communication by this company was KEY, because we had originally planned to meet in the hotel lobby at 9:30, but the next day I realized that our bus would be comming at 9:25 to take us to the airport. Arnaud arranged for Carlos to come at 9am. It was so nice to watch the video on the place ride home.<\/p> <p> \u00a0<\/p> <p> The value for money was incredible. Very comparable prices and worth every penny. We also just decided to spend the extra $250 for the highlight video. I think it will be worth it so that you can share the wedding with loved ones without making them sit through 1.5 hours of footage <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/> I can't wait to see it!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"courtney.naray@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1311069768,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-242517.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"bittersweetD1","Id":242517,"Name":"bittersweetD1","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":69414,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d2206411a01e58f54396102a985fe77d","RawContent":"&lt;p&gt; We had Milan as our photographer and Carlos as the videographer for our wedding in Punta Cana on the 14th of &amp;nbsp;Nov 2012. Their work was phenomenal. From the fun,artistic and unconventional photography by Milan and the super cool videography by Carlos and the phenomenal editing and super fast delivery by Arnaud...we couldn&#039;t have asked for more from anyone. Everyone loved the team ..they made us feel at ease and the pictures captured all our memories so beautifully. Arnaud was very communicative and fast all through the process leading up to the big day and everything was completely painless.We got our photos and video back the day after the wedding in less than 24 hours. I did a lot of research before going with HDC and I am sooooo glad that I did! Worth every single penny!&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1688274,"PostDate":1353437631,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> We had Milan as our photographer and Carlos as the videographer for our wedding in Punta Cana on the 14th of \u00a0Nov 2012. Their work was phenomenal. From the fun,artistic and unconventional photography by Milan and the super cool videography by Carlos and the phenomenal editing and super fast delivery by Arnaud...we couldn't have asked for more from anyone. Everyone loved the team ..they made us feel at ease and the pictures captured all our memories so beautifully. Arnaud was very communicative and fast all through the process leading up to the big day and everything was completely painless.We got our photos and video back the day after the wedding in less than 24 hours. I did a lot of research before going with HDC and I am sooooo glad that I did! Worth every single penny!\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"deepikadavid@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1353437105,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-262563.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"deedavid","Id":262563,"Name":"deedavid","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":69414,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8a8d996002dccd6d7af3fb99a7780ea1","RawContent":"&lt;p&gt; We just used them for our wedding on November 10th at Paradisus Palma Real. &amp;nbsp;I really can&#039;t say enough wonderful things about the whole team. &amp;nbsp;Arnaud very communicative and responsive to all of my emails. &amp;nbsp; He met with us a few days after the wedding so we could choose our pics that would be printed out and we had the video and all the pics before we left! &amp;nbsp;Milan&#039;s photography style is amazing. &amp;nbsp;You can tell he absolutely loves what he does. &amp;nbsp;Our pics are so beautiful!!! &amp;nbsp;All of the guests couldn&#039;t stop raving about how great Milan was. &amp;nbsp;Carlos did an amazing job as well. &amp;nbsp;He quietly stood in the background capturing all of the amazing moments on video and video is incredible!!! &amp;nbsp;We&#039;ve watched it a bunch of times already! &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I just wrote a review about the day so definitely check it out. &amp;nbsp;Let me know if you have any questions. &amp;nbsp;I highly recommend going with HDC. &amp;nbsp;The pics are too beautiful for words! &amp;nbsp;Their work is impeccable! &amp;nbsp;They love what they do and it shows!&lt;\/p&gt;","Attachments":[],"Id":1688637,"PostDate":1353519098,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> We just used them for our wedding on November 10th at Paradisus Palma Real. \u00a0I really can't say enough wonderful things about the whole team. \u00a0Arnaud very communicative and responsive to all of my emails. \u00a0 He met with us a few days after the wedding so we could choose our pics that would be printed out and we had the video and all the pics before we left! \u00a0Milan's photography style is amazing. \u00a0You can tell he absolutely loves what he does. \u00a0Our pics are so beautiful!!! \u00a0All of the guests couldn't stop raving about how great Milan was. \u00a0Carlos did an amazing job as well. \u00a0He quietly stood in the background capturing all of the amazing moments on video and video is incredible!!! \u00a0We've watched it a bunch of times already! \u00a0<\/p> <p> \u00a0<\/p> <p> I just wrote a review about the day so definitely check it out. \u00a0Let me know if you have any questions. \u00a0I highly recommend going with HDC. \u00a0The pics are too beautiful for words! \u00a0Their work is impeccable! \u00a0They love what they do and it shows!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mnocelli@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1320667057,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-247440.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"micheleann","Id":247440,"Name":"micheleann","IsOnline":false}}],"Id":"69414","Title":"HDC Photo","LastPostDate":1447668776},"Pages":{"TotalItems":107,"TotalPages":11,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":100},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
