{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":20,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":5183,"MovedTo":null,"MovedOn":0,"FirstPostId":590677,"Rating":0,"RatingHits":0,"Starter":{"Id":214687,"Name":"ashey063009","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-214687.gif?_r=0","PhotoWidth":71,"PhotoHeight":100,"PhotoType":"custom"},"IsOnline":false},"StartDate":1234462197,"LastPoster":{"Id":282278,"Name":"RitvikSehgal","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282278.png?_r=1425103909","PhotoWidth":200,"PhotoHeight":242,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":45,"Preview":{"Id":590677,"PostDate":1234462197,"PostContent":"Hey All,   I'm looking for a song for my dad and I to dance to in June. He isn't into country (sa...","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t45890\">**Ash's Melia Las Dunas Review **<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t46296\">**Ash's TTD Photos**<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t46293\">**Ash's Wedding Day Photos**<br><\/a><a data-ipb='nomediaparse' href=\"http:\/\/www.ezticker.com\/ticker\/1663\/2120\/20090630\/We+Got+Hitched+in+Cuba%21\/ticker.png\">http:\/\/www.ezticker.com\/ticker\/1663\/...%21\/ticker.png<\/a><\/div><\/div>","Email":"ashley_k_anderson@hotmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1233949984,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-214687.gif?_r=0","PhotoWidth":71,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"ashey063009","Id":214687,"Name":"ashey063009","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":31164,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"415e4295da43c46e4961eda768fc0acc","RawContent":"Hey All, \n \n I&#039;m looking for a song for my dad and I to dance to in June. He isn&#039;t into country (sad, I know, I love it) and I&#039;m very against bad 1970s music -- or anything that sounds like it. \n \n I&#039;d really love something contemporary or funky, like a David Gray or Eva Cassidy. Any ideas?? Thanks a million in advance, you ladies always have so many great ideas!","Attachments":[],"Id":590677,"PostDate":1234462197,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hey All, <br \/> <br \/> I'm looking for a song for my dad and I to dance to in June. He isn't into country (sad, I know, I love it) and I'm very against bad 1970s music -- or anything that sounds like it. <br \/> <br \/> I'd really love something contemporary or funky, like a David Gray or Eva Cassidy. Any ideas?? Thanks a million in advance, you ladies always have so many great ideas!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t45890\">**Ash's Melia Las Dunas Review **<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t46296\">**Ash's TTD Photos**<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t46293\">**Ash's Wedding Day Photos**<br><\/a><a data-ipb='nomediaparse' href=\"http:\/\/www.ezticker.com\/ticker\/1663\/2120\/20090630\/We+Got+Hitched+in+Cuba%21\/ticker.png\">http:\/\/www.ezticker.com\/ticker\/1663\/...%21\/ticker.png<\/a><\/div><\/div>","Email":"ashley_k_anderson@hotmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1233949984,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-214687.gif?_r=0","PhotoWidth":71,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"ashey063009","Id":214687,"Name":"ashey063009","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":31164,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e70d5de8840a9e7dd382b1a9cdd83cdc","RawContent":"I&#039;m not one of the ladies...\n \n ...but there are some great songs out there. Check out some suggestions in this thread:\n \n &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/bestdestinationwedding.com\/forum\/t4980\"&gt;http:\/\/bestdestinationwedding.com\/forum\/t4980&lt;\/a&gt;\n \n For me, the song I&#039;m going to dance to with my daughter on her wedding day is &amp;quot;Cinderella&amp;quot; by Steven Curtis Chapman - Not very funky, but describes exactly the way I feel about her. \n \n Check out these lyrics:\n \n She spins and she sways to whatever song plays,\n Without a care in the world.\n And I&#039;m sittin&#039; here wearin&#039; the weight of the world on my shoulders.\n It&#039;s been a long day and there&#039;s still work to do,\n She&#039;s pulling at me saying &amp;quot;Dad I need you!\n There&#039;s a ball at the castle and I&#039;ve been invited and I need to practice my dancin&#039;&amp;quot;\n &amp;quot;Oh please, daddy, please!&amp;quot;\n \n So I will dance with Cinderella\n While she is here in my arms\n &#039;Cause I know something the prince never knew\n Oh I will dance with Cinderella\n I don&#039;t wanna miss even one song,\n Cuz all too soon the clock will strike midnight\n And she&#039;ll be gone\n \n She says he&#039;s a nice guy and I&#039;d be impressed\n She wants to know if I approve of the dress\n She says &amp;quot;Dad, the prom is just one week away,\n And I need to practice my dancin&#039;&amp;quot;\n &amp;quot;Oh please, daddy, please!&amp;quot;\n \n So I will dance with Cinderella\n While she is here in my arms\n &#039;Cause I know something the prince never knew\n Ohh-oh ohh-oh, I will dance with Cinderella\n I don&#039;t wanna miss even one song,\n Cuz all too soon the clock will strike midnight\n And she&#039;ll be gone\n She will be gone.\n \n Well, she came home today\n With a ring on her hand\n Just glowin&#039; and tellin&#039; us all they had planned\n She says &amp;quot;Dad, the wedding&#039;s still six months away\n but I need to practice my dancin&#039;&amp;quot;\n &amp;quot;Oh please, daddy please!&amp;quot;\n \n So I will dance with Cinderella\n While she is here in my arms\n &#039;Cause I know something the prince never knew\n Ohh-oh ohh-oh, I will dance with Cinderella\n I don&#039;t wanna miss even one song,\n (even one song)\n Cuz all too soon the clock will strike midnight\n And she&#039;ll be gone","Attachments":[],"Id":595537,"PostDate":1234906882,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm not one of the ladies...<br \/> <br \/> ...but there are some great songs out there. Check out some suggestions in this thread:<br \/> <br \/> <a href='http:\/\/bestdestinationwedding.com\/forum\/t4980' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/bestdestinati...com\/forum\/t4980<\/a><br \/> <br \/> For me, the song I'm going to dance to with my daughter on her wedding day is \"Cinderella\" by Steven Curtis Chapman - Not very funky, but describes exactly the way I feel about her. <br \/> <br \/> Check out these lyrics:<br \/> <br \/> She spins and she sways to whatever song plays,<br \/> Without a care in the world.<br \/> And I'm sittin' here wearin' the weight of the world on my shoulders.<br \/> It's been a long day and there's still work to do,<br \/> She's pulling at me saying \"Dad I need you!<br \/> There's a ball at the castle and I've been invited and I need to practice my dancin'\"<br \/> \"Oh please, daddy, please!\"<br \/> <br \/> So I will dance with Cinderella<br \/> While she is here in my arms<br \/> 'Cause I know something the prince never knew<br \/> Oh I will dance with Cinderella<br \/> I don't wanna miss even one song,<br \/> Cuz all too soon the clock will strike midnight<br \/> And she'll be gone<br \/> <br \/> She says he's a nice guy and I'd be impressed<br \/> She wants to know if I approve of the dress<br \/> She says \"Dad, the prom is just one week away,<br \/> And I need to practice my dancin'\"<br \/> \"Oh please, daddy, please!\"<br \/> <br \/> So I will dance with Cinderella<br \/> While she is here in my arms<br \/> 'Cause I know something the prince never knew<br \/> Ohh-oh ohh-oh, I will dance with Cinderella<br \/> I don't wanna miss even one song,<br \/> Cuz all too soon the clock will strike midnight<br \/> And she'll be gone<br \/> She will be gone.<br \/> <br \/> Well, she came home today<br \/> With a ring on her hand<br \/> Just glowin' and tellin' us all they had planned<br \/> She says \"Dad, the wedding's still six months away<br \/> but I need to practice my dancin'\"<br \/> \"Oh please, daddy please!\"<br \/> <br \/> So I will dance with Cinderella<br \/> While she is here in my arms<br \/> 'Cause I know something the prince never knew<br \/> Ohh-oh ohh-oh, I will dance with Cinderella<br \/> I don't wanna miss even one song,<br \/> (even one song)<br \/> Cuz all too soon the clock will strike midnight<br \/> And she'll be gone\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nathaniel@nathanielthompson.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1200693407,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208282.jpg?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"nathanielthompsonphoto","Id":208282,"Name":"nathanielthompsonphoto","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":31164,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"032c2b8f8b13c366581ee810845efebb","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;ashey063009&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;I&#039;m looking for a song for my dad and I to dance to in June. He isn&#039;t into country (sad, I know, I love it)&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;i have the opposite problem, LOL! i loathe most country music, but someone played heartland&#039;s &amp;quot;i loved her first&amp;quot; for him and he loves it. the lyrics are nice, so i&#039;m gonna suck it up since it&#039;s what he picked and he loves it so much. i just really didn&#039;t want a tearjerker since i&#039;m such a crybaby, LOL.","Attachments":[],"Id":595725,"PostDate":1234915738,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>ashey063009<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">I'm looking for a song for my dad and I to dance to in June. He isn't into country (sad, I know, I love it)<\/div> <\/td> <\/tr> <\/table> <\/div>i have the opposite problem, LOL! i loathe most country music, but someone played heartland's \"i loved her first\" for him and he loves it. the lyrics are nice, so i'm gonna suck it up since it's what he picked and he loves it so much. i just really didn't want a tearjerker since i'm such a crybaby, LOL.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-size:10px;\"><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/forum\/thread\/48680\/mummergirl-s-totally-after-the-fact-planning-thread#post_963823\">My After-the-Fact Planning Thread<\/a><\/span>","Email":"mummergirl@yahoo.com","IpAddress":"68.83.34.78","GroupId":46,"GroupName":"VIP Member","JoinDate":1207088760,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208981.jpg?_r=1389220347","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"cougs","Id":208981,"Name":"cougs","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":31164,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c335587164180f885da264f1db77174e","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;nathanielthompsonphoto&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;For me, the song I&#039;m going to dance to with my daughter on her wedding day is &amp;quot;Cinderella&amp;quot; by Steven Curtis Chapman - Not very funky, but describes exactly the way I feel about her.&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;great lyrics, and i think it&#039;s wonderful that you found a song that reflects your personal father\/daughter relationship. very sweet! :)","Attachments":[],"Id":595728,"PostDate":1234915736,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>nathanielthompsonphoto<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">For me, the song I'm going to dance to with my daughter on her wedding day is \"Cinderella\" by Steven Curtis Chapman - Not very funky, but describes exactly the way I feel about her.<\/div> <\/td> <\/tr> <\/table> <\/div>great lyrics, and i think it's wonderful that you found a song that reflects your personal father\/daughter relationship. very sweet! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-size:10px;\"><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/forum\/thread\/48680\/mummergirl-s-totally-after-the-fact-planning-thread#post_963823\">My After-the-Fact Planning Thread<\/a><\/span>","Email":"mummergirl@yahoo.com","IpAddress":"68.83.34.78","GroupId":46,"GroupName":"VIP Member","JoinDate":1207088760,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208981.jpg?_r=1389220347","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"cougs","Id":208981,"Name":"cougs","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":31164,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2644623e725f8a97c6c560232e0bd1c1","RawContent":"I choose &amp;quot;Somewhere over the rainbow&amp;quot; by Iz for my father\/daughter dance. It means something to us, so it was perfect","Attachments":[],"Id":595794,"PostDate":1234919108,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I choose \"Somewhere over the rainbow\" by Iz for my father\/daughter dance. It means something to us, so it was perfect\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Lindsay and Jamie - January 28, 2009<\/span><\/div><\/div>","Email":"lindsay_a_West@hotmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1207534138,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209032.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"seaprincess","Id":209032,"Name":"seaprincess","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":31164,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"59e0c4571edb7cea45edb6588b5167b6","RawContent":"I choose &amp;quot;Somewhere over the rainbow&amp;quot; by Iz for my father\/daughter dance. It means something to us, so it was perfect","Attachments":[],"Id":595795,"PostDate":1234919123,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I choose \"Somewhere over the rainbow\" by Iz for my father\/daughter dance. It means something to us, so it was perfect\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Lindsay and Jamie - January 28, 2009<\/span><\/div><\/div>","Email":"lindsay_a_West@hotmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1207534138,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209032.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"seaprincess","Id":209032,"Name":"seaprincess","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":31164,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d26c9fd8b5659928373f3cc158bb9579","RawContent":"I checked around and found a song by Billy Joel, what do you guys think? \n \n Billy Joel - Lullaby (Good Night My Angel)\n \n &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.youtube.com\/watch?v=xebnpP2BFPI\"&gt;YouTube - Billy Joel - Lullaby (Goodnight, My Angel) - with lyrics&lt;\/a&gt;\n \n *Verse 1*\n Good night my angel time to close you eyes\n And save these questions for another day\n I think I know what you&#039;ve been asking me \n I think you know what I&#039;ve been trying to say\n \n I promised I would never leave you\n And you should always know\n Where ever you may go\n No matter where you are\n I never will be far away\n \n *Verse 2*\n Good night my angel now it&#039;s time to sleep\n And still so many things I want to say\n Remember all the songs you sang for me\n When we went sailing on an emerald bay\n \n And like a boat out on the ocean\n I&#039;m rocking you to sleep\n The water&#039;s dark and deep \n Inside this ancient heart\n You&#039;ll always be a part of me\n \n (Musical Bridge)\n Do do do do...\n \n *Verse 3*\n Goodnight my angel now it&#039;s time to dream\n And dream how wondeful your life will be\n Someday your child will cry and if you sing this lullaby\n Then in your heart there will always be a part of me\n \n Someday we&#039;ll all be gone \n But lullabies go on and on\n They never die that&#039;s how you and I will be","Attachments":[],"Id":595833,"PostDate":1234921347,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I checked around and found a song by Billy Joel, what do you guys think? <br \/> <br \/> Billy Joel - Lullaby (Good Night My Angel)<br \/> <br \/> <a href='http:\/\/www.youtube.com\/watch?v=xebnpP2BFPI' class='bbc_url' title='External link' rel='nofollow external'>YouTube - Billy Joel - Lullaby (Goodnight, My Angel) - with lyrics<\/a><br \/> <br \/> *Verse 1*<br \/> Good night my angel time to close you eyes<br \/> And save these questions for another day<br \/> I think I know what you've been asking me <br \/> I think you know what I've been trying to say<br \/> <br \/> I promised I would never leave you<br \/> And you should always know<br \/> Where ever you may go<br \/> No matter where you are<br \/> I never will be far away<br \/> <br \/> *Verse 2*<br \/> Good night my angel now it's time to sleep<br \/> And still so many things I want to say<br \/> Remember all the songs you sang for me<br \/> When we went sailing on an emerald bay<br \/> <br \/> And like a boat out on the ocean<br \/> I'm rocking you to sleep<br \/> The water's dark and deep <br \/> Inside this ancient heart<br \/> You'll always be a part of me<br \/> <br \/> (Musical Bridge)<br \/> Do do do do...<br \/> <br \/> *Verse 3*<br \/> Goodnight my angel now it's time to dream<br \/> And dream how wondeful your life will be<br \/> Someday your child will cry and if you sing this lullaby<br \/> Then in your heart there will always be a part of me<br \/> <br \/> Someday we'll all be gone <br \/> But lullabies go on and on<br \/> They never die that's how you and I will be\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.baby-gaga.com\/p\/dev241ps___.png\">http:\/\/tickers.baby-gaga.com\/p\/dev241ps___.png<\/a><\/div><\/div>","Email":"michaelandjennifer328@comcast.net","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1186959004,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207611.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Jenn3878","Id":207611,"Name":"Jenn3878","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":31164,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"286a078409cda4fa134c2c1c6f34bb98","RawContent":"my best friend (MOH) used billy joel &amp;quot;lullaby&amp;quot; at her wedding and there wasn&#039;t a dry eye (my dad was there and even he got a little choked up) ... it&#039;s really beautiful.","Attachments":[],"Id":595852,"PostDate":1234922123,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                my best friend (MOH) used billy joel \"lullaby\" at her wedding and there wasn't a dry eye (my dad was there and even he got a little choked up) ... it's really beautiful.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-size:10px;\"><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/forum\/thread\/48680\/mummergirl-s-totally-after-the-fact-planning-thread#post_963823\">My After-the-Fact Planning Thread<\/a><\/span>","Email":"mummergirl@yahoo.com","IpAddress":"68.83.34.78","GroupId":46,"GroupName":"VIP Member","JoinDate":1207088760,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208981.jpg?_r=1389220347","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"cougs","Id":208981,"Name":"cougs","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":31164,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0