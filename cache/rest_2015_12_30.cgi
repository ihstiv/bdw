{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":5,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":1120,"MovedTo":null,"MovedOn":0,"FirstPostId":1903023,"Rating":0,"RatingHits":0,"Starter":{"Id":284508,"Name":"dreia85","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284508.jpg?_r=1440129039","PhotoWidth":190,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":false},"StartDate":1440110256,"LastPoster":{"Id":277031,"Name":"MrandMrsBonitto2016","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277031.jpg?_r=1397251056","PhotoWidth":200,"PhotoHeight":203,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":22,"Preview":{"Id":1903023,"PostDate":1440110256,"PostContent":"Hi,\u00a0 \u00a0 I am getting married in Punta Cana in July 2016 and am having a hard time finding a make u...","Author":{"Signature":"","Email":"iidreiaii@aol.com","IpAddress":"100.8.175.179","GroupId":39,"GroupName":"Newbie","JoinDate":1440109346,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284508.jpg?_r=1440129039","PhotoWidth":190,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"dreia85","Id":284508,"Name":"dreia85","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"100.8.175.179","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79517,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"37e8c3486593248d5b0b086be67b604c","RawContent":"&lt;p&gt;Hi,&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am getting married in Punta Cana in July 2016 and am having a hard time finding a make up artist and hair stylist. I&#039;ve contacted Kistie Ann, Anna Nuet and Indira Sanchez, but they are unavailable or need a specific # of people to book.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I would appreciate any suggestions. Thanks so much!&lt;\/p&gt;","Attachments":[],"Id":1903023,"PostDate":1440110256,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi,\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I am getting married in Punta Cana in July 2016 and am having a hard time finding a make up artist and hair stylist. I've contacted Kistie Ann, Anna Nuet and Indira Sanchez, but they are unavailable or need a specific # of people to book.<\/p>\n<p>\u00a0<\/p>\n<p>I would appreciate any suggestions. Thanks so much!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"iidreiaii@aol.com","IpAddress":"100.8.175.179","GroupId":39,"GroupName":"Newbie","JoinDate":1440109346,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284508.jpg?_r=1440129039","PhotoWidth":190,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"dreia85","Id":284508,"Name":"dreia85","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"172.56.18.144","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79517,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"53deeef36a68324ccd6054519609d560","RawContent":"I&#039;m getting married this November and I contacted a friend who has family in punta Cana, they highly recommended the Eden beauty spa located in punta Cana check them out!! They have fb and Instagram","Attachments":[],"Id":1903075,"PostDate":1440155142,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm getting married this November and I contacted a friend who has family in punta Cana, they highly recommended the Eden beauty spa located in punta Cana check them out!! They have fb and Instagram\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"joymelody18@gmail.com","IpAddress":"172.56.18.144","GroupId":39,"GroupName":"Newbie","JoinDate":1440153439,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284519.jpg?_r=1441069886","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"JoyMelodyKreig","Id":284519,"Name":"JoyMelodyKreig","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"100.8.175.179","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79517,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f658088134b9a68c980bd6d8b4ac8884","RawContent":"&lt;span&gt;@&lt;a  class=\"\" href=\"http:\/\/www.bestdestinationwedding.com\/user\/284519-joymelodykreig\/\" title=\"\"&gt;JoyMelodyKreig&lt;\/a&gt;&lt;\/span&gt;\n&lt;p&gt;Were you able to get in touch with anyone there? Have you seen pictures of their work?&lt;\/p&gt;","Attachments":[],"Id":1905716,"PostDate":1443636828,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                \n\t<span>@<a href='http:\/\/www.bestdestinationwedding.com\/user\/284519-joymelodykreig\/' class='bbc_url' title=''>JoyMelodyKreig<\/a><\/span>\n<p>Were you able to get in touch with anyone there? Have you seen pictures of their work?<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"iidreiaii@aol.com","IpAddress":"100.8.175.179","GroupId":39,"GroupName":"Newbie","JoinDate":1440109346,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284508.jpg?_r=1440129039","PhotoWidth":190,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"dreia85","Id":284508,"Name":"dreia85","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"172.56.34.58","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79517,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c13a088260b3a3e25c20d3b5a90d7524","RawContent":"Check a post I made a few months back. It should be helpful. Good Luck","Attachments":[],"Id":1905953,"PostDate":1444063991,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Check a post I made a few months back. It should be helpful. Good Luck\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p style=\"text-align:center;\">\u00a0 \u00a0 \u00a0 \u00a0 \u00a0 Future Mrs. Bonitto 12\/14\/16<\/p>\n<div><br><div style=\"text-align:center;\"><br><div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.weddingcountdown.com\/\"><img src=\"http:\/\/img.weddingcountdown.com\/ticker\/30ag12yqu333h.png\" alt=\"30ag12yqu333h.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<\/div>\n<\/div>\n<p>\u00a0","Email":"shamicaglover@yahoo.com","IpAddress":"161.185.157.23","GroupId":40,"GroupName":"Jr. Member","JoinDate":1394115176,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277031.jpg?_r=1397251056","PhotoWidth":200,"PhotoHeight":203,"PhotoType":"custom"},"FormattedName":"MrandMrsBonitto2016","Id":277031,"Name":"MrandMrsBonitto2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"161.185.161.116","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79517,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3892d2443ba2933f5b9183bc71750a99","RawContent":"[quote name=\"dreia85\" post=\"1903023\" timestamp=\"1440128256\"]\nHi, \n\nI am getting married in Punta Cana in July 2016 and am having a hard time finding a make up artist and hair stylist. I&#039;ve contacted Kistie Ann, Anna Nuet and Indira Sanchez, but they are unavailable or need a specific # of people to book.\n\nI would appreciate any suggestions. Thanks so much![\/quote] Contact Jazmin Abrito","Attachments":[],"Id":1906545,"PostDate":1445237964,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>dreia85, on 20 August 2015 - 10:37 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hi,\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I am getting married in Punta Cana in July 2016 and am having a hard time finding a make up artist and hair stylist. I've contacted Kistie Ann, Anna Nuet and Indira Sanchez, but they are unavailable or need a specific # of people to book.<\/p>\n<p>\u00a0<\/p>\n<p>I would appreciate any suggestions. Thanks so much!<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0Contact Jazmin Abrito<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p style=\"text-align:center;\">\u00a0 \u00a0 \u00a0 \u00a0 \u00a0 Future Mrs. Bonitto 12\/14\/16<\/p>\n<div><br><div style=\"text-align:center;\"><br><div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.weddingcountdown.com\/\"><img src=\"http:\/\/img.weddingcountdown.com\/ticker\/30ag12yqu333h.png\" alt=\"30ag12yqu333h.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<\/div>\n<\/div>\n<p>\u00a0","Email":"shamicaglover@yahoo.com","IpAddress":"161.185.157.23","GroupId":40,"GroupName":"Jr. Member","JoinDate":1394115176,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277031.jpg?_r=1397251056","PhotoWidth":200,"PhotoHeight":203,"PhotoType":"custom"},"FormattedName":"MrandMrsBonitto2016","Id":277031,"Name":"MrandMrsBonitto2016","IsOnline":false}}],"Id":"79517","Title":"Make-Up & Hairstylist In Punta Cana","LastPostDate":1445237964},"Pages":{"TotalItems":5,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
