ght.netdna-cdn.com\/cdn\/profile\/photo-211327.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"reevesbride","Id":211327,"Name":"reevesbride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27267,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2390c6e790b9f9aa14824f273b83e0b5","RawContent":"I wanted to do it to &amp;quot;Your Arms&amp;quot; by Three Doors Down, but decided to take the traditional route with one of my favorite classical pieces: Canon in D. :)","Attachments":[],"Id":521111,"PostDate":1227807455,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I wanted to do it to \"Your Arms\" by Three Doors Down, but decided to take the traditional route with one of my favorite classical pieces: Canon in D. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"signaorion@hotmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1221772200,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211816.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"~*Kathy*~","Id":211816,"Name":"~*Kathy*~","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27267,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"5922494c63d37b2ada912a3ad782012c","RawContent":"We are walking down and away to Israel Kamakawiwo&#039;s version of Somewhere over the Rainbow and What a beautiful world. It was in 50 first dates.","Attachments":[],"Id":521120,"PostDate":1227810733,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We are walking down and away to Israel Kamakawiwo's version of Somewhere over the Rainbow and What a beautiful world. It was in 50 first dates.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Like our first kiss all over again<\/span><\/div><\/div>","Email":"saraece@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1168207640,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207034.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"saraece","Id":207034,"Name":"saraece","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27267,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fc3a593ec3eb01397c7507e7fc68bd4a","RawContent":"Saraece I love that song too - that is what we are walking back up the aisle to (recessional?) after the ceremony. It is beachy and happy and I love it!\n I am walking down the aisle to &amp;quot;Home&amp;quot; by Chantal Kreviazuk. The trick for me will be not to cry since when I hear that song, I tend to get teary!","Attachments":[],"Id":521125,"PostDate":1227811807,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Saraece I love that song too - that is what we are walking back up the aisle to (recessional?) after the ceremony. It is beachy and happy and I love it!<br \/> I am walking down the aisle to \"Home\" by Chantal Kreviazuk. The trick for me will be not to cry since when I hear that song, I tend to get teary!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sara.klassen@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1225215311,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-212442.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"sarafish81","Id":212442,"Name":"sarafish81","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27267,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"26025fb3cf9baf4914e3cf965d87dc09","RawContent":"I am working on my music now and I think I am going to have the Bridal Party walk to Bless the Broken Road by Rascal Flatts and then I am going to probably walk to the traditional wedding March.","Attachments":[],"Id":521130,"PostDate":1227812483,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I am working on my music now and I think I am going to have the Bridal Party walk to Bless the Broken Road by Rascal Flatts and then I am going to probably walk to the traditional wedding March.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Shannon<\/span><br><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10747;0\/st\/20090626\/e\/Our+Wedding\/k\/4ead\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...4ead\/event.png<\/a><\/div><\/div>","Email":"Shannon_Straughn@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1223070930,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-212118.gif?_r=0","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"FormattedName":"Solidshan83","Id":212118,"Name":"Solidshan83","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27267,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":3,"IsLiked":false,"PostKey":"001268f482ecaf08c4f9178348bcc297","R