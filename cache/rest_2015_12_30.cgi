\/cdn\/profile\/photo-270042.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"lululuvs2travel","Id":270042,"Name":"lululuvs2travel","IsOnline":false}},"Posts":[],"Id":"79632","Title":"Wedding June 2016... Which Resort? Please Help!","LastPostDate":1450877057},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":15,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":826,"MovedTo":null,"MovedOn":0,"FirstPostId":1887640,"Rating":0,"RatingHits":0,"Starter":{"Id":282132,"Name":"KatieMcBride","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282132.jpg?_r=1437519508","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"StartDate":1424973512,"LastPoster":{"Id":282132,"Name":"KatieMcBride","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282132.jpg?_r=1437519508","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":2,"Preview":{"Id":1887640,"PostDate":1424973512,"PostContent":"Hi everyone! I'm getting married at the Riu Caribe next April, but they told me I am not able to...","Author":{"Signature":"","Email":"katie_mcbride48@yahoo.ca","IpAddress":"199.85.228.129","GroupId":39,"GroupName":"Newbie","JoinDate":1424096250,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282132.jpg?_r=1437519508","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"KatieMcBride","Id":282132,"Name":"KatieMcBride","IsOnline":false}},"Posts":[],"Id":"78849","Title":"Riu Private Receptions","LastPostDate":1450808388},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":16,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":615,"MovedTo":null,"MovedOn":0,"FirstPostId":1908507,"Rating":0,"RatingHits":0,"Starter":{"Id":279721,"Name":"Wafflesmom","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279721.jpg?_r=1444491864","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":true},"StartDate":1450556849,"LastPoster":{"Id":250090,"Name":"dreamweddings","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250090.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":2,"Preview":{"Id":1908507,"PostDate":1450556849,"PostContent":"31 days, my guests and I are exactly 1 month away from boarding a plane to celebrate our wedding...","Author":{"Signature":"My planning thread: <a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/79425-wafflesmom-moon-palace-planning-thread-january-23-2016\/\">http:\/\/www.bestdestinationwedding.com\/topic\/79425-wafflesmom-moon-palace-planning-thread-january-23-2016\/<\/a><br><br>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;4;484\/st\/20160123\/e\/Our+Wedding\/dt\/-2\/k\/44c5\/event.png\" alt=\"event.png\"><\/a>","Email":"jerilee.valenzuela@shaw.ca","IpAddress":"24.114.26.77","GroupId":3,"GroupName":"Member","JoinDate":1410080585,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279721.jpg?_r=1444491864","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Wafflesmom","Id":279721,"Name":"Wafflesmom","IsOnline":true}},"Posts":[],"Id":"79801","Title":"Mexico Travel: Tips, Tricks And Advice","LastPostDate":1450800589},{"State":"o