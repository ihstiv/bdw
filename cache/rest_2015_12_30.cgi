{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":19,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":true,"Views":2293,"MovedTo":null,"MovedOn":0,"FirstPostId":1882654,"Rating":0,"RatingHits":0,"Starter":{"Id":281700,"Name":"Stephieee","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1421075333,"LastPoster":{"Id":285230,"Name":"Deannak","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1882654,"PostDate":1421075333,"PostContent":"I never thought planning a wedding would be so overwhelming. \u00a0 I just contacted a travel agent th...","Author":{"Signature":"","Email":"stephanie_antoinette@yahoo.com","IpAddress":"24.176.205.226","GroupId":39,"GroupName":"Newbie","JoinDate":1421074486,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Stephieee","Id":281700,"Name":"Stephieee","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.176.205.226","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78590,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c5753323db83d1f6419a790108629dda","RawContent":"&lt;p&gt;I never thought planning a wedding would be so overwhelming.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I just contacted a travel agent through a list of specialized Royal Wedding Specialist ( We want the Royal Playa Del Carmen).&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am not sure if that was the right first step, or if I was supposed to reach out to someone from the hotel first.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Are the prices online, pretty close to accurate - Im not sure how to figure all that out.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I know I need a photographer out there, so any recommendation would be great! I am also super interested in a videographer.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I decided on a destination wedding because I thought it would be more affordable. Is 10k a realisitc amount for a wedding of 20-40 people?&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;any advice, input etc would be great!&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1882654,"PostDate":1421075333,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I never thought planning a wedding would be so overwhelming.<\/p>\n<p>\u00a0<\/p>\n<p>I just contacted a travel agent through a list of specialized Royal Wedding Specialist ( We want the Royal Playa Del Carmen).<\/p>\n<p>\u00a0<\/p>\n<p>I am not sure if that was the right first step, or if I was supposed to reach out to someone from the hotel first.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Are the prices online, pretty close to accurate - Im not sure how to figure all that out.<\/p>\n<p>\u00a0<\/p>\n<p>I know I need a photographer out there, so any recommendation would be great! I am also super interested in a videographer.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I decided on a destination wedding because I thought it would be more affordable. Is 10k a realisitc amount for a wedding of 20-40 people?\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>any advice, input etc would be great!\u00a0<\/p>\n<p>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"stephanie_antoinette@yahoo.com","IpAddress":"24.176.205.226","GroupId":39,"GroupName":"Newbie","JoinDate":1421074486,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Stephieee","Id":281700,"Name":"Stephieee","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"216.166.10.202","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78590,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"2d60a9ff0717b470a7749357097d692f","RawContent":"&lt;p&gt;Hey there! I was married at Now Jade last year. We spent about $15,000 for the two of us and our immediate family (with everything all together - flight, wedding package, dress, suit, decor, photographer, DJ, etc) and our guests paid their own way and rooms. I think you can contact either the hotel or a travel agent. I personally went straight to the hotel wedding coordinator to book, but my friend used a travel agent for her wedding. So, I don&#039;t think it matters. A travel agent might be easier to arrange flights and stuff too though. We did that part on our own.&lt;\/p&gt;\n&lt;p&gt;First step, research your resorts and book. Next step find your photographer\/videographer. Our photographer created our wedding day itinerary for us and gave us a lot of advice. It really took a lot of pressure off. We used Bohemia Photography, I was very happy them. I actually just got on here to review them, I didn&#039;t know this site was here for my wedding (which would&#039;ve been nice)! Their website is www.bohemia-photography.com&lt;\/p&gt;\n&lt;p&gt;Best of luck to you! And just remember, nothing is ever perfect, so just go with it!&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1882703,"PostDate":1421101993,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hey there! I was married at Now Jade last year. We spent about $15,000 for the two of us and our immediate family (with everything all together - flight, wedding package, dress, suit, decor, photographer, DJ, etc) and our guests paid their own way and rooms. I think you can contact either the hotel or a travel agent. I personally went straight to the hotel wedding coordinator to book, but my friend used a travel agent for her wedding. So, I don't think it matters. A travel agent might be easier to arrange flights and stuff too though. We did that part on our own.<\/p>\n<p>First step, research your resorts and book. Next step find your photographer\/videographer. Our photographer created our wedding day itinerary for us and gave us a lot of advice. It really took a lot of pressure off. We used Bohemia Photography, I was very happy them. I actually just got on here to review them, I didn't know this site was here for my wedding (which would've been nice)! Their website is www.bohemia-photography.com<\/p>\n<p>Best of luck to you! And just remember, nothing is ever perfect, so just go with it!\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"melanieperez833@gmail.com","IpAddress":"216.166.10.202","GroupId":39,"GroupName":"Newbie","JoinDate":1421098795,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281707.jpg?_r=1421118242","PhotoWidth":200,"PhotoHeight":269,"PhotoType":"custom"},"FormattedName":"PalmTreeDreams","Id":281707,"Name":"PalmTreeDreams","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.101.83.185","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78590,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c95c5ce639ba6e9262bb264c40e8dcc0","RawContent":"&lt;p&gt;Congrats and welcome to the site! This is a great place for information that will help you on your planning adventure! I&#039;m going to suggest that finding a travel agent is your first best step. They will become your buddy through the planning process and will help take a lot of the stress off you, as well as being the contact for your guests. If you&#039;re in the US, Wright Travel is affiliated with this site and they are destination wedding experts!! There is no charge for them to work with you. If you&#039;re still trying to decide on the where and when, definitely talk to a TA and they will help you sort out your must haves and help you work out a destination.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Once you have the where, go through the forums here and get to know the other brides that are using the same resort. As well there are the vendor reviews that will give you some ideas. There are a ton of photographer reviews as well that will help you sort through and find a photographer who&#039;s style you like. Contact them and get their pricing and get a feel from them before you decide.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Here is the link to contacting Wright Travel:&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.wrighttravelagency.com\/go\/plan-your-destination-wedding?keyword=BDWTB&#039;&gt;http:\/\/www.wrighttravelagency.com\/go\/plan-your-destination-wedding?keyword=BDWTB&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck and happy planning!&lt;\/p&gt;","Attachments":[],"Id":1882708,"PostDate":1421105167,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats and welcome to the site! This is a great place for information that will help you on your planning adventure! I'm going to suggest that finding a travel agent is your first best step. They will become your buddy through the planning process and will help take a lot of the stress off you, as well as being the contact for your guests. If you're in the US, Wright Travel is affiliated with this site and they are destination wedding experts!! There is no charge for them to work with you. If you're still trying to decide on the where and when, definitely talk to a TA and they will help you sort out your must haves and help you work out a destination.<\/p>\n<p>\u00a0<\/p>\n<p>Once you have the where, go through the forums here and get to know the other brides that are using the same resort. As well there are the vendor reviews that will give you some ideas. There are a ton of photographer reviews as well that will help you sort through and find a photographer who's style you like. Contact them and get their pricing and get a feel from them before you decide.<\/p>\n<p>\u00a0<\/p>\n<p>Here is the link to contacting Wright Travel:<\/p>\n<p>\u00a0<\/p>\n<p><a href='http:\/\/www.wrighttravelagency.com\/go\/plan-your-destination-wedding?keyword=BDWTB' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.wrighttra...g?keyword=BDWTB<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Good luck and happy planning!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283440999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.143.225.246","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78590,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"63338b0b374c6037ced895e14a5583c1","RawContent":"Congratulations!!!! You will find the brides here amazing and the ideas shared such an inspiration toward your magical day!!\n\n\nTalk to a TA as a first step!","Attachments":[],"Id":1882712,"PostDate":1421107860,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Congratulations!!!! You will find the brides here amazing and the ideas shared such an inspiration toward your magical day!!<br><br>\nTalk to a TA as a first step! \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kmkwedding2016@gmail.com","IpAddress":"70.72.195.234","GroupId":38,"GroupName":"Moderators","JoinDate":1390238608,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kmk2016","Id":276231,"Name":"kmk2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"190.167.87.137","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78590,"EditedBy":"<strong>Edited by Moments That Matter, 13 January 2015 - 10:40 AM.<\/strong>","EditDate":1421145604,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"d905daf6661fd69cdf3d525985f918e5","RawContent":"&lt;p&gt;Congrats on your upcoming Royal Wedding in PdC, Stephieee, and welcome to our forum community!!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;You&#039;ve picked a gorgeous venue for your Special Day, and can see what a beautiful backdrop it will make for your photos here: &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10152516859384487.1073741901.18683524486&amp;amp;type=3&#039;&gt;Royal Wedding PdC Album&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-b-iad.xx.fbcdn.net\/hphotos-xap1\/t31.0-8\/10397119_10152516861699487_2016771516330569174_o.jpg\" alt=\"10397119_10152516861699487_2016771516330\"&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-a-iad.xx.fbcdn.net\/hphotos-xpf1\/t31.0-8\/10468123_10152516862839487_1001871744561080720_o.jpg\" alt=\"10468123_10152516862839487_1001871744561\"&gt;&lt;\/p&gt;\n&lt;p&gt;...so you can see you&#039;ve already started with a Great Choice for your first step!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Possibly focusing on the end result will help ease feeling so overwhelmed, and get those \"stomach butterflies flying in formation!\"&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Wishing you all the best with your plans - cheers!!! team MTM :)&lt;\/p&gt;","Attachments":[],"Id":1882728,"PostDate":1421145112,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats on your upcoming Royal Wedding in PdC, Stephieee, and welcome to our forum community!!!<\/p>\n<p>\u00a0<\/p>\n<p>You've picked a gorgeous venue for your Special Day, and can see what a beautiful backdrop it will make for your photos here: <a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10152516859384487.1073741901.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>Royal Wedding PdC Album<\/a><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-b-iad.xx.fbcdn.net\/hphotos-xap1\/t31.0-8\/10397119_10152516861699487_2016771516330569174_o.jpg\" alt=\"10397119_10152516861699487_2016771516330\"><\/span><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-a-iad.xx.fbcdn.net\/hphotos-xpf1\/t31.0-8\/10468123_10152516862839487_1001871744561080720_o.jpg\" alt=\"10468123_10152516862839487_1001871744561\"><\/span><\/p>\n<p>...so you can see you've already started with a Great Choice for your first step!<\/p>\n<p>\u00a0<\/p>\n<p>Possibly focusing on the end result will help ease feeling so overwhelmed, and get those \"stomach butterflies flying in formation!\"<\/p>\n<p>\u00a0<\/p>\n<p>Wishing you all the best with your plans - cheers!!! team MTM <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280192660,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"216.200.128.254","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78590,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"643b93fd301ad3002973b0aed45cb3d6","RawContent":"&lt;p&gt;@[member=\"Stephieee\"]&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am booking Samuel Luna for photography; love his style based on the photos I&#039;ve seen and the reviews. &amp;nbsp;He&#039;s pretty reasonable as well. &amp;nbsp;I liked Del Sol as well, but they were considerably more.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We are having around 30 people at our wedding, and will be around $15k total (guests paying own way). &amp;nbsp;I&#039;m doing some nicer gifts for my FI and bridal party, and a private reception at $55\/person, so it&#039;s feasible you could get closer to $10k if you do a LOT of DIY\/go pretty basic. &amp;nbsp;Just make sure to plan out things you want to do, and don&#039;t get overwhelmed by all the cool stuff on this board :)&lt;\/p&gt;","Attachments":[],"Id":1882729,"PostDate":1421145483,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"281700\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281700-stephieee\/' title='Member profile'><span itemprop=\"name\">Stephieee<\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>I am booking Samuel Luna for photography; love his style based on the photos I've seen and the reviews. \u00a0He's pretty reasonable as well. \u00a0I liked Del Sol as well, but they were considerably more.<\/p>\n<p>\u00a0<\/p>\n<p>We are having around 30 people at our wedding, and will be around $15k total (guests paying own way). \u00a0I'm doing some nicer gifts for my FI and bridal party, and a private reception at $55\/person, so it's feasible you could get closer to $10k if you do a LOT of DIY\/go pretty basic. \u00a0Just make sure to plan out things you want to do, and don't get overwhelmed by all the cool stuff on this board <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>30 guests, Bride & Groom & 2 kids - one FANTASTIC time!<\/p>\n<p>\u00a0<\/p>\n<p><strong>Planning Thread<\/strong> - Includes lots of DIY (picture-heavy)<br><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/77321-marinah84s-planning-thread-31415-crown-paradise-club-cancun\/\"><span style=\"color:rgb(0,0,255);\">http:\/\/www.bestdestinationwedding.com\/topic\/77321-marinah84s-planning-thread-31415-crown-paradise-club-cancun\/<\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p><strong>Underwater Trash The Dress Session Photos<\/strong> - Samuel Luna (Photographer)<\/p>\n<p><a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/media\/set\/?set=a.784031153664.1073741863.54300091&type=1&l=a8a5688cd7'>https:\/\/www.facebook.com\/media\/set\/?set=a.784031153664.1073741863.54300091&type=1&l=a8a5688cd7<\/a><\/p>\n<p>\u00a0<\/p>\n<p><strong>Resort Review<\/strong> - <em>Crown Paradise Club Cancun<\/em><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77321-marinah84s-planning-thread-31415-crown-paradise-club-cancun\/page-28#entry1894872'>http:\/\/www.bestdestinationwedding.com\/topic\/77321-marinah84s-planning-thread-31415-crown-paradise-club-cancun\/page-28#entry1894872<\/a><\/p>\n<p>\u00a0<\/p>\n<p><strong>Photographer Review <\/strong>- <em>Samuel Luna<\/em> - Coming Soon!<\/p>\n<p>\u00a0<\/p>\n<p><strong>Makeup\/Hair Artist Review\u00a0<\/strong>-\u00a0<em>Sara Tamargo<\/em><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4968-sara-tamargo-makeup-artistry\/'>http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4968-sara-tamargo-makeup-artistry\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p><strong>For Sale Items<\/strong> -\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79146-wedding-items-for-sale\/#entry1895327'>http:\/\/www.bestdestinationwedding.com\/topic\/79146-wedding-items-for-sale\/#entry1895327<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"marinarhianne@gmail.com","IpAddress":"67.149.51.114","GroupId":40,"GroupName":"Jr. Member","JoinDate":1387567052,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275696.jpg?_r=1429206783","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"marinah84","Id":275696,"Name":"marinah84","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"205.178.96.176","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78590,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"4fd9484446b50f75e23d34b2d2277f3d","RawContent":"&lt;p&gt;Hello,&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I totally understand how overwhelming planning a destination wedding can be as we just went through the process. We were married in Playa del Carmen (Grand Coral Beach Club) in Janurary and miss it already. Similar to your situation, we really didn&#039;t know which photographer to chose as there are so many options.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Let me make at least one of your decisions very simple. Carlos Lopez from Karisma Fine Art Wedding Photography was &amp;nbsp;our photogpher and was absolutly incredible. At first, we really didn&#039;t want to do that much in terms of photo, but now that we are back from our wedding, we continue to talk about how great of a job Carlos did on our wedding day. Throughout our entire wedding planning, Carlos continued to stay in touch with us to make sure he had a vision of how we wanted our special day planned. It was my understanding that a photographer kind of just showed up and stayed in the background, but Carlos became a much larger part of our wedding as he was so passionate about making sure to capture all of the special moments. On our wedding day, Carlos showed up to our resort HOURS early to make sure he understood the lay of the land, wanted to be on time and even made the sure the bride was not worrying about the cloudy skies!! Carlos worked so hard not only on our wedding day but for the next two days to make sure he finished our final photo package before we even left Mexico - AMAZING!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I know there are a lot of details to plan a destination wedding and you will have to rely on the opinion of others through reviews as its hard to visit Mexico and meet with each and every vendor. I can promise you will not be dissapointed if you use Carlos to capture your wedding. Do yourself a favor and at least visit Carlos&#039; blog for some excellent examples of his work (&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.karismaphoto.com\/blog\/)....we&#039;&gt;http:\/\/www.karismaphoto.com\/blog\/)....we&lt;\/a&gt; are the Paul and Allison wedding. I have also attached a couple of our favorites!! &lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;If you have any additional questions on Carlos, please don&#039;t hesitate to reach out.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;","Attachments":[{"Id":30636,"Name":"KarismaPhotography (85 de 177).jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2015\/post-282137-0-71419500-1424133657.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2015\/post-282137-0-71419500-1424133657_thumb.jpg","Width":1000,"Height":665},{"Id":30637,"Name":"KarismaPhotography (86 de 177).jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2015\/post-282137-0-50927800-1424133678.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2015\/post-282137-0-50927800-1424133678_thumb.jpg","Width":1000,"Height":666},{"Id":30638,"Name":"KarismaPhotography (113 de 177).jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2015\/post-282137-0-32168900-1424133696.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2015\/post-282137-0-32168900-1424133696_thumb.jpg","Width":1000,"Height":664}],"Id":1886504,"PostDate":1424115762,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello,\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I totally understand how overwhelming planning a destination wedding can be as we just went through the process. We were married in Playa del Carmen (Grand Coral Beach Club) in Janurary and miss it already. Similar to your situation, we really didn't know which photographer to chose as there are so many options.<\/p>\n<p>\u00a0<\/p>\n<p>Let me make at least one of your decisions very simple. Carlos Lopez from Karisma Fine Art Wedding Photography was \u00a0our photogpher and was absolutly incredible. At first, we really didn't want to do that much in terms of photo, but now that we are back from our wedding, we continue to talk about how great of a job Carlos did on our wedding day. Throughout our entire wedding planning, Carlos continued to stay in touch with us to make sure he had a vision of how we wanted our special day planned. It was my understanding that a photographer kind of just showed up and stayed in the background, but Carlos became a much larger part of our wedding as he was so passionate about making sure to capture all of the special moments. On our wedding day, Carlos showed up to our resort HOURS early to make sure he understood the lay of the land, wanted to be on time and even made the sure the bride was not worrying about the cloudy skies!! Carlos worked so hard not only on our wedding day but for the next two days to make sure he finished our final photo package before we even left Mexico - AMAZING!!<\/p>\n<p>\u00a0<\/p>\n<p>I know there are a lot of details to plan a destination wedding and you will have to rely on the opinion of others through reviews as its hard to visit Mexico and meet with each and every vendor. I can promise you will not be dissapointed if you use Carlos to capture your wedding. Do yourself a favor and at least visit Carlos' blog for some excellent examples of his work (<a href='http:\/\/www.karismaphoto.com\/blog\/)....we' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.karismaph...om\/blog\/)....we<\/a> are the Paul and Allison wedding. I have also attached a couple of our favorites!! <\/p>\n<p>\u00a0<\/p>\n<p>If you have any additional questions on Carlos, please don't hesitate to reach out.\u00a0<\/p>\n<p>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"saftiggold@gmail.com","IpAddress":"205.178.96.176","GroupId":39,"GroupName":"Newbie","JoinDate":1424113793,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Saftig11","Id":282137,"Name":"Saftig11","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.155.94.124","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78590,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"434dc8dc2a0b037cdcb4ae39ff15a4ff","RawContent":"&lt;p&gt;you&#039;ve definitely come to the right place! I love these forums.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I think contacting at TA that specializes in the resort you want is a great step. Usually they can get cheaper travel quotes for you than if you went through the hotel, or even if you look through expedia. We were pretty much decided on our resort as well, which makes the process a little easier. We had to change resorts last minute, but that&#039;s another story haha.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;m not sure how much the wedding packages are for the royal hotels but I was planning my wedding in one of their sister resorts a couple of years ago and they were reasonable. I&#039;m sure the prices have gone up since then, but it might be doable with 10k. A lot of it always depends on the amount of guests, you will have a much easier time pulling it off with 20 guests than with 40. If you have more guests, it&#039;s always a matter of reallocating costs and prioritizing things. It also depends on how many \"extras\" you want for the wedding or if you want something quite simple.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We&#039;re having about 40-45 people and will probably spend close to 17000 by the end of it. I don&#039;t think it will be a luxurious wedding but we&#039;re definitely splurging on a few things :D&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1886533,"PostDate":1424134992,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>you've definitely come to the right place! I love these forums.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I think contacting at TA that specializes in the resort you want is a great step. Usually they can get cheaper travel quotes for you than if you went through the hotel, or even if you look through expedia. We were pretty much decided on our resort as well, which makes the process a little easier. We had to change resorts last minute, but that's another story haha.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I'm not sure how much the wedding packages are for the royal hotels but I was planning my wedding in one of their sister resorts a couple of years ago and they were reasonable. I'm sure the prices have gone up since then, but it might be doable with 10k. A lot of it always depends on the amount of guests, you will have a much easier time pulling it off with 20 guests than with 40. If you have more guests, it's always a matter of reallocating costs and prioritizing things. It also depends on how many \"extras\" you want for the wedding or if you want something quite simple.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>We're having about 40-45 people and will probably spend close to 17000 by the end of it. I don't think it will be a luxurious wedding but we're definitely splurging on a few things <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/biggrin.png' class='bbc_emoticon' alt=':D' \/>\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<br><p><a data-ipb='nomediaparse' href='http:\/\/www.TickerFactory.com\/'><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;31;484\/st\/20150813\/e\/Wedding+time%21+\/dt\/-2\/k\/b92c\/event.png\" alt=\"event.png\"><\/a><\/p>\n<p style=\"text-align:center;\">\u00a0<\/p>\n<p style=\"text-align:center;\">\u00a0","Email":"sblopezb@gmail.com","IpAddress":"172.219.193.22","GroupId":42,"GroupName":"Sr. Member","JoinDate":1359745104,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265511.jpg?_r=1442890536","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"TinkerSofi","Id":265511,"Name":"TinkerSofi","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.137.211.49","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78590,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1e67ec73759b5fa7b646e4f51788010b","RawContent":"&lt;p&gt;I am planning an October 2015 wedding and have a budget of $10,000 for 20-25 guests at an all-inclusive resort.&amp;nbsp; Our guests are spending about $1500 per person for a week at the resort with airfare.&amp;nbsp; I haven&#039;t started pricing all of the add ons but am nervous that I get sucked into most of them!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;J&lt;\/p&gt;","Attachments":[],"Id":1889134,"PostDate":1426199129,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I am planning an October 2015 wedding and have a budget of $10,000 for 20-25 guests at an all-inclusive resort.\u00a0 Our guests are spending about $1500 per person for a week at the resort with airfare.\u00a0 I haven't started pricing all of the add ons but am nervous that I get sucked into most of them!<\/p>\n<p>\u00a0<\/p>\n<p>J<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"phimoez@yahoo.com","IpAddress":"50.137.211.49","GroupId":39,"GroupName":"Newbie","JoinDate":1425858636,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"MNsunseeker","Id":282367,"Name":"MNsunseeker","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.41.59","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78590,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"db52acce7681e408793bc7b4111497d5","RawContent":"[quote name=\"MNsunseeker\" post=\"1889134\" timestamp=\"1426217129\"]\nI am planning an October 2015 wedding and have a budget of $10,000 for 20-25 guests at an all-inclusive resort.  Our guests are spending about $1500 per person for a week at the resort with airfare.  I haven&#039;t started pricing all of the add ons but am nervous that I get sucked into most of them!\n\nJ[\/quote]Is that for your wedding only? If yes I think 10k for your guest size is more than doable. What resort?\n\n\nSent from my iPad using Tapatalk","Attachments":[],"Id":1889139,"PostDate":1426201066,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>MNsunseeker, on 12 March 2015 - 10:25 PM, said:<\/p><div class='blockquote'><div class='quote'><p>I am planning an October 2015 wedding and have a budget of $10,000 for 20-25 guests at an all-inclusive resort.  Our guests are spending about $1500 per person for a week at the resort with airfare.  I haven't started pricing all of the add ons but am nervous that I get sucked into most of them!<br><br>\nJ<\/p><\/div><\/div>\n<br>\nIs that for your wedding only? If yes I think 10k for your guest size is more than doable. What resort?<br><br><br>\nSent from my iPad using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399410602,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}}],"Id":"78590","Title":"Playa Del Carmen Wedding - 2016 And So Overwhelmed","LastPostDate":1451387647},"Pages":{"TotalItems":19,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
