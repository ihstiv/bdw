{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":true,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":4754,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":256036,"MovedTo":null,"MovedOn":0,"FirstPostId":191217,"Rating":0,"RatingHits":0,"Starter":{"Id":208131,"Name":"LadyCheese","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208131.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"IsOnline":false},"StartDate":1202618392,"LastPoster":{"Id":282641,"Name":"jordansaulnier","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":22,"Preview":{"Id":806962,"PostDate":1250691170,"PostContent":"Oh thanks NSbride2010!! It's jak.05@hotmail.com! Thank you so much! Also, you look so much like s...","Author":{"Signature":"","Email":"jak.05@hotmail.com","IpAddress":"70.65.198.231","GroupId":40,"GroupName":"Jr. Member","JoinDate":1240940711,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-217125.gif?_r=0","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"FormattedName":"xxashleyxx007","Id":217125,"Name":"xxashleyxx007","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":11205,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"707b5d50248704a6c8cc6cc2212d3de6","RawContent":"Oh thanks NSbride2010!! It&#039;s &lt;a data-ipb=&#039;nomediaparse&#039; href=\"mailto:jak.05@hotmail.com\"&gt;jak.05@hotmail.com&lt;\/a&gt;! Thank you so much! Also, you look so much like someone from another wedding forum, and she&#039;s from N.S. too I believe. But then again, your picture is super tiny, so maybe I just think you look like her LOL","Attachments":[],"Id":806962,"PostDate":1250691170,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Oh thanks NSbride2010!! It's <a href='mailto:jak.05@hotmail.com' class='bbc_url' title='External link' rel='nofollow external'>jak.05@hotmail.com<\/a>! Thank you so much! Also, you look so much like someone from another wedding forum, and she's from N.S. too I believe. But then again, your picture is super tiny, so maybe I just think you look like her LOL\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jak.05@hotmail.com","IpAddress":"70.65.198.231","GroupId":40,"GroupName":"Jr. Member","JoinDate":1240940711,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-217125.gif?_r=0","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"FormattedName":"xxashleyxx007","Id":217125,"Name":"xxashleyxx007","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":11205,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fbfbb2a84f0b0554db08982074762c1f","RawContent":"Another quick question, I know that you have to be there 3 days before the wedding. Does that include the day you travel AND the day you are getting married, or neither??","Attachments":[],"Id":807010,"PostDate":1250693746,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Another quick question, I know that you have to be there 3 days before the wedding. Does that include the day you travel AND the day you are getting married, or neither??\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jak.05@hotmail.com","IpAddress":"70.65.198.231","GroupId":40,"GroupName":"Jr. Member","JoinDate":1240940711,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-217125.gif?_r=0","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"FormattedName":"xxashleyxx007","Id":217125,"Name":"xxashleyxx007","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":11205,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"265502198f3ee2e69525e1768698f899","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;ndinn&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Just thought I would let you all know that I have had to cancel our DW. We are disappointed but I think it is for the best. We are going to have a wedding at home instead. I wish you all the best at your weddings! good luck.&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;Sad to hear...if it is not too forward, how come? Whatever the reason, hopefully it is for you and your FI&#039;s best interest and not because of bickering guests. Good luck with your planning and congrats on being engaged :)","Attachments":[],"Id":807117,"PostDate":1250697814,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>ndinn<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Just thought I would let you all know that I have had to cancel our DW. We are disappointed but I think it is for the best. We are going to have a wedding at home instead. I wish you all the best at your weddings! good luck.<\/div> <\/td> <\/tr> <\/table> <\/div>Sad to hear...if it is not too forward, how come? Whatever the reason, hopefully it is for you and your FI's best interest and not because of bickering guests. Good luck with your planning and congrats on being engaged <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nolanss@hotmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1245773460,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-218714.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"SSNM","Id":218714,"Name":"SSNM","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":11205,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f36179690e670d979a0b59c5ac3d0b58","RawContent":"Ndinn - I am so sorry! I hope everything is still ok, and it&#039;s for the best! Besides, it&#039;s not where you get married... it&#039;s about the fact that you are marrying the love of your life, doesn&#039;t matter where as long as he&#039;s there! Good luck love, everything will turn out just wonderful at home.","Attachments":[],"Id":807190,"PostDate":1250700394,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Ndinn - I am so sorry! I hope everything is still ok, and it's for the best! Besides, it's not where you get married... it's about the fact that you are marrying the love of your life, doesn't matter where as long as he's there! Good luck love, everything will turn out just wonderful at home.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jak.05@hotmail.com","IpAddress":"70.65.198.231","GroupId":40,"GroupName":"Jr. Member","JoinDate":1240940711,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-217125.gif?_r=0","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"FormattedName":"xxashleyxx007","Id":217125,"Name":"xxashleyxx007","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":11205,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"68aa86c5735e10d451d54442af331bd3","RawContent":"ndinn.... date\/location twin! i am SO sorry to hear that, but i&#039;m sure whatever wedding you plan will be beautiful and you&#039;ll end up married to your FI no matter which way you go! good luck with everything!\n \n ssnm.. i will ask my WC (when i&#039;m assigned one!) about the kids meal thing as well. if you hear anything, let me know! i will only have 1 child at the reception, but i&#039;m still curious... esp if she can have something to eat other than whatever our &amp;quot;adult&amp;quot; menu is.\n \n i hope you CA girls get your TA stuff figured out! i wish i could be more help, but i don&#039;t think any info i have would be helpful for you! if it gives you any sort of reference, our price is $1450 for 7 days including air\/hotel\/transfers and insurance.","Attachments":[],"Id":807278,"PostDate":1250704074,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                ndinn.... date\/location twin! i am SO sorry to hear that, but i'm sure whatever wedding you plan will be beautiful and you'll end up married to your FI no matter which way you go! good luck with everything!<br \/> <br \/> ssnm.. i will ask my WC (when i'm assigned one!) about the kids meal thing as well. if you hear anything, let me know! i will only have 1 child at the reception, but i'm still curious... esp if she can have something to eat other than whatever our \"adult\" menu is.<br \/> <br \/> i hope you CA girls get your TA stuff figured out! i wish i could be more help, but i don't think any info i have would be helpful for you! if it gives you any sort of reference, our price is $1450 for 7 days including air\/hotel\/transfers and insurance.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i721.photobucket.com\/albums\/ww211\/ebredhawk\/ejttd_0008.jpg\">http:\/\/i721.photobucket.com\/albums\/w...ejttd_0008.jpg<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/blog.eyespy-weddings.com\/\">eyespy photography<\/a><br><br><strong><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f77\/dreams-punta-cana-la-barcaza-review-4-28-10-super-long-58714\">my Dreams Punta Cana\/La Barcaza review<\/a><\/strong><\/div><\/div>","Email":"ebredhawk@yahoo.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1234819618,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-214967.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"ebredhawk","Id":214967,"Name":"ebredhawk","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":11205,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9918d960f2f01fbd2458bc331190993b","RawContent":"hey NSbride2010, would you mind also sending mde the bouquet choices...Diaz.adi@gmail.com...thanks a bunch!","Attachments":[],"Id":807432,"PostDate":1250709094,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                hey NSbride2010, would you mind also sending mde the bouquet choices...Diaz.adi@gmail.com...thanks a bunch!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"diaz.adi@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1248918298,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-219984.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"PrincessAva","Id":219984,"Name":"PrincessAva","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":11205,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6ab6d0c7ae32e0bb473de50f9fc5e8dc","RawContent":"I would like to see that menu, if you can send to me?? I am interested in Dreams as well, as a possible place for my wedding :) Thank You much.","Attachments":[],"Id":807484,"PostDate":1250711120,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I would like to see that menu, if you can send to me?? I am interested in Dreams as well, as a possible place for my wedding <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> Thank You much.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>\"Grow old with me! The best is yet to be.\"url=<\/span><a data-ipb='nomediaparse' href=\"http:\/\/www.TickerFactory.com\/%5D\">http:\/\/www.TickerFactory.com\/]<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;130\/st\/20101010\/e\/Our+Destination+Wedding%21%21\/k\/1293\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...1293\/event.png<\/a><br><span>[\/url]<\/span><\/div><\/div>","Email":"nicben314@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1248961159,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-220002.gif?_r=0","PhotoWidth":100,"PhotoHeight":76,"PhotoType":"custom"},"FormattedName":"Soon2bMrsC","Id":220002,"Name":"Soon2bMrsC","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":11205,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1753cc72f4c503f1fd7664ab21adcc33","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;xxashleyxx007&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Another quick question, I know that you have to be there 3 days before the wedding. Does that include the day you travel AND the day you are getting married, or neither??&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;The day you arrive at the resort doesn&#039;t count. Sundays do not count. Dominican holidays also do not count. So if you arrive on a Saturday and Monday is a dominican holiday, your three days won&#039;t start until Tuesday. I am not sure if the day of the wedding counts (i.e. I am not sure if you could get married on the Thursday or would have to wait until the Friday in the above example). I feel like the former should be possible if you dicker with the WC; the 3 day imposition is not a legal requirement of the country.","Attachments":[],"Id":807507,"PostDate":1250711882,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>xxashleyxx007<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Another quick question, I know that you have to be there 3 days before the wedding. Does that include the day you travel AND the day you are getting married, or neither??<\/div> <\/td> <\/tr> <\/table> <\/div>The day you arrive at the resort doesn't count. Sundays do not count. Dominican holidays also do not count. So if you arrive on a Saturday and Monday is a dominican holiday, your three days won't start until Tuesday. I am not sure if the day of the wedding counts (i.e. I am not sure if you could get married on the Thursday or would have to wait until the Friday in the above example). I feel like the former should be possible if you dicker with the WC; the 3 day imposition is not a legal requirement of the country.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nolanss@hotmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1245773460,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-218714.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"SSNM","Id":218714,"Name":"SSNM","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":11205,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6557889548fec8967c6f53abe534597f","RawContent":"just to add on to what ssnm said (which is right on!)... the 3 day rule is just so the WC has time to meet with you and organize everything for your wedding. also, if you&#039;re having a symbolic ceremony (as opposed to a legal one) the rule doesn&#039;t necessarily apply, although you do need to allow a few days for your pre-wedding meeting with your WC. we are getting there on saturday for a wednesday wedding, although it is not a legal ceremony.\n \n when in doubt, once you get your date set just email a WC, tell them your wedding date and your arrival date and make sure it&#039;s okay.","Attachments":[],"Id":807541,"PostDate":1250713106,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                just to add on to what ssnm said (which is right on!)... the 3 day rule is just so the WC has time to meet with you and organize everything for your wedding. also, if you're having a symbolic ceremony (as opposed to a legal one) the rule doesn't necessarily apply, although you do need to allow a few days for your pre-wedding meeting with your WC. we are getting there on saturday for a wednesday wedding, although it is not a legal ceremony.<br \/> <br \/> when in doubt, once you get your date set just email a WC, tell them your wedding date and your arrival date and make sure it's okay.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i721.photobucket.com\/albums\/ww211\/ebredhawk\/ejttd_0008.jpg\">http:\/\/i721.photobucket.com\/albums\/w...ejttd_0008.jpg<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/blog.eyespy-weddings.com\/\">eyespy photography<\/a><br><br><strong><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f77\/dreams-punta-cana-la-barcaza-review-4-28-10-super-long-58714\">my Dreams Punta Cana\/La Barcaza review<\/a><\/strong><\/div><\/div>","Email":"ebredhawk@yahoo.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1234819618,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-214967.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"ebredhawk","Id":214967,"Name":"ebredhawk","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":11205,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b02662062e7d9808501873f6f7147ba8","RawContent":"Hello, Ladies! Can you add us to the list...we are getting married October 16, 2010!!","Attachments":[],"Id":808948,"PostDate":1250799873,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hello, Ladies! Can you add us to the list...we are getting married October 16, 2010!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sumpgrl@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1242667607,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-217640.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"Autumn1","Id":217640,"Name":"Autumn1","IsOnline":false}}],"Id":"11205","Title":"Dreams Punta Cana Brides","LastPostDate":1430646272},"Pages":{"TotalItems":4754,"TotalPages":476,"CurrentPage":320,"NextPage":330,"PreviousPage":310,"LastPage":4750},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
