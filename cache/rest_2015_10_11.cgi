{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":1,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":331,"MovedTo":null,"MovedOn":0,"FirstPostId":1902563,"Rating":0,"RatingHits":0,"Starter":{"Id":284131,"Name":"MegLeLy","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1439591334,"LastPoster":{"Id":284131,"Name":"MegLeLy","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":22,"Preview":{"Id":1902563,"PostDate":1439591334,"PostContent":"Just came across this and thought it would be useful - for Dreams Resorts , Zoetry, and Breathles...","Author":{"Signature":"","Email":"megewy@yahoo.com","IpAddress":"99.17.41.18","GroupId":39,"GroupName":"Newbie","JoinDate":1437848879,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"MegLeLy","Id":284131,"Name":"MegLeLy","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.17.41.18","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79494,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"e9850c240ba244537f1b6de056d5f171","RawContent":"Just came across this and thought it would be useful - for Dreams Resorts , Zoetry, and Breathless in the DR, there is an app called Unlimited Connectivity by amresorts  that you can download for Apple and android phones that:\n\n- call the U.S. and Canada for free\n\n- call or send messages to family and friends in the resort\n\n- call the resort staff from anywhere in the resort of connected to wifi\n\n- request resort services like housekeeping, room service or spa\n\n- view daily resort schedules\n\n- view menus for resort restaurants \n\n- view details about the resort (room types, services, etc)\n\n-receive resort messages with exclusive deals tailored to your preferences\n\n- view your account information\n\n\nAlso says that you can use this instead of getting an international plan from your provider\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1902563,"PostDate":1439591334,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Just came across this and thought it would be useful - for Dreams Resorts , Zoetry, and Breathless in the DR, there is an app called Unlimited Connectivity by amresorts  that you can download for Apple and android phones that:<br>\n- call the U.S. and Canada for free<br>\n- call or send messages to family and friends in the resort<br>\n- call the resort staff from anywhere in the resort of connected to wifi<br>\n- request resort services like housekeeping, room service or spa<br>\n- view daily resort schedules<br>\n- view menus for resort restaurants <br>\n- view details about the resort (room types, services, etc)<br>\n-receive resort messages with exclusive deals tailored to your preferences<br>\n- view your account information<br><br>\nAlso says that you can use this instead of getting an international plan from your provider<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"megewy@yahoo.com","IpAddress":"99.17.41.18","GroupId":39,"GroupName":"Newbie","JoinDate":1437848879,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"MegLeLy","Id":284131,"Name":"MegLeLy","IsOnline":false}}],"Id":"79494","Title":"Unlimited Connectivity - Dreams, Zoetry, Breathless","LastPostDate":1439591334},"Pages":{"TotalItems":1,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
