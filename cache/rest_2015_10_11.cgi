\",\"size\":\"84\",\"type\":\"jpg\"}}\" huddler_plugin=\"attachment\">\u00a0<\/span> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <span huddler_attributes=\"{\"plugin\":\"attachment\",\"params\":{\"id\":\"14162\",\"name\":\"Pink3.jpg\",\"description\":\"\",\"size\":\"62\",\"type\":\"jpg\"}}\" huddler_plugin=\"attachment\">\u00a0<\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jennneedham@hotmail.com","IpAddress":"66.46.14.132","GroupId":39,"GroupName":"Newbie","JoinDate":1315737787,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-245163.jpg?_r=1395159041","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Jenn Needham","Id":245163,"Name":"Jenn Needham","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":67731,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4f141dabc08ce490a3a67a654119ee79","RawContent":"&lt;p&gt; I like coral and nude palette - simple and elegant.\n &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1782971,"PostDate":1374755502,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I like coral and nude palette - simple and elegant.<br \/> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Sehausle@gmail.com","IpAddress":"69.132.176.52","GroupId":40,"GroupName":"Jr. Member","Joi