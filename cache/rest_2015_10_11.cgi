{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":63,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":true,"Views":7184,"MovedTo":null,"MovedOn":0,"FirstPostId":1875671,"Rating":0,"RatingHits":0,"Starter":{"Id":275598,"Name":"kellymenning","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275598.jpg?_r=1426649427","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"StartDate":1413289009,"LastPoster":{"Id":284050,"Name":"2ndTimeMrs","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":44,"Preview":{"Id":1875671,"PostDate":1413289055,"PostContent":"I finally finished by welcome bags! Yay! Thank you to so many girls who posted theirs and I got i...","Author":{"Signature":"<p>Wedding Date: November 1, 2015<br>\nWedding Location: Azul Fives Hotel in Playa del Carmen<\/p>\n<p>Photographer: Photos in Cancun - Derek Campbell<br>\n<a data-ipb='nomediaparse' href='http:\/\/www.photosincancun.com'>http:\/\/www.photosincancun.com<\/a><\/p>\n<p>Decoration Rentals: Love & Lace Wedding Decor<br>\n<a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/loveandlacedecor'>https:\/\/www.facebook.com\/loveandlacedecor<\/a><\/p>\n<div>Wedding Photo Album: <a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/media\/set\/?set=a.10100809953124424.1073741834.18310150&type=1&l=581de87d2f'>https:\/\/www.facebook.com\/media\/set\/?set=a.10100809953124424.1073741834.18310150&type=1&l=581de87d2f<\/a><\/div>\n","Email":"khmciver@gmail.com","IpAddress":"108.223.176.224","GroupId":47,"GroupName":"Site Supporter","JoinDate":1386793154,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275598.jpg?_r=1426649427","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"kellymenning","Id":275598,"Name":"kellymenning","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.223.176.224","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78217,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":13,"IsLiked":false,"PostKey":"dd77c0a5a73dd5a214fde1535b59a35d","RawContent":"&lt;p&gt;I finally finished by welcome bags! Yay! Thank you to so many girls who posted theirs and I got ideas from. This site is the best! If anyone wants any info or templates, let me know and I&#039;m happy to send it to you.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Girls are getting pink and white tote bags and the guys are getting yellow and white. If a girl is bringing her husband, they&#039;re just getting a pink one. If a guy is bringing his wife, they&#039;re just getting a yellow one. You get the idea.&lt;\/p&gt;\n&lt;div&gt;[sharedmedia=gallery:images:78694]&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;I attached a welcome tag to everyone&#039;s bag which I had made from Etsy.&lt;\/div&gt;\n&lt;div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:78693]&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;Inside the bag, I put a petal fold with inserts inside. They included a Welcome Letter, Things to do in Mexico, Wedding Weekend Itinerary, Groomsmen Itinerary, if applicable, Bridesmaid itinerary, if applicable and a Social Media card with our hashtag.&lt;\/div&gt;\n&lt;div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:78688]&lt;\/div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:78696]&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;Also inside the bag, I did three separate bags with stuff in them.&lt;\/div&gt;\n&lt;div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:78686]&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;I did a Sand, Sun and Fun bag and I put \"For Better or For Worse...\" at the top of it. We did a logo so I put that on there as well. The bag included Bug Spray (the things that look like pens), playing cards, aloe vera, sunscreen, crayons for our coloring book which you&#039;ll see later, and chapstick with SPF.&lt;\/div&gt;\n&lt;div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:78691]&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;I did a So Fresh and So Clean bag and I put \"In Good Times and Bad...\" at the top of it. The bag included a lint roller, tic tacs, tissues, hand sanitizer, shout wipes and gum.&lt;\/div&gt;\n&lt;div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:78692]&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;Last bag was a Wedding Weekend Survival Kit. I put \"In Sickness and In Health..\" at the top of it. It included a recovery kit sack, which had advil, Tylenol, pepto, alka seltzer and blowfish (a hangover cure my fianc\u00e9 swears by). It also had a First Aid kit with bandaids, etc. and it had a Spanish to Go mini book which I found online.&lt;\/div&gt;\n&lt;div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:78695]&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;Also inside the tote bag are a Crossword Puzzle about us, a Map of the resort which I put where all the events are, a key card holder, a koozie and a coloring book.&lt;\/div&gt;\n&lt;div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:78687]&lt;\/div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:78689]&lt;\/div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:78690]&lt;\/div&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Then I&#039;m getting chips in Playa and putting them in there too, even though the hotel is all inclusive.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Hope that helps someone!&lt;\/p&gt;\n&lt;\/div&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;\/div&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;\/div&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;\/div&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;\/div&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;\/div&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n\n&lt;p&gt;Sorry some of those are upside down or sideways. I&#039;m not very good with this site. Haha!&lt;\/p&gt;","Attachments":[],"Id":1875671,"PostDate":1413289055,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I finally finished by welcome bags! Yay! Thank you to so many girls who posted theirs and I got ideas from. This site is the best! If anyone wants any info or templates, let me know and I'm happy to send it to you.<\/p>\n<p>\u00a0<\/p>\n<p>Girls are getting pink and white tote bags and the guys are getting yellow and white. If a girl is bringing her husband, they're just getting a pink one. If a guy is bringing his wife, they're just getting a yellow one. You get the idea.<\/p>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/78694-tote-bags\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17868\/sml_gallery_275598_17868_2257501.jpg' class='galattach galimageview sharedmedia_screenshot' title='Tote Bags'  width='200' height='151'  alt='Tote Bags' id='sml_image_view_78694' \/><\/a>\n<br \/><\/div>\n<div>\u00a0<\/div>\n<div>I attached a welcome tag to everyone's bag which I had made from Etsy.<\/div>\n<div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/78693-tote-bag-tag\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17868\/sml_gallery_275598_17868_1423674.jpg' class='galattach galimageview sharedmedia_screenshot' title='Tote Bag Tag'  width='200' height='151'  alt='Tote Bag Tag' id='sml_image_view_78693' \/><\/a>\n<br \/><\/div>\n<div>\u00a0<\/div>\n<div>Inside the bag, I put a petal fold with inserts inside. They included a Welcome Letter, Things to do in Mexico, Wedding Weekend Itinerary, Groomsmen Itinerary, if applicable, Bridesmaid itinerary, if applicable and a Social Media card with our hashtag.<\/div>\n<div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/78688-inserts\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17868\/sml_gallery_275598_17868_446969.jpg' class='galattach galimageview sharedmedia_screenshot' title='Inserts'  width='200' height='151'  alt='Inserts' id='sml_image_view_78688' \/><\/a>\n<br \/><\/div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/78696-welcome-card\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17868\/sml_gallery_275598_17868_412511.jpg' class='galattach galimageview sharedmedia_screenshot' title='Welcome Card'  width='150' height='200'  alt='Welcome Card' id='sml_image_view_78696' \/><\/a>\n<br \/><\/div>\n<div>\u00a0<\/div>\n<div>Also inside the bag, I did three separate bags with stuff in them.<\/div>\n<div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/78686-bags\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17868\/sml_gallery_275598_17868_2343714.jpg' class='galattach galimageview sharedmedia_screenshot' title='Bags'  width='200' height='151'  alt='Bags' id='sml_image_view_78686' \/><\/a>\n<br \/><\/div>\n<div>\u00a0<\/div>\n<div>I did a Sand, Sun and Fun bag and I put \"For Better or For Worse...\" at the top of it. We did a logo so I put that on there as well. The bag included Bug Spray (the things that look like pens), playing cards, aloe vera, sunscreen, crayons for our coloring book which you'll see later, and chapstick with SPF.<\/div>\n<div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/78691-san-sun-and-fun\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17868\/sml_gallery_275598_17868_159743.jpg' class='galattach galimageview sharedmedia_screenshot' title='San Sun And Fun'  width='150' height='200'  alt='San Sun And Fun' id='sml_image_view_78691' \/><\/a>\n<br \/><\/div>\n<div>\u00a0<\/div>\n<div>I did a So Fresh and So Clean bag and I put \"In Good Times and Bad...\" at the top of it. The bag included a lint roller, tic tacs, tissues, hand sanitizer, shout wipes and gum.<\/div>\n<div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/78692-so-fresh-so-clean\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17868\/sml_gallery_275598_17868_1004447.jpg' class='galattach galimageview sharedmedia_screenshot' title='So Fresh So Clean'  width='150' height='200'  alt='So Fresh So Clean' id='sml_image_view_78692' \/><\/a>\n<br \/><\/div>\n<div>\u00a0<\/div>\n<div>Last bag was a Wedding Weekend Survival Kit. I put \"In Sickness and In Health..\" at the top of it. It included a recovery kit sack, which had advil, Tylenol, pepto, alka seltzer and blowfish (a hangover cure my fianc\u00e9 swears by). It also had a First Aid kit with bandaids, etc. and it had a Spanish to Go mini book which I found online.<\/div>\n<div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/78695-weekend-survival-kit\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17868\/sml_gallery_275598_17868_1050750.jpg' class='galattach galimageview sharedmedia_screenshot' title='Weekend Survival Kit'  width='200' height='151'  alt='Weekend Survival Kit' id='sml_image_view_78695' \/><\/a>\n<br \/><\/div>\n<div>\u00a0<\/div>\n<div>Also inside the tote bag are a Crossword Puzzle about us, a Map of the resort which I put where all the events are, a key card holder, a koozie and a coloring book.<\/div>\n<div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/78687-documents\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17868\/sml_gallery_275598_17868_1652221.jpg' class='galattach galimageview sharedmedia_screenshot' title='Documents'  width='200' height='151'  alt='Documents' id='sml_image_view_78687' \/><\/a>\n<br \/><\/div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/78689-key-card\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17868\/sml_gallery_275598_17868_1509896.jpg' class='galattach galimageview sharedmedia_screenshot' title='Key Card'  width='150' height='200'  alt='Key Card' id='sml_image_view_78689' \/><\/a>\n<br \/><\/div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/78690-map\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17868\/sml_gallery_275598_17868_1287368.jpg' class='galattach galimageview sharedmedia_screenshot' title='Map'  width='200' height='151'  alt='Map' id='sml_image_view_78690' \/><\/a>\n<br \/><\/div>\n<p>\u00a0<\/p>\n<p>Then I'm getting chips in Playa and putting them in there too, even though the hotel is all inclusive.<\/p>\n<p>\u00a0<\/p>\n<p>Hope that helps someone!<\/p>\n<\/div>\n<p>\u00a0<\/p>\n<\/div>\n<p>\u00a0<\/p>\n<\/div>\n<div>\u00a0<\/div>\n<p>\u00a0<\/p>\n<\/div>\n<p>\u00a0<\/p>\n<\/div>\n<p>\u00a0<\/p>\n<\/div>\n<p>\u00a0<\/p>\n<\/div>\n<p>\u00a0<\/p>\n<br \/><p>Sorry some of those are upside down or sideways. I'm not very good with this site. Haha!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Wedding Date: November 1, 2015<br>\nWedding Location: Azul Fives Hotel in Playa del Carmen<\/p>\n<p>Photographer: Photos in Cancun - Derek Campbell<br>\n<a data-ipb='nomediaparse' href='http:\/\/www.photosincancun.com'>http:\/\/www.photosincancun.com<\/a><\/p>\n<p>Decoration Rentals: Love & Lace Wedding Decor<br>\n<a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/loveandlacedecor'>https:\/\/www.facebook.com\/loveandlacedecor<\/a><\/p>\n<div>Wedding Photo Album: <a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/media\/set\/?set=a.10100809953124424.1073741834.18310150&type=1&l=581de87d2f'>https:\/\/www.facebook.com\/media\/set\/?set=a.10100809953124424.1073741834.18310150&type=1&l=581de87d2f<\/a><\/div>\n","Email":"khmciver@gmail.com","IpAddress":"108.223.176.224","GroupId":47,"GroupName":"Site Supporter","JoinDate":1386793154,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275598.jpg?_r=1426649427","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"kellymenning","Id":275598,"Name":"kellymenning","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.101.83.185","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78217,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3781421eb94a8ecf4ed1cac199683074","RawContent":"&lt;p&gt;Wow! Well done! Are the bags from Gemline? I really like them! You&#039;ve really added a lot to each bag! I&#039;m sure your guests will love them!&lt;\/p&gt;","Attachments":[],"Id":1875672,"PostDate":1413290334,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Wow! Well done! Are the bags from Gemline? I really like them! You've really added a lot to each bag! I'm sure your guests will love them!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><em><span style=\"color:rgb(51,153,255);\">I'm lucky enough to\u00a0tell my husband how much I love him and say yes again\u00a0on October 20, 2015 at Grand Coral Beach Club!\u00a0<\/span><\/em>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.209.1.177","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78217,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8e00b6dc392c02904ae40ebfcd3c0713","RawContent":"Great job on the bags! I never thought to include bug spray and a lint brush. \n\n\nWhere did you find the bug spray? \n\n\nThanks for sharing.","Attachments":[],"Id":1875674,"PostDate":1413290726,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Great job on the bags! I never thought to include bug spray and a lint brush. <br><br>\nWhere did you find the bug spray? <br><br>\nThanks for sharing.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"carter.watson2015@gmail.com","IpAddress":"71.47.13.201","GroupId":39,"GroupName":"Newbie","JoinDate":1393524530,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276925.jpg?_r=1393540000","PhotoWidth":150,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"AyeWatSoon","Id":276925,"Name":"AyeWatSoon","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"204.246.246.10","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78217,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5096564349e0ac2c32b02e740a1dc34a","RawContent":"&lt;p&gt;These ended up fantastic!!! &amp;nbsp;Your guests will love them. &amp;nbsp;I LOVE how you used \"for better or for worse..\" etc on each bag - SO creative!&lt;\/p&gt;","Attachments":[],"Id":1875694,"PostDate":1413296746,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>These ended up fantastic!!! \u00a0Your guests will love them. \u00a0I LOVE how you used \"for better or for worse..\" etc on each bag - SO creative!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>30 guests, Bride & Groom & 2 kids - one FANTASTIC time!<\/p>\n<p>\u00a0<\/p>\n<p><strong>Planning Thread<\/strong> - Includes lots of DIY (picture-heavy)<br><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/77321-marinah84s-planning-thread-31415-crown-paradise-club-cancun\/\"><span style=\"color:rgb(0,0,255);\">http:\/\/www.bestdestinationwedding.com\/topic\/77321-marinah84s-planning-thread-31415-crown-paradise-club-cancun\/<\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p><strong>Underwater Trash The Dress Session Photos<\/strong> - Samuel Luna (Photographer)<\/p>\n<p><a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/media\/set\/?set=a.784031153664.1073741863.54300091&type=1&l=a8a5688cd7'>https:\/\/www.facebook.com\/media\/set\/?set=a.784031153664.1073741863.54300091&type=1&l=a8a5688cd7<\/a><\/p>\n<p>\u00a0<\/p>\n<p><strong>Resort Review<\/strong> - <em>Crown Paradise Club Cancun<\/em><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77321-marinah84s-planning-thread-31415-crown-paradise-club-cancun\/page-28#entry1894872'>http:\/\/www.bestdestinationwedding.com\/topic\/77321-marinah84s-planning-thread-31415-crown-paradise-club-cancun\/page-28#entry1894872<\/a><\/p>\n<p>\u00a0<\/p>\n<p><strong>Photographer Review <\/strong>- <em>Samuel Luna<\/em> - Coming Soon!<\/p>\n<p>\u00a0<\/p>\n<p><strong>Makeup\/Hair Artist Review\u00a0<\/strong>-\u00a0<em>Sara Tamargo<\/em><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4968-sara-tamargo-makeup-artistry\/'>http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4968-sara-tamargo-makeup-artistry\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p><strong>For Sale Items<\/strong> -\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79146-wedding-items-for-sale\/#entry1895327'>http:\/\/www.bestdestinationwedding.com\/topic\/79146-wedding-items-for-sale\/#entry1895327<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"marinarhianne@gmail.com","IpAddress":"67.149.51.114","GroupId":40,"GroupName":"Jr. Member","JoinDate":1387570652,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275696.jpg?_r=1429206783","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"marinah84","Id":275696,"Name":"marinah84","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.90.222.212","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78217,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"db37c1709ffa47f690df83578822a158","RawContent":"Great job!!! Your guests will be in awe. \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1875695,"PostDate":1413297128,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Great job!!! Your guests will be in awe. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"76.16.100.44","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78217,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d253312d28c9ade70e9c22829c9a0a8f","RawContent":"&lt;p&gt;Those look great!&lt;\/p&gt;\n&lt;p&gt;Are you planning to include anything in &amp;nbsp;your luggage for customs?&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1875701,"PostDate":1413298611,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Those look great!<\/p>\n<p>Are you planning to include anything in \u00a0your luggage for customs?\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kelseybutson@gmail.com","IpAddress":"173.161.18.162","GroupId":39,"GroupName":"Newbie","JoinDate":1389634334,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kjb123","Id":276061,"Name":"kjb123","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"162.234.72.154","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78217,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"423da844a38d915a453ecd652507eacd","RawContent":"&lt;p&gt;Thanks everyone!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;@[member=\"acw271011\"] Thanks!! I got the bags from Ebay, but I saw them on another website too. If you want me to try to find it, let me know. I&#039;m happy to! I think they were about $3\/bag.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;@[member=\"AyeWatSoon\"] I got the bug spray at this site -&amp;nbsp;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.anypromo.com\/personal-care\/sanitizer\/spray-pen-25-oz-hand-sanitizer-p680363&#039;&gt;http:\/\/www.anypromo.com\/personal-care\/sanitizer\/spray-pen-25-oz-hand-sanitizer-p680363&lt;\/a&gt;. I paid $180 total for 150 of them, which included my logo design on them, shipping, etc.&amp;nbsp; &lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;@[member=\"kjb123\"] I am actually taking everything down there. Nightmare. I know. I have divided everything up and I have two other people taking some since I can&#039;t take it all with me. I checked with my travel agent and my wedding coordinator and they said I shouldn&#039;t have a problem getting it all in, especially since it&#039;s for a wedding. I&#039;m just keeping my fingers crossed.&lt;\/p&gt;","Attachments":[],"Id":1875711,"PostDate":1413303342,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thanks everyone!!<\/p>\n<p>\u00a0<\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"232000\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/232000-acw271011\/' title='Member profile'><span itemprop=\"name\">acw271011<\/span><\/a> Thanks!! I got the bags from Ebay, but I saw them on another website too. If you want me to try to find it, let me know. I'm happy to! I think they were about $3\/bag.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"276925\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/276925-ayewatsoon\/' title='Member profile'><span itemprop=\"name\">AyeWatSoon<\/span><\/a> I got the bug spray at this site -\u00a0<a href='http:\/\/www.anypromo.com\/personal-care\/sanitizer\/spray-pen-25-oz-hand-sanitizer-p680363' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.anypromo....nitizer-p680363<\/a>. I paid $180 total for 150 of them, which included my logo design on them, shipping, etc.\u00a0 <\/p>\n<p>\u00a0<\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"276061\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/276061-kjb123\/' title='Member profile'><span itemprop=\"name\">kjb123<\/span><\/a> I am actually taking everything down there. Nightmare. I know. I have divided everything up and I have two other people taking some since I can't take it all with me. I checked with my travel agent and my wedding coordinator and they said I shouldn't have a problem getting it all in, especially since it's for a wedding. I'm just keeping my fingers crossed.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Wedding Date: November 1, 2015<br>\nWedding Location: Azul Fives Hotel in Playa del Carmen<\/p>\n<p>Photographer: Photos in Cancun - Derek Campbell<br>\n<a data-ipb='nomediaparse' href='http:\/\/www.photosincancun.com'>http:\/\/www.photosincancun.com<\/a><\/p>\n<p>Decoration Rentals: Love & Lace Wedding Decor<br>\n<a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/loveandlacedecor'>https:\/\/www.facebook.com\/loveandlacedecor<\/a><\/p>\n<div>Wedding Photo Album: <a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/media\/set\/?set=a.10100809953124424.1073741834.18310150&type=1&l=581de87d2f'>https:\/\/www.facebook.com\/media\/set\/?set=a.10100809953124424.1073741834.18310150&type=1&l=581de87d2f<\/a><\/div>\n","Email":"khmciver@gmail.com","IpAddress":"108.223.176.224","GroupId":47,"GroupName":"Site Supporter","JoinDate":1386793154,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275598.jpg?_r=1426649427","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"kellymenning","Id":275598,"Name":"kellymenning","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"107.1.218.150","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78217,"EditedBy":"<strong>Edited by KJS3323, 14 October 2014 - 06:07 PM.<\/strong>","EditDate":1413310036,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"68b26eada63e1362d5bb2a00636e3534","RawContent":"&lt;p&gt;These bags are wonderful! My fiance and I are still looking to finalize our gift bag ideas and this site has been a tremendous help!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Where did you get the plastic bags that you are putting the goodies in and where did you get the labels to seal the bags?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thanks in advance!&lt;\/p&gt;","Attachments":[],"Id":1875721,"PostDate":1413310014,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>These bags are wonderful! My fiance and I are still looking to finalize our gift bag ideas and this site has been a tremendous help!<\/p>\n<p>\u00a0<\/p>\n<p>Where did you get the plastic bags that you are putting the goodies in and where did you get the labels to seal the bags?<\/p>\n<p>\u00a0<\/p>\n<p>Thanks in advance!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kjs33233@gmail.com","IpAddress":"107.1.218.150","GroupId":39,"GroupName":"Newbie","JoinDate":1413309679,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"KJS3323","Id":280631,"Name":"KJS3323","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.223.176.224","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78217,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"e44d304b01d16a486af863339f9cf571","RawContent":"&lt;p&gt;@[member=\"KJS3323\"] Thanks! I got the clear plastic bags at Michael&#039;s. They&#039;re by a brand call Celebrate It and they were 6.75\"x9.75\". You can buy them online too. Then for the toppers, I just designed them, printed them and used a paper cutter to cut them. I&#039;m happy to send you the template if you want it.&lt;\/p&gt;\n\n&lt;p&gt;I attached the templates I used for the toppers. You can remove the logo and do whatever you want to them, but at least it gives you an idea of how I did them.&lt;\/p&gt;","Attachments":[],"Id":1875731,"PostDate":1413319896,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"280631\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/280631-kjs3323\/' title='Member profile'><span itemprop=\"name\">KJS3323<\/span><\/a> Thanks! I got the clear plastic bags at Michael's. They're by a brand call Celebrate It and they were 6.75\"x9.75\". You can buy them online too. Then for the toppers, I just designed them, printed them and used a paper cutter to cut them. I'm happy to send you the template if you want it.<\/p>\n<br \/><p>I attached the templates I used for the toppers. You can remove the logo and do whatever you want to them, but at least it gives you an idea of how I did them.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Wedding Date: November 1, 2015<br>\nWedding Location: Azul Fives Hotel in Playa del Carmen<\/p>\n<p>Photographer: Photos in Cancun - Derek Campbell<br>\n<a data-ipb='nomediaparse' href='http:\/\/www.photosincancun.com'>http:\/\/www.photosincancun.com<\/a><\/p>\n<p>Decoration Rentals: Love & Lace Wedding Decor<br>\n<a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/loveandlacedecor'>https:\/\/www.facebook.com\/loveandlacedecor<\/a><\/p>\n<div>Wedding Photo Album: <a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/media\/set\/?set=a.10100809953124424.1073741834.18310150&type=1&l=581de87d2f'>https:\/\/www.facebook.com\/media\/set\/?set=a.10100809953124424.1073741834.18310150&type=1&l=581de87d2f<\/a><\/div>\n","Email":"khmciver@gmail.com","IpAddress":"108.223.176.224","GroupId":47,"GroupName":"Site Supporter","JoinDate":1386793154,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275598.jpg?_r=1426649427","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"kellymenning","Id":275598,"Name":"kellymenning","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"98.229.104.230","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78217,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8116c1e408a164f8de4065fbd43d6f22","RawContent":"I&#039;m impressed! \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1875734,"PostDate":1413320622,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm impressed! <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"malyna@gmail.com","IpAddress":"71.235.105.205","GroupId":40,"GroupName":"Jr. Member","JoinDate":1397425622,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277580.jpg?_r=1397779480","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"malyna","Id":277580,"Name":"malyna","IsOnline":false}}],"Id":"78217","Title":"Oot Bags - Finally Finished Them! Pics Attached","LastPostDate":1442583110},"Pages":{"TotalItems":63,"TotalPages":7,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":60},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
