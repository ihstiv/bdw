> Time: 1455294000 / Fri, 12 Feb 2016 16:20:00 +0000
> URL: /index.php?/REST/Forums/topic?startFromPostId=1909974&SessionId=03e9888cab3510930456c8bb41f284f1
> User lorishultz2016 (284536)
Request Time: 1 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":6,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":341,"MovedTo":null,"MovedOn":0,"FirstPostId":1909974,"Rating":0,"RatingHits":0,"Starter":{"Id":285948,"Name":"FutureMrsRescueRiley","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-285948.jpg?_r=1453673360","PhotoWidth":200,"PhotoHeight":113,"PhotoType":"custom"},"IsOnline":false},"StartDate":1453651373,"LastPoster":{"Id":223381,"Name":"GVphotographer","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223381.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1909974,"PostDate":1453651373,"PostContent":"Hey Everyone, \u00a0 I am new to this forum. We got engaged on the beach in San Felipe during the Baja...","Author":{"Signature":"","Email":"ca_robinson06@yahoo.com","IpAddress":"209.237.75.250","GroupId":39,"GroupName":"Newbie","JoinDate":1453129154,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-285948.jpg?_r=1453673360","PhotoWidth":200,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"FutureMrsRescueRiley","Id":285948,"Name":"FutureMrsRescueRiley","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"73.240.160.148","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79889,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8f8939abffbe793d76da9fe1b2ebf4f4","RawContent":"&lt;p&gt;Hey Everyone,&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am new to this forum. We got engaged on the beach in San Felipe during the Baja 1000 race in November 2015. It was so awesome, no one was on the beach with us and it was sunset...perfect! So now...we are in the midst of planning what feels like a lot of overwhelming decisions! We are both really wanting to do a destination in Mexico, but preferably at an all-inclusive resort so that our families can have a cool vacation and keep the cost down for everyone. There are so many venues to choose from and we won&#039;t be able to visit many, if any, of them. I&#039;m hoping for some insight as to how to choose the right venue, past experiences with resorts, what helped you make your final decision when choosing a destination venue, etc. Help! :) We are interested so far in Cancun, Cabo, and Riveria Maya for January 2017.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We are also kicking around the idea of having a wedding in Oregon, where we are both living, but the venues that we are the most interested in, and that would make a trip worthwhile for all of our out of town company, are about 10-15k for everything, for just one day! We have been doing a lot of research and it seems you can have a whole wedding and a couple weeks of vacation for the same price. All of my family (bride) lives in Oregon while my fiancee&#039;s family lives in Nashville, San Diego, and Phoenix. Our friends are spread out through the country as well as Australia and New Zealand...so everyone will need to be traveling at some point, so we thought a destination would be a good happy medium.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Any advice would be helpful, I&#039;ve been scouring forums and feels like I&#039;m getting more lost in the decision making process. Thank you all!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Cassandra&lt;\/p&gt;","Attachments":[],"Id":1909974,"PostDate":1453651373,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hey Everyone,<\/p>\n<p>\u00a0<\/p>\n<p>I am new to this forum. We got engaged on the beach in San Felipe during the Baja 1000 race in November 2015. It was so awesome, no one was on the beach with us and it was sunset...perfect! So now...we are in the midst of planning what feels like a lot of overwhelming decisions! We are both really wanting to do a destination in Mexico, but preferably at an all-inclusive resort so that our families can have a cool vacation and keep the cost down for everyone. There are so many venues to choose from and we won't be able to visit many, if any, of them. I'm hoping for some insight as to how to choose the right venue, past experiences with resorts, what helped you make your final decision when choosing a destination venue, etc. Help! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> We are interested so far in Cancun, Cabo, and Riveria Maya for January 2017.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>We are also kicking around the idea of having a wedding in Oregon, where we are both living, but the venues that we are the most interested in, and that would make a trip worthwhile for all of our out of town company, are about 10-15k for everything, for just one day! We have been doing a lot of research and it seems you can have a whole wedding and a couple weeks of vacation for the same price. All of my family (bride) lives in Oregon while my fiancee's family lives in Nashville, San Diego, and Phoenix. Our friends are spread out through the country as well as Australia and New Zealand...so everyone will need to be traveling at some point, so we thought a destination would be a good happy medium.<\/p>\n<p>\u00a0<\/p>\n<p>Any advice would be helpful, I've been scouring forums and feels like I'm getting more lost in the decision making process. Thank you all!<\/p>\n<p>\u00a0<\/p>\n<p>Cassandra<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ca_robinson06@yahoo.com","IpAddress":"209.237.75.250","GroupId":39,"GroupName":"Newbie","JoinDate":1453129154,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-285948.jpg?_r=1453673360","PhotoWidth":200,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"FutureMrsRescueRiley","Id":285948,"Name":"FutureMrsRescueRiley","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.41.78","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79889,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cb35530d5fc2ed0d5b6cd1316c5d8b8b","RawContent":"&lt;p&gt;@[member=\"FutureMrsRescueRiley\"] Congrats and welcome to the site! You&#039;ve come to the right place for information and the brides here are always willing to help!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;You&#039;ll find choosing your resort probably the most difficult part of your planning journey. You&#039;re right - there are so many to choose from! The first thing I would say is find yourself a good travel agent. They will become your new bff as you move towards your wedding. A good TA will help you work within your budget, help with what you do and don&#039;t want and also work with you to keep the price to something affordable for your guests. Every resort has something going for it, but an agent will help you decide what is really important to you. The owners of this site are destination wedding specialists, and I&#039;m sure would be able to help you work through what you&#039;re looking for. In fact the owner is also a destination bride. You can contact them through this site: &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/wrighttravelagency.com\/inquiry\/&#039;&gt;http:\/\/wrighttravelagency.com\/inquiry\/&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;The other thing I would recommend is making a budget so that you know what you have to work with. You&#039;ll get lots of recommendations on resorts here, but it will depend on what you want. Not every resort works for every bride.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck and happy planning!&lt;\/p&gt;","Attachments":[],"Id":1909982,"PostDate":1453656888,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"285948\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/285948-futuremrsrescueriley\/' title='Member profile'><span itemprop=\"name\">FutureMrsRescueRiley<\/span><\/a> Congrats and welcome to the site! You've come to the right place for information and the brides here are always willing to help!<\/p>\n<p>\u00a0<\/p>\n<p>You'll find choosing your resort probably the most difficult part of your planning journey. You're right - there are so many to choose from! The first thing I would say is find yourself a good travel agent. They will become your new bff as you move towards your wedding. A good TA will help you work within your budget, help with what you do and don't want and also work with you to keep the price to something affordable for your guests. Every resort has something going for it, but an agent will help you decide what is really important to you. The owners of this site are destination wedding specialists, and I'm sure would be able to help you work through what you're looking for. In fact the owner is also a destination bride. You can contact them through this site: <a href='http:\/\/wrighttravelagency.com\/inquiry\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/wrighttravelagency.com\/inquiry\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>The other thing I would recommend is making a budget so that you know what you have to work with. You'll get lots of recommendations on resorts here, but it will depend on what you want. Not every resort works for every bride.<\/p>\n<p>\u00a0<\/p>\n<p>Good luck and happy planning!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span><\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/ann.chadwick.5\/media_set?set=a.10153262834771016.1073741828.569791015&type=3'><span style=\"color:#ff0099;\"><em>https:\/\/www.facebook.com\/ann.chadwick.5\/media_set?set=a.10153262834771016.1073741828.569791015&type=3<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/'><span style=\"color:#ff0099;\"><em>http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283437399,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"73.240.160.148","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79889,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e915ff59fa4997a95bfcea21d73b0a20","RawContent":"&lt;p&gt;Great suggestion, thank you! Beautiful pictures and ceremony!&lt;\/p&gt;","Attachments":[],"Id":1909984,"PostDate":1453659636,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Great suggestion, thank you! Beautiful pictures and ceremony!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ca_robinson06@yahoo.com","IpAddress":"209.237.75.250","GroupId":39,"GroupName":"Newbie","JoinDate":1453129154,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-285948.jpg?_r=1453673360","PhotoWidth":200,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"FutureMrsRescueRiley","Id":285948,"Name":"FutureMrsRescueRiley","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"142.161.170.48","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79889,"EditedBy":"<strong>Edited by Moments That Matter, 25 January 2016 - 02:12 PM.<\/strong>","EditDate":1453731150,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6d02a2b0db819e41dab0c176dd010cf4","RawContent":"&lt;p&gt;Welcome to our forum community Cassandra, and Congrats on your engagement on the beach and upcoming dw!!! yes, acw271011 is so right about there being lots of great info, advice, suggestions + support from everyone at these boards - so you&#039;re already off to a great start....big exhale! :)&lt;\/p&gt;\n&lt;p&gt;LOTs of brides (like Most of them) feel some degree of being overwhelmed in the beginning of this amazing journey - so you&#039;re in good company :) However with all the resources you find here, it&#039;s bound to make your decision process easier and get you started off on the right foot.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;For some added inspiration, here are some magical wedding moments that matter we&#039;ve captured in our magnificent Mayan Riviera.....to ramp up your creativity even more.....enjoy!!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;....from our &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xlt1\/t31.0-8\/12304126_10153785339774487_6948717609887949276_o.jpg&#039;&gt;Cover Photos Album: &lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-prn2\/t31.0-8\/1781097_10152194000894487_743267921_o.jpg\" alt=\"1781097_10152194000894487_743267921_o.jp\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xlt1\/t31.0-8\/12304126_10153785339774487_6948717609887949276_o.jpg\" alt=\"12304126_10153785339774487_6948717609887\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xtp1\/t31.0-8\/12109790_10153682859529487_4869403078968401747_o.jpg\" alt=\"12109790_10153682859529487_4869403078968\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xpt1\/t31.0-8\/12113407_10153672260929487_7722884119648579082_o.jpg\" alt=\"12113407_10153672260929487_7722884119648\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xap1\/t31.0-8\/1655514_10152324691449487_2975260255853675658_o.jpg\" alt=\"1655514_10152324691449487_29752602558536\"&gt;&lt;\/p&gt;\n&lt;p&gt;Wishing you happy research and all the best with your plans - cheers!!! team MTM :)&lt;\/p&gt;","Attachments":[],"Id":1910016,"PostDate":1453730846,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome to our forum community Cassandra, and Congrats on your engagement on the beach and upcoming dw!!! yes, acw271011 is so right about there being lots of great info, advice, suggestions + support from everyone at these boards - so you're already off to a great start....big exhale! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>LOTs of brides (like Most of them) feel some degree of being overwhelmed in the beginning of this amazing journey - so you're in good company <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> However with all the resources you find here, it's bound to make your decision process easier and get you started off on the right foot.<\/p>\n<p>\u00a0<\/p>\n<p>For some added inspiration, here are some magical wedding moments that matter we've captured in our magnificent Mayan Riviera.....to ramp up your creativity even more.....enjoy!!!<\/p>\n<p>\u00a0<\/p>\n<p>....from our <a href='https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xlt1\/t31.0-8\/12304126_10153785339774487_6948717609887949276_o.jpg' class='bbc_url' title='External link' rel='nofollow external'>Cover Photos Album: <\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-prn2\/t31.0-8\/1781097_10152194000894487_743267921_o.jpg\" alt=\"1781097_10152194000894487_743267921_o.jp\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xlt1\/t31.0-8\/12304126_10153785339774487_6948717609887949276_o.jpg\" alt=\"12304126_10153785339774487_6948717609887\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xtp1\/t31.0-8\/12109790_10153682859529487_4869403078968401747_o.jpg\" alt=\"12109790_10153682859529487_4869403078968\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xpt1\/t31.0-8\/12113407_10153672260929487_7722884119648579082_o.jpg\" alt=\"12113407_10153672260929487_7722884119648\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xap1\/t31.0-8\/1655514_10152324691449487_2975260255853675658_o.jpg\" alt=\"1655514_10152324691449487_29752602558536\"><\/span><\/p>\n<p>Wishing you happy research and all the best with your plans - cheers!!! team MTM <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280189060,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"69.50.165.212","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79889,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9f7671fabdb8e1b004ec395bcc0d5419","RawContent":"&lt;p&gt;@FutureMrsRescueRiley&amp;nbsp;&lt;span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\"&gt;Congratulations on your engagement and welcome to BDW! &amp;nbsp;Working with at TA is the best thing you can do to help understand what each resort includes and how they do weddings. &amp;nbsp;If you need any help please contact us&amp;nbsp;&lt;\/span&gt;&lt;a  class=\"bbc_url\" href=\"http:\/\/www.wrighttravelagency.com\/leads\/inquiry\/\" title=\"External link\"&gt;here&lt;\/a&gt;&lt;span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\"&gt;&amp;nbsp;to help get you started.&amp;nbsp;&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1910299,"PostDate":1454169842,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@FutureMrsRescueRiley\u00a0<span  style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif\">Congratulations on your engagement and welcome to BDW! \u00a0Working with at TA is the best thing you can do to help understand what each resort includes and how they do weddings. \u00a0If you need any help please contact us\u00a0<\/span><a href='http:\/\/www.wrighttravelagency.com\/leads\/inquiry\/' class='bbc_url' title='External link' rel='nofollow external'>here<\/a><span  style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif\">\u00a0to help get you started.\u00a0<\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><b>Preety Jaswal - Canadian Wedding Specialist<\/b><\/p>\n<div style=\"font-family:arial, sans-serif;font-size:12.8px;\"><a data-ipb='nomediaparse' href='https:\/\/www.wrighttravelagency.com\/go\/destination-wedding\/?source=EMLSIG' title=\"External link\"><strong><span style=\"color:rgb(0,128,128);\">Looking for a travel agency that specializes in Destination Weddings-CLICK HERE<\/span><\/strong><\/a><span style=\"font-family:arial, helvetica, sans-serif;font-size:14px;color:rgb(0,128,128);\"><strong>?<\/strong>\u00a0\u00a0We are an award winning travel agency and you can\u00a0<\/span><strong><span style=\"color:rgb(0,128,128);\"><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/' title=\"\">read our reviews\u00a0here.<\/a><\/span><\/strong><\/div>\n","Email":"preety@travelbyplatinum.com","IpAddress":"69.50.165.200","GroupId":49,"GroupName":"Insiders","JoinDate":1448895839,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-285479.jpg?_r=1450836897","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"TAPreety","Id":285479,"Name":"TAPreety","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"189.172.236.211","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79889,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"622aaf395357bc58c8800624a21e53a7","RawContent":"&lt;p&gt;Welcome to this great forum, here you\u00b4ll find the information you are looking for. Congratulations on your wedding!!\n&lt;span&gt;&lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile03.gif\" title=\"Smile03\" alt=\"smile03.gif\"&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span&gt;Gonzalo Verdeja&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1910790,"PostDate":1455213378,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome to this great forum, here you\u00b4ll find the information you are looking for. Congratulations on your wedding!!<br><span><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile03.gif\" title=\"Smile03\" alt=\"smile03.gif\"><\/span><\/span><\/p>\n<p><span>Gonzalo Verdeja<\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"info@artncolors.com","IpAddress":"189.176.187.29","GroupId":42,"GroupName":"Sr. Member","JoinDate":1258565301,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223381.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"GVphotographer","Id":223381,"Name":"GVphotographer","IsOnline":false}}],"Id":"79889","Title":"Newbie And Confused On Destination Venue!","LastPostDate":1455213378},"Pages":{"TotalItems":6,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
