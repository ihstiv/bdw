{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":27,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":10943,"MovedTo":null,"MovedOn":0,"FirstPostId":1342310,"Rating":0,"RatingHits":0,"Starter":{"Id":233439,"Name":"schayer","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-233439.JPG?_r=0","PhotoWidth":200,"PhotoHeight":149,"PhotoType":"custom"},"IsOnline":false},"StartDate":1290034571,"LastPoster":{"Id":286135,"Name":"theshakeel009","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":33,"Preview":{"Id":1342310,"PostDate":1290034571,"PostContent":"Hi,  \u00a0  I've done some research on the site before posting but i didn't find an answer to my que...","Author":{"Signature":"","Email":"stefanichayer@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1287869979,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-233439.JPG?_r=0","PhotoWidth":200,"PhotoHeight":149,"PhotoType":"custom"},"FormattedName":"schayer","Id":233439,"Name":"schayer","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":58148,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7611f9b5dfee685ba931245d14bce60f","RawContent":"&lt;p&gt; Hi,&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I&#039;ve done some research on the site before posting but i didn&#039;t find an answer to my question.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; When should we buy our wedding bands? When should we start &amp;quot;shopping&amp;quot;?&lt;\/p&gt; &lt;p&gt; Is there an ideal time line? Our wedding is in April.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Thanks&lt;\/p&gt; &lt;p&gt; Stephanie&lt;\/p&gt;","Attachments":[],"Id":1342310,"PostDate":1290034571,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hi,<\/p> <p> \u00a0<\/p> <p> I've done some research on the site before posting but i didn't find an answer to my question.<\/p> <p> \u00a0<\/p> <p> When should we buy our wedding bands? When should we start \"shopping\"?<\/p> <p> Is there an ideal time line? Our wedding is in April.<\/p> <p> \u00a0<\/p> <p> Thanks<\/p> <p> Stephanie<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"stefanichayer@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1287869979,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-233439.JPG?_r=0","PhotoWidth":200,"PhotoHeight":149,"PhotoType":"custom"},"FormattedName":"schayer","Id":233439,"Name":"schayer","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":58148,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"70bca3e89918bc5866ba6f5a68542975","RawContent":"&lt;p&gt; I think it just depends on you and your FI. I&#039;m keen to get it sorted sooner rather then later (we&#039;re 11 months from the wedding) and I know someone else who bought them 6 months before the wedding....I think 4 or 3 months before is &amp;quot;standard&amp;quot; time&lt;\/p&gt;","Attachments":[],"Id":1342688,"PostDate":1290081553,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I think it just depends on you and your FI. I'm keen to get it sorted sooner rather then later (we're 11 months from the wedding) and I know someone else who bought them 6 months before the wedding....I think 4 or 3 months before is \"standard\" time<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"karyan99@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1272009371,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-227583.jpg?_r=0","PhotoWidth":101,"PhotoHeight":256,"PhotoType":"custom"},"FormattedName":"karyan","Id":227583,"Name":"karyan","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":58148,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c6da748130713bcaa0f15fc78017bf74","RawContent":"&lt;p&gt; We actually just bought ours last night and we are getting married in June. We had the money so we figured we would just get it out of the way...&lt;\/p&gt;","Attachments":[],"Id":1342723,"PostDate":1290088099,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> We actually just bought ours last night and we are getting married in June. We had the money so we figured we would just get it out of the way...<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"slandro06@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1271903316,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-227545.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"slandro06","Id":227545,"Name":"slandro06","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":58148,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1155f1b5c10aa24b4d539bc931b6e5cd","RawContent":"&lt;p&gt; I don&#039;t think there&#039;s really such a thing as a &#039;set time&#039; ..... my wedding is also in April and my FI and I are waiting to see if there are any holiday or post-holiday sales on the rings we want&lt;\/p&gt;","Attachments":[],"Id":1342730,"PostDate":1290089378,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I don't think there's really such a thing as a 'set time' ..... my wedding is also in April and my FI and I are waiting to see if there are any holiday or post-holiday sales on the rings we want<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lauraandchriswedding@live.ca","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1275340132,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-228710.jpg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Lua","Id":228710,"Name":"Lua","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":58148,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"04ae1558a409730fdd959beb99463b60","RawContent":"&lt;p&gt; We&#039;re getting married June 2011. I just bought my FI&#039;s ring last Saturday because the ring he wanted was on sale for 50% off! We figured, why the heck not?! When he&#039;s finished paying off my E-ring, he&#039;ll move on to my WB. It&#039;s going to have to be custom made to fit. My sister and I went to a bridal expo and they gave us gift cards for two free wedding bands. I told him, so he wouldn&#039;t stress himself out with all we got going on, to just get my WB using the gift card and we&#039;ll use that as my WB for the wedding. We ordered that last week too (he even ordered himself an E-ring to ward off the ladies he says, lol). After we come back, and things settle down money-wise, then he&#039;ll buy me the custom WB.&lt;\/p&gt;","Attachments":[],"Id":1342749,"PostDate":1290091503,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> We're getting married June 2011. I just bought my FI's ring last Saturday because the ring he wanted was on sale for 50% off! We figured, why the heck not?! When he's finished paying off my E-ring, he'll move on to my WB. It's going to have to be custom made to fit. My sister and I went to a bridal expo and they gave us gift cards for two free wedding bands. I told him, so he wouldn't stress himself out with all we got going on, to just get my WB using the gift card and we'll use that as my WB for the wedding. We ordered that last week too (he even ordered himself an E-ring to ward off the ladies he says, lol). After we come back, and things settle down money-wise, then he'll buy me the custom WB.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><em>Heaven endures and the Earth lasts a long time, because they do not live for themselves<\/em><span>. ~~Our story endures: June 25, 2011~~<\/span><br><span>Wedsite: kosha.projectwedding.com<\/span><\/div><\/div>","Email":"shariannharris@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1273975311,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-228250.jpeg?_r=0","PhotoWidth":104,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"AfricanVenus","Id":228250,"Name":"AfricanVenus","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":58148,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c03d71a30638f3d0d73a175a507d70b0","RawContent":"&lt;p&gt; I agree that there really isn&#039;t a set time.&amp;nbsp; My FI and I are getting married in April as well, and we bought ours over the summer because we had found the ones we really liked.&amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Right now with the time of year it is, I agree with Lua - see what kind of sales were are with the holidays.&amp;nbsp; This will probably be the cheapest time of the year to purchase!&amp;nbsp; Good luck!&lt;\/p&gt;","Attachments":[],"Id":1342751,"PostDate":1290091608,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I agree that there really isn't a set time.\u00a0 My FI and I are getting married in April as well, and we bought ours over the summer because we had found the ones we really liked.\u00a0<\/p> <p> \u00a0<\/p> <p> Right now with the time of year it is, I agree with Lua - see what kind of sales were are with the holidays.\u00a0 This will probably be the cheapest time of the year to purchase!\u00a0 Good luck!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><strong>Married the love of my life in April!!<\/strong><\/div><\/div>","Email":"erin82283@comcast.net","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1276041384,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-228983.jpg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Ellabaja1983","Id":228983,"Name":"Ellabaja1983","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":58148,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a116f695457dc59e0ce33b9bfdf80905","RawContent":"&lt;p&gt; I want to buy ours ASAP. With the price of platinum and gold rising so quickly I think it is best to look down a price now. We both want platinum rings and they are only getting more expensive as the days go by. Hopefully, we can settle on something sooner rather than later.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1342770,"PostDate":1290093108,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I want to buy ours ASAP. With the price of platinum and gold rising so quickly I think it is best to look down a price now. We both want platinum rings and they are only getting more expensive as the days go by. Hopefully, we can settle on something sooner rather than later.<\/p> <p> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sherrif@acanac.net","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1281471620,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-231230.jpg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"mochamakes3","Id":231230,"Name":"mochamakes3","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":58148,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c27d87d215727f84b364d32a760027d8","RawContent":"&lt;p&gt; Thanks Ladies! I haven&#039;t thought about shopping early and wait to buy when on sale.&amp;nbsp;&lt;\/p&gt; &lt;p&gt; I didn&#039;t want to buy too early because&amp;nbsp;I though&amp;nbsp;I might want to wear it early (bad toughs - that must be bad luck lol)&lt;\/p&gt;","Attachments":[],"Id":1343169,"PostDate":1290124040,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Thanks Ladies! I haven't thought about shopping early and wait to buy when on sale.\u00a0<\/p> <p> I didn't want to buy too early because\u00a0I though\u00a0I might want to wear it early (bad toughs - that must be bad luck lol)<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"stefanichayer@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1287869979,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-233439.JPG?_r=0","PhotoWidth":200,"PhotoHeight":149,"PhotoType":"custom"},"FormattedName":"schayer","Id":233439,"Name":"schayer","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":58148,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1f985d3501ea7b7af374f98358558e91","RawContent":"&lt;p&gt; My wedding is also in April and I&#039;m pushing my FI to go shopping now since mine will have to be custom ordered (my E-ring took almost 8 weeks because of the small size)&amp;nbsp; We actually lucked out and found a band he liked when we were vacationing in Hawaii last week with titanium and koa wood, so we&#039;ve at least gotten that taken care of.&amp;nbsp; I was concerned about buying over the internet because sizes aren&#039;t always exact and since he was getting titanium, there was no way to resize it.&amp;nbsp; We&#039;ll probably go back to the store where he bought my e-ring since he was able to negotiate a good deal with them.&amp;nbsp; I&#039;d recommend like the other ladies, sooner rather than later, it&#039;s not something you want to buy in a rush because of an upcoming deadline.&lt;\/p&gt;","Attachments":[],"Id":1362015,"PostDate":1292810307,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> My wedding is also in April and I'm pushing my FI to go shopping now since mine will have to be custom ordered (my E-ring took almost 8 weeks because of the small size)\u00a0 We actually lucked out and found a band he liked when we were vacationing in Hawaii last week with titanium and koa wood, so we've at least gotten that taken care of.\u00a0 I was concerned about buying over the internet because sizes aren't always exact and since he was getting titanium, there was no way to resize it.\u00a0 We'll probably go back to the store where he bought my e-ring since he was able to negotiate a good deal with them.\u00a0 I'd recommend like the other ladies, sooner rather than later, it's not something you want to buy in a rush because of an upcoming deadline.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"francinemichelle@mac.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1281328300,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-231164.jpg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"fmichelle","Id":231164,"Name":"fmichelle","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":58148,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f0328c48db4462c902450ca2e3ffdf43","RawContent":"&lt;p&gt; I&#039;m not getting married until Sept. 2011, but I&#039;m already looking around.&amp;nbsp; Like one of the other girls said, with the price of gold continuesly going up, if we find a good price, we&#039;ll get it earlier.&lt;\/p&gt;","Attachments":[],"Id":1362232,"PostDate":1292858510,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I'm not getting married until Sept. 2011, but I'm already looking around.\u00a0 Like one of the other girls said, with the price of gold continuesly going up, if we find a good price, we'll get it earlier.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"magdal89@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1264390220,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-225008.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"bmadzia1","Id":225008,"Name":"bmadzia1","IsOnline":false}}],"Id":"58148","Title":"When should we buy the wedding bands?","LastPostDate":1454585916},"Pages":{"TotalItems":27,"TotalPages":3,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":20},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
