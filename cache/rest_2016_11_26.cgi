<\/table> <\/div><br \/> Have you looked at traveler pics on Trip Advisor?? There are some pretty bad ones of the bathrooms at the Divi. Really old shower\/tubs and curtains with mold on them.... but it does get good reviews.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f77\/tvts-las-caletas-wedding-review-pics-31890\/\">My Las Caletas Wedding Review<\/a><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f76\/more-pro-pics-our-las-caletas-wedding-32657\/\">Pro Wedding Pics<\/a><span> <\/span><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f77\/tvts-eyespy-photography-review-pics-31889\/\">EyeSpy Photography Review<\/a><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f76\/teaser-ttd-pics-31998\/\">TTD Pics<\/a><\/div><\/div>","Email":"tjvanthiel@gmail.com","IpAddress":"173.28.94.136","GroupId":46,"GroupName":"VIP Member","JoinDate":1174672560,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-207287.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"tvt","Id":207287,"Name":"tvt","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":2811,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bd07fe52fc4a3b10c22eb5e72daccbc7","RawContent":"&lt;a data-ipb=&#039;nomediaparse&#039; href=\"[url=\"http:\/\/allyoucanupload.webshots.com\/v\/2001630570706519058%22&gt;\"]http:\/\/allyoucanupload.webshots.com\/v\/2001630570706519058\"&gt;[\/url][img]http:\/\/aycu14.webshots.com\/image\/14013\/2001630