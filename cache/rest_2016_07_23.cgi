px 0.0px 0.0px; font: 12.0px Helvetica\"&gt; &lt;img alt=\"DSC03774.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/873610\/width\/600\/height\/450\" \/&gt;&lt;\/p&gt; &lt;p style=\"margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Helvetica\"&gt; &amp;nbsp;&lt;\/p&gt; &lt;p style=\"margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Helvetica\"&gt; &lt;img alt=\"DSC03785.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/873612\/width\/600\/height\/450\" \/&gt;&lt;\/p&gt; &lt;p style=\"margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Helvetica\"&gt; &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1634285,"PostDate":1340416623,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I posted in the other boarding pass forum but then realized it wasnt the DIY one. \u00a0<\/p> <p> So here it goes again :-)\u00a0<\/p> <p> \u00a0<\/p> <p id=\"yui_3_4_1_1_1340415566487_725\"  style=\"margin-left: 0px\"> With all the help and inspiration i got from everyone on here i figured it was only right that i share what i came up with.<\/p> <p id=\"yui_3_4_1_1_1340415566487_723\"  style=\"margin-left: 0px\"> For boarding pass and ceremony fans i used aylee bit template\u00a0<\/p> <p id=\"yui_3_4_1_1_1340415566487_721\"  style=\"margin-left: 0px\"> All clip art came from dafont.com<\/p> <p id=\"yui_3_4_1_1_1340415566487_719\"  style=\"margin-left: 0px\"> \u00a0<\/p> <p id=\"yui_3_4_1_1_1340415566487_727\"  style=\"margin-left: 0px\"> MATERIALS<\/p> <p id=\"yui_3_4_1_1_1340415566487_717\"  style=\"margin-left: 0px\"> Envelope liners - wedding themed wrapping paper (walmart)<\/p> <p id=\"yui_3_4_1_1_1340415566487_715\"  style=\"margin-left: 0px\"> Wrap around labels - ivory cardstock, stamp \u00a0(michaels)\u00a0<\/p> <p id=\"yui_3_4_1_1_1340415566487_713\"  style=\"margin-left: 0px\"> \u00a0<\/p> <p id=\"yui_3_4_1_1_1340415566487_729\"  style=\"margin-left: 0px\"> Boarding Passes - Metallic Cream Linen Cardstock (paperandmore)\u00a0<\/p> <p id=\"yui_3_4_1_1_1340415566487_711\"  style=\"margin-left: 0px\"> Ticket Jackets and Ceremony Programs \u00a0- Metallic Lagoon Cardstock (paperandmore)<\/p> <p id=\"yui_3_4_1_1_1340415566487_709\"  style=\"margin-left: 0px\"> Envelopes - Metallic Bronze #10 and Metallic Lagoon 4 bar (envelopemall)<\/p> <p id=\"yui_3_4_1_1_1340415566487_707\"  style=\"margin-left: 0px\"> \u00a0<\/p> <p id=\"yui_3_4_1_1_1340415566487_705\"  style=\"margin-left: 0px\"> <spanid=\"yui_3_4_1_1_1340415566487_731\" >PIcked up at Michaels<\/span><\/p> <p id=\"yui_3_4_1_1_1340415566487_733\"  style=\"margin-left: 0px\"> Rotary Trimmer<\/p> <p id=\"yui_3_4_1_1_1340415566487_735\"  style=\"margin-left: 0px\"> 1\/8 Hole punch<\/p> <p id=\"yui_3_4_1_1_1340415566487_737\"  style=\"margin-left: 0px\"> Sand Dollar\/Starfish Punch<\/p> <p id=\"yui_3_4_1_1_1340415566487_739\"  style=\"margin-left: 0px\"> Rounded Corner Punch<\/p> <p id=\"yui_3_4_1_1_1340415566487_741\"  style=\"margin-left: 0px\"> Scissors<\/p> <p id=\"yui_3_4_1_1_1340415566487_743\"  style=\"margin-left: 0px\"> Zots glue dots<\/p> <p id=\"yui_3_4_1_1_1340415566487_745\"  style=\"margin-left: 0px\"> Bone folder<\/p> <p id=\"yui_3_4_1_1_1340415566487_747\"  style=\"margin-left: 0px\"> aqua ribbon<\/p> <p id=\"yui_3_4_1_1_1340415566487_749\"  style=\"margin-left: 0px\"> Bronze brads<\/p> <p  style=\"margin-left: 0px\"> \u00a0<\/p> <p  style=\"margin-left: 0px\"> BOARDING PASS INVITES\/JACKETS\/RETURNTICKETS\/WRAP AROUND ADDRESS LABELS<\/p> <p  style=\"margin-left: 0px\"> \u00a0<\/p> <p  style=\"margin-left: 0px\"> \u00a0<\/p> <p  style=\"margin: 0.0px 0.0px 0.0px 0.0px\"> <span rel='lightbox'><img class='bbc_img' alt=\"DSC00087.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/873596\/width\/525\/height\/700\" \/><\/span><\/p> <p  style=\"margin: 0.0px 0.0px 0.0px 0.0px\"> \u00a0<\/p> <p  style=\"margin: 0.0px 0.0px 0.0px 0.0px\"> <span rel='lightbox'><img class='bbc_img' alt=\"DSC00089.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/873598\/width\/600\/height\/450\" \/><\/span><\/p> <p  style=\"margin: 0.0px 0.0px 0.0px 0.0px\"> \u00a0<\/p> <p  style=\"margin: 0.0px 0.0px 0.0px 0.0px\"> <span rel='lightbox'><img class='bbc_img' alt=\"DSC00088.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/873600\/width\/600\/height\/450\" \/><\/span><\/p> <p  style=\"margin: 0.0px 0.0px 0.0px 0.0px\"> \u00a0<\/p> <p  style=\"margin: 0.0px 0.0px 0.0px 0.0px\"> <span rel='lightbox'><img class='bbc_img' alt=\"DSC00078.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/873602\/width\/600\/height\/450\" \/><\/span><\/p> <p  style=\"margin: 0.0px 0.0px 0.0px 0.0px\"> \u00a0<\/p> <p  style=\"margin: 0.0px 0.0px 0.0px 0.0px\"> <span rel='lightbox'><img class='bbc_img' alt=\"DSC00090.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/873604\/width\/600\/height\/450\" \/><\/span><\/p> <p  style=\"margin: 0.0px 0.0px 0.0px 0.0px\"> \u00a0<\/p> <p  style=\"margin: 0.0px 0.0px 0.0px 0.0px\"> \u00a0<\/p> <p  style=\"margin: 0.0px 0.0px 0.0px 0.0px\"> CEREMONY PROGRAM FANS<\/p> <p  style=\"margin: 0.0px 0.0px 0.0px 0.0px\"> <span rel='lightbox'><img class='bbc_img' alt=\"IMG_0683.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/873606\/width\/600\/height\/450\" \/><\/span><\/p> <p  style=\"margin: 0.0px 0.0px 0.0px 0.0px\"> \u00a0<\/p> <p  style=\"margin: 0.0px 0.0px 0.0px 0.0px\"> <span rel='lightbox'><img class='bbc_img' alt=\"IMG_0450.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/873608\/width\/525\/height\/700\" \/><\/span><\/p> <p  style=\"margin: 0.0px 0.0px 0.0px 0.0px\"> \u00a0<\/p> <p  style=\"margin: 0.0px 0.0px 0.0px 0.0px\"> \u00a0<\/p> <p  style=\"margin: 0.0px 0.0px 0.0px 0.0px\"> ENVELOPE LINERS WEDDING BROCHURE\u00a0AND WRAP AROUND LABELS<\/p> <p  style=\"margin: 0.0px 0.0px 0.0px 0.0px\"> \u00a0<\/p> <p  style=\"margin: 0.0px 0.0px 0.0px 0.0px\"> <span rel='lightbox'><img class='bbc_img' alt=\"DSC03774.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/873610\/width\/600\/height\/450\" \/><\/span><\/p> <p  style=\"margin: 0.0px 0.0px 0.0px 0.0px\"> \u00a0<\/p> <p  style=\"margin: 0.0px 0.0px 0.0px 0.0px\"> <span rel='lightbox'><img class='bbc_img' alt=\"DSC03785.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/873612\/width\/600\/height\/450\" \/><\/span><\/p> <p  style=\"margin: 0.0px 0.0px 0.0px 0.0px\"> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"chanteandrandall@gmail.com","IpAddress":"","GroupId":47,"GroupName":"Site Supporter","JoinDate":1300896434,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-238077.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"jazzysis","Id":238077,"Name":"jazzysis","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":68172,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3affb99f5c07d7385c5e7d815ce09c1f","RawContent":"&lt;p&gt; Very Cute!!!!!!!&amp;nbsp; Very well done and detail oriented!&amp;nbsp; Love these!&lt;\/p&gt;","Attachments":[],"Id":1634701,"PostDate":1340637552,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Ve