ly: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Wafflesmom, on 22 March 2015 - 10:32 PM, said:<\/p><div class='blockquote'><div class='quote'><p>You are such a gorgeous bride, absolutely stunning! Thanks for the sneak peek and mini review of Samuel, I'm so glad we went with him. I saw that facebook pic yesterday and loved it, I didn't know that was you! Such a gorgeous shot<\/p><\/div><\/div>\nWe've got Samuel too. I love his work! Can't wait to see the pro shots.  Beautiful bride as she was and his work - should be awesome!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1426134867","PhotoWidth":668,"PhotoHeight":600,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"76.68.33.151","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77321,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"b9d209fb99826b85be2b9ae771f28eb7","RawContent":"&lt;p&gt;You looked amazing on your day! &amp;nbsp;The dress fit you perfectly and your tan looked awesome too! &amp;nbsp;Can&#039;t wait to read your reviews :)&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1890449,"PostDate":1427103700,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  