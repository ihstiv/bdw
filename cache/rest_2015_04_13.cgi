ngHits":0,"Starter":{"Id":279175,"Name":"Lilian84","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279175.jpg?_r=1406605860","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"IsOnline":false},"StartDate":1406438546,"LastPoster":{"Id":241884,"Name":"AllieH","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-241884.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":35,"Preview":{"Id":1862519,"PostDate":1406438546,"PostContent":"Hello,\u00a0 \u00a0 I am a Canadian marrying my American Fiance, therefore I need to apply for a fiance vis...","Author":{"Signature":"<p><em><span style=\"font-family:arial, helvetica, sans-serif;\">I'm lucky I'm in love with my best friend<\/span><\/em>","Email":"lily_1202@hotmail.com","IpAddress":"24.157.233.83","GroupId":40,"GroupName":"Jr. Member","JoinDate":1406390649,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279175.jpg?_r=1406605860","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"Lilian84","Id":279175,"Name":"Lilian84","IsOnline":false}},"Posts":[],"Id":"77629","Title":"Florida Honeymoon","LastPostDate":1408400779},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":14,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":2488,"MovedTo":null,"MovedOn":0,"FirstPostId":1565789,"Rating":0,"RatingHits":0,"Starter":{"Id":249605,"Name":"erinuc","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-249605.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":113,"PhotoType":"custom"},"IsOnline":false},"StartDate":1326120353,"LastPoster":{"Id":278811,"Name":"fashionleader","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278811.jpg?oh=81c60cada1560d42c6d5b3b1a8adad57&oe=547f3e71&__gda__=1416648915_31d8b187e16d72c32b135201014bed12","PhotoWidth":0,"PhotoHeight":0,"PhotoType":"facebook"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":35,"Preview":{"Id":1565789,"PostDate":1326120353,"PostContent":"Hi all!  \u00a0  My fiance and I are getting married in Fort Myers Beach at the beginning of June. Si...","Author":{"Signature":"","Email":"erinuc@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1326120176,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-249605.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"erinuc","Id":249605,"Name":"erinuc","IsOnline":false}},"Posts":[],"Id":"65192","Title":"Afternoon beach wedding in June: too hot?","LastPostDate":1407141163},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":17,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":2185,"MovedTo":null,"MovedOn":0,"FirstPostId":29812,"Rating":0,"RatingHits":0,"Starter":{"Id":207145,"Name":"tob1kanobe","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207145.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"IsOnline":false},"StartDate":1172370172,"LastPoster":{"Id":279175,"Name":"Lilian84","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279175.jpg?_r=1406605860","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":35,"Preview":{"Id":29812,"PostDate":1172370172,"PostContent":"I live in Southwest Florida and grew up in Naple