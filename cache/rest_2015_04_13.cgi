idth":169,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.172.122.57","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77321,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":3,"IsLiked":false,"PostKey":"302f8db884f07f33bfd112db3a9ec527","RawContent":"&lt;p&gt;Love the backdrop. That water is just so nice and blue. Looks awesome girl. Now put up more pictures...hahaha&lt;\/p&gt;","Attachments":[],"Id":1890495,"PostDate":1427124768,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Love the backdrop. That water is just so nice and blue. Looks awesome girl. Now put up more pictures...hahaha<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p style=\"text-align:center;\"><strong>Kristy and Nathan<\/strong><\/p>\n<p style=\"text-align:center;\"><strong>Melia Caribe Tropical <\/strong><\/p>\n<p style=\"text-align:center;\"><strong>April 17, 2015<\/strong>","Email":"colek_64@hotmail.com","IpAddress":"199.180.174.8","GroupId":3,"GroupName":"Member","JoinDate":1395332214,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277264.jpg?_r=1421648383","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"kcole123","Id":277264,"Name":"kcole123","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.155.94.124","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77321,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"706b108f6038e9b6c3768462dc29994f","RawContent":"&lt;p&gt;beautiful pictures!! :) you looked amazing :)&lt;\/p&gt;","Attachments":[],"Id":1890543,"PostDate":1427147008,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>beautiful pictures!! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> you looked amazing <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<br><p><a data-ipb='nomediaparse' href='http:\/\/www.TickerFactory.com\/'><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;31;484\/st\/20150813\/e\/Wedding+time%21+\/dt\/-2\/k\/b92c\/event.png\" alt=\"event.png\"><\/a><\/p>\n<p style=\"text-align:center;\">\u00a0<\/p>\n<p style=\"text-align:center;\">\u00a0","Email":"sblopezb@gmail.com","IpAddress":"172.219.193.22","GroupId":42,"GroupName":"Sr. Member","JoinDate":1359748704,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265511.jpg?_r=1427386564","PhotoWidth":200,"PhotoHeight":153,"PhotoType":"custom"},"FormattedName":"TinkerSofi","Id":265511,"Name":"TinkerSofi","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"64.231.97.33","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77321,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"351b44c0abc151adaf8e1e64df8e43ce","RawContent":"&lt;p&gt;We want more! We want more! lol sorry... couldn&#039;t resist....&lt;\/p&gt;","Attachments":[],"Id":1890548,"PostDate":1427148272,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>We want more! We want more! lol sorry... couldn't resist....<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1426134867","PhotoWidth":668,"PhotoHeight":600,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"216.200.128.254","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77321,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"f40461717ffaadfeb56116ab6a6cdf7a","RawContent":"[quote name=\"acw271011\" post=\"1890475\" timestamp=\"1427130273\"]\nI have to ask - did you find the satin dress hot? I&#039;ve wanted to stay away from satin only because I was worried that it was too heavy and too warm.[\/quote]\nIt wasn&#039;t actually the satin that I found hot, it was all the layers under it!  My dress weighed almost 10lbs by itself, and the tulle underlayers stuck to my legs during the dancing.  It was actually fine in terms of weight (made sure they corseted it VERY tight around my ribs so it wouldn&#039;t fall lol) until the guests started jumping in the pool and getting the deck wet!  They tried to get me to jump in, but I didn&#039;t want to drown!  10lbs dry = at least 30lbs wet!  The water seeped up the dress and made it very heavy. \nI didn&#039;t sweat during the ceremony or pictures, or really the reception because it was cool by the water.  Hope that helps, Ann!\n[quote name=\"kcole123\" post=\"1890495\" timestamp=\"1427139168\"]\nLove the backdrop. That water is just so nice and blue. Looks awesome girl. Now put up more pictures...hahaha[\/quote]\nI&#039;m still sorting - slowly but surely :)  I&#039;m hoping to get Sam&#039;s photos back soon, because I know those will blow mine out of the water LOL\n\n[b][size=6]It&#039;s Official![\/size][\/b]\n\n[size=6][size=4]We went to the courthouse yesterday and are now officially Mr &amp;amp; Mrs!  I&#039;m glad we did it symbolically in Mexico, this elongated the process a bit so we could enjoy it a little longer :)[\/size][\/size]\n\nThey were sweet and the court witnesses took some pictures with my camera during the less than 10 minute ceremony haha.\n[sharedmedia=gallery:images:80584]\n\nMy new ring set and my \"Something Blue\" ;)\n[sharedmedia=gallery:images:80585]\n\nThe nail is actually called something blue, haha, and it&#039;s gorgeous in person.  I&#039;ll probably do the rest over the acrylics after I finish unpacking\/cleaning tonight!\n\nIf you&#039;re curious about Jamberry, let me know!  I can mail out a free sample for you to try :)\n\n[url=\"http:\/\/marinarhianne.jamberrynails.net\/product\/something-blue--matte-#.VRF7KPx4rYh\"]http:\/\/marinarhianne.jamberrynails.net\/product\/something-blue--matte-#.VRF7KPx4rYh[\/url]","Attachments":[],"Id":1890596,"PostDate":1427194862,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>acw271011, on 23 March 2015 - 01:04 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>I have to ask - did you find the satin dress hot? I've wanted to stay away from satin only because I was worried that it was too heavy and too warm.<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>It wasn't actually the satin that I found hot, it was all the layers under it! \u00a0My dress weighed almost 10lbs by itself, and the tulle underlayers stuck to my legs during the dancing. \u00a0It was actually fine in terms of weight (made sure they corseted it VERY tight around my ribs so it wouldn't fall lol) until the guests started jumping in the pool and getting the deck wet! \u00a0They tried to get me to jump in, but I didn't want to drown! \u00a010lbs dry = at least 30lbs wet! \u00a0The water seeped up the dress and made it very heavy.\u00a0<\/p>\n<p>\nI didn't sweat during the ceremony or pictures, or really the reception because it was cool by the water. \u00a0Hope that helps, Ann!<\/p><br \/><p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>kcole123, on 23 March 2015 - 03:32 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Love the backdrop. That water is just so nice and blue. Looks awesome girl. Now put up more pictures...hahaha<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>I'm still sorting - slowly but surely <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> \u00a0I'm hoping to get Sam's photos back soon, because I know those will blow mine out of the water LOL<\/p><br \/><p><strong><span  style=\"font-size:24px\">It's Official!<\/span><\/strong><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-size:24px\"><span  style=\"font-size:14px\">We went to the courthouse yesterday and are now officially Mr & Mrs! \u00a0I'm glad we did it symbolically in Mexico, this elongated the process a bit so we could enjoy it a little longer <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p>They were sweet and the court witnesses took some pictures with my camera during the less than 10 minute ceremony haha.<\/p>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/index.phpgallery\/image\/80584-courthouse\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17988\/sml_gallery_275696_17988_70526.jpg' class='galattach galimageview sharedmedia_screenshot' title='courthouse'  width='200' height='200'  alt='courthouse' id='sml_image_view_80584' \/><\/a>\n<br \/><\/div>\n<div>\u00a0<\/div>\n<div>My new ring set and my \"Something Blue\" <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/><\/div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/index.phpgallery\/image\/80585-something-blue-jamberry-nail\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17988\/sml_gallery_275696_17988_4990.jpg' class='galattach galimageview sharedmedia_screenshot' title='something blue jamberry nail'  width='150' height='200'  alt='something blue jamberry nail' id='sml_image_view_80585' \/><\/a>\n<br \/><\/div>\n<div>\u00a0<\/div>\n<div>The nail is actually called something blue, haha, and it's gorgeous in person. \u00a0I'll probably do the rest over the acrylics after I finish unpacking\/cleaning tonight!<\/div>\n<div>\u00a0<\/div>\n<div>If you're curious about Jamberry, let me know! \u00a0I can mail out a free sample for you to try <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/div>\n<div>\u00a0<\/div>\n<div><a href='http:\/\/marinarhianne.jamberrynails.net\/product\/something-blue--matte-#.VRF7KPx4rYh' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/marinarhianne...e-#.VRF7KPx4rYh<\/a><\/div>\n<p>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"32 guests, Bride & Groom & 2 kids booked!Planning Thread - lots of pictures, DIY\/templates and ongoing updates!<br><br><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/77321-marinah84s-planning-thread-31415-crown-paradise-club-cancun\/\"><span style=\"color:rgb(0,0,255);\">http:\/\/www.bestdestinationwedding.com\/topic\/77321-marinah84s-planning-thread-31415-crown-paradise-club-cancun\/<\/span><\/a>","Email":"marinarhianne@gmail.com","IpAddress":"67.149.51.114","GroupId":40,"GroupName":"Jr. Member","JoinDate":1387570652,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275696.jpeg?_r=1426773379","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"marinah84","Id":275696,"Name":"marinah84","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.235.100.35","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77321,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"f76de775ba8aa4de8e8b3c6f4b163e43","RawContent":"Oh I love the something blue!!! And I love it as the one nail!! Very cool! I so can&#039;t wait to see Sam&#039;s photos!!!! And congrats on it really being official!!! Hey Mrs!","Attachments":[],"Id":1890601,"PostDate":1427196156,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Oh I love the something blue!!! And I love it as the one nail!! Very cool! I so can't wait to see Sam's photos!!!! And congrats on it really being official!!! Hey Mrs!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1426134867","PhotoWidth":668,"PhotoHeight":600,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.155.94.124","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77321,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"b1b8c7a1e5c7f6e57eefe8b9bb9abc08","RawContent":"&lt;p&gt;I saw your picture of the legal ceremony on facebook. I love the idea of one blue nail :). Did you get your acrylics done before you left or at the resort?&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;m glad to hear that it was cool by the water. I&#039;m hoping the same thing will happen for our wedding :). My dress is also satin but it only has one layer :)&lt;\/p&gt;","Attachments":[],"Id":1890606,"PostDate":1427198868,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I saw your picture of the legal ceremony on facebook. I love the idea of one blue nail <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>. Did you get your acrylics done before you left or at the resort?\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I'm glad to hear that it was cool by the water. I'm hoping the same thing will happen for our wedding <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>. My dress is also satin but it only has one layer <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<br><p><a data-ipb='nomediaparse' href='http:\/\/www.TickerFactory.com\/'><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;31;484\/st\/20150813\/e\/Wedding+time%21+\/dt\/-2\/k\/b92c\/event.png\" alt=\"event.png\"><\/a><\/p>\n<p style=\"text-align:center;\">\u00a0<\/p>\n<p style=\"text-align:center;\">\u00a0","Email":"sblopezb@gmail.com","IpAddress":"172.219.193.22","GroupId":42,"GroupName":"Sr. Member","JoinDate":1359748704,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265511.jpg?_r=1427386564","PhotoWidth":200,"PhotoHeight":153,"PhotoType":"custom"},"FormattedName":"TinkerSofi","Id":265511,"Name":"TinkerSofi","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"216.200.128.254","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77321,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3939dced92fe7a56d2ba499b155488c6","RawContent":"[quote name=\"TinkerSofi\" post=\"1890606\" timestamp=\"1427213268\"]\nI saw your picture of the legal ceremony on facebook. I love the idea of one blue nail :). Did you get your acrylics done before you left or at the resort? \n\nI&#039;m glad to hear that it was cool by the water. I&#039;m hoping the same thing will happen for our wedding :). My dress is also satin but it only has one layer :)[\/quote]\nI did them about a week before - it&#039;s one of the things I actually wish I had waited on!  I had to get them filled and one cracked nail fixed the morning of the wedding, and it was more expensive than getting them done (fills here are like $14!  It cost me $43 before tip!).  The fills also cracked - I don&#039;t know if that was due to me being hard on them, or the quality of the work done at the spa.  I would definitely recommend waiting, if you aren&#039;t worried about functioning with long nails.  I had them done pretty short, so I would have been fine doing day of!","Attachments":[],"Id":1890608,"PostDate":1427200478,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>TinkerSofi, on 24 March 2015 - 12:07 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>I saw your picture of the legal ceremony on facebook. I love the idea of one blue nail <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>. Did you get your acrylics done before you left or at the resort?\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I'm glad to hear that it was cool by the water. I'm hoping the same thing will happen for our wedding <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>. My dress is also satin but it only has one layer <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>I did them about a week before - it's one of the things I actually wish I had waited on! \u00a0I had to get them filled and one cracked nail fixed the morning of the wedding, and it was more expensive than getting them done (fills here are like $14! \u00a0It cost me $43 before tip!). \u00a0The fills also cracked - I don't know if that was due to me being hard on them, or the quality of the work done at the spa. \u00a0I would definitely recommend waiting, if you aren't worried about functioning with long nails. \u00a0I had them done pretty short, so I would have been fine doing day of!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"32 guests, Bride & Groom & 2 kids booked!Planning Thread - lots of pictures, DIY\/templates and ongoing updates!<br><br><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/77321-marinah84s-planning-thread-31415-crown-paradise-club-cancun\/\"><span style=\"color:rgb(0,0,255);\">http:\/\/www.bestdestinationwedding.com\/topic\/77321-marinah84s-planning-thread-31415-crown-paradise-club-cancun\/<\/span><\/a>","Email":"marinarhianne@gmail.com","IpAddress":"67.149.51.114","GroupId":40,"GroupName":"Jr. Member","JoinDate":1387570652,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275696.jpeg?_r=1426773379","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"marinah84","Id":275696,"Name":"marinah84","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.155.94.124","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77321,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4853e1ff8e863f7bbfef74cd253b9e3e","RawContent":"[quote name=\"marinah84\" post=\"1890608\" timestamp=\"1427214878\"]\nI did them about a week before - it&#039;s one of the things I actually wish I had waited on!  I had to get them filled and one cracked nail fixed the morning of the wedding, and it was more expensive than getting them done (fills here are like $14!  It cost me $43 before tip!).  The fills also cracked - I don&#039;t know if that was due to me being hard on them, or the quality of the work done at the spa.  I would definitely recommend waiting, if you aren&#039;t worried about functioning with long nails.  I had them done pretty short, so I would have been fine doing day of![\/quote]Yeah I can&#039;t function with long nails aha so maybe I&#039;ll wait. I haven&#039;t decided if I want acrylic for the wedding or just a normal french manicure. I don&#039;t want to wreck my nails but oh, they look so pretty :)","Attachments":[],"Id":1890609,"PostDate":1427200623,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>marinah84, on 24 March 2015 - 12:34 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>I did them about a week before - it's one of the things I actually wish I had waited on! \u00a0I had to get them filled and one cracked nail fixed the morning of the wedding, and it was more expensive than getting them done (fills here are like $14! \u00a0It cost me $43 before tip!). \u00a0The fills also cracked - I don't know if that was due to me being hard on them, or the quality of the work done at the spa. \u00a0I would definitely recommend waiting, if you aren't worried about functioning with long nails. \u00a0I had them done pretty short, so I would have been fine doing day of!<\/p>\n<\/div>\n<\/div><\/div>\n<p>Yeah I can't function with long nails aha so maybe I'll wait. I haven't decided if I want acrylic for the wedding or just a normal french manicure. I don't want to wreck my nails but oh, they look so pretty <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<br><p><a data-ipb='nomediaparse' href='http:\/\/www.TickerFactory.com\/'><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;31;484\/st\/20150813\/e\/Wedding+time%21+\/dt\/-2\/k\/b92c\/event.png\" alt=\"event.png\"><\/a><\/p>\n<p style=\"text-align:center;\">\u00a0<\/p>\n<p style=\"text-align:center;\">\u00a0","Email":"sblopezb@gmail.com","IpAddress":"172.219.193.22","GroupId":42,"GroupName":"Sr. Member","JoinDate":1359748704,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265511.jpg?_r=1427386564","PhotoWidth":200,"PhotoHeight":153,"PhotoType":"custom"},"FormattedName":"TinkerSofi","Id":265511,"Name":"TinkerSofi","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.172.122.57","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77321,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"37d4e7a747bcd65bb7e61172d95d6be0","RawContent":"&lt;p&gt;I have a nail appointment booked on April 8th and I leave the 13th. Maybe it&#039;s too long before? I never get my nails done but wanted to for pictures and so they would look better than they do now. My god come to think of it I am all fake for this wedding...hahaha But a bride has to look gorge. on her wedding day.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Congratulations on making it official. Must be so exciting to be a Mrs. now.&lt;\/p&gt;","Attachments":[],"Id":1890637,"PostDate":1427210340,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I have a nail appointment booked on April 8th and I leave the 13th. Maybe it's too long before? I never get my nails done but wanted to for pictures and so they would look better than they do now. My god come to think of it I am all fake for this wedding...hahaha But a bride has to look gorge. on her wedding day.<\/p>\n<p>\u00a0<\/p>\n<p>Congratulations on making it official. Must be so exciting to be a Mrs. now.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p style=\"text-align:center;\"><strong>Kristy and Nathan<\/strong><\/p>\n<p style=\"text-align:center;\"><strong>Melia Caribe Tropical <\/strong><\/p>\n<p style=\"text-align:center;\"><strong>April 17, 2015<\/strong>","Email":"colek_64@hotmail.com","IpAddress":"199.180.174.8","GroupId":3,"GroupName":"Member","JoinDate":1395332214,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277264.jpg?_r=1421648383","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"kcole123","Id":277264,"Name":"kcole123","IsOnline":false}}],"Pages":{"TotalItems":254,"TotalPages":26,"CurrentPage":220,"NextPage":230,"PreviousPage":210,"LastPage":250},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
