howEmoticons":true,"IpAddress":"24.32.161.137","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77321,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"7cfcafddbe457fbdf01e214efe73755a","RawContent":"@[member=\"MrsCtoB\"]\n\n\nYay how exciting!!  It&#039;s getting so close!","Attachments":[],"Id":1882797,"PostDate":1421192587,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"266526\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/266526-mrsctob\/' title='Member profile'><span itemprop=\"name\">MrsCtoB<\/span><\/a><br><br>\nYay how exciting!!  It's getting so close!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"32 guests, Bride & Groom & 2 kids booked!Planning Thread - lots of pictures, DIY\/templates and ongoing updates!<br><br><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/77321-marinah84s-planning-thread-31415-crown-paradise-club-cancun\/\"><span style=\"color:rgb(0,0,255);\">http:\/\/www.bestdestinationwedding.com\/topic\/77321-marinah84s-planning-thread-31415-crown-paradise-club-cancun\/<\/span><\/a>","Email":"marinarhianne@gmail.com","IpAddress":"67.149.51.114","GroupId":40,"GroupName":"Jr. Member","JoinDate":1387570652,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275696.jpeg?_r=1426773379","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"marinah84","Id":275696,"Name":"marinah84","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.177.38.169","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77321,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"2519bf68446cfb2f2b3ef3e47e603464","RawContent":"&lt;p&gt;It really is @[member=\"marinah84\"] 2 months from today!!! When are you flying into Cancun?&lt;\/p&gt;","Attachments":[],"Id":1882943,"PostDate":1421268288,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>It really is @<a hovercard-ref=\"member\" hovercard-id=\"275696\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/275696-marinah84\/' title='Member profile'><span itemprop=\"name\">marinah84<\/span><\/a> 2 months from today!!! When are you flying into Cancun?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div><a class='bbc_url' href='http:\/\/www.TickerFactory.com\/'><\/div>\n<div><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;0;6\/st\/20150314\/e\/Our+Wedding\/k\/c1c3\/event.png\" alt=\"event.png\"><\/div>\n<div><\/a><\/div>\n","Email":"tiffmedeiros@gmail.com","IpAddress":"50.177.38.169","GroupId":40,"GroupName":"Jr. Member","JoinDate":1361723426,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-266526.jpg?_r=1427840086","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"MrsCtoB","Id":266526,"Name":"MrsCtoB","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"216.200.128.254","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77321,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b455e8fd8035f76d85390cba36bef9f9","RawContent":"&lt;p&gt;@[member=\"MrsCtoB\"]&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We are flying in on the 11th! &amp;nbsp;We have 2\/3 of the guests flying on the same flight, it&#039;s going to be a hoot! &amp;nbsp;We are staying a few days after guests leave, for our \"honeymoon\" but it&#039;s mostly for the TTD session and to take advantage of family babysitting (which we don&#039;t usually get since we live far away from the family now!).&lt;\/p&gt;","Attachments":[],"Id":1883015,"PostDate":1421335468,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"266526\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/266526-mrsctob\/' title='Member profile'><span itemprop=\"name\">MrsCtoB<\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>We are flying in on the 11th! \u00a0We have 2\/3 of the guests flying on the same flight, it's going to be a hoot! \u00a0We are staying a few days after guests leave, for our \"honeymoon\" but it's mostly for the TTD session and to take advantage of family babysitting (which we don't usually get since we live far away from the family now!).<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"32 guests, Bride & Groom & 2 kids booked!Planning Thread - lots of pictures, DIY\/templates and ongoing updates!<br><br><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/77321-marinah84s-planning-thread-31415-crown-paradise-club-cancun\/\"><span style=\"color:rgb(0,0,255);\">http:\/\/www.bestdestinationwedding.com\/topic\/77321-marinah84s-planning-thread-31415-crown-paradise-club-cancun\/<\/span><\/a>","Email":"marinarhianne@gmail.com","IpAddress":"67.149.51.114","GroupId":40,"GroupName":"Jr. Member","JoinDate":1387570652,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275696.jpeg?_r=1426773379","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"marinah84","Id":275696,"Name":"marinah84","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"216.200.128.254","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77321,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":3,"IsLiked":false,"PostKey":"231ad6ce953f974c8e58581b11c35c11","RawContent":"&lt;p&gt;&lt;span style=\"font-size:18px;\"&gt;&lt;strong&gt;Update 1.15.15&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Mini update again today. &amp;nbsp;I worked on the maracas tags over lunch, and while I don&#039;t \"love\" them, I think they&#039;ll do :) &amp;nbsp;I don&#039;t want to spend a ton of time and effort on them, since I&#039;m not 100% they&#039;ll even get used! &amp;nbsp;I am using leftover paper from invites, and thin ribbon I bought for .99 that I didn&#039;t have a use for. &amp;nbsp;They are a little bigger than I wanted, but no one will care :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I did the design in Picmonkey (mostly so I could use the Rue font that is so festively Mexican looking!)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;div&gt;[sharedmedia=gallery:images:79676]&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;I test printed today, and I&#039;m apparently out of ink...the colors aren&#039;t too bad, so not sure I want to bother getting more just for these. &amp;nbsp;Most of what I have left to print is probably black &amp;amp; white. &amp;nbsp;Except the welcome book...maybe I should just get ink haha.&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;I can&#039;t seem to find the exact template - if you buy the special paper from Avery, they&#039;ll already be in a luggage shape and labels. &amp;nbsp;I just used them for a general size &amp;amp; printed on normal ivory paper. &amp;nbsp;I&#039;ll keep looking, and if I find it, I&#039;ll post it here!&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;Test Print&lt;\/div&gt;\n&lt;div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:79771]&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;I decided to do a \"fun\" hole punch, and used my little crab (I got it on ebay for 99 cents from China, it&#039;s REALLY tiny but very cute).&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:79772]&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;Not sure how I&#039;m going to tie it in the punch, but this is okay for now ;)&lt;\/div&gt;\n&lt;div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:79774]&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;Here it is all put together with a maraca from our trip to Cabo. &amp;nbsp;Tag again is a bit bigger than I&#039;d like, but for a project that I&#039;m not sure we&#039;ll even use (if we can&#039;t get to the market for instance) I can&#039;t complain! &amp;nbsp;I plan on putting the tags together with the ribbon, and then when we get there, it&#039;ll be easy to just tie them on. &amp;nbsp;And with 20 guests coming with me on the plane, I&#039;m pretty sure someone will be able to help out ;)&lt;\/div&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;\/div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:79773]&lt;\/div&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;\/div&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;\/div&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1883023,"PostDate":1421340967,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span  style=\"font-size:18px\"><strong>Update 1.15.15<\/strong><\/span><\/p>\n<p>\u00a0<\/p>\n<p>Mini update again today. \u00a0I worked on the maracas tags over lunch, and while I don't \"love\" them, I think they'll do <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> \u00a0I don't want to spend a ton of time and effort on them, since I'm not 100% they'll even get used! \u00a0I am using leftover paper from invites, and thin ribbon I bought for .99 that I didn't have a use for. \u00a0They are a little bigger than I wanted, but no one will care <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I did the design in Picmonkey (mostly so I could use the Rue font that is so festively Mexican looking!)<\/p>\n<p>\u00a0<\/p>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/index.phpgallery\/image\/79676-maracas-tags\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17712\/sml_gallery_275696_17712_83738.png' class='galattach galimageview sharedmedia_screenshot' title='Maracas Tags'  width='200' height='141'  alt='Maracas Tags' id='sml_image_view_79676' \/><\/a>\n<br \/><\/div>\n<div>\u00a0<\/div>\n<div>\u00a0<\/div>\n<div>I test printed today, and I'm apparently out of ink...the colors aren't too bad, so not sure I want to bother getting more just for these. \u00a0Most of what I have left to print is probably black & white. \u00a0Except the welcome book...maybe I should just get ink haha.<\/div>\n<div>\u00a0<\/div>\n<div>I can't seem to find the exact template - if you buy the special paper from Avery, they'll already be in a luggage shape and labels. \u00a0I just used them for a general size & printed on normal ivory paper. \u00a0I'll keep looking, and if I find it, I'll post it here!<\/div>\n<div>\u00a0<\/div>\n<div>Test Print<\/div>\n<div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/index.phpgallery\/image\/79771-maracas-tags-mockup-1\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17712\/sml_gallery_275696_17712_676405.jpg' class='galattach galimageview sharedmedia_screenshot' title='Maracas Tags Mockup (1)'  width='150' height='200'  alt='Maracas Tags Mockup (1)' id='sml_image_view_79771' \/><\/a>\n<br \/><\/div>\n<div>\u00a0<\/div>\n<div>I decided to do a \"fun\" hole punch, and used my little crab (I got it on ebay for 99 cents from China, it's REALLY tiny but very cute).<\/div>\n<div>\u00a0<\/div>\n<div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/index.phpgallery\/image\/79772-maracas-tags-mockup-2\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17712\/sml_gallery_275696_17712_1278914.jpg' class='galattach galimageview sharedmedia_screenshot' title='Maracas Tags Mockup (2)'  width='200' height='150'  alt='Maracas Tags Mockup (2)' id='sml_image_view_79772' \/><\/a>\n<br \/><\/div>\n<div>\u00a0<\/div>\n<div>\u00a0<\/div>\n<div>Not sure how I'm going to tie it in the punch, but this is okay for now <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/><\/div>\n<div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/index.phpgallery\/image\/79774-maracas-tags-mockup-4\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17712\/sml_gallery_275696_17712_2010997.jpg' class='galattach galimageview sharedmedia_screenshot' title='Maracas Tags Mockup (4)'  width='150' height='200'  alt='Maracas Tags Mockup (4)' id='sml_image_view_79774' \/><\/a>\n<br \/><\/div>\n<div>\u00a0<\/div>\n<div>\u00a0<\/div>\n<div>Here it is all put together with a maraca from our trip to Cabo. \u00a0Tag again is a bit bigger than I'd like, but for a project that I'm not sure we'll even use (if we can't get to the market for instance) I can't complain! \u00a0I plan on putting the tags together with the ribbon, and then when we get there, it'll be easy to just tie them on. \u00a0And with 20 guests coming with me on the plane, I'm pretty sure someone will be able to help out <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/><\/div>\n<p>\u00a0<\/p>\n<\/div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/index.phpgallery\/image\/79773-maracas-tags-mockup-3\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17712\/sml_gallery_275696_17712_1969172.jpg' class='galattach galimageview sharedmedia_screenshot' title='Maracas Tags Mockup (3)'  width='200' height='150'  alt='Maracas Tags Mockup (3)' id='sml_image_view_79773' \/><\/a>\n<br \/><\/div>\n<p>\u00a0<\/p>\n<\/div>\n<p>\u00a0<\/p>\n<\/div>\n<p>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"32 guests, Bride & Groom & 2 kids booked!Planning Thread - lots of pictures, DIY\/templates and ongoing updates!<br><br><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/77321-marinah84s-planning-thread-31415-crown-paradise-club-cancun\/\"><span style=\"color:rgb(0,0,255);\">http:\/\/www.bestdestinationwedding.com\/topic\/77321-marinah84s-planning-thread-31415-crown-paradise-club-cancun\/<\/span><\/a>","Email":"marinarhianne@gmail.com","IpAddress":"67.149.51.114","GroupId":40,"GroupName":"Jr. Member","JoinDate":1387570652,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275696.jpeg?_r=1426773379","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"marinah84","Id":275696,"Name":"marinah84","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.177.38.169","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77321,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"71fdfae6ed978a36bff39f2b8e1b28d7","RawContent":"[quote name=\"marinah84\" post=\"1883015\" timestamp=\"1421349868\"]\n@[member=\"MrsCtoB\"]\n\nWe are flying in on the 11th!  We have 2\/3 of the guests flying on the same flight, it&#039;s going to be a hoot!  We are staying a few days after guests leave, for our \"honeymoon\" but it&#039;s mostly for the TTD session and to take advantage of family babysitting (which we don&#039;t usually get since we live far away from the family now!).[\/quote]us too!! I think we land around noon...maybe we will run into each other! We arrive solo on the 11th and have asked our guests to arrive the next day, Thursday!","Attachments":[],"Id":1883039,"PostDate":1421352291,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>marinah84, on 15 January 2015 - 03:24 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"266526\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/266526-mrsctob\/' title='Member profile'><span itemprop=\"name\">MrsCtoB<\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>We are flying in on the 11th! \u00a0We have 2\/3 of the guests flying on the same flight, it's going to be a hoot! \u00a0We are staying a few days after guests leave, for our \"honeymoon\" but it's mostly for the TTD session and to take advantage of family babysitting (which we don't usually get since we live far away from the family now!).<\/p>\n<\/div>\n<\/div><\/div>\n<p>us too!! I think we land around noon...maybe we will run into each other! We arrive solo on the 11th and have asked our guests to arrive the next day, Thursday!\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div><a class='bbc_url' href='http:\/\/www.TickerFactory.com\/'><\/div>\n<div><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;0;6\/st\/20150314\/e\/Our+Wedding\/k\/c1c3\/event.png\" alt=\"event.png\"><\/div>\n<div><\/a><\/div>\n","Email":"tiffmedeiros@gmail.com","IpAddress":"50.177.38.169","GroupId":40,"GroupName":"Jr. Member","JoinDate":1361723426,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-266526.jpg?_r=1427840086","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"MrsCtoB","Id":266526,"Name":"MrsCtoB","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.32.161.137","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77321,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f98e195826fc2b7fc76827cbf2ddd14b","RawContent":"That would be hilarious and awesome!  We land around 130 I think. Might be 230 now with the time change that goes into effect on 2\/1.  I need to check our flight!","Attachments":[],"Id":1883068,"PostDate":1421365990,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                That would be hilarious and awesome!  We land around 130 I think. Might be 230 now with the time change that goes into effect on 2\/1.  I need to check our flight!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"32 guests, Bride & Groom & 2 kids booked!Planning Thread - lots of pictures, DIY\/templates and ongoing updates!<br><br><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/77321-marinah84s-planning-thread-31415-crown-paradise-club-cancun\/\"><span style=\"color:rgb(0,0,255);\">http:\/\/www.bestdestinationwedding.com\/topic\/77321-marinah84s-planning-thread-31415-crown-paradise-club-cancun\/<\/span><\/a>","Email":"marinarhianne@gmail.com","IpAddress":"67.149.51.114","GroupId":40,"GroupName":"Jr. Member","JoinDate":1387570652,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275696.jpeg?_r=1426773379","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"marinah84","Id":275696,"Name":"marinah84","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.215.194.145","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77321,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"be9cdcb18d05ff81ec0cada5e2d6ee04","RawContent":"&lt;p&gt;&lt;strong&gt;&lt;span style=\"font-size:18px;\"&gt;Update: 01.24.2015&lt;\/span&gt;&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;Wedding Rings&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;FINALLY FI figured out his wedding band! &amp;nbsp;He chose a tungsten carbide ring, with meteorite inlay. &amp;nbsp;It wasn&#039;t nerdy enough that we&#039;re getting married on Pi Day or anything, right? &amp;nbsp;It&#039;s gorgeous - found it on eBay, and it&#039;s wonderful quality. &amp;nbsp;He had to get the tungsten carbide due to working in an industrial setting.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Cool Box&lt;\/p&gt;\n&lt;div&gt;[sharedmedia=gallery:images:79845]&lt;\/div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:79846]&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;Ring&lt;\/div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:79847]&lt;\/div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:79848]&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;My thumb lol&lt;\/div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:79849]&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;Our set :) &amp;nbsp;LOVE this shot - I almost don&#039;t need the photographer to do it on our wedding day, I love it so much! &amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:79852]&lt;\/div&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;He&#039;s also picked out the shoes, so I think he *might* be done...yay!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;Flower Girl Tutu&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Ok, I have to say, I&#039;m SO glad I put this project back on my plate. &amp;nbsp;It&#039;s SO stinking cute. &amp;nbsp;And they make fabric adhesive, so I didn&#039;t even have to break out my 15+ years out of use sewing skills ;)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I took an old pair of shorts that were the right color (decided to go with pink), and just split the crotch. &amp;nbsp;This created the strapless top and gave her some layering between the scratchy tulle and her skin.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;div&gt;[sharedmedia=gallery:images:79879]&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;I then used adhesive velcro - said not for fabric, but i figure it&#039;s only for the short term right? &amp;nbsp;seems to stick pretty well to me!&lt;\/div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:79880]&lt;\/div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:79876]&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;Glue drying on the carebear (with the badonkadonk, it was hard to get the dress on now with the flowers stiff from being glued!)&lt;\/div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:79881]&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;dress hanging up!&lt;\/div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:79874]&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;With straps (and her smartbutt face, haha)&lt;\/div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:79875]&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;strapless - i think it&#039;ll stay up ok without the straps, but she can choose day of if she wants them or not. &amp;nbsp;i like it both ways :)&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:79877]&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;shoes! &amp;nbsp;i made her some glittered ones, but they were stiff and hurt her heels, so she refuses to wear them.&lt;\/div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:79878]&lt;\/div&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;All she does is twirl and ask for her \"crown\" - what a princess ;)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;More updates soon - I can taste the finish line!!! haha&lt;\/p&gt;","Attachments":[],"Id":1884020,"PostDate":1422140602,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><strong><span  style=\"font-size:18px\">Update: 01.24.2015<\/span><\/strong><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><strong>Wedding Rings<\/strong><\/p>\n<p>FINALLY FI figured out his wedding band! \u00a0He chose a tungsten carbide ring, with meteorite inlay. \u00a0It wasn't nerdy enough that we're getting married on Pi Day or anything, right? \u00a0It's gorgeous - found it on eBay, and it's wonderful quality. \u00a0He had to get the tungsten carbide due to working in an industrial setting.<\/p>\n<p>\u00a0<\/p>\n<p>Cool Box<\/p>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/index.phpgallery\/image\/79845-grooms-ring\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17712\/sml_gallery_275696_17712_134495.jpg' class='galattach galimageview sharedmedia_screenshot' title='Grooms Ring'  width='150' height='200'  alt='Grooms Ring' id='sml_image_view_79845' \/><\/a>\n<br \/><\/div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/index.phpgallery\/image\/79846-grooms-ring\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17712\/sml_gallery_275696_17712_1307125.jpg' class='galattach galimageview sharedmedia_screenshot' title='Grooms Ring'  width='200' height='150'  alt='Grooms Ring' id='sml_image_view_79846' \/><\/a>\n<br \/><\/div>\n<div>\u00a0<\/div>\n<div>Ring<\/div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/index.phpgallery\/image\/79847-grooms-ring\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17712\/sml_gallery_275696_17712_560923.jpg' class='galattach galimageview sharedmedia_screenshot' title='Grooms Ring'  width='150' height='200'  alt='Grooms Ring' id='sml_image_view_79847' \/><\/a>\n<br \/><\/div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/index.phpgallery\/image\/79848-grooms-ring\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17712\/sml_gallery_275696_17712_2947932.jpg' class='galattach galimageview sharedmedia_screenshot' title='Grooms Ring'  width='200' height='150'  alt='Grooms Ring' id='sml_image_view_79848' \/><\/a>\n<br \/><\/div>\n<div>\u00a0<\/div>\n<div>My thumb lol<\/div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/index.phpgallery\/image\/79849-grooms-ring\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17712\/sml_gallery_275696_17712_1892101.jpg' class='galattach galimageview sharedmedia_screenshot' title='Grooms Ring'  width='150' height='200'  alt='Grooms Ring' id='sml_image_view_79849' \/><\/a>\n<br \/><\/div>\n<div>\u00a0<\/div>\n<div>Our set <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> \u00a0LOVE this shot - I almost don't need the photographer to do it on our wedding day, I love it so much! \u00a0<\/div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/index.phpgallery\/image\/79852-wedding-set\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17712\/sml_gallery_275696_17712_617761.png' class='galattach galimageview sharedmedia_screenshot' title='Wedding Set'  width='135' height='200'  alt='Wedding Set' id='sml_image_view_79852' \/><\/a>\n<br \/><\/div>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>He's also picked out the shoes, so I think he *might* be done...yay!<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><strong>Flower Girl Tutu<\/strong><\/p>\n<p>\u00a0<\/p>\n<p>Ok, I have to say, I'm SO glad I put this project back on my plate. \u00a0It's SO stinking cute. \u00a0And they make fabric adhesive, so I didn't even have to break out my 15+ years out of use sewing skills <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/><\/p>\n<p>\u00a0<\/p>\n<p>I took an old pair of shorts that were the right color (decided to go with pink), and just split the crotch. \u00a0This created the strapless top and gave her some layering between the scratchy tulle and her skin.<\/p>\n<p>\u00a0<\/p>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/index.phpgallery\/image\/79879-flower-girl-dress-parts\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17712\/sml_gallery_275696_17712_432712.jpg' class='galattach galimageview sharedmedia_screenshot' title='flower girl dress parts'  width='200' height='150'  alt='flower girl dress parts' id='sml_image_view_79879' \/><\/a>\n<br \/><\/div>\n<div>\u00a0<\/div>\n<div>I then used adhesive velcro - said not for fabric, but i figure it's only for the short term right? \u00a0seems to stick pretty well to me!<\/div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/index.phpgallery\/image\/79880-flower-girl-dress-straps\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17712\/sml_gallery_275696_17712_2271279.jpg' class='galattach galimageview sharedmedia_screenshot' title='flower girl dress straps'  width='150' height='200'  alt='flower girl dress straps' id='sml_image_view_79880' \/><\/a>\n<br \/><\/div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/index.phpgallery\/image\/79876-flower-girl-dress-strap-velcro\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17712\/sml_gallery_275696_17712_75776.jpg' class='galattach galimageview sharedmedia_screenshot' title='flower girl dress strap velcro'  width='150' height='200'  alt='flower girl dress strap velcro' id='sml_image_view_79876' \/><\/a>\n<br \/><\/div>\n<div>\u00a0<\/div>\n<div>Glue drying on the carebear (with the badonkadonk, it was hard to get the dress on now with the flowers stiff from being glued!)<\/div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/index.phpgallery\/image\/79881-flower-girl-dress-glue-drying\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17712\/sml_gallery_275696_17712_78752.jpg' class='galattach galimageview sharedmedia_screenshot' title='flower girl dress glue drying'  width='200' height='150'  alt='flower girl dress glue drying' id='sml_image_view_79881' \/><\/a>\n<br \/><\/div>\n<div>\u00a0<\/div>\n<div>dress hanging up!<\/div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/index.phpgallery\/image\/79874-flower-girl-dress-hanging\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17712\/sml_gallery_275696_17712_72583.jpg' class='galattach galimageview sharedmedia_screenshot' title='flower girl dress hanging'  width='150' height='200'  alt='flower girl dress hanging' id='sml_image_view_79874' \/><\/a>\n<br \/><\/div>\n<div>\u00a0<\/div>\n<div>With straps (and her smartbutt face, haha)<\/div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/index.phpgallery\/image\/79875-flower-girl-dress-sleeves\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17712\/sml_gallery_275696_17712_54700.jpg' class='galattach galimageview sharedmedia_screenshot' title='flower girl dress sleeves'  width='150' height='200'  alt='flower girl dress sleeves' id='sml_image_view_79875' \/><\/a>\n<br \/><\/div>\n<div>\u00a0<\/div>\n<div>\u00a0<\/div>\n<div>strapless - i think it'll stay up ok without the straps, but she can choose day of if she wants them or not. \u00a0i like it both ways <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/div>\n<div>\u00a0<\/div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/index.phpgallery\/image\/79877-flower-girl-dress-strapless\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17712\/sml_gallery_275696_17712_11537.jpg' class='galattach galimageview sharedmedia_screenshot' title='flower girl dress strapless'  width='150' height='200'  alt='flower girl dress strapless' id='sml_image_view_79877' \/><\/a>\n<br \/><\/div>\n<div>\u00a0<\/div>\n<div>shoes! \u00a0i made her some glittered ones, but they were stiff and hurt her heels, so she refuses to wear them.<\/div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/index.phpgallery\/image\/79878-flower-girl-shoes\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17712\/sml_gallery_275696_17712_10194.jpg' class='galattach galimageview sharedmedia_screenshot' title='flower girl shoes'  width='150' height='200'  alt='flower girl shoes' id='sml_image_view_79878' \/><\/a>\n<br \/><\/div>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>All she does is twirl and ask for her \"crown\" - what a princess <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>More updates soon - I can taste the finish line!!! haha<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"32 guests, Bride & Groom & 2 kids booked!Planning Thread - lots of pictures, DIY\/templates and ongoing updates!<br><br><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/77321-marinah84s-planning-thread-31415-crown-paradise-club-cancun\/\"><span style=\"color:rgb(0,0,255);\">http:\/\/www.bestdestinationwedding.com\/topic\/77321-marinah84s-planning-thread-31415-crown-paradise-club-cancun\/<\/span><\/a>","Email":"marinarhianne@gmail.com","IpAddress":"67.149.51.114","GroupId":40,"GroupName":"Jr. Member","JoinDate":1387570652,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275696.jpeg?_r=1426773379","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"marinah84","Id":275696,"Name":"marinah84","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"184.48.223.241","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77321,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":3,"IsLiked":false,"PostKey":"ca641ad29e69b434a6a12a2ab7021c25","RawContent":"&lt;p&gt;&lt;span style=\"font-size:18px;\"&gt;&lt;strong&gt;Update 1.25.2015&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Another update today, even though I\"m traveling!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;The Good: &amp;nbsp;Makeup Artist Booked!&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;After looking at a lot of reviews and pictures, I narrowed down to 3: Styling Trio, Sara Tamargo &amp;amp; The MakeUp Pros. &amp;nbsp;Styling Trio was just too expensive, even for the non-Adrian people. &amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Honestly, it was a toss up between The MakeUp Pros and Sara. &amp;nbsp;Fernando was EXTREMELY responsive, and worked very hard to win my business. &amp;nbsp;He has fantastic reviews, but just a lack of social media presence in terms of pictures. &amp;nbsp;I&#039;m sure he would have been wonderful, but he had a little heavier makeup hand than I envisioned for myself\/bridal party, from the pictures he sent me.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I had contacted Sara Tamargo (sister of Del Sol photographer I believe) after reviewing her website\/facebook\/this forum. &amp;nbsp;I LOVED almost every bride&#039;s makeup that she did, and some of the hair...wow! &amp;nbsp;She had a morning appointment the day of the wedding, but is able to come in the afternoon for us! &amp;nbsp;She also was open to a little haggling, haha, so I was able to get a small discount to appease my frugal FI (who still thinks I need to do my own hair and makeup...men!)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I would still recommend Fernando\/TheMakeupPros, but chose to go with Sara due to her style. &amp;nbsp;They were pretty much dead on the same in terms of prices, as well.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Her site:&amp;nbsp;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.saratamargo.com\/&#039;&gt;http:\/\/www.saratamargo.com\/&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;BDW Reviews:&amp;nbsp;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21612-sara-tamargo-makeup-artistry\/&#039;&gt;http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21612-sara-tamargo-makeup-artistry\/&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;Facebook:&amp;nbsp;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/SaraTamargoMakeup&#039;&gt;https:\/\/www.facebook.com\/SaraTamargoMakeup&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;The UGLY: SCAMMED.&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;I ordered hangers from an Etsy shop (GettinWired) and it appears they closed up shop and scammed a TON of brides. &amp;nbsp;So now I have a paypal dispute for the $62 I paid them. &amp;nbsp;I&#039;m pretty upset. &amp;nbsp;I will probably order myself a hanger still, but will most likely not worry about getting anyone else one. &amp;nbsp;Mostly due to time and I&#039;ve got a lot of $ I&#039;m already spending on them (more than I was going to, at least!). &amp;nbsp;I don&#039;t think this post shows how deeply upset and pissed I am that I got scammed...I never even thought about it with Etsy!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;Wedding Timelines&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;I&#039;m not ready to print these yet, but I have them done outside of tweaking times (already had to tweak the time on he hair\/makeup when I booked Sara, for instance!). &amp;nbsp;I was going to get them printed on postcards, but probably won&#039;t, since I feel the timeline is pretty fluid and I don&#039;t want to have to correct them all, haha. &amp;nbsp;We&#039;ll see the printing timeline of Vistaprint - maybe 2 weeks out I&#039;ll see if it&#039;s still feasible. &amp;nbsp;I&#039;ve attached the PDFs. &amp;nbsp;One for everyone in the welcome bag (Guest), and then one for the girls\/one for the guys. &amp;nbsp;I think they&#039;re pretty cute!&lt;\/p&gt;","Attachments":[],"Id":1884046,"PostDate":1422185063,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span  style=\"font-size:18px\"><strong>Update 1.25.2015<\/strong><\/span><\/p>\n<p>\u00a0<\/p>\n<p>Another update today, even though I\"m traveling!<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><strong>The Good: \u00a0Makeup Artist Booked!<\/strong><\/p>\n<p>\u00a0<\/p>\n<p>After looking at a lot of reviews and pictures, I narrowed down to 3: Styling Trio, Sara Tamargo & The MakeUp Pros. \u00a0Styling Trio was just too expensive, even for the non-Adrian people. \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Honestly, it was a toss up between The MakeUp Pros and Sara. \u00a0Fernando was EXTREMELY responsive, and worked very hard to win my business. \u00a0He has fantastic reviews, but just a lack of social media presence in terms of pictures. \u00a0I'm sure he would have been wonderful, but he had a little heavier makeup hand than I envisioned for myself\/bridal party, from the pictures he sent me.<\/p>\n<p>\u00a0<\/p>\n<p>I had contacted Sara Tamargo (sister of Del Sol photographer I believe) after reviewing her website\/facebook\/this forum. \u00a0I LOVED almost every bride's makeup that she did, and some of the hair...wow! \u00a0She had a morning appointment the day of the wedding, but is able to come in the afternoon for us! \u00a0She also was open to a little haggling, haha, so I was able to get a small discount to appease my frugal FI (who still thinks I need to do my own hair and makeup...men!)<\/p>\n<p>\u00a0<\/p>\n<p>I would still recommend Fernando\/TheMakeupPros, but chose to go with Sara due to her style. \u00a0They were pretty much dead on the same in terms of prices, as well.<\/p>\n<p>\u00a0<\/p>\n<p>Her site:\u00a0<a href='http:\/\/www.saratamargo.com\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.saratamargo.com\/<\/a><\/p>\n<p>BDW Reviews:\u00a0<a href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21612-sara-tamargo-makeup-artistry\/' class='bbc_url' title=''>http:\/\/www.bestdesti...akeup-artistry\/<\/a><\/p>\n<p>Facebook:\u00a0<a href='https:\/\/www.facebook.com\/SaraTamargoMakeup' class='bbc_url' title='External link' rel='nofollow external'>https:\/\/www.facebook...raTamargoMakeup<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><strong>The UGLY: SCAMMED.<\/strong><\/p>\n<p>I ordered hangers from an Etsy shop (GettinWired) and it appears they closed up shop and scammed a TON of brides. \u00a0So now I have a paypal dispute for the $62 I paid them. \u00a0I'm pretty upset. \u00a0I will probably order myself a hanger still, but will most likely not worry about getting anyone else one. \u00a0Mostly due to time and I've got a lot of $ I'm already spending on them (more than I was going to, at least!). \u00a0I don't think this post shows how deeply upset and pissed I am that I got scammed...I never even thought about it with Etsy!<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><strong>Wedding Timelines<\/strong><\/p>\n<p>I'm not ready to print these yet, but I have them done outside of tweaking times (already had to tweak the time on he hair\/makeup when I booked Sara, for instance!). \u00a0I was going to get them printed on postcards, but probably won't, since I feel the timeline is pretty fluid and I don't want to have to correct them all, haha. \u00a0We'll see the printing timeline of Vistaprint - maybe 2 weeks out I'll see if it's still feasible. \u00a0I've attached the PDFs. \u00a0One for everyone in the welcome bag (Guest), and then one for the girls\/one for the guys. \u00a0I think they're pretty cute!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"32 guests, Bride & Groom & 2 kids booked!Planning Thread - lots of pictures, DIY\/templates and ongoing updates!<br><br><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/77321-marinah84s-planning-thread-31415-crown-paradise-club-cancun\/\"><span style=\"color:rgb(0,0,255);\">http:\/\/www.bestdestinationwedding.com\/topic\/77321-marinah84s-planning-thread-31415-crown-paradise-club-cancun\/<\/span><\/a>","Email":"marinarhianne@gmail.com","IpAddress":"67.149.51.114","GroupId":40,"GroupName":"Jr. Member","JoinDate":1387570652,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275696.jpeg?_r=1426773379","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"marinah84","Id":275696,"Name":"marinah84","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.215.197.134","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77321,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"31c44ec314e317727dfff3d92d053d04","RawContent":"&lt;p&gt;For my reference, my updated &#039;to do&#039; list based on a previous post:&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;font-size:13.5135135650635px;color:rgb(40,40,40);\"&gt;&lt;span style=\"font-size:18px;\"&gt;&lt;strong&gt;Updated To Do Lists:&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;font-size:13.5135135650635px;color:rgb(40,40,40);\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;font-size:13.5135135650635px;color:rgb(40,40,40);\"&gt;&lt;strong&gt;DIY&lt;\/strong&gt;&lt;\/p&gt;\n&lt;ul&gt;&lt;li&gt;Finish mothers gifts (package them nicely)&lt;\/li&gt;\n&lt;li&gt;Dress Hangers (due to being scammed :( )&lt;\/li&gt;\n&lt;li&gt;Groom Bout (rest are done)&lt;\/li&gt;\n&lt;\/ul&gt;&lt;p style=\"font-family:arial, helvetica, sans-serif;font-size:13.5135135650635px;color:rgb(40,40,40);\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;font-size:13.5135135650635px;color:rgb(40,40,40);\"&gt;&lt;strong&gt;Welcome Bags\/Favors&lt;\/strong&gt;&lt;\/p&gt;\n&lt;ul&gt;&lt;li&gt;Put on chapstick labels &amp;amp; put in survival kit&lt;\/li&gt;\n&lt;li&gt;Finish making maraca tags&lt;\/li&gt;\n&lt;li&gt;Finish sunglasses tags&lt;\/li&gt;\n&lt;li&gt;Finish Welcome Booklet (Home printer)&lt;\/li&gt;\n&lt;li&gt;Ongoing - iPod playlists - ceremony, dinner, reception&lt;\/li&gt;\n&lt;li&gt;Print Kid Coloring Book (home printer)&lt;\/li&gt;\n&lt;li&gt;Make luggage tag placecards with booked guest names (Home printer)&lt;\/li&gt;\n&lt;li&gt;Print parent wedding 5x7s&lt;\/li&gt;\n&lt;li&gt;Print Ceremony Program Fans (Vistaprint)&amp;nbsp;&lt;\/li&gt;\n&lt;li&gt;Menu\/I Spy Cards for plates (Vistaprint)&amp;nbsp;&lt;\/li&gt;\n&lt;\/ul&gt;&lt;p style=\"font-family:arial, helvetica, sans-serif;font-size:13.5135135650635px;color:rgb(40,40,40);\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;font-size:13.5135135650635px;color:rgb(40,40,40);\"&gt;&lt;strong&gt;Important&lt;\/strong&gt;&lt;\/p&gt;\n&lt;ul&gt;&lt;li&gt;Altered Wedding Dress pickup&lt;\/li&gt;\n&lt;li&gt;Get notarized permission form for family to take kids back in USA (not necessary but a safety net just in case)&lt;\/li&gt;\n&lt;li&gt;Get legally married :)&lt;\/li&gt;\n&lt;li&gt;Email coordinator with listed out everything we agreed on, and get her confirmation&lt;\/li&gt;\n&lt;li&gt;Print out binder for wedding coordinator with wedding to dos (reception set up, ceremony set up, etc)&lt;\/li&gt;\n&lt;\/ul&gt;&lt;p style=\"margin:0px;\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"margin:0px;\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"font-size:13.5135135650635px;font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;&lt;strong&gt;Beauty&lt;\/strong&gt;&lt;\/p&gt;\n&lt;ul&gt;&lt;li&gt;Eyelash extensions&lt;\/li&gt;\n&lt;li&gt;Acrylic nails&lt;\/li&gt;\n&lt;li&gt;Ombre hair\/HALO extension&lt;\/li&gt;\n&lt;\/ul&gt;","Attachments":[],"Id":1884073,"PostDate":1422200912,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>For my reference, my updated 'to do' list based on a previous post:<\/p>\n<p>\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;font-size:13.5135135650635px;color:rgb(40,40,40)\"><span  style=\"font-size:18px\"><strong>Updated To Do Lists:<\/strong><\/span><\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;font-size:13.5135135650635px;color:rgb(40,40,40)\">\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;font-size:13.5135135650635px;color:rgb(40,40,40)\"><strong>DIY<\/strong><\/p>\n<ul><li>Finish mothers gifts (package them nicely)<\/li>\n<li>Dress Hangers (due to being scammed <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/sad.png' class='bbc_emoticon' alt=':(' \/> )<\/li>\n<li>Groom Bout (rest are done)<\/li>\n<\/ul><p  style=\"font-family:arial, helvetica, sans-serif;font-size:13.5135135650635px;color:rgb(40,40,40)\">\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;font-size:13.5135135650635px;color:rgb(40,40,40)\"><strong>Welcome Bags\/Favors<\/strong><\/p>\n<ul><li>Put on chapstick labels & put in survival kit<\/li>\n<li>Finish making maraca tags<\/li>\n<li>Finish sunglasses tags<\/li>\n<li>Finish Welcome Booklet (Home printer)<\/li>\n<li>Ongoing - iPod playlists - ceremony, dinner, reception<\/li>\n<li>Print Kid Coloring Book (home printer)<\/li>\n<li>Make luggage tag placecards with booked guest names (Home printer)<\/li>\n<li>Print parent wedding 5x7s<\/li>\n<li>Print Ceremony Program Fans (Vistaprint)\u00a0<\/li>\n<li>Menu\/I Spy Cards for plates (Vistaprint)\u00a0<\/li>\n<\/ul><p  style=\"font-family:arial, helvetica, sans-serif;font-size:13.5135135650635px;color:rgb(40,40,40)\">\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;font-size:13.5135135650635px;color:rgb(40,40,40)\"><strong>Important<\/strong><\/p>\n<ul><li>Altered Wedding Dress pickup<\/li>\n<li>Get notarized permission form for family to take kids back in USA (not necessary but a safety net just in case)<\/li>\n<li>Get legally married <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/li>\n<li>Email coordinator with listed out everything we agreed on, and get her confirmation<\/li>\n<li>Print out binder for wedding coordinator with wedding to dos (reception set up, ceremony set up, etc)<\/li>\n<\/ul><p  style=\"margin:0px\">\u00a0<\/p>\n<p  style=\"margin:0px\">\u00a0<\/p>\n<p  style=\"font-size:13.5135135650635px;font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\"><strong>Beauty<\/strong><\/p>\n<ul><li>Eyelash extensions<\/li>\n<li>Acrylic nails<\/li>\n<li>Ombre hair\/HALO extension<\/li>\n<\/ul>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"32 guests, Bride & Groom & 2 kids booked!Planning Thread - lots of pictures, DIY\/templates and ongoing updates!<br><br><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/77321-marinah84s-planning-thread-31415-crown-paradise-club-cancun\/\"><span style=\"color:rgb(0,0,255);\">http:\/\/www.bestdestinationwedding.com\/topic\/77321-marinah84s-planning-thread-31415-crown-paradise-club-cancun\/<\/span><\/a>","Email":"marinarhianne@gmail.com","IpAddress":"67.149.51.114","GroupId":40,"GroupName":"Jr. Member","JoinDate":1387570652,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275696.jpeg?_r=1426773379","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"marinah84","Id":275696,"Name":"marinah84","IsOnline":true}}],"Pages":{"TotalItems":254,"TotalPages":26,"CurrentPage":90,"NextPage":100,"PreviousPage":80,"LastPage":250},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
