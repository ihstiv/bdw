{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":59942,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1a06e9c764ef8bc19fdd078c8f8017a6","RawContent":"&lt;p&gt; Hey GC brides,&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I&#039;ve started our wedding site and wanted to share it in case it is helpful to you (or any other potential Grand Cayman brides) www.SeguraMueller.com&lt;\/p&gt; &lt;p&gt; It is a work in progress...but some basics are there all ready.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I don&#039;t have many vendors lined up yet; I would love to hear your thoughts on who you choose &amp;amp; if you love them...&lt;\/p&gt;","Attachments":[],"Id":1439016,"PostDate":1303441233,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hey GC brides,<\/p> <p> \u00a0<\/p> <p> I've started our wedding site and wanted to share it in case it is helpful to you (or any other potential Grand Cayman brides) www.SeguraMueller.com<\/p> <p> It is a work in progress...but some basics are there all ready.<\/p> <p> \u00a0<\/p> <p> I don't have many vendors lined up yet; I would love to hear your thoughts on who you choose & if you love them...<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"segura.mueller@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1278754661,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-230070.jpg?_r=0","PhotoWidth":200,"PhotoHeight":160,"PhotoType":"custom"},"FormattedName":"ls415","Id":230070,"Name":"ls415","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":59942,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a7ef32fe2a856555e6e236b5684c1caa","RawContent":"&lt;p&gt; I found this beautiful wristlet for our mother&#039;s to wear and Celebrations is able to do them for me.&amp;nbsp; Super excited.....love them&lt;img alt=\"Mothers writst corsage..bmp\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/403373\/width\/1000\/height\/500\" \/&gt;&lt;\/p&gt;","Attachments":[],"Id":1445642,"PostDate":1304456184,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I found this beautiful wristlet for our mother's to wear and Celebrations is able to do them for me.\u00a0 Super excited.....love them<span rel='lightbox'><img class='bbc_img' alt=\"Mothers writst corsage..bmp\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/403373\/width\/1000\/height\/500\" \/><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cyndi_harrison@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1303325905,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-239091.jpg?_r=0","PhotoWidth":200,"PhotoHeight":130,"PhotoType":"custom"},"FormattedName":"GrandCayBride","Id":239091,"Name":"GrandCayBride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":59942,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ce8d0f5431cbaa910bd5abacd0a75a64","RawContent":"&lt;p&gt; Love Love Love!!!!&amp;nbsp; Gorgeous!&lt;\/p&gt;","Attachments":[],"Id":1447086,"PostDate":1304633628,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Love Love Love!!!!\u00a0 Gorgeous!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"shaunandstefanie@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1295551451,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-235778.jpg?_r=0","PhotoWidth":200,"PhotoHeight":215,"PhotoType":"custom"},"FormattedName":"Starfish0512","Id":235778,"Name":"Starfish0512","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":59942,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"98f30ddc0dd8ba91826071ac61d33622","RawContent":"&lt;p&gt; Our trip is a short 22 days away... not that I&#039;m counting days or anything!&amp;nbsp; We&#039;ve decided to do an e-shoot while we are down there with Rebecca Davidson, we will most likely be using her for our wedding too...&amp;nbsp; Super excited! Fingers crossed that we still have our choice of date for either place, getting a little nervous about it!!&lt;\/p&gt;","Attachments":[],"Id":1447087,"PostDate":1304633813,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Our trip is a short 22 days away... not that I'm counting days or anything!\u00a0 We've decided to do an e-shoot while we are down there with Rebecca Davidson, we will most likely be using her for our wedding too...\u00a0 Super excited! Fingers crossed that we still have our choice of date for either place, getting a little nervous about it!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"shaunandstefanie@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1295551451,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-235778.jpg?_r=0","PhotoWidth":200,"PhotoHeight":215,"PhotoType":"custom"},"FormattedName":"Starfish0512","Id":235778,"Name":"Starfish0512","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":59942,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c65771a317797b7f72bfc2579dcb39f2","RawContent":"We are getting married on June 24th!!  We will be there at the same time.  I hope you have a wonderful day!!!!\n   [quote]\nOriginally Posted by [b]Starfish0512[\/b] \/img\/forum\/go_quote.gif\n \n \n Our trip is a short 22 days away... not that I&#039;m counting days or anything!  We&#039;ve decided to do an e-shoot while we are down there with Rebecca Davidson, we will most likely be using her for our wedding too...  Super excited! Fingers crossed that we still have our choice of date for either place, getting a little nervous about it!![\/quote]","Attachments":[],"Id":1448590,"PostDate":1304948617,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <br \/> We are getting married on June 24th!!\u00a0 We will be there at the same time.\u00a0 I hope you have a wonderful day!!!!<br \/> \u00a0<\/p> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>Starfish0512<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" style=\"border-bottom: 0px solid; border-left: 0px solid; border-top: 0px solid; border-right: 0px solid\" \/><\/span><br \/> <br \/> <p> Our trip is a short 22 days away... not that I'm counting days or anything!\u00a0 We've decided to do an e-shoot while we are down there with Rebecca Davidson, we will most likely be using her for our wedding too...\u00a0 Super excited! Fingers crossed that we still have our choice of date for either place, getting a little nervous about it!!<\/p> <\/blockquote> <br \/> <br \/> <p> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cyndi_harrison@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1303325905,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-239091.jpg?_r=0","PhotoWidth":200,"PhotoHeight":130,"PhotoType":"custom"},"FormattedName":"GrandCayBride","Id":239091,"Name":"GrandCayBride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":59942,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bc89cab9bab5b9944fa47e5d7416c61c","RawContent":"I just re read what you posted and we wont be there at the same time....you are getting married next year.  Oops.  Sorry....too much going on and on my mind!!!  :) [quote]\nOriginally Posted by [b]GrandCayBride[\/b] \/img\/forum\/go_quote.gif\n \n \n \n We are getting married on June 24th!!  We will be there at the same time.  I hope you have a wonderful day!!!!\n   \n \n \n[\/quote]","Attachments":[],"Id":1448620,"PostDate":1304950729,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <br \/> I just re read what you posted and we wont be there at the same time....you are getting married next year.\u00a0 Oops.\u00a0 Sorry....too much going on and on my mind!!!\u00a0 <img src='https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>GrandCayBride<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" style=\"border-bottom: 0px solid; border-left: 0px solid; border-top: 0px solid; border-right: 0px solid\" \/><\/span><br \/> <br \/> <p> <br \/> We are getting married on June 24th!!\u00a0 We will be there at the same time.\u00a0 I hope you have a wonderful day!!!!<br \/> \u00a0<\/p> <br \/> <br \/> <p> \u00a0<\/p> <\/blockquote> <br \/> <br \/> <p> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cyndi_harrison@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1303325905,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-239091.jpg?_r=0","PhotoWidth":200,"PhotoHeight":130,"PhotoType":"custom"},"FormattedName":"GrandCayBride","Id":239091,"Name":"GrandCayBride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":59942,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7977d8a445c436901ce7bf766cb22ee0","RawContent":"&lt;p&gt; June 24th is right around the corner though :)&amp;nbsp; Hows everything going? smoothly I hope?! How many people are traveling down with you??&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1448849,"PostDate":1304973641,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> June 24th is right around the corner though <img src='https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0 Hows everything going? smoothly I hope?! How many people are traveling down with you??\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"shaunandstefanie@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1295551451,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-235778.jpg?_r=0","PhotoWidth":200,"PhotoHeight":215,"PhotoType":"custom"},"FormattedName":"Starfish0512","Id":235778,"Name":"Starfish0512","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":59942,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"08c54eda217169799e595f293e14b852","RawContent":"&lt;p&gt; Everything seems to being going great so far.......I will let you know when I get back and hopefully I will tell you it went very smoothly!&lt;\/p&gt; &lt;p&gt; We have 30 people going....should be a ball!!!&amp;nbsp; How about you.....how many will you have going down?&lt;\/p&gt;","Attachments":[],"Id":1449411,"PostDate":1305051565,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Everything seems to being going great so far.......I will let you know when I get back and hopefully I will tell you it went very smoothly!<\/p> <p> We have 30 people going....should be a ball!!!\u00a0 How about you.....how many will you have going down?<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cyndi_harrison@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1303325905,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-239091.jpg?_r=0","PhotoWidth":200,"PhotoHeight":130,"PhotoType":"custom"},"FormattedName":"GrandCayBride","Id":239091,"Name":"GrandCayBride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":59942,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6d7b2a1cf16f98cce2b1fa27782e1c51","RawContent":"&lt;p&gt; We are looking at a guest list of 30, expecting around 20-25.&amp;nbsp;Because our guest list is on the smaller side (just how we wanted it) and due to the requirements of the caribbean club to hold a ceremony there,&amp;nbsp;I spoke with my FMIL, she agreed that perhaps the best way to handle the guests would be in single rooms i.e Grand Cayman Beach Suites...&amp;nbsp; spoke with Marina again and she has us penciled in for May 25, 2012.   Unfortunately the 26th was booked already but i&#039;m fine with a friday wedding!&amp;nbsp; Needless to say GrandCay Bride - I will definitely be looking forward to all the wonderful reviews you will have from your wedding!!!&lt;\/p&gt;","Attachments":[],"Id":1450227,"PostDate":1305149595,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> We are looking at a guest list of 30, expecting around 20-25.\u00a0Because our guest list is on the smaller side (just how we wanted it) and due to the requirements of the caribbean club to hold a ceremony there,\u00a0I spoke with my FMIL, she agreed that perhaps the best way to handle the guests would be in single rooms i.e Grand Cayman Beach Suites...\u00a0 spoke with Marina again and she has us penciled in for May 25, 2012.\u00a0\u00a0 Unfortunately the 26th was booked already but i'm fine with a friday wedding!\u00a0 Needless to say GrandCay Bride - I will definitely be looking forward to all the wonderful reviews you will have from your wedding!!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"shaunandstefanie@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1295551451,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-235778.jpg?_r=0","PhotoWidth":200,"PhotoHeight":215,"PhotoType":"custom"},"FormattedName":"Starfish0512","Id":235778,"Name":"Starfish0512","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":59942,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0ab00cc4607f8b5931c9870423f5a54e","RawContent":"&lt;p&gt; We are having ceremony on the Beach with a Steel Drum player......... cocktail hour at Hemingways terrace with Shellfish bar......then Dinner at Turtle pool Terrace.....Limited Hemingways menu.&amp;nbsp; We are having Mainstream a Jazz\/Raggae band play at reception.   Should be fun.&amp;nbsp; I will definitely let you know how it went.&lt;\/p&gt;","Attachments":[],"Id":1450705,"PostDate":1305226012,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> We are having ceremony on the Beach with a Steel Drum player......... cocktail hour at Hemingways terrace with Shellfish bar......then Dinner at Turtle pool Terrace.....Limited Hemingways menu.\u00a0 We are having Mainstream a Jazz\/Raggae band play at reception.\u00a0\u00a0 Should be fun.\u00a0 I will definitely let you know how it went.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cyndi_harrison@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1303325905,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-239091.jpg?_r=0","PhotoWidth":200,"PhotoHeight":130,"PhotoType":"custom"},"FormattedName":"GrandCayBride","Id":239091,"Name":"GrandCayBride","IsOnline":false}}],"Pages":{"TotalItems":369,"TotalPages":37,"CurrentPage":10,"NextPage":20,"PreviousPage":0,"LastPage":360},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
