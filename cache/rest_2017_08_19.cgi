{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":2,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":829,"MovedTo":null,"MovedOn":0,"FirstPostId":1800587,"Rating":0,"RatingHits":0,"Starter":{"Id":244956,"Name":"kfarkas26","Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-244956.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"StartDate":1379420169,"LastPoster":{"Id":275858,"Name":"megthomson","Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-275858.jpg?_r=1394079727","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":67,"Preview":{"Id":1800587,"PostDate":1379420169,"PostContent":"Hello fellow brides, \u00a0 Just wanted to make you aware of an issue I am having with a vendor that w...","Author":{"Signature":"","Email":"kfarkas26@gmail.com","IpAddress":"","GroupId":47,"GroupName":"Site Supporter","JoinDate":1315330394,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-244956.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"kfarkas26","Id":244956,"Name":"kfarkas26","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75115,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"298210ecdfa16f8b7343acf96986104e","RawContent":"&lt;p&gt;Hello fellow brides,&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;Just wanted to make you aware of an issue I am having with a vendor that was referred to me through word of mouth on this site. I used Robert Dunkley and DVS video for my wedding in June. He was a pleasure to work with before and during the wedding, However I have not heard from him since my wedding day, and he is not answering any of my calls or emails. I have also been hearing that he is doing the same to other brides as well. I am pretty sure that he took my money and ran. I have even gone as far as contacting him under a fake email claiming to be a bride trying to book his services, he got back to me right away and was trying to have me book him. Once I confronted him and told him who I was he dropped all communication again. I am heartbroken over this issue because not only did I lose a big chunk of money but I also lost alot of memories that he captured,. I wanted to warn you all so you do not have to go through the same thing I am dealing with.&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;Good Luck!&lt;\/p&gt; &lt;p&gt;Kristi&lt;\/p&gt;","Attachments":[],"Id":1800587,"PostDate":1379420169,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello fellow brides,<\/p> <p>\u00a0<\/p> <p>Just wanted to make you aware of an issue I am having with a vendor that was referred to me through word of mouth on this site. I used Robert Dunkley and DVS video for my wedding in June. He was a pleasure to work with before and during the wedding, However I have not heard from him since my wedding day, and he is not answering any of my calls or emails. I have also been hearing that he is doing the same to other brides as well. I am pretty sure that he took my money and ran. I have even gone as far as contacting him under a fake email claiming to be a bride trying to book his services, he got back to me right away and was trying to have me book him. Once I confronted him and told him who I was he dropped all communication again. I am heartbroken over this issue because not only did I lose a big chunk of money but I also lost alot of memories that he captured,. I wanted to warn you all so you do not have to go through the same thing I am dealing with.<\/p> <p>\u00a0<\/p> <p>Good Luck!<\/p> <p>Kristi<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kfarkas26@gmail.com","IpAddress":"","GroupId":47,"GroupName":"Site Supporter","JoinDate":1315330394,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-244956.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"kfarkas26","Id":244956,"Name":"kfarkas26","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.76.163.5","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75115,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b9060aa23115755b96da3a7fa44accfb","RawContent":"So sorry to hear this!","Attachments":[],"Id":1822351,"PostDate":1388813188,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                So sorry to hear this!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"megthomson78@gmail.com","IpAddress":"173.76.163.5","GroupId":40,"GroupName":"Jr. Member","JoinDate":1388753198,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-275858.jpg?_r=1394079727","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"megthomson","Id":275858,"Name":"megthomson","IsOnline":false}}],"Id":"75115","Title":"BRIDES BEWARE- VENDOR FRAUD- DVS Videos- Jamaica","LastPostDate":1388813188},"Pages":{"TotalItems":2,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
