stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1453235488","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"pjay","Id":281478,"Name":"pjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.196.146.237","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79914,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"92d0891855273dfed3b86ca555ced8b2","RawContent":"Hi! I&#039;m interested in several of your items but live in Wisconsin so I would need them shipped at the additional cost! Can you let me know what is already spoke for\/unavailable?","Attachments":[],"Id":1912458,"PostDate":1459681988,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi! I'm interested in several of your items but live in Wisconsin so I would need them shipped at the additional cost! Can you let me know what is already spoke for\/unavailable? \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"laurapotter88@gmail.com","IpAddress":"108.196.146.237","GroupId":39,"GroupName":"Newbie","JoinDate":1447062571,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"laurapotter88","Id":285279,"Name":"laurapotter88","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.142.4.206","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79914,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9a1a695405c7461f7e16206fa78a67e2","RawContent":"&lt;p&gt;Hi Laura,&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;My gold mercury glass votives (just the gold ones), my Mr &amp;amp; Mrs signs, my LED tealights. I think that is it?&amp;nbsp;&lt;\/p&gt;\n\n&lt;p&gt;I mean that&#039;s all that I&#039;ve sold from here&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;@[member=\"laurapotter88\"]&lt;\/p&gt;","Attachments":[],"Id":1912520,"PostDate":1459776308,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Laura,\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>My gold mercury glass votives (just the gold ones), my Mr & Mrs signs, my LED tealights. I think that is it?\u00a0<\/p>\n<br \/><p>I mean that's all that I've sold from here<\/p>\n<p>\u00a0<\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"285279\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/285279-laurapotter88\/' title='Member profile'><span itemprop=\"name\">laurapotter88<\/span><\/a><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419423414,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1453235488","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"pjay","Id":281478,"Name":"pjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.54.102.36","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79914,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"23d9569fbd7945bef9c428bdd40878a9","RawContent":"&lt;p&gt;how much to shi&lt;sub&gt;p robe to nyc&lt;\/sub&gt;&lt;\/p&gt;","Attachments":[],"Id":1912536,"PostDate":1459808233,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>how much to shi<sub>p robe to nyc<\/sub><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"dathotgal51@yahoo.com","IpAddress":"173.77.182.126","GroupId":39,"GroupName":"Newbie","JoinDate":1423457925,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282047.jpg?_r=1462036649","PhotoWidth":200,"PhotoHeight":203,"PhotoType":"facebook"},"FormattedName":"dathotgal","Id":282047,"Name":"dathotgal","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.142.4.206","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79914,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8eaa2a199ef010d860c3a50e51d88206","RawContent":"&lt;p&gt;@[member=\"dathotgal\"] I would need your zipcode and then I can get a quote if you&#039;d like? If you want to DM me your zipcode :)&lt;\/p&gt;","Attachments":[],"Id":1912559,"PostDate":1459858708,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"282047\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282047-dathotgal\/' title='Member profile'><span itemprop=\"name\">dathotgal<\/span><\/a> I would need your zipcode and then I can get a quote if you'd like? If you want to DM me your zipcode <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419423414,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1453235488","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"pjay","Id":281478,"Name":"pjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"12.7.145.170","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79914,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6493ff8a2c56ecb9acd08e258e4c8426","RawContent":"[quote name=\"pjay\" post=\"1910389\" timestamp=\"1454379345\"]\nHello brides!\n\nIt&#039;s been almost two months now and i&#039;ve finally had a chance to sort through all of my wedding items.\n\nI&#039;ve got quite a bit that i&#039;m looking to sell and was hoping to sell some of the more breakable items locally (GTA area) if possible.\nI am willing to ship at the cost of the buyer.\n\nI may have some leftover items for OOT bags as well, but I haven&#039;t unpacked those just yet.\n\n\n[b]12 gold mercury glass votive holders $15[\/b]\n[img]http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif[\/img][url=\"http:\/\/www.bestdestinationwedding.com\/index.php?app=core&amp;amp;module=attach&amp;amp;section=attach&amp;amp;attach_rel_module=post&amp;amp;attach_id=35003\"]Facetune-201502081035077640.jpg[\/url]\n\n\n\n[b]Three large mason jars - Painted and distressed $10 (gray and mint)[\/b]\n[img]http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif[\/img][url=\"http:\/\/www.bestdestinationwedding.com\/index.php?app=core&amp;amp;module=attach&amp;amp;section=attach&amp;amp;attach_rel_module=post&amp;amp;attach_id=35004\"]20160201_193105.jpg[\/url]\n\n\n\n[b]&#039;hob nob&#039; textured vases - One white mason and two clear glass. $15 for all three[\/b]\n[img]http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif[\/img][url=\"http:\/\/www.bestdestinationwedding.com\/index.php?app=core&amp;amp;module=attach&amp;amp;section=attach&amp;amp;attach_rel_module=post&amp;amp;attach_id=35005\"]20160201_194048.jpg[\/url]\n\n\n[b]Mint\/gold mercury large votive holders $8 for both[\/b]\n[img]http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif[\/img][url=\"http:\/\/www.bestdestinationwedding.com\/index.php?app=core&amp;amp;module=attach&amp;amp;section=attach&amp;amp;attach_rel_module=post&amp;amp;attach_id=35006\"]20160201_194134.jpg[\/url][img]http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif[\/img][url=\"http:\/\/www.bestdestinationwedding.com\/index.php?app=core&amp;amp;module=attach&amp;amp;section=attach&amp;amp;attach_rel_module=post&amp;amp;attach_id=35007\"]20160201_194139.jpg[\/url]\n\n[b]very light blue (almost clear) textured votive holders $8 for all three[\/b]\n[img]http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif[\/img][url=\"http:\/\/www.bestdestinationwedding.com\/index.php?app=core&amp;amp;module=attach&amp;amp;section=attach&amp;amp;attach_rel_module=post&amp;amp;attach_id=35008\"]20160201_194207.jpg[\/url][img]http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif[\/img][url=\"http:\/\/www.bestdestinationwedding.com\/index.php?app=core&amp;amp;module=attach&amp;amp;section=attach&amp;amp;attach_rel_module=post&amp;amp;attach_id=35009\"]20160201_194217.jpg[\/url]\n\n\n[b]Three silver glass textured votives $10 for all three[\/b]\n[img]http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif[\/img][url=\"http:\/\/www.bestdestinationwedding.com\/index.php?app=core&amp;amp;module=attach&amp;amp;section=attach&amp;amp;attach_rel_module=post&amp;amp;attach_id=35010\"]20160201_194819.jpg[\/url]\n\n\n[b]FRAMES $20 for the lot of 5 (or $15 for the white and teal and $6 for the three in the second photo)[\/b]\n[img]http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif[\/img][url=\"http:\/\/www.bestdestinationwedding.com\/index.php?app=core&amp;amp;module=attach&amp;amp;section=attach&amp;amp;attach_rel_module=post&amp;amp;attach_id=35012\"]20160201_193015.jpg[\/url][img]http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif[\/img][url=\"http:\/\/www.bestdestinationwedding.com\/index.php?app=core&amp;amp;module=attach&amp;amp;section=attach&amp;amp;attach_rel_module=post&amp;amp;attach_id=35013\"]20160201_194909.jpg[\/url]\n\n[b]Table numbers (spray painted gold with custom number print outs) $8 for all 4[\/b]\n[img]http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif[\/img][url=\"http:\/\/www.bestdestinationwedding.com\/index.php?app=core&amp;amp;module=attach&amp;amp;section=attach&amp;amp;attach_rel_module=post&amp;amp;attach_id=35014\"]20160201_193525.jpg[\/url]\n\n[b]Paper LED lanterns unopened 4 for $4 (these were great to use for rehearsal\/welcome dinners)[\/b]\n[img]http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif[\/img][url=\"http:\/\/www.bestdestinationwedding.com\/index.php?app=core&amp;amp;module=attach&amp;amp;section=attach&amp;amp;attach_rel_module=post&amp;amp;attach_id=35015\"]20160201_193233.jpg[\/url]\n\n[b]Wooden Chalkboard $10[\/b]\n[img]http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif[\/img][url=\"http:\/\/www.bestdestinationwedding.com\/index.php?app=core&amp;amp;module=attach&amp;amp;section=attach&amp;amp;attach_rel_module=post&amp;amp;attach_id=35016\"]20160201_192955.jpg[\/url]\n\n[b]Chalkboard Mr &amp;amp; Mrs chair signs $20[\/b]\n[img]http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif[\/img][url=\"http:\/\/www.bestdestinationwedding.com\/index.php?app=core&amp;amp;module=attach&amp;amp;section=attach&amp;amp;attach_rel_module=post&amp;amp;attach_id=35017\"]20160201_193127.jpg[\/url]\n\n\n[b]Black men&#039;s suspenders (ordered from Grunion Run - opened, but never worn) $10[\/b]\n[img]http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif[\/img][url=\"http:\/\/www.bestdestinationwedding.com\/index.php?app=core&amp;amp;module=attach&amp;amp;section=attach&amp;amp;attach_rel_module=post&amp;amp;attach_id=35018\"]20160201_193343.jpg[\/url]\n\n[b]38 tea lights - $20 (most of them weren&#039;t used at all. The one&#039;s that were used were only used for 6 hours)[\/b]\n[img]http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif[\/img][url=\"http:\/\/www.bestdestinationwedding.com\/index.php?app=core&amp;amp;module=attach&amp;amp;section=attach&amp;amp;attach_rel_module=post&amp;amp;attach_id=35019\"]20160201_193739.jpg[\/url]\n\n\n[b]1 blush taffeta table drape (rectangle) 90\" x 156\" - Professionally dry cleaned  $15[\/b]\n[img]http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif[\/img][url=\"http:\/\/www.bestdestinationwedding.com\/index.php?app=core&amp;amp;module=attach&amp;amp;section=attach&amp;amp;attach_rel_module=post&amp;amp;attach_id=35020\"]A86A4465.jpg[\/url]\n\n[b]3 blush taffeta tabe cloths (circular) 132\" - Professionally dry cleaned  $50 for all 3[\/b]\n[img]http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif[\/img][url=\"http:\/\/www.bestdestinationwedding.com\/index.php?app=core&amp;amp;module=attach&amp;amp;section=attach&amp;amp;attach_rel_module=post&amp;amp;attach_id=35021\"]20160201_192939.jpg[\/url][img]http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif[\/img][url=\"http:\/\/www.bestdestinationwedding.com\/index.php?app=core&amp;amp;module=attach&amp;amp;section=attach&amp;amp;attach_rel_module=post&amp;amp;attach_id=35022\"]A86A4469.jpg[\/url]\n\n[b]1 black and white striped table runner (used for head table) - professionally dry cleaned 16\" wide x 156\" long $15[\/b]\n[img]http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif[\/img][url=\"http:\/\/www.bestdestinationwedding.com\/index.php?app=core&amp;amp;module=attach&amp;amp;section=attach&amp;amp;attach_rel_module=post&amp;amp;attach_id=35023\"]HT8A4898.jpg[\/url]\n\n\n\n[b]Bride robe - Size M\/L - Never worn (tags still attached) $15[\/b]\n[img]http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif[\/img][url=\"http:\/\/www.bestdestinationwedding.com\/index.php?app=core&amp;amp;module=attach&amp;amp;section=attach&amp;amp;attach_rel_module=post&amp;amp;attach_id=35024\"]20150314_220120.jpg[\/url]\n\n\n\n[b]Gold Sequins bridal hanger - $10[\/b]\n[img]http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif[\/img][url=\"http:\/\/www.bestdestinationwedding.com\/index.php?app=core&amp;amp;module=attach&amp;amp;section=attach&amp;amp;attach_rel_module=post&amp;amp;attach_id=35025\"]20150602_155853.jpg[\/url][img]http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif[\/img][url=\"http:\/\/www.bestdestinationwedding.com\/index.php?app=core&amp;amp;module=attach&amp;amp;section=attach&amp;amp;attach_rel_module=post&amp;amp;attach_id=35026\"]20150602_155907.jpg[\/url]\n\n[b]Card box (Paris) $10 - around 20 &#039;advice for the bride and groom&#039; cards included[\/b]\n[img]http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif[\/img][url=\"http:\/\/www.bestdestinationwedding.com\/index.php?app=core&amp;amp;module=attach&amp;amp;section=attach&amp;amp;attach_rel_module=post&amp;amp;attach_id=35027\"]20160201_194623.jpg[\/url][img]http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif[\/img][url=\"http:\/\/www.bestdestinationwedding.com\/index.php?app=core&amp;amp;module=attach&amp;amp;section=attach&amp;amp;attach_rel_module=post&amp;amp;attach_id=35028\"]20160201_194645.jpg[\/url]\n\n[b]7 packs of straws (each has 20 straws in it) -$15[\/b]\n[img]http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif[\/img][url=\"http:\/\/www.bestdestinationwedding.com\/index.php?app=core&amp;amp;module=attach&amp;amp;section=attach&amp;amp;attach_rel_module=post&amp;amp;attach_id=35029\"]20160201_193452.jpg[\/url]\n\n\n[b]One layer tulle Ivory veil with a satin edge finish - Never worn $15 [\/b]\n[b]White Single Tier 54\" Width 38\" Length Satin Ribbon Edge[\/b]\n[img]http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif[\/img][url=\"http:\/\/www.bestdestinationwedding.com\/index.php?app=core&amp;amp;module=attach&amp;amp;section=attach&amp;amp;attach_rel_module=post&amp;amp;attach_id=35033\"]il_570xN.384238344_b2wv.jpg[\/url]\n\n\n\n\n[b]Flower crown - Custom made with silk florals off of Etsy (worn once for bachelorette)- $20[\/b]\n[img]http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif[\/img][url=\"http:\/\/www.bestdestinationwedding.com\/index.php?app=core&amp;amp;module=attach&amp;amp;section=attach&amp;amp;attach_rel_module=post&amp;amp;attach_id=35031\"]20160201_193045.jpg[\/url][img]http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif[\/img][url=\"http:\/\/www.bestdestinationwedding.com\/index.php?app=core&amp;amp;module=attach&amp;amp;section=attach&amp;amp;attach_rel_module=post&amp;amp;attach_id=35032\"]flower crown.jpg[\/url][\/quote]Congrats @[member=\"pjay\"],\n\nI wanted to know if your frames, wood chalkboard, led lights, and table frames were still available.\n\nThanks,\nJ","Attachments":[],"Id":1914866,"PostDate":1468497877,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>pjay, on 01 February 2016 - 10:15 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hello brides!<\/p>\n<p>\u00a0<\/p>\n<p>It's been almost two months now and i've finally had a chance to sort through all of my wedding items.<\/p>\n<p>\u00a0<\/p>\n<p>I've got quite a bit that i'm looking to sell and was hoping to sell some of the more breakable items locally (GTA area) if possible.<\/p>\n<p>I am willing to ship at the cost of the buyer.<\/p>\n<p>\u00a0<\/p>\n<p>I may have some leftover items for OOT bags as well, but I haven't unpacked those just yet.<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><strong>12 gold mercury glass votive holders $15<\/strong><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif\" alt=\"attachicon.gif\"><\/span><a href='http:\/\/www.bestdestinationwedding.com\/index.php?app=core&module=attach&section=attach&attach_rel_module=post&attach_id=35003' class='bbc_url' title=''>Facetune-201502081035077640.jpg<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><strong>Three large mason jars - Painted and distressed $10 (gray and mint)<\/strong><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif\" alt=\"attachicon.gif\"><\/span><a href='http:\/\/www.bestdestinationwedding.com\/index.php?app=core&module=attach&section=attach&attach_rel_module=post&attach_id=35004' class='bbc_url' title=''>20160201_193105.jpg<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><strong>'hob nob' textured vases - One white mason and two clear glass. $15 for all three<\/strong><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif\" alt=\"attachicon.gif\"><\/span><a href='http:\/\/www.bestdestinationwedding.com\/index.php?app=core&module=attach&section=attach&attach_rel_module=post&attach_id=35005' class='bbc_url' title=''>20160201_194048.jpg<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><strong>Mint\/gold mercury large votive holders $8 for both<\/strong><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif\" alt=\"attachicon.gif\"><\/span><a href='http:\/\/www.bestdestinationwedding.com\/index.php?app=core&module=attach&section=attach&attach_rel_module=post&attach_id=35006' class='bbc_url' title=''>20160201_194134.jpg<\/a><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif\" alt=\"attachicon.gif\"><\/span><a href='http:\/\/www.bestdestinationwedding.com\/index.php?app=core&module=attach&section=attach&attach_rel_module=post&attach_id=35007' class='bbc_url' title=''>20160201_194139.jpg<\/a><\/p>\n<p>\u00a0<\/p>\n<p><strong>very light blue (almost clear) textured votive holders $8 for all three<\/strong><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif\" alt=\"attachicon.gif\"><\/span><a href='http:\/\/www.bestdestinationwedding.com\/index.php?app=core&module=attach&section=attach&attach_rel_module=post&attach_id=35008' class='bbc_url' title=''>20160201_194207.jpg<\/a><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif\" alt=\"attachicon.gif\"><\/span><a href='http:\/\/www.bestdestinationwedding.com\/index.php?app=core&module=attach&section=attach&attach_rel_module=post&attach_id=35009' class='bbc_url' title=''>20160201_194217.jpg<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><strong>Three silver glass textured votives $10 for all three<\/strong><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif\" alt=\"attachicon.gif\"><\/span><a href='http:\/\/www.bestdestinationwedding.com\/index.php?app=core&module=attach&section=attach&attach_rel_module=post&attach_id=35010' class='bbc_url' title=''>20160201_194819.jpg<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><strong>FRAMES $20 for the lot of 5 (or $15 for the white and teal and $6 for the three in the second photo)<\/strong><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif\" alt=\"attachicon.gif\"><\/span><a href='http:\/\/www.bestdestinationwedding.com\/index.php?app=core&module=attach&section=attach&attach_rel_module=post&attach_id=35012' class='bbc_url' title=''>20160201_193015.jpg<\/a><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif\" alt=\"attachicon.gif\"><\/span><a href='http:\/\/www.bestdestinationwedding.com\/index.php?app=core&module=attach&section=attach&attach_rel_module=post&attach_id=35013' class='bbc_url' title=''>20160201_194909.jpg<\/a><\/p>\n<p>\u00a0<\/p>\n<p><strong>Table numbers (spray painted gold with custom number print outs) $8 for all 4<\/strong><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif\" alt=\"attachicon.gif\"><\/span><a href='http:\/\/www.bestdestinationwedding.com\/index.php?app=core&module=attach&section=attach&attach_rel_module=post&attach_id=35014' class='bbc_url' title=''>20160201_193525.jpg<\/a><\/p>\n<p>\u00a0<\/p>\n<p><strong>Paper LED lanterns unopened 4 for $4 (these were great to use for rehearsal\/welcome dinners)<\/strong><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif\" alt=\"attachicon.gif\"><\/span><a href='http:\/\/www.bestdestinationwedding.com\/index.php?app=core&module=attach&section=attach&attach_rel_module=post&attach_id=35015' class='bbc_url' title=''>20160201_193233.jpg<\/a><\/p>\n<p>\u00a0<\/p>\n<p><strong>Wooden Chalkboard $10<\/strong><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif\" alt=\"attachicon.gif\"><\/span><a href='http:\/\/www.bestdestinationwedding.com\/index.php?app=core&module=attach&section=attach&attach_rel_module=post&attach_id=35016' class='bbc_url' title=''>20160201_192955.jpg<\/a><\/p>\n<p>\u00a0<\/p>\n<p><strong>Chalkboard Mr & Mrs chair signs $20<\/strong><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif\" alt=\"attachicon.gif\"><\/span><a href='http:\/\/www.bestdestinationwedding.com\/index.php?app=core&module=attach&section=attach&attach_rel_module=post&attach_id=35017' class='bbc_url' title=''>20160201_193127.jpg<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><strong>Black men's suspenders (ordered from Grunion Run - opened, but never worn) $10<\/strong><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif\" alt=\"attachicon.gif\"><\/span><a href='http:\/\/www.bestdestinationwedding.com\/index.php?app=core&module=attach&section=attach&attach_rel_module=post&attach_id=35018' class='bbc_url' title=''>20160201_193343.jpg<\/a><\/p>\n<p>\u00a0<\/p>\n<p><strong>38 tea lights - $20 (most of them weren't used at all. The one's that were used were only used for 6 hours)<\/strong><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif\" alt=\"attachicon.gif\"><\/span><a href='http:\/\/www.bestdestinationwedding.com\/index.php?app=core&module=attach&section=attach&attach_rel_module=post&attach_id=35019' class='bbc_url' title=''>20160201_193739.jpg<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><strong>1 blush taffeta table drape (rectangle) 90\" x 156\" - Professionally dry cleaned \u00a0$15<\/strong><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif\" alt=\"attachicon.gif\"><\/span><a href='http:\/\/www.bestdestinationwedding.com\/index.php?app=core&module=attach&section=attach&attach_rel_module=post&attach_id=35020' class='bbc_url' title=''>A86A4465.jpg<\/a><\/p>\n<p>\u00a0<\/p>\n<p><strong>3 blush taffeta tabe cloths (circular) 132\" - Professionally dry cleaned \u00a0$50 for all 3<\/strong><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif\" alt=\"attachicon.gif\"><\/span><a href='http:\/\/www.bestdestinationwedding.com\/index.php?app=core&module=attach&section=attach&attach_rel_module=post&attach_id=35021' class='bbc_url' title=''>20160201_192939.jpg<\/a><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif\" alt=\"attachicon.gif\"><\/span><a href='http:\/\/www.bestdestinationwedding.com\/index.php?app=core&module=attach&section=attach&attach_rel_module=post&attach_id=35022' class='bbc_url' title=''>A86A4469.jpg<\/a><\/p>\n<p>\u00a0<\/p>\n<p><strong>1 black and white striped table runner (used for head table) - professionally dry cleaned 16\" wide x 156\" long $15<\/strong><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif\" alt=\"attachicon.gif\"><\/span><a href='http:\/\/www.bestdestinationwedding.com\/index.php?app=core&module=attach&section=attach&attach_rel_module=post&attach_id=35023' class='bbc_url' title=''>HT8A4898.jpg<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><strong>Bride robe - Size M\/L - Never worn (tags still attached) $15<\/strong><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif\" alt=\"attachicon.gif\"><\/span><a href='http:\/\/www.bestdestinationwedding.com\/index.php?app=core&module=attach&section=attach&attach_rel_module=post&attach_id=35024' class='bbc_url' title=''>20150314_220120.jpg<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><strong>Gold Sequins bridal hanger - $10<\/strong><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif\" alt=\"attachicon.gif\"><\/span><a href='http:\/\/www.bestdestinationwedding.com\/index.php?app=core&module=attach&section=attach&attach_rel_module=post&attach_id=35025' class='bbc_url' title=''>20150602_155853.jpg<\/a><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif\" alt=\"attachicon.gif\"><\/span><a href='http:\/\/www.bestdestinationwedding.com\/index.php?app=core&module=attach&section=attach&attach_rel_module=post&attach_id=35026' class='bbc_url' title=''>20150602_155907.jpg<\/a><\/p>\n<p>\u00a0<\/p>\n<p><strong>Card box (Paris) $10 - around 20 'advice for the bride and groom' cards included<\/strong><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif\" alt=\"attachicon.gif\"><\/span><a href='http:\/\/www.bestdestinationwedding.com\/index.php?app=core&module=attach&section=attach&attach_rel_module=post&attach_id=35027' class='bbc_url' title=''>20160201_194623.jpg<\/a><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif\" alt=\"attachicon.gif\"><\/span><a href='http:\/\/www.bestdestinationwedding.com\/index.php?app=core&module=attach&section=attach&attach_rel_module=post&attach_id=35028' class='bbc_url' title=''>20160201_194645.jpg<\/a><\/p>\n<p>\u00a0<\/p>\n<p><strong>7 packs of straws (each has 20 straws in it) -$15<\/strong><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif\" alt=\"attachicon.gif\"><\/span><a href='http:\/\/www.bestdestinationwedding.com\/index.php?app=core&module=attach&section=attach&attach_rel_module=post&attach_id=35029' class='bbc_url' title=''>20160201_193452.jpg<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><strong>One layer tulle Ivory veil with a satin edge finish - Never worn $15 <\/strong><\/p>\n<p><strong><span  style=\"margin:0px\">White Single Tier 54\" Width 38\" Length Satin Ribbon Edge<\/span><\/strong><\/p>\n<p><span  style=\"margin:0px\"><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif\" alt=\"attachicon.gif\"><\/span><a href='http:\/\/www.bestdestinationwedding.com\/index.php?app=core&module=attach&section=attach&attach_rel_module=post&attach_id=35033' class='bbc_url' title=''>il_570xN.384238344_b2wv.jpg<\/a><\/span><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p