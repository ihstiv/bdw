{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cae1b293865dcefd93dd09f5fa373037","RawContent":"&lt;p&gt; Hey Ladies,&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; a friend of mine is going to GBPJ on November 26th (not for a wedding just a vacation). I&#039;d asked her to take lots of pictures and to tell me about her stay there. I&#039;ll share those pics and her impressions on this thread as Lsmith211 said to me; we never get tired of seeing pictures and talking about that place!&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; She&#039;ll be back beginning of December!&lt;\/p&gt; &lt;p&gt; More to come...&lt;\/p&gt;","Attachments":[],"Id":1340707,"PostDate":1289921839,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hey Ladies,<\/p> <p> \u00a0<\/p> <p> a friend of mine is going to GBPJ on November 26th (not for a wedding just a vacation). I'd asked her to take lots of pictures and to tell me about her stay there. I'll share those pics and her impressions on this thread as Lsmith211 said to me; we never get tired of seeing pictures and talking about that place!<\/p> <p> \u00a0<\/p> <p> She'll be back beginning of December!<\/p> <p> More to come...<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"stefanichayer@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1287873579,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-233439.JPG?_r=0","PhotoWidth":200,"PhotoHeight":149,"PhotoType":"custom"},"FormattedName":"schayer","Id":233439,"Name":"schayer","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8a6af27b2bafbd1d19b88e49ca614dd3","RawContent":"&lt;p&gt; I booked my BM&#039;s hair along with mine yesterday, they got back to me super fast too! I am in the same boat as everyone else. I know you pick your flowers, cake etc when you meet with her the first day or two when you get there...it seems like everything happens then so I am not worrying about it. The only thing I would like to know beofre is the menu so I can make them with vistaprint before we go down...but Ill worry about that in like March...haha&lt;\/p&gt;","Attachments":[],"Id":1340898,"PostDate":1289934250,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I booked my BM's hair along with mine yesterday, they got back to me super fast too! I am in the same boat as everyone else. I know you pick your flowers, cake etc when you meet with her the first day or two when you get there...it seems like everything happens then so I am not worrying about it. The only thing I would like to know beofre is the menu so I can make them with vistaprint before we go down...but Ill worry about that in like March...haha<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Today I marry my bestfriend, the one I laugh with, the one I love.<\/span><\/div><\/div>","Email":"kfairful@alumni.uoguelph.ca","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1272162450,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-227617.jpg?_r=0","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"katelynn","Id":227617,"Name":"katelynn","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c50809e4ffa9db537fc61feb5ce18923","RawContent":"&lt;p&gt; Hi Ladies!&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I am new at this but getting married at the end of May 2011, and wondering&amp;nbsp;how you guys are getting the free wedding package??&amp;nbsp; I have over 40 people booked plus us and i wasn&#039;t told anything about a free package.&amp;nbsp; Anyone?&amp;nbsp; Thanks!!&lt;\/p&gt;","Attachments":[],"Id":1341241,"PostDate":1289945582,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hi Ladies!<\/p> <p> \u00a0<\/p> <p> I am new at this but getting married at the end of May 2011, and wondering\u00a0how you guys are getting the free wedding package??\u00a0 I have over 40 people booked plus us and i wasn't told anything about a free package.\u00a0 Anyone?\u00a0 Thanks!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"keristonge@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1289945054,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-233998.jpg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"keriltz","Id":233998,"Name":"keriltz","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"eaad089f2f03dbebfbe24ca8b86b0def","RawContent":"&lt;p&gt; Hi Ladies!&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I am new at this but getting married in May 2011.&amp;nbsp; Just reading through all the posts, how are people getting free wedding packages?&amp;nbsp; We have 40+ people booked and haven&#039;t been told anything about a free wedding package.&amp;nbsp; Anyone?&amp;nbsp; Thanks!!&lt;\/p&gt;","Attachments":[],"Id":1341247,"PostDate":1289945847,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hi Ladies!<\/p> <p> \u00a0<\/p> <p> I am new at this but getting married in May 2011.\u00a0 Just reading through all the posts, how are people getting free wedding packages?\u00a0 We have 40+ people booked and haven't been told anything about a free wedding package.\u00a0 Anyone?\u00a0 Thanks!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"keristonge@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1289945054,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-233998.jpg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"keriltz","Id":233998,"Name":"keriltz","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cacc6d9273376c0eed8f1e6f2486f4c7","RawContent":"Kool :) I kno I can pick stuff when I get there but I like to know ahead of time. I like to be in the know I guess..","Attachments":[],"Id":1341254,"PostDate":1289946229,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Kool <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> I kno I can pick stuff when I get there but I like to know ahead of time. I like to be in the know I guess..\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"blondyriley@aim.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1282785574,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-231747.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"ChrisBC25","Id":231747,"Name":"ChrisBC25","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8d69e89212c8fd6af2c5edeaac4353d0","RawContent":"Congrats Keriltz! \n I&#039;m going with the free package as well. Have you booked your wedding with Beverly. When i did you sent me a document listing all wedding packages and a form to submit after I booked my rooms and made my choice. One thing about the free package is after 16 people, its $25 for any extra additional people. But still will be cheaper than any other packages.\n \n   [quote]\nOriginally Posted by [b]keriltz[\/b] \/img\/forum\/go_quote.gif\n \n \n Hi Ladies! \n \n I am new at this but getting married in May 2011.  Just reading through all the posts, how are people getting free wedding packages?  We have 40+ people booked and haven&#039;t been told anything about a free wedding package.  Anyone?  Thanks!![\/quote]","Attachments":[],"Id":1341739,"PostDate":1290004185,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Congrats Keriltz!<\/p> <p> I'm going with the free package as well. Have you booked your wedding with Beverly. When i did you sent me a document listing all wedding packages and a form to submit\u00a0after\u00a0I booked my rooms and made my choice. One thing about\u00a0the free package is after 16 people, its $25 for any extra additional people. But still will be cheaper than any other packages.<br \/> <br \/> \u00a0<\/p> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>keriltz<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" style=\"border-right: 0px solid; border-top: 0px solid; border-left: 0px solid; border-bottom: 0px solid\" \/><\/span><br \/> <br \/> <p> Hi Ladies!<\/p> <p> \u00a0<\/p> <p> I am new at this but getting married in May 2011.\u00a0 Just reading through all the posts, how are people getting free wedding packages?\u00a0 We have 40+ people booked and haven't been told anything about a free wedding package.\u00a0 Anyone?\u00a0 Thanks!!<\/p> <\/blockquote> <br \/> <br \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"stefanichayer@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1287873579,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-233439.JPG?_r=0","PhotoWidth":200,"PhotoHeight":149,"PhotoType":"custom"},"FormattedName":"schayer","Id":233439,"Name":"schayer","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"805f153f60f685287dd2c92ff8bbfe0a","RawContent":"&lt;p&gt; No they never said anything about the free package to me, that&#039;s why i am curious about it.&amp;nbsp; I am going with the lowest one which doesn&#039;t really come with anything and still have to pay the $25 per person after 16 but i have to pay a base price of $700, i don&#039;t think i am getting a good deal here! Haha&amp;nbsp; I have already booked with Beverly months ago and just yesterday emailed about the free package and see what they say.&amp;nbsp; My FI and i are legally getting married in Canada then doing the ceremony down there so we won&#039;t have to may any fees for the legal stuff.&lt;\/p&gt;","Attachments":[],"Id":1341812,"PostDate":1290011292,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> No they never said anything about the free package to me, that's why i am curious about it.\u00a0 I am going with the lowest one which doesn't really come with anything and still have to pay the $25 per person after 16 but i have to pay a base price of $700, i don't think i am getting a good deal here! Haha\u00a0 I have already booked with Beverly months ago and just yesterday emailed about the free package and see what they say.\u00a0 My FI and i are legally getting married in Canada then doing the ceremony down there so we won't have to may any fees for the legal stuff.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"keristonge@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1289945054,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-233998.jpg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"keriltz","Id":233998,"Name":"keriltz","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a1ba195a1785213057a02dfdcc06c178","RawContent":"&lt;p&gt; i am from atlantic canada and we booked with air transat in October and we were not offered any free wedding. I would also like to know how people got this. I am thinking that it was offered last year and this summer and they must have discontinued this ?!&lt;\/p&gt;","Attachments":[],"Id":1341879,"PostDate":1290014322,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> i am from atlantic canada and we booked with air transat in October and we were not offered any free wedding. I would also like to know how people got this. I am thinking that it was offered last year and this summer and they must have discontinued this ?!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tmmartell@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1284229239,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232240.JPG?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"TMwedding2011","Id":232240,"Name":"TMwedding2011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0febdfc852a7c825032be8d7d24dbd89","RawContent":"&lt;p&gt; Hey, just a question to throw out there. Anyone actually getting emails from Beverly lately?&lt;\/p&gt; &lt;p&gt; The last email I got from her was over a month ago and I&#039;ve sent her two since then...&lt;\/p&gt;","Attachments":[],"Id":1342012,"PostDate":1290020525,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hey, just a question to throw out there. Anyone actually getting emails from Beverly lately?<\/p> <p> The last email I got from her was over a month ago and I've sent her two since then...<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Married my best friend 04\/28\/11 at the Gran Bahia Principe Runaway Bay<\/span><\/div><\/div>","Email":"trista.lundquist@gmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1273793347,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-228171.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"tris","Id":228171,"Name":"tris","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e754aa54f531720456fca9159f7eb8b8","RawContent":"&lt;p&gt; I emailed her last week and she sent it to her assistant and she replied to me.&amp;nbsp; This time i emailed her assistant directly.&lt;\/p&gt;","Attachments":[],"Id":1342027,"PostDate":1290021253,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I emailed her last week and she sent it to her assistant and she replied to me.\u00a0 This time i emailed her assistant directly.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"keristonge@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1289945054,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-233998.jpg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"keriltz","Id":233998,"Name":"keriltz","IsOnline":false}}],"Pages":{"TotalItems":5564,"TotalPages":557,"CurrentPage":440,"NextPage":450,"PreviousPage":430,"LastPage":5560},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
