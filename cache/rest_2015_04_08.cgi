edName":"m8chow","Id":266988,"Name":"m8chow","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":71,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bd9b6541e4a7e3d29c0cc2a4075cdb4f","RawContent":"@m8chow thank you very much,, I really enjoyed every minute of our week in Punta Cana,,&amp; our wedding!!;)) Happy planning!!","Attachments":[],"Id":1818237,"PostDate":1386141577,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @m8chow thank you very much,, I really enjoyed every minute of our week in Punta Cana,,& our wedding!!<img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/>) Happy planning!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"BERRYANDNACHOSWEDDING2013@GMAIL.COM","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1365495120,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268351.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"OCT 2013 BR","Id":268351,"Name":"OCT 2013 BR","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.161.176.182","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":71,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"399e55973634c667077c076dbbe80835","RawContent":"&lt;p&gt;Finally got my dress and could finally try it on! And OMG it&#039;s sooo much more than I imagined not having put it on before purchasing! &amp;nbsp;And I got a second much cheaper dress for TTD because I really don&#039;t even want my original ruined at all&lt;\/p&gt;","Attachments":[],"Id":1821050,"PostDate":1388397188,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Finally got my dress and could finally try it on! And OMG it's sooo much more than I imagined not having put it on before purchasing! \u00a0And I got a second much cheaper dress for TTD because I really don't even want my original ruined at all<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"landry.janelle3@gmail.com","IpAddress":"207.161.176.182","GroupId":39,"GroupName":"Newbie","JoinDate":1365166899,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268229.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Janelle0308","Id":268229,"Name":"Janelle0308","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"122.176.166.194","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":71,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"48589d103ef2b0d8e99d2ba5a2bf894c","RawContent":"[quote name=\"Jennifer\" post=\"127\" timestamp=\"1158011111\"]\nThis is what I wore. I bought it in a very pale blue but apprently it is not in that color anymore. I got it at David&#039;s Bridal for $150.\n\n\n[img]http:\/\/www.davidsbridal.com\/images\/fashions\/full\/s06_F1286_bluevelvettanzanite.jpg[\/img][\/quote]Nice Very nice, Simple and beautiful.","Attachments":[],"Id":1821849,"PostDate":1388702225,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Jennifer, on 11 September 2006 - 02:45 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>This is what I wore. I bought it in a very pale blue but apprently it is not in that color anymore. I got it at David's Bridal for $150.<br><br><br><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/www.davidsbridal.com\/images\/fashions\/full\/s06_F1286_bluevelvettanzanite.jpg\" alt=\"s06_F1286_bluevelvettanzanite.jpg\"><\/span><\/p>\n<\/div>\n<\/div><\/div>\n<p>Nice Very nice, Simple and beautiful.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><strong><a data-ipb='nomediaparse' href='http:\/\/www.dreamweddingshawaii.com\/'>Wedding in Hawaii<\/a><\/strong>","Email":"stewartharry779@gmail.com","IpAddress":"122.176.166.194","GroupId":39,"GroupName":"Newbie","JoinDate":1388701891,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"johansmith","Id":275854,"Name":"johansmith","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.35.146.149","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":71,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0e1f2ad46ffee296d4ecf9a3b59d12a8","RawContent":"[quote name=\"AllieH\" post=\"1791308\" timestamp=\"1376497042\"]\nWITH! It looks gorgeous on you both ways, but the bling really adds to the dress, accents your figure and the lines of the dress itself.[\/quote]\nBling it out!","Attachments":[],"Id":1824951,"PostDate":1389380470,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>AllieH, on 14 August 2013 - 09:17 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>WITH! It looks gorgeous on you both ways, but the bling really adds to the dress, accents your figure and the lines of the dress itself.<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>Bling it out!\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"heather_smith@live.ca","IpAddress":"173.35.146.149","GroupId":40,"GroupName":"Jr. Member","JoinDate":1389257763,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275964.jpg?_r=1390332015","PhotoWidth":180,"PhotoHeight":135,"PhotoType":"facebook"},"FormattedName":"HEZZA","Id":275964,"Name":"HEZZA","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"162.157.142.135","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":71,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d7e280f50484f7ddf30b91a16ecdecd5","RawContent":"I have a Mori Lee dress ordered and can&#039;t wait to get it!","Attachments":[],"Id":1826109,"PostDate":1389738986,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I have a Mori Lee dress ordered and can't wait to get it!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kdnolan@hotmail.com","IpAddress":"137.186.69.243","GroupId":40,"GroupName":"Jr. Member","JoinDate":1366569442,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268830.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"kdnolan","Id":268830,"Name":"kdnolan","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"182.180.187.47","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":71,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"176346e59b76814b829479fcdd07a7c2","RawContent":"&lt;p&gt;the bridesmaids dress looking great&amp;nbsp; i love that....&lt;\/p&gt;","Attachments":[],"Id":1826133,"PostDate":1389756580,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"tex