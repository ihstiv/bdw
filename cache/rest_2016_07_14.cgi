{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5ab6ab2213ddee65d44b941166c44b32","RawContent":"Just wanted to mention, that i heard from a girl who just got married at GBP, and she used the hotel photographer and she said they weren&#039;t that good. she said she wished people had taken more photos on their personal cameras cause the ones she got from the hotel photog weren&#039;t good. Just a heads up incase anyone is planning on using them. we get 10 free photos with our Free Package, we&#039;ll take them cause they are free. lol","Attachments":[],"Id":1048215,"PostDate":1266985582,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Just wanted to mention, that i heard from a girl who just got married at GBP, and she used the hotel photographer and she said they weren't that good. she said she wished people had taken more photos on their personal cameras cause the ones she got from the hotel photog weren't good. Just a heads up incase anyone is planning on using them. we get 10 free photos with our Free Package, we'll take them cause they are free. lol\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/global.thebump.com\/tickers\/tt7a388.aspx\">http:\/\/global.thebump.com\/tickers\/tt7a388.aspx<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/i964.photobucket.com\/albums\/ae129\/mccrady\/gartrepic.jpg\">http:\/\/i964.photobucket.com\/albums\/a...\/gartrepic.jpg<\/a><\/div><\/div>","Email":"kerrij@shaw.ca","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1250884128,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-220796.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"kerrij","Id":220796,"Name":"kerrij","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":false,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b7c6d853e088fb6d3404e0b9b235647b","RawContent":"thank you for the information kerrij...","Attachments":[],"Id":1049455,"PostDate":1267059799,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                thank you for the information kerrij...\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"chrissik82@googlemail.com","IpAddress":"","GroupId":5,"GroupName":"Banned","JoinDate":1260680287,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223885.PNG?_r=0","PhotoWidth":150,"PhotoHeight":87,"PhotoType":"custom"},"FormattedName":"christinak82","Id":223885,"Name":"christinak82","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e81576d73989e719c752eba2a691d89e","RawContent":"Hi girls!!!\n \n I really appreciate all the information you are posting on here ...... I have been researching hotels for what seems like forever and after reading all your posts I am 95% sure I will choose the GBP for my wedding in January 2011!!!!\n \n Keep the information coming :)\n I will let you know if I come across any helpful information as well \n \n Brie","Attachments":[],"Id":1050272,"PostDate":1267083140,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi girls!!!<br \/> <br \/> I really appreciate all the information you are posting on here ...... I have been researching hotels for what seems like forever and after reading all your posts I am 95% sure I will choose the GBP for my wedding in January 2011!!!!<br \/> <br \/> Keep the information coming <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br \/> I will let you know if I come across any helpful information as well <br \/> <br \/> Brie\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>BRIE<\/span><\/div><\/div>","Email":"brie.pietrobon@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1262067914,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-224151.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"BrieP","Id":224151,"Name":"BrieP","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"353e37634e0cf61c9d054c0e68d11988","RawContent":"Hey,\n \n Thanks for the info. on the photographer. I had emailed Beverly to ask if the photographer has a website or samples, but she did not respond.....","Attachments":[],"Id":1051926,"PostDate":1267168873,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hey,<br \/> <br \/> Thanks for the info. on the photographer. I had emailed Beverly to ask if the photographer has a website or samples, but she did not respond.....\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lchayim@rogers.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1265621673,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-225422.JPG?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"StephAli","Id":225422,"Name":"StephAli","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"17601c5ee3acaeca05bf8918eba21b5d","RawContent":"I&#039;m baaaack!!! OMG girls, if you even second guess the GBP even once, DON&amp;quot;T!! it was the BEST resort to get married at. the gazebo is sooooo private and sooo beautiful. and you feel special because there aren&#039;t 2-3 weddings a day there. i think there were only 2 other weddings our entire week...and the 2 other girls were both named Kerri too! funny! we felt special and everyone on the resort knew our group...which wasn&#039;t hard as there were 50 of us who all became the bestest of friends and made so many friends aroudn the resort. \n the hotel was soooo great, the food was awesome, service...umm, pretty much no one had complaints, that i heard anyway, but i thought felt the nice ones were super, and the not so nice ones were crap and felt like you were annoying them...it was one way or the other, but i also found that everywhere in jamaica, even at our second resort, so i wouldn&#039;t take that to heart for this resort.\n Beverly is FANTASTIC!!! seriously, don&#039;t worry about a thing until you get there. she&#039;ll go over everything with you and plan the whole wedding in about 15 mins...she&#039;ll even do a rehearsal with you, which i HIGHLY recommend. i thought we didn&#039;t need to bother and just a waste of time, but was soooo gald we did it. everything was amazing and every single person cried at one point of the night.\n I would write your own script too, i hated what the Rev had so we rewrote ours and it was soooo special.\n the spa...gail, is a total cow! she was rude to everyone, and told the hair stylist to be there by 9am, nd their drive was 1 1\/2 hrs to work, and our appt was at 10:30 and my MIL got in trouble for being late! i had confirmed the appt time the day prior even for 10:30. the stylists were OK. i hated my hair but didn&#039;t care enough to fix it, my moms hair was AWFUL!! i even said, nooo that isn&#039;t finished! she had to go back and redo her hair. the stylists don&#039;t really listen to what you say, they know best! or so they think. i asked not to have a huge mass of hairspray in my hair when done, becuase my BM before me did and it looked sick! (i also saw the bride before me and i hated her hair too!) she said no you need it, and i said no i want it to look natural not all glued together, and she wouldn&#039;t listen and glued my hair together. my MOH was the only one with good hair. also i gave her hair inspiration pics, and it didn&#039;t look like what i wanted &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/sad.gif\" border=\"0\" alt=\"\" title=\"Sad\" class=\"inlineimg\" \/&gt; i had them do my make up and it was nice, but the mascara was terrible and she refused to put on false eyelashes.\n our wedding time was at 3:30 and it was soooo rushed with pics between the ceremony and dinner at 6:30...i&#039;d say 2pm would be ideal!\n Hihgly recommend the steel drum band...$400 for 4 of them and they have a sound system so you can hear it well...amazing touch!\n we also hired the DJ and bar for the dance, but we got jipped because we had it the night of the beach party and the DJ does it, so he had to leave at 10:30 instead of 11pm. but it was soooooo fun! the gazebo dance floor was backed the entire time! and a great spot for garter and bouquet toss!\n the hotel photographer....do not use!!! he was there, somewhere. my hubby saw him but i didn&#039;t even once! we got 10 free photos which i still haven&#039;t seen or had contact from him. but apparently his camera was not a fancy one like a photographer should have. just like a Canon SLR or something. i&#039;d def hire outside the resort!\n the dinner we had at Dolce Vita by the beach, it was PERFECT! a room all to ourselves, great for speeches and toasts. loved it!\n Hmmm, not sure what else there is to cover! any questions, just let me know!!","Attachments":[],"Id":1084525,"PostDate":1269284830,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm baaaack!!! OMG girls, if you even second guess the GBP even once, DON\"T!! it was the BEST resort to get married at. the gazebo is sooooo private and sooo beautiful. and you feel special because there aren't 2-3 weddings a day there. i think there were only 2 other weddings our entire week...and the 2 other girls were both named Kerri too! funny! we felt special and everyone on the resort knew our group...which wasn't hard as there were 50 of us who all became the bestest of friends and made so many friends aroudn the resort. <br \/> the hotel was soooo great, the food was awesome, service...umm, pretty much no one had complaints, that i heard anyway, but i thought felt the nice ones were super, and the not so nice ones were crap and felt like you were annoying them...it was one way or the other, but i also found that everywhere in jamaica, even at our second resort, so i wouldn't take that to heart for this resort.<br \/> Beverly is FANTASTIC!!! seriously, don't worry about a thing until you get there. she'll go over everything with you and plan the whole wedding in about 15 mins...she'll even do a rehearsal with you, which i HIGHLY recommend. i thought we didn't need to bother and just a waste of time, but was soooo gald we did it. everything was amazing and every single person cried at one point of the night.<br \/> I would write your own script too, i hated what the Rev had so we rewrote ours and it was soooo special.<br \/> the spa...gail, is a total cow! she was rude to everyone, and told the hair stylist to be there by 9am, nd their drive was 1 1\/2 hrs to work, and our appt was at 10:30 and my MIL got in trouble for being late! i had confirmed the appt time the day prior even for 10:30. the stylists were OK. i hated my hair but didn't care enough to fix it, my moms hair was AWFUL!! i even said, nooo that isn't finished! she had to go back and redo her hair. the stylists don't really listen to what you say, they know best! or so they think. i asked not to have a huge mass of hairspray in my hair when done, becuase my BM before me did and it looked sick! (i also saw the bride before me and i hated her hair too!) she said no you need it, and i said no i want it to look natural not all glued together, and she wouldn't listen and glued my hair together. my MOH was the only one with good hair. also i gave her hair inspiration pics, and it didn't look like what i wanted <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/sad.gif\" border=\"0\" alt=\"\" title=\"Sad\" class=\"inlineimg\" \/><\/span> i had them do my make up and it was nice, but the mascara was terrible and she refused to put on false eyelashes.<br \/> our wedding time was at 3:30 and it was soooo rushed with pics between the ceremony and dinner at 6:30...i'd say 2pm would be ideal!<br \/> Hihgly recommend the steel drum band...$400 for 4 of them and they have a sound system so you can hear it well...amazing touch!<br \/> we also hired the DJ and bar for the dance, but we got jipped because we had it the night of the beach party and the DJ does it, so he had to leave at 10:30 instead of 11pm. but it was soooooo fun! the gazebo dance floor was backed the entire time! and a great spot for garter and bouquet toss!<br \/> the hotel photographer....do not use!!! he was there, somewhere. my hubby saw him but i didn't even once! we got 10 free photos which i still haven't seen or had contact from him. but apparently his camera was not a fancy one like a photographer should have. just like a Canon SLR or something. i'd def hire outside the resort!<br \/> the dinner we had at Dolce Vita by the beach, it was PERFECT! a room all to ourselves, great for speeches and toasts. loved it!<br \/> Hmmm, not sure what else there is to cover! any questions, just let me know!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/global.thebump.com\/tickers\/tt7a388.aspx\">http:\/\/global.thebump.com\/tickers\/tt7a388.aspx<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/i964.photobucket.com\/albums\/ae129\/mccrady\/gartrepic.jpg\">http:\/\/i964.photobucket.com\/albums\/a...\/gartrepic.jpg<\/a><\/div><\/div>","Email":"kerrij@shaw.ca","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1250884128,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-220796.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"kerrij","Id":220796,"Name":"kerrij","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":false,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"dfa02aeab483b94f787b8f193f3a69ea","RawContent":"hi kerrij, \n \n thank you so much for sharing your experience with us... it\u00b4s great to hear that you loved the resort and your wedding... the spa experience doesn\u00b4t sound that great though... I have something very specific in mind with my hair, so I think I am gonna flip out if she won\u00b4t listen to what I want, hihi... \n you said they have beach parties at the resort, is it a special day or do those parties take place randomly? \n how did it work with the dolce vita? did they block the whole restaurant for you? or did you have a separate area? how was it decorated? did you choose certain colors\/flowers, etc.?\n \n I think I will have some more questions later if you dont mind :-) ? \n Congratulations on your wedding :-) \n youre married now!!!! yeeeiiih....","Attachments":[],"Id":1084617,"PostDate":1269290711,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                hi kerrij, <br \/> <br \/> thank you so much for sharing your experience with us... it\u00b4s great to hear that you loved the resort and your wedding... the spa experience doesn\u00b4t sound that great though... I have something very specific in mind with my hair, so I think I am gonna flip out if she won\u00b4t listen to what I want, hihi... <br \/> you said they have beach parties at the resort, is it a special day or do those parties take place randomly? <br \/> how did it work with the dolce vita? did they block the whole restaurant for you? or did you have a separate area? how was it decorated? did you choose certain colors\/flowers, etc.?<br \/> <br \/> I think I will have some more questions later if you dont mind :-) ? <br \/> Congratulations on your wedding :-) <br \/> youre married now!!!! yeeeiiih....\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"chrissik82@googlemail.com","IpAddress":"","GroupId":5,"GroupName":"Banned","JoinDate":1260680287,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223885.PNG?_r=0","PhotoWidth":150,"PhotoHeight":87,"PhotoType":"custom"},"FormattedName":"christinak82","Id":223885,"Name":"christinak82","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fc3636f6659baf4fb9ebf3feacc784a9","RawContent":"I don&#039;t mind the questions at all! fire away!\n the hotels beach party is tuesday nights. but its not on the beach lol. it&#039;s at the snack shack, and was soooo cool! so it&#039;s great if you don&#039;t have your own dance to just go to that. \n \n at dolce vita they have a side room that is round and held 50 of us well, and i&#039;m sure smaller groups would be just fine too! the doorway was the only view of the rest of the restaurant, but was also across the lobby of the restaraunt. was perfect!\n i didn&#039;t notice decor at the rest. but def didn&#039;t need any. i didn&#039;t have any special decor anywhere and people told me it was the most beautiful wedding they&#039;ve ever been to. so i wouldn&#039;t worry about taking stuff with you or buying\/renting much. not even flowers.\n my bouquet was GORGEOUS!!! i LOVED it! you can choose your colors and your bouquet and anything you want with Beverly. she has a binder of pics of stuff and you just say, i want that! and she&#039;ll make it happen. the chair covers were included which is nice too!","Attachments":[],"Id":1085168,"PostDate":1269306770,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I don't mind the questions at all! fire away!<br \/> the hotels beach party is tuesday nights. but its not on the beach lol. it's at the snack shack, and was soooo cool! so it's great if you don't have your own dance to just go to that. <br \/> <br \/> at dolce vita they have a side room that is round and held 50 of us well, and i'm sure smaller groups would be just fine too! the doorway was the only view of the rest of the restaurant, but was also across the lobby of the restaraunt. was perfect!<br \/> i didn't notice decor at the rest. but def didn't need any. i didn't have any special decor anywhere and people told me it was the most beautiful wedding they've ever been to. so i wouldn't worry about taking stuff with you or buying\/renting much. not even flowers.<br \/> my bouquet was GORGEOUS!!! i LOVED it! you can choose your colors and your bouquet and anything you want with Beverly. she has a binder of pics of stuff and you just say, i want that! and she'll make it happen. the chair covers were included which is nice too!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/global.thebump.com\/tickers\/tt7a388.aspx\">http:\/\/global.thebump.com\/tickers\/tt7a388.aspx<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/i964.photobucket.com\/albums\/ae129\/mccrady\/gartrepic.jpg\">http:\/\/i964.photobucket.com\/albums\/a...\/gartrepic.jpg<\/a><\/div><\/div>","Email":"kerrij@shaw.ca","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1250884128,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-220796.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"kerrij","Id":220796,"Name":"kerrij","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8d47d0ecc839202eb9d7e347dc66e736","RawContent":"Hey Kerrij,\n \n CONGRATS!!!! I love the picture of you are your husband!!&lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif\" border=\"0\" alt=\"\" title=\"Cheesy\" class=\"inlineimg\" \/&gt;\n \n I was just wondering if you could tell me how far the bar is from the beach gazebo??","Attachments":[],"Id":1092127,"PostDate":1269754443,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hey Kerrij,<br \/> <br \/> CONGRATS!!!! I love the picture of you are your husband!!<span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif\" border=\"0\" alt=\"\" title=\"Cheesy\" class=\"inlineimg\" \/><\/span><br \/> <br \/> I was just wondering if you could tell me how far the bar is from the beach gazebo??\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lchayim@rogers.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1265621673,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-225422.JPG?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"StephAli","Id":225422,"Name":"StephAli","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":false,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"463905fcd0401e823f2260a644b09862","RawContent":"Hi Kerrij, \n \n does that separate room also hold more than 50 people? We expect about 60-70 people. \n Did you have to pay those $2500 for that room?","Attachments":[],"Id":1093270,"PostDate":1269884763,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi Kerrij, <br \/> <br \/> does that separate room also hold more than 50 people? We expect about 60-70 people. <br \/> Did you have to pay those $2500 for that room?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"chrissik82@googlemail.com","IpAddress":"","GroupId":5,"GroupName":"Banned","JoinDate":1260680287,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223885.PNG?_r=0","PhotoWidth":150,"PhotoHeight":87,"PhotoType":"custom"},"FormattedName":"christinak82","Id":223885,"Name":"christinak82","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"95dd601ba9cabdfb03d4d1ecf4253cc2","RawContent":"Hey everyone! We are considering GBP Jamaica for our wedding the week of Jan 29th 2011!! We would be flying Transat from Toronto!!! Just have to make the final decision SOON!\n \n \n kerrij - I would LOVE to hear how your wedding went!!! \n How are you other GBP Jamaica girls doing with your planning??","Attachments":[],"Id":1094029,"PostDate":1269908164,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hey everyone! We are considering GBP Jamaica for our wedding the week of Jan 29th 2011!! We would be flying Transat from Toronto!!! Just have to make the final decision SOON!<br \/> <br \/> <br \/> kerrij - I would LOVE to hear how your wedding went!!! <br \/> How are you other GBP Jamaica girls doing with your planning??\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jennyslack@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1262229008,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-224208.jpg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"jennypenny23","Id":224208,"Name":"jennypenny23","IsOnline":false}}],"Pages":{"TotalItems":5564,"TotalPages":557,"CurrentPage":40,"NextPage":50,"PreviousPage":30,"LastPage":5560},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
