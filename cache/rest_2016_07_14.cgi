{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":5564,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":true,"Views":437496,"MovedTo":null,"MovedOn":0,"FirstPostId":909811,"Rating":0,"RatingHits":0,"Starter":{"Id":220796,"Name":"kerrij","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-220796.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"IsOnline":false},"StartDate":1257286410,"LastPoster":{"Id":287055,"Name":"JasminMattPhoto","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-287055.jpg?_r=1464796174","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":23,"Preview":{"Id":1028633,"PostDate":1265757005,"PostContent":"Quote:     Originally Posted by kerrij   I'm behind on all the chit chat!   I emailed paula to t...","Author":{"Signature":"","Email":"chrissik82@googlemail.com","IpAddress":"","GroupId":5,"GroupName":"Banned","JoinDate":1260680287,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223885.PNG?_r=0","PhotoWidth":150,"PhotoHeight":87,"PhotoType":"custom"},"FormattedName":"christinak82","Id":223885,"Name":"christinak82","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4444f1875af7f90635d9dd21d6cc643d","RawContent":"Hello girls...\n I&#039;m not in Calgary but still Alberta (Peace River) and I am getting married at the Gran Bahia Principe as well ! May 29th, 2010... I would love to hear of your experience after the wedding since you are getting married first!! :)\n I just booked my photographer today... I would recommend getting someone off the resort.. I was a bridesmaid at 2 weddings at Ocho Rios in Jamaica in October and both brides were not happy with the photo packages... price and creativity was not that great... :)\n Amanda","Attachments":[],"Id":1027624,"PostDate":1265690142,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hello girls...<br \/> I'm not in Calgary but still Alberta (Peace River) and I am getting married at the Gran Bahia Principe as well ! May 29th, 2010... I would love to hear of your experience after the wedding since you are getting married first!! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br \/> I just booked my photographer today... I would recommend getting someone off the resort.. I was a bridesmaid at 2 weddings at Ocho Rios in Jamaica in October and both brides were not happy with the photo packages... price and creativity was not that great... <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br \/> Amanda\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"amandajill1982@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1265669614,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-225433.gif?_r=0","PhotoWidth":150,"PhotoHeight":101,"PhotoType":"custom"},"FormattedName":"amandajill","Id":225433,"Name":"amandajill","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":false,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"81cfafcf6429d5e32186481447f7bb87","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;kerrij&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;I&#039;m behind on all the chit chat! \n \n I emailed paula to the other day to book my appt and she said they didn&#039;t do GBP anymore...i was like, uhhh we just had about 4 emails back and forth and each eamil i stated the hotel name, and then finally she&#039;s like, oh i thought it was grand Palladium! oy! I have talked to the new spa rep via email and just waiting to book our hair and pedi&#039;s when i hear back! i am def goign to book it before we get there. i&#039;ll tell him to put it in his books! hahah\n \n Julia, we have 47 booked! it&#039;s going to be so fun i cannot wait! \n \n try doing a search on Jan&#039;s, there is lots of talk about them, but like Christina said, most brides stop posting after their wedding...so hopefully you can find some info. I actually decided against ordering extra flowers other than flower girl flowers. But Tai is actually doing them for way cheaper than i thought now, so that is good. i bought parasols and fans for uber cheap for the BMs and moms instead.\n \n Beverly is getting on my nervous! hahah she never responds anymore. argh! so i&#039;ll just leave it for another couple weeks and then i&#039;m going to call her. last time i called another WC there said she&#039;d be back in 15 mins. so i called back in 20 and she wasn&#039;t there so the WC helped me and said she&#039;d reply to the email i&#039;ve been waiting so long on. \n \n Julia i also heard one other girl got her steel drum band for free! i wonder how we can snake some freebies too! hehehe I can&#039;t believe i&#039;m just 25 days away until we leave!\n \n I really wish there were some past brides that got married here. i haven&#039;t seen any pics or anything even on trip advisor...just the odd one from someone who went to a friends wedding there.&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;\n wow kerrij, it must be so exciting to know that its only 25 days away :-) \n and yeah its so hard to find more information and especially pictures about GBPJ. even that one review on tripadvisor has only one picture of the bridal bouquet... thats it?!?!? If I would have my wedding pictures done I would post them everywhere and tell everyone how it went... I mean why else would you take so beautiful pictures if you dont show them? \n I wish you all the best kerrij... hope you\u00b4ll let us know about your experience...","Attachments":[],"Id":1028633,"PostDate":1265757005,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>kerrij<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">I'm behind on all the chit chat! <br \/> <br \/> I emailed paula to the other day to book my appt and she said they didn't do GBP anymore...i was like, uhhh we just had about 4 emails back and forth and each eamil i stated the hotel name, and then finally she's like, oh i thought it was grand Palladium! oy! I have talked to the new spa rep via email and just waiting to book our hair and pedi's when i hear back! i am def goign to book it before we get there. i'll tell him to put it in his books! hahah<br \/> <br \/> Julia, we have 47 booked! it's going to be so fun i cannot wait! <br \/> <br \/> try doing a search on Jan's, there is lots of talk about them, but like Christina said, most brides stop posting after their wedding...so hopefully you can find some info. I actually decided against ordering extra flowers other than flower girl flowers. But Tai is actually doing them for way cheaper than i thought now, so that is good. i bought parasols and fans for uber cheap for the BMs and moms instead.<br \/> <br \/> Beverly is getting on my nervous! hahah she never responds anymore. argh! so i'll just leave it for another couple weeks and then i'm going to call her. last time i called another WC there said she'd be back in 15 mins. so i called back in 20 and she wasn't there so the WC helped me and said she'd reply to the email i've been waiting so long on. <br \/> <br \/> Julia i also heard one other girl got her steel drum band for free! i wonder how we can snake some freebies too! hehehe I can't believe i'm just 25 days away until we leave!<br \/> <br \/> I really wish there were some past brides that got married here. i haven't seen any pics or anything even on trip advisor...just the odd one from someone who went to a friends wedding there.<\/div> <\/td> <\/tr> <\/table> <\/div><br \/> wow kerrij, it must be so exciting to know that its only 25 days away :-) <br \/> and yeah its so hard to find more information and especially pictures about GBPJ. even that one review on tripadvisor has only one picture of the bridal bouquet... thats it?!?!? If I would have my wedding pictures done I would post them everywhere and tell everyone how it went... I mean why else would you take so beautiful pictures if you dont show them? <br \/> I wish you all the best kerrij... hope you\u00b4ll let us know about your experience...\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"chrissik82@googlemail.com","IpAddress":"","GroupId":5,"GroupName":"Banned","JoinDate":1260680287,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223885.PNG?_r=0","PhotoWidth":150,"PhotoHeight":87,"PhotoType":"custom"},"FormattedName":"christinak82","Id":223885,"Name":"christinak82","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c77ec98bf443dadb2fce234c96869155","RawContent":"Hi AmandaJill! Another one of us GBP girls! yay! Thanks for the photog tip. who you book def makes your photos amazing! i hope my girl is good!! her website she looks awesome!\n Christina i couldn&#039;t agree with you more!\n \n What are your guys plans for your weddings? are you all having it in the gazebo with dinner in a restaurant or is anyone renting out the private space? Are you doing anything special or different?","Attachments":[],"Id":1029332,"PostDate":1265776265,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi AmandaJill! Another one of us GBP girls! yay! Thanks for the photog tip. who you book def makes your photos amazing! i hope my girl is good!! her website she looks awesome!<br \/> Christina i couldn't agree with you more!<br \/> <br \/> What are your guys plans for your weddings? are you all having it in the gazebo with dinner in a restaurant or is anyone renting out the private space? Are you doing anything special or different?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/global.thebump.com\/tickers\/tt7a388.aspx\">http:\/\/global.thebump.com\/tickers\/tt7a388.aspx<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/i964.photobucket.com\/albums\/ae129\/mccrady\/gartrepic.jpg\">http:\/\/i964.photobucket.com\/albums\/a...\/gartrepic.jpg<\/a><\/div><\/div>","Email":"kerrij@shaw.ca","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1250884128,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-220796.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"kerrij","Id":220796,"Name":"kerrij","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e96f30ead5c52457fff999cad7b2913d","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;kerrij&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt; But Tai is actually doing them for way cheaper than i thought now, so that is good. i bought parasols and fans for uber cheap for the BMs and moms instead.&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;I told Tai not to do flowers for the Moms (I don&#039;t have any bm&#039;s) - do you think I&#039;m going to offend them? Half of my guests are mom&#039;s\/dad&#039;s - I didnt want to offend anyone by not including them, but I don&#039;t want to offend anyone else either... What do you guys think?\n \n Also Kerri, did you find out how that girl got that steel band for free&lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/huh.gif\" border=\"0\" alt=\"\" title=\"Huh\" class=\"inlineimg\" \/&gt;? I&#039;m already WAY over budget, so I can&#039;t add any music (our wedding is small anyway), but I&#039;d add music if it was free!\n \n 33 days til we get married! Getting close!","Attachments":[],"Id":1029481,"PostDate":1265780305,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>kerrij<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\"> But Tai is actually doing them for way cheaper than i thought now, so that is good. i bought parasols and fans for uber cheap for the BMs and moms instead.<\/div> <\/td> <\/tr> <\/table> <\/div>I told Tai not to do flowers for the Moms (I don't have any bm's) - do you think I'm going to offend them? Half of my guests are mom's\/dad's - I didnt want to offend anyone by not including them, but I don't want to offend anyone else either... What do you guys think?<br \/> <br \/> Also Kerri, did you find out how that girl got that steel band for free<span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/huh.gif\" border=\"0\" alt=\"\" title=\"Huh\" class=\"inlineimg\" \/><\/span>? I'm already WAY over budget, so I can't add any music (our wedding is small anyway), but I'd add music if it was free!<br \/> <br \/> 33 days til we get married! Getting close!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/davf.daisypath.com\/bnBtm6.png\">http:\/\/davf.daisypath.com\/bnBtm6.png<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/www.mywedding.com\/chrisandjulia2010\">http:\/\/www.mywedding.com\/chrisandjulia2010<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/i99.photobucket.com\/albums\/l283\/juliaks\/Hosting\/03-14WEDDIN00005.jpg\">http:\/\/i99.photobucket.com\/albums\/l2...EDDIN00005.jpg<\/a><\/div><\/div>","Email":"julia.spaargaren@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1257408945,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223082.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"juliaks","Id":223082,"Name":"juliaks","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b6ad69c79776f192eba9548f9cf0a552","RawContent":"Hello Brides-to-be,\n \n I am from Canada as well, living in the Toronto area. I\u00e2\u20ac\u2122m looking to get married at GBP in Nov of this year. I have not booked yet, I\u00e2\u20ac\u2122m still waiting for questions to be answered by Beverly. Since many of you will be getting married at GBP before me I would love to lean on your wisdom for ideas.\n \n We are looking at 75-100 guests and would like to have a private reception. Beverly provide a prepaid party package one for $60per person and the other for $100per person. Is anyone out there doing the prepaid party package, which consist of Special Decoration with Tikki Torches, welcome cocktail with coconut water, Steel Band or Live band, Night \u00e2\u20ac\u0153Show\u00e2\u20ac\u009d of 45 minutes, Special typical dresses (not sure what this is) and buffet menu.\n \n Does GBP do custom wedding packages? There are many items on the list of packages that we will not be needing, because we are getting an offsite photographer, our own minister and if we go with the prepaid party package I don\u00e2\u20ac\u2122t know if the sit down reception that is included in the package is relevant.\n \n If any of you plan to do a private reception can you let me know what your plans are? I\u00e2\u20ac\u2122m trying to find ways to bring down the cost.","Attachments":[],"Id":1032619,"PostDate":1266006846,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hello Brides-to-be,<br \/> <br \/> I am from Canada as well, living in the Toronto area. I\u00e2\u20ac\u2122m looking to get married at GBP in Nov of this year. I have not booked yet, I\u00e2\u20ac\u2122m still waiting for questions to be answered by Beverly. Since many of you will be getting married at GBP before me I would love to lean on your wisdom for ideas.<br \/> <br \/> We are looking at 75-100 guests and would like to have a private reception. Beverly provide a prepaid party package one for $60per person and the other for $100per person. Is anyone out there doing the prepaid party package, which consist of Special Decoration with Tikki Torches, welcome cocktail with coconut water, Steel Band or Live band, Night \u00e2\u20ac\u0153Show\u00e2\u20ac\u009d of 45 minutes, Special typical dresses (not sure what this is) and buffet menu.<br \/> <br \/> Does GBP do custom wedding packages? There are many items on the list of packages that we will not be needing, because we are getting an offsite photographer, our own minister and if we go with the prepaid party package I don\u00e2\u20ac\u2122t know if the sit down reception that is included in the package is relevant.<br \/> <br \/> If any of you plan to do a private reception can you let me know what your plans are? I\u00e2\u20ac\u2122m trying to find ways to bring down the cost.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nshettle@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1265755282,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-225470.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Virtuous","Id":225470,"Name":"Virtuous","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"48846186070aae5b94e175a86116a650","RawContent":"Julia, you should call Beverly and ask her if you can get the Free Package...I called and talked to the other WC there yesterday (DeshonJay) and i got the feeling that they don&#039;t care who gets what package...you get all the basic stuff except minister fees which is $400 and works out way cheaper than blissful, especially if you only have 16 people! and i found out that is why i haven&#039;t had to put a deposit down, because mine is &amp;quot;free&amp;quot; so i pay when i get there.\n \n I would absolutely not feel bad about getting your moms flowers and not everyone else. you should make your moms feel special cause it&#039;s their little girls\/boys day! they would love it! i&#039;m getting our moms a silk fan for the ceremony and no one else.\n \n I&#039;m not sure how the girl got it free, i&#039;m hoping when we get there we can squeeze so free things in there?! eek!\n \n Hi Virtuous! I didn&#039;t know about that $60\/100 package! now that i know they have tikki torches i&#039;m going ot have to inquire about that! sounds awesome!! Since i didn&#039;t know about this, i&#039;m sure i don&#039;t know if they do custom pkgs or not. sorry!\n \n I&#039;m not doing a private reception, just dinner in the rest (one of them has a private-ish room) an then our dance for 2 hours at the gazebo which is private!\n \n I&#039;ve learned that since i don&#039;t get email responses anymore, so annoying!, that calling them works just as well and you can ask either of them questions and their responses are usually No Problem! hehe so cute!","Attachments":[],"Id":1033347,"PostDate":1266033633,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Julia, you should call Beverly and ask her if you can get the Free Package...I called and talked to the other WC there yesterday (DeshonJay) and i got the feeling that they don't care who gets what package...you get all the basic stuff except minister fees which is $400 and works out way cheaper than blissful, especially if you only have 16 people! and i found out that is why i haven't had to put a deposit down, because mine is \"free\" so i pay when i get there.<br \/> <br \/> I would absolutely not feel bad about getting your moms flowers and not everyone else. you should make your moms feel special cause it's their little girls\/boys day! they would love it! i'm getting our moms a silk fan for the ceremony and no one else.<br \/> <br \/> I'm not sure how the girl got it free, i'm hoping when we get there we can squeeze so free things in there?! eek!<br \/> <br \/> Hi Virtuous! I didn't know about that $60\/100 package! now that i know they have tikki torches i'm going ot have to inquire about that! sounds awesome!! Since i didn't know about this, i'm sure i don't know if they do custom pkgs or not. sorry!<br \/> <br \/> I'm not doing a private reception, just dinner in the rest (one of them has a private-ish room) an then our dance for 2 hours at the gazebo which is private!<br \/> <br \/> I've learned that since i don't get email responses anymore, so annoying!, that calling them works just as well and you can ask either of them questions and their responses are usually No Problem! hehe so cute!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/global.thebump.com\/tickers\/tt7a388.aspx\">http:\/\/global.thebump.com\/tickers\/tt7a388.aspx<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/i964.photobucket.com\/albums\/ae129\/mccrady\/gartrepic.jpg\">http:\/\/i964.photobucket.com\/albums\/a...\/gartrepic.jpg<\/a><\/div><\/div>","Email":"kerrij@shaw.ca","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1250884128,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-220796.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"kerrij","Id":220796,"Name":"kerrij","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7f329d4cc46826952e1041e73acc5aa7","RawContent":"Hi girls!\n As someone here wisely said - with Beverly it is a hit or miss.&lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/girl_werewolf.gif\" border=\"0\" alt=\"\" title=\"Girl Werewolf\" class=\"inlineimg\" \/&gt; Funnily she replies pretty fast to me. I think once you gave her your credit card form filled out you can stop worrying.\n Girls, did anyone already book an appointment in this new Bahia Spa? Or is it just me since no one brought it up here. I wonder how many hours do I need to get hair and make up done? Would 2 hours be enough? Should I be ready like half an hour before the wedding? hmm \n How off topic is that? ))) Just didn&#039;t find much threads about this aspect of jamaican weddings.\n In case someone needs this - &lt;a data-ipb=&#039;nomediaparse&#039; href=\"mailto:spabpjam@bahia-principe.com\"&gt;spabpjam@bahia-principe.com&lt;\/a&gt;","Attachments":[],"Id":1033900,"PostDate":1266092294,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi girls!<br \/> As someone here wisely said - with Beverly it is a hit or miss.<span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/girl_werewolf.gif\" border=\"0\" alt=\"\" title=\"Girl Werewolf\" class=\"inlineimg\" \/><\/span> Funnily she replies pretty fast to me. I think once you gave her your credit card form filled out you can stop worrying.<br \/> Girls, did anyone already book an appointment in this new Bahia Spa? Or is it just me since no one brought it up here. I wonder how many hours do I need to get hair and make up done? Would 2 hours be enough? Should I be ready like half an hour before the wedding? hmm <br \/> How off topic is that? ))) Just didn't find much threads about this aspect of jamaican weddings.<br \/> In case someone needs this - <a href='mailto:spabpjam@bahia-principe.com' class='bbc_url' title='External link' rel='nofollow external'>spabpjam@bahia-principe.com<\/a>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>I need a holiday....a therapist and a life!!!!<\/span><\/div><\/div>","Email":"iced_pink_martini@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1263484888,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-224665.gif?_r=0","PhotoWidth":96,"PhotoHeight":96,"PhotoType":"custom"},"FormattedName":"Rani","Id":224665,"Name":"Rani","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"16e64811ddc3075040a47301befddd04","RawContent":"Ya I booked our spa appointments. I want to be ready a couple hours before the ceremony though. My ceremony is at 3:30 and I requested to be done around 1:30 so I&#039;ll prob start at noon and go for the 2nd round of appointments. But if you contact the spa they will guide you to what time you should start if you know what time you want to be finished. All depends on what you want done exactly to your hair and stuff.","Attachments":[],"Id":1036937,"PostDate":1266353671,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Ya I booked our spa appointments. I want to be ready a couple hours before the ceremony though. My ceremony is at 3:30 and I requested to be done around 1:30 so I'll prob start at noon and go for the 2nd round of appointments. But if you contact the spa they will guide you to what time you should start if you know what time you want to be finished. All depends on what you want done exactly to your hair and stuff.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/global.thebump.com\/tickers\/tt7a388.aspx\">http:\/\/global.thebump.com\/tickers\/tt7a388.aspx<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/i964.photobucket.com\/albums\/ae129\/mccrady\/gartrepic.jpg\">http:\/\/i964.photobucket.com\/albums\/a...\/gartrepic.jpg<\/a><\/div><\/div>","Email":"kerrij@shaw.ca","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1250884128,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-220796.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"kerrij","Id":220796,"Name":"kerrij","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c11ae8a00230cc35719ea0fe19ce65c0","RawContent":"Hey Kerrij\n \n I am getting married at GBP in November and I am debating the reception....Do you know how far\/close a bar is to the gazebo? Beverly told me that I can rent it for $500 and then I would also have to pay $15 per person per hr for a bar.....did she tell you the same thing??","Attachments":[],"Id":1040157,"PostDate":1266482025,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hey Kerrij<br \/> <br \/> I am getting married at GBP in November and I am debating the reception....Do you know how far\/close a bar is to the gazebo? Beverly told me that I can rent it for $500 and then I would also have to pay $15 per person per hr for a bar.....did she tell you the same thing??\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lchayim@rogers.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1265621673,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-225422.JPG?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"StephAli","Id":225422,"Name":"StephAli","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c512910c0ccdcd259f0391a773999a66","RawContent":"Hey Steph, yes she told me the same thing. i think it&#039;s a bit of a hike to the bar. if you look at pics of the gazebo it&#039;s a little ways. But to me it&#039;s worth it, if people are walking to the bar all the time they won&#039;t be at the dance, they&#039;ll get distracted and start chatting with other people.","Attachments":[],"Id":1046427,"PostDate":1266899660,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hey Steph, yes she told me the same thing. i think it's a bit of a hike to the bar. if you look at pics of the gazebo it's a little ways. But to me it's worth it, if people are walking to the bar all the time they won't be at the dance, they'll get distracted and start chatting with other people.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/global.thebump.com\/tickers\/tt7a388.aspx\">http:\/\/global.thebump.com\/tickers\/tt7a388.aspx<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/i964.photobucket.com\/albums\/ae129\/mccrady\/gartrepic.jpg\">http:\/\/i964.photobucket.com\/albums\/a...\/gartrepic.jpg<\/a><\/div><\/div>","Email":"kerrij@shaw.ca","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1250884128,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-220796.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"kerrij","Id":220796,"Name":"kerrij","IsOnline":false}}],"Id":"44634","Title":"Any Gran Bahia Principe Runaway Bay Brides out there?","LastPostDate":1467934433},"Pages":{"TotalItems":5564,"TotalPages":557,"CurrentPage":30,"NextPage":40,"PreviousPage":20,"LastPage":5560},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
