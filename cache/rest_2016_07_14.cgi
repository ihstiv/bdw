Request Time: 1 seconds
{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d1ac13042a4d2c534c6f488e9af296f1","RawContent":"Hi Brides!\n I&#039;m getting married July 30, 2010 at Gran Bahia! Ladies, thanks soooo much for all the valuable info that you have provided. At first I was nervous about choosing this resort, but now I feel confident in my choice. Kerri thanks sooo much for posting your pics. Everything looked soo beautiful on your special day! Best of Luck to Everyone! Be sure to post pics after your big day and I will be sure to do the same.\n \n Jmarie","Attachments":[],"Id":1164236,"PostDate":1274927187,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi Brides!<br \/> I'm getting married July 30, 2010 at Gran Bahia! Ladies, thanks soooo much for all the valuable info that you have provided. At first I was nervous about choosing this resort, but now I feel confident in my choice. Kerri thanks sooo much for posting your pics. Everything looked soo beautiful on your special day! Best of Luck to Everyone! Be sure to post pics after your big day and I will be sure to do the same.<br \/> <br \/> Jmarie\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"joelleschiliro@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1259831042,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223693.jpg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"JMarie","Id":223693,"Name":"JMarie","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9e389304170077871700e44c45731c78","RawContent":"Hi Ladies, \n \n I just wanted to share some info. about the photographer that I am using for my big day. Her name is Misha Earle and she has been very accomadating with everything. We are spending 2500.00 total but she has other packages available and she will work with you on pricing. We are getting 10 hours of shooting time and the time can be split into 2 days which we are doing. We are doing a trash the dress session the next day, but we are not sure what location we are going to use. The package also includes a DVD slide show with all your images set to the music of your choice. If you want to contact her, her email address is &lt;a data-ipb=&#039;nomediaparse&#039; href=\"mailto:mishaearle@gmail.com\"&gt;mishaearle@gmail.com&lt;\/a&gt;. Again, she has been very helpful with everything and she responds very quickly to emails. Hope this helps anyone who is still looking for a photographer. You can also look at her website mishaearlephotography.com!","Attachments":[],"Id":1164428,"PostDate":1274940264,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi Ladies, <br \/> <br \/> I just wanted to share some info. about the photographer that I am using for my big day. Her name is Misha Earle and she has been very accomadating with everything. We are spending 2500.00 total but she has other packages available and she will work with you on pricing. We are getting 10 hours of shooting time and the time can be split into 2 days which we are doing. We are doing a trash the dress session the next day, but we are not sure what location we are going to use. The package also includes a DVD slide show with all your images set to the music of your choice. If you want to contact her, her email address is <a href='mailto:mishaearle@gmail.com' class='bbc_url' title='External link' rel='nofollow external'>mishaearle@gmail.com<\/a>. Again, she has been very helpful with everything and she responds very quickly to emails. Hope this helps anyone who is still looking for a photographer. You can also look at her website mishaearlephotography.com!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"joelleschiliro@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1259831042,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223693.jpg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"JMarie","Id":223693,"Name":"JMarie","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2eb93737e340bc7de86c2b129cd1718e","RawContent":"Hi Jmarie! Yay! There are so many of us now!! I am looking into the photog for sure! Thx!!","Attachments":[],"Id":1164848,"PostDate":1274988723,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi Jmarie! Yay! There are so many of us now!! I am looking into the photog for sure! Thx!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jennyslack@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1262229008,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-224208.jpg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"jennypenny23","Id":224208,"Name":"jennypenny23","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":false,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a7e76dcdc028e0909eb3214dd13b41ca","RawContent":"Thank you so much for the info JMarie. I looked on her website. She has very nice pictures.","Attachments":[],"Id":1167038,"PostDate":1275159244,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thank you so much for the info JMarie. I looked on her website. She has very nice pictures.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"chrissik82@googlemail.com","IpAddress":"","GroupId":5,"GroupName":"Banned","JoinDate":1260680287,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223885.PNG?_r=0","PhotoWidth":150,"PhotoHeight":87,"PhotoType":"custom"},"FormattedName":"christinak82","Id":223885,"Name":"christinak82","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fe87104f8a1a06174b3e8ad9126e5b3e","RawContent":"I have a question about the decorations.\n \n Does it matter what package you pick to get the chair covers? And its free? Seems weird they&#039;d give them for free, but on the forms I was sent from the WC, it showed a charge schedule for them..... \n \n I won&#039;t be able to afford $2500 on a photographer, so I&#039;m going to have to go wit hthe resort one, and one of my guests is a photographer so I&amp;quot;m hoping she&#039;ll just take really nice pictures, hahaha, I know it sounds cheap but I can&#039;t see any way of fitting that huge of a number into the budget.....","Attachments":[],"Id":1170727,"PostDate":1275531665,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I have a question about the decorations.<br \/> <br \/> Does it matter what package you pick to get the chair covers? And its free? Seems weird they'd give them for free, but on the forms I was sent from the WC, it showed a charge schedule for them..... <br \/> <br \/> I won't be able to afford $2500 on a photographer, so I'm going to have to go wit hthe resort one, and one of my guests is a photographer so I\"m hoping she'll just take really nice pictures, hahaha, I know it sounds cheap but I can't see any way of fitting that huge of a number into the budget.....\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Gran Bahia Principe - Runaway Bay - February 22, 2011<\/span><\/div><\/div>","Email":"akua420@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1270637423,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-227119.jpg?_r=0","PhotoWidth":200,"PhotoHeight":161,"PhotoType":"custom"},"FormattedName":"akua420","Id":227119,"Name":"akua420","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bb87a9ce29c67d5f6c13a12737a57733","RawContent":"akua,\n \n I&#039;m doing the same thing!! lol....all my g\/f love taking pictures so I might as well use them!! &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif\" border=\"0\" alt=\"\" title=\"Cheesy\" class=\"inlineimg\" \/&gt; One g\/f is a photographer so she is going to take some of the posed photos that I just need!!","Attachments":[],"Id":1171068,"PostDate":1275552574,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                akua,<br \/> <br \/> I'm doing the same thing!! lol....all my g\/f love taking pictures so I might as well use them!! <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif\" border=\"0\" alt=\"\" title=\"Cheesy\" class=\"inlineimg\" \/><\/span> One g\/f is a photographer so she is going to take some of the posed photos that I just need!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lchayim@rogers.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1265621673,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-225422.JPG?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"StephAli","Id":225422,"Name":"StephAli","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f3b2022a205b35e769db08d601901033","RawContent":"This resort sounds really nice. My TA suggested it along with breezes and riu ochos rios...so I hope to see pics of each somewhere in these threads : ) !","Attachments":[],"Id":1171689,"PostDate":1275604817,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                This resort sounds really nice. My TA suggested it along with breezes and riu ochos rios...so I hope to see pics of each somewhere in these threads : ) !\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"dsc225@nyu.edu","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1275029994,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-228644.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"luckiestdestiny","Id":228644,"Name":"luckiestdestiny","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0a1c567b8fe937733440107bb2867711","RawContent":"I am so excited about how many GBP Runaway bay Bride-to-be&#039;s there are now!!! Looking forward to sharing plans with everyone over the next couple of mths!! Our group rate is secured until June 16th so we will have our full guest list by then!! woohoo!!","Attachments":[],"Id":1172398,"PostDate":1275642012,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I am so excited about how many GBP Runaway bay Bride-to-be's there are now!!! Looking forward to sharing plans with everyone over the next couple of mths!! Our group rate is secured until June 16th so we will have our full guest list by then!! woohoo!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jennyslack@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1262229008,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-224208.jpg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"jennypenny23","Id":224208,"Name":"jennypenny23","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f5c3f5ac7ec10f6b92a3356d7c497111","RawContent":"So I&#039;ve just returned from our wedding at GBP and this place is absolutely amazing! I am so sad that it&#039;s over because I would go back and do it again in a heartbeat! Beverly, the WC, is amazing and an absolute sweetheart! She took care of everything for us! The day couldn&#039;t have been more perfect and it&#039;s all thanks to her! We had a beautiful, sunny day and she was there with us every step of the way. We had our supper at the Grill Restaurant &amp;amp; the food was delicious! Everyone loved it! We also decided on the reception in the Gazebo where we got married and I would highly recommend that! It is definitely worth it! We brought all of our own music and had the place rockin&#039;! All of our guests said it was the best wedding they have ever attended. I will recommend bringing your own photographer if possible. We didn&#039;t do that but luckily we had a few friends with professional cameras. I would have been rather upset if we didn&#039;t as the resort photographer didn&#039;t show up until the ceremony was over and then he only spent maybe a half hour with us! Luckily we also had a friend with a video camera who captured all our special moments. This resort is absolutely beautiful &amp;amp; spotless! Our room was overlooking the pool &amp;amp; the ocean as were most of our wedding guests&#039; rooms. We couldn&#039;t have gotten better treatment! All in all, I would recommend this resort to anyone who is looking for a place to get married! I was so sad to leave it &amp;amp; cannot wait to return for our anniversary. Good Luck to all you future GBP brides! You are in for a treat!","Attachments":[],"Id":1174867,"PostDate":1275881702,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                So I've just returned from our wedding at GBP and this place is absolutely amazing! I am so sad that it's over because I would go back and do it again in a heartbeat! Beverly, the WC, is amazing and an absolute sweetheart! She took care of everything for us! The day couldn't have been more perfect and it's all thanks to her! We had a beautiful, sunny day and she was there with us every step of the way. We had our supper at the Grill Restaurant & the food was delicious! Everyone loved it! We also decided on the reception in the Gazebo where we got married and I would highly recommend that! It is definitely worth it! We brought all of our own music and had the place rockin'! All of our guests said it was the best wedding they have ever attended. I will recommend bringing your own photographer if possible. We didn't do that but luckily we had a few friends with professional cameras. I would have been rather upset if we didn't as the resort photographer didn't show up until the ceremony was over and then he only spent maybe a half hour with us! Luckily we also had a friend with a video camera who captured all our special moments. This resort is absolutely beautiful & spotless! Our room was overlooking the pool & the ocean as were most of our wedding guests' rooms. We couldn't have gotten better treatment! All in all, I would recommend this resort to anyone who is looking for a place to get married! I was so sad to leave it & cannot wait to return for our anniversary. Good Luck to all you future GBP brides! You are in for a treat!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"stewart_gloria@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1272083499,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-227602.gif?_r=0","PhotoWidth":63,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"sunchick31","Id":227602,"Name":"sunchick31","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"974422773d933694be83b3a68375d0eb","RawContent":"Hey Sunchick,\n \n Did you have a bar at the beach gazebo for the reception?? I am just wondering b\/c we havent decided what to do yet, and I&#039;m trying to way the pros and cons....basically $ vs. convenience....was the resort bar close enough to the gazebo that my guest could walk to it and I would not have to hire a bartender to be stationed at the gazebo??\n \n Thanks!!","Attachments":[],"Id":1174961,"PostDate":1275888190,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hey Sunchick,<br \/> <br \/> Did you have a bar at the beach gazebo for the reception?? I am just wondering b\/c we havent decided what to do yet, and I'm trying to way the pros and cons....basically $ vs. convenience....was the resort bar close enough to the gazebo that my guest could walk to it and I would not have to hire a bartender to be stationed at the gazebo??<br \/> <br \/> Thanks!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lchayim@rogers.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1265621673,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-225422.JPG?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"StephAli","Id":225422,"Name":"StephAli","IsOnline":false}}],"Pages":{"TotalItems":5564,"TotalPages":557,"CurrentPage":110,"NextPage":120,"PreviousPage":100,"LastPage":5560},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
