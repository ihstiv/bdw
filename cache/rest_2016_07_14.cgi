{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e79ed51c392bfc089ce9a34a7bf38c3a","RawContent":"Hi ladies! I just received wedding package info from Beverly today, YAY! It&#039;s very exciting finally getting something about the wedding!!!\n \n Thought I&#039;d share the info with all of you, in case you are interested! :)&lt;p&gt;&amp;nbsp;&lt;\/p&gt;&lt;span huddler_attributes=\"{&amp;quot;plugin&amp;quot;:&amp;quot;attachment&amp;quot;,&amp;quot;params&amp;quot;:{&amp;quot;id&amp;quot;:&amp;quot;7096&amp;quot;,&amp;quot;name&amp;quot;:&amp;quot;Wedding_Package_with_incl_2010.doc&amp;quot;,&amp;quot;description&amp;quot;:&amp;quot;&amp;quot;,&amp;quot;size&amp;quot;:318.5,&amp;quot;type&amp;quot;:&amp;quot;doc&amp;quot;}}\" huddler_plugin=\"attachment\"&gt;&amp;nbsp;&lt;\/span&gt;","Attachments":[],"Id":1111016,"PostDate":1271142058,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi ladies! I just received wedding package info from Beverly today, YAY! It's very exciting finally getting something about the wedding!!!<br \/> <br \/> Thought I'd share the info with all of you, in case you are interested! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><p>\u00a0<\/p><span huddler_attributes=\"{\"plugin\":\"attachment\",\"params\":{\"id\":\"7096\",\"name\":\"Wedding_Package_with_incl_2010.doc\",\"description\":\"\",\"size\":318.5,\"type\":\"doc\"}}\" huddler_plugin=\"attachment\">\u00a0<\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mekanabr@gmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1259797911,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223677.JPG?_r=0","PhotoWidth":200,"PhotoHeight":299,"PhotoType":"custom"},"FormattedName":"mekanabr","Id":223677,"Name":"mekanabr","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"54b8dc931b46452b8873d4c5e5c1bcb9","RawContent":"Awesome mekanabr!!\n \n I received this from her today! Exciting!&lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile29.gif\" border=\"0\" alt=\"\" title=\"Smile29\" class=\"inlineimg\" \/&gt;","Attachments":[],"Id":1112787,"PostDate":1271232647,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Awesome mekanabr!!<br \/> <br \/> I received this from her today! Exciting!<span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile29.gif\" border=\"0\" alt=\"\" title=\"Smile29\" class=\"inlineimg\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jennyslack@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1262229008,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-224208.jpg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"jennypenny23","Id":224208,"Name":"jennypenny23","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":false,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"77c46c31dbd29abfd215eb5a8ac17e80","RawContent":"hi mekanabr, \n its so stupid that they have that restriction for downloading attachments... I need 150 posts to do that... crazy... anyway... it should be the same document we got from beverly... I just wanted to compare it, in case they updated something... oh well... I guess, I need to spam some threads here to reach the posting amount... :-)","Attachments":[],"Id":1113079,"PostDate":1271270327,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                hi mekanabr, <br \/> its so stupid that they have that restriction for downloading attachments... I need 150 posts to do that... crazy... anyway... it should be the same document we got from beverly... I just wanted to compare it, in case they updated something... oh well... I guess, I need to spam some threads here to reach the posting amount... :-)\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"chrissik82@googlemail.com","IpAddress":"","GroupId":5,"GroupName":"Banned","JoinDate":1260680287,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223885.PNG?_r=0","PhotoWidth":150,"PhotoHeight":87,"PhotoType":"custom"},"FormattedName":"christinak82","Id":223885,"Name":"christinak82","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7029fa94621fbdce3847e4ca05026772","RawContent":"Hey Brides...I&#039;m not on BDW site as often anymore so feel free to PM me if you need a quick respons from a past GBP bride...since i&#039;m now scoping out all the baby websites! hehe yay!\n Ok here i go!\n \n &lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;mekanabr&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Ok another question for you Kerrij :)\n \n If you wouldn&#039;t mind sharing (or pm&#039;ing it to me) could you tell me how much your total wedding cost and what all it included? I was reading some sort of scary stuff on here from about a year ago and the prices sounded crazy!\n \n Thanks!!!!!&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;It&#039;s expensive no matter what you do!! no including the typical costs, rings, honeymoon, dress, wedding party outfits, photog, etc. here is roughly what i spent.\n Steel drum band - $400 ABSOLUTELY WORTH IT!!!\n Gazebo &amp;amp; DJ - $500\n Bar - $15\/person, i think?\n chair covers - were included\n we had the free package and had to pay for 35 of our guests i think.\n I think in the end it cost $4000 with the free package, which isn&#039;t avail anymore. \n Flights from Calgary $1739. we upgraded to first class $300 each. \n \n &lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;jennypenny23&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Im so glad that there are more GBP Runaway Bay brides out there! I just sent an email to &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Hi ladies! I just received wedding package info from Beverly today, YAY! It&#039;s very exciting finally getting something about the wedding!!!\n \n Thought I&#039;d share the info with all of you, in case you are interested! :)&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;My tip...go for the cheapest one. (unless you have a big group, then do the math and see what works out best) i almost chose Blissful because of all the options, but once you really look at it, you don&#039;t need most of that stuff anyway!\n I still haven&#039;t even seen the pics that were included in my package! not impressed.\n \n &lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;christinak82&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;hi mekanabr, \n its so stupid that they have that restriction for downloading attachments... I need 150 posts to do that... crazy... anyway... it should be the same document we got from beverly... I just wanted to compare it, in case they updated something... oh well... I guess, I need to spam some threads here to reach the posting amount... :-)&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;I felt the same way! so what i did (u can also pay $20 or something to get your 15) is i just spent a couple days at work commenting on all the newbies and then i got bored of that and so i just started opening up random threads and commenting on them. I always hated why people would post annoying commetns like &amp;quot;That is a good question, i want to know that answer too&amp;quot; instead of constructive feedback...then i learned why all these stupid posts were everywhere. BUT...in my quest to reach my 150 and opening random threads, i DID learn so much and got so many ideas...it helped me a lot, even though it was so annoying to get to 150. LOL\n \n GOOD LUCK GIRLS!!!!!!!!!!!!!","Attachments":[],"Id":1113228,"PostDate":1271276319,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hey Brides...I'm not on BDW site as often anymore so feel free to PM me if you need a quick respons from a past GBP bride...since i'm now scoping out all the baby websites! hehe yay!<br \/> Ok here i go!<br \/> <br \/> <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>mekanabr<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Ok another question for you Kerrij <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br \/> <br \/> If you wouldn't mind sharing (or pm'ing it to me) could you tell me how much your total wedding cost and what all it included? I was reading some sort of scary stuff on here from about a year ago and the prices sounded crazy!<br \/> <br \/> Thanks!!!!!<\/div> <\/td> <\/tr> <\/table> <\/div>It's expensive no matter what you do!! no including the typical costs, rings, honeymoon, dress, wedding party outfits, photog, etc. here is roughly what i spent.<br \/> Steel drum band - $400 ABSOLUTELY WORTH IT!!!<br \/> Gazebo & DJ - $500<br \/> Bar - $15\/person, i think?<br \/> chair covers - were included<br \/> we had the free package and had to pay for 35 of our guests i think.<br \/> I think in the end it cost $4000 with the free package, which isn't avail anymore. <br \/> Flights from Calgary $1739. we upgraded to first class $300 each. <br \/> <br \/> <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>jennypenny23<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Im so glad that there are more GBP Runaway Bay brides out there! I just sent an email to <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Hi ladies! I just received wedding package info from Beverly today, YAY! It's very exciting finally getting something about the wedding!!!<br \/> <br \/> Thought I'd share the info with all of you, in case you are interested! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/div> <\/td> <\/tr> <\/table> <\/div>My tip...go for the cheapest one. (unless you have a big group, then do the math and see what works out best) i almost chose Blissful because of all the options, but once you really look at it, you don't need most of that stuff anyway!<br \/> I still haven't even seen the pics that were included in my package! not impressed.<br \/> <br \/> <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>christinak82<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">hi mekanabr, <br \/> its so stupid that they have that restriction for downloading attachments... I need 150 posts to do that... crazy... anyway... it should be the same document we got from beverly... I just wanted to compare it, in case they updated something... oh well... I guess, I need to spam some threads here to reach the posting amount... :-)<\/div> <\/td> <\/tr> <\/table> <\/div>I felt the same way! so what i did (u can also pay $20 or something to get your 15) is i just spent a couple days at work commenting on all the newbies and then i got bored of that and so i just started opening up random threads and commenting on them. I always hated why people would post annoying commetns like \"That is a good question, i want to know that answer too\" instead of constructive feedback...then i learned why all these stupid posts were everywhere. BUT...in my quest to reach my 150 and opening random threads, i DID learn so much and got so many ideas...it helped me a lot, even though it was so annoying to get to 150. LOL<br \/> <br \/> GOOD LUCK GIRLS!!!!!!!!!!!!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/global.thebump.com\/tickers\/tt7a388.aspx\">http:\/\/global.thebump.com\/tickers\/tt7a388.aspx<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/i964.photobucket.com\/albums\/ae129\/mccrady\/gartrepic.jpg\">http:\/\/i964.photobucket.com\/albums\/a...\/gartrepic.jpg<\/a><\/div><\/div>","Email":"kerrij@shaw.ca","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1250884128,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-220796.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"kerrij","Id":220796,"Name":"kerrij","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6db4b7bf948c90515c84659fde7d67f0","RawContent":"Oh ya, and the cake...i didn&#039;t have the Special wedding cake in my package like Blissful does...and my cake was sooooo beautiful!!! 2 layers and pretty big, and so pretty! you can pick out your cake colors and flavor at the resort, as well as your bouqet and everythingn else. no need to order stuff a head of time!!","Attachments":[],"Id":1113231,"PostDate":1271276430,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Oh ya, and the cake...i didn't have the Special wedding cake in my package like Blissful does...and my cake was sooooo beautiful!!! 2 layers and pretty big, and so pretty! you can pick out your cake colors and flavor at the resort, as well as your bouqet and everythingn else. no need to order stuff a head of time!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/global.thebump.com\/tickers\/tt7a388.aspx\">http:\/\/global.thebump.com\/tickers\/tt7a388.aspx<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/i964.photobucket.com\/albums\/ae129\/mccrady\/gartrepic.jpg\">http:\/\/i964.photobucket.com\/albums\/a...\/gartrepic.jpg<\/a><\/div><\/div>","Email":"kerrij@shaw.ca","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1250884128,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-220796.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"kerrij","Id":220796,"Name":"kerrij","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3372f72440f31156c3ff33aee5979933","RawContent":"Thanks as usual Kerrij, what would we all do without you? :) Oh and btw, CONGRATS!!! That is super exciting for you guys!!!\n \n Christinak82, I did exactly what Kerrij did to get my 150 posts, just say hi to all the newbies and then start to explore other posts. Not only do you get out of the newbie stage that way, but you really do learn tons of stuff that you hadn&#039;t even thought about!! \n \n Here are the 2010 prices Beverly sent to me. \n Remember: $700\n Sunshine: $1100\n Blissful Love: $1350\n Unforgettale: $1900\n \n The Hors d&#039;oeuvres are a little pricey but might try to figure out a different option. When is your wedding and what plans have you made so far? Glad to meet another GBP bride!! :)","Attachments":[],"Id":1113984,"PostDate":1271308928,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks as usual Kerrij, what would we all do without you? <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> Oh and btw, CONGRATS!!! That is super exciting for you guys!!!<br \/> <br \/> Christinak82, I did exactly what Kerrij did to get my 150 posts, just say hi to all the newbies and then start to explore other posts. Not only do you get out of the newbie stage that way, but you really do learn tons of stuff that you hadn't even thought about!! <br \/> <br \/> Here are the 2010 prices Beverly sent to me. <br \/> Remember: $700<br \/> Sunshine: $1100<br \/> Blissful Love: $1350<br \/> Unforgettale: $1900<br \/> <br \/> The Hors d'oeuvres are a little pricey but might try to figure out a different option. When is your wedding and what plans have you made so far? Glad to meet another GBP bride!! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mekanabr@gmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1259797911,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223677.JPG?_r=0","PhotoWidth":200,"PhotoHeight":299,"PhotoType":"custom"},"FormattedName":"mekanabr","Id":223677,"Name":"mekanabr","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"45ea143fe6c1f7e14684a324ed39aa1f","RawContent":"You&#039;re welcome!! i love to talk about my wedding and the resort...so this thread is pretty much one of the few that i still come back to! heheh\n \n And thank you! we are verrrry excited! fingers crossed all goes well!\n \n i wouldn&#039;t do hors deourves...not really any time to eat them and if people need a snack, the buffet is awesome. dinner is very filling!","Attachments":[],"Id":1115170,"PostDate":1271383390,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                You're welcome!! i love to talk about my wedding and the resort...so this thread is pretty much one of the few that i still come back to! heheh<br \/> <br \/> And thank you! we are verrrry excited! fingers crossed all goes well!<br \/> <br \/> i wouldn't do hors deourves...not really any time to eat them and if people need a snack, the buffet is awesome. dinner is very filling!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/global.thebump.com\/tickers\/tt7a388.aspx\">http:\/\/global.thebump.com\/tickers\/tt7a388.aspx<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/i964.photobucket.com\/albums\/ae129\/mccrady\/gartrepic.jpg\">http:\/\/i964.photobucket.com\/albums\/a...\/gartrepic.jpg<\/a><\/div><\/div>","Email":"kerrij@shaw.ca","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1250884128,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-220796.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"kerrij","Id":220796,"Name":"kerrij","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":false,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"540917e448c42b1edbbf38c3fb93d573","RawContent":"@ mekanabr: \n I have the exact same package prices, so nothing changed since october last year. we chose the cheapest package because we will be getting married in New York before we go there and I try to discuss with Beverly if we can get a discount because we dont need all the official paperwork, etc. \n what package did you chose? do you plan on renting the gazebo for dancing and do you want to have a private reception or just what kerri did?","Attachments":[],"Id":1115981,"PostDate":1271443144,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @ mekanabr: <br \/> I have the exact same package prices, so nothing changed since october last year. we chose the cheapest package because we will be getting married in New York before we go there and I try to discuss with Beverly if we can get a discount because we dont need all the official paperwork, etc. <br \/> what package did you chose? do you plan on renting the gazebo for dancing and do you want to have a private reception or just what kerri did?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"chrissik82@googlemail.com","IpAddress":"","GroupId":5,"GroupName":"Banned","JoinDate":1260680287,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223885.PNG?_r=0","PhotoWidth":150,"PhotoHeight":87,"PhotoType":"custom"},"FormattedName":"christinak82","Id":223885,"Name":"christinak82","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":false,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4651598990098adf7cc98f97c676442f","RawContent":"@ kerri: thanks again for all the info. you said that because of your ceremony time, you were in a rush, right? I try to convince my fiance to move our ceremony to an earlier time but he says he doesnt want to sweat his @ss of if its that early in the afternoon... how was it for you kerri? was it that hot?","Attachments":[],"Id":1115990,"PostDate":1271443267,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @ kerri: thanks again for all the info. you said that because of your ceremony time, you were in a rush, right? I try to convince my fiance to move our ceremony to an earlier time but he says he doesnt want to sweat his @ss of if its that early in the afternoon... how was it for you kerri? was it that hot?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"chrissik82@googlemail.com","IpAddress":"","GroupId":5,"GroupName":"Banned","JoinDate":1260680287,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223885.PNG?_r=0","PhotoWidth":150,"PhotoHeight":87,"PhotoType":"custom"},"FormattedName":"christinak82","Id":223885,"Name":"christinak82","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9e97d605efe14ccc26db6cc344c94bc0","RawContent":"We are booked for Feb 1st @ 3pm ! I&#039;m a little bit nervous about the time of day too... but I think it will be OK...\n \n Sent out invites last week.... so excited!!! \n \n Thanks kerrij for sharing your wedding details with us and answering all of our questions!!","Attachments":[],"Id":1118469,"PostDate":1271635559,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We are booked for Feb 1st @ 3pm ! I'm a little bit nervous about the time of day too... but I think it will be OK...<br \/> <br \/> Sent out invites last week.... so excited!!! <br \/> <br \/> Thanks kerrij for sharing your wedding details with us and answering all of our questions!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jennyslack@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1262229008,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-224208.jpg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"jennypenny23","Id":224208,"Name":"jennypenny23","IsOnline":false}}],"Pages":{"TotalItems":5564,"TotalPages":557,"CurrentPage":60,"NextPage":70,"PreviousPage":50,"LastPage":5560},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
