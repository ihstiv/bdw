ontobemrsdow","Id":223542,"Name":"soontobemrsdow","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ecd9aa312c6e4c547650619b8079b5d2","RawContent":"ahhhhh I looked at your pictures 5 times today kerrij !!!\n Im sooooooooooo excited!!!","Attachments":[],"Id":1129560,"PostDate":1272345876,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                ahhhhh I looked at your pictures 5 times today kerrij !!!<br \/> Im sooooooooooo excited!!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jennyslack@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1262229008,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-224208.jpg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"jennypenny23","Id":224208,"Name":"jennypenny23","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":false,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bdb446fb6b7528477f3b2ec3b0e7cf69","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;jennypenny23&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;ahhhhh I looked at your pictures 5 times today kerrij !!!\n Im sooooooooooo excited!!!&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;me too... I get goose bombs everytime I look at your pictures, kerri... incredibly beautiful... and I love your dress... you are so pretty... thank you so much again for your posts.... \n I would love to see more... it gets me so excited...","Attachments":[],"Id":1130190,"PostDate":1272397902,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>jennypenny23<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">ahhhhh I looked at your pictures 5 times today kerrij !!!<br \/> Im sooooooooooo excited!!!<\/div> <\/td> <\/tr> <\/table> <\/div>me too... I get goose bombs everytime I look at your pictures, kerri... incredibly beautiful... and I love your dress... you are so pretty... thank you so much again for your posts.... <br \/> I would love to see more... it gets me so excited...\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"chrissik82@googlemail.com","IpAddress":"","GroupId":5,"GroupName":"Banned","JoinDate":1260680287,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223885.PNG?_r=0","PhotoWidth":150,"PhotoHeight":87,"PhotoType":"custom"},"FormattedName":"christinak82","Id":223885,"Name":"christinak82","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f2850ab674911887bccfac4a17ae5eb0","RawContent":"Awwww thanks girls!! and you&#039;ll all feel just as beautiful as i did! you can&#039;t go wrong with this resort. and it&#039;s so nice that there are a zillion weddings while you are there, so you feel extra special :)\n The gazebo in real life is amazing! the pics don&#039;t do it justice at all. it&#039;s just so PERFECT!! i&#039;m getting teary eyed just thinking about it...but i am extra emotional today. hehehe\n and the dinner pics...that isn&#039;t the $2500 private room either. that is the one that you get with your dinner...actually there are a couple places they could put you, but i&#039;m sure you could request this one, i think bigger groups always go there, but not sure.\n \n aahhhhh...to be back again! can i just come to all of your weddings please!!! hehehe","Attachments":[],"Id":1130486,"PostDate":1272410719,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Awwww thanks girls!! and you'll all feel just as beautiful as i did! you can't go wrong with this resort. and it's so nice that there are a zillion weddings while you are there, so you feel extra special <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br \/> The gazebo in real life is amazing! the pics don't do it justice at all. it's just so PERFECT!! i'm getting teary eyed just thinking about it...but i am extra emotional today. hehehe<br \/> and the dinner pics...that isn't the $2500 private room either. that is the one that you get with your dinner...actually there are a couple places they could put you, but i'm sure you could request this one, i think bigger groups always go there, but not sure.<br \/> <br \/> aahhhhh...to be back again! can i just come to all of your weddings please!!! hehehe\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/global.thebump.com\/tickers\/tt7a388.aspx\">http:\/\/global.thebump.com\/tickers\/tt7a388.aspx<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/i964.photobucket.com\/albums\/ae129\/mccrady\/gartrepic.jpg\">http:\/\/i964.photobucket.com\/albums\/a...\/gartrepic.jpg<\/a><\/div><\/div>","Email":"kerrij@shaw.ca","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1250884128,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-220796.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"kerrij","Id":220796,"Name":"kerrij","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"af78744da01c70e7de5d0ba30375c4d1","RawContent":"Wow! your pics are amazing Kerri! I have less than 3 weeks to go and I&#039;m so excited to see some pics of your special day! Congrats!!","Attachments":[],"Id":1130879,"PostDate":1272428823,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Wow! your pics are amazing Kerri! I have less than 3 weeks to go and I'm so excited to see some pics of your special day! Congrats!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"stewart_gloria@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1272083499,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-227602.gif?_r=0","PhotoWidth":63,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"sunchick31","Id":227602,"Name":"sunchick31","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ce95a3fd69493307d7c716f4707cb119","RawContent":"sunchick31!!! yay- its soooo close!!! 3 weeks!&lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile123.gif\" border=\"0\" alt=\"\" title=\"Smile123\" class=\"inlineimg\" \/&gt;\n I hope you keep us posted!!! =o) I still have 9 mths to go.... &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile27.gif\" border=\"0\" alt=\"\" title=\"Smile27\" class=\"inlineimg\" \/&gt;","Attachments":[],"Id":1130898,"PostDate":1272429758,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                sunchick31!!! yay- its soooo close!!! 3 weeks!<span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile123.gif\" border=\"0\" alt=\"\" title=\"Smile123\" class=\"inlineimg\" \/><\/span><br \/> I hope you keep us posted!!! =o) I still have 9 mths to go.... <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile27.gif\" border=\"0\" alt=\"\" title=\"Smile27\" class=\"inlineimg\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jennyslack@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1262229008,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-224208.jpg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"jennypenny23","Id":224208,"Name":"jennypenny23","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e5614861b8a20303f422217eef67c027","RawContent":"I&#039;ll definitely keep you guys posted. I wish i had found this website sooner &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/sad.gif\" border=\"0\" alt=\"\" title=\"Sad\" class=\"inlineimg\" \/&gt;.","Attachments":[],"Id":1130913,"PostDate":1272430655,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'll definitely keep you guys posted. I wish i had found this website sooner <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/sad.gif\" border=\"0\" alt=\"\" title=\"Sad\" class=\"inlineimg\" \/><\/span>.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"stewart_gloria@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1272083499,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-227602.gif?_r=0","PhotoWidth":63,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"sunchick31","Id":227602,"Name":"sunchick31","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6397ee418481f15a9e73808f429cac27","RawContent":"BIG congrats kerrij!!! I love your pic and I&#039;m glad you had a perfect wedding!!!\n Did you do a poolside reception?\n \n Scarlett","Attachments":[],"Id":1133809,"PostDate":1272615395,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                BIG congrats kerrij!!! I love your pic and I'm glad you had a perfect wedding!!!<br \/> Did you do a poolside reception?<br \/> <br \/> Scarlett\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Scarlett<\/span><\/div><\/div>","Email":"littlegeebee@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1259319056,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223555.gif?_r=0","PhotoWidth":66,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"swong","Id":223555,"Name":"swong","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a0278cee5c8094736da415db20f8b6db","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;swong&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;BIG congrats kerrij!!! I love your pic and I&#039;m glad you had a perfect wedding!!!\n Did you do a poolside reception?\n \n Scarlett&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;Thanks! They actually don&#039;t do pool side receptions &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/sad.gif\" border=\"0\" alt=\"\" title=\"Sad\" class=\"inlineimg\" \/&gt;\n maybe you could have your champagne poolside. but I asked about having our dinner and stuff outdoors and they don&#039;t allow it due to health regulations or something.","Attachments":[],"Id":1134590,"PostDate":1272678106,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>swong<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">BIG congrats kerrij!!! I love your pic and I'm glad you had a perfect wedding!!!<br \/> Did you do a poolside reception?<br \/> <br \/> Scarlett<\/div> <\/td> <\/tr> <\/table> <\/div>Thanks! They actually don't do pool side receptions <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/sad.gif\" border=\"0\" alt=\"\" title=\"Sad\" class=\"inlineimg\" \/><\/span><br \/> maybe you could have your champagne poolside. but I asked about having our dinner and stuff outdoors and they don't allow it due to health regulations or something.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/global.thebump.com\/tickers\/tt7a388.aspx\">http:\/\/global.thebump.com\/tickers\/tt7a388.aspx<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/i964.photobucket.com\/albums\/ae129\/mccrady\/gartrepic.jpg\">http:\/\/i964.photobucket.com\/albums\/a...\/gartrepic.jpg<\/a><\/div><\/div>","Email":"kerrij@shaw.ca","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1250884128,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-220796.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"kerrij","Id":220796,"Name":"kerrij","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b374143205289495b0cf00b98cab1bfc","RawContent":"Kerrij, your pics are beautiful. I am narrowing down my choices between here and ROR. The wedding gazebo looks stunning.","Attachments":[],"Id":1135242,"PostDate":1272763264,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Kerrij, your pics are beautiful. I am narrowing down my choices between here and ROR. The wedding gazebo looks stunning.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Leez309@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1270521853,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-227075.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"FormattedName":"Leez309","Id":227075,"Name":"Leez309","IsOnline":false}}],"Pages":{"TotalItems":5564,"TotalPages":557,"CurrentPage":80,"NextPage":90,"PreviousPage":70,"LastPage":5560},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
