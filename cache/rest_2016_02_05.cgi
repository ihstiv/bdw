stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.113.233.65","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78815,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"923f8b5d0cd22b51519eee24513d3aeb","RawContent":"&lt;p&gt;I got all my bouquets and bouts from Bloom Bridal - they were really fantastic&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"http:\/\/s14.postimg.org\/72xf79x1d\/Flowers.png\" alt=\"Flowers.png\"&gt;&lt;\/p&gt;","Attachments":[],"Id":1886934,"PostDate":1424404997,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I got all my bouquets and bouts from Bloom Bridal - they were really fantastic<\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/s14.postimg.org\/72xf79x1d\/Flowers.png\" alt=\"Flowers.png\"><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Married December 19, 2014 at Beach Palace Resort in Cancun, Mexico<\/p>\n<p>\u00a0<\/p>\n<p>My Planning Thread - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/'>http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>My Wedding Review<\/p>\n<p>Part 1 - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881197'>http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881197<\/a><\/p>\n<p>Part 2 - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881590'>http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881590<\/a><\/p>\n<p>Part 3 - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881861'>http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881861<\/a><\/p>\n<p>\u00a0","Email":"lilyluu83@gmail.com","IpAddress":"174.119.162.30","GroupId":3,"GroupName":"Member","JoinDate":1395609348,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277296.jpg?_r=1421643766","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"tygrrlily","Id":277296,"Name":"tygrrlily","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.100.61.37","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78815,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"d48ab13d86463e7a605ae745c6e98ca5","RawContent":"&lt;p&gt;I used &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.plumeriasweddingflowerboutique.com\/&#039;&gt;Plumerias Wedding Flower Boutique&lt;\/a&gt; -- but I also got married back in 2009 and so it&#039;s a different owner now. But I believe the quality hasn&#039;t changed! They were awesome and no one could believe my flowers weren&#039;t real :)&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"http:\/\/i287.photobucket.com\/albums\/ll150\/msam007562\/Plumeria%20Wedding%20Flowers\/mariesam_tommy_1460.jpg\" alt=\"mariesam_tommy_1460.jpg\"&gt;&lt;\/p&gt;","Attachments":[],"Id":1886941,"PostDate":1424419332,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I used <a href='http:\/\/www.plumeriasweddingflowerboutique.com\/' class='bbc_url' title='External link' rel='nofollow external'>Plumerias Wedding Flower Boutique<\/a> -- but I also got married back in 2009 and so it's a different owner now. But I believe the quality hasn't changed! They were awesome and no one could believe my flowers weren't real <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i287.photobucket.com\/albums\/ll150\/msam007562\/Plumeria%20Wedding%20Flowers\/mariesam_tommy_1460.jpg\" alt=\"mariesam_tommy_1460.jpg\"><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-size:18px;\"><span style=\"font-family:georgia;\"><strong>MARIESAM SANCHEZ PHOTOGRAPHY<\/strong><\/span><\/span><br>\nWEBSITE: <a  class=\"bbc_url\" href=\"http:\/\/www.mariesamsanchez.com\">www.mariesamsanchez.com<\/a><br>\nBLOG: <a  class=\"bbc_url\" href=\"http:\/\/www.mariesamsanchezblog.com\">www.mariesamsanchez.com<\/a><a data-ipb='nomediapar