{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":41,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":3206,"MovedTo":null,"MovedOn":0,"FirstPostId":1893005,"Rating":0,"RatingHits":0,"Starter":{"Id":277519,"Name":"veryvalentine","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277519.jpg?_r=1439827749","PhotoWidth":200,"PhotoHeight":132,"PhotoType":"custom"},"IsOnline":false},"StartDate":1429016943,"LastPoster":{"Id":277044,"Name":"smileitseb","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277044.jpg?_r=1432531828","PhotoWidth":200,"PhotoHeight":241,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":43,"Preview":{"Id":1893005,"PostDate":1429016943,"PostContent":"Hello lovely brides and brides-to-be! \u00a0 I am thinking of having sparklers at our wedding.\u00a0 We get...","Author":{"Signature":"<div><br><div>\u00a0<\/div>\n<div>\u00a0<\/div>\n<div>Married on June 20th, 2015 at the Grand Sunset Princess Riviera Gazebo & Reception at the Chill Out with 60 guests<\/div>\n<div>\u00a0<\/div>\n<\/div>\n<div>\u00a0<\/div>\n<p>My planning thread:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/<\/a><\/p>\n<p>My review thread: \u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/<\/a>","Email":"rebecca.valero@gmail.com","IpAddress":"38.112.94.76","GroupId":3,"GroupName":"Member","JoinDate":1396982852,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277519.jpg?_r=1439827749","PhotoWidth":200,"PhotoHeight":132,"PhotoType":"custom"},"FormattedName":"veryvalentine","Id":277519,"Name":"veryvalentine","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"38.112.94.76","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79058,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"e6b7a7a2055a4c5c01a3b72adf4e94d9","RawContent":"&lt;p&gt;Hello lovely brides and brides-to-be!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am thinking of having sparklers at our wedding.&amp;nbsp; We get married this June in the Mayan Riviera.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;My idea was to have everyone light up their sparklers during our first dance.&amp;nbsp; I am going to make little tags that say \"let love sparkle\" or \"let amor sparkle\" since we are trying to do things a little \"Spanglish\"&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Does anyone know where you can buy Sparklers in the mayan Riviera?&amp;nbsp; I&#039;m guessing the Walmart there would have them?? But just wondering if anyone else has succeeded with this.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Also, for any past brides, do you think the sparkler light up would be distracting during the first dance.&amp;nbsp; I don&#039;t expect everyone&#039;s undivided attention but I&#039;m hoping that for pictures there are enough sparklers to make it pretty.&amp;nbsp; At least for sure it would draw a crowd that way.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Would love to hear your thoughts!&amp;nbsp; :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1893005,"PostDate":1429016943,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello lovely brides and brides-to-be!<\/p>\n<p>\u00a0<\/p>\n<p>I am thinking of having sparklers at our wedding.\u00a0 We get married this June in the Mayan Riviera.<\/p>\n<p>\u00a0<\/p>\n<p>My idea was to have everyone light up their sparklers during our first dance.\u00a0 I am going to make little tags that say \"let love sparkle\" or \"let amor sparkle\" since we are trying to do things a little \"Spanglish\"<\/p>\n<p>\u00a0<\/p>\n<p>Does anyone know where you can buy Sparklers in the mayan Riviera?\u00a0 I'm guessing the Walmart there would have them?? But just wondering if anyone else has succeeded with this.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Also, for any past brides, do you think the sparkler light up would be distracting during the first dance.\u00a0 I don't expect everyone's undivided attention but I'm hoping that for pictures there are enough sparklers to make it pretty.\u00a0 At least for sure it would draw a crowd that way.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Would love to hear your thoughts!\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div><br><div>\u00a0<\/div>\n<div>\u00a0<\/div>\n<div>Married on June 20th, 2015 at the Grand Sunset Princess Riviera Gazebo & Reception at the Chill Out with 60 guests<\/div>\n<div>\u00a0<\/div>\n<\/div>\n<div>\u00a0<\/div>\n<p>My planning thread:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/<\/a><\/p>\n<p>My review thread: \u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/<\/a>","Email":"rebecca.valero@gmail.com","IpAddress":"38.112.94.76","GroupId":3,"GroupName":"Member","JoinDate":1396982852,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277519.jpg?_r=1439827749","PhotoWidth":200,"PhotoHeight":132,"PhotoType":"custom"},"FormattedName":"veryvalentine","Id":277519,"Name":"veryvalentine","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"216.84.102.233","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79058,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"1233b5468a7fb0a06de72165d7cc2d0f","RawContent":"&lt;p&gt;@[member=\"veryvalentine\"] check with your resort, we are getting our sparklers directly from them for $2 each! could prob find them cheaper tho&lt;\/p&gt;","Attachments":[],"Id":1893014,"PostDate":1429019392,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"277519\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/277519-veryvalentine\/' title='Member profile'><span itemprop=\"name\">veryvalentine<\/span><\/a> check with your resort, we are getting our sparklers directly from them for $2 each! could prob find them cheaper tho<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>58 guests plus bride and groom<br>\nCeremony: Gazebo<br>\nReception: Pool Deck","Email":"smileitseb@gmail.com","IpAddress":"50.90.104.129","GroupId":40,"GroupName":"Jr. Member","JoinDate":1394223869,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277044.jpg?_r=1432531828","PhotoWidth":200,"PhotoHeight":241,"PhotoType":"custom"},"FormattedName":"smileitseb","Id":277044,"Name":"smileitseb","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"38.112.94.76","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79058,"EditedBy":"<strong>Edited by veryvalentine, 14 April 2015 - 05:59 AM.<\/strong>","EditDate":1429019955,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"13be615258693857bd6f6783aaf97b03","RawContent":"&lt;p&gt;Thanks @[member=\"smileitseb\"] ! ;)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I found a decorator in Playa del Carmen that can sell them to me for $1 Canadian each.&amp;nbsp; I&#039;m thinking of buying about 80 so I was hoping to buy them in packs as I don&#039;t want to spend $80 on sparklers...that could be money I could spend on flowers.&amp;nbsp; *sigh*&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;@[member=\"calgarybride2015\"] did you do sparklers?&amp;nbsp; I&#039;m wondering what the best time would be for them.&amp;nbsp; I&#039;ve seen some brides do a send off.&amp;nbsp; Maybe we could do it at the end when we leave?&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1893019,"PostDate":1429019754,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thanks @<a hovercard-ref=\"member\" hovercard-id=\"277044\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/277044-smileitseb\/' title='Member profile'><span itemprop=\"name\">smileitseb<\/span><\/a> ! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/><\/p>\n<p>\u00a0<\/p>\n<p>I found a decorator in Playa del Carmen that can sell them to me for $1 Canadian each.\u00a0 I'm thinking of buying about 80 so I was hoping to buy them in packs as I don't want to spend $80 on sparklers...that could be money I could spend on flowers.\u00a0 *sigh*<\/p>\n<p>\u00a0<\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"277873\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/277873-calgarybride2015\/' title='Member profile'><span itemprop=\"name\">calgarybride2015<\/span><\/a> did you do sparklers?\u00a0 I'm wondering what the best time would be for them.\u00a0 I've seen some brides do a send off.\u00a0 Maybe we could do it at the end when we leave?\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div><br><div>\u00a0<\/div>\n<div>\u00a0<\/div>\n<div>Married on June 20th, 2015 at the Grand Sunset Princess Riviera Gazebo & Reception at the Chill Out with 60 guests<\/div>\n<div>\u00a0<\/div>\n<\/div>\n<div>\u00a0<\/div>\n<p>My planning thread:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/<\/a><\/p>\n<p>My review thread: \u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/<\/a>","Email":"rebecca.valero@gmail.com","IpAddress":"38.112.94.76","GroupId":3,"GroupName":"Member","JoinDate":1396982852,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277519.jpg?_r=1439827749","PhotoWidth":200,"PhotoHeight":132,"PhotoType":"custom"},"FormattedName":"veryvalentine","Id":277519,"Name":"veryvalentine","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.41.59","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79058,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"c5789517fc1236320adc9b5ecc78968e","RawContent":"[quote name=\"veryvalentine\" post=\"1893019\" timestamp=\"1429019754\"]\nThanks @[member=\"smileitseb\"] ! ;)\n\nI found a decorator in Playa del Carmen that can sell them to me for $1 Canadian each.  I&#039;m thinking of buying about 80 so I was hoping to buy them in packs as I don&#039;t want to spend $80 on sparklers...that could be money I could spend on flowers.  *sigh*\n\n@[member=\"calgarybride2015\"] did you do sparklers?  I&#039;m wondering what the best time would be for them.  I&#039;ve seen some brides to a send off.  Maybe we could do it at the end when we leave?[\/quote]\nNo I didn&#039;t do sparklers.    \nTiming would depend on a few things -- will you leave before everyone else?  we closed down the party, so by that time a lot of the older folk had left as well as some of the quieter crowd (ie not party animals) so there wouldn&#039;t have been everyone to enjoy it.  With that said, maybe a couple ideas:  first dance, entrance into reception\n\nRead your other post, I actually think the sparklers would keep people&#039;s attention on the dance, because it adds some fun!  hahah seriously I am sure only 1\/2 of my guests watched the whole first dance.    And you will be so in your own world you won&#039;t even notice them - you will see them, then you will forget they are there! Would make for some pretty pictures :)\n\nWhere to buy them? no idea, the only bride I can think of on here who used them also rented her decor from the lady in PDC and if memory serves me correct, she got them for the bride.  I would assume Walmart would sell them, but maybe as your WC?\n\nHope that helps some!","Attachments":[],"Id":1893020,"PostDate":1429020051,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>veryvalentine, on 14 April 2015 - 05:55 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Thanks @<a hovercard-ref=\"member\" hovercard-id=\"277044\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/277044-smileitseb\/' title='Member profile'><span itemprop=\"name\">smileitseb<\/span><\/a> ! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/><\/p>\n<p>\u00a0<\/p>\n<p>I found a decorator in Playa del Carmen that can sell them to me for $1 Canadian each.\u00a0 I'm thinking of buying about 80 so I was hoping to buy them in packs as I don't want to spend $80 on sparklers...that could be money I could spend on flowers.\u00a0 *sigh*<\/p>\n<p>\u00a0<\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"277873\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/277873-calgarybride2015\/' title='Member profile'><span itemprop=\"name\">calgarybride2015<\/span><\/a> did you do sparklers?\u00a0 I'm wondering what the best time would be for them.\u00a0 I've seen some brides to a send off.\u00a0 Maybe we could do it at the end when we leave?\u00a0<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>No I didn't do sparklers. \u00a0 \u00a0<\/p>\n<p>Timing would depend on a few things -- will you leave before everyone else? \u00a0we closed down the party, so by that time a lot of the older folk had left as well as some of the quieter crowd (ie not party animals) so there wouldn't have been everyone to enjoy it. \u00a0With that said, maybe a couple ideas: \u00a0first dance, entrance into reception<\/p>\n<p>\u00a0<\/p>\n<p>Read your other post, I actually think the sparklers would keep people's attention on the dance, because it adds some fun! \u00a0hahah seriously I am sure only 1\/2 of my guests watched the whole first dance. \u00a0 \u00a0And you will be so in your own world you won't even notice them - you will see them, then you will forget they are there! Would make for some pretty pictures <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Where to buy them? no idea, the only bride I can think of on here who used them also rented her decor from the lady in PDC and if memory serves me correct, she got them for the bride. \u00a0I would assume Walmart would sell them, but maybe as your WC?<\/p>\n<p>\u00a0<\/p>\n<p>Hope that helps some!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399428602,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"38.112.94.76","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79058,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8fed9f4739209746e09a056bd471e0f7","RawContent":"&lt;p&gt;@[member=\"calgarybride2015\"]&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;thanks so much for the advice!&amp;nbsp; I think you are right, first dance would be perfect.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I usually don&#039;t pay attention to first dance myself...but if I can participate or feel a part of it by lighting a sparkler it certainly would keep me more focused!&amp;nbsp; I&#039;m going to go with this idea!   the tags I&#039;m making will say \"let amor sparkle\"&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I was actually going to ask you...what was it like at the end of the night?&amp;nbsp; I know we are with different hotels..but did you have to do anything?&amp;nbsp; like deal with the WC?&amp;nbsp; Did they take down the d\u00e9cor?&amp;nbsp; I&#039;m used to local weddings where the bride and groom come back the next day or family comes back and takes down some of the d\u00e9cor etc etc.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1893023,"PostDate":1429020324,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"277873\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/277873-calgarybride2015\/' title='Member profile'><span itemprop=\"name\">calgarybride2015<\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>thanks so much for the advice!\u00a0 I think you are right, first dance would be perfect.\u00a0<\/p>\n<p>I usually don't pay attention to first dance myself...but if I can participate or feel a part of it by lighting a sparkler it certainly would keep me more focused!\u00a0 I'm going to go with this idea!\u00a0\u00a0 the tags I'm making will say \"let amor sparkle\"<\/p>\n<p>\u00a0<\/p>\n<p>I was actually going to ask you...what was it like at the end of the night?\u00a0 I know we are with different hotels..but did you have to do anything?\u00a0 like deal with the WC?\u00a0 Did they take down the d\u00e9cor?\u00a0 I'm used to local weddings where the bride and groom come back the next day or family comes back and takes down some of the d\u00e9cor etc etc.\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div><br><div>\u00a0<\/div>\n<div>\u00a0<\/div>\n<div>Married on June 20th, 2015 at the Grand Sunset Princess Riviera Gazebo & Reception at the Chill Out with 60 guests<\/div>\n<div>\u00a0<\/div>\n<\/div>\n<div>\u00a0<\/div>\n<p>My planning thread:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/<\/a><\/p>\n<p>My review thread: \u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/<\/a>","Email":"rebecca.valero@gmail.com","IpAddress":"38.112.94.76","GroupId":3,"GroupName":"Member","JoinDate":1396982852,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277519.jpg?_r=1439827749","PhotoWidth":200,"PhotoHeight":132,"PhotoType":"custom"},"FormattedName":"veryvalentine","Id":277519,"Name":"veryvalentine","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"216.84.102.233","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79058,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"6993f3ba3b9f97e1a84a0938571cac5e","RawContent":"&lt;p&gt;@[member=\"veryvalentine\"] I&#039;m doing a sendoff but I really love your idea of let love sparkle during the first dance. It will make for some magical pictures :)&lt;\/p&gt;","Attachments":[],"Id":1893026,"PostDate":1429020872,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"277519\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/277519-veryvalentine\/' title='Member profile'><span itemprop=\"name\">veryvalentine<\/span><\/a> I'm doing a sendoff but I really love your idea of let love sparkle during the first dance. It will make for some magical pictures <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>58 guests plus bride and groom<br>\nCeremony: Gazebo<br>\nReception: Pool Deck","Email":"smileitseb@gmail.com","IpAddress":"50.90.104.129","GroupId":40,"GroupName":"Jr. Member","JoinDate":1394223869,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277044.jpg?_r=1432531828","PhotoWidth":200,"PhotoHeight":241,"PhotoType":"custom"},"FormattedName":"smileitseb","Id":277044,"Name":"smileitseb","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"38.112.94.76","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79058,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"60fa42869aba8816ef7cf77c0908dad6","RawContent":"&lt;p&gt;@[member=\"smileitseb\"]&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I think so too.&amp;nbsp; I at first considered the send off...but I&#039;m picturing a circle on the beach with sparklers and I think it&#039;s gonna look amazing if the timing is right.&amp;nbsp; Our song is really short.&amp;nbsp; 2-3 mins...so that&#039;s enough time I think.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;As CalgaryBride2015 mentioned...who knows if everyone will stick around at the end...and who knows if people will be sober enough operate a lighter?&amp;nbsp; hahahah.&lt;\/p&gt;","Attachments":[],"Id":1893028,"PostDate":1429021056,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"277044\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/277044-smileitseb\/' title='Member profile'><span itemprop=\"name\">smileitseb<\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>I think so too.\u00a0 I at first considered the send off...but I'm picturing a circle on the beach with sparklers and I think it's gonna look amazing if the timing is right.\u00a0 Our song is really short.\u00a0 2-3 mins...so that's enough time I think.<\/p>\n<p>\u00a0<\/p>\n<p>As CalgaryBride2015 mentioned...who knows if everyone will stick around at the end...and who knows if people will be sober enough operate a lighter?\u00a0 hahahah.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div><br><div>\u00a0<\/div>\n<div>\u00a0<\/div>\n<div>Married on June 20th, 2015 at the Grand Sunset Princess Riviera Gazebo & Reception at the Chill Out with 60 guests<\/div>\n<div>\u00a0<\/div>\n<\/div>\n<div>\u00a0<\/div>\n<p>My planning thread:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/<\/a><\/p>\n<p>My review thread: \u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/<\/a>","Email":"rebecca.valero@gmail.com","IpAddress":"38.112.94.76","GroupId":3,"GroupName":"Member","JoinDate":1396982852,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277519.jpg?_r=1439827749","PhotoWidth":200,"PhotoHeight":132,"PhotoType":"custom"},"FormattedName":"veryvalentine","Id":277519,"Name":"veryvalentine","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79058,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8ea1722cdf81d3fe8c7fb05356ccfc90","RawContent":"&lt;p&gt;Cute! We are doing the same thing as well. I actually contacted one of my vendors (my photographer) and he is going to get them for me at the cost price (not charging me anything extra on top). I think i&#039;m paying around $30 USD&amp;nbsp;for 30 of them and they are the extra long sparklers.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Ps. Any idea how you plan on having everyone light them at the same time? I&#039;ve been thinking about this.&lt;\/p&gt;","Attachments":[],"Id":1893033,"PostDate":1429021522,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Cute! We are doing the same thing as well. I actually contacted one of my vendors (my photographer) and he is going to get them for me at the cost price (not charging me anything extra on top). I think i'm paying around $30 USD\u00a0for 30 of them and they are the extra long sparklers.<\/p>\n<p>\u00a0<\/p>\n<p>Ps. Any idea how you plan on having everyone light them at the same time? I've been thinking about this.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419437814,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1453235488","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"154.20.36.21","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79058,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1cdd6661d7dad2951d2b6de5ada3c9ff","RawContent":"&lt;p&gt;Can you buy them before you leave and bring them with you? Would probably save you a lot of money! And they are small enough should fit into your suitcase! :)&lt;\/p&gt;","Attachments":[],"Id":1893035,"PostDate":1429021741,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Can you buy them before you leave and bring them with you? Would probably save you a lot of money! And they are small enough should fit into your suitcase! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"millar_devon@hotmail.com","IpAddress":"154.20.36.21","GroupId":39,"GroupName":"Newbie","JoinDate":1423329313,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282027.jpg?_r=1429713632","PhotoWidth":169,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Victoriabride","Id":282027,"Name":"Victoriabride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"216.84.102.233","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79058,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"9f225cd89b23f897d4b47cc1e5c0aafe","RawContent":"&lt;p&gt;@[member=\"Victoriabride\"] you can&#039;t take sparklers on the plane :\/&lt;\/p&gt;","Attachments":[],"Id":1893038,"PostDate":1429022709,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"282027\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/282027-victoriabride\/' title='Member profile'><span itemprop=\"name\">Victoriabride<\/span><\/a> you can't take sparklers on the plane :\/<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>58 guests plus bride and groom<br>\nCeremony: Gazebo<br>\nReception: Pool Deck","Email":"smileitseb@gmail.com","IpAddress":"50.90.104.129","GroupId":40,"GroupName":"Jr. Member","JoinDate":1394223869,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277044.jpg?_r=1432531828","PhotoWidth":200,"PhotoHeight":241,"PhotoType":"custom"},"FormattedName":"smileitseb","Id":277044,"Name":"smileitseb","IsOnline":false}}],"Id":"79058","Title":"Sparklers! (Reception, First Dance)","LastPostDate":1431465064},"Pages":{"TotalItems":41,"TotalPages":5,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":40},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
