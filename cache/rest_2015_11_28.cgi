{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":11,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":1695,"MovedTo":null,"MovedOn":0,"FirstPostId":1892824,"Rating":0,"RatingHits":0,"Starter":{"Id":282082,"Name":"jnvoigt","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282082.jpg?_r=1428850100","PhotoWidth":200,"PhotoHeight":146,"PhotoType":"custom"},"IsOnline":false},"StartDate":1428849674,"LastPoster":{"Id":279112,"Name":"alwalters625","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279112.jpg?_r=1442449277","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":22,"Preview":{"Id":1892824,"PostDate":1428849674,"PostContent":"Hey there Everyone ! \u00a0 We just got back and I have a full review of the resort along with picture...","Author":{"Signature":"","Email":"jnvoigt@yahoo.com","IpAddress":"66.56.187.156","GroupId":39,"GroupName":"Newbie","JoinDate":1423663207,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282082.jpg?_r=1428850100","PhotoWidth":200,"PhotoHeight":146,"PhotoType":"custom"},"FormattedName":"jnvoigt","Id":282082,"Name":"jnvoigt","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.56.187.156","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79050,"EditedBy":"<strong>Edited by jnvoigt, 12 April 2015 - 06:47 AM.<\/strong>","EditDate":1428850036,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"904f23dc3eb65a0fb66bf7b2e64a845d","RawContent":"&lt;p&gt;Hey there Everyone !&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We just got back and I have a full review of the resort along with pictures and the wedding process and lots of helpful tricks for your trip and planning&lt;\/p&gt;\n&lt;p&gt;I couldn&#039;t get the paste from word function to work so I attached the review entitled Blog below&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Bring on any questions you may have and I included templates for OOT bag stuff here too !&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Hope this helps everyone and it was amazing so hope your special day is just as great !&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;xoxo&lt;\/p&gt;\n&lt;p&gt;Jess&lt;\/p&gt;","Attachments":[{"Id":31538,"Name":"original-monograms_2014_May_7079-1132090.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_04_2015\/post-282082-0-74177300-1428849586.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_04_2015\/post-282082-0-74177300-1428849586_thumb.jpg","Width":1000,"Height":778},{"Id":31541,"Name":"ry=4002WT0VGKI.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_04_2015\/post-282082-0-73423600-1428849961.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_04_2015\/post-282082-0-73423600-1428849961_thumb.jpg","Width":550,"Height":400},{"Id":31542,"Name":"ry=400CBP8O5C8.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_04_2015\/post-282082-0-20687800-1428849999.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_04_2015\/post-282082-0-20687800-1428849999_thumb.jpg","Width":550,"Height":400},{"Id":31543,"Name":"ry=400CHY4IN1P.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_04_2015\/post-282082-0-78156600-1428850001.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_04_2015\/post-282082-0-78156600-1428850001_thumb.jpg","Width":550,"Height":400},{"Id":31544,"Name":"ry=400TMPMJ5SM.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_04_2015\/post-282082-0-61761400-1428850027.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_04_2015\/post-282082-0-61761400-1428850027_thumb.jpg","Width":550,"Height":400},{"Id":31545,"Name":"ry=4006LYZYBFJ.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_04_2015\/post-282082-0-36258900-1428850028.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_04_2015\/post-282082-0-36258900-1428850028_thumb.jpg","Width":550,"Height":400},{"Id":31546,"Name":"ry=400493VEFAP.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_04_2015\/post-282082-0-02512800-1428850029.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_04_2015\/post-282082-0-02512800-1428850029_thumb.jpg","Width":550,"Height":400},{"Id":31547,"Name":"ry=400ODRRWDE2.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_04_2015\/post-282082-0-33290400-1428850030.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_04_2015\/post-282082-0-33290400-1428850030_thumb.jpg","Width":550,"Height":400}],"Id":1892824,"PostDate":1428849674,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hey there Everyone !<\/p>\n<p>\u00a0<\/p>\n<p>We just got back and I have a full review of the resort along with pictures and the wedding process and lots of helpful tricks for your trip and planning<\/p>\n<p>I couldn't get the paste from word function to work so I attached the review entitled Blog below<\/p>\n<p>\u00a0<\/p>\n<p>Bring on any questions you may have and I included templates for OOT bag stuff here too !<\/p>\n<p>\u00a0<\/p>\n<p>Hope this helps everyone and it was amazing so hope your special day is just as great !<\/p>\n<p>\u00a0<\/p>\n<p>xoxo<\/p>\n<p>Jess<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jnvoigt@yahoo.com","IpAddress":"66.56.187.156","GroupId":39,"GroupName":"Newbie","JoinDate":1423663207,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282082.jpg?_r=1428850100","PhotoWidth":200,"PhotoHeight":146,"PhotoType":"custom"},"FormattedName":"jnvoigt","Id":282082,"Name":"jnvoigt","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.65.74.207","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79050,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"34ef3a57f4d1507344ad388422df157f","RawContent":"&lt;p&gt;This is so helpful - thank you very much for sharing!&lt;\/p&gt;","Attachments":[],"Id":1892832,"PostDate":1428859532,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>This is so helpful - thank you very much for sharing!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ashley225@gmail.com","IpAddress":"66.87.117.140","GroupId":39,"GroupName":"Newbie","JoinDate":1426945785,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282492.jpg?_r=1447288455","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"AshleyNYC323","Id":282492,"Name":"AshleyNYC323","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"156.57.21.15","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79050,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ff1355ddfec918113d5a0fd5cc0e69d3","RawContent":"&lt;p&gt;I can&#039;t view any of your attachments, is there anyway you can you email me directly - VERY interested!!! &amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;danamarielouise@hotmail.com&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;THANKS!!!&lt;\/p&gt;","Attachments":[],"Id":1892843,"PostDate":1428869158,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I can't view any of your attachments, is there anyway you can you email me directly - VERY interested!!! \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>danamarielouise@hotmail.com<\/p>\n<p>\u00a0<\/p>\n<p>THANKS!!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"danamarielouise@hotmail.com","IpAddress":"24.89.226.42","GroupId":39,"GroupName":"Newbie","JoinDate":1393275767,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Danamarielouise","Id":276863,"Name":"Danamarielouise","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"73.43.251.19","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79050,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9e1a15875b693d08d72d735d87e6670b","RawContent":"@[member=\"jnvoigt\"] Thanks so much for posting! I can&#039;t open the attachments. Can you please email them to me at rebeccalightsey@yahoo.com? Thank you!!!","Attachments":[],"Id":1893135,"PostDate":1429056380,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"282082\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282082-jnvoigt\/' title='Member profile'><span itemprop=\"name\">jnvoigt<\/span><\/a> Thanks so much for posting! I can't open the attachments. Can you please email them to me at rebeccalightsey@yahoo.com? Thank you!!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rebeccalightsey@yahoo.com","IpAddress":"74.190.197.204","GroupId":39,"GroupName":"Newbie","JoinDate":1405554263,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279045.jpg?_r=1434956018","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"RebeLight","Id":279045,"Name":"RebeLight","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.94.109.103","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79050,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b160b30b45f81b14e813500ca187622e","RawContent":"I would also love to see everything! If you wouldnt mind...my email is jaspbri0317@aol.com thank you [emoji2]","Attachments":[],"Id":1893159,"PostDate":1429068530,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I would also love to see everything! If you wouldnt mind...my email is jaspbri0317@aol.com thank you [emoji2] \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jaspbri0317@aol.com","IpAddress":"71.58.144.195","GroupId":39,"GroupName":"Newbie","JoinDate":1296688027,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-236302.jpg?_r=1429022808","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"jaspbri0317","Id":236302,"Name":"jaspbri0317","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"206.74.64.116","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79050,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"607356033be3aa092c816e0df5b9789b","RawContent":"&lt;p&gt;@&lt;span&gt;&lt;a  class=\"\" href=\"http:\/\/www.bestdestinationwedding.com\/user\/282082-jnvoigt\/\" title=\"\"&gt;&lt;span&gt;jnvoigt&lt;\/span&gt;&lt;\/a&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thank you so much for sharing! You had the cutest ideas!!&amp;nbsp; Looks like you had an amazing wedding!&amp;nbsp; Its so funny you said that about the dress, because I just posted on here about flying with your dress!!&amp;nbsp; I have one- question?&amp;nbsp; How did you do with the heat?&amp;nbsp; Were your guests very hot sitting in the sun during the ceremony.&amp;nbsp; How was the reception outdoors?&amp;nbsp; Thank you so much!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Christine&lt;\/p&gt;","Attachments":[],"Id":1893590,"PostDate":1429424104,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<span><a href='http:\/\/www.bestdestinationwedding.com\/user\/282082-jnvoigt\/' class='bbc_url' title=''><span>jnvoigt<\/span><\/a><\/span><\/p>\n<p>\u00a0<\/p>\n<p>Thank you so much for sharing! You had the cutest ideas!!\u00a0 Looks like you had an amazing wedding!\u00a0 Its so funny you said that about the dress, because I just posted on here about flying with your dress!!\u00a0 I have one- question?\u00a0 How did you do with the heat?\u00a0 Were your guests very hot sitting in the sun during the ceremony.\u00a0 How was the reception outdoors?\u00a0 Thank you so much!<\/p>\n<p>\u00a0<\/p>\n<p>Christine<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cwright1320@yahoo.com","IpAddress":"72.230.115.231","GroupId":39,"GroupName":"Newbie","JoinDate":1388165078,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Cwright","Id":275744,"Name":"Cwright","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"98.25.136.128","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79050,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"64dcca95979dc28396a39e7cfa2a68b2","RawContent":"Hey Christine\n\nThanks and yes it was ! The heat was only bad at the ceremony  which was at 430 pm and it felt like it was beating on us. I gave everyone paper fans so they were ok but we were hot. My hubby was sweating when he walked back down the Isle with me for sure ! But as soon as we were done and could get some shade we were good. The reception was great and it didn&#039;t feel too hot at all. Some guys did change to shorts though !\n\nHope that helps and good luck with the planning !","Attachments":[],"Id":1893871,"PostDate":1429663525,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hey Christine<br>\nThanks and yes it was ! The heat was only bad at the ceremony  which was at 430 pm and it felt like it was beating on us. I gave everyone paper fans so they were ok but we were hot. My hubby was sweating when he walked back down the Isle with me for sure ! But as soon as we were done and could get some shade we were good. The reception was great and it didn't feel too hot at all. Some guys did change to shorts though !<br>\nHope that helps and good luck with the planning !\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jnvoigt@yahoo.com","IpAddress":"66.56.187.156","GroupId":39,"GroupName":"Newbie","JoinDate":1423663207,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282082.jpg?_r=1428850100","PhotoWidth":200,"PhotoHeight":146,"PhotoType":"custom"},"FormattedName":"jnvoigt","Id":282082,"Name":"jnvoigt","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.90.27.19","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79050,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a86030e1175449a81915c0f63f6a6d8b","RawContent":"&lt;p&gt;Hey Jess-&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp; I couldn&#039;t open the attachments either. &amp;nbsp;Mind emailing them to me? &amp;nbsp;Becksnfx@[member=\"gmail\"].com. &amp;nbsp;I&#039;m an April 2016 bride.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thanks!&lt;\/p&gt;","Attachments":[],"Id":1896662,"PostDate":1432137779,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hey Jess-<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0 I couldn't open the attachments either. \u00a0Mind emailing them to me? \u00a0Becksnfx@<a hovercard-ref=\"member\" hovercard-id=\"219734\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/219734-gmail\/' title='Member profile'><span itemprop=\"name\">gmail<\/span><\/a>.com. \u00a0I'm an April 2016 bride.<\/p>\n<p>\u00a0<\/p>\n<p>Thanks!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"becksnfx@gmail.com","IpAddress":"70.90.27.19","GroupId":39,"GroupName":"Newbie","JoinDate":1432137628,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"becksnfx","Id":283173,"Name":"becksnfx","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"204.63.55.228","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79050,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5f2374e0b6c047672bf3126c35b7984a","RawContent":"&lt;p&gt;@[member=\"jnvoigt\"] &amp;nbsp;Hi Jess, Congratulations!!! Thank you so much for posting this and being so detailed. I&#039;m sure we all appreciate it! :)&lt;\/p&gt;\n&lt;p&gt;I&#039;m getting married here April 29, 2016 and have been having a ton of anxiety...reading your post has eased some of my nerves. Thank you isn&#039;t enough!! May I ask that you also email me too at itsjustmetrish@[member=\"gmail\"].com I truly appreciate it!!&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1902379,"PostDate":1439411579,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"282082\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282082-jnvoigt\/' title='Member profile'><span itemprop=\"name\">jnvoigt<\/span><\/a> \u00a0Hi Jess, Congratulations!!! Thank you so much for posting this and being so detailed. I'm sure we all appreciate it! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>I'm getting married here April 29, 2016 and have been having a ton of anxiety...reading your post has eased some of my nerves. Thank you isn't enough!! May I ask that you also email me too at itsjustmetrish@<a hovercard-ref=\"member\" hovercard-id=\"219734\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/219734-gmail\/' title='Member profile'><span itemprop=\"name\">gmail<\/span><\/a>.com I truly appreciate it!!\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"itsjustmetrish@gmail.com","IpAddress":"204.63.55.228","GroupId":39,"GroupName":"Newbie","JoinDate":1439395741,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284383.jpg?_r=1439433185","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"fijiangel15","Id":284383,"Name":"fijiangel15","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.45.141.241","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79050,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5a802be4c96bc429bf0daa2f644b92d0","RawContent":"&lt;p&gt;Thank you so much! your review was so helpful and its helping me with my stress! One Question... was Alcohol included with dinner. This is very important for me &amp;amp; guest.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thanks!&lt;\/p&gt;","Attachments":[],"Id":1903641,"PostDate":1440772365,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thank you so much! your review was so helpful and its helping me with my stress! One Question... was Alcohol included with dinner. This is very important for me & guest.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Thanks!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"pannelisse@gmail.com","IpAddress":"99.45.141.241","GroupId":39,"GroupName":"Newbie","JoinDate":1440620997,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284576.jpg?_r=1443546094","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"Soon2beJara","Id":284576,"Name":"Soon2beJara","IsOnline":false}}],"Id":"79050","Title":"Now Larimar Review !","LastPostDate":1440866332},"Pages":{"TotalItems":11,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
