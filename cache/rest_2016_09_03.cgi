{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":6,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":727,"MovedTo":null,"MovedOn":0,"FirstPostId":1904452,"Rating":0,"RatingHits":0,"Starter":{"Id":276516,"Name":"SandC","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276516.jpg?_r=1443033438","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"StartDate":1441898511,"LastPoster":{"Id":281796,"Name":"Sandraco8","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":23,"Preview":{"Id":1904452,"PostDate":1441898511,"PostContent":"Can anyone tell me what i need to do to get my legal documents sent to jamaica? \u00a0Do they have to...","Author":{"Signature":"","Email":"sergeaubin@hotmail.com","IpAddress":"216.223.125.194","GroupId":39,"GroupName":"Newbie","JoinDate":1391616725,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276516.jpg?_r=1443033438","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"SandC","Id":276516,"Name":"SandC","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"216.223.125.194","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79579,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"566454f489c869c97cf5931332eb942a","RawContent":"&lt;p&gt;Can anyone tell me what i need to do to get my legal documents sent to jamaica? &amp;nbsp;Do they have to be notarize or certified? &amp;nbsp;who can do that? &amp;nbsp;Seems very confusing between notarized or commission of oath.&lt;\/p&gt;\n&lt;p&gt;Thanks&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1904452,"PostDate":1441898511,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Can anyone tell me what i need to do to get my legal documents sent to jamaica? \u00a0Do they have to be notarize or certified? \u00a0who can do that? \u00a0Seems very confusing between notarized or commission of oath.<\/p>\n<p>Thanks\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sergeaubin@hotmail.com","IpAddress":"216.223.125.194","GroupId":39,"GroupName":"Newbie","JoinDate":1391616725,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276516.jpg?_r=1443033438","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"SandC","Id":276516,"Name":"SandC","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"200.79.251.123","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79579,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"6aceb8119b14212f82ee162252021e0b","RawContent":"[quote name=\"SandC\" post=\"1904452\" timestamp=\"1441894911\"]\nCan anyone tell me what i need to do to get my legal documents sent to jamaica?  Do they have to be notarize or certified?  who can do that?  Seems very confusing between notarized or commission of oath.\nThanks[\/quote]@[member=\"SandC\"] where are you getting married in Jamaica? im not familiar with the process, but your location or resort must have all the steps to follow , for a legal wedding. I would ask them.\n\n\nHappy Planning!\nJoyce","Attachments":[],"Id":1904463,"PostDate":1441909383,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>SandC, on 10 September 2015 - 07:21 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Can anyone tell me what i need to do to get my legal documents sent to jamaica? \u00a0Do they have to be notarize or certified? \u00a0who can do that? \u00a0Seems very confusing between notarized or commission of oath.<\/p>\n<p>Thanks\u00a0<\/p>\n<\/div>\n<\/div><\/div>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"276516\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/276516-sandc\/' title='Member profile'><span itemprop=\"name\">SandC<\/span><\/a> where are you getting married in Jamaica? im not familiar with the process, but your location or resort must have all the steps to follow , for a legal wedding. I would ask them.<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Happy Planning!<\/p>\n<p>Joyce<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Dream Weddings Riviera Maya- We pay attention to your wishes and coordinate closely with you to ensure your wedding or event is planned to perfection! Supporting you brides and help you feel less overwhelmed during the wedding planning process.<\/p>\n<p>Have fun the best is yet to come!<\/p>\n<p>\u00a0<\/p>\n<p>This is where I will be posting all videos about most common question about Destination wedding<\/p>\n<p> <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0\u00a0<a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/groups\/1664036763874450\/'>https:\/\/www.facebook.com\/groups\/1664036763874450\/<\/a><br><br><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Dream Weddings Riviera Maya<\/span><\/span><\/span><br><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">weddingsinplayadelcarmen@gmail.com<\/span><\/span><br><a  class=\"bbc_url\" href=\"http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html\">http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html<\/a><br><br><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Happy Planning!<\/span><\/span><\/span><br><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Joyce<\/span><\/span><\/span>","Email":"weddingsinplayadelcarmen@gmail.com","IpAddress":"187.252.44.28","GroupId":84,"GroupName":"Insiders w\/ Articles","JoinDate":1326857987,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250090.jpg?_r=1451923195","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"dreamweddings","Id":250090,"Name":"dreamweddings","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.146.146.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79579,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"b7aff5c46a84ee6a57015ea94d187a79","RawContent":"&lt;p&gt;@[member=\"acw271011\"] married in Jamaica, hopefully she can pop in and help!&lt;\/p&gt;","Attachments":[],"Id":1904465,"PostDate":1441909747,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"232000\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/232000-acw271011\/' title='Member profile'><span itemprop=\"name\">acw271011<\/span><\/a> married in Jamaica, hopefully she can pop in and help!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399432202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"159.53.110.140","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79579,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e58f08e16200e934b4de27cda6091f44","RawContent":"&lt;p&gt;I was recently married in Jamaica. We had copies of our birth certificates and passports notarized and then we just scanned and emailed to the wedding coordinators. The paperwork said we had to send the physical notarized copies but they accepted the scanned\/emailed documents with no problem! We never provided the physical documents and we have our marriage certificate in hand :)&lt;\/p&gt;","Attachments":[],"Id":1904476,"PostDate":1441916286,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I was recently married in Jamaica. We had copies of our birth certificates and passports notarized and then we just scanned and emailed to the wedding coordinators. The paperwork said we had to send the physical notarized copies but they accepted the scanned\/emailed documents with no problem! We never provided the physical documents and we have our marriage certificate in hand <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rebecca.shaffer@gmail.com","IpAddress":"159.53.174.144","GroupId":3,"GroupName":"Member","JoinDate":1403119687,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"beckys98","Id":278581,"Name":"beckys98","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.87.237.201","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79579,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3a9dd980a1a10114c4c715a3f986ae18","RawContent":"&lt;p&gt;I was married in Jamaica nearly 4 years ago. We were both divorced so document requirements were a bit different. Notarized copies of birth certificates definitely plus notarized copies of our final divorce papers. We were asked to scan and email the copies to the WC at the resort, then bring the actual originals with us and we had to hand them in to the WC when we met with her. They may not need that anymore but my feeling was that it seems to vary from parish to parish (county) as to how strict they are.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Definitely your WC should be able to tell you what she needs but I would be prepared with your notarized copies in case. Notarizing a document usually means a certificate is attached by the Notary (lawyer)&amp;nbsp;stating that they&#039;ve seen the original documents and what they&#039;re attaching is a true copy of the original and they attest to that and usually add a seal. A Commissioner of Oaths is just someone that you take documents to that need to be signed but that have a sworn statement with them that the signature was witnessed. I&#039;m a commissioner of oaths and it only means that people bring documents to me, I stamp them if they don&#039;t already have a special commissioner&#039;s box on them, then the person signing has a statement they have to swear to along with signing the document. That won&#039;t work for documents in Jamaica for a marriage licence though.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;@[member=\"SandC\"] I&#039;m not sure where you&#039;re from but here in Ontario a lawyer is the only one that can be a notary so&amp;nbsp;you would have to find a lawyer to do the notarizing for you.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck!&lt;\/p&gt;","Attachments":[],"Id":1904483,"PostDate":1441922570,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I was married in Jamaica nearly 4 years ago. We were both divorced so document requirements were a bit different. Notarized copies of birth certificates definitely plus notarized copies of our final divorce papers. We were asked to scan and email the copies to the WC at the resort, then bring the actual originals with us and we had to hand them in to the WC when we met with her. They may not need that anymore but my feeling was that it seems to vary from parish to parish (county) as to how strict they are.<\/p>\n<p>\u00a0<\/p>\n<p>Definitely your WC should be able to tell you what she needs but I would be prepared with your notarized copies in case. Notarizing a document usually means a certificate is attached by the Notary (lawyer)\u00a0stating that they've seen the original documents and what they're attaching is a true copy of the original and they attest to that and usually add a seal. A Commissioner of Oaths is just someone that you take documents to that need to be signed but that have a sworn statement with them that the signature was witnessed. I'm a commissioner of oaths and it only means that people bring documents to me, I stamp them if they don't already have a special commissioner's box on them, then the person signing has a statement they have to swear to along with signing the document. That won't work for documents in Jamaica for a marriage licence though.<\/p>\n<p>\u00a0<\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"276516\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/276516-sandc\/' title='Member profile'><span itemprop=\"name\">SandC<\/span><\/a> I'm not sure where you're from but here in Ontario a lawyer is the only one that can be a notary so\u00a0you would have to find a lawyer to do the notarizing for you.<\/p>\n<p>\u00a0<\/p>\n<p>Good luck!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/'><span style=\"color:#ff0099;\"><em>http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283462599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.196.44.37","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79579,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"24d19c0667ce7b6cc9f7cbba2c837d40","RawContent":"We emailed copies of our documents with a notarized letter and were told we need to show the originals when we arrive for our wedding. The copies needed to be sent in at least 60 days prior to the wedding date.\n\n\nGood luck!","Attachments":[],"Id":1904566,"PostDate":1442061132,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We emailed copies of our documents with a notarized letter and were told we need to show the originals when we arrive for our wedding. The copies needed to be sent in at least 60 days prior to the wedding date.<br><br>\nGood luck!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sandra_co8@icloud.com","IpAddress":"50.162.188.193","GroupId":39,"GroupName":"Newbie","JoinDate":1421710870,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Sandraco8","Id":281796,"Name":"Sandraco8","IsOnline":false}}],"Id":"79579","Title":"Legal Documents. Notarized? Certified?","LastPostDate":1442061132},"Pages":{"TotalItems":6,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
