png\" alt=\"sml_gallery_206696_17612_13451.png\"><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"> \u00a0 \u00a0<img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"font-size:14px;\"><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010'>Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><\/span><\/span><strong><span style=\"color:#b22222;\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a data-ipb='nomediaparse' href='mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com'>ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"admin@bestdestinationwedding.com","IpAddress":"71.202.225.11","GroupId":4,"GroupName":"Administrators","JoinDate":1137227820,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"FormattedName":"TammyWright","Id":206696,"Name":"TammyWright","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.161.201.33","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78700,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"08868a41e8fd71a0bf88240650c59381","RawContent":"[quote name=\"TammyWright\" post=\"1904195\" timestamp=\"1441468296\"]\nHi All,\n\nI just got back from Moon Palace Jamaica Grande.  It is awesome.  Pics here: [url=\"http:\/\/www.bestdestinationwedding.com\/gallery\/album\/18096-moon-palace-jamaica-grande-ochos-rios\/\"]http:\/\/www.bestdestinationwedding.com\/gallery\/album\/18096-moon-palace-jamaica-grande-ochos-rios\/[\/url]\n\nReview coming :)[\/quote]I&#039;ve been curious about this resort, I can&#039;t wait to read your review :)","Attachments":[],"Id":1904199,"PostDate":1441482464,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>TammyWright, on 05 September 2015 - 08:51 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hi All,<\/p>\n<p>\u00a0<\/p>\n<p>I just got back from Moon Palace Jamaica Grande. \u00a0It is awesome. \u00a0Pics here:\u00a0<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/album\/18096-moon-palace-jamaica-grande-ochos-rios\/' class='bbc_url' title=''>http:\/\/www.bestdesti...nde-ochos-rios\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Review coming <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<\/div>\n<\/div><\/div>\n<p>I've been curious about this resort, I can't wait to\u00a0read your review <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"dnyomba@gmail.com","IpAddress":"207.161.66.184","GroupId":40,"GroupName":"Jr. Member","JoinDate":1390119458,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"FutureMrsSam","Id":276191,"Name":"FutureMrsSam","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"152.132.9.140","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78700,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"340777910ae2ed6928a0a3efe444e26d","RawContent":"&lt;p&gt;Hi Tammy,&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;m planning a wedding there for June 2016...I can&#039;t wait to read your review.&amp;nbsp; My wedding specialist is heading there at the end of the month and I&#039;m ready to hear all the good things about it.&lt;\/p&gt;","Attachments":[],"Id":1904754,"PostDate":1442331203,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Tammy,<\/p>\n<p>\u00a0<\/p>\n<p>I'm planning a wedding there for June 2016...I can't wait to read your review.\u00a0 My wedding specialist is heading there at the end of the month and I'm ready to hear all the good things about it.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-family:'comic sans ms', cursive;\">STBMrsPowell <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/span>","Email":"shay_tt03@hotmail.com","IpAddress":"152.132.9.140","GroupId":39,"GroupName":"Newbie","JoinDate":1438786399,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284292.jpg?_r=1442327838","PhotoWidth":169,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"STBMrsPowell","Id":284292,"Name":"STBMrsPowell","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"12.146.240.122","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78700,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"27b87d2cd4a6f5cfcf72f7c06a024c20","RawContent":"&lt;p&gt;We actually are getting the chance to view the resort later this October, the pictures look amazing&lt;\/p&gt;","Attachments":[],"Id":1905593,"PostDate":1443533161,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>We actually are getting the chance to view the resort later this October, the pictures look amazing<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"smhughes5@gmail.com","IpAddress":"24.236.71.15","GroupId":39,"GroupName":"Newbie","JoinDate":1414468192,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280892.jpg?_r=1424806022","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"StaceyMarieHughes","Id":280892,"Name":"StaceyMarieHughes","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.79.44.186","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78700,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5806b153bea7707f3bf43807adec2b1e","RawContent":"&lt;p&gt;My travel agent highly recommended this place. Her pics were beautiful! Currently trying to plan a trip down there to tour it and 2 other locations in December.&lt;\/p&gt;","Attachments":[],"Id":1906279,"PostDate":1444883166,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>My travel agent highly recommended this place. Her pics were beautiful! Currently trying to plan a trip down there to tour it and 2 other locations in December.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"townsendsmithwed@gmail.com","IpAddress":"173.66.3.166","GroupId":39,"GroupName":"Newbie","JoinDate":1427046004,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282503.jpeg?_r=1462490971","PhotoWidth":200,"PhotoHeight":199,"PhotoType":"custom"},"FormattedName":"tiffanyt","Id":282503,"Name":"tiffanyt","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"12.146.240.122","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78700,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5e6c77935c096d4c85a445ef08ddc91a","RawContent":"&lt;p&gt;We just got back a few days ago. The resort isn&#039;t completely finished, but it was amazing. The staff were very friendly and view was beautiful&lt;\/p&gt;","Attachments":[],"Id":1906968,"PostDate":1446223049,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>We just got back a few days ago. The resort isn't completely finished, but it was amazing. The staff were very friendly and view was beautiful<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"smhughes5@gmail.com","IpAddress":"24.236.71.15","GroupId":39,"GroupName":"Newbie","JoinDate":1414468192,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280892.jpg?_r=1424806022","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"StaceyMarieHughes","Id":280892,"Name":"StaceyMarieHughes","IsOnline":false}}],"Id":"78700","Title":"Moon Palace Jamaica Brides?","LastPostDate":1446223049},"Pages":{"TotalItems":10,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
