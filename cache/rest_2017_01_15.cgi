-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;128\/st\/20071012\/e\/the+big+day\/dt\/-3\/k\/9829\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...9829\/event.png<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/www.natalieandkevinberns.com\">www.natalieandkevinberns.com<\/a><\/div><\/div>","Email":"natalieberns@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1153050960,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-206763.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"TOESNTHESND","Id":206763,"Name":"TOESNTHESND","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"880ff9507662cf9acd52f06424e2060a","RawContent":"Ok I&#039;m going to try this! The ring is kind of blurry. It&#039;s platinum and the center is 2.2 cts and the sides have 3 diamonds on each side. I still can&#039;t find a band that looks good with it yet! &lt;img src=\"http:\/\/i116.photobucket.com\/albums\/o4\/gnat1711\/ring_00612.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;","Attachments":[],"Id":5353,"PostDate":1162393301,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Ok I'm going to try this! The ring is kind of blurry. It's platinum and the center is 2.2 cts and the sides have 3 diamonds on each side. I still can't find a band that looks good with it yet! <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i116.photobucket.com\/albums\/o4\/gnat1711\/ring_00612.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"gnat1711@yahoo.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1160483100,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-206849.gif?_r=0","PhotoWidth":73,"PhotoHeight":99,"PhotoType":"custom"},"FormattedName":"Natalie Z","Id":206849,"Name":"Natalie Z","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"5a10472277397e88d62a333fd0d8a7ba","RawContent":"&lt;img src=\"http:\/\/www.e-weddingbands.com\/store\/media\/newdiamond\/wgdiamond5b.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n OK, so this is the general idea of what I was thinking when I said &amp;quot;basket cut&amp;quot; - I&#039;m pretty sure I made that up! This one is way too wide though - 11 mm.","Attachments":[],"Id":5413,"PostDate":1162416722,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n             