67,"Height":367},{"Id":32898,"Name":"unnamed-2.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-276354-0-66174700-1435890707.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-276354-0-66174700-1435890707_thumb.jpg","Width":367,"Height":367},{"Id":32899,"Name":"unnamed-3.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-276354-0-68190400-1435890708.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-276354-0-68190400-1435890708_thumb.jpg","Width":367,"Height":367},{"Id":32900,"Name":"unnamed-4.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-276354-0-12492100-1435890709.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-276354-0-12492100-1435890709_thumb.jpg","Width":367,"Height":367},{"Id":32901,"Name":"unnamed-5.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-276354-0-75349000-1435890709.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-276354-0-75349000-1435890709_thumb.jpg","Width":367,"Height":367},{"Id":32902,"Name":"11536096_436103546572580_1110500958229380391_n.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-276354-0-32083000-1435890714.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-276354-0-32083000-1435890714_thumb.jpg","Width":958,"Height":960}],"Id":1899733,"PostDate":1435890868,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span  style=\"font-size:12px\">I am selling the leftover wedding\u00a0decor. Prices do not include shipping. If you are located in Chicago or NE Florida, I would be happy to\u00a0arrange a time to meet in person so you\u00a0won't have to pay shipping!\u00a0<\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-size:12px\">25 white chair sashes- $20<\/span><\/p>\n<p><span  style=\"font-size:12px\">White paper and wooden hand fans (these were leftover and never used)-$16 for lot of 19<\/span><\/p>\n<p><span  style=\"font-size:12px\">6 white flower\u00a0candles & 3 silver flower candles-$7<\/span><\/p>\n<p><span  style=\"font-size:12px\">17 bubbles with yellow and\u00a0blue ribbon-$2<\/span><\/p>\n<p><span  style=\"font-size:12px\">Bride to Be Sash (new)-$4<\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-size:12px\">Burlap\u00a0<\/span><\/p>\n<p><span  style=\"font-size:12px\">1 new roll of 15 ft-$8<\/span><\/p>\n<p><span  style=\"font-size:12px\">1 roll cut-$4<\/span><\/p>\n<p><span  style=\"font-size:12px\">$10 for both<\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-size:12px\">Ribbon<\/span><\/p>\n<p><span  style=\"font-size:12px\">Thin Ivory Lace-about 5.5 yrds\u00a0<\/span><\/p>\n<p><span  style=\"font-size:12px\">Blue\u00a0ribbon-12 in<\/span><\/p>\n<p><span  style=\"font-size:12px\">wide Lace- 2.5ft<\/span><\/p>\n<p><span  style=\"font-size:12px\">New floral tape<\/span><\/p>\n<p><span  style=\"font-size:12px\">$8 for the lot<\/span><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"halishields31@gmail.com","IpAddress":"50.151.250.251","GroupId":39,"GroupName":"Newbie","JoinDate":1390848884,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"has31","Id":276354,"Name":"has31","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"67.163.54.84","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79345,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ca95cb88aec6606937ee43ec6e842020","RawContent":"&lt;p&gt;The hand fans are silk with bamboo handles! Happy to combine shipping or offer a discount for buying multiple items!&lt;\/p&gt;","Attachments":[],"Id":1899812,"PostDate":1436116029,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>The hand fans are silk with bamboo handles! Happy to combine shipping or offer a discount for buying multiple items!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"halishields31@gmail.com","IpAddress":"50.151.250.251","GroupId":39,"GroupName":"Newbie","JoinDate":1390848884,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"has31","Id":276354,"Name":"has31","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"192.249.47.212","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79345,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"84e798a65f594827df0311963156f312","RawContent":"&lt;p&gt;@[member=\"has31\"] i would love to speak to you about the fans. If i were to purchase the ones you have i would need about 30 to match&lt;\/p&gt;","Attachments":[],"Id":1899850,"PostDate":1436194324,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"276354\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/276354-has31\/' title='Member profile'><span itemprop=\"name\">has31<\/span><\/a> i would love to speak to you about the fans. If i were to purchase the ones you have i would need about 30 to match<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>57 Guest","Email":"racht33@yahoo.com","IpAddress":"192.249.47.212","GroupId":3,"GroupName":"Member","JoinDate":1422632988,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281952.jpg?_r=1424197509","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"racht33","Id":281952,"Name":"racht33","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"67.163.54.84","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79345,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"11c3a9fcbf34c731a11b57f25f14999d","RawContent":"&lt;p&gt;@[member=\"racht33\"] Unfortunately I am not finding the same exact fans anymore. I bought them on ebay and it doesn&#039;t look like the seller has anymore. It would be cute to do half and half ( a different color perhaps). I bought 20 fans because at the time, I thought that would be plenty for my small wedding. Several more people RSVPed and we had about 32 people total. &amp;nbsp;Only one fan was used. So glad I chose not to rent parasols a few days before. I think everyone had gotten used to the heat by the time the wedding rolled around.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1899895,"PostDate":1436242032,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"281952\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281952-racht33\/' title='Member profile'><span itemprop=\"name\">racht33<\/span><\/a> Unfortunately I am not finding the same exact fans anymore. I bought them on ebay and it doesn't look like the seller has anymore. It would be cute to do half and half ( a different color perhaps). I bought 20 fans because at the time, I thought that would be plenty for my small wedding. Several more people RSVPed and we had about 32 people total. \u00a0Only one fan was used. So glad I chose not to rent parasols a few days before. I think everyone had gotten used to the heat by the time the wedding rolled around.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"halishields31@gmail.com","IpAddress":"50.151.250.251","GroupId":39,"GroupName":"Newbie","JoinDate":1390848884,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.pn