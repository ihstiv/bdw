{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":2,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":479,"MovedTo":null,"MovedOn":0,"FirstPostId":1908692,"Rating":0,"RatingHits":0,"Starter":{"Id":285674,"Name":"sulee154151","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1451032037,"LastPoster":{"Id":250090,"Name":"dreamweddings","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250090.jpg?_r=1451923195","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":7,"Preview":{"Id":1908692,"PostDate":1451032037,"PostContent":"Hi everyone, \u00a0 My\u00a0fianc\u00a9e and I are looking forward to getting married at the end of this year. \u00a0...","Author":{"Signature":"<p>dich vu <a data-ipb='nomediaparse' href='http:\/\/sonepoxy.suu.vn\/'>son epoxy<\/a> gia re","Email":"sulee154151@gmail.com","IpAddress":"183.81.9.219","GroupId":39,"GroupName":"Newbie","JoinDate":1451031333,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"sulee154151","Id":285674,"Name":"sulee154151","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"183.81.9.219","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79814,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d314d886a738f324ec37fc7f301a299b","RawContent":"&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;Hi everyone,&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;My&amp;nbsp;&lt;span style=\"color:rgb(34,34,34);font-family:arial, sans-serif;font-size:small;\"&gt;fianc\u00a9e and I are looking forward to getting married at the end of this year. &amp;nbsp;However, we have struggled to choose a resort at which to host our wedding. &amp;nbsp;Our difficulty arises from the fact that most (if not all) resorts seem to cater to guests who want to have a beach, gazebo, or garden wedding ceremony. &amp;nbsp;My&amp;nbsp;&lt;\/span&gt;&lt;span style=\"color:rgb(34,34,34);font-family:arial, sans-serif;font-size:small;\"&gt;fianc\u00a9e and I prefer an indoor wedding (as we want the ceremony to be more formal.)&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;&lt;span style=\"color:rgb(34,34,34);font-family:arial, sans-serif;font-size:small;\"&gt;Can anyone recommend any resorts with a beautiful or interesting indoor ceremony venue?&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;&lt;span style=\"color:rgb(34,34,34);font-family:arial, sans-serif;font-size:small;\"&gt;Thanks very much for your help. &amp;nbsp;I look forward to reading your replies. &amp;nbsp;:-)&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1908692,"PostDate":1451032037,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">Hi everyone,<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">My\u00a0<span  style=\"color:rgb(34,34,34);font-family:arial, sans-serif;font-size:small\">fianc\u00a9e and I are looking forward to getting married at the end of this year. \u00a0However, we have struggled to choose a resort at which to host our wedding. \u00a0Our difficulty arises from the fact that most (if not all) resorts seem to cater to guests who want to have a beach, gazebo, or garden wedding ceremony. \u00a0My\u00a0<\/span><span  style=\"color:rgb(34,34,34);font-family:arial, sans-serif;font-size:small\">fianc\u00a9e and I prefer an indoor wedding (as we want the ceremony to be more formal.)<\/span><\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\"><span  style=\"color:rgb(34,34,34);font-family:arial, sans-serif;font-size:small\">Can anyone recommend any resorts with a beautiful or interesting indoor ceremony venue?<\/span><\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\"><span  style=\"color:rgb(34,34,34);font-family:arial, sans-serif;font-size:small\">Thanks very much for your help. \u00a0I look forward to reading your replies. \u00a0:-)<\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>dich vu <a data-ipb='nomediaparse' href='http:\/\/sonepoxy.suu.vn\/'>son epoxy<\/a> gia re","Email":"sulee154151@gmail.com","IpAddress":"183.81.9.219","GroupId":39,"GroupName":"Newbie","JoinDate":1451031333,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"sulee154151","Id":285674,"Name":"sulee154151","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"200.79.251.123","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79814,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d2d90c296f7daaf68b4baf86620d9606","RawContent":"[quote name=\"sulee154151\" post=\"1908692\" timestamp=\"1451032037\"]\n[color=rgb(40,40,40)][font=arial]\nHi everyone,[\/font][\/color]\n[color=rgb(40,40,40)][font=arial]\nMy [color=rgb(34,34,34)][font=arial][size=1]fianc\u00a9e and I are looking forward to getting married at the end of this year.  However, we have struggled to choose a resort at which to host our wedding.  Our difficulty arises from the fact that most (if not all) resorts seem to cater to guests who want to have a beach, gazebo, or garden wedding ceremony.  My [\/size][\/font][\/color][color=rgb(34,34,34)][font=arial][size=1]fianc\u00a9e and I prefer an indoor wedding (as we want the ceremony to be more formal.)[\/size][\/font][\/color][\/font][\/color]\n[color=rgb(40,40,40)][font=arial]\n[color=rgb(34,34,34)][font=arial][size=1]Can anyone recommend any resorts with a beautiful or interesting indoor ceremony venue?[\/size][\/font][\/color][\/font][\/color]\n[color=rgb(40,40,40)][font=arial]\n[color=rgb(34,34,34)][font=arial][size=1]Thanks very much for your help.  I look forward to reading your replies.  :-)[\/size][\/font][\/color][\/font][\/color]\n[\/quote]@[member=\"sulee154151\"], you might want to follow the link, Del Sol has some few resort which sums up what you are looking for . Check them out  [url=\"http:\/\/delsolphotography.com\/category\/weddings\/?venue=&amp;amp;location=&amp;amp;receptions=ball-room&amp;amp;guests=&amp;amp;colors=&amp;amp;photographer=&amp;amp;coordinator=&amp;amp;monthnum=\"]http:\/\/delsolphotography.com\/category\/weddings\/?venue=&amp;amp;location=&amp;amp;receptions=ball-room&amp;amp;guests=&amp;amp;colors=&amp;amp;photographer=&amp;amp;coordinator=&amp;amp;monthnum=[\/url]\n\n\nAlso check out Beach Palace Cancun and Paradisus resort Playa del carmen\n\n\nHappy Planning","Attachments":[],"Id":1908738,"PostDate":1451358966,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>sulee154151, on 25 December 2015 - 12:27 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">Hi everyone,<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">My\u00a0<span  style=\"color:rgb(34,34,34);font-family:arial, sans-serif;font-size:small\">fianc\u00a9e and I are looking forward to getting married at the end of this year. \u00a0However, we have struggled to choose a resort at which to host our wedding. \u00a0Our difficulty arises from the fact that most (if not all) resorts seem to cater to guests who want to have a beach, gazebo, or garden wedding ceremony. \u00a0My\u00a0<\/span><span  style=\"color:rgb(34,34,34);font-family:arial, sans-serif;font-size:small\">fianc\u00a9e and I prefer an indoor wedding (as we want the ceremony to be more formal.)<\/span><\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\"><span  style=\"color:rgb(34,34,34);font-family:arial, sans-serif;font-size:small\">Can anyone recommend any resorts with a beautiful or interesting indoor ceremony venue?<\/span><\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\"><span  style=\"color:rgb(34,34,34);font-family:arial, sans-serif;font-size:small\">Thanks very much for your help. \u00a0I look forward to reading your replies. \u00a0:-)<\/span><\/p>\n<p>\u00a0<\/p>\n<\/div>\n<\/div><\/div>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"285674\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/285674-sulee154151\/' title='Member profile'><span itemprop=\"name\">sulee154151<\/span><\/a>, you might want to follow the link, Del Sol has some few resort which sums up what you are looking for . Check them out \u00a0<a href='http:\/\/delsolphotography.com\/category\/weddings\/?venue=&location=&receptions=ball-room&guests=&colors=&photographer=&coordinator=&monthnum=' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/delsolphotogr...ator=&monthnum=<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Also check out Beach Palace Cancun and Paradisus resort Playa del carmen<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Happy Planning<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Dream Weddings Riviera Maya- We pay attention to your wishes and coordinate closely with you to ensure your wedding or event is planned to perfection! Supporting you brides and help you feel less overwhelmed during the wedding planning process.<\/p>\n<p>Have fun the best is yet to come!<\/p>\n<p>\u00a0<\/p>\n<p>This is where I will be posting all videos about most common question about Destination wedding<\/p>\n<p> <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0\u00a0<a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/groups\/1664036763874450\/'>https:\/\/www.facebook.com\/groups\/1664036763874450\/<\/a><br><br><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Dream Weddings Riviera Maya<\/span><\/span><\/span><br><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">weddingsinplayadelcarmen@gmail.com<\/span><\/span><br><a  class=\"bbc_url\" href=\"http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html\">http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html<\/a><br><br><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Happy Planning!<\/span><\/span><\/span><br><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Joyce<\/span><\/span><\/span>","Email":"weddingsinplayadelcarmen@gmail.com","IpAddress":"187.252.44.28","GroupId":84,"GroupName":"Insiders w\/ Articles","JoinDate":1326854387,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250090.jpg?_r=1451923195","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"dreamweddings","Id":250090,"Name":"dreamweddings","IsOnline":false}}],"Id":"79814","Title":"Resort With A Beautiful Or Interesting Indoor Ceremony Venue?","LastPostDate":1451358966},"Pages":{"TotalItems":2,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0