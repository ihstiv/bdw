{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"86.12.49.109","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72484,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"1b90256ab87a8f9335416cc4e68db398","RawContent":"Hello Ladies,\n\nwe are getting married at OCX in April :-) I am getting very excited about it.I am looking for hair &amp;amp; make up stylist and I was wondering if anyone had hair &amp;amp; make up done at the hotel using their services? Or can you recommend me someone really good but not so pricey? I did contact Styling Trio and few others as I like their work,but they are far too expensive for me ... Many thanks :-)\n\n\n\nSent from my iPad using Tapatalk","Attachments":[],"Id":1881525,"PostDate":1420216249,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hello Ladies,<br>\nwe are getting married at OCX in April :-) I am getting very excited about it.I am looking for hair & make up stylist and I was wondering if anyone had hair & make up done at the hotel using their services? Or can you recommend me someone really good but not so pricey? I did contact Styling Trio and few others as I like their work,but they are far too expensive for me ... Many thanks :-)<br><br><br>\nSent from my iPad using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sallinka84@gmail.com","IpAddress":"86.12.49.109","GroupId":3,"GroupName":"Member","JoinDate":142021496