{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":3,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":39,"MovedTo":null,"MovedOn":0,"FirstPostId":1903747,"Rating":0,"RatingHits":0,"Starter":{"Id":284619,"Name":"CandanceWilliams2be","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284619.jpg?_r=1440956169","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"StartDate":1440939831,"LastPoster":{"Id":277873,"Name":"calgarybride2015","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":true},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1903753,"PostDate":1440956773,"PostContent":"Welcome Most people who do a DW have a travel agent who gives you all the info to give your guest...","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399410602,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":true}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.11.52.41","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79547,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":true,"PostKey":"aed97c7b94c83957cf68a57dbe9a591e","RawContent":"&lt;p&gt;Hello Ladies,  &amp;nbsp;At first I &amp;nbsp;was stressed out until I found this sight..&lt;\/p&gt;\n&lt;p&gt;Yes  now&amp;nbsp;im very excited to plan!&lt;\/p&gt;\n&lt;p&gt;So I found the resort&amp;nbsp;( Lifestyle Holidays Vacation Resort)one check off my long list .&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;But I don&#039;t know a lot of information, and the page don&#039;t have enough info for me to tell my guest&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;Have anyone had a wedding in Puerto Plata here.&amp;nbsp; What info did you give your guest.&lt;\/p&gt;\n&lt;p&gt;I wonder will they&amp;nbsp;mail me some brochures.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I want to have a information party to give them all the important info&amp;nbsp; they would need if they want&amp;nbsp; to join us. I really don&#039;t know where to start&amp;nbsp; Help Please&lt;\/p&gt;","Attachments":[],"Id":1903747,"PostDate":1440939831,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello Ladies,\u00a0\u00a0\u00a0At first I \u00a0was stressed out until I found this sight..<\/p>\n<p>Yes\u00a0\u00a0now\u00a0im very excited to plan!<\/p>\n<p>So I found the resort\u00a0( Lifestyle Holidays Vacation Resort)one check off my long list .<\/p>\n<p>\u00a0But I don't know a lot of information, and the page don't have enough info for me to tell my guest<\/p>\n<p>\u00a0Have anyone had a wedding in Puerto Plata here.\u00a0 What info did you give your guest.<\/p>\n<p>I wonder will they\u00a0mail me some brochures.\u00a0<\/p>\n<p>I want to have a information party to give them all the important info\u00a0 they would need if they want\u00a0 to join us. I really don't know where to start\u00a0 Help Please<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"candance01@yahoo.com","IpAddress":"50.11.52.41","GroupId":39,"GroupName":"Newbie","JoinDate":1440930862,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284619.jpg?_r=1440956169","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"CandanceWilliams2be","Id":284619,"Name":"CandanceWilliams2be","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.113.222.142","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":false,"TopicId":79547,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bc4fc57f62a9b9b35c7dc39e4f11ff3b","RawContent":"I am sure they would send you all the info you might need also check trip advisor they sometimes give info.","Attachments":[],"Id":1903751,"PostDate":1440955287,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I am sure they would send you all the info you might need also check trip advisor they sometimes give info. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lori.yepez@aa.com","IpAddress":"173.74.136.107","GroupId":39,"GroupName":"Newbie","JoinDate":1440276410,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"lorishultz2016","Id":284536,"Name":"lorishultz2016","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.146.146.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79547,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"042d52501ed58fe1c76247e8dfba16d3","RawContent":"Welcome\n\n\nMost people who do a DW have a travel agent who gives you all the info to give your guests. Price, dates, booking deadlines, etc. All travel can be handled thru them if they want to book in your group. If they don&#039;t want to book in your group just ensure they have all the info.  \n\n\nA lot of brides give out all this info within an invite or use a wedding website. Most are free and can even track your RSVPs if you want. Take a look at www.mywedding.com to get an idea. \n\n\nAt this point though it sounds like you could use a travel agent to price out your package and possibly get you resort perks and group rates.   I think you are in the states and the owners of this site are travel agents - wright travel - and they have a great review on here. \n\n\nAlso reach out to the wedding department at your resort to get their packages and prices to ensure this resort can offer you the wedding you desire in your budget. \n\n\nI hope I was on track with what you needed :) good luck\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1903753,"PostDate":1440956773,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Welcome<br><br>\nMost people who do a DW have a travel agent who gives you all the info to give your guests. Price, dates, booking deadlines, etc. All travel can be handled thru them if they want to book in your group. If they don't want to book in your group just ensure they have all the info.  <br><br>\nA lot of brides give out all this info within an invite or use a wedding website. Most are free and can even track your RSVPs if you want. Take a look at www.mywedding.com to get an idea. <br><br>\nAt this point though it sounds like you could use a travel agent to price out your package and possibly get you resort perks and group rates.   I think you are in the states and the owners of this site are travel agents - wright travel - and they have a great review on here. <br><br>\nAlso reach out to the wedding department at your resort to get their packages and prices to ensure this resort can offer you the wedding you desire in your budget. <br><br>\nI hope I was on track with what you needed <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> good luck<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399410602,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":true}}],"Id":"79547","Title":"Destination Wedding In 2017  In Dr","LastPostDate":1440956773},"Pages":{"TotalItems":3,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
