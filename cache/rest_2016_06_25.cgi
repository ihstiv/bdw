"custom"},"FormattedName":"JPenny","Id":234539,"Name":"JPenny","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60891,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8b6426f902dc777406de0ef9e0c205ec","RawContent":"&lt;p&gt; Your invitations came out beautiful!!&amp;nbsp; Thanks for the detailed pictures and descriptions too.&amp;nbsp; I will be trying my hand at something similar when we need our invites.&amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1455361,"PostDate":1305916175,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Your invitations came out beautiful!!\u00a0 Thanks for the detailed pictures and descriptions too.\u00a0 I will be trying my hand at something similar when we need our invites.\u00a0<\/p> <p> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mcporter5@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1303871553,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/8\/8a\/8aab65c2_fb-user-1577160218-avatar?_r=0","PhotoWidth":0,"PhotoHeight":0,"PhotoType":"custom"},"FormattedName":"lovepea","Id":239339,"Name":"lovepea","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdi