          body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Riu Santa Fe in Cabo! Waiting on the date still but will be sometime in \u00a0Feb 2016!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"millar_devon@hotmail.com","IpAddress":"154.20.36.21","GroupId":39,"GroupName":"Newbie","JoinDate":1423332913,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282027.jpg?_r=1429713632","PhotoWidth":169,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Victoriabride","Id":282027,"Name":"Victoriabride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"158.82.202.5","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78276,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"1fb06af3d315a1f3538a7276f87b478b","RawContent":"&lt;p&gt;April 9, 2016 at the Grand Sirenis Riviera Maya&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Just sent out the invites so people can put down deposits and bought my wedding dress on the weekend. I feel like I did all the important stuff super early and now I have over a year of waiting - and I&#039;m not a very patient person!&lt;\/p&gt;","Attachments":[],"Id":1890928,"PostDate":1427407574,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>April 9, 2016 at the Grand Sirenis Riviera Maya<\/p>\n<p>\u00a0<\/p>\n<p>Just sent out the invites so people can put down deposits and bought my wedding dress on the weekend. I feel like I did all the important stuff super early and now I have over a year of waiting - and I'm not a very patient person!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div>\u00a0<\/div>\n<div>\u00a0<\/div>\n<div><a class='bbc_url' href='http:\/\/www.TickerFactory.com\/'><\/div>\n<div><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;6\/st\/20160409\/e\/our+Wedding+Day\/k\/a16a\/event.png\" alt=\"event.png\"><\/div>\n<div><\/a><\/div>\n<div>\u00a0<\/div>\n","Email":"krystalball@gmail.com","IpAddress":"158.82.202.5","GroupId":39,"GroupName":"Newbie","JoinDate":1421867763,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281820.jpg?_r=1440261411","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"krystalball","Id":281820,"Name":"krystalball","IsOnline":false}}],"Pages":{"TotalItems":65,"TotalPages":7,"CurrentPage":10,"NextPage":20,"PreviousPage":0,"LastPage":60},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
