","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b62b1ea8eeaf82be5a937231d9f2ad63","RawContent":"&lt;p&gt;April or May 2016, still doing our research.&lt;\/p&gt;","Attachments":[],"Id":1884892,"PostDate":1422843954,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>April or May 2016, still doing our research.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"njwood000@gmail.com","IpAddress":"71.7.173.185","GroupId":40,"GroupName":"Jr. Member","JoinDate":1405828391,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Msmimi","Id":279087,"Name":"Msmimi","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"184.147.135.4","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78276,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"2560c5408b5975fbafc650d99f64982d","RawContent":"Looks like May 2016 at Azul Fives. Working out the details now :)\n\n\nI CAN&#039;T WAIT TO FINALLY HAVE A DATE! It must feel amazing \u2665\ufe0f","Attachments":[],"Id":1887284,"PostDate":1424747163,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Looks like May 2016 at Azul Fives. Working out the details now <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br><br>\nI CAN'T WAIT TO FINALLY HAVE A DATE! It must feel amazing \u2665\ufe0f\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>My Planning Thread: <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79377-ashhtayys-planning-thread-azul-fives-june-7-2016\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79377-ashhtayys-planning-thread-azul-fives-june-7-2016\/<\/a><br>\n\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;0;116\/st\/20160607\/e\/Our+Wedding\/dt\/1\/k\/bb99\/event.png\" alt=\"event.png\"><\/a>","Email":"ashley.taylor@live.ca","IpAddress":"184.147.135.4","GroupId":40,"GroupName":"Jr. Member","JoinDate":1423108661,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282006.png?_r=1423373502","PhotoWidth":200,"PhotoHeight":138,"PhotoType":"custom"},"FormattedName":"ashhtayy","Id":282006,"Name":"ashhtayy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.91.126.243","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78276,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d7bc2125bb9808b0f69c70528dda4a20","RawContent":"&lt;p&gt;I just got my date confirmed.....April 4, 2016 at the Riu Palace Riviera Maya!!! Let the fun in planning begin! Congratulations to all of you out there as well.&lt;\/p&gt;","Attachments":[],"Id":1887988,"PostDate":1425318784,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I just got my date confirmed.....April 4, 2016 at the Riu Palace Riviera Maya!!! Let the fun in planning begin! Congratulations to all of you out there as well.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"robynb7@hotmail.com","IpAddress":"99.233.112.15","GroupId":39,"GroupName":"Newbie","JoinDate":1409892993,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279694.jpg?_r=1425843817","PhotoWidth":200,"PhotoHeight":171,"PhotoType":"custom"},"FormattedName":"rbehlke","Id":279694,"Name":"rbehlke","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"69.125.102.56","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78276,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"0ac80766788cd87c88a2b7164550fa68","RawContent":"Our date is 4\/16\/16 but I&#039;m torn between Grand Solmar and Dreams in Cabo!","Attachments":[],"Id":1888540,"PostDate":1425609531,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Our date is 4\/16\/16 but I'm torn between Grand Solmar and Dreams in Cabo!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mara1481@gmail.com","IpAddress":"107.188.26.154","GroupId":39,"GroupName":"Newbie","JoinDate":1425584179,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"JolieTP","Id":282325,"Name":"JolieTP","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"199.85.228.129","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78276,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d2ce0a37696e4857697489ee32c6b3fd","RawContent":"&lt;p&gt;April 15th 2016 at Riu Caribe (Cancun) I&#039;m so excited!! It&#039;s just tough to have to wait so long to work with the wedding planners. I want everything finalized NOW, haha.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Happy planning to all 2016 brides, so exciting!!!&lt;\/p&gt;","Attachments":[],"Id":1888880,"PostDate":1426012058,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>April 15th 2016 at Riu Caribe (Cancun) I'm so excited!! It's just tough to have to wait so long to work with the wedding planners. I want everything finalized NOW, haha.<\/p>\n<p>\u00a0<\/p>\n<p>Happy planning to all 2016 brides, so exciting!!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"katie_mcbride48@yahoo.ca","IpAddress":"199.85.228.129","GroupId":39,"GroupName":"Newbie","JoinDate":1424117850,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282132.jpg?_r=1437519508","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"KatieMcBride","Id":282132,"Name":"KatieMcBride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"198.140.4.205","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78276,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5aecdb8978fbbdf90a12dc0103b5d077","RawContent":"&lt;p&gt;06\/16\/2016 Dreams La Romana!&lt;\/p&gt;","Attachments":[],"Id":1890615,"PostDate":1427221034,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>06\/16\/2016 Dreams La Romana!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"morriscarrwedding@gmail.com","IpAddress":"50.129.132.162","GroupId":39,"GroupName":"Newbie","JoinDate":1414106243,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"custom"},"FormattedName":"soontobemrsc","Id":280829,"Name":"soontobemrsc","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.161.201.