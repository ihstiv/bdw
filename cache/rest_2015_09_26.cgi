{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":2,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":true,"Views":142,"MovedTo":null,"MovedOn":0,"FirstPostId":1905073,"Rating":0,"RatingHits":0,"Starter":{"Id":262240,"Name":"MissAmber26","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-262240.jpg?_r=1421980656","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"StartDate":1442772403,"LastPoster":{"Id":230711,"Name":"Moments That Matter","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":true},"PollState":"0","LastVote":0,"ForumId":2,"Preview":{"Id":1905073,"PostDate":1442774045,"PostContent":"Hello beautiful brides! I wanted to start a forum to share wedding information about the Cancun r...","Author":{"Signature":"","Email":"Amaqt03@hotmail.com","IpAddress":"98.169.122.6","GroupId":39,"GroupName":"Newbie","JoinDate":1352514105,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-262240.jpg?_r=1421980656","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"MissAmber26","Id":262240,"Name":"MissAmber26","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.209.228.111","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79603,"EditedBy":"<strong>Edited by MissAmber26, 20 September 2015 - 10:34 AM.<\/strong>","EditDate":1442774098,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4bd58cf1679e0434c401e68ba8699967","RawContent":"&lt;p&gt;Hello beautiful brides!\n\n\nI wanted to start a forum to share wedding information about the Cancun resorts managed by Playa Resorts.\n\n\nI&#039;ve booked my April 2016 wedding at the Hyatt Ziva opening in Cancun November 2015. It is formerly the Dreams Cancun resort.\n\n&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Here is a photo of one of the wedding venues available at Hyatt Ziva and the Hyatt wedding brochure. I think the venue is going to be gorgeous!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I look forward to chatting with other Playa brides!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;","Attachments":[],"Id":1905073,"PostDate":1442774045,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello beautiful brides!<br><br>\nI wanted to start a forum to share wedding information about the Cancun resorts managed by Playa Resorts.<br><br>\nI've booked my April 2016 wedding at the Hyatt Ziva opening in Cancun November 2015. It is formerly the Dreams Cancun resort.<br>\n\u00a0<\/p>\n<p>Here is a photo of one of the wedding venues available at Hyatt Ziva and the Hyatt wedding brochure. I think the venue is going to be gorgeous!<\/p>\n<p>\u00a0<\/p>\n<p>I look forward to chatting with other Playa brides!<\/p>\n<p>\u00a0<\/p>\n<p><a class='resized_img' rel='lightbox[1905073]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_09_2015\/post-262240-0-63686100-1442769946.jpg\" title=\"RENDER GAZEBOHyatt cancun.jpg - Size: 82.24KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_09_2015\/post-262240-0-63686100-1442769946.jpg\" class='bbc_img linked-image' alt=\"RENDER GAZEBOHyatt cancun.jpg\" \/><\/a>\n\n<a href=\"http:\/\/www.bestdestinationwedding.com\/index.phpapp=core&amp;module=attach&amp;section=attach&amp;attach_id=33838\" title=\"Download attachment\"><img src=\"http:\/\/www.bestdestinationwedding.com\/public\/style_extra\/mime_types\/pdf.gif\" alt=\"Attached File\" \/><\/a>\n&nbsp;<a href=\"http:\/\/www.bestdestinationwedding.com\/index.phpapp=core&amp;module=attach&amp;section=attach&amp;attach_id=33838\" title=\"Download attachment\"><strong>Hyatt Weddings Brochure- FINAL.pdf<\/strong><\/a> &nbsp;&nbsp;<span class='desc'><strong>1.06MB<\/strong><\/span>\n&nbsp;&nbsp;<span class=\"desc lighter\">2 downloads<\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Amaqt03@hotmail.com","IpAddress":"98.169.122.6","GroupId":39,"GroupName":"Newbie","JoinDate":1352514105,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-262240.jpg?_r=1421980656","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"MissAmber26","Id":262240,"Name":"MissAmber26","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"190.167.84.73","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79603,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c940e0672b8709b9b8465cf09526151d","RawContent":"&lt;p&gt;That&#039;s a great photo, MissAmber26! Looks like you&#039;ve chosen well for your wedding venue :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We captured a wedding at Dreams Cancun which was also gorgeous.....as you can see in these magical wedding moments that matter taken from that album - with a link here: &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10151184994994487.470938.18683524486&amp;amp;type=3&#039;&gt;Dreams Cancun Wedding Album&lt;\/a&gt;......enjoy!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-mia1-1.xx.fbcdn.net\/hphotos-ash2\/t31.0-8\/620901_10151184998434487_1492783092_o.jpg\" alt=\"620901_10151184998434487_1492783092_o.jp\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-mia1-1.xx.fbcdn.net\/hphotos-frc3\/t31.0-8\/664976_10151185001329487_1425881690_o.jpg\" alt=\"664976_10151185001329487_1425881690_o.jp\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-mia1-1.xx.fbcdn.net\/hphotos-xfp1\/t31.0-8\/175004_10151185005534487_1695418387_o.jpg\" alt=\"175004_10151185005534487_1695418387_o.jp\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Wishing you happy research and all the best with your plans - cheers!!! team MTM :)&lt;\/p&gt;","Attachments":[],"Id":1905187,"PostDate":1442940152,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>That's a great photo, MissAmber26! Looks like you've chosen well for your wedding venue <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>We captured a wedding at Dreams Cancun which was also gorgeous.....as you can see in these magical wedding moments that matter taken from that album - with a link here: <a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10151184994994487.470938.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>Dreams Cancun Wedding Album<\/a>......enjoy!<\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-mia1-1.xx.fbcdn.net\/hphotos-ash2\/t31.0-8\/620901_10151184998434487_1492783092_o.jpg\" alt=\"620901_10151184998434487_1492783092_o.jp\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-mia1-1.xx.fbcdn.net\/hphotos-frc3\/t31.0-8\/664976_10151185001329487_1425881690_o.jpg\" alt=\"664976_10151185001329487_1425881690_o.jp\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-mia1-1.xx.fbcdn.net\/hphotos-xfp1\/t31.0-8\/175004_10151185005534487_1695418387_o.jpg\" alt=\"175004_10151185005534487_1695418387_o.jp\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>Wishing you happy research and all the best with your plans - cheers!!! team MTM <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280214260,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":true}}],"Id":"79603","Title":"Playa Resorts Cancun - Hyatt Ziva\/ Zilara \/ Gran Caribe","LastPostDate":1442940152},"Pages":{"TotalItems":2,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
