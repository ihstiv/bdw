{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":true,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":81,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":31349,"MovedTo":null,"MovedOn":0,"FirstPostId":822187,"Rating":0,"RatingHits":0,"Starter":{"Id":206696,"Name":"TammyWright","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"IsOnline":false},"StartDate":1251769810,"LastPoster":{"Id":278832,"Name":"vsschick1234","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":28,"Preview":{"Id":822187,"PostDate":1251769810,"PostContent":"We have changed the rules about downloading attachments. You no longer need points to download at...","Author":{"Signature":"<p><span style=\"font-family:arial, helvetica, sans-serif;\">Founder and Owner of BestDestinationWedding.com \u00a0\/ \u00a0<\/span><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/'><strong><span style=\"font-family:arial, helvetica, sans-serif;\">Bride & Groom Fly FREE Promotion<\/span><\/strong><\/a><\/p>\n<p>\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><a data-ipb='nomediaparse' href='https:\/\/www.wrighttravelagency.com\/go\/destination-wedding\/?source=EMLSIG'><strong><span style=\"color:#008080;\">Looking for a travel agency that specializes in Destination Weddings-CLICK HERE<\/span><\/strong><\/a><span style=\"color:#008080;\"><strong>?<\/strong> \u00a0We are an award winning travel agency and you can <\/span><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style=\"color:#008080;\">read our reviews\u00a0here.<\/span><\/a><\/strong><\/span><br>\n\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"color:#008080;\"><strong>Awards and recognition:\u00a0<\/strong><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Palace Resorts Winner \"Top Travel Agent\", \"Top Homebased Travel Agency\" PRO Platinum Agency (Top Award) \u00a0 \u00a0 | \u00a0 \u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">AMResorts Master Agent & Top Agency \u00a0<\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/68050-karisma-hotels-givc-and-gi-wedding-consultants-wright-travel-agency\/'><strong>Wright Travel & Karisma GIVC Benefits<\/strong><\/a><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Travel Impressions Best of the Best Globe Winner \u00a0 \u00a0| \u00a0 \u00a0\u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Apple Vacations Golden Apple Winner \u00a0<\/span><\/span><br><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17612\/sml_gallery_206696_17612_13451.png\" alt=\"sml_gallery_206696_17612_13451.png\"><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"> \u00a0 \u00a0<img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"font-size:14px;\"><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010'>Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><\/span><\/span><strong><span style=\"color:#b22222;\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a data-ipb='nomediaparse' href='mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com'>ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"admin@bestdestinationwedding.com","IpAddress":"71.202.225.11","GroupId":4,"GroupName":"Administrators","JoinDate":1137227820,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"FormattedName":"TammyWright","Id":206696,"Name":"TammyWright","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":41818,"EditedBy":"","EditDate":1388965803,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"ae88dfa9006a8ae74bb592bd2ae1e3df","RawContent":"&lt;p&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;We have changed the rules about downloading attachments. You no longer need points to download attachments but instead you need to be have reached \"jr. member\" or higher status on the forum.\n\n&lt;strong&gt;To reach \"junior member\" status you need to have a minimum of 150 posts &lt;\/strong&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;- or -&lt;\/strong&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;You can by-pass the post count by becoming a &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/wedding-tips\/c\/general-bdw\/become-a-best-destination-wedding-supporter-r1740&#039;&gt;BDW Supporter&lt;\/a&gt; &lt;strong&gt;(only for new paid memberships, not those already in existence).&lt;\/strong&gt;&lt;\/strong&gt;\n\n&lt;strong&gt;To become a&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/wedding-tips\/c\/general-bdw\/become-a-best-destination-wedding-supporter-r1740&#039;&gt; &lt;\/a&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/wiki\/become-a-best-destination-wedding-supporter&#039;&gt;BDW Supporter&lt;\/a&gt;, in lieu of the post count requirement, please follow these instructions.&lt;\/strong&gt;&lt;\/span&gt;&lt;\/span&gt;\n\n&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;Some of the great benefits of being a supporter:&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;ul&gt;&lt;li&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;A special user badge on your postbit:&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt;\n&lt;li&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;The ability to download attachments*&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt;\n&lt;li&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;The knowledge you&#039;re supporting the site in a great way!&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt;\n&lt;\/ul&gt;&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;For only $30, you&#039;ll become a Supporter for life.&lt;\/strong&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;* For more information about attachment limitations, please continue to read below.&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;To become a BDW Supporter,&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;ol&gt;&lt;li&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;Click the button below to head over to the &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/store\/&#039;&gt;Plan Selection page&lt;\/a&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt;\n\t&lt;li&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;Select the \"Best Destination Wedding Supporter\" plan and click \"Continue\"&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt;\n\t&lt;li&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;You will be redirect to PayPal where you will make your payment&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt;\n\t&lt;li&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;After you make your payment and it has been processed, you will be automatically added to the Site Supporter group.&lt;\/span&gt;&lt;\/span&gt;\n\n\n\t&amp;nbsp;&lt;\/li&gt;\n&lt;\/ol&gt;&lt;p style=\"text-align:center;\"&gt;&lt;img src=\"http:\/\/assets.bestdestinationwedding.com\/e\/e4\/e4ef8e8e_bdw_become_a_supporter.png\" alt=\"e4ef8e8e_bdw_become_a_supporter.png\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;Attachments &amp;amp; Downloading&lt;\/strong&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;On Best Destination Wedding, we have a wealth of attachments of hotel information, invitation templates, save the date templates, etc. etc.&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;To download attachments, you must be a Junior Member.&amp;nbsp; &lt;strong&gt;To reach \"junior member\" status you need to have a minimum of 150 posts.&lt;\/strong&gt;\n\n&lt;strong&gt;- or -\n\n\nYou can by-pass the post count by purchasing a Site Supporter membership.&lt;\/strong&gt;\n\n&lt;strong&gt;To Purchase a Supporter Membership to download attachment in lieu of the post count requirement please follow these instructions.&lt;\/strong&gt;&lt;\/span&gt;&lt;\/span&gt;\n\n&amp;nbsp;&lt;\/p&gt;\n&lt;ul&gt;&lt;li&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;$30 one-time fee by-pass the 150 post requirement to download attachments.&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt;\n&lt;li&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;Click the \"Become A Supporter\" button above and you will be taken to the plan selection page.&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt;\n&lt;li&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;Select the $30 Best Destination Wedding Supporter plan and click \"Continue\"&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt;\n&lt;li&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;This will take you to PayPal where you can make your payment.&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt;\n&lt;li&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;Paying the membership fee does not make you immune from getting banned. If you break forum rules, you will get banned the $30 fee is non-refundable.&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt;\n&lt;\/ul&gt;&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;The attachments are a way to reward members that contribute more to the forum. Downloads are a huge resource hog and very taxing on the server so we do not want people to just download templates whenever they want. It causes the forum to run very slowly and is very resource intensive.\n\n&lt;strong&gt;&lt;u&gt;If you do NOT have enough posts to download a template, it means you are not active enough.&amp;nbsp;&lt;\/u&gt; This does not mean you should just post BS posts to get your post count up.&amp;nbsp; If you do so, your posts will be deleted and your account disabled.&lt;\/strong&gt;\n\n\nPlease do not ask for members to send you templates or downloads either on the forum or by PM. It is very time consuming for the member to send their downloads to everyone by email. That is why they are uploaded to the forum.\n\n&lt;strong&gt;If it is reported that you have posted or pm&#039;d a member for a template or download you will lose forum privileges temporarily.&amp;nbsp;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;We had to change the way downloads were distributed because of complaints that people did not understand the point system etc. Another example of how a few bad apples will ruin it for everyone else.\n\n&lt;strong&gt;This new rule goes into affect immediately. &lt;\/strong&gt;&lt;\/span&gt;&lt;\/span&gt;\n\n&amp;nbsp;&lt;\/p&gt;\n\n&lt;p&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;Here are some of the forum rules:&lt;\/strong&gt;\n&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/bestdestinationwedding.com\/forum\/faq.php&#039;&gt;BDW FAQs&lt;\/a&gt;\n\n&lt;strong&gt;Being a member of this forum is a priviledge and not a right. &lt;\/strong&gt;\n\n\nYou may lose some forum priviledges or be banned from the forum for the following reasons (not all may be listed here):\n\n&lt;strong&gt;Violation of privacy: &lt;\/strong&gt;Do Not post personal details about a user that contains their physical location or contact information without their permission. Such details include real name, address details, phone numbers, email addresses, etc.\n\n\nCopying their pictures and posting them elsewhere could also be a copyright infringement.\n\n&lt;strong&gt;Spamming:&lt;\/strong&gt; Accounts which are obviously created to spam the boards will be banned instantly and the offending posts will be deleted.\n\n\nAccounts that were not created to spam the board but do spam will be banned at the administration and moderators discretion.\n\n&lt;strong&gt;Disruption:&lt;\/strong&gt; Posting for the purpose of creating disruption on these boards will not be tolerated (e.g., \"baiting\" or \"trolling\"). This includes deliberately violating board guidelines and courtesies or otherwise posting in a manner that is deemed by BDW management to be disruptive or harassing. Please note that creating a new member name for the purpose of disruption places your primary BDW account in jeopardy, as well.\n\n&lt;strong&gt;Solicitations NOT Allowed:&lt;\/strong&gt; Solicitations by vendors AND brides are not allowed. It is so innapropriate to pm\/email a member about your services or a vendor that you are using unsolicited.\n\n\nThere is no warning on this matter. if you solicit, you may get banned.\n\n\nThese are just a few reasons but forum moderators can ban at their discretion.\n\n&lt;strong&gt;Also, for forum etiquette,&lt;\/strong&gt; this video is funny but a good guideline for what good forum etiquette is: &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/forum\/thread\/3673\/posting-and-you&#039;&gt;&lt;strong&gt;Posting and You!&lt;\/strong&gt;&lt;\/a&gt;&lt;\/span&gt;&lt;\/span&gt;\n\n&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;It is also important for Members to know other rules and PSA&#039;s to avoid getting banned. &lt;\/strong&gt;A good place to start reading is: &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/forum\/thread\/32834\/psa-why-members-get-banned&#039;&gt;&lt;strong&gt;Why Members get BANNED!&lt;\/strong&gt;&lt;\/a&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;Also, be sure to read the stickied threads in this forum&lt;\/strong&gt; (especially the PSA about Points, Sharing Photographer):&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;&lt;strong&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/bestdestinationwedding.com\/forum\/f49\/&#039;&gt;Forum News &amp;amp; Updates&lt;\/a&gt;&lt;\/strong&gt;\n&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/forum\/thread\/32313\/click-here-for-faq-s-and-to-learn-how-to-work-this-forum&#039;&gt;&lt;strong&gt;FAQs and how to navigate the FORUM&lt;\/strong&gt;&lt;\/a&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/forum\/thread\/29110\/psa-looking-to-share-a-photographer&#039;&gt;&lt;strong&gt;Looking to Share a Photographer?&lt;\/strong&gt;&lt;\/a&gt;\n\n&lt;strong&gt;Who is behind this forum? Who is Tammy Host?: &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/forum\/thread\/15295\/wright-travel-agency-tammy-host&#039;&gt;Wright Travel Agency&lt;\/a&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":822187,"PostDate":1251769810,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span  style=\"font-size:14px\"><span  style=\"font-family:arial, helvetica, sans-serif\">We have changed the rules about downloading attachments. You no longer need points to download attachments but instead you need to be have reached \"jr. member\" or higher status on the forum.<br><br><strong>To reach \"junior member\" status you need to have a minimum of 150 posts <\/strong><\/span><\/span><\/p>\n<p><span  style=\"font-size:14px\"><span  style=\"font-family:arial, helvetica, sans-serif\"><strong>- or -<\/strong><\/span><\/span><\/p>\n<p><span  style=\"font-size:14px\"><span  style=\"font-family:arial, helvetica, sans-serif\"><strong>You can by-pass the post count by becoming a <a href='http:\/\/www.bestdestinationwedding.com\/wedding-tips\/c\/general-bdw\/become-a-best-destination-wedding-supporter-r1740' class='bbc_url' title=''>BDW Supporter<\/a> <strong>(only for new paid memberships, not those already in existence).<\/strong><\/strong><br><br><strong>To become a<a href='http:\/\/www.bestdestinationwedding.com\/wedding-tips\/c\/general-bdw\/become-a-best-destination-wedding-supporter-r1740' class='bbc_url' title=''> <\/a><a href='http:\/\/www.bestdestinationwedding.com\/wiki\/become-a-best-destination-wedding-supporter' class='bbc_url' title=''>BDW Supporter<\/a>, in lieu of the post count requirement, please follow these instructions.<\/strong><\/span><\/span><br>\n\u00a0<\/p>\n<p><span  style=\"font-size:14px\"><span  style=\"font-family:arial, helvetica, sans-serif\">Some of the great benefits of being a supporter:<\/span><\/span><\/p>\n<ul><li><span  style=\"font-size:14px\"><span  style=\"font-family:arial, helvetica, sans-serif\">A special user badge on your postbit:<\/span><\/span><\/li>\n<li><span  style=\"font-size:14px\"><span  style=\"font-family:arial, helvetica, sans-serif\">The ability to download attachments*<\/span><\/span><\/li>\n<li><span  style=\"font-size:14px\"><span  style=\"font-family:arial, helvetica, sans-serif\">The knowledge you're supporting the site in a great way!<\/span><\/span><\/li>\n<\/ul><p>\u00a0<\/p>\n<p><span  style=\"font-size:14px\"><span  style=\"font-family:arial, helvetica, sans-serif\"><strong>For only $30, you'll become a Supporter for life.<\/strong><\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-size:14px\"><span  style=\"font-family:arial, helvetica, sans-serif\">* For more information about attachment limitations, please continue to read below.<\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-size:14px\"><span  style=\"font-family:arial, helvetica, sans-serif\">To become a BDW Supporter,<\/span><\/span><\/p>\n<ol><li><span  style=\"font-size:14px\"><span  style=\"font-family:arial, helvetica, sans-serif\">Click the button below to head over to the <a href='http:\/\/www.bestdestinationwedding.com\/store\/' class='bbc_url' title=''>Plan Selection page<\/a><\/span><\/span><\/li>\n\t<li><span  style=\"font-size:14px\"><span  style=\"font-family:arial, helvetica, sans-serif\">Select the \"Best Destination Wedding Supporter\" plan and click \"Continue\"<\/span><\/span><\/li>\n\t<li><span  style=\"font-size:14px\"><span  style=\"font-family:arial, helvetica, sans-serif\">You will be redirect to PayPal where you will make your payment<\/span><\/span><\/li>\n\t<li><span  style=\"font-size:14px\"><span  style=\"font-family:arial, helvetica, sans-serif\">After you make your payment and it has been processed, you will be automatically added to the Site Supporter group.<\/span><\/span><br><br>\n\t\u00a0<\/li>\n<\/ol><p  style=\"text-align:center\"><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/assets.bestdestinationwedding.com\/e\/e4\/e4ef8e8e_bdw_become_a_supporter.png\" alt=\"e4ef8e8e_bdw_become_a_supporter.png\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-size:14px\"><span  style=\"font-family:arial, helvetica, sans-serif\"><strong>Attachments & Downloading<\/strong><\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-size:14px\"><span  style=\"font-family:arial, helvetica, sans-serif\">On Best Destination Wedding, we have a wealth of attachments of hotel information, invitation templates, save the date templates, etc. etc.<\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-size:14px\"><span  style=\"font-family:arial, helvetica, sans-serif\">To download attachments, you must be a Junior Member.\u00a0 <strong>To reach \"junior member\" status you need to have a minimum of 150 posts.<\/strong><br><br><strong>- or -<br><br>\nYou can by-pass the post count by purchasing a Site Supporter membership.<\/strong><br><br><strong>To Purchase a Supporter Membership to download attachment in lieu of the post count requirement please follow these instructions.<\/strong><\/span><\/span><br>\n\u00a0<\/p>\n<ul><li><span  style=\"font-size:14px\"><span  style=\"font-family:arial, helvetica, sans-serif\">$30 one-time fee by-pass the 150 post requirement to download attachments.\u00a0<\/span><\/span><\/li>\n<li><span  style=\"font-size:14px\"><span  style=\"font-family:arial, helvetica, sans-serif\">Click the \"Become A Supporter\" button above and you will be taken to the plan selection page.<\/span><\/span><\/li>\n<li><span  style=\"font-size:14px\"><span  style=\"font-family:arial, helvetica, sans-serif\">Select the $30 Best Destination Wedding Supporter plan and click \"Continue\"<\/span><\/span><\/li>\n<li><span  style=\"font-size:14px\"><span  style=\"font-family:arial, helvetica, sans-serif\">This will take you to PayPal where you can make your payment.<\/span><\/span><\/li>\n<li><span  style=\"font-size:14px\"><span  style=\"font-family:arial, helvetica, sans-serif\">Paying the membership fee does not make you immune from getting banned. If you break forum rules, you will get banned the $30 fee is non-refundable.<\/span><\/span><\/li>\n<\/ul><p>\u00a0<\/p>\n<p><span  style=\"font-size:14px\"><span  style=\"font-family:arial, helvetica, sans-serif\">The attachments are a way to reward members that contribute more to the forum. Downloads are a huge resource hog and very taxing on the server so we do not want people to just download templates whenever they want. It causes the forum to run very slowly and is very resource intensive.<br><br><strong><u>If you do NOT have enough posts to download a template, it means you are not active enough.\u00a0<\/u> This does not mean you should just post BS posts to get your post count up.\u00a0 If you do so, your posts will be deleted and your account disabled.<\/strong><br><br>\nPlease do not ask for members to send you templates or downloads either on the forum or by PM. It is very time consuming for the member to send their downloads to everyone by email. That is why they are uploaded to the forum.<br><br><strong>If it is reported that you have posted or pm'd a member for a template or download you will lose forum privileges temporarily.\u00a0<\/strong><\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-size:14px\"><span  style=\"font-family:arial, helvetica, sans-serif\">We had to change the way downloads were distributed because of complaints that people did not understand the point system etc. Another example of how a few bad apples will ruin it for everyone else.<br><br><strong>This new rule goes into affect immediately. <\/strong><\/span><\/span><br>\n\u00a0<\/p>\n<br><p><span  style=\"font-size:14px\"><span  style=\"font-family:arial, helvetica, sans-serif\"><strong>Here are some of the forum rules:<\/strong><br><a href='http:\/\/bestdestinationwedding.com\/forum\/faq.php' class='bbc_url' title='External link' rel='nofollow external'>BDW FAQs<\/a><br><br><strong>Being a member of this forum is a priviledge and not a right. <\/strong><br><br>\nYou may lose some forum priviledges or be banned from the forum for the following reasons (not all may be listed here):<br><br><strong>Violation of privacy: <\/strong>Do Not post personal details about a user that contains their physical location or contact information without their permission. Such details include real name, address details, phone numbers, email addresses, etc.<br><br>\nCopying their pictures and posting them elsewhere could also be a copyright infringement.<br><br><strong>Spamming:<\/strong> Accounts which are obviously created to spam the boards will be banned instantly and the offending posts will be deleted.<br><br>\nAccounts that were not created to spam the board but do spam will be banned at the administration and moderators discretion.<br><br><strong>Disruption:<\/strong> Posting for the purpose of creating disruption on these boards will not be tolerated (e.g., \"baiting\" or \"trolling\"). This includes deliberately violating board guidelines and courtesies or otherwise posting in a manner that is deemed by BDW management to be disruptive or harassing. Please note that creating a new member name for the purpose of disruption places your primary BDW account in jeopardy, as well.<br><br><strong>Solicitations NOT Allowed:<\/strong> Solicitations by vendors AND brides are not allowed. It is so innapropriate to pm\/email a member about your services or a vendor that you are using unsolicited.<br><br>\nThere is no warning on this matter. if you solicit, you may get banned.<br><br>\nThese are just a few reasons but forum moderators can ban at their discretion.<br><br><strong>Also, for forum etiquette,<\/strong> this video is funny but a good guideline for what good forum etiquette is: <a href='http:\/\/www.bestdestinationwedding.com\/forum\/thread\/3673\/posting-and-you' class='bbc_url' title=''><strong>Posting and You!<\/strong><\/a><\/span><\/span><br>\n\u00a0<\/p>\n<p><span  style=\"font-size:14px\"><span  style=\"font-family:arial, helvetica, sans-serif\"><strong>It is also important for Members to know other rules and PSA's to avoid getting banned. <\/strong>A good place to start reading is: <a href='http:\/\/www.bestdestinationwedding.com\/forum\/thread\/32834\/psa-why-members-get-banned' class='bbc_url' title=''><strong>Why Members get BANNED!<\/strong><\/a><\/span><\/span><\/p>\n<p><span  style=\"font-size:14px\"><span  style=\"font-family:arial, helvetica, sans-serif\"><strong>Also, be sure to read the stickied threads in this forum<\/strong> (especially the PSA about Points, Sharing Photographer):<\/span><\/span><\/p>\n<p><span  style=\"font-size:14px\"><span  style=\"font-family:arial, helvetica, sans-serif\"><strong><a href='http:\/\/bestdestinationwedding.com\/forum\/f49\/' class='bbc_url' title='External link' rel='nofollow external'>Forum News & Updates<\/a><\/strong><br><a href='http:\/\/www.bestdestinationwedding.com\/forum\/thread\/32313\/click-here-for-faq-s-and-to-learn-how-to-work-this-forum' class='bbc_url' title=''><strong>FAQs and how to navigate the FORUM<\/strong><\/a><\/span><\/span><\/p>\n<p><span  style=\"font-size:14px\"><span  style=\"font-family:arial, helvetica, sans-serif\"><a href='http:\/\/www.bestdestinationwedding.com\/forum\/thread\/29110\/psa-looking-to-share-a-photographer' class='bbc_url' title=''><strong>Looking to Share a Photographer?<\/strong><\/a><br><br><strong>Who is behind this forum? Who is Tammy Host?: <a href='http:\/\/www.bestdestinationwedding.com\/forum\/thread\/15295\/wright-travel-agency-tammy-host' class='bbc_url' title=''>Wright Travel Agency<\/a><\/strong><\/span><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-family:arial, helvetica, sans-serif;\">Founder and Owner of BestDestinationWedding.com \u00a0\/ \u00a0<\/span><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/'><strong><span style=\"font-family:arial, helvetica, sans-serif;\">Bride & Groom Fly FREE Promotion<\/span><\/strong><\/a><\/p>\n<p>\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><a data-ipb='nomediaparse' href='https:\/\/www.wrighttravelagency.com\/go\/destination-wedding\/?source=EMLSIG'><strong><span style=\"color:#008080;\">Looking for a travel agency that specializes in Destination Weddings-CLICK HERE<\/span><\/strong><\/a><span style=\"color:#008080;\"><strong>?<\/strong> \u00a0We are an award winning travel agency and you can <\/span><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style=\"color:#008080;\">read our reviews\u00a0here.<\/span><\/a><\/strong><\/span><br>\n\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"color:#008080;\"><strong>Awards and recognition:\u00a0<\/strong><\/span><\/span><br><span style=\"color:#008080;\