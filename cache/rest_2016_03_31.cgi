-cdn.com\/cdn\/profile\/photo-281751.jpg?_r=1455392044","PhotoWidth":200,"PhotoHeight":222,"PhotoType":"custom"},"IsOnline":true}},{"Id":184,"Content":"Half guests from CAN, half from UK - Where do I start?","Date":1421446327,"TotalComments":0,"Author":{"Id":281751,"Name":"deecol","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281751.jpg?_r=1455392044","PhotoWidth":200,"PhotoHeight":222,"PhotoType":"custom"},"IsOnline":true}}],"Pages":{"TotalItems":7,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":2,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
