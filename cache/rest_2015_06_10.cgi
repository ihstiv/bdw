{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":118,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":24687,"MovedTo":null,"MovedOn":0,"FirstPostId":734415,"Rating":0,"RatingHits":0,"Starter":{"Id":217967,"Name":"VioletVol","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-217967.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"IsOnline":false},"StartDate":1245781207,"LastPoster":{"Id":276764,"Name":"becassidy","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":93,"Preview":{"Id":1861571,"PostDate":1406043313,"PostContent":"You don't need a ticket or an advance reservation, just make waves to our wedding celebration. B...","Author":{"Signature":"","Email":"becassidy@ymail.com","IpAddress":"151.151.109.15","GroupId":40,"GroupName":"Jr. Member","JoinDate":1392737096,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"becassidy","Id":276764,"Name":"becassidy","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":38244,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1c7a43ad499590e09b96896b66ecaeab","RawContent":"&lt;p&gt;Thanks for all the wording suggestions. Such great ideas!!&lt;\/p&gt;","Attachments":[],"Id":1816392,"PostDate":1385088200,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thanks for all the wording suggestions. Such great ideas!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rvalenka@gmail.com","IpAddress":"166.137.12.120","GroupId":40,"GroupName":"Jr. Member","JoinDate":1383890954,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-274900.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"rvalenka","Id":274900,"Name":"rvalenka","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.97.112.145","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":38244,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ab1ca14746494d53507005dd5705f683","RawContent":"&lt;p&gt;love the ideas!&lt;\/p&gt;","Attachments":[],"Id":1832703,"PostDate":1391899401,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>love the ideas!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"meghartman@gmail.com","IpAddress":"75.97.112.145","GroupId":40,"GroupName":"Jr. Member","JoinDate":1374432186,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-271770.jpg?_r=1391556917","PhotoWidth":200,"PhotoHeight":159,"PhotoType":"custom"},"FormattedName":"megan224","Id":271770,"Name":"megan224","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.87.31.101","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":38244,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f77fcd3b167f634ec22c905a271356ba","RawContent":"Very cute thanks for sharing!","Attachments":[],"Id":1851165,"PostDate":1400476401,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Very cute thanks for sharing! \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rheanna@uwalumni.com","IpAddress":"75.135.169.141","GroupId":40,"GroupName":"Jr. Member","JoinDate":1400445451,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278018.jpg?_r=1410892817","PhotoWidth":200,"PhotoHeight":131,"PhotoType":"custom"},"FormattedName":"Rheannarudy","Id":278018,"Name":"Rheannarudy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"89.100.218.185","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":38244,"EditedBy":"<strong>Edited by stefadile, 19 May 2014 - 09:33 AM.<\/strong>","EditDate":1400491985,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e40287ee917c439d10cb39aa2d714e94","RawContent":"Thanks for the wording, I think we&#039;ll send out an e-invite, it&#039;ll be the quickest and ,most cost effective option!! :-) :-)","Attachments":[],"Id":1851176,"PostDate":1400491908,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks for the wording, I think we'll send out an e-invite, it'll be the quickest and ,most cost effective option!! :-) :-) \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"prendest@tcd.ie","IpAddress":"89.100.218.185","GroupId":40,"GroupName":"Jr. Member","JoinDate":1382542889,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-274502.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"stefadile","Id":274502,"Name":"stefadile","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.87.31.101","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":38244,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"eb5665917da75abe03ba1c55db990400","RawContent":"[quote name=\"jaruszen\" post=\"1650767\" timestamp=\"1344534306\"]\nHi all!   We are getting married in Mexico in November and almost 30 family and friends will be joining us.  After the ceremony we will be having a mini-reception (dinner and dancing) that evening.  We are then having an AHR in January and expect about 150 people.   I was wondering if you have any recommendations\/comments about sending the Mexico invite and the AHR invite together to all 150 people?  Do you typically send the Destination invite and AHR invite separately and at separate times?     The invitation would include:  -Mexico ceremony  -Mexico &#039;reception&#039; - menu choices and response card  -AHR Information  -AHR Response Card     I was thinking about sending them together so those that can&#039;t go to Mexico don&#039;t feel left out and they know that there will be a party to celebrate.  The fiance disagrees haha.  Any help is appreciated![\/quote]\nWe are planning to do the same - send both Mexico &amp;amp; AHR invites together.  Anyone aware of any threads on this?","Attachments":[],"Id":1851688,"PostDate":1400722406,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>jaruszen, on 09 August 2012 - 01:45 PM, said:<\/p><div class='blockquote'><div class='quote'><p>Hi all!\u00a0\u00a0 We are getting married in Mexico in November and almost 30\u00a0family and friends will be joining us.\u00a0 After the ceremony we will be having a mini-reception (dinner and dancing) that evening.\u00a0 We are then\u00a0having an AHR in January and expect about 150 people.\u00a0 \u00a0I was wondering if you have any recommendations\/comments about sending the Mexico invite and the AHR invite together to all 150 people?\u00a0 Do you typically send the Destination invite and AHR invite separately and at separate times?  \u00a0  The invitation would include:  -Mexico ceremony  -Mexico 'reception' - menu choices and response card  -AHR Information  -AHR Response Card  \u00a0  I was thinking about sending them together so those that can't go to Mexico don't feel left out and they know that there will be a party to celebrate.\u00a0 The fiance disagrees haha.\u00a0 Any help is appreciated!<\/p><\/div><\/div>\n<br>\nWe are planning to do the same - send both Mexico & AHR invites together.  Anyone aware of any threads on this? \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rheanna@uwalumni.com","IpAddress":"75.135.169.141","GroupId":40,"GroupName":"Jr. Member","JoinDate":1400445451,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278018.jpg?_r=1410892817","PhotoWidth":200,"PhotoHeight":131,"PhotoType":"custom"},"FormattedName":"Rheannarudy","Id":278018,"Name":"Rheannarudy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"184.65.100.98","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":38244,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8c661f7331ed6ff9e7ac0da64972f9cd","RawContent":"&lt;p&gt;How are people wording their AHR invites if they are being sent out before the DW takes place?&lt;\/p&gt;\n&lt;p&gt;For example I invited 55 people to Mexico, and have 100 invites for the AHR. (Keeping it small). We&#039;re having our AHR 1 week after the DW so invites for the AHR need to go out well before the trip. Everything I think of sounds like:&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;\"______ and ______ will be getting married on the beaches of Mexico on May 26, 2015 (WHICH YOUR NOT INVITED TO), please join us as we celebrate one more time at our local cocktail reception on June 6, 2015\"&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Or am I the only heartless one that had a separate guest list for DW and AHR?? I can&#039;t afford to bring everyone to Mexico because my reception costs $100 a person!&lt;\/p&gt;","Attachments":[],"Id":1852981,"PostDate":1401534546,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>How are people wording their AHR invites if they are being sent out before the DW takes place?<\/p>\n<p>For example I invited 55 people to Mexico, and have 100 invites for the AHR. (Keeping it small). We're having our AHR 1 week after the DW so invites for the AHR need to go out well before the trip. Everything I think of sounds like:<\/p>\n<p>\u00a0<\/p>\n<p>\"______ and ______ will be getting married on the beaches of Mexico on May 26, 2015 (WHICH YOUR NOT INVITED TO), please join us as we celebrate one more time at our local cocktail reception on June 6, 2015\"<\/p>\n<p>\u00a0<\/p>\n<p>Or am I the only heartless one that had a separate guest list for DW and AHR?? I can't afford to bring everyone to Mexico because my reception costs $100 a person!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nikkicraig10@gmail.com","IpAddress":"204.174.77.34","GroupId":39,"GroupName":"Newbie","JoinDate":1395764738,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"nikkicraig10","Id":277331,"Name":"nikkicraig10","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"166.137.10.112","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":38244,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"57441f7e6166b0daaa1f0c6b8e47ac74","RawContent":"We had separate invite lists also. It was a tough decision on the wording. \n\nHere&#039;s a picture of the wording we settled on for our invite. \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1853016,"PostDate":1401552106,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We had separate invite lists also. It was a tough decision on the wording. <br>\nHere's a picture of the wording we settled on for our invite. <a class='resized_img' rel='lightbox[1853016]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2014\/post-274900-140156637808.jpg\" title=\"ImageUploadedByTapatalk1401566374.591890.jpg - Size: 209.32KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2014\/post-274900-140156637808.jpg\" class='bbc_img linked-image' alt=\"ImageUploadedByTapatalk1401566374.591890.jpg\" \/><\/a>\n\n<a class='resized_img' rel='lightbox[1853016]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2014\/post-274900-140156637808.jpg\" title=\"ImageUploadedByTapatalk1401566374.591890.jpg - Size: 209.32KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2014\/post-274900-140156637808.jpg\" class='bbc_img linked-image' alt=\"ImageUploadedByTapatalk1401566374.591890.jpg\" \/><\/a>\n\n<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rvalenka@gmail.com","IpAddress":"166.137.12.120","GroupId":40,"GroupName":"Jr. Member","JoinDate":1383890954,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-274900.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"rvalenka","Id":274900,"Name":"rvalenka","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.251.90.66","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":38244,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a18ed340fc4f48c0e55524d71bd1baec","RawContent":"&lt;p&gt;\n\nYou don&#039;t need a ticket\n\nor an advance reservation,\n\njust make waves\n\nto our wedding celebration.\n\n\nBRIDE\n\nand\n\nGROOM\n\nwill be married on\n\nDATE\n\nLOCATION\n\nPlease join them for a reception\n\nwhen they return\n\nDATE at TIME\n\nLOCATION\n\nADDRESS\n\nCITY, STATE&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I absolutely LOVE this!! I need to send out invites BEFORE our wedding so I was struggling with wording. Thank you!!!&lt;\/p&gt;","Attachments":[],"Id":1861571,"PostDate":1406043313,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><br>\nYou don't need a ticket<br>\nor an advance reservation,<br>\njust make waves<br>\nto our wedding celebration.<br><br>\nBRIDE<br>\nand<br>\nGROOM<br>\nwill be married on<br>\nDATE<br>\nLOCATION<br>\nPlease join them for a reception<br>\nwhen they return<br>\nDATE at TIME<br>\nLOCATION<br>\nADDRESS<br>\nCITY, STATE<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I absolutely LOVE this!! I need to send out invites BEFORE our wedding so I was struggling with wording. Thank you!!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"becassidy@ymail.com","IpAddress":"151.151.109.15","GroupId":40,"GroupName":"Jr. Member","JoinDate":1392737096,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"becassidy","Id":276764,"Name":"becassidy","IsOnline":false}}],"Id":"38244","Title":"AHR Invitation Wording","LastPostDate":1406043313},"Pages":{"TotalItems":118,"TotalPages":12,"CurrentPage":110,"NextPage":-1,"PreviousPage":100,"LastPage":110},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
