pe=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I like the poem idea...did anyone do something simple like we tied the knot now come celebrate with us? something like that<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kefritz21@gmail.com","IpAddress":"","GroupId":5,"GroupName":"Banned","JoinDate":1364506581,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kefritz","Id":267926,"Name":"kefritz","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":38244,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"964ef99e4b1f74bea1bad1e19083f07d","RawContent":"[quote]\nOriginally Posted by [b]kefritz[\/b] \/img\/forum\/go_quote.gif\n \n \n I like the poem idea...did anyone do something simple like we tied the knot now come celebrate with us? something like that[\/quote] \n \n We just said, \"_________ and __________ were married in an intimate ceremony in the Dominican Republic on July 18, 2013. Come celebrate in Alberta the vows shared in the Caribbean.\" \n \n Simple.","Attachments":[],"Id":1739912,"PostDate":1364516741,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>kefritz<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <p> I like the poem idea...did anyone do something simple like we tied the knot now come celebrate with us? something like that<\/p> <\/blockquote> <p> \u00a0<\/p> <p> We just said, \"_________ and __________ were married in an intimate ceremony in the Dominican Republic on July 18, 2013. Come celebrate in Alberta the vows shared in the Caribbean.\"<\/p> <p> \u00a0<\/p> <p> Simple.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"krys85418@gmail.com","IpAddress":"108.181.124.120","GroupId":42,"GroupName":"Sr. Member","JoinDate":1301859312,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-238489.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"Peach","Id":238489,"Name":"Peach","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":false,"TopicId":38244,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"04ac7b67f2f01116142ea3fb5db6f82e","RawContent":"I really like that thank you!","Attachments":[],"Id":1739943,"PostDate":1364548448,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                