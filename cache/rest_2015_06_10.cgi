89,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>GracieBebe<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">You should try <a href='http:\/\/www.verseit.com' class='bbc_url' title='External link' rel='nofollow external'>VerseIt.com<\/a>. It has a bunch of great wording for all types of invitations. We got our AHR wording from there.<\/div> <\/td> <\/tr> <\/table> <\/div>great website, thanks for the link!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i910.photobucket.com\/albums\/ac309\/otalison\/700_5790sm.jpg\">http:\/\/i910.photobucket.com\/albums\/a...700_5790sm.jpg<\/a><\/div><\/div>","Email":"otalison@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1256953640,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-222968.jpeg?_r=0","PhotoWidth":187,"PhotoHeight":270,"PhotoType":"custom"},"FormattedName":"futuremrsgoodrich","Id":222968,"Name":"futuremrsgoodrich","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQu