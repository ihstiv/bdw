   <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> wow thats a lot of work, I'm sure your guests will LOVE it! So much goodies!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"caroline_diem@hotmail.com","IpAddress":"70.160.34.128","GroupId":40,"GroupName":"Jr. Member","JoinDate":1289129755,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-233772.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"coquine","Id":233772,"Name":"coquine","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":64500,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"67570509d235babbb16c3d61620441a1","RawContent":"&lt;p&gt; Your bags look amazing! Your guests are absolutely going to love them! Our OOTs are super similar, down to the same bag and colours! Great minds think alike!&amp;nbsp;&lt;img id=\"yui_3_4_1_21_1322012535918_8\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/msnwink.gif\" \/&gt;&lt;\/p&gt;","Attachments":[],"Id":1549772,"PostDate":1321998279,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Your bags look amazing! Your guests are absolutely going to love them! Our OOTs are super similar, down to the same bag and colours! Great minds think alike!\u00a0<span rel='lightbox'><img class='bbc_img' id=\"yui_3_4_1_21_1322012535918_8\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/msnwink.gif\" \/><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kgodi061@uottawa.ca","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1300304267,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-237887.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"BusyBee123","Id":237887,"Name":"BusyBee123","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":64500,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"69ef6ba5902b90a95cb95749eeae9dee","RawContent":"&lt;p&gt; Your guests will love these!!!&lt;\/p&gt;","Attachments":[],"Id":1549821,"PostDate":1322002605,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Your guests will love these!!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"saraylin@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1296934025,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-236417.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"slin2011","Id":236417,"Name":"slin2011","IsOnline":false}}],"Id":"64500","Title":"MJKH - Wedding week survival bags are done!!! Lots of pics : )","LastPostDate":1433760058},"Pages":{"TotalItems":163,"TotalPages":17,"CurrentPage":10,"NextPage":20,"PreviousPage":0,"LastPage":160},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
