{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":10,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":487,"MovedTo":null,"MovedOn":0,"FirstPostId":1907060,"Rating":0,"RatingHits":0,"Starter":{"Id":285228,"Name":"Vjohana","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-285228.jpg?_r=1447965003","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":false},"StartDate":1446517359,"LastPoster":{"Id":281055,"Name":"snswedding2016","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281055.jpg?_r=1415590512","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":true},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1907060,"PostDate":1446517359,"PostContent":"I just got engaged and I have no idea where to begin. I am open to all places, not just Mexico. H...","Author":{"Signature":"","Email":"vrichani@gmail.com","IpAddress":"70.208.70.11","GroupId":39,"GroupName":"Newbie","JoinDate":1446516797,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-285228.jpg?_r=1447965003","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Vjohana","Id":285228,"Name":"Vjohana","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"100.35.39.226","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79702,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"54f2b76f6df47079af339cf815656136","RawContent":"I just got engaged and I have no idea where to begin. I am open to all places, not just Mexico. However I&#039;m under a pretty tight budget under $10k. Ideally $7k. Is it doable? For an all inclusive ?","Attachments":[],"Id":1907060,"PostDate":1446517359,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I just got engaged and I have no idea where to begin. I am open to all places, not just Mexico. However I'm under a pretty tight budget under $10k. Ideally $7k. Is it doable? For an all inclusive ?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"vrichani@gmail.com","IpAddress":"70.208.70.11","GroupId":39,"GroupName":"Newbie","JoinDate":1446516797,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-285228.jpg?_r=1447965003","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Vjohana","Id":285228,"Name":"Vjohana","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.146.146.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79702,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"ab9e3c74efbe49a4f0f2f355ea7a6399","RawContent":"Welcome and congrats!\n\n\nIs your budget of $7k for wedding alone or for your trip as well? For wedding alone that&#039;s very doable if your guest list isn&#039;t extensive. Ie 100 people. \n\n\nFinding the resort is the hardest part and a travel agent will be your best friend.  They will help narrow down location and resort based on pricing, your wants list, and wedding packages. Also can get you a group rate and sometimes hotel perks!\n\n\nGood luck \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1907069,"PostDate":1446527751,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Welcome and congrats!<br><br>\nIs your budget of $7k for wedding alone or for your trip as well? For wedding alone that's very doable if your guest list isn't extensive. Ie 100 people. <br><br>\nFinding the resort is the hardest part and a travel agent will be your best friend.  They will help narrow down location and resort based on pricing, your wants list, and wedding packages. Also can get you a group rate and sometimes hotel perks!<br><br>\nGood luck <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399428602,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"96.242.17.69","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79702,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6427fff008de5eabfa2c4ef4c338374b","RawContent":"&lt;p&gt;Hi All,&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Last Saturday, I was engaged to the man of my dreams and I couldn&#039;t be any happier. Out situation is tough because we have a large family, not much money to spend, and we are in a long distance relationship so we opted for a Destination wedding. I do not really know where to begin and have been trying to do some research on my own.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Here are some details:&lt;\/p&gt;\n&lt;p&gt;- We want to get married end of July\/ August 2016 (tight deadline).&lt;\/p&gt;\n&lt;p&gt;- We are thinking of having about 40 - 50 guests.&lt;\/p&gt;\n&lt;p&gt;- We really want an all inclusive resort.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;- We are thinking Mexico but are open to ideas&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Is a $7K budget really doable? This would include our wedding packages, resort, and travel. We would have the guests pay for their travel and resort costs and would ideally love to find something affordable for the, We are young and inlove and unfortunately not rich. :(&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Any help would be GREATLY appreciated.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1907101,"PostDate":1446604743,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi All,<\/p>\n<p>\u00a0<\/p>\n<p>Last Saturday, I was engaged to the man of my dreams and I couldn't be any happier. Out situation is tough because we have a large family, not much money to spend, and we are in a long distance relationship so we opted for a Destination wedding. I do not really know where to begin and have been trying to do some research on my own.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Here are some details:<\/p>\n<p>- We want to get married end of July\/ August 2016 (tight deadline).<\/p>\n<p>- We are thinking of having about 40 - 50 guests.<\/p>\n<p>- We really want an all inclusive resort.\u00a0<\/p>\n<p>- We are thinking Mexico but are open to ideas<\/p>\n<p>\u00a0<\/p>\n<p>Is a $7K budget really doable? This would include our wedding packages, resort, and travel. We would have the guests pay for their travel and resort costs and would ideally love to find something affordable for the, We are young and inlove and unfortunately not rich. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/sad.png' class='bbc_emoticon' alt=':(' \/><\/p>\n<p>\u00a0<\/p>\n<p>Any help would be GREATLY appreciated.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"vrichani@gmail.com","IpAddress":"70.208.70.11","GroupId":39,"GroupName":"Newbie","JoinDate":1446516797,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-285228.jpg?_r=1447965003","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Vjohana","Id":285228,"Name":"Vjohana","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.202.225.11","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79702,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"16abac52b23ab88e34e407594eb175a0","RawContent":"&lt;p&gt;@Vjohana&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;$7k is a little tight when you take out your travel costs but it is not impossible because there are some resorts that offer \"free\" weddings and private events if you have a certain # of rooms\/nights booked through a group block.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Also, we have a promo running where we give back up to $1000 back to the bride and groom for airfare. &amp;nbsp;So if you take advantage of the different promotions out there it is doable.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;If you want more info, you can email us at info@wrighttravelagency.com or use the submission link in my signature.&lt;\/p&gt;","Attachments":[],"Id":1907103,"PostDate":1446605456,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@Vjohana\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>$7k is a little tight when you take out your travel costs but it is not impossible because there are some resorts that offer \"free\" weddings and private events if you have a certain # of rooms\/nights booked through a group block.<\/p>\n<p>\u00a0<\/p>\n<p>Also, we have a promo running where we give back up to $1000 back to the bride and groom for airfare. \u00a0So if you take advantage of the different promotions out there it is doable.<\/p>\n<p>\u00a0<\/p>\n<p>If you want more info, you can email us at info@wrighttravelagency.com or use the submission link in my signature.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-family:arial, helvetica, sans-serif;\">Founder and Owner of BestDestinationWedding.com \u00a0\/ \u00a0<\/span><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/'><strong><span style=\"font-family:arial, helvetica, sans-serif;\">Bride & Groom Fly FREE Promotion<\/span><\/strong><\/a><\/p>\n<p>\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><strong><a data-ipb='nomediaparse' href='http:\/\/wrighttravelagency.com\/inquiry\/'><span style=\"color:#008080;\">Looking for a travel agency that specializes in Destination Weddings<\/span><\/a><\/strong><span style=\"color:#008080;\"><strong>?<\/strong> \u00a0We are an award winning travel agency and you can <\/span><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style=\"color:#008080;\">read our reviews\u00a0here.<\/span><\/a><\/strong><\/span><br>\n\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"color:#008080;\"><strong>Awards and recognition:\u00a0<\/strong><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Palace Resorts Winner \"Top Travel Agent\", \"Top Homebased Travel Agency\" PRO Platinum Agency (Top Award) \u00a0 \u00a0 | \u00a0 \u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">AMResorts Master Agent & Top Agency \u00a0<\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/68050-karisma-hotels-givc-and-gi-wedding-consultants-wright-travel-agency\/'><strong>Wright Travel & Karisma GIVC Benefits<\/strong><\/a><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Travel Impressions Best of the Best Globe Winner \u00a0 \u00a0| \u00a0 \u00a0\u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Apple Vacations Golden Apple Winner \u00a0<\/span><\/span><br><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"> \u00a0 \u00a0<img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"font-size:14px;\"><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010'>Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><\/span><\/span><strong><span style=\"color:#b22222;\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a data-ipb='nomediaparse' href='mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com'>ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"admin@bestdestinationwedding.com","IpAddress":"71.202.225.11","GroupId":4,"GroupName":"Administrators","JoinDate":1137224220,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"FormattedName":"TammyWright","Id":206696,"Name":"TammyWright","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"190.80.187.138","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79702,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"28d1aa90fcdf7f5cd93745018631be3d","RawContent":"&lt;p&gt;Congrats on your 2016 dw coming up Vjohana and welcome to our forum community!!! you&#039;ve come to the right place to find lots of helpful info to assist you with your planning decisions - so well done :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Mexico is a very popular destination choice for lots of wedding couples, and you can see why when you look at these magical wedding moments that matter we&#039;ve captured in our magnificent Mayan Riviera......taken from our &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10150695320839487.414941.18683524486&amp;amp;type=3&#039;&gt;Cover Photos Album: &lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-atl3-1.xx.fbcdn.net\/hphotos-xat1\/t31.0-8\/12109790_10153682859529487_4869403078968401747_o.jpg\" alt=\"12109790_10153682859529487_4869403078968\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-atl3-1.xx.fbcdn.net\/hphotos-xtp1\/t31.0-8\/12109810_10153677938589487_5335644766497317680_o.jpg\" alt=\"12109810_10153677938589487_5335644766497\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-atl3-1.xx.fbcdn.net\/hphotos-xpa1\/t31.0-8\/11951533_10153610355409487_3502002007315431031_o.jpg\" alt=\"11951533_10153610355409487_3502002007315\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Hope you find all the answers you&#039;re looking for, and Enjoy your journey ahead - cheers!!! team MTM :)&lt;\/p&gt;","Attachments":[],"Id":1907135,"PostDate":1446654669,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats on your 2016 dw coming up Vjohana and welcome to our forum community!!! you've come to the right place to find lots of helpful info to assist you with your planning decisions - so well done <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Mexico is a very popular destination choice for lots of wedding couples, and you can see why when you look at these magical wedding moments that matter we've captured in our magnificent Mayan Riviera......taken from our <a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10150695320839487.414941.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>Cover Photos Album: <\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-atl3-1.xx.fbcdn.net\/hphotos-xat1\/t31.0-8\/12109790_10153682859529487_4869403078968401747_o.jpg\" alt=\"12109790_10153682859529487_4869403078968\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-atl3-1.xx.fbcdn.net\/hphotos-xtp1\/t31.0-8\/12109810_10153677938589487_5335644766497317680_o.jpg\" alt=\"12109810_10153677938589487_5335644766497\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-atl3-1.xx.fbcdn.net\/hphotos-xpa1\/t31.0-8\/11951533_10153610355409487_3502002007315431031_o.jpg\" alt=\"11951533_10153610355409487_3502002007315\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>Hope you find all the answers you're looking for, and Enjoy your journey ahead - cheers!!! team MTM <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280210660,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"96.242.17.69","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79702,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f94a41b29adb9490bedf0a246f831726","RawContent":"&lt;p&gt;Thank you everyone for the wonderful advice. I think the hardest part is trying to figure out how and where to start my destination wedding planning :) There seems to be a lot of useful information on here!&lt;\/p&gt;","Attachments":[],"Id":1907174,"PostDate":1446743402,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thank you everyone for the wonderful advice. I think the hardest part is trying to figure out how and where to start my destination wedding planning <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> There seems to be a lot of useful information on here!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"vrichani@gmail.com","IpAddress":"70.208.70.11","GroupId":39,"GroupName":"Newbie","JoinDate":1446516797,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-285228.jpg?_r=1447965003","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Vjohana","Id":285228,"Name":"Vjohana","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"98.229.104.230","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79702,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"78e2759b2f850eac7ea0030a62dc88d5","RawContent":"Mine is 6k for the wedding alone for 40 people \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1907180,"PostDate":1446775408,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Mine is 6k for the wedding alone for 40 people <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"malyna@gmail.com","IpAddress":"71.235.105.205","GroupId":40,"GroupName":"Jr. Member","JoinDate":1397440022,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277580.jpg?_r=1397779480","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"malyna","Id":277580,"Name":"malyna","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.87.97.157","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79702,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d0353a4bdaab0b86c738660705fc0168","RawContent":"I would start by getting a,Travel agent they could really help deciding where you want to go.","Attachments":[],"Id":1907259,"PostDate":1447024488,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I would start by getting a,Travel agent they could really help deciding where you want to go.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lori.yepez@aa.com","IpAddress":"173.74.136.107","GroupId":39,"GroupName":"Newbie","JoinDate":1440294410,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"lorishultz2016","Id":284536,"Name":"lorishultz2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"96.242.17.69","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79702,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"876b663fdb6c238d7474f02471d06561","RawContent":"&lt;p&gt;Thanks! Does anyone have a good recommendation for a travel agent? I have been working with a local one but I am getting the feeling they are not very experienced in DW.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1907697,"PostDate":1447944869,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thanks! Does anyone have a good recommendation for a travel agent? I have been working with a local one but I am getting the feeling they are not very experienced in DW.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"vrichani@gmail.com","IpAddress":"70.208.70.11","GroupId":39,"GroupName":"Newbie","JoinDate":1446516797,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-285228.jpg?_r=1447965003","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Vjohana","Id":285228,"Name":"Vjohana","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.53.254.39","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79702,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ae6ebcba6ffa3345fb71047bafb71199","RawContent":"&lt;p&gt;@[member=\"Vjohana\"] where are you located? I have a great TA that I&#039;m working with who is just outside of Toronto. All of our correspondence is via email and phone. She really has been the best decision I&#039;ve made in planning our wedding. Let me know if you&#039;d like me to give you her contact info.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;If you&#039;re from the US, Wright Travel through this site is great and I&#039;m sure they would be a great asset to have.&lt;\/p&gt;","Attachments":[],"Id":1907706,"PostDate":1447954943,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"285228\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/285228-vjohana\/' title='Member profile'><span itemprop=\"name\">Vjohana<\/span><\/a> where are you located? I have a great TA that I'm working with who is just outside of Toronto. All of our correspondence is via email and phone. She really has been the best decision I've made in planning our wedding. Let me know if you'd like me to give you her contact info.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>If you're from the US, Wright Travel through this site is great and I'm sure they would be a great asset to have.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>My planning thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78916-snswedding2016-planning-thread-jan-9-2016-azul-fives\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78916-snswedding2016-planning-thread-jan-9-2016-azul-fives\/<\/a><\/p>\n<p>\u00a0<\/p>\n<div><a class='bbc_url' href='http:\/\/www.TickerFactory.com\/'><\/div>\n<div><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10730;0\/st\/20160109\/e\/Our+Wedding\/k\/9fa9\/event.png\" alt=\"event.png\"><\/div>\n<div><\/a><\/div>\n","Email":"sean.n.steph2016@gmail.com","IpAddress":"74.12.52.42","GroupId":40,"GroupName":"Jr. Member","JoinDate":1415547511,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281055.jpg?_r=1415590512","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"snswedding2016","Id":281055,"Name":"snswedding2016","IsOnline":true}}],"Id":"79702","Title":"Destination With About 40-50 Guests With Budget Of 7K. Is This Doable?","LastPostDate":1447954943},"Pages":{"TotalItems":10,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
