{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":28,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":15367,"MovedTo":null,"MovedOn":0,"FirstPostId":1831107,"Rating":0,"RatingHits":0,"Starter":{"Id":271556,"Name":"jnellerose","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-271556.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"StartDate":1391291351,"LastPoster":{"Id":206696,"Name":"TammyWright","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":118,"Preview":{"Id":1866473,"PostDate":1408065541,"PostContent":"I have sent the General Manager this thread so he can keep up with the issues. \u00a0 You should also...","Author":{"Signature":"<p><span style=\"font-family:arial, helvetica, sans-serif;\">Founder and Owner of BestDestinationWedding.com \u00a0\/ \u00a0<\/span><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/'><strong><span style=\"font-family:arial, helvetica, sans-serif;\">Bride & Groom Fly FREE Promotion<\/span><\/strong><\/a><\/p>\n<p>\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><strong><a data-ipb='nomediaparse' href='http:\/\/wrighttravelagency.com\/inquiry\/'><span style=\"color:#008080;\">Looking for a travel agency that specializes in Destination Weddings<\/span><\/a><\/strong><span style=\"color:#008080;\"><strong>?<\/strong> \u00a0We are an award winning travel agency and you can <\/span><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style=\"color:#008080;\">read our reviews\u00a0here.<\/span><\/a><\/strong><\/span><br>\n\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"color:#008080;\"><strong>Awards and recognition:\u00a0<\/strong><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Palace Resorts Winner \"Top Travel Agent\", \"Top Homebased Travel Agency\" PRO Platinum Agency (Top Award) \u00a0 \u00a0 | \u00a0 \u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">AMResorts Master Agent & Top Agency \u00a0<\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/68050-karisma-hotels-givc-and-gi-wedding-consultants-wright-travel-agency\/'><strong>Wright Travel & Karisma GIVC Benefits<\/strong><\/a><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Travel Impressions Best of the Best Globe Winner \u00a0 \u00a0| \u00a0 \u00a0\u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Apple Vacations Golden Apple Winner \u00a0<\/span><\/span><br><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"> \u00a0 \u00a0<img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"font-size:14px;\"><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010'>Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><\/span><\/span><strong><span style=\"color:#b22222;\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a data-ipb='nomediaparse' href='mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com'>ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"admin@bestdestinationwedding.com","IpAddress":"71.202.225.11","GroupId":4,"GroupName":"Administrators","JoinDate":1137224220,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"FormattedName":"TammyWright","Id":206696,"Name":"TammyWright","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"65.60.68.42","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76214,"EditedBy":"<strong>Edited by andiegarcia, 30 May 2014 - 09:45 AM.<\/strong>","EditDate":1401471909,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"46a851f8e8da91536b426e9cb6f1e987","RawContent":"&lt;p&gt;I was having some luck with Magda planning our wedding and even had a positive experience getting to meet her at the resort for a site visit in November.&amp;nbsp; Its sad to hear the overwhelming amount of negative feedback from the WC&#039;s at dreams.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Unfortunately, Magda has moved on and she has moved me to a new WC - Shantal.&amp;nbsp; Communication with Shantal has been AWFUL!&amp;nbsp; I&#039;m two weeks out from my wedding and have questions that haven&#039;t been answered.&amp;nbsp; I&#039;ve even been CC&#039;ing David Ocete, one of her managers and still haven&#039;t had a response to an email I sent last week.&amp;nbsp; VERY DISSAPOINTED! I will certainly let everyone at the resort know this has not been easy, especially in the final weeks of wedding planning.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Anyone else working with Shantal having the same experience?&lt;\/p&gt;","Attachments":[],"Id":1852811,"PostDate":1401471848,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I was having some luck with Magda planning our wedding and even had a positive experience getting to meet her at the resort for a site visit in November.\u00a0 Its sad to hear the overwhelming amount of negative feedback from the WC's at dreams.<\/p>\n<p>\u00a0<\/p>\n<p>Unfortunately, Magda has moved on and she has moved me to a new WC - Shantal.\u00a0 Communication with Shantal has been AWFUL!\u00a0 I'm two weeks out from my wedding and have questions that haven't been answered.\u00a0 I've even been CC'ing David Ocete, one of her managers and still haven't had a response to an email I sent last week.\u00a0 VERY DISSAPOINTED! I will certainly let everyone at the resort know this has not been easy, especially in the final weeks of wedding planning.<\/p>\n<p>\u00a0<\/p>\n<p>Anyone else working with Shantal having the same experience?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"andiengarcia@gmail.com","IpAddress":"75.140.67.22","GroupId":39,"GroupName":"Newbie","JoinDate":1352780411,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-262321.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"andiegarcia","Id":262321,"Name":"andiegarcia","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"198.228.200.144","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76214,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9f3f53f63233a3cfb566f47f133c9360","RawContent":"hi,\n\nthanks for all the responses to my post.\n\nwe ended up working with Shantal, because we were having such bad responses from Angel Garcia.  Then Shantal didn&#039;t prove to be much better.  However, I did have better luck reaching Shantal through Skype.. so if you don&#039;t have a skype account, definitely make one and search for her on there.  at least you will have direct contact to her!\n\nUltimately, we ended up canceling our wedding with Dreams because they were overbooked for our wedding week in October.  We have since moved our wedding to Pueblo Bonito Sunset Beach, and communication so far has been pretty good.\n\nIt&#039;s such a shame.. dreams is supposed to be top notch for destination weddings but my experience with them has proven to be anything but that.","Attachments":[],"Id":1852815,"PostDate":1401472480,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                hi,<br>\nthanks for all the responses to my post.<br>\nwe ended up working with Shantal, because we were having such bad responses from Angel Garcia.  Then Shantal didn't prove to be much better.  However, I did have better luck reaching Shantal through Skype.. so if you don't have a skype account, definitely make one and search for her on there.  at least you will have direct contact to her!<br>\nUltimately, we ended up canceling our wedding with Dreams because they were overbooked for our wedding week in October.  We have since moved our wedding to Pueblo Bonito Sunset Beach, and communication so far has been pretty good.<br>\nIt's such a shame.. dreams is supposed to be top notch for destination weddings but my experience with them has proven to be anything but that.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"janelle.gonzales@gmail.com","IpAddress":"198.228.201.149","GroupId":39,"GroupName":"Newbie","JoinDate":1373911579,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-271556.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"jnellerose","Id":271556,"Name":"jnellerose","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"65.60.68.42","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76214,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"890aa4e60c6c015739c9c393252cf562","RawContent":"&lt;p&gt;HI!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We FINALLY heard back from Shantal.&amp;nbsp; She claims that she&#039;s been having \"trouble with her emails,\" which is why she hasn&#039;t received any of my emails.&amp;nbsp; So frustrating!&amp;nbsp; Then when I asked for a detailed list of our expenses, she sent us the wrong wedding expense sheet. It has been one&amp;nbsp;problem after another.&amp;nbsp; I&#039;m nervous about the execution and service on the day of the wedding.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Tammy, is there someone I can talk to when I get to the resort on Thursday about the terrible service\/communication we&#039;ve had since working with Shantal?&lt;\/p&gt;","Attachments":[],"Id":1854575,"PostDate":1402421153,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>HI!<\/p>\n<p>\u00a0<\/p>\n<p>We FINALLY heard back from Shantal.\u00a0 She claims that she's been having \"trouble with her emails,\" which is why she hasn't received any of my emails.\u00a0 So frustrating!\u00a0 Then when I asked for a detailed list of our expenses, she sent us the wrong wedding expense sheet. It has been one\u00a0problem after another.\u00a0 I'm nervous about the execution and service on the day of the wedding.<\/p>\n<p>\u00a0<\/p>\n<p>Tammy, is there someone I can talk to when I get to the resort on Thursday about the terrible service\/communication we've had since working with Shantal?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"andiengarcia@gmail.com","IpAddress":"75.140.67.22","GroupId":39,"GroupName":"Newbie","JoinDate":1352780411,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-262321.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"andiegarcia","Id":262321,"Name":"andiegarcia","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.90.231.16","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76214,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b72bc0f13c0e3c3f519e5015c087459b","RawContent":"Hi everyone! I have had the same experience with the WCs at the dreams. Went from Mariana to Magda and now with Shantal. My wedding isn&#039;t until September 20th, but still would like to feel at ease by having all of my vendors booked. I have booked my dj, photographer and videographer, and also the reverend. But I still need to book a florist, and a few other things such as the cake and I wanted to do cigar rolling. Do any of you know how I can do that on my own? Or do I have to go through Shantal?","Attachments":[],"Id":1854600,"PostDate":1402424884,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi everyone! I have had the same experience with the WCs at the dreams. Went from Mariana to Magda and now with Shantal. My wedding isn't until September 20th, but still would like to feel at ease by having all of my vendors booked. I have booked my dj, photographer and videographer, and also the reverend. But I still need to book a florist, and a few other things such as the cake and I wanted to do cigar rolling. Do any of you know how I can do that on my own? Or do I have to go through Shantal? \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rosana8274@yahoo.com","IpAddress":"166.137.208.37","GroupId":39,"GroupName":"Newbie","JoinDate":1401469177,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Rosana8274","Id":278171,"Name":"Rosana8274","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.79.62.16","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76214,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2d694f2dc80eb94fd651a41a1d1bcf72","RawContent":"&lt;p&gt;It is reassuring (but still upsetting) to see that we are all going through this together.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Shantal has not sent me an e-mail since APRIL and my wedding is on August 22. I am very concerned! If we are truly able to get all the details ironed out once I arrive at Dreams, then I will accept that. Can anyone give me any feedback on this? Do most of the decisions get made during the consultation upon arrival at Dreams?&lt;\/p&gt;","Attachments":[],"Id":1856694,"PostDate":1403573284,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>It is reassuring (but still upsetting) to see that we are all going through this together.<\/p>\n<p>\u00a0<\/p>\n<p>Shantal has not sent me an e-mail since APRIL and my wedding is on August 22. I am very concerned! If we are truly able to get all the details ironed out once I arrive at Dreams, then I will accept that. Can anyone give me any feedback on this? Do most of the decisions get made during the consultation upon arrival at Dreams?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"candicecwong@hotmail.com","IpAddress":"70.79.62.16","GroupId":39,"GroupName":"Newbie","JoinDate":1361853338,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-266600.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"misscuppycake","Id":266600,"Name":"misscuppycake","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.202.225.11","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76214,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"157840a46f9440f357c555576d3e50d7","RawContent":"&lt;p&gt;Hi Ladies,&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I was just at Dreams on wednesday and met with the General Manager, Shantal, Angel, etc.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;They do have some new wedding coordinators to help with the work load but I also sent the GM this thread and they are monitoring it if you are having issues.&lt;\/p&gt;","Attachments":[],"Id":1862274,"PostDate":1406302943,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Ladies,<\/p>\n<p>\u00a0<\/p>\n<p>I was just at Dreams on wednesday and met with the General Manager, Shantal, Angel, etc.<\/p>\n<p>\u00a0<\/p>\n<p>They do have some new wedding coordinators to help with the work load but I also sent the GM this thread and they are monitoring it if you are having issues.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-family:arial, helvetica, sans-serif;\">Founder and Owner of BestDestinationWedding.com \u00a0\/ \u00a0<\/span><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/'><strong><span style=\"font-family:arial, helvetica, sans-serif;\">Bride & Groom Fly FREE Promotion<\/span><\/strong><\/a><\/p>\n<p>\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><strong><a data-ipb='nomediaparse' href='http:\/\/wrighttravelagency.com\/inquiry\/'><span style=\"color:#008080;\">Looking for a travel agency that specializes in Destination Weddings<\/span><\/a><\/strong><span style=\"color:#008080;\"><strong>?<\/strong> \u00a0We are an award winning travel agency and you can <\/span><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style=\"color:#008080;\">read our reviews\u00a0here.<\/span><\/a><\/strong><\/span><br>\n\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"color:#008080;\"><strong>Awards and recognition:\u00a0<\/strong><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Palace Resorts Winner \"Top Travel Agent\", \"Top Homebased Travel Agency\" PRO Platinum Agency (Top Award) \u00a0 \u00a0 | \u00a0 \u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">AMResorts Master Agent & Top Agency \u00a0<\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/68050-karisma-hotels-givc-and-gi-wedding-consultants-wright-travel-agency\/'><strong>Wright Travel & Karisma GIVC Benefits<\/strong><\/a><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Travel Impressions Best of the Best Globe Winner \u00a0 \u00a0| \u00a0 \u00a0\u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Apple Vacations Golden Apple Winner \u00a0<\/span><\/span><br><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"> \u00a0 \u00a0<img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"font-size:14px;\"><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010'>Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><\/span><\/span><strong><span style=\"color:#b22222;\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a data-ipb='nomediaparse' href='mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com'>ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"admin@bestdestinationwedding.com","IpAddress":"71.202.225.11","GroupId":4,"GroupName":"Administrators","JoinDate":1137224220,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"FormattedName":"TammyWright","Id":206696,"Name":"TammyWright","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"107.217.90.126","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76214,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3e85d8dc09a69eff57020aee3b4dd47e","RawContent":"&lt;p&gt;Hello Tammy! Shantal is my wedding coordinator and I have emailed several times and not heard back. &amp;nbsp;I haven&#039;t received any contact from Dreams since I was e-mailed in February to tell me that my wedding coordinator was changing. &amp;nbsp;Can you please let them know I&#039;m having trouble getting in touch?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thank you!&lt;\/p&gt;","Attachments":[],"Id":1866124,"PostDate":1407973258,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello Tammy! Shantal is my wedding coordinator and I have emailed several times and not heard back. \u00a0I haven't received any contact from Dreams since I was e-mailed in February to tell me that my wedding coordinator was changing. \u00a0Can you please let them know I'm having trouble getting in touch?<\/p>\n<p>\u00a0<\/p>\n<p>Thank you!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"meredith.g.mckee@gmail.com","IpAddress":"98.220.63.34","GroupId":39,"GroupName":"Newbie","JoinDate":1390953882,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276381.jpg?_r=1390954281","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Mgmckee","Id":276381,"Name":"Mgmckee","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.202.225.11","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76214,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b9e10552a060410906b4114baea7133b","RawContent":"I have sent the General Manager this thread so he can keep up with the issues.\n\nYou should also have your TA send an email to the resort as well.\n[quote name=\"Mgmckee\" post=\"1866124\" timestamp=\"1407973258\"]\nHello Tammy! Shantal is my wedding coordinator and I have emailed several times and not heard back.  I haven&#039;t received any contact from Dreams since I was e-mailed in February to tell me that my wedding coordinator was changing.  Can you please let them know I&#039;m having trouble getting in touch?\n\nThank you![\/quote]","Attachments":[],"Id":1866473,"PostDate":1408065541,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I have sent the General Manager this thread so he can keep up with the issues.<\/p>\n<p>\u00a0<\/p>\n<p>You should also have your TA send an email to the resort as well.<\/p>\n<p>\u00a0<\/p>\n<p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Mgmckee, on 13 August 2014 - 03:40 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hello Tammy! Shantal is my wedding coordinator and I have emailed several times and not heard back. \u00a0I haven't received any contact from Dreams since I was e-mailed in February to tell me that my wedding coordinator was changing. \u00a0Can you please let them know I'm having trouble getting in touch?<\/p>\n<p>\u00a0<\/p>\n<p>Thank you!<\/p>\n<\/div>\n<\/div><\/div>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-family:arial, helvetica, sans-serif;\">Founder and Owner of BestDestinationWedding.com \u00a0\/ \u00a0<\/span><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/'><strong><span style=\"font-family:arial, helvetica, sans-serif;\">Bride & Groom Fly FREE Promotion<\/span><\/strong><\/a><\/p>\n<p>\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><strong><a data-ipb='nomediaparse' href='http:\/\/wrighttravelagency.com\/inquiry\/'><span style=\"color:#008080;\">Looking for a travel agency that specializes in Destination Weddings<\/span><\/a><\/strong><span style=\"color:#008080;\"><strong>?<\/strong> \u00a0We are an award winning travel agency and you can <\/span><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style=\"color:#008080;\">read our reviews\u00a0here.<\/span><\/a><\/strong><\/span><br>\n\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"color:#008080;\"><strong>Awards and recognition:\u00a0<\/strong><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Palace Resorts Winner \"Top Travel Agent\", \"Top Homebased Travel Agency\" PRO Platinum Agency (Top Award) \u00a0 \u00a0 | \u00a0 \u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">AMResorts Master Agent & Top Agency \u00a0<\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/68050-karisma-hotels-givc-and-gi-wedding-consultants-wright-travel-agency\/'><strong>Wright Travel & Karisma GIVC Benefits<\/strong><\/a><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Travel Impressions Best of the Best Globe Winner \u00a0 \u00a0| \u00a0 \u00a0\u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Apple Vacations Golden Apple Winner \u00a0<\/span><\/span><br><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"> \u00a0 \u00a0<img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"font-size:14px;\"><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010'>Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><\/span><\/span><strong><span style=\"color:#b22222;\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a data-ipb='nomediaparse' href='mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com'>ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"admin@bestdestinationwedding.com","IpAddress":"71.202.225.11","GroupId":4,"GroupName":"Administrators","JoinDate":1137224220,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"FormattedName":"TammyWright","Id":206696,"Name":"TammyWright","IsOnline":false}}],"Id":"76214","Title":"Help! Trouble Contacting Wc At Dreams Los Cabos","LastPostDate":1408065541},"Pages":{"TotalItems":28,"TotalPages":3,"CurrentPage":20,"NextPage":-1,"PreviousPage":10,"LastPage":20},"PushNotifications":[{"Key":"notifications"