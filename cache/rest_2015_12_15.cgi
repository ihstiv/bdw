t.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1436293677","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"73.150.69.53","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79431,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"611902a847de78ad6274ccf1b9b23018","RawContent":"Hi , we have 5 kids between us(8-14). We are looking for a resort our kids will love. I am looking at beaches turks and Caicos, Ochos rios, and moon palace cancun. Any feedback on these resorts?Turks is more money obviously. Is it worth it? Has anyone been to all three?\n\nLooking to set a date in July of 2016. So need to decide soon.\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1901125,"PostDate":1437769175,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi , we have 5 kids between us(8-14). We are looking for a resort our kids will love. I am looking at beaches turks and Caicos, Ochos rios, and moon palace cancun. Any feedback on these resorts?Turks is more money obviously. Is it worth it? Has anyone been to all three?<br>\nLooking to set a date in July of 2016. So need to decide soon.<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"chrisleotta126@yahoo.com","IpAddress":"73.150.69.53","GroupId":39,"GroupName":"Newbie","JoinDate":1437480839,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Chris126","Id":284060,"Name":"Chris126","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"96.48.159.21","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79431,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"14f34f1ee95262e5cdea57d1a5c45bd1","RawContent":"I can&#039;t speak for the other choices but we&#039;re getting married at Moon Palace next year. We have 4 kids coming to our wedding (ages 1-10) and our travel agent recommended it to us because of the many activities geared towards kids. They have a great kids club that caters to young ones and a separate one for teens. There&#039;s also a flow rider! My nephew and I have looked at videos of the kids club on you tube and he is excited!","Attachments":[],"Id":1901134,"PostDate":1437779599,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I can't speak for the other choices but we're getting married at Moon Palace next year. We have 4 kids coming to our wedding (ages 1-10) and our travel agent recommended it to us because of the many activities geared towards kids. They have a great kids club that caters to young ones and a separate one for teens. There's also a flow rider! My nephew and I have looked at videos of the kids club on you tube and he is excited!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"My planning thread: <a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/79425-wafflesmom-moon-palace-planning-thread-january-23-2016\/\">http:\/\/www.bestdestinationwedding.com\/topic\/79425-wafflesmom-moon-palace-planning-thread-january-23-2016\/<\/a><br><br>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;4;484\/st\/20160123\/e\/Our+Wedding\/dt\/-2\/k\/44c5\/event.png\" alt=\"event.png\"><\/a>","Email":"jerilee.valenzuela@shaw.ca","IpAddress":"24.114.26.77","GroupId":3,"GroupName":"Member","JoinDate":1410098585,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279721.jpg?_r=1444491864","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Wafflesmom","Id":279721,"Name":"Wafflesmom","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79431,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"11f18647138cbb95b5ee44d1888de791","RawContent":"&lt;p&gt;I have to agree with @[member=\"Wafflesmom\"] because i&#039;ve been to Moon Palace and there&#039;s a lot of activities. Flow rider is AWESOME! :)&lt;\/p&gt;","Attachments":[],"Id":1902016,"PostDate":1438874746,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n 