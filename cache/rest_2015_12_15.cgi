{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":22,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":5300,"MovedTo":null,"MovedOn":0,"FirstPostId":877760,"Rating":0,"RatingHits":0,"Starter":{"Id":213622,"Name":"KimmyG","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213622.gif?_r=0","PhotoWidth":75,"PhotoHeight":100,"PhotoType":"custom"},"IsOnline":false},"StartDate":1255067255,"LastPoster":{"Id":278832,"Name":"vsschick1234","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":74,"Preview":{"Id":877760,"PostDate":1255067255,"PostContent":"I didn't see a thread dedicated to this, so I'm starting one. I LOVE the idea of doing Message In...","Author":{"Signature":"","Email":"geminigem615@aol.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1231215388,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213622.gif?_r=0","PhotoWidth":75,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"KimmyG","Id":213622,"Name":"KimmyG","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":43563,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"12141a21d747ca5f9b371e07f0f556a2","RawContent":"I didn&#039;t see a thread dedicated to this, so I&#039;m starting one.\n I LOVE the idea of doing Message In A Bottle invitations but they can be very expensive so I&#039;m considering making my own. Has anyone done this before? Where did you buy plastic bottles\/corks? Any advice in making these?\n \n Here are some websites I found helpful in gathering information: \n \n &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.favorideas.com\/wedding-themes\/beach-themes\/message-in-a-bottle-invitations\/\"&gt; Message in a Bottle Invitations: Perfect for Your Beach Wedding&lt;\/a&gt;\n \n &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.ebottles.com\/articles\/make-a-message-in-a-bottle.html\"&gt;HOW TO MAKE YOUR MESSAGE IN A BOTTLE INVITATION&lt;\/a&gt;","Attachments":[],"Id":877760,"PostDate":1255067255,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I didn't see a thread dedicated to this, so I'm starting one.<br \/> I LOVE the idea of doing Message In A Bottle invitations but they can be very expensive so I'm considering making my own. Has anyone done this before? Where did you buy plastic bottles\/corks? Any advice in making these?<br \/> <br \/> Here are some websites I found helpful in gathering information: <br \/> <br \/> <a href='http:\/\/www.favorideas.com\/wedding-themes\/beach-themes\/message-in-a-bottle-invitations\/' class='bbc_url' title='External link' rel='nofollow external'> Message in a Bottle Invitations: Perfect for Your Beach Wedding<\/a><br \/> <br \/> <a href='http:\/\/www.ebottles.com\/articles\/make-a-message-in-a-bottle.html' class='bbc_url' title='External link' rel='nofollow external'>HOW TO MAKE YOUR MESSAGE IN A BOTTLE INVITATION<\/a>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"geminigem615@aol.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1231215388,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213622.gif?_r=0","PhotoWidth":75,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"KimmyG","Id":213622,"Name":"KimmyG","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":43563,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2073f01654697e852f7ecbb76be6526a","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;KimmyG&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;I didn&#039;t see a thread dedicated to this, so I&#039;m starting one.\n I LOVE the idea of doing Message In A Bottle invitations but they can be very expensive so I&#039;m considering making my own. Has anyone done this before? Where did you buy plastic bottles\/corks? Any advice in making these?\n \n Here are some websites I found helpful in gathering information: \n \n &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.favorideas.com\/wedding-themes\/beach-themes\/message-in-a-bottle-invitations\/\"&gt; Message in a Bottle Invitations: Perfect for Your Beach Wedding&lt;\/a&gt;\n \n &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.ebottles.com\/articles\/make-a-message-in-a-bottle.html\"&gt;HOW TO MAKE YOUR MESSAGE IN A BOTTLE INVITATION&lt;\/a&gt;&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;\n I&#039;ve seen quite a few girls on here make these--they always turn out so great! Thanks for posting those sites...I think we&#039;ll do our thank you notes this way...I&#039;m hooked on passport invitations already! Too many cute ideas!!!","Attachments":[],"Id":877949,"PostDate":1255081391,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>KimmyG<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">I didn't see a thread dedicated to this, so I'm starting one.<br \/> I LOVE the idea of doing Message In A Bottle invitations but they can be very expensive so I'm considering making my own. Has anyone done this before? Where did you buy plastic bottles\/corks? Any advice in making these?<br \/> <br \/> Here are some websites I found helpful in gathering information: <br \/> <br \/> <a href='http:\/\/www.favorideas.com\/wedding-themes\/beach-themes\/message-in-a-bottle-invitations\/' class='bbc_url' title='External link' rel='nofollow external'> Message in a Bottle Invitations: Perfect for Your Beach Wedding<\/a><br \/> <br \/> <a href='http:\/\/www.ebottles.com\/articles\/make-a-message-in-a-bottle.html' class='bbc_url' title='External link' rel='nofollow external'>HOW TO MAKE YOUR MESSAGE IN A BOTTLE INVITATION<\/a><\/div> <\/td> <\/tr> <\/table> <\/div><br \/> I've seen quite a few girls on here make these--they always turn out so great! Thanks for posting those sites...I think we'll do our thank you notes this way...I'm hooked on passport invitations already! Too many cute ideas!!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"wsarah2107@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1239686799,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-216700.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"wsarah2107","Id":216700,"Name":"wsarah2107","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":43563,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9a018bb856cc45046a10330f265be00f","RawContent":"I had them for mine and they came out great! I&#039;ll post the link where i ordered the bottels,boxes,sand, shells. And I need to take a pic as well :)\n \n I tied fushia ribbon around the neck of the bottel and in the center of the knot put a lime green austrian crystal. I filled the box with lime green crinkle cut and used coconut oil to make it smell tropical. Everyone that received them loved it...and none of them arrived broken. \n \n I added extra shells that i ordered from somewhere on-line to include mini starfish.\n \n I thought the sand looked plain so I added Martha Stewart irridescent glitter for a little shimmer.\n \n I had the message printed on shimmer paper. I tied fushia ribbon around the message in a knot...and of course put another austrian crystal in the center. The ends of the ribbon I hot glued to the bottom of the cork and covered it with a small shell to hide the glue dot. I also spray painted the cork with a little bit of shine :)\n \n &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.sandartsupplies.com\/StoreBox\/message_bottles.htm\"&gt;Message Bottles&lt;\/a&gt;\n \n oriental trading also has shells and starfish","Attachments":[],"Id":877967,"PostDate":1255083264,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I had them for mine and they came out great! I'll post the link where i ordered the bottels,boxes,sand, shells. And I need to take a pic as well <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br \/> <br \/> I tied fushia ribbon around the neck of the bottel and in the center of the knot put a lime green austrian crystal. I filled the box with lime green crinkle cut and used coconut oil to make it smell tropical. Everyone that received them loved it...and none of them arrived broken. <br \/> <br \/> I added extra shells that i ordered from somewhere on-line to include mini starfish.<br \/> <br \/> I thought the sand looked plain so I added Martha Stewart irridescent glitter for a little shimmer.<br \/> <br \/> I had the message printed on shimmer paper. I tied fushia ribbon around the message in a knot...and of course put another austrian crystal in the center. The ends of the ribbon I hot glued to the bottom of the cork and covered it with a small shell to hide the glue dot. I also spray painted the cork with a little bit of shine <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br \/> <br \/> <a href='http:\/\/www.sandartsupplies.com\/StoreBox\/message_bottles.htm' class='bbc_url' title='External link' rel='nofollow external'>Message Bottles<\/a><br \/> <br \/> oriental trading also has shells and starfish\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Not even rain could ruin my wedding day!<\/span><\/div><\/div>","Email":"jblueyes27@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1254707478,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-222301.gif?_r=0","PhotoWidth":66,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"jo&delo2010","Id":222301,"Name":"jo&delo2010","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":43563,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a65875c637b8a71d5b22b1e032e62803","RawContent":"I was into that idea for the invites as well, then we started working on the boarding pass invites and have stuck with that. we were thinking about using them as favors with a little thank you note inside. they are very cute.","Attachments":[],"Id":878822,"PostDate":1255138389,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I was into that idea for the invites as well, then we started working on the boarding pass invites and have stuck with that. we were thinking about using them as favors with a little thank you note inside. they are very cute.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/global.theknot.com\/tools\/tickers\/tt25913.aspx\">http:\/\/global.theknot.com\/tools\/tickers\/tt25913.aspx<\/a><\/div><\/div>","Email":"lily17bear@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1238312442,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-216255.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"lily17bear","Id":216255,"Name":"lily17bear","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":43563,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7670235ed8a304354f0da6f733422d8d","RawContent":"I was thinking of doing MIB invites.. Still undecided. You can purchase bottles, sand, and even entire kits at &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.sandartsupplies.com\"&gt;Sand Blast Entertainment&lt;\/a&gt;\n \n Prices seem reasonable!","Attachments":[],"Id":878860,"PostDate":1255140425,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I was thinking of doing MIB invites.. Still undecided. You can purchase bottles, sand, and even entire kits at <a href='http:\/\/www.sandartsupplies.com' class='bbc_url' title='External link' rel='nofollow external'>Sand Blast Entertainment<\/a><br \/> <br \/> Prices seem reasonable!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/www.mywedding.com\/jamesandkarima\">http:\/\/www.mywedding.com\/jamesandkarima<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10748;130\/st\/20100807\/e\/Our+Wedding+Day%21\/k\/94be\/s-event.png\">http:\/\/tickers.TickerFactory.com\/ezt...be\/s-event.png<\/a><strong>Bride & Groom plus 37 Guests Booked!!<\/strong><\/div><\/div>","Email":"karima_majeed@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1231358547,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213679.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"August2010Bride","Id":213679,"Name":"August2010Bride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":43563,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7bc9628c472dec4a8ca4cb2217e59c7e","RawContent":"Jo&amp;amp;Delo I&#039;d love to see your photos! Yours sound so creative and beautiful. \n Lily- I never thought about doing this as a favor, that&#039;s a neat idea.\n \n Thanks for sharing links for purchasing supplies. I feel like this is a totally managable project (with bridesmaids help!) as long as you can find the items for reasonable prices. I saw plastic bottles for $0.79 (or $0.74 if you get 100) and that&#039;s the lowest I&#039;ve found. I hope I can find that website again because I don&#039;t remember where it was! Gah!","Attachments":[],"Id":880137,"PostDate":1255295532,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Jo&Delo I'd love to see your photos! Yours sound so creative and beautiful. <br \/> Lily- I never thought about doing this as a favor, that's a neat idea.<br \/> <br \/> Thanks for sharing links for purchasing supplies. I feel like this is a totally managable project (with bridesmaids help!) as long as you can find the items for reasonable prices. I saw plastic bottles for $0.79 (or $0.74 if you get 100) and that's the lowest I've found. I hope I can find that website again because I don't remember where it was! Gah!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"geminigem615@aol.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1231215388,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213622.gif?_r=0","PhotoWidth":75,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"KimmyG","Id":213622,"Name":"KimmyG","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":43563,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0fa3b5ba20825d77ea2e20a17b2619da","RawContent":"ColoredSand.com (the link you both posted above!) IS the site with great bulk discounts... $0.65 each if you get 144 plastic bottles! I&#039;m not inviting that many people but it may be worth buying them and selling the leftovers here on BDW since it&#039;s such a great price. Or 2 brides can team up and split an order. Anyone in with me?! \n The website also sells the rafia ribbon, sand and shells. Awesome :-D","Attachments":[],"Id":880141,"PostDate":1255295880,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                ColoredSand.com (the link you both posted above!) IS the site with great bulk discounts... $0.65 each if you get 144 plastic bottles! I'm not inviting that many people but it may be worth buying them and selling the leftovers here on BDW since it's such a great price. Or 2 brides can team up and split an order. Anyone in with me?! <br \/> The website also sells the rafia ribbon, sand and shells. Awesome :-D\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"geminigem615@aol.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1231215388,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213622.gif?_r=0","PhotoWidth":75,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"KimmyG","Id":213622,"Name":"KimmyG","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":43563,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9406c84e0f4e8b2b369ee2a7716563a5","RawContent":"From &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.sandartsupplies.com:\"&gt;Sand Blast Entertainment&lt;\/a&gt;\n \n &amp;quot;One thing to remember about Sand Blast Entertainment. &lt;strong&gt;&lt;u&gt;We price match&lt;\/u&gt;&lt;\/strong&gt;! After over 16 years in the business we are well aware that there are others out there that dangle a low price in order to try to get your business. &lt;strong&gt;&lt;u&gt;If you do find a lower price on an exact same item, be sure and tell us when you order, we&#039;ll match it&lt;\/u&gt;&lt;\/strong&gt;. At Sand Blast we don&#039;t try tricks either, like not including a top for a bottle in the price. We pride ourselves in service here, and we actually have the staff and training to back that up.\n Just give us a call and you can tell right away. Speak with one of our friendly sales staff. Cindy, Amy, Beverly, or Jason are ready to help you with any question you have. As a matter of fact, be sure and &lt;strong&gt;&lt;u&gt;mention this article and we will throw in a free gift with your order&lt;\/u&gt;&lt;\/strong&gt;. Every order is treated with special care by us. Thanks!&amp;quot;\n \n Sounds good to me! &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/pinkie.gif\" border=\"0\" alt=\"\" title=\"Pinkie\" class=\"inlineimg\" \/&gt;","Attachments":[],"Id":880144,"PostDate":1255296226,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                From <a href='http:\/\/www.sandartsupplies.com:' class='bbc_url' title='External link' rel='nofollow external'>Sand Blast Entertainment<\/a><br \/> <br \/> \"One thing to remember about Sand Blast Entertainment. <strong><u>We price match<\/u><\/strong>! After over 16 years in the business we are well aware that there are others out there that dangle a low price in order to try to get your business. <strong><u>If you do find a lower price on an exact same item, be sure and tell us when you order, we'll match it<\/u><\/strong>. At Sand Blast we don't try tricks either, like not including a top for a bottle in the price. We pride ourselves in service here, and we actually have the staff and training to back that up.<br \/> Just give us a call and you can tell right away. Speak with one of our friendly sales staff. Cindy, Amy, Beverly, or Jason are ready to help you with any question you have. As a matter of fact, be sure and <strong><u>mention this article and we will throw in a free gift with your order<\/u><\/strong>. Every order is treated with special care by us. Thanks!\"<br \/> <br \/> Sounds good to me! <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/pinkie.gif\" border=\"0\" alt=\"\" title=\"Pinkie\" class=\"inlineimg\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"geminigem615@aol.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1231215388,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213622.gif?_r=0","PhotoWidth":75,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"KimmyG","Id":213622,"Name":"KimmyG","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":43563,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6a7c41764438375d7d5cf025bd57a677","RawContent":"We made ours and it was very inexpensive and our guest loved them. We were so happy we put the time into making them. Here a thread of ours. &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/bestdestinationwedding.com\/forum\/f55\/our-diy-message-bottle-pics-31718\/\"&gt;http:\/\/bestdestinationwedding.com\/fo...le-pics-31718\/&lt;\/a&gt;","Attachments":[],"Id":880333,"PostDate":1255317237,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We made ours and it was very inexpensive and our guest loved them. We were so happy we put the time into making them. Here a thread of ours. <a href='http:\/\/bestdestinationwedding.com\/forum\/f55\/our-diy-message-bottle-pics-31718\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/bestdestinati....le-pics-31718\/<\/a>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Our Honeymoon In Ireland!!<\/span><\/div><\/div>","Email":"jkcz0702@gmail.com","IpAddress":"75.99.176.34","GroupId":42,"GroupName":"Sr. Member","JoinDate":1208067675,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209088.gif?_r=0","PhotoWidth":100,"PhotoHeight":79,"PhotoType":"custom"},"FormattedName":"Jen_S","Id":209088,"Name":"Jen_S","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":43563,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"07a6cd70c51185212b6dddf9749d182b","RawContent":"Those invitations are really cute. Good job!!!","Attachments":[],"Id":883930,"PostDate":1255503531,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Those invitations are really cute. Good job!!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/davf.daisypath.com\/kTmbm6.png\">http:\/\/davf.daisypath.com\/kTmbm6.png<\/a><\/div><\/div>","Email":"pattiwood5@yahoo.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1251791795,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-221196.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Patti","Id":221196,"Name":"Patti","IsOnline":false}}],"Id":"43563","Title":"Message In A Bottle Invitations","LastPostDate":1418765833},"Pages":{"TotalItems":22,"TotalPages":3,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":20},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
