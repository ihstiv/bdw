{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":4,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":167,"MovedTo":null,"MovedOn":0,"FirstPostId":1909116,"Rating":0,"RatingHits":0,"Starter":{"Id":285590,"Name":"GwendolynB","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-285590.png?_r=1452183958","PhotoWidth":200,"PhotoHeight":176,"PhotoType":"custom"},"IsOnline":false},"StartDate":1452189757,"LastPoster":{"Id":262240,"Name":"MissAmber26","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-262240.jpg?_r=1421980656","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":2,"Preview":{"Id":1909116,"PostDate":1452189757,"PostContent":"Hi ladies!I just got back from doing site visits in Cancun over New Years and my fiance and I fel...","Author":{"Signature":"","Email":"gwendolyn.brink@gmail.com","IpAddress":"63.73.199.69","GroupId":39,"GroupName":"Newbie","JoinDate":1450121147,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-285590.png?_r=1452183958","PhotoWidth":200,"PhotoHeight":176,"PhotoType":"custom"},"FormattedName":"GwendolynB","Id":285590,"Name":"GwendolynB","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"63.73.199.69","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79846,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3191dba7d443dc2077f14e2e09d0e659","RawContent":"&lt;p&gt;&lt;span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\"&gt;Hi ladies!&lt;\/span&gt;\n\n&lt;span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\"&gt;I just got back from doing site visits in Cancun over New Years and my fiance and I fell in LOVE with the Hyatt Ziva Cancun. I&#039;d love to hear more from other ladies who are getting married there so we can share ideas, hear the pros\/cons, and all have the best weddings possible!&lt;\/span&gt;\n\n&lt;span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\"&gt;We&#039;ll likely be having around 130-140 guests. We&#039;re doing the rehearsal &amp;amp; rehearsal dinner on the beach. The wedding ceremony will be in the sky gazebo, cocktail hour on the Punta Vista Terrace, and reception in the ballroom.&lt;\/span&gt;\n\n&lt;span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\"&gt;Would love to chat more with others booking their wedding here too!&lt;\/span&gt;\n\n&lt;span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\"&gt;Best,&lt;\/span&gt;\n&lt;span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\"&gt;Gwen&amp;nbsp;&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1909116,"PostDate":1452189757,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span  style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif\">Hi ladies!<\/span><br><br><span  style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif\">I just got back from doing site visits in Cancun over New Years and my fiance and I fell in LOVE with the Hyatt Ziva Cancun. I'd love to hear more from other ladies who are getting married there so we can share ideas, hear the pros\/cons, and all have the best weddings possible!<\/span><br><br><span  style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif\">We'll likely be having around 130-140 guests. We're doing the rehearsal & rehearsal dinner on the beach. The wedding ceremony will be in the sky gazebo, cocktail hour on the Punta Vista Terrace, and reception in the ballroom.<\/span><br><br><span  style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif\">Would love to chat more with others booking their wedding here too!<\/span><br><br><span  style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif\">Best,<\/span><br><span  style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif\">Gwen\u00a0<\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"gwendolyn.brink@gmail.com","IpAddress":"63.73.199.69","GroupId":39,"GroupName":"Newbie","JoinDate":1450121147,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-285590.png?_r=1452183958","PhotoWidth":200,"PhotoHeight":176,"PhotoType":"custom"},"FormattedName":"GwendolynB","Id":285590,"Name":"GwendolynB","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.15.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79846,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e927cbfe82857df490d99a4dfb4c27af","RawContent":"&lt;p&gt;@GwendolynB&amp;nbsp; Congrats on your upcoming wedding!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Have you tried doing a search up top for the resort name to see what threads you get? The Hyatt Ziva is quite new but I seem to remember having seen a couple of posts in the past regarding this resort.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck.&lt;\/p&gt;","Attachments":[],"Id":1909130,"PostDate":1452215484,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@GwendolynB\u00a0 Congrats on your upcoming wedding!<\/p>\n<p>\u00a0<\/p>\n<p>Have you tried doing a search up top for the resort name to see what threads you get? The Hyatt Ziva is quite new but I seem to remember having seen a couple of posts in the past regarding this resort.<\/p>\n<p>\u00a0<\/p>\n<p>Good luck.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span><\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/ann.chadwick.5\/media_set?set=a.10153262834771016.1073741828.569791015&type=3'><span style=\"color:#ff0099;\"><em>https:\/\/www.facebook.com\/ann.chadwick.5\/media_set?set=a.10153262834771016.1073741828.569791015&type=3<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/'><span style=\"color:#ff0099;\"><em>http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283458999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.209.228.230","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79846,"EditedBy":"<strong>Edited by MissAmber26, 09 January 2016 - 06:51 PM.<\/strong>","EditDate":1452394306,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9d14a855f9b7c607e0c3fc6ebf371556","RawContent":"&lt;p&gt;&lt;span&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/user\/285590-gwendolynb\/&#039; title=\"\"&gt;GwendolynB&lt;\/a&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;Yay another Hyatt bride! I&#039;m getting married there in April. Soon much to do. Do you have photos? I won&#039;t get to do a site visit. I have a few that an agent posted on FB. I am doing all of my events at the sky gazebo. Did it seem like enough space? I&#039;ll have about 50 people. I have kids coming and my WP said that Punta Vista is adults only. Did they tell you that? My WP is Elsa but I want to request a new one. She takes too long to get back with me. Who&#039;s yours?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I had started a page of info looking for people a while back. But this a better place for sharing I guess.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/topic\/79603-playa-resorts-cancun-hyatt-ziva-zilara-gran-caribe\/&#039;&gt;http:\/\/www.bestdestinationwedding.com\/topic\/79603-playa-resorts-cancun-hyatt-ziva-zilara-gran-caribe\/&lt;\/a&gt;&lt;\/p&gt;","Attachments":[],"Id":1909222,"PostDate":1452394244,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span><a href='http:\/\/www.bestdestinationwedding.com\/user\/285590-gwendolynb\/' class='bbc_url' title=''>GwendolynB<\/a><\/span><\/p>\n<p>Yay another Hyatt bride! I'm getting married there in April. Soon much to do. Do you have photos? I won't get to do a site visit. I have a few that an agent posted on FB. I am doing all of my events at the sky gazebo. Did it seem like enough space? I'll have about 50 people. I have kids coming and my WP said that Punta Vista is adults only. Did they tell you that? My WP is Elsa but I want to request a new one. She takes too long to get back with me. Who's yours?<\/p>\n<p>\u00a0<\/p>\n<p>I had started a page of info looking for people a while back. But this a better place for sharing I guess.<\/p>\n<p>\u00a0<\/p>\n<p><a href='http:\/\/www.bestdestinationwedding.com\/topic\/79603-playa-resorts-cancun-hyatt-ziva-zilara-gran-caribe\/' class='bbc_url' title=''>http:\/\/www.bestdesti...ra-gran-caribe\/<\/a><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Amaqt03@hotmail.com","IpAddress":"98.169.122.6","GroupId":39,"GroupName":"Newbie","JoinDate":1352510505,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-262240.jpg?_r=1421980656","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"MissAmber26","Id":262240,"Name":"MissAmber26","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.209.228.230","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79846,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3ba9216640a40f993796de62446d35e9","RawContent":"OK so I lied. I just looked at my info again and my cocktail and reception are at Punta Vista terrace too. But I think thats the one thats connected to the sky gazebo area. There was another terrace I wanted that she said was in the adults only area.\n\n\n[quote name=\"MissAmber26\" post=\"1909222\" timestamp=\"1452394244\"]\n[url=\"http:\/\/www.bestdestinationwedding.com\/user\/285590-gwendolynb\/\"]GwendolynB[\/url]\nYay another Hyatt bride! I&#039;m getting married there in April. Soon much to do. Do you have photos? I won&#039;t get to do a site visit. I have a few that an agent posted on FB. I am doing all of my events at the sky gazebo. Did it seem like enough space? I&#039;ll have about 50 people. I have kids coming and my WP said that Punta Vista is adults only. Did they tell you that? My WP is Elsa but I want to request a new one. She takes too long to get back with me. Who&#039;s yours?\n\nI had started a page of info looking for people a while back. But this a better place for sharing I guess.\n\n[url=\"http:\/\/www.bestdestinationwedding.com\/topic\/79603-playa-resorts-cancun-hyatt-ziva-zilara-gran-caribe\/\"]http:\/\/www.bestdestinationwedding.com\/topic\/79603-playa-resorts-cancun-hyatt-ziva-zilara-gran-caribe\/[\/url][\/quote]","Attachments":[],"Id":1909223,"PostDate":1452397498,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>OK so I lied. I just looked at my info again and my cocktail and reception are at Punta Vista terrace too. But I think thats the one thats connected to the sky gazebo area. There was another terrace I wanted that she said was in the adults only area.<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>MissAmber26, on 09 January 2016 - 06:50 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p><a href='http:\/\/www.bestdestinationwedding.com\/user\/285590-gwendolynb\/' class='bbc_url' title=''>GwendolynB<\/a><\/p>\n<p>Yay another Hyatt bride! I'm getting married there in April. Soon much to do. Do you have photos? I won't get to do a site visit. I have a few that an agent posted on FB. I am doing all of my events at the sky gazebo. Did it seem like enough space? I'll have about 50 people. I have kids coming and my WP said that Punta Vista is adults only. Did they tell you that? My WP is Elsa but I want to request a new one. She takes too long to get back with me. Who's yours?<\/p>\n<p>\u00a0<\/p>\n<p>I had started a page of info looking for people a while back. But this a better place for sharing I guess.<\/p>\n<p>\u00a0<\/p>\n<p><a href='http:\/\/www.bestdestinationwedding.com\/topic\/79603-playa-resorts-cancun-hyatt-ziva-zilara-gran-caribe\/' class='bbc_url' title=''>http:\/\/www.bestdesti...ra-gran-caribe\/<\/a><\/p>\n<\/div>\n<\/div><\/div>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Amaqt03@hotmail.com","IpAddress":"98.169.122.6","GroupId":39,"GroupName":"Newbie","JoinDate":1352510505,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-262240.jpg?_r=1421980656","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"MissAmber26","Id":262240,"Name":"MissAmber26","IsOnline":false}}],"Id":"79846","Title":"Hyatt Ziva Cancun - Roll Call!","LastPostDate":1452397498},"Pages":{"TotalItems":4,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}