Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":4,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":153,"MovedTo":null,"MovedOn":0,"FirstPostId":1909065,"Rating":0,"RatingHits":0,"Starter":{"Id":285796,"Name":"hreppond22","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1452089610,"LastPoster":{"Id":230711,"Name":"Moments That Matter","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1909065,"PostDate":1452089610,"PostContent":"Hello Ladies, \u00a0 I just recently got engaged December 12th in Las Vegas and we are really wanting...","Author":{"Signature":"","Email":"hope_reppond@yahoo.com","IpAddress":"174.47.145.2","GroupId":39,"GroupName":"Newbie","JoinDate":1452088429,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"hreppond22","Id":285796,"Name":"hreppond22","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.47.145.2","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79843,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"60b3df0254a1141ca30b1e1f8a21a294","RawContent":"&lt;p&gt;Hello Ladies,&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I just recently got engaged December 12th in Las Vegas and we are really wanting to do a destination wedding at the Generations Riviera Maya in February 2017 on the sky terrace they just built. It is absolutly beautiful!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;What is the weather like in February in mexico?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am trying to decide what package to go with through Karisma and lomas weddings. What has everyone experienced with the memorable moments packages?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Has anyone done this yet? If so, can you send me pictures to &lt;a  class=\"bbc_url\" href=\"mailto:hope_reppond@yahoo.com\" title=\"External link\"&gt;hope_reppond@yahoo.com&lt;\/a&gt;?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thank you,&lt;\/p&gt;\n&lt;p&gt;Hope Reppond&lt;\/p&gt;","Attachments":[],"Id":1909065,"PostDate":1452089610,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello Ladies,<\/p>\n<p>\u00a0<\/p>\n<p>I just recently got engaged December 12th in Las Vegas and we are really wanting to do a destination wedding at the Generations Riviera Maya in February 2017 on the sky terrace they just built. It is absolutly beautiful!<\/p>\n<p>\u00a0<\/p>\n<p>What is the weather like in February in mexico?<\/p>\n<p>\u00a0<\/p>\n<p>I am trying to decide what package to go with through Karisma and lomas weddings. What has everyone experienced with the memorable moments packages?<\/p>\n<p>\u00a0<\/p>\n<p>Has anyone done this yet? If so, can you send me pictures to <a href='mailto:hope_reppond@yahoo.com' class='bbc_url' title='External link' rel='nofollow external'>hope_reppond@yahoo.com<\/a>?<\/p>\n<p>\u00a0<\/p>\n<p>Thank you,<\/p>\n<p>Hope Reppond<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"hope_reppond@yahoo.com","IpAddress":"174.47.145.2","GroupId":39,"GroupName":"Newbie","JoinDate":1452088429,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"hreppond22","Id":285796,"Name":"hreppond22","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.202.225.11","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79843,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"7074f5684d837eb83bb5e01918447a48","RawContent":"&lt;p&gt;Hi Hope,&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Congrats on your engagement!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;The weather in February is fantastic in Cancun.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am planning my vow renewal for April and using a memorable moments package.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I love Generations and go every year. The sky deck and chapel are both so beautiful. I am a top producer and wedding agent for Karisma and would love to help answer any questions.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17612\/gallery_206696_17612_48773.jpg\" alt=\"gallery_206696_17612_48773.jpg\"&gt;&lt;\/p&gt;","Attachments":[],"Id":1909076,"PostDate":1452095941,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Hope,<\/p>\n<p>\u00a0<\/p>\n<p>Congrats on your engagement!!<\/p>\n<p>\u00a0<\/p>\n<p>The weather in February is fantastic in Cancun.<\/p>\n<p>\u00a0<\/p>\n<p>I am planning my vow renewal for April and using a memorable moments package.<\/p>\n<p>\u00a0<\/p>\n<p>I love Generations and go every year. The sky deck and chapel are both so beautiful. I am a top producer and wedding agent for Karisma and would love to help answer any questions.<\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17612\/gallery_206696_17612_48773.jpg\" alt=\"gallery_206696_17612_48773.jpg\"><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-family:arial, helvetica, sans-serif;\">Founder and Owner of BestDestinationWedding.com \u00a0\/ \u00a0<\/span><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/'><strong><span style=\"font-family:arial, helvetica, sans-serif;\">Bride & Groom Fly FREE Promotion<\/span><\/strong><\/a><\/p>\n<p>\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><strong><a data-ipb='nomediaparse' href='http:\/\/wrighttravelagency.com\/inquiry\/'><span style=\"color:#008080;\">Looking for a travel agency that specializes in Destination Weddings<\/span><\/a><\/strong><span style=\"color:#008080;\"><strong>?<\/strong> \u00a0We are an award winning travel agency and you can <\/span><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style=\"color:#008080;\">read our reviews\u00a0here.<\/span><\/a><\/strong><\/span><br>\n\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"color:#008080;\"><strong>Awards and recognition:\u00a0<\/strong><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Palace Resorts Winner \"Top Travel Agent\", \"Top Homebased Travel Agency\" PRO Platinum Agency (Top Award) \u00a0 \u00a0 | \u00a0 \u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">AMResorts Master Agent & Top Agency \u00a0<\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/68050-karisma-hotels-givc-and-gi-wedding-consultants-wright-travel-agency\/'><strong>Wright Travel & Karisma GIVC Benefits<\/strong><\/a><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Travel Impressions Best of the Best Globe Winner \u00a0 \u00a0| \u00a0 \u00a0\u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Apple Vacations Golden Apple Winner \u00a0<\/span><\/span><br><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17612\/sml_gallery_206696_17612_13451.png\" alt=\"sml_gallery_206696_17612_13451.png\"><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"> \u00a0 \u00a0<img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"font-size:14px;\"><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010'>Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><\/span><\/span><strong><span style=\"color:#b22222;\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a data-ipb='nomediaparse' href='mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com'>ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"admin@bestdestinationwedding.com","IpAddress":"71.202.225.11","GroupId":4,"GroupName":"Administrators","JoinDate":1137206220,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"FormattedName":"TammyWright","Id":206696,"Name":"TammyWright","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.15.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79843,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3ab5f6bc59f36b5a4848f5c322fb8c5a","RawContent":"&lt;p&gt;@hreppond22&amp;nbsp; Congrats and welcome to the site! You&#039;ve come to the right place for ideas and suggestions. The ladies here are great and always ready to help!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;@[member=\"TammyWright\"] is absolutely awesome and you couldn&#039;t do better for someone working with you on your DW!! Karisma properties are very popular with the brides here and Generations is really a beautiful resort!&amp;nbsp; February is also a popular month just because of the weather. It really is a beautiful time of the year to be in Mexico - warmth and sunshine and of course the great beaches!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck and happy planning!&lt;\/p&gt;","Attachments":[],"Id":1909084,"PostDate":1452123469,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@hreppond22\u00a0 Congrats and welcome to the site! You've come to the right place for ideas and suggestions. The ladies here are great and always ready to help!<\/p>\n<p>\u00a0<\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"206696\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/206696-tammywright\/' title='Member profile'><span itemprop=\"name\">TammyWright<\/span><\/a> is absolutely awesome and you couldn't do better for someone working with you on your DW!! Karisma properties are very popular with the brides here and Generations is really a beautiful resort!\u00a0 February is also a popular month just because of the weather. It really is a beautiful time of the year to be in Mexico - warmth and sunshine and of course the great beaches!<\/p>\n<p>\u00a0<\/p>\n<p>Good luck and happy planning!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span><\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/ann.chadwick.5\/media_set?set=a.10153262834771016.1073741828.569791015&type=3'><span style=\"color:#ff0099;\"><em>https:\/\/www.facebook.com\/ann.chadwick.5\/media_set?set=a.10153262834771016.1073741828.569791015&type=3<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/'><span style=\"color:#ff0099;\"><em>http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283440999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"142.161.170.48","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79843,"EditedBy":"<strong>Edited by Moments That Matter, Today, 12:42 AM.<\/strong>","EditDate":1452386567,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"05c49e9765d50fddcc016b2bd3bc168b","RawContent":"&lt;p&gt;Welcome to our forum community, Hope and Congrats on your upcoming Generations Riviera Maya wedding!!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Here&#039;s a link showing &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.momentsthatmatterphotography.com\/#!weather-sunset\/cggz&#039;&gt;Mexico weather + sunset times in Feb&lt;\/a&gt;, so you can plan your timeline to capture that incomparably magical Golden light of sunset :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;For further inspiration, here are some wedding moments that matter we captured there, taken from our &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10152626430674487.1073741908.18683524486&amp;amp;type=3&#039;&gt;Generations Riviera Maya Wedding Album: &lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-yyz1-1.xx.fbcdn.net\/hphotos-xpf1\/t31.0-8\/10548040_10152626433689487_474654768007711462_o.jpg\" alt=\"10548040_10152626433689487_4746547680077\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-yyz1-1.xx.fbcdn.net\/hphotos-frc3\/t31.0-8\/10403830_10152626434834487_4932238958314209748_o.jpg\" alt=\"10403830_10152626434834487_4932238958314\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-yyz1-1.xx.fbcdn.net\/hphotos-frc3\/v\/t1.0-9\/10620735_10152626436579487_2074395026960139124_n.jpg?oh=6808b33cebff5a2867bb8f7444a914ee&amp;amp;oe=570BE716\" alt=\"10620735_10152626436579487_2074395026960\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-yyz1-1.xx.fbcdn.net\/hphotos-xtp1\/t31.0-8\/10623967_10152626436859487_3228867300195504472_o.jpg\" alt=\"10623967_10152626436859487_3228867300195\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-yyz1-1.xx.fbcdn.net\/hphotos-xfl1\/t31.0-8\/10454122_10152626437989487_6182769040888540413_o.jpg\" alt=\"10454122_10152626437989487_6182769040888\"&gt;&lt;\/p&gt;\n&lt;p&gt;Wishing you happy research - Enjoy your amazing journey ahead, cheers!!! team MTM :)&lt;\/p&gt;","Attachments":[],"Id":1909227,"PostDate":1452386471,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome to our forum community, Hope and Congrats on your upcoming Generations Riviera Maya wedding!!!<\/p>\n<p>\u00a0<\/p>\n<p>Here's a link showing <a href='http:\/\/www.momentsthatmatterphotography.com\/#!weather-sunset\/cggz' class='bbc_url' title='External link' rel='nofollow external'>Mexico weather + sunset times in Feb<\/a>, so you can plan your timeline to capture that incomparably magical Golden light of sunset <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>For further inspiration, here are some wedding moments that matter we captured there, taken from our <a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10152626430674487.1073741908.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>Generations Riviera Maya Wedding Album: <\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-yyz1-1.xx.fbcdn.net\/hphotos-xpf1\/t31.0-8\/10548040_10152626433689487_474654768007711462_o.jpg\" alt=\"10548040_10152626433689487_4746547680077\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-yyz1-1.xx.fbcdn.net\/hphotos-frc3\/t31.0-8\/10403830_10152626434834487_4932238958314209748_o.jpg\" alt=\"10403830_10152626434834487_4932238958314\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-yyz1-1.xx.fbcdn.net\/hphotos-frc3\/v\/t1.0-9\/10620735_10152626436579487_2074395026960139124_n.jpg?oh=6808b33cebff5a2867bb8f7444a914ee&oe=570BE716\" alt=\"10620735_10152626436579487_2074395026960\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-yyz1-1.xx.fbcdn.net\/hphotos-xtp1\/t31.0-8\/10623967_10152626436859487_3228867300195504472_o.jpg\" alt=\"10623967_10152626436859487_3228867300195\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-yyz1-1.xx.fbcdn.net\/hphotos-xfl1\/t31.0-8\/10454122_10152626437989487_6182769040888540413_o.jpg\" alt=\"10454122_10152626437989487_6182769040888\"><\/span><\/p>\n<p>Wishing you happy research - Enjoy your amazing journey ahead, cheers!!! team MTM <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280192660,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}}],"Id":"79843","Title":"Newbie Interested In Generation Sky Terrace","LastPostDate":1452386471},"Pages":{"TotalItems":4,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
