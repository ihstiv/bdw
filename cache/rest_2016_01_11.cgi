           <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I'm excited for our second meet up! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/biggrin.png' class='bbc_emoticon' alt=':D' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419419814,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1450791654","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"38.112.94.76","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79202,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":4,"IsLiked":false,"PostKey":"6d6f8b58665f865f34dc80a7c3706074","RawContent":"&lt;p&gt;I am free! &amp;nbsp;yay. &amp;nbsp; We are planning for an October getaway, but I&#039;m pretty sure early October works for me! :)&lt;\/p&gt;","Attachments":[],"Id":1902866,"PostDate":1439981937,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I am free! \u00a0yay. \u00a0 We are planning for an October getaway, but I'm pretty sure early October works for me! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div><br><div>\u00a0<\/div>\n<div>\u00a0<\/div>\n<div>Married on June 20th, 2015 at the Grand Sunset Princess Riviera Gazebo & Reception at the Chill Out with 60 guests<\/div>\n<div>\u00a0<\/div>\n<\/div>\n<div>\u00a0<\/div>\n<p>My planning thread:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/<\/a><\/p>\n<p>My review thread: \u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/<\/a>","Email":"rebecca.valero@gmail.com","IpAddress":"38.112.94.76","GroupId":3,"GroupName":"Member","Joi