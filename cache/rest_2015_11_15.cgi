Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":2,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":576,"MovedTo":null,"MovedOn":0,"FirstPostId":1890131,"Rating":0,"RatingHits":0,"Starter":{"Id":282480,"Name":"Rebeccaroberts","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1426816966,"LastPoster":{"Id":268563,"Name":"Slaughter2be","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":67,"Preview":{"Id":1890131,"PostDate":1426816966,"PostContent":"Hello, My fiancee and I are currently planning our Italian wedding from Canadian soil. We have a...","Author":{"Signature":"","Email":"abbottbecky@yahoo.ca","IpAddress":"198.84.221.237","GroupId":39,"GroupName":"Newbie","JoinDate":1426816621,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Rebeccaroberts","Id":282480,"Name":"Rebeccaroberts","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"198.84.221.237","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78955,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ff637c8b737702f76dc58fc85d9309d8","RawContent":"Hello,\n\n\nMy fiancee and I are currently planning our Italian wedding from Canadian soil. We have a found a great venue in Petritoli, Fermo, Le Marche. We are bringing 50 of our closest friends and family across the pond with us to celebrate. Everyone is covering their own accommodation costs in the castle we have rented. Now we are trying to sort out logistics of the wedding day without hiring a wedding planner. Does anyone have any leads on a photographer that would work within a \u20ac750 budget on a wedding in Italy? We are also trying to find a classical guitarist for the ceremony \u20ac150 max. Is this even possible? Any tips would be very much appreciated!\n\n\ncheers!\n\n\nRebecca","Attachments":[],"Id":1890131,"PostDate":1426816966,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hello,<br><br>\nMy fiancee and I are currently planning our Italian wedding from Canadian soil. We have a found a great venue in Petritoli, Fermo, Le Marche. We are bringing 50 of our closest friends and family across the pond with us to celebrate. Everyone is covering their own accommodation costs in the castle we have rented. Now we are trying to sort out logistics of the wedding day without hiring a wedding planner. Does anyone have any leads on a photographer that would work within a \u20ac750 budget on a wedding in Italy? We are also trying to find a classical guitarist for the ceremony \u20ac150 max. Is this even possible? Any tips would be very much appreciated!<br><br>\ncheers!<br><br>\nRebecca\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"abbottbecky@yahoo.ca","IpAddress":"198.84.221.237","GroupId":39,"GroupName":"Newbie","JoinDate":1426816621,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Rebeccaroberts","Id":282480,"Name":"Rebeccaroberts","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.52.93.100","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78955,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"11858c2fd52751b022bf1625408c1957","RawContent":"[quote name=\"Rebeccaroberts\" post=\"1890131\" timestamp=\"1426816966\"]\nHello,\n\nMy fiancee and I are currently planning our Italian wedding from Canadian soil. We have a found a great venue in Petritoli, Fermo, Le Marche. We are bringing 50 of our closest friends and family across the pond with us to celebrate. Everyone is covering their own accommodation costs in the castle we have rented. Now we are trying to sort out logistics of the wedding day without hiring a wedding planner. Does anyone have any leads on a photographer that would work within a \u20ac750 budget on a wedding in Italy? We are also trying to find a classical guitarist for the ceremony \u20ac150 max. Is this even possible? Any tips would be very much appreciated!\n\ncheers!\n\nRebecca[\/quote]May I ask how are you planning your wedding from Canada. My Bff was thinking of a wedding in Paris. However we not sure how to go about it.","Attachments":[],"Id":1904861,"PostDate":1442420741,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Rebeccaroberts, on 19 March 2015 - 06:02 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hello,<br><br>\nMy fiancee and I are currently planning our Italian wedding from Canadian soil. We have a found a great venue in Petritoli, Fermo, Le Marche. We are bringing 50 of our closest friends and family across the pond with us to celebrate. Everyone is covering their own accommodation costs in the castle we have rented. Now we are trying to sort out logistics of the wedding day without hiring a wedding planner. Does anyone have any leads on a photographer that would work within a \u20ac750 budget on a wedding in Italy? We are also trying to find a classical guitarist for the ceremony \u20ac150 max. Is this even possible? Any tips would be very much appreciated!<br><br>\ncheers!<br><br>\nRebecca<\/p>\n<\/div>\n<\/div><\/div>\n<p>May I ask how are you planning your wedding from Canada. My Bff was thinking of a wedding in Paris. However we not sure how to go about it.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"svazquez309@gmail.com","IpAddress":"108.29.64.103","GroupId":39,"GroupName":"Newbie","JoinDate":1365966148,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Slaughter2be","Id":268563,"Name":"Slaughter2be","IsOnline":false}}],"Id":"78955","Title":"Budget Wedding In Italy?","LastPostDate":1442420741},"Pages":{"TotalItems":2,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
