{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":5,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":774,"MovedTo":null,"MovedOn":0,"FirstPostId":1917313,"Rating":0,"RatingHits":0,"Starter":{"Id":288534,"Name":"kcha0225","Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1488224657,"LastPoster":{"Id":230028,"Name":"TA Patty","Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-230028.jpg?_r=1398727965","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":22,"Preview":{"Id":1917831,"PostDate":1497060838,"PostContent":"The Punta Cana resort area is very nice, but the The Westin in the Punta Cana Resort is not an al...","Author":{"Signature":"<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><a class='bbc_url' href='http:\/\/wrighttravelagency.com\/inquiry\/'><span style='color: rgb(0,128,128)'>Looking for a travel agency that specializes in Destination Weddings<\/span><\/a><span style='color: rgb(0,128,128)'>? We are an award winning travel agency and you can read our reviews <\/span><a class='bbc_url' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style='color: rgb(0,128,128)'><strong class='bbc'>HERE.<\/strong><\/span><\/a><\/span><\/span><br \/>\n<br \/>\n<span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'><strong class='bbc'>Awards and recognition: <\/strong><\/span><\/span><\/span><\/span><br \/>\n<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'>Palace Resorts Top PRO Agency <\/span><\/span><\/span><\/span><br \/>\n<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'>Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator <\/span><\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>AMResorts Master Agent & Top Agency<\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>Travel Impressions Best of the Best Globe Winner<\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>Apple Vacations Golden Apple Winner<\/span><\/span><\/span><span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='font-size: 12px;'><span style='color: rgb(0,128,128)'>5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | AMResorts Master Agent & Top Agency | <\/span><span style='color: rgb(0,128,128)'>Travel Impressions Best of the Best Globe Winner | Apple Vacations Golden Apple Winner <\/span><\/span><\/span><\/span>","Email":"patty@wrighttravelagency.com","IpAddress":"76.95.92.213","GroupId":49,"GroupName":"Insiders","JoinDate":1278657480,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-230028.jpg?_r=1398727965","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"TA Patty","Id":230028,"Name":"TA Patty","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"166.67.66.240","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80965,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"430a0c8fcf8d37406413cf823457f1f0","RawContent":"&lt;p&gt;Help ! I&#039;m stuck in between venues in the DR. My fianc\u00e9 and I have been working with a travel agent for quite some time now and we are having difficulties finding a venue&amp;nbsp;to best suit our big day. What are the opinions of the best venues for a wedding in the DR. Any feedback is greatly appreciated.&lt;\/p&gt;","Attachments":[],"Id":1917313,"PostDate":1488224657,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Help ! I'm stuck in between venues in the DR. My fianc\u00e9 and I have been working with a travel agent for quite some time now and we are having difficulties finding a venue\u00a0to best suit our big day. What are the opinions of the best venues for a wedding in the DR. Any feedback is greatly appreciated.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"countdown2brown2018@gmail.com","IpAddress":"166.67.66.240","GroupId":39,"GroupName":"Newbie","JoinDate":1488223422,"Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kcha0225","Id":288534,"Name":"kcha0225","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"179.53.151.182","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80965,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e4592debf1e2019a6cc71fd16792dc51","RawContent":"&lt;p&gt;Well depends what do you want. For me one of the best places for weddings is Las Terrenas, here you have a lot of diferent alternatives. Check this: &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.facebook.com\/LasTerrenas&#039;&gt;http:\/\/www.facebook.com\/LasTerrenas&lt;\/a&gt;the place is incredible and i can recomend a lot of hotels like Sublime Samana or big luxury villas. \n\nI work also in Punta Cana.\n\nAre diferent places but good the two destinies.&amp;nbsp;\n\n\nRegards!&lt;\/p&gt;","Attachments":[],"Id":1917443,"PostDate":1490056154,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Well depends what do you want. For me one of the best places for weddings is Las Terrenas, here you have a lot of diferent alternatives. Check this: <a href='http:\/\/www.facebook.com\/LasTerrenas' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.facebook.com\/LasTerrenas<\/a>the place is incredible and i can recomend a lot of hotels like Sublime Samana or big luxury villas. <br>\nI work also in Punta Cana.<br>\nAre diferent places but good the two destinies.\u00a0<br><br>\nRegards!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/www.lopezspratt.com\/archivos\/firmaforo.jpg\" alt=\"firmaforo.jpg\"><br>\nLopezSpratt :: Destination Wedding Photography & Video - Punta Cana \/ La Romana \/ Las Terrenas<br><a data-ipb='nomediaparse' href='http:\/\/www.lopezspratt.com'>http:\/\/www.lopezspratt.com<\/a>","Email":"webs@lopezspratt.com","IpAddress":"179.53.151.182","GroupId":39,"GroupName":"Newbie","JoinDate":1490054799,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-288635.jpg?_r=1490055039","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"lopezspratt","Id":288635,"Name":"lopezspratt","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"76.95.180.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80965,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"15e9d0697d3f5dcf06ec2c3b9fc5573f","RawContent":"&lt;p&gt;Congratulations! Are you looking for resort options or off site wedding venues? There are lots of great options for both in the DR.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1917470,"PostDate":1490294253,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congratulations! Are you looking for resort options or off site wedding venues? There are lots of great options for both in the DR.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><a class='bbc_url' href='http:\/\/wrighttravelagency.com\/inquiry\/'><span style='color: rgb(0,128,128)'>Looking for a travel agency that specializes in Destination Weddings<\/span><\/a><span style='color: rgb(0,128,128)'>? We are an award winning travel agency and you can read our reviews <\/span><a class='bbc_url' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style='color: rgb(0,128,128)'><strong class='bbc'>HERE.<\/strong><\/span><\/a><\/span><\/span><br \/>\n<br \/>\n<span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'><strong class='bbc'>Awards and recognition: <\/strong><\/span><\/span><\/span><\/span><br \/>\n<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'>Palace Resorts Top PRO Agency <\/span><\/span><\/span><\/span><br \/>\n<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'>Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator <\/span><\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>AMResorts Master Agent & Top Agency<\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>Travel Impressions Best of the Best Globe Winner<\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>Apple Vacations Golden Apple Winner<\/span><\/span><\/span><span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='font-size: 12px;'><span style='color: rgb(0,128,128)'>5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | AMResorts Master Agent & Top Agency | <\/span><span style='color: rgb(0,128,128)'>Travel Impressions Best of the Best Globe Winner | Apple Vacations Golden Apple Winner <\/span><\/span><\/span><\/span>","Email":"patty@wrighttravelagency.com","IpAddress":"76.95.92.213","GroupId":49,"GroupName":"Insiders","JoinDate":1278657480,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-230028.jpg?_r=1398727965","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"TA Patty","Id":230028,"Name":"TA Patty","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"37.144.190.29","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80965,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"43a3fb265db96e1cbde5a931d380ac80","RawContent":"&lt;p&gt;Hi. I can advize you the Westin Puntacana Resort &amp;amp; Club. My friend had a wedding there. They liked high hotel&#039;s service and wonderful area. She showed me her photos! they are stunning! Lemme left a link for u&amp;nbsp;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.wedgo.net\/photographer-in-dominican-republic.html&#039;&gt;http:\/\/www.wedgo.net\/photographer-in-dominican-republic.html&lt;\/a&gt;&lt;\/p&gt;","Attachments":[],"Id":1917792,"PostDate":1496647230,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi. I can advize you the Westin Puntacana Resort & Club. My friend had a wedding there. They liked high hotel's service and wonderful area. She showed me her photos! they are stunning! Lemme left a link for u\u00a0<a href='http:\/\/www.wedgo.net\/photographer-in-dominican-republic.html' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.wedgo.net...n-republic.html<\/a><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"meldavis199@gmail.com","IpAddress":"37.144.190.29","GroupId":39,"GroupName":"Newbie","JoinDate":1496646364,"Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Melissa199","Id":288962,"Name":"Melissa199","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"76.95.180.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80965,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"88a1b524a4f14f8cf8dacf01827dadba","RawContent":"&lt;p&gt;The Punta Cana resort area is very nice, but the The Westin in the Punta Cana Resort is not an all inclusive resort. &amp;nbsp;An all inclusive resort is what most couples choose to make it easy and affordable for their guests. &amp;nbsp;Since meals, beverages, alcohol, entertainment etc... are all included guests don&#039;t have to worry about a big bill when they leave. &amp;nbsp;If you&#039;re out at the pool and want a drinl just swim up to the bar and it&#039;s included, there are a variety of restaurants to choose from for meals and it&#039;s all included. There are many beautiful areas and great all inclusive resort options in Punta Cana and we have been to several of them.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Just click the link below if you&#039;d like a BDW TA to contact you. &amp;nbsp; Thanks! TA Patty&lt;\/p&gt;","Attachments":[],"Id":1917831,"PostDate":1497060838,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>The Punta Cana resort area is very nice, but the The Westin in the Punta Cana Resort is not an all inclusive resort. \u00a0An all inclusive resort is what most couples choose to make it easy and affordable for their guests. \u00a0Since meals, beverages, alcohol, entertainment etc... are all included guests don't have to worry about a big bill when they leave. \u00a0If you're out at the pool and want a drinl just swim up to the bar and it's included, there are a variety of restaurants to choose from for meals and it's all included. There are many beautiful areas and great all inclusive resort options in Punta Cana and we have been to several of them.<\/p>\n<p>\u00a0<\/p>\n<p>Just click the link below if you'd like a BDW TA to contact you. \u00a0 Thanks! TA Patty<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><a class='bbc_url' href='http:\/\/wrighttravelagency.com\/inquiry\/'><span style='color: rgb(0,128,128)'>Looking for a travel agency that specializes in Destination Weddings<\/span><\/a><span style='color: rgb(0,128,128)'>? We are an award winning travel agency and you can read our reviews <\/span><a class='bbc_url' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style='color: rgb(0,128,128)'><strong class='bbc'>HERE.<\/strong><\/span><\/a><\/span><\/span><br \/>\n<br \/>\n<span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'><strong class='bbc'>Awards and recognition: <\/strong><\/span><\/span><\/span><\/span><br \/>\n<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'>Palace Resorts Top PRO Agency <\/span><\/span><\/span><\/span><br \/>\n<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'>Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator <\/span><\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>AMResorts Master Agent & Top Agency<\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>Travel Impressions Best of the Best Globe Winner<\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>Apple Vacations Golden Apple Winner<\/span><\/span><\/span><span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='font-size: 12px;'><span style='color: rgb(0,128,128)'>5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | AMResorts Master Agent & Top Agency | <\/span><span style='color: rgb(0,128,128)'>Travel Impressions Best of the Best Globe Winner | Apple Vacations Golden Apple Winner <\/span><\/span><\/span><\/span>","Email":"patty@wrighttravelagency.com","IpAddress":"76.95.92.213","GroupId":49,"GroupName":"Insiders","JoinDate":1278657480,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-230028.jpg?_r=1398727965","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"TA Patty","Id":230028,"Name":"TA Patty","IsOnline":false}}],"Id":"80965","Title":"2018 Dominican Republic Bride","LastPostDate":1497060838},"Pages":{"TotalItems":5,"TotalPages":1,"CurrentPage":0,"NextPage