{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":true,"CanEdit":true,"CanReply":true,"CanFollow":true,"TotalPosts":1,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":0,"MovedTo":null,"MovedOn":0,"FirstPostId":1902835,"Rating":0,"RatingHits":0,"Starter":{"Id":284480,"Name":"littlemiss782","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":true},"StartDate":1439989680,"LastPoster":{"Id":284480,"Name":"littlemiss782","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":true},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1902835,"PostDate":1439989680,"PostContent":"Hi!  Just came across this app and I'm hoping all of you wonderful people can help me out?  We've...","Author":{"Signature":"","Email":"ecushion@hotmail.co.uk","IpAddress":"176.249.218.33","GroupId":39,"GroupName":"Newbie","JoinDate":1439988724,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"littlemiss782","Id":284480,"Name":"littlemiss782","IsOnline":true}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"176.249.218.33","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":false,"CanLike":false,"TopicId":79501,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3901cc59f8f84cfc8b30eba5ca5e1c59","RawContent":"Hi! \n\n\nJust came across this app and I&#039;m hoping all of you wonderful people can help me out? \n\n\nWe&#039;ve been engaged for a few years but never got round to getting married due to having children etc However, we have now decided on a destination wedding. We are looking to get married in 2017 which I know seems a long time off but we&#039;ll be able to book up in May 2016. \n\n\nIt&#039;s always been a dream of ours to go to the Caribbean so we are looking at Dominican Republic as a possibility. I really like the look of Dreams La Romana. After looking into the cost of the paper work etc it&#039;s looking like it&#039;s going to be a bit too expensive. Especially as we will only be able to go during the summer school holidays. \n\n\nI am now considering other destinations such as Greece, Mexico, Italy etc\n\n\nOur ideal destination would be:\n\n\u2022 All inclusive\n\n\u2022 Cater for children of all ages\n\n\u2022 4 or 5 star hotel\n\n\u2022 Opportunity to explore local area\n\n\u2022 Scuba diving, paragliding\n\n\u2022 Beach wedding location\n\n\u2022 soft sand beach\n\n\u2022 Family rooms that sleep upto 5\n\n\nReasonable price, Beaches is far too expensive! \n\n\nAll information, suggestions and ideas greatly appreciated. \n\n\nKind regards\n\nMrsM2be :-)","Attachments":[],"Id":1902835,"PostDate":1439989680,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi! <br><br>\nJust came across this app and I'm hoping all of you wonderful people can help me out? <br><br>\nWe've been engaged for a few years but never got round to getting married due to having children etc However, we have now decided on a destination wedding. We are looking to get married in 2017 which I know seems a long time off but we'll be able to book up in May 2016. <br><br>\nIt's always been a dream of ours to go to the Caribbean so we are looking at Dominican Republic as a possibility. I really like the look of Dreams La Romana. After looking into the cost of the paper work etc it's looking like it's going to be a bit too expensive. Especially as we will only be able to go during the summer school holidays. <br><br>\nI am now considering other destinations such as Greece, Mexico, Italy etc<br><br>\nOur ideal destination would be:<br>\n\u2022 All inclusive<br>\n\u2022 Cater for children of all ages<br>\n\u2022 4 or 5 star hotel<br>\n\u2022 Opportunity to explore local area<br>\n\u2022 Scuba diving, paragliding<br>\n\u2022 Beach wedding location<br>\n\u2022 soft sand beach<br>\n\u2022 Family rooms that sleep upto 5<br><br>\nReasonable price, Beaches is far too expensive! <br><br>\nAll information, suggestions and ideas greatly appreciated. <br><br>\nKind regards<br>\nMrsM2be :-)\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ecushion@hotmail.co.uk","IpAddress":"176.249.218.33","GroupId":39,"GroupName":"Newbie","JoinDate":1439988724,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"littlemiss782","Id":284480,"Name":"littlemiss782","IsOnline":true}}],"Id":"79501","Title":"Planning My Dw And Need Some Destination Suggestions!","LastPostDate":1439989680},"Pages":{"TotalItems":1,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
