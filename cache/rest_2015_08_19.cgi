www.tropicalstudioonline.com\/weddings\/dreamslaromana\/local\/GThumb\/410\/f3c15b3c58df1482a93a4c810c72c9e3.jpg\" alt=\"f3c15b3c58df1482a93a4c810c72c9e3.jpg\"><\/span><\/p>\n<br \/><p><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/www.tropicalstudioonline.com\/weddings\/dreamslaromana\/local\/GThumb\/200\/385535742fa6c55acf122bbe69d70536.jpg\" alt=\"385535742fa6c55acf122bbe69d70536.jpg\"><\/span><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/www.tropicalstudioonline.com\/weddings\/dreamslaromana\/local\/GThumb\/410\/5f69252b9b138e34ebc85da3122692b9.jpg\" alt=\"5f69252b9b138e34ebc85da3122692b9.jpg\"><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rizolyaguiar@gmail.com","IpAddress":"74.89.64.141","GroupId":40,"GroupName":"Jr. Member","JoinDate":1375978831,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272367.jpg?_r=1403193511","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"strwbsprkl","Id":272367,"Name":"strwbsprkl","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.197.53.90","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75899,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6b186034cc652093af85fe65d364fc55","RawContent":"&lt;p&gt;I am looking to get married there in April 2015... I am super excited. It looks like an amazing resort. I look forward to sharing information and ideas.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1828024,"PostDate":1390402408,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I am looking to get married there in April 2015... I am super excited. It looks like an amazing resort. I look forward to sharing information and ideas.<\/p>\n<p>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mandiesueb@yahoo.com","IpAddress":"38.99.122.168","GroupId":40,"GroupName":"Jr. Member","JoinDate":1388887317,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275879.jpg?_r=1431174019","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"Mandiesue","Id":275879,"Name":"Mandiesue","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.89.64.141","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75899,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2358a7f4270a73717e93303e2d81c63b","RawContent":"Awww how exciting!!!! Your wedding is  before mine  we can definately  share some ideas!! Are you having a rehearsal dinner?","Attachments":[],"Id":1828226,"PostDate":1390445691,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Awww how exciting!!!! Your wedding is  before mine  we can definately  share some ideas!! Are you having a rehearsal dinner? \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rizolyaguiar@gmail.com","IpAddress":"74.89.64.141","GroupId":40,"GroupName":"Jr. Member","JoinDate":1375978831,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272367.jpg?_r=1403193511","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"strwbsprkl","Id":272367,"Name":"strwbsprkl","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.197.53.90","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75899,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"686a879eb93b6efb2550f3b48f052717","RawContent":"&lt;p&gt;I just got my date confirmed and I am waiting for the hotel contract to arrive. We are getting married 4\/22\/15 at 4:30. I am hopeful its not that hot at that time of the day. I want to look at the pricing. I think I would like to have a rehearsal dinner but I have to plan it out a little more. Are you having the legal ceremony or the symbolic? My travel agent said most people do the symbolic without telling anyone but I have mixed thoughts.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1828385,"PostDate":1390501105,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I just got my date confirmed and I am waiting for the hotel contract to arrive. We are getting married 4\/22\/15 at 4:30. I am hopeful its not that hot at that time of the day. I want to look at the pricing. I think I would like to have a rehearsal dinner but I have to plan it out a little more. Are you having the legal ceremony or the symbolic? My travel agent said most people do the symbolic without telling anyone but I have mixed thoughts.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mandiesueb@yahoo.com","IpAddress":"38.99.122.168","GroupId":40,"GroupName":"Jr. Member","JoinDate":1388887317,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275879.jpg?_r=1431174019","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"Mandiesue","Id":275879,"Name":"Mandiesue","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.89.64.141","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75899,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"49f0494ea815a7ff101a6b94e84ce8d1","RawContent":"&lt;p&gt;us too! we decided on doing the legal ceremony in DR. it will be a little more expensive. I went to a wedding in punta cana in August, people are finding out now the ceremony was symbolic and they don&#039;t seem too happy lol.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;will you be having a wedding party?&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1828621,"PostDate":1390600672,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>us too! we decided on doing the legal ceremony in DR. it will be a little more expensive. I went to a wedding in punta cana in August, people are finding out now the ceremony was symbolic and they don't seem too happy lol.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>will you be having a wedding party?\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rizolyaguiar@gmail.com","IpAddress":"74.89.64.141","GroupId":40,"GroupName":"Jr. Member","JoinDate":1375978831,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272367.jpg?_r=1403193511","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"strwbsprkl","Id":272367,"Name":"strwbsprkl","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.197.53.90","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75899,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"94594ddc20dd1ee02403fe2c794a24ef","RawContent":"&lt;p&gt;I will not be having a wedding party. Our wedding is going to be around 20-30 people. DId you pick your location yet? We are thinking about the white gazebo and I would like to have a beach bar-b-que reception. I havent heard back yet if that is an option.&lt;\/p&gt;","Attachments":[],"Id":1829750,"PostDate":1391027844,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I will not be having a wedding party. Our wedding is going to be around 20-30 people. DId you pick your location yet? We are thinking about the white gazebo and I would like to have a beach bar-b-que reception. I havent heard back yet if that is an option.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mandiesueb@yahoo.com","IpAddress":"38.99.122.168","GroupId":40,"GroupName":"Jr. Member","JoinDate":1388887317,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275879.jpg?_r=1431174019","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"Mandiesue","Id":275879,"Name":"Mandiesue","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.89.64.141","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75899,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1dbdc0153e9deb9d0634ef57a2efd644","RawContent":"&lt;p&gt;I think Yana is on vacation, Jenny came back from vacation on jan 9th. We want the Gazebo for the ceremony and cocktail hr. I was looking into one of the ballrooms or restaurants. It is so hot in July so ac is a must. So far I have a 60 guest list :( looking to downsize.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;I think you&#039;ll be able to do the bbq on the beach. They have bonfire parties all the time on the beach as well.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1829825,"PostDate":1391044300,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I think Yana is on vacation, Jenny came back from vacation on jan 9th. We want the Gazebo for the ceremony and cocktail hr. I was looking into one of the ballrooms or restaurants. It is so hot in July so ac is a must. So far I have a 60 guest list <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/sad.png' class='bbc_emoticon' alt=':(' \/> looking to downsize.\u00a0<\/p>\n<p>\u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0I think you'll be able to do the bbq on the beach. They have bonfire parties all the time on the beach as well.\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rizolyaguiar@gmail.com","IpAddress":"74.89.64.141","GroupId":40,"GroupName":"Jr. Member","JoinDate":1375978831,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272367.jpg?_r=1403193511","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"strwbsprkl","Id":272367,"Name":"strwbsprkl","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.189.27.164","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75899,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3fad112d3938438f9a2e8441b87e51db","RawContent":"&lt;p&gt;Hi Dream La Romana Brides!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Hope your planning is going well. &amp;nbsp;I just started doing research on wedding venues and looking at the Dreams La Romana. &amp;nbsp;What made you ladies choose this resort over all the other ones on the island?&lt;\/p&gt;\n&lt;p&gt;I&#039;ve see the pics and they are indeed gorgeous but it&#039;s nice to know why people make their choice.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;m looking to get married July 2015.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thank you!&lt;\/p&gt;","Attachments":[],"Id":1831671,"PostDate":1391484056,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Dream La Romana Brides!<\/p>\n<p>\u00a0<\/p>\n<p>Hope your planning is going well. \u00a0I just started doing research on wedding venues and looking at the Dreams La Romana. \u00a0What made you ladies choose this resort over all the other ones on the island?<\/p>\n<p>I've see the pics and they are indeed gorgeous but it's nice to know why people make their choice.<\/p>\n<p>\u00a0<\/p>\n<p>I'm looking to get married July 2015.<\/p>\n<p>\u00a0<\/p>\n<p>Thank you!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"carolina12780@yahoo.com","IpAddress":"24.191.37.76","GroupId":39,"GroupName":"Newbie","JoinDate":1390155894,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276197.png?_r=1390185448","PhotoWidth":200,"PhotoHeight":164,"PhotoType":"custom"},"FormattedName":"bonafidelatina","Id":276197,"Name":"bonafidelatina","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.89.64.141","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75899,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"309d011dfd7561f6268e544a9955b996","RawContent":"Yea we are hoping for July, 4, 2015. We picked this one because the resorts in Punta cana are so big. You have to take a little golf cart everywhere and in the night they come every 30 minute well the side we were in. Also our families have already been to Punta cana and in la Romana they can go to more touristy areas like altos de chavon. \n\n\nwhen are you thinking of having your wedding? Hope it helped lol","Attachments":[],"Id":1831707,"PostDate":1391518938,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Yea we are hoping for July, 4, 2015. We picked this one because the resorts in Punta cana are so big. You have to take a little golf cart everywhere and in the night they come every 30 minute well the side we were in. Also our families have already been to Punta cana and in la Romana they can go to more touristy areas like altos de chavon. <br><br>\nwhen are you thinking of having your wedding? Hope it helped lol \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rizolyaguiar@gmail.com","IpAddress":"74.89.64.141","GroupId":40,"GroupName":"Jr. Member","JoinDate":1375978831,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272367.jpg?_r=1403193511","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"strwbsprkl","Id":272367,"Name":"strwbsprkl","IsOnline":false}}],"Id":"75899","Title":"Dreams La Romana 2015","LastPostDate":1439907718},"Pages":{"TotalItems":34,"TotalPages":4,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":30},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
