{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":35,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":5698,"MovedTo":null,"MovedOn":0,"FirstPostId":930928,"Rating":0,"RatingHits":0,"Starter":{"Id":209468,"Name":"~St.T Bride~","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209468.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"IsOnline":false},"StartDate":1258575548,"LastPoster":{"Id":276541,"Name":"tcrawford14","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":88,"Preview":{"Id":1832231,"PostDate":1391701397,"PostContent":"I will be getting married on the Liberty September 2014. Wedding on ship before we leave port. AN...","Author":{"Signature":"","Email":"tbutz1216@aol.com","IpAddress":"198.140.4.205","GroupId":39,"GroupName":"Newbie","JoinDate":1391698512,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"tcrawford14","Id":276541,"Name":"tcrawford14","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":45183,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0674a4e893bf62a85c7b398ff4136bda","RawContent":"[quote]\nOriginally Posted by [b]CruiseBride10[\/b] \/img\/forum\/go_quote.gif\n \n \n \n Hi there! \n \n I will be on your cruise next year! My friends are getting married May 12, 2011 in Ocho Rios.  I have pics of our wedding on the Carnival Liberty which was this past May.  I can send them to your email if you like! \n[\/quote] \n Can you send me your pictures?  I am looking at Ochos Rios :) \n Let me know: \n applefortchr@yahoo.com \n \n Thanks!!","Attachments":[],"Id":1717108,"PostDate":1360177464,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>CruiseBride10<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <p> <br \/> Hi there!<\/p> <p> \u00a0<\/p> <p> I will be on your cruise next year! My friends are getting married May 12, 2011 in Ocho Rios. \u00a0I have pics of our wedding on the Carnival Liberty which was this past May. \u00a0I can send them to your email if you like!<\/p> <p> \u00a0<\/p> <\/blockquote> <p> Can you send me your pictures? \u00a0I am looking at Ochos Rios <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p> <p> Let me know:<\/p> <p> applefortchr@yahoo.com<\/p> <p> \u00a0<\/p> <p> Thanks!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"applefortchr@yahoo.com","IpAddress":"165.155.192.123","GroupId":39,"GroupName":"Newbie","JoinDate":1358083392,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-264343.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Brook53","Id":264343,"Name":"Brook53","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":45183,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8ab38d07f6d75bf5460f7ea7b3623a09","RawContent":"[quote]\nOriginally Posted by [b]olive0y1[\/b] \/img\/forum\/go_quote.gif\n \n \n Hello! \n \n I know this is old and hopefully you get to read this, but I was wondering, did you book your hair appoitment before you boarded the ship or after?[\/quote] \n \n I made my appointment before getting on the ship. I called Carnival, who put me through to the spa management company, who put me through to three other people. I eventually got to the person who managed my ship&#039;s spa and made the appointment. Then I checked in with them the second I got on the boat to confirm appointments. Make them send you email confirmations and bring those emails! :-)","Attachments":[],"Id":1723578,"PostDate":1361395852,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>olive0y1<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <p> Hello!<\/p> <p> \u00a0<\/p> <p> I know this is old and hopefully you get to read this, but I was wondering, did you book your hair appoitment before you boarded the ship or after?<\/p> <\/blockquote> <p> \u00a0<\/p> <p> I made my appointment before getting on the ship. I called Carnival, who put me through to the spa management company, who put me through to three other people. I eventually got to the person who managed my ship's spa and made the appointment. Then\u00a0I checked in with them the second I got on the boat to confirm appointments. Make them send you email confirmations and bring those emails! :-)<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><p><span>Erica & Al - April 3, 2012 - St. Thomas, USVI<\/span><\/p><span><\/span><p><strong><span><em><a data-ipb='nomediaparse' href=\"http:\/\/www.bestdestinationwedding.com\/t\/78715\/aciretas-planning-journal-april-3-2012-cruise-wedding\">Planning Thread<\/a><\/em><\/span><\/strong><\/p><span><\/span><p><a data-ipb='nomediaparse' href=\"http:\/\/www.bestdestinationwedding.com\/t\/79320\/aciretas-wedding-ahr-pics\"><strong><span><em>Wedding & AHR Pics<\/em><\/span><\/strong><\/a><\/p><span><\/span><\/div><\/div>","Email":"ericataffs@gmail.com","IpAddress":"99.11.245.41","GroupId":47,"GroupName":"Site Supporter","JoinDate":1288620966,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-233628.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":197,"PhotoType":"custom"},"FormattedName":"acireta","Id":233628,"Name":"acireta","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":45183,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"59ba66db0f3dde35ca3b700d9daaf0fd","RawContent":"[quote]\nOriginally Posted by [b]acireta[\/b] \/img\/forum\/go_quote.gif\n \n \n \n I made my appointment before getting on the ship. I called Carnival, who put me through to the spa management company, who put me through to three other people. I eventually got to the person who managed my ship&#039;s spa and made the appointment. Then I checked in with them the second I got on the boat to confirm appointments. Make them send you email confirmations and bring those emails! :-)[\/quote] \n Ah great idea, thank you!!!!","Attachments":[],"Id":1726076,"PostDate":1361919025,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>acireta<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <p> \u00a0<\/p> <p> I made my appointment before getting on the ship. I called Carnival, who put me through to the spa management company, who put me through to three other people. I eventually got to the person who managed my ship's spa and made the appointment. Then\u00a0I checked in with them the second I got on the boat to confirm appointments. Make them send you email confirmations and bring those emails! :-)<\/p> <\/blockquote> <p> Ah great idea, thank you!!!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"olivepanes@gmail.com","IpAddress":"108.90.49.194","GroupId":40,"GroupName":"Jr. Member","JoinDate":1322586976,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-248159.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"olive0y1","Id":248159,"Name":"olive0y1","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":45183,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a4e395e5f8670fffb8a7068d29d2b974","RawContent":"[quote]\nOriginally Posted by [b]acireta[\/b] \/img\/forum\/go_quote.gif\n \n \n \n I made my appointment before getting on the ship. I called Carnival, who put me through to the spa management company, who put me through to three other people. I eventually got to the person who managed my ship&#039;s spa and made the appointment. Then I checked in with them the second I got on the boat to confirm appointments. Make them send you email confirmations and bring those emails! :-)[\/quote] \n Btw, is this the number you called to set up the appointment? [list]\n[*][b]1.800.764.7419[\/b]\n[\/list]","Attachments":[],"Id":1726132,"PostDate":1361926697,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>acireta<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <p> \u00a0<\/p> <p> I made my appointment before getting on the ship. I called Carnival, who put me through to the spa management company, who put me through to three other people. I eventually got to the person who managed my ship's spa and made the appointment. Then\u00a0I checked in with them the second I got on the boat to confirm appointments. Make them send you email confirmations and bring those emails! :-)<\/p> <\/blockquote> <p> Btw, is this the number you called to set up the appointment?<\/p> <ul> <li class=\"number\"> <strong id=\"ccl_header_locale-number\">1.800.764.7419<\/strong><\/li> <\/ul>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"olivepanes@gmail.com","IpAddress":"108.90.49.194","GroupId":40,"GroupName":"Jr. Member","JoinDate":1322586976,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-248159.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"olive0y1","Id":248159,"Name":"olive0y1","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"198.140.4.205","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":45183,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f51d0aa5835a515ed252ff05fe502814","RawContent":"&lt;p&gt;I will be getting married on the Liberty September 2014. Wedding on ship before we leave port. ANY suggestions or information about ceremony, reception etc would be greatly appreciated.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1832231,"PostDate":1391701397,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I will be getting married on the Liberty September 2014. Wedding on ship before we leave port. ANY suggestions or information about ceremony, reception etc would be greatly appreciated.<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tbutz1216@aol.com","IpAddress":"198.140.4.205","GroupId":39,"GroupName":"Newbie","JoinDate":1391698512,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"tcrawford14","Id":276541,"Name":"tcrawford14","IsOnline":false}}],"Id":"45183","Title":"Carnival Liberty Brides","LastPostDate":1391701397},"Pages":{"TotalItems":35,"TotalPages":4,"CurrentPage":30,"NextPage":-1,"PreviousPage":20,"LastPage":30},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
