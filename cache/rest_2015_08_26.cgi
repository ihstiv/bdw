{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":5,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":933,"MovedTo":null,"MovedOn":0,"FirstPostId":1871441,"Rating":0,"RatingHits":0,"Starter":{"Id":279746,"Name":"Sarah835","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279746.jpg?_r=1410435597","PhotoWidth":50,"PhotoHeight":50,"PhotoType":"custom"},"IsOnline":false},"StartDate":1410421540,"LastPoster":{"Id":284579,"Name":"MrsSanches30","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":22,"Preview":{"Id":1903502,"PostDate":1440615314,"PostContent":"Hi Ladies! \u00a0 I am getting married at the Majestic Elegance on March 31st,2016. We looked into hav...","Author":{"Signature":"","Email":"dpasqualetti123@gmail.com","IpAddress":"24.185.147.98","GroupId":39,"GroupName":"Newbie","JoinDate":1440615117,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"MrsSanches30","Id":284579,"Name":"MrsSanches30","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"142.206.2.12","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78000,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5b95ba9cdeb4d2c409141b790024d01f","RawContent":"&lt;p&gt;Hi ladies!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I thought I would start a 2016 Majestic Elegance bride forum. I&#039;m planning for my wedding to be on March 15th 2016. I&#039;m hoping to have the ceremony on the beach in the gazebo. I would really like to have a private reception but I&#039;m still looking into the costs associated. Does anyone have ideas about photographers? From what I&#039;ve read, the on-site service is not reliable.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Sarah&lt;\/p&gt;","Attachments":[],"Id":1871441,"PostDate":1410421540,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi ladies!<\/p>\n<p>\u00a0<\/p>\n<p>I thought I would start a 2016 Majestic Elegance bride forum. I'm planning for my wedding to be on March 15th 2016. I'm hoping to have the ceremony on the beach in the gazebo. I would really like to have a private reception but I'm still looking into the costs associated. Does anyone have ideas about photographers? From what I've read, the on-site service is not reliable.<\/p>\n<p>\u00a0<\/p>\n<p>Sarah<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sarahsamuelwedding@hotmail.com","IpAddress":"142.206.2.12","GroupId":39,"GroupName":"Newbie","JoinDate":1410259050,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279746.jpg?_r=1410435597","PhotoWidth":50,"PhotoHeight":50,"PhotoType":"custom"},"FormattedName":"Sarah835","Id":279746,"Name":"Sarah835","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"161.185.161.116","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78000,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"7700b6898a37f7867f5eafe99a447b46","RawContent":"&lt;p&gt;@[member=\"Sarah835\"] Congrats on your engagement and wedding:) I&#039;m not a Majestic bride. However, look into HDC for your wedding photos. They have amazing reviews and the photos I&#039;ve seen are beautiful. Happy planning my fellow 2016 bride!&lt;\/p&gt;","Attachments":[],"Id":1871541,"PostDate":1410450640,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"279746\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/279746-sarah835\/' title='Member profile'><span itemprop=\"name\">Sarah835<\/span><\/a> Congrats on your engagement and wedding:) I'm not a Majestic bride. However, look into HDC for your wedding photos. They have amazing reviews and the photos I've seen are beautiful. Happy planning my fellow 2016 bride!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p style=\"text-align:center;\">\u00a0 \u00a0 \u00a0 \u00a0 \u00a0 Future Mrs. Bonitto 10\/14\/16<\/p>\n<div><br><div>\u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0<a  class=\"bbc_url\" href=\"http:\/\/www.theknot.com\/?utm_source=ticker&utm_medium=UBB&utm_campaign=tickers\"><img src=\"http:\/\/global.theknot.com\/tickers\/tt1c2490.aspx\" alt=\"tt1c2490.aspx\"><\/a><\/div>\n<div>\u00a0\u00a0<\/div>\n<\/div>\n<p>\u00a0","Email":"shamicaglover@yahoo.com","IpAddress":"161.185.157.23","GroupId":40,"GroupName":"Jr. Member","JoinDate":1394118776,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277031.jpg?_r=1397251056","PhotoWidth":200,"PhotoHeight":203,"PhotoType":"custom"},"FormattedName":"MrandMrsBonitto2016","Id":277031,"Name":"MrandMrsBonitto2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"142.206.2.14","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78000,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b76c29b020228b85e22d221f3943f7d9","RawContent":"&lt;p&gt;I was thinking of doing an underwater trash the dress session! Does anyone know of underwater photographers in the Punta Cana region? I&#039;m having a hard time finding one!&lt;\/p&gt;","Attachments":[],"Id":1872071,"PostDate":1410953622,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I was thinking of doing an underwater trash the dress session! Does anyone know of underwater photographers in the Punta Cana region? I'm having a hard time finding one!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sarahsamuelwedding@hotmail.com","IpAddress":"142.206.2.12","GroupId":39,"GroupName":"Newbie","JoinDate":1410259050,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279746.jpg?_r=1410435597","PhotoWidth":50,"PhotoHeight":50,"PhotoType":"custom"},"FormattedName":"Sarah835","Id":279746,"Name":"Sarah835","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"100.0.3.213","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78000,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"59250cc759ea5162ecd58f92f5ed9cae","RawContent":"&lt;p&gt;Sarah Congrats&lt;\/p&gt;\n&lt;p&gt;I am planning Aug of 2016. I am planning the beach also. I think i am going to have a non private dinner then a private reception party after.&lt;\/p&gt;","Attachments":[],"Id":1889795,"PostDate":1426638188,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Sarah Congrats<\/p>\n<p>I am planning Aug of 2016. I am planning the beach also. I think i am going to have a non private dinner then a private reception party after.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"laurenp1528@aol.com","IpAddress":"100.0.3.213","GroupId":39,"GroupName":"Newbie","JoinDate":1425946718,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"laurenstru","Id":282374,"Name":"laurenstru","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.185.147.98","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78000,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3297553f44a87cc46664252b9b1fc9aa","RawContent":"&lt;p&gt;Hi Ladies!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am getting married at the Majestic Elegance on March 31st,2016. We looked into having a private reception, but it was too much money. We were thinking of having a semi-private dinner then a private party at one of the bars after. Is anyone else doing this? Thanks!&lt;\/p&gt;","Attachments":[],"Id":1903502,"PostDate":1440615314,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Ladies!<\/p>\n<p>\u00a0<\/p>\n<p>I am getting married at the Majestic Elegance on March 31st,2016. We looked into having a private reception, but it was too much money. We were thinking of having a semi-private dinner then a private party at one of the bars after. Is anyone else doing this? Thanks!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"dpasqualetti123@gmail.com","IpAddress":"24.185.147.98","GroupId":39,"GroupName":"Newbie","JoinDate":1440615117,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"MrsSanches30","Id":284579,"Name":"MrsSanches30","IsOnline":false}}],"Id":"78000","Title":"Majestic Elegance Brides - 2016","LastPostDate":1440615314},"Pages":{"TotalItems":5,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}