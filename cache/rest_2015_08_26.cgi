ad>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks for Sharing Linda! Where did you have the reception? The reception link was disabled.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"shebaa1123@gmail.com","IpAddress":"75.115.5.66","GroupId":39,"GroupName":"Newbie","JoinDate":1418578824,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Shebaa1123","Id":281409,"Name":"Shebaa1123","IsOnline":false}}],"Pages":{"TotalItems":26,"TotalPages":3,"CurrentPage":20,"NextPage":-1,"PreviousPage":10,"LastPage":20},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
