> URL: /index.php?/REST/Forums/topic/getPosts?topicId=79218&start=20&SessionId=de307203ab2fa6e368f6f2081ceb7ab5
> User jacquewedding (283943)
Request Time: 1 seconds
{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"201.116.201.71","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79218,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"82b1f09d89469b16f5965fca5547b8a7","RawContent":"[quote name=\"barcelobride2016\" post=\"1897367\" timestamp=\"1432754626\"]\nHello fellow brides! I&#039;m sure this topic has come up a million times, but I&#039;m wondering if it&#039;s acceptable to wear almost a ball gown type of dress to a destination wedding? I&#039;m getting married at the barcelo maya palace march 2016. I was originally looking for a mermaid style dress but fell in love with this one. Thoughts?? Too much? [img]http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif[\/img][url=\"http:\/\/www.bestdestinationwedding.com\/index.php?app=core&amp;amp;module=attach&amp;amp;section=attach&amp;amp;attach_rel_module=post&amp;amp;attach_id=32441\"]image.jpg[\/url]\nI&#039;m not sure why I look sideways..oh well you get the point.\n[\/quote]\nHello Dear @[member=\"barcelobride2016\"]\n\nCongratulation for your future wedding!!I hope everything doing good with the planning process  for the big day!! \n\nOur destination is a beach destination, our location is  Las Caletas Mexico, here the only way to arrive  is via boat or catamaran, but it is not an impediment to wear a glamurous and elegance dress !! You can wear anything that show your style!!.\n\n[sharedmedia=gallery:albums:18074]","Attachments":[],"Id":1900416,"PostDate":1436873086,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>barcelobride2016, on 27 May 2015 - 03:23 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hello fellow brides! I'm sure this topic has come up a million times, but I'm wondering if it's acceptable to wear almost a ball gown type of dress to a destination wedding? I'm getting married at the barcelo maya palace march 2016. I was originally looking for a mermaid style dress but fell in love with this one. Thoughts?? Too much? <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif\" alt=\"attachicon.gif\"><\/span><a href='http:\/\/www.bestdestinationwedding.com\/index.php?app=core&module=attach&section=attach&attach_rel_module=post&attach_id=32441' class='bbc_url' title=''>image.jpg<\/a><\/p>\n<p>I'm not sure why I look sideways..oh well you get the point.<\/p>\n<p>\u00a0<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>Hello Dear @<a hovercard-ref=\"member\" hovercard-id=\"283271\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/283271-barcelobride2016\/' title='Member profile'><span itemprop=\"name\">barcelobride2016<\/span><\/a><\/p>\n<div>\u00a0<\/div>\n<p>Congratulation for your future wedding!!I hope everything doing good with the planning process \u00a0for the big day!!\u00a0<\/p>\n<div>\u00a0<\/div>\n<div>Our destination is a beach destination, our location is \u00a0Las Caletas Mexico, here the only way to arrive \u00a0is via boat or catamaran, but it is not an impediment to wear a glamurous and elegance dress !! You can wear anything that show your style!!.<\/div>\n<div>\n<div><div class='_sharedMediaBbcode'>\n\t<div class='bbcode_mediaWrap clearfix'>\n\t\t<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/album\/18074-adventure-weddings\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_18074\/tn_gallery_258213_18074_440469.png' class='sharedmedia_screenshot cover_img_75' title='Glamorous dresses'  width='75' height='75'  alt='Glamorous dresses' id='tn_image_view_81602_cover' \/><\/a>\n\t\t<div class='details'>\n\t\t\t<h5><a href='http:\/\/www.bestdestinationwedding.com\/gallery\/album\/18074-adventure-weddings\/' class='bbc_url' title=''>Album: Adventure Weddings<\/a><\/h5>\n\t\t\t<div>6 images<\/div>\n\t\t\t<div>0 comments<\/div>\n\t\t<\/div>\n\t<\/div>\n<\/div>\n<br \/><\/div>\n<p>\u00a0<\/p>\n<\/div>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"dennise@adventureweddingsvallarta.com","IpAddress":"187.146.166.254","GroupId":49,"GroupName":"Insiders","JoinDate":1343044403,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-258213.jpeg?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"LasCaletas","Id":258213,"Name":"LasCaletas","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.98.143.201","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79218,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2d271a65d08de8d0b3a45436ea41deb1","RawContent":"&lt;p&gt;@[member=\"barcelobride2016\"]&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;m getting married exactly ONE WEEK before you in the same resort, same gazebo! I&#039;m also 90% sure that I will be wearing a ball-gown type of dress. I figured it would be ok since my ceremony is in the gazebo and reception in the banquet room.&lt;\/p&gt;","Attachments":[],"Id":1901713,"PostDate":1438555397,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"283271\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/283271-barcelobride2016\/' title='Member profile'><span itemprop=\"name\">barcelobride2016<\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>I'm getting married exactly ONE WEEK before you in the same resort, same gazebo! I'm also 90% sure that I will be wearing a ball-gown type of dress. I figured it would be ok since my ceremony is in the gazebo and reception in the banquet room.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"uniceeeee@gmail.com","IpAddress":"72.66.30.29","GroupId":39,"GroupName":"Newbie","JoinDate":1428168744,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"yooyooo","Id":282629,"Name":"yooyooo","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"122.15.103.61","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79218,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"eceea585f55109fcebb16cb2679219c7","RawContent":"&lt;p&gt;hey congrats.&lt;\/p&gt;\n&lt;p&gt;you can wear whatever is more comfortable to you. you will gorgeous in any dress because wedding day is totally the day of bridal.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1901875,"PostDate":1438744754,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>hey congrats.<\/p>\n<p>you can wear whatever is more comfortable to you. you will gorgeous in any dress because wedding day is totally the day of bridal.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"katherineriverace@gmail.com","IpAddress":"122.15.103.61","GroupId":39,"GroupName":"Newbie","JoinDate":1425086317,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282278.png?_r=1425103909","PhotoWidth":200,"PhotoHeight":242,"PhotoType":"custom"},"FormattedName":"RitvikSehgal","Id":282278,"Name":"RitvikSehgal","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"122.15.103.61","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79218,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6a9017bd98879877f3f2cfb9ada202d9","RawContent":"&lt;p&gt;&lt;span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\"&gt;You will be gorgeous in any dress because wedding day is totally the day of bridal. I suggest you to wear something in which you are very comfortable.&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1901970,"PostDate":1438828125,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span  style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif\">You will be gorgeous in any dress because wedding day is totally the day of bridal. I suggest you to wear something in which you are very comfortable.<\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rahulthakur01@hotmail.com","IpAddress":"122.15.103.61","GroupId":39,"GroupName":"Newbie","JoinDate":1438822568,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"rahulthakur01","Id":284300,"Name":"rahulthakur01","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"216.232.36.51","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79218,"EditedBy":"","EditDate":1439754900,"EditReason":"","DeleteDate":0,"TotalLikes":3,"IsLiked":false,"PostKey":"d408021f01d6118d3c779e6ce0454b52","RawContent":"&lt;p&gt;Of course it is acceptable!!&amp;nbsp; It is your day and whatever you want to wear that makes you feel special is what&#039;s acceptable!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;For me, I did the stereotypical \"bridal\" gown for my 1st wedding, but for this my 2nd time around I wanted to achieve a more sexy felling than \"bridal\" lol.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;This is the dress I ordered minus the train and the rear hem is to my ankles.&lt;\/p&gt;","Attachments":[{"Id":33354,"Name":"My dress.JPG","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2015\/post-282362-0-20351800-1439768680.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2015\/post-282362-0-20351800-1439768680_thumb.jpg","Width":330,"Height":460}],"Id":1902630,"PostDate":1439754325,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Of course it is acceptable!!\u00a0 It is your day and whatever you want to wear that makes you feel special is what's acceptable!<\/p>\n<p>\u00a0<\/p>\n<p>For me, I did the stereotypical \"bridal\" gown for my 1st wedding, but for this my 2nd time around I wanted to achieve a more sexy felling than \"bridal\" lol.<\/p>\n<p>\u00a0<\/p>\n<p>This is the dress I ordered minus the train and the rear hem is to my ankles.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"maddjax@gmail.com","IpAddress":"216.232.36.51","GroupId":39,"GroupName":"Newbie","JoinDate":1425825405,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282362.jpg?_r=1439765582","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"maddjax","Id":282362,"Name":"maddjax","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.42.251","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79218,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3f199b821d984d09cdde82c803246cf3","RawContent":"&lt;p&gt;@maddjax&amp;nbsp; That&#039;s so pretty!! And perfect for a DW!&lt;\/p&gt;","Attachments":[],"Id":1902633,"PostDate":1439759246,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@maddjax\u00a0 That's so pretty!! And perfect for a DW!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.234.116.105","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79218,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6ffecbebbdd1d981cfe428750bac6ad1","RawContent":"[quote name=\"calgarybride2015\" post=\"1897455\" timestamp=\"1432851115\"]\nChub rub. I have that lol. Figure skater thighs I like to say :) \n\n\nSent from my iPhone using Tapatalk[\/quote]Mine are fast food thighs. :)","Attachments":[],"Id":1902634,"PostDate":1439760322,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>calgarybride2015, on 28 May 2015 - 06:11 PM, said:<\/p><div class='blockquote'><div class='quote'><p>Chub rub. I have that lol. Figure skater thighs I like to say <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> <br><br><br>\nSent from my iPhone using Tapatalk<\/p><\/div><\/div>\nMine are fast food thighs. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>My Planning Thread (Grand Sirenis 05.12.16)<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79418-joannabananas-planning-thread-may-12th-2016-grand-sirenis\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79418-joannabananas-planning-thread-may-12th-2016-grand-sirenis\/<\/a>","Email":"joanne.aguiar@gmail.com","IpAddress":"99.234.116.105","GroupId":40,"GroupName":"Jr. Member","JoinDate":1424042509,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282128.jpg?_r=1435421499","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"JoannaBanana","Id":282128,"Name":"JoannaBanana","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"122.15.103.61","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79218,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a7ac15c3dc8d207a5d224bc2d3132567","RawContent":"&lt;p&gt;hey,&lt;\/p&gt;\n&lt;p&gt;congrats for the weeding.&lt;\/p&gt;\n&lt;p&gt;your dress is really very beautiful and you will look gorgeous in this.&lt;\/p&gt;","Attachments":[],"Id":1902952,"PostDate":1440053969,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>hey,<\/p>\n<p>congrats for the weeding.<\/p>\n<p>your dress is really very beautiful and you will look gorgeous in this.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rahulthakur01@hotmail.com","IpAddress":"122.15.103.61","GroupId":39,"GroupName":"Newbie","JoinDate":1438822568,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"rahulthakur01","Id":284300,"Name":"rahulthakur01","IsOnline":false}}],"Pages":{"TotalItems":28,"TotalPages":3,"CurrentPage":20,"NextPage":-1,"PreviousPage":10,"LastPage":20},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
