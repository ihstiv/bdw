{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":16,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":1672,"MovedTo":null,"MovedOn":0,"FirstPostId":1721791,"Rating":0,"RatingHits":0,"Starter":{"Id":264966,"Name":"MK71809","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-264966.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"StartDate":1361111776,"LastPoster":{"Id":278914,"Name":"MissJen3","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278914.jpg?_r=1427504777","PhotoWidth":200,"PhotoHeight":146,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":88,"Preview":{"Id":1861942,"PostDate":1406172570,"PostContent":"I havent even looked in stores. I have looked online, and have tagged a few that I like, but when...","Author":{"Signature":"","Email":"jen.tipler@gmail.com","IpAddress":"99.247.221.156","GroupId":40,"GroupName":"Jr. Member","JoinDate":1404873744,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278914.jpg?_r=1427504777","PhotoWidth":200,"PhotoHeight":146,"PhotoType":"custom"},"FormattedName":"MissJen3","Id":278914,"Name":"MissJen3","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72614,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"86d3fbebf096a8aa0f369dff5fb41f3b","RawContent":"Hey Brides I am getting married on embarkation day n I can&#039;t help but feel that I shouldn&#039;t be getting a big ole gown. Bc #1 it&#039;s my second marriage n #2 won&#039;t be in it very long bc the ceremony n reception will be over by 3pm n I think its silly 2 spend all that money for only several hrs. Can u past brides or brides 2 be help me out! Pllllleeeeaase! I don&#039;t want the party 2 end at 3pm when my non sailing guest have 2 leave. What is everyone else doing? Will u have dinner n cocktails later in the evening? R u wearing a big, beautiful wedding gown? What made u decide on long or short? Thanks, Kara","Attachments":[],"Id":1721791,"PostDate":1361111776,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hey Brides I am getting married on embarkation day n I can't help but feel that I shouldn't be getting a big ole gown. Bc #1 it's my second marriage n #2 won't be in it very long bc the ceremony n reception will be over by 3pm n I think its silly 2 spend all that money for only several hrs. Can u past brides or brides 2 be help me out! Pllllleeeeaase! I don't want the party 2 end at 3pm when my non sailing guest have 2 leave. What is everyone else doing? Will u have dinner n cocktails later in the evening? R u wearing a big, beautiful wedding gown? What made u decide on long or short? Thanks, Kara\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"July2014bride@verizon.net","IpAddress":"","GroupId":47,"GroupName":"Site Supporter","JoinDate":1358981135,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-264966.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"MK71809","Id":264966,"Name":"MK71809","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72614,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8db80e643cafb1b0b412a44ada828092","RawContent":"&lt;p&gt; Hi Kara, I think you should wear whatever you want to wear on your wedding day, regardless if it&#039;s your second marriage. I do suggest you get a dress that travels well though (material that doesn&#039;t wrinkle easily\/not too heavy\/not too hot for the destination you chose). I didn&#039;t get married on a cruise, but I did get married on a beach and my dress was super lightweight chiffon. Good luck!&lt;\/p&gt;","Attachments":[],"Id":1721921,"PostDate":1361133679,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hi Kara, I think you should wear whatever you want to wear on your wedding day, regardless if it's your second marriage. I do suggest you get a dress that travels well though (material that doesn't wrinkle easily\/not too heavy\/not too hot for the destination you chose). I didn't get married on a cruise, but I did get married on a beach and my dress was super lightweight chiffon. Good luck!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"feebi_@hotmail.com","IpAddress":"42.98.255.116","GroupId":40,"GroupName":"Jr. Member","JoinDate":1285951162,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232829.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"feebi","Id":232829,"Name":"feebi","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72614,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"780f2e228e540c2cd52ddcb582eb7a9a","RawContent":"[quote]\nOriginally Posted by [b]MK71809[\/b] \/img\/forum\/go_quote.gif\n \n Hey Brides I am getting married on embarkation day n I can&#039;t help but feel that I shouldn&#039;t be getting a big ole gown. Bc #1 it&#039;s my second marriage n #2 won&#039;t be in it very long bc the ceremony n reception will be over by 3pm n I think its silly 2 spend all that money for only several hrs. Can u past brides or brides 2 be help me out! Pllllleeeeaase! I don&#039;t want the party 2 end at 3pm when my non sailing guest have 2 leave. What is everyone else doing? Will u have dinner n cocktails later in the evening? R u wearing a big, beautiful wedding gown? What made u decide on long or short?\n \n Thanks, Kara[\/quote] \n Hi Kara, \n So I got my dress from Nordstroms online. There is a Nordstrom Wedding Suite not too far from me that I&#039;ll have all the alterations done at. What I love love love about Nordstroms is their return policy. So far I have purchased 3 gowns off their website and have returned the 2 I didn&#039;t like. As long as it&#039;s not altered and you still have the tags they will take it back no questions asked. I got my dress for $250 which is unheard of. All the reviews from this gown said it&#039;s easy to travel with and doesn&#039;t wrinkle. I&#039;ve tried it on and I LOVE it!! It does run a lil long so I&#039;ll have to get it altered. Another thing about Nordstorm is they&#039;ll let you chose a $$ amount to go up to and it&#039;s free shipping over $75. I don&#039;t know if you have got your dress yet or if you are still looking but if you are still looking I&#039;d look into Nordstrom&#039;s Wedding Gown selections. If you do have your dress and are feeling guilty what is the return policy like. A dress doesn&#039;t have to cost an arm and a leg for it to be considered a wedding gown. As long as you feel comfortable in it and are comfortable with the price then I say it&#039;s the right gown. If your dress is big and the price is right and you feel good in it then I say rock that gown! Good of luck! \n Best, \n Melissa \n \n Wedding Suite Dresses $500 and under: \n [img]http:\/\/g-lvl3.nordstromimage.com\/imagegallery\/store\/product\/Large\/15\/_6362075.jpg[\/img]","Attachments":[],"Id":1721934,"PostDate":1361135930,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>MK71809<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> Hey Brides I am getting married on embarkation day n I can't help but feel that I shouldn't be getting a big ole gown. Bc #1 it's my second marriage n #2 won't be in it very long bc the ceremony n reception will be over by 3pm n I think its silly 2 spend all that money for only several hrs. Can u past brides or brides 2 be help me out! Pllllleeeeaase! I don't want the party 2 end at 3pm when my non sailing guest have 2 leave. What is everyone else doing? Will u have dinner n cocktails later in the evening? R u wearing a big, beautiful wedding gown? What made u decide on long or short?<br \/> <br \/> Thanks, Kara<\/blockquote> <p> Hi Kara,<\/p> <p> So I got my dress from Nordstroms online. There is a Nordstrom Wedding Suite not too far from me\u00a0that I'll have all the alterations done at. What I love love love about Nordstroms is their return policy. So far I have purchased 3 gowns off their website and have returned the 2 I didn't like. As long as it's not altered and you still have the tags they will take it back no questions asked. I got my dress for $250 which is unheard of. All the reviews from this gown said it's easy to travel with and doesn't wrinkle. I've tried it on and I LOVE it!! It does run a lil long so I'll have to get it altered. Another thing about Nordstorm is they'll let you chose a $$ amount to go up to and it's free shipping over $75. I don't know if you have got your dress yet or if you are still looking but if you are still looking I'd look into Nordstrom's Wedding Gown selections. If you do have your dress and are feeling guilty what is the return policy like. A dress doesn't have to cost an arm and a leg for it to be considered a wedding gown. As long as you feel comfortable in it and are comfortable with the price then I say it's the right gown. If your dress is big and the price is right and you feel good in it then I say rock that gown!\u00a0Good of luck!<\/p> <p> Best,<\/p> <p> Melissa<\/p> <p> \u00a0<\/p> <p> Wedding Suite Dresses $500 and under:<\/p> <p> <span rel='lightbox'><img class='bbc_img' height=\"399\" id=\"irc_mi\" src=\"http:\/\/g-lvl3.nordstromimage.com\/imagegallery\/store\/product\/Large\/15\/_6362075.jpg\" style=\"margin-top: 0px;\" width=\"260\" \/><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ma.palmerII@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1345522637,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-259415.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"melnryluvco","Id":259415,"Name":"melnryluvco","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72614,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b37831ba8ded61e169d655d0b52de470","RawContent":"Thank u! I haven&#039;t purchased it yet but have fallen inlove with this one [img]http:\/\/img.tapatalk.com\/d\/13\/02\/18\/uge2azeq.jpg[\/img] Hope the pic comes up :))","Attachments":[],"Id":1721985,"PostDate":1361150446,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thank u! I haven't purchased it yet but have fallen inlove with this one <span rel='lightbox'><img class='bbc_img' src='http:\/\/img.tapatalk.com\/d\/13\/02\/18\/uge2azeq.jpg' alt='Posted Image'  \/><\/span> Hope the pic comes up <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>)\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"July2014bride@verizon.net","IpAddress":"","GroupId":47,"GroupName":"Site Supporter","JoinDate":1358981135,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-264966.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"MK71809","Id":264966,"Name":"MK71809","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72614,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"aabde0da1ad022eab423b259d5b12349","RawContent":"[quote]\nOriginally Posted by [b]MK71809[\/b] \/img\/forum\/go_quote.gif\n \n Thank u! I haven&#039;t purchased it yet but have fallen inlove with this one [img]http:\/\/img.tapatalk.com\/d\/13\/02\/18\/uge2azeq.jpg[\/img]\n \n Hope the pic comes up :))[\/quote] \n That is beautiful!!!!!! I love love love it! I think as long as you look and feel great in it to hell with what anyone says about your 2nd wedding. I think you deserve to feel special on this day no matter what! Good luck!","Attachments":[],"Id":1722016,"PostDate":1361156428,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>MK71809<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> Thank u! I haven't purchased it yet but have fallen inlove with this one <span rel='lightbox'><img class='bbc_img' alt=\"uge2azeq.jpg\" class=\"bbcode_img\" src=\"http:\/\/img.tapatalk.com\/d\/13\/02\/18\/uge2azeq.jpg\" \/><\/span><br \/> <br \/> Hope the pic comes up <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>)<\/blockquote> <p> That is beautiful!!!!!! I love love love it! I think as long as you look and feel great in it to hell with what anyone says about your 2nd wedding. I think you deserve to feel special on this day no matter what! Good luck!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ma.palmerII@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1345522637,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-259415.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"melnryluvco","Id":259415,"Name":"melnryluvco","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72614,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"40cf9a42d95aadedb87467067ab7d7eb","RawContent":"&lt;p&gt; I love your gown - to make you feel better, it is our second wedding as well (I am in my late 40&#039;s), my original thought was that I would get a simple gown since it is our second wedding and it was on a cruise, well I tried on all of the ones that I printed (without a train, no fuss etc) and I ended up with something I never thought I would; when I tried it on I just fell in love with it!&lt;\/p&gt; &lt;p id=\"yui_3_7_3_1_1361233973168_2374\"&gt; &lt;img alt=\"LEAD Technologies Inc. V1.01&#10;\" data-id=\"189016\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/189016\/width\/350\/height\/700\" \/&gt;&lt;\/p&gt;","Attachments":[],"Id":1722467,"PostDate":1361235453,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I love your gown - to make you feel better, it is our second wedding as well (I am in my late 40's), my original thought was that I would get a simple gown since it is our second wedding and it was on a cruise, well I tried on all of the ones that I printed (without a train, no fuss etc) and I ended up with something I never thought I would; when I tried it on I just fell in love with it!<\/p> <p id=\"yui_3_7_3_1_1361233973168_2374\"> <span rel='lightbox'><img class='bbc_img' alt=\"LEAD Technologies Inc. V1.01&#10;\" data-id=\"189016\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/189016\/width\/350\/height\/700\" \/><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"debimthomas@msn.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1348920150,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-260833.jpeg?_r=0","PhotoWidth":169,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"dst8","Id":260833,"Name":"dst8","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72614,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"92e16538957464a6f48a9219fc35303b","RawContent":"Dst8 what day r u getting married on ur cruise? Thank u 2 everyone that responded... ya know what I&#039;m gonna get that big beautiful dress bc my first marriage didn&#039;t matter and It&#039;s still my day :)) Kara","Attachments":[],"Id":1722892,"PostDate":1361302192,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Dst8 what day r u getting married on ur cruise? Thank u 2 everyone that responded... ya know what I'm gonna get that big beautiful dress bc my first marriage didn't matter and It's still my day <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>) Kara\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"July2014bride@verizon.net","IpAddress":"","GroupId":47,"GroupName":"Site Supporter","JoinDate":1358981135,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-264966.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"MK71809","Id":264966,"Name":"MK71809","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72614,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"73f4e537a67a9b0a91bf268d3d86d3b3","RawContent":"[quote]\nOriginally Posted by [b]MK71809[\/b] \/img\/forum\/go_quote.gif\n \n Dst8 what day r u getting married on ur cruise?\n \n Thank u 2 everyone that responded... ya know what I&#039;m gonna get that big beautiful dress bc my first marriage didn&#039;t matter and It&#039;s still my day :))\n \n Kara[\/quote] \n \n Kara - great way to look at it - its your day and it should be whatever you want it to be..... \n \n We are getting married on the Breeze 1-4-14","Attachments":[],"Id":1723674,"PostDate":1361408544,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>MK71809<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> Dst8 what day r u getting married on ur cruise?<br \/> <br \/> Thank u 2 everyone that responded... ya know what I'm gonna get that big beautiful dress bc my first marriage didn't matter and It's still my day <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>)<br \/> <br \/> Kara<\/blockquote> <p> \u00a0<\/p> <p> Kara - great way to look at it - its your day and it should be whatever you want it to be.....<\/p> <p> \u00a0<\/p> <p> We are getting married on the Breeze 1-4-14<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"debimthomas@msn.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1348920150,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-260833.jpeg?_r=0","PhotoWidth":169,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"dst8","Id":260833,"Name":"dst8","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72614,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c992197104feb0c744aa2ecfc92b4d9b","RawContent":"&lt;p&gt; I&#039;m getting married on embarkation day as well, and I&#039;m wearing what I want! &amp;nbsp;Yes, the non sailing guests have to get off at 3, but I&#039;m staying in my dress until after dinner. &amp;nbsp;I really want to take pictures during the captain&#039;s drill! LOL! We aren&#039;t having a formal reception, since dinner is at 6. &amp;nbsp;I&#039;m staying in my dress as long as I want! Do whatever pleases you, because that&#039;s all that matters on that day! &amp;nbsp;Cheers!&lt;\/p&gt;","Attachments":[],"Id":1728567,"PostDate":1362416080,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I'm getting married on embarkation day as well, and I'm wearing what I want! \u00a0Yes, the non sailing guests have to get off at 3, but I'm staying in my dress until after dinner. \u00a0I really want to take pictures during the captain's drill! LOL! We aren't having a formal reception, since dinner is at 6. \u00a0I'm staying in my dress as long as I want! Do whatever pleases you, because that's all that matters on that day! \u00a0Cheers!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Tandtglass@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1352169592,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-262117.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Tandtglass","Id":262117,"Name":"Tandtglass","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72614,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c8d50cc62217c25dfc0cd2f941a9c9b9","RawContent":"&lt;p&gt; I too think 2-3 hours is a short time to be in my wedding dress, so we will probably have an AHR at a later date to be able to wear it again.&lt;\/p&gt;","Attachments":[],"Id":1737902,"PostDate":1364186868,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I too think 2-3 hours is a short time to be in my wedding dress, so we will probably have an AHR at a later date to be able to wear it again.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mscheryl10@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1361030249,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-266139.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"mscheryl10","Id":266139,"Name":"mscheryl10","IsOnline":false}}],"Id":"72614","Title":"Having trouble with gown! Plz help! ","LastPostDate":1406172570},"Pages":{"TotalItems":16,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
