ead>\r\n              <body>\r\n                <p> Carnival Cruises has a variety of dream wedding cruise packages including cruise ship weddings and <strong><a href='http:\/\/www.eventmanagementindia.com' class='bbc_url' title='External link' rel='nofollow external'>destination weddings<\/a><\/strong> to make your special day. Thinking about getting married at sea? Our editor picks eight great cruise lines for onboard (and on-shore) weddings!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"eventmanagementindia1@gmail.com","IpAddress":"","GroupId":5,"GroupName":"Banned","JoinDate":1374141464,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Davindane89","Id":271676,"Name":"Davindane89","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"69.117.93.162","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73377,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cca834711e5ad11b0e267f1fbbcafaa5","RawContent":"Hope you guys weddings were awesome!","Attachments":[],"Id":1861359,"PostDate":1405991645,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hope you guys weddings were awesome!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bseasebey@yahoo.com","IpAddress":"69.117.93.162","Grou