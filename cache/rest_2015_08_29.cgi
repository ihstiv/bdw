{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":2187,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":94493,"MovedTo":null,"MovedOn":0,"FirstPostId":806024,"Rating":0,"RatingHits":0,"Starter":{"Id":220624,"Name":"angelalanahung","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-220624.gif?_r=0","PhotoWidth":200,"PhotoHeight":213,"PhotoType":"custom"},"IsOnline":false},"StartDate":1250646353,"LastPoster":{"Id":242900,"Name":"ndvidul","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-242900.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":2,"Preview":{"Id":806024,"PostDate":1250646353,"PostContent":"Hi all,  Thought I would start a new thread for 2010 as I know the packages etc have changed so I...","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/dwdf.daisypath.com\/Z1a8p1.png\">http:\/\/dwdf.daisypath.com\/Z1a8p1.png<\/a><\/div><\/div>","Email":"actl.1980@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1250514946,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-220624.gif?_r=0","PhotoWidth":200,"PhotoHeight":213,"PhotoType":"custom"},"FormattedName":"angelalanahung","Id":220624,"Name":"angelalanahung","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":41177,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"120cbd16f953eb80a908adce1cab5fac","RawContent":"Hi all,\n \n Thought I would start a new thread for 2010 as I know the packages etc have changed so I am not sure how relevant the information will be on the other thread.\n \n I am getting married at the Moon Palace, Cancun next May. I am still doing a lot of research and need to gather a lot more information.\n \n I would be grateful if people could post as much information as possible. I will do the same aswell!! :)\n \n Good luck with your planning everyone!! &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/bride.gif\" border=\"0\" alt=\"\" title=\"Bride\" class=\"inlineimg\" \/&gt;\n \n Many thanks, Angela","Attachments":[],"Id":806024,"PostDate":1250646353,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi all,<br \/> <br \/> Thought I would start a new thread for 2010 as I know the packages etc have changed so I am not sure how relevant the information will be on the other thread.<br \/> <br \/> I am getting married at the Moon Palace, Cancun next May. I am still doing a lot of research and need to gather a lot more information.<br \/> <br \/> I would be grateful if people could post as much information as possible. I will do the same aswell!! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br \/> <br \/> Good luck with your planning everyone!! <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/bride.gif\" border=\"0\" alt=\"\" title=\"Bride\" class=\"inlineimg\" \/><\/span><br \/> <br \/> Many thanks, Angela\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/dwdf.daisypath.com\/Z1a8p1.png\">http:\/\/dwdf.daisypath.com\/Z1a8p1.png<\/a><\/div><\/div>","Email":"actl.1980@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1250514946,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-220624.gif?_r=0","PhotoWidth":200,"PhotoHeight":213,"PhotoType":"custom"},"FormattedName":"angelalanahung","Id":220624,"Name":"angelalanahung","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":41177,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ab55eed5c549463264d377ff512147df","RawContent":"Hi,\n \n My wedding coordinator is Cristina Doblado. Is she anyone else&#039;s WC? I sent her an email 3 weeks ago and I have heard nothing back. I did send another email a week ago to make sure she got my first email but I still got no response.\n \n I am a little concerned at how competant she is going to be if she can&#039;t even reply to my questions on email. Has she taken ages to reply to anyone elses emails?\n \n Thanks :)","Attachments":[],"Id":806737,"PostDate":1250684778,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi,<br \/> <br \/> My wedding coordinator is Cristina Doblado. Is she anyone else's WC? I sent her an email 3 weeks ago and I have heard nothing back. I did send another email a week ago to make sure she got my first email but I still got no response.<br \/> <br \/> I am a little concerned at how competant she is going to be if she can't even reply to my questions on email. Has she taken ages to reply to anyone elses emails?<br \/> <br \/> Thanks <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/dwdf.daisypath.com\/Z1a8p1.png\">http:\/\/dwdf.daisypath.com\/Z1a8p1.png<\/a><\/div><\/div>","Email":"actl.1980@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1250514946,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-220624.gif?_r=0","PhotoWidth":200,"PhotoHeight":213,"PhotoType":"custom"},"FormattedName":"angelalanahung","Id":220624,"Name":"angelalanahung","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":41177,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bc1c86ea69188b7ae94f51a1b1eb426f","RawContent":"Hi! I am glad someone started the 2010 thread! I am getting married next August. On the other forum they said that the wedding coordinators take a very long time to reply to emails. I cannot wait to see pictures of the new packages so I can figure out which one to pick! I am especially anxious about the flowers, how it says you have to pick from the &amp;quot;sapphire collection&amp;quot; for the bouquet. I am leaning towards sapphire but when I saw pics of those flowers I was disappointed. Do you think they would let us choose another bouquet? I am thinking of going with silk flowers anyway but it would be nice to know.","Attachments":[],"Id":806799,"PostDate":1250698558,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi! I am glad someone started the 2010 thread! I am getting married next August. On the other forum they said that the wedding coordinators take a very long time to reply to emails. I cannot wait to see pictures of the new packages so I can figure out which one to pick! I am especially anxious about the flowers, how it says you have to pick from the \"sapphire collection\" for the bouquet. I am leaning towards sapphire but when I saw pics of those flowers I was disappointed. Do you think they would let us choose another bouquet? I am thinking of going with silk flowers anyway but it would be nice to know.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bowlofcherries28@yahoo.com","IpAddress":"74.108.20.94","GroupId":40,"GroupName":"Jr. Member","JoinDate":1226771822,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-212683.gif?_r=0","PhotoWidth":154,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"slapsappyhappy","Id":212683,"Name":"slapsappyhappy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":41177,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5d63e040688ec65a8a64699aeabfa4d1","RawContent":"HI\n \n I have been sent the pics from the Hotel of the packages as I wanted to see which to choose too.\n \n If you PM me your email address I will happily send it on to you\n \n Rach x","Attachments":[],"Id":806891,"PostDate":1250703290,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                HI<br \/> <br \/> I have been sent the pics from the Hotel of the packages as I wanted to see which to choose too.<br \/> <br \/> If you PM me your email address I will happily send it on to you<br \/> <br \/> Rach x\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rachelwalkden2002@yahoo.co.uk","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1250162699,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-220492.gif?_r=0","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"FormattedName":"mrssharkey2be","Id":220492,"Name":"mrssharkey2be","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":41177,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ae614abb99a7b728372461c5192f1dee","RawContent":"Hi,\n I booked through Virgin Holidays, due to fly out 28th May with wedding to take place 2nd June 2010. has anyone else booked with Virgin? I have not heard anything back from Virgin but did email the hotel who have confirmed my day and time of 3pm. Although we ok-ed the free wedding package I want to upgrade as I have really fallen for the diamond collection! cant wait to see some pictures of the flowers\/cakes etc.","Attachments":[],"Id":807092,"PostDate":1250711187,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi,<br \/> I booked through Virgin Holidays, due to fly out 28th May with wedding to take place 2nd June 2010. has anyone else booked with Virgin? I have not heard anything back from Virgin but did email the hotel who have confirmed my day and time of 3pm. Although we ok-ed the free wedding package I want to upgrade as I have really fallen for the diamond collection! cant wait to see some pictures of the flowers\/cakes etc.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;3\/st\/20100603\/e\/Our+Wedding\/dt\/5\/k\/3143\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...3143\/event.png<\/a><\/div><\/div>","Email":"clare.brewer@hotmail.co.uk","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1248283642,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-219696.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"cb280182","Id":219696,"Name":"cb280182","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":41177,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d9914e4bca8ea538c4e237a4dc39620a","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;cb280182&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Hi,\n I booked through Virgin Holidays, due to fly out 28th May with wedding to take place 2nd June 2010. has anyone else booked with Virgin? I have not heard anything back from Virgin but did email the hotel who have confirmed my day and time of 3pm. Although we ok-ed the free wedding package I want to upgrade as I have really fallen for the diamond collection! cant wait to see some pictures of the flowers\/cakes etc.&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;Hi,\n \n I also booked with VH. I haven&#039;t heard much from them apart from receiving a pack with forms that I need to fill in asking what colours we would like etc...\n \n We went for the deluxe wedding package, we get the sapphire collection but VH said that all we need to do is request a different collection and that shouldn&#039;t be a problem. I didn&#039;t like the sea shells that they include in that package. I always think they look a little tacky :~","Attachments":[],"Id":807110,"PostDate":1250712026,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>cb280182<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Hi,<br \/> I booked through Virgin Holidays, due to fly out 28th May with wedding to take place 2nd June 2010. has anyone else booked with Virgin? I have not heard anything back from Virgin but did email the hotel who have confirmed my day and time of 3pm. Although we ok-ed the free wedding package I want to upgrade as I have really fallen for the diamond collection! cant wait to see some pictures of the flowers\/cakes etc.<\/div> <\/td> <\/tr> <\/table> <\/div>Hi,<br \/> <br \/> I also booked with VH. I haven't heard much from them apart from receiving a pack with forms that I need to fill in asking what colours we would like etc...<br \/> <br \/> We went for the deluxe wedding package, we get the sapphire collection but VH said that all we need to do is request a different collection and that shouldn't be a problem. I didn't like the sea shells that they include in that package. I always think they look a little tacky :~\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/dwdf.daisypath.com\/Z1a8p1.png\">http:\/\/dwdf.daisypath.com\/Z1a8p1.png<\/a><\/div><\/div>","Email":"actl.1980@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1250514946,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-220624.gif?_r=0","PhotoWidth":200,"PhotoHeight":213,"PhotoType":"custom"},"FormattedName":"angelalanahung","Id":220624,"Name":"angelalanahung","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":41177,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c6b7c408d4bbdac122333e6ccf4e3567","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;slapsappyhappy&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Hi! I am glad someone started the 2010 thread! I am getting married next August. On the other forum they said that the wedding coordinators take a very long time to reply to emails. I cannot wait to see pictures of the new packages so I can figure out which one to pick! I am especially anxious about the flowers, how it says you have to pick from the &amp;quot;sapphire collection&amp;quot; for the bouquet. I am leaning towards sapphire but when I saw pics of those flowers I was disappointed. Do you think they would let us choose another bouquet? I am thinking of going with silk flowers anyway but it would be nice to know.&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;\n Hi, I think they let you do what you want as long as you pay for it. I get the sapphire collection as standard but I am going to change it as it won&#039;t go with my colours and I don&#039;t really like shells. :-)","Attachments":[],"Id":807119,"PostDate":1250712253,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>slapsappyhappy<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Hi! I am glad someone started the 2010 thread! I am getting married next August. On the other forum they said that the wedding coordinators take a very long time to reply to emails. I cannot wait to see pictures of the new packages so I can figure out which one to pick! I am especially anxious about the flowers, how it says you have to pick from the \"sapphire collection\" for the bouquet. I am leaning towards sapphire but when I saw pics of those flowers I was disappointed. Do you think they would let us choose another bouquet? I am thinking of going with silk flowers anyway but it would be nice to know.<\/div> <\/td> <\/tr> <\/table> <\/div><br \/> Hi, I think they let you do what you want as long as you pay for it. I get the sapphire collection as standard but I am going to change it as it won't go with my colours and I don't really like shells. :-)\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/dwdf.daisypath.com\/Z1a8p1.png\">http:\/\/dwdf.daisypath.com\/Z1a8p1.png<\/a><\/div><\/div>","Email":"actl.1980@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1250514946,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-220624.gif?_r=0","PhotoWidth":200,"PhotoHeight":213,"PhotoType":"custom"},"FormattedName":"angelalanahung","Id":220624,"Name":"angelalanahung","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":41177,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b697067e7533edba0f1f2623bb4f50bb","RawContent":"Oh, and I will start uploading files and things when I gain enough points to do so :)","Attachments":[],"Id":807611,"PostDate":1250731900,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Oh, and I will start uploading files and things when I gain enough points to do so <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/dwdf.daisypath.com\/Z1a8p1.png\">http:\/\/dwdf.daisypath.com\/Z1a8p1.png<\/a><\/div><\/div>","Email":"actl.1980@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1250514946,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-220624.gif?_r=0","PhotoWidth":200,"PhotoHeight":213,"PhotoType":"custom"},"FormattedName":"angelalanahung","Id":220624,"Name":"angelalanahung","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":41177,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5e067d5af202ee80b310d07573c5dc9e","RawContent":"Hello Ladies :)\n We are getting married at the Moon Palace on February 22\/10. \n We are doing the free package and just adding on anything extra.\n Our wedding ceremony is confirmed for 4pm and we are doing the private reception following. I&#039;ve got a good portion of the planning for our wedding under way so if you have any questions just let me know :)","Attachments":[],"Id":807814,"PostDate":1250738777,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hello Ladies <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br \/> We are getting married at the Moon Palace on February 22\/10. <br \/> We are doing the free package and just adding on anything extra.<br \/> Our wedding ceremony is confirmed for 4pm and we are doing the private reception following. I've got a good portion of the planning for our wedding under way so if you have any questions just let me know <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/img.weddingcountdown.com\/ticker\/gk61191zhz.png\">http:\/\/img.weddingcountdown.com\/ticker\/gk61191zhz.png<\/a><\/div><\/div>","Email":"ambershinbine@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1239354575,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-216616.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"Shinbinea","Id":216616,"Name":"Shinbinea","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":41177,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d78d154d8ee21e63ee6290d82776bc22","RawContent":"Hope you all liked the pics on the emails I sent. Im toying with the Amber\/Emerald and Diamond collections at the mo. They are all too nice","Attachments":[],"Id":808186,"PostDate":1250760642,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hope you all liked the pics on the emails I sent. Im toying with the Amber\/Emerald and Diamond collections at the mo. They are all too nice\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rachelwalkden2002@yahoo.co.uk","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1250162699,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-220492.gif?_r=0","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"FormattedName":"mrssharkey2be","Id":220492,"Name":"mrssharkey2be","IsOnline":false}}],"Id":"41177","Title":"Moon Palace 2010 Brides!!","LastPostDate":1316318827},"Pages":{"TotalItems":2187,"TotalPages":219,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":2180},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
