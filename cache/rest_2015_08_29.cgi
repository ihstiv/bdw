{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":1009,"QueuedPosts":0,"DeletedPosts":7,"HasUnreadPosts":true,"HasAttachments":true,"Views":89609,"MovedTo":null,"MovedOn":0,"FirstPostId":1699849,"Rating":0,"RatingHits":0,"Starter":{"Id":263113,"Name":"superlawyer87","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-263113.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"IsOnline":false},"StartDate":1357145233,"LastPoster":{"Id":274657,"Name":"misbosox","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-274657.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":2,"Preview":{"Id":1748421,"PostDate":1366385812,"PostContent":"Hiya I contacted the hotel direct and they said I only had to buy day passes at $ 93 each for an...","Author":{"Signature":"","Email":"bolderson2002@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1364491685,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-267908.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"kelly1979","Id":267908,"Name":"kelly1979","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71504,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"85bc88e5ae34c6472a4ae998ef349b5e","RawContent":"Hiya I contacted the hotel direct and they said I only had to buy day passes at $ 93 each for an outside vendor but they can only do photographs and not video x","Attachments":[],"Id":1748421,"PostDate":1366385812,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hiya I contacted the hotel direct and they said I only had to buy day passes at $ 93 each for an outside vendor but they can only do photographs and not video x\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bolderson2002@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1364491685,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-267908.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"kelly1979","Id":267908,"Name":"kelly1979","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71504,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"246dad9bce889ba1335e189bced30dc6","RawContent":"&lt;p&gt; Hi Ladies,&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I just confirmed my wedding for July 11, 2014 at the Moon Palace!!! I am very excited for the planning process. I will be traveling on a site inspection tour this August! If you ladies need any particular pictures or questions I can ask once I am there. I would love to help any way I can!&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Happy planning and I&#039;m excited to be sharing our experience along the way!&lt;\/p&gt;","Attachments":[],"Id":1749475,"PostDate":1366657268,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hi Ladies,<\/p> <p> \u00a0<\/p> <p> I just confirmed my wedding for July 11, 2014 at the Moon Palace!!! I am very excited for the planning process. I will be traveling on a site inspection tour this August! If you ladies need any particular pictures or questions I can ask once I am there. I would love to help any way I can!<\/p> <p> \u00a0<\/p> <p> Happy planning and I'm excited to be sharing our experience along the way!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"miriamliabarajas@ymail.com","IpAddress":"204.126.125.254","GroupId":39,"GroupName":"Newbie","JoinDate":1322686764,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-248207.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"LiaLoooves","Id":248207,"Name":"LiaLoooves","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71504,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"63993fc67ff178239bedf2d21f0d8ebb","RawContent":"[quote]\nOriginally Posted by [b]Geegee[\/b] \/img\/forum\/go_quote.gif\n \n Hi\n The photos are amazing! We got engaged at the moon last year and we just have to go back to go back for the big day! How many weeks ahead can contact them we were looking at july 2014 ?[\/quote] \n Hi Geegee! You might want to contact them asap. I just confirmed my wedding for July 11, 2014 and they already had 3 other weddings booked for the same day. It is better to get an early start expecially to save the date you want.","Attachments":[],"Id":1749481,"PostDate":1366657906,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>Geegee<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> Hi<br \/> The photos are amazing! We got engaged at the moon last year and we just have to go back to go back for the big day! How many weeks ahead can contact them we were looking at july 2014 ?<\/blockquote> <p> Hi Geegee! You might want to contact them asap. I just confirmed my wedding for July 11, 2014 and they already had 3 other weddings booked for the same day. It is better to get an early start expecially to save the date you want.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"miriamliabarajas@ymail.com","IpAddress":"204.126.125.254","GroupId":39,"GroupName":"Newbie","JoinDate":1322686764,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-248207.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"LiaLoooves","Id":248207,"Name":"LiaLoooves","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71504,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ea19a651e6337b91d08dad7b3e352190","RawContent":"[quote]\nOriginally Posted by [b]JennyLynn824[\/b] \/img\/forum\/go_quote.gif\n \n \n Me and my fiance are hoping to get married at Moon Palace in early May 2014 and are hoping to book a stay long enough to honeymoon and use the complimentary wedding package.  Has anyone else chosen the complimentary package? What were your thoughts?  Also, our guestlist is only going to be 10-15 people.  Are there any suggestions on things I should ask the WC?  I am new to this and need all the help I can get! Please, lol![\/quote] \n Hi JennyLynn824! \n \n The good thing about the complimentary wedding package is that you can customize your wedding to your taste, using the collections limits you to the colors and flowers, since they are standard. The Moon Palace works with Zuniga Productions which is a vendor that provides extras such as linen, runners, flowers, the whole nine. So you can pretty much have the wedding of your dreams! I also decided on the complimentary since I wasn&#039;t too big on the collections. Hope this helps.","Attachments":[],"Id":1749486,"PostDate":1366658178,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>JennyLynn824<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <p> Me and my fiance are hoping to get married at Moon Palace in early May 2014 and are hoping to book a stay long enough to honeymoon and use the complimentary wedding package. \u00a0Has anyone else chosen the complimentary package? What were your thoughts? \u00a0Also, our guestlist is only going to be 10-15 people. \u00a0Are there any suggestions on things I should ask the WC? \u00a0I am new to this and need all the help I can get! Please, lol!<\/p> <\/blockquote> <p> Hi JennyLynn824!<\/p> <p> \u00a0<\/p> <p> The good thing about the complimentary wedding package is that you can customize your wedding to your taste, using the collections limits you to the colors and flowers, since they are standard. The Moon Palace works with Zuniga Productions which is a vendor that provides extras such as linen, runners, flowers, the whole nine. So you can pretty much have the wedding of your dreams! I also decided on the complimentary since I wasn't too big on the collections. Hope this helps.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"miriamliabarajas@ymail.com","IpAddress":"204.126.125.254","GroupId":39,"GroupName":"Newbie","JoinDate":1322686764,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-248207.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"LiaLoooves","Id":248207,"Name":"LiaLoooves","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71504,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"416659e96962f352df9de021b9b24e93","RawContent":"&lt;p&gt; I would contact them as soon as you can. &amp;nbsp;I am planning for a June 2014 wedding there and the first date I wanted was all booked up! I was in shock. &amp;nbsp;Thankfully they had a time slot available within &amp;nbsp;the same week. &amp;nbsp;I have heard nothing but wonderful things about weddings at this location, so I am sure our weddings will be a success as well! &amp;nbsp;The only cons I have heard is the contract process at first is slow, so be patient. &amp;nbsp;And I have heard that it is always windy down by the water, so plan ahead for that as well when you get your bridesmaid dresses and think about updo&#039;s! (but the wind is usually a plus because of how hot it can be down there)&lt;\/p&gt; &lt;p&gt; \n Hope this helps!&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1749604,"PostDate":1366677190,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I would contact them as soon as you can. \u00a0I am planning for a June 2014 wedding there and the first date I wanted was all booked up! I was in shock. \u00a0Thankfully they had a time slot available within \u00a0the same week. \u00a0I have heard nothing but wonderful things about weddings at this location, so I am sure our weddings will be a success as well! \u00a0The only cons I have heard is the contract process at first is slow, so be patient. \u00a0And I have heard that it is always windy down by the water, so plan ahead for that as well when you get your bridesmaid dresses and think about updo's! (but the wind is usually a plus because of how hot it can be down there)<\/p> <p> <br \/> Hope this helps!\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"juliedrew2014@gmail.com","IpAddress":"76.123.8.194","GroupId":39,"GroupName":"Newbie","JoinDate":1366604745,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268836.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Juliebeth","Id":268836,"Name":"Juliebeth","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71504,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"09bc33045771f55ee47ae2127056df57","RawContent":"&lt;p&gt; That is a good idea to visit before hand!! &amp;nbsp;Could you ask more details about the reception. I know the complimentary includes reception reservations for 30 guests...but I am curious to see if they charge per person or if that includes the food and all?! &amp;nbsp; That is the main concern I have left before finalizing my decision to have my wedding at the Moon Palace in June 2014. &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; How far are you with planning?!&lt;\/p&gt;","Attachments":[],"Id":1749607,"PostDate":1366677508,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> That is a good idea to visit before hand!! \u00a0Could you ask more details about the reception. I know the complimentary includes reception reservations for 30 guests...but I am curious to see if they charge per person or if that includes the food and all?! \u00a0 That is the main concern I have left before finalizing my decision to have my wedding at the Moon Palace in June 2014. \u00a0<\/p> <p> \u00a0<\/p> <p> How far are you with planning?!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"juliedrew2014@gmail.com","IpAddress":"76.123.8.194","GroupId":39,"GroupName":"Newbie","JoinDate":1366604745,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268836.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Juliebeth","Id":268836,"Name":"Juliebeth","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71504,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cf2f8bd8eeca43caaf20e914ce0f0b99","RawContent":"[quote]\nOriginally Posted by [b]LiaLoooves[\/b] \/img\/forum\/go_quote.gif\n \n \n Hi JennyLynn824! \n \n The good thing about the complimentary wedding package is that you can customize your wedding to your taste, using the collections limits you to the colors and flowers, since they are standard. The Moon Palace works with Zuniga Productions which is a vendor that provides extras such as linen, runners, flowers, the whole nine. So you can pretty much have the wedding of your dreams! I also decided on the complimentary since I wasn&#039;t too big on the collections. Hope this helps.[\/quote] \n So happy to have found this thread, the moon palace and playacar palace resorts seem to be some of my top potential choices! Did any of you consider playacar as well? And if so, what made you go with the moon palace? \n \n Our wedding group will be around 40 and mostly in their 30s or so (i.e. younger crown for post part; but hey age is just a number right lol!  ;)  \n \n I&#039;ve heard playa del carmen doesn&#039;t have a huge night life, which is why I may lean more towards moon palace. Any thoughts guys? ;)","Attachments":[],"Id":1749681,"PostDate":1366699394,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>LiaLoooves<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <p> Hi JennyLynn824!<\/p> <p> \u00a0<\/p> <p> The good thing about the complimentary wedding package is that you can customize your wedding to your taste, using the collections limits you to the colors and flowers, since they are standard. The Moon Palace works with Zuniga Productions which is a vendor that provides extras such as linen, runners, flowers, the whole nine. So you can pretty much have the wedding of your dreams! I also decided on the complimentary since I wasn't too big on the collections. Hope this helps.<\/p> <\/blockquote> <p> So happy to have found this thread, the moon palace and playacar palace resorts seem to be some of my top potential choices! Did any of you consider playacar as well? And if so, what made you go with the moon palace?<\/p> <p> \u00a0<\/p> <p> Our wedding group will be around 40 and mostly in their 30s or so (i.e. younger crown for post part; but hey age is just a number right lol!\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/>\u00a0<\/p> <p> \u00a0<\/p> <p> I've heard playa del carmen doesn't have\u00a0a huge night life, which is why I may lean more towards moon palace. Any thoughts guys? <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kpoirier@ualberta.ca","IpAddress":"142.179.209.110","GroupId":40,"GroupName":"Jr. Member","JoinDate":1365642436,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268428.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"MrsShoreytobe","Id":268428,"Name":"MrsShoreytobe","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71504,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4ebd8653018499e5174176f3507a83db","RawContent":"[quote]\nOriginally Posted by [b]Juliebeth[\/b] \/img\/forum\/go_quote.gif\n \n \n That is a good idea to visit before hand!!  Could you ask more details about the reception. I know the complimentary includes reception reservations for 30 guests...but I am curious to see if they charge per person or if that includes the food and all?!   That is the main concern I have left before finalizing my decision to have my wedding at the Moon Palace in June 2014.   \n \n How far are you with planning?![\/quote] \n Hi Juliebeth! \n \n I&#039;m not too sure regarding the complimentary package for the reception reservations. I know if you select a Collin Cowie Collection you can have as many guest as you want with no extra charge. The more people that attend the better it is for you because you can get the unlimited private functions which include the private reception, and cocktail hour, private welcome dinner, etc. I can ask for you once I talk to my wedding coordinator some time this week to confirm my site inspection. I&#039;m still debating if I should do the complimentary package or the Collin Cowie. So far, I have reserved the date which is the most important and first thing you should do. The acutal planning of the wedding selecting reception sites, cake, flowers, entertainment, etc. that process wont happen until 90 days prior to your wedding date. That is when you will be able to speak with the wedding coordinator that will assist you the day of your wedding. This kind of freaks me out because I like to plan ahead and make sure everything is perfect. However, I am confident that they will live up to their great reputation. Moon Palace conducts weddings all year round and they are great at what they do. My sister in laws cousin got married at the Moon Palace two years ago and they said the wedding was PERFECT! This is why I am not to worried. In the mean time there are a lot of DIY projects we can focus our time on. Hope this helps.","Attachments":[],"Id":1749758,"PostDate":1366732455,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>Juliebeth<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <p> That is a good idea to visit before hand!! \u00a0Could you ask more details about the reception. I know the complimentary includes reception reservations for 30 guests...but I am curious to see if they charge per person or if that includes the food and all?! \u00a0 That is the main concern I have left before finalizing my decision to have my wedding at the Moon Palace in June 2014. \u00a0<\/p> <p> \u00a0<\/p> <p> How far are you with planning?!<\/p> <\/blockquote> <p> Hi Juliebeth!<\/p> <p> \u00a0<\/p> <p> I'm not too sure regarding the complimentary package for the reception reservations. I know if you select a Collin Cowie Collection you can have as many guest as you want with no extra charge. The more people that attend the better it is for you because you can get the unlimited private functions which include the private reception, and cocktail hour, private welcome dinner, etc. I can ask for you once I talk to my wedding coordinator some time this week to confirm my site inspection. I'm still debating if I should do the complimentary package or the Collin Cowie. So far, I have reserved the date which is the most important and first thing you should do. The acutal planning of the wedding selecting reception sites, cake, flowers, entertainment, etc. that process wont happen until 90 days prior to your wedding date. That is when you will be able to speak with the wedding coordinator that will assist you the day of your wedding. This kind of freaks me out because I like to plan ahead and make sure everything is perfect. However, I am confident that they will live up to their great reputation. Moon Palace conducts weddings all year round and they are great at what they do. My sister in laws cousin got married at the Moon Palace two years ago and they said the wedding was PERFECT! This is why I am not to worried. In the mean time there are a lot of DIY projects we can focus our time on. Hope this helps.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"miriamliabarajas@ymail.com","IpAddress":"204.126.125.254","GroupId":39,"GroupName":"Newbie","JoinDate":1322686764,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-248207.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"LiaLoooves","Id":248207,"Name":"LiaLoooves","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71504,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c1171857b296d48e4e3c9197fa51e70e","RawContent":"[quote]\nOriginally Posted by [b]MrsShoreytobe[\/b] \/img\/forum\/go_quote.gif\n \n \n So happy to have found this thread, the moon palace and playacar palace resorts seem to be some of my top potential choices! Did any of you consider playacar as well? And if so, what made you go with the moon palace? \n \n Our wedding group will be around 40 and mostly in their 30s or so (i.e. younger crown for post part; but hey age is just a number right lol!  ;)  \n \n I&#039;ve heard playa del carmen doesn&#039;t have a huge night life, which is why I may lean more towards moon palace. Any thoughts guys? ;)[\/quote] \n Hi MrsShoreytobe! \n \n My sister in law went to her cousins wedding two years ago and the wedding was at Moon Palace she stayed at Playacar. I asked her the same question. She said its all about preference. Moon Palace is a HUGE resort and they have tons of activities to do, their rooms are also more modern and the resort its self is beautiful. The down fall according to her is that Moon Palace is too big and she prefers a smaller hotel. Playacar is located in Playa del Carmen and you can walk around and site see more of a little town feel. The hotel is much smaller and the rooms are not as great. So it depends on what it is your looking for. Also, keep in mind whether you stay at Moon Palace or Playacar you can visit all the palace resorts and eat at there restaurants for free since you have the All Inclusive. So you can potentially stay at Moon Palace or Playacar and visit the other resorts.","Attachments":[],"Id":1749762,"PostDate":1366733040,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>MrsShoreytobe<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <p> So happy to have found this thread, the moon palace and playacar palace resorts seem to be some of my top potential choices! Did any of you consider playacar as well? And if so, what made you go with the moon palace?<\/p> <p> \u00a0<\/p> <p> Our wedding group will be around 40 and mostly in their 30s or so (i.e. younger crown for post part; but hey age is just a number right lol!\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/>\u00a0<\/p> <p> \u00a0<\/p> <p> I've heard playa del carmen doesn't have\u00a0a huge night life, which is why I may lean more towards moon palace. Any thoughts guys? <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/><\/p> <\/blockquote> <p> Hi MrsShoreytobe!<\/p> <p> \u00a0<\/p> <p> My sister in law went to her cousins wedding two years ago and the wedding was at Moon Palace she stayed at Playacar. I asked her the same question. She said its all about preference. Moon Palace is a HUGE resort and they have tons of activities to do, their rooms are also more modern and the resort its self is beautiful. The down fall according to her is that Moon Palace is too big and she prefers a smaller hotel. Playacar is located in Playa del Carmen and you can walk around and site see more of a little town feel. The hotel is much smaller and the rooms are not as great. So it depends on what it is your looking for. Also, keep in mind whether you stay at Moon Palace or Playacar you can visit all the palace resorts and eat at there restaurants for free since you have the All Inclusive. So you can potentially stay at Moon Palace or Playacar and visit the other resorts.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"miriamliabarajas@ymail.com","IpAddress":"204.126.125.254","GroupId":39,"GroupName":"Newbie","JoinDate":1322686764,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-248207.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"LiaLoooves","Id":248207,"Name":"LiaLoooves","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71504,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e2f4293f50144e090357134279e99a3b","RawContent":"[quote name=\"LiaLoooves\"]\nHi Juliebeth! I&#039;m not too sure regarding the complimentary package for the reception reservations. I know if you select a Collin Cowie Collection you can have as many guest as you want with no extra charge. The more people that attend the better it is for you because you can get the unlimited private functions which include the private reception, and cocktail hour, private welcome dinner, etc. I can ask for you once I talk to my wedding coordinator some time this week to confirm my site inspection. I&#039;m still debating if I should do the complimentary package or the Collin Cowie. So far, I have reserved the date which is the most important and first thing you should do. The acutal planning of the wedding selecting reception sites, cake, flowers, entertainment, etc. that process wont happen until 90 days prior to your wedding date. That is when you will be able to speak with the wedding coordinator that will assist you the day of your wedding. This kind of freaks me out because I like to plan ahead and make sure everything is perfect. However, I am confident that they will live up to their great reputation. Moon Palace conducts weddings all year round and they are great at what they do. My sister in laws cousin got married at the Moon Palace two years ago and they said the wedding was PERFECT! This is why I am not to worried. In the mean time there are a lot of DIY projects we can focus our time on. Hope this helps.[\/quote] It does help! Thank you :). Yes I am sure it will be wonderful! It freaks me out as well because you don&#039;t know the final costs of the reception and what not 3 months prior...but if it was extremely high, I am sure others would be complaining versus saying how wonderful the wedding was! :). Good luck! And if you do hear any good feedback after this week, please post!","Attachments":[],"Id":1749780,"PostDate":1366735667,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <blockquote class='ipsBlockquote' data-author=\"LiaLoooves\" url=\"\/t\/83792\/moon&#045;palace&#045;2014#post_1897827\"><p>Hi Juliebeth! I'm not too sure regarding the complimentary package for the reception reservations. I know if you select a Collin Cowie Collection you can have as many guest as you want with no extra charge. The more people that attend the better it is for you because you can get the unlimited private functions which include the private reception, and cocktail hour, private welcome dinner, etc. I can ask for you once I talk to my wedding coordinator some time this week to confirm my site inspection. I'm still debating if I should do the complimentary package or the Collin Cowie. So far, I have reserved the date which is the most important and first thing you should do. The acutal planning of the wedding selecting reception sites, cake, flowers, entertainment, etc. that process wont happen until 90 days prior to your wedding date. That is when you will be able to speak with the wedding coordinator that will assist you the day of your wedding. This kind of freaks me out because I like to plan ahead and make sure everything is perfect. However, I am confident that they will live up to their great reputation. Moon Palace conducts weddings all year round and they are great at what they do. My sister in laws cousin got married at the Moon Palace two years ago and they said the wedding was PERFECT! This is why I am not to worried. In the mean time there are a lot of DIY projects we can focus our time on. Hope this helps.<\/p><\/blockquote> It does help! Thank you <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>. Yes I am sure it will be wonderful! It freaks me out as well because you don't know the final costs of the reception and what not 3 months prior...but if it was extremely high, I am sure others would be complaining versus saying how wonderful the wedding was! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>. Good luck! And if you do hear any good feedback after this week, please post!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"juliedrew2014@gmail.com","IpAddress":"76.123.8.194","GroupId":39,"GroupName":"Newbie","JoinDate":1366604745,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268836.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Juliebeth","Id":268836,"Name":"Juliebeth","IsOnline":false}}],"Id":"71504","Title":"Moon Palace- 2014","LastPostDate":1440308889},"Pages":{"TotalItems":1009,"TotalPages":101,"CurrentPage":20,"NextPage":30,"PreviousPage":10,"LastPage":1000},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
