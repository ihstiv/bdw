{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":5,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":294,"MovedTo":null,"MovedOn":0,"FirstPostId":1903747,"Rating":0,"RatingHits":0,"Starter":{"Id":284619,"Name":"CandanceWilliams2be","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284619.jpg?_r=1440956169","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"StartDate":1440961431,"LastPoster":{"Id":230711,"Name":"Moments That Matter","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1903782,"PostDate":1441046759,"PostContent":"Welcome to the forum Candice and Congrats on your upcoming dw in the DR. There is basically no ma...","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280214260,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.11.52.41","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79547,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"aed97c7b94c83957cf68a57dbe9a591e","RawContent":"&lt;p&gt;Hello Ladies,  &amp;nbsp;At first I &amp;nbsp;was stressed out until I found this sight..&lt;\/p&gt;\n&lt;p&gt;Yes  now&amp;nbsp;im very excited to plan!&lt;\/p&gt;\n&lt;p&gt;So I found the resort&amp;nbsp;( Lifestyle Holidays Vacation Resort)one check off my long list .&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;But I don&#039;t know a lot of information, and the page don&#039;t have enough info for me to tell my guest&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;Have anyone had a wedding in Puerto Plata here.&amp;nbsp; What info did you give your guest.&lt;\/p&gt;\n&lt;p&gt;I wonder will they&amp;nbsp;mail me some brochures.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I want to have a information party to give them all the important info&amp;nbsp; they would need if they want&amp;nbsp; to join us. I really don&#039;t know where to start&amp;nbsp; Help Please&lt;\/p&gt;","Attachments":[],"Id":1903747,"PostDate":1440961431,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello Ladies,\u00a0\u00a0\u00a0At first I \u00a0was stressed out until I found this sight..<\/p>\n<p>Yes\u00a0\u00a0now\u00a0im very excited to plan!<\/p>\n<p>So I found the resort\u00a0( Lifestyle Holidays Vacation Resort)one check off my long list .<\/p>\n<p>\u00a0But I don't know a lot of information, and the page don't have enough info for me to tell my guest<\/p>\n<p>\u00a0Have anyone had a wedding in Puerto Plata here.\u00a0 What info did you give your guest.<\/p>\n<p>I wonder will they\u00a0mail me some brochures.\u00a0<\/p>\n<p>I want to have a information party to give them all the important info\u00a0 they would need if they want\u00a0 to join us. I really don't know where to start\u00a0 Help Please<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"candance01@yahoo.com","IpAddress":"50.11.52.41","GroupId":39,"GroupName":"Newbie","JoinDate":1440952462,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284619.jpg?_r=1440956169","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"CandanceWilliams2be","Id":284619,"Name":"CandanceWilliams2be","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.113.222.142","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79547,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bc4fc57f62a9b9b35c7dc39e4f11ff3b","RawContent":"I am sure they would send you all the info you might need also check trip advisor they sometimes give info.","Attachments":[],"Id":1903751,"PostDate":1440976887,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I am sure they would send you all the info you might need also check trip advisor they sometimes give info. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lori.yepez@aa.com","IpAddress":"173.74.136.107","GroupId":39,"GroupName":"Newbie","JoinDate":1440298010,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"lorishultz2016","Id":284536,"Name":"lorishultz2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.146.146.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79547,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"042d52501ed58fe1c76247e8dfba16d3","RawContent":"Welcome\n\n\nMost people who do a DW have a travel agent who gives you all the info to give your guests. Price, dates, booking deadlines, etc. All travel can be handled thru them if they want to book in your group. If they don&#039;t want to book in your group just ensure they have all the info.  \n\n\nA lot of brides give out all this info within an invite or use a wedding website. Most are free and can even track your RSVPs if you want. Take a look at www.mywedding.com to get an idea. \n\n\nAt this point though it sounds like you could use a travel agent to price out your package and possibly get you resort perks and group rates.   I think you are in the states and the owners of this site are travel agents - wright travel - and they have a great review on here. \n\n\nAlso reach out to the wedding department at your resort to get their packages and prices to ensure this resort can offer you the wedding you desire in your budget. \n\n\nI hope I was on track with what you needed :) good luck\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1903753,"PostDate":1440978373,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Welcome<br><br>\nMost people who do a DW have a travel agent who gives you all the info to give your guests. Price, dates, booking deadlines, etc. All travel can be handled thru them if they want to book in your group. If they don't want to book in your group just ensure they have all the info.  <br><br>\nA lot of brides give out all this info within an invite or use a wedding website. Most are free and can even track your RSVPs if you want. Take a look at www.mywedding.com to get an idea. <br><br>\nAt this point though it sounds like you could use a travel agent to price out your package and possibly get you resort perks and group rates.   I think you are in the states and the owners of this site are travel agents - wright travel - and they have a great review on here. <br><br>\nAlso reach out to the wedding department at your resort to get their packages and prices to ensure this resort can offer you the wedding you desire in your budget. <br><br>\nI hope I was on track with what you needed <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> good luck<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399432202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.12.21","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79547,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8608db5e1a90862df4d3434ef7cf4d7b","RawContent":"&lt;p&gt;@[member=\"CandanceWilliams2be\"] Congrats and welcome!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;@[member=\"calgarybride2015\"] is right on target I think with her suggestions to you. And definitely Wright Travel are destination wedding specialists and worth looking at for assistance with your planning!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;There are quite a few DR brides (past and present) on the site so it would be worth doing some reading and searching through the site for information as well, just by typing into the search bar at the top.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck!&lt;\/p&gt;","Attachments":[],"Id":1903777,"PostDate":1441039713,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"284619\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/284619-candancewilliams2be\/' title='Member profile'><span itemprop=\"name\">CandanceWilliams2be<\/span><\/a> Congrats and welcome!<\/p>\n<p>\u00a0<\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"277873\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277873-calgarybride2015\/' title='Member profile'><span itemprop=\"name\">calgarybride2015<\/span><\/a> is right on target I think with her suggestions to you. And definitely Wright Travel are destination wedding specialists and worth looking at for assistance with your planning!<\/p>\n<p>\u00a0<\/p>\n<p>There are quite a few DR brides (past and present) on the site so it would be worth doing some reading and searching through the site for information as well, just by typing into the search bar at the top.<\/p>\n<p>\u00a0<\/p>\n<p>Good luck!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><em><span style=\"color:rgb(51,153,255);\">I'm lucky enough to say yes again....October 20, 2015\u00a0<\/span><\/em>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283462599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"177.237.80.72","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79547,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"73e4a51f2324be13ae068fb553441a61","RawContent":"&lt;p&gt;Welcome to the forum Candice and Congrats on your upcoming dw in the DR. There is basically no mail service there, so it&#039;s best to get info online or ask them to send you something via email.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Since you&#039;re starting your planning process early, you have time to check out a few options - well done :) Yes, this is a great place for wonderful info, advice and support from all the resources here, so you&#039;re right about relaxing into the planning process and enjoying it stress-free - very wise :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Wishing you happy research, and all the best with your plans - cheers!!! team mtm :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-mia1-1.xx.fbcdn.net\/hphotos-xpf1\/t31.0-8\/10494477_10152483125994487_4008060495709548840_o.jpg\" alt=\"10494477_10152483125994487_4008060495709\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-mia1-1.xx.fbcdn.net\/hphotos-ash2\/t31.0-8\/272254_10151099077434487_735766665_o.jpg\" alt=\"272254_10151099077434487_735766665_o.jpg\"&gt;&lt;\/p&gt;","Attachments":[],"Id":1903782,"PostDate":1441046759,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome to the forum Candice and Congrats on your upcoming dw in the DR. There is basically no mail service there, so it's best to get info online or ask them to send you something via email.<\/p>\n<p>\u00a0<\/p>\n<p>Since you're starting your planning process early, you have time to check out a few options - well done <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> Yes, this is a great place for wonderful info, advice and support from all the resources here, so you're right about relaxing into the planning process and enjoying it stress-free - very wise <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Wishing you happy research, and all the best with your plans - cheers!!! team mtm <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-mia1-1.xx.fbcdn.net\/hphotos-xpf1\/t31.0-8\/10494477_10152483125994487_4008060495709548840_o.jpg\" alt=\"10494477_10152483125994487_4008060495709\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-mia1-1.xx.fbcdn.net\/hphotos-ash2\/t31.0-8\/272254_10151099077434487_735766665_o.jpg\" alt=\"272254_10151099077434487_735766665_o.jpg\"><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280214260,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}}],"Id":"79547","Title":"Destination Wedding In 2017  In Dr","LastPostDate":1441046759},"Pages":{"TotalItems":5,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"P