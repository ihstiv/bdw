00\/height\/450\" \/&gt;&lt;img alt=\"Pergola v8.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762866\/width\/600\/height\/450\" \/&gt;&lt;img alt=\"Pergola v9.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762868\/width\/600\/height\/399\" \/&gt;&lt;img alt=\"Beach Ceremony Location v10.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762884\/width\/600\/height\/400\" \/&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;&lt;strong&gt;Beach Ceremony Photos&lt;\/strong&gt;:&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;&lt;img alt=\"Beach Ceremony Location v2.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762870\/width\/600\/height\/401\" \/&gt;&lt;img alt=\"Beach Ceremony Location v3.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762872\/width\/600\/height\/337\" \/&gt;&lt;img alt=\"Beach Ceremony Location v4.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762874\/width\/600\/height\/399\" \/&gt;&lt;img alt=\"Beach Ceremony Location v5.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762876\/width\/600\/height\/400\" \/&gt;&lt;img alt=\"Beach Ceremony Location v6.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762878\/width\/600\/height\/400\" \/&gt;&lt;img alt=\"Beach Ceremony Location v7.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762880\/width\/600\/height\/400\" \/&gt;&lt;img alt=\"Beach Ceremony Location v9.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762882\/width\/600\/height\/450\" \/&gt;&lt;img alt=\"Beach Ceremony Location v11.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762886\/width\/600\/height\/400\" \/&gt;&lt;img alt=\"Beach Ceremony Location.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762888\/width\/321\/height\/480\" \/&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;&lt;strong&gt;Fountain Wedding Ceremony Photos:&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;&lt;img alt=\"Fountain Wedding Location v1.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762890\/width\/600\/height\/398\" \/&gt;&lt;img alt=\"Fountain Wedding Location v2.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762892\/width\/600\/height\/398\" \/&gt;&lt;img alt=\"Fountain Wedding Location v3.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762894\/width\/600\/height\/355\" \/&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;&lt;strong&gt;Garden Wedding Ceremony Photos:&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;&lt;img alt=\"Garden Wedding Ceremony v1.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762896\/width\/600\/height\/448\" \/&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1595155,"PostDate":1331773780,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <span  style=\"font-size: 12px\">Wedding Locations<\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 12px\">The Pergola<\/span><\/p> <p> <span  style=\"font-size: 12px\">The Beach<\/span><\/p> <p> <span  style=\"font-size: 12px\">The Fountain<\/span><\/p> <p> <span  style=\"font-size: 12px\">The Garden<\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 12px\"><span rel='lightbox'><img class='bbc_img' alt=\"Now Jade Ceremony Locations.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762850\/width\/600\/height\/524\" \/><\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 12px\"><strong>Pergola Ceremony Photos:<\/strong><\/span><\/p> <p> <span  style=\"font-size: 12px\"><span rel='lightbox'><img class='bbc_img' alt=\"Pergola v1.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762852\/width\/600\/height\/450\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\"Pergola v2.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762854\/width\/600\/height\/450\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\"Pergola v3.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762856\/width\/600\/height\/450\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\"Pergola v4.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762858\/width\/600\/height\/400\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\"Pergola v5.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762860\/width\/600\/height\/450\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\"Pergola v6.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762862\/width\/600\/height\/450\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\"Pergola v7.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762864\/width\/600\/height\/450\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\"Pergola v8.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762866\/width\/600\/height\/450\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\"Pergola v9.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762868\/width\/600\/height\/399\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\"Beach Ceremony Location v10.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762884\/width\/600\/height\/400\" \/><\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 12px\"><strong>Beach Ceremony Photos<\/strong>:<\/span><\/p> <p> <span  style=\"font-size: 12px\"><span rel='lightbox'><img class='bbc_img' alt=\"Beach Ceremony Location v2.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762870\/width\/600\/height\/401\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\"Beach Ceremony Location v3.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762872\/width\/600\/height\/337\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\"Beach Ceremony Location v4.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762874\/width\/600\/height\/399\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\"Beach Ceremony Location v5.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762876\/width\/600\/height\/400\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\"Beach Ceremony Location v6.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762878\/width\/600\/height\/400\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\"Beach Ceremony Location v7.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762880\/width\/600\/height\/400\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\"Beach Ceremony Location v9.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762882\/width\/600\/height\/450\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\"Beach Ceremony Location v11.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762886\/width\/600\/height\/400\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\"Beach Ceremony Location.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762888\/width\/321\/height\/480\" \/><\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 12px\"><strong>Fountain Wedding Ceremony Photos:<\/strong><\/span><\/p> <p> <span  style=\"font-size: 12px\"><span rel='lightbox'><img class='bbc_img' alt=\"Fountain Wedding Location v1.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762890\/width\/600\/height\/398\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\"Fountain Wedding Location v2.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762892\/width\/600\/height\/398\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\"Fountain Wedding Location v3.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762894\/width\/600\/height\/355\" \/><\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 12px\"><strong>Garden Wedding Ceremony Photos:<\/strong><\/span><\/p> <p> <span  style=\"font-size: 12px\"><span rel='lightbox'><img class='bbc_img' alt=\"Garden Wedding Ceremony v1.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762896\/width\/600\/height\/448\" \/><\/span><\/span><\/p> <p> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"~Trisha~<br \/>\n<a class='bbc_url' href='http:\/\/www.faberphotography.com'>www.faberphotography.com<\/a><br \/>\n<br \/>\nMy latest destination wedding photos can be found <a class='bbc_url' href='http:\/\/faberphotography.com\/destination-wedding\/'>HERE<\/a>","Email":"tfaber@wbmi.com","IpAddress":"12.24.226.126","GroupId":46,"GroupName":"VIP Member","JoinDate":1172009700,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207201.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"Tlseege","Id":207201,"Name":"Tlseege","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":66415,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f2a1ad67c16393f17adda849a71a03f0","RawContent":"&lt;p&gt; &lt;strong&gt;&lt;span style=\"font-size: 12px\"&gt;PDF (note, most pictures are also down below, so if you don&#039;t have 150 posts yet and cannot open this document, don&#039;t worry too much)&lt;\/span&gt;&lt;\/strong&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;strong&gt;&lt;span style=\"font-size: 12px\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;span huddler_attributes=\"{&amp;quot;plugin&amp;quot;:&amp;quot;attachment&amp;quot;,&amp;quot;params&amp;quot;:{&amp;quot;id&amp;quot;:&amp;quot;13446&amp;quot;,&amp;quot;name&amp;quot;:&amp;quot;NOW JADE DINNER LOCATIONS.pdf&amp;quot;,&amp;quot;description&amp;quot;:&amp;quot;NOW Jade Dinner Location options&amp;quot;,&amp;quot;size&amp;quot;:&amp;quot;4,671&amp;quot;,&amp;quot;type&amp;quot;:&amp;quot;pdf&amp;quot;}}\" huddler_plugin=\"attachment\"&gt;&amp;nbsp;&lt;\/span&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;strong&gt;&lt;span style=\"font-size: 12px\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;strong&gt;&lt;span style=\"font-size: 12px\"&gt;Room Capacities:&lt;\/span&gt;&lt;\/strong&gt;&lt;\/p&gt; &lt;div id=\"yui_3_7_3_1_1362147324443_567\"&gt;  &lt;span style=\"font-size: 12px\"&gt;Pool Terrace ( maximum 40 guest)&lt;\/span&gt; &lt;div id=\"yui_3_7_3_1_1362147324443_566\"&gt; &lt;span style=\"font-size: 12px\"&gt;Ocean Front Deck (Carnival Terrace) ( maximum 60 guest)&lt;\/span&gt;&lt;\/div&gt; &lt;\/div&gt; &lt;div id=\"yui_3_7_3_1_1362147324443_565\"&gt; &lt;span style=\"font-size: 12px\"&gt;&lt;span id=\"yui_3_7_3_1_1362147324443_564\" style=\"line-height: 1.231\"&gt;Beach ( maximum 80 guest)&lt;\/span&gt;&lt;\/span&gt;&lt;\/div&gt; &lt;div id=\"yui_3_7_3_1_1362147324443_563\"&gt; &lt;span style=\"font-size: 12px\"&gt;Garden ( maximum 120 guest)&lt;\/span&gt;&lt;\/div&gt; &lt;div id=\"yui_3_7_3_1_1362147324443_558\"&gt; &lt;span style=\"font-size: 12px\"&gt;Bamboo Room ( Private Ocean View Room \u00e2\u20ac\u201c Maximum 80 guest)&lt;\/span&gt;&lt;\/div&gt; &lt;div id=\"yui_3_7_3_1_1362147324443_557\"&gt; &lt;span style=\"font-size: 12px\"&gt;Castaways Restaurant ( from 07:00pm-10:00pm Maximum 120 guest)&lt;\/span&gt;&lt;\/div&gt;  &amp;nbsp;  &lt;span style=\"font-size: 12px\"&gt;Here is a little map to show the locations of some of the wedding locations:&lt;\/span&gt;  &lt;p id=\"yui_3_7_3_1_1362407084567_1829\"&gt; &lt;span style=\"font-size: 12px\"&gt;&lt;img alt=\"LEAD Technologies Inc. V1.01&#10;\" data-id=\"191816\" data-type=\"61\" height=\"312\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/191816\/width\/350\/height\/700\" width=\"410\" \/&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt;   &amp;nbsp; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;strong&gt;&lt;span style=\"font-size: 12px\"&gt;Cocktail Hour Locations:&lt;\/span&gt;&lt;\/strong&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;The Mix Beach Bar\/Blue Bar&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;The Orange Room&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;&lt;img alt=\"NOW Jade Cocktail Party Options.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762734\/width\/600\/height\/481\" \/&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Here is another shot of the Blue Beach Bar&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;&lt;img alt=\"Blue Beach Bar v2.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762738\/width\/600\/height\/450\" \/&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;strong&gt;&lt;span style=\"font-size: 12px\"&gt;Reception Locations:&lt;\/span&gt;&lt;\/strong&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Las Olas\/Castaways&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Yellow Room\/Bamboo Room&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Festival Terrace\/Carnival Terrace&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Blue Beach Bar\/Mix Beach Bar&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Pool Deck&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Beach&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;strong&gt;Castaways Pictures:&lt;\/strong&gt;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"Castaways Reception v1.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762740\/width\/600\/height\/450\" \/&gt;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"Castaways Reception v2.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762742\/width\/397\/height\/600\" \/&gt;&lt;img alt=\"Castaways Reception v3.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762744\/width\/600\/height\/398\" \/&gt;&lt;img alt=\"Castaways Reception v4.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762746\/width\/600\/height\/398\" \/&gt;&lt;img alt=\"Castaways Reception v5.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762748\/width\/600\/height\/398\" \/&gt;&lt;img alt=\"Castaways Reception v6.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762750\/width\/600\/height\/398\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;strong&gt;Bamboo Room Reception Photos:&lt;\/strong&gt;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"Bamboo Room Reception v2.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762754\/width\/600\/height\/450\" \/&gt;&lt;img alt=\"Bamboo Room Reception Table v2.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762756\/width\/600\/height\/450\" \/&gt;&lt;img alt=\"Bamboo Room Reception Table.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762760\/width\/600\/height\/450\" \/&gt;&lt;img alt=\"Bamboo Room Reception v3.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762762\/width\/600\/height\/316\" \/&gt;&lt;img alt=\"Bamboo Room Reception v4.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762764\/width\/600\/height\/402\" \/&gt;&lt;img alt=\"Bamboo Room Reception v5.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762768\/width\/600\/height\/450\" \/&gt;&lt;img alt=\"Bamboo Room Dessert Table.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762770\/width\/600\/height\/376\" \/&gt;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"Yellow Room v2.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762774\/width\/600\/height\/450\" \/&gt;&lt;img alt=\"Yellow Room.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762776\/width\/600\/height\/450\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;strong&gt;Festival\/Carnival Terrace Reception Photos&lt;\/strong&gt;:&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"Festival Terrace.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762778\/width\/600\/height\/450\" \/&gt;&lt;img alt=\"Festival Terrace from beach.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762780\/width\/600\/height\/450\" \/&gt;&lt;img alt=\"Festival Terrace Reception v1.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762782\/width\/600\/height\/398\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;strong&gt;Outdoor Reception Photos:&lt;\/strong&gt;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"Outdoor Lawn Reception.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762784\/width\/310\/height\/463\" \/&gt;&lt;img alt=\"Outdoor Reception v2.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762788\/width\/600\/height\/399\" \/&gt;&lt;img alt=\"Outdoor Reception.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762790\/width\/600\/height\/399\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;All receptions are three hours long.&amp;nbsp; The extra hour cost depends on number of guests, however for 75 people it is approximately $1200.&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;If you\u00e2\u20ac\u2122d like a private bar AT your reception location it is a $350 one time setup fee. (FYI, most brides have said this is not worth it.&amp;nbsp; You&#039;ll have more than enough servers at your event to keep your guests happy)&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;If you have over 50 people, you can have a buffet.&amp;nbsp; &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.bestdestinationwedding.com\/t\/57821\/the-now-riviera-cancun\/370#post_1413517\"&gt;THIS&lt;\/a&gt; post lists the buffet options. &lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;The reception areas are either round tables that seat 6-10 or rectangle tables that seat up to 40 people.&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;There are divine and eternity dinner options (4 entree choices in total) and your guests can choose their entree in advance for free, or on the spot for an extra $30 per person, or you can choose for them for free.&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Children\u00e2\u20ac\u2122s menus are available for $20-25&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;The kid menu: fruit cocktail, cheese burger, chicken fingers, spaghetti, and ice cream.&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;The Vegetarian option is the same price as the other meals.&amp;nbsp; Here is the menu:&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Vegetarian Menu&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Salads:&lt;\/span&gt;&lt;\/p&gt; &lt;ul&gt; &lt;li&gt; &lt;span style=\"font-size: 12px\"&gt;Arugula salad companied with pear layers, lime vinaigrette and extra virgin olive oil&lt;\/span&gt;&lt;\/li&gt; &lt;li&gt; &lt;span style=\"font-size: 12px\"&gt;Toscana salad, mixed lettuce, tomato, mushrooms, asparagus, endives, Californian peaches and artichokes with sun dry tomato vinaigrette&lt;\/span&gt;&lt;\/li&gt; &lt;\/ul&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Soup:&lt;\/span&gt;&lt;\/p&gt; &lt;ul&gt; &lt;li&gt; &lt;span style=\"font-size: 12px\"&gt;Minestrone soup and spinach&lt;\/span&gt;&lt;\/li&gt; &lt;\/ul&gt; &lt;p style=\"margin-left: 2.25pt\"&gt; &lt;span style=\"font-size: 12px\"&gt;Main Course:&lt;\/span&gt;&lt;\/p&gt; &lt;ul&gt; &lt;li&gt; &lt;span style=\"font-size: 12px\"&gt;Pasta Penne in a tomato and basil sauce with vegetables&lt;\/span&gt;&lt;\/li&gt; &lt;li&gt; &lt;span style=\"font-size: 12px\"&gt;Vegetable lasagna&lt;\/span&gt;&lt;\/li&gt; &lt;\/ul&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Desserts:&lt;\/span&gt;&lt;\/p&gt; &lt;ul&gt; &lt;li&gt; &lt;span style=\"font-size: 12px\"&gt;Cottage cheese foam and strawberries&lt;\/span&gt;&lt;\/li&gt; &lt;\/ul&gt;","Attachments":[],"Id":1595156,"PostDate":1331773783,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <strong><span  style=\"font-size: 12px\">PDF (note, most pictures are also down below, so if you don't have 150 posts yet and cannot open this document, don't worry too much)<\/span><\/strong><\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> <strong><span  style=\"font-size: 12px\">\u00a0<\/span><\/strong><\/p> <p> \u00a0<\/p> <span huddler_attributes=\"{\"plugin\":\"attachment\",\"params\":{\"id\":\"13446\",\"name\":\"NOW JADE DINNER LOCATIONS.pdf\",\"description\":\"NOW Jade Dinner Location options\",\"size\":\"4,671\",\"type\":\"pdf\"}}\" huddler_plugin=\"attachment\">\u00a0<\/span> <p> \u00a0<\/p> <p> <strong><span  style=\"font-size: 12px\">\u00a0<\/span><\/strong><\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> <strong><span  style=\"font-size: 12px\">Room Capacities:<\/span><\/strong><\/p> <div id=\"yui_3_7_3_1_1362147324443_567\">  <span  style=\"font-size: 12px\">Pool Terrace ( maximum 40 guest)<\/span> <div id=\"yui_3_7_3_1_1362147324443_566\"> <span  style=\"font-size: 12px\">Ocean Front Deck (Carnival Terrace) ( maximum 60 guest)<\/span><\/div> <\/div> <div id=\"yui_3_7_3_1_1362147324443_565\"> <span  style=\"font-size: 12px\"><spanid=\"yui_3_7_3_1_1362147324443_564\" >Beach ( maximum 80 guest)<\/span><\/span><\/div> <div id=\"yui_3_7_3_1_1362147324443_563\"> <span  style=\"font-size: 12px\">Garden ( maximum 120 guest)<\/span><\/div> <div id=\"yui_3_7_3_1_1362147324443_558\"> <span  style=\"font-size: 12px\">Bamboo Room ( Private Ocean View Room \u00e2\u20ac\u201c Maximum 80 guest)<\/span><\/div> <div id=\"yui_3_7_3_1_1362147324443_557\"> <span  style=\"font-size: 12px\">Castaways Restaurant ( from 07:00pm-10:00pm Maximum 120 guest)<\/span><\/div>  \u00a0  <span  style=\"font-size: 12px\">Here is a little map to show the locations of some of the wedding locations:<\/span>  <p id=\"yui_3_7_3_1_1362407084567_1829\"> <span  style=\"font-size: 12px\"><span rel='lightbox'><img class='bbc_img' alt=\"LEAD Technologies Inc. V1.01&#10;\" data-id=\"191816\" data-type=\"61\" height=\"312\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/191816\/width\/350\/height\/700\" width=\"410\" \/><\/span><\/span><\/p> <p> \u00a0<\/p>   \u00a0 <p> \u00a0<\/p> <p> <strong><span  style=\"font-size: 12px\">Cocktail Hour Locations:<\/span><\/strong><\/p> <p> <span  style=\"font-size: 12px\">The Mix Beach Bar\/Blue Bar<\/span><\/p> <p> <span  style=\"font-size: 12px\">The Orange Room<\/span><\/p> <p> <span  style=\"font-size: 12px\"><span rel='lightbox'><img class='bbc_img' alt=\"NOW Jade Cocktail Party Options.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762734\/width\/600\/height\/481\" \/><\/span><\/span><\/p> <p> <span  style=\"font-size: 12px\">Here is another shot of the Blue Beach Bar<\/span><\/p> <p> <span  style=\"font-size: 12px\"><span rel='lightbox'><img class='bbc_img' alt=\"Blue Beach Bar v2.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762738\/width\/600\/height\/450\" \/><\/span><\/span><\/p> <p> \u00a0<\/p> <p> <strong><span  style=\"font-size: 12px\">Reception Locations:<\/span><\/strong><\/p> <p> <span  style=\"font-size: 12px\">Las Olas\/Castaways<\/span><\/p> <p> <span  style=\"font-size: 12px\">Yellow Room\/Bamboo Room<\/span><\/p> <p> <span  style=\"font-size: 12px\">Festival Terrace\/Carnival Terrace<\/span><\/p> <p> <span  style=\"font-size: 12px\">Blue Beach Bar\/Mix Beach Bar<\/span><\/p> <p> <span  style=\"font-size: 12px\">Pool Deck<\/span><\/p> <p> <span  style=\"font-size: 12px\">Beach<\/span><\/p> <p> \u00a0<\/p> <p> <strong>Castaways Pictures:<\/strong><\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"Castaways Reception v1.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762740\/width\/600\/height\/450\" \/><\/span><\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"Castaways Reception v2.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762742\/width\/397\/height\/600\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\"Castaways Reception v3.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762744\/width\/600\/height\/398\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\"Castaways Reception v4.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762746\/width\/600\/height\/398\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\"Castaways Reception v5.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762748\/width\/600\/height\/398\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\"Castaways Reception v6.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762750\/width\/600\/height\/398\" \/><\/span><\/p> <p> \u00a0<\/p> <p> <strong>Bamboo Room Reception Photos:<\/strong><\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"Bamboo Room Reception v2.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762754\/width\/600\/height\/450\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\"Bamboo Room Reception Table v2.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762756\/width\/600\/height\/450\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\"Bamboo Room Reception Table.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762760\/width\/600\/height\/450\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\"Bamboo Room Reception v3.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762762\/width\/600\/height\/316\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\"Bamboo Room Reception v4.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762764\/width\/600\/height\/402\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\"Bamboo Room Reception v5.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762768\/width\/600\/height\/450\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\"Bamboo Room Dessert Table.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762770\/width\/600\/height\/376\" \/><\/span><\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"Yellow Room v2.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762774\/width\/600\/height\/450\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\"Yellow Room.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762776\/width\/600\/height\/450\" \/><\/span><\/p> <p> \u00a0<\/p> <p> <strong>Festival\/Carnival Terrace Reception Photos<\/strong>:<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"Festival Terrace.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762778\/width\/600\/height\/450\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\"Festival Terrace from beach.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762780\/width\/600\/height\/450\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\"Festival Terrace Reception v1.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762782\/width\/600\/height\/398\" \/><\/span><\/p> <p> \u00a0<\/p> <p> <strong>Outdoor Reception Photos:<\/strong><\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"Outdoor Lawn Reception.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762784\/width\/310\/height\/463\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\"Outdoor Reception v2.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762788\/width\/600\/height\/399\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\"Outdoor Reception.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762790\/width\/600\/height\/399\" \/><\/span><\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 12px\">All receptions are three hours long.\u00a0 The extra hour cost depends on number of guests, however for 75 people it is approximately $1200.<\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 12px\">If you\u00e2\u20ac\u2122d like a private bar AT your reception location it is a $350 one time setup fee. (FYI, most brides have said this is not worth it.\u00a0 You'll have more than enough servers at your event to keep your guests happy)<\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 12px\">If you have over 50 people, you can have a buffet.\u00a0 <a href='http:\/\/www.bestdestinationwedding.com\/t\/57821\/the-now-riviera-cancun\/370#post_1413517' class='bbc_url' title=''>THIS<\/a> post lists the buffet options. <\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 12px\">The reception areas are either round tables that seat 6-10 or rectangle tables that seat up to 40 people.<\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 12px\">There are divine and eternity dinner options (4 entree choices in total) and your guests can choose their entree in advance for free, or on the spot for an extra $30 per person, or you can choose for them for free.<\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 12px\">Children\u00e2\u20ac\u2122s menus are available for $20-25<\/span><\/p> <p> <span  style=\"font-size: 12px\">The kid menu: fruit cocktail, cheese burger, chicken fingers, spaghetti, and ice cream.<\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 12px\">The Vegetarian option is the same price as the other meals.\u00a0 Here is the menu:<\/span><\/p> <p> <span  style=\"font-size: 12px\">Vegetarian Menu<\/span><\/p> <p> <span  style=\"font-size: 12px\">Salads:<\/span><\/p> <ul> <li> <span  style=\"font-size: 12px\">Arugula salad companied with pear layers, lime vinaigrette and extra virgin olive oil<\/span><\/li> <li> <span  style=\"font-size: 12px\">Toscana salad, mixed lettuce, tomato, mushrooms, asparagus, endives, Californian peaches and artichokes with sun dry tomato vinaigrette<\/span><\/li> <\/ul> <p> <span  style=\"font-size: 12px\">Soup:<\/span><\/p> <ul> <li> <span  style=\"font-size: 12px\">Minestrone soup and spinach<\/span><\/li> <\/ul> <p  style=\"margin-left: 2.25pt\"> <span  style=\"font-size: 12px\">Main Course:<\/span><\/p> <ul> <li> <span  style=\"font-size: 12px\">Pasta Penne in a tomato and basil sauce with vegetables<\/span><\/li> <li> <span  style=\"font-size: 12px\">Vegetable lasagna<\/span><\/li> <\/ul> <p> <span  style=\"font-size: 12px\">Desserts:<\/span><\/p> <ul> <li> <span  style=\"font-size: 12px\">Cottage cheese foam and strawberries<\/span><\/li> <\/ul>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"~Trisha~<br \/>\n<a class='bbc_url' href='http:\/\/www.faberphotography.com'>www.faberphotography.com<\/a><br \/>\n<br \/>\nMy latest destination wedding photos can be found <a class='bbc_url' href='http:\/\/faberphotography.com\/destination-wedding\/'>HERE<\/a>","Email":"tfaber@wbmi.com","IpAddress":"12.24.226.126","GroupId":46,"GroupName":"VIP Member","JoinDate":1172009700,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207201.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"Tlseege","Id":207201,"Name":"Tlseege","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":66415,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3581572cbb38dab4a9d6f8045ca23799","RawContent":"&lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;DJ&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;The resort uses a few different DJ\u00e2\u20ac\u2122s.&amp;nbsp; AV Solutions, DJ Dorremix, and Luis De Alba&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Alex Martinez&lt;\/span&gt; - AV Solutions&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;&lt;span style=\"color: blue\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;img alt=\"Mariachi Band.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762937\/width\/600\/height\/450\" \/&gt;&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1595157,"PostDate":1331773786,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <span  style=\"font-size: 12px\">DJ<\/span><\/p> <p> <span  style=\"font-size: 12px\">The resort uses a few different DJ\u00e2\u20ac\u2122s.\u00a0 AV Solutions, DJ Dorremix, and Luis De Alba<\/span><\/p> <p> <span  style=\"font-size: 12px\">\u00a0<\/span><\/p> <p> <span  style=\"font-size: 12px\"><span  style=\"font-family: arial, sans-serif\">Alex Martinez<\/span> - AV Solutions<\/span><\/p> <p> <span  style=\"font-size: 12px\"><span  style=\"color: blue\"><span  style=\"font-family: arial, sans-serif\"><span rel='lightbox'><img class='bbc_img' alt=\"Mariachi Band.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762937\/width\/600\/height\/450\" \/><\/span><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"~Trisha~<br \/>\n<a class='bbc_url' href='http:\/\/www.faberphotography.com'>www.faberphotography.com<\/a><br \/>\n<br \/>\nMy latest destination wedding photos can be found <a class='bbc_url' href='http:\/\/faberphotography.com\/destination-wedding\/'>HERE<\/a>","Email":"tfaber@wbmi.com","IpAddress":"12.24.226.126","GroupId":46,"GroupName":"VIP Member","JoinDate":1172009700,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207201.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"Tlseege","Id":207201,"Name":"Tlseege","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":66415,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4946a30cbeeeb387039480c6c54ac7ba","RawContent":"&lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Cake&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;&lt;strong&gt;Eternity Cakes (included in the Eternity Package)&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;ul&gt; &lt;li&gt; &lt;span style=\"font-size: 12px\"&gt;Serves up to 25 people&lt;\/span&gt;&lt;\/li&gt; &lt;li&gt; &lt;span style=\"font-size: 12px\"&gt;$7 per additional person&lt;\/span&gt;&lt;\/li&gt; &lt;\/ul&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Flavors:&lt;\/span&gt;&lt;\/p&gt; &lt;ul&gt; &lt;li&gt; &lt;span style=\"font-size: 12px\"&gt;White Cream Cake: A silky smooth cake made with rich cream for a moist, tender finish. Great with our classic butter cream or a fruit filling.&lt;\/span&gt;&lt;\/li&gt; &lt;li&gt; &lt;span style=\"font-size: 12px\"&gt;Golden Yellow Cake: Delicate, tender cake with a hint of pure vanilla. Excellent with a fruit filling or loaded with a dark fudge filling.&lt;\/span&gt;&lt;\/li&gt; &lt;li&gt; &lt;span style=\"font-size: 12px\"&gt;Chocolate Fudge Cake: Rich, deep dark chocolate cake made with pure dark chocolate. Generously covered with butter cream and filled with chocolate fudge.&lt;\/span&gt;&lt;\/li&gt; &lt;li&gt; &lt;span style=\"font-size: 12px\"&gt;Chocolate Kahlua Symphony: An unforgettable combination of rich chocolate layers and coffee liqueur. Excellent with a mocha filling.&lt;\/span&gt;&lt;\/li&gt; &lt;\/ul&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;&lt;img alt=\"Eternity Cake Options.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762922\/width\/600\/height\/508\" \/&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;&lt;strong&gt;Divine Cakes (included in the Devine Package)&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;ul&gt; &lt;li&gt; &lt;span style=\"font-size: 12px\"&gt;Serves up to 20 people&lt;\/span&gt;&lt;\/li&gt; &lt;li&gt; &lt;span style=\"font-size: 12px\"&gt;$8 per additional person&lt;\/span&gt;&lt;\/li&gt; &lt;\/ul&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Flavors:&amp;nbsp; You select the cake flavor and then select the filing to go inside it&lt;\/span&gt;&lt;\/p&gt; &lt;ul&gt; &lt;li&gt; &lt;span style=\"font-size: 12px\"&gt;Marble Fudge Cake: A moist marriage of white cake with dark chocolate to create rivers of fudge, all wrapped up in our elegant butter cream.&lt;\/span&gt;&lt;\/li&gt; &lt;li&gt; &lt;span style=\"font-size: 12px\"&gt;Almond Delight Cake: White moist layers with a delicate, fresh roasted, ground almond filling. A truly elegant cake for an elegant occasion.&lt;\/span&gt;&lt;\/li&gt; &lt;li&gt; &lt;span style=\"font-size: 12px\"&gt;Lemon Twist Mellow: A hint of lemon and a divine creamy lemon filling. Wonderful with a raspberry filling.&lt;\/span&gt;&lt;\/li&gt; &lt;li&gt; &lt;span style=\"font-size: 12px\"&gt;Bella Matrimoniale Classic: Three moist layers of white cake with two fillings, almond and raspberry. Your Guests will say \u00e2\u20ac\u0153Wow\u00e2\u20ac\u009d and ask for seconds.&lt;\/span&gt;&lt;\/li&gt; &lt;li&gt; &lt;span style=\"font-size: 12px\"&gt;Cheese Cake Showstopper: Creamy New York cheesecake baked to perfection and frosted with our special butter cream or whipped cream.&lt;\/span&gt;&lt;\/li&gt; &lt;li&gt; &lt;span style=\"font-size: 12px\"&gt;Chocolate Passion Black Tie: Cake made with the finest imported dark chocolate filled with variety of berries.&lt;\/span&gt;&lt;\/li&gt; &lt;\/ul&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Fillings: Vanilla, Chocolate, Raspberry, Strawberry, Fresh Sliced Strawberries, Peaches, Pineapples Roasted Almond&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;&lt;img alt=\"Divine Cake Options.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762924\/width\/600\/height\/514\" \/&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Here are some BDW Bride&#039;s Cake Photos:&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;&lt;img alt=\"Wedding Cake v2.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762926\/width\/600\/height\/450\" \/&gt;&lt;img alt=\"Wedding Cake v3.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762928\/width\/340\/height\/510\" \/&gt;&lt;img alt=\"Wedding Cake.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762930\/width\/600\/height\/450\" \/&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1595158,"PostDate":1331773790,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <span  style=\"font-size: 12px\">Cake<\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 12px\"><strong>Eternity Cakes (included in the Eternity Package)<\/strong><\/span><\/p> <ul> <li> <span  style=\"font-size: 12px\">Serves up to 25 people<\/span><\/li> <li> <span  style=\"font-size: 12px\">$7 per additional person<\/span><\/li> <\/ul> <p> <span  style=\"font-size: 12px\">Flavors:<\/span><\/p> <ul> <li> <span  style=\"font-size: 12px\">White Cream Cake: A silky smooth cake made with rich cream for a moist, tender finish. Great with our classic butter cream or a fruit filling.<\/span><\/li> <li> <span  style=\"font-size: 12px\">Golden Yellow Cake: Delicate, tender cake with a hint of pure vanilla. Excellent with a fruit filling or loaded with a dark fudge filling.<\/span><\/li> <li> <span  style=\"font-size: 12px\">Chocolate Fudge Cake: Rich, deep dark chocolate cake made with pure dark chocolate. Generously covered with butter cream and filled with chocolate fudge.<\/span><\/li> <li> <span  style=\"font-size: 12px\">Chocolate Kahlua Symphony: An unforgettable combination of rich chocolate layers and coffee liqueur. Excellent with a mocha filling.<\/span><\/li> <\/ul> <p> \u00a0<\/p> <p> <span  style=\"font-size: 12px\"><span rel='lightbox'><img class='bbc_img' alt=\"Eternity Cake Options.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762922\/width\/600\/height\/508\" \/><\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 12px\"><strong>Divine Cakes (included in the Devine Package)<\/strong><\/span><\/p> <ul> <li> <span  style=\"font-size: 12px\">Serves up to 20 people<\/span><\/li> <li> <span  style=\"font-size: 12px\">$8 per additional person<\/span><\/li> <\/ul> <p> \u00a0<\/p> <p> <span  style=\"font-size: 12px\">Flavors:\u00a0 You select the cake flavor and then select the filing to go inside it<\/span><\/p> <ul> <li> <span  style=\"font-size: 12px\">Marble Fudge Cake: A moist marriage of white cake with dark chocolate to create rivers of fudge, all wrapped up in our elegant butter cream.<\/span><\/li> <li> <span  style=\"font-size: 12px\">Almond Delight Cake: White moist layers with a delicate, fresh roasted, ground almond filling. A truly elegant cake for an elegant occasion.<\/span><\/li> <li> <span  style=\"font-size: 12px\">Lemon Twist Mellow: A hint of lemon and a divine creamy lemon filling. Wonderful with a raspberry filling.<\/span><\/li> <li> <span  style=\"font-size: 12px\">Bella Matrimoniale Classic: Three moist layers of white cake with two fillings, almond and raspberry. Your Guests will say \u00e2\u20ac\u0153Wow\u00e2\u20ac\u009d and ask for seconds.<\/span><\/li> <li> <span  style=\"font-size: 12px\">Cheese Cake Showstopper: Creamy New York cheesecake baked to perfection and frosted with our special butter cream or whipped cream.<\/span><\/li> <li> <span  style=\"font-size: 12px\">Chocolate Passion Black Tie: Cake made with the finest imported dark chocolate filled with variety of berries.<\/span><\/li> <\/ul> <p> \u00a0<\/p> <p> <span  style=\"font-size: 12px\">Fillings: Vanilla, Chocolate, Raspberry, Strawberry, Fresh Sliced Strawberries, Peaches, Pineapples Roasted Almond<\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 12px\"><span rel='lightbox'><img class='bbc_img' alt=\"Divine Cake Options.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762924\/width\/600\/height\/514\" \/><\/span><\/span><\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 12px\">Here are some BDW Bride's Cake Photos:<\/span><\/p> <p> <span  style=\"font-size: 12px\"><span rel='lightbox'><img class='bbc_img' alt=\"Wedding Cake v2.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762926\/width\/600\/height\/450\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\"Wedding Cake v3.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762928\/width\/340\/height\/510\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\"Wedding Cake.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762930\/width\/600\/height\/450\" \/><\/span><\/span><\/p> <p> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"~Trisha~<br \/>\n<a class='bbc_url' href='http:\/\/www.faberphotography.com'>www.faberphotography.com<\/a><br \/>\n<br \/>\nMy latest destination wedding photos can be found <a class='bbc_url' href='http:\/\/faberphotography.com\/destination-wedding\/'>HERE<\/a>","Email":"tfaber@wbmi.com","IpAddress":"12.24.226.126","GroupId":46,"GroupName":"VIP Member","JoinDate":1172009700,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207201.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"Tlseege","Id":207201,"Name":"Tlseege","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":66415,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9b4a00727e8747e56e44dbf593ce81a8","RawContent":"&lt;p&gt; &lt;strong&gt;&lt;span style=\"font-size: 12px\"&gt;Details - &lt;\/span&gt;&lt;\/strong&gt;&lt;span style=\"font-size: 12px\"&gt;if you uncover some other random expenses or options, please PM or email me!&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;The wedding canopy is 2 meters per side (approximately 6 ft x 6 ft)&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Walkway can be red or white to Pergola&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;3 foot long sparklers $5 per sparkler.&amp;nbsp; Small metal ones $3\/6&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Projector for slideshow $300&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Welcome bag distribution $2-3 a bag&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;$40 for dress cleaning (after TTD session!)&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;20 minutes from Playa Del Carmen, 15 minutes from Cancun&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Daily van from the resort takes you into town for $1 a person&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Chair bows $5 each, if you bring your own there is a $1 iron fee&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;White tiffany chairs $9&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Brown tiffany chairs $7&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Fire dancers $1,000 a performance&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Excursion contact alex.orozco@yourcancundmc.com , her name is Alejandra&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Day Pass $55 per persona&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1595159,"PostDate":1331773794,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <strong><span  style=\"font-size: 12px\">Details - <\/span><\/strong><span  style=\"font-size: 12px\">if you uncover some other random expenses or options, please PM or email me!<\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 12px\">The wedding canopy is 2 meters per side (approximately 6 ft x 6 ft)<\/span><\/p> <p> <span  style=\"font-size: 12px\">Walkway can be red or white to Pergola<\/span><\/p> <p> <span  style=\"font-size: 12px\">3 foot long sparklers $5 per sparkler.\u00a0 Small metal ones $3\/6<\/span><\/p> <p> <span  style=\"font-size: 12px\">Projector for slideshow $300<\/span><\/p> <p> <span  style=\"font-size: 12px\">Welcome bag distribution $2-3 a bag<\/span><\/p> <p> <span  style=\"font-size: 12px\">$40 for dress cleaning (after TTD session!)<\/span><\/p> <p> <span  style=\"font-size: 12px\">20 minutes from Playa Del Carmen, 15 minutes from Cancun<\/span><\/p> <p> <span  style=\"font-size: 12px\">Daily van from the resort takes you into town for $1 a person<\/span><\/p> <p> <span  style=\"font-size: 12px\">Chair bows $5 each, if you bring your own there is a $1 iron fee<\/span><\/p> <p> <span  style=\"font-size: 12px\">White tiffany chairs $9<\/span><\/p> <p> <span  style=\"font-size: 12px\">Brown tiffany chairs $7<\/span><\/p> <p> <span  style=\"font-size: 12px\">Fire dancers $1,000 a performance<\/span><\/p> <p> <span  style=\"font-size: 12px\">Excursion contact alex.orozco@yourcancundmc.com , her name is Alejandra<\/span><\/p> <p> <span  style=\"font-size: 12px\">Day Pass $55 per persona<\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"~Trisha~<br \/>\n<a class='bbc_url' href='http:\/\/www.faberphotography.com'>www.faberphotography.com<\/a><br \/>\n<br \/>\nMy latest destination wedding photos can be found <a class='bbc_url' href='http:\/\/faberphotography.com\/destination-wedding\/'>HERE<\/a>","Email":"tfaber@wbmi.com","IpAddress":"12.24.226.126","GroupId":46,"GroupName":"VIP Member","JoinDate":1172009700,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207201.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"Tlseege","Id":207201,"Name":"Tlseege","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":66415,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,