vewright.netdna-cdn.com\/cdn\/profile\/photo-241100.jpg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"aquamaniac","Id":241100,"Name":"aquamaniac","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":63282,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a5891ebbb77b3f581f4d208fb4142e54","RawContent":"&lt;p&gt; Thanks for all the info -&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; just wanted to clarify one point... My WC and TA haven&#039;t said anything about needing my birth certificate translated... are you sure that is a requirement still for Canadian brides?&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; ALso.... I get married in exactly 3 months today! --- December 8, 2011!!!!&lt;\/p&gt;","Attachments":[],"Id":1517026,"PostDate":1315526225,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Thanks for all the info -<\/p> <p> \u00a0<\/p> <p> just wanted to clarify one point... My WC and TA haven't said anything about needing my birth certificate translated... are you sure that is a requirement still for Canadian brides?<\/p> <p> \u00a0<\/p> <p> ALso.... I get married in exactly 3 months today! --- December 8, 2011!!!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nagem17@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1302806658,"Ph