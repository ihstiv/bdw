{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":35,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":50533,"MovedTo":null,"MovedOn":0,"FirstPostId":1192507,"Rating":0,"RatingHits":0,"Starter":{"Id":228160,"Name":"Ginger1961","Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-228160.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"StartDate":1277232836,"LastPoster":{"Id":285538,"Name":"Almccullar","Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":89,"Preview":{"Id":1908157,"PostDate":1449461771,"PostContent":"My fianc\u00e9 & I are interested in possibly doing our wedding moon at one of the Jamaica Sandals wit...","Author":{"Signature":"","Email":"almccullar88@yahoo.com","IpAddress":"107.77.94.87","GroupId":39,"GroupName":"Newbie","JoinDate":1449461399,"Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Almccullar","Id":285538,"Name":"Almccullar","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":false,"TopicId":53458,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"eefd44aabcb6e48cd30347379bf15a5f","RawContent":"Can someone please clarify for me the cost of a the Sandals wedding packages? I&#039;ve been reading the website but can&#039;t seem to figure out. I&#039;m only staying 4 nights so I know I don&#039;t qualify for a free wedding but I think it&#039;s 500 dollars in fees for the same Beatiful Beginnings package. However, and this is where I get confused, it seems it&#039;s geared towards Bride and Groom and two guests. What if you have Bride and Groom and 6 people? How does it work? Do they charge you a fee for each person over the 4 people in the package? How much is it for the Group Weddings? I sent Sandals an email last week. They emailed me back with no information but told me to call them. No thanks. Don&#039;t want to have the pressured sales pitch before I even decide what i want. I also don&#039;t want them confusing me and encouraging me to purchase a package if I don&#039;t need one. Help me please!\n \n Thanks a bunch ladies.","Attachments":[],"Id":1192507,"PostDate":1277232836,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Can someone please clarify for me the cost of a the Sandals wedding packages? I've been reading the website but can't seem to figure out. I'm only staying 4 nights so I know I don't qualify for a free wedding but I think it's 500 dollars in fees for the same Beatiful Beginnings package. However, and this is where I get confused, it seems it's geared towards Bride and Groom and two guests. What if you have Bride and Groom and 6 people? How does it work? Do they charge you a fee for each person over the 4 people in the package? How much is it for the Group Weddings? I sent Sandals an email last week. They emailed me back with no information but told me to call them. No thanks. Don't want to have the pressured sales pitch before I even decide what i want. I also don't want them confusing me and encouraging me to purchase a package if I don't need one. Help me please!<br \/> <br \/> Thanks a bunch ladies.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>\"<\/span><em><strong>He's my Lobster<\/strong><\/em><span>\"<\/span><\/div><\/div>","Email":"wendy.somerton@ecbc.ca","IpAddress":"","GroupId":5,"GroupName":"Banned","JoinDate":1273775801,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-228160.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Ginger1961","Id":228160,"Name":"Ginger1961","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":false,"TopicId":53458,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"391ce7740630944f93fadc0c140a9897","RawContent":"You only qualify for a free Beautiful Beginnings package with a stay of 6 nights or longer booked in a concierge level room or higher. The fees are different for each island: $250 (Jamaica), $500 (Antigua), $500 (St. Lucia), $500 (Bahamas) and $700 (Turks &amp;amp; Caicos). In the Beautiful Beginnings package with a &amp;quot;standard reception,&amp;quot; it only includes the Bride and Groom and 2 guests. Any more than 2 guests, you will need to pay $15 per person for each extra guest - so you have 4 extra guests. This standard reception only include a 30 minute cocktail reception with the cake, champagne toast and cold hors d&#039;oeuvres.\n \n I have the Sandals Wedding Sales kit - if you want a copy, PM me your email address :)","Attachments":[],"Id":1192564,"PostDate":1277234945,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                You only qualify for a free Beautiful Beginnings package with a stay of 6 nights or longer booked in a concierge level room or higher. The fees are different for each island: $250 (Jamaica), $500 (Antigua), $500 (St. Lucia), $500 (Bahamas) and $700 (Turks & Caicos). In the Beautiful Beginnings package with a \"standard reception,\" it only includes the Bride and Groom and 2 guests. Any more than 2 guests, you will need to pay $15 per person for each extra guest - so you have 4 extra guests. This standard reception only include a 30 minute cocktail reception with the cake, champagne toast and cold hors d'oeuvres.<br \/> <br \/> I have the Sandals Wedding Sales kit - if you want a copy, PM me your email address <img src='https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rachel.coley@aquipt.com","IpAddress":"","GroupId":5,"GroupName":"Banned","JoinDate":1266267475,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-225613.bmp?_r=0","PhotoWidth":0,"PhotoHeight":0,"PhotoType":"custom"},"FormattedName":"Josie1073","Id":225613,"Name":"Josie1073","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":53458,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7b43bdfba3eeb2ed8a0a4f4a03a5c83b","RawContent":"Also remember that the prices may change based on when you are getting married. I think the prices out right now are for 2010 weddings.","Attachments":[],"Id":1192628,"PostDate":1277237070,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Also remember that the prices may change based on when you are getting married. I think the prices out right now are for 2010 weddings.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Chrissy & Jeremiah's Blog with Pictures...<\/span><br><br><a data-ipb='nomediaparse' href=\"http:\/\/www.brilliant.tc\/2010\/05\/chrissy-jeremiah-island-escape\/\">http:\/\/www.brilliant.tc\/2010\/05\/chri...island-escape\/<\/a><\/div><\/div>","Email":"christinambucko@aol.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1258064938,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-223252.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Girasole","Id":223252,"Name":"Girasole","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":false,"TopicId":53458,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"76ce281abd30002b3451bf920e6e5f1f","RawContent":"Welcome to the forum Ginger! \n \n The cost will depend on what island you will be getting married at (those are the goverment fees and vary according to island). You will also need to put a $200 deposit on the wedding.\n \n Of course if you want to upgrade anything such as the wedding, reception ect that all comes with an additional cost. \n \n With the basic Beautiful Beginnings you get the bride &amp;amp; groom plus two guests additional guests will be for the Standard Cocktail Reception for $15 per person*\n \n \n This is what you get with the standard cocktail reception- \n Cocktail Area for 30 Minutes\n Bride and Groom and 2 guests are free (included in WeddingMoon package)\n Theme Wedding Cake\n Champagne Toast\n A Selection of Chef inspired Cold Hors D&#8217;oeuvres\n *This fee applies to all Sandals &amp;amp; Beaches guests and is in addition to any day passes.","Attachments":[],"Id":1192734,"PostDate":1277240951,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Welcome to the forum Ginger! <br \/> <br \/> The cost will depend on what island you will be getting married at (those are the goverment fees and vary according to island). You will also need to put a $200 deposit on the wedding.<br \/> <br \/> Of course if you want to upgrade anything such as the wedding, reception ect that all comes with an additional cost. <br \/> <br \/> With the basic Beautiful Beginnings you get the bride & groom plus two guests additional guests will be for the Standard Cocktail Reception for $15 per person*<br \/> <br \/> <br \/> This is what you get with the standard cocktail reception- <br \/> Cocktail Area for 30 Minutes<br \/> Bride and Groom and 2 guests are free (included in WeddingMoon package)<br \/> Theme Wedding Cake<br \/> Champagne Toast<br \/> A Selection of Chef inspired Cold Hors D&#8217;oeuvres<br \/> *This fee applies to all Sandals & Beaches guests and is in addition to any day passes.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"","IpAddress":"","GroupId":5,"GroupName":"Banned","JoinDate":1193117580,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-207874.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"JenniferSS","Id":207874,"Name":"JenniferSS","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":false,"TopicId":53458,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"34a39a80fc89564b2bd93ab62aac626f","RawContent":"Thank you so much for the feedback everyone. It will most likely be Bahamas. I understand that things will change based on the year we get married. I&#039;d like to know what other options I have. I thought about just what was included in the above and then just book reservations at on of the restaurants because we are such a small group. Do you think that will be okay? We&#039;re paying for our parents to go so we&#039;re trying to keep the extras to a minimum. It&#039;s more important for us to have our family there without the burden of cost on them. That&#039;s not to say I wouldn&#039;t consider doing something else. I&#039;d like to do something fun. Any thoughts would be appreciated.\n \n Ginger","Attachments":[],"Id":1204089,"PostDate":1278212157,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thank you so much for the feedback everyone. It will most likely be Bahamas. I understand that things will change based on the year we get married. I'd like to know what other options I have. I thought about just what was included in the above and then just book reservations at on of the restaurants because we are such a small group. Do you think that will be okay? We're paying for our parents to go so we're trying to keep the extras to a minimum. It's more important for us to have our family there without the burden of cost on them. That's not to say I wouldn't consider doing something else. I'd like to do something fun. Any thoughts would be appreciated.<br \/> <br \/> Ginger\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>\"<\/span><em><strong>He's my Lobster<\/strong><\/em><span>\"<\/span><\/div><\/div>","Email":"wendy.somerton@ecbc.ca","IpAddress":"","GroupId":5,"GroupName":"Banned","JoinDate":1273775801,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-228160.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Ginger1961","Id":228160,"Name":"Ginger1961","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":false,"TopicId":53458,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"369738c76c77e0ae5c26794327bc8d49","RawContent":"Hey Ginger,\n \n We are just doing the BB package and having our &amp;quot;reception&amp;quot; at one of the restaurants after the ceremony. We are a small group of just 6 people, so to us, spending money on a reception didn&#039;t make sense. We instead are booking an excursion the day after the wedding for our guests as a thank you for joining us in Jamaica :)","Attachments":[],"Id":1205854,"PostDate":1278447930,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hey Ginger,<br \/> <br \/> We are just doing the BB package and having our \"reception\" at one of the restaurants after the ceremony. We are a small group of just 6 people, so to us, spending money on a reception didn't make sense. We instead are booking an excursion the day after the wedding for our guests as a thank you for joining us in Jamaica <img src='https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rachel.coley@aquipt.com","IpAddress":"","GroupId":5,"GroupName":"Banned","JoinDate":1266267475,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-225613.bmp?_r=0","PhotoWidth":0,"PhotoHeight":0,"PhotoType":"custom"},"FormattedName":"Josie1073","Id":225613,"Name":"Josie1073","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":false,"TopicId":53458,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cfcad8b080cdc4fc1fc4686495dad007","RawContent":"We are only having 8 guests and will just do dinner at one of the restaurants after the ceremony. We&#039;ve decided to upgrade to the 1 hr cocktail hour though so we&#039;d have some private time to do cake, toasts, dances, etc but couldn&#039;t rationalize the added expense of a full reception for such a small group.","Attachments":[],"Id":1206271,"PostDate":1278464217,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We are only having 8 guests and will just do dinner at one of the restaurants after the ceremony. We've decided to upgrade to the 1 hr cocktail hour though so we'd have some private time to do cake, toasts, dances, etc but couldn't rationalize the added expense of a full reception for such a small group.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><em><strong>~~ Lea ~~<\/strong><\/em><br><strong>January 2, 2011 ~ Sandals Royal Caribbean<br>(honeymooning at Couples Negril)<\/strong><span> <\/span><a data-ipb='nomediaparse' href=\"http:\/\/dwdf.daisypath.com\/xRI3m4.png\"><br><br>http:\/\/dwdf.daisypath.com\/xRI3m4.png<\/a><\/div><\/div>","Email":"lea.simon@yahoo.com","IpAddress":"","GroupId":5,"GroupName":"Banned","JoinDate":1272342858,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-227690.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"mrs*j*2011","Id":227690,"Name":"mrs*j*2011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":53458,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f13a3ec3b20050c19dc573030d33d0d1","RawContent":"We actually had 10 people (including us) so we were originally going to just eat dinner @ the restaurant &amp;amp; upgrade to the cocktail hour but when we got there we decided it would be really nice to have everyone just together without noise &amp;amp; other people around. So we did the 2 hour reception dinner which was very nice and a great location overlooking the beach but even without it I think the restaurants are so nice it just depends on what you want. We did our rehersal dinner @ Marios and had a great time. Good luck with your planning!","Attachments":[],"Id":1206275,"PostDate":1278464484,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We actually had 10 people (including us) so we were originally going to just eat dinner @ the restaurant & upgrade to the cocktail hour but when we got there we decided it would be really nice to have everyone just together without noise & other people around. So we did the 2 hour reception dinner which was very nice and a great location overlooking the beach but even without it I think the restaurants are so nice it just depends on what you want. We did our rehersal dinner @ Marios and had a great time. Good luck with your planning!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Chrissy & Jeremiah's Blog with Pictures...<\/span><br><br><a data-ipb='nomediaparse' href=\"http:\/\/www.brilliant.tc\/2010\/05\/chrissy-jeremiah-island-escape\/\">http:\/\/www.brilliant.tc\/2010\/05\/chri...island-escape\/<\/a><\/div><\/div>","Email":"christinambucko@aol.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1258064938,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-223252.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Girasole","Id":223252,"Name":"Girasole","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":false,"TopicId":53458,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cd4ba4ba2e5908513b8f9fc5469ff35d","RawContent":"Upgrading to a one hour reception sounds like a great idea. Something else I&#039;m not doing is the photograpy session. It&#039;s really expensive compared to other resorts we&#039;ve looked at. My fiance is a great photographer and has a really nice camera and tripod. He figures he&#039;ll set it up and get people to push the button for us. I&#039;d rather put the 1500somewhere else. Like I said paying for our parents to go for 4 nights and their flights is costing us about 10,000 dollars but it&#039;s worth it to us. Anyone have any pictures of ceremony sites at Sandals Bahamian? I&#039;d love to see them. Also what is the cost to upgrade to the hour reception. I like the idea of private time too. 30 minutes seems really rushed. One other question, do they actually do a rehersal? I&#039;ve seen a few ladies mention rehearsal dinners. A few other resorts we looked into before settling on Sandals do not do an actual rehearsal. Thank you everyone for all the information.","Attachments":[],"Id":1212455,"PostDate":1278884785,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Upgrading to a one hour reception sounds like a great idea. Something else I'm not doing is the photograpy session. It's really expensive compared to other resorts we've looked at. My fiance is a great photographer and has a really nice camera and tripod. He figures he'll set it up and get people to push the button for us. I'd rather put the 1500somewhere else. Like I said paying for our parents to go for 4 nights and their flights is costing us about 10,000 dollars but it's worth it to us. Anyone have any pictures of ceremony sites at Sandals Bahamian? I'd love to see them. Also what is the cost to upgrade to the hour reception. I like the idea of private time too. 30 minutes seems really rushed. One other question, do they actually do a rehersal? I've seen a few ladies mention rehearsal dinners. A few other resorts we looked into before settling on Sandals do not do an actual rehearsal. Thank you everyone for all the information.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>\"<\/span><em><strong>He's my Lobster<\/strong><\/em><span>\"<\/span><\/div><\/div>","Email":"wendy.somerton@ecbc.ca","IpAddress":"","GroupId":5,"GroupName":"Banned","JoinDate":1273775801,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-228160.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Ginger1961","Id":228160,"Name":"Ginger1961","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":53458,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"53967bd37628601de6342a719c3d2910","RawContent":"&lt;p&gt; Does anyone know how much it is to add on a private reception?&lt;\/p&gt;","Attachments":[],"Id":1236533,"PostDate":1280425269,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Does anyone know how much it is to add on a private reception?<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"allysoncady@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1280425137,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-230821.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"c8080","Id":230821,"Name":"c8080","IsOnline":false}}],"Id":"53458","Title":"Cost of Sandals Wedding! 6-8","LastPostDate":1449461771},"Pages":{"TotalItems":35,"TotalPages":4,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":30},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
