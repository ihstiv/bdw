{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":27,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":497,"MovedTo":null,"MovedOn":0,"FirstPostId":1893340,"Rating":0,"RatingHits":0,"Starter":{"Id":281478,"Name":"perianjay","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1428347017","PhotoWidth":169,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":true},"StartDate":1429198348,"LastPoster":{"Id":281478,"Name":"perianjay","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1428347017","PhotoWidth":169,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":true},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1893340,"PostDate":1429198348,"PostContent":"Hey Ladies! Was just thinking about this today when I was making a rough draft of my seating list...","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":3,"GroupName":"Member","JoinDate":1419437814,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1428347017","PhotoWidth":169,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":true}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79072,"EditedBy":"<strong>Edited by perianjay, 16 April 2015 - 07:33 AM.<\/strong>","EditDate":1429198431,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f8b6dbbceaf2818928eb7879034202bc","RawContent":"&lt;p&gt;Hey Ladies!\n\n\nWas just thinking about this today when I was making a rough draft of my seating list. Did you include your vendors in your seating plan?\n\n&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I will have four vendors who will be attending the reception. I have a videographer (two people) and photographer (two people) and didn&#039;t know if it was an expectation. I haven&#039;t asked my WC about this as of yet and I thought i&#039;d just get some feelers out in the group.&lt;\/p&gt;","Attachments":[],"Id":1893340,"PostDate":1429198348,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hey Ladies!<br><br>\nWas just thinking about this today when I was making a rough draft of my seating list. Did you include your vendors in your seating plan?<br>\n\u00a0<\/p>\n<p>I will have four vendors who will be attending the reception. I have a videographer (two people) and photographer (two people) and didn't know if it was an expectation. I haven't asked my WC about this as of yet and I thought i'd just get some feelers out in the group.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":3,"GroupName":"Member","JoinDate":1419437814,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1428347017","PhotoWidth":169,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"216.84.102.233","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79072,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"f2d130c3e4458bdba761ffeb0b3dbb5e","RawContent":"&lt;p&gt;@[member=\"perianjay\"] I didn&#039;t include them in my seating chart, because I honestly don&#039;t expect them to sit down at all, shouldn&#039;t they be working the whole time?&lt;\/p&gt;","Attachments":[],"Id":1893345,"PostDate":1429200338,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"281478\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/281478-perianjay\/' title='Member profile'><span itemprop=\"name\">perianjay<\/span><\/a> I didn't include them in my seating chart, because I honestly don't expect them to sit down at all, shouldn't they be working the whole time?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>58 guests plus bride and groom<br>\nCeremony: Gazebo<br>\nReception: Pool Deck","Email":"smileitseb@gmail.com","IpAddress":"50.90.104.129","GroupId":40,"GroupName":"Jr. Member","JoinDate":1394223869,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277044.jpg?_r=1428066900","PhotoWidth":200,"PhotoHeight":224,"PhotoType":"custom"},"FormattedName":"smileitseb","Id":277044,"Name":"smileitseb","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"192.249.47.212","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79072,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"4e5bd25909dd37d0225ed8ea0c31c05f","RawContent":"&lt;p&gt;This is a good question., I haven&#039;t even thought about that... are you including plates for all of them as well ? For the Photographers and DJ , etc ?... Because if you are then they will need a seat to eat..&amp;nbsp; I agree with @[member=\"smileitseb\"] they should be working the entire time. But I don&#039;t think anyone will want to be recorded or photographed eating. So they possibly will need to sit and eat themselves.....?&lt;\/p&gt;","Attachments":[],"Id":1893347,"PostDate":1429202109,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>This is a good question., I haven't even thought about that... are you including plates for all of them as well ? For the Photographers and DJ , etc ?... Because if you are then they will need a seat to eat..\u00a0 I agree with @<a hovercard-ref=\"member\" hovercard-id=\"277044\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/277044-smileitseb\/' title='Member profile'><span itemprop=\"name\">smileitseb<\/span><\/a> they should be working the entire time. But I don't think anyone will want to be recorded or photographed eating. So they possibly will need to sit and eat themselves.....?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"racht33@yahoo.com","IpAddress":"192.249.47.212","GroupId":3,"GroupName":"Member","JoinDate":1422632988,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281952.jpg?_r=1424197509","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"racht33","Id":281952,"Name":"racht33","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79072,"EditedBy":"<strong>Edited by perianjay, 16 April 2015 - 09:12 AM.<\/strong>","EditDate":1429204337,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3b9baed7e5d4baaec3ac3475364f77e8","RawContent":"&lt;p&gt;@[member=\"smileitseb\"] I think it&#039;s somewhat an expectation to feed them etc. Especially if they will be there for 6-8 hours. My photographer will be there for around 7 hours and videographer 5 hours.. My resort mentioned something about paying for a day pass for our vendors as well.&lt;\/p&gt;\n\n&lt;p&gt;@[member=\"racht33\"] I don&#039;t think they would include eating time as hours you pay for regardless (with photography anyway). I&#039;d feel prettty bad expecting my photographer\/videographer to come at 1pm and not eat until 9-10pm.&lt;\/p&gt;\n&lt;p&gt;Most of the time the photographer is there a bit longer too because of the flow of the day.. they aren&#039;t always shooting. I know that at weddings at home it&#039;s an expectation to feed the vendors. Usually it&#039;s only photographers because they spend the good of the day with you depending on how many hours you&#039;ve paid for.&lt;\/p&gt;","Attachments":[],"Id":1893354,"PostDate":1429204315,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"277044\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/277044-smileitseb\/' title='Member profile'><span itemprop=\"name\">smileitseb<\/span><\/a> I think it's somewhat an expectation to feed them etc. Especially if they will be there for 6-8 hours. My photographer will be there for around 7 hours and videographer 5 hours.. My resort mentioned something about paying for a day pass for our vendors as well.<\/p>\n<br><p>@<a hovercard-ref=\"member\" hovercard-id=\"281952\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/281952-racht33\/' title='Member profile'><span itemprop=\"name\">racht33<\/span><\/a> I don't think they would include eating time as hours you pay for regardless (with photography anyway). I'd feel prettty bad expecting my photographer\/videographer to come at 1pm and not eat until 9-10pm.<\/p>\n<p>Most of the time the photographer is there a bit longer too because of the flow of the day.. they aren't always shooting. I know that at weddings at home it's an expectation to feed the vendors. Usually it's only photographers because they spend the good of the day with you depending on how many hours you've paid for.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":3,"GroupName":"Member","JoinDate":1419437814,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1428347017","PhotoWidth":169,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.87.237.180","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79072,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"3d920e35e6849cae16a3660b98c09fe1","RawContent":"&lt;p&gt;We&#039;re a super small group but I&#039;ve invited our photographer (not sure if there is an assistant) to have dinner with us. I&#039;m figuring by the time we actually get to our time to sit down and eat, he&#039;ll be finished with pictures. We only took a five hour package since it&#039;s just a renewal, not our actual wedding.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I know some of the contracts, if you read through them, say that a meal is to be provided so in some ways, based on that, it&#039;s up to you whether you invite them to actually eat with you, or just ask your WC to ensure that a meal is provided for them.&lt;\/p&gt;","Attachments":[],"Id":1893357,"PostDate":1429206049,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>We're a super small group but I've invited our photographer (not sure if there is an assistant) to have dinner with us. I'm figuring by the time we actually get to our time to sit down and eat, he'll be finished with pictures. We only took a five hour package since it's just a renewal, not our actual wedding.<\/p>\n<p>\u00a0<\/p>\n<p>I know some of the contracts, if you read through them, say that a meal is to be provided so in some ways, based on that, it's up to you whether you invite them to actually eat with you, or just ask your WC to ensure that a meal is provided for them.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283458999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1426134867","PhotoWidth":668,"PhotoHeight":600,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79072,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7a7cf92a22ffd9001fcc54c127d0da40","RawContent":"&lt;p&gt;@[member=\"acw271011\"] That&#039;s really nice of you! I agree though. I definitely want to feed my photographers\/videographers.. I just didn&#039;t know if they would be sitting with my guests, or if the resort would have them sitting somewhere else? not too sure. I just wanted to make sure that they are fed! I&#039;d feel terrible if they worked all day and didn&#039;t get a break somewhere in between to eat and take a moment.&lt;\/p&gt;","Attachments":[],"Id":1893358,"PostDate":1429206257,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"232000\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/232000-acw271011\/' title='Member profile'><span itemprop=\"name\">acw271011<\/span><\/a> That's really nice of you! I agree though. I definitely want to feed my photographers\/videographers.. I just didn't know if they would be sitting with my guests, or if the resort would have them sitting somewhere else? not too sure. I just wanted to make sure that they are fed! I'd feel terrible if they worked all day and didn't get a break somewhere in between to eat and take a moment.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":3,"GroupName":"Member","JoinDate":1419437814,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1428347017","PhotoWidth":169,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.87.237.180","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79072,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"a757815d026efdf5b7887420f2edf8a9","RawContent":"&lt;p&gt;I know when we got married in Jamaica, our photographer didn&#039;t sit down to eat at all until he was completely finished with our package time, and then he did sit down with us. We had included him with us for a meal, again it was just the two of us so it was no big deal.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;An option might be to include them, but maybe if you have a table that isn&#039;t completely full perhaps have them sit there together. The other option too, if your package on time is complete, you could find a way for them to go maybe to the resort buffet, on their own, and get a meal there, or one of the onsite restaurants.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Best thing is to check with your WC because I&#039;m certain, if the photographer isn&#039;t going to be part of your actual meal group, that they&#039;ve dealt with this any number&amp;nbsp;of times and she would be able to tell you how to organize it, especially since so many of the contracts have that clause. Maybe a ticket needs to be prepared for them or something that they would need to pick up from the WC once their work is done.&lt;\/p&gt;","Attachments":[],"Id":1893360,"PostDate":1429206668,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I know when we got married in Jamaica, our photographer didn't sit down to eat at all until he was completely finished with our package time, and then he did sit down with us. We had included him with us for a meal, again it was just the two of us so it was no big deal.<\/p>\n<p>\u00a0<\/p>\n<p>An option might be to include them, but maybe if you have a table that isn't completely full perhaps have them sit there together. The other option too, if your package on time is complete, you could find a way for them to go maybe to the resort buffet, on their own, and get a meal there, or one of the onsite restaurants.<\/p>\n<p>\u00a0<\/p>\n<p>Best thing is to check with your WC because I'm certain, if the photographer isn't going to be part of your actual meal group, that they've dealt with this any number\u00a0of times and she would be able to tell you how to organize it, especially since so many of the contracts have that clause. Maybe a ticket needs to be prepared for them or something that they would need to pick up from the WC once their work is done.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283458999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1426134867","PhotoWidth":668,"PhotoHeight":600,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"159.53.46.140","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79072,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"b074187e2d9b681b74f5490127db4be2","RawContent":"&lt;p&gt;I need to feed my photographers but I was wondering the same about the seating arrangement. I can JUST fit everyone at 7 tables so if I add them then I have to go to 8 and spread people out (and add a centerpiece) so I&#039;m hoping they can set up a separate 2-top for them. I hate to spread out my guests and make some sit with the photographer instead of someone else they know!&lt;\/p&gt;","Attachments":[],"Id":1893361,"PostDate":1429206715,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I need to feed my photographers but I was wondering the same about the seating arrangement. I can JUST fit everyone at 7 tables so if I add them then I have to go to 8 and spread people out (and add a centerpiece) so I'm hoping they can set up a separate 2-top for them. I hate to spread out my guests and make some sit with the photographer instead of someone else they know!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rebecca.shaffer@gmail.com","IpAddress":"159.53.174.144","GroupId":40,"GroupName":"Jr. Member","JoinDate":1403116087,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"beckys98","Id":278581,"Name":"beckys98","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.87.237.180","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79072,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7343975489a8ac0010f4290257503bf1","RawContent":"&lt;p&gt;The other thing too, as well as checking with your WC is to come right out and ask your photographer how they usually do things. Again, they&#039;ve likely gone through this a thousand times and I&#039;m sure they&#039;ll work with whatever works for you!!&lt;\/p&gt;","Attachments":[],"Id":1893364,"PostDate":1429206970,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>The other thing too, as well as checking with your WC is to come right out and ask your photographer how they usually do things. Again, they've likely gone through this a thousand times and I'm sure they'll work with whatever works for you!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283458999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1426134867","PhotoWidth":668,"PhotoHeight":600,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79072,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"21c5a78fd66dea05eaf9a14b1f851e05","RawContent":"&lt;p&gt;@[member=\"acw271011\"] Definitely going to ask my WC how it would work :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;@[member=\"beckys98\"] eek! I have enough room at one of my tables. The table is six right now, but may go down to 4 if their children don&#039;t come. Worst case scenario it would end up being a table of 10 with my vendors, best case it would end up being a table of 8. That&#039;s if the WC says that they would be eating with us on the sky terrace. I would only assume so to be perfectly honest.&lt;\/p&gt;","Attachments":[],"Id":1893366,"PostDate":1429207092,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"232000\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/232000-acw271011\/' title='Member profile'><span itemprop=\"name\">acw271011<\/span><\/a> Definitely going to ask my WC how it would work <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"278581\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/278581-beckys98\/' title='Member profile'><span itemprop=\"name\">beckys98<\/span><\/a> eek! I have enough room at one of my tables. The table is six right now, but may go down to 4 if their children don't come. Worst case scenario it would end up being a table of 10 with my vendors, best case it would end up being a table of 8. That's if the WC says that they would be eating with us on the sky terrace. I would only assume so to be perfectly honest.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":3,"GroupName":"Member","JoinDate":1419437814,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1428347017","PhotoWidth":169,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":true}}],"Id":"79072","Title":"Vendors - Seating At Reception","LastPostDate":1429279348},"Pages":{"TotalItems":27,"TotalPages":3,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":20},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
