{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.219.69.233","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77019,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"80c8a5451c5c715269f9bf0b0fddb293","RawContent":"Hey ladies!\n\n\nFrom what I understand Chandlyn is the coordinator down there (at the resort) and Laura is the wedding planner out of Toronto!\n\n\nI&#039;m dealing with Laura in Toronto....I hear Chandlyn is fabulous!\n\n\n:)","Attachments":[],"Id":1849983,"PostDate":1399931013,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hey ladies!<br><br>\nFrom what I understand Chandlyn is the coordinator down there (at the resort) and Laura is the wedding planner out of Toronto!<br><br>\nI'm dealing with Laura in Toronto....I hear Chandlyn is fabulous!<br><br>\n<img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Happy Planning Future Brides!<\/p>\n<p>Love, Mrs. Gedney! <3<\/p>\n<p>11.18.2014","Email":"psaca@me.com","IpAddress":"99.227.231.192","GroupId":40,"GroupName":"Jr. Member","JoinDate":1372253473,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270939.jpg?_r=1423518723","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"pamelas21","Id":270939,"Name":"pamelas21","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"69.126.17.167","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77019,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"2ea34e3a08f660e584cb95d33e04f6e9","RawContent":"Chandlyn is awesome!!  :)  Thanks for clarifying, I was wondering why I had never spoken with Laura!","Attachments":[],"Id":1850014,"PostDate":1399946758,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Chandlyn is awesome!!  <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>  Thanks for clarifying, I was wondering why I had never spoken with Laura!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jgugenheim@gmail.com","IpAddress":"69.121.31.46","GroupId":39,"GroupName":"Newbie","JoinDate":1391804127,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276557.jpg?_r=1392759726","PhotoWidth":185,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Soon2beMrsJ","Id":276557,"Name":"Soon2beMrsJ","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"69.58.97.194","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77019,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"f58f0338848d7b6de35c7188b5391249","RawContent":"&lt;p&gt;I read somewhere that us Canadian girls can request to work with Chandlyn to eliminate the middle person (Laura) BUT so far Laura has been great! &amp;lt;3&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Plus I&#039;m out of Toronto and Laura is based in Toronto too!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Not sure why they did it this way.....&lt;\/p&gt;","Attachments":[],"Id":1850047,"PostDate":1399990912,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I read somewhere that us Canadian girls can request to work with Chandlyn to eliminate the middle person (Laura) BUT so far Laura has been great! <3<\/p>\n<p>\u00a0<\/p>\n<p>Plus I'm out of Toronto and Laura is based in Toronto too!<\/p>\n<p>\u00a0<\/p>\n<p>Not sure why they did it this way.....<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Happy Planning Future Brides!<\/p>\n<p>Love, Mrs. Gedney! <3<\/p>\n<p>11.18.2014","Email":"psaca@me.com","IpAddress":"99.227.231.192","GroupId":40,"GroupName":"Jr. Member","JoinDate":1372253473,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270939.jpg?_r=1423518723","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"pamelas21","Id":270939,"Name":"pamelas21","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"69.121.31.46","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77019,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"000b46aee8cd7d9e0d2ca7d81274443c","RawContent":"&lt;p&gt;Ahhhh, gotcha!!&amp;nbsp; Luckily they are both awesome so everybody wins&amp;nbsp; :)&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;So excited, save the dates are done and now I can finally go dress shopping!!!!!!!!!&lt;\/p&gt;","Attachments":[],"Id":1850116,"PostDate":1400006114,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Ahhhh, gotcha!!\u00a0 Luckily they are both awesome so everybody wins\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>So excited, save the dates are done and now I can finally go dress shopping!!!!!!!!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jgugenheim@gmail.com","IpAddress":"69.121.31.46","GroupId":39,"GroupName":"Newbie","JoinDate":1391804127,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276557.jpg?_r=1392759726","PhotoWidth":185,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Soon2beMrsJ","Id":276557,"Name":"Soon2beMrsJ","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.244.114.38","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77019,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"dc19c412fa9c298b60ff3617807d74fc","RawContent":"&lt;p&gt;Thanks for the clarification! My wedding&#039;s so far away I haven&#039;t even contacted Chandlyn yet.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I can&#039;t believe my luck, I&#039;m in Toronto too so I could definitely get in touch with Laura if I had to, yay!&lt;\/p&gt;","Attachments":[],"Id":1850163,"PostDate":1400023437,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thanks for the clarification! My wedding's so far away I haven't even contacted Chandlyn yet.<\/p>\n<p>\u00a0<\/p>\n<p>I can't believe my luck, I'm in Toronto too so I could definitely get in touch with Laura if I had to, yay!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"smitha_r@yahoo.com","IpAddress":"99.244.114.38","GroupId":39,"GroupName":"Newbie","JoinDate":1389143480,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275928.jpg?_r=1403747949","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"mysticjade","Id":275928,"Name":"mysticjade","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.227.231.192","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77019,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"e0e0bcff2e5939e2dfbee182c5be1897","RawContent":"&lt;p&gt;I don&#039;t think I&#039;m ever going to email with Chandlyn. I&#039;m told I&#039;ll only deal with her when we land in Montego Bay!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;You&#039;re a year away mysticjade! Enjoy that year! I&#039;m 6 months away and silently freaking out hahaha&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;@[member=\"soontobemrsJ\"] Good luck dress shopping! &amp;lt;3&lt;\/p&gt;","Attachments":[],"Id":1850174,"PostDate":1400025771,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I don't think I'm ever going to email with Chandlyn. I'm told I'll only deal with her when we land in Montego Bay!<\/p>\n<p>\u00a0<\/p>\n<p>You're a year away mysticjade! Enjoy that year! I'm 6 months away and silently freaking out hahaha<\/p>\n<p>\u00a0<\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"255022\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/255022-soontobemrsj\/' title='Member profile'><span itemprop=\"name\">soontobemrsJ<\/span><\/a> Good luck dress shopping! <3<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Happy Planning Future Brides!<\/p>\n<p>Love, Mrs. Gedney! <3<\/p>\n<p>11.18.2014","Email":"psaca@me.com","IpAddress":"99.227.231.192","GroupId":40,"GroupName":"Jr. Member","JoinDate":1372253473,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270939.jpg?_r=1423518723","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"pamelas21","Id":270939,"Name":"pamelas21","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"69.126.17.167","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77019,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6022476637af4428944408ce9e21acc3","RawContent":"[quote name=\"pamelas21\" post=\"1850174\" timestamp=\"1400025771\"]\nI don&#039;t think I&#039;m ever going to email with Chandlyn. I&#039;m told I&#039;ll only deal with her when we land in Montego Bay!\n \nYou&#039;re a year away mysticjade! Enjoy that year! I&#039;m 6 months away and silently freaking out hahaha\n \n@[member=\"soontobemrsJ\"] Good luck dress shopping! &amp;lt;3[\/quote]Thanks!! Appointments are June 7th, so hopefully I find the dress in that one trip. \n\nHope you don&#039;t freak out too much, I&#039;m sure everything will go beautifully!!! :)","Attachments":[],"Id":1850201,"PostDate":1400030231,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>pamelas21, on 13 May 2014 - 04:02 PM, said:<\/p><div class='blockquote'><div class='quote'><p>I don't think I'm ever going to email with Chandlyn. I'm told I'll only deal with her when we land in Montego Bay!<br>\n\u00a0<br>\nYou're a year away mysticjade! Enjoy that year! I'm 6 months away and silently freaking out hahaha<br>\n\u00a0<br>\n@<a hovercard-ref=\"member\" hovercard-id=\"255022\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/255022-soontobemrsj\/' title='Member profile'><span itemprop=\"name\">soontobemrsJ<\/span><\/a> Good luck dress shopping! <3<\/p><\/div><\/div>\n<br>\nThanks!! Appointments are June 7th, so hopefully I find the dress in that one trip. <br><br>\nHope you don't freak out too much, I'm sure everything will go beautifully!!! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jgugenheim@gmail.com","IpAddress":"69.121.31.46","GroupId":39,"GroupName":"Newbie","JoinDate":1391804127,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276557.jpg?_r=1392759726","PhotoWidth":185,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Soon2beMrsJ","Id":276557,"Name":"Soon2beMrsJ","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.227.231.192","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77019,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":3,"IsLiked":false,"PostKey":"21d575e5a310d9006f6c707570ef1768","RawContent":"[quote name=\"Soon2beMrsJ\" post=\"1850201\" timestamp=\"1400030231\"]\nThanks!! Appointments are June 7th, so hopefully I find the dress in that one trip.\n\nHope you don&#039;t freak out too much, I&#039;m sure everything will go beautifully!!! :)[\/quote]\nHope so! The important thing is to get married to my best friend! &amp;lt;3 cheesy I know LOL\n\nBTW I purchased the 1st dress I tried on! ;) &amp;lt;3\n\nIt was &#039;the one&#039; !!\n\n:D","Attachments":[],"Id":1850207,"PostDate":1400031275,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Soon2beMrsJ, on 13 May 2014 - 05:17 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Thanks!! Appointments are June 7th, so hopefully I find the dress in that one trip.<br><br>\nHope you don't freak out too much, I'm sure everything will go beautifully!!! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>Hope so! The important thing is to get married to my best friend! <3 cheesy I know LOL<\/p>\n<p>\u00a0<\/p>\n<p>BTW I purchased the 1st dress I tried on! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/> <3<\/p>\n<p>\u00a0<\/p>\n<p>It was 'the one' !!<\/p>\n<p>\u00a0<\/p>\n<p><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/biggrin.png' class='bbc_emoticon' alt=':D' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Happy Planning Future Brides!<\/p>\n<p>Love, Mrs. Gedney! <3<\/p>\n<p>11.18.2014","Email":"psaca@me.com","IpAddress":"99.227.231.192","GroupId":40,"GroupName":"Jr. Member","JoinDate":1372253473,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270939.jpg?_r=1423518723","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"pamelas21","Id":270939,"Name":"pamelas21","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"69.121.31.46","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77019,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1f5ba36f06b89ef134670fdc4b9ce48c","RawContent":"&lt;p&gt;Cheesy but true!&amp;nbsp; :)  &lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;ve heard that happens with a lot of people, you just see it and you&#039;re like yup this is my dress!!!&amp;nbsp; Can&#039;t wait to go!!&lt;\/p&gt;","Attachments":[],"Id":1850252,"PostDate":1400076830,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Cheesy but true!\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I've heard that happens with a lot of people, you just see it and you're like yup this is my dress!!!\u00a0 Can't wait to go!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jgugenheim@gmail.com","IpAddress":"69.121.31.46","GroupId":39,"GroupName":"Newbie","JoinDate":1391804127,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276557.jpg?_r=1392759726","PhotoWidth":185,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Soon2beMrsJ","Id":276557,"Name":"Soon2beMrsJ","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.231.14.119","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77019,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bd0ab2fe5071bf9a09496acc20d3fb4e","RawContent":"Congrats! I intend on booking my wedding there for Sept 2015.  Would you mind emailing me your pictures as well?  Unfortunately I will be unable to go and visit the site prior to my actual wedding so pictures are all I have, Yikes!\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1850396,"PostDate":1400115602,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Congrats! I intend on booking my wedding there for Sept 2015.  Would you mind emailing me your pictures as well?  Unfortunately I will be unable to go and visit the site prior to my actual wedding so pictures are all I have, Yikes!<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"Using Tapatalk","Email":"krissyl830@gmail.com","IpAddress":"72.231.14.119","GroupId":3,"GroupName":"Member","JoinDate":1400115490,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277969.jpg?_r=1400115490","PhotoWidth":111,"PhotoHeight":148,"PhotoType":"custom"},"FormattedName":"krissybear1229","Id":277969,"Name":"krissybear1229","IsOnline":false}}],"Pages":{"TotalItems":69,"TotalPages":7,"CurrentPage":20,"NextPage":30,"PreviousPage":10,"LastPage":60},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
