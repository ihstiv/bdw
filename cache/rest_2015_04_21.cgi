{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":10,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":201,"MovedTo":null,"MovedOn":0,"FirstPostId":1893142,"Rating":0,"RatingHits":0,"Starter":{"Id":281952,"Name":"racht33","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281952.jpg?_r=1424197509","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"StartDate":1429060478,"LastPoster":{"Id":272291,"Name":"candle23","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272291.jpg?_r=1388954341","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":2,"Preview":{"Id":1893142,"PostDate":1429060478,"PostContent":"I need help!! I'm really stuck between which of the two to pick. What helped you make your decisi...","Author":{"Signature":"","Email":"racht33@yahoo.com","IpAddress":"192.249.47.212","GroupId":3,"GroupName":"Member","JoinDate":1422632988,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281952.jpg?_r=1424197509","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"racht33","Id":281952,"Name":"racht33","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.0.198.224","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79064,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"66aabc915c99c94a065e55e95dcfdf82","RawContent":"&lt;p&gt;I need help!! I&#039;m really stuck between which of the two to pick. What helped you make your decision over these two?&lt;\/p&gt;","Attachments":[],"Id":1893142,"PostDate":1429060478,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I need help!! I'm really stuck between which of the two to pick. What helped you make your decision over these two?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"racht33@yahoo.com","IpAddress":"192.249.47.212","GroupId":3,"GroupName":"Member","JoinDate":1422632988,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281952.jpg?_r=1424197509","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"racht33","Id":281952,"Name":"racht33","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.85.127.174","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79064,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"16f3bd2b228a5dcf0de9a214eeac55ce","RawContent":"&lt;p&gt;We picked Now Sapphire for a couple of reasons. For one, it looks more \"Mexican\" to me. I didn&#039;t want to go all the way to Mexico to feel like I was in a slick hotel that could right here in our city (well, other than the weather, the beach, the pools, etc.)&amp;nbsp; :P&amp;nbsp;Now Jade looked more like that to me, although gorgeous in its own right. Also, I have a colleague who was married at Now Sapphire two years ago. She had a very good experience there, so that personal recommendation really clinched it for me.&lt;\/p&gt;","Attachments":[],"Id":1893163,"PostDate":1429071859,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>We picked Now Sapphire for a couple of reasons. For one, it looks more \"Mexican\" to me. I didn't want to go all the way to Mexico to feel like I was in a slick hotel that could right here in our city (well, other than the weather, the beach, the pools, etc.)\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/tongue.png' class='bbc_emoticon' alt=':P' \/>\u00a0Now Jade looked more like that to me, although gorgeous in its own right. Also, I have a colleague who was married at Now Sapphire two years ago. She had a very good experience there, so that personal recommendation really clinched it for me.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ekjzwedding@gmail.com","IpAddress":"24.85.127.174","GroupId":39,"GroupName":"Newbie","JoinDate":1417449445,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281283.jpg?_r=1428779369","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"vancouverpetunia","Id":281283,"Name":"vancouverpetunia","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.85.127.174","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79064,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8cb96344b4931c834c950bc61244238a","RawContent":"I also forgot to mention that Jade was slightly more expensive for our travel packages. Not by a lot, I think maybe $50 per person for the week. But every little bit helps. \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1893167,"PostDate":1429093826,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I also forgot to mention that Jade was slightly more expensive for our travel packages. Not by a lot, I think maybe $50 per person for the week. But every little bit helps. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ekjzwedding@gmail.com","IpAddress":"24.85.127.174","GroupId":39,"GroupName":"Newbie","JoinDate":1417449445,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281283.jpg?_r=1428779369","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"vancouverpetunia","Id":281283,"Name":"vancouverpetunia","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"192.249.47.212","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79064,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6781fcaa1e3d842dd084468b5f4606a2","RawContent":"&lt;p&gt;thank you so much for your feedback. It seems to be the similar comment we have gotten from various people between the two. They state it feels more like Mexico. My big deciding point is the ceremony&amp;nbsp; and reception locations. @vancouverpentunia&lt;\/p&gt;","Attachments":[],"Id":1893211,"PostDate":1429117761,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>thank you so much for your feedback. It seems to be the similar comment we have gotten from various people between the two. They state it feels more like Mexico. My big deciding point is the ceremony\u00a0 and reception locations. @vancouverpentunia<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"racht33@yahoo.com","IpAddress":"192.249.47.212","GroupId":3,"GroupName":"Member","JoinDate":1422632988,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281952.jpg?_r=1424197509","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"racht33","Id":281952,"Name":"racht33","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.222.215.164","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79064,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"a2a4b033c4c124c77829ebcd909e13be","RawContent":"We chose the now jade because of how beautiful and modern the hotel looked :) I guess you just really have to know what it is you are looking for!!","Attachments":[],"Id":1893220,"PostDate":1429121772,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We chose the now jade because of how beautiful and modern the hotel looked <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> I guess you just really have to know what it is you are looking for!! \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"candle_23@hotmail.com","IpAddress":"66.222.215.154","GroupId":40,"GroupName":"Jr. Member","JoinDate":1375761701,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272291.jpg?_r=1388954341","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"candle23","Id":272291,"Name":"candle23","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"192.249.47.212","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79064,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0ce8f2eaab64dd450d91da19f4d138a0","RawContent":"&lt;p&gt;Its&amp;nbsp; the look fianc\u00e9 and I really like. Plus the ceremony\/reception areas at now jade just win my heart so much more!! and You cant beat a rain shower!!!&amp;nbsp; Your wedding is coming so close!!! You must be so excited!! @[member=\"candle23\"]&lt;\/p&gt;","Attachments":[],"Id":1893222,"PostDate":1429122175,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Its\u00a0 the look fianc\u00e9 and I really like. Plus the ceremony\/reception areas at now jade just win my heart so much more!! and You cant beat a rain shower!!!\u00a0 Your wedding is coming so close!!! You must be so excited!! @<a hovercard-ref=\"member\" hovercard-id=\"272291\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/272291-candle23\/' title='Member profile'><span itemprop=\"name\">candle23<\/span><\/a><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"racht33@yahoo.com","IpAddress":"192.249.47.212","GroupId":3,"GroupName":"Member","JoinDate":1422632988,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281952.jpg?_r=1424197509","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"racht33","Id":281952,"Name":"racht33","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"67.71.84.242","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79064,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"741cd452f98e059d80af827987021426","RawContent":"&lt;p&gt;I fell in love with NS looking at photos from other brides.&amp;nbsp; As soon as I saw the Tequila Terrace I knew I wanted to have my wedding there.&amp;nbsp; It had something different from all the other resorts and I loved it.&amp;nbsp; It was everything I could have asked for and more!&lt;\/p&gt;","Attachments":[],"Id":1893258,"PostDate":1429133085,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I fell in love with NS looking at photos from other brides.\u00a0 As soon as I saw the Tequila Terrace I knew I wanted to have my wedding there.\u00a0 It had something different from all the other resorts and I loved it.\u00a0 It was everything I could have asked for and more!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"dinaskates84@hotmail.com","IpAddress":"74.12.203.194","GroupId":40,"GroupName":"Jr. Member","JoinDate":1341078220,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-257303.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"DinaQtobe","Id":257303,"Name":"DinaQtobe","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"142.161.170.48","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79064,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"752438f30941727ada2eefbe085090dc","RawContent":"&lt;p&gt;Congrats on narrowing down your choices for your upcoming dw to two venues! Either one of your choices will make a wonderful backdrop for your magical wedding \"moments that matter\" photos as you can see here......&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;...captured at the &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;\/\/www.facebook.com\/media\/set\/?set=a.10152285887359487.1073741881.18683524486&amp;amp;type=3&#039;&gt;NOW Sapphire Wedding Album&lt;\/a&gt;:&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord.xx.fbcdn.net\/hphotos-xfp1\/t31.0-8\/1909431_10152285892349487_154319466_o.jpg\" alt=\"1909431_10152285892349487_154319466_o.jp\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord.xx.fbcdn.net\/hphotos-xaf1\/t31.0-8\/1781021_10152285893614487_337915281_o.jpg\" alt=\"1781021_10152285893614487_337915281_o.jp\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;...or these samples from the &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10152879942949487.1073741913.18683524486&amp;amp;type=3&#039;&gt;NOW Jade Wedding Album&lt;\/a&gt;:&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord.xx.fbcdn.net\/hphotos-xap1\/t31.0-8\/10828083_10152879945629487_385058951217096100_o.jpg\" alt=\"10828083_10152879945629487_3850589512170\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/fbcdn-sphotos-e-a.akamaihd.net\/hphotos-ak-xfa1\/t31.0-8\/10481829_10152879945984487_3218129313193200416_o.jpg\" alt=\"10481829_10152879945984487_3218129313193\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Wishing you happy research, and all the best with your plans - cheers!!! team MTM :)&lt;\/p&gt;","Attachments":[],"Id":1893263,"PostDate":1429139498,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats on narrowing down your choices for your upcoming dw to two venues! Either one of your choices will make a wonderful backdrop for your magical wedding \"moments that matter\" photos as you can see here......<\/p>\n<p>\u00a0<\/p>\n<p>...captured at the <a href='\/\/www.facebook.com\/media\/set\/?set=a.10152285887359487.1073741881.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>NOW Sapphire Wedding Album<\/a>:<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord.xx.fbcdn.net\/hphotos-xfp1\/t31.0-8\/1909431_10152285892349487_154319466_o.jpg\" alt=\"1909431_10152285892349487_154319466_o.jp\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord.xx.fbcdn.net\/hphotos-xaf1\/t31.0-8\/1781021_10152285893614487_337915281_o.jpg\" alt=\"1781021_10152285893614487_337915281_o.jp\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>...or these samples from the <a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10152879942949487.1073741913.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>NOW Jade Wedding Album<\/a>:<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord.xx.fbcdn.net\/hphotos-xap1\/t31.0-8\/10828083_10152879945629487_385058951217096100_o.jpg\" alt=\"10828083_10152879945629487_3850589512170\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/fbcdn-sphotos-e-a.akamaihd.net\/hphotos-ak-xfa1\/t31.0-8\/10481829_10152879945984487_3218129313193200416_o.jpg\" alt=\"10481829_10152879945984487_3218129313193\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>Wishing you happy research, and all the best with your plans - cheers!!! team MTM <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280210660,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.41.59","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79064,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"c0fb026b2f46c0168225f4d47af6070b","RawContent":"[quote name=\"racht33\" post=\"1893222\" timestamp=\"1429122175\"]\nIts  the look fianc\u00e9 and I really like. Plus the ceremony\/reception areas at now jade just win my heart so much more!! and You cant beat a rain shower!!!  Your wedding is coming so close!!! You must be so excited!! @[member=\"candle23\"][\/quote]Hehehe hers was a 2014 date :) she&#039;s a veteran on here!\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1893265,"PostDate":1429140889,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>racht33, on 15 April 2015 - 10:22 AM, said:<\/p><div class='blockquote'><div class='quote'><p>Its  the look fianc\u00e9 and I really like. Plus the ceremony\/reception areas at now jade just win my heart so much more!! and You cant beat a rain shower!!!  Your wedding is coming so close!!! You must be so excited!! @<a hovercard-ref=\"member\" hovercard-id=\"272291\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/272291-candle23\/' title='Member profile'><span itemprop=\"name\">candle23<\/span><\/a><\/p><\/div><\/div>\n<br>\nHehehe hers was a 2014 date <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> she's a veteran on here!<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399428602,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.222.215.164","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79064,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"52509244ee7ec9983b3f8b7723813c4d","RawContent":"[quote name=\"calgarybride2015\" post=\"1893265\" timestamp=\"1429140889\"]\nHehehe hers was a 2014 date :) she&#039;s a veteran on here!\nSent from my iPhone using Tapatalk[\/quote]Yup! I am an old married lady now! Pregnant even! The hubs and I were just talking about how last year at this time we really just got into wedding planning mode and only one short year later here we are married with our first little human on the way!! Happy planning!!","Attachments":[],"Id":1893329,"PostDate":1429194338,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>calgarybride2015, on 15 April 2015 - 03:34 PM, said:<\/p><div class='blockquote'><div class='quote'><p>Hehehe hers was a 2014 date <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> she's a veteran on here!<br>\nSent from my iPhone using Tapatalk<\/p><\/div><\/div>\n<br>\nYup! I am an old married lady now! Pregnant even! The hubs and I were just talking about how last year at this time we really just got into wedding planning mode and only one short year later here we are married with our first little human on the way!! Happy planning!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"candle_23@hotmail.com","IpAddress":"66.222.215.154","GroupId":40,"GroupName":"Jr. Member","JoinDate":1375761701,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272291.jpg?_r=1388954341","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"candle23","Id":272291,"Name":"candle23","IsOnline":false}}],"Id":"79064","Title":"Now Sapphire \/now Jade Brides","LastPostDate":1429194338},"Pages":{"TotalItems":10,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
