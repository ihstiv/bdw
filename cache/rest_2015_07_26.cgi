{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":9,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":951,"MovedTo":null,"MovedOn":0,"FirstPostId":1849902,"Rating":0,"RatingHits":0,"Starter":{"Id":277925,"Name":"Nadika","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277925.jpg?_r=1400290290","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"StartDate":1399890155,"LastPoster":{"Id":282237,"Name":"lab209","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":74,"Preview":{"Id":1849902,"PostDate":1399890155,"PostContent":"Does anyone have any cute poems or ideas of what we could say on the welcome letter that will go...","Author":{"Signature":"<p><span style=\"font-size:24px;\"><strong><span style=\"color:#00b0f0;\"><span style=\"font-family:amienne;\">The real act of marriage takes place in the heart, not in the ballroom or church or synagogue. It's a choice you make - not just on your wedding day, but over and over again - and that choice is reflected in the way you treat your husband or wife.<\/span><\/span><\/strong><\/span><\/p>\n<p><span style=\"font-size:24px;\"><strong><span style=\"color:#00b0f0;\"><span style=\"font-family:amienne;\">Barbara de Angelis<\/span><\/span><\/strong><\/span><\/p>\n<p>\u00a0","Email":"nadikamorgan@hotmail.com","IpAddress":"82.46.189.41","GroupId":39,"GroupName":"Newbie","JoinDate":1399869828,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277925.jpg?_r=1400290290","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"Nadika","Id":277925,"Name":"Nadika","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"82.46.189.41","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77046,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8694925d9e069717b54cba9270a5eaef","RawContent":"&lt;p&gt;\nDoes anyone have any cute poems or ideas of what we could say on the welcome letter that will go inside the OOT bags for the hotel rooms???&lt;\/p&gt;\n&lt;p&gt;\nI have some ideas of what we could use but I wanted it to be a little more creative and fun than just;&lt;\/p&gt;\n&lt;p&gt;\n\"Welcome to our wedding, we hope you find the contents of this bag useful in your stay! Thank you so much for being a part of our Special Day, All our love&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;dnd&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Help&lt;\/p&gt;","Attachments":[],"Id":1849902,"PostDate":1399890155,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>\nDoes anyone have any cute poems or ideas of what we could say on the welcome letter that will go inside the OOT bags for the hotel rooms???<\/p>\n<p>\nI have some ideas of what we could use but I wanted it to be a little more creative and fun than just;<\/p>\n<p>\n\"Welcome to our wedding, we hope you find the contents of this bag useful in your stay! Thank you so much for being a part of our Special Day, All our love<\/p>\n<p>\u00a0<\/p>\n<p>dnd<\/p>\n<p>\u00a0<\/p>\n<p>Help<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-size:24px;\"><strong><span style=\"color:#00b0f0;\"><span style=\"font-family:amienne;\">The real act of marriage takes place in the heart, not in the ballroom or church or synagogue. It's a choice you make - not just on your wedding day, but over and over again - and that choice is reflected in the way you treat your husband or wife.<\/span><\/span><\/strong><\/span><\/p>\n<p><span style=\"font-size:24px;\"><strong><span style=\"color:#00b0f0;\"><span style=\"font-family:amienne;\">Barbara de Angelis<\/span><\/span><\/strong><\/span><\/p>\n<p>\u00a0","Email":"nadikamorgan@hotmail.com","IpAddress":"82.46.189.41","GroupId":39,"GroupName":"Newbie","JoinDate":1399869828,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277925.jpg?_r=1400290290","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"Nadika","Id":277925,"Name":"Nadika","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"162.138.210.3","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77046,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6f6dd5d757a90bbd49ee701bfb5fb1c1","RawContent":"&lt;p&gt;Put a schedule in the bag.&amp;nbsp; Just basic saying gather at this time, at this location for xx.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We e-mailed our schedule out before hand and also put it in the bag.&amp;nbsp; Then we didn&#039;t have to run around making sure people knew.&amp;nbsp; Times that seem obvious our guests would forget because they were in vacation mode. &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1849923,"PostDate":1399894193,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Put a schedule in the bag.\u00a0 Just basic saying gather at this time, at this location for xx.<\/p>\n<p>\u00a0<\/p>\n<p>We e-mailed our schedule out before hand and also put it in the bag.\u00a0 Then we didn't have to run around making sure people knew.\u00a0 Times that seem obvious our guests would forget because they were in vacation mode. \u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"batesj@sec.gov","IpAddress":"162.138.210.3","GroupId":39,"GroupName":"Newbie","JoinDate":1389185283,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"lukose","Id":275936,"Name":"lukose","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.87.31.101","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77046,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"36bcd75a993f15aa39ae814ae13f4fc0","RawContent":"[quote name=\"lukose\" post=\"1849923\" timestamp=\"1399908593\"]\nPut a schedule in the bag.  Just basic saying gather at this time, at this location for xx.\n \nWe e-mailed our schedule out before hand and also put it in the bag.  Then we didn&#039;t have to run around making sure people knew.  Times that seem obvious our guests would forget because they were in vacation mode.\n[\/quote]Great idea:)","Attachments":[],"Id":1851311,"PostDate":1400560076,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>lukose, on 12 May 2014 - 11:29 AM, said:<\/p><div class='blockquote'><div class='quote'><p>Put a schedule in the bag.\u00a0 Just basic saying gather at this time, at this location for xx.<br>\n\u00a0<br>\nWe e-mailed our schedule out before hand and also put it in the bag.\u00a0 Then we didn't have to run around making sure people knew.\u00a0 Times that seem obvious our guests would forget because they were in vacation mode.<br><\/p><\/div><\/div>\n<br>\nGreat idea:)\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rheanna@uwalumni.com","IpAddress":"75.135.169.141","GroupId":40,"GroupName":"Jr. Member","JoinDate":1400445451,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278018.jpg?_r=1410892817","PhotoWidth":200,"PhotoHeight":131,"PhotoType":"custom"},"FormattedName":"Rheannarudy","Id":278018,"Name":"Rheannarudy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.62.217.165","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77046,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"cf4fa7b6baec4fbb9b95157b463ac7a6","RawContent":"&lt;p&gt;I put on ours-&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Welcome&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We are so happy that you are here to share the joy of our wedding day! We are fortunate to have each of you in our lives, and feel honored that you have traveled great distance to be with us.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We hope you have a wonderful stay at Secrets Capri Riviera Cancun, and look forward to spending the next few days in paradise with you!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;With love and appreciation&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Amanda &amp;amp; Jason&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Its on a card the same size as our invitations were printed on (trying to recycle, not spend more!!! lol)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I added an itenerary that is attached to it, I&#039;m not sure if I want to add anything else or not though. Still working on them-&lt;\/p&gt;","Attachments":[],"Id":1853122,"PostDate":1401637075,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I put on ours-<\/p>\n<p>\u00a0<\/p>\n<p>Welcome<\/p>\n<p>\u00a0<\/p>\n<p>We are so happy that you are here to share the joy of our wedding day! We are fortunate to have each of you in our lives, and feel honored that you have traveled great distance to be with us.<\/p>\n<p>\u00a0<\/p>\n<p>We hope you have a wonderful stay at Secrets Capri Riviera Cancun, and look forward to spending the next few days in paradise with you!<\/p>\n<p>\u00a0<\/p>\n<p>With love and appreciation<\/p>\n<p>\u00a0<\/p>\n<p>Amanda & Jason<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Its on a card the same size as our invitations were printed on (trying to recycle, not spend more!!! lol)<\/p>\n<p>\u00a0<\/p>\n<p>I added an itenerary that is attached to it, I'm not sure if I want to add anything else or not though. Still working on them-<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"amanda.hodges1@snhu.edu","IpAddress":"24.62.217.165","GroupId":39,"GroupName":"Newbie","JoinDate":1398523937,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277733.jpg?_r=1400873765","PhotoWidth":200,"PhotoHeight":213,"PhotoType":"custom"},"FormattedName":"BusyBee280","Id":277733,"Name":"BusyBee280","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.101.152.253","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77046,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4b14114cb2fa01a21341727dacf8645f","RawContent":"[quote name=\"BusyBee280\" post=\"1853122\" timestamp=\"1401651475\"]\nI put on ours-\n \nWelcome\n \nWe are so happy that you are here to share the joy of our wedding day! We are fortunate to have each of you in our lives, and feel honored that you have traveled great distance to be with us.\n \nWe hope you have a wonderful stay at Secrets Capri Riviera Cancun, and look forward to spending the next few days in paradise with you!\n \nWith love and appreciation\n \nAmanda &amp;amp; Jason\n \n \n \nIts on a card the same size as our invitations were printed on (trying to recycle, not spend more!!! lol)\n \nI added an itenerary that is attached to it, I&#039;m not sure if I want to add anything else or not though. Still working on them-[\/quote]Did you make your own or did you order them ?","Attachments":[],"Id":1854052,"PostDate":1401970772,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>BusyBee280, on 01 June 2014 - 03:37 PM, said:<\/p><div class='blockquote'><div class='quote'><p>I put on ours-<br>\n\u00a0<br>\nWelcome<br>\n\u00a0<br>\nWe are so happy that you are here to share the joy of our wedding day! We are fortunate to have each of you in our lives, and feel honored that you have traveled great distance to be with us.<br>\n\u00a0<br>\nWe hope you have a wonderful stay at Secrets Capri Riviera Cancun, and look forward to spending the next few days in paradise with you!<br>\n\u00a0<br>\nWith love and appreciation<br>\n\u00a0<br>\nAmanda & Jason<br>\n\u00a0<br>\n\u00a0<br>\n\u00a0<br>\nIts on a card the same size as our invitations were printed on (trying to recycle, not spend more!!! lol)<br>\n\u00a0<br>\nI added an itenerary that is attached to it, I'm not sure if I want to add anything else or not though. Still working on them-<\/p><\/div><\/div>\n<br>\nDid you make your own or did you order them ? \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>55 guests booked plus bride and groom <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>","Email":"drkt0010@hotmail.com","IpAddress":"50.101.144.156","GroupId":40,"GroupName":"Jr. Member","JoinDate":1396294378,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277431.jpg?_r=1423500629","PhotoWidth":200,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"Dreamteam17","Id":277431,"Name":"Dreamteam17","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"216.200.128.254","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77046,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"dc544383455d32a7fab5d82fef7b192a","RawContent":"&lt;p&gt;I plan on making something like this: &amp;nbsp;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.pinterest.com\/pin\/47358233556460151\/&#039;&gt;http:\/\/www.pinterest.com\/pin\/47358233556460151\/&lt;\/a&gt;&lt;\/p&gt;","Attachments":[],"Id":1854919,"PostDate":1402581741,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I plan on making something like this: \u00a0<a href='http:\/\/www.pinterest.com\/pin\/47358233556460151\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.pinterest...58233556460151\/<\/a><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>30 guests, Bride & Groom & 2 kids - one FANTASTIC time!<\/p>\n<p>\u00a0<\/p>\n<p><strong>Planning Thread<\/strong> - Includes lots of DIY (picture-heavy)<br><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/77321-marinah84s-planning-thread-31415-crown-paradise-club-cancun\/\"><span style=\"color:rgb(0,0,255);\">http:\/\/www.bestdestinationwedding.com\/topic\/77321-marinah84s-planning-thread-31415-crown-paradise-club-cancun\/<\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p><strong>Underwater Trash The Dress Session Photos<\/strong> - Samuel Luna (Photographer)<\/p>\n<p><a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/media\/set\/?set=a.784031153664.1073741863.54300091&type=1&l=a8a5688cd7'>https:\/\/www.facebook.com\/media\/set\/?set=a.784031153664.1073741863.54300091&type=1&l=a8a5688cd7<\/a><\/p>\n<p>\u00a0<\/p>\n<p><strong>Resort Review<\/strong> - <em>Crown Paradise Club Cancun<\/em><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77321-marinah84s-planning-thread-31415-crown-paradise-club-cancun\/page-28#entry1894872'>http:\/\/www.bestdestinationwedding.com\/topic\/77321-marinah84s-planning-thread-31415-crown-paradise-club-cancun\/page-28#entry1894872<\/a><\/p>\n<p>\u00a0<\/p>\n<p><strong>Photographer Review <\/strong>- <em>Samuel Luna<\/em> - Coming Soon!<\/p>\n<p>\u00a0<\/p>\n<p><strong>Makeup\/Hair Artist Review\u00a0<\/strong>-\u00a0<em>Sara Tamargo<\/em><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4968-sara-tamargo-makeup-artistry\/'>http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4968-sara-tamargo-makeup-artistry\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p><strong>For Sale Items<\/strong> -\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79146-wedding-items-for-sale\/#entry1895327'>http:\/\/www.bestdestinationwedding.com\/topic\/79146-wedding-items-for-sale\/#entry1895327<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"marinarhianne@gmail.com","IpAddress":"67.149.51.114","GroupId":40,"GroupName":"Jr. Member","JoinDate":1387570652,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275696.jpg?_r=1429206783","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"marinah84","Id":275696,"Name":"marinah84","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.226.199.68","Is