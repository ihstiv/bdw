IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":6165,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e321f0e6a600c0dbabf9f2e391cb4f1b","RawContent":"&lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/bump.gif\" border=\"0\" alt=\"\" title=\"Bump\" class=\"inlineimg\" \/&gt;&lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/bump.gif\" border=\"0\" alt=\"\" title=\"Bump\" class=\"inlineimg\" \/&gt;&lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/bump.gif\" border=\"0\" alt=\"\" title=\"Bump\" class=\"inlineimg\" \/&gt;\n \n for newbies and not so newbies","Attachments":[],"Id":251438,"PostDate":1207173809,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/bump.gif\" border=\"0\" alt=\"\" title=\"Bump\" class=\"inlineimg\" \/><\/span><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/bump.gif\" border=\"0\" alt=\"\" title=\"Bump\" class=\"inlineimg\" \/><\/span><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/bump.gif\" border=\"0\" alt=\"\" title=\"Bump\" class=\"inlineimg\" \/><\/span><br \/> <br \/> for newbies and not so newbies\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<strong>Christine + Will (married 7\/20\/07) + Ainsleigh (born 6\/25\/08) + Nolan (born 11\/9\/10) + Delaney (born 12\/31\/13) = One Very Happy Family!<\/strong>","Email":"christine@dc-hulls.com","IpAddress":"167.154.70.240","GroupId":46,"GroupName":"VIP Member","JoinDate":1165971180,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206965.gif?_r=0","PhotoWidth":100,"PhotoHeight":67,"PhotoType":"custom"},"FormattedName":"Christine","Id":206965,"Name":"Christine","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":6165,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4436c96faf78302adf87ac56e5ee8670","RawContent":"Hi, \n Thank you for the warm welcome. Before I post in the newbie section I read through your rules and etiquette to make sure it is ok for me to be on your forum. I have been married for 9 years so I am not planning a wedding, however, I do destination wedding photography all over the world and thought I could lend some advice to brides (and grooms) who may have questions about photography (questions to ask their photographer overseas, the benefits of a local photographer and the benefits of bringing a photographer, costs, etc). Which leads to my question...is it ok for me to be on this forum? I appreciate very much the service you provide and want to follow any rules you have.\n \n Katie Moos","Attachments":[],"Id":323003,"PostDate":1212204575,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi, <br \/> Thank you for the warm welcome. Before I post in the newbie section I read through your rules and etiquette to make sure it is ok for me to be on your forum. I have been married for 9 years so I am not planning a wedding, however, I do destination wedding photography all over the world and thought I could lend some advice to brides (and grooms) who may have questions about photography (questions to ask their photographer overseas, the benefits of a local photographer and the benefits of bringing a photographer, costs, etc). Which leads to my question...is it ok for me to be on this forum? I appreciate very much the service you provide and want to follow any rules you have.<br \/> <br \/> Katie Moos\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"info@katiemoos.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1212170585,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209662.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Katie Moos Photography","Id":209662,"Name":"Katie Moos Photography","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":6165,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2157e1e30236c5a0b181d072b10d9e17","RawContent":"correct - please read these rules and let us know if you have any questions!","Attachments":[],"Id":323197,"PostDate":1212238568,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n              