n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> The are Awesome!! You did a great job!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jandp.wedding@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1369284443,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-269886.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Miss J","Id":269886,"Name":"Miss J","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":74238,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5a3bbecf7cca4a877bc1bcdfc339e07d","RawContent":"How long did it take you to do all these?","Attachments":[],"Id":1767016,"PostDate":1370976787,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                How long did it take you to do all these?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"j.ramoutar@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1358011004,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-264317.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"jenn4285","Id":264317,"Name":"jenn4285","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":74238,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"79e474ade2f9f6e07f8a3e5fbab82667","RawContent":"Thanks everyone!!!!! Guess I have to wait until tomorrow before anyone starts to receive them...... No calls\/ messages today! Jenn- from idea, through design, redesign, printing, cutting, putting together, i would estimate about 40 hours......all done within a week hahaha. I was a but rushed and had to get them out this week. Though the longest was definitely putting them together- that was easily 30 hours (from last tuesday to mailing them out yesterday).","Attachments":[],"Id":1767091,"PostDate":1370986371,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks everyone!!!!! Guess I have to wait until tomorrow before anyone starts to receive them...... No calls\/ messages today! Jenn- from idea, through design, redesign, printing, cutting, putting together, i would estimate about 40 hours......all done within a week hahaha. I was a but rushed and had to get them out this week. Though the longest was definitely putting them together- that was easily 30 hours (from last tuesday to mailing them out yesterday).\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jenny.mccallum@gmail.com","IpAddress":"24.114.49.159","GroupId":3,"GroupName":"Member","JoinDate":1351073287,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-261719.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Jenny2014","Id":261719,"Name":"Jenny2014","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":74238,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"083c4dec644a46eeda0756a85a892788","RawContent":"&lt;p&gt; well that was time well spent!&lt;\/p&gt;","Attachments":[],"Id":1767096,"PostDate":1370986908,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> well that was time well spent!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"j.ramoutar@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1358011004,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-264317.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"jenn4285","Id":264317,"Name":"jenn4285","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"I