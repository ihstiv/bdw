idth":733,"Height":550}],"Id":1894055,"PostDate":1429784636,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi ladies,<\/p>\n<p>I was at my local ikea the other day. \u00a0I got these lanterns for $4.99 THE BIG one its \"member special\" normally $14.99! \u00a0Saved $90! \u00a0<a href='http:\/\/www.ikea.com\/us\/en\/catalog\/products\/00252861\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.ikea.com\/...ducts\/00252861\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>I also found my OOT bags there these were\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Gian-Luigi & Susan September 13, 2015 Finest Resort <a data-ipb='nomediaparse' href='http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A'>http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A<\/a>","Email":"susanlaurelli@yahoo.com","IpAddress":"47.17.228.244","GroupId":39,"GroupName":"Newbie","JoinDate":1414843804,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280946.jpg?_r=1437865075","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"SusanMarie813","Id":280946,"Name":"SusanMarie813","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"154.20.36.21","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79100,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"32714f18cd44799df8be9a9dea91a7b3","RawContent":"&lt;p&gt;Both great finds! I&amp;nbsp; love the lanterns,, I am always looking for good deals and was thinking about doing lanterns for centerpieces too! I don&#039;t have an ikea where I live but maybe I can purchase online! Thanks for sharing :)&lt;\/p&gt;","Attachments":[],"Id":1894057,"PostDate":1429785115,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Both great finds! I\u00a0 love the lanterns,, I am always looking for good deals and was thinking about doing lanterns for centerpieces too! I don't have an ikea where I live but maybe I can purchase online! Thanks for sharing <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"millar_devon@hotmail.com","IpAddress":"154.20.36.21","GroupId":39,"GroupName":"Newbie","JoinDate":1423314913,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282027.jpg?_r=1429713632","PhotoWidth":169,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Victoriabride","Id":282027,"Name":"Victoriabride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"38.112.94.76","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79100,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3ed2a34dfdfc71c06b85b5aaa47de5af","RawContent":"&lt;p&gt;@SusanMarie813&amp;nbsp; Fun!&amp;nbsp; How much were the beach bags?&amp;nbsp; Those were from Ikea as well?&lt;\/p&gt;","Attachments":[],"Id":1894062,"PostDate":1429787658,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@SusanMarie813\u00a0 Fun!\u00a0 How much were the beach bags?\u00a0 Those were from Ikea as well?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div><br><div>\u00a0<\/div>\n<div>\u00a0<\/div>\n<div>Married on June 20th, 2015 at the Grand Sunset Princess Riviera Gazebo & Reception at the Chill Out with 60 guests<\/div>\n<div>\u00a0<\/div>\n<\/div>\n<div>\u00a0<\/div>\n<p>My planning thread:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/<\/a><\/p>\n<p>My review thread: \u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/<\/a>","Email":"rebecca.valero@gmail.com","IpAddress":"38.112.94.76","GroupId":3,"GroupName":"Member","JoinDate":1396968452,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277519.jpg?_r=1435850174","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"veryvalentine","Id":277519,"Name":"veryvalentine","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"192.249.47.212","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79100,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c69fc1fe044c038f7ec3e8b9f0f731b5","RawContent":"&lt;p&gt;I love the lanterns!! This is an awesome find~ Thank you for sharing!&lt;\/p&gt;","Attachments":[],"Id":1894070,"PostDate":1429791010,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I love the lanterns!! This is an awesome find~ Thank you for sharing!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>57 Guest","Email":"racht33@yahoo.com","IpAddress":"192.249.47.212","GroupId":3,"GroupName":"Member","JoinDate":1422618588,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281952.jpg?_r=1424197509","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"racht33","Id":281952,"Name":"racht33","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"170.200.168.13","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79100,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"810eea0cb591c63e8e0b4a7f60f973fb","RawContent":"[quote name=\"veryvalentine\" post=\"1894062\" timestamp=\"1429802058\"]\n@SusanMarie813  Fun!  How much were the beach bags?  Those were from Ikea as well?[\/quote]@[member=\"veryvalentine\"] they were $3.99 each at ikea.  They were in a bin by the cash register\n\nThe lanterns were a special you have to become an ikea member which takes 3 minutes to do at any kiosk.  \nThey only have the black ones on sale.","Attachments":[],"Id":1894253,"PostDate":1429884676,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>veryvalentine, on 23 April 2015 - 11:14 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>@SusanMarie813\u00a0 Fun!\u00a0 How much were the beach bags?\u00a0 Those were from Ikea as well?<\/p>\n<\/div>\n<\/div><\/div>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"277519\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277519-veryvalentine\/' title='Member profile'><span itemprop=\"name\">veryvalentine<\/span><\/a> they were $3.99 each at ikea. \u00a0They were in a bin by the cash register<\/p><br \/><p>The lanterns were a special you have to become an ikea member which takes 3 minutes to do at any kiosk. \u00a0<\/p>\n<p>They only have the black ones on sale. \u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Gian-Luigi & Susan September 13, 2015 Finest Resort <a data-ipb='nomediaparse' href='http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A'>http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A<\/a>","Email":"susanlaurelli@yahoo.com","IpAddress":"47.17.228.244","GroupId":39,"GroupName":"Newbie","JoinDate":1414843804,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280946.jpg?_r=1437865075","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"SusanMarie813","Id":280946,"Name":"SusanMarie813","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.94.109.103","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79100,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a4e4c8094c791c2cbe8c86b45db35065","RawContent":"those bags are great! love ikea","Attachments":[],"Id":1894305,"PostDate":1429903448,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                those bags are great! love ikea\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jaspbri0317@aol.com","IpAddress":"71.58.144.195","GroupId":39,"GroupName":"Newbie","JoinDate":1296673627,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-236302.jpg?_r=1429022808","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"jaspbri0317","Id":236302,"Name":"jaspbri0317","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"142.56.86.35","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79100,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"bad361bcc3d7e811d9ca4f956564d211","RawContent":"&lt;p&gt;@[member=\"SusanMarie813\"]&lt;\/p&gt;\n&lt;p&gt;Oh my gosh! I&#039;ve been trying to find affordable white lanters! Why I never thought to look at IKEA is beyond me. Thank goodness I have a day off on Friday. Looks like I&#039;m going shopping hahahah Thanks!&lt;\/p&gt;","Attachments":[],"Id":1897858,"PostDate":1433349854,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"280946\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/280946-susanmarie813\/' title='Member profile'><span itemprop=\"name\">SusanMarie813<\/span><\/a><\/p>\n<p>Oh my gosh! I've been trying to find affordable white lanters! Why I never thought to look at IKEA is beyond me. Thank goodness I have a day off on Friday. Looks like I'm going shopping hahahah Thanks!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>~*~YYCBRIDE2016~*~<\/p><p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79227-yycbride2016-grand-sirenis-planning-thread-february-2016\/'>My planning thread\u00a0<\/a><\/p><p>\u00a0<\/p><p><a class='bbc_url' href='http:\/\/www.TickerFactory.com\/'><br><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10730;484\/st\/20160223\/e\/Our+Wedding\/dt\/-1\/k\/4bd8\/event.png\" alt=\"event.png\"><br><\/a><br>\u00a0","Email":"janellepaquin@hotmail.com","IpAddress":"162.157.216.37","GroupId":40,"GroupName":"Jr. Member","JoinDate":1432086904,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283167.jpg?_r=1432133572","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"yycbride2016","Id":283167,"Name":"yycbride2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.146.146.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79100,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"cf8d87d3acd9d6ece911d68b39c6e73f","RawContent":"[quote name=\"yycbride2016\" post=\"1897858\" timestamp=\"1433364254\"]\n@[member=\"SusanMarie813\"]\nOh my gosh! I&#039;ve been trying to find affordable white lanters! Why I never thought to look at IKEA is beyond me. Thank goodness I have a day off on Friday. Looks like I&#039;m going shopping hahahah Thanks![\/quote]They are nice. I was tempted to buy some the week before we left. I also saw some at Superstore a month back in white blue or orange. \n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1897859,"PostDate":1433362962,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>yycbride2016, on 03 June 2015 - 04:44 PM, said:<\/p><div class='blockquote'><div class='quote'><p>@<a hovercard-ref=\"member\" hovercard-id=\"280946\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/280946-susanmarie813\/' title='Member profile'><span itemprop=\"name\">SusanMarie813<\/span><\/a><br>\nOh my gosh! I've been trying to find affordable white lanters! Why I never thought to look at IKEA is beyond me. Thank goodness I have a day off on Friday. Looks like I'm going shopping hahahah Thanks!<\/p><\/div><\/div>\n<br>\nThey are nice. I was tempted to buy some the week before we left. I also saw some at Superstore a month back in white blue or orange. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}}],"Id":"79100","Title":"Oot Bags And Centerpieces - Good Deal","LastPostDate":1433362962},"Pages":{"TotalItems":8,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
