{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":46,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":3961,"MovedTo":null,"MovedOn":0,"FirstPostId":1118084,"Rating":0,"RatingHits":0,"Starter":{"Id":225370,"Name":"skadow","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-225370.jpg?_r=0","PhotoWidth":150,"PhotoHeight":129,"PhotoType":"custom"},"IsOnline":false},"StartDate":1271562074,"LastPoster":{"Id":282981,"Name":"august2215","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":33,"Preview":{"Id":1118084,"PostDate":1271562074,"PostContent":"Where are you girls getting your wedding dress undergarments \/ lingerie?  I want something that w...","Author":{"Signature":"","Email":"sarakadow@yaho.com","IpAddress":"","GroupId":5,"GroupName":"Banned","JoinDate":1265426869,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-225370.jpg?_r=0","PhotoWidth":150,"PhotoHeight":129,"PhotoType":"custom"},"FormattedName":"skadow","Id":225370,"Name":"skadow","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":false,"TopicId":50895,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bf3914d5de93ed88593c734d55f77066","RawContent":"Where are you girls getting your wedding dress undergarments \/ lingerie?\n \n I want something that will hold it all in under my dress, AND look sexy for later. (at least semi sexy) Maybe a white lace corset type.\n \n I know David&#039;s Bridal has a few. They only sell the lace on online so I couldnt try it on in the store. I couldnt find anything at Victoria Secrets. I am sure I could find something online in a search ,but I want something repuable.","Attachments":[],"Id":1118084,"PostDate":1271562074,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Where are you girls getting your wedding dress undergarments \/ lingerie?<br \/> <br \/> I want something that will hold it all in under my dress, AND look sexy for later. (at least semi sexy) Maybe a white lace corset type.<br \/> <br \/> I know David's Bridal has a few. They only sell the lace on online so I couldnt try it on in the store. I couldnt find anything at Victoria Secrets. I am sure I could find something online in a search ,but I want something repuable.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sarakadow@yaho.com","IpAddress":"","GroupId":5,"GroupName":"Banned","JoinDate":1265426869,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-225370.jpg?_r=0","PhotoWidth":150,"PhotoHeight":129,"PhotoType":"custom"},"FormattedName":"skadow","Id":225370,"Name":"skadow","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50895,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"71f12e4152d982f6e715fb4a6e9ffc32","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;skadow&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Where are you girls getting your wedding dress undergarments \/ lingerie.\n \n I want something that will hold it all in under my dress, AND look sexy for later. (at least semi sexy) Maybe a white lace corset type.\n \n I know David&#039;s Bridal has a few. They only sell the lace on online so I couldnt try it on in the store. I couldnt find anything at Victoria Secrets. I am sure I could find something online in a search ,but I want something repuable.&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;I am not sure about wearing a corset. They become very uncomfortable very quick. I am a bartender and have to wear one once a month for about 9 hours. After about 5 hours, it drives me crazy. They are very pretty, but you pay a price wearing one. I am going with a lacy bra and panties.","Attachments":[],"Id":1118091,"PostDate":1271562760,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>skadow<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Where are you girls getting your wedding dress undergarments \/ lingerie.<br \/> <br \/> I want something that will hold it all in under my dress, AND look sexy for later. (at least semi sexy) Maybe a white lace corset type.<br \/> <br \/> I know David's Bridal has a few. They only sell the lace on online so I couldnt try it on in the store. I couldnt find anything at Victoria Secrets. I am sure I could find something online in a search ,but I want something repuable.<\/div> <\/td> <\/tr> <\/table> <\/div>I am not sure about wearing a corset. They become very uncomfortable very quick. I am a bartender and have to wear one once a month for about 9 hours. After about 5 hours, it drives me crazy. They are very pretty, but you pay a price wearing one. I am going with a lacy bra and panties.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"RSVP@edynjaxon.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1242146713,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-217475.jpg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"mswhatever","Id":217475,"Name":"mswhatever","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50895,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"539fb16788cf9c547cbd1dbcdef9c40c","RawContent":"i&#039;m not wearing a bra bc its built into my dress. but definately wearing some sexy lace panties.\n on a side note...don&#039;t know about you, but i&#039;m thinking FI (then hubby &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/wink.gif\" border=\"0\" alt=\"\" title=\"Wink\" class=\"inlineimg\" \/&gt;) and I will be a bit tipsy by the time we head upstairs so maybe a corset will be too much to deal with, lol!!","Attachments":[],"Id":1118119,"PostDate":1271569734,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                i'm not wearing a bra bc its built into my dress. but definately wearing some sexy lace panties.<br \/> on a side note...don't know about you, but i'm thinking FI (then hubby <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/wink.gif\" border=\"0\" alt=\"\" title=\"Wink\" class=\"inlineimg\" \/><\/span>) and I will be a bit tipsy by the time we head upstairs so maybe a corset will be too much to deal with, lol!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ctompkins24@hotmail.com","IpAddress":"50.180.178.41","GroupId":42,"GroupName":"Sr. Member","JoinDate":1254280082,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-222144.jpg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"carolina24","Id":222144,"Name":"carolina24","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50895,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cdefb8c4abb7ba4f6ed0cad4054bce2c","RawContent":"Yummy Tummy makes the cutest lacey panties\/corset all in ones. They are super comfortable, easy to remove AND they have snap closed crotch areas for those times you are well..in a hurry &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/wink.gif\" border=\"0\" alt=\"\" title=\"Wink\" class=\"inlineimg\" \/&gt;","Attachments":[],"Id":1118238,"PostDate":1271600176,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Yummy Tummy makes the cutest lacey panties\/corset all in ones. They are super comfortable, easy to remove AND they have snap closed crotch areas for those times you are well..in a hurry <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/wink.gif\" border=\"0\" alt=\"\" title=\"Wink\" class=\"inlineimg\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div>\n<div><a data-ipb='nomediaparse' href='http:\/\/bestdestinationwedding.com\/forum\/f128\/vdaybrides-planning-thread-warning-pics-galore-54918\/'>My Planning Thread<\/a><br><a data-ipb='nomediaparse' href='http:\/\/bestdestinationwedding.com\/forum\/f77\/vdaybrides-dreams-los-cabos-wedding-review-long-55501\/'>My Dreams Los Cabos Review<\/a><\/div>\n<div><span>Married 2-14-2010 Dreams, Los Cabos<\/span><\/div>\n<\/div>\n<p>\u00a0<\/p>\n","Email":"itherapysolutions@gmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1256427794,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-222825.gif?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"vdaybride","Id":222825,"Name":"vdaybride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50895,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7fa65e870dc19b33576726dde5961d30","RawContent":"Since its going to be sooo hot outside, I was thinking of wearing something light (lace undies\/bra) and then at night when we go to our room, I can go all out and put on a whole sexy outfit... &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/msnwink.gif\" border=\"0\" alt=\"\" title=\"mswink\" class=\"inlineimg\" \/&gt;","Attachments":[],"Id":1118619,"PostDate":1271622337,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Since its going to be sooo hot outside, I was thinking of wearing something light (lace undies\/bra) and then at night when we go to our room, I can go all out and put on a whole sexy outfit... <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/msnwink.gif\" border=\"0\" alt=\"\" title=\"mswink\" class=\"inlineimg\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Married @ Dreams La Romana, Dominican Republic September 10th 2010<\/span><\/div><\/div>","Email":"10weddingbells@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1269542884,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-226789.JPG?_r=0","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"Pink_Petals","Id":226789,"Name":"Pink_Petals","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50895,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0242cb46afd8c3d36404797cdfa3e256","RawContent":"I def regret wearing a corset and the under skirt thing. It was so hott even though it wasnt as hot as it could get, but my goodness it was too much. I didnt wear either for my AHR and I was soooo comfy. I bought them bc the bridal store sold me on it and practically demanded that I need them. Good luck!","Attachments":[],"Id":1118695,"PostDate":1271625938,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I def regret wearing a corset and the under skirt thing. It was so hott even though it wasnt as hot as it could get, but my goodness it was too much. I didnt wear either for my AHR and I was soooo comfy. I bought them bc the bridal store sold me on it and practically demanded that I need them. Good luck!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/www.bestdestinationwedding.com\/t\/55142\/future-mrs2010-tucks-beaches-t-c-review-long-with-pictures\">My Beaches T&C review<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f128\/meag-tucks-future_mrs2010-super-long-planning-thread-pic-heavy-53999\/\">My planning thread<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f77\/tropical-imaging-review-pictures-future_mrs2010-tucks-55570\/\">Tropical Imaging Review w\/pics<\/a><span><\/span><\/div><\/div>","Email":"future_mrs2010@yahoo.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1244217579,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-218156.gif?_r=0","PhotoWidth":100,"PhotoHeight":68,"PhotoType":"custom"},"FormattedName":"*Meagan*","Id":218156,"Name":"*Meagan*","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50895,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"29a5398c71cadc849eb477fe48f3edc5","RawContent":"Anyone wearing Spanx?? That is what I was thinking about wearing. The higher power ones are what I was thinking about to have a smooth look under my dress, but I am not wearing a bra and so I am concerned about the rolling down effect!\n \n Vday: did you wear the yummy tummy?","Attachments":[],"Id":1118722,"PostDate":1271628651,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n     