font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Great ideas! thanks girls<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nicki7985@yahoo.com","IpAddress":"96.235.184.26","GroupId":40,"GroupName":"Jr. Member","JoinDate":1405886652,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279097.jpg?_r=1408764462","PhotoWidth":169,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"NickiLynn1116","Id":279097,"Name":"NickiLynn1116","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"199.168.151.176","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77046,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9262af5ae08280745490a2763e65be36","RawContent":"&lt;p&gt;Great ideas.&amp;nbsp; Thanks for posting!&lt;\/p&gt;","Attachments":[],"Id":1887508,"PostDate":1424876723,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Great ideas.\u00a0 Thanks for posting!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lleat209@yahoo.com","IpAddress":"199.168.151.176","GroupId":39,"GroupName":"Newbie","JoinDate":1424793456,"Photo":{"HasPhoto":false,"PhotoUrl":"h