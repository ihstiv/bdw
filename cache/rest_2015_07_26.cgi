{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":2,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":526,"MovedTo":null,"MovedOn":0,"FirstPostId":1899339,"Rating":0,"RatingHits":0,"Starter":{"Id":283554,"Name":"Mickeyb","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1435269932,"LastPoster":{"Id":282808,"Name":"mia256","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":28,"Preview":{"Id":1899339,"PostDate":1435269932,"PostContent":"Hey everyone.  So far this site has been amazing and super helpful and I am looking for some advi...","Author":{"Signature":"","Email":"bidlofs@gmail.com","IpAddress":"99.226.139.21","GroupId":39,"GroupName":"Newbie","JoinDate":1434403344,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Mickeyb","Id":283554,"Name":"Mickeyb","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"184.151.36.1","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79324,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1c64383339f1074684ef2bd590a22ff7","RawContent":"Hey everyone. \n\n\n\nSo far this site has been amazing and super helpful and I am looking for some advice. My fianc\u00e9 and I finally booked our date and venue and I am now onto photography and am having major dilemmas. \n\n\n\nSo photography is actually very important to me. It&#039;s something I love doing even though I&#039;m not good and something I love looking at. The way k see it is it&#039;s the only thing that&#039;s gonna last. That being said I&#039;m kinda stuck. I know I wanna bring my own photographer with to be safe on quality but here my troubles. \n\n\n\nI am in between two photographers \n\n\nWww.richardsmmanuel.com whose style I really like and he can do some awesome shots as well as under water shots he says. But he&#039;s around 5500 which is high..\n\n\n\nThan there&#039;s www.kesscreativestudios.com who is good but I dunno if it speaks to me as much but is only 2700 or so which is an awesome savings. \n\n\n\nOpinions?? Also what do you think of their photography. \n\n\n\nThanks everyone!!!!!","Attachments":[],"Id":1899339,"PostDate":1435269932,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hey everyone. <br><br><br>\nSo far this site has been amazing and super helpful and I am looking for some advice. My fianc\u00e9 and I finally booked our date and venue and I am now onto photography and am having major dilemmas. <br><br><br>\nSo photography is actually very important to me. It's something I love doing even though I'm not good and something I love looking at. The way k see it is it's the only thing that's gonna last. That being said I'm kinda stuck. I know I wanna bring my own photographer with to be safe on quality but here my troubles. <br><br><br>\nI am in between two photographers <br><br>\nWww.richardsmmanuel.com whose style I really like and he can do some awesome shots as well as under water shots he says. But he's around 5500 which is high..<br><br><br>\nThan there's www.kesscreativestudios.com who is good but I dunno if it speaks to me as much but is only 2700 or so which is an awesome savings. <br><br><br>\nOpinions?? Also what do you think of their photography. <br><br><br>\nThanks everyone!!!!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bidlofs@gmail.com","IpAddress":"99.226.139.21","GroupId":39,"GroupName":"Newbie","JoinDate":1434403344,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Mickeyb","Id":283554,"Name":"Mickeyb","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"189.212.178.170","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79324,"EditedBy":"<strong>Edited by mia256, 28 June 2015 - 01:05 AM.<\/strong>","EditDate":1435453520,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c50dc2777c5bc2f9e8c8dc2575e61ae0","RawContent":"&lt;p&gt;The photographer is one of the key aspects of the wedding, all that you will remember and show to your relatives will be thanks to the photographer!.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;What&#039;s the Venue you&#039;ve chosen? If it&#039;s in Mexico I can give you some advice!&lt;\/p&gt;","Attachments":[],"Id":1899445,"PostDate":1435453507,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>The photographer is one of the key aspects of the wedding, all that you will remember and show to your relatives will be thanks to the photographer!.<\/p>\n<p>\u00a0<\/p>\n<p>What's the Venue you've chosen? If it's in Mexico I can give you some advice!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mercedes.guzman.savalza@gmail.com","IpAddress":"189.212.178.170","GroupId":39,"GroupName":"Newbie","JoinDate":1429577101,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"mia256","Id":282808,"Name":"mia256","IsOnline":false}}],"Id":"79324","Title":"Photography Help","LastPostDate":1435453507},"Pages":{"TotalItems":2,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
