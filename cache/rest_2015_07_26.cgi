{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":6,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":1075,"MovedTo":null,"MovedOn":0,"FirstPostId":1106641,"Rating":0,"RatingHits":0,"Starter":{"Id":226841,"Name":"tonijmccann","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-226841.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"StartDate":1270780379,"LastPoster":{"Id":265353,"Name":"sdbride619","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265353.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":88,"Preview":{"Id":1807419,"PostDate":1381871586,"PostContent":"I am getting married April 29th 2014 in St. Thomas can anyone tell me about the cruise timeline d...","Author":{"Signature":"","Email":"apriljane619@gmail.com","IpAddress":"66.87.66.93","GroupId":39,"GroupName":"Newbie","JoinDate":1359487259,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265353.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"sdbride619","Id":265353,"Name":"sdbride619","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50571,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6ef5e1a0823ac5ec07b38c3731aa115e","RawContent":"Hey girls! I&#039;m getting married on the Carnival Liberty a year from tomorrow. (I know I&#039;m thinking ahead of everything but I like to be prepared!) We are sailing out of Miami. If we get married the day we leave, is there anywhere near the port where I could get hair\/make up done? At least hair? Has anyone done this? \n \n I&#039;d also love to see any photos or comments about weddings on Carnival Liberty! I have tons of questions for anyone who&#039;s had one on that ship.","Attachments":[],"Id":1106641,"PostDate":1270780379,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hey girls! I'm getting married on the Carnival Liberty a year from tomorrow. (I know I'm thinking ahead of everything but I like to be prepared!) We are sailing out of Miami. If we get married the day we leave, is there anywhere near the port where I could get hair\/make up done? At least hair? Has anyone done this? <br \/> <br \/> I'd also love to see any photos or comments about weddings on Carnival Liberty! I have tons of questions for anyone who's had one on that ship.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tonijmccann@aol.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1269708817,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-226841.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"tonijmccann","Id":226841,"Name":"tonijmccann","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50571,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cc924252689c07cfbccadb7a8b647520","RawContent":"I&#039;m having my wedding cruise on the Liberty as well! We are getting married in the beach in St Thomas though so I can&#039;t help you out with your Miami questions. The Liberty is such a beautiful ship (much nicer than Freedom which I was just on in February) - I&#039;m so excited! 52 guests and counting!!!","Attachments":[],"Id":1123436,"PostDate":1271885553,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm having my wedding cruise on the Liberty as well! We are getting married in the beach in St Thomas though so I can't help you out with your Miami questions. The Liberty is such a beautiful ship (much nicer than Freedom which I was just on in February) - I'm so excited! 52 guests and counting!!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"goodtoglow@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1267128179,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-225953.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"goodtoglow","Id":225953,"Name":"goodtoglow","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50571,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9fc0a1efd4aff0df046279c86df613eb","RawContent":"I&#039;m getting married on the Carnival Glory this Sunday out of Miami. I&#039;m using Beauty by Noel (use google to find the website). He&#039;s coming to my hotel on the morning of the wedding to do my hair &amp;amp; makeup. He does all types of hair.","Attachments":[],"Id":1123495,"PostDate":1271888919,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm getting married on the Carnival Glory this Sunday out of Miami. I'm using Beauty by Noel (use google to find the website). He's coming to my hotel on the morning of the wedding to do my hair & makeup. He does all types of hair.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nrsmith80@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1248736492,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-219900.JPG?_r=0","PhotoWidth":200,"PhotoHeight":190,"PhotoType":"custom"},"FormattedName":"shortnsweet7675","Id":219900,"Name":"shortnsweet7675","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50571,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"460864019813962cbc4ffd4cfd5424e5","RawContent":"I&#039;m not sure about Miami itself, but I had a great experience with the salon on the Liberty.\n \n They opened an hour early to accomodate my wedding day itinerary, and my hair was done by one of the men in the salon and I was REALLY happy with it. (I think he was the only male stylist).\n \n They don&#039;t do make-up on the Liberty, so I had a MAC consultation and she was great writing down step by step instructions from brush to use, and brush strokes and it turned out great as well.\n \n Good luck!","Attachments":[],"Id":1126017,"PostDate":1272041463,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm not sure about Miami itself, but I had a great experience with the salon on the Liberty.<br \/> <br \/> They opened an hour early to accomodate my wedding day itinerary, and my hair was done by one of the men in the salon and I was REALLY happy with it. (I think he was the only male stylist).<br \/> <br \/> They don't do make-up on the Liberty, so I had a MAC consultation and she was great writing down step by step instructions from brush to use, and brush strokes and it turned out great as well.<br \/> <br \/> Good luck!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/www.weddingcountdown.com\/ticker\/1g9618ly5.png\">http:\/\/www.weddingcountdown.com\/ticker\/1g9618ly5.png<\/a><\/div><\/div>","Email":"melissadugas@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1211139013,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209468.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"~St.T Bride~","Id":209468,"Name":"~St.T Bride~","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50571,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5691b567e925eaa586cf7f716bd8f373","RawContent":"I am getting married on the Liberty in October and am wondering if anyone can recommend a restaurant for a welcome dinner the night before the wedding.","Attachments":[],"Id":1176495,"PostDate":1275956743,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I am getting married on the Liberty in October and am wondering if anyone can recommend a restaurant for a welcome dinner the night before the wedding.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"codysarawheeler@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1275874864,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-228937.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"luvlygurl78","Id":228937,"Name":"luvlygurl78","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50571,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6fc957bd4239f4607a23ae0b5d3a389e","RawContent":"I am getting married April 29th 2014 in St. Thomas can anyone tell me about the cruise timeline did you feel rushed?","Attachments":[],"Id":1807419,"PostDate":1381871586,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I am getting married April 29th 2014 in St. Thomas can anyone tell me about the cruise timeline did you feel rushed?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"apriljane619@gmail.com","IpAddress":"66.87.66.93","GroupId":39,"GroupName":"Newbie","JoinDate":1359487259,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265353.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"sdbride619","Id":265353,"Name":"sdbride619","IsOnline":false}}],"Id":"50571","Title":"Carnival Liberty Bride sailing out of Miami. Hair\/Makeup questions!","LastPostDate":1381871586},"Pages":{"TotalItems":6,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
