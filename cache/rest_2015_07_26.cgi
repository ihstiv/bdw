Request Time: 1 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":78,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":28363,"MovedTo":null,"MovedOn":0,"FirstPostId":1581116,"Rating":0,"RatingHits":0,"Starter":{"Id":233628,"Name":"acireta","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-233628.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":197,"PhotoType":"custom"},"IsOnline":false},"StartDate":1328922651,"LastPoster":{"Id":282047,"Name":"dathotgal","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282047.jpg?_r=1436938666","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":74,"Preview":{"Id":1581116,"PostDate":1328922651,"PostContent":"We have 13 people (3 singles, 5 couples) sailing with us on the Carnival Liberty and 8 guests (4...","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><p><span>Erica & Al - April 3, 2012 - St. Thomas, USVI<\/span><\/p><span><\/span><p><strong><span><em><a data-ipb='nomediaparse' href=\"http:\/\/www.bestdestinationwedding.com\/t\/78715\/aciretas-planning-journal-april-3-2012-cruise-wedding\">Planning Thread<\/a><\/em><\/span><\/strong><\/p><span><\/span><p><a data-ipb='nomediaparse' href=\"http:\/\/www.bestdestinationwedding.com\/t\/79320\/aciretas-wedding-ahr-pics\"><strong><span><em>Wedding & AHR Pics<\/em><\/span><\/strong><\/a><\/p><span><\/span><\/div><\/div>","Email":"ericataffs@gmail.com","IpAddress":"99.11.245.41","GroupId":47,"GroupName":"Site Supporter","JoinDate":1288606566,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-233628.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":197,"PhotoType":"custom"},"FormattedName":"acireta","Id":233628,"Name":"acireta","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":65763,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"17f0336ef4f21d2eaf642366646a7be6","RawContent":"&lt;p&gt; &lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: medium\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;We have 13 people (3 singles, 5 couples) sailing with us on the Carnival Liberty and 8 guests (4 couples) meeting us on St. Thomas for our wedding. We sail on March 31&lt;sup&gt;st&lt;\/sup&gt;, so I\u00e2\u20ac\u2122ll be dropping off and sending these pre-trip packets mid-February. I\u00e2\u20ac\u2122m going to hand-deliver as many of these as possible to save money on postage.&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: medium\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: medium\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;For each packet, we\u00e2\u20ac\u2122ll be sending a passport of information, luggage tag for each guest, a packing list, and a thank you for booking business card, all packaged in a black folder. We\u00e2\u20ac\u2122re also going to include the wedding day timeline for island guests (since we won\u00e2\u20ac\u2122t see them before the wedding day) and a list of the cruise events for the sailing guests. &lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: medium\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: medium\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;img alt=\"DSC00104.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/721863\/width\/600\/height\/499\" \/&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: medium\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: medium\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;img alt=\"DSC00107.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/721865\/width\/600\/height\/450\" \/&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: medium\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: medium\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: medium\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;strong&gt;&lt;u&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Luggage Tags&lt;\/span&gt;&lt;\/span&gt;&lt;\/u&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: medium\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;I got shimmer business cards from Zazzle and was very disappointed in the quality, especially for the price. If I could go back, I would have sent these back for a refund and printed on my own on shimmer paper. I mounted the cards on teal cardstock leftover from my invitations and added address labels on the back. &lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: medium\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;I got the luggage tags from a BDW bride. &lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: medium\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: medium\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;img alt=\"DSC00124.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/721867\/width\/600\/height\/450\" \/&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: medium\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: medium\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;span huddler_attributes=\"{&amp;quot;plugin&amp;quot;:&amp;quot;attachment&amp;quot;,&amp;quot;params&amp;quot;:{&amp;quot;id&amp;quot;:&amp;quot;11439&amp;quot;,&amp;quot;name&amp;quot;:&amp;quot;luggage tag back.doc&amp;quot;,&amp;quot;description&amp;quot;:&amp;quot;&amp;quot;,&amp;quot;size&amp;quot;:&amp;quot;41&amp;quot;,&amp;quot;type&amp;quot;:&amp;quot;doc&amp;quot;}}\" huddler_plugin=\"attachment\"&gt;&amp;nbsp;&lt;\/span&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: medium\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: medium\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;strong&gt;&lt;u&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Packing List&lt;\/span&gt;&lt;\/span&gt;&lt;\/u&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: medium\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;I found a packing checklist online that I loved, but it was ridiculously expensive, so I made my own and adjusted it to fit for a cruise, adding some travel\/cruising tips on the back.&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: medium\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: medium\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;img alt=\"packing list front.JPG\" height=\"593\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/721875\/width\/529\/height\/682\" style=\"width: 394px; height: 526px\" width=\"436\" \/&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: medium\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: medium\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;img alt=\"packing list back.JPG\" height=\"580\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/721877\/width\/527\/height\/681\" style=\"width: 393px; height: 544px\" width=\"410\" \/&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;span huddler_attributes=\"{&amp;quot;plugin&amp;quot;:&amp;quot;attachment&amp;quot;,&amp;quot;params&amp;quot;:{&amp;quot;id&amp;quot;:&amp;quot;11440&amp;quot;,&amp;quot;name&amp;quot;:&amp;quot;packing list.pptx&amp;quot;,&amp;quot;description&amp;quot;:&amp;quot;&amp;quot;,&amp;quot;size&amp;quot;:&amp;quot;121&amp;quot;,&amp;quot;type&amp;quot;:&amp;quot;pptx&amp;quot;}}\" huddler_plugin=\"attachment\"&gt;&amp;nbsp;&lt;\/span&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: medium\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: medium\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;em&gt;to be continued...&lt;\/em&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: medium\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1581116,"PostDate":1328922651,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: medium\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">We have 13 people (3 singles, 5 couples) sailing with us on the Carnival Liberty and 8 guests (4 couples) meeting us on St. Thomas for our wedding. We sail on March 31<sup>st<\/sup>, so I\u00e2\u20ac\u2122ll be dropping off and sending these pre-trip packets mid-February. I\u00e2\u20ac\u2122m going to hand-deliver as many of these as possible to save money on postage.<\/span><\/span><\/span><\/span><\/p> <p> <span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: medium\">\u00a0<\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: medium\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">For each packet, we\u00e2\u20ac\u2122ll be sending a passport of information, luggage tag for each guest, a packing list, and a thank you for booking business card, all packaged in a black folder. We\u00e2\u20ac\u2122re also going to include the wedding day timeline for island guests (since we won\u00e2\u20ac\u2122t see them before the wedding day) and a list of the cruise events for the sailing guests. <\/span><\/span><\/span><\/span><\/p> <p> <span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: medium\">\u00a0<\/span><\/span><\/p> <p> <span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: medium\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span rel='lightbox'><img class='bbc_img' alt=\"DSC00104.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/721863\/width\/600\/height\/499\" \/><\/span><\/span><\/span><\/span><\/span><\/p> <p> <span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: medium\">\u00a0<\/span><\/span><\/p> <p> <span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: medium\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span rel='lightbox'><img class='bbc_img' alt=\"DSC00107.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/721865\/width\/600\/height\/450\" \/><\/span><\/span><\/span><\/span><\/span><\/p> <p> <span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: medium\">\u00a0<\/span><\/span><\/p> <p> <span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: medium\">\u00a0<\/span><\/span><\/p> <p> <span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: medium\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><strong><u><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Luggage Tags<\/span><\/span><\/u><\/strong><\/span><\/span><\/span><\/span><\/p> <p> <span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: medium\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">I got shimmer business cards from Zazzle and was very disappointed in the quality, especially for the price. If I could go back, I would have sent these back for a refund and printed on my own on shimmer paper. I mounted the cards on teal cardstock leftover from my invitations and added address labels on the back. <\/span><\/span><\/span><\/span><\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: medium\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">I got the luggage tags from a BDW bride. <\/span><\/span><\/span><\/span><\/span><\/span><\/p> <p> <span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: medium\">\u00a0<\/span><\/span><\/p> <p> <span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: medium\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span rel='lightbox'><img class='bbc_img' alt=\"DSC00124.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/721867\/width\/600\/height\/450\" \/><\/span><\/span><\/span><\/span><\/span><\/p> <p> <span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: medium\">\u00a0<\/span><\/span><\/p> <p> <span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: medium\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">\u00a0<\/span><\/span><\/span><\/span><\/p> <span huddler_attributes=\"{\"plugin\":\"attachment\",\"params\":{\"id\":\"11439\",\"name\":\"luggage tag back.doc\",\"description\":\"\",\"size\":\"41\",\"type\":\"doc\"}}\" huddler_plugin=\"attachment\">\u00a0<\/span> <p> \u00a0<\/p> <p> <span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: medium\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">\u00a0<\/span><\/span><\/span><\/span><\/p> <p> <span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: medium\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><strong><u><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Packing List<\/span><\/span><\/u><\/strong><\/span><\/span><\/span><\/span><\/p> <p> <span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: medium\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">I found a packing checklist online that I loved, but it was ridiculously expensive, so I made my own and adjusted it to fit for a cruise, adding some travel\/cruising tips on the back.<\/span><\/span><\/span><\/span><\/span><\/span><\/p> <p> <span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: medium\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">\u00a0<\/span><\/span><\/span><\/span><\/p> <p> <span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: medium\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span rel='lightbox'><img class='bbc_img' alt=\"packing list front.JPG\" height=\"593\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/721875\/width\/529\/height\/682\" style=\"width: 394px; height: 526px\" width=\"436\" \/><\/span><\/span><\/span><\/span><\/span><\/span><\/span><\/p> <p> <span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: medium\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">\u00a0<\/span><\/span><\/span><\/span><\/span><\/span><\/p> <p> <span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: medium\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span rel='lightbox'><img class='bbc_img' alt=\"packing list back.JPG\" height=\"580\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/721877\/width\/527\/height\/681\" style=\"width: 393px; height: 544px\" width=\"410\" \/><\/span><\/span><\/span><\/span><\/span><\/span><\/span><\/p> <p> \u00a0<\/p> <span huddler_attributes=\"{\"plugin\":\"attachment\",\"params\":{\"id\":\"11440\",\"name\":\"packing list.pptx\",\"description\":\"\",\"size\":\"121\",\"type\":\"pptx\"}}\" huddler_plugin=\"attachment\">\u00a0<\/span> <p> \u00a0<\/p> <p> <span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: medium\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">\u00a0<\/span><\/span><\/span><\/span><\/span><\/span><\/p> <p> <span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: medium\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><em>to be continued...<\/em><\/span><\/span><\/span><\/span><\/span><\/span><\/p> <p> <span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: medium\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">\u00a0<\/span><\/span><\/span><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><p><span>Erica & Al - April 3, 2012 - St. Thomas, USVI<\/span><\/p><span><\/span><p><strong><span><em><a data-ipb='nomediaparse' href=\"http:\/\/www.bestdestinationwedding.com\/t\/78715\/aciretas-planning-journal-april-3-2012-cruise-wedding\">Planning Thread<\/a><\/em><\/span><\/strong><\/p><span><\/span><p><a data-ipb='nomediaparse' href=\"http:\/\/www.bestdestinationwedding.com\/t\/79320\/aciretas-wedding-ahr-pics\"><strong><span><em>Wedding & AHR Pics<\/em><\/span><\/strong><\/a><\/p><span><\/span><\/div><\/div>","Email":"ericataffs@gmail.com","IpAddress":"99.11.245.41","GroupId":47,"GroupName":"Site Supporter","JoinDate":1288606566,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-233628.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":197,"PhotoType":"custom"},"FormattedName":"acireta","Id":233628,"Name":"acireta","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":65763,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"26b18816493161ccdbb3881053f5b8d5","RawContent":"&lt;p&gt; &lt;strong&gt;&lt;u&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Passport&lt;\/span&gt;&lt;\/span&gt;&lt;\/u&gt;&lt;\/strong&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;I used a bunch of passport templates from BDW brides to compile my info passport. I made one passport for the cruising guests and one for the island guests. The cruising passport had info about the ports of call and cruise tips. The island passport had info about St. Thomas and travel information instead. &lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;I printed the passports on 110# cardstock, used my Fiskars paper cutter to do the straight lines, Fiskars corner punch to round the corners, and Martha Stewart scoring board to get a nice fold. I tied the passports through two holes with twine from Ace Hardware.&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;img alt=\"DSC00117.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/721885\/width\/600\/height\/450\" \/&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;img alt=\"DSC00109.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/721887\/width\/600\/height\/450\" \/&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;img alt=\"DSC00110.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/721889\/width\/600\/height\/450\" \/&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;img alt=\"DSC00112.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/721891\/width\/600\/height\/450\" \/&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;img alt=\"DSC00113.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/721893\/width\/600\/height\/450\" \/&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;img alt=\"DSC00115.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/721895\/width\/600\/height\/450\" \/&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;img alt=\"DSC00116.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/721897\/width\/600\/height\/450\" \/&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;span huddler_attributes=\"{&amp;quot;plugin&amp;quot;:&amp;quot;attachment&amp;quot;,&amp;quot;params&amp;quot;:{&amp;quot;id&amp;quot;:&amp;quot;11441&amp;quot;,&amp;quot;name&amp;quot;:&amp;quot;Passport template cruise.ppt&amp;quot;,&amp;quot;description&amp;quot;:&amp;quot;&amp;quot;,&amp;quot;size&amp;quot;:&amp;quot;798&amp;quot;,&amp;quot;type&amp;quot;:&amp;quot;ppt&amp;quot;}}\" huddler_plugin=\"attachment\"&gt;&amp;nbsp;&lt;\/span&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;span huddler_attributes=\"{&amp;quot;plugin&amp;quot;:&amp;quot;attachment&amp;quot;,&amp;quot;params&amp;quot;:{&amp;quot;id&amp;quot;:&amp;quot;11442&amp;quot;,&amp;quot;name&amp;quot;:&amp;quot;Passport template St T.ppt&amp;quot;,&amp;quot;description&amp;quot;:&amp;quot;&amp;quot;,&amp;quot;size&amp;quot;:&amp;quot;905&amp;quot;,&amp;quot;type&amp;quot;:&amp;quot;ppt&amp;quot;}}\" huddler_plugin=\"attachment\"&gt;&amp;nbsp;&lt;\/span&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&amp;nbsp; &lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p id=\"yui_3_4_1_7_1328937079078_26\"&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: medium\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;em&gt;to be continued...&lt;\/em&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1581120,"PostDate":1328923313,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <strong><u><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">Passport<\/span><\/span><\/u><\/strong><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">I used a bunch of passport templates from BDW brides to compile my info passport. I made one passport for the cruising guests and one for the island guests. The cruising passport had info about the ports of call and cruise tips. The island passport had info about St. Thomas and travel information instead. <\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">I printed the passports on 110# cardstock, used my Fiskars paper cutter to do the straight lines, Fiskars corner punch to round the corners, and Martha Stewart scoring board to get a nice fold. I tied the passports through two holes with twine from Ace Hardware.<\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span rel='lightbox'><img class='bbc_img' alt=\"DSC00117.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/721885\/width\/600\/height\/450\" \/><\/span><\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span rel='lightbox'><img class='bbc_img' alt=\"DSC00109.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/721887\/width\/600\/height\/450\" \/><\/span><\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span rel='lightbox'><img class='bbc_img' alt=\"DSC00110.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/721889\/width\/600\/height\/450\" \/><\/span><\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span rel='lightbox'><img class='bbc_img' alt=\"DSC00112.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/721891\/width\/600\/height\/450\" \/><\/span><\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span rel='lightbox'><img class='bbc_img' alt=\"DSC00113.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/721893\/width\/600\/height\/450\" \/><\/span><\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span rel='lightbox'><img class='bbc_img' alt=\"DSC00115.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/721895\/width\/600\/height\/450\" \/><\/span><\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span rel='lightbox'><img class='bbc_img' alt=\"DSC00116.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/721897\/width\/600\/height\/450\" \/><\/span><\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">\u00a0<\/span><\/span><\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <span huddler_attributes=\"{\"plugin\":\"attachment\",\"params\":{\"id\":\"11441\",\"name\":\"Passport template cruise.ppt\",\"description\":\"\",\"size\":\"798\",\"type\":\"ppt\"}}\" huddler_plugin=\"attachment\">\u00a0<\/span> <p> \u00a0<\/p> <span huddler_attributes=\"{\"plugin\":\"attachment\",\"params\":{\"id\":\"11442\",\"name\":\"Passport template St T.ppt\",\"description\":\"\",\"size\":\"905\",\"type\":\"ppt\"}}\" huddler_plugin=\"attachment\">\u00a0<\/span> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">\u00a0<\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">\u00a0 <\/span><\/span><\/p> <p id=\"yui_3_4_1_7_1328937079078_26\"> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: medium\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><em>to be continued...<\/em><\/span><\/span><\/span><\/span><\/span><\/span><\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\">\u00a0<\/span><\/span><\/p> <p> \u00a0<\/p>\r\n   