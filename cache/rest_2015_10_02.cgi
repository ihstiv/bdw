, sans-serif;\"&gt;Palace Resorts&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"margin-left:.25in;text-align:center;\"&gt;&lt;span style=\"color:#595959;\"&gt;&lt;span style=\"font-family:symbol;\"&gt;\u00b7\t &lt;\/span&gt;&lt;\/span&gt;&lt;span style=\"color:#595959;\"&gt;&lt;span style=\"font-family:&#039;calibri light&#039;, sans-serif;\"&gt;Riu Palace&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"margin-left:.25in;text-align:center;\"&gt;&lt;span style=\"color:#595959;\"&gt;&lt;span style=\"font-family:symbol;\"&gt;\u00b7\t &lt;\/span&gt;&lt;\/span&gt;&lt;span style=\"color:#595959;\"&gt;&lt;span style=\"font-family:&#039;calibri light&#039;, sans-serif;\"&gt;Royalton Resorts&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"margin-left:.25in;text-align:center;\"&gt;&lt;span style=\"color:#595959;\"&gt;&lt;span style=\"font-family:symbol;\"&gt;\u00b7\t &lt;\/span&gt;&lt;\/span&gt;&lt;span style=\"color:#595959;\"&gt;&lt;span style=\"font-family:&#039;calibri light&#039;, sans-serif;\"&gt;Secrets Resorts&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"margin-left:.25in;text-align:center;\"&gt;&lt;span style=\"color:#595959;\"&gt;&lt;span style=\"font-family:symbol;\"&gt;\u00b7\t &lt;\/span&gt;&lt;\/span&gt;&lt;span style=\"color:#595959;\"&gt;&lt;span style=\"font-family:&#039;calibri light&#039;, sans-serif;\"&gt;Valentin Imperial Maya&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"margin-left:.25in;text-align:center;\"&gt;&lt;span style=\"color:#595959;\"&gt;&lt;span style=\"font-family:symbol;\"&gt;\u00b7\t &lt;\/span&gt;&lt;\/span&gt;&lt;span style=\"color:#595959;\"&gt;&lt;span style=\"font-family:&#039;calibri light&#039;, sans-serif;\"&gt;Zoetry Resorts&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"text-align:center;\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"margin-left:.25in;text-align:center;\"&gt;&lt;span style=\"color:#595959;\"&gt;&lt;span style=\"font-family:&#039;calibri light&#039;, sans-serif;\"&gt;\u2026a