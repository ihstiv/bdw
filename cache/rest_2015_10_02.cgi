{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":127,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":true,"Views":4519,"MovedTo":null,"MovedOn":0,"FirstPostId":1900255,"Rating":0,"RatingHits":0,"Starter":{"Id":282006,"Name":"ashhtayy","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282006.png?_r=1423373502","PhotoWidth":200,"PhotoHeight":138,"PhotoType":"custom"},"IsOnline":false},"StartDate":1436657964,"LastPoster":{"Id":282006,"Name":"ashhtayy","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282006.png?_r=1423373502","PhotoWidth":200,"PhotoHeight":138,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":37,"Preview":{"Id":1900465,"PostDate":1436906837,"PostContent":"A dress, suit and 2 BMs dresses may be a lot for one bag.    Is there anyone coming who has a tra...","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.98.196.2","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79377,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"622b8488fec685cfe540d777309fbd56","RawContent":"&lt;p&gt;@[member=\"ashhtayy\"] I&#039;m so excited!! It still feels like a dream hahah&lt;\/p&gt;","Attachments":[],"Id":1900433,"PostDate":1436882261,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"282006\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282006-ashhtayy\/' title='Member profile'><span itemprop=\"name\">ashhtayy<\/span><\/a> I'm so excited!! It still feels like a dream hahah<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<br><p><a data-ipb='nomediaparse' href='http:\/\/www.TickerFactory.com\/'><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;31;484\/st\/20150813\/e\/Wedding+time%21+\/dt\/-2\/k\/b92c\/event.png\" alt=\"event.png\"><\/a><\/p>\n<p style=\"text-align:center;\">\u00a0<\/p>\n<p style=\"text-align:center;\">\u00a0","Email":"sblopezb@gmail.com","IpAddress":"172.219.193.22","GroupId":42,"GroupName":"Sr. Member","JoinDate":1359748704,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265511.jpg?_r=1442890536","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"TinkerSofi","Id":265511,"Name":"TinkerSofi","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.146.146.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79377,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"1cfdaf156b631af5eebe1f65631e654b","RawContent":"A dress, suit and 2 BMs dresses may be a lot for one bag.   \n\n\nIs there anyone coming who has a travel steamer? Thankfully my friend brought one as we needed it. Even hanging my dress it was wrinkled. So we did all 5 dresses. \n\n\nSince we knew we&#039;d be steaming dresses my BMs just shoved theirs in their carry on lol. My husband&#039;s was more casual than a suit so he just ironed his in Mexico. \n\n\nAnother suggestion, as said above, is asking your WC for a quote to steam everything upon arrival. \n\n\nGlad everyone is getting perks!\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1900465,"PostDate":1436906837,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                A dress, suit and 2 BMs dresses may be a lot for one bag.   <br><br>\nIs there anyone coming who has a travel steamer? Thankfully my friend brought one as we needed it. Even hanging my dress it was wrinkled. So we did all 5 dresses. <br><br>\nSince we knew we'd be steaming dresses my BMs just shoved theirs in their carry on lol. My husband's was more casual than a suit so he just ironed his in Mexico. <br><br>\nAnother suggestion, as said above, is asking your WC for a quote to steam everything upon arrival. <br><br>\nGlad everyone is getting perks!<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"184.147.133.33","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79377,"EditedBy":"<strong>Edited by ashhtayy, 14 July 2015 - 08:51 PM.<\/strong>","EditDate":1436907100,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"99a0a68bcd59dbfe003fbc08c1809489","RawContent":"&lt;p&gt;@[member=\"calgarybride2015\"] travel steamer is a great idea. mike is going to freak when i say we need to buy one. about 6 months ago i said we NEEDED a steamer. we bought a pretty good one...and have only used it a few times when we got it and then for both my gfs weddings (for the bridesmaids dresses). should have bought a travel sized one to begin with! no way we can travel with ours lol&lt;\/p&gt;","Attachments":[],"Id":1900466,"PostDate":1436907076,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"277873\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277873-calgarybride2015\/' title='Member profile'><span itemprop=\"name\">calgarybride2015<\/span><\/a> travel steamer is a great idea. mike is going to freak when i say we need to buy one. about 6 months ago i said we NEEDED a steamer. we bought a pretty good one...and have only used it a few times when we got it and then for both my gfs weddings (for the bridesmaids dresses). should have bought a travel sized one to begin with! no way we can travel with ours lol<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>My Planning Thread: <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79377-ashhtayys-planning-thread-azul-fives-june-7-2016\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79377-ashhtayys-planning-thread-azul-fives-june-7-2016\/<\/a><br>\n\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;0;116\/st\/20160607\/e\/Our+Wedding\/dt\/1\/k\/bb99\/event.png\" alt=\"event.png\"><\/a>","Email":"ashley.taylor@live.ca","IpAddress":"184.147.135.4","GroupId":40,"GroupName":"Jr. Member","JoinDate":1423090661,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282006.png?_r=1423373502","PhotoWidth":200,"PhotoHeight":138,"PhotoType":"custom"},"FormattedName":"ashhtayy","Id":282006,"Name":"ashhtayy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.146.146.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79377,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":3,"IsLiked":false,"PostKey":"cb3f1a0f6750f17d8fa35f8d3d5b5740","RawContent":"[quote name=\"ashhtayy\" post=\"1900466\" timestamp=\"1436921476\"]\n@[member=\"calgarybride2015\"] travel steamer is a great idea. mike is going to freak when i say we need to buy one. about 6 months ago i said we NEEDED a steamer. we bought a pretty good one...and have only used it a few times when we got it and then for both my gfs weddings (for the bridesmaids dresses). should have bought a travel sized one to begin with! no way we can travel with ours lol[\/quote]\nLOL sounds like the juicer we had to have and have never used :)   Thankfully you are getting some use out of yours, but yes that would be quite large to pack!\n\nBefore you buy one I would seriously ask your guest list!   You would be surprised who owns what or knows someone who would lend it to them! Could save you some money!","Attachments":[],"Id":1900469,"PostDate":1436909199,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>ashhtayy, on 14 July 2015 - 08:51 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"277873\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277873-calgarybride2015\/' title='Member profile'><span itemprop=\"name\">calgarybride2015<\/span><\/a> travel steamer is a great idea. mike is going to freak when i say we need to buy one. about 6 months ago i said we NEEDED a steamer. we bought a pretty good one...and have only used it a few times when we got it and then for both my gfs weddings (for the bridesmaids dresses). should have bought a travel sized one to begin with! no way we can travel with ours lol<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>LOL sounds like the juicer we had to have and have never used <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> \u00a0 Thankfully you are getting some use out of yours, but yes that would be quite large to pack!<\/p>\n<p>\u00a0<\/p>\n<p>Before you buy one I would seriously ask your guest list! \u00a0 You would be surprised who owns what or knows someone who would lend it to them! Could save you some money!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"184.147.133.33","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79377,"EditedBy":"<strong>Edited by ashhtayy, 14 July 2015 - 09:32 PM.<\/strong>","EditDate":1436909525,"EditReason":"","DeleteDate":0,"TotalLikes":3,"IsLiked":false,"PostKey":"018657c6324d9bfac2bd9f6d043a7157","RawContent":"&lt;p&gt;&lt;strong&gt;The \u2018Save the Date\u2019&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;After finding a deal that we didn\u2019t think we\u2019d be able to beat, we began the search for the perfect STD. I knew I wanted to do a post card and include a photograph from our engagement shoot. The main reason for including the photograph of us was because I still didn\u2019t have a colour scheme or theme. I searched many sites and finally found a template on zazzle.com that had a similar calligraphy to our wedding website.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I SHOULD have done more research as we certainly paid too much for our STDs (more so too much for shipping rather than the actual STDs). We only required 85 postcards even though our guest list was close to 200. We sent one per household; some groups of four only received one STD. Our STDs were $1.00USD each with a discount of $21.25USD for a total of $63.75USD. The shipping came to $45.64USD. Total for STD and shipping was $94.39USD.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;The second I hit submit on zazzle.com I realized I had placed the order for the WRONG STD. I had many different templates saved and most looked identical. I ordered one with the incorrect date and old wedding website. I could not believe that this had happened. After I wiped the tears from my eyes I frantically emailed zazzle.com 4 times stating PLEASE CANCEL THE ORDER. It was a Sunday night, no one was on email and their phone was not being answered because of the day of the week and time. As soon as their offices opened Monday morning I called and was told it was too late \u2013 they hadn\u2019t checked their email and the STDs had been sent to print. Someone was looking out for me that day though. Zazzle.com acknowledged that it was their error as they could see I emailed them less than 5 minutes after I had placed the order. They told me to push through the order for the correct STDs and they would reimburse me (STDs and shipping costs) once I received the incorrect STDs in the mail. They were true to their word and reimbursed the $94.39USD to my credit card. They didn\u2019t even want me to send the incorrect STDs back.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Side note: although promising to reimburse both the STD cost and shipping, the first credit only included the cost of the STD. When I called they apologized and put through a credit for the shipping as well. Outstanding customer service.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;This was 100% my mistake so had they not of credited me I would have understood but I am happy to say customer service is important to them and they did everything they could to make this right for me.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;It total our STDs were $122.96CAD and $85CAD for the stamps which we bought in a 100 pack from Costco.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;STDs with shipping and stamps = $207.96CAD&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;The front included our picture and names. The back of the post card included the dates our guests would be traveling, the name of the resort, our wedding website and a brief note that said \u201cDetails on the resort, travel arrangements and booking deadlines can be found on our website\u201d.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;If I were to do this again I would:&lt;\/p&gt;\n&lt;ol&gt;&lt;li&gt;Pay less for our STDs or make them myself if time had permitted that (it didn\u2019t because when I ordered them our 90 days had already started)&lt;\/li&gt;\n\t&lt;li&gt;Order locally (Canadian supplier)\n\t&lt;ol&gt;&lt;li&gt;Yes \u2013 zazzle.com has a zazzle.ca but they didn\u2019t offer the STD I wanted &lt;span style=\"font-family:wingdings;\"&gt; :(&lt;\/span&gt;&lt;\/li&gt;\n\t&lt;\/ol&gt;&lt;\/li&gt;\n\t&lt;li&gt;Have asked people to RSVP&lt;\/li&gt;\n\t&lt;li&gt;Include our booking deadline date on the STD (few people read the website)&lt;\/li&gt;\n&lt;\/ol&gt;&lt;p&gt;Nowadays if people don\u2019t do something right away, they forget. Our STDs likely made it on to a few fridges, maybe into a junk drawer or a friends keepsake card box, and people didn\u2019t even realize they had to act fairly soon. I take fault for that because I didn\u2019t articulate the right things on our STDs.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Our STDs were sent late April and our booking deadline was June 18&lt;sup&gt;th&lt;\/sup&gt;. It was EXTREMELY important to us to give our guests a year\u2019s notice. We wanted everyone to come but knew that wouldn\u2019t be possible. We hoped that with enough notice, more people could make this happen.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;div&gt;[sharedmedia=gallery:images:81199]&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:81583]&lt;\/div&gt;\n&lt;\/div&gt;","Attachments":[],"Id":1900470,"PostDate":1436909351,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><strong>The \u2018Save the Date\u2019<\/strong><\/p>\n<p>After finding a deal that we didn\u2019t think we\u2019d be able to beat, we began the search for the perfect STD. I knew I wanted to do a post card and include a photograph from our engagement shoot. The main reason for including the photograph of us was because I still didn\u2019t have a colour scheme or theme. I searched many sites and finally found a template on zazzle.com that had a similar calligraphy to our wedding website.<\/p>\n<p>\u00a0<\/p>\n<p>I SHOULD have done more research as we certainly paid too much for our STDs (more so too much for shipping rather than the actual STDs). We only required 85 postcards even though our guest list was close to 200. We sent one per household; some groups of four only received one STD. Our STDs were $1.00USD each with a discount of $21.25USD for a total of $63.75USD. The shipping came to $45.64USD. Total for STD and shipping was $94.39USD.<\/p>\n<p>\u00a0<\/p>\n<p>The second I hit submit on zazzle.com I realized I had placed the order for the WRONG STD. I had many different templates saved and most looked identical. I ordered one with the incorrect date and old wedding website. I could not believe that this had happened. After I wiped the tears from my eyes I frantically emailed zazzle.com 4 times stating PLEASE CANCEL THE ORDER. It was a Sunday night, no one was on email and their phone was not being answered because of the day of the week and time. As soon as their offices opened Monday morning I called and was told it was too late \u2013 they hadn\u2019t checked their email and the STDs had been sent to print. Someone was looking out for me that day though. Zazzle.com acknowledged that it was their error as they could see I emailed them less than 5 minutes after I had placed the order. They told me to push through the order for the correct STDs and they would reimburse me (STDs and shipping costs) once I received the incorrect STDs in the mail. They were true to their word and reimbursed the $94.39USD to my credit card. They didn\u2019t even want me to send the incorrect STDs back.<\/p>\n<p>\u00a0<\/p>\n<p>Side note: although promising to reimburse both the STD cost and shipping, the first credit only included the cost of the STD. When I called they apologized and put through a credit for the shipping as well. Outstanding customer service.<\/p>\n<p>\u00a0<\/p>\n<p>This was 100% my mistake so had they not of credited me I would have understood but I am happy to say customer service is important to them and they did everything they could to make this right for me.<\/p>\n<p>\u00a0<\/p>\n<p>It total our STDs were $122.96CAD and $85CAD for the stamps which we bought in a 100 pack from Costco.<\/p>\n<p>\u00a0<\/p>\n<p>STDs with shipping and stamps = $207.96CAD<\/p>\n<p>\u00a0<\/p>\n<p>The front included our picture and names. The back of the post card included the dates our guests would be traveling, the name of the resort, our wedding website and a brief note that said \u201cDetails on the resort, travel arrangements and booking deadlines can be found on our website\u201d.<\/p>\n<p>\u00a0<\/p>\n<p>If I were to do this again I would:<\/p>\n<ol><li>Pay less for our STDs or make them myself if time had permitted that (it didn\u2019t because when I ordered them our 90 days had already started)<\/li>\n\t<li>Order locally (Canadian supplier)\n\t<ol><li>Yes \u2013 zazzle.com has a zazzle.ca but they didn\u2019t offer the STD I wanted <span  style=\"font-family:wingdings\"> <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/sad.png' class='bbc_emoticon' alt=':(' \/><\/span><\/li>\n\t<\/ol><\/li>\n\t<li>Have asked people to RSVP<\/li>\n\t<li>Include our booking deadline date on the STD (few people read the website)<\/li>\n<\/ol><p>Nowadays if people don\u2019t do something right away, they forget. Our STDs likely made it on to a few fridges, maybe into a junk drawer or a friends keepsake card box, and people didn\u2019t even realize they had to act fairly soon. I take fault for that because I didn\u2019t articulate the right things on our STDs.<\/p>\n<p>\u00a0<\/p>\n<p>Our STDs were sent late April and our booking deadline was June 18<sup>th<\/sup>. It was EXTREMELY important to us to give our guests a year\u2019s notice. We wanted everyone to come but knew that wouldn\u2019t be possible. We hoped that with enough notice, more people could make this happen.<\/p>\n<p>\u00a0<\/p>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/81199-save-the-date\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_18028\/sml_gallery_282006_18028_38443.jpg' class='galattach galimageview sharedmedia_screenshot' title='Save The Date'  width='200' height='197'  alt='Save The Date' id='sml_image_view_81199' \/><\/a>\n<br \/><\/div>\n<div>\u00a0<\/div>\n<div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/81583-std-back\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_18028\/sml_gallery_282006_18028_1596.jpg' class='galattach galimageview sharedmedia_screenshot' title='STD Back'  width='200' height='153'  alt='STD Back' id='sml_image_view_81583' \/><\/a>\n<br \/><\/div>\n<\/div>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>My Planning Thread: <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79377-ashhtayys-planning-thread-azul-fives-june-7-2016\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79377-ashhtayys-planning-thread-azul-fives-june-7-2016\/<\/a><br>\n\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;0;116\/st\/20160607\/e\/Our+Wedding\/dt\/1\/k\/bb99\/event.png\" alt=\"event.png\"><\/a>","Email":"ashley.taylor@live.ca","IpAddress":"184.147.135.4","GroupId":40,"GroupName":"Jr. Member","JoinDate":1423090661,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282006.png?_r=1423373502","PhotoWidth":200,"PhotoHeight":138,"PhotoType":"custom"},"FormattedName":"ashhtayy","Id":282006,"Name":"ashhtayy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.228.78.229","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79377,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"7110b4401cfda737df78924aad8e735e","RawContent":"Lovely STDs. We were kind of on the same boat. We sent them as soon as we made our reservation so people would have time, but I guess no one understood and no one put their deposit at that time haha. Only when we sent our invites two months later people started asking how to put down their deposit. I also wish I had used different STDs and included different information on them. In the end it all worked out though :) \n\n\nWe bought a travel steamer a few months ago, maybe it was just a bad one because we returned it after trying it a couple of times. It wasn&#039;t very good, but maybe another brand might be better. I&#039;ll ask first and see if anyone has one [emoji1]\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1900471,"PostDate":1436912863,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Lovely STDs. We were kind of on the same boat. We sent them as soon as we made our reservation so people would have time, but I guess no one understood and no one put their deposit at that time haha. Only when we sent our invites two months later people started asking how to put down their deposit. I also wish I had used different STDs and included different information on them. In the end it all worked out though <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> <br><br>\nWe bought a travel steamer a few months ago, maybe it was just a bad one because we returned it after trying it a couple of times. It wasn't very good, but maybe another brand might be better. I'll ask first and see if anyone has one [emoji1]<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<br><p><a data-ipb='nomediaparse' href='http:\/\/www.TickerFactory.com\/'><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;31;484\/st\/20150813\/e\/Wedding+time%21+\/dt\/-2\/k\/b92c\/event.png\" alt=\"event.png\"><\/a><\/p>\n<p style=\"text-align:center;\">\u00a0<\/p>\n<p style=\"text-align:center;\">\u00a0","Email":"sblopezb@gmail.com","IpAddress":"172.219.193.22","GroupId":42,"GroupName":"Sr. Member","JoinDate":1359748704,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265511.jpg?_r=1442890536","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"TinkerSofi","Id":265511,"Name":"TinkerSofi","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.146.146.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79377,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"c569dc0caabb3d9ef38d5886c5a92ab9","RawContent":"We realized the steamer had to touch the dress to work - or work quickly lol - and it didn&#039;t ruin the dresses. We tried on the flower girl one first as she had many layers you couldn&#039;t see :) just incase\n\n\nLove your save the dates. I totally agree we learn a lot after the fact.  Glad their customer service was awesome too. Had an issue with vistaprint and in the end got two orders for the price of one. \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1900472,"PostDate":1436913411,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We realized the steamer had to touch the dress to work - or work quickly lol - and it didn't ruin the dresses. We tried on the flower girl one first as she had many layers you couldn't see <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> just incase<br><br>\nLove your save the dates. I totally agree we learn a lot after the fact.  Glad their customer service was awesome too. Had an issue with vistaprint and in the end got two orders for the price of one. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"184.147.133.33","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79377,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"e1cf513c56272765ee98e46474120be5","RawContent":"[quote name=\"calgarybride2015\" post=\"1900469\" timestamp=\"1436923599\"]\nLOL sounds like the juicer we had to have and have never used :)   Thankfully you are getting some use out of yours, but yes that would be quite large to pack!\n\nBefore you buy one I would seriously ask your guest list!   You would be surprised who owns what or knows someone who would lend it to them! Could save you some money![\/quote]\n@[member=\"calgarybride2015\"] as i read your reply i remembered one of my bridesmaids has one. i&#039;ll definitely check to see what state it is in and if she thinks we will be able to bring it to the wedding. must save money wherever possible!\n[quote name=\"TinkerSofi\" post=\"1900471\" timestamp=\"1436927263\"]\nLovely STDs. We were kind of on the same boat. We sent them as soon as we made our reservation so people would have time, but I guess no one understood and no one put their deposit at that time haha. Only when we sent our invites two months later people started asking how to put down their deposit. I also wish I had used different STDs and included different information on them. In the end it all worked out though :)\n\nWe bought a travel steamer a few months ago, maybe it was just a bad one because we returned it after trying it a couple of times. It wasn&#039;t very good, but maybe another brand might be better. I&#039;ll ask first and see if anyone has one [emoji1]\n\n\nSent from my iPhone using Tapatalk[\/quote]\n@[member=\"TinkerSofi\"] we had like 10 people book right away and then maybe 30 the week of and then the other 14 or so were after our fake deposit due date but before the real due date lol NO one read the website. absolutely should have put the booking deadline on the actual STD.\n\ni&#039;m actually thinking of not sending formal invites. i feel like if you&#039;ve put your deposit down, you&#039;re coming. we do want to send something to everyone, but it won&#039;t be a formal invite like my save the date suggested (by suggested i mean said).\n\nlike @[member=\"calgarybride2015\"] said, one of your guests probably has a steamer you can borrow. fingers crossed anyways. have you looked into steaming costs at AF? i don&#039;t have a clue how much it is.\n[quote name=\"calgarybride2015\" post=\"1900472\" timestamp=\"1436927811\"]\nWe realized the steamer had to touch the dress to work - or work quickly lol - and it didn&#039;t ruin the dresses. We tried on the flower girl one first as she had many layers you couldn&#039;t see :) just incase\n\nLove your save the dates. I totally agree we learn a lot after the fact. Glad their customer service was awesome too. Had an issue with vistaprint and in the end got two orders for the price of one.\n\n\nSent from my iPhone using Tapatalk[\/quote]\n@[member=\"calgarybride2015\"] yes! the steamer does have to touch the dress to work. it&#039;s scary the first time you do it because the dress gets water on it and you think you&#039;ve ruined it (at least i thought so the first time). rookie mistake.\n\nSO grateful zazzle.com made up for my silly mistake. glad to hear vistaprint was good to you too!","Attachments":[],"Id":1900473,"PostDate":1436913723,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>calgarybride2015, on 14 July 2015 - 09:26 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>LOL sounds like the juicer we had to have and have never used <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> \u00a0 Thankfully you are getting some use out of yours, but yes that would be quite large to pack!<\/p>\n<p>\u00a0<\/p>\n<p>Before you buy one I would seriously ask your guest list! \u00a0 You would be surprised who owns what or knows someone who would lend it to them! Could save you some money!<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"277873\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277873-calgarybride2015\/' title='Member profile'><span itemprop=\"name\">calgarybride2015<\/span><\/a> as i read your reply i remembered one of my bridesmaids has one. i'll definitely check to see what state it is in and if she thinks we will be able to bring it to the wedding. must save money wherever possible!<\/p>\n<p>\u00a0<\/p>\n<p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>TinkerSofi, on 14 July 2015 - 10:27 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Lovely STDs. We were kind of on the same boat. We sent them as soon as we made our reservation so people would have time, but I guess no one understood and no one put their deposit at that time haha. Only when we sent our invites two months later people started asking how to put down their deposit. I also wish I had used different STDs and included different information on them. In the end it all worked out though <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br><br>\nWe bought a travel steamer a few months ago, maybe it was just a bad one because we returned it after trying it a couple of times. It wasn't very good, but maybe another brand might be better. I'll ask first and see if anyone has one [emoji1]<br><br><br>\nSent from my iPhone using Tapatalk<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"265511\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/265511-tinkersofi\/' title='Member profile'><span itemprop=\"name\">TinkerSofi<\/span><\/a> we had like 10 people book right away and then maybe 30 the week of and then the other 14 or so were after our fake deposit due date but before the real due date lol NO one read the website. absolutely should have put the booking deadline on the actual STD.<\/p>\n<p>\u00a0<\/p>\n<p>i'm actually thinking of not sending formal invites. i feel like if you've put your deposit down, you're coming. we do want to send something to everyone, but it won't be a formal invite like my save the date suggested (by suggested i mean said).<\/p>\n<p>\u00a0<\/p>\n<p>like @<a hovercard-ref=\"member\" hovercard-id=\"277873\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277873-calgarybride2015\/' title='Member profile'><span itemprop=\"name\">calgarybride2015<\/span><\/a> said, one of your guests probably has a steamer you can borrow. fingers crossed anyways. have you looked into steaming costs at AF? i don't have a clue how much it is.<\/p><br \/><p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>calgarybride2015, on 14 July 2015 - 10:36 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>We realized the steamer had to touch the dress to work - or work quickly lol - and it didn't ruin the dresses. We tried on the flower girl one first as she had many layers you couldn't see <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> just incase<br><br>\nLove your save the dates. I totally agree we learn a lot after the fact. Glad their customer service was awesome too. Had an issue with vistaprint and in the end got two orders for the price of one.<br><br><br>\nSent from my iPhone using Tapatalk<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"277873\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277873-calgarybride2015\/' title='Member profile'><span itemprop=\"name\">calgarybride2015<\/span><\/a> yes! the steamer does have to touch the dress to work. it's scary the first time you do it because the dress gets water on it and you think you've ruined it (at least i thought so the first time). rookie mistake.<\/p>\n<p>\u00a0<\/p>\n<p>SO grateful zazzle.com made up for my silly mistake. glad to hear vistaprint was good to you too!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>My Planning Thread: <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79377-ashhtayys-planning-thread-azul-fives-june-7-2016\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79377-ashhtayys-planning-thread-azul-fives-june-7-2016\/<\/a><br>\n\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;0;116\/st\/20160607\/e\/Our+Wedding\/dt\/1\/k\/bb99\/event.png\" alt=\"event.png\"><\/a>","Email":"ashley.taylor@live.ca","IpAddress":"184.147.135.4","GroupId":40,"GroupName":"Jr. Member","JoinDate":1423090661,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282006.png?_r=1423373502","PhotoWidth":200,"PhotoHeight":138,"PhotoType":"custom"},"FormattedName":"ashhtayy","Id":282006,"Name":"ashhtayy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.85.127.174","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79377,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"f404e660832b9f55498c136313464230","RawContent":"&lt;p&gt;@[member=\"ashhtayy\"] You should double check with your resort. Our resort includes steaming\/pressing of the bride&#039;s and groom&#039;s wedding garments. Can&#039;t hurt to ask...&lt;\/p&gt;","Attachments":[],"Id":1900477,"PostDate":1436915409,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"282006\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282006-ashhtayy\/' title='Member profile'><span itemprop=\"name\">ashhtayy<\/span><\/a> You should double check with your resort. Our resort includes steaming\/pressing of the bride's and groom's wedding garments. Can't hurt to ask...<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>- Erin<\/p>\n<p>\u00a0<\/p>\n<p>My planning thread:\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268'>http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268<\/a>","Email":"ekjzwedding@gmail.com","IpAddress":"24.85.127.174","GroupId":40,"GroupName":"Jr. Member","JoinDate":1417435045,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281283.jpg?_r=1428779369","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"vancouverpetunia","Id":281283,"Name":"vancouverpetunia","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"184.147.133.33","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79377,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8911ea12ae94dbd66fe9ac13ddf90813","RawContent":"@[member=\"vancouverpetunia\"] I&#039;ll email tomorrow. thanks!!","Attachments":[],"Id":1900481,"PostDate":1436917026,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"281283\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281283-vancouverpetunia\/' title='Member profile'><span itemprop=\"name\">vancouverpetunia<\/span><\/a> I'll email tomorrow. thanks!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>My Planning Thread: <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79377-ashhtayys-planning-thread-azul-fives-june-7-2016\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79377-ashhtayys-planning-thread-azul-fives-june-7-2016\/<\/a><br>\n\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;0;116\/st\/20160607\/e\/Our+Wedding\/dt\/1\/k\/bb99\/event.png\" alt=\"event.png\"><\/a>","Email":"ashley.taylor@live.ca","IpAddress":"184.147.135.4","GroupId":40,"GroupName":"Jr. Member","JoinDate":1423090661,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282006.png?_r=1423373502","PhotoWidth":200,"PhotoHeight":138,"PhotoType":"custom"},"FormattedName":"ashhtayy","Id":282006,"Name":"ashhtayy","IsOnline":false}}],"Id":"79377","Title":"Ashhtayy's Planning Thread - Azul Fives - June 7, 2016","LastPostDate":1441753728},"Pages":{"TotalItems":127,"TotalPages":13,"CurrentPage":40,"NextPage":50,"PreviousPage":30,"LastPage":120},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
