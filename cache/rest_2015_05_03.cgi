{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":4,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":137,"MovedTo":null,"MovedOn":0,"FirstPostId":1894943,"Rating":0,"RatingHits":0,"Starter":{"Id":282893,"Name":"giigiixo","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282893.jpg?_r=1430688802","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"StartDate":1430407417,"LastPoster":{"Id":230711,"Name":"Moments That Matter","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1894943,"PostDate":1430407417,"PostContent":"Hello every I am new to this site. My fianc\u00e9 and I have chosen to have our wedding at Royalton pu...","Author":{"Signature":"<a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><br><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;484\/st\/20160506\/e\/Our+Wedding\/k\/be22\/event.png\" alt=\"event.png\"><br><\/a>","Email":"jessica.galvao21@gmail.com","IpAddress":"99.227.250.95","GroupId":39,"GroupName":"Newbie","JoinDate":1430235023,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282893.jpg?_r=1430688802","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"giigiixo","Id":282893,"Name":"giigiixo","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.227.250.95","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79131,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fa18ba62e2924e6293a202d78810a892","RawContent":"Hello every I am new to this site. My fianc\u00e9 and I have chosen to have our wedding at Royalton punta Cana since we love Dominican so much we thought it would be perfect! \n\nI am wondering if any brides here have recently had a wedding at this resort or any brides that are near to their wedding date . \n\nI am looking for pictures, ceromny sites ( they want me a few but not very good ones) \n\n Extra died prices. We went with the DREAM package . We wanted to pay asap for this but payment doesn&#039;t open up for us until next year February. \n\nThanks !!","Attachments":[],"Id":1894943,"PostDate":1430407417,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hello every I am new to this site. My fianc\u00e9 and I have chosen to have our wedding at Royalton punta Cana since we love Dominican so much we thought it would be perfect! <br>\nI am wondering if any brides here have recently had a wedding at this resort or any brides that are near to their wedding date . <br>\nI am looking for pictures, ceromny sites ( they want me a few but not very good ones) <br>\n Extra died prices. We went with the DREAM package . We wanted to pay asap for this but payment doesn't open up for us until next year February. <br>\nThanks !! \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><br><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;484\/st\/20160506\/e\/Our+Wedding\/k\/be22\/event.png\" alt=\"event.png\"><br><\/a>","Email":"jessica.galvao21@gmail.com","IpAddress":"99.227.250.95","GroupId":39,"GroupName":"Newbie","JoinDate":1430235023,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282893.jpg?_r=1430688802","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"giigiixo","Id":282893,"Name":"giigiixo","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79131,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f03ab3c4245e6c193310b696b7aa5ae4","RawContent":"&lt;p&gt;Welcome and congrats!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;There&#039;s actually a thread on this website specific to Royalton PC. It may assist you :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/topic\/75274-royalton-punta-cana-2014\/&#039;&gt;http:\/\/www.bestdestinationwedding.com\/topic\/75274-royalton-punta-cana-2014\/&lt;\/a&gt;&lt;\/p&gt;","Attachments":[],"Id":1894945,"PostDate":1430408285,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome and congrats!<\/p>\n<p>\u00a0<\/p>\n<p>There's actually a thread on this website specific to Royalton PC. It may assist you <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p><a href='http:\/\/www.bestdestinationwedding.com\/topic\/75274-royalton-punta-cana-2014\/' class='bbc_url' title=''>http:\/\/www.bestdesti...unta-cana-2014\/<\/a><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":3,"GroupName":"Member","JoinDate":1419437814,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1428347017","PhotoWidth":169,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.227.250.95","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79131,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6ce18d5ed01952a5b13eed09128f55b0","RawContent":"Thank you ! \nI am looking for new info or to start a new thread as there is 16 pages long all from 2013-2014 very few for this year !!","Attachments":[],"Id":1894959,"PostDate":1430422645,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thank you ! <br \/>I am looking for new info or to start a new thread as there is 16 pages long all from 2013-2014 very few for this year !! \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><br><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;484\/st\/20160506\/e\/Our+Wedding\/k\/be22\/event.png\" alt=\"event.png\"><br><\/a>","Email":"jessica.galvao21@gmail.com","IpAddress":"99.227.250.95","GroupId":39,"GroupName":"Newbie","JoinDate":1430235023,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282893.jpg?_r=1430688802","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"giigiixo","Id":282893,"Name":"giigiixo","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"142.161.170.48","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79131,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a99aae365abaaeb53846f111bc10830d","RawContent":"&lt;p&gt;Welcome to our forum community giigiixo and Congrats on your Punta Cana wedding next year!!! very exciting and you&#039;ve come to the right place for assistance with your planning decisions, for sure :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Wishing you happy research and all the best with your plans - cheers!!! team MTM :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;....for some added inspiration, here are a few beautiful beach wedding \"moments that matter\" Linc captured in our Mexican Mayan Riviera - enjoy :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord.xx.fbcdn.net\/hphotos-xfa1\/t31.0-8\/10498204_10152558963544487_7865765403738280307_o.jpg\" alt=\"10498204_10152558963544487_7865765403738\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord.xx.fbcdn.net\/hphotos-xpf1\/t31.0-8\/1496567_10152127812449487_1704896308_o.jpg\" alt=\"1496567_10152127812449487_1704896308_o.j\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord.xx.fbcdn.net\/hphotos-ash2\/t31.0-8\/1399149_10151979750379487_633506417_o.jpg\" alt=\"1399149_10151979750379487_633506417_o.jp\"&gt;&lt;\/p&gt;","Attachments":[],"Id":1895181,"PostDate":1430580567,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome to our forum community giigiixo and Congrats on your Punta Cana wedding next year!!! very exciting and you've come to the right place for assistance with your planning decisions, for sure <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Wishing you happy research and all the best with your plans - cheers!!! team MTM <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>....for some added inspiration, here are a few beautiful beach wedding \"moments that matter\" Linc captured in our Mexican Mayan Riviera - enjoy <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord.xx.fbcdn.net\/hphotos-xfa1\/t31.0-8\/10498204_10152558963544487_7865765403738280307_o.jpg\" alt=\"10498204_10152558963544487_7865765403738\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord.xx.fbcdn.net\/hphotos-xpf1\/t31.0-8\/1496567_10152127812449487_1704896308_o.jpg\" alt=\"1496567_10152127812449487_1704896308_o.j\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord.xx.fbcdn.net\/hphotos-ash2\/t31.0-8\/1399149_10151979750379487_633506417_o.jpg\" alt=\"1399149_10151979750379487_633506417_o.jp\"><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280210660,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}}],"Id":"79131","Title":"Royalton Brides ?","LastPostDate":1430580567},"Pages":{"TotalItems":4,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
