{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":5,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":235,"MovedTo":null,"MovedOn":0,"FirstPostId":1898039,"Rating":0,"RatingHits":0,"Starter":{"Id":283419,"Name":"Rhonda3839","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1433681617,"LastPoster":{"Id":283476,"Name":"mrslewis","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1898039,"PostDate":1433681617,"PostContent":"Anyone planning a wedding here or has had one recently? My fiance and I are looking to we'd May 2...","Author":{"Signature":"","Email":"rhonda3839@aol.com","IpAddress":"32.214.84.114","GroupId":39,"GroupName":"Newbie","JoinDate":1433635517,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Rhonda3839","Id":283419,"Name":"Rhonda3839","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"32.214.84.114","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79253,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b97b754b878279e8bdf58d44eaee9cae","RawContent":"Anyone planning a wedding here or has had one recently? My fiance and I are looking to we&#039;d May 2016. We just got engaged this past April at Paradisus Palma Real and want to come back to the area. I have questions regarding the  wedding packages\/ customizations\/ grounds\/ photographers and food. Any help is appreciated","Attachments":[],"Id":1898039,"PostDate":1433681617,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Anyone planning a wedding here or has had one recently? My fiance and I are looking to we'd May 2016. We just got engaged this past April at Paradisus Palma Real and want to come back to the area. I have questions regarding the  wedding packages\/ customizations\/ grounds\/ photographers and food. Any help is appreciated \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rhonda3839@aol.com","IpAddress":"32.214.84.114","GroupId":39,"GroupName":"Newbie","JoinDate":1433635517,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Rhonda3839","Id":283419,"Name":"Rhonda3839","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.5.39.34","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79253,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"013ce77a824c76d9d46a3c9402a080df","RawContent":"&lt;p&gt;You are going to love this resort! &amp;nbsp;They have amazing incentives for wedding groups too. &amp;nbsp;You can email info@wrighttravelagency.com for more info!&lt;\/p&gt;","Attachments":[],"Id":1898047,"PostDate":1433705445,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>You are going to love this resort! \u00a0They have amazing incentives for wedding groups too. \u00a0You can email info@wrighttravelagency.com for more info!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><a class='bbc_url' href='http:\/\/wrighttravelagency.com\/inquiry\/'><span style='color: rgb(0,128,128)'>Looking for a travel agency that specializes in Destination Weddings<\/span><\/a><span style='color: rgb(0,128,128)'>? We are an award winning travel agency and you can read our reviews <\/span><a class='bbc_url' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style='color: rgb(0,128,128)'><strong class='bbc'>HERE.<\/strong><\/span><\/a><\/span><\/span><br \/>\n<br \/>\n<span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'><strong class='bbc'>Awards and recognition: <\/strong><\/span><\/span><\/span><\/span><br \/>\n<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'>Palace Resorts Top PRO Agency <\/span><\/span><\/span><\/span><br \/>\n<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'>Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator <\/span><\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>AMResorts Master Agent & Top Agency<\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>Travel Impressions Best of the Best Globe Winner<\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>Apple Vacations Golden Apple Winner<\/span><\/span><\/span>","Email":"barbara@wrighttravelagency.com","IpAddress":"69.57.225.114","GroupId":49,"GroupName":"Insiders","JoinDate":1325616705,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-249263.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"TA Babs","Id":249263,"Name":"TA Babs","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"32.214.84.114","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79253,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"077ad57eb42ff6f55e473fc9865138cf","RawContent":"I emailed last night actually and Patty responded to me. Can&#039;t wait to talk to her sometime this week can give me all the details. My fiance and I are so excited!","Attachments":[],"Id":1898048,"PostDate":1433716379,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I emailed last night actually and Patty responded to me. Can't wait to talk to her sometime this week can give me all the details. My fiance and I are so excited!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rhonda3839@aol.com","IpAddress":"32.214.84.114","GroupId":39,"GroupName":"Newbie","JoinDate":1433635517,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Rhonda3839","Id":283419,"Name":"Rhonda3839","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.114.73.167","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79253,"EditedBy":"<strong>Edited by Moments That Matter, 07 June 2015 - 04:01 PM.<\/strong>","EditDate":1433721701,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"a2e2b10b9fab8d89c3f5a7e6be17b8a7","RawContent":"&lt;p&gt;Congrats on your engagement, Rhonda3839 and welcome to our forum community :) You&#039;ll find lots of great advice, ideas, suggestions and support from everyone here, so well done on finding us!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;For some further inspiration, here are a few magical beach wedding \"moments that matter\" our premier photograher, Linc captured at some recent Mayan Riviera weddings......Enjoy!!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;...from the &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10153360211499487.1073741932.18683524486&amp;amp;type=&#039;&gt;RUI Yucatan Playacar Wedding Album: &lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xta1\/t31.0-8\/11312888_10153360212899487_3185437363785761513_o.jpg\" alt=\"11312888_10153360212899487_3185437363785\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xta1\/t31.0-8\/11270484_10153360212794487_3962152744924471433_o.jpg\" alt=\"11270484_10153360212794487_3962152744924\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xat1\/t31.0-8\/11235450_10153360215944487_75064290117880840_o.jpg\" alt=\"11235450_10153360215944487_7506429011788\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;.....or these from our &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10150695320839487.414941.18683524486&amp;amp;type=3&#039;&gt;Cover Photos: &lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xat1\/t31.0-8\/11334252_10153357324994487_6025654323044648467_o.jpg\" alt=\"11334252_10153357324994487_6025654323044\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xpa1\/t31.0-8\/1559519_10152106833954487_1160439146_o.jpg\" alt=\"1559519_10152106833954487_1160439146_o.j\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Wishing you happy research, and all the best with your plans - cheers!!! team MTM :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-prn2\/v\/t1.0-9\/p206x206\/540100_10151506610509487_1660143585_n.jpg?oh=378193bed634e7fc6ef62cd87172ccf5&amp;amp;oe=55F38737\" alt=\"540100_10151506610509487_1660143585_n.jp\"&gt;&lt;\/p&gt;","Attachments":[],"Id":1898049,"PostDate":1433721571,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats on your engagement, Rhonda3839 and welcome to our forum community <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> You'll find lots of great advice, ideas, suggestions and support from everyone here, so well done on finding us!<\/p>\n<p>\u00a0<\/p>\n<p>For some further inspiration, here are a few magical beach wedding \"moments that matter\" our premier photograher, Linc captured at some recent Mayan Riviera weddings......Enjoy!!!<\/p>\n<p>\u00a0<\/p>\n<p>...from the <a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10153360211499487.1073741932.18683524486&type=' class='bbc_url' title='External link' rel='nofollow external'>RUI Yucatan Playacar Wedding Album: <\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xta1\/t31.0-8\/11312888_10153360212899487_3185437363785761513_o.jpg\" alt=\"11312888_10153360212899487_3185437363785\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xta1\/t31.0-8\/11270484_10153360212794487_3962152744924471433_o.jpg\" alt=\"11270484_10153360212794487_3962152744924\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xat1\/t31.0-8\/11235450_10153360215944487_75064290117880840_o.jpg\" alt=\"11235450_10153360215944487_7506429011788\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>.....or these from our <a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10150695320839487.414941.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>Cover Photos: <\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xat1\/t31.0-8\/11334252_10153357324994487_6025654323044648467_o.jpg\" alt=\"11334252_10153357324994487_6025654323044\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xpa1\/t31.0-8\/1559519_10152106833954487_1160439146_o.jpg\" alt=\"1559519_10152106833954487_1160439146_o.j\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>Wishing you happy research, and all the best with your plans - cheers!!! team MTM <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-prn2\/v\/t1.0-9\/p206x206\/540100_10151506610509487_1660143585_n.jpg?oh=378193bed634e7fc6ef62cd87172ccf5&oe=55F38737\" alt=\"540100_10151506610509487_1660143585_n.jp\"><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280210660,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"64.61.116.226","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79253,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"15ef5bf682fae9cbe8fb4648df133d91","RawContent":"&lt;p&gt;Hello,&amp;nbsp; I too am interested in having my wedding here in April 2016.&amp;nbsp; I emailed Patty last night as well and she&#039;s extremely quick to respond and sent me out brochures already.&amp;nbsp; I&#039;m worried about the prices and costs for the guests.&amp;nbsp; It seems to be extremely expensive when I looked at the prices for my date and range it was about $475 per night :( .&amp;nbsp; I&#039;m hoping that everyone can come but at the same time, I want to have the wedding of my dreams.&amp;nbsp; Does anyone know about the credits we receive? $1800?&lt;\/p&gt;","Attachments":[],"Id":1898360,"PostDate":1434028985,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello,\u00a0 I too am interested in having my wedding here in April 2016.\u00a0 I emailed Patty last night as well and she's extremely quick to respond and sent me out brochures already.\u00a0 I'm worried about the prices and costs for the guests.\u00a0 It seems to be extremely expensive when I looked at the prices for my date and range it was about $475 per night <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/sad.png' class='bbc_emoticon' alt=':(' \/> .\u00a0 I'm hoping that everyone can come but at the same time, I want to have the wedding of my dreams.\u00a0 Does anyone know about the credits we receive? $1800?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"dixon.chloe@gmail.com","IpAddress":"64.61.116.226","GroupId":39,"GroupName":"Newbie","JoinDate":1433942014,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"mrslewis","Id":283476,"Name":"mrslewis","IsOnline":false}}],"Id":"79253","Title":"Hard Rock Punta Cana","LastPostDate":1434028985},"Pages":{"TotalItems":5,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
