0731;0\/st\/20160423\/e\/we+leave+for+Mexico%21\/k\/c059\/event.png\" alt=\"event.png\"><\/a>\u00a0 \u00a0\u00a0\u00a0 \u00a0\u00a0<a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;32;116\/st\/20160430\/e\/we+say+I+do%21\/k\/8afc\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<\/div>\n<p>\u00a0<\/p>\n<p>My Planning Thread:<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79580-deecols-planning-thread-gbp-april-30th-2016\/#entry1904529'>http:\/\/www.bestdestinationwedding.com\/topic\/79580-deecols-planning-thread-gbp-april-30th-2016\/#entry1904529<\/a>","Email":"deannaproteau@hotmail.com","IpAddress":"207.134.141.162","GroupId":40,"GroupName":"Jr. Member","JoinDate":1421424569,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281751.jpg?_r=1442083173","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"deecol","Id":281751,"Name":"deecol","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79407,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":3,"IsLiked":false,"PostKey":"952c83be1d295c67c5101e44bc01fd00","RawContent":"&lt;p&gt;I&#039;ve also heard great things about the wedding DJ app. I don&#039;t have an iPhone myself, but I do have an iPad, so I think we are going to load that up with all the music and try it out! We aren&#039;t hiring a DJ so this is pretty much our only option at this point.&lt;\/p&gt;","Attachments":[],"Id":1900779,"PostDate":1437398310,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I've also heard great things about the wedding DJ app. I don't have an iPhone myself, but I do have an iPad, so I think we are going to load that up with all the music and try it out! We aren't hiring a DJ so this is pretty much our only option at this point.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419419814,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1436293677","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.134.141.162","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79407,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"706bcf78e80d4c8e0686350d0e90f066","RawContent":"&lt;p&gt;@[member=\"perianjay\"] We&#039;re thinking along the same lines.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;If you do use an app let me know how it is :)&lt;\/p&gt;","Attachments":[],"Id":1900825,"PostDate":1437463907,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"281478\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281478-perianjay\/' title='Member profile'><span itemprop=\"name\">perianjay<\/span><\/a> We're thinking along the same lines.<\/p>\n<p>\u00a0<\/p>\n<p>If you do use an app let me know how it is <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div><img src=\"http:\/\/\" alt=\"\"><\/div>\n<div><br><div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;0\/st\/20160423\/e\/we+leave+for+Mexico%21\/k\/c059\/event.png\" alt=\"event.png\"><\/a>\u00a0 \u00a0\u00a0\u00a0 \u00a0\u00a0<a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;32;116\/st\/20160430\/e\/we+say+I+do%21\/k\/8afc\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<\/div>\n<p>\u00a0<\/p>\n<p>My Planning Thread:<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79580-deecols-planning-thread-gbp-april-30th-2016\/#entry1904529'>http:\/\/www.bestdestinationwedding.com\/topic\/79580-deecols-planning-thread-gbp-april-30th-2016\/#entry1904529<\/a>","Email":"deannaproteau@hotmail.com","IpAddress":"207.134.141.162","GroupId":40,"GroupName":"Jr. Member","JoinDate":1421424569,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281751.jpg?_r=1442083173","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"deecol","Id":281751,"Name":"deecol","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"170.146.220.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79407,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"d54d43173c1c3a0732dba232ff3e95aa","RawContent":"&lt;p&gt;@[member=\"TinkerSofi\"]...thank you for all your info on this app! It really helps...I have 2 questions for you. 1. Do you know if you can edit music with it? For example, I want our recessional song to start about halfway through the song...should I pre-edit it? If so, any suggestions on an app that would do that? :) 2. What type of speakers will you be using. The cost to rent a PA system for our wedding is crazy expensive so we were thinking of bringing our own...&lt;\/p&gt;\n&lt;p&gt;Thanks!!! Brooke&lt;\/p&gt;","Attachments":[],"Id":1901522,"PostDate":1438186313,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"265511\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/265511-tinkersofi\/' title='Member profile'><span itemprop=\"name\">TinkerSofi<\/span><\/a>...thank you for all your info on this app! It really helps...I have 2 questions for you. 1. Do you know if you can edit music with it? For example, I want our recessional song to start about halfway through the song...should I pre-edit it? If so, any suggestions on an app that would do that? <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> 2. What type of speakers will you be using. The cost to rent a PA system for our wedding is crazy expensive so we were thinking of bringing our own...<\/p>\n<p>Thanks!!! Brooke<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"weddingbb2015@gmail.com","IpAddress":"107.217.9.121","GroupId":39,"GroupName":"Newbie","JoinDate":1420319446,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281588.jpg?_r=1439315189","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"BB2015","Id":281588,"Name":"BB2015","IsOnline":false}}],"Id":"79407","Title":"Wedding Dj Apps?","LastPostDate":1442450984},"Pages":{"TotalItems":15,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
