{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":38,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":4796,"MovedTo":null,"MovedOn":0,"FirstPostId":891598,"Rating":0,"RatingHits":0,"Starter":{"Id":218828,"Name":"*~Tara~*","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-218828.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"IsOnline":false},"StartDate":1256001395,"LastPoster":{"Id":277964,"Name":"Sanael","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"none"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":22,"Preview":{"Id":891598,"PostDate":1256001395,"PostContent":"Hi Everyone,  I've been looking around this site for some time now hoping to find a list of excur...","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><strong>My Wedding Review<\/strong><span>: <\/span><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f33\/wedding-review-dec-7-09-majestic-elegance-jellyfish-restaurant-56600\/\">http:\/\/bestdestinationwedding.com\/fo...taurant-56600\/<\/a><\/div><\/div>","Email":"tara_ann19@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1246015171,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-218828.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"*~Tara~*","Id":218828,"Name":"*~Tara~*","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44039,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"766a70cad01aa5407a6c1fe0201d50f6","RawContent":"Hi Everyone,\n \n I&#039;ve been looking around this site for some time now hoping to find a list of excursions available in Punta Cana, but I&#039;ve had no luck so far. Do any of you know what&#039;s available or where I can go to find out more information about them? I asked my wedding planner for a list, but she didn&#039;t give me one and just said that I would be able to make my arrangements once I arrive- not very helpful. I&#039;m trying to be organized and since we are going to spend a good portion of our wedding &amp;quot;entertaining&amp;quot; our guests and are going to have to share our time, it would definitely be helpful to review our options and make plans before we go down. Don&#039;t know if it matters, but I&#039;m staying at the Majestic Elegance. Sorry if this has already been posted somewhere else and I just haven&#039;t found it! \n \n Thanks for your help!","Attachments":[],"Id":891598,"PostDate":1256001395,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi Everyone,<br \/> <br \/> I've been looking around this site for some time now hoping to find a list of excursions available in Punta Cana, but I've had no luck so far. Do any of you know what's available or where I can go to find out more information about them? I asked my wedding planner for a list, but she didn't give me one and just said that I would be able to make my arrangements once I arrive- not very helpful. I'm trying to be organized and since we are going to spend a good portion of our wedding \"entertaining\" our guests and are going to have to share our time, it would definitely be helpful to review our options and make plans before we go down. Don't know if it matters, but I'm staying at the Majestic Elegance. Sorry if this has already been posted somewhere else and I just haven't found it! <br \/> <br \/> Thanks for your help!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><strong>My Wedding Review<\/strong><span>: <\/span><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f33\/wedding-review-dec-7-09-majestic-elegance-jellyfish-restaurant-56600\/\">http:\/\/bestdestinationwedding.com\/fo...taurant-56600\/<\/a><\/div><\/div>","Email":"tara_ann19@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1246015171,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-218828.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"*~Tara~*","Id":218828,"Name":"*~Tara~*","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44039,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e076b53d82a7217f85f00a94ba2fb537","RawContent":"I was given an email for a catamaran in Punta Cana. I will see if I can dig up the email; hopefully I didn&#039;t delete it in my email cleanse frenzy...","Attachments":[],"Id":891726,"PostDate":1256005648,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I was given an email for a catamaran in Punta Cana. I will see if I can dig up the email; hopefully I didn't delete it in my email cleanse frenzy...\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nolanss@hotmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1245769860,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-218714.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"SSNM","Id":218714,"Name":"SSNM","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44039,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4c1f17fdf0c16bfb07e95e2a6b41bf26","RawContent":"...found it! Jose Ramon Hernandez, Groups &amp;amp; Incentives Supervisor, Amstar DMC, Dominican Republic\n \n &lt;a data-ipb=&#039;nomediaparse&#039; href=\"mailto:josherna@amstardmc.com\"&gt;josherna@amstardmc.com&lt;\/a&gt;\n \n Got his info from the WC at Dreams Punta Cana when I inquired about catamarans\/excursions. You can email him and see what he offers. I never got back to him as he asked me if I was a travel agent, wedding planner, or private client. I decided that I wanted to find one of the former to talk to him for more bargaining power &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/wink.gif\" border=\"0\" alt=\"\" title=\"Wink\" class=\"inlineimg\" \/&gt;","Attachments":[],"Id":891735,"PostDate":1256005874,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                ...found it! Jose Ramon Hernandez, Groups & Incentives Supervisor, Amstar DMC, Dominican Republic<br \/> <br \/> <a href='mailto:josherna@amstardmc.com' class='bbc_url' title='External link' rel='nofollow external'>josherna@amstardmc.com<\/a><br \/> <br \/> Got his info from the WC at Dreams Punta Cana when I inquired about catamarans\/excursions. You can email him and see what he offers. I never got back to him as he asked me if I was a travel agent, wedding planner, or private client. I decided that I wanted to find one of the former to talk to him for more bargaining power <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/wink.gif\" border=\"0\" alt=\"\" title=\"Wink\" class=\"inlineimg\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nolanss@hotmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1245769860,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-218714.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"SSNM","Id":218714,"Name":"SSNM","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44039,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f6575c7286dbde1dd3ea22d338b52521","RawContent":"Here is the site SSNM is talking about. &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.amstardmc.com\/dominican_republic\/destinations\/punta_cana\/punta_cana_zip_lines.php#\"&gt;Amstar dmc, Dominican Republic Destinations&lt;\/a&gt; We are looking to do the Zip Line. It will all just depend on the type of people you have or what you are looking to do. Do you want more active stuff or more like site seeing?\n \n This is another one we are looking at:\n &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.fun-buggy.com\/eng.html\"&gt;fun-buggy caribe eng&lt;\/a&gt;\n Trip Advisor:\n &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.tripadvisor.com\/Attraction_Review-g147293-d1534533-Reviews-Fun_Buggy-Punta_Cana_Dominican_Republic.html\"&gt;Fun-Buggy - Punta Cana - Reviews of Fun-Buggy - TripAdvisor&lt;\/a&gt;\n \n &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.xtreme-buggy.com\/Welcome.html\"&gt;Welcome&lt;\/a&gt;\n \n If you go on Trip Advisor and just type in Punta Cana a list will come up on the left hand side and it will say Things to do. It will give you a list and the reveiws to go along with it.\n &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.tripadvisor.com\/Attractions-g147293-Activities-Punta_Cana_Dominican_Republic.html\"&gt;Things to Do in Punta Cana - Punta Cana Attractions - TripAdvisor&lt;\/a&gt;","Attachments":[],"Id":891961,"PostDate":1256042361,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Here is the site SSNM is talking about. <a href='http:\/\/www.amstardmc.com\/dominican_republic\/destinations\/punta_cana\/punta_cana_zip_lines.php#' class='bbc_url' title='External link' rel='nofollow external'>Amstar dmc, Dominican Republic Destinations<\/a> We are looking to do the Zip Line. It will all just depend on the type of people you have or what you are looking to do. Do you want more active stuff or more like site seeing?<br \/> <br \/> This is another one we are looking at:<br \/> <a href='http:\/\/www.fun-buggy.com\/eng.html' class='bbc_url' title='External link' rel='nofollow external'>fun-buggy caribe eng<\/a><br \/> Trip Advisor:<br \/> <a href='http:\/\/www.tripadvisor.com\/Attraction_Review-g147293-d1534533-Reviews-Fun_Buggy-Punta_Cana_Dominican_Republic.html' class='bbc_url' title='External link' rel='nofollow external'>Fun-Buggy - Punta Cana - Reviews of Fun-Buggy - TripAdvisor<\/a><br \/> <br \/> <a href='http:\/\/www.xtreme-buggy.com\/Welcome.html' class='bbc_url' title='External link' rel='nofollow external'>Welcome<\/a><br \/> <br \/> If you go on Trip Advisor and just type in Punta Cana a list will come up on the left hand side and it will say Things to do. It will give you a list and the reveiws to go along with it.<br \/> <a href='http:\/\/www.tripadvisor.com\/Attractions-g147293-Activities-Punta_Cana_Dominican_Republic.html' class='bbc_url' title='External link' rel='nofollow external'>Things to Do in Punta Cana - Punta Cana Attractions - TripAdvisor<\/a>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Cory & Jennifer<\/span><br><span>March 13, 2010Punta Cana D.R.!!<\/span><a data-ipb='nomediaparse' href=\"http:\/\/i150.photobucket.com\/albums\/s106\/jnc1983\/IMG_6740.jpg\">http:\/\/i150.photobucket.com\/albums\/s...3\/IMG_6740.jpg<\/a><\/div><\/div>","Email":"lcbabe01@msn.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1231441897,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213735.gif?_r=0","PhotoWidth":26,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Outdoor_girl1010","Id":213735,"Name":"Outdoor_girl1010","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44039,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e0450c5cbca51578071bd5cc6174f94f","RawContent":"Outdoor Girl thank you so much!!!","Attachments":[],"Id":894217,"PostDate":1256157662,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Outdoor Girl thank you so much!!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/global.theknot.com\/tools\/tickers\/tt44496.aspx\">http:\/\/global.theknot.com\/tools\/tickers\/tt44496.aspx<\/a><br><br><br><span>52 booked + The Bride and Groom!!!<\/span><br><a data-ipb='nomediaparse' href=\"http:\/\/i69.photobucket.com\/albums\/i70\/Jimmyjess\/DSC02673.jpg\">http:\/\/i69.photobucket.com\/albums\/i7...s\/DSC02673.jpg<\/a><span>Me and my Bridesmaids at my Bachelorette Party on a Roof Top with Manhattan in the background.<\/span><\/div><\/div>","Email":"jessicamrodriguez@yahoo.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1241896872,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-217398.gif?_r=0","PhotoWidth":42,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"TheFutureMrs.Sears","Id":217398,"Name":"TheFutureMrs.Sears","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44039,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d16bb908cd1129d5d0bb65ebf54ce8b9","RawContent":"Here is the link for a cruise company: &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.weddingboatpuntacana.com\"&gt;Wedding Punta Cana. The best Wedding in Punta Cana, Dominican Republic.&lt;\/a&gt;. The company is called la barcaza. They have different kinds of cruises with just drinks or snacks or full meals etc..","Attachments":[],"Id":894398,"PostDate":1256168065,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Here is the link for a cruise company: <a href='http:\/\/www.weddingboatpuntacana.com' class='bbc_url' title='External link' rel='nofollow external'>Wedding Punta Cana. The best Wedding in Punta Cana, Dominican Republic.<\/a>. The company is called la barcaza. They have different kinds of cruises with just drinks or snacks or full meals etc..\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;130\/st\/20100120\/e\/on+my+way+to+being+mrs+L\/k\/e51f\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...e51f\/event.png<\/a><\/div><\/div>","Email":"tamtret@hotmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1249046349,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-220034.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"Tam","Id":220034,"Name":"Tam","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44039,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c6b192f8716040d5ded8f09fa3244621","RawContent":"Thanks everyone! Sooo helpful!! Lots of ideas to think about now :)","Attachments":[],"Id":894605,"PostDate":1256182897,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks everyone! Sooo helpful!! Lots of ideas to think about now <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><strong>My Wedding Review<\/strong><span>: <\/span><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f33\/wedding-review-dec-7-09-majestic-elegance-jellyfish-restaurant-56600\/\">http:\/\/bestdestinationwedding.com\/fo...taurant-56600\/<\/a><\/div><\/div>","Email":"tara_ann19@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1246015171,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-218828.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"*~Tara~*","Id":218828,"Name":"*~Tara~*","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44039,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a101ec3062147cb06b5c3a7f1954eee9","RawContent":"Have you joined the Majestic Brides Facebook site? There&#039;s lot of great info on there including info on excursions that people have gone on. We did the Caribbean Festival last year which included swimming with sharks and sting-rays and that was good. I&#039;ve also heard that the Safari one, I can&#039;t think of the name right now it good (where you get to see the Dominican way of life, etc.) Besides that we&#039;ve done parasailing and horseback riding from the vendors that walk the beach and hope to maybe do a zip-line this year. Our tour operator last year told us that the dolphins wasn&#039;t worth the time\/money and I&#039;ve heard that the deep sea fishing can be a really rough trip!! A girl I work with did it with her husband and 7 out of 8 on the boat got sick from how rough it was just trying to get out.","Attachments":[],"Id":894630,"PostDate":1256186238,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Have you joined the Majestic Brides Facebook site? There's lot of great info on there including info on excursions that people have gone on. We did the Caribbean Festival last year which included swimming with sharks and sting-rays and that was good. I've also heard that the Safari one, I can't think of the name right now it good (where you get to see the Dominican way of life, etc.) Besides that we've done parasailing and horseback riding from the vendors that walk the beach and hope to maybe do a zip-line this year. Our tour operator last year told us that the dolphins wasn't worth the time\/money and I've heard that the deep sea fishing can be a really rough trip!! A girl I work with did it with her husband and 7 out of 8 on the boat got sick from how rough it was just trying to get out.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"karen-aucoin@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1232319034,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Karen Aucoin","Id":214081,"Name":"Karen Aucoin","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44039,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"dac22b2c6dd9da96d27b21481f1dc91d","RawContent":"Hi there! \n I lived in Punta cana for 7 months (working at a resort) so I tried most of the excursions since they were free for me. The one I think most people would enjoy is the trip to Saona Island. I believe it&#039;s offered by most of the hotels, and it&#039;s a full-day trip. You take a bus from the hotel, then a motorboat and a catamaran. You get to see live starfish, flying fish, swim in a natural pool, and hang out at a really nice beach. It&#039;s a great place for collecting shells and coral if any kids are with you. They also serve lunch at the island.\n \n I also enjoyed the shopping excursion in Bavaro since they took us to a cigar factory and a place that makes fruit flavoured rums in hand painted bottles (like banana rum, passionfruit, etc). They can personalize them however you want, which is pretty cool. \n \n I agree that you shouldn&#039;t bother with the dolphin thing...it&#039;s not worth the money. And unless you REALLY want to go to Santo Domingo, don&#039;t bother with that one either cuz it&#039;s a very long day and your guests will be tired after! \n \n If you have any questions send me a message!","Attachments":[],"Id":894652,"PostDate":1256208211,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi there! <br \/> I lived in Punta cana for 7 months (working at a resort) so I tried most of the excursions since they were free for me. The one I think most people would enjoy is the trip to Saona Island. I believe it's offered by most of the hotels, and it's a full-day trip. You take a bus from the hotel, then a motorboat and a catamaran. You get to see live starfish, flying fish, swim in a natural pool, and hang out at a really nice beach. It's a great place for collecting shells and coral if any kids are with you. They also serve lunch at the island.<br \/> <br \/> I also enjoyed the shopping excursion in Bavaro since they took us to a cigar factory and a place that makes fruit flavoured rums in hand painted bottles (like banana rum, passionfruit, etc). They can personalize them however you want, which is pretty cool. <br \/> <br \/> I agree that you shouldn't bother with the dolphin thing...it's not worth the money. And unless you REALLY want to go to Santo Domingo, don't bother with that one either cuz it's a very long day and your guests will be tired after! <br \/> <br \/> If you have any questions send me a message!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"redheadkatie@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1254006506,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-222036.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"rubialoca","Id":222036,"Name":"rubialoca","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44039,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a69e0778c14f4d778de7ca2cf9358b48","RawContent":"Which tour operator are you going with Tara? You might find some options on the web site of the tour operator or in the brochures. I have a brochure and price list but please note they are from March 2009 but hopefully it gives you an idea. Hope this helps!&lt;p&gt;&amp;nbsp;&lt;\/p&gt;&lt;span huddler_attributes=\"{&amp;quot;plugin&amp;quot;:&amp;quot;attachment&amp;quot;,&amp;quot;params&amp;quot;:{&amp;quot;id&amp;quot;:&amp;quot;6625&amp;quot;,&amp;quot;name&amp;quot;:&amp;quot;Excursion booking form.pdf&amp;quot;,&amp;quot;description&amp;quot;:&amp;quot;&amp;quot;,&amp;quot;size&amp;quot;:412.451171875,&amp;quot;type&amp;quot;:&amp;quot;pdf&amp;quot;}}\" huddler_plugin=\"attachment\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;p&gt;&amp;nbsp;&lt;\/p&gt;&lt;span huddler_attributes=\"{&amp;quot;plugin&amp;quot;:&amp;quot;attachment&amp;quot;,&amp;quot;params&amp;quot;:{&amp;quot;id&amp;quot;:&amp;quot;6626&amp;quot;,&amp;quot;name&amp;quot;:&amp;quot;Excursion description.pdf&amp;quot;,&amp;quot;description&amp;quot;:&amp;quot;&amp;quot;,&amp;quot;size&amp;quot;:496.3544921875,&amp;quot;type&amp;quot;:&amp;quot;pdf&amp;quot;}}\" huddler_plugin=\"attachment\"&gt;&amp;nbsp;&lt;\/span&gt;","Attachments":[],"Id":894653,"PostDate":1256208212,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Which tour operator are you going with Tara? You might find some options on the web site of the tour operator or in the brochures. I have a brochure and price list but please note they are from March 2009 but hopefully it gives you an idea. Hope this helps!<p>\u00a0<\/p><span huddler_attributes=\"{\"plugin\":\"attachment\",\"params\":{\"id\":\"6625\",\"name\":\"Excursion booking form.pdf\",\"description\":\"\",\"size\":412.451171875,\"type\":\"pdf\"}}\" huddler_plugin=\"attachment\">\u00a0<\/span><p>\u00a0<\/p><span huddler_attributes=\"{\"plugin\":\"attachment\",\"params\":{\"id\":\"6626\",\"name\":\"Excursion description.pdf\",\"description\":\"\",\"size\":496.3544921875,\"type\":\"pdf\"}}\" huddler_plugin=\"attachment\">\u00a0<\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"helen_s81@hotmail.com","IpAddress":"69.157.125.20","GroupId":3,"GroupName":"Member","JoinDate":1194741234,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207919.jpeg?_r=0","PhotoWidth":180,"PhotoHeight":224,"PhotoType":"custom"},"FormattedName":"Helen_S81","Id":207919,"Name":"Helen_S81","IsOnline":false}}],"Id":"44039","Title":"Punta Cana Excursions","LastPostDate":1406235001},"Pages":{"TotalItems":38,"TotalPages":4,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":30},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
