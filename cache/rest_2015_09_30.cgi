{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":7,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":682,"MovedTo":null,"MovedOn":0,"FirstPostId":1883251,"Rating":0,"RatingHits":0,"Starter":{"Id":281539,"Name":"Karenanne83","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281539.jpg?_r=1421886704","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"StartDate":1421602295,"LastPoster":{"Id":284359,"Name":"thuytien146","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284359.jpg?_r=1439261366","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":22,"Preview":{"Id":1883251,"PostDate":1421602295,"PostContent":"Hi! Well I think we have picked Dreams Palm Beach as our wedding destination, we will be booking...","Author":{"Signature":"","Email":"karenaustwick@yahoo.co.uk","IpAddress":"83.100.154.110","GroupId":39,"GroupName":"Newbie","JoinDate":1420103185,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281539.jpg?_r=1421886704","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"Karenanne83","Id":281539,"Name":"Karenanne83","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"83.100.154.110","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78623,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3dc90c1c350fc7296e31c75c6b517a69","RawContent":"Hi!\n\nWell I think we have picked Dreams Palm Beach as our wedding destination, we will be booking shortly. \n\nWe are looking at July 2016. \n\nAny dreams palm beach brides out there that have booked\/had their wedding?\n\nAny advice?\n\nI find their packages info confusing so don&#039;t know what options are best!\n\nKaren xx","Attachments":[],"Id":1883251,"PostDate":1421602295,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi!<br>\nWell I think we have picked Dreams Palm Beach as our wedding destination, we will be booking shortly. <br>\nWe are looking at July 2016. <br>\nAny dreams palm beach brides out there that have booked\/had their wedding?<br>\nAny advice?<br>\nI find their packages info confusing so don't know what options are best!<br>\nKaren xx\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"karenaustwick@yahoo.co.uk","IpAddress":"83.100.154.110","GroupId":39,"GroupName":"Newbie","JoinDate":1420103185,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281539.jpg?_r=1421886704","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"Karenanne83","Id":281539,"Name":"Karenanne83","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.249.106.58","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78623,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"09cb1f2cf293e8727fb6bad978493813","RawContent":"&lt;p&gt;Hi! We are getting married there on March 6th! So far, everything has been great. My advice would be to stay in contact with your wedding coordinator if you have any questions or concerns!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Let me know if you have any questions!&lt;\/p&gt;","Attachments":[],"Id":1883267,"PostDate":1421614791,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi! We are getting married there on March 6th! So far, everything has been great. My advice would be to stay in contact with your wedding coordinator if you have any questions or concerns!<\/p>\n<p>\u00a0<\/p>\n<p>Let me know if you have any questions!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kelly_miller_@hotmail.com","IpAddress":"99.249.122.85","GroupId":40,"GroupName":"Jr. Member","JoinDate":1390772931,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kellymiller","Id":276338,"Name":"kellymiller","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"83.100.154.110","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78623,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"46902cfd0fdef98397de8bbb80b620ae","RawContent":"That&#039;s great! I can&#039;t wait to hear all about your wedding! How many guests will you have with you? \n\nHave you decided where your ceremony will be and reception etc?","Attachments":[],"Id":1883268,"PostDate":1421615853,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                That's great! I can't wait to hear all about your wedding! How many guests will you have with you? <br>\nHave you decided where your ceremony will be and reception etc?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"karenaustwick@yahoo.co.uk","IpAddress":"83.100.154.110","GroupId":39,"GroupName":"Newbie","JoinDate":1420103185,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281539.jpg?_r=1421886704","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"Karenanne83","Id":281539,"Name":"Karenanne83","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.249.106.58","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78623,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"65c9182ef0080ed92b21f344c3c41b38","RawContent":"&lt;p&gt;We will have about 23 guests (we have some who might book last minute due to work issues). We picked the Garden gazebo for the ceremony and the pool island for the reception.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I wouldn&#039;t worry about the packages yet, we didn&#039;t decide on a package until we knew our guest count. That way we could figure out what worked best with the number of people we had attending. It really depends on what you want. We went with the Ultimate package (the biggest one) because it included so much of the stuff that we wanted (video of ceremony, hair and makeup for the bride, best menu option etc), so you just need to figure out what you want included for your wedding then pick the package that best suits that.&lt;\/p&gt;","Attachments":[],"Id":1883282,"PostDate":1421629364,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>We will have about 23 guests (we have some who might book last minute due to work issues). We picked the Garden gazebo for the ceremony and the pool island for the reception.<\/p>\n<p>\u00a0<\/p>\n<p>I wouldn't worry about the packages yet, we didn't decide on a package until we knew our guest count. That way we could figure out what worked best with the number of people we had attending. It really depends on what you want. We went with the Ultimate package (the biggest one) because it included so much of the stuff that we wanted (video of ceremony, hair and makeup for the bride, best menu option etc), so you just need to figure out what you want included for your wedding then pick the package that best suits that.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kelly_miller_@hotmail.com","IpAddress":"99.249.122.85","GroupId":40,"GroupName":"Jr. Member","JoinDate":1390772931,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kellymiller","Id":276338,"Name":"kellymiller","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"45.21.22.154","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78623,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"60f31dc9a037a09f5b3feb72e7177450","RawContent":"&lt;p&gt;Hi! My fiance and I decided on Dreams Palm Beach for our wedding on April 30th 2016. I sent my Wedding Request Form and Deposit in over a week ago but have yet to receive a confirmation. I have emailed the coordinator, that I was communicating with prior to making our decision, several times but have yet to receive a response. Did anyone else have this issue? I am a bit concerned that I have not heard anything and I am hoping this is not a preview of what is to come. Thanks in advance for any advice or input!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1901827,"PostDate":1438716923,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi! My fiance and I decided on Dreams Palm Beach for our wedding on April 30th 2016. I sent my Wedding Request Form and Deposit in over a week ago but have yet to receive a confirmation. I have emailed the coordinator, that I was communicating with prior to making our decision, several times but have yet to receive a response. Did anyone else have this issue? I am a bit concerned that I have not heard anything and I am hoping this is not a preview of what is to come. Thanks in advance for any advice or input!<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"brittany.mayfield84@yahoo.com","IpAddress":"45.21.22.154","GroupId":39,"GroupName":"Newbie","JoinDate":1438716508,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284275.jpg?_r=1439699749","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"bmayfiel","Id":284275,"Name":"bmayfiel","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.69.169.241","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78623,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f1706ce99dc61399ef4035814ab01fce","RawContent":"Hi.. My fianc\u00e9 and I are getting married there on April 26.. I had the same experience with the wedding coordinator ..we are working with a travel agent and she was successful in getting in touch with her and getting the name of our specific wedding coordinator. I was initially emailing Cristina .. But contact with my specific coordinator (Chantal) has been better .. Even though they still have not charged my credit card for my deposit. I was reading other reviews and this appears to be a consistent issue but everyone claims their weddings are amazing once they are there.  Hope this helps \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1902227,"PostDate":1439228659,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi.. My fianc\u00e9 and I are getting married there on April 26.. I had the same experience with the wedding coordinator ..we are working with a travel agent and she was successful in getting in touch with her and getting the name of our specific wedding coordinator. I was initially emailing Cristina .. But contact with my specific coordinator (Chantal) has been better .. Even though they still have not charged my credit card for my deposit. I was reading other reviews and this appears to be a consistent issue but everyone claims their weddings are amazing once they are there.  Hope this helps <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"taw98001@hotmail.com","IpAddress":"75.69.169.241","GroupId":3,"GroupName":"Member","JoinDate":1437693034,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"duckgrl7","Id":284106,"Name":"duckgrl7","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"14.177.241.215","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78623,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fa50af1ad80caf690ab114e65162e39c","RawContent":"&lt;p&gt;hj&amp;nbsp;I love weddings on the beach, romantic&lt;\/p&gt;","Attachments":[],"Id":1902259,"PostDate":1439261337,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>hj\u00a0I love weddings on the beach, romantic<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><a data-ipb='nomediaparse' href='http:\/\/dochoitinhduc368.com'><em><b>\u0110\u1ed3 ch\u01a1i t\u00ecnh d\u1ee5c cho n\u1eef<\/b><\/em><\/a>","Email":"lapdatcameraquansathaphuong@gmail.com","IpAddress":"14.177.241.215","GroupId":39,"GroupName":"Newbie","JoinDate":1439260976,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284359.jpg?_r=1439261366","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"thuytien146","Id":284359,"Name":"thuytien146","IsOnline":false}}],"Id":"78623","Title":"Dreams Palm Beach Punta Cana","LastPostDate":1439261337},"Pages":{"TotalItems":7,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
