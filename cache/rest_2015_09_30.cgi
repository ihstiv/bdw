{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":16,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":1824,"MovedTo":null,"MovedOn":0,"FirstPostId":1855912,"Rating":0,"RatingHits":0,"Starter":{"Id":268499,"Name":"Meandhim","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268499.jpg?_r=1395417550","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"StartDate":1403067656,"LastPoster":{"Id":261965,"Name":"csho","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-261965.jpg?_r=1400781457","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":22,"Preview":{"Id":1855912,"PostDate":1403067656,"PostContent":"So it's seems as though our wedding is just not going to happen...am I crazy?","Author":{"Signature":"<div>\u00a0<\/div>\n<div><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78914-meandhim-grand-palladium-bavaro-nov-2015\/'>My Planning Thread<\/a>\u00a0- MeandHim - Grand Palladium Bavaro - Nov 25 2015<\/div>\n<div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10765;116\/st\/20151125\/e\/Our+Wedding\/k\/461e\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"markandshavonne@live.com","IpAddress":"70.30.85.211","GroupId":3,"GroupName":"Member","JoinDate":1365792059,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268499.jpg?_r=1395417550","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"Meandhim","Id":268499,"Name":"Meandhim","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"209.91.107.136","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77352,"EditedBy":"<strong>Edited by Meandhim, 17 June 2014 - 09:16 PM.<\/strong>","EditDate":1403068588,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e9a8fd51105877d026ae91e33f593b6b","RawContent":"So it&#039;s seems as though our wedding is just not going to happen...am I crazy?","Attachments":[],"Id":1855912,"PostDate":1403067656,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                So it's seems as though our wedding is just not going to happen...am I crazy?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div>\u00a0<\/div>\n<div><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78914-meandhim-grand-palladium-bavaro-nov-2015\/'>My Planning Thread<\/a>\u00a0- MeandHim - Grand Palladium Bavaro - Nov 25 2015<\/div>\n<div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10765;116\/st\/20151125\/e\/Our+Wedding\/k\/461e\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"markandshavonne@live.com","IpAddress":"70.30.85.211","GroupId":3,"GroupName":"Member","JoinDate":1365792059,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268499.jpg?_r=1395417550","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"Meandhim","Id":268499,"Name":"Meandhim","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"206.223.185.220","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77352,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c507b0bed770bd179b6a1ab3b0cc2470","RawContent":"&lt;p&gt;OMG! Why?? What kind of advice are you looking for?&lt;\/p&gt;","Attachments":[],"Id":1855934,"PostDate":1403096917,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>OMG! Why?? What kind of advice are you looking for?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><em><span style=\"color:rgb(51,153,255);\">I'm lucky enough to\u00a0tell my husband how much I love him and say yes again\u00a0on October 20, 2015 at Grand Coral Beach Club!\u00a0<\/span><\/em>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283458999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"89.100.218.185","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77352,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fabe5037968fadd5bb862931189ca3f8","RawContent":"Oh my goodness, what happened??","Attachments":[],"Id":1855935,"PostDate":1403097211,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Oh my goodness, what happened??\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"prendest@tcd.ie","IpAddress":"89.100.218.185","GroupId":40,"GroupName":"Jr. Member","JoinDate":1382557289,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-274502.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"stefadile","Id":274502,"Name":"stefadile","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.222.63.146","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77352,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1275d4a3c794dde553b1f508d0a6e6a6","RawContent":"&lt;p&gt;Oh my goodness! I hope everything works out for you!&lt;\/p&gt;","Attachments":[],"Id":1855956,"PostDate":1403102394,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Oh my goodness! I hope everything works out for you!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Happily Married!<\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/74669-destination-engagement-photos-dubrovnik-croatia\/?hl=%2Bcroatia+%2Bengagement+%2Bphotos'>http:\/\/www.bestdestinationwedding.com\/topic\/74669-destination-engagement-photos-dubrovnik-croatia\/?hl=%2Bcroatia+%2Bengagement+%2Bphotos<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/76346-carinas-csho-iberostar-laguna-azul-planning-journal-050514\/'>http:\/\/www.bestdestinationwedding.com\/topic\/76346-carinas-csho-iberostar-laguna-azul-planning-journal-050514\/<\/a>","Email":"crins_15@hotmail.com","IpAddress":"24.222.63.146","GroupId":42,"GroupName":"Sr. Member","JoinDate":1351780968,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-261965.jpg?_r=1400781457","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"csho","Id":261965,"Name":"csho","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"199.180.174.8","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77352,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"cace5990d1ee1ede95897d7d6d87749d","RawContent":"&lt;p&gt;is it travel issue you are dealing with. I know all too well what that&#039;s like. Some days I feel like throwing in the towel and just eloping...lol. We are all here for you whatever the issue if you need any advice on what to do. All the ladies on here, as you know, are amazing. I wouldn&#039;t have made it this far without some sort of breakdown if it wasn&#039;t for this forum.&lt;\/p&gt;","Attachments":[],"Id":1855973,"PostDate":1403106375,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>is it travel issue you are dealing with. I know all too well what that's like. Some days I feel like throwing in the towel and just eloping...lol. We are all here for you whatever the issue if you need any advice on what to do. All the ladies on here, as you know, are amazing. I wouldn't have made it this far without some sort of breakdown if it wasn't for this forum.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p style=\"text-align:center;\"><strong>Kristy and Nathan<\/strong><\/p>\n<p style=\"text-align:center;\"><strong>Melia Caribe Tropical <\/strong><\/p>\n<p style=\"text-align:center;\"><strong>April 17, 2015<\/strong>","Email":"colek_64@hotmail.com","IpAddress":"199.180.174.8","GroupId":3,"GroupName":"Member","JoinDate":1395346614,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277264.jpg?_r=1429937323","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"kcole123","Id":277264,"Name":"kcole123","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.114.27.37","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77352,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"63a2d1c98504537bd6be31d3b987637f","RawContent":"I read your post last night (or maybe it was a different post) and saw some of the issues you were facing.... No real answer for you but I understand how you are stressed! As for the travel issues hopefully that can be resolved!! \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1855997,"PostDate":1403108685,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I read your post last night (or maybe it was a different post) and saw some of the issues you were facing.... No real answer for you but I understand how you are stressed! As for the travel issues hopefully that can be resolved!! <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kmkwedding2016@gmail.com","IpAddress":"70.72.195.234","GroupId":38,"GroupName":"Moderators","JoinDate":1390256608,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kmk2016","Id":276231,"Name":"kmk2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.249.122.85","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77352,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ae7de0e1db71fd5521ff249ce7fd598b","RawContent":"&lt;p&gt;Oh no! I hope everything is ok!&lt;\/p&gt;","Attachments":[],"Id":1856056,"PostDate":1403136422,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Oh no! I hope everything is ok!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kelly_miller_@hotmail.com","IpAddress":"99.249.122.85","GroupId":40,"GroupName":"Jr. Member","JoinDate":1390772931,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kellymiller","Id":276338,"Name":"kellymiller","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.12.55.199","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77352,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"0d2069bd424974411590f44c871f2ddc","RawContent":"&lt;p&gt;Hi Everyone!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thanks for your concern! And I&#039;m sorry I did not reply at all til now! &amp;nbsp;I was having breakdown moment I think that night and need to say out loud what was running through my head at the time...at 1am while I couldn&#039;t sleep...everyone has those moments right?..........right?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;This has been a&amp;nbsp;particularly stressful \/crazy summer for me&amp;nbsp;and a few weeks ago&amp;nbsp;after an array of problems&amp;nbsp;including&amp;nbsp;a&amp;nbsp;disappearing&amp;nbsp;TA , Travel date &amp;amp; Pricing Problems, Budget setbacks, and a death in the immediate family; we decided to postpone our wedding from April 2015 to Nov 2015 (hopefully).&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;This time around we have a reliable TA in place who is just a couple doors down from my office..so I can see\/talk to her at any time...she&#039;s great.&amp;nbsp;I have already figured out the Travel Date problem...Because of the many different locations our guests are flying from we have to fly with Air Canada or WestJet to get everyone there at the same time, so now just waiting for their flight schedules to come out. Changing the Date from April to November should take care of the pricing Issue....hopefully...but just in case I am looking for some back up resorts...So if any of you ladies have some good suggestions for a back up resort in Punta Cana that AC or WJ has on their roster...I&#039;m all ears. Please help!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Our latest set back was just yesterday... my FI has a newly imposed&amp;nbsp;Vacation&amp;nbsp;Black out time from Sept 1 - to Dec 24 starting 2015 for just his department. Because we have no definite date set yet we are unable to find out if they will make an exception for him to get married...so unsure what to do about that now...guess I&#039;ll have to wait to get price and then ask...if we can&#039;t get it we will postpone again I guess...&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;My FI dislikes big weddings, hates just about&amp;nbsp;everything&amp;nbsp;about them, so the smaller the better..that&#039;s&amp;nbsp;probably why he like the idea of a destination wedding, he is&amp;nbsp;completely&amp;nbsp;opposed to a wedding at home. My FI and I have been together for 8 years (9 this April), and we lived together since the&amp;nbsp;beginning...so it&#039;s not like getting married will change anything on that front...It would really be just a&amp;nbsp;piece&amp;nbsp;of paper. All of my close friends and family live far away from me so I wouldn&#039;t be getting any of the fun pre wedding things...like an engagement party, wedding shower, or stagette, which is completely ok.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;After all the bumps in the road I kinda feel like we should just go to City Hall tomorrow after work and just sign the papers, my FI would be just as happy with that,...save everyone some time and money...but I know I&#039;ll regret it.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I Thought wedding planning would be so fun, I&#039;m such a DIY \/ crafting freak! Now I&#039;m feeling&amp;nbsp;disappointed, defeated&amp;nbsp;and sad.. I want to have that day where Me and Him are two most important people, I want to walk down the isle with my Dad and have that father daughter dance (I am my dads only girl, and&amp;nbsp;favourite&amp;nbsp;person), I want to hear all the nice things and funny stories that people say about you on your wedding day, I want that moment where I walk down the isle and see my FI&#039;s face, and I want to share all those things with my&amp;nbsp;favourite&amp;nbsp;people while we eat good food and dance the night away. I guess I don&#039;t get why it seems to be so hard to achieve.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Now as I write these things down I feel selfish and stupid for being so upset...sorry ladies I guess this is another breakdown moment! God I&#039;m losing it...I need to keep it together! ha.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;......So in short can anyone recommend a back up resort?...or a psych ward?...ha!ha!&lt;\/p&gt;","Attachments":[],"Id":1871517,"PostDate":1410460174,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Everyone!<\/p>\n<p>\u00a0<\/p>\n<p>Thanks for your concern! And I'm sorry I did not reply at all til now! \u00a0I was having breakdown moment I think that night and need to say out loud what was running through my head at the time...at 1am while I couldn't sleep...everyone has those moments right?..........right?<\/p>\n<p>\u00a0<\/p>\n<p>This has been a\u00a0particularly stressful \/crazy summer for me\u00a0and a few weeks ago\u00a0after an array of problems\u00a0including\u00a0a\u00a0disappearing\u00a0TA , Travel date & Pricing Problems, Budget setbacks, and a death in the immediate family; we decided to postpone our wedding from April 2015 to Nov 2015 (hopefully).<\/p>\n<p>\u00a0<\/p>\n<p>This time around we have a reliable TA in place who is just a couple doors down from my office..so I can see\/talk to her at any time...she's great.\u00a0I have already figured out the Travel Date problem...Because of the many different locations our guests are flying from we have to fly with Air Canada or WestJet to get everyone there at the same time, so now just waiting for their flight schedules to come out. Changing the Date from April to November should take care of the pricing Issue....hopefully...but just in case I am looking for some back up resorts...So if any of you ladies have some good suggestions for a back up resort in Punta Cana that AC or WJ has on their roster...I'm all ears. Please help!<\/p>\n<p>\u00a0<\/p>\n<p>Our latest set back was just yesterday... my FI has a newly imposed\u00a0Vacation\u00a0Black out time from Sept 1 - to Dec 24 starting 2015 for just his department. Because we have no definite date set yet we are unable to find out if they will make an exception for him to get married...so unsure what to do about that now...guess I'll have to wait to get price and then ask...if we can't get it we will postpone again I guess...<\/p>\n<p>\u00a0<\/p>\n<p>My FI dislikes big weddings, hates just about\u00a0everything\u00a0about them, so the smaller the better..that's\u00a0probably why he like the idea of a destination wedding, he is\u00a0completely\u00a0opposed to a wedding at home. My FI and I have been together for 8 years (9 this April), and we lived together since the\u00a0beginning...so it's not like getting married will change anything on that front...It would really be just a\u00a0piece\u00a0of paper. All of my close friends and family live far away from me so I wouldn't be getting any of the fun pre wedding things...like an engagement party, wedding shower, or stagette, which is completely ok.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>After all the bumps in the road I kinda feel like we should just go to City Hall tomorrow after work and just sign the papers, my FI would be just as happy with that,...save everyone some time and money...but I know I'll regret it.<\/p>\n<p>\u00a0<\/p>\n<p>I Thought wedding planning would be so fun, I'm such a DIY \/ crafting freak! Now I'm feeling\u00a0disappointed, defeated\u00a0and sad.. I want to have that day where Me and Him are two most important people, I want to walk down the isle with my Dad and have that father daughter dance (I am my dads only girl, and\u00a0favourite\u00a0person), I want to hear all the nice things and funny stories that people say about you on your wedding day, I want that moment where I walk down the isle and see my FI's face, and I want to share all those things with my\u00a0favourite\u00a0people while we eat good food and dance the night away. I guess I don't get why it seems to be so hard to achieve.<\/p>\n<p>\u00a0<\/p>\n<p>Now as I write these things down I feel selfish and stupid for being so upset...sorry ladies I guess this is another breakdown moment! God I'm losing it...I need to keep it together! ha.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>......So in short can anyone recommend a back up resort?...or a psych ward?...ha!ha!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div>\u00a0<\/div>\n<div><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78914-meandhim-grand-palladium-bavaro-nov-2015\/'>My Planning Thread<\/a>\u00a0- MeandHim - Grand Palladium Bavaro - Nov 25 2015<\/div>\n<div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10765;116\/st\/20151125\/e\/Our+Wedding\/k\/461e\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"markandshavonne@live.com","IpAddress":"70.30.85.211","GroupId":3,"GroupName":"Member","JoinDate":1365792059,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268499.jpg?_r=1395417550","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"Meandhim","Id":268499,"Name":"Meandhim","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.172.160.130","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77352,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"5f5f7185120337f59307b0016a11f143","RawContent":"&lt;p&gt;I&#039;m sorry to hear about all the issues. I think if it&#039;s important for you to have that one day when you and your fiance are the most important people then you need to have it, whenever that might be.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Sorry I don&#039;t know much about resorts in Punta Cana. I&#039;ve only been there once to the Colonial Majestic. We liked the hotel and saw a wedding while there but I honestly have no idea what their weddings are like. We traveled with west jet that time. In terms of prices have you thought about the summer? I know it&#039;s super hot over there but it is cheaper to travel. We&#039;re having our wedding in August for that reason, and because we have a couple of teachers\/students among our guests so August is perfect for them to travel :).&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Maybe the company can make an exception for your fiance, tell them that the trip and wedding were already booked before they made those changes so he can&#039;t change it :P.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1871521,"PostDate":1410460857,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I'm sorry to hear about all the issues. I think if it's important for you to have that one day when you and your fiance are the most important people then you need to have it, whenever that might be.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Sorry I don't know much about resorts in Punta Cana. I've only been there once to the Colonial Majestic. We liked the hotel and saw a wedding while there but I honestly have no idea what their weddings are like. We traveled with west jet that time. In terms of prices have you thought about the summer? I know it's super hot over there but it is cheaper to travel. We're having our wedding in August for that reason, and because we have a couple of teachers\/students among our guests so August is perfect for them to travel <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Maybe the company can make an exception for your fiance, tell them that the trip and wedding were already booked before they made those changes so he can't change it <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/tongue.png' class='bbc_emoticon' alt=':P' \/>.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<br><p><a data-ipb='nomediaparse' href='http:\/\/www.TickerFactory.com\/'><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;31;484\/st\/20150813\/e\/Wedding+time%21+\/dt\/-2\/k\/b92c\/event.png\" alt=\"event.png\"><\/a><\/p>\n<p style=\"text-align:center;\">\u00a0<\/p>\n<p style=\"text-align:center;\">\u00a0","Email":"sblopezb@gmail.com","IpAddress":"172.219.193.22","GroupId":42,"GroupName":"Sr. Member","JoinDate":1359763104,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265511.jpg?_r=1442890536","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"TinkerSofi","Id":265511,"Name":"TinkerSofi","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"205.142.197.104","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77352,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"bab1ff63923a66e85b2fa937db66a4b6","RawContent":"&lt;p&gt;I&#039;m so sorry about all this stress and you are not being selfish, everyone deserves a day to remember with family and friends if that&#039;s what they want. I really like the Secrets and Excellence resorts so if it has to be PC then maybe start there? Wish I could be mroe helpful. I would say too that Sept-end of Nov is generally hurricane season so get travel insurance and a rain plan just in case. or think about May which is usually a shoulder season for some resorts&lt;\/p&gt;","Attachments":[],"Id":1871528,"PostDate":1410462334,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I'm so sorry about all this stress and you are not being selfish, everyone deserves a day to remember with family and friends if that's what they want. I really like the Secrets and Excellence resorts so if it has to be PC then maybe start there? Wish I could be mroe helpful. I would say too that Sept-end of Nov is generally hurricane season so get travel insurance and a rain plan just in case. or think about May which is usually a shoulder season for some resorts<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"spj.wedding@gmail.com","IpAddress":"205.142.197.104","GroupId":40,"GroupName":"Jr. Member","JoinDate":1407351354,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279330.jpg?_r=1407431220","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"spjwedding","Id":279330,"Name":"spjwedding","IsOnline":false}}],"Id":"77352","Title":"The Signs Are Pointing To A Big \"not Happening\"...needing Advice","LastPostDate":1418239979},"Pages":{"TotalItems":16,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
