Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":7,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":856,"MovedTo":null,"MovedOn":0,"FirstPostId":1903553,"Rating":0,"RatingHits":0,"Starter":{"Id":284588,"Name":"Momay2016","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284588.jpg?_r=1440698120","PhotoWidth":177,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":false},"StartDate":1440680456,"LastPoster":{"Id":228415,"Name":"JwdEvents","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-228415.jpg?_r=1443483879","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1903553,"PostDate":1440680456,"PostContent":"Hi Everyone! Newly engaged, and happy to be so! I am currently working with Luxe to pick our dest...","Author":{"Signature":"","Email":"melissacmay@hotmail.com","IpAddress":"174.3.202.243","GroupId":39,"GroupName":"Newbie","JoinDate":1440679305,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284588.jpg?_r=1440698120","PhotoWidth":177,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Momay2016","Id":284588,"Name":"Momay2016","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.3.202.243","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79541,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"bd400967a7b9c1860021b6a0392a7fcb","RawContent":"&lt;p&gt;Hi Everyone!\n\n\nNewly engaged, and happy to be so!\n\n\nI am currently working with Luxe to pick our destination. We are thinking of going with the Royalton Riviera Cancun. Would love to hear what anyone has for experiences? Also looking at NOW Sapphire.\n\n\nThank you!&lt;\/p&gt;","Attachments":[],"Id":1903553,"PostDate":1440680456,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Everyone!<br><br>\nNewly engaged, and happy to be so!<br><br>\nI am currently working with Luxe to pick our destination. We are thinking of going with the Royalton Riviera Cancun. Would love to hear what anyone has for experiences? Also looking at NOW Sapphire.<br><br>\nThank you!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"melissacmay@hotmail.com","IpAddress":"174.3.202.243","GroupId":39,"GroupName":"Newbie","JoinDate":1440679305,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284588.jpg?_r=1440698120","PhotoWidth":177,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Momay2016","Id":284588,"Name":"Momay2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.187.229.252","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79541,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"3ffaae39f1939dbf7e544bbbe69d3072","RawContent":"&lt;p&gt;Hi Momay2016,&lt;\/p&gt;\n&lt;p&gt;TA Wendy here.. I just visited and stayed at Royalton Riviera Cancun for 5 nights early this summer. I was so pleased with it in every way! They really are a wonderful resort at a great price point and value. They have the most amazing buffet I have ever experienced in their casual buffet restaurant, and a great selection of specialty restaurants.&lt;\/p&gt;\n&lt;p&gt;The rooms are spacious, with something for everyone.. family friendly section as well as adults only side. Entertainment in the evenings was very good and fun nightclubs.&lt;\/p&gt;\n&lt;p&gt;They have a very nice selection of locations for weddings, and they are on a great beach.&lt;\/p&gt;\n&lt;p&gt;When they first opened their rates were incredibly reasonable, but as they have become established they have raised prices a bit to where they really ought to be.. they would most likely be higher than you would find at Now Sapphire, but comparing the two resorts I would say that Royalton is larger, newer and still of great value for your price.&lt;\/p&gt;\n&lt;p&gt;They are still a very easy drive from the airport, being located just a bit south of Moon Palace.&lt;\/p&gt;\n&lt;p&gt;If we at Wright Travel can answer anything for you just let us know! We agents are here to assist!&lt;\/p&gt;\n&lt;p&gt;Best wishes to you!&lt;\/p&gt;","Attachments":[],"Id":1903558,"PostDate":1440682015,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Momay2016,<\/p>\n<p>TA Wendy here.. I just visited and stayed at Royalton Riviera Cancun for 5 nights early this summer. I was so pleased with it in every way! They really are a wonderful resort at a great price point and value. They have the most amazing buffet I have ever experienced in their casual buffet restaurant, and a great selection of specialty restaurants.<\/p>\n<p>The rooms are spacious, with something for everyone.. family friendly section as well as adults only side. Entertainment in the evenings was very good and fun nightclubs.<\/p>\n<p>They have a very nice selection of locations for weddings, and they are on a great beach.<\/p>\n<p>When they first opened their rates were incredibly reasonable, but as they have become established they have raised prices a bit to where they really ought to be.. they would most likely be higher than you would find at Now Sapphire, but comparing the two resorts I would say that Royalton is larger, newer and still of great value for your price.<\/p>\n<p>They are still a very easy drive from the airport, being located just a bit south of Moon Palace.<\/p>\n<p>If we at Wright Travel can answer anything for you just let us know! We agents are here to assist!<\/p>\n<p>Best wishes to you!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><a class='bbc_url' href='http:\/\/wrighttravelagency.com\/inquiry\/'><span style='color: rgb(0,128,128)'>Looking for a travel agency that specializes in Destination Weddings<\/span><\/a><span style='color: rgb(0,128,128)'>? We are an award winning travel agency and you can read our reviews <\/span><a class='bbc_url' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style='color: rgb(0,128,128)'><strong class='bbc'>HERE.<\/strong><\/span><\/a><\/span><\/span><br \/>\n<br \/>\n<span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'><strong class='bbc'>Awards and recognition: <\/strong><\/span><\/span><\/span><\/span><br \/>\n<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'>Palace Resorts Top PRO Agency <\/span><\/span><\/span><\/span><br \/>\n<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'>Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator <\/span><\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>AMResorts Master Agent & Top Agency<\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>Travel Impressions Best of the Best Globe Winner<\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>Apple Vacations Golden Apple Winner<\/span><\/span><\/span>","Email":"wendyhicks1@sbcglobal.net","IpAddress":"99.187.229.252","GroupId":49,"GroupName":"Insiders","JoinDate":1238016240,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-216154.jpg?_r=1419958783","PhotoWidth":200,"PhotoHeight":250,"PhotoType":"custom"},"FormattedName":"TA Wendy","Id":216154,"Name":"TA Wendy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.101.80.79","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79541,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6adc4af36275c1b50034f96b4bda3716","RawContent":"&lt;p&gt;@[member=\"Momay2016\"] Congrats and welcome! TA Wendy gave you some great info to give you an idea of comparing the two resorts you mentioned. As well, we have a bride to be that is getting married at the Royalton is just a few weeks. Hopefully she&#039;ll pop in with what she has been through and share it. NOW Sapphire is also a popular resort with the ladies here. What I recommend is that you do a search in the search bar at the top for the resorts you&#039;re looking at. There are quite a few threads available - too many to attach here but I can almost guarantee that any questions you have, have been asked and answered here.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Definitely a travel agent is the other thing I would recommend. I see you&#039;re from Edmonton. We have several brides to be in Calgary and one that was just married in April that is also from Edmonton. A travel agent will free up your time to deal with your wedding planning while the agent works with your guests needs and inquiries. I know there are a couple here that the western ladies recommend.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck and happy planning!&lt;\/p&gt;","Attachments":[],"Id":1903611,"PostDate":1440712088,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"284588\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/284588-momay2016\/' title='Member profile'><span itemprop=\"name\">Momay2016<\/span><\/a> Congrats and welcome! TA Wendy gave you some great info to give you an idea of comparing the two resorts you mentioned. As well, we have a bride to be that is getting married at the Royalton is just a few weeks. Hopefully she'll pop in with what she has been through and share it. NOW Sapphire is also a popular resort with the ladies here. What I recommend is that you do a search in the search bar at the top for the resorts you're looking at. There are quite a few threads available - too many to attach here but I can almost guarantee that any questions you have, have been asked and answered here.<\/p>\n<p>\u00a0<\/p>\n<p>Definitely a travel agent is the other thing I would recommend. I see you're from Edmonton. We have several brides to be in Calgary and one that was just married in April that is also from Edmonton. A travel agent will free up your time to deal with your wedding planning while the agent works with your guests needs and inquiries. I know there are a couple here that the western ladies recommend.<\/p>\n<p>\u00a0<\/p>\n<p>Good luck and happy planning!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><em><span style=\"color:rgb(51,153,255);\">I'm lucky enough to\u00a0tell my husband how much I love him and say yes again\u00a0on October 20, 2015 at Grand Coral Beach Club!\u00a0<\/span><\/em>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283440999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"32.214.84.114","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79541,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"bbebb3f492d41a36cea0e8b115480c1e","RawContent":"Hello @[member=\"Momay2016\"] I am a bride to be who has booked my wedding at Royalton Riviera Cancun for May 2016. I went to check out the resort during my site visit July 31st and my fiance and I absolutely LOVED it. The resort is on the large side (but not overwhelming large), its brand new openned this year and very beautiful. The food at the main buffet restaurant was good, the welcome drinks we received were great and the guests overall appeared happy. Not to mention that the room rate price we received was reasonable. I was really big on having a place that would entertain all of our guests, upon my visit I was happy to see many guests involved in the activities held at the pools by the resort staff. They also have a night club on site as well as a casino. We have scheduled our wedding and cocktail hour at the sky terrace which is absolutely beautiful. I&#039;m more than willing to help answer any questions you may have as I go through the process. I am currently working with Wright Travel Agency which I have found through this forum.\nHello @[member=\"Momay2016\"] I am a bride to be who has booked my wedding at Royalton Riviera Cancun for May 2016. I went to check out the resort during my site visit July 31st and my fiance and I absolutely LOVED it. The resort is on the large side (but not overwhelming large), its brand new openned this year and very beautiful. The food at the main buffet restaurant was good, the welcome drinks we received were great and the guests overall appeared happy. Not to mention that the room rate price we received was reasonable. I was really big on having a place that would entertain all of our guests, upon my visit I was happy to see many guests involved in the activities held at the pools by the resort staff. They also have a night club on site as well as a casino. We have scheduled our wedding and cocktail hour at the sky terrace which is absolutely beautiful. I&#039;m more than willing to help answer any questions you may have as I go through the process. I am currently working with Wright Travel Agency which I have found through this forum.","Attachments":[],"Id":1903631,"PostDate":1440725193,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hello @<a hovercard-ref=\"member\" hovercard-id=\"284588\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/284588-momay2016\/' title='Member profile'><span itemprop=\"name\">Momay2016<\/span><\/a> I am a bride to be who has booked my wedding at Royalton Riviera Cancun for May 2016. I went to check out the resort during my site visit July 31st and my fiance and I absolutely LOVED it. The resort is on the large side (but not overwhelming large), its brand new openned this year and very beautiful. The food at the main buffet restaurant was good, the welcome drinks we received were great and the guests overall appeared happy. Not to mention that the room rate price we received was reasonable. I was really big on having a place that would entertain all of our guests, upon my visit I was happy to see many guests involved in the activities held at the pools by the resort staff. They also have a night club on site as well as a casino. We have scheduled our wedding and cocktail hour at the sky terrace which is absolutely beautiful. I'm more than willing to help answer any questions you may have as I go through the process. I am currently working with Wright Travel Agency which I have found through this forum.<br \/>Hello @<a hovercard-ref=\"member\" hovercard-id=\"284588\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/284588-momay2016\/' title='Member profile'><span itemprop=\"name\">Momay2016<\/span><\/a> I am a bride to be who has booked my wedding at Royalton Riviera Cancun for May 2016. I went to check out the resort during my site visit July 31st and my fiance and I absolutely LOVED it. The resort is on the large side (but not overwhelming large), its brand new openned this year and very beautiful. The food at the main buffet restaurant was good, the welcome drinks we received were great and the guests overall appeared happy. Not to mention that the room rate price we received was reasonable. I was really big on having a place that would entertain all of our guests, upon my visit I was happy to see many guests involved in the activities held at the pools by the resort staff. They also have a night club on site as well as a casino. We have scheduled our wedding and cocktail hour at the sky terrace which is absolutely beautiful. I'm more than willing to help answer any questions you may have as I go through the process. I am currently working with Wright Travel Agency which I have found through this forum.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rhonda3839@aol.com","IpAddress":"32.214.84.114","GroupId":39,"GroupName":"Newbie","JoinDate":1433617517,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283419.jpg?_r=1443402934","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"Rhonda3839","Id":283419,"Name":"Rhonda3839","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"177.237.80.72","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79541,"EditedBy":"<strong>Edited by Moments That Matter, 28 August 2015 - 11:51 AM.<\/strong>","EditDate":1440762707,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"34b754a37f702cab4739fa3966729c09","RawContent":"&lt;p&gt;Welcome to the forum Momay2016 and Congrats on your upcoming dw!!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We&#039;ve captured a wedding at the NOW Sapphire and can show you what a gorgeous backdrop it would make for your wedding day love story in photos here: &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10152285887359487.1073741881.18683524486&amp;amp;type=3&#039;&gt;NOW Sapphire Wedding Album&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-mia1-1.xx.fbcdn.net\/hphotos-xft1\/t31.0-8\/1781233_10152285888669487_354935100_o.jpg\" alt=\"1781233_10152285888669487_354935100_o.jp\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-mia1-1.xx.fbcdn.net\/hphotos-xap1\/t31.0-8\/10010300_10152285889709487_764706269_o.jpg\" alt=\"10010300_10152285889709487_764706269_o.j\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-mia1-1.xx.fbcdn.net\/hphotos-xaf1\/t31.0-8\/1025772_10152285892949487_1938182328_o.jpg\" alt=\"1025772_10152285892949487_1938182328_o.j\"&gt;&lt;\/p&gt;\n&lt;p&gt;wishing you happy research and all the best with your plans - cheers!!! team mtm :)&lt;\/p&gt;","Attachments":[],"Id":1903662,"PostDate":1440762657,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome to the forum Momay2016 and Congrats on your upcoming dw!!!<\/p>\n<p>\u00a0<\/p>\n<p>We've captured a wedding at the NOW Sapphire and can show you what a gorgeous backdrop it would make for your wedding day love story in photos here: <a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10152285887359487.1073741881.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>NOW Sapphire Wedding Album<\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-mia1-1.xx.fbcdn.net\/hphotos-xft1\/t31.0-8\/1781233_10152285888669487_354935100_o.jpg\" alt=\"1781233_10152285888669487_354935100_o.jp\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-mia1-1.xx.fbcdn.net\/hphotos-xap1\/t31.0-8\/10010300_10152285889709487_764706269_o.jpg\" alt=\"10010300_10152285889709487_764706269_o.j\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-mia1-1.xx.fbcdn.net\/hphotos-xaf1\/t31.0-8\/1025772_10152285892949487_1938182328_o.jpg\" alt=\"1025772_10152285892949487_1938182328_o.j\"><\/span><\/p>\n<p>wishing you happy research and all the best with your plans - cheers!!! team mtm <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280192660,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"80.42.248.99","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79541,"EditedBy":"<strong>Edited by maybeoneday, 31 August 2015 - 09:34 AM.<\/strong>","EditDate":1441013646,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a737138c28700b8d1024f020ba565faf","RawContent":"Hi @[member=\"Momay2016\"]\n\nCongratulations.  I am getting married at Royaltan Riviera Cancun mid October 2015. Planning directly with the WC for Luxe has been great. She always emails back with any information requested. \n\nThe wedding locations look great. We have gone for the chapel rather than the Sky Terrace due to cost but the Terrace looks amazing. \n\n\nMaybeoneday\n\n14 \/10\/2015 - R R C, Mexico","Attachments":[],"Id":1903771,"PostDate":1441013538,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi @<a hovercard-ref=\"member\" hovercard-id=\"284588\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/284588-momay2016\/' title='Member profile'><span itemprop=\"name\">Momay2016<\/span><\/a><br>\nCongratulations.  I am getting married at Royaltan Riviera Cancun mid October 2015. Planning directly with the WC for Luxe has been great. She always emails back with any information requested. <br>\nThe wedding locations look great. We have gone for the chapel rather than the Sky Terrace due to cost but the Terrace looks amazing. <br><br>\nMaybeoneday<br>\n14 \/10\/2015 - R R C, Mexico\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"shelina_nessa@yahoo.co.uk","IpAddress":"149.254.56.238","GroupId":40,"GroupName":"Jr. Member","JoinDate":1421803539,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"maybeoneday","Id":281816,"Name":"maybeoneday","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"201.160.133.208","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79541,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cefd4a6c40997a1d61476df8f936ab2a","RawContent":"&lt;p&gt;Congratulations on your upcoming wedding, we wish you a happy planning and glad you chose such a great place.&lt;\/p&gt;","Attachments":[],"Id":1905624,"PostDate":1443546958,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congratulations on your upcoming wedding, we wish you a happy planning and glad you chose such a great place.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div>\n<div>\n<p><em><strong>Julian Molina<\/strong><\/em><\/p>\n<p><em><strong>Dj<\/strong><\/em><\/p>\n<p><b><i>Wedding Entertainment Consultant<\/i><\/b><\/p>\n<p><b><i>www.julianmolina.me<\/i><\/b><\/p>\n<p><b><i>Phone: +52 (998) 236 0134<\/i><\/b><\/p>\n<\/div>\n<\/div>\n<p>\u00a0","Email":"julian.molina.info@gmail.com","IpAddress":"187.185.71.164","GroupId":40,"GroupName":"Jr. Member","JoinDate":1274425546,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-228415.jpg?_r=1443483879","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"JwdEvents","Id":228415,"Name":"JwdEvents","IsOnline":false}}],"Id":"79541","Title":"Has Anyone Married At The Royalton Riviera Cancun-Mexico?","LastPostDate":1443546958},"Pages":{"TotalItems":7,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}