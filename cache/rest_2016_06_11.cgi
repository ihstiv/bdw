{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":true,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":1,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":3048,"MovedTo":null,"MovedOn":0,"FirstPostId":1907039,"Rating":0,"RatingHits":0,"Starter":{"Id":206696,"Name":"TammyWright","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"IsOnline":false},"StartDate":1446487545,"LastPoster":{"Id":206696,"Name":"TammyWright","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":2,"Preview":{"Id":1907039,"PostDate":1446487545,"PostContent":"Hyatt Zilara and Hyatt Ziva, the all-inclusive luxury resorts that introduced the Evolution of Al...","Author":{"Signature":"<p><span style=\"font-family:arial, helvetica, sans-serif;\">Founder and Owner of BestDestinationWedding.com \u00a0\/ \u00a0<\/span><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/'><strong><span style=\"font-family:arial, helvetica, sans-serif;\">Bride & Groom Fly FREE Promotion<\/span><\/strong><\/a><\/p>\n<p>\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><a data-ipb='nomediaparse' href='https:\/\/www.wrighttravelagency.com\/go\/destination-wedding\/?source=EMLSIG'><strong><span style=\"color:#008080;\">Looking for a travel agency that specializes in Destination Weddings-CLICK HERE<\/span><\/strong><\/a><span style=\"color:#008080;\"><strong>?<\/strong> \u00a0We are an award winning travel agency and you can <\/span><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style=\"color:#008080;\">read our reviews\u00a0here.<\/span><\/a><\/strong><\/span><br>\n\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"color:#008080;\"><strong>Awards and recognition:\u00a0<\/strong><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Palace Resorts Winner \"Top Travel Agent\", \"Top Homebased Travel Agency\" PRO Platinum Agency (Top Award) \u00a0 \u00a0 | \u00a0 \u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">AMResorts Master Agent & Top Agency \u00a0<\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/68050-karisma-hotels-givc-and-gi-wedding-consultants-wright-travel-agency\/'><strong>Wright Travel & Karisma GIVC Benefits<\/strong><\/a><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Travel Impressions Best of the Best Globe Winner \u00a0 \u00a0| \u00a0 \u00a0\u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Apple Vacations Golden Apple Winner \u00a0<\/span><\/span><br><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17612\/sml_gallery_206696_17612_13451.png\" alt=\"sml_gallery_206696_17612_13451.png\"><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"> \u00a0 \u00a0<img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"font-size:14px;\"><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010'>Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><\/span><\/span><strong><span style=\"color:#b22222;\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a data-ipb='nomediaparse' href='mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com'>ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"admin@bestdestinationwedding.com","IpAddress":"71.202.225.11","GroupId":4,"GroupName":"Administrators","JoinDate":1137224220,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"FormattedName":"TammyWright","Id":206696,"Name":"TammyWright","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.202.225.11","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79694,"EditedBy":"","EditDate":1446487864,"EditReason":"","DeleteDate":0,"TotalLikes":3,"IsLiked":false,"PostKey":"b4116e4505fc64411b81f83ed50359e0","RawContent":"&lt;p&gt;Hyatt Zilara and Hyatt Ziva, the all-inclusive luxury resorts that introduced the Evolution of All-Inclusive\u2122, offer incredible wedding venues in the world\u2019s most celebrated beachfront locations. Now, you and a guest can preview your preferred destination plus receive a $500 credit toward your wedding. It\u2019s like getting your Big Day Preview essentially for free.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;ul&gt;&lt;li&gt;Two night luxury getaway for two to the romantic destinations of Cancun, Los Cabos, Montego Bay or Puerto Vallarta&lt;\/li&gt;\n&lt;li&gt;All-inclusive accommodations featuring fine dining, signature cocktails and live entertainment - and it&#039;s all included&lt;\/li&gt;\n&lt;li&gt;Best room availability at check-in&lt;\/li&gt;\n&lt;li&gt;Receive credit of $500 when you book your wedding - its like getting your preview for free&lt;\/li&gt;\n&lt;li&gt;Personal onsite wedding planner will arrange for an exclusive resort tour and special food tastings&lt;\/li&gt;\n&lt;\/ul&gt;&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;*Big Day Preview applies to US and Canada adult residents only. Credit is valid for a minimum $2,500 wedding program. Limit one Big Day Preview credit per wedding. Best room availability suite category restrictions may apply. Applies to new bookings only. Oceanview room categories for both free wedding packages required. For Just the Two of You package is complimentary with purchase of a minimum 6-night stay and requires purchase of upper category. Intimate Elegance package is complimentary with a minimum of 15 room nights in upper category, or purchased for $999. Offers valid through December 15, 2015. Holidays or other blackout dates may apply. Additional terms and conditions may apply, contract agent for full details.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;For more information or to book, contact:&lt;\/p&gt;\n&lt;p&gt;Wright Travel Agency&lt;\/p&gt;\n&lt;p&gt;info@wrighttravelagency.com&lt;\/p&gt;\n&lt;p&gt;415-839-7511 x1&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17612\/med_gallery_206696_17612_45159.jpg\" alt=\"med_gallery_206696_17612_45159.jpg\"&gt;&lt;\/p&gt;","Attachments":[],"Id":1907039,"PostDate":1446487545,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hyatt Zilara and Hyatt Ziva, the all-inclusive luxury resorts that introduced the Evolution of All-Inclusive\u2122, offer incredible wedding venues in the world\u2019s most celebrated beachfront locations. Now, you and a guest can preview your preferred destination plus receive a $500 credit toward your wedding. It\u2019s like getting your Big Day Preview essentially for free.<\/p>\n<p>\u00a0<\/p>\n<ul><li>Two night luxury getaway for two to the romantic destinations of Cancun, Los Cabos, Montego Bay or Puerto Vallarta<\/li>\n<li>All-inclusive accommodations featuring fine dining, signature cocktails and live entertainment - and it's all included<\/li>\n<li>Best room availability at check-in<\/li>\n<li>Receive credit of $500 when you book your wedding - its like getting your preview for free<\/li>\n<li>Personal onsite wedding planner will arrange for an exclusive resort tour and special food tastings<\/li>\n<\/ul><p>\u00a0<\/p>\n<p>*Big Day Preview applies to US and Canada adult residents only. Credit is valid for a minimum $2,500 wedding program. Limit one Big Day Preview credit per wedding. Best room availability suite category restrictions may apply. Applies to new bookings only. Oceanview room categories for both free wedding packages required. For Just the Two of You package is complimentary with purchase of a minimum 6-night stay and requires purchase of upper category. Intimate Elegance package is complimentary with a minimum of 15 room nights in upper category, or purchased for $999. Offers valid through December 15, 2015. Holidays or other blackout dates may apply. Additional terms and conditions may apply, contract agent for full details.<\/p>\n<p>\u00a0<\/p>\n<p>For more information or to book, contact:<\/p>\n<p>Wright Travel Agency<\/p>\n<p>info@wrighttravelagency.com<\/p>\n<p>415-839-7511 x1<\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17612\/med_gallery_206696_17612_45159.jpg\" alt=\"med_gallery_206696_17612_45159.jpg\"><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-family:arial, helvetica, sans-serif;\">Founder and Owner of BestDestinationWedding.com \u00a0\/ \u00a0<\/span><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/'><strong><span style=\"font-family:arial, helvetica, sans-serif;\">Bride & Groom Fly FREE Promotion<\/span><\/strong><\/a><\/p>\n<p>\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><a data-ipb='nomediaparse' href='https:\/\/www.wrighttravelagency.com\/go\/destination-wedding\/?source=EMLSIG'><strong><span style=\"color:#008080;\">Looking for a travel agency that specializes in Destination Weddings-CLICK HERE<\/span><\/strong><\/a><span style=\"color:#008080;\"><strong>?<\/strong> \u00a0We are an award winning travel agency and you can <\/span><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style=\"color:#008080;\">read our reviews\u00a0here.<\/span><\/a><\/strong><\/span><br>\n\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"color:#008080;\"><strong>Awards and recognition:\u00a0<\/strong><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Palace Resorts Winner \"Top Travel Agent\", \"Top Homebased Travel Agency\" PRO Platinum Agency (Top Award) \u00a0 \u00a0 | \u00a0 \u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">AMResorts Master Agent & Top Agency \u00a0<\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/68050-karisma-hotels-givc-and-gi-wedding-consultants-wright-travel-agency\/'><strong>Wright Travel & Karisma GIVC Benefits<\/strong><\/a><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Travel Impressions Best of the Best Globe Winner \u00a0 \u00a0| \u00a0 \u00a0\u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Apple Vacations Golden Apple Winner \u00a0<\/span><\/span><br><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17612\/sml_gallery_206696_17612_13451.png\" alt=\"sml_gallery_206696_17612_13451.png\"><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"> \u00a0 \u00a0<img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"font-size:14px;\"><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010'>Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><\/span><\/span><strong><span style=\"color:#b22222;\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a data-ipb='nomediaparse' href='mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com'>ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"admin@bestdestinationwedding.com","IpAddress":"71.202.225.11","GroupId":4,"GroupName":"Administrators","JoinDate":1137224220,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"FormattedName":"TammyWright","Id":206696,"Name":"TammyWright","IsOnline":false}}],"Id":"79694","Title":"Hyatt Ziva And Hyatt Zilara Big Day Preview $500","LastPostDate":1446487545},"Pages":{"TotalItems":1,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
