otoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-266526.jpg?_r=1427840086","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":60,"Preview":{"Id":1498735,"PostDate":1312428109,"PostContent":"Has anyone given out pre-travel letters or other information and how did you do it? I planned on...","Author":{"Signature":"","Email":"jessicajxavier@gmail.com","IpAddress":"70.36.138.137","GroupId":39,"GroupName":"Newbie","JoinDate":1294614547,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"none"},"FormattedName":"JessX823","Id":235323,"Name":"JessX823","IsOnline":false}},"Posts":[],"Id":"62689","Title":"Pre-Travel Information to Guests","LastPostDate":1418588816}],"Pages":{"TotalItems":2333,"TotalPages":156,"CurrentPage":60,"NextPage":75,"PreviousPage":45,"LastPage":2325},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
