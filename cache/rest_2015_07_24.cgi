{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":90,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":14867,"MovedTo":null,"MovedOn":0,"FirstPostId":407114,"Rating":0,"RatingHits":0,"Starter":{"Id":210920,"Name":"Ryan's girl","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-210920.gif?_r=0","PhotoWidth":100,"PhotoHeight":67,"PhotoType":"custom"},"IsOnline":false},"StartDate":1217884928,"LastPoster":{"Id":279386,"Name":"Ydolem","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279386.jpg?_r=1416803730","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":60,"Preview":{"Id":407114,"PostDate":1217884928,"PostContent":"With regards to tipping at your DW, I was wondering who you're tipping and approximately how much...","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Our ELIZABETH MEDINA slideshow<\/span><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t42700\">http:\/\/bestdestinationwedding.com\/forum\/t42700<\/a><br><span>My Iberostar Lindo review<\/span><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t42812\">http:\/\/bestdestinationwedding.com\/forum\/t42812<\/a><\/div><\/div>","Email":"kj_hunt@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1217556565,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-210920.gif?_r=0","PhotoWidth":100,"PhotoHeight":67,"PhotoType":"custom"},"FormattedName":"Ryan's girl","Id":210920,"Name":"Ryan's girl","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":21309,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f421e69e3a373d6d8bdea658dc58110e","RawContent":"With regards to tipping at your DW, I was wondering who you&#039;re tipping and approximately how much? I know that I&#039;m going to tip my wedding coordinator but was thinking about the bartender, photographer...etc. Anyone that I&#039;m not thinking about that should be considered?","Attachments":[],"Id":407114,"PostDate":1217884928,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                With regards to tipping at your DW, I was wondering who you're tipping and approximately how much? I know that I'm going to tip my wedding coordinator but was thinking about the bartender, photographer...etc. Anyone that I'm not thinking about that should be considered?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Our ELIZABETH MEDINA slideshow<\/span><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t42700\">http:\/\/bestdestinationwedding.com\/forum\/t42700<\/a><br><span>My Iberostar Lindo review<\/span><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t42812\">http:\/\/bestdestinationwedding.com\/forum\/t42812<\/a><\/div><\/div>","Email":"kj_hunt@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1217556565,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-210920.gif?_r=0","PhotoWidth":100,"PhotoHeight":67,"PhotoType":"custom"},"FormattedName":"Ryan's girl","Id":210920,"Name":"Ryan's girl","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":21309,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"64e195a008365260b1ed604e1743d3fd","RawContent":"don&#039;t forget your officiant, DJ\/musicians, and head waiter\/maitre d&#039; assuming everything goes to plan!","Attachments":[],"Id":407128,"PostDate":1217885300,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                don't forget your officiant, DJ\/musicians, and head waiter\/maitre d' assuming everything goes to plan!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jfavuzza@gmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1199464097,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208127.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"neen","Id":208127,"Name":"neen","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":21309,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"36d6870dc5cac4dc806a7ff07ee63a62","RawContent":"Tips are a wonderful way to show your appreciation for a vendor. I never expect a tip from a client, and there are times when I don&#039;t et tipped, and that&#039;s ok. My adverae tip is $50 for me and $50 for my other photographer, but we have been tipped up to $100 a piece.\n \n hope that helps!\n congrats and best wishes,\n Pamela","Attachments":[],"Id":407135,"PostDate":1217885520,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Tips are a wonderful way to show your appreciation for a vendor. I never expect a tip from a client, and there are times when I don't et tipped, and that's ok. My adverae tip is $50 for me and $50 for my other photographer, but we have been tipped up to $100 a piece.<br \/> <br \/> hope that helps!<br \/> congrats and best wishes,<br \/> Pamela\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Pamela_inc@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1205792400,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208837.gif?_r=0","PhotoWidth":75,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"PamelaLuedekePhoto","Id":208837,"Name":"PamelaLuedekePhoto","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":21309,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"785ac9bdb18573edd681b78e322929d4","RawContent":"oh! and usually at the end of the night when we are saying goodbyes my clients will say thanks and hand us an envelope with a tip and a little note inside (I usually spend a lot of time with my brides before their big day)...it does make us feel good after a hard days work :)","Attachments":[],"Id":407138,"PostDate":1217885666,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                oh! and usually at the end of the night when we are saying goodbyes my clients will say thanks and hand us an envelope with a tip and a little note inside (I usually spend a lot of time with my brides before their big day)...it does make us feel good after a hard days work <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Pamela_inc@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1205792400,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208837.gif?_r=0","PhotoWidth":75,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"PamelaLuedekePhoto","Id":208837,"Name":"PamelaLuedekePhoto","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":21309,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"62f40117a548521f574aabe6c7fbe8ce","RawContent":"I hadn&#039;t even thought about this. Do you really have to tip the officiant? And how much would you tip them? How much would you tip the wedding coordinator?","Attachments":[],"Id":408560,"PostDate":1217971164,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I hadn't even thought about this. Do you really have to tip the officiant? And how much would you tip them? How much would you tip the wedding coordinator?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ajannene@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1214326054,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-210138.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"Anna83","Id":210138,"Name":"Anna83","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":21309,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ec16f044b722469e4e828ea97a366d82","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;PamelaLuedekePhoto&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Tips are a wonderful way to show your appreciation for a vendor. I never expect a tip from a client, and there are times when I don&#039;t et tipped, and that&#039;s ok. \n Pamela&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;my thoughts exactly,,, my best tip was $300. I was shocked to say the least.","Attachments":[],"Id":408582,"PostDate":1217971894,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>PamelaLuedekePhoto<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Tips are a wonderful way to show your appreciation for a vendor. I never expect a tip from a client, and there are times when I don't et tipped, and that's ok. <br \/> Pamela<\/div> <\/td> <\/tr> <\/table> <\/div>my thoughts exactly,,, my best tip was $300. I was shocked to say the least.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cdphotog@mac.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1167417240,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207000.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Nic Dragomire","Id":207000,"Name":"Nic Dragomire","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":21309,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"564f9bac3bb02432810a2b98f2caba37","RawContent":"I understand tipping wait staff, drivers, and anyone who goes above and beyond. However, I must be really cheap, because I have a hard time justifying tipping my wedding coordinator who I am requesting very little leg work from and who is pocketing over 50% of what she is charging us to put on a very simple ceremony. Is that awful of me?","Attachments":[],"Id":408662,"PostDate":1217975657,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I understand tipping wait staff, drivers, and anyone who goes above and beyond. However, I must be really cheap, because I have a hard time justifying tipping my wedding coordinator who I am requesting very little leg work from and who is pocketing over 50% of what she is charging us to put on a very simple ceremony. Is that awful of me?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ufjamolei@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1197653224,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208033.gif?_r=0","PhotoWidth":98,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"FLgator","Id":208033,"Name":"FLgator","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":21309,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"39fdeeda2fd811f78515953e7f3c79d6","RawContent":"And what about the Reverend if you are meeting them for the first time at the ceremony and they are with you for about 20 minutes? What&#039;s a reasonable tip for them?","Attachments":[],"Id":408994,"PostDate":1217989976,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                And what about the Reverend if you are meeting them for the first time at the ceremony and they are with you for about 20 minutes? What's a reasonable tip for them?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"andreajphillips@gmail.com","IpAddress":"172.56.10.56","GroupId":46,"GroupName":"VIP Member","JoinDate":1213802220,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"none"},"FormattedName":"Banana11","Id":210029,"Name":"Banana11","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":21309,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"44a05808734296f4889507bd9e8aa7b0","RawContent":"These are all really good questions. I was wondering the same thing. Everyone that I am dealing with is included in my package and I am meeting them all on the day of my ceremony. So do I tip all of them, which would be a photographer, videographer, harpist, officiant and wedding coordinator? Or do I just tip my coordinator? Also they are not really doing that much so what should I tip? Im so confused!","Attachments":[],"Id":419448,"PostDate":1218732292,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                These are all really good questions. I was wondering the same thing. Everyone that I am dealing with is included in my package and I am meeting them all on the day of my ceremony. So do I tip all of them, which would be a photographer, videographer, harpist, officiant and wedding coordinator? Or do I just tip my coordinator? Also they are not really doing that much so what should I tip? Im so confused!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;130\/st\/20080912\/e\/Until+the+big+day%21%21\/dt\/-1\/k\/4370\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...4370\/event.png<\/a><\/div><\/div>","Email":"mr2turbo7@cox.net","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1199945468,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208189.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"CTHawaii14","Id":208189,"Name":"CTHawaii14","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":21309,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b7f0ccc56909addcea81e64c6506611d","RawContent":"I have the same questions and the same problem. My wedding coordinator doubles as my travel agent\/officiant. I am being charged enough since they really have nothing to do until the day of the wedding. They did setup payment to the restaurant for the reception. \n \n Do I have to tip the wait staff if a gratuity is included in my bill? Do I also have to tip the lady making the cake? When does it end?","Attachments":[],"Id":419542,"PostDate":1218735152,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I have the same questions and the same problem. My wedding coordinator doubles as my travel agent\/officiant. I am being charged enough since they really have nothing to do until the day of the wedding. They did setup payment to the restaurant for the reception. <br \/> <br \/> Do I have to tip the wait staff if a gratuity is included in my bill? Do I also have to tip the lady making the cake? When does it end?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><i>Sylvia<\/i><br><br><strong><i>Our wedding slideshow<\/i><\/strong><a data-ipb='nomediaparse' href=\"http:\/\/www.facebook.com\/profile.php?id=1384711218&ref=name#\/video\/video.php?v=1047086342460\">http:\/\/www.facebook.com\/profile.php?...=1047086342460<\/a><\/div><\/div>","Email":"syl042215@gmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1216254244,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-210596.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"syl1115","Id":210596,"Name":"syl1115","IsOnline":false}}],"Id":"21309","Title":"Tipping etiquette","LastPostDate":1414787885},"Pages":{"TotalItems":90,"TotalPages":9,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":80},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
