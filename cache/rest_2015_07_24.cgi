: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                The knot has an article on tipping but not sure how much of it applies to DW.<br \/> On the site if you type in Wedding Vendors: Tipping Cheat Sheet in the search box it comes right up. Sorry didn't know how to place the link here.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><em>4\/1\/11 in St. Kitts at the Marriott I married my best-friend!!!<\/em><\/div><\/div>","Email":"misstiewill@aol.com","IpAddress":"164.82.32.13","GroupId":3,"GroupName":"Member","JoinDate":1231999038,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213971.jpg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"big3n09","Id":213971,"Name":"big3n09","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":21309,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a5f8608638a53353cd119b1b47bc1666","RawContent":"I think what I&#039;m going to do it make up some thank you cards with some money in each for various people (WC, judge, wait staff, photographer). I think that will be an easy thing to slip them at a quick moment. If I feel that someone doesn&#039;t deserve a tip (which I hope doesn&#039;t happen because that means something will have gone really wrong) then I will just keep the envelope to myself.","Attachments":[],"Id":756270,"PostDate":1247406525,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I think what I'm going to do it make up some thank you cards with some money in each for various people (WC, judge, wait staff, photographer). I think that will be an easy thing to slip them at a quick moment. If I feel that someone doesn't deserve a tip (which I hope doesn't happen because that means something will have gone really wrong) then I will just keep the envelope to myself.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><strong>~Keira~<\/strong><span>**formerly KLee147**<\/span><br><br><a data-ipb='nomediaparse' href=\"http:\/\/i794.photobucket.com\/albums\/yy224\/KLee147\/Wedding%20Pro%20Pics\/LEE_0170-1-1.jpg\">http:\/\/i794.photobucket.com\/albums\/y...E_0170-1-1.jpg<\/a><\/div><\/div>","Email":"keira.lee@tdsecurities.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1246890502,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-219143.gif?_r=0","PhotoWidth":78,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"~Keira~","Id":219143,"Name":"~Keira~","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":21309,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6027ab6fef4dab21c44b7fcd13e31e69","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \