{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":17,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":609,"MovedTo":null,"MovedOn":0,"FirstPostId":1881673,"Rating":0,"RatingHits":0,"Starter":{"Id":280946,"Name":"SusanMarie813","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280946.jpg?_r=1437732100","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"StartDate":1420318299,"LastPoster":{"Id":281560,"Name":"pykx82","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":60,"Preview":{"Id":1881673,"PostDate":1420318299,"PostContent":"Hi! We just got engaged NYE but we have been discussing getting married for the past few months....","Author":{"Signature":"<p>Gian-Luigi & Susan September 13, 2015 Finest Resort <a data-ipb='nomediaparse' href='http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A'>http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A<\/a>","Email":"susanlaurelli@yahoo.com","IpAddress":"47.17.228.244","GroupId":39,"GroupName":"Newbie","JoinDate":1414840204,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280946.jpg?_r=1437732100","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"SusanMarie813","Id":280946,"Name":"SusanMarie813","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.68.254.42","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78534,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9acc97d814622f1c8ae2cdcf06057da6","RawContent":"&lt;p&gt;Hi!&lt;\/p&gt;\n&lt;p&gt;We just got engaged NYE but we have been discussing getting married for the past few months. &amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I was previously married.&lt;\/p&gt;\n&lt;p&gt;We have been together for 3 years&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We have a little 15 &amp;nbsp;month old&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We have about 200 people on the invite list because he has a HUGE family but know that most will not be able to make it. &amp;nbsp;If they do OMG will I be in BIG trouble. (side note)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We are planning the wedding September 2015, simple and fast no need to drag it all out.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I do not expect my friends or family to throw us a shower, which I kind of feel bad for him. &amp;nbsp;I don&#039;t want him to miss out on all the fun wedding things.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Here is the question do you think if we put on the invitation (doing a boarding pass invite not a save the date) \"registered at\" just in case people who are not coming want to send us something? &amp;nbsp;I really don&#039;t want them to think we want money, this could be more of a nice to have. &amp;nbsp;Or even if someone on his family side decided to do a shower?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1881673,"PostDate":1420318299,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi!<\/p>\n<p>We just got engaged NYE but we have been discussing getting married for the past few months. \u00a0<\/p>\n<p>I was previously married.<\/p>\n<p>We have been together for 3 years\u00a0<\/p>\n<p>We have a little 15 \u00a0month old<\/p>\n<p>\u00a0<\/p>\n<p>We have about 200 people on the invite list because he has a HUGE family but know that most will not be able to make it. \u00a0If they do OMG will I be in BIG trouble. (side note)<\/p>\n<p>\u00a0<\/p>\n<p>We are planning the wedding September 2015, simple and fast no need to drag it all out.<\/p>\n<p>\u00a0<\/p>\n<p>I do not expect my friends or family to throw us a shower, which I kind of feel bad for him. \u00a0I don't want him to miss out on all the fun wedding things.<\/p>\n<p>\u00a0<\/p>\n<p>Here is the question do you think if we put on the invitation (doing a boarding pass invite not a save the date) \"registered at\" just in case people who are not coming want to send us something? \u00a0I really don't want them to think we want money, this could be more of a nice to have. \u00a0Or even if someone on his family side decided to do a shower?<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Gian-Luigi & Susan September 13, 2015 Finest Resort <a data-ipb='nomediaparse' href='http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A'>http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A<\/a>","Email":"susanlaurelli@yahoo.com","IpAddress":"47.17.228.244","GroupId":39,"GroupName":"Newbie","JoinDate":1414840204,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280946.jpg?_r=1437732100","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"SusanMarie813","Id":280946,"Name":"SusanMarie813","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.208.82","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78534,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"4510e432425bb239f6d943387e2fc48d","RawContent":"First of all... Congrats and welcome to the forum! \n\n\nI have never been a fan of making any mention of gifts or a registry anywhere on an invitation- I just have always thought it was better communicated quietly through family or at most placed discretely on your wedding website. \n\n\nI may be in the minority though since I am respectfully declining all gifts and have asked for a shower not to be thrown. It&#039;s my second wedding and in addition those coming to the wedding will be spending a significant amount to attend and I didn&#039;t want any type of insinuated expectation for gifts on my part. \n\n\nOthers may give you different suggestions though! The brides here are great.","Attachments":[],"Id":1881676,"PostDate":1420320007,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                First of all... Congrats and welcome to the forum! <br><br>\nI have never been a fan of making any mention of gifts or a registry anywhere on an invitation- I just have always thought it was better communicated quietly through family or at most placed discretely on your wedding website. <br><br>\nI may be in the minority though since I am respectfully declining all gifts and have asked for a shower not to be thrown. It's my second wedding and in addition those coming to the wedding will be spending a significant amount to attend and I didn't want any type of insinuated expectation for gifts on my part. <br><br>\nOthers may give you different suggestions though! The brides here are great. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kmkwedding2016@gmail.com","IpAddress":"70.72.195.234","GroupId":38,"GroupName":"Moderators","JoinDate":1390238608,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kmk2016","Id":276231,"Name":"kmk2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.68.254.42","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78534,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1ff774bfdf2666376a2520477cf8aae9","RawContent":"[quote name=\"kmk2016\" post=\"1881676\" timestamp=\"1420338007\"]\nFirst of all... Congrats and welcome to the forum!\n\nI have never been a fan of making any mention of gifts or a registry anywhere on an invitation- I just have always thought it was better communicated quietly through family or at most placed discretely on your wedding website.\n\nI may be in the minority though since I am respectfully declining all gifts and have asked for a shower not to be thrown. It&#039;s my second wedding and in addition those coming to the wedding will be spending a significant amount to attend and I didn&#039;t want any type of insinuated expectation for gifts on my part.\n\nOthers may give you different suggestions though! The brides here are great.[\/quote]I was feeling the same way as you before I was speaking to a good friend and she was like out of 200 people maybe 30 will come.  They are super close family on his side, and I know they are the type to send gifts no matter what.  Then it had me started to think well I dont want them sending money because that will just go to the wedding, bills or baby supplies.  Money just goes.  I&#039;d rather have things that we could use in the future in a new home, like if we were going to have a shower..  So torn.... Thanks for your input though :)","Attachments":[],"Id":1881677,"PostDate":1420320240,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>kmk2016, on 03 January 2015 - 09:20 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>First of all... Congrats and welcome to the forum!<br><br>\nI have never been a fan of making any mention of gifts or a registry anywhere on an invitation- I just have always thought it was better communicated quietly through family or at most placed discretely on your wedding website.<br><br>\nI may be in the minority though since I am respectfully declining all gifts and have asked for a shower not to be thrown. It's my second wedding and in addition those coming to the wedding will be spending a significant amount to attend and I didn't want any type of insinuated expectation for gifts on my part.<br><br>\nOthers may give you different suggestions though! The brides here are great.<\/p>\n<\/div>\n<\/div><\/div>\n<p>I was feeling the same way as you before I was speaking to a good friend and she was like out of 200 people maybe 30 will come. \u00a0They are super close family on his side, and I know they are the type to send gifts no matter what. \u00a0Then it had me started to think well I dont want them sending money because that will just go to the wedding, bills or baby supplies. \u00a0Money just goes. \u00a0I'd rather have things that we could use in the future in a new home, like if we were going to have a shower.. \u00a0So torn.... Thanks for your input though <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Gian-Luigi & Susan September 13, 2015 Finest Resort <a data-ipb='nomediaparse' href='http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A'>http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A<\/a>","Email":"susanlaurelli@yahoo.com","IpAddress":"47.17.228.244","GroupId":39,"GroupName":"Newbie","JoinDate":1414840204,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280946.jpg?_r=1437732100","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"SusanMarie813","Id":280946,"Name":"SusanMarie813","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.155.94.124","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78534,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6e06715b5b5a0be6d2366f1f219c459a","RawContent":"First off, congrats on your engagement! I agree with kmk. I&#039;m not a big fan of mentioning the gifts or registry on the invitation, but if you have a website (which I highly recommend for a DW) you can add it on there. We are telling people that gifts are not necessary but if they would like to give us something they can either give us money or buy from a registry (not sure yet if we&#039;ll even do a registry). Basically I don&#039;t want to put people under pressure to spend even more money on our wedding. I understand that this is basically a vacation for most people, but I don&#039;t want to come across as greedy. \n\nAs for the shower, I pictured my shower without gifts haha. I just want to have a good time with my guests but that&#039;s it. So if you&#039;re willing to do that, you can just ask people not to bring any gifts to the shower but he can still sort of get that experience. \n\nThis is the first wedding for both of us by the way :)\n[quote name=\"SusanMarie813\" post=\"1881677\" timestamp=\"1420338240\"]\nI was feeling the same way as you before I was speaking to a good friend and she was like out of 200 people maybe 30 will come.  They are super close family on his side, and I know they are the type to send gifts no matter what.  Then it had me started to think well I dont want them sending money because that will just go to the wedding, bills or baby supplies.  Money just goes.  I&#039;d rather have things that we could use in the future in a new home, like if we were going to have a shower..  So torn.... Thanks for your input though :)[\/quote]Just an FYI, people really surprised us when they started to book! We thought we&#039;d have about 40 people max but pretty much everyone said yes and booked haha, so we have almost 50 guests. Mostly the ones that said no were my extended family in Argentina because all inclusives for them are extremely expensive. \n\nI totally get it, about the money, it goes on the most every-day expenses and it&#039;s kind of a bummer. I would do a registry and put the information on your website, but I wouldn&#039;t mention it on my invites. Let&#039;s say some people say no and still want to send you a gift, if they didn&#039;t check out the website they&#039;ll ask either you or your parents, so they&#039;ll still get the info.","Attachments":[],"Id":1881678,"PostDate":1420321303,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>First off, congrats on your engagement! I agree with kmk. I'm not a big fan of mentioning the gifts or registry on the invitation, but if you have a website (which I highly recommend for a DW) you can add it on there. We are telling people that gifts are not necessary but if they would like to give us something they can either give us money or buy from a registry (not sure yet if we'll even do a registry). Basically I don't want to put people under pressure to spend even more money on our wedding. I understand that this is basically a vacation for most people, but I don't want to come across as greedy.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>As for the shower, I pictured my shower without gifts haha. I just want to have a good time with my guests but that's it. So if you're willing to do that, you can just ask people not to bring any gifts to the shower but he can still sort of get that experience.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>This is the first wedding for both of us by the way <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p><br \/><p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>SusanMarie813, on 03 January 2015 - 09:24 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>I was feeling the same way as you before I was speaking to a good friend and she was like out of 200 people maybe 30 will come. \u00a0They are super close family on his side, and I know they are the type to send gifts no matter what. \u00a0Then it had me started to think well I dont want them sending money because that will just go to the wedding, bills or baby supplies. \u00a0Money just goes. \u00a0I'd rather have things that we could use in the future in a new home, like if we were going to have a shower.. \u00a0So torn.... Thanks for your input though <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<\/div>\n<\/div><\/div>\n<p>Just an FYI, people really surprised us when they started to book! We thought we'd have about 40 people max but pretty much everyone said yes and booked haha, so we have almost 50 guests. Mostly the ones that said no were my extended family in Argentina because all inclusives for them are extremely expensive.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I totally get it, about the money, it goes on the most every-day expenses and it's kind of a bummer. I would do a registry and put the information on your website, but I wouldn't mention it on my invites. Let's say some people say no and still want to send you a gift, if they didn't check out the website they'll ask either you or your parents, so they'll still get the info.\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<br><p><a data-ipb='nomediaparse' href='http:\/\/www.TickerFactory.com\/'><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;31;484\/st\/20150813\/e\/Wedding+time%21+\/dt\/-2\/k\/b92c\/event.png\" alt=\"event.png\"><\/a><\/p>\n<p style=\"text-align:center;\">\u00a0<\/p>\n<p style=\"text-align:center;\">\u00a0","Email":"sblopezb@gmail.com","IpAddress":"172.219.193.22","GroupId":42,"GroupName":"Sr. Member","JoinDate":1359745104,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265511.jpg?_r=1427386564","PhotoWidth":200,"PhotoHeight":153,"PhotoType":"custom"},"FormattedName":"TinkerSofi","Id":265511,"Name":"TinkerSofi","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.68.254.42","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78534,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"0f5a0a923f51ad70af58e7f3bab4b0ad","RawContent":"&lt;p&gt;OMG if everyone goes what will we do LOL!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am not having a shower unless someone on his side is going to throw us one. &amp;nbsp;I know my family will not. &amp;nbsp;Our baby shower we paid for ourselves and had a nice cocktail party.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;:)&lt;\/p&gt;","Attachments":[],"Id":1881681,"PostDate":1420321969,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>OMG if everyone goes what will we do LOL!<\/p>\n<p>\u00a0<\/p>\n<p>I am not having a shower unless someone on his side is going to throw us one. \u00a0I know my family will not. \u00a0Our baby shower we paid for ourselves and had a nice cocktail party.<\/p>\n<p>\u00a0<\/p>\n<p><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Gian-Luigi & Susan September 13, 2015 Finest Resort <a data-ipb='nomediaparse' href='http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A'>http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A<\/a>","Email":"susanlaurelli@yahoo.com","IpAddress":"47.17.228.244","GroupId":39,"GroupName":"Newbie","JoinDate":1414840204,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280946.jpg?_r=1437732100","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"SusanMarie813","Id":280946,"Name":"SusanMarie813","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.155.94.124","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78534,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"52faee034423d36a20d291a834568db2","RawContent":"&lt;p&gt;@[member=\"SusanMarie813\"] It can really go both ways, some brides really struggle to get people to book and others get pretty much everyone who was invited. It&#039;s really hard to know before hand, although with that many guests I don&#039;t think you&#039;ll have much trouble to get a nicely sized wedding. Let&#039;s hope not everyone says yes!&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1881684,"PostDate":1420323373,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"280946\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/280946-susanmarie813\/' title='Member profile'><span itemprop=\"name\">SusanMarie813<\/span><\/a> It can really go both ways, some brides really struggle to get people to book and others get pretty much everyone who was invited. It's really hard to know before hand, although with that many guests I don't think you'll have much trouble to get a nicely sized wedding. Let's hope not everyone says yes!\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<br><p><a data-ipb='nomediaparse' href='http:\/\/www.TickerFactory.com\/'><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;31;484\/st\/20150813\/e\/Wedding+time%21+\/dt\/-2\/k\/b92c\/event.png\" alt=\"event.png\"><\/a><\/p>\n<p style=\"text-align:center;\">\u00a0<\/p>\n<p style=\"text-align:center;\">\u00a0","Email":"sblopezb@gmail.com","IpAddress":"172.219.193.22","GroupId":42,"GroupName":"Sr. Member","JoinDate":1359745104,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265511.jpg?_r=1427386564","PhotoWidth":200,"PhotoHeight":153,"PhotoType":"custom"},"FormattedName":"TinkerSofi","Id":265511,"Name":"TinkerSofi","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.41.59","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78534,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"f340dc3ffd2482b141733dc321c6cb6a","RawContent":"Congrats and welcome!!\n\n\nI agree with the ladies above.  I don&#039;t think it&#039;s taboo to have a registry but I would put it on your website and not on your invites. For those who don&#039;t go and don&#039;t make it on your website, just make sure your family knows to pass along the message. \n\n\nWe didn&#039;t do a registry. Although it&#039;s a week long vacation for them, we still felt guilty so we&#039;ve politely declined gifts when people ask. \n\n\nBoth myself and my fianc\u00e9 have never been married. I only had a bachelorette and skipped the shower. Not exactly sure why, but that&#039;s what I chose.  Showers kind of scream gift giving to me--maybe that&#039;s why?? Hahha not sure. \n\n\nNone the less it&#039;s totally an individual decision :) good luck!\n\n\nOn a side note we invited approx 64 people and 42 are coming :) \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1881688,"PostDate":1420325906,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Congrats and welcome!!<br><br>\nI agree with the ladies above.  I don't think it's taboo to have a registry but I would put it on your website and not on your invites. For those who don't go and don't make it on your website, just make sure your family knows to pass along the message. <br><br>\nWe didn't do a registry. Although it's a week long vacation for them, we still felt guilty so we've politely declined gifts when people ask. <br><br>\nBoth myself and my fianc\u00e9 have never been married. I only had a bachelorette and skipped the shower. Not exactly sure why, but that's what I chose.  Showers kind of scream gift giving to me--maybe that's why?? Hahha not sure. <br><br>\nNone the less it's totally an individual decision <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> good luck!<br><br>\nOn a side note we invited approx 64 people and 42 are coming <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399410602,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.101.83.185","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78534,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1ca9e098e3cade98b08b96c92ec9ed21","RawContent":"&lt;p&gt;Congrats and welcome to BDW. I&#039;m going to chime in with the other ladies. I would advise putting together a website and discreetly putting something there about gifts. Even better is to put the word out through parents, or as Kim said other family members. The word will get around. I&#039;m old school as well when it comes to this stuff and especially with having a DW, people will be spending a large amount of money to get there. If the ones that don&#039;t attend are gracious enough to send a gift, that&#039;s fine. But adding it anywhere to your invites comes off as tacky.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck and happy planning!&lt;\/p&gt;","Attachments":[],"Id":1881693,"PostDate":1420327936,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats and welcome to BDW. I'm going to chime in with the other ladies. I would advise putting together a website and discreetly putting something there about gifts. Even better is to put the word out through parents, or as Kim said other family members. The word will get around. I'm old school as well when it comes to this stuff and especially with having a DW, people will be spending a large amount of money to get there. If the ones that don't attend are gracious enough to send a gift, that's fine. But adding it anywhere to your invites comes off as tacky.<\/p>\n<p>\u00a0<\/p>\n<p>Good luck and happy planning!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283440999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"23.17.81.153","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78534,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"1735365d56dc640c3fd027aa665a4b45","RawContent":"welcome and congratulations! You will love it on here :)\n\n\nI am also going to agree with the other ladies. I would not put it on my invitations.\n\nI think I will be adding it to my website .\n\nFrom my experience the people who want to buy gifts will contact you\/ your family to see what you would need or want. My mom has been fielding my calls. \n\nAs for showers I have told both of our families that we would prefer not to have any, that being said my work place will be throwing one for us, since it&#039;s the workplace tradition I don&#039;t have much say so I&#039;m going to go enjoy it. \n\n\nAs a side note I invited 64 guests and was under the impression that I would have about 30.. Our number is currently at 16 including ourselves :)","Attachments":[],"Id":1881699,"PostDate":1420331797,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                welcome and congratulations! You will love it on here <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br><br>\nI am also going to agree with the other ladies. I would not put it on my invitations.<br>\nI think I will be adding it to my website .<br>\nFrom my experience the people who want to buy gifts will contact you\/ your family to see what you would need or want. My mom has been fielding my calls. <br>\nAs for showers I have told both of our families that we would prefer not to have any, that being said my work place will be throwing one for us, since it's the workplace tradition I don't have much say so I'm going to go enjoy it. <br><br>\nAs a side note I invited 64 guests and was under the impression that I would have about 30.. Our number is currently at 16 including ourselves <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kcrosby86@msn.com","IpAddress":"142.179.243.111","GroupId":40,"GroupName":"Jr. Member","JoinDate":1398811631,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Kayla88","Id":277780,"Name":"Kayla88","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"107.77.76.109","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78534,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"73efabc2f63c282f08a551e5001be5b5","RawContent":"Thanks ladies","Attachments":[],"Id":1881709,"PostDate":1420363478,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks ladies \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Gian-Luigi & Susan September 13, 2015 Finest Resort <a data-ipb='nomediaparse' href='http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A'>http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A<\/a>","Email":"susanlaurelli@yahoo.com","IpAddress":"47.17.228.244","GroupId":39,"GroupName":"Newbie","JoinDate":1414840204,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280946.jpg?_r=1437732100","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"SusanMarie813","Id":280946,"Name":"SusanMarie813","IsOnline":false}}],"Id":"78534","Title":"Registry - Interesting Question","LastPostDate":1421256124},"Pages":{"TotalItems":17,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
