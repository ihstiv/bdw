true,"TopicId":71800,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"dfb41ff6d30b060f6e9c29d9c23fb73d","RawContent":"Hey guys does anybody know what krystie ann charges for her services ?","Attachments":[],"Id":1884081,"PostDate":1422204091,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hey guys does anybody know what krystie ann charges for her services ?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mespin90@yahoo.com","IpAddress":"66.87.117.9","GroupId":39,"GroupName":"Newbie","JoinDate":1421087474,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"maresp90","Id":281703,"Name":"maresp90","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.69.68.93","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71800,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5be416f95217358a0ca42391b0dd1de1","RawContent":"&lt;p&gt;Hello gorgeous&lt;\/p&gt;\n&lt;p&gt;Congratulation.....&lt;\/p&gt;\n&lt;p&gt;I&#039;m a Professional Makeup Artist from new York now living in Dominican Republic&lt;\/p&gt;\n&lt;p&gt;I do airbrush makeup&lt;\/p&gt;\n&lt;p&gt;regular makeup with mac cosmetics,Chanel,makeup forever and Anastasia&lt;\/p&gt;\n&lt;p&gt;i do highlights and contour&lt;\/p&gt;\n&lt;p&gt;eyelashes extension&lt;\/p&gt;\n&lt;p&gt;full lashes&lt;\/p&gt;\n&lt;p&gt;hairdo and blow dry&lt;\/p&gt;\n&lt;p&gt;love to work on destination wedding&lt;\/p&gt;\n&lt;p&gt;for more info visit my website www.judymakeup.tk&lt;\/p&gt;\n&lt;p&gt;instagram judysbeautybar&lt;\/p&gt;\n&lt;p&gt;Facebook Judy n figueroa&lt;\/p&gt;\n&lt;p&gt;Cel: 1 849 353 9986 \/ 1 631 994 5476&lt;\/p&gt;\n&lt;p&gt;email judyfdetavares@hotmail.com&lt;\/p&gt;\n&lt;p&gt;Judy N Figueroa&lt;\/p&gt;\n&lt;p&gt;Professional Makeup Artist&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Senior in colors&lt;\/p&gt;\n&lt;p&gt;Brazilian Blow dry specialist&lt;\/p&gt;\n\n&lt;p&gt;@[member=\"KellyLBauman\"] Hello gorgeous&lt;\/p&gt;\n&lt;p&gt;Congratulation.....&lt;\/p&gt;\n&lt;p&gt;I&#039;m a Professional Makeup Artist from new York now living in Dominican Republic&lt;\/p&gt;\n&lt;p&gt;I do airbrush makeup&lt;\/p&gt;\n&lt;p&gt;regular makeup with mac cosmetics,Chanel,makeup forever and Anastasia&lt;\/p&gt;\n&lt;p&gt;i do highlights and contour&lt;\/p&gt;\n&lt;p&gt;eyelashes extension&lt;\/p&gt;\n&lt;p&gt;full lashes&lt;\/p&gt;\n&lt;p&gt;hairdo and blow dry&lt;\/p&gt;\n&lt;p&gt;love to work on destination wedding&lt;\/p&gt;\n&lt;p&gt;for more info visit my website www.judymakeup.tk&lt;\/p&gt;\n&lt;p&gt;instagram judysbeautybar&lt;\/p&gt;\n&lt;p&gt;Facebook Judy n figueroa&lt;\/p&gt;\n&lt;p&gt;Cel: 1 849 353 9986 \/ 1 631 994 5476&lt;\/p&gt;\n&lt;p&gt;email judyfdetavares@hotmail.com&lt;\/p&gt;\n&lt;p&gt;Judy N Figueroa&lt;\/p&gt;\n&lt;p&gt;Professional Makeup Artist&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Senior in colors&lt;\/p&gt;\n&lt;p&gt;Brazilian Blow dry specialist&lt;\/p&gt;","Attachments":[],"Id":1887432,"PostDate":1424821971,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello gorgeous<\/p>\n<p>Congratulation.....<\/p>\n<p>I'm a Professional Makeup Artist from new York now living in Dominican Republic<\/p>\n<p>I do airbrush makeup<\/p>\n<p>regular makeup with mac cosmetics,Chanel,makeup forever and Anastasia<\/p>\n<p>i do highlights and contour<\/p>\n<p>eyelashes extension<\/p>\n<p>full lashes<\/p>\n<p>hairdo and blow dry<\/p>\n<p>love to work on destination wedding<\/p>\n<p>for more info visit my website www.judymakeup.tk<\/p>\n<p>instagram judysbeautybar<\/p>\n<p>Facebook Judy n figueroa<\/p>\n<p>Cel: 1 849 353 9986 \/ 1 631 994 5476<\/p>\n<p>email judyfdetavares@hotmail.com<\/p>\n<p>Judy N Figueroa<\/p>\n<p>Professional Makeup Artist\u00a0<\/p>\n<p>Senior in colors<\/p>\n<p>Brazilian Blow dry specialist<\/p>\n<br \/><p>@<a hovercard-ref=\"member\" hovercard-id=\"264156\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/264156-kellylbauman\/' title='Member profile'><span itemprop=\"name\">KellyLBauman<\/span><\/a> Hello gorgeous<\/p>\n<p>Congratulation.....<\/p>\n<p>I'm a Professional Makeup Artist from new York now living in Dominican Republic<\/p>\n<p>I do airbrush makeup<\/p>\n<p>regular makeup with mac cosmetics,Chanel,makeup forever and Anastasia<\/p>\n<p>i do highlights and contour<\/p>\n<p>eyelashes extension<\/p>\n<p>full lashes<\/p>\n<p>hairdo and blow dry<\/p>\n<p>love to work on destination wedding<\/p>\n<p>for more info visit my website www.judymakeup.tk<\/p>\n<p>instagram judysbeautybar<\/p>\n<p>Facebook Judy n figueroa<\/p>\n<p>Cel: 1 849 353 9986 \/ 1 631 994 5476<\/p>\n<p>email judyfdetavares@hotmail.com<\/p>\n<p>Judy N Figueroa<\/p>\n<p>Professional Makeup Artist\u00a0<\/p>\n<p>Senior in colors<\/p>\n<p>Brazilian Blow dry specialist<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"judys_beauty_bar@yahoo.com","IpAddress":"72.69.68.93","GroupId":39,"GroupName":"Newbie","JoinDate":1363697624,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-267545.jpeg?_r=0","PhotoWidth":113,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"JudyBeautyBaR","Id":267545,"Name":"JudyBeautyBaR","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.134.151.211","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71800,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"77c8e5f8fa45991f1a149459b17ba046","RawContent":"&lt;p&gt;I&#039;m available for travel and I would be willing to trade haha.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;If you need any advice or tips on what to ask the makeup artist I&#039;m happy to help!&lt;\/p&gt;\n&lt;p&gt;I have been a makeup artist for 11 years and I specialize in Bridal makeup.&lt;\/p&gt;\n&lt;p&gt;I wish I could travel with all you ladies and make you look amazing on your Big Day!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Makeup is so much fun and a HUGE part of my life!&lt;\/p&gt;","Attachments":[],"Id":1887450,"PostDate":1424825062,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I'm available for travel and I would be willing to trade haha.<\/p>\n<p>\u00a0<\/p>\n<p>If you need any advice or tips on what to ask the makeup artist I'm happy to help!<\/p>\n<p>I have been a makeup artist for 11 years and I specialize in Bridal makeup.<\/p>\n<p>I wish I could travel with all you ladies and make you look amazing on your Big Day!<\/p>\n<p>\u00a0<\/p>\n<p>Makeup is so much fun and a HUGE part of my life!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>My Planning Thread:<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78846-steelethespotlights-planning-thread-may-152015-hard-rock-vallara\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78846-steelethespotlights-planning-thread-may-152015-hard-rock-vallara\/<\/a><\/p>\n<p>\n\u00a0","Email":"keegan.steele@gmail.com","IpAddress":"50.134.151.211","GroupId":39,"GroupName":"Newbie","JoinDate":1423275359,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282025.jpg?_r=1423455490","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"SteeleTheSpotlight","Id":282025,"Name":"SteeleTheSpotlight","IsOnline":false}}],"Pages":{"TotalItems":19,"TotalPages":2,"CurrentPage":10,"NextPage":-1,"PreviousPage":0,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
