{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":39,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":4023,"MovedTo":null,"MovedOn":0,"FirstPostId":1819519,"Rating":0,"RatingHits":0,"Starter":{"Id":275607,"Name":"kellisbaby","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275607.jpg?_r=1425326341","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":false},"StartDate":1387218677,"LastPoster":{"Id":275607,"Name":"kellisbaby","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275607.jpg?_r=1425326341","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":22,"Preview":{"Id":1819519,"PostDate":1387218677,"PostContent":"Any 2014 or 2015 Excellence Punta Cana brides out there?\u00a0 I'm in the process of booking 1\/12\/15 a...","Author":{"Signature":"","Email":"kellis_baby@hotmail.com","IpAddress":"108.222.71.55","GroupId":40,"GroupName":"Jr. Member","JoinDate":1386889365,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275607.jpg?_r=1425326341","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"kellisbaby","Id":275607,"Name":"kellisbaby","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"162.119.64.119","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75769,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"aba7bcf55c8c836fc3ed6045a5c833b3","RawContent":"&lt;p&gt;Any 2014 or 2015 Excellence Punta Cana brides out there?&amp;nbsp; I&#039;m in the process of booking 1\/12\/15 and wondering if there are any other brides out there planning with me.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;d especially love it if past brides could come back and tell us how their wedding\/reception\/honeymoon\/DR trip was.&lt;\/p&gt;","Attachments":[],"Id":1819519,"PostDate":1387218677,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Any 2014 or 2015 Excellence Punta Cana brides out there?\u00a0 I'm in the process of booking 1\/12\/15 and wondering if there are any other brides out there planning with me.<\/p>\n<p>\u00a0<\/p>\n<p>I'd especially love it if past brides could come back and tell us how their wedding\/reception\/honeymoon\/DR trip was.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kellis_baby@hotmail.com","IpAddress":"108.222.71.55","GroupId":40,"GroupName":"Jr. Member","JoinDate":1386889365,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275607.jpg?_r=1425326341","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"kellisbaby","Id":275607,"Name":"kellisbaby","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"69.115.153.242","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75769,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7068bb955d610d3206e67453481d1385","RawContent":"&lt;p&gt;Hi there,&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;My date is scheduled for 11\/8\/14!! So excited!&lt;\/p&gt;\n&lt;p&gt;It was really a pain in the butt to reset my password, so I think there won&#039;t be a lot of responses from past brides who no longer need the site.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1819920,"PostDate":1387534602,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi there,<\/p>\n<p>\u00a0<\/p>\n<p>My date is scheduled for 11\/8\/14!! So excited!<\/p>\n<p>It was really a pain in the butt to reset my password, so I think there won't be a lot of responses from past brides who no longer need the site.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"justjennelle@aol.com","IpAddress":"69.115.153.242","GroupId":39,"GroupName":"Newbie","JoinDate":1370257635,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270220.jpeg?_r=0","PhotoWidth":122,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"JennelleRM","Id":270220,"Name":"JennelleRM","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.170.77.131","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75769,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c4e4a54d2a1992e651708e947de616f1","RawContent":"&lt;p&gt;I hope you ladies are still checking this thread!!! I am hoping to book the date 12-13-14 but the wedding planner (Emy) said she cannot confirm my date until&amp;nbsp;I book the room..... There are no flights available for these dates until closer to the end of January, so, I don&#039;t want to book my room and not have a flight to go with it.. but I also don&#039;t want to wait and end up booking the room\/flight and then be told the date isn&#039;t available!!! that part is a bit frustrating! ive already been looking at all the photographer packages, although im somewhat confused... we are planning on going with&amp;nbsp;the Excellence of Love package - and then the WP01 package which is 1 photographer, 1 hour, 24 digital files $450. I asked about this package, and person at Beach Wedding Studios said that they normally take 140-160 pics, which you don&#039;t get, but you can buy the disk - according to the A la carte photo list a CD with all pictures unedited - $1,500. Have any of you looked into the picture packages? I also was curious if you get to pick any certain colors for the wedding? My sister got married at Moon Palace in Cancun 2 years ago and they sent her a whole list of \"packages\" with different color schemes - maybe this comes with Excellence after you get your confirmation, but so far I&#039;ve only received the photography info, wedding packages and wedding facts.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Hope you are still on this site! Id really like to bounce ideas and get information from both of you!&lt;\/p&gt;\n&lt;p&gt;-Beth&lt;\/p&gt;","Attachments":[],"Id":1827393,"PostDate":1390169120,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I hope you ladies are still checking this thread!!! I am hoping to book the date 12-13-14 but the wedding planner (Emy) said she cannot confirm my date until\u00a0I book the room..... There are no flights available for these dates until closer to the end of January, so, I don't want to book my room and not have a flight to go with it.. but I also don't want to wait and end up booking the room\/flight and then be told the date isn't available!!! that part is a bit frustrating! ive already been looking at all the photographer packages, although im somewhat confused... we are planning on going with\u00a0the Excellence of Love package - and then the WP01 package which is 1 photographer, 1 hour, 24 digital files $450. I asked about this package, and person at Beach Wedding Studios said that they normally take 140-160 pics, which you don't get, but you can buy the disk - according to the A la carte photo list a CD with all pictures unedited - $1,500. Have any of you looked into the picture packages? I also was curious if you get to pick any certain colors for the wedding? My sister got married at Moon Palace in Cancun 2 years ago and they sent her a whole list of \"packages\" with different color schemes - maybe this comes with Excellence after you get your confirmation, but so far I've only received the photography info, wedding packages and wedding facts.<\/p>\n<p>\u00a0<\/p>\n<p>Hope you are still on this site! Id really like to bounce ideas and get information from both of you!<\/p>\n<p>-Beth<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"beth9211240@aol.com","IpAddress":"66.170.77.131","GroupId":39,"GroupName":"Newbie","JoinDate":1390167826,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"bethb731","Id":276205,"Name":"bethb731","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"162.119.64.119","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75769,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cd1230c5db6c4cd69bfb0052016a519c","RawContent":"&lt;p&gt;Nice, we have two other brides at the Excellence.&amp;nbsp; I&#039;m happy to have someone else to compare notes with!&amp;nbsp; We just got our official wedding confirmation letter this week.&amp;nbsp; (OMG, it took forever... over a month.)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;@[member=\"bethb731\"] - I&#039;m not sure if this helps, but I booked our room block in advance of getting the confirmation letter of our wedding date\/package.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;The photo pacakges for Beach Weddings Studio are expensive, so I am really considering just bringing someone from offsite.&amp;nbsp; HCD and Caribbean Emotions gave me excellent pricing.&amp;nbsp; So good, I could bring them in, pay the extra fees and get a lot more for the $$.&amp;nbsp; My travel agent is also looking into the possibility of flying someone in, putting them up for 3 nights at the hotel in lieu of them charging for pictures.&amp;nbsp; (Which would ROCK!)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I got a list of the bouquets, centerpieces, gazebo decorations, cakes and pricing that I&#039;ll be happy to send over to you if you want.&lt;\/p&gt;","Attachments":[],"Id":1828472,"PostDate":1390504998,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Nice, we have two other brides at the Excellence.\u00a0 I'm happy to have someone else to compare notes with!\u00a0 We just got our official wedding confirmation letter this week.\u00a0 (OMG, it took forever... over a month.)<\/p>\n<p>\u00a0<\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"276205\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/276205-bethb731\/' title='Member profile'><span itemprop=\"name\">bethb731<\/span><\/a> - I'm not sure if this helps, but I booked our room block in advance of getting the confirmation letter of our wedding date\/package.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>The photo pacakges for Beach Weddings Studio are expensive, so I am really considering just bringing someone from offsite.\u00a0 HCD and Caribbean Emotions gave me excellent pricing.\u00a0 So good, I could bring them in, pay the extra fees and get a lot more for the $$.\u00a0 My travel agent is also looking into the possibility of flying someone in, putting them up for 3 nights at the hotel in lieu of them charging for pictures.\u00a0 (Which would ROCK!)<\/p>\n<p>\u00a0<\/p>\n<p>I got a list of the bouquets, centerpieces, gazebo decorations, cakes and pricing that I'll be happy to send over to you if you want.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kellis_baby@hotmail.com","IpAddress":"108.222.71.55","GroupId":40,"GroupName":"Jr. Member","JoinDate":1386889365,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275607.jpg?_r=1425326341","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"kellisbaby","Id":275607,"Name":"kellisbaby","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"69.115.153.242","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75769,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3a00d4618164e9089daa35029d14bdca","RawContent":"&lt;p&gt;Hi there,&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I would really appreciate if you could send my your research on other photographers. I also found that Beach Weddings Studio was very expensive, especially since I don&#039;t want any prints. I just want to bring home a disc. I do wonder how that affects the prints and video included in the package though.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Also, I requested my info about a year ago and never got anything about cakes. Could you please send me everything you have? Then, if I have anything different I&#039;ll send it to you :) I&#039;ll put all spaces between so it does get &#039;captured&#039; &amp;nbsp; j u s t j e n n e l l e &#039;at&#039; a o l&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thank you!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Beth, I also held rooms before I got my confirmation and before flights were published. I&#039;m not sure where you are flying from, but I didn&#039;t have any issues with that. 12\/13\/14 is a cool date! My birthday is 12\/12! My main color is navy blue because my engagement ring has sapphires and I just starting building off that :) I don;t intend on doing too much extra decorating though...&lt;\/p&gt;","Attachments":[],"Id":1828907,"PostDate":1390745641,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi there,<\/p>\n<p>\u00a0<\/p>\n<p>I would really appreciate if you could send my your research on other photographers. I also found that Beach Weddings Studio was very expensive, especially since I don't want any prints. I just want to bring home a disc. I do wonder how that affects the prints and video included in the package though.<\/p>\n<p>\u00a0<\/p>\n<p>Also, I requested my info about a year ago and never got anything about cakes. Could you please send me everything you have? Then, if I have anything different I'll send it to you <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> I'll put all spaces between so it does get 'captured' \u00a0 j u s t j e n n e l l e 'at' a o l\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Thank you!<\/p>\n<p>\u00a0<\/p>\n<p>Beth, I also held rooms before I got my confirmation and before flights were published. I'm not sure where you are flying from, but I didn't have any issues with that. 12\/13\/14 is a cool date! My birthday is 12\/12! My main color is navy blue because my engagement ring has sapphires and I just starting building off that <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> I don;t intend on doing too much extra decorating though...<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"justjennelle@aol.com","IpAddress":"69.115.153.242","GroupId":39,"GroupName":"Newbie","JoinDate":1370257635,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270220.jpeg?_r=0","PhotoWidth":122,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"JennelleRM","Id":270220,"Name":"JennelleRM","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"162.119.64.119","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75769,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"dc3b6170bd1c98075bb00277a9b56e1e","RawContent":"&lt;p&gt;@JennelleRM&amp;nbsp; Do you still need the photographer pricing I got for HDC and Caribbean Emotions?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I ended up going with PhotoPhil though.&amp;nbsp; He is not cheap, but his pictures are amazing.&amp;nbsp; And with all day coverage and the outside vendor fee, it&#039;s about the same as I&#039;d pay for the resort photographer.&amp;nbsp; So I&#039;m happy with my decision.&amp;nbsp; PhotoPhil acts as a day of coordinator as well, so that&#039;s a relief.&amp;nbsp; So far he has been SUPER helpful and very, very prompt in replying to my emails.&amp;nbsp; I mailed a depsit check TODAY!&amp;nbsp; WOOT!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I also ended up booking pastor Rick York at PhotoPhil&#039;s suggestion.&amp;nbsp; He said the resorts wedding ceremony is in Spanish and then yoru wedding coordinator translates in English.&amp;nbsp; Erm, no thanks.&amp;nbsp; Pastor York&#039;s fee&#039;s for 2015 were $400 but luckily Emy Rose said there is no day pass, or outside vendor fee for him.&lt;\/p&gt;","Attachments":[],"Id":1833380,"PostDate":1392218693,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@JennelleRM\u00a0 Do you still need the photographer pricing I got for HDC and Caribbean Emotions?<\/p>\n<p>\u00a0<\/p>\n<p>I ended up going with PhotoPhil though.\u00a0 He is not cheap, but his pictures are amazing.\u00a0 And with all day coverage and the outside vendor fee, it's about the same as I'd pay for the resort photographer.\u00a0 So I'm happy with my decision.\u00a0 PhotoPhil acts as a day of coordinator as well, so that's a relief.\u00a0 So far he has been SUPER helpful and very, very prompt in replying to my emails.\u00a0 I mailed a depsit check TODAY!\u00a0 WOOT!<\/p>\n<p>\u00a0<\/p>\n<p>I also ended up booking pastor Rick York at PhotoPhil's suggestion.\u00a0 He said the resorts wedding ceremony is in Spanish and then yoru wedding coordinator translates in English.\u00a0 Erm, no thanks.\u00a0 Pastor York's fee's for 2015 were $400 but luckily Emy Rose said there is no day pass, or outside vendor fee for him.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kellis_baby@hotmail.com","IpAddress":"108.222.71.55","GroupId":40,"GroupName":"Jr. Member","JoinDate":1386889365,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275607.jpg?_r=1425326341","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"kellisbaby","Id":275607,"Name":"kellisbaby","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.249.88.229","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75769,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5ba512af609738ce406d1245f454912f","RawContent":"Hello, yes please, that would be great! Can you also please send info for photophil? I&#039;m doing a symbolic ceremony, so I believe the coordinator just does the whole thing in English.\nAlso, how does having an outside photographer affect the photos included in the wedding package? @","Attachments":[],"Id":1833605,"PostDate":1392318410,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hello, yes please, that would be great! Can you also please send info for photophil? I'm doing a symbolic ceremony, so I believe the coordinator just does the whole thing in English.<br \/>Also, how does having an outside photographer affect the photos included in the wedding package? @\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"justjennelle@aol.com","IpAddress":"69.115.153.242","GroupId":39,"GroupName":"Newbie","JoinDate":1370257635,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270220.jpeg?_r=0","PhotoWidth":122,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"JennelleRM","Id":270220,"Name":"JennelleRM","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.152.203.27","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75769,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f9e8d492e17583b1b3a5d24bc3bd39d7","RawContent":"&lt;p&gt;I am getting married 7-12-14 at the EPC. I was wondering how the ceremony is when it is in Spanish and translated. I am also wondering the exact process of paperwork. I am really nervous about the paperwork. Any insight would be appreciated.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1836904,"PostDate":1394058498,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I am getting married 7-12-14 at the EPC. I was wondering how the ceremony is when it is in Spanish and translated. I am also wondering the exact process of paperwork. I am really nervous about the paperwork. Any insight would be appreciated.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sbpopkin222@gmail.com","IpAddress":"24.152.203.27","GroupId":39,"GroupName":"Newbie","JoinDate":1394058070,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"sbpopkin222","Id":277020,"Name":"sbpopkin222","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.222.70.54","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75769,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5e44436eb41eb1c46a2afdfa77157384","RawContent":"&lt;p&gt;@sbpopkin222&amp;nbsp; are you doing a legal ceremony?&amp;nbsp; I&#039;m doing symbolic, but apparently the ceremony is still in Spanish and translated back into English by the WC.&amp;nbsp; I&#039;d rather just get Pastor York and cut out the Spanish.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Do your homework if you are doing a legal ceremony.&amp;nbsp; It seems a bit complicated with having to get documents translated into Spanish and notarized, and then translating back into English, etc.&amp;nbsp; It was just too much hassle, and I&#039;ve read horror stories on here about brides not getting their wedding certificates.&amp;nbsp; I&#039;m going the cheap\/easy\/fast route and doing a courthouse wedding before we leave.&lt;\/p&gt;","Attachments":[],"Id":1840966,"PostDate":1395954569,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@sbpopkin222\u00a0 are you doing a legal ceremony?\u00a0 I'm doing symbolic, but apparently the ceremony is still in Spanish and translated back into English by the WC.\u00a0 I'd rather just get Pastor York and cut out the Spanish.<\/p>\n<p>\u00a0<\/p>\n<p>Do your homework if you are doing a legal ceremony.\u00a0 It seems a bit complicated with having to get documents translated into Spanish and notarized, and then translating back into English, etc.\u00a0 It was just too much hassle, and I've read horror stories on here about brides not getting their wedding certificates.\u00a0 I'm going the cheap\/easy\/fast route and doing a courthouse wedding before we leave.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kellis_baby@hotmail.com","IpAddress":"108.222.71.55","GroupId":40,"GroupName":"Jr. Member","JoinDate":1386889365,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275607.jpg?_r=1425326341","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"kellisbaby","Id":275607,"Name":"kellisbaby","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"187.185.71.164","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75769,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"68903050df7335018a7f157b58f971a8","RawContent":"&lt;p&gt;Hello ladies,&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We are a team of two wedding photographers based in Punta Cana and available for bookings for 2014\/2015.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Feel free to e-mail me if you are still looking for a wedding photographer!&lt;\/p&gt;","Attachments":[],"Id":1840979,"PostDate":1395957517,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello ladies,<\/p>\n<p>\u00a0<\/p>\n<p>We are a team of two wedding photographers based in Punta Cana and available for bookings for 2014\/2015.<\/p>\n<p>\u00a0<\/p>\n<p>Feel free to e-mail me if you are still looking for a wedding photographer!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><strong><span style=\"color:#000080;\"><span style=\"font-size:18px;\"><em><span style=\"font-family:'times new roman', times, serif;\">Creative documentary wedding photographer in Punta Cana!<\/span><\/em><\/span><\/span><\/strong><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.juliaeskin.com'>www.juliaeskin.com<\/a><\/p>\n<p>\u00a0","Email":"julia@juliaeskin.com","IpAddress":"187.153.56.51","GroupId":49,"GroupName":"Insiders","JoinDate":1270568042,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-227096.jpg?_r=1392861573","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Julia Eskin","Id":227096,"Name":"Julia Eskin","IsOnline":false}}],"Id":"75769","Title":"2014\/2015 Excellence Punta Cana Brides?","LastPostDate":1422370322},"Pages":{"TotalItems":39,"TotalPages":4,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":30},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
