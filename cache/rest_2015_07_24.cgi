{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":102,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":21158,"MovedTo":null,"MovedOn":0,"FirstPostId":1528076,"Rating":0,"RatingHits":0,"Starter":{"Id":241612,"Name":"Michey","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/3\/3f\/3f48c407_user-41229-avatar?_r=0","PhotoWidth":200,"PhotoHeight":198,"PhotoType":"custom"},"IsOnline":false},"StartDate":1317415774,"LastPoster":{"Id":280939,"Name":"FutureMrsZ","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280939.jpg?_r=1414783650","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":60,"Preview":{"Id":1528076,"PostDate":1317415774,"PostContent":"Not sure if tipping works the same in Mexico as it does in the States, but how much do you tip t...","Author":{"Signature":"","Email":"michelle.0279@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1309161439,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/3\/3f\/3f48c407_user-41229-avatar?_r=0","PhotoWidth":200,"PhotoHeight":198,"PhotoType":"custom"},"FormattedName":"Michey","Id":241612,"Name":"Michey","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":63836,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e40bf7f98a4c31c780d1256739f97d71","RawContent":"&lt;p&gt; Not sure if tipping works the same in Mexico as it does in the States, but how much do you tip the&amp;nbsp;&lt;\/p&gt; &lt;p&gt; WC&lt;\/p&gt; &lt;p&gt; DJ&amp;nbsp;&lt;\/p&gt; &lt;p&gt; or even staff that work the wedding?&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Thanks, Michelle&lt;\/p&gt;","Attachments":[],"Id":1528076,"PostDate":1317415774,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Not sure if tipping works the same in Mexico as it does in the States, but how much do you tip the\u00a0<\/p> <p> WC<\/p> <p> DJ\u00a0<\/p> <p> or even staff that work the wedding?<\/p> <p> \u00a0<\/p> <p> Thanks, Michelle<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"michelle.0279@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1309161439,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/3\/3f\/3f48c407_user-41229-avatar?_r=0","PhotoWidth":200,"PhotoHeight":198,"PhotoType":"custom"},"FormattedName":"Michey","Id":241612,"Name":"Michey","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":63836,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fb694483504308f3b0f92b5c512321c1","RawContent":"&lt;p&gt; I have similar questions on tipping. &amp;nbsp;I&#039;d also like to know about tipping the DJ - if it is his own company\/service he is already setting the price and receiving the full amount.&lt;\/p&gt;","Attachments":[],"Id":1528515,"PostDate":1317545754,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I have similar questions on tipping. \u00a0I'd also like to know about tipping the DJ - if it is his own company\/service he is already setting the price and receiving the full amount.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Kellys8525@gmail.com","IpAddress":"186.7.250.139","GroupId":47,"GroupName":"Site Supporter","JoinDate":1309605758,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-241872.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"DRBride11","Id":241872,"Name":"DRBride11","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":63836,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a637189998f6ae33c66eaf0c6ab362ae","RawContent":"&lt;p&gt; I would love to know as well! i forgot all about tipping:)&lt;\/p&gt;","Attachments":[],"Id":1528614,"PostDate":1317561834,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I would love to know as well! i forgot all about tipping:)<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"katiejosey@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1313351579,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-243868.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"KatieJ","Id":243868,"Name":"KatieJ","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":63836,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a5076a43f6c61ccd408f95fe44cd188a","RawContent":"&lt;p&gt; I would love to know how much is standard to tip the WC also!! xxx&lt;\/p&gt;","Attachments":[],"Id":1528861,"PostDate":1317635143,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I would love to know how much is standard to tip the WC also!! xxx<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jmbarroccu@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1315556266,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-245108.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":139,"PhotoType":"custom"},"FormattedName":"jennaba3","Id":245108,"Name":"jennaba3","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":false,"TopicId":63836,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cbf456601a3d4eaff994150faa4d7fe6","RawContent":"&lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;div style=\"background-color: transparent; \"&gt; &lt;span id=\"internal-source-marker_0.7861260112840682\" style=\"font-size: 11pt; font-family: Arial; color: rgb(0, 0, 0); background-color: transparent; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; \"&gt;Giving tip depend on person to person and of course on budget...........According to me tipping is an additional cost........Wedding planners work for a set fee and will not expect a tip............If you want to show them how grateful you are for their hard work in planning your wedding then 10% of their total fee is more than adequate..............&lt;\/span&gt;&lt;\/div&gt;","Attachments":[],"Id":1529392,"PostDate":1317714128,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> \u00a0<\/p> <div  style=\"background-color: transparent\"> <span id=\"internal-source-marker_0.7861260112840682\"  style=\"font-size: 11pt;font-family: Arial;color: rgb(0, 0, 0);background-color: transparent;font-style: normal\">Giving tip depend on person to person and of course on budget...........According to me tipping is an additional cost........Wedding planners work for a set fee and will not expect a tip............If you want to show them how grateful you are for their hard work in planning your wedding then 10% of their total fee is more than adequate..............<\/span><\/div>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"michellejones.j@gmail.com","IpAddress":"","GroupId":5,"GroupName":"Banned","JoinDate":1317622668,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-246142.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"JonesM","Id":246142,"Name":"JonesM","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":63836,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"d94a33d6a870614b002ea5bc448ca094","RawContent":"&lt;p&gt; Here girls I did some research on destination weddings and here was the best result&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;ul&gt; &lt;li&gt; You do not need to tip your florist unless he\/she does something spectacular or really out-of-the-floral-realm for you. If he tracks down the filling for your goody bags, or she blows your mind with something you weren\u00e2\u20ac\u2122t expecting, by all means, feel free to tip the florist. But it isn\u00e2\u20ac\u2122t something you need to build into your budget.&lt;\/li&gt; &lt;li&gt; You don\u00e2\u20ac\u2122t need to tip your caterer, but you will need to tip the servers and bartenders. If you don\u00e2\u20ac\u2122t have a wedding planner to guide you, ask the caterer what\u00e2\u20ac\u2122s appropriate per person.&lt;\/li&gt; &lt;li&gt; Don\u00e2\u20ac\u2122t tip the photographer. If you adored her, order more prints!&lt;\/li&gt; &lt;li&gt; Don\u00e2\u20ac\u2122t tip the wedding cake baker.&lt;\/li&gt; &lt;li&gt; Don\u00e2\u20ac\u2122t tip a band, unless they stay extra time and don\u00e2\u20ac\u2122t bill you for it.&lt;\/li&gt; &lt;li&gt; Tip a DJ if he\u00e2\u20ac\u2122s really, really good. $50 is more than enough.&lt;\/li&gt; &lt;li&gt; If you\u00e2\u20ac\u2122re staying in a small hotel and you\u00e2\u20ac\u2122ve taken over the whole place for your wedding, be sure to tip the hotel manager\/concierge who has helped you with everything. You should also tip the breakfast or housekeeping staff, but you don\u00e2\u20ac\u2122t need to do it individually. Give a tip to the person in charge of that staff and ask them to split it with the people who worked during your wedding.&lt;\/li&gt; &lt;li&gt; If you\u00e2\u20ac\u2122re staying at a villa or private property with a house manager or caretaker, tip if you\u00e2\u20ac\u2122re having the reception on the property and the person is being very helpful. Remember, the property owners made money on you. The caretaker or property manager is on salary and had to put up with you because it\u00e2\u20ac\u2122s part of his job. If they do a great job, acknowledge it. If you have daily maid service, it\u00e2\u20ac\u2122s appropriate to leave a tip of $2-$5 per day in your room. If you have a 5-bedroom house, you should tip $10 per day at the end of your stay if they did a good job.&lt;\/li&gt; &lt;li&gt; Do not tip your wedding officiant.&lt;\/li&gt; &lt;li&gt; Do not tip your rental equipment delivery guys \u00e2\u20ac\u201d you paid a delivery fee already.&lt;\/li&gt; &lt;li&gt; Finally, do tip your wedding planner. As self-serving as this may sound, I get asked this question a lot so I\u00e2\u20ac\u2122m going to tackle it openly and honestly.&lt;\/li&gt; &lt;\/ul&gt; &lt;p&gt; If you have a good wedding planner who is charging you a reasonable fee and isn\u00e2\u20ac\u2122t marking up your services, you should tip her at the end of your wedding if you are happy with her services. When deciding how much to tip, think about how much her total fee was, and think about how much money she saved you (there will be items that stick out when you think about it), and how challenging you may have been as a client. If you know you drove her nuts or were very demanding (and she was nice about it), compensate her for the extra time and effort she had to put in to your big day. Tip between 15 and 20 percent of her wedding fee. To some extend it\u00e2\u20ac\u2122s like a restaurant, if you were satisfied, go 15 percent. If you were thrilled and she did a great job for you, go 20 percent or more. If you felt like she dropped the ball, give her 10 percent, or don\u00e2\u20ac\u2122t tip her at all. A tip is supposed to be a gratuity for a job well done, whether it\u00e2\u20ac\u2122s a waitress, a hairdresser or a wedding planner.&lt;\/p&gt; &lt;p&gt; The exception to the rule is the wedding planner who asks for a tip. That is just so gauche. Sometimes I\u00e2\u20ac\u2122ll make a joke about it to my clients when they\u00e2\u20ac\u2122re really super impressed with something I\u00e2\u20ac\u2122ve done. When they\u00e2\u20ac\u2122re telling me how great I am or how much money I\u00e2\u20ac\u2122ve saved them, I\u00e2\u20ac\u2122ll make some joke like \u00e2\u20ac\u0153remember that when it\u00e2\u20ac\u2122s time to tip me,\u00e2\u20ac\u009d or something like that. But I\u00e2\u20ac\u2122ve never ever told a bride up front that a tip was required, or asked a bride for a gratuity after the wedding. Some brides are just thoughtful. I\u00e2\u20ac\u2122ve received lovely thank-you gifts and even sweeter notes \u00e2\u20ac\u201d and those can be very rewarding as well.&lt;\/p&gt; &lt;p&gt; If you don\u00e2\u20ac\u2122t use a wedding planner and a banquet manager or someone else from the hotel steps into that role for your wedding, be prepared to tip her at the end of the event as long as everything has gone smoothly. She is your de facto wedding planner and you should thank her for executing that role well. It doesn\u00e2\u20ac\u2122t need to be as much as you would tip a wedding planner, but a token to let her know her work was appreciated is more than appropriate.&lt;\/p&gt; &lt;p&gt; So when your wedding planner gives you the list of tips you\u00e2\u20ac\u2122ll need for your wedding a few weeks before the big day, take a moment to think about whether you\u00e2\u20ac\u2122ll want to have some extra on hand to tip your planner too, assuming she delivers all that she promised on your wedding day. If in the end she doesn\u00e2\u20ac\u2122t deserve it, spend it on a spa day on your honeymoon.&lt;\/p&gt;","Attachments":[],"Id":1529400,"PostDate":1317714977,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Here girls I did some research on destination weddings and here was the best result<\/p> <p> \u00a0<\/p> <ul> <li> You do not need to tip your florist unless he\/she does something spectacular or really out-of-the-floral-realm for you. If he tracks down the filling for your goody bags, or she blows your mind with something you weren\u00e2\u20ac\u2122t expecting, by all means, feel free to tip the florist. But it isn\u00e2\u20ac\u2122t something you need to build into your budget.<\/li> <li> You don\u00e2\u20ac\u2122t need to tip your caterer, but you will need to tip the servers and bartenders. If you don\u00e2\u20ac\u2122t have a wedding planner to guide you, ask the caterer what\u00e2\u20ac\u2122s appropriate per person.<\/li> <li> Don\u00e2\u20ac\u2122t tip the photographer. If you adored her, order more prints!<\/li> <li> Don\u00e2\u20ac\u2122t tip the wedding cake baker.<\/li> <li> Don\u00e2\u20ac\u2122t tip a band, unless they stay extra time and don\u00e2\u20ac\u2122t bill you for it.<\/li> <li> Tip a DJ if he\u00e2\u20ac\u2122s really, really good. $50 is more than enough.<\/li> <li> If you\u00e2\u20ac\u2122re staying in a small hotel and you\u00e2\u20ac\u2122ve taken over the whole place for your wedding, be sure to tip the hotel manager\/concierge who has helped you with everything. You should also tip the breakfast or housekeeping staff, but you don\u00e2\u20ac\u2122t need to do it individually. Give a tip to the person in charge of that staff and ask them to split it with the people who worked during your wedding.<\/li> <li> If you\u00e2\u20ac\u2122re staying at a villa or private property with a house manager or caretaker, tip if you\u00e2\u20ac\u2122re having the reception on the property and the person is being very helpful. Remember, the property owners made money on you. The caretaker or property manager is on salary and had to put up with you because it\u00e2\u20ac\u2122s part of his job. If they do a great job, acknowledge it. If you have daily maid service, it\u00e2\u20ac\u2122s appropriate to leave a tip of $2-$5 per day in your room. If you have a 5-bedroom house, you should tip $10 per day at the end of your stay if they did a good job.<\/li> <li> Do not tip your wedding officiant.<\/li> <li> Do not tip your rental equipment delivery guys \u00e2\u20ac\u201d you paid a delivery fee already.<\/li> <li> Finally, do tip your wedding planner. As self-serving as this may sound, I get asked this question a lot so I\u00e2\u20ac\u2122m going to tackle it openly and honestly.<\/li> <\/ul> <p> If you have a good wedding planner who is charging you a reasonable fee and isn\u00e2\u20ac\u2122t marking up your services, you should tip her at the end of your wedding if you are happy with her services. When deciding how much to tip, think about how much her total fee was, and think about how much money she saved you (there will be items that stick out when you think about it), and how challenging you may have been as a client. If you know you drove her nuts or were very demanding (and she was nice about it), compensate her for the extra time and effort she had to put in to your big day. Tip between 15 and 20 percent of her wedding fee. To some extend it\u00e2\u20ac\u2122s like a restaurant, if you were satisfied, go 15 percent. If you were thrilled and she did a great job for you, go 20 percent or more. If you felt like she dropped the ball, give her 10 percent, or don\u00e2\u20ac\u2122t tip her at all. A tip is supposed to be a gratuity for a job well done, whether it\u00e2\u20ac\u2122s a waitress, a hairdresser or a wedding planner.<\/p> <p> The exception to the rule is the wedding planner who asks for a tip. That is just so gauche. Sometimes I\u00e2\u20ac\u2122ll make a joke about it to my clients when they\u00e2\u20ac\u2122re really super impressed with something I\u00e2\u20ac\u2122ve done. When they\u00e2\u20ac\u2122re telling me how great I am or how much money I\u00e2\u20ac\u2122ve saved them, I\u00e2\u20ac\u2122ll make some joke like \u00e2\u20ac\u0153remember that when it\u00e2\u20ac\u2122s time to tip me,\u00e2\u20ac\u009d or something like that. But I\u00e2\u20ac\u2122ve never ever told a bride up front that a tip was required, or asked a bride for a gratuity after the wedding. Some brides are just thoughtful. I\u00e2\u20ac\u2122ve received lovely thank-you gifts and even sweeter notes \u00e2\u20ac\u201d and those can be very rewarding as well.<\/p> <p> If you don\u00e2\u20ac\u2122t use a wedding planner and a banquet manager or someone else from the hotel steps into that role for your wedding, be prepared to tip her at the end of the event as long as everything has gone smoothly. She is your de facto wedding planner and you should thank her for executing that role well. It doesn\u00e2\u20ac\u2122t need to be as much as you would tip a wedding planner, but a token to let her know her work was appreciated is more than appropriate.<\/p> <p> So when your wedding planner gives you the list of tips you\u00e2\u20ac\u2122ll need for your wedding a few weeks before the big day, take a moment to think about whether you\u00e2\u20ac\u2122ll want to have some extra on hand to tip your planner too, assuming she delivers all that she promised on your wedding day. If in the end she doesn\u00e2\u20ac\u2122t deserve it, spend it on a spa day on your honeymoon.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sllefebvr@yahoo.com","IpAddress":"64.223.108.246","GroupId":42,"GroupName":"Sr. Member","JoinDate":1298499581,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-237131.JPG?_r=0","PhotoWidth":200,"PhotoHeight":157,"PhotoType":"custom"},"FormattedName":"Sllefebvr","Id":237131,"Name":"Sllefebvr","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":63836,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"94abffc3b12db0698c7a9049298da669","RawContent":"Thanks for posting.  Very helpful!!\n   [quote]\nOriginally Posted by [b]Sllefebvr[\/b] \/img\/forum\/go_quote.gif\n \n \n Here girls I did some research on destination weddings and here was the best result \n [list]\n[*]You do not need to tip your florist unless he\/she does something spectacular or really out-of-the-floral-realm for you. If he tracks down the filling for your goody bags, or she blows your mind with something you weren\u00e2\u20ac\u2122t expecting, by all means, feel free to tip the florist. But it isn\u00e2\u20ac\u2122t something you need to build into your budget.\n[*]You don\u00e2\u20ac\u2122t need to tip your caterer, but you will need to tip the servers and bartenders. If you don\u00e2\u20ac\u2122t have a wedding planner to guide you, ask the caterer what\u00e2\u20ac\u2122s appropriate per person.\n[*]Don\u00e2\u20ac\u2122t tip the photographer. If you adored her, order more prints!\n[*]Don\u00e2\u20ac\u2122t tip the wedding cake baker.\n[*]Don\u00e2\u20ac\u2122t tip a band, unless they stay extra time and don\u00e2\u20ac\u2122t bill you for it.\n[*]Tip a DJ if he\u00e2\u20ac\u2122s really, really good. $50 is more than enough.\n[*]If you\u00e2\u20ac\u2122re staying in a small hotel and you\u00e2\u20ac\u2122ve taken over the whole place for your wedding, be sure to tip the hotel manager\/concierge who has helped you with everything. You should also tip the breakfast or housekeeping staff, but you don\u00e2\u20ac\u2122t need to do it individually. Give a tip to the person in charge of that staff and ask them to split it with the people who worked during your wedding.\n[*]If you\u00e2\u20ac\u2122re staying at a villa or private property with a house manager or caretaker, tip if you\u00e2\u20ac\u2122re having the reception on the property and the person is being very helpful. Remember, the property owners made money on you. The caretaker or property manager is on salary and had to put up with you because it\u00e2\u20ac\u2122s part of his job. If they do a great job, acknowledge it. If you have daily maid service, it\u00e2\u20ac\u2122s appropriate to leave a tip of $2-$5 per day in your room. If you have a 5-bedroom house, you should tip $10 per day at the end of your stay if they did a good job.\n[*]Do not tip your wedding officiant.\n[*]Do not tip your rental equipment delivery guys \u00e2\u20ac\u201d you paid a delivery fee already.\n[*]Finally, do tip your wedding planner. As self-serving as this may sound, I get asked this question a lot so I\u00e2\u20ac\u2122m going to tackle it openly and honestly.\n[\/list] If you have a good wedding planner who is charging you a reasonable fee and isn\u00e2\u20ac\u2122t marking up your services, you should tip her at the end of your wedding if you are happy with her services. When deciding how much to tip, think about how much her total fee was, and think about how much money she saved you (there will be items that stick out when you think about it), and how challenging you may have been as a client. If you know you drove her nuts or were very demanding (and she was nice about it), compensate her for the extra time and effort she had to put in to your big day. Tip between 15 and 20 percent of her wedding fee. To some extend it\u00e2\u20ac\u2122s like a restaurant, if you were satisfied, go 15 percent. If you were thrilled and she did a great job for you, go 20 percent or more. If you felt like she dropped the ball, give her 10 percent, or don\u00e2\u20ac\u2122t tip her at all. A tip is supposed to be a gratuity for a job well done, whether it\u00e2\u20ac\u2122s a waitress, a hairdresser or a wedding planner. \n The exception to the rule is the wedding planner who asks for a tip. That is just so gauche. Sometimes I\u00e2\u20ac\u2122ll make a joke about it to my clients when they\u00e2\u20ac\u2122re really super impressed with something I\u00e2\u20ac\u2122ve done. When they\u00e2\u20ac\u2122re telling me how great I am or how much money I\u00e2\u20ac\u2122ve saved them, I\u00e2\u20ac\u2122ll make some joke like \u00e2\u20ac\u0153remember that when it\u00e2\u20ac\u2122s time to tip me,\u00e2\u20ac\u009d or something like that. But I\u00e2\u20ac\u2122ve never ever told a bride up front that a tip was required, or asked a bride for a gratuity after the wedding. Some brides are just thoughtful. I\u00e2\u20ac\u2122ve received lovely thank-you gifts and even sweeter notes \u00e2\u20ac\u201d and those can be very rewarding as well. \n If you don\u00e2\u20ac\u2122t use a wedding planner and a banquet manager or someone else from the hotel steps into that role for your wedding, be prepared to tip her at the end of the event as long as everything has gone smoothly. She is your de facto wedding planner and you should thank her for executing that role well. It doesn\u00e2\u20ac\u2122t need to be as much as you would tip a wedding planner, but a token to let her know her work was appreciated is more than appropriate. \n So when your wedding planner gives you the list of tips you\u00e2\u20ac\u2122ll need for your wedding a few weeks before the big day, take a moment to think about whether you\u00e2\u20ac\u2122ll want to have some extra on hand to tip your planner too, assuming she delivers all that she promised on your wedding day. If in the end she doesn\u00e2\u20ac\u2122t deserve it, spend it on a spa day on your honeymoon.[\/quote]","Attachments":[],"Id":1529747,"PostDate":1317749599,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Thanks for posting.\u00a0 Very helpful!!<br \/> \u00a0<\/p> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>Sllefebvr<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" style=\"border: 0px solid;\" \/><\/span><br \/> <br \/> <p> Here girls I did some research on destination weddings and here was the best result<\/p> <p> \u00a0<\/p> <ul> <li> You do not need to tip your florist unless he\/she does something spectacular or really out-of-the-floral-realm for you. If he tracks down the filling for your goody bags, or she blows your mind with something you weren\u00e2\u20ac\u2122t expecting, by all means, feel free to tip the florist. But it isn\u00e2\u20ac\u2122t something you need to build into your budget.<\/li> <li> You don\u00e2\u20ac\u2122t need to tip your caterer, but you will need to tip the servers and bartenders. If you don\u00e2\u20ac\u2122t have a wedding planner to guide you, ask the caterer what\u00e2\u20ac\u2122s appropriate per person.<\/li> <li> Don\u00e2\u20ac\u2122t tip the photographer. If you adored her, order more prints!<\/li> <li> Don\u00e2\u20ac\u2122t tip the wedding cake baker.<\/li> <li> Don\u00e2\u20ac\u2122t tip a band, unless they stay extra time and don\u00e2\u20ac\u2122t bill you for it.<\/li> <li> Tip a DJ if he\u00e2\u20ac\u2122s really, really good. $50 is more than enough.<\/li> <li> If you\u00e2\u20ac\u2122re staying in a small hotel and you\u00e2\u20ac\u2122ve taken over the whole place for your wedding, be sure to tip the hotel manager\/concierge who has helped you with everything. You should also tip the breakfast or housekeeping staff, but you don\u00e2\u20ac\u2122t need to do it individually. Give a tip to the person in charge of that staff and ask them to split it with the people who worked during your wedding.<\/li> <li> If you\u00e2\u20ac\u2122re staying at a villa or private property with a house manager or caretaker, tip if you\u00e2\u20ac\u2122re having the reception on the property and the person is being very helpful. Remember, the property owners made money on you. The caretaker or property manager is on salary and had to put up with you because it\u00e2\u20ac\u2122s part of his job. If they do a great job, acknowledge it. If you have daily maid service, it\u00e2\u20ac\u2122s appropriate to leave a tip of $2-$5 per day in your room. If you have a 5-bedroom house, you should tip $10 per day at the end of your stay if they did a good job.<\/li> <li> Do not tip your wedding officiant.<\/li> <li> Do not tip your rental equipment delivery guys \u00e2\u20ac\u201d you paid a delivery fee already.<\/li> <li> Finally, do tip your wedding planner. As self-serving as this may sound, I get asked this question a lot so I\u00e2\u20ac\u2122m going to tackle it openly and honestly.<\/li> <\/ul> <p> If you have a good wedding planner who is charging you a reasonable fee and isn\u00e2\u20ac\u2122t marking up your services, you should tip her at the end of your wedding if you are happy with her services. When deciding how much to tip, think about how much her total fee was, and think about how much money she saved you (there will be items that stick out when you think about it), and how challenging you may have been as a client. If you know you drove her nuts or were very demanding (and she was nice about it), compensate her for the extra time and effort she had to put in to your big day. Tip between 15 and 20 percent of her wedding fee. To some extend it\u00e2\u20ac\u2122s like a restaurant, if you were satisfied, go 15 percent. If you were thrilled and she did a great job for you, go 20 percent or more. If you felt like she dropped the ball, give her 10 percent, or don\u00e2\u20ac\u2122t tip her at all. A tip is supposed to be a gratuity for a job well done, whether it\u00e2\u20ac\u2122s a waitress, a hairdresser or a wedding planner.<\/p> <p> The exception to the rule is the wedding planner who asks for a tip. That is just so gauche. Sometimes I\u00e2\u20ac\u2122ll make a joke about it to my clients when they\u00e2\u20ac\u2122re really super impressed with something I\u00e2\u20ac\u2122ve done. When they\u00e2\u20ac\u2122re telling me how great I am or how much money I\u00e2\u20ac\u2122ve saved them, I\u00e2\u20ac\u2122ll make some joke like \u00e2\u20ac\u0153remember that when it\u00e2\u20ac\u2122s time to tip me,\u00e2\u20ac\u009d or something like that. But I\u00e2\u20ac\u2122ve never ever told a bride up front that a tip was required, or asked a bride for a gratuity after the wedding. Some brides are just thoughtful. I\u00e2\u20ac\u2122ve received lovely thank-you gifts and even sweeter notes \u00e2\u20ac\u201d and those can be very rewarding as well.<\/p> <p> If you don\u00e2\u20ac\u2122t use a wedding planner and a banquet manager or someone else from the hotel steps into that role for your wedding, be prepared to tip her at the end of the event as long as everything has gone smoothly. She is your de facto wedding planner and you should thank her for executing that role well. It doesn\u00e2\u20ac\u2122t need to be as much as you would tip a wedding planner, but a token to let her know her work was appreciated is more than appropriate.<\/p> <p> So when your wedding planner gives you the list of tips you\u00e2\u20ac\u2122ll need for your wedding a few weeks before the big day, take a moment to think about whether you\u00e2\u20ac\u2122ll want to have some extra on hand to tip your planner too, assuming she delivers all that she promised on your wedding day. If in the end she doesn\u00e2\u20ac\u2122t deserve it, spend it on a spa day on your honeymoon.<\/p> <\/blockquote> <br \/> <br \/> <p> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sxctaz18@gmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1279735450,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230504.jpeg?_r=0","PhotoWidth":123,"PhotoHeight":160,"PhotoType":"custom"},"FormattedName":"sxcT","Id":230504,"Name":"sxcT","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":63836,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"439ec04f298c17ed7e6a34bfc84b06f4","RawContent":"&lt;p&gt; Thanks for posting&lt;\/p&gt;","Attachments":[],"Id":1529936,"PostDate":1317777111,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Thanks for posting<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"katiejosey@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1313351579,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-243868.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"KatieJ","Id":243868,"Name":"KatieJ","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":63836,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"147317d9d7883783909ae74e28942d79","RawContent":"Thanks for finding this!  Makes it a little easier to decided who to tip and how much!\n   [quote]\nOriginally Posted by [b]Sllefebvr[\/b] \/img\/forum\/go_quote.gif\n \n \n Here girls I did some research on destination weddings and here was the best result \n [list]\n[*]You do not need to tip your florist unless he\/she does something spectacular or really out-of-the-floral-realm for you. If he tracks down the filling for your goody bags, or she blows your mind with something you weren\u00e2\u20ac\u2122t expecting, by all means, feel free to tip the florist. But it isn\u00e2\u20ac\u2122t something you need to build into your budget.\n[*]You don\u00e2\u20ac\u2122t need to tip your caterer, but you will need to tip the servers and bartenders. If you don\u00e2\u20ac\u2122t have a wedding planner to guide you, ask the caterer what\u00e2\u20ac\u2122s appropriate per person.\n[*]Don\u00e2\u20ac\u2122t tip the photographer. If you adored her, order more prints!\n[*]Don\u00e2\u20ac\u2122t tip the wedding cake baker.\n[*]Don\u00e2\u20ac\u2122t tip a band, unless they stay extra time and don\u00e2\u20ac\u2122t bill you for it.\n[*]Tip a DJ if he\u00e2\u20ac\u2122s really, really good. $50 is more than enough.\n[*]If you\u00e2\u20ac\u2122re staying in a small hotel and you\u00e2\u20ac\u2122ve taken over the whole place for your wedding, be sure to tip the hotel manager\/concierge who has helped you with everything. You should also tip the breakfast or housekeeping staff, but you don\u00e2\u20ac\u2122t need to do it individually. Give a tip to the person in charge of that staff and ask them to split it with the people who worked during your wedding.\n[*]If you\u00e2\u20ac\u2122re staying at a villa or private property with a house manager or caretaker, tip if you\u00e2\u20ac\u2122re having the reception on the property and the person is being very helpful. Remember, the property owners made money on you. The caretaker or property manager is on salary and had to put up with you because it\u00e2\u20ac\u2122s part of his job. If they do a great job, acknowledge it. If you have daily maid service, it\u00e2\u20ac\u2122s appropriate to leave a tip of $2-$5 per day in your room. If you have a 5-bedroom house, you should tip $10 per day at the end of your stay if they did a good job.\n[*]Do not tip your wedding officiant.\n[*]Do not tip your rental equipment delivery guys \u00e2\u20ac\u201d you paid a delivery fee already.\n[*]Finally, do tip your wedding planner. As self-serving as this may sound, I get asked this question a lot so I\u00e2\u20ac\u2122m going to tackle it openly and honestly.\n[\/list] If you have a good wedding planner who is charging you a reasonable fee and isn\u00e2\u20ac\u2122t marking up your services, you should tip her at the end of your wedding if you are happy with her services. When deciding how much to tip, think about how much her total fee was, and think about how much money she saved you (there will be items that stick out when you think about it), and how challenging you may have been as a client. If you know you drove her nuts or were very demanding (and she was nice about it), compensate her for the extra time and effort she had to put in to your big day. Tip between 15 and 20 percent of her wedding fee. To some extend it\u00e2\u20ac\u2122s like a restaurant, if you were satisfied, go 15 percent. If you were thrilled and she did a great job for you, go 20 percent or more. If you felt like she dropped the ball, give her 10 percent, or don\u00e2\u20ac\u2122t tip her at all. A tip is supposed to be a gratuity for a job well done, whether it\u00e2\u20ac\u2122s a waitress, a hairdresser or a wedding planner. \n The exception to the rule is the wedding planner who asks for a tip. That is just so gauche. Sometimes I\u00e2\u20ac\u2122ll make a joke about it to my clients when they\u00e2\u20ac\u2122re really super impressed with something I\u00e2\u20ac\u2122ve done. When they\u00e2\u20ac\u2122re telling me how great I am or how much money I\u00e2\u20ac\u2122ve saved them, I\u00e2\u20ac\u2122ll make some joke like \u00e2\u20ac\u0153remember that when it\u00e2\u20ac\u2122s time to tip me,\u00e2\u20ac\u009d or something like that. But I\u00e2\u20ac\u2122ve never ever told a bride up front that a tip was required, or asked a bride for a gratuity after the wedding. Some brides are just thoughtful. I\u00e2\u20ac\u2122ve received lovely thank-you gifts and even sweeter notes \u00e2\u20ac\u201d and those can be very rewarding as well. \n If you don\u00e2\u20ac\u2122t use a wedding planner and a banquet manager or someone else from the hotel steps into that role for your wedding, be prepared to tip her at the end of the event as long as everything has gone smoothly. She is your de facto wedding planner and you should thank her for executing that role well. It doesn\u00e2\u20ac\u2122t need to be as much as you would tip a wedding planner, but a token to let her know her work was appreciated is more than appropriate. \n So when your wedding planner gives you the list of tips you\u00e2\u20ac\u2122ll need for your wedding a few weeks before the big day, take a moment to think about whether you\u00e2\u20ac\u2122ll want to have some extra on hand to tip your planner too, assuming she delivers all that she promised on your wedding day. If in the end she doesn\u00e2\u20ac\u2122t deserve it, spend it on a spa day on your honeymoon.[\/quote]","Attachments":[],"Id":1529969,"PostDate":1317800895,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <br \/> Thanks for finding this!\u00a0 Makes it a little easier to decided who to tip and how much!<br \/> \u00a0<\/p> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>Sllefebvr<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" style=\"border-bottom: 0px solid; border-left: 0px solid; border-top: 0px solid; border-right: 0px solid\" \/><\/span><br \/> <br \/> <p> Here girls I did some research on destination weddings and here was the best result<\/p> <p> \u00a0<\/p> <ul> <li> You do not need to tip your florist unless he\/she does something spectacular or really out-of-the-floral-realm for you. If he tracks down the filling for your goody bags, or she blows your mind with something you weren\u00e2\u20ac\u2122t expecting, by all means, feel free to tip the florist. But it isn\u00e2\u20ac\u2122t something you need to build into your budget.<\/li> <li> You don\u00e2\u20ac\u2122t need to tip your caterer, but you will need to tip the servers and bartenders. If you don\u00e2\u20ac\u2122t have a wedding planner to guide you, ask the caterer what\u00e2\u20ac\u2122s appropriate per person.<\/li> <li> Don\u00e2\u20ac\u2122t tip the photographer. If you adored her, order more prints!<\/li> <li> Don\u00e2\u20ac\u2122t tip the wedding cake baker.<\/li> <li> Don\u00e2\u20ac\u2122t tip a band, unless they stay extra time and don\u00e2\u20ac\u2122t bill you for it.<\/li> <li> Tip a DJ if he\u00e2\u20ac\u2122s really, really good. $50 is more than enough.<\/li> <li> If you\u00e2\u20ac\u2122re staying in a small hotel and you\u00e2\u20ac\u2122ve taken over the whole place for your wedding, be sure to tip the hotel manager\/concierge who has helped you with everything. You should also tip the breakfast or housekeeping staff, but you don\u00e2\u20ac\u2122t need to do it individually. Give a tip to the person in charge of that staff and ask them to split it with the people who worked during your wedding.<\/li> <li> If you\u00e2\u20ac\u2122re staying at a villa or private property with a house manager or caretaker, tip if you\u00e2\u20ac\u2122re having the reception on the property and the person is being very helpful. Remember, the property owners made money on you. The caretaker or property manager is on salary and had to put up with you because it\u00e2\u20ac\u2122s part of his job. If they do a great job, acknowledge it. If you have daily maid service, it\u00e2\u20ac\u2122s appropriate to leave a tip of $2-$5 per day in your room. If you have a 5-bedroom house, you should tip $10 per day at the end of your stay if they did a good job.<\/li> <li> Do not tip your wedding officiant.<\/li> <li> Do not tip your rental equipment delivery guys \u00e2\u20ac\u201d you paid a delivery fee already.<\/li> <li> Finally, do tip your wedding planner. As self-serving as this may sound, I get asked this question a lot so I\u00e2\u20ac\u2122m going to tackle it openly and honestly.<\/li> <\/ul> <p> If you have a good wedding planner who is charging you a reasonable fee and isn\u00e2\u20ac\u2122t marking up your services, you should tip her at the end of your wedding if you are happy with her services. When deciding how much to tip, think about how much her total fee was, and think about how much money she saved you (there will be items that stick out when you think about it), and how challenging you may have been as a client. If you know you drove her nuts or were very demanding (and she was nice about it), compensate her for the extra time and effort she had to put in to your big day. Tip between 15 and 20 percent of her wedding fee. To some extend it\u00e2\u20ac\u2122s like a restaurant, if you were satisfied, go 15 percent. If you were thrilled and she did a great job for you, go 20 percent or more. If you felt like she dropped the ball, give her 10 percent, or don\u00e2\u20ac\u2122t tip her at all. A tip is supposed to be a gratuity for a job well done, whether it\u00e2\u20ac\u2122s a waitress, a hairdresser or a wedding planner.<\/p> <p> The exception to the rule is the wedding planner who asks for a tip. That is just so gauche. Sometimes I\u00e2\u20ac\u2122ll make a joke about it to my clients when they\u00e2\u20ac\u2122re really super impressed with something I\u00e2\u20ac\u2122ve done. When they\u00e2\u20ac\u2122re telling me how great I am or how much money I\u00e2\u20ac\u2122ve saved them, I\u00e2\u20ac\u2122ll make some joke like \u00e2\u20ac\u0153remember that when it\u00e2\u20ac\u2122s time to tip me,\u00e2\u20ac\u009d or something like that. But I\u00e2\u20ac\u2122ve never ever told a bride up front that a tip was required, or asked a bride for a gratuity after the wedding. Some brides are just thoughtful. I\u00e2\u20ac\u2122ve received lovely thank-you gifts and even sweeter notes \u00e2\u20ac\u201d and those can be very rewarding as well.<\/p> <p> If you don\u00e2\u20ac\u2122t use a wedding planner and a banquet manager or someone else from the hotel steps into that role for your wedding, be prepared to tip her at the end of the event as long as everything has gone smoothly. She is your de facto wedding planner and you should thank her for executing that role well. It doesn\u00e2\u20ac\u2122t need to be as much as you would tip a wedding planner, but a token to let her know her work was appreciated is more than appropriate.<\/p> <p> So when your wedding planner gives you the list of tips you\u00e2\u20ac\u2122ll need for your wedding a few weeks before the big day, take a moment to think about whether you\u00e2\u20ac\u2122ll want to have some extra on hand to tip your planner too, assuming she delivers all that she promised on your wedding day. If in the end she doesn\u00e2\u20ac\u2122t deserve it, spend it on a spa day on your honeymoon.<\/p> <\/blockquote> <br \/> <br \/> <p> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jkergen@hotmail.com","IpAddress":"137.186.71.240","GroupId":42,"GroupName":"Sr. Member","JoinDate":1293141900,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-234788.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"JayKay","Id":234788,"Name":"JayKay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":63836,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"676da0bbc75c0755ecc7745e81ef7a2e","RawContent":"&lt;p&gt; I know.. I would of tipped everybody.. but obv. we don&#039;t need to which is nice to know!! I can keep that money in my own pocket!!&lt;\/p&gt;","Attachments":[],"Id":1529970,"PostDate":1317801109,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I know.. I would of tipped everybody.. but obv. we don't need to which is nice to know!! I can keep that money in my own pocket!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sllefebvr@yahoo.com","IpAddress":"64.223.108.246","GroupId":42,"GroupName":"Sr. Member","JoinDate":1298499581,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-237131.JPG?_r=0","PhotoWidth":200,"PhotoHeight":157,"PhotoType":"custom"},"FormattedName":"Sllefebvr","Id":237131,"Name":"Sllefebvr","IsOnline":false}}],"Id":"63836","Title":"How much do we tip the wedding coordinator?","LastPostDate":1415049775},"Pages":{"TotalItems":102,"TotalPages":11,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":100},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
