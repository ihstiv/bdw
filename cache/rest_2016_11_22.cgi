\/\/tickers.TickerFactory.com\/ezt\/d\/4;10716;2\/st\/20090509\/e\/Our+Wedding\/k\/3dbc\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...3dbc\/event.png<\/a><br><br><br><br><span>Officially the Mrs!<\/span><\/div><\/div>","Email":"starlene.morgan@pnc.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1222980098,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-212095.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"StarAndJay","Id":212095,"Name":"StarAndJay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":28118,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"29110ef7d820d2117e18a8595d1a4c5c","RawContent":"This is perfect timing as my wedding budget has been reduced since my FI lost his job. \n \n How do you plan to get all of your glass candle hurricanes to the DR?","Attachments":[],"Id":538140,"PostDate":1229726941,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                This is perfect timing as my wedding budget has been reduced since my FI lost his job. <br \/> <br \/> How do you plan to get all of your glass candle hurricanes to the DR?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"erika.holler@gmail.com","IpAddress":"67.177.241.195","GroupId":46,"GroupName":"VIP Member","JoinDate":1224480180,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-212330.gif?_r=0","PhotoWidth":79,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Erika J","Id":212330,"Name":"Erika J","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":28118,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5dc53dab83216ed9d6053bf273be3dd9","RawContent":"love the suggestions. Im trying very hard to not go into debt with our wedding. Off to the dollar store...","Attachments":[],"Id":538141,"PostDate":1229726980,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                love the suggestions. Im trying very hard to not go into debt with our wedding. Off to the dollar store...\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>:<\/span><\/div><\/div>","Email":"missblueeyedoc@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1217882963,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-210969.gif?_r=0","PhotoWidth":170,"PhotoHeight":127,"PhotoType":"custom"},"FormattedName":"lilmisssunshine","Id":210969,"Name":"lilmisssunshine","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":28118,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"acc27ffbbbd2f07106215551c9c7e3e6","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;Erika J&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;This is perfect timing as my wedding budget has been reduced since my FI lost his job. \n \n How do you plan to get all of your glass candle hurricanes to the DR?&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;Hi:\n \n No worries about the budget...I see it as an opportunity to get creative. You&#039;ll be surprised at what you can do!\n \n About the vases, in thick bubble wrap. We will stuff the inside with clothing to support the glass and wrap the outside in bubble wrap and more clothing....nestle it in a suitcase of more clothes...then pray over the suitcase :)\n \n And if we have any casualties, plan B: white dinner plates from the resort with clear glass pebbles will have to do! We will make a candle arrangement.","Attachments":[],"Id":538157,"PostDate":1229728009,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>Erika J<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">This is perfect timing as my wedding budget has been reduced since my FI lost his job. <br \/> <br \/> How do you plan to get all of your glass candle hurricanes to the DR?<\/div> <\/td> <\/tr> <\/table> <\/div>Hi:<br \/> <br \/> No worries about the budget...I see it as an opportunity to get creative. You'll be surprised at what you can do!<br \/> <br \/> About the vases, in thick bubble wrap. We will stuff the inside with clothing to support the glass and wrap the outside in bubble wrap and more clothing....nestle it in a suitcase of more clothes...then pray over the suitcase <img src='https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br \/> <br \/> And if we have any casualties, plan B: white dinner plates from the resort with clear glass pebbles will have to do! We will make a candle arrangement.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/www.weddingcountdown.com\/ticker\/ubdgkri2xzd.png\">http:\/\/www.weddingcountdown.com\/ticker\/ubdgkri2xzd.png<\/a><br><br><br><strong>Interested in sharing a Photographer: May 9 - 16, 2009<\/strong><br><span>Punta Cana, Dominican RepublicPM me if interested....<\/span><\/div><\/div>","Email":"staciq7@hotmail.com","IpAddress":"184.148.82.222","GroupId":39,"GroupName":"Newbie","JoinDate":1216353431,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-210620.gif?_r=0","PhotoWidth":200,"PhotoHeight":244,"PhotoType":"custom"},"FormattedName":"BeautifulBridetoBe","Id":210620,"Name":"BeautifulBridetoBe","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":28118,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3e7b16affd62e56a8a10b26e6c1b485c","RawContent":"That sounds perfect either way : )","Attachments":[],"Id":538163,"PostDate":1229728197,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                That sounds perfect either way : )\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"erika.holler@gmail.com","IpAddress":"67.177.241.195","GroupId":46,"GroupName":"VIP Member","JoinDate":1224480180,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-212330.gif?_r=0","PhotoWidth":79,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Erika J","Id":212330,"Name":"Erika J","IsOnline":false}}],"Id":"28118","Title":"10 Budgeting Tips for the Frugal Minded :)","LastPostDate":1467618962},"Pages":{"TotalItems":482,"TotalPages":49,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":480},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
