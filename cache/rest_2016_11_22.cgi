Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":2,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":301,"MovedTo":null,"MovedOn":0,"FirstPostId":1915586,"Rating":0,"RatingHits":0,"Starter":{"Id":285114,"Name":"Sarewarren","Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1473466790,"LastPoster":{"Id":286018,"Name":"Endreece","Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-286018.jpg?_r=1459635518","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":60,"Preview":{"Id":1915586,"PostDate":1473466790,"PostContent":"Hello, We are planning a destination wedding in Mexico for October 2017. So far the quotes we hav...","Author":{"Signature":"","Email":"warren.a.sarah@gmail.com","IpAddress":"68.144.64.34","GroupId":39,"GroupName":"Newbie","JoinDate":1445141066,"Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Sarewarren","Id":285114,"Name":"Sarewarren","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.75.26.176","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80291,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fb2ac19cd73ab26e97df18d74739ee04","RawContent":"Hello,\n\n\nWe are planning a destination wedding in Mexico for October 2017. So far the quotes we have received from toronto to cancun have been close to 1700\/ person based on double occupancy and close to 1900\/ person based on double occupancy from calgary to cancun. I am hoping they drop but would also like to start planning. Is it ok to book the wedding package and choose a date before booking the travel packages? I am worried they won&#039;t have room.\n\n\nThanks!","Attachments":[],"Id":1915586,"PostDate":1473466790,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hello,<br><br>\nWe are planning a destination wedding in Mexico for October 2017. So far the quotes we have received from toronto to cancun have been close to 1700\/ person based on double occupancy and close to 1900\/ person based on double occupancy from calgary to cancun. I am hoping they drop but would also like to start planning. Is it ok to book the wedding package and choose a date before booking the travel packages? I am worried they won't have room.<br><br>\nThanks!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"warren.a.sarah@gmail.com","IpAddress":"68.144.64.34","GroupId":39,"GroupName":"Newbie","JoinDate":1445141066,"Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Sarewarren","Id":285114,"Name":"Sarewarren","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"76.183.118.211","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80291,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f0fc62b9d88a231f0292c27a5c36c167","RawContent":"Yes I think it is necessary to book the wedding first because dates can go really fast. Ours had a $250 deposit but it secured our spot. The prices may not go down much though. Have you compared the prices you received to prices on other websites?  That might help. Happy planning!","Attachments":[],"Id":1915594,"PostDate":1473599518,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Yes I think it is necessary to book the wedding first because dates can go really fast. Ours had a $250 deposit but it secured our spot. The prices may not go down much though. Have you compared the prices you received to prices on other websites?  That might help. Happy planning!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cadesha.benson@gmail.com","IpAddress":"67.61.107.139","GroupId":39,"GroupName":"Newbie","JoinDate":1453562302,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-286018.jpg?_r=1459635518","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"Endreece","Id":286018,"Name":"Endreece","IsOnline":false}}],"Id":"80291","Title":"Booking Wedding Ahead Of Travel?","LastPostDate":1473599518},"Pages":{"TotalItems":2,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
