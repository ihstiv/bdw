{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":2,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":516,"MovedTo":null,"MovedOn":0,"FirstPostId":1896759,"Rating":0,"RatingHits":0,"Starter":{"Id":281560,"Name":"pykx82","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1432218219,"LastPoster":{"Id":283187,"Name":"tsts","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":48,"Preview":{"Id":1896763,"PostDate":1432221236,"PostContent":"I'm getting married here also Sept 25\/2015...I've found some reviews and pictures on facebook...T...","Author":{"Signature":"","Email":"trinas121@hotmail.com","IpAddress":"76.65.195.33","GroupId":39,"GroupName":"Newbie","JoinDate":1432213359,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"tsts","Id":283187,"Name":"tsts","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"198.163.47.9","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79201,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fef68a647f49c8bc5e5c2f98b129686b","RawContent":"&lt;p&gt;Hello Ladies!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;So I had previously posted about how we had booked our wedding for January 2016 at the Riu Jalisco in Nuevo Vallarta, Mexico.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Since then, a number of our guests expressed concerns over how dangerous Mexico has gotten lately due to the surge in violence in and around the Puerto Vallarta area, and so we have decided to relocate the wedding to Cuba.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I have to admit that I&#039;m WAY more excited for the wedding now that it&#039;s in Cuba.&amp;nbsp; I absolutely adore that country and cannot wait to get back there.&amp;nbsp; We&#039;ve decided on the Blau Varadero, based on photos and Trip Advisor reviews (as well as the glowing review from our travel agent).&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Has anyone had their wedding there?&amp;nbsp; Any advice\/stories\/photos you would be willing to share?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1896759,"PostDate":1432218219,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello Ladies!<\/p>\n<p>\u00a0<\/p>\n<p>So I had previously posted about how we had booked our wedding for January 2016 at the Riu Jalisco in Nuevo Vallarta, Mexico.<\/p>\n<p>\u00a0<\/p>\n<p>Since then, a number of our guests expressed concerns over how dangerous Mexico has gotten lately due to the surge in violence in and around the Puerto Vallarta area, and so we have decided to relocate the wedding to Cuba.<\/p>\n<p>\u00a0<\/p>\n<p>I have to admit that I'm WAY more excited for the wedding now that it's in Cuba.\u00a0 I absolutely adore that country and cannot wait to get back there.\u00a0 We've decided on the Blau Varadero, based on photos and Trip Advisor reviews (as well as the glowing review from our travel agent).<\/p>\n<p>\u00a0<\/p>\n<p>Has anyone had their wedding there?\u00a0 Any advice\/stories\/photos you would be willing to share?<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"slfehr@outlook.com","IpAddress":"24.114.26.10","GroupId":39,"GroupName":"Newbie","JoinDate":1420222977,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"pykx82","Id":281560,"Name":"pykx82","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"76.65.195.33","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79201,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9a700f612f534118fc3b762a7be9575f","RawContent":"&lt;p&gt;I&#039;m getting married here also Sept 25\/2015...I&#039;ve found some reviews and pictures on facebook...The WC seems great there; and responses quickly to any questions I&#039;ve sent to her&lt;\/p&gt;","Attachments":[],"Id":1896763,"PostDate":1432221236,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I'm getting married here also Sept 25\/2015...I've found some reviews and pictures on facebook...The WC seems great there; and responses quickly to any questions I've sent to her<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"trinas121@hotmail.com","IpAddress":"76.65.195.33","GroupId":39,"GroupName":"Newbie","JoinDate":1432213359,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"tsts","Id":283187,"Name":"tsts","IsOnline":false}}],"Id":"79201","Title":"Blau Varadero Wedding (And Much Wedding Drama)","LastPostDate":1432221236},"Pages":{"TotalItems":2,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
