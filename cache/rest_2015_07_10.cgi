           width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I've been told I have a J-Lo booty - good thing Paul is a \"butt guy\" - so I strut my booty proudly!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<a class='bbc_url' href='http:\/\/bestdestinationwedding.com\/forum\/f77\/anns-annr-las-caletas-dreams-pv-hawaii-review-looooooong-6068\/'>Ann's Caletas Wedding & Hawaii Honeymoon Review<\/a><br \/>\n<a class='bbc_url' href='http:\/\/www.leighmillerphotography.com\/darkroom\/share\/?n=ann_paul'>Our Caletas Wedding Slideshow (by Leigh Miller)<\/a><br \/>\n<a class='bbc_url' href='http:\/\/www.onetruemedia.com\/shared?p=31de360c85cec8376c35a5&skin_id=701&utm_source=otm&utm_medium=image'>Our Caletas Wedding Video<\/a>","Email":"annkherrick@yahoo.com","IpAddress":"76.16.7.43","GroupId":46,"GroupName":"VIP Member","JoinDate":1161396480,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206863.jpg?_r=1429384252","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"LCBride2007","Id":206863,"Name":"LCBride2007","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":1766,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"36945970a400e1da26bc4972b87bf332","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;akh&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;I&#039;ve been told I have a J-Lo booty - good thing Paul is a &amp;quot;butt guy&amp;quot; - so I strut my booty proudly!&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;Oh my gosh you guys! I am booty-licious myself, and Rafael is definitely a butt guy. When I was in high school I used to get so upset though because black guys would always say things like &amp;quot;damn, you gotta lot of junk in that trunk&amp;quot; - I did not like that type of attention, so embarrassing at that age! Not too long ago I was in Vegas for a girls weekend &amp;amp; we were standing in line for a club (Rain I think) and some guy behind me got on his cell phone &amp;amp; told his friend he was standing behind &amp;quot;a fine white girl with a black girls bootie&amp;quot; - wow!!!","Attachments":[],"Id":24139,"PostDate":1170896882,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>akh<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">I've been told I have a J-Lo booty - good thing Paul is a \"butt guy\" - so I strut my booty proudly!<\/div> <\/td> <\/tr> <\/table> <\/div>Oh my gosh you guys! I am booty-licious myself, and Rafael is definitely a butt guy. When I was in high school I used to get so upset though because black guys would always say things like \"damn, you gotta lot of junk in that trunk\" - I did not like that type of attention, so embarrassing at that age! Not too long ago I was in Vegas for a girls weekend & we were standing in line for a club (Rain I think) and some guy behind me got on his cell phone & told his friend he was standing behind \"a fine white girl with a black girls bootie\" - wow!!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"clb26@yahoo.com","IpAddress":"67.182.138.230","GroupId":46,"GroupName":"VIP Member","JoinDate":1148516640,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"none"},"FormattedName":"A10CalGal","Id":206736,"Name":"A10CalGal","IsOnline":false}}],"Pages":{"TotalItems":35,"TotalPages":4,"CurrentPage":10,"NextPage":20,"PreviousPage":0,"LastPage":30},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
