:2,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":345,"MovedTo":null,"MovedOn":0,"FirstPostId":1864583,"Rating":0,"RatingHits":0,"Starter":{"Id":265870,"Name":"Lindsey24","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265870.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":113,"PhotoType":"custom"},"IsOnline":false},"StartDate":1407247225,"LastPoster":{"Id":278603,"Name":"Sabes44","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278603.jpg?_r=1405559586","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":48,"Preview":{"Id":1864583,"PostDate":1407247225,"PostContent":"Hello! \u00a0 My fiance and I are planning to elope to Varadero, Cuba on Setember 6, 2014. We will be...","Author":{"Signature":"","Email":"lsnelgrove24@gmail.com","IpAddress":"198.84.200.85","GroupId":39,"GroupName":"Newbie","JoinDate":1360459308,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265870.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"Lindsey24","Id":265870,"Name":"Lindsey24","IsOnline":false}},"Posts":[],"Id":"77726","Title":"Beach Elopement In Varadero - Please Help!","LastPostDate":1407271045},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":1,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":452,"MovedTo":null,"MovedOn":0,"FirstPostId":1864378,"Rating":0,"RatingHits":0,"Starter":{"Id":279285,"Name":"trustory","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1407123702,"LastPoster":{"Id":279285,"Name":"trustory","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":48,"Preview":{"Id":1864378,"PostDate":1407123702,"PostContent":"Hi All, \u00a0 I am getting married at the Melia Varadero in January of 2015.\u00a0 Looking for any previou...","Author":{"Signature":"","Email":"tmbaksh@hotmail.com","IpAddress":"198.96.180.245","GroupId":39,"GroupName":"Newbie","JoinDate":1407121838,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"trustory","Id":279285,"Name":"trustory","IsOnline":false}},"Posts":[],"Id":"77707","Title":"Melia Varadero 2014\/2015","LastPostDate":1407123702},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":9,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":652,"MovedTo":null,"MovedOn":0,"FirstPostId":1786424,"Rating":0,"RatingHits":0,"Starter":{"Id":272165,"Name":"Stanicka","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272165.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"StartDate":1375444993,"LastPoster":{"Id":279185,"Name":"081114OVCUBA","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279185.jpg?_r=1408922571","PhotoWidth":200,"PhotoHeight":299,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":48,"Preview":{"Id":1786424,"PostDate":1375444993,"PostContent":"Can someone please provide me with the list of documents that are needed before arriving in Cuba?...","Author":{"Signature":"","Email":"stanicka86@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1375434101,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272165.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Stanicka","Id":272165,"Name":"Stanicka","IsOnline":false}},"Posts":[],"Id":"74740","Title":"Necessary documents for a Cuban Wedding","LastPostDate":1407021415}],"Pages":{"TotalItems":341,"TotalPages":23,"CurrentPage":0,"NextPage":15,"PreviousPage":-1,"LastPage":330},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
