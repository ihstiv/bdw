http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276748.jpg?_r=1392867144","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"diadiamond","Id":276748,"Name":"diadiamond","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.234.136.182","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77583,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d957a7fe2901b387b3a2b02b85ca6cb8","RawContent":"&lt;p&gt;Oh wow! &amp;nbsp;I really hope it works out for you. &amp;nbsp;Let us know when you find out!&lt;\/p&gt;","Attachments":[],"Id":1870652,"PostDate":1409916227,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Oh wow! \u00a0I really hope it works out for you. \u00a0Let us know when you find out!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div><br><div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;484\/st\/20150924\/e\/Our+Wedding\/k\/8745\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<\/div>\n<div>\u00a0<\/div>\n<div>My Planning Thread:<\/div>\n<div>\u00a0<\/div>\n<div><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79153-diadiamonds-planning-thread-iberostar-varadero-cuba-sept242015\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79153-diadiamonds-planning-thread-iberostar-varadero-cuba-sept242015\/<\/a><\/div>\n<div>\u00a0<\/div>\n<div>\u00a0<\/div>\n","Email":"fadia.daniel@gmail.com","IpAddress":"76.64.81.211","GroupId":40,"GroupName":"Jr. Member","JoinDate":1392664043,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276748.jpg?_r=1392867144","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"diadiamond","Id":276748,"Name":"diadiamond","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.235.152.39","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77583,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cf6d80b62f85f53c7f134e3460389f70","RawContent":"&lt;p&gt;Hi Everyone! &amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;m not sure if I let you all know, but I ended up picking the Iberostar Varadero for my wedding. &amp;nbsp;My wedding is on September 24, 2015. &amp;nbsp;I will definitely write a review and post pictures too so that future brides have a wedding review to look at. &amp;nbsp;Good luck to all the brides out there still trying to choose a resort it was so far the most stressful part of planning.&lt;\/p&gt;","Attachments":[],"Id":1881843,"PostDate":1420475788,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Everyone! \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I'm not sure if I let you all know, but I ended up picking the Iberostar Varadero for my wedding. \u00a0My wedding is on September 24, 2015. \u00a0I will definitely write a review and post pictures too so that future brides have a wedding review to look at. \u00a0Good luck to all the brides out there still trying to choose a resort it was so far the most stressful part of planning.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div><br><div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;484\/st\/20150924\/e\/Our+Wedding\/k\/8745\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<\/div>\n<div>\u00a0<\/div>\n<div>My Planning Thread:<\/div>\n<div>\u00a0<\/div>\n<div><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79153-diadiamonds-planning-thread-iberostar-varadero-cuba-sept242015\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79153-diadiamonds-planning-thread-iberostar-varadero-cuba-sept242015\/<\/a><\/div>\n<div>\u00a0<\/div>\n<div>\u00a0<\/div>\n","Email":"fadia.daniel@gmail.com","IpAddress":"76.64.81.211","GroupId":40,"GroupName":"Jr. Member","JoinDate":1392664043,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276748.jpg?_r=1392867144","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"diadiamond","Id":276748,"Name":"diadiamond","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.77.57.142","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77583,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"69a0b33b847de0e1352d48e593609002","RawContent":"&lt;p&gt;oh i can&#039;t wait to hear your review... i am 80% sure i am going to pick the same resort. are you going to your the photographer there?&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Really looking forward to hearing your review and how everything goes&lt;\/p&gt;","Attachments":[],"Id":1887090,"PostDate":1424558352,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>oh i can't wait to hear your review... i am 80% sure i am going to pick the same resort. are you going to your the photographer there?\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Really looking forward to hearing your review and how everything goes<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nataliepienkowski@gmail.com","IpAddress":"24.77.57.142","GroupId":39,"GroupName":"Newbie","JoinDate":1423784492,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Pienkowskin","Id":282098,"Name":"Pienkowskin","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.234.116.105","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77583,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"4a635d42a5109817e7c67b86899d8902","RawContent":"I change my mind every day lol","Attachments":[],"Id":1887092,"PostDate":1424560808,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I change my mind every day lol\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"joanne.aguiar@gmail.com","IpAddress":"99.234.116.105","GroupId":39,"GroupName":"Newbie","JoinDate":1424056909,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282128.jpg?_r=1435421499","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"JoannaBanana","Id":282128,"Name":"JoannaBanana","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.49.225.75","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77583,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b88f633cb89d8bbc70db58377e84704c","RawContent":"&lt;p&gt;@[member=\"Pienkowskin\"] Hey hun! &amp;nbsp;Thanks! &amp;nbsp;I&#039;m about 5 months away from the big day. &amp;nbsp;I&#039;m just going to use the resort photographer as I don&#039;t have the funds to bring my own. &amp;nbsp;Also I heard that they are giving photographers that you bring a hard time. &amp;nbsp;&lt;\/p&gt;\n\n&lt;p&gt;@[member=\"JoannaBanana\"] &amp;nbsp;I hear you on that girl! &amp;nbsp;I chose my resort and sometimes I still question if I chose the right one. &amp;nbsp;I haven&#039;t been to the resort I chose so it makes me a little nervous, but I have been reading and hearing good things from people who have been to the resort. &amp;nbsp;We chose Iberostar Varadero because it had better reviews than the other resorts we were thinking of and we really wanted our guests to feel comfortable (most of them have never been to Cuba before). &amp;nbsp;I really wanted Iberostar Laguna Azul because the spa terrace looked so beautiful, but my fiance said no because of the slightly lower ratings. &amp;nbsp; &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1894405,"PostDate":1430004519,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"282098\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/282098-pienkowskin\/' title='Member profile'><span itemprop=\"name\">Pienkowskin<\/span><\/a> Hey hun! \u00a0Thanks! \u00a0I'm about 5 months away from the big day. \u00a0I'm just going to use the resort photographer as I don't have the funds to bring my own. \u00a0Also I heard that they are giving photographers that you bring a hard time. \u00a0<\/p>\n<br \/><p>@<a hovercard-ref=\"member\" hovercard-id=\"282128\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/282128-joannabanana\/' title='Member profile'><span itemprop=\"name\">JoannaBanana<\/span><\/a> \u00a0I hear you on that girl! \u00a0I chose my resort and sometimes I still question if I chose the right one. \u00a0I haven't been to the resort I chose so it makes me a little nervous, but I have been reading and hearing good things from people who have been to the resort. \u00a0We chose Iberostar Varadero because it had better reviews than the other resorts we were thinking of and we really wanted our guests to feel comfortable (most of them have never been to Cuba before). \u00a0I really wanted Iberostar Laguna Azul because the spa terrace looked so beautiful, but my fiance said no because of the slightly lower ratings. \u00a0 \u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div><br><div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;484\/st\/20150924\/e\/Our+Wedding\/k\/8745\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<\/div>\n<div>\u00a0<\/div>\n<div>My Planning Thread:<\/div>\n<div>\u00a0<\/div>\n<div><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79153-diadiamonds-planning-thread-iberostar-varadero-cuba-sept242015\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79153-diadiamonds-planning-thread-iberostar-varadero-cuba-sept242015\/<\/a><\/div>\n<div>\u00a0<\/div>\n<div>\u00a0<\/div>\n","Email":"fadia.daniel@gmail.com","IpAddress":"76.64.81.211","GroupId":40,"GroupName":"Jr. Member","JoinDate":1392664043,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276748.jpg?_r=1392867144","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"diadiamond","Id":276748,"Name":"diadiamond","IsOnline":false}}],"Id":"77583","Title":"Anyone Else Having A Hard Time Picking A Resort?","LastPostDate":1430004519},"Pages":{"TotalItems":25,"TotalPages":3,"CurrentPage":20,"NextPage":-1,"PreviousPage":10,"LastPage":20},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
