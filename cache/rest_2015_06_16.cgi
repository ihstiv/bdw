{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":true,"CanEdit":true,"CanReply":true,"CanFollow":true,"TotalPosts":3,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":5,"MovedTo":null,"MovedOn":0,"FirstPostId":1898633,"Rating":0,"RatingHits":0,"Starter":{"Id":283554,"Name":"Mickeyb","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":true},"StartDate":1434418626,"LastPoster":{"Id":283167,"Name":"yycbride2016","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283167.jpg?_r=1432133572","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"IsOnline":true},"PollState":"0","LastVote":0,"ForumId":57,"Preview":{"Id":1898637,"PostDate":1434419856,"PostContent":"@Mickeyb I am getting married there February 2016! We are hoping to do the free wedding package (...","Author":{"Signature":"<p>~*~YYCBRIDE2016~*~<\/p><p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79227-yycbride2016-grand-sirenis-planning-thread-february-2016\/'>My planning thread\u00a0<\/a><\/p><p>\u00a0<\/p><p><a class='bbc_url' href='http:\/\/www.TickerFactory.com\/'><br><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10730;484\/st\/20160223\/e\/Our+Wedding\/dt\/-1\/k\/4bd8\/event.png\" alt=\"event.png\"><br><\/a><br>\u00a0","Email":"janellepaquin@hotmail.com","IpAddress":"162.157.216.37","GroupId":39,"GroupName":"Newbie","JoinDate":1432101304,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283167.jpg?_r=1432133572","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"yycbride2016","Id":283167,"Name":"yycbride2016","IsOnline":true}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.226.139.21","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":false,"CanLike":false,"TopicId":79279,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"75babd86b56092599b0657ac435770cb","RawContent":"Hello Fellow brides. I need your help. \n\n\nI am currently looking into getting married in June 2016 and working through different resorts (suggestions always welcome). I am looking for good food good service and a reasonable wedding package. \n\n\nThe and Sirenis has come across my table and one that is quite on the list because it&#039;s a good price and the package seems good. \n\n\n\nI am looking for any help from brides that are currently looking there or have gotten married there. What package did you use what extras did you get. My concern is I am looking at the presidential package because it comes with a DJ and private event and that&#039;s important to me but it says only for 10 people does that mean I have to pay a ton for extra guests? Has anyone dealt with this?? \n\n\nWanted to go to moon palace where they offer free private events but the resort seems to be coming in high costs and grand Sirenis package seemed good! \n\n\n\nAny help is much appreciated. \n\n\nThanks brides!!!","Attachments":[],"Id":1898633,"PostDate":1434418626,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hello Fellow brides. I need your help. <br><br>\nI am currently looking into getting married in June 2016 and working through different resorts (suggestions always welcome). I am looking for good food good service and a reasonable wedding package. <br><br>\nThe and Sirenis has come across my table and one that is quite on the list because it's a good price and the package seems good. <br><br><br>\nI am looking for any help from brides that are currently looking there or have gotten married there. What package did you use what extras did you get. My concern is I am looking at the presidential package because it comes with a DJ and private event and that's important to me but it says only for 10 people does that mean I have to pay a ton for extra guests? Has anyone dealt with this?? <br><br>\nWanted to go to moon palace where they offer free private events but the resort seems to be coming in high costs and grand Sirenis package seemed good! <br><br><br>\nAny help is much appreciated. <br><br>\nThanks brides!!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bidlofs@gmail.com","IpAddress":"99.226.139.21","GroupId":39,"GroupName":"Newbie","JoinDate":1434417744,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Mickeyb","Id":283554,"Name":"Mickeyb","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.15.187","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79279,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e89f31af4cad95e1cb0209c90dd61db0","RawContent":"&lt;p&gt;Check out the thread for calgarybride2015&amp;nbsp; She was married there in January and gave it a glowing review. i know when she gets a chance she&#039;ll chime in here with a comment because I know she loved the resort and has great things to say about it!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;@calgarybride2015&amp;nbsp; Kim - you&#039;re on!!&lt;\/p&gt;","Attachments":[],"Id":1898634,"PostDate":1434419272,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Check out the thread for calgarybride2015\u00a0 She was married there in January and gave it a glowing review. i know when she gets a chance she'll chime in here with a comment because I know she loved the resort and has great things to say about it!<\/p>\n<p>\u00a0<\/p>\n<p>@calgarybride2015\u00a0 Kim - you're on!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283458999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"162.157.216.37","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79279,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7a14faa30a5310fe1d728e64b9fe45f9","RawContent":"@[member=\"Mickeyb\"] I am getting married there February 2016! We are hoping to do the free wedding package (you need 10 double rooms booked for 7days) and then we are going to pay to upgrade to the private beach for the ceremony and private reception. \n\n\nYou do have to pay more for guests after 10 but it should say on the package list if you got one from the coordinators. They are well priced. We will be bringing a few things of our own to save on renting costs (decorations and chair sashes). \n\n\nSo far the resort is quick to respond and really helpful if I have any questions. I&#039;d recommend this resort this far. \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1898637,"PostDate":1434419856,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"283554\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/283554-mickeyb\/' title='Member profile'><span itemprop=\"name\">Mickeyb<\/span><\/a> I am getting married there February 2016! We are hoping to do the free wedding package (you need 10 double rooms booked for 7days) and then we are going to pay to upgrade to the private beach for the ceremony and private reception. <br><br>\nYou do have to pay more for guests after 10 but it should say on the package list if you got one from the coordinators. They are well priced. We will be bringing a few things of our own to save on renting costs (decorations and chair sashes). <br><br>\nSo far the resort is quick to respond and really helpful if I have any questions. I'd recommend this resort this far. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>~*~YYCBRIDE2016~*~<\/p><p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79227-yycbride2016-grand-sirenis-planning-thread-february-2016\/'>My planning thread\u00a0<\/a><\/p><p>\u00a0<\/p><p><a class='bbc_url' href='http:\/\/www.TickerFactory.com\/'><br><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10730;484\/st\/20160223\/e\/Our+Wedding\/dt\/-1\/k\/4bd8\/event.png\" alt=\"event.png\"><br><\/a><br>\u00a0","Email":"janellepaquin@hotmail.com","IpAddress":"162.157.216.37","GroupId":39,"GroupName":"Newbie","JoinDate":1432101304,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283167.jpg?_r=1432133572","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"yycbride2016","Id":283167,"Name":"yycbride2016","IsOnline":true}}],"Id":"79279","Title":"Grand Sirenis Mexico","LastPostDate":1434419856},"Pages":{"TotalItems":3,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":1,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
