{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":15,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":814,"MovedTo":null,"MovedOn":0,"FirstPostId":1887083,"Rating":0,"RatingHits":0,"Starter":{"Id":282195,"Name":"SunyMel","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1424555449,"LastPoster":{"Id":279694,"Name":"rbehlke","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279694.jpg?_r=1425843817","PhotoWidth":200,"PhotoHeight":171,"PhotoType":"custom"},"IsOnline":true},"PollState":"0","LastVote":0,"ForumId":2,"Preview":{"Id":1887083,"PostDate":1424555449,"PostContent":"Hi and congrats to all the bride and grooms! I am new here but have been creeping for a couple mo...","Author":{"Signature":"","Email":"melanie.noel07@gmail.com","IpAddress":"162.157.13.243","GroupId":39,"GroupName":"Newbie","JoinDate":1424554106,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"SunyMel","Id":282195,"Name":"SunyMel","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"162.157.13.243","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78825,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e6896c045d063f0449841b0008af88a0","RawContent":"Hi and congrats to all the bride and grooms! I am new here but have been creeping for a couple months! Lol I have picked the Riu Palace Mexico for our wedding. Some of my guests would like to stay at the Riu Playacar (cheaper). We understand that they won&#039;t be able to come to the palace to visit and we are ok to go see them at their resort during the week. My question is: For the wedding day will they need to purchase a day pass? If they do, how much is it? I have looked for some information regarding this and can&#039;t find a straight answer. I think it&#039;s ridiculous that they would have to pay.... I&#039;m not 100% sure we will pick this resort. Are there any other ones in the area with similar prices (or lower) and that have other sister resorts where guests can stay for a bit less? \n\n\nI appreciate your help! :)\n\nMelanie","Attachments":[],"Id":1887083,"PostDate":1424555449,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi and congrats to all the bride and grooms! I am new here but have been creeping for a couple months! Lol I have picked the Riu Palace Mexico for our wedding. Some of my guests would like to stay at the Riu Playacar (cheaper). We understand that they won't be able to come to the palace to visit and we are ok to go see them at their resort during the week. My question is: For the wedding day will they need to purchase a day pass? If they do, how much is it? I have looked for some information regarding this and can't find a straight answer. I think it's ridiculous that they would have to pay.... I'm not 100% sure we will pick this resort. Are there any other ones in the area with similar prices (or lower) and that have other sister resorts where guests can stay for a bit less? <br><br>\nI appreciate your help! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br>\nMelanie\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"melanie.noel07@gmail.com","IpAddress":"162.157.13.243","GroupId":39,"GroupName":"Newbie","JoinDate":1424554106,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"SunyMel","Id":282195,"Name":"SunyMel","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.234.116.105","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78825,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bebe785e2e59de5521837291cc46eaa7","RawContent":"I&#039;ve read (in a different thread) that a day pass is $65 and for guests of another Riu $45.  Keep us posted with what you find! This resort is on my short list.","Attachments":[],"Id":1887084,"PostDate":1424555693,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I've read (in a different thread) that a day pass is $65 and for guests of another Riu $45.  Keep us posted with what you find! This resort is on my short list.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"joanne.aguiar@gmail.com","IpAddress":"99.234.116.105","GroupId":39,"GroupName":"Newbie","JoinDate":1424056909,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282128.jpg?_r=1426731614","PhotoWidth":200,"PhotoHeight":114,"PhotoType":"custom"},"FormattedName":"JoannaBanana","Id":282128,"Name":"JoannaBanana","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"162.157.13.243","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78825,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7e06dd3957f78ebdbee97f36a5b35aa8","RawContent":"Hi Neako! I will let you know what I find out! What other resorts are you considering? I&#039;m not 100% sure about the Riu... I find their wedding package a bit pricey. We will be a group of 50+ guests. Someone on this site said she paid 10000$ for her wedding with a group of 75. It was 70$ per person for the private reception (BBQ style) on top of the wedding package. Also 25$ per person (after the 40 that were included in the pkg) for the ceremony.","Attachments":[],"Id":1887087,"PostDate":1424557835,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi Neako! I will let you know what I find out! What other resorts are you considering? I'm not 100% sure about the Riu... I find their wedding package a bit pricey. We will be a group of 50+ guests. Someone on this site said she paid 10000$ for her wedding with a group of 75. It was 70$ per person for the private reception (BBQ style) on top of the wedding package. Also 25$ per person (after the 40 that were included in the pkg) for the ceremony. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"melanie.noel07@gmail.com","IpAddress":"162.157.13.243","GroupId":39,"GroupName":"Newbie","JoinDate":1424554106,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"SunyMel","Id":282195,"Name":"SunyMel","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.234.116.105","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78825,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e5c676d61291d3cdc4c670dd2a3d5b97","RawContent":"Hey, my short list right now is Riu Yucatan, Riu Palace Mexico, maybe maybe Riu Palace Riviera Maya and then Grand Riviera Princess","Attachments":[],"Id":1887091,"PostDate":1424560607,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hey, my short list right now is Riu Yucatan, Riu Palace Mexico, maybe maybe Riu Palace Riviera Maya and then Grand Riviera Princess\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"joanne.aguiar@gmail.com","IpAddress":"99.234.116.105","GroupId":39,"GroupName":"Newbie","JoinDate":1424056909,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282128.jpg?_r=1426731614","PhotoWidth":200,"PhotoHeight":114,"PhotoType":"custom"},"FormattedName":"JoannaBanana","Id":282128,"Name":"JoannaBanana","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"162.157.13.243","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78825,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7f5d9e2956f7f2b846c0a7bb26f7451b","RawContent":"For those of you who wanted to know, Riu has finally responded to my question about the day pass. If you are staying at one of the Riu you have to pay 45$ for a day pass if the wedding is at the palace. If you are staying at a completely different resort then you have to pay 95$. \n\n\nAlso, you can only eat dinner (a la carte or buffet) at your own resort. So if you are staying at the palace and you want to have dinner with friends staying at the Yucatan, you can&#039;t. After 6 pm everyone needs to return to their own resort. \n\n\nThey sent me a price list of some of the extras. Give me your email address if you want me to send it to you!\n\n\nGood luck! :)\n\n\nMel","Attachments":[],"Id":1887843,"PostDate":1425170393,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                For those of you who wanted to know, Riu has finally responded to my question about the day pass. If you are staying at one of the Riu you have to pay 45$ for a day pass if the wedding is at the palace. If you are staying at a completely different resort then you have to pay 95$. <br><br>\nAlso, you can only eat dinner (a la carte or buffet) at your own resort. So if you are staying at the palace and you want to have dinner with friends staying at the Yucatan, you can't. After 6 pm everyone needs to return to their own resort. <br><br>\nThey sent me a price list of some of the extras. Give me your email address if you want me to send it to you!<br><br>\nGood luck! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br><br>\nMel\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"melanie.noel07@gmail.com","IpAddress":"162.157.13.243","GroupId":39,"GroupName":"Newbie","JoinDate":1424554106,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"SunyMel","Id":282195,"Name":"SunyMel","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"98.199.69.10","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78825,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cc97b2acb43f46ba2e9aabed96e8db1b","RawContent":"&lt;p&gt;@[member=\"SunyMel\"]&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;FYI, about having your wedding at RPM or any Riu resort. If you have your wedding at RPM, 80% of your guests MUST stay there too. Riu Playacar does NOT count toward the 80%. Just something to keep in mind! :) Happy wedding planning!&lt;\/p&gt;","Attachments":[],"Id":1890821,"PostDate":1427353982,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"282195\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282195-sunymel\/' title='Member profile'><span itemprop=\"name\">SunyMel<\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>FYI, about having your wedding at RPM or any Riu resort. If you have your wedding at RPM, 80% of your guests MUST stay there too. Riu Playacar does NOT count toward the 80%. Just something to keep in mind! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> Happy wedding planning!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"schmusie81@hotmail.com","IpAddress":"66.87.120.150","GroupId":39,"GroupName":"Newbie","JoinDate":1297404459,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-236660.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"susie q","Id":236660,"Name":"susie q","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"162.157.13.243","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78825,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b11fa77afff28c59ae5b916b7d1d27d7","RawContent":"@[member=\"susie q\"]\n\n\nMy travel agent told me about this too and I found a way around it. I actually have 2 reservations - One for my actual wedding at the RPM and another for the Riu Playacar which I put under my mother and sister&#039;s name. The only thing was I had to put two separate deposits.","Attachments":[],"Id":1891127,"PostDate":1427571135,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"236660\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/236660-susie-q\/' title='Member profile'><span itemprop=\"name\">susie q<\/span><\/a><br><br>\nMy travel agent told me about this too and I found a way around it. I actually have 2 reservations - One for my actual wedding at the RPM and another for the Riu Playacar which I put under my mother and sister's name. The only thing was I had to put two separate deposits.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"melanie.noel07@gmail.com","IpAddress":"162.157.13.243","GroupId":39,"GroupName":"Newbie","JoinDate":1424554106,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"SunyMel","Id":282195,"Name":"SunyMel","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"187.175.124.66","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78825,"EditedBy":"<strong>Edited by Moments That Matter, 29 March 2015 - 09:51 AM.<\/strong>","EditDate":1427651492,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8e861606ac48c48043d760b0172a1f40","RawContent":"&lt;p&gt;Welcome to our forum community, Mel and Congrats on your upcoming Mexican wedding!!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We can show you what some of the venues you&#039;re considering would look like as a backdrop for your wedding photos here:&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;...&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10153088034599487.1073741921.18683524486&amp;amp;type=3&#039;&gt;Grand Riviera Princess Wedding Album.&lt;\/a&gt;...&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord.xx.fbcdn.net\/hphotos-xap1\/t31.0-8\/10927831_10153088037604487_507007434765026007_o.jpg\" alt=\"10927831_10153088037604487_5070074347650\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;...from the &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10152385810899487.1073741889.18683524486&amp;amp;type=3&#039;&gt;RUI Palace Playacar Wedding Album&lt;\/a&gt;.....&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/fbcdn-sphotos-e-a.akamaihd.net\/hphotos-ak-xft1\/t31.0-8\/10321813_10152385813474487_4727846940423784178_o.jpg\" alt=\"10321813_10152385813474487_4727846940423\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;...&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10150862627269487.427067.18683524486&amp;amp;type=3&#039;&gt;RUI Palace Mexico Wedding Album&lt;\/a&gt;.....&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/fbcdn-sphotos-b-a.akamaihd.net\/hphotos-ak-xfa1\/v\/t1.0-9\/179529_10150862630394487_658371902_n.jpg?oh=ccbcc8956a0f107542466bce10ed5ef3&amp;amp;oe=5570EE02&amp;amp;__gda__=1436653109_cd4979b5030a92d81c43f501aec701b8\" alt=\"179529_10150862630394487_658371902_n.jpg\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Wishing you happy research and all the best with your journey - cheers!!! team MTM :)&lt;\/p&gt;","Attachments":[],"Id":1891191,"PostDate":1427650870,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome to our forum community, Mel and Congrats on your upcoming Mexican wedding!!!<\/p>\n<p>\u00a0<\/p>\n<p>We can show you what some of the venues you're considering would look like as a backdrop for your wedding photos here:<\/p>\n<p>\u00a0<\/p>\n<p>...<a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10153088034599487.1073741921.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>Grand Riviera Princess Wedding Album.<\/a>...<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord.xx.fbcdn.net\/hphotos-xap1\/t31.0-8\/10927831_10153088037604487_507007434765026007_o.jpg\" alt=\"10927831_10153088037604487_5070074347650\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>...from the <a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10152385810899487.1073741889.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>RUI Palace Playacar Wedding Album<\/a>.....<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/fbcdn-sphotos-e-a.akamaihd.net\/hphotos-ak-xft1\/t31.0-8\/10321813_10152385813474487_4727846940423784178_o.jpg\" alt=\"10321813_10152385813474487_4727846940423\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>...<a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10150862627269487.427067.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>RUI Palace Mexico Wedding Album<\/a>.....<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/fbcdn-sphotos-b-a.akamaihd.net\/hphotos-ak-xfa1\/v\/t1.0-9\/179529_10150862630394487_658371902_n.jpg?oh=ccbcc8956a0f107542466bce10ed5ef3&oe=5570EE02&__gda__=1436653109_cd4979b5030a92d81c43f501aec701b8\" alt=\"179529_10150862630394487_658371902_n.jpg\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>Wishing you happy research and all the best with your journey - cheers!!! team MTM <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280210660,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"98.199.69.10","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78825,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7a5d172b729a7d04d1cda340d6a7d309","RawContent":"[quote name=\"SunyMel\" post=\"1891127\" timestamp=\"1427571135\"]\n@[member=\"susie q\"]\n\nMy travel agent told me about this too and I found a way around it. I actually have 2 reservations - One for my actual wedding at the RPM and another for the Riu Playacar which I put under my mother and sister&#039;s name. The only thing was I had to put two separate deposits.[\/quote]That&#039;s great you found a way around it, but how does that work?? I&#039;m baffled! Lol","Attachments":[],"Id":1891532,"PostDate":1427877661,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>SunyMel, on 28 March 2015 - 11:32 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"236660\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/236660-susie-q\/' title='Member profile'><span itemprop=\"name\">susie q<\/span><\/a><br><br>\nMy travel agent told me about this too and I found a way around it. I actually have 2 reservations - One for my actual wedding at the RPM and another for the Riu Playacar which I put under my mother and sister's name. The only thing was I had to put two separate deposits.<\/p>\n<\/div>\n<\/div><\/div>\n<p>That's great you found a way around it, but how does that work?? I'm baffled! Lol<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"schmusie81@hotmail.com","IpAddress":"66.87.120.150","GroupId":39,"GroupName":"Newbie","JoinDate":1297404459,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-236660.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"susie q","Id":236660,"Name":"susie q","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"98.199.69.10","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78825,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b08b030e8a1731fa2e7edb13b65556ed","RawContent":"&lt;p&gt;FYI, one of the other Rius is doing renovations, and should be completed Oct 2015, so RPM, and everything else is selling out. Book early!!! :angry:&lt;\/p&gt;","Attachments":[],"Id":1892889,"PostDate":1428901444,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>FYI, one of the other Rius is doing renovations, and should be completed Oct 2015, so RPM, and everything else is selling out. Book early!!! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/angry.png' class='bbc_emoticon' alt=':angry:' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"schmusie81@hotmail.com","IpAddress":"66.87.120.150","GroupId":39,"GroupName":"Newbie","JoinDate":1297404459,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-236660.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"susie q","Id":236660,"Name":"susie q","IsOnline":false}}],"Id":"78825","Title":"Riu Palace Mexico","LastPostDate":1434419275},"Pages":{"TotalItems":15,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
