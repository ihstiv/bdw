{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":19,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":865,"MovedTo":null,"MovedOn":0,"FirstPostId":1897943,"Rating":0,"RatingHits":0,"Starter":{"Id":283386,"Name":"ReginaKay","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283386.jpg?_r=1433470594","PhotoWidth":200,"PhotoHeight":201,"PhotoType":"custom"},"IsOnline":true},"StartDate":1433471252,"LastPoster":{"Id":206696,"Name":"TammyWright","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1897943,"PostDate":1433471252,"PostContent":"Hello Everyone!\u00a0 \u00a0 I'm newly engaged and am on the hunt for all-inclusive resorts in Mexico or Do...","Author":{"Signature":"","Email":"reginakrachak@gmail.com","IpAddress":"100.33.96.77","GroupId":39,"GroupName":"Newbie","JoinDate":1433470231,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283386.jpg?_r=1433470594","PhotoWidth":200,"PhotoHeight":201,"PhotoType":"custom"},"FormattedName":"ReginaKay","Id":283386,"Name":"ReginaKay","IsOnline":true}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"100.33.96.77","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79248,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2e76bf1da2e619a1e5027e3b1fde9b46","RawContent":"&lt;p&gt;Hello Everyone!&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;m newly engaged and am on the hunt for all-inclusive resorts in Mexico or Dominican Republic. It seems like the hundreds I&#039;ve looked at didn&#039;t work one for reason or another. I&#039;m pretty easy going, but truly need a resort to be budget friendly for my guests (I&#039;m hoping to get married the weekend of April 7th-12th). My family and friends are all coming from New York so we are very spoiled with food - thus we&#039;ll need a resort with good food (doesn&#039;t have to be spectacular, but people have to be able to eat!). I am looking for a resort that is relatively modern or at least has a fresh\/clean look. Another important factor is wheelchair accessibility for my grandmother - and distance from airport cannot exceed 45 minutes. We are expecting about 60 guests and these hotels and wedding ceremony availabilities are booking up so fast! Please let me know about any suggestions you all have, they will be so appreciated!&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thank you tons,&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Regina&lt;\/p&gt;","Attachments":[],"Id":1897943,"PostDate":1433471252,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello Everyone!\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I'm newly engaged and am on the hunt for all-inclusive resorts in Mexico or Dominican Republic. It seems like the hundreds I've looked at didn't work one for reason or another. I'm pretty easy going, but truly need a resort to be budget friendly for my guests (I'm hoping to get married the weekend of April 7th-12th). My family and friends are all coming from New York so we are very spoiled with food - thus we'll need a resort with good food (doesn't have to be spectacular, but people have to be able to eat!). I am looking for a resort that is relatively modern or at least has a fresh\/clean look. Another important factor is wheelchair accessibility for my grandmother - and distance from airport cannot exceed 45 minutes. We are expecting about 60 guests and these hotels and wedding ceremony availabilities are booking up so fast! Please let me know about any suggestions you all have, they will be so appreciated!\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Thank you tons,\u00a0<\/p>\n<p>Regina<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"reginakrachak@gmail.com","IpAddress":"100.33.96.77","GroupId":39,"GroupName":"Newbie","JoinDate":1433470231,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283386.jpg?_r=1433470594","PhotoWidth":200,"PhotoHeight":201,"PhotoType":"custom"},"FormattedName":"ReginaKay","Id":283386,"Name":"ReginaKay","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"184.151.222.153","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79248,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"d9f11c5fb5c1822eeeedcae8cf52b638","RawContent":"Congrats! I would have recommended my resort the Grand Sirenis Riviera Maya but it&#039;s about 1 hour from Cancun!  Good luck :) \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1897944,"PostDate":1433475435,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Congrats! I would have recommended my resort the Grand Sirenis Riviera Maya but it's about 1 hour from Cancun!  Good luck <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399428602,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.15.187","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79248,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"a6982dca01861d6069b4d0a6ea4edb31","RawContent":"&lt;p&gt;I would absolutely get in touch with the administrators of this site, Wright Travel. They&#039;re destination wedding experts and they will work with you on budget and all the other things you&#039;re looking for, then help with communicating with guests. Here&#039;s a link to get in touch. No harm in asking to see what they can help with but I&#039;m sure you&#039;ll get information that you need.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.wrighttravelagency.com\/leads\/inquiry\/&#039;&gt;https:\/\/www.wrighttravelagency.com\/leads\/inquiry\/&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck and happy planning!&lt;\/p&gt;","Attachments":[],"Id":1897951,"PostDate":1433480651,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I would absolutely get in touch with the administrators of this site, Wright Travel. They're destination wedding experts and they will work with you on budget and all the other things you're looking for, then help with communicating with guests. Here's a link to get in touch. No harm in asking to see what they can help with but I'm sure you'll get information that you need.<\/p>\n<p>\u00a0<\/p>\n<p><a href='https:\/\/www.wrighttravelagency.com\/leads\/inquiry\/' class='bbc_url' title='External link' rel='nofollow external'>https:\/\/www.wrighttr...\/leads\/inquiry\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Good luck and happy planning!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283458999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"96.54.109.9","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79248,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"1dcf26ea22c8bdad4702536d71107315","RawContent":"You could look at either Now Sapphire or Now Jade. Both within 45 mins of airport. We are booked at Now Sapphire for April 2016. We were lucky enough to visit this past April and do a menu tasting for the wedding. It was delicious, although I can&#039;t speak for the regular restaurants. Now Jade appears very modern looking compared to Now Sapphire which has more of a Mexican feel to it. I don&#039;t know about accessibility and they are not the cheapest of resorts (but not the most expensive either) so those may be downfalls. I have to say our WC seems amazing. Always answers within a few days, which is more than many here can say when they are 10 months out. \n\n\n\nSent from my iPhone using Tapatalk\nP.S. You can check out my planning thread for more info on the menu tasting and site visit, including photos. \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1897953,"PostDate":1433483178,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                You could look at either Now Sapphire or Now Jade. Both within 45 mins of airport. We are booked at Now Sapphire for April 2016. We were lucky enough to visit this past April and do a menu tasting for the wedding. It was delicious, although I can't speak for the regular restaurants. Now Jade appears very modern looking compared to Now Sapphire which has more of a Mexican feel to it. I don't know about accessibility and they are not the cheapest of resorts (but not the most expensive either) so those may be downfalls. I have to say our WC seems amazing. Always answers within a few days, which is more than many here can say when they are 10 months out. <br><br><br>\nSent from my iPhone using Tapatalk<br \/>P.S. You can check out my planning thread for more info on the menu tasting and site visit, including photos. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>- Erin<\/p>\n<p>\u00a0<\/p>\n<p>My planning thread:\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268'>http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268<\/a>","Email":"ekjzwedding@gmail.com","IpAddress":"24.85.127.174","GroupId":40,"GroupName":"Jr. Member","JoinDate":1417449445,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281283.jpg?_r=1428779369","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"vancouverpetunia","Id":281283,"Name":"vancouverpetunia","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.203.165.31","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79248,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"1b003dea46d5ea3aa1dd3b0035fbb58d","RawContent":"&lt;p&gt;I second the vote for the Now Jade and the suggestion to look into the Wright Travel Agency for help. We got married at the Now Jade last month with the help of Babs V and Kelly Shiffman from WTA. &amp;nbsp;All of my guests loved it and had a great time.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;It&#039;s very modern and there are 7 restaurants (italian, mediterranean, french, mexican, japanese, etc) that you can go to as many times as you want and don&#039;t require reservations. My grandmother had mobility issues and we thought she was accommodated very well. I think you just need to keep in mind your venue options - for examples we knew a wedding on the beach was definitely out so we chose to get married at the Pergola overlooking the beach (plus I&#039;m not a fan of sand!)&lt;\/p&gt;","Attachments":[],"Id":1897973,"PostDate":1433521897,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I second the vote for the Now Jade and the suggestion to look into the Wright Travel Agency for help. We got married at the Now Jade last month with the help of Babs V and Kelly Shiffman from WTA. \u00a0All of my guests loved it and had a great time.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>It's very modern and there are 7 restaurants (italian, mediterranean, french, mexican, japanese, etc) that you can go to as many times as you want and don't require reservations. My grandmother had mobility issues and we thought she was accommodated very well. I think you just need to keep in mind your venue options - for examples we knew a wedding on the beach was definitely out so we chose to get married at the Pergola overlooking the beach (plus I'm not a fan of sand!)<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mckiever.whetsel@gmail.com","IpAddress":"68.53.109.189","GroupId":40,"GroupName":"Jr. Member","JoinDate":1377372014,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272881.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"mckievme","Id":272881,"Name":"mckievme","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.114.22.160","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79248,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"84a65c71fab0d37d47307e1c3e2148d8","RawContent":"&lt;p&gt;Congrats on your engagement, Regina and Welcome to our forum community!!! It&#039;s chock-full of great ideas, suggestions and advice to help with your planning decisions :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Here are some visual sample comparasons of the resorts the ladies have already recommended .... to show you what kind of backdrop they&#039;d make for your Wedding Day Photo Story......enjoy!!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;from the &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10150951039939487.436910.18683524486&amp;amp;type=3&#039;&gt;G&lt;\/a&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10150951039939487.436910.18683524486&amp;amp;type=3&#039;&gt;rand Sirenis Riviera Maya Wedding Album&lt;\/a&gt;:&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xaf1\/t31.0-8\/338751_10150951048374487_246483711_o.jpg\" alt=\"338751_10150951048374487_246483711_o.jpg\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;from the &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10152879942949487.1073741913.18683524486&amp;amp;type=3&#039;&gt;NOW Jade Wedding Album:&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xap1\/t31.0-8\/10828083_10152879945629487_385058951217096100_o.jpg\" alt=\"10828083_10152879945629487_3850589512170\"&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xfa1\/t31.0-8\/10481829_10152879945984487_3218129313193200416_o.jpg\" alt=\"10481829_10152879945984487_3218129313193\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;from the &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10151784774734487.1073741863.18683524486&amp;amp;type=3&#039;&gt;NOW Sapphire Wedding Album: &lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-ash2\/t31.0-8\/1149436_10151784776474487_1878076495_o.jpg\" alt=\"1149436_10151784776474487_1878076495_o.j\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-frc3\/t31.0-8\/1274839_10151784777424487_1492467888_o.jpg\" alt=\"1274839_10151784777424487_1492467888_o.j\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-prn2\/t31.0-8\/1097873_10151784780044487_1914691090_o.jpg\" alt=\"1097873_10151784780044487_1914691090_o.j\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Wishing you happy research, and all the best with your plans - cheers!!! team MTM :)&lt;\/p&gt;","Attachments":[],"Id":1897976,"PostDate":1433522035,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats on your engagement, Regina and Welcome to our forum community!!! It's chock-full of great ideas, suggestions and advice to help with your planning decisions <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Here are some visual sample comparasons of the resorts the ladies have already recommended .... to show you what kind of backdrop they'd make for your Wedding Day Photo Story......enjoy!!!<\/p>\n<p>\u00a0<\/p>\n<p>from the <a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10150951039939487.436910.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>G<\/a><a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10150951039939487.436910.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>rand Sirenis Riviera Maya Wedding Album<\/a>:<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xaf1\/t31.0-8\/338751_10150951048374487_246483711_o.jpg\" alt=\"338751_10150951048374487_246483711_o.jpg\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>from the <a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10152879942949487.1073741913.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>NOW Jade Wedding Album:<\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xap1\/t31.0-8\/10828083_10152879945629487_385058951217096100_o.jpg\" alt=\"10828083_10152879945629487_3850589512170\"><\/span><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xfa1\/t31.0-8\/10481829_10152879945984487_3218129313193200416_o.jpg\" alt=\"10481829_10152879945984487_3218129313193\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>from the <a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10151784774734487.1073741863.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>NOW Sapphire Wedding Album: <\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-ash2\/t31.0-8\/1149436_10151784776474487_1878076495_o.jpg\" alt=\"1149436_10151784776474487_1878076495_o.j\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-frc3\/t31.0-8\/1274839_10151784777424487_1492467888_o.jpg\" alt=\"1274839_10151784777424487_1492467888_o.j\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-prn2\/t31.0-8\/1097873_10151784780044487_1914691090_o.jpg\" alt=\"1097873_10151784780044487_1914691090_o.j\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>Wishing you happy research, and all the best with your plans - cheers!!! team MTM <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280210660,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"12.49.162.226","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79248,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1dafc82799809ce9b1c7b264458c4d8f","RawContent":"Congrats on your engagement! I would look at Karisma properties if food is important to you, they consider their food gourmet inclusive. Getting a good travel agent is also important. I booked Azul Fives for June 2016. If you need a TA I will be happy to refer mine.\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1897978,"PostDate":1433522914,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Congrats on your engagement! I would look at Karisma properties if food is important to you, they consider their food gourmet inclusive. Getting a good travel agent is also important. I booked Azul Fives for June 2016. If you need a TA I will be happy to refer mine.<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lovelifelivefab@gmail.com","IpAddress":"162.225.177.118","GroupId":39,"GroupName":"Newbie","JoinDate":1364494849,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-267909.jpg?_r=1433349488","PhotoWidth":79,"PhotoHeight":80,"PhotoType":"custom"},"FormattedName":"jswllms","Id":267909,"Name":"jswllms","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"199.85.228.129","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79248,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"fd562b917a882adfff6efde1e3cb2a0d","RawContent":"&lt;p&gt;Any of the Riu properties I would suggest. They have great wedding packages and very budget friendly! I&#039;m getting married at Riu Caribe next April. It&#039;s about 30 mins from Cancun airport.&lt;\/p&gt;\n&lt;p&gt;Congratulations on your engagement!!!&lt;\/p&gt;","Attachments":[],"Id":1897983,"PostDate":1433529027,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Any of the Riu properties I would suggest. They have great wedding packages and very budget friendly! I'm getting married at Riu Caribe next April. It's about 30 mins from Cancun airport.<\/p>\n<p>Congratulations on your engagement!!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"katie_mcbride48@yahoo.ca","IpAddress":"199.85.228.129","GroupId":39,"GroupName":"Newbie","JoinDate":1424114250,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282132.jpg?_r=1434408748","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"facebook"},"FormattedName":"KatieMcBride","Id":282132,"Name":"KatieMcBride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"100.33.96.77","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79248,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3f7a0cd923b32a54f8fa5e18c7468ef8","RawContent":"[quote name=\"mckievme\" post=\"1897973\" timestamp=\"1433521897\"]\nI second the vote for the Now Jade and the suggestion to look into the Wright Travel Agency for help. We got married at the Now Jade last month with the help of Babs V and Kelly Shiffman from WTA.  All of my guests loved it and had a great time. \n\nIt&#039;s very modern and there are 7 restaurants (italian, mediterranean, french, mexican, japanese, etc) that you can go to as many times as you want and don&#039;t require reservations. My grandmother had mobility issues and we thought she was accommodated very well. I think you just need to keep in mind your venue options - for examples we knew a wedding on the beach was definitely out so we chose to get married at the Pergola overlooking the beach (plus I&#039;m not a fan of sand!)[\/quote]I hope this is how you reply! I&#039;m new to this website lol! Now Jade seems very interesting and I don&#039;t want to get married on the sand either! Your wedding date was the date of my engagement! Do you have any pictures?? Thanks for the response\n[quote name=\"jswllms\" post=\"1897978\" timestamp=\"1433522914\"]\nCongrats on your engagement! I would look at Karisma properties if food is important to you, they consider their food gourmet inclusive. Getting a good travel agent is also important. I booked Azul Fives for June 2016. If you need a TA I will be happy to refer mine.\n\n\nSent from my iPhone using Tapatalk[\/quote]I love the Azul chain but as I&#039;m looking at dates on tripadvisor (just for an idea of nightly rate) - they seem all booked for every date I try to enter! (I&#039;m hoping to get married the weekend of April 7-12th, 2016).","Attachments":[],"Id":1897988,"PostDate":1433533754,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>mckievme, on 05 June 2015 - 08:31 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>I second the vote for the Now Jade and the suggestion to look into the Wright Travel Agency for help. We got married at the Now Jade last month with the help of Babs V and Kelly Shiffman from WTA. \u00a0All of my guests loved it and had a great time.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>It's very modern and there are 7 restaurants (italian, mediterranean, french, mexican, japanese, etc) that you can go to as many times as you want and don't require reservations. My grandmother had mobility issues and we thought she was accommodated very well. I think you just need to keep in mind your venue options - for examples we knew a wedding on the beach was definitely out so we chose to get married at the Pergola overlooking the beach (plus I'm not a fan of sand!)<\/p>\n<\/div>\n<\/div><\/div>\n<p>I hope this is how you reply! I'm new to this website lol! Now Jade seems very interesting and I don't want to get married on the sand either! Your wedding date was the date of my engagement! Do you have any pictures?? Thanks for the response<\/p><br \/><p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>jswllms, on 05 June 2015 - 08:48 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Congrats on your engagement! I would look at Karisma properties if food is important to you, they consider their food gourmet inclusive. Getting a good travel agent is also important. I booked Azul Fives for June 2016. If you need a TA I will be happy to refer mine.<br><br><br>\nSent from my iPhone using Tapatalk<\/p>\n<\/div>\n<\/div><\/div>\n<p>I love the Azul chain but as I'm looking at dates on tripadvisor (just for an idea of nightly rate) - they seem all booked for every date I try to enter! (I'm hoping to get married the weekend of April 7-12th, 2016).\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"reginakrachak@gmail.com","IpAddress":"100.33.96.77","GroupId":39,"GroupName":"Newbie","JoinDate":1433470231,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283386.jpg?_r=1433470594","PhotoWidth":200,"PhotoHeight":201,"PhotoType":"custom"},"FormattedName":"ReginaKay","Id":283386,"Name":"ReginaKay","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"96.54.109.9","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79248,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6524bd5be47e2c2d254af09a3dbc2a09","RawContent":"Check out the Now Jade forum on this site. Lots of photos there I&#039;m sure. Also search the site for previous Now Jade brides&#039; planning threads. I would echo the suggestions to talk to a destination wedding travel agent. They can help you identity resorts in your budget and with availability. There generally isn&#039;t any upfront cost, so you don&#039;t have anything to lose. \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1897994,"PostDate":1433551116,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Check out the Now Jade forum on this site. Lots of photos there I'm sure. Also search the site for previous Now Jade brides' planning threads. I would echo the suggestions to talk to a destination wedding travel agent. They can help you identity resorts in your budget and with availability. There generally isn't any upfront cost, so you don't have anything to lose. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>- Erin<\/p>\n<p>\u00a0<\/p>\n<p>My planning thread:\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268'>http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268<\/a>","Email":"ekjzwedding@gmail.com","IpAddress":"24.85.127.174","GroupId":40,"GroupName":"Jr. Member","JoinDate":1417449445,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281283.jpg?_r=1428779369","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"vancouverpetunia","Id":281283,"Name":"vancouverpetunia","IsOnline":false}}],"Id":"79248","Title":"Bride To Be ... April 2016","LastPostDate":1433993489},"Pages":{"TotalItems":19,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
