llspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;SophieInLove&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;girls have any of you used Julieta for makeup and hair?\n her before and after looks amazing.and prices too.\n are you all buying make up and hair for you and bridesmaids?\n I am scared to do it!&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;Who is Julieta and does she have a website with the before and after pics on it?","Attachments":[],"Id":1119815,"PostDate":1271718228,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>SophieInLove<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">girls have any of you used Julieta for makeup and hair?<br \/> her before and after looks amazing.and prices too.<br \/> are you all buying make up and hair for you and bridesmaids?<br \/> I am scared to do it!<\/div> <\/td> <\/tr> <\/table> <\/div>Who is Julieta and does she have a website with the before and after pics on it?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>SouthernSweetie<\/span><br><br><a data-ipb='nomediaparse' href=\"http:\/\/www.theweddingticker.com\/ticker\/31776.png\">http:\/\/www.theweddingticker.com\/ticker\/31776.png<\/a><\/div><\/div>","Email":"jean_hopson@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1259134133,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223520.JPG?_r=0","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"SouthernSweetie","Id":223520,"Name":"SouthernSweetie","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":43830,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"84dddb861d05afb5d9d350162250ffa3","RawContent":"I would LOVE to find someone in the Cancun area (preferably from MAC) to come to the resort to do my make-up. Believe it or not, I was considering flying in a MAC make-up artist from Atlanta. Buying a resort day pass beats the heck out of paying for a vacation for someone who I don&#039;t really know. Exception: the photographer - the photos are just too darn important!","Attachments":[],"Id":1119821,"PostDate":1271718390,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I would LOVE to find someone in the Cancun area (preferably from MAC) to come to the resort to do my make-up. Believe it or not, I was considering flying in a MAC make-up artist from Atlanta. Buying a resort day pass beats the heck out of paying for a vacation for someone who I don't really know. Exception: the photographer - the photos are just too darn important!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>SouthernSweetie<\/span><br><br><a data-ipb='nomediaparse' href=\"http:\/\/www.theweddingticker.com\/ticker\/31776.png\">http:\/\/www.theweddingticker.com\/ticker\/31776.png<\/a><\/div><\/div>","Email":"jean_hopson@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1259134133,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223520.JPG?_r=0","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"SouthernSweetie","Id":223520,"Name":"SouthernSweetie","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":43830,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"294fc9e2a0bff40383ec1ca3d642e5fe","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;Mere&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;I am doing my own make-up and possibly getting my hair done at the resort salon.&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;Me Too! \n \n I&#039;m going to do a few trials first to make sure the colours look ok in sunlight, take some test photos to see how it all shows up, and time how long it all takes to put on....maybe even go for a light jog to see how it all holds up to a bit of activity.","Attachments":[],"Id":1119936,"PostDate":1271720810,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>Mere<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">I am doing my own make-up and possibly getting my hair done at the resort salon.<\/div> <\/td> <\/tr> <\/table> <\/div>Me Too! <br \/> <br \/> I'm going to do a few trials first to make sure the colours look ok in sunlight, take some test photos to see how it all shows up, and time how long it all takes to put on....maybe even go for a light jog to see how it all holds up to a bit of activity.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"wongrose@gmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1264127439,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-224931.jpg?_r=0","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"rosieposie","Id":224931,"Name":"rosieposie","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":43830,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4d6a4e634cf03cd27c6ff397939cae4b","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;rosieposie&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Me Too! \n \n I&#039;m going to do a few trials first to make sure the colours look ok in sunlight, take some test photos to see how it all shows up, and time how long it all takes to put on....maybe even go for a light jog to see how it all holds up to a bit of activity.&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;\n This is a great idea!","Attachments":[],"Id":1120437,"PostDate":1271737724,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>rosieposie<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Me Too! <br \/> <br \/> I'm going to do a few trials first to make sure the colours look ok in sunlight, take some test photos to see how it all shows up, and time how long it all takes to put on....maybe even go for a light jog to see how it all holds up to a bit of activity.<\/div> <\/td> <\/tr> <\/table> <\/div><br \/> This is a great idea!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><strong><a data-ipb='nomediaparse' href=\"http:\/\/meredithandjedd.com\">My Planning Site<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/t\/wqxRY9P\/weight.png\">http:\/\/tickers.TickerFactory.com\/ezt...Y9P\/weight.png<\/a><br><br><\/strong><strong><a data-ipb='nomediaparse' href=\"http:\/\/img.weddingcountdown.com\/ticker\/jk46iybq93.png\">http:\/\/img.weddingcountdown.com\/ticker\/jk46iybq93.png<\/a><\/strong><\/div><\/div>","Email":"meredithhaley@hotmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1264190210,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-224948.gif?_r=0","PhotoWidth":73,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Mere","Id":224948,"Name":"Mere","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":43830,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"29d1ec0e052fd80bb8c2d9c34e498335","RawContent":"Here is from an original post that I did- I loved loved my make-up artist. People raved all day long about my make-up.. and that is coming from big city (LA and SF) girls with pretty high expectations:)! You can find a full review of him and see my pictures from my original wedding review. But he was the best!!!!! I wish that he was more widely known on this forum.. a true and rare gem! I&#039;m sure you could find him through a request from your resort or the YazminGonzalez website. The website is in spanish but I believe there is a way to send an email or request on the website (my wedding coordinator had set it up for me). Their website is &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.yazmingonzalez.com.mx\/\"&gt;Yazm\u00adn Gonz\u00a1lez&lt;\/a&gt;\n \n I have to give a HUGE shout-out to the hair and make-up artist that I used for my wedding, Sergio from Yazmin Gonzalez. He was the best find!!!! I even had paid for a trial run the day I flew in- it was completely not needed but helped my piece of mind. I believe that for the trial run plus the day of the wedding it was 330 total. He came to the hotel for both days, took so much time to make sure it was exactly what I wanted and the day of the wedding everyone RAVED about how fabulous my hair and make-up turned out. If you have any questions please let me know...but thumbs up all around for Sergio.","Attachments":[],"Id":1121180,"PostDate":1271791499,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Here is from an original post that I did- I loved loved my make-up artist. People raved all day long about my make-up.. and that is coming from big city (LA and SF) girls with pretty high expectations:)! You can find a full review of him and see my pictures from my original wedding review. But he was the best!!!!! I wish that he was more widely known on this forum.. a true and rare gem! I'm sure you could find him through a request from your resort or the YazminGonzalez website. The website is in spanish but I believe there is a way to send an email or request on the website (my wedding coordinator had set it up for me). Their website is <a href='http:\/\/www.yazmingonzalez.com.mx\/' class='bbc_url' title='External link' rel='nofollow external'>Yazm\u00adn Gonz\u00a1lez<\/a><br \/> <br \/> I have to give a HUGE shout-out to the hair and make-up artist that I used for my wedding, Sergio from Yazmin Gonzalez. He was the best find!!!! I even had paid for a trial run the day I flew in- it was completely not needed but helped my piece of mind. I believe that for the trial run plus the day of the wedding it was 330 total. He came to the hotel for both days, took so much time to make sure it was exactly what I wanted and the day of the wedding everyone RAVED about how fabulous my hair and make-up turned out. If you have any questions please let me know...but thumbs up all around for Sergio.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ccarmany23@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1196139640,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207984.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"ccarmany23","Id":207984,"Name":"ccarmany23","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":43830,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"540e9051c932efeaba7faf737a1b6a19","RawContent":"Lots of helpful stuff :-)","Attachments":[],"Id":1131197,"PostDate":1272439386,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Lots of helpful stuff :-)\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/www.whenismywedding.com\/signature\/e8ece990426edcc4.gif\">http:\/\/www.whenismywedding.com\/signa...90426edcc4.gif<\/a><br><br><span>Us + 5 Kids + 34 Adults = 41 Booked<\/span><\/div><\/div>","Email":"spoodyhead@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1267767973,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-226172.gif?_r=0","PhotoWidth":100,"PhotoHeight":88,"PhotoType":"custom"},"FormattedName":"FutureMrsRobart","Id":226172,"Name":"FutureMrsRobart","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":43830,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"49e8b0156071e6d4607c74aef732b83b","RawContent":"&lt;p&gt; NaM, I just hired Fernando for my makeup and hair for my April 2011 wedding in Cancun.&amp;nbsp; Just watched your wedding phots from DelSol, I have to say you were one of the most beautiful brides.&amp;nbsp; Your photographers did a great job, I only hope my wedding is 1\/2 as beautiful as yours was.&amp;nbsp; Thanks for sharing&lt;\/p&gt;","Attachments":[],"Id":1338006,"PostDate":1289533506,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> NaM, I just hired Fernando for my makeup and hair for my April 2011 wedding in Cancun.\u00a0 Just watched your wedding phots from DelSol, I have to say you were one of the most beautiful brides.\u00a0 Your photographers did a great job, I only hope my wedding is 1\/2 as beautiful as yours was.\u00a0 Thanks for sharing<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"maur411@aol.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1270536413,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-227084.JPG?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Maur","Id":227084,"Name":"Maur","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":43830,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"db46f19f746fe471e8b9cfcdc57d960c","RawContent":"&lt;p&gt; \n Hi!&amp;nbsp;\n &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I am going to look into him.&amp;nbsp; Would you mind&amp;nbsp;sending me&amp;nbsp;some photos from your wedding so I can see his work?&amp;nbsp; My email is &lt;img alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" style=\"border-right: 0px solid; border-top: 0px solid; border-left: 0px solid; border-bottom: 0px solid\" \/&gt;\n \n Here is from an original post that I did- I loved loved my make-up artist. People raved all day long about my make-up.. and that is coming from big city (LA and SF) girls with pretty high expectations:)! You can find a full review of him and see my pictures from my original wedding review. But he was the best!!!!! I wish that he was more widely known on this forum.. a true and rare gem! I&#039;m sure you could find him through a request from your resort or the YazminGonzalez website. The website is in spanish but I believe there is a way to send an email or request on the website (my wedding coordinator had set it up for me). Their website is &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.yazmingonzalez.com.mx\/\"&gt;Yazm\u00adn Gonz\u00a1lez&lt;\/a&gt;\n \n I have to give a HUGE shout-out to the hair and make-up artist that I used for my wedding, Sergio from Yazmin Gonzalez. He was the best find!!!! I even had paid for a trial run the day I flew in- it was completely not needed but helped my piece of mind. I believe that for the trial run plus the day of the wedding it was 330 total. He came to the hotel for both days, took so much time to make sure it was exactly what I wanted and the day of the wedding everyone RAVED about how fabulous my hair and make-up turned out. If you have any questions please let me know...but thumbs up all around for Sergio.&lt;\/blockquote&gt; \n \n","Attachments":[],"Id":1403790,"PostDate":1298430240,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <br \/> Hi!\u00a0<br \/> \u00a0<\/p> <p> I am going to look into him.\u00a0 Would you mind\u00a0sending me\u00a0some photos from your wedding so I can see his work?\u00a0 My email is <span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" style=\"border-right: 0px solid; border-top: 0px solid; border-left: 0px solid; border-bottom: 0px solid\" \/><\/span><br \/> <br \/> Here is from an original post that I did- I loved loved my make-up artist. People raved all day long about my make-up.. and that is coming from big city (LA and SF) girls with pretty high expectations:)! You can find a full review of him and see my pictures from my original wedding review. But he was the best!!!!! I wish that he was more widely known on this forum.. a true and rare gem! I'm sure you could find him through a request from your resort or the YazminGonzalez website. The website is in spanish but I believe there is a way to send an email or request on the website (my wedding coordinator had set it up for me). Their website is <a href='http:\/\/www.yazmingonzalez.com.mx\/' class='bbc_url' title='External link' rel='nofollow external'>Yazm\u00adn Gonz\u00a1lez<\/a><br \/> <br \/> I have to give a HUGE shout-out to the hair and make-up artist that I used for my wedding, Sergio from Yazmin Gonzalez. He was the best find!!!! I even had paid for a trial run the day I flew in- it was completely not needed but helped my piece of mind. I believe that for the trial run plus the day of the wedding it was 330 total. He came to the hotel for both days, took so much time to make sure it was exactly what I wanted and the day of the wedding everyone RAVED about how fabulous my hair and make-up turned out. If you have any questions please let me know...but thumbs up all around for Sergio.<\/blockquote> <br \/> <br \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"melissafaybik@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1277111471,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-229376.jpg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"melfaybik","Id":229376,"Name":"melfaybik","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":43830,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"75457c5f7a8469d18a8beface05b8eb2","RawContent":"&lt;p&gt; Im just wondering if any one has heard of Krystie Ann or has her booked for makeup and hair?&lt;\/p&gt; &lt;p&gt; I am booking her for mine and just looking for feedback&lt;\/p&gt;","Attachments":[],"Id":1509770,"PostDate":1314126051,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Im just wondering if any one has heard of Krystie Ann or has her booked for makeup and hair?<\/p> <p> I am booking her for mine and just looking for feedback<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"TashFrankwedding@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1314124592,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-244297.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"TashnFrank","Id":244297,"Name":"TashnFrank","IsOnline":false}}],"Id":"43830","Title":"Makeup Artist-Mexico","LastPostDate":1314126051},"Pages":{"TotalItems":20,"TotalPages":2,"CurrentPage":10,"NextPage":-1,"PreviousPage":0,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
