{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":1,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":121,"MovedTo":null,"MovedOn":0,"FirstPostId":1593917,"Rating":0,"RatingHits":0,"Starter":{"Id":252656,"Name":"amyliz","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1331617675,"LastPoster":{"Id":252656,"Name":"amyliz","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":67,"Preview":{"Id":1593917,"PostDate":1331617675,"PostContent":"\u00a0  \u00a0  For all you ladies who worry about what can be planned in a short time and\/or with a very...","Author":{"Signature":"","Email":"amyliz2008@hotmail.com","IpAddress":"","GroupId":5,"GroupName":"Banned","JoinDate":1331611318,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"amyliz","Id":252656,"Name":"amyliz","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":false,"TopicId":66385,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f76acba0d51ddfa8b8dcfd1f01b26707","RawContent":"&lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p align=\"left\"&gt; &amp;nbsp;&lt;\/p&gt; &lt;p align=\"left\"&gt; &lt;span style=\"color:#555555;\"&gt;&lt;span style=\"font-family:verdana,sans-serif;\"&gt;&lt;span style=\"font-size:10.0pt;\"&gt;For all you ladies who worry about what can be planned in a short time and\/or with a very tight budget, I have to share my mazing $1500 wedding that I planned in less then a month!   &lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p align=\"left\" style=\"margin-left:30pt;\"&gt; &lt;span style=\"color:#555555;\"&gt;&lt;span style=\"font-family:verdana,sans-serif;\"&gt;&lt;span style=\"font-size:10.0pt;\"&gt;1.  &amp;nbsp; &lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;span style=\"color:#555555;\"&gt;&lt;span style=\"font-family:verdana,sans-serif;\"&gt;&lt;span style=\"font-size:10.0pt;\"&gt;The wedding was held in my in-laws backyard which is HUGE and beautiful. &amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p align=\"left\" style=\"margin-left:30pt;\"&gt; &lt;span style=\"color:#555555;\"&gt;&lt;span style=\"font-family:verdana,sans-serif;\"&gt;&lt;span style=\"font-size:10.0pt;\"&gt;2.  &amp;nbsp; &lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;span style=\"color:#555555;\"&gt;&lt;span style=\"font-family:verdana,sans-serif;\"&gt;&lt;span style=\"font-size:10.0pt;\"&gt;My FIL prepared all the food (which was very good!)&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p align=\"left\" style=\"margin-left:30pt;\"&gt; &lt;span style=\"color:#555555;\"&gt;&lt;span style=\"font-family:verdana,sans-serif;\"&gt;&lt;span style=\"font-size:10.0pt;\"&gt;3.  &amp;nbsp; &lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;span style=\"color:#555555;\"&gt;&lt;span style=\"font-family:verdana,sans-serif;\"&gt;&lt;span style=\"font-size:10.0pt;\"&gt;I had a friend of the family (and as it turned out - me) taking pictures for them for free&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p align=\"left\" style=\"margin-left:30pt;\"&gt; &lt;span style=\"color:#555555;\"&gt;&lt;span style=\"font-family:verdana,sans-serif;\"&gt;&lt;span style=\"font-size:10.0pt;\"&gt;4.  &amp;nbsp; &lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;span style=\"color:#555555;\"&gt;&lt;span style=\"font-family:verdana,sans-serif;\"&gt;&lt;span style=\"font-size:10.0pt;\"&gt;My brother video-taped the ceremony and parts of the reception.&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p align=\"left\" style=\"margin-left:30pt;\"&gt; &lt;span style=\"color:#555555;\"&gt;&lt;span style=\"font-family:verdana,sans-serif;\"&gt;&lt;span style=\"font-size:10.0pt;\"&gt;5.  &amp;nbsp; &lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;span style=\"color:#555555;\"&gt;&lt;span style=\"font-family:verdana,sans-serif;\"&gt;&lt;span style=\"font-size:10.0pt;\"&gt;The officiant was the best friend of the groom and I believe did the wedding for free.&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p align=\"left\" style=\"margin-left:30pt;\"&gt; &lt;span style=\"color:#555555;\"&gt;&lt;span style=\"font-family:verdana,sans-serif;\"&gt;&lt;span style=\"font-size:10.0pt;\"&gt;6.  &amp;nbsp; &lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;span style=\"color:#555555;\"&gt;&lt;span style=\"font-family:verdana,sans-serif;\"&gt;&lt;span style=\"font-size:10.0pt;\"&gt;Many of the decorations were lent or given to them for free - the rest were purchased at Goodwill.&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p align=\"left\" style=\"margin-left:30pt;\"&gt; &lt;span style=\"color:#555555;\"&gt;&lt;span style=\"font-family:verdana,sans-serif;\"&gt;&lt;span style=\"font-size:10.0pt;\"&gt;7.  &amp;nbsp; &lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;span style=\"color:#555555;\"&gt;&lt;span style=\"font-family:verdana,sans-serif;\"&gt;&lt;span style=\"font-size:10.0pt;\"&gt;The important thing is the dress which was purchased on foreverweddinggown.com. It is a good site and I was satisfied with their service. They helped me save a large of money.&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p align=\"left\" style=\"margin-left:30pt;\"&gt; &amp;nbsp;&lt;\/p&gt; &lt;p align=\"left\"&gt; &lt;span style=\"color:#555555;\"&gt;&lt;span style=\"font-family:verdana,sans-serif;\"&gt;&lt;span style=\"font-size:10.0pt;\"&gt;Those are the things that I heard about. &amp;nbsp;That said, my wedding was GORGEOUS! I was so happy.I love taking pictures, and of course being recently married, I was excited to take some pictures and enjoy the wedding. So with that said, here are my favorite (mostly non-facial) pictures from the day:&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;img alt=\"two.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/758794\/width\/266\/height\/349\" \/&gt;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"three.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/758796\/width\/348\/height\/261\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"ten.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/758798\/width\/264\/height\/350\" \/&gt;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"six.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/758800\/width\/447\/height\/668\" \/&gt;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"one.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/758802\/width\/350\/height\/526\" \/&gt;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"nine.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/758804\/width\/263\/height\/351\" \/&gt;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"four.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/758806\/width\/265\/height\/621\" \/&gt;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"eight.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/758808\/width\/264\/height\/350\" \/&gt;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"12.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/758810\/width\/263\/height\/352\" \/&gt;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"11.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/758812\/width\/262\/height\/341\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1593917,"PostDate":1331617675,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> \u00a0<\/p> <p align=\"left\"> \u00a0<\/p> <p align=\"left\"> <span  style=\"color:#555555\"><span  style=\"font-family:verdana,sans-serif\"><span  style=\"font-size:10.0pt\">For all you ladies who worry about what can be planned in a short time and\/or with a very tight budget, I have to share my mazing $1500 wedding that I planned in less then a month! \u00a0\u00a0<\/span><\/span><\/span><\/p> <p align=\"left\"  style=\"margin-left:30pt\"> <span  style=\"color:#555555\"><span  style=\"font-family:verdana,sans-serif\"><span  style=\"font-size:10.0pt\">1.\u00a0\u00a0\u00a0 <\/span><\/span><\/span><span  style=\"color:#555555\"><span  style=\"font-family:verdana,sans-serif\"><span  style=\"font-size:10.0pt\">The wedding was held in my in-laws backyard which is HUGE and beautiful. \u00a0<\/span><\/span><\/span><\/p> <p align=\"left\"  style=\"margin-left:30pt\"> <span  style=\"color:#555555\"><span  style=\"font-family:verdana,sans-serif\"><span  style=\"font-size:10.0pt\">2.\u00a0\u00a0\u00a0 <\/span><\/span><\/span><span  style=\"color:#555555\"><span  style=\"font-family:verdana,sans-serif\"><span  style=\"font-size:10.0pt\">My FIL prepared all the food (which was very good!)<\/span><\/span><\/span><\/p> <p align=\"left\"  style=\"margin-left:30pt\"> <span  style=\"color:#555555\"><span  style=\"font-family:verdana,sans-serif\"><span  style=\"font-size:10.0pt\">3.\u00a0\u00a0\u00a0 <\/span><\/span><\/span><span  style=\"color:#555555\"><span  style=\"font-family:verdana,sans-serif\"><span  style=\"font-size:10.0pt\">I had a friend of the family (and as it turned out - me) taking pictures for them for free<\/span><\/span><\/span><\/p> <p align=\"left\"  style=\"margin-left:30pt\"> <span  style=\"color:#555555\"><span  style=\"font-family:verdana,sans-serif\"><span  style=\"font-size:10.0pt\">4.\u00a0\u00a0\u00a0 <\/span><\/span><\/span><span  style=\"color:#555555\"><span  style=\"font-family:verdana,sans-serif\"><span  style=\"font-size:10.0pt\">My brother video-taped the ceremony and parts of the reception.<\/span><\/span><\/span><\/p> <p align=\"left\"  style=\"margin-left:30pt\"> <span  style=\"color:#555555\"><span  style=\"font-family:verdana,sans-serif\"><span  style=\"font-size:10.0pt\">5.\u00a0\u00a0\u00a0 <\/span><\/span><\/span><span  style=\"color:#555555\"><span  style=\"font-family:verdana,sans-serif\"><span  style=\"font-size:10.0pt\">The officiant was the best friend of the groom and I believe did the wedding for free.<\/span><\/span><\/span><\/p> <p align=\"left\"  style=\"margin-left:30pt\"> <span  style=\"color:#555555\"><span  style=\"font-family:verdana,sans-serif\"><span  style=\"font-size:10.0pt\">6.\u00a0\u00a0\u00a0 <\/span><\/span><\/span><span  style=\"color:#555555\"><span  style=\"font-family:verdana,sans-serif\"><span  style=\"font-size:10.0pt\">Many of the decorations were lent or given to them for free - the rest were purchased at Goodwill.<\/span><\/span><\/span><\/p> <p align=\"left\"  style=\"margin-left:30pt\"> <span  style=\"color:#555555\"><span  style=\"font-family:verdana,sans-serif\"><span  style=\"font-size:10.0pt\">7.\u00a0\u00a0\u00a0 <\/span><\/span><\/span><span  style=\"color:#555555\"><span  style=\"font-family:verdana,sans-serif\"><span  style=\"font-size:10.0pt\">The important thing is the dress which was purchased on foreverweddinggown.com. It is a good site and I was satisfied with their service. They helped me save a large of money.<\/span><\/span><\/span><\/p> <p align=\"left\"  style=\"margin-left:30pt\"> \u00a0<\/p> <p align=\"left\"> <span  style=\"color:#555555\"><span  style=\"font-family:verdana,sans-serif\"><span  style=\"font-size:10.0pt\">Those are the things that I heard about. \u00a0That said, my wedding was GORGEOUS! I was so happy.I love taking pictures, and of course being recently married, I was excited to take some pictures and enjoy the wedding. So with that said, here are my favorite (mostly non-facial) pictures from the day:<\/span><\/span><\/span><\/p> <p> \u00a0<span rel='lightbox'><img class='bbc_img' alt=\"two.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/758794\/width\/266\/height\/349\" \/><\/span><\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"three.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/758796\/width\/348\/height\/261\" \/><\/span><\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"ten.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/758798\/width\/264\/height\/350\" \/><\/span><\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"six.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/758800\/width\/447\/height\/668\" \/><\/span><\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"one.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/758802\/width\/350\/height\/526\" \/><\/span><\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"nine.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/758804\/width\/263\/height\/351\" \/><\/span><\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"four.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/758806\/width\/265\/height\/621\" \/><\/span><\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"eight.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/758808\/width\/264\/height\/350\" \/><\/span><\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"12.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/758810\/width\/263\/height\/352\" \/><\/span><\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"11.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/758812\/width\/262\/height\/341\" \/><\/span><\/p> <p> \u00a0<\/p> <p> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"amyliz2008@hotmail.com","IpAddress":"","GroupId":5,"GroupName":"Banned","JoinDate":1331611318,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"amyliz","Id":252656,"Name":"amyliz","IsOnline":false}}],"Id":"66385","Title":"AW: My $1500 wedding! ","LastPostDate":1331617675},"Pages":{"TotalItems":1,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
