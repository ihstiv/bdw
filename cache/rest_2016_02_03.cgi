se,"PostKey":"9215eecf664a27ad0ce4a1570715a7cc","RawContent":"&lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/bestdestinationwedding.com\/forum\/t2213\"&gt;http:\/\/bestdestinationwedding.com\/forum\/t2213&lt;\/a&gt;\n \n this question has come up several times. The suggestion is usually to not use them. They can&#039;t do anything any other TA can do for you.","Attachments":[],"Id":185290,"PostDate":1202095643,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <a href='http:\/\/bestdestinationwedding.com\/forum\/t2213' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/bestdestinati...com\/forum\/t2213<\/a><br \/> <br \/> this question has come up several times. The suggestion is usually to not use them. They can't do anything any other TA can do for you.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"morganleigh03@yahoo.com","IpAddress":"75.177.182.183","GroupId":46,"GroupName":"VIP Member","JoinDate":1182664980,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"rodent","Id":207489,"Name":"rodent","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":10900,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f4bc5b73b444965a67f659a120990173","RawContent":"&lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/bestdestinationwedding.com\/forum\/t13171\"&gt;http:\/\/bestdestinationwedding.com\/forum\/t13171&lt;\/a&gt;\n \n Here is another. Please use the search tool to see if you question has already been answered before posting something. We are all working hard to reduce the number of repetitive posts on this forum.","Attachments":[],"Id":185291,"PostDate":1202095778,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <a href='http:\/\/bestdestinationwedding.com\/forum\/t13171' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/bestdestinati...om\/forum\/t13171<\/a><br \/> <br \/> Here is another. Please use the search tool to see if you question has already been answered before posting something. We are all working hard to reduce the number of repetitive posts on this forum.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"morganleigh03@yahoo.com","IpAddress":"75.177.182.183","GroupId":46,"GroupName":"VIP Member","JoinDate":1182664980,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"rodent","Id":207489,"Name":"rodent","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":10900,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fb4e744ee928a7d6238c9f31ca4e43c3","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;Rhonda&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Just wondering if anyone has anyone heard of\/used &amp;quot;destinationweddings.com&amp;quot;&lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/huh.gif\" border=\"0\" alt=\"\" title=\"Huh\" class=\"inlineimg\" \/&gt; \n It is a company that does travel\/hotel packages for you and your guests. \n Is anyone here familiar with this company? \n If so, please share any information\/thoughts....\n Thanks!!!&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;I am currently using them for my wedding....i have been dealing with them since June 07 and i haven&#039;t had a problem yet. My guests are also using them.","Attachments":[],"Id":185294,"PostDate":1202095857,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>Rhonda<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Just wondering if anyone has anyone heard of\/used \"destinationweddings.com\"<span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/huh.gif\" border=\"0\" alt=\"\" title=\"Huh\" class=\"inlineimg\" \/><\/span> <br \/> It is a company that does travel\/hotel packages for you and your guests. <br \/> Is anyone here familiar with this company? <br \/> If so, please share any information\/thoughts....<br \/> Thanks!!!<\/div> <\/td> <\/tr> <\/table> <\/div>I am currently using them for my wedding....i have been dealing with them since June 07 and i haven't had a problem yet. My guests are also using them.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10743;2\/st\/20080808\/e\/Our+Wedding\/k\/20de\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...20de\/event.png<\/a><\/div><\/div>","Email":"dimples3781@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1201211154,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208345.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"SDRBRIDE08","Id":208345,"Name":"SDRBRIDE08","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":10900,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ae1bb3c1624d563784015a5081883b66","RawContent":"There are a few thread on here (as posted above) that talk about this issue. The general consensus was not to use them, but there are a few people who do and are happy with them. I hired and fired them, so my personal opinion is to use a TA that has experience with DW&#039;s. There are a few on this board as well as the host.","Attachments":[],"Id":185297,"PostDate":1202096003,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                There are a few thread on here (as posted above) that talk about this issue. The general consensus was not to use them, but there are a few people who do and are happy with them. I hired and fired them, so my personal opinion is to use a TA that has experience with DW's. There are a few on this board as well as the host.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"carlydorazio@gmail.com","IpAddress":"72.92.56.95","GroupId":46,"GroupName":"VIP Member","JoinDate":1177548900,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207375.jpg?_r=1414982962","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"boscobel","Id":207375,"Name":"boscobel","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":10900,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"eecf65bf4fdd699b02a9d349decefd47","RawContent":"Ok, Sorry! I&#039;m new here and wasn&#039;t aware of the previous conversations. Thanks for your help! It is definitely helpful!!!","Attachments":[],"Id":185335,"PostDate":1202097595,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Ok, Sorry! I'm new here and wasn't aware of the previous conversations. Thanks for your help! It is definitely helpful!!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rweidelman@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1201939261,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208442.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Rhonda","Id":208442,"Name":"Rhonda","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":10900,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"93065901a1fa0209a08dbee8c9db576b","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;Rhonda&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Ok, Sorry! I&#039;m new here and wasn&#039;t aware of the previous conversations. Thanks for your help! It is definitely helpful!!!&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;No problem :) This forum is great &amp;amp; you should find all you need to plan your wedding. Welcome!","Attachments":[],"Id":185343,"PostDate":1202098276,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>Rhonda<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Ok, Sorry! I'm new here and wasn't aware of the previous conversations. Thanks for your help! It is definitely helpful!!!<\/div> <\/td> <\/tr> <\/table> <\/div>No problem <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> This forum is great & you should find all you need to plan your wedding. Welcome!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"morganleigh03@yahoo.com","IpAddress":"75.177.182.183","GroupId":46,"GroupName":"VIP Member","JoinDate":1182664980,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"rodent","Id":207489,"Name":"rodent","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":10900,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"80eb2d0b1ec2f2f89e980ad7f7b6c979","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;Rhonda&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Ok, Sorry! I&#039;m new here and wasn&#039;t aware of the previous conversations. Thanks for your help! It is definitely helpful!!!&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;Hi Rhonda - welcome to the forum -please take some time to read throught this thread &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/bestdestinationwedding.com\/forum\/t14777\"&gt;http:\/\/bestdestinationwedding.com\/forum\/t14777&lt;\/a&gt; this should help you navigate!\n \n Good Luck!","Attachments":[],"Id":185448,"PostDate":1202106695,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>Rhonda<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Ok, Sorry! I'm new here and wasn't aware of the previous conversations. Thanks for your help! It is definitely helpful!!!<\/div> <\/td> <\/tr> <\/table> <\/div>Hi Rhonda - welcome to the forum -please take some time to read throught this thread <a href='http:\/\/bestdestinationwedding.com\/forum\/t14777' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/bestdestinati...om\/forum\/t14777<\/a> this should help you navigate!<br \/> <br \/> Good Luck!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"alyssa.brantley@gmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1182310260,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207483.gif?_r=0","PhotoWidth":100,"PhotoHeight":67,"PhotoType":"custom"},"FormattedName":"Alyssa","Id":207483,"Name":"Alyssa","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":10900,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"1495c9bfb9974a0909e67be03fa7a95a","RawContent":"-- I did a search for this and couldn&#039;t find the threads so I just thought I&#039;d post another one --\n \n I looked into using them for my wedding in Mexico since two other friends of mine were using them, one getting married in Hawaii and one in the DR. We didn&#039;t end up going to either friends wedding because they were just months apart from ours.\n \n I didn&#039;t use DestinationWeddings.com because we didn&#039;t get any good quotes from them and the TA wasn&#039;t too helpful so I scratched them off the list completely.\n \n I&#039;m posting this because my friends just got back from the DR wedding and had a terrible experience with DestinationWeddings.com.\n \n Their first TA, Eileen, mistakenly booked their guests with a different wedding and also double charged some people&#039;s credit cards. So they asked for another TA @ DestinationWeddings.com after that disaster. Their second TA, Debbie Ryan, accidentally booked 1\/4 of their guests at a different and less nice resort 40 minutes away! My friend said, they were walking around this terrible resort looking for the bride and groom. Luckily, his cellphone was working and he contacted the groom. \n \n Debbie wasn&#039;t able to do anything until the next day, something about faxing vouchers to the correct resort and redoing the transportation. Basically, fixing the mess because more guests were arriving the next day and heading to the wrong place. AND after all was said and done, one guest still wasn&#039;t able to switch! It would be different if the resorts were close by or even just short cab ride away but 40 minutes?\n \n As you can imagine the bride was so upset and her mother was LIVID.\n \n She is not on this forum so I thought I should share this with everyone. I know some of you have had wonderful experiences with DestinationWeddings.com but I&#039;m thinking that they are just not consistent. Maybe they are random agents not all having the same expertise or adequate training?\n \n I just hope none of you or your guest have to go through this.","Attachments":[],"Id":318513,"PostDate":1211956264,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                -- I did a search for this and couldn't find the threads so I just thought I'd post another one --<br \/> <br \/> I looked into using them for my wedding in Mexico since two other friends of mine were using them, one getting married in Hawaii and one in the DR. We didn't end up going to either friends wedding because they were just months apart from ours.<br \/> <br \/> I didn't use DestinationWeddings.com because we didn't get any good quotes from them and the TA wasn't too helpful so I scratched them off the list completely.<br \/> <br \/> I'm posting this because my friends just got back from the DR wedding and had a terrible experience with DestinationWeddings.com.<br \/> <br \/> Their first TA, Eileen, mistakenly booked their guests with a different wedding and also double charged some people's credit cards. So they asked for another TA @ DestinationWeddings.com after that disaster. Their second TA, Debbie Ryan, accidentally booked 1\/4 of their guests at a different and less nice resort 40 minutes away! My friend said, they were walking around this terrible resort looking for the bride and groom. Luckily, his cellphone was working and he contacted the groom. <br \/> <br \/> Debbie wasn't able to do anything until the next day, something about faxing vouchers to the correct resort and redoing the transportation. Basically, fixing the mess because more guests were arriving the next day and heading to the wrong place. AND after all was said and done, one guest still wasn't able to switch! It would be different if the resorts were close by or even just short cab ride away but 40 minutes?<br \/> <br \/> As you can imagine the bride was so upset and her mother was LIVID.<br \/> <br \/> She is not on this forum so I thought I should share this with everyone. I know some of you have had wonderful experiences with DestinationWeddings.com but I'm thinking that they are just not consistent. Maybe they are random agents not all having the same expertise or adequate training?<br \/> <br \/> I just hope none of you or your guest have to go through this.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tanyamaynigo@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1204702359,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208722.gif?_r=0","PhotoWidth":73,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"antonia321","Id":208722,"Name":"antonia321","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":10900,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e1fe2bb30fe4de9842bc53fae59d619b","RawContent":"Thanks for the warning!","Attachments":[],"Id":318811,"PostDate":1211996690,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks for the warning!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/www.whenismywedding.com\/signature\/8828a3939bc973e9.gif\">http:\/\/www.whenismywedding.com\/signa...939bc973e9.gif<\/a><\/div><\/div>","Email":"kellywinter1@comcast.net","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1208805709,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209152.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"kellywinter1","Id":209152,"Name":"kellywinter1","IsOnline":false}}],"Id":"10900","Title":"DestinationWeddings.com * Post all experiences, info and questions here! *","LastPostDate":1365450223},"Pages":{"TotalItems":209,"TotalPages":21,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":200},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
