<\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jessicaandcurtis@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1345555503,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-259435.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"somethingblue77","Id":259435,"Name":"somethingblue77","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":69230,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"42e3ff5b3139570a16b43e9a622cc792","RawContent":"&lt;p&gt; Hi brides! I received my dress from DressilyMe yesterday! It came in a small Fedex package. I was a bit surprised that in this small box contains my dress. But it did. I love it and it fits perfectly! ....Well I had to try it on secretly as my FI and I live in a small condo. He was on the couch so I didn&#039;t want him to see it and I also didn&#039;t want the dog to potentially tear my train. My wedding is not till June 2013 so I have 9 months to get in better shape! Although the dress fits perfectly now..&lt;\/p&gt;","Attachments":[],"Id":1669428,"PostDate":1349193831,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hi brides! I received my dress from DressilyMe yesterday! It came in a small Fedex package. I was a bit surprised that in this small box contains my dress. But it did. I love it and it fits perfectly! ....Well I had to try it on secretly as my FI and I live in a small condo. He was on the couch so I didn't want him to see it and I also didn't want the dog to potentially tear my train. My wedding is not till June 2013 so I have 9 months to get in better shape! Although the dress fits perfectly now..<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jessicaandcurtis@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1345555503,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-259435.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"somethingblue77","Id":259435,"Name":"somethingblue77","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":69230,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1051c4e24e2112f8bd187c8261c7e0d8","RawContent":"Would love to see some pics!","Attachments":[],"Id":1669430,"PostDate":1349194079,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Would love to see some pics!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Enjoythepartykm@aol.com","IpAddress":"68.13.213.79","GroupId":3,"GroupName":"Member","JoinDate":1343393580,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-258455.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Tulumbride2013","Id":258455,"Name":"Tulumbride2013","IsOnline":false}}],"Id":"69230","Title":"Dresses from Dressilyme","LastPostDate":1453710170},"Pages":{"TotalItems":36,"TotalPages":4,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":30},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
