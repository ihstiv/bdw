{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f5a5239596293e5a20885b707fbb94e7","RawContent":"Thanks Lauren. I talked to Nayeli and I do have other options so hopefully it will still look pretty! She said I can do bamboo sticks at $75ea.\n \n Mesita","Attachments":[],"Id":601562,"PostDate":1235429751,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks Lauren. I talked to Nayeli and I do have other options so hopefully it will still look pretty! She said I can do bamboo sticks at $75ea.<br \/> <br \/> Mesita\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Mesita and Durante<\/span><br><span>June 18, 2009<\/span><br><span>Excellence Playa Mujeres<\/span><br><br><span>My wedding review:<\/span><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t45032#post857892\">http:\/\/bestdestinationwedding.com\/fo...032#post857892<\/a><span>My wedding pro slideshow:<\/span><a data-ipb='nomediaparse' href=\"http:\/\/www.keithcephus.com\/mesita\">http:\/\/www.keithcephus.com\/mesita<\/a><a data-ipb='nomediaparse' href=\"http:\/\/www.ezticker.com\/ticker\/947\/192\/20090618\/Our+Swine+Flu+Free+Wedding%21\/ticker.png\">http:\/\/www.ezticker.com\/ticker\/947\/1...%21\/ticker.png<\/a><\/div><\/div>","Email":"mesita.simms@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1221110745,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211672.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Sensatori Bride","Id":211672,"Name":"Sensatori Bride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f3bc31f9a935c69880a5da84e851cf83","RawContent":"Ladies, \n \n Do you know if the resort accepts shipments on behalf of upcoming guests? We&#039;re flying Continental and they charge you for all the luggage you check. That being said, I would really rather not bring an extra suitcase full of wedding stuff.\n \n Thanks in advance.","Attachments":[],"Id":602008,"PostDate":1235453324,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Ladies, <br \/> <br \/> Do you know if the resort accepts shipments on behalf of upcoming guests? We're flying Continental and they charge you for all the luggage you check. That being said, I would really rather not bring an extra suitcase full of wedding stuff.<br \/> <br \/> Thanks in advance.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i30.photobucket.com\/albums\/c336\/dmbstolio\/Dec122009238-1.jpg\">http:\/\/i30.photobucket.com\/albums\/c3...22009238-1.jpg<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/www.jenandken2009.com\">www.jenandken2009.com<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;130\/st\/20091212\/e\/Jen+%26amp%3B+Kenny%27s+wedding\/k\/02c3\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...02c3\/event.png<\/a><\/div><\/div>","Email":"davis1974@gmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1215061237,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-210302.gif?_r=0","PhotoWidth":98,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Jennifer Davis","Id":210302,"Name":"Jennifer Davis","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cb4dd19503c5a6c743dfc70e3e93b183","RawContent":"Jen, \n I don&#039;t know if the resort excepts early shipments, i&#039;m already prepared to pay and extra baggage fee. But, if you find out do post it because i&#039;m intrested to know myself.","Attachments":[],"Id":608883,"PostDate":1236043485,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Jen, <br \/> I don't know if the resort excepts early shipments, i'm already prepared to pay and extra baggage fee. But, if you find out do post it because i'm intrested to know myself.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/www.weddingcountdown.com\/ticker\/6qscsou.png\">http:\/\/www.weddingcountdown.com\/ticker\/6qscsou.png<\/a><br><span>[\/CENTER]<\/span><\/div><\/div>","Email":"reeveswedding@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1219377984,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211327.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"reevesbride","Id":211327,"Name":"reevesbride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d883b0ec1825f76c29d412da1b680e71","RawContent":"Dana got married today! I hope she writes a review when she gets back.\n \n Since there just seems to be a few of us talking I think that you guys went down for a site visit and I have a question. Only our parents are staying on the resort...everyone else chose to stay off property. Do you guys remember any cool places to go in Cancun where I can do like a &amp;quot;welcome gathering&amp;quot;. Not something too fancy just a cool place to have drinks, eat appetizers, and give out the OOT bags?? I don&#039;t want to spend a lot either. It would have been so much easier if we were all at the same resort but oh well.\n \n I would love any advice!!\n \n ~M","Attachments":[],"Id":610201,"PostDate":1236147523,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Dana got married today! I hope she writes a review when she gets back.<br \/> <br \/> Since there just seems to be a few of us talking I think that you guys went down for a site visit and I have a question. Only our parents are staying on the resort...everyone else chose to stay off property. Do you guys remember any cool places to go in Cancun where I can do like a \"welcome gathering\". Not something too fancy just a cool place to have drinks, eat appetizers, and give out the OOT bags?? I don't want to spend a lot either. It would have been so much easier if we were all at the same resort but oh well.<br \/> <br \/> I would love any advice!!<br \/> <br \/> ~M\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Mesita and Durante<\/span><br><span>June 18, 2009<\/span><br><span>Excellence Playa Mujeres<\/span><br><br><span>My wedding review:<\/span><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t45032#post857892\">http:\/\/bestdestinationwedding.com\/fo...032#post857892<\/a><span>My wedding pro slideshow:<\/span><a data-ipb='nomediaparse' href=\"http:\/\/www.keithcephus.com\/mesita\">http:\/\/www.keithcephus.com\/mesita<\/a><a data-ipb='nomediaparse' href=\"http:\/\/www.ezticker.com\/ticker\/947\/192\/20090618\/Our+Swine+Flu+Free+Wedding%21\/ticker.png\">http:\/\/www.ezticker.com\/ticker\/947\/1...%21\/ticker.png<\/a><\/div><\/div>","Email":"mesita.simms@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1221110745,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211672.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Sensatori Bride","Id":211672,"Name":"Sensatori Bride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"be80a7ace9dfaf1f231afd0cce66e1d4","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;Sensatori Bride&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Dana got married today! I hope she writes a review when she gets back.\n \n Since there just seems to be a few of us talking I think that you guys went down for a site visit and I have a question. Only our parents are staying on the resort...everyone else chose to stay off property. Do you guys remember any cool places to go in Cancun where I can do like a &amp;quot;welcome gathering&amp;quot;. Not something too fancy just a cool place to have drinks, eat appetizers, and give out the OOT bags?? I don&#039;t want to spend a lot either. It would have been so much easier if we were all at the same resort but oh well.\n \n I would love any advice!!\n \n ~M&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;I stayed at an all-inclusive resort when I visited so I didn&#039;t do much off property eating but one place that was fun and reasonably priced was Pat O&#039; Briens- it was the home of the hurricane, and everything as far as appetizers were reasonably priced ($9.00-$12.00 US)which is decent for outside of the US. There appetizers consisted of American favorites like potato skins, cheese sticks, onion rings, and wings. We went over on a Thursday and they had a live band mixed with DJ music, you could sit indoors or out and all your drinks are brought to you balanced on your waiters head. All and all it had a good atmosphere. Its right next to Bubba Gump Shrimp Co. Just remember Cancun is a $60.00 taxi ride roundtrip for your from Excellence!\n \n &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/http:\/\/www.patobriens.com\/patobriens2\/cancun\/default.asp\"&gt;http:\/\/http:\/\/www.patobriens.com\/pat...un\/default.asp&lt;\/a&gt;\n \n Hope this helps! \n \n Lauren","Attachments":[],"Id":610219,"PostDate":1236150007,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>Sensatori Bride<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Dana got married today! I hope she writes a review when she gets back.<br \/> <br \/> Since there just seems to be a few of us talking I think that you guys went down for a site visit and I have a question. Only our parents are staying on the resort...everyone else chose to stay off property. Do you guys remember any cool places to go in Cancun where I can do like a \"welcome gathering\". Not something too fancy just a cool place to have drinks, eat appetizers, and give out the OOT bags?? I don't want to spend a lot either. It would have been so much easier if we were all at the same resort but oh well.<br \/> <br \/> I would love any advice!!<br \/> <br \/> ~M<\/div> <\/td> <\/tr> <\/table> <\/div>I stayed at an all-inclusive resort when I visited so I didn't do much off property eating but one place that was fun and reasonably priced was Pat O' Briens- it was the home of the hurricane, and everything as far as appetizers were reasonably priced ($9.00-$12.00 US)which is decent for outside of the US. There appetizers consisted of American favorites like potato skins, cheese sticks, onion rings, and wings. We went over on a Thursday and they had a live band mixed with DJ music, you could sit indoors or out and all your drinks are brought to you balanced on your waiters head. All and all it had a good atmosphere. Its right next to Bubba Gump Shrimp Co. Just remember Cancun is a $60.00 taxi ride roundtrip for your from Excellence!<br \/> <br \/> <a href='http:\/\/http:\/\/www.patobriens.com\/patobriens2\/cancun\/default.asp' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/http:\/\/www.pa....un\/default.asp<\/a><br \/> <br \/> Hope this helps! <br \/> <br \/> Lauren\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/www.weddingcountdown.com\/ticker\/6qscsou.png\">http:\/\/www.weddingcountdown.com\/ticker\/6qscsou.png<\/a><br><span>[\/CENTER]<\/span><\/div><\/div>","Email":"reeveswedding@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1219377984,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211327.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"reevesbride","Id":211327,"Name":"reevesbride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"61d31871e588184e3bd140914f63d016","RawContent":"Great suggesstion! This might be a winner. Yep, cab fare is going to suck!","Attachments":[],"Id":610273,"PostDate":1236152312,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Great suggesstion! This might be a winner. Yep, cab fare is going to suck!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Mesita and Durante<\/span><br><span>June 18, 2009<\/span><br><span>Excellence Playa Mujeres<\/span><br><br><span>My wedding review:<\/span><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t45032#post857892\">http:\/\/bestdestinationwedding.com\/fo...032#post857892<\/a><span>My wedding pro slideshow:<\/span><a data-ipb='nomediaparse' href=\"http:\/\/www.keithcephus.com\/mesita\">http:\/\/www.keithcephus.com\/mesita<\/a><a data-ipb='nomediaparse' href=\"http:\/\/www.ezticker.com\/ticker\/947\/192\/20090618\/Our+Swine+Flu+Free+Wedding%21\/ticker.png\">http:\/\/www.ezticker.com\/ticker\/947\/1...%21\/ticker.png<\/a><\/div><\/div>","Email":"mesita.simms@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1221110745,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211672.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Sensatori Bride","Id":211672,"Name":"Sensatori Bride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e2cfa7dae3b8efe719a7ea4366225abe","RawContent":"Okay so this might be a silly question but is there an open bar included in the packages? If not, does anyone know a price of an open bar for the reception? Or is a bar included in the &amp;quot;cocktail&amp;quot; hour?\n \n Thanks!\n Mesita","Attachments":[],"Id":611511,"PostDate":1236232249,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Okay so this might be a silly question but is there an open bar included in the packages? If not, does anyone know a price of an open bar for the reception? Or is a bar included in the \"cocktail\" hour?<br \/> <br \/> Thanks!<br \/> Mesita\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Mesita and Durante<\/span><br><span>June 18, 2009<\/span><br><span>Excellence Playa Mujeres<\/span><br><br><span>My wedding review:<\/span><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t45032#post857892\">http:\/\/bestdestinationwedding.com\/fo...032#post857892<\/a><span>My wedding pro slideshow:<\/span><a data-ipb='nomediaparse' href=\"http:\/\/www.keithcephus.com\/mesita\">http:\/\/www.keithcephus.com\/mesita<\/a><a data-ipb='nomediaparse' href=\"http:\/\/www.ezticker.com\/ticker\/947\/192\/20090618\/Our+Swine+Flu+Free+Wedding%21\/ticker.png\">http:\/\/www.ezticker.com\/ticker\/947\/1...%21\/ticker.png<\/a><\/div><\/div>","Email":"mesita.simms@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1221110745,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211672.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Sensatori Bride","Id":211672,"Name":"Sensatori Bride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"889c5639b061790acb127b4edeea97ce","RawContent":"I think the bar is just included as a part of your all-inclusive. Just an assumption but I think its a safe bet.","Attachments":[],"Id":612514,"PostDate":1236306479,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I think the bar is just included as a part of your all-inclusive. Just an assumption but I think its a safe bet.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/www.weddingcountdown.com\/ticker\/6qscsou.png\">http:\/\/www.weddingcountdown.com\/ticker\/6qscsou.png<\/a><br><span>[\/CENTER]<\/span><\/div><\/div>","Email":"reeveswedding@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1219377984,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211327.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"reevesbride","Id":211327,"Name":"reevesbride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2abda52e719bfc04c03adb572c60aa0e","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;Sensatori Bride&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Okay so this might be a silly question but is there an open bar included in the packages? If not, does anyone know a price of an open bar for the reception? Or is a bar included in the &amp;quot;cocktail&amp;quot; hour?\n \n Thanks!\n Mesita&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;Yes. The open bar is included. Here is a cut and paste of an email I got from Nayeli:\n \n The additional decorations included are opt to you, it can be the rose petal aisle runner, an extra centerpiece or 20 color chair ribbons. For the ceremony we also have the seashells and starfish walk way or with river rocks and candles, pictures enclosed.\n The decorations for the cocktail and dinner are not included, we only have the centerpiece but for example at the X-Lounge non decoration is needed because it\u00e2\u20ac\u2122s very nice the way it is, it has some plants the big white lamps and for the spice terrace we will decorate the tables with the centerpieces and if you want to add candles and sea shells it\u00e2\u20ac\u2122s also a good idea, for the candles and shells the charge is $15 usd per table (round table of 8 people).\n \n Yes, you will have a bar tender at the cocktail hour and at the dinner, at the X-Lounge we are going to use the sol bar which is near it but your guests do not need to go to the bar , you will have waiters and they are going to give your drinks and it\u00e2\u20ac\u2122s the same for the dinner, at the beginning of the cocktail and dinner we are going to receive the guests with a drink already prepared for example if you choose a hot pink bouquet we can have strawberry margaritas or if you want only beers or sparkling wine, something matching with the bridesmaids dresses, etc. and after that you can order your drinks to the waiters.","Attachments":[],"Id":612681,"PostDate":1236317159,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>Sensatori Bride<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Okay so this might be a silly question but is there an open bar included in the packages? If not, does anyone know a price of an open bar for the reception? Or is a bar included in the \"cocktail\" hour?<br \/> <br \/> Thanks!<br \/> Mesita<\/div> <\/td> <\/tr> <\/table> <\/div>Yes. The open bar is included. Here is a cut and paste of an email I got from Nayeli:<br \/> <br \/> The additional decorations included are opt to you, it can be the rose petal aisle runner, an extra centerpiece or 20 color chair ribbons. For the ceremony we also have the seashells and starfish walk way or with river rocks and candles, pictures enclosed.<br \/> The decorations for the cocktail and dinner are not included, we only have the centerpiece but for example at the X-Lounge non decoration is needed because it\u00e2\u20ac\u2122s very nice the way it is, it has some plants the big white lamps and for the spice terrace we will decorate the tables with the centerpieces and if you want to add candles and sea shells it\u00e2\u20ac\u2122s also a good idea, for the candles and shells the charge is $15 usd per table (round table of 8 people).<br \/> <br \/> Yes, you will have a bar tender at the cocktail hour and at the dinner, at the X-Lounge we are going to use the sol bar which is near it but your guests do not need to go to the bar , you will have waiters and they are going to give your drinks and it\u00e2\u20ac\u2122s the same for the dinner, at the beginning of the cocktail and dinner we are going to receive the guests with a drink already prepared for example if you choose a hot pink bouquet we can have strawberry margaritas or if you want only beers or sparkling wine, something matching with the bridesmaids dresses, etc. and after that you can order your drinks to the waiters.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i30.photobucket.com\/albums\/c336\/dmbstolio\/Dec122009238-1.jpg\">http:\/\/i30.photobucket.com\/albums\/c3...22009238-1.jpg<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/www.jenandken2009.com\">www.jenandken2009.com<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;130\/st\/20091212\/e\/Jen+%26amp%3B+Kenny%27s+wedding\/k\/02c3\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...02c3\/event.png<\/a><\/div><\/div>","Email":"davis1974@gmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1215061237,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-210302.gif?_r=0","PhotoWidth":98,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Jennifer Davis","Id":210302,"Name":"Jennifer Davis","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"dd803c00464a627cf9b55e61df9da6d9","RawContent":"Thanks for your post Jen the centerpiece question is one I needed answered as well. \n \n Lauren","Attachments":[],"Id":612686,"PostDate":1236317482,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks for your post Jen the centerpiece question is one I needed answered as well. <br \/> <br \/> Lauren\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/www.weddingcountdown.com\/ticker\/6qscsou.png\">http:\/\/www.weddingcountdown.com\/ticker\/6qscsou.png<\/a><br><span>[\/CENTER]<\/span><\/div><\/div>","Email":"reeveswedding@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1219377984,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211327.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"reevesbride","Id":211327,"Name":"reevesbride","IsOnline":false}}],"Pages":{"TotalItems":2874,"TotalPages":288,"CurrentPage":40,"NextPage":50,"PreviousPage":30,"LastPage":2870},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
