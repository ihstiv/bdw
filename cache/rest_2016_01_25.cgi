:"custom"},"FormattedName":"MSG518","Id":221387,"Name":"MSG518","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e91513b0801a6c5c8c35836e3f404cef","RawContent":"Still wondering if anyone has restaurant suggestions for Cancun, looking fora place with great food and great prices for a rehearsal dinner.","Attachments":[],"Id":990355,"PostDate":1263128785,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Still wondering if anyone has restaurant suggestions for Cancun, looking fora place with great food and great prices for a rehearsal dinner.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;130\/st\/20100417\/e\/the+wedding+of+my+dreams\/dt\/-1\/k\/0f53\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...0f53\/event.png<\/a><br><br><i><strong>Excellence Playa Mujeres Bride<br>April 17, 2010<\/strong><\/i><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/t\/wukvjpB\/weight.png\">http:\/\/tickers.TickerFactory.com\/ezt...jpB\/weight.png<\/a><\/div><\/div>","Email":"s_katrese@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1229629965,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213251.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"s_katrese","Id":213251,"Name":"s_katrese","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d8507ce3b89bb91c4843bc82974970d3","RawContent":"I just got back from our honeymoon at this resort and it was AH-Mazing! All of you getting married here will NOT be disappointed!!","Attachments":[],"Id":990667,"PostDate":1263167855,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I just got back from our honeymoon at this resort and it was AH-Mazing! All of you getting married here will NOT be disappointed!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i210.photobucket.com\/albums\/bb46\/nadinecloss\/rocks.jpg\">http:\/\/i210.photobucket.com\/albums\/b...loss\/rocks.jpg<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f77\/nadine-s-dreams-huatulco-review-12-29-09-a-53920\/\">My Dreams Huatulco Wedding Review<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f128\/nadine-s-planning-thread-52947\/\">My Planning Thread<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f76\/nadine-s-wedding-day-after-photots-54891\/#post1161576\">Photographer Review<\/a><\/div><\/div>","Email":"nadinecloss@hotmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1215636060,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-210423.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"*Nadine*","Id":210423,"Name":"*Nadine*","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b11ba9700a8a2979439ff155b5976d08","RawContent":"Katrese I wish i knew places for you to eat..i&#039;m trying not to leave the resort to eat if possible.....\n MSG my menu choices are grilled filet, mahi mahi &amp;amp; chicken breast, and shrimp stuffed chicken breast...I mixed the gold and silver menu choices since i&#039;m getting the gold package..per Yamina that is ok. I have no idea what the veggie option is. \n Nadine I love your dress...mine is similar...\n Question have you all picked a photgrapher yet...I&#039;m in the process I realize now I should have done this month&#039;s ago. I am waiting for a price list from Elizabeth Medina and Del Sol....any suggestions on good photog&#039;s you&#039;ve seen?","Attachments":[],"Id":991033,"PostDate":1263187765,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Katrese I wish i knew places for you to eat..i'm trying not to leave the resort to eat if possible.....<br \/> MSG my menu choices are grilled filet, mahi mahi & chicken breast, and shrimp stuffed chicken breast...I mixed the gold and silver menu choices since i'm getting the gold package..per Yamina that is ok. I have no idea what the veggie option is. <br \/> Nadine I love your dress...mine is similar...<br \/> Question have you all picked a photgrapher yet...I'm in the process I realize now I should have done this month's ago. I am waiting for a price list from Elizabeth Medina and Del Sol....any suggestions on good photog's you've seen?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/www.ezticker.com\/ticker\/1159\/1768\/20100522\/Until+I+Marry+My+Love\/ticker.png\">http:\/\/www.ezticker.com\/ticker\/1159\/...ove\/ticker.png<\/a><\/div><\/div>","Email":"tracihopeis@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1238572485,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-216339.gif?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"thope","Id":216339,"Name":"thope","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d1b4fe57e86b5270f496cdaedad7b7fa","RawContent":"Hello Thope:\n \n I went with Del Sol Photography, Vincent will be shooting our wedding. The office manager is Melissa, she is great. They worked out a payment plan so I did not have to pay it all in one huge chunk. They do not charge you travel since they are in Playa del Carmen. Elizabeth Medina charges you travel and you have to put her up in a hotel room the night before and her prices were higher.\n \n Hope this helps, let me know if you have any questions. Good Luck.\n \n Shanna","Attachments":[],"Id":991525,"PostDate":1263238647,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hello Thope:<br \/> <br \/> I went with Del Sol Photography, Vincent will be shooting our wedding. The office manager is Melissa, she is great. They worked out a payment plan so I did not have to pay it all in one huge chunk. They do not charge you travel since they are in Playa del Carmen. Elizabeth Medina charges you travel and you have to put her up in a hotel room the night before and her prices were higher.<br \/> <br \/> Hope this helps, let me know if you have any questions. Good Luck.<br \/> <br \/> Shanna\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sinma2@jcpenney.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1257930515,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223217.png?_r=0","PhotoWidth":200,"PhotoHeight":167,"PhotoType":"custom"},"FormattedName":"Supersonic","Id":223217,"Name":"Supersonic","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c7c804d105723a52f3109967bd515c72","RawContent":"I am going with sascha gluck of cacun photos he has received great reviews on this site so I look forward to working with him.","Attachments":[],"Id":991558,"PostDate":1263240452,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I am going with sascha gluck of cacun photos he has received great reviews on this site so I look forward to working with him.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;130\/st\/20100417\/e\/the+wedding+of+my+dreams\/dt\/-1\/k\/0f53\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...0f53\/event.png<\/a><br><br><i><strong>Excellence Playa Mujeres Bride<br>April 17, 2010<\/strong><\/i><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/t\/wukvjpB\/weight.png\">http:\/\/tickers.TickerFactory.com\/ezt...jpB\/weight.png<\/a><\/div><\/div>","Email":"s_katrese@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1229629965,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213251.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"s_katrese","Id":213251,"Name":"s_katrese","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e05d62388494aeae55cb912fdda5f1b1","RawContent":"Hi there Excellence brides! You all chose a fantastic destination, congratulations! Hope no one minds if I pop in for a second to comment. I would hate for any of my brides to get the wrong idea or worry based on this incorrect information since my policies have not changed at all.\n \n &lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt; Elizabeth Medina charges you travel and you have to put her up in a hotel room the night before &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;I do travel in from about 4 hours away however I cover all travel costs myself other than the cost of one night&#039;s hotel for the night of the wedding. (to avoid making the drive twice in one day + shooting a wedding!) We do not need to stay at the resort, although it often works out better than way for our clients for us to be onsite because of required day passes and vendor requirements, etc. There are NO additional travel charges.\n \n I hope that is helpful! Best wishes for your weddings! Elizabeth\n \n PS, Since I can&#039;t seem to post with out photos I am attaching a few along with a &lt;img src=\"http:\/\/www.elizabethmedina.com\/blog\/wp-content\/uploads\/2008\/12\/585_emedina_blog_08.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n &lt;img src=\"http:\/\/www.elizabethmedina.com\/blog\/wp-content\/uploads\/2008\/12\/585_emedina_blog_09.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n &lt;img src=\"http:\/\/www.elizabethmedina.com\/blog\/wp-content\/uploads\/2008\/12\/585_emedina_blog_18.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n &lt;img src=\"http:\/\/www.elizabethmedina.com\/blog\/wp-content\/uploads\/2008\/12\/585_emedina_blog_24.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;","Attachments":[],"Id":992530,"PostDate":1263265519,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi there Excellence brides! You all chose a fantastic destination, congratulations! Hope no one minds if I pop in for a second to comment. I would hate for any of my brides to get the wrong idea or worry based on this incorrect information since my policies have not changed at all.<br \/> <br \/> <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\"> Elizabeth Medina charges you travel and you have to put her up in a hotel room the night before <\/td> <\/tr> <\/table> <\/div>I do travel in from about 4 hours away however I cover all travel costs myself other than the cost of one night's hotel for the night of the wedding. (to avoid making the drive twice in one day + shooting a wedding!) We do not need to stay at the resort, although it often works out better than way for our clients for us to be onsite because of required day passes and vendor requirements, etc. There are NO additional travel charges.<br \/> <br \/> I hope that is helpful! Best wishes for your weddings! Elizabeth<br \/> <br \/> PS, Since I can't seem to post with out photos I am attaching a few along with a <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/www.elizabethmedina.com\/blog\/wp-content\/uploads\/2008\/12\/585_emedina_blog_08.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/www.elizabethmedina.com\/blog\/wp-content\/uploads\/2008\/12\/585_emedina_blog_09.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/www.elizabethmedina.com\/blog\/wp-content\/uploads\/2008\/12\/585_emedina_blog_18.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/www.elizabethmedina.com\/blog\/wp-content\/uploads\/2008\/12\/585_emedina_blog_24.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"med1231@mac.com","IpAddress":"","GroupId":44,"GroupName":"Vendor","JoinDate":1163664120,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206909.jpg?_r=0","PhotoWidth":200,"PhotoHeight":230,"PhotoType":"custom"},"FormattedName":"Elizabeth Medina","Id":206909,"Name":"Elizabeth Medina","IsOnline":false}}],"Pages":{"TotalItems":2874,"TotalPages":288,"CurrentPage":380,"NextPage":390,"PreviousPage":370,"LastPage":2870},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
