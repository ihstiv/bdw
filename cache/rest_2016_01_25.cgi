{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e9e09a3ff01e595b015c2693e52a80f3","RawContent":"Does anyone know how much it is per person after 20 guests?\n \n I thought it was somewhere in this thread...but I can&#039;t find it...\n \n Thank you!\n Rebecca","Attachments":[],"Id":1009188,"PostDate":1264401543,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Does anyone know how much it is per person after 20 guests?<br \/> <br \/> I thought it was somewhere in this thread...but I can't find it...<br \/> <br \/> Thank you!<br \/> Rebecca\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;95\/st\/20101203\/e\/Our+Dream+Wedding\/k\/adc5\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...adc5\/event.png<\/a><\/div><\/div>","Email":"rebecca.ooyen@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1260949542,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223947.gif?_r=0","PhotoWidth":78,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"ButterflyR12","Id":223947,"Name":"ButterflyR12","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1e0f4cabaf25f5001d9d501e9e93e03e","RawContent":"Hello Caroline:\n \n My fiance and I have been to Mexico 7 times now. We have stayed at El Dorado Royale 3 times, that was our favorite until we went to EPM this past year. We did get engaged at EPM this past August, which makes it more special to us. We did go back and fourth between EDR and EPM, but EPM is just a bit better for us, we really love it. We are getting married on 9.3.10, it was just the place for us. Hope this helps you. Please ask me any questions about other resorts in the area if you like.\n \n Smiles,\n Shanna\n \n &lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;caroline0277&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;So I know I have asked this question before... but have any of you been to EPM and other resorts in Cancun for a basis of comparison. I thought EPM was beautiful when we were there but I am wondering how it compares to other Cancun resorts. Any thoughts?&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;","Attachments":[],"Id":1009244,"PostDate":1264404181,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hello Caroline:<br \/> <br \/> My fiance and I have been to Mexico 7 times now. We have stayed at El Dorado Royale 3 times, that was our favorite until we went to EPM this past year. We did get engaged at EPM this past August, which makes it more special to us. We did go back and fourth between EDR and EPM, but EPM is just a bit better for us, we really love it. We are getting married on 9.3.10, it was just the place for us. Hope this helps you. Please ask me any questions about other resorts in the area if you like.<br \/> <br \/> Smiles,<br \/> Shanna<br \/> <br \/> <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>caroline0277<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">So I know I have asked this question before... but have any of you been to EPM and other resorts in Cancun for a basis of comparison. I thought EPM was beautiful when we were there but I am wondering how it compares to other Cancun resorts. Any thoughts?<\/div> <\/td> <\/tr> <\/table> <\/div>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sinma2@jcpenney.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1257930515,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223217.png?_r=0","PhotoWidth":200,"PhotoHeight":167,"PhotoType":"custom"},"FormattedName":"Supersonic","Id":223217,"Name":"Supersonic","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b943d11751113681b17db37d66e811ae","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;ButterflyR12&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Does anyone know how much it is per person after 20 guests?\n \n I thought it was somewhere in this thread...but I can&#039;t find it...\n \n Thank you!\n Rebecca&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;I think it&#039;s $45\/pp after the first 20 people","Attachments":[],"Id":1010525,"PostDate":1264476168,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>ButterflyR12<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Does anyone know how much it is per person after 20 guests?<br \/> <br \/> I thought it was somewhere in this thread...but I can't find it...<br \/> <br \/> Thank you!<br \/> Rebecca<\/div> <\/td> <\/tr> <\/table> <\/div>I think it's $45\/pp after the first 20 people\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"caroline0277@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1240535780,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-216996.gif?_r=0","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"FormattedName":"caroline0277","Id":216996,"Name":"caroline0277","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0c0cc32206357c71da4495d5b4f0143c","RawContent":"MSG518- you should check out Jcrew- I had been looking at all of their different BM&#039;s dresses, but ended up finding perfect dresses under their regular dress section. They have several different styles that would be great for any shape. Good luck","Attachments":[],"Id":1011044,"PostDate":1264497333,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                MSG518- you should check out Jcrew- I had been looking at all of their different BM's dresses, but ended up finding perfect dresses under their regular dress section. They have several different styles that would be great for any shape. Good luck\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i83.photobucket.com\/albums\/j307\/PAChumley\/Engaged\/CabofbMay2009XOXO089-1.jpg\">http:\/\/i83.photobucket.com\/albums\/j3...9XOXO089-1.jpg<\/a><\/div><\/div>","Email":"pachumley@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1244684485,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-218326.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Paige2010","Id":218326,"Name":"Paige2010","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cacf3509faa4a6f2f3809ed12dfd2af0","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;Paige2010&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;MSG518- you should check out Jcrew- I had been looking at all of their different BM&#039;s dresses, but ended up finding perfect dresses under their regular dress section. They have several different styles that would be great for any shape. Good luck&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;Thanks, Paige!\n \n I actually ended up getting my bridesmaids&#039; dresses at Macys over the weekend! I&#039;m so happy because that is a huge weight lifted off my shoulder! I tried so hard to let my bridesmaids have a say in the dress so they wouldn&#039;t hate me, but they kept saying &amp;quot;We will wear whatever you want us to wear...even if you chose a garbage bag. It&#039;s your wedding!&amp;quot; \n \n So I finally made my decision!&lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile36.gif\" border=\"0\" alt=\"\" title=\"Smile36\" class=\"inlineimg\" \/&gt;","Attachments":[],"Id":1011509,"PostDate":1264540849,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>Paige2010<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">MSG518- you should check out Jcrew- I had been looking at all of their different BM's dresses, but ended up finding perfect dresses under their regular dress section. They have several different styles that would be great for any shape. Good luck<\/div> <\/td> <\/tr> <\/table> <\/div>Thanks, Paige!<br \/> <br \/> I actually ended up getting my bridesmaids' dresses at Macys over the weekend! I'm so happy because that is a huge weight lifted off my shoulder! I tried so hard to let my bridesmaids have a say in the dress so they wouldn't hate me, but they kept saying \"We will wear whatever you want us to wear...even if you chose a garbage bag. It's your wedding!\" <br \/> <br \/> So I finally made my decision!<span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile36.gif\" border=\"0\" alt=\"\" title=\"Smile36\" class=\"inlineimg\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/daisypath.com\/pic\/2009\/12\/05\/8Brs.jpg\">http:\/\/daisypath.com\/pic\/2009\/12\/05\/8Brs.jpg<\/a><a data-ipb='nomediaparse' href=\"http:\/\/dvcf.daisypath.com\/QoqAm5.png\">http:\/\/dvcf.daisypath.com\/QoqAm5.png<\/a><\/div><\/div>","Email":"msg518@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1252365613,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-221387.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"MSG518","Id":221387,"Name":"MSG518","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"502498a27e7dd0432d9e1982a9267a5d","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;caroline0277&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;So I know I have asked this question before... but have any of you been to EPM and other resorts in Cancun for a basis of comparison. I thought EPM was beautiful when we were there but I am wondering how it compares to other Cancun resorts. Any thoughts?&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;Hi...we have been to EPM and absolutely loved it! We seriously did not have 1 complaint. I&#039;ve also been to Cancun at a resort on the strip, and while it was nice...it just didn&#039;t compare to EPM. Especially the service, food, and since EPM is a bit secluded...it just seems perfect for a wedding \/ honeymoon as well.\n Just my two cents... &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile03.gif\" border=\"0\" alt=\"\" title=\"Smile03\" class=\"inlineimg\" \/&gt;\n Rebecca","Attachments":[],"Id":1012534,"PostDate":1264575005,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>caroline0277<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">So I know I have asked this question before... but have any of you been to EPM and other resorts in Cancun for a basis of comparison. I thought EPM was beautiful when we were there but I am wondering how it compares to other Cancun resorts. Any thoughts?<\/div> <\/td> <\/tr> <\/table> <\/div>Hi...we have been to EPM and absolutely loved it! We seriously did not have 1 complaint. I've also been to Cancun at a resort on the strip, and while it was nice...it just didn't compare to EPM. Especially the service, food, and since EPM is a bit secluded...it just seems perfect for a wedding \/ honeymoon as well.<br \/> Just my two cents... <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile03.gif\" border=\"0\" alt=\"\" title=\"Smile03\" class=\"inlineimg\" \/><\/span><br \/> Rebecca\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;95\/st\/20101203\/e\/Our+Dream+Wedding\/k\/adc5\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...adc5\/event.png<\/a><\/div><\/div>","Email":"rebecca.ooyen@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1260949542,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223947.gif?_r=0","PhotoWidth":78,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"ButterflyR12","Id":223947,"Name":"ButterflyR12","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"70f7b75a9757b224dd0a90b313bdab9f","RawContent":"Hey Ladies,\n \n I wanted to see what packages ya&#039;ll are selecting? I am trying to decide if I should upgrade, and I am also unsure what is included in the Excellence Love package. Does anyone know what kind of dinner it includes? Thanks!!!","Attachments":[],"Id":1012558,"PostDate":1264575727,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hey Ladies,<br \/> <br \/> I wanted to see what packages ya'll are selecting? I am trying to decide if I should upgrade, and I am also unsure what is included in the Excellence Love package. Does anyone know what kind of dinner it includes? Thanks!!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;0\/st\/20100717\/e\/Our+Wedding\/dt\/-1\/k\/65d2\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...65d2\/event.png<\/a><\/div><\/div>","Email":"crasm2@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1263179265,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-224523.gif?_r=0","PhotoWidth":150,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"Blissful1910","Id":224523,"Name":"Blissful1910","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"347ec8cd548995582ec0a65c7eb9e250","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;ButterflyR12&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Hi...we have been to EPM and absolutely loved it! We seriously did not have 1 complaint. I&#039;ve also been to Cancun at a resort on the strip, and while it was nice...it just didn&#039;t compare to EPM. Especially the service, food, and since EPM is a bit secluded...it just seems perfect for a wedding \/ honeymoon as well.\n Just my two cents... &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile03.gif\" border=\"0\" alt=\"\" title=\"Smile03\" class=\"inlineimg\" \/&gt;\n Rebecca&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;Thank you, Rebecca! It definitely helps to hear perspectives of those who have traveled in the Cancun area. Thank you for taking the time to respond.","Attachments":[],"Id":1015540,"PostDate":1264751123,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>ButterflyR12<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Hi...we have been to EPM and absolutely loved it! We seriously did not have 1 complaint. I've also been to Cancun at a resort on the strip, and while it was nice...it just didn't compare to EPM. Especially the service, food, and since EPM is a bit secluded...it just seems perfect for a wedding \/ honeymoon as well.<br \/> Just my two cents... <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile03.gif\" border=\"0\" alt=\"\" title=\"Smile03\" class=\"inlineimg\" \/><\/span><br \/> Rebecca<\/div> <\/td> <\/tr> <\/table> <\/div>Thank you, Rebecca! It definitely helps to hear perspectives of those who have traveled in the Cancun area. Thank you for taking the time to respond.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"caroline0277@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1240535780,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-216996.gif?_r=0","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"FormattedName":"caroline0277","Id":216996,"Name":"caroline0277","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b53321a5f2de56cabe5225d7dedf5ac1","RawContent":"Hey Ladies..I haven&#039;t posted in awhile...Hi to all the newbies! Thanks Rebecca for your 2 cents..I was considering a site visit but Excellence has so many good reviews on here and on trip advisor we decided against it. I have pics of the gazebo options decorated and flowers if anyone needs them. Does anyone have cake photos...cant find mine. 3 months to go and cant wait....&lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/rofl.gif\" border=\"0\" alt=\"\" title=\"Rofl\" class=\"inlineimg\" \/&gt;\n Thanks!","Attachments":[],"Id":1016760,"PostDate":1264835677,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hey Ladies..I haven't posted in awhile...Hi to all the newbies! Thanks Rebecca for your 2 cents..I was considering a site visit but Excellence has so many good reviews on here and on trip advisor we decided against it. I have pics of the gazebo options decorated and flowers if anyone needs them. Does anyone have cake photos...cant find mine. 3 months to go and cant wait....<span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/rofl.gif\" border=\"0\" alt=\"\" title=\"Rofl\" class=\"inlineimg\" \/><\/span><br \/> Thanks!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/www.ezticker.com\/ticker\/1159\/1768\/20100522\/Until+I+Marry+My+Love\/ticker.png\">http:\/\/www.ezticker.com\/ticker\/1159\/...ove\/ticker.png<\/a><\/div><\/div>","Email":"tracihopeis@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1238572485,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-216339.gif?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"thope","Id":216339,"Name":"thope","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8fc46dd44bc62b021d147f1666530e0f","RawContent":"Sorry ladies I have been so busy with sending out my invites, I will post pictures sometime later this week. I am so excited about the big day its coming...","Attachments":[],"Id":1017344,"PostDate":1264905539,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Sorry ladies I have been so busy with sending out my invites, I will post pictures sometime later this week. I am so excited about the big day its coming...\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;130\/st\/20100417\/e\/the+wedding+of+my+dreams\/dt\/-1\/k\/0f53\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...0f53\/event.png<\/a><br><br><i><strong>Excellence Playa Mujeres Bride<br>April 17, 2010<\/strong><\/i><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/t\/wukvjpB\/weight.png\">http:\/\/tickers.TickerFactory.com\/ezt...jpB\/weight.png<\/a><\/div><\/div>","Email":"s_katrese@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1229629965,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213251.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"s_katrese","Id":213251,"Name":"s_katrese","IsOnline":false}}],"Pages":{"TotalItems":2874,"TotalPages":288,"CurrentPage":420,"NextPage":430,"PreviousPage":410,"LastPage":2870},"PushNotifications":[{