read<\/u><br \/> <br \/> - use the macro setting on your camera to take photos of your ring<br \/> - create a free <a href='http:\/\/www.photobucket.com' class='bbc_url' title='External link' rel='nofollow external'>photobucket<\/a> account to upload and share your photos<br \/> - resize your photos if necessary so that it isn't so large that it resizes everyone screens<br \/> - paste the entire IMG code into the thread to share your photos here<br \/> <br \/> Check out this thread for lots of help - <a href='http:\/\/bestdestinationwedding.com\/forum\/t32313' class='bbc_url' title='External link' rel='nofollow external'>**Click Here for FAQ and BDW How to's**<\/a><\/font><\/strong>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/jimkennedyphotography.com\/movienatasha\/\">3.24.07 cabo surf<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/nabumbah.livejournal.com\/\">year two.<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/20th.teamintraining.org\/?utm_source=google&utm_medium=cpc&utm_campaign=20th%2BAdwords\">i ran 26.2 - I helped save lives.<\/a><a data-ipb='nomediaparse' href=\"http:\/\/img.photobucket.com\/albums\/v396\/nabumbah\/family157-1.jpg\">http:\/\/img.photobucket.com\/albums\/v3...amily157-1.jpg<\/a><\/div><\/div>","Email":"nabumbah@gmail.com","IpAddress":"","GroupId":46,"GroupName":"VIP Member","JoinDate":1147463160,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206733.gif?_r=0","PhotoWidth":83,"PhotoHeight":99,"PhotoType":"custom"},"FormattedName":"NABUMBAH","Id":206733,"Name":"NABUMBAH","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":254,"EditedB