ke":true,"TopicId":53458,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ee7e4086985a0bca091dc5f63de9b629","RawContent":"&lt;p&gt; Hi Josie,&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Thanks for the information about the sandles wedding. &amp;nbsp;I too would love a copy of the kit.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Many thanks,&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Jennifer&lt;\/p&gt;","Attachments":[],"Id":1777410,"PostDate":1373556027,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hi Josie,<\/p> <p> \u00a0<\/p> <p> Thanks for the information about the sandles wedding. \u00a0I too would love a copy of the kit.<\/p> <p> \u00a0<\/p> <p> Many thanks,<\/p> <p> \u00a0<\/p> <p> Jennifer<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Jibenw@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1373555977,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-271423.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Jiben","Id":271423,"Name":"Jiben","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"76.28.4.125","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":53458,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"687449110d8d34d01c2092ba5732452b","RawContent":"&lt;p&gt;@[member=\