{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":8761,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ea6e46227218a8beba5447b3b713853d","RawContent":"You may be able to buy a thicker one at David&#039;s Bridal. A friend of mine did this. The bag that my boutique gave me is pretty thin. Now hearing that someone&#039;s dress ripped on the plane, I&#039;m starting to freak out a little...","Attachments":[],"Id":150562,"PostDate":1197572448,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                You may be able to buy a thicker one at David's Bridal. A friend of mine did this. The bag that my boutique gave me is pretty thin. Now hearing that someone's dress ripped on the plane, I'm starting to freak out a little...\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Bre & Pete<\/span><br><span>January 19, 2008<\/span><br><span>El Dorado Royale<\/span><\/div><\/div>","Email":"brequinn@verizon.net","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1186691538,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207605.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"bre","Id":207605,"Name":"bre","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":8761,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2e543b9f38636bce53c2567f23d1231d","RawContent":"Yeah, the one that David&#039;s gave me is pretty thin and it also has a cardboard type torso\/boob thing inside the dress to keep it&#039;s form. It just feels real flimsy when I carry it.","Attachments":[],"Id":150873,"PostDate":1197602605,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Yeah, the one that David's gave me is pretty thin and it also has a cardboard type torso\/boob thing inside the dress to keep it's form. It just feels real flimsy when I carry it.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><strong><i><br><br><br>Therese & Jay<br>Riu Ocho Rios, Jamaica2.15.08<\/i><\/strong><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;116\/st\/20080215\/e\/Our+Wedding\/k\/1f03\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...1f03\/event.png<\/a><\/div><\/div>","Email":"tfafara1758@wowway.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1187662153,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207650.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"chicago88","Id":207650,"Name":"chicago88","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":8761,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"81d76f64f2d4600627fb312f5804b7e4","RawContent":"You can also try stores that sell robes etc. for other occasions - When I bought my legal robes they had really good quality garmet bags for these things, priests robes, choir gowns etc. - things that are generally longer and heavier!","Attachments":[],"Id":150877,"PostDate":1197603233,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                You can also try stores that sell robes etc. for other occasions - When I bought my legal robes they had really good quality garmet bags for these things, priests robes, choir gowns etc. - things that are generally longer and heavier!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i261.photobucket.com\/albums\/ii59\/mradolli\/VC_081127_1105.jpg\">http:\/\/i261.photobucket.com\/albums\/i...81127_1105.jpg<\/a><\/div><\/div>","Email":"mradolli@hotmail.com","IpAddress":"206.222.94.35","GroupId":42,"GroupName":"Sr. Member","JoinDate":1187918239,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207669.gif?_r=0","PhotoWidth":100,"PhotoHeight":69,"PhotoType":"custom"},"FormattedName":"MissyR","Id":207669,"Name":"MissyR","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":8761,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4b69bec3ec59fa4b4516306e3f84ac5b","RawContent":"I used the thin one from the bridal store and it was fine. I did buy a new white flat sheet and wrapped it around the entire dress to protect it (Natasha tip). I also carried FI&#039;s suit in the bag too. I actually poked a hole in the bottom of the bag so I could loop the hanger hook through it and carry it folded in half. \n \n Seriously, after we checked our other bags I just carried the whole thing rolled up anyway.","Attachments":[],"Id":151973,"PostDate":1197864939,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I used the thin one from the bridal store and it was fine. I did buy a new white flat sheet and wrapped it around the entire dress to protect it (Natasha tip). I also carried FI's suit in the bag too. I actually poked a hole in the bottom of the bag so I could loop the hanger hook through it and carry it folded in half. <br \/> <br \/> Seriously, after we checked our other bags I just carried the whole thing rolled up anyway.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"katesig@yahoo.com","IpAddress":"98.247.242.206","GroupId":46,"GroupName":"VIP Member","JoinDate":1154933700,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206773.gif?_r=0","PhotoWidth":85,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"-Kate-","Id":206773,"Name":"-Kate-","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":8761,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a9432382e684766d79733b3b6599bc8e","RawContent":"I used the one I got from the bridal shop. It did the trick but my dress was really wrinkled. I was glad the resort had a steam and press service.\n \n Call your airline to see what kind of arrangements can be made to store your dress on the plane. We were able to put our wedding attire in coat check on the plane to and from.","Attachments":[],"Id":152009,"PostDate":1197869230,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I used the one I got from the bridal shop. It did the trick but my dress was really wrinkled. I was glad the resort had a steam and press service.<br \/> <br \/> Call your airline to see what kind of arrangements can be made to store your dress on the plane. We were able to put our wedding attire in coat check on the plane to and from.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span><center><embed src=\"<\/span><a data-ipb='nomediaparse' href=\"http:\/\/www.widdlytinks.com\/pregnancy\/pregnancy-tickers\/pregnancyticker.swf\">http:\/\/www.widdlytinks.com\/pregnancy\/pregnancy-tickers\/pregnancyticker.swf<\/a><span>\" FlashVars=\"t1=Baby Lambert is on the way&b=7&c=0xCC00CC&f=5&y=2010&m=4&d=14\" quality=\"high\" wmode=\"transparent\" width=\"430\" height=\"115\" name=\"Pregnancy Ticker\" align=\"middle\"...<\/span><a data-ipb='nomediaparse' href=\"http:\/\/www.macromedia.com\/go\/getflashplayer\"><\/a><a data-ipb='nomediaparse' href=\"http:\/\/www.widdlytinks.com\/\"><\/a><\/div><\/div>","Email":"luckeek72@yahoo.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1173509520,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207249.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"Karen","Id":207249,"Name":"Karen","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":8761,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5b79001fc61f26667b2ef31ffb2a499b","RawContent":"I bought my dress online and it didn&#039;t come with a garment bag. I bought one from a local bridal store for $10 it&#039;s clear but it&#039;s decent. I don&#039;t like the fact that its see thru, so I will have to buy another one that&#039;s doesn&#039;t show.","Attachments":[],"Id":152148,"PostDate":1197923589,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I bought my dress online and it didn't come with a garment bag. I bought one from a local bridal store for $10 it's clear but it's decent. I don't like the fact that its see thru, so I will have to buy another one that's doesn't show.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"snow_oh@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1177283886,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207365.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"bride08","Id":207365,"Name":"bride08","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":8761,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0aee09e6103053a2da51a7932a13070a","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;Galit&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;When I was shopping around for a dress, places like Kleinfelds and Pricilla of Boston told me they would &amp;quot;package&amp;quot; my dress for the plane ride in some special way. Why not call them and see what they have to offer? They could be completely full of crap, but it doesnt hurt to call :)&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;That&#039;s exactly what I did, I told the salon that I was having a DW, and they said they would pack it up for me so that it transports well. I took it out of the bag the day before our wedding (which was 3 days after we arrived in Cabo) and the dress was fine, didn&#039;t need any touchup&#039;s..","Attachments":[],"Id":152150,"PostDate":1197924110,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>Galit<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">When I was shopping around for a dress, places like Kleinfelds and Pricilla of Boston told me they would \"package\" my dress for the plane ride in some special way. Why not call them and see what they have to offer? They could be completely full of crap, but it doesnt hurt to call <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/div> <\/td> <\/tr> <\/table> <\/div>That's exactly what I did, I told the salon that I was having a DW, and they said they would pack it up for me so that it transports well. I took it out of the bag the day before our wedding (which was 3 days after we arrived in Cabo) and the dress was fine, didn't need any touchup's..\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tmooney74@yahoo.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1148677920,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206746.jpg?_r=1394162525","PhotoWidth":180,"PhotoHeight":184,"PhotoType":"custom"},"FormattedName":"TammyB","Id":206746,"Name":"TammyB","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":8761,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"446ba098175b46f65b1e8bde4a946dd8","RawContent":"I used a Macy&#039;s garment bag under the white plastic one I got from the bridal shop. \n \n We hung it in the first class closet on the plane. You can call ahead and ask the airline but chances are it doesn&#039;t matter - the person you speak with is probably in a call center far from the airport you&#039;ll be flying out of. \n \n They&#039;ll tell you closet storage is on a space available basis. There is also a captain&#039;s closet you should be able to use. If all else fails you can lay it flat across the luggage in the overhead bin. The humidity the day of my wedding took care of the minor wrinkles in the dress :o)","Attachments":[],"Id":152180,"PostDate":1197929157,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I used a Macy's garment bag under the white plastic one I got from the bridal shop. <br \/> <br \/> We hung it in the first class closet on the plane. You can call ahead and ask the airline but chances are it doesn't matter - the person you speak with is probably in a call center far from the airport you'll be flying out of. <br \/> <br \/> They'll tell you closet storage is on a space available basis. There is also a captain's closet you should be able to use. If all else fails you can lay it flat across the luggage in the overhead bin. The humidity the day of my wedding took care of the minor wrinkles in the dress <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/ohmy.png' class='bbc_emoticon' alt=':o' \/>)\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mrsjamyjones@gmail.com","IpAddress":"162.201.254.135","GroupId":38,"GroupName":"Moderators","JoinDate":1168271040,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207039.jpeg?_r=0","PhotoWidth":1000,"PhotoHeight":667,"PhotoType":"custom"},"FormattedName":"starchild","Id":207039,"Name":"starchild","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.47.49.223","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":8761,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a01aa41fba29a93b5735328f60dd785b","RawContent":"&lt;p&gt;Great post. Thanks!&lt;\/p&gt;","Attachments":[],"Id":1868585,"PostDate":1408922464,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Great post. Thanks!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jolie.vidal@gmail.com","IpAddress":"205.143.69.5","GroupId":40,"GroupName":"Jr. Member","JoinDate":1408558257,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"BrideToBeJolie","Id":279500,"Name":"BrideToBeJolie","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.34.236.241","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":8761,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5dfef6c841f9b330df7ea9db6356f53f","RawContent":"&lt;p&gt;My garment bag is so thin.. I heard there&#039;s special bags you can buy on ebay for traveling on a plane that run about $50... but like someone said.. better than a ripped gown!!&lt;\/p&gt;","Attachments":[],"Id":1868590,"PostDate":1408923277,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>My garment bag is so thin.. I heard there's special bags you can buy on ebay for traveling on a plane that run about $50... but like someone said.. better than a ripped gown!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lauramthistle@gmail.com","IpAddress":"24.34.236.241","GroupId":40,"GroupName":"Jr. Member","JoinDate":1391620956,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276518.jpg?_r=1394639305","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"LauraM","Id":276518,"Name":"LauraM","IsOnline":false}}],"Pages":{"TotalItems":24,"TotalPages":3,"CurrentPage":10,"NextPage":20,"PreviousPage":0,"LastPage":20},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
