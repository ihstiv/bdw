le":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9b1f808a381f6df7031730dd44b803c6","RawContent":"Hey girls,\n \n What did\/will you walk down the aisle to? My FI was thinking we should get a violinist, but I think the sound system is enough. Any advice?\n \n Thanks!\n Mindy","Attachments":[],"Id":947779,"PostDate":1259809238,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hey girls,<br \/> <br \/> What did\/will you walk down the aisle to? My FI was thinking we should get a violinist, but I think the sound system is enough. Any advice?<br \/> <br \/> Thanks!<br \/> Mindy\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/daisypath.com\/pic\/2009\/12\/05\/8Brs.jpg\">http:\/\/daisypath.com\/pic\/2009\/12\/05\/8Brs.jpg<\/a><a data-ipb='nomediaparse' href=\"http:\/\/dvcf.daisypath.com\/QoqAm5.png\">http:\/\/dvcf.daisypath.com\/QoqAm5.png<\/a><\/div><\/div>","Email":"msg518@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1252365613,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-221387.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"MSG518","Id":221387,"Name":"MSG518","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1858ff2edf735c5cad225e73369a2bf7","RawContent":"Greetings ladies. I am another Dreams Riveria Cancun bride looking to change venues. THe reviews from tripadvisor.com for DRC are looking pretty bad right now and I am panicing. EPM was my second choice from when I was researching before so now I am trying to quick make a decision to either suck it up with DRC or make a change. My biggest question so far is how much does it cost per person over the 20 included in the packages? I have emailed the resort a few times for more info but so far nothing in return. Any additional pricing info that you girls could give me would be great. I am hoping to make a decision to stay\/change in the next week or so and I am already in panic mode!\n \n Thanks!","Attachments":[],"Id":951080,"PostDate":1259989913,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Greetings ladies. I am another Dreams Riveria Cancun bride looking to change venues. THe reviews from tripadvisor.com for DRC are looking pretty bad right now and I am panicing. EPM was my second choice from when I was researching before so now I am trying to quick make a decision to either suck it up with DRC or make a change. My biggest question so far is how much does it cost per person over the 20 included in the packages? I have emailed the resort a few times for more info but so far nothing in return. Any additional pricing info that you girls could give me would be great. I am hoping to make a decision to stay\/change in the next week or so and I am already in panic mode!<br \/> <br \/> Thanks!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rachael.jacobs@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1256116804,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-222751.gif?_r=0","PhotoWidth":200,"PhotoHeight":205,"PhotoType":"custom"},"FormattedName":"chirorach","Id":222751,"Name":"chirorach","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"aff3d9d5f7e149b1d14a62880f2fa5a9","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;chirorach&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Greetings ladies. I am another Dreams Riveria Cancun bride looking to change venues. THe reviews from tripadvisor.com for DRC are looking pretty bad right now and I am panicing. EPM was my second choice from when I was researching before so now I am trying to quick make a decision to either suck it up with DRC or make a change. My biggest question so far is how much does it cost per person over the 20 included in the packages? I have emailed the resort a few times for more info but so far nothing in return. Any additional pricing info that you girls could give me would be great. I am hoping to make a decision to stay\/change in the next week or so and I am already in panic mode!\n \n Thanks!&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;$45 p\/person over 20 (includes cocktail hour, dinner and cake)\n \n Yamina (WC) is pretty slow to respond but is very nice and very accommodating once you get her.\n \n The info and the cost of the wedding packages is included on the excellence resorts websites. They have 3 choices.\n \n They do allow outside vendors ($100 fee)\n \n No children whatsoever - no exceptions.\n \n 2 wedding per day only (one in early afternoon and one in late afternoon)\n \n I can&#039;t think of anything else right now. If you have something specific, let us know.\n \n Good luck making your decision. I know it must be a hard one.","Attachments":[],"Id":951288,"PostDate":1260009552,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>chirorach<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Greetings ladies. I am another Dreams Riveria Cancun bride looking to change venues. THe reviews from tripadvisor.com for DRC are looking pretty bad right now and I am panicing. EPM was my second choice from when I was researching before so now I am trying to quick make a decision to either suck it up with DRC or make a change. My biggest question so far is how much does it cost per person over the 20 included in the packages? I have emailed the resort a few times for more info but so far nothing in return. Any additional pricing info that you girls could give me would be great. I am hoping to make a decision to stay\/change in the next week or so and I am already in panic mode!<br \/> <br \/> Thanks!<\/div> <\/td> <\/tr> <\/table> <\/div>$45 p\/person over 20 (includes cocktail hour, dinner and cake)<br \/> <br \/> Yamina (WC) is pretty slow to respond but is very nice and very accommodating once you get her.<br \/> <br \/> The info and the cost of the wedding packages is included on the excellence resorts websites. They have 3 choices.<br \/> <br \/> They do allow outside vendors ($100 fee)<br \/> <br \/> No children whatsoever - no exceptions.<br \/> <br \/> 2 wedding per day only (one in early afternoon and one in late afternoon)<br \/> <br \/> I can't think of anything else right now. If you have something specific, let us know.<br \/> <br \/> Good luck making your decision. I know it must be a hard one.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i30.photobucket.com\/albums\/c336\/dmbstolio\/Dec122009238-1.jpg\">http:\/\/i30.photobucket.com\/albums\/c3...22009238-1.jpg<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/www.jenandken2009.com\">www.jenandken2009.com<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;130\/st\/20091212\/e\/Jen+%26amp%3B+Kenny%27s+wedding\/k\/02c3\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...02c3\/event.png<\/a><\/div><\/div>","Email":"davis1974@gmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1215061237,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-210302.gif?_r=0","PhotoWidth":98,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Jennifer Davis","Id":210302,"Name":"Jennifer Davis","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4fa3eaa00790c2a9bb7ceabe8d6d9852","RawContent":"Hi Ladies!\n I am hoping to include beach towels in our wedding colors for the OOC bags, but I&#039;m having trouble finding them for a decent price. Did anyone else do towels!?","Attachments":[],"Id":952436,"PostDate":1260169049,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi Ladies!<br \/> I am hoping to include beach towels in our wedding colors for the OOC bags, but I'm having trouble finding them for a decent price. Did anyone else do towels!?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Rebecca and Clay<\/span><br><span>3-5-10<\/span><br><span>Excellence Playa Mujeres<\/span><a data-ipb='nomediaparse' href=\"http:\/\/www.rebeccaandclay.com\">www.rebeccaandclay.com<\/a><\/div><\/div>","Email":"rah_3@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1257638541,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223137.gif?_r=0","PhotoWidth":100,"PhotoHeight":26,"PhotoType":"custom"},"FormattedName":"Rebecca030510","Id":223137,"Name":"Rebecca030510","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":false,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e21d18b4d482e0185bb4cb84d32901d7","RawContent":"I would highly advise against your parents using the cruise as a means to get to your wedding! For several reasons:\n \n 1.Cruises reserve the right to change ports at any time-for any reason! Even in mid sail.\n \n 2.There is a very short windowfor the passenger to visit the destination- most go from 10am - 4pm ( although many lines extend those hrs in Cozumel) .\n \n 3. When you are on a ship that is disembarking 3000 ppl- it takes quite a while, there will also be traffic jams and the ferry will likely fill up quickly. Then they will encouter traffic in PDC. Add to that the drive to EPM......\n \n 4. If they miss the ferry back to Coz, and miss their cruise it will leave them and they will be responsible to get to the next port at their own expense.\n \n 5. The logistics of trying to coordinate your wedding with the cruiseline schedule- which as mentioned above can change at the drop of a hat!\n \n If they will not budge perhaps they can find a cruise that docks in Cancun- it eliminates many of teh logistical nightmares and save them a bunch of time!\n \n My advise would be for them to cruise after the wedding- take a few days at EPM then get a flight to Miami \/FLL to take their cruise.\n \n As far as using a TA - there are many many threads on the forum but generally it doesn&#039;t cost anything extra to utilize a TA&#039;s services. \n \n \n &lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;JenKen11082010&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Hey ladies! I just spent the last few hours reading this ENTIRE thread and I&#039;m sure I still missed some details but it was very informative and so helpful!\n \n So here is my deal. I currently have a date reserved at Dreams Riviera Cancun for 11\/08\/2010. I love the resort and location but HATE the wedding gazebo and HATE that the recent reviews make it seem like children own the place. We do not want to get married right in the sand and our none of our guests will bring children so we are really looking for an adults only.\n \n I have spent A TON of time researching every single adult only in this area and I love EPM but I have a big problem. My parents insist on attending our wedding by way of a cruise. The cruise stops in Cozumel - which means my parents will need to take the ferry to Playa Del Carmen and then a taxi north to Playa Mujeres (which I think will take over an hour). My parents have never traveled outside of the US and I worry about their ability to manage this. I keep trying to convince my mom just to fly in and stay for a few days but she feels like if she is going to spend this much money she wants a full 7 days vacation and has always wanted to go on a cruise. Dreams Riviera Cancun is only about 20 minutes from PDC and will be much easier for them to get to but I really prefer EPM - the wedding gazebo seems much nicer and I love that its adult only. Any insight would be so appreciated! I&#039;m just not sure if I can expect my parents to be able to handle this and if not maybe we should plan our wedding in cozumel or Playa Del Carmen to make life easier on them. I&#039;m torn because I&#039;ve searched and searched for the perfect resort in those areas and just cant find one I absolutely love.\n \n One more question. We have traveled a lot (all over the US, Mexico twice, Honduras, Belize, Grand Cayman, etc) but have always booked our trips online - on our own. I have never used a TA and have NO IDEA how they work, where to find one, etc. Is it best to find a TA in your town to be able to meet in person, can you find one online and how much do you typically pay for their service? Can they save you money? Anyone planning everything on your own and think a TA isn&#039;t necessary? Again, any information would be great.\n \n I am also interested in the save the date letter mentioned a few pages ago and I&#039;m hoping someone can email it to me &lt;a data-ipb=&#039;nomediaparse&#039; href=\"mailto:jenns_cute_88@hotmail.com\"&gt;jenns_cute_88@hotmail.com&lt;\/a&gt; since I dont have enough points yet. \n \n We would like to have 20 or so guests and would likely go with the Love Package. I&#039;m upset that I&#039;ve spent so much time emailing the wedding coordinator at Dreams and I&#039;ve finally begun to understand their packages and costs and now I&#039;ve gone and changed my mind...UGGHHH!!!&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;","Attachments":[],"Id":954554,"PostDate":1260306526,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I would highly advise against your parents using the cruise as a means to get to your wedding! For several reasons:<br \/> <br \/> 1.Cruises reserve the right to change ports at any time-for any reason! Even in mid sail.<br \/> <br \/> 2.There is a very short windowfor the passenger to visit the destination- most go from 10am - 4pm ( although many lines extend those hrs in Cozumel) .<br \/> <br \/> 3. When you are on a ship that is disembarking 3000 ppl- it takes quite a while, there will also be traffic jams and the ferry will likely fill up quickly. Then they will encouter traffic in PDC. Add to that the drive to EPM......<br \/> <br \/> 4. If they miss the ferry back to Coz, and miss their cruise it will leave them and they will be responsible to get to the next port at their own expense.<br \/> <br \/> 5. The logistics of trying to coordinate your wedding with the cruiseline schedule- which as mentioned above can change at the drop of a hat!<br \/> <br \/> If they will not budge perhaps they can find a cruise that docks in Cancun- it eliminates many of teh logistical nightmares and save them a bunch of time!<br \/> <br \/> My advise would be for them to cruise after the wedding- take a few days at EPM then get a flight to Miami \/FLL to take their cruise.<br \/> <br \/> As far as using a TA - there are many many threads on the forum but generally it doesn't cost anything extra to utilize a TA's services. <br \/> <br \/> <br \/> <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>JenKen11082010<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Hey ladies! I just spent the last few hours reading this ENTIRE thread and I'm sure I still missed some details but it was very informative and so helpful!<br \/> <br \/> So here is my deal. I currently have a date reserved at Dreams Riviera Cancun for 11\/08\/2010. I love the resort and location but HATE the wedding gazebo and HATE that the recent reviews make it seem like children own the place. We do not want to get married right in the sand and our none of our guests will bring children so we are really looking for an adults only.<br \/> <br \/> I have spent A TON of time researching every single adult only in this area and I love EPM but I have a big problem. My parents insist on attending our wedding by way of a cruise. The cruise stops in Cozumel - which means my parents will need to take the ferry to Playa Del Carmen and then a taxi north to Playa Mujeres (which I think will take over an hour). My parents have never traveled outside of the US and I worry about their ability to manage this. I keep trying to convince my mom just to fly in and stay for a few days but she feels like if she is going to spend this much money she wants a full 7 days vacation and has always wanted to go on a cruise. Dreams Riviera Cancun is only about 20 minutes from PDC and will be much easier for them to get to but I really prefer EPM - the wedding gazebo seems much nicer and I love that its adult only. Any insight would be so appreciated! I'm just not sure if I can expect my parents to be able to handle this and if not maybe we should plan our wedding in cozumel or Playa Del Carmen to make life easier on them. I'm torn because I've searched and searched for the perfect resort in those areas and just cant find one I absolutely love.<br \/> <br \/> One more question. We have traveled a lot (all over the US, Mexico twice, Honduras, Belize, Grand Cayman, etc) but have always booked our trips online - on our own. I have never used a TA and have NO IDEA how they work, where to find one, etc. Is it best to find a TA in your town to be able to meet in person, can you find one online and how much do you typically pay for their service? Can they save you money? Anyone planning everything on your own and think a TA isn't necessary? Again, any information would be great.<br \/> <br \/> I am also interested in the save the date letter mentioned a few pages ago and I'm hoping someone can email it to me <a href='mailto:jenns_cute_88@hotmail.com' class='bbc_url' title='External link' rel='nofollow external'>jenns_cute_88@hotmail.com<\/a> since I dont have enough points yet. <br \/> <br \/> We would like to have 20 or so guests and would likely go with the Love Package. I'm upset that I've spent so much time emailing the wedding coordinator at Dreams and I've finally begun to understand their packages and costs and now I've gone and changed my mind...UGGHHH!!!<\/div> <\/td> <\/tr> <\/table> <\/div>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"","IpAddress":"","GroupId":5,"GroupName":"Banned","JoinDate":1193117580,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207874.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"JenniferSS","Id":207874,"Name":"JenniferSS","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0aa7dabfda199641b17cc86e33f3a40f","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;Rebecca030510&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Hi Ladies!\n I am hoping to include beach towels in our wedding colors for the OOC bags, but I&#039;m having trouble finding them for a decent price. Did anyone else do towels!?&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;Rebecca,\n \n I&#039;m looking to do the same. I haven&#039;t any either...well I haven&#039;t actually looked lol. If I find anything I&#039;ll let you know!","Attachments":[],"Id":959014,"PostDate":1260499296,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>Rebecca030510<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Hi Ladies!<br \/> I am hoping to include beach towels in our wedding colors for the OOC bags, but I'm having trouble finding them for a decent price. Did anyone else do towels!?<\/div> <\/td> <\/tr> <\/table> <\/div>Rebecca,<br \/> <br \/> I'm looking to do the same. I haven't any either...well I haven't actually looked lol. If I find anything I'll let you know!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/daisypath.com\/pic\/2009\/12\/05\/8Brs.jpg\">http:\/\/daisypath.com\/pic\/2009\/12\/05\/8Brs.jpg<\/a><a data-ipb='nomediaparse' href=\"http:\/\/dvcf.daisypath.com\/QoqAm5.png\">http:\/\/dvcf.daisypath.com\/QoqAm5.png<\/a><\/div><\/div>","Email":"msg518@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1252365613,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-221387.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"MSG518","Id":221387,"Name":"MSG518","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0a56b574918d425fb708746149c8539d","RawContent":"Jen I hope your wedding day was amazing... hurry back with positive reviews and pictures. Yes don&#039;t forget the pictures.&lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheers.gif\" border=\"0\" alt=\"\" title=\"Cheers\" class=\"inlineimg\" \/&gt;","Attachments":[],"Id":961942,"PostDate":1260775966,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Jen I hope your wedding day was amazing... hurry back with positive reviews and pictures. Yes don't forget the pictures.<span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheers.gif\" border=\"0\" alt=\"\" title=\"Cheers\" class=\"inlineimg\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;130\/st\/20100417\/e\/the+wedding+of+my+dreams\/dt\/-1\/k\/0f53\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...0f53\/event.png<\/a><br><br><i><strong>Excellence Playa Mujeres Bride<br>April 17, 2010<\/strong><\/i><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/t\/wukvjpB\/weight.png\">http:\/\/tickers.TickerFactory.com\/ezt...jpB\/weight.png<\/a><\/div><\/div>","Email":"s_katrese@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1229629965,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213251.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"s_katrese","Id":213251,"Name":"s_katrese","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"259e97032a73c4ab7eb8bfd179a32e80","RawContent":"Hi ladies!!!! I wanted to send you a quick note.....\n \n Everything was PERFECT! And this is coming from a complete control freak. I have to say not one single thing went wrong. Everything happened exactly as planned and discussed with Yamina. I&#039;ll post a planning thread and review when I get back home but I know there are not a lot of EPM brides so I wanted to be sure to get back to you guys asap!\n \n The resort is GORGEOUS! The food is excellent. Yamina is THE BEST! Whatever reservations I had about her due to lack of communication before we arrived went right out the window when we met.\n \n BTW - Towels. I used &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.towels4less.com\"&gt;Beach Towels wholesale manufacturer of custom embroidered monogrammed bath towel for corporate events&lt;\/a&gt;. I ordered from them. I think it was $550.00 for 40 towels. I got the large terry velour ones in white and in navy blue.\n \n A word of warning, though.....getting the towels down to Mexico was a big pain in the you know what. They are heavy and take up a ton of room. We had 2 extra large suitcases just for the OOT bag stuff which was 90% towels.","Attachments":[],"Id":962159,"PostDate":1260818416,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi ladies!!!! I wanted to send you a quick note.....<br \/> <br \/> Everything was PERFECT! And this is coming from a complete control freak. I have to say not one single thing went wrong. Everything happened exactly as planned and discussed with Yamina. I'll post a planning thread and review when I get back home but I know there are not a lot of EPM brides so I wanted to be sure to get back to you guys asap!<br \/> <br \/> The resort is GORGEOUS! The food is excellent. Yamina is THE BEST! Whatever reservations I had about her due to lack of communication before we arrived went right out the window when we met.<br \/> <br \/> BTW - Towels. I used <a href='http:\/\/www.towels4less.com' class='bbc_url' title='External link' rel='nofollow external'>Beach Towels wholesale manufacturer of custom embroidered monogrammed bath towel for corporate events<\/a>. I ordered from them. I think it was $550.00 for 40 towels. I got the large terry velour ones in white and in navy blue.<br \/> <br \/> A word of warning, though.....getting the towels down to Mexico was a big pain in the you know what. They are heavy and take up a ton of room. We had 2 extra large suitcases just for the OOT bag stuff which was 90% towels.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i30.photobucket.com\/albums\/c336\/dmbstolio\/Dec122009238-1.jpg\">http:\/\/i30.photobucket.com\/albums\/c3...22009238-1.jpg<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/www.jenandken2009.com\">www.jenandken2009.com<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;130\/st\/20091212\/e\/Jen+%26amp%3B+Kenny%27s+wedding\/k\/02c3\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...02c3\/event.png<\/a><\/div><\/div>","Email":"davis1974@gmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1215061237,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-210302.gif?_r=0","PhotoWidth":98,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Jennifer Davis","Id":210302,"Name":"Jennifer Davis","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ba110ebde6a8d1c610b6a57786a2b9d1","RawContent":"Thanks Jen! Congrats!! I got the chills reading your message! I hope you and your family enjoy the rest of your stay!","Attachments":[],"Id":962757,"PostDate":1260839406,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks Jen! Congrats!! I got the chills reading your message! I hope you and your family enjoy the rest of your stay!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/daisypath.com\/pic\/2009\/12\/05\/8Brs.jpg\">http:\/\/daisypath.com\/pic\/2009\/12\/05\/8Brs.jpg<\/a><a data-ipb='nomediaparse' href=\"http:\/\/dvcf.daisypath.com\/QoqAm5.png\">http:\/\/dvcf.daisypath.com\/QoqAm5.png<\/a><\/div><\/div>","Email":"msg518@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1252365613,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-221387.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"MSG518","Id":221387,"Name":"MSG518","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"87e7dc8e520c8f907edd52b1a9c39fe9","RawContent":"Jen Yay!!!! Cant wait to see pix and get your full review!","Attachments":[],"Id":963583,"PostDate":1260879387,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Jen Yay!!!! Cant wait to see pix and get your full review!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/www.ezticker.com\/ticker\/1159\/1768\/20100522\/Until+I+Marry+My+Love\/ticker.png\">http:\/\/www.ezticker.com\/ticker\/1159\/...ove\/ticker.png<\/a><\/div><\/div>","Email":"tracihopeis@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1238572485,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-216339.gif?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"thope","Id":216339,"Name":"thope","IsOnline":false}}],"Id":"27268","Title":"Excellence Playa Mujeres Brides Post Here!","LastPostDate":1452215913},"Pages":{"TotalItems":2874,"TotalPages":288,"CurrentPage":340,"NextPage":350,"PreviousPage":330,"LastPage":2870},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
