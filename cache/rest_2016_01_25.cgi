{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f143faa1ba67458b1e8758e3d27c600a","RawContent":"Thanks Jennifer! That helps a lot. I was getting nervous that a bar wasn&#039;t included!","Attachments":[],"Id":612761,"PostDate":1236324280,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks Jennifer! That helps a lot. I was getting nervous that a bar wasn't included!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Mesita and Durante<\/span><br><span>June 18, 2009<\/span><br><span>Excellence Playa Mujeres<\/span><br><br><span>My wedding review:<\/span><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t45032#post857892\">http:\/\/bestdestinationwedding.com\/fo...032#post857892<\/a><span>My wedding pro slideshow:<\/span><a data-ipb='nomediaparse' href=\"http:\/\/www.keithcephus.com\/mesita\">http:\/\/www.keithcephus.com\/mesita<\/a><a data-ipb='nomediaparse' href=\"http:\/\/www.ezticker.com\/ticker\/947\/192\/20090618\/Our+Swine+Flu+Free+Wedding%21\/ticker.png\">http:\/\/www.ezticker.com\/ticker\/947\/1...%21\/ticker.png<\/a><\/div><\/div>","Email":"mesita.simms@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1221110745,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211672.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Sensatori Bride","Id":211672,"Name":"Sensatori Bride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"af8c6bffbdd2fd475416cfd7de0fc54b","RawContent":"Hi Everyone!\n \n We just got back last night from our wedding and honeymoon and it was amazing! I&amp;quot;ll post pictures soon.","Attachments":[],"Id":615439,"PostDate":1236636543,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi Everyone!<br \/> <br \/> We just got back last night from our wedding and honeymoon and it was amazing! I\"ll post pictures soon.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;116\/st\/20090303\/e\/Our+Wedding\/k\/240b\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...240b\/event.png<\/a><\/div><\/div>","Email":"danascarlton@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1218527327,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211131.gif?_r=0","PhotoWidth":200,"PhotoHeight":158,"PhotoType":"custom"},"FormattedName":"DanaC","Id":211131,"Name":"DanaC","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8aba8e191eca3a718e099bb17b24c0d4","RawContent":"Hi Dana! I can&#039;t wait to see your pictures and hear your review. Congratulations!\n \n ~M","Attachments":[],"Id":616399,"PostDate":1236715315,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi Dana! I can't wait to see your pictures and hear your review. Congratulations!<br \/> <br \/> ~M\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Mesita and Durante<\/span><br><span>June 18, 2009<\/span><br><span>Excellence Playa Mujeres<\/span><br><br><span>My wedding review:<\/span><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t45032#post857892\">http:\/\/bestdestinationwedding.com\/fo...032#post857892<\/a><span>My wedding pro slideshow:<\/span><a data-ipb='nomediaparse' href=\"http:\/\/www.keithcephus.com\/mesita\">http:\/\/www.keithcephus.com\/mesita<\/a><a data-ipb='nomediaparse' href=\"http:\/\/www.ezticker.com\/ticker\/947\/192\/20090618\/Our+Swine+Flu+Free+Wedding%21\/ticker.png\">http:\/\/www.ezticker.com\/ticker\/947\/1...%21\/ticker.png<\/a><\/div><\/div>","Email":"mesita.simms@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1221110745,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211672.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Sensatori Bride","Id":211672,"Name":"Sensatori Bride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9490e03ff7ce74f3d1bfd0ae61e971df","RawContent":"Hey Everyone!\n \n We had a wonderful experience at EPM! Everyone in our party agreed that the resort was amazing and were totally pleased with the trip! I&#039;m so glad that we went for the destination wedding - it is the smartest (and easiest) way to get married!\n \n &lt;i&gt;I&#039;m pretty laid-back, so take my reviews with that in mind. &lt;\/i&gt;\n \n The entire event was perfect and there weren&#039;t any issues -it was a completely stress-free experience. \n &lt;ul&gt;&lt;li&gt;Nayeli was our coordinator for the wedding and she was great to work with and very knowledgeable about the entire wedding process. She was very flexible with any special arrangements\/requests and our entire pre-wedding meeting was no more than 1 hour.\n&lt;\/li&gt; &lt;li&gt;Sebastian was the photographer and he did amazing work (we wound up with ~200 photos - this is a very small sample). He is also very flexible and willing to create special packages\/arrangements outside of the pre-disclosed photo packages (we had to pay his fee in cash - keep that in mind)\n&lt;\/li&gt; &lt;li&gt;The staff at the spa was great. My makeup was perfect for the event and she did an amazing job with my hair. I had a general idea of what i wanted prior to going, but I&#039;m sure it would have been helpful to bring along a photo (I&#039;m laid back and didn&#039;t think this was important until I was sitting in the chair)\n&lt;\/li&gt; &lt;li&gt;We were married in the Gazebo area. I do recommend this due to the winds that were pretty consistent on our trip. Apparently it is typically pretty windy at the resort (this was the case all 8 days we were there). Also, the Gazebo gives you more of an opportunity to &#039;dress up&#039; the event with chair covers and flowers and provides shade for your guests.\n&lt;\/li&gt; &lt;li&gt;During the ceremony, the wedding officiant could not pronounce our names at all. She said Dana at least 3 different ways and could not pronounce my husband\u00e2\u20ac\u2122s last name at all. It makes for a funny story. (We did a symbolic wedding since we got married in NC right before we left so we could avoid the legal requirements of a Mexican wedding.) \n&lt;\/li&gt; &lt;li&gt;Our cocktail hour was at the X-Lounge. It&#039;s a pretty cool spot and is right on the beach. We had 3 waiters and a bartender for our party. Open bar with champagne toast and a bunch of food.\n&lt;\/li&gt; &lt;li&gt;Dinner was on the terrace of the Spice restaurant (2nd floor with direct views of the ocean). It was gorgeous, private, with plenty of room! There is only 1 centerpiece included with the package \u00e2\u20ac\u201c I didn\u00e2\u20ac\u2122t realize that we would have 2 round dinner tables\u00e2\u20ac\u00a6not a big deal, but someone might find that helpful).\n&lt;\/li&gt; &lt;li&gt;I was very wary of the limited food options and having to create a 5 course meal out of them - but the food was great &amp;amp; we picked well. The cake was AWESOME! We also had 3 waiters for dinner \u00e2\u20ac\u201c and the service was amazing. \n&lt;\/li&gt; &lt;li&gt;Flowers were stunning and exactly what I wanted.\n&lt;\/li&gt; &lt;li&gt;My dress was pressed perfectly &amp;amp; my husband&#039;s suit was perfect too! \n&lt;\/li&gt; &lt;li&gt;They had our room all set up for our wedding night with champagne and rose petals. &lt;\/li&gt; &lt;\/ul&gt;\n The photographer didn&#039;t stay for the whole time, so I have to get some pictures from our guests for the reception so I can post them. \n \n We didn&#039;t add music at all. They had the wedding march for me to walk to - and we found that to be enough. If you wanted dancing as part of your reception dinner, you\u00e2\u20ac\u2122ll need music. \n \n Here are some pictures - let me know if anyone has any questions about the resort, the wedding experience, or if you want to see more pics!\n \n &lt;img src=\"http:\/\/i83.photobucket.com\/albums\/j286\/caboweddingforum\/OurWedding044.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n &lt;img src=\"http:\/\/i83.photobucket.com\/albums\/j286\/caboweddingforum\/OurWedding054.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n &lt;img src=\"http:\/\/i83.photobucket.com\/albums\/j286\/caboweddingforum\/OurWedding127.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n &lt;img src=\"http:\/\/i83.photobucket.com\/albums\/j286\/caboweddingforum\/OurWedding172.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;","Attachments":[],"Id":616774,"PostDate":1236736435,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hey Everyone!<br \/> <br \/> We had a wonderful experience at EPM! Everyone in our party agreed that the resort was amazing and were totally pleased with the trip! I'm so glad that we went for the destination wedding - it is the smartest (and easiest) way to get married!<br \/> <br \/> <i>I'm pretty laid-back, so take my reviews with that in mind. <\/i><br \/> <br \/> The entire event was perfect and there weren't any issues -it was a completely stress-free experience. <br \/> <ul><li>Nayeli was our coordinator for the wedding and she was great to work with and very knowledgeable about the entire wedding process. She was very flexible with any special arrangements\/requests and our entire pre-wedding meeting was no more than 1 hour.<br \/><\/li> <li>Sebastian was the photographer and he did amazing work (we wound up with ~200 photos - this is a very small sample). He is also very flexible and willing to create special packages\/arrangements outside of the pre-disclosed photo packages (we had to pay his fee in cash - keep that in mind)<br \/><\/li> <li>The staff at the spa was great. My makeup was perfect for the event and she did an amazing job with my hair. I had a general idea of what i wanted prior to going, but I'm sure it would have been helpful to bring along a photo (I'm laid back and didn't think this was important until I was sitting in the chair)<br \/><\/li> <li>We were married in the Gazebo area. I do recommend this due to the winds that were pretty consistent on our trip. Apparently it is typically pretty windy at the resort (this was the case all 8 days we were there). Also, the Gazebo gives you more of an opportunity to 'dress up' the event with chair covers and flowers and provides shade for your guests.<br \/><\/li> <li>During the ceremony, the wedding officiant could not pronounce our names at all. She said Dana at least 3 different ways and could not pronounce my husband\u00e2\u20ac\u2122s last name at all. It makes for a funny story. (We did a symbolic wedding since we got married in NC right before we left so we could avoid the legal requirements of a Mexican wedding.) <br \/><\/li> <li>Our cocktail hour was at the X-Lounge. It's a pretty cool spot and is right on the beach. We had 3 waiters and a bartender for our party. Open bar with champagne toast and a bunch of food.<br \/><\/li> <li>Dinner was on the terrace of the Spice restaurant (2nd floor with direct views of the ocean). It was gorgeous, private, with plenty of room! There is only 1 centerpiece included with the package \u00e2\u20ac\u201c I didn\u00e2\u20ac\u2122t realize that we would have 2 round dinner tables\u00e2\u20ac\u00a6not a big deal, but someone might find that helpful).<br \/><\/li> <li>I was very wary of the limited food options and having to create a 5 course meal out of them - but the food was great & we picked well. The cake was AWESOME! We also had 3 waiters for dinner \u00e2\u20ac\u201c and the service was amazing. <br \/><\/li> <li>Flowers were stunning and exactly what I wanted.<br \/><\/li> <li>My dress was pressed perfectly & my husband's suit was perfect too! <br \/><\/li> <li>They had our room all set up for our wedding night with champagne and rose petals. <\/li> <\/ul><br \/> The photographer didn't stay for the whole time, so I have to get some pictures from our guests for the reception so I can post them. <br \/> <br \/> We didn't add music at all. They had the wedding march for me to walk to - and we found that to be enough. If you wanted dancing as part of your reception dinner, you\u00e2\u20ac\u2122ll need music. <br \/> <br \/> Here are some pictures - let me know if anyone has any questions about the resort, the wedding experience, or if you want to see more pics!<br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i83.photobucket.com\/albums\/j286\/caboweddingforum\/OurWedding044.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i83.photobucket.com\/albums\/j286\/caboweddingforum\/OurWedding054.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i83.photobucket.com\/albums\/j286\/caboweddingforum\/OurWedding127.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i83.photobucket.com\/albums\/j286\/caboweddingforum\/OurWedding172.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;116\/st\/20090303\/e\/Our+Wedding\/k\/240b\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...240b\/event.png<\/a><\/div><\/div>","Email":"danascarlton@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1218527327,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211131.gif?_r=0","PhotoWidth":200,"PhotoHeight":158,"PhotoType":"custom"},"FormattedName":"DanaC","Id":211131,"Name":"DanaC","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f76354c36af0fe7576d35ccde405c3cb","RawContent":"I forgot one:\n \n &lt;img src=\"http:\/\/i83.photobucket.com\/albums\/j286\/caboweddingforum\/OurWedding119.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;","Attachments":[],"Id":616783,"PostDate":1236736674,"Post