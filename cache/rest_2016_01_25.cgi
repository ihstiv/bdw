idth: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                All your websites are great! Good job ladies!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i30.photobucket.com\/albums\/c336\/dmbstolio\/Dec122009238-1.jpg\">http:\/\/i30.photobucket.com\/albums\/c3...22009238-1.jpg<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/www.jenandken2009.com\">www.jenandken2009.com<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;130\/st\/20091212\/e\/Jen+%26amp%3B+Kenny%27s+wedding\/k\/02c3\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...02c3\/event.png<\/a><\/div><\/div>","Email":"davis1974@gmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1215061237,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-210302.gif?_r=0","PhotoWidth":98,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Jennifer Davis","Id":210302,"Name":"Jennifer Davis","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"17fb5a1b6b927b92a427b8f184593720","RawContent":"Thanks ladies...I LOVE this blog..","Attachments":[],"Id":729583,"PostDate":1245393890,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks ladies...I LOVE this blog..\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/www.ezticker.com\/ticker\/1159\/1768\/20100522\/Until+I+Marry+My+Love\/ticker.png\">http:\/\/www.ezticker.com\/ticker\/1159\/...ove\/ticker.png<\/a><\/div><\/div>","Email":"tracihopeis@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1238572485,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-216339.gif?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"thope","Id":216339,"Name":"thope","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fa831161d6fd3c83a95f6f6f73e7fc7e","RawContent":"Hi Ladies,\n I have a quick question for some of you with regards to guest accomodations. Are any of them staying at a different resort? Do any of you know of any resort\/hotel close to EPM? I know its quite a ways from the busy sidie of Cancun, and ive read that our resort is like in the middle of nowhere...lol..so Im just looking for other resort options for those who might not have the resources for our resort, or have teenage children who still want to attend.\n Any info is appreciated!","Attachments":[],"Id":730123,"PostDate":1245443810,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi Ladies,<br \/> I have a quick question for some of you with regards to guest accomodations. Are any of them staying at a different resort? Do any of you know of any resort\/hotel close to EPM? I know its quite a ways from the busy sidie of Cancun, and ive read that our resort is like in the middle of nowhere...lol..so Im just looking for other resort options for those who might not have the resources for our resort, or have teenage children who still want to attend.<br \/> Any info is appreciated!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"yoliejimenez1976@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1243020069,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-217738.gif?_r=0","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"FormattedName":"Jewels336","Id":217738,"Name":"Jewels336","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0ab73f8f83bcafc9867f4b8fafd0c84c","RawContent":"Hey girlies, \n been doing some research and I found a hotel La Amada on the same beach as EPM. Looks like their neighbors...this may be a good alternative for some of your guests who have children or maybe want to save a little money. Its not all inclusive so Im not sure how much they would save..but some people like smaller numbers up front (even if they end up spending more later on)...\n Just thought it might be useful info..\n \n heres their website &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.laamadahotel.com\"&gt;Luxury Playa Mujeres &amp;amp; Cancun Hotels | La Amada Hotel, Playa Mujeres, Cancun, Mexico&lt;\/a&gt;\n \n I also found this on expedia where you can map how close the resorts are:\n &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.expedia.com\/PlayaMujeres-Cancun-Hotels.0-n6085422-0.Travel-Guide-Filter-Hotels\"&gt;Playa Mujeres hotels in Cancun, Quintana Roo&lt;\/a&gt;\n \n Trip Advisor has a lot of positive feedback as well.\n \n TTYL!","Attachments":[],"Id":730331,"PostDate":1245454547,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hey girlies, <br \/> been doing some research and I found a hotel La Amada on the same beach as EPM. Looks like their neighbors...this may be a good alternative for some of your guests who have children or maybe want to save a little money. Its not all inclusive so Im not sure how much they would save..but some people like smaller numbers up front (even if they end up spending more later on)...<br \/> Just thought it might be useful info..<br \/> <br \/> heres their website <a href='http:\/\/www.laamadahotel.com' class='bbc_url' title='External link' rel='nofollow external'>Luxury Playa Mujeres & Cancun Hotels | La Amada Hotel, Playa Mujeres, Cancun, Mexico<\/a><br \/> <br \/> I also found this on expedia where you can map how close the resorts are:<br \/> <a href='http:\/\/www.expedia.com\/PlayaMujeres-Cancun-Hotels.0-n6085422-0.Travel-Guide-Filter-Hotels' class='bbc_url' title='External link' rel='nofollow external'>Playa Mujeres hotels in Cancun, Quintana Roo<\/a><br \/> <br \/> Trip Advisor has a lot of positive feedback as well.<br \/> <br \/> TTYL!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"yoliejimenez1976@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1243020069,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-217738.gif?_r=0","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"FormattedName":"Jewels336","Id":217738,"Name":"Jewels336","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"75663d1e96fa21a7a695c06c43e5a86d","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;Jewels336&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Hey girlies, \n been doing some research and I found a hotel La Amada on the same beach as EPM. Looks like their neighbors...this may be a good alternative for some of your guests who have children or maybe want to save a little money. Its not all inclusive so Im not sure how much they would save..but some people like smaller numbers up front (even if they end up spending more later on)...\n Just thought it might be useful info..\n \n heres their website &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.laamadahotel.com\"&gt;Luxury Playa Mujeres &amp;amp; Cancun Hotels | La Amada Hotel, Playa Mujeres, Cancun, Mexico&lt;\/a&gt;\n \n I also found this on expedia where you can map how close the resorts are:\n &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.expedia.com\/PlayaMujeres-Cancun-Hotels.0-n6085422-0.Travel-Guide-Filter-Hotels\"&gt;Playa Mujeres hotels in Cancun, Quintana Roo&lt;\/a&gt;\n \n Trip Advisor has a lot of positive feedback as well.\n \n TTYL!&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;Thanks!\n \n Two of my guests, with babies, are actually going to be staying here for our wedding so they can bring their children. They got a great rate - La Amada has a similar sale going on to Excellence Playa Mujeres right now.\n \n La Amada is also owned by The Excellence Group. I noticed the similiarity in decor to Excellence Playa Mujeres right away, didn&#039;t you? \n \n Some things I already asked in case any of you are interested:\n \n 1. No, they will not waive the day pass fee for guests staying at La Amada. neother the special wedding day pass fee of $70 p person or the regular day pass fee of $100 p person.\n \n 2. La Amada offers babysitting services at the rate of $20 usd for one child, $30 USD per hour for 2 children, $40 USD for 3 children, etc, etc.\n \n 3. La Amada is only a short beach walk away from EPM - about 2-3 minutes, and only 1\/2 mile away by road.\n \n 4. Yamina Bermudez is the wedding coordinator for La Amada in addition to her duties at Excellence Playa Muejres.","Attachments":[],"Id":730412,"PostDate":1245458921,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>Jewels336<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Hey girlies, <br \/> been doing some research and I found a hotel La Amada on the same beach as EPM. Looks like their neighbors...this may be a good alternative for some of your guests who have children or maybe want to save a little money. Its not all inclusive so Im not sure how much they would save..but some people like smaller numbers up front (even if they end up spending more later on)...<br \/> Just thought it might be useful info..<br \/> <br \/> heres their website <a href='http:\/\/www.laamadahotel.com' class='bbc_url' title='External link' rel='nofollow external'>Luxury Playa Mujeres & Cancun Hotels | La Amada Hotel, Playa Mujeres, Cancun, Mexico<\/a><br \/> <br \/> I also found this on expedia where you can map how close the resorts are:<br \/> <a href='http:\/\/www.expedia.com\/PlayaMujeres-Cancun-Hotels.0-n6085422-0.Travel-Guide-Filter-Hotels' class='bbc_url' title='External link' rel='nofollow external'>Playa Mujeres hotels in Cancun, Quintana Roo<\/a><br \/> <br \/> Trip Advisor has a lot of positive feedback as well.<br \/> <br \/> TTYL!<\/div> <\/td> <\/tr> <\/table> <\/div>Thanks!<br \/> <br \/> Two of my guests, with babies, are actually going to be staying here for our wedding so they can bring their children. They got a great rate - La Amada has a similar sale going on to Excellence Playa Mujeres right now.<br \/> <br \/> La Amada is also owned by The Excellence Group. I noticed the similiarity in decor to Excellence Playa Mujeres right away, didn't you? <br \/> <br \/> Some things I already asked in case any of you are interested:<br \/> <br \/> 1. No, they will not waive the day pass fee for guests staying at La Amada. neother the special wedding day pass fee of $70 p person or the regular day pass fee of $100 p person.<br \/> <br \/> 2. La Amada offers babysitting services at the rate of $20 usd for one child, $30 USD per hour for 2 children, $40 USD for 3 children, etc, etc.<br \/> <br \/> 3. La Amada is only a short beach walk away from EPM - about 2-3 minutes, and only 1\/2 mile away by road.<br \/> <br \/> 4. Yamina Bermudez is the wedding coordinator for La Amada in addition to her duties at Excellence Playa Muejres.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i30.photobucket.com\/albums\/c336\/dmbstolio\/Dec122009238-1.jpg\">http:\/\/i30.photobucket.com\/albums\/c3...22009238-1.jpg<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/www.jenandken2009.com\">www.jenandken2009.com<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;130\/st\/20091212\/e\/Jen+%26amp%3B+Kenny%27s+wedding\/k\/02c3\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...02c3\/event.png<\/a><\/div><\/div>","Email":"davis1974@gmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1215061237,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-210302.gif?_r=0","PhotoWidth":98,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Jennifer Davis","Id":210302,"Name":"Jennifer Davis","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"828d16bdbef4168e4df379b5eb66f7e7","RawContent":"Hi Ladies!!!!!! I miss you guys!!! This place is absolutely breath taking! My wedding was the most beautiful day of my life and I had a great time! Yamina is great! She even did things that I didn&#039;t ask for free! So I know its a pain that she doesnt respond but there are a ton of weddings here everyday. She is very busy but very attentive once you&#039;re here. I will try to answer your questions when I get back.\n \n I noticed the posts about La Amada...it is a few feet away from building 8 so its a very good alternative. I met Yamina&#039;s boss too and she is nice. Well I gotta go but wanted to say hi. I&#039;ll post pics and a very detailed review when I get back home.\n \n ~Mesita","Attachments":[],"Id":731080,"PostDate":1245531259,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi Ladies!!!!!! I miss you guys!!! This place is absolutely breath taking! My wedding was the most beautiful day of my life and I had a great time! Yamina is great! She even did things that I didn't ask for free! So I know its a pain that she doesnt respond but there are a ton of weddings here everyday. She is very busy but very attentive once you're here. I will try to answer your questions when I get back.<br \/> <br \/> I noticed the posts about La Amada...it is a few feet away from building 8 so its a very good alternative. I met Yamina's boss too and she is nice. Well I gotta go but wanted to say hi. I'll post pics and a very detailed review when I get back home.<br \/> <br \/> ~Mesita\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Mesita and Durante<\/span><br><span>June 18, 2009<\/span><br><span>Excellence Playa Mujeres<\/span><br><br><span>My wedding review:<\/span><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t45032#post857892\">http:\/\/bestdestinationwedding.com\/fo...032#post857892<\/a><span>My wedding pro slideshow:<\/span><a data-ipb='nomediaparse' href=\"http:\/\/www.keithcephus.com\/mesita\">http:\/\/www.keithcephus.com\/mesita<\/a><a data-ipb='nomediaparse' href=\"http:\/\/www.ezticker.com\/ticker\/947\/192\/20090618\/Our+Swine+Flu+Free+Wedding%21\/ticker.png\">http:\/\/www.ezticker.com\/ticker\/947\/1...%21\/ticker.png<\/a><\/div><\/div>","Email":"mesita.simms@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1221110745,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211672.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Sensatori Bride","Id":211672,"Name":"Sensatori Bride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5164f8e666187002f38cda6e3a3e0592","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;Sensatori Bride&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Hi Ladies!!!!!! I miss you guys!!! This place is absolutely breath taking! My wedding was the most beautiful day of my life and I had a great time! Yamina is great! She even did things that I didn&#039;t ask for free! So I know its a pain that she doesnt respond but there are a ton of weddings here everyday. She is very busy but very attentive once you&#039;re here. I will try to answer your questions when I get back.\n \n I noticed the posts about La Amada...it is a few feet away from building 8 so its a very good alternative. I met Yamina&#039;s boss too and she is nice. Well I gotta go but wanted to say hi. I&#039;ll post pics and a very detailed review when I get back home.\n \n ~Mesita&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;Oh, I&#039;m so happy to hear, you had and excellent day at excellence. I couldn&#039;t be more happy for you. \n \n Lauren","Attachments":[],"Id":731284,"PostDate":1245564705,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>Sensatori Bride<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Hi Ladies!!!!!! I miss you guys!!! This place is absolutely breath taking! My wedding was the most beautiful day of my life and I had a great time! Yamina is great! She even did things that I didn't ask for free! So I know its a pain that she doesnt respond but there are a ton of weddings here everyday. She is very busy but very attentive once you're here. I will try to answer your questions when I get back.<br \/> <br \/> I noticed the posts about La Amada...it is a few feet away from building 8 so its a very good alternative. I met Yamina's boss too and she is nice. Well I gotta go but wanted to say hi. I'll post pics and a very detailed review when I get back home.<br \/> <br \/> ~Mesita<\/div> <\/td> <\/tr> <\/table> <\/div>Oh, I'm so happy to hear, you had and excellent day at excellence. I couldn't be more happy for you. <br \/> <br \/> Lauren\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/www.weddingcountdown.com\/ticker\/6qscsou.png\">http:\/\/www.weddingcountdown.com\/ticker\/6qscsou.png<\/a><br><span>[\/CENTER]<\/span><\/div><\/div>","Email":"reeveswedding@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1219377984,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211327.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"reevesbride","Id":211327,"Name":"reevesbride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b13b30e684fec50a0444184a6d264a60","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;Sensatori Bride&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Hi Ladies!!!!!! I miss you guys!!! This place is absolutely breath taking! My wedding was the most beautiful day of my life and I had a great time! Yamina is great! She even did things that I didn&#039;t ask for free! So I know its a pain that she doesnt respond but there are a ton of weddings here everyday. She is very busy but very attentive once you&#039;re here. I will try to answer your questions when I get back.\n \n I noticed the posts about La Amada...it is a few feet away from building 8 so its a very good alternative. I met Yamina&#039;s boss too and she is nice. Well I gotta go but wanted to say hi. I&#039;ll post pics and a very detailed review when I get back home.\n \n ~Mesita&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;Yay! So glad you are having so much fun! Excellent! ...no pun intended =0)","Attachments":[],"Id":731801,"PostDate":1245646440,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>Sensatori Bride<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Hi Ladies!!!!!! I miss you guys!!! This place is absolutely breath taking! My wedding was the most beautiful day of my life and I had a great time! Yamina is great! She even did things that I didn't ask for free! So I know its a pain that she doesnt respond but there are a ton of weddings here everyday. She is very busy but very attentive once you're here. I will try to answer your questions when I get back.<br \/> <br \/> I noticed the posts about La Amada...it is a few feet away from building 8 so its a very good alternative. I met Yamina's boss too and she is nice. Well I gotta go but wanted to say hi. I'll post pics and a very detailed review when I get back home.<br \/> <br \/> ~Mesita<\/div> <\/td> <\/tr> <\/table> <\/div>Yay! So glad you are having so much fun! Excellent! ...no pun intended =0)\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i30.photobucket.com\/albums\/c336\/dmbstolio\/Dec122009238-1.jpg\">http:\/\/i30.photobucket.com\/albums\/c3...22009238-1.jpg<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/www.jenandken2009.com\">www.jenandken2009.com<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;130\/st\/20091212\/e\/Jen+%26amp%3B+Kenny%27s+wedding\/k\/02c3\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...02c3\/event.png<\/a><\/div><\/div>","Email":"davis1974@gmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1215061237,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-210302.gif?_r=0","PhotoWidth":98,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Jennifer Davis","Id":210302,"Name":"Jennifer Davis","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b6ec81c023413f72af86a703d889542a","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;Jennifer Davis&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Thanks!\n \n Two of my guests, with babies, are actually going to be staying here for our wedding so they can bring their children. They got a great rate - La Amada has a similar sale going on to Excellence Playa Mujeres right now.\n \n La Amada is also owned by The Excellence Group. I noticed the similiarity in decor to Excellence Playa Mujeres right away, didn&#039;t you? \n \n Some things I already asked in case any of you are interested:\n \n 1. No, they will not waive the day pass fee for guests staying at La Amada. neother the special wedding day pass fee of $70 p person or the regular day pass fee of $100 p person.\n \n 2. La Amada offers babysitting services at the rate of $20 usd for one child, $30 USD per hour for 2 children, $40 USD for 3 children, etc, etc.\n \n 3. La Amada is only a short beach walk away from EPM - about 2-3 minutes, and only 1\/2 mile away by road.\n \n 4. Yamina Bermudez is the wedding coordinator for La Amada in addition to her duties at Excellence Playa Muejres.&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;Thanks for the info Jenn! I appreciate it. Funny you should mention the day pass, this was one of the questions I just presented to Yamina. I needed clarification on which fee applied on the wedding day for guests\/vendors coming into the resort. \n \n Poor Yamina, I guess I can understand why she takes so long to return emails...","Attachments":[],"Id":732178,"PostDate":1245681970,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>Jennifer Davis<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Thanks!<br \/> <br \/> Two of my guests, with babies, are actually going to be staying here for our wedding so they can bring their children. They got a great rate - La Amada has a similar sale going on to Excellence Playa Mujeres right now.<br \/> <br \/> La Amada is also owned by The Excellence Group. I noticed the similiarity in decor to Excellence Playa Mujeres right away, didn't you? <br \/> <br \/> Some things I already asked in case any of you are interested:<br \/> <br \/> 1. No, they will not waive the day pass fee for guests staying at La Amada. neother the special wedding day pass fee of $70 p person or the regular day pass fee of $100 p person.<br \/> <br \/> 2. La Amada offers babysitting services at the rate of $20 usd for one child, $30 USD per hour for 2 children, $40 USD for 3 children, etc, etc.<br \/> <br \/> 3. La Amada is only a short beach walk away from EPM - about 2-3 minutes, and only 1\/2 mile away by road.<br \/> <br \/> 4. Yamina Bermudez is the wedding coordinator for La Amada in addition to her duties at Excellence Playa Muejres.<\/div> <\/td> <\/tr> <\/table> <\/div>Thanks for the info Jenn! I appreciate it. Funny you should mention the day pass, this was one of the questions I just presented to Yamina. I needed clarification on which fee applied on the wedding day for guests\/vendors coming into the resort. <br \/> <br \/> Poor Yamina, I guess I can understand why she takes so long to return emails...\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"yoliejimenez1976@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1243020069,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-217738.gif?_r=0","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"FormattedName":"Jewels336","Id":217738,"Name":"Jewels336","IsOnline":false}}],"Pages":{"TotalItems":2874,"TotalPages":288,"CurrentPage":220,"NextPage":230,"PreviousPage":210,"LastPage":2870},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
