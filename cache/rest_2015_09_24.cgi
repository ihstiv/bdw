/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Missmissymac78","Id":284047,"Name":"Missmissymac78","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.87.30.156","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":false,"TopicId":79420,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6e505971f9a0e06e9a696da6e5a3dc88","RawContent":"[quote name=\"Missmissymac78\" post=\"1900854\" timestamp=\"1437501957\"]\nJust started searching for wedding locations and came across Kakua Beach Club ....anyone have any info or thoughts about this location?\n\nThanks \ud83d\ude04[\/quote]Hi i was wondering if you got some info i am stuck btw Kakua &amp;amp; Jellyfish..","Attachments":[],"Id":1905248,"PostDate":1443013372,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Missmissymac78, on 21 July 2015 - 11:05 AM, said:<\/p><div class='blockquote'><div class='quote'><p>Just started searching for wedding locations and came across Kakua Beach Club ....anyone have any info or thoughts about this location?<br><br>\nThanks \ud83d\ude04<\/p><\/div><\/div>\n<br>\nHi i was wondering if you got some info i am stuck btw Kakua & Jellyfish..\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"campos213@gmail.com","IpAddress":"66.87.9.162","GroupId":39,"GroupName":"Newbie","JoinDate":1441932857,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"RoxMario","Id":284764,"Name":"RoxMario","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"190.167.75.118","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79420,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"267cd93ebc80afde7ce7582cf4f9ac0b","RawContent":"&lt;p&gt;Welcome to our forum community, Missmissymac78, and Congrats on your upcoming dw!!! You&#039;ve come to the right place for great resources to help with your planning decisions, so well done already!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;For some added inspiration, here are some magical beach wedding moments that matter we captured in our beautiful Mayan Riviera - to ramp up your creative juices.....enjoy!!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;.....taken from our &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10150695320839487.414941.18683524486&amp;amp;type=3&#039;&gt;Cover Photos Album: &lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-iad3-1.xx.fbcdn.net\/hphotos-prn2\/t31.0-8\/10608633_10152626440284487_6175377033029663791_o.jpg\" alt=\"10608633_10152626440284487_6175377033029\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-iad3-1.xx.fbcdn.net\/hphotos-xat1\/t31.0-8\/10329825_10152586142924487_3450657429731469229_o.jpg\" alt=\"10329825_10152586142924487_3450657429731\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-iad3-1.xx.fbcdn.net\/hphotos-xlf1\/t31.0-8\/1618120_10152265848279487_1607472971_o.jpg\" alt=\"1618120_10152265848279487_1607472971_o.j\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Wishing you happy research, and all the best with your plans - cheers!!! team MTM :)&lt;\/p&gt;","Attachments":[],"Id":1905272,"PostDate":1443032518,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome to our forum community, Missmissymac78, and Congrats on your upcoming dw!!! You've come to the right place for great resources to help with your planning decisions, so well done already!<\/p>\n<p>\u00a0<\/p>\n<p>For some added inspiration, here are some magical beach wedding moments that matter we captured in our beautiful Mayan Riviera - to ramp up your creative juices.....enjoy!!!<\/p>\n<p>\u00a0<\/p>\n<p>.....taken from our <a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10150695320839487.414941.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>Cover Photos Album: <\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-iad3-1.xx.fbcdn.net\/hphotos-prn2\/t31.0-8\/10608633_10152626440284487_6175377033029663791_o.jpg\" alt=\"10608633_10152626440284487_6175377033029\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-iad3-1.xx.fbcdn.net\/hphotos-xat1\/t31.0-8\/10329825_10152586142924487_3450657429731469229_o.jpg\" alt=\"10329825_10152586142924487_3450657429731\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-iad3-1.xx.fbcdn.net\/hphotos-xlf1\/t31.0-8\/1618120_10152265848279487_1607472971_o.jpg\" alt=\"1618120_10152265848279487_1607472971_o.j\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>Wishing you happy research, and all the best with your plans - cheers!!! team MTM <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280214260,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}}],"Id":"79420","Title":"Kukua Beach Club Wedding Anyone?\ud83d\ude04","LastPostDate":1443032518},"Pages":{"TotalItems":3,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
