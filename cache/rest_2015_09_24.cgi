{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":12,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":1393,"MovedTo":null,"MovedOn":0,"FirstPostId":1895221,"Rating":0,"RatingHits":0,"Starter":{"Id":282964,"Name":"samwillow","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282964.jpg?_r=1431149209","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":true},"StartDate":1430669699,"LastPoster":{"Id":236302,"Name":"jaspbri0317","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-236302.jpg?_r=1429022808","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1895221,"PostDate":1430669699,"PostContent":"well, in this time. i dont know how to start my wedding planning. i discussed with my boyfriend a...","Author":{"Signature":"","Email":"samwillow39@gmail.com","IpAddress":"114.121.164.128","GroupId":39,"GroupName":"Newbie","JoinDate":1430668422,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282964.jpg?_r=1431149209","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"samwillow","Id":282964,"Name":"samwillow","IsOnline":true}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"114.121.164.128","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79144,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4c6dace72e1a2782722c4e68b6cdb050","RawContent":"&lt;p&gt;well, in this time. i dont know how to start my wedding planning. i discussed with my boyfriend about this, and he said that we must choose the concept. but i think it&#039;s not the first thing, i thinked we must know our budget and choose the number of guests, because we really2 need to prepare the all budget by ourself. thats no help from our parents. what do you think? can give us some idea?&lt;\/p&gt;","Attachments":[],"Id":1895221,"PostDate":1430669699,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>well, in this time. i dont know how to start my wedding planning. i discussed with my boyfriend about this, and he said that we must choose the concept. but i think it's not the first thing, i thinked we must know our budget and choose the number of guests, because we really2 need to prepare the all budget by ourself. thats no help from our parents. what do you think? can give us some idea?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"samwillow39@gmail.com","IpAddress":"114.121.164.128","GroupId":39,"GroupName":"Newbie","JoinDate":1430668422,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282964.jpg?_r=1431149209","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"samwillow","Id":282964,"Name":"samwillow","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"142.161.170.48","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79144,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6e1793dc9d303a7b3bb8c61edcefacb1","RawContent":"&lt;p&gt;Welcome to the forum, samwillow, and Congrats on your upcoming wedding!!! you&#039;ve come to the right place to get lots of great information, ideas, suggestions and support from everyone here - so well done on getting a good start already!&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Wishing you happy research, and all the best with your plans - cheers!!! team MTM :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;here are a few magical wedding \"moments that matter\" for added inspiration..taken from &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10153270894224487.1073741928.18683524486&amp;amp;type=3&#039;&gt;The RUI Palace Peninsula Cancun Wedding Album&lt;\/a&gt;...enjoy!&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord.xx.fbcdn.net\/hphotos-xta1\/t31.0-8\/1980358_10153270895379487_2144611720278088419_o.jpg\" alt=\"1980358_10153270895379487_21446117202780\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord.xx.fbcdn.net\/hphotos-xpa1\/t31.0-8\/11182657_10153270896109487_5614574020468908688_o.jpg\" alt=\"11182657_10153270896109487_5614574020468\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord.xx.fbcdn.net\/hphotos-xap1\/t31.0-8\/11136216_10153270897364487_782806863449110843_o.jpg\" alt=\"11136216_10153270897364487_7828068634491\"&gt;&lt;\/p&gt;","Attachments":[],"Id":1895226,"PostDate":1430676953,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome to the forum, samwillow, and Congrats on your upcoming wedding!!! you've come to the right place to get lots of great information, ideas, suggestions and support from everyone here - so well done on getting a good start already!\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Wishing you happy research, and all the best with your plans - cheers!!! team MTM <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>here are a few magical wedding \"moments that matter\" for added inspiration..taken from <a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10153270894224487.1073741928.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>The RUI Palace Peninsula Cancun Wedding Album<\/a>...enjoy!<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord.xx.fbcdn.net\/hphotos-xta1\/t31.0-8\/1980358_10153270895379487_2144611720278088419_o.jpg\" alt=\"1980358_10153270895379487_21446117202780\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord.xx.fbcdn.net\/hphotos-xpa1\/t31.0-8\/11182657_10153270896109487_5614574020468908688_o.jpg\" alt=\"11182657_10153270896109487_5614574020468\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord.xx.fbcdn.net\/hphotos-xap1\/t31.0-8\/11136216_10153270897364487_782806863449110843_o.jpg\" alt=\"11136216_10153270897364487_7828068634491\"><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280214260,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"76.119.165.154","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79144,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5d93653160b7b9e84531c6049c84e013","RawContent":"[quote name=\"samwillow\" post=\"1895221\" timestamp=\"1430666099\"]\nwell, in this time. i dont know how to start my wedding planning. i discussed with my boyfriend about this, and he said that we must choose the concept. but i think it&#039;s not the first thing, i thinked we must know our budget and choose the number of guests, because we really2 need to prepare the all budget by ourself. thats no help from our parents. what do you think? can give us some idea?[\/quote]Congratulations on your engagement!  I would recommend contacting a destination wedding travel agent.  They will give you lots of ideas and will provide you with a great deal of information.  :)","Attachments":[],"Id":1895230,"PostDate":1430679806,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>samwillow, on 03 May 2015 - 08:14 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>well, in this time. i dont know how to start my wedding planning. i discussed with my boyfriend about this, and he said that we must choose the concept. but i think it's not the first thing, i thinked we must know our budget and choose the number of guests, because we really2 need to prepare the all budget by ourself. thats no help from our parents. what do you think? can give us some idea?<\/p>\n<\/div>\n<\/div><\/div>\n<p>Congratulations on your engagement!\u00a0 I would recommend contacting a destination wedding travel agent.\u00a0 They will give you lots of ideas and will provide you with a great deal of information.\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"candice.french@gmail.com","IpAddress":"24.62.169.169","GroupId":39,"GroupName":"Newbie","JoinDate":1415124695,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280992.jpg?_r=1421507914","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"MissFrench","Id":280992,"Name":"MissFrench","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.155.94.124","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79144,"EditedBy":"<strong>Edited by TinkerSofi, 03 May 2015 - 01:15 PM.<\/strong>","EditDate":1430687745,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"f494a0604c26bc9f58355331572bca78","RawContent":"&lt;p&gt;I definitely think that setting the budget is the first thing and trying to work on a rough draft of your guestlist. This will give you an idea of what kind of wedding you will have and a general feel of what you&#039;re looking at and what kind of destination and resort you need to find. For example, if you have a small budget and a big guestlist you&#039;ll have to either cut the guestlist or you&#039;ll know that you&#039;re going to have to find a hotel with really reasonable prices for a wedding. Also, if you have a lot of guests you need to find a hotel that will be able to accommodate a wedding with that many people.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;In a way the budget affects the concept of your wedding because it will dictate how much you can spend on all the little extras. You can definitely have a rough idea of what you want and that&#039;s ok (it might help you narrow down some resorts), but keep in mind that you might change your mind a few times before settling on one concept :), especially once your find your venue. Ours sure did!&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Happy planning!&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1895233,"PostDate":1430687493,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I definitely think that setting the budget is the first thing and trying to work on a rough draft of your guestlist. This will give you an idea of what kind of wedding you will have and a general feel of what you're looking at and what kind of destination and resort you need to find. For example, if you have a small budget and a big guestlist you'll have to either cut the guestlist or you'll know that you're going to have to find a hotel with really reasonable prices for a wedding. Also, if you have a lot of guests you need to find a hotel that will be able to accommodate a wedding with that many people.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>In a way the budget affects the concept of your wedding because it will dictate how much you can spend on all the little extras. You can definitely have a rough idea of what you want and that's ok (it might help you narrow down some resorts), but keep in mind that you might change your mind a few times before settling on one concept <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>, especially once your find your venue. Ours sure did!\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Happy planning!\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<br><p><a data-ipb='nomediaparse' href='http:\/\/www.TickerFactory.com\/'><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;31;484\/st\/20150813\/e\/Wedding+time%21+\/dt\/-2\/k\/b92c\/event.png\" alt=\"event.png\"><\/a><\/p>\n<p style=\"text-align:center;\">\u00a0<\/p>\n<p style=\"text-align:center;\">\u00a0","Email":"sblopezb@gmail.com","IpAddress":"172.219.193.22","GroupId":42,"GroupName":"Sr. Member","JoinDate":1359766704,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265511.jpg?_r=1442890536","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"TinkerSofi","Id":265511,"Name":"TinkerSofi","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.15.187","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79144,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d9a0068cfdc7805b5e7566b6861c6756","RawContent":"&lt;p&gt;Congrats and welcome to the forum! Setting your budget is definitely a good place to start, but you will also need to figure out what kind of resort you want, and what your price point is for your guests. Definitely consult a destination wedding travel agent. They&#039;ll help you decide the where that works for your budget and that of your guests!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck and happy planning!&lt;\/p&gt;","Attachments":[],"Id":1895255,"PostDate":1430720671,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats and welcome to the forum! Setting your budget is definitely a good place to start, but you will also need to figure out what kind of resort you want, and what your price point is for your guests. Definitely consult a destination wedding travel agent. They'll help you decide the where that works for your budget and that of your guests!<\/p>\n<p>\u00a0<\/p>\n<p>Good luck and happy planning!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><em><span style=\"color:rgb(51,153,255);\">I'm lucky enough to say yes again....October 20, 2015\u00a0<\/span><\/em>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283462599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.51.43.112","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79144,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"9ae95c1a68448fdd0a5d67aefd1ae210","RawContent":"&lt;p&gt;Congrats on your engagement! You have definitely come to the right place when it comes to planning a destination wedding :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;For us, it was all about picking a general location to have our wedding first. Once we knew that we wanted to have our wedding in the Riviera Maya in Mexico, then we knew it was a matter of looking at venue options to get an idea of what pricing was like and what we wanted for our Wedding Day.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;If you are really open when it comes to location, a great way to narrow that down is to contact a travel agent to help give you recommendations on what pricing is like in the different areas when it comes to lodging and venue options. The BDW travel agency,&amp;nbsp;&lt;a  class=\"bbc_url\" href=\"https:\/\/www.wrighttravelagency.com\/go\/destination-wedding?lp-variation-id=0&amp;amp;title=Planning%20a%20Destination%20Wedding?&amp;amp;source=BDW&amp;amp;creative=WTA%20TB\" title=\"External link\"&gt;Wright Travel Agency&lt;\/a&gt;, is a great resource to turn to first! They&#039;ve worked with tons of brides on the forum and have lots of knowledge when it comes to DW locations ;) &amp;nbsp;&lt;span style=\"color:rgb(24,24,24);font-family:arial, helvetica, sans-serif;background-color:rgb(253,252,250);\"&gt;You can&amp;nbsp;&lt;\/span&gt;&lt;a  class=\"bbc_url\" href=\"http:\/\/www.wrighttravelagency.com\/leads\/inquiry\/\" title=\"External link\"&gt;contact them HERE!&lt;\/a&gt;&amp;nbsp;Good luck!!!&amp;nbsp; ;)&lt;\/p&gt;","Attachments":[],"Id":1895256,"PostDate":1430729165,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats on your engagement! You have definitely come to the right place when it comes to planning a destination wedding <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>For us, it was all about picking a general location to have our wedding first. Once we knew that we wanted to have our wedding in the Riviera Maya in Mexico, then we knew it was a matter of looking at venue options to get an idea of what pricing was like and what we wanted for our Wedding Day.<\/p>\n<p>\u00a0<\/p>\n<p>If you are really open when it comes to location, a great way to narrow that down is to contact a travel agent to help give you recommendations on what pricing is like in the different areas when it comes to lodging and venue options. The BDW travel agency,\u00a0<a href='https:\/\/www.wrighttravelagency.com\/go\/destination-wedding?lp-variation-id=0&title=Planning%20a%20Destination%20Wedding?&source=BDW&creative=WTA%20TB' class='bbc_url' title='External link' rel='nofollow external'>Wright Travel Agency<\/a>, is a great resource to turn to first! They've worked with tons of brides on the forum and have lots of knowledge when it comes to DW locations <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/> \u00a0<span  style=\"color:rgb(24,24,24);font-family:arial, helvetica, sans-serif;background-color:rgb(253,252,250)\">You can\u00a0<\/span><a href='http:\/\/www.wrighttravelagency.com\/leads\/inquiry\/' class='bbc_url' title='External link' rel='nofollow external'>contact them HERE!<\/a>\u00a0Good luck!!!\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-size:18px;\"><span style=\"font-family:georgia;\"><strong>MARIESAM SANCHEZ PHOTOGRAPHY<\/strong><\/span><\/span><br>\nWEBSITE: <a  class=\"bbc_url\" href=\"http:\/\/www.mariesamsanchez.com\">www.mariesamsanchez.com<\/a><br>\nBLOG: <a  class=\"bbc_url\" href=\"http:\/\/www.mariesamsanchezblog.com\">www.mariesamsanchez.com<\/a><a data-ipb='nomediaparse' href='http:\/\/www.mariesamsanchez.com\/blog'>\/blog<\/a><br>\nCONTACT ME: <a  class=\"bbc_email\" href=\"mailto:mariesam.sanchez@gmail.com?subject=BDW%20Inquiry\" title=\"E-mail Link\">mariesam.sanchez@gmail.com<\/a><br><br><img src=\"http:\/\/i287.photobucket.com\/albums\/ll150\/msam007562\/063cb5c8-dbda-4822-87fe-ba3c0ebcdb7f.jpg\" alt=\"063cb5c8-dbda-4822-87fe-ba3c0ebcdb7f.jpg\">","Email":"mariesam.sanchez@gmail.com","IpAddress":"74.100.61.37","GroupId":38,"GroupName":"Moderators","JoinDate":1285957945,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232833.jpg?_r=1422091823","PhotoWidth":200,"PhotoHeight":220,"PhotoType":"custom"},"FormattedName":"MarieSamSanchezPhoto","Id":232833,"Name":"MarieSamSanchezPhoto","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"143.58.161.6","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79144,"EditedBy":"<strong>Edited by JenniferH114, 04 May 2015 - 08:19 AM.<\/strong>","EditDate":1430756383,"EditReason":"","DeleteDate":0,"TotalLikes":3,"IsLiked":false,"PostKey":"5aa242d7b94e8657294312d9e5baf7bb","RawContent":"&lt;p&gt;&lt;span&gt;@&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/user\/282964-samwillow\/&#039; title=\"\"&gt;&lt;span&gt;samwillow&lt;\/span&gt;&lt;\/a&gt;&amp;nbsp;- Congratulations! In general, I would say there are a few things that you should start thinking about right away and those&amp;nbsp;are budget, estimated number of guests (even if you don&#039;t have a final guest list just yet) and general destination area (or if you even have a preference). &lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span&gt;For us, we knew right away that we&#039;d have around 30-40 guests, so researching resorts was most important to me. We also didn&#039;t really have a set budget; we just knew that we didn&#039;t want our guests paying above a certain amount for their trips. I do think contacting an experienced travel agent may help you, but I don&#039;t recommend going in completely blind. Do some research yourself prior to talking to an agent so that you have some ideas of your own.\n\n\nMany resorts change a per person fee for all guests over whatever number is included in your wedding package. For example, the wedding packages includes 20 people and you have to pay $50 per additional person. If you are going to have a really big wedding, just may sure your resort can accommodate that many people. Also, be mindful of what kinds of things are included in the weddings packages offered. Some places include more things than others, which can really affect your budget.&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1895278,"PostDate":1430756262,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span>@<a href='http:\/\/www.bestdestinationwedding.com\/user\/282964-samwillow\/' class='bbc_url' title=''><span>samwillow<\/span><\/a>\u00a0- Congratulations! In general, I would say there are a few things that you should start thinking about right away and those\u00a0are budget, estimated number of guests (even if you don't have a final guest list just yet) and general destination area (or if you even have a preference). <\/span><\/p>\n<p>\u00a0<\/p>\n<p><span>For us, we knew right away that we'd have around 30-40 guests, so researching resorts was most important to me. We also didn't really have a set budget; we just knew that we didn't want our guests paying above a certain amount for their trips. I do think contacting an experienced travel agent may help you, but I don't recommend going in completely blind. Do some research yourself prior to talking to an agent so that you have some ideas of your own.<br><br>\nMany resorts change a per person fee for all guests over whatever number is included in your wedding package. For example, the wedding packages includes 20 people and you have to pay $50 per additional person. If you are going to have a really big wedding, just may sure your resort can accommodate that many people. Also, be mindful of what kinds of things are included in the weddings packages offered. Some places include more things than others, which can really affect your budget.<\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jhowe114@gmail.com","IpAddress":"38.98.131.98","GroupId":40,"GroupName":"Jr. Member","JoinDate":1402429989,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278395.jpg?_r=1421871115","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"JenniferH114","Id":278395,"Name":"JenniferH114","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"162.134.72.6","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79144,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"19e05c8b562bd101a40395319f4df132","RawContent":"&lt;p&gt;read a LOT and learn your options :)&lt;\/p&gt;","Attachments":[],"Id":1895820,"PostDate":1431207103,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>read a LOT and learn your options <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div>\u00a0<\/div>\n<div>Check my planning thread:\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79170-azul-sensatori-april-2015-wedding-many-pics-and-planning-tips\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79170-azul-sensatori-april-2015-wedding-many-pics-and-planning-tips\/<\/a><\/div>\n<div><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10765;484\/st\/20150410\/e\/Our+Wedding+\/k\/3e00\/event.png\" alt=\"event.png\"><\/div>\n<div>[\/url]<\/div>\n","Email":"tkandlina@gmail.com","IpAddress":"162.134.72.5","GroupId":40,"GroupName":"Jr. Member","JoinDate":1396885157,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277499.jpg?_r=1431203346","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"linaco80","Id":277499,"Name":"linaco80","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"187.252.52.125","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79144,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"089becd8457c56105d47d162c2b7f0c2","RawContent":"[quote name=\"samwillow\" post=\"1895221\" timestamp=\"1430666099\"]\nwell, in this time. i dont know how to start my wedding planning. i discussed with my boyfriend about this, and he said that we must choose the concept. but i think it&#039;s not the first thing, i thinked we must know our budget and choose the number of guests, because we really2 need to prepare the all budget by ourself. thats no help from our parents. what do you think? can give us some idea?[\/quote]Hey samwillow,\n\ndraw up the guest lists and budget then find a travel agent, which you can sit down with to look at your options in terms of hotel.  then choose the hotel, then photographer. Dj  then decor then anything extra.\n\nHappy Planning","Attachments":[],"Id":1896246,"PostDate":1431583028,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>samwillow, on 03 May 2015 - 08:14 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>well, in this time. i dont know how to start my wedding planning. i discussed with my boyfriend about this, and he said that we must choose the concept. but i think it's not the first thing, i thinked we must know our budget and choose the number of guests, because we really2 need to prepare the all budget by ourself. thats no help from our parents. what do you think? can give us some idea?<\/p>\n<\/div>\n<\/div><\/div>\n<p>Hey samwillow,<\/p>\n<p>\u00a0<\/p>\n<p>draw up the guest lists and budget then find a travel agent, which you can sit down with to look at your options in terms of hotel. \u00a0then choose the hotel, then photographer. Dj \u00a0then decor then anything extra.<\/p>\n<p>\u00a0<\/p>\n<p>Happy Planning<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Dream Weddings Riviera Maya- We pay attention to your wishes and coordinate closely with you to ensure your wedding or event is planned to perfection!<\/p>\n<p>\u00a0<\/p>\n<p><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Dream Weddings Riviera Maya<\/span><\/span><\/span><br><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">weddingsinplayadelcarmen@gmail.com<\/span><\/span><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html'>http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html<\/a><\/p>\n<p>\u00a0<\/p>\n<p><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Happy Planning!<\/span><\/span><\/span><br><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Joyce<\/span><\/span><\/span><br>\n\u00a0","Email":"weddingsinplayadelcarmen@gmail.com","IpAddress":"187.252.44.28","GroupId":49,"GroupName":"Insiders","JoinDate":1326857987,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250090.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"dreamweddings","Id":250090,"Name":"dreamweddings","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.196.8.38","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79144,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d4ae809d1ff660720bfc7d1e3c1f2495","RawContent":"All great starting points. Look to see if resorts you are considering have your date available. Our date was determined by availability. Lots of promotions out there. We are doing Mexico so we didnt want to be too into hurricane season. Knowing your budget and guest list a b and c also helps. Like most brides here, our final bill came in higher than expected. Suprisingly, so did our guest list because we chose June as our date. Summer vacatiom in the states. We expected 40 guests and will be honored by 106! Your travel agent is huge!!! Mine is a pitbull (will gladly pass along her info) no nonsense. Easy to work with and found me what i think is the best value. DJ and photography will be big expense too","Attachments":[],"Id":1896432,"PostDate":1431732159,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                All great starting points. Look to see if resorts you are considering have your date available. Our date was determined by availability. Lots of promotions out there. We are doing Mexico so we didnt want to be too into hurricane season. Knowing your budget and guest list a b and c also helps. Like most brides here, our final bill came in higher than expected. Suprisingly, so did our guest list because we chose June as our date. Summer vacatiom in the states. We expected 40 guests and will be honored by 106! Your travel agent is huge!!! Mine is a pitbull (will gladly pass along her info) no nonsense. Easy to work with and found me what i think is the best value. DJ and photography will be big expense too\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"keredondo@gmail.com","IpAddress":"108.225.204.185","GroupId":39,"GroupName":"Newbie","JoinDate":1403649619,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278682.jpg?_r=1414954781","PhotoWidth":187,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"BecomingaRiggio","Id":278682,"Name":"BecomingaRiggio","IsOnline":false}}],"Id":"79144","Title":"First Thing In Planning The Wedding","LastPostDate":1433107966},"Pages":{"TotalItems":12,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
