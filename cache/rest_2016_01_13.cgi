Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":6,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":2245,"MovedTo":null,"MovedOn":0,"FirstPostId":1650464,"Rating":0,"RatingHits":0,"Starter":{"Id":258350,"Name":"Lmickwee","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-258350.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":113,"PhotoType":"custom"},"IsOnline":false},"StartDate":1344475217,"LastPoster":{"Id":275445,"Name":"DevinChantelle","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275445.jpeg?_r=0","PhotoWidth":100,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":86,"Preview":{"Id":1650464,"PostDate":1344475217,"PostContent":"Hey! Has anyone thought about having their wedding at Club Med Sandpiper Resort? I am looking in...","Author":{"Signature":"","Email":"Lmickwee766@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1343253340,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-258350.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"Lmickwee","Id":258350,"Name":"Lmickwee","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":68932,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9fe410b4622b5c1c11bc79098170d637","RawContent":"&lt;p&gt; Hey! Has anyone thought about having their wedding at Club Med Sandpiper Resort? I am looking into it, but have never been so I am wondering if anyone has ever been to a wedding there or has ever stayed there and could give me some advice?&lt;\/p&gt;","Attachments":[],"Id":1650464,"PostDate":1344475217,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hey! Has anyone thought about having their wedding at Club Med Sandpiper Resort? I am looking into it, but have never been so I am wondering if anyone has ever been to a wedding there or has ever stayed there and could give me some advice?<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Lmickwee766@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1343253340,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-258350.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"Lmickwee","Id":258350,"Name":"Lmickwee","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":68932,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0f746c8a75a416121baebdd9980f9c20","RawContent":"&lt;p&gt; &lt;span style=\"color:#1f497d;\"&gt;&lt;span style=\"font-family:calibri,sans-serif;\"&gt;&lt;span style=\"font-size:11.0pt;\"&gt;Hi. My fianc\u00a9 and I got married last fall in Sandpiper. The staff was amazing to deal with and the venue was gorgeous. We had our ceremony at the Gazebo overlooking the water. We picked an assortment of Hors D\u00e2\u20ac\u2122Oeuvres with an open bar to follow ceremony. We barely had time to taste the Hors D\u00e2\u20ac\u2122Oeuvres as we wanted to take advantage of the incredible Sunset. Our guests had no complaints. They loved the drinks and food for the cocktail hour. After the cocktail hour we had set up a private reception at the Riverside Restaurant where we had a few tables for our group of 60. We did amber lighting with very simple candlelit centerpieces. The coordinators from Imagine were outstanding. They really did grasp the simple vision I was looking for since we were on a tight budget. We chose the NY marinated steak with breaded shrimp which gave our guests options. Everyone really enjoyed the food. Once Dinner was over we had a DJ and Photobooth station. We partied until 12pm where some guests went back to their rooms after a long day and some of our younger party animals went to the club\/bar and apparently had a great time. &lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;\n &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1651084,"PostDate":1344612203,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <span  style=\"color:#1f497d\"><span  style=\"font-family:calibri,sans-serif\"><span  style=\"font-size:11.0pt\">Hi. My fianc\u00a9 and I got married last fall in Sandpiper. The staff was amazing to deal with and the venue was gorgeous. We had our ceremony at the Gazebo overlooking the water. We picked an assortment of Hors D\u00e2\u20ac\u2122Oeuvres with an open bar to follow ceremony. We barely had time to taste the Hors D\u00e2\u20ac\u2122Oeuvres as we wanted to take advantage of the incredible Sunset. Our guests had no complaints. They loved the drinks and food for the cocktail hour. After the cocktail hour we had set up a private reception at the Riverside Restaurant where we had a few tables for our group of 60. We did amber lighting with very simple candlelit centerpieces. The coordinators from Imagine were outstanding. They really did grasp the simple vision I was looking for since we were on a tight budget. We chose the NY marinated steak with breaded shrimp which gave our guests options. Everyone really enjoyed the food. Once Dinner was over we had a DJ and Photobooth station. We partied until 12pm where some guests went back to their rooms after a long day and some of our younger party animals went to the club\/bar and apparently had a great time. <\/span><\/span><\/span><br \/> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Jleon@ImagineVIP.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1344612104,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-259019.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"LoveBlissOcean","Id":259019,"Name":"LoveBlissOcean","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":68932,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"add7d5cd2a16189136861ff36c037df8","RawContent":"&lt;p&gt; Thank you SO much for your post, i cannot tell you how helpful it is! They have not been able to show me many pictures, but the wedding by the gazebo looks gorgeous, were you happy with it? They have a wedding package offer that is if yiu have a minimum of 20 guests staying 3nights or more, your wedding and 3 night stay for the bride and groom are free. Did you go wth a similar package? This package does not include a reception. I know that since it is an all-inclusive resort you could technically have your reception dinner at one of the restaurants where the food and alcohol is included, but they have quoted me a great price for a four hour private reception with open bar and 3 course meal and i would really love to have a private reception. They have not really shown me pictures, but did you like your reception venue? What month did you get married? Was the resort really crowded?&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; It is so good to finally find someone who has had their wedding at this resort and can vouch for it. I was a little apprehensive because i have never been to this resort, or any club med for that matter, so I have really no idea what to expect. I just know the price is right in our budget and i think my guests will love that it is all inclusive!&lt;\/p&gt;","Attachments":[],"Id":1652349,"PostDate":1344911596,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Thank you SO much for your post, i cannot tell you how helpful it is! They have not been able to show me many pictures, but the wedding by the gazebo looks gorgeous, were you happy with it? They have a wedding package offer that is if yiu have a minimum of 20 guests staying 3nights or more, your wedding and 3 night stay for the bride and groom are free. Did you go wth a similar package? This package does not include a reception. I know that since it is an all-inclusive resort you could technically have your reception dinner at one of the restaurants where the food and alcohol is included, but they have quoted me a great price for a four hour private reception with open bar and 3 course meal and i would really love to have a private reception. They have not really shown me pictures, but did you like your reception venue? What month did you get married? Was the resort really crowded?<\/p> <p> \u00a0<\/p> <p> It is so good to finally find someone who has had their wedding at this resort and can vouch for it. I was a little apprehensive because i have never been to this resort, or any club med for that matter, so I have really no idea what to expect. I just know the price is right in our budget and i think my guests will love that it is all inclusive!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Lmickwee766@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1343253340,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-258350.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"Lmickwee","Id":258350,"Name":"Lmickwee","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":68932,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fcf0e576496918182ae1510b168653ce","RawContent":"&lt;p&gt; I am considering having my 2014 wedding at Sandpiper as well. Thank you for recapping the wonderful experience you had.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Lmickwee - did you end up deciding on Sandpiper? If so - when is\/was your wedding? I&#039;d love to hear your experience as well. The more I hear the more comfortable I am booking this without ever seeing it. The control freak in me is tough to quiet down :)&lt;\/p&gt;","Attachments":[],"Id":1733128,"PostDate":1363186469,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I am considering having my 2014 wedding at Sandpiper as well. Thank you for recapping the wonderful experience you had.<\/p> <p> \u00a0<\/p> <p> Lmickwee - did you end up deciding on Sandpiper? If so - when is\/was your wedding? I'd love to hear your experience as well. The more I hear the more comfortable I am booking this without ever seeing it. The control freak in me is tough to quiet down <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kgtc.wedding@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1362512552,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-266932.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"tristanc","Id":266932,"Name":"tristanc","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":68932,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"26b51d14a5fe1e36d2ba852ca5291423","RawContent":"&lt;p&gt;I just had my Wedding at Sandpiper 10\/12\/2013. The Resort is absolutely AMAZING!!!!!!!! Our guest which was 120 people were impressed by the service and hospitality of club Med. They offer so many activities for your guest to partake or they can just relax under the sun in their beautiful newly renovated pool. The staff onsite&amp;nbsp;are so welcoming and always trying to assist you. Sandpiper is also super kid-friendly, which was one of my reasons we did it there. They have kid camp and kid shows that are amazing :) We did our wedding at the Gazebo and then our reception at the main dinner hall in a separate room and then we had the dancing at the Atlantic room. The food was YUMMY!!!! The only downfall which I will be truthful is the wedding coordinators company that you must go through to coordinate your wedding&amp;nbsp;wasn&#039;t pleased with their services. I recommend Sandpiper 120% 5 stars; the wedding company &amp;nbsp;not so much.&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;GOOD LUCK and Many blessings your way :)&lt;\/p&gt;","Attachments":[],"Id":1811025,"PostDate":1383321373,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I just had my Wedding at Sandpiper 10\/12\/2013. The Resort is absolutely AMAZING!!!!!!!! Our guest which was 120 people were impressed by the service and hospitality of club Med. They offer so many activities for your guest to partake or they can just relax under the sun in their beautiful newly renovated pool. The staff onsite\u00a0are so welcoming and always trying to assist you. Sandpiper is also super kid-friendly, which was one of my reasons we did it there. They have kid camp and kid shows that are amazing <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> We did our wedding at the Gazebo and then our reception at the main dinner hall in a separate room and then we had the dancing at the Atlantic room. The food was YUMMY!!!! The only downfall which I will be truthful is the wedding coordinators company that you must go through to coordinate your wedding\u00a0wasn't pleased with their services. I recommend Sandpiper 120% 5 stars; the wedding company \u00a0not so much.<\/p> <p>\u00a0<\/p> <p>GOOD LUCK and Many blessings your way <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lmart029@fiu.edu","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1383320864,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-274747.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"LMAbride","Id":274747,"Name":"LMAbride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":68932,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d58ec14091399291c9d1aa694f73f261","RawContent":"&lt;p&gt;Tristan what did you decide about Club Med? My fiance and I are thinking about getting &amp;nbsp;married there in September and we&#039;re having to sign our contract soon&lt;\/p&gt;","Attachments":[],"Id":1817888,"PostDate":1386015293,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Tristan what did you decide about Club Med? My fiance and I are thinking about getting \u00a0married there in September and we're having to sign our contract soon<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"devinchantelle@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1386015031,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275445.jpeg?_r=0","PhotoWidth":100,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"DevinChantelle","Id":275445,"Name":"DevinChantelle","IsOnline":false}}],"Id":"68932","Title":"Wedding at Club Med Sandpiper??","LastPostDate":1386015293},"Pages":{"TotalItems":6,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
