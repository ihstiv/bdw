hy ( <a data-ipb='nomediaparse' href='http:\/\/www.decordova.ca'>www.decordova.ca<\/a> )<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"emma.palmer@rogers.com","IpAddress":"67.17.215.182","GroupId":39,"GroupName":"Newbie","JoinDate":1419945157,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"emmapalmer","Id":281523,"Name":"emmapalmer","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.197.9.143","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78427,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"97f6ea17ad850d718404eecff6c78b02","RawContent":"All,\n\nI am new to this forum. \n\nI was hoping if you can help me with advise in planning a destination wedding in Cancun, Mexico. \n\n\nSo far, I&#039;m interested in three hotels. \n\n- Crown Paradise\n\n- Westin Laguna-mar\n\n- Royal Sands\n\n\nAny advise on how to get going on planning this wedding. \n\n\nTx \n\n\n\nSent from my iPad using Tapatalk","Attachments":[],"Id":1879250,"PostDate":1417150499,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                All,<br>\nI am new to this forum. <br>\nI was hoping if you can help me with advise in planning a destination wedding in Cancun, Mexico. <br><br>\nSo far, I'm interested in three hotels. <br>\n- Crown Paradise<br>\n- Westin Laguna-mar<br>\n- Royal Sands<