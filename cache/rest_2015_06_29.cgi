{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":2,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":164,"MovedTo":null,"MovedOn":0,"FirstPostId":1899337,"Rating":0,"RatingHits":0,"Starter":{"Id":283554,"Name":"Mickeyb","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1435282176,"LastPoster":{"Id":230711,"Name":"Moments That Matter","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1899337,"PostDate":1435282176,"PostContent":"Hey everyone.  So far this site has been amazing and super helpful and I am looking for some advi...","Author":{"Signature":"","Email":"bidlofs@gmail.com","IpAddress":"99.226.139.21","GroupId":39,"GroupName":"Newbie","JoinDate":1434417744,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Mickeyb","Id":283554,"Name":"Mickeyb","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"184.151.36.1","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79323,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8cba4837c4e5c2d6559a04d254d8526f","RawContent":"Hey everyone. \n\n\nSo far this site has been amazing and super helpful and I am looking for some advice. My fianc\u00e9 and I finally booked our date and venue and I am now onto photography and am having major dilemmas. \n\n\nSo photography is actually very important to me. It&#039;s something I love doing even though I&#039;m not good and something I love looking at. The way k see it is it&#039;s the only thing that&#039;s gonna last. That being said I&#039;m kinda stuck. I know I wanna bring my own photographer with to be safe on quality but here my troubles. \n\n\nI am in between two photographers \n\nWww.richardsmmanuel.com whose style I really like and he can do some awesome shots as well as under water shots he says. But he&#039;s around 5500 which is high..\n\n\nThan there&#039;s www.kesscreativestudios.com who is good but I dunno if it speaks to me as much but is only 2700 or so which is an awesome savings. \n\n\nOpinions?? Also what do you think of their photography. \n\n\nThanks everyone!!!!!","Attachments":[],"Id":1899337,"PostDate":1435282176,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hey everyone. <br><br>\nSo far this site has been amazing and super helpful and I am looking for some advice. My fianc\u00e9 and I finally booked our date and venue and I am now onto photography and am having major dilemmas. <br><br>\nSo photography is actually very important to me. It's something I love doing even though I'm not good and something I love looking at. The way k see it is it's the only thing that's gonna last. That being said I'm kinda stuck. I know I wanna bring my own photographer with to be safe on quality but here my troubles. <br><br>\nI am in between two photographers <br>\nWww.richardsmmanuel.com whose style I really like and he can do some awesome shots as well as under water shots he says. But he's around 5500 which is high..<br><br>\nThan there's www.kesscreativestudios.com who is good but I dunno if it speaks to me as much but is only 2700 or so which is an awesome savings. <br><br>\nOpinions?? Also what do you think of their photography. <br><br>\nThanks everyone!!!!! \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bidlofs@gmail.com","IpAddress":"99.226.139.21","GroupId":39,"GroupName":"Newbie","JoinDate":1434417744,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Mickeyb","Id":283554,"Name":"Mickeyb","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.70.175.68","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79323,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"d8d49acc974ac63c47dcc8f9539335c5","RawContent":"&lt;p&gt;Congrats on your upcoming dw Mickeyb and welcome to our forum community!!! As you&#039;ve already seen, there&#039;s lots of great info, advice and support here to help with your planning decisions.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;You&#039;re very right about the importance of wedding photos and how what&#039;s left after the party&#039;s over and your guests have gone home, are your memories and the photos that were captured. When you choose the right photographer, those images can bring you right back to those magical \"moments that matter\" to re-live all over again :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We just wanted to chime in and give you a word of caution re bringing in a photographer with you from home.&lt;\/p&gt;\n&lt;p&gt;\nIt is illegal for someone to come to Mexico and photograph a wedding without proper working papers. The same way people can not just travel to the USA or Canada and work. Cancun airport is aware of this and as you will see... scans all luggage arriving when you go through customs. People traveling with more than one camera will need to answer for the equipment. Im not trying to scare you... just give you the facts of working in a foreign country.&lt;\/p&gt;\n&lt;p&gt;\nMTM Studios understands the importance of working within a budget for most wedding couples, so has recently adjusted our&amp;nbsp; prices to accommodate couples who are working with a strict spending plan.&lt;\/p&gt;\n&lt;p&gt;Are you willing to risk the photographer you&#039;re bringing in with you - not being allowed to work in Mexico?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We&#039;re not suggesting you need to hire us.&lt;\/p&gt;\n&lt;p&gt;There are lots of wonderful professionals in our area who would do an amazing job of telling your Wedding Day Celebration in a photo story you&#039;ll cherish for a lifetime!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Here&#039;s a link to some reviews, giving wedding couples&#039; opinions about professional photographers in our area: &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/reviews\/c\/70-photographer-reviews\/&#039;&gt;Destination Wedding Photographer Reviews&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We wish you happy research, and all the best with your plans - cheers!!! team MTM :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;....here are some magical wedding \"moments that matter\" MTM has captured in our gorgeous Mayan Riviera, taken from our : &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10150695320839487.414941.18683524486&amp;amp;type=3&#039;&gt;Cover Photo Album&lt;\/a&gt; ....enjoy :)&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xtf1\/t31.0-8\/11427375_10153408854794487_4566310682341134022_o.jpg\" alt=\"11427375_10153408854794487_4566310682341\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xfa1\/t31.0-8\/1557351_10152516887594487_6618319857352960386_o.jpg\" alt=\"1557351_10152516887594487_66183198573529\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xpf1\/t31.0-8\/10514196_10152534166149487_1439571747332471489_o.jpg\" alt=\"10514196_10152534166149487_1439571747332\"&gt;&lt;\/p&gt;","Attachments":[],"Id":1899389,"PostDate":1435358886,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats on your upcoming dw Mickeyb and welcome to our forum community!!! As you've already seen, there's lots of great info, advice and support here to help with your planning decisions.<\/p>\n<p>\u00a0<\/p>\n<p>You're very right about the importance of wedding photos and how what's left after the party's over and your guests have gone home, are your memories and the photos that were captured. When you choose the right photographer, those images can bring you right back to those magical \"moments that matter\" to re-live all over again <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>We just wanted to chime in and give you a word of caution re bringing in a photographer with you from home.<\/p>\n<p>\nIt is illegal for someone to come to Mexico and photograph a wedding without proper working papers. The same way people can not just travel to the USA or Canada and work. Cancun airport is aware of this and as you will see... scans all luggage arriving when you go through customs. People traveling with more than one camera will need to answer for the equipment. Im not trying to scare you... just give you the facts of working in a foreign country.<\/p>\n<p>\nMTM Studios understands the importance of working within a budget for most wedding couples, so has recently adjusted our\u00a0 prices to accommodate couples who are working with a strict spending plan.<\/p>\n<p>Are you willing to risk the photographer you're bringing in with you - not being allowed to work in Mexico?<\/p>\n<p>\u00a0<\/p>\n<p>We're not suggesting you need to hire us.<\/p>\n<p>There are lots of wonderful professionals in our area who would do an amazing job of telling your Wedding Day Celebration in a photo story you'll cherish for a lifetime!<\/p>\n<p>\u00a0<\/p>\n<p>Here's a link to some reviews, giving wedding couples' opinions about professional photographers in our area: <a href='http:\/\/www.bestdestinationwedding.com\/reviews\/c\/70-photographer-reviews\/' class='bbc_url' title=''>Destination Wedding Photographer Reviews<\/a><\/p>\n<p>\u00a0<\/p>\n<p>We wish you happy research, and all the best with your plans - cheers!!! team MTM <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>....here are some magical wedding \"moments that matter\" MTM has captured in our gorgeous Mayan Riviera, taken from our : <a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10150695320839487.414941.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>Cover Photo Album<\/a> ....enjoy <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xtf1\/t31.0-8\/11427375_10153408854794487_4566310682341134022_o.jpg\" alt=\"11427375_10153408854794487_4566310682341\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xfa1\/t31.0-8\/1557351_10152516887594487_6618319857352960386_o.jpg\" alt=\"1557351_10152516887594487_66183198573529\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xpf1\/t31.0-8\/10514196_10152534166149487_1439571747332471489_o.jpg\" alt=\"10514196_10152534166149487_1439571747332\"><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280210660,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}}],"Id":"79323","Title":"Photography","LastPostDate":1435358886},"Pages":{"TotalItems":2,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
