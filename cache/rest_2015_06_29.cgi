atingHits":0,"Starter":{"Id":278581,"Name":"beckys98","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1419993046,"LastPoster":{"Id":282234,"Name":"LeighC","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":33,"Preview":{"Id":1881354,"PostDate":1419993046,"PostContent":"I FINALLY went dress shopping today for my June 11, 2015 wedding. Unfortunately, the bridal shops...","Author":{"Signature":"","Email":"rebecca.shaffer@gmail.com","IpAddress":"159.53.174.144","GroupId":40,"GroupName":"Jr. Member","JoinDate":1403116087,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"beckys98","Id":278581,"Name":"beckys98","IsOnline":false}},"Posts":[],"Id":"78522","Title":"Dress Dilemma - I Can't Try On The Dress!","LastPostDate":1429837845},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":8273,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":1125421,"MovedTo":null,"MovedOn":0,"FirstPostId":126,"Rating":0,"RatingHits":0,"Starter":{"Id":206701,"Name":"Jennifer","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206701.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"IsOnline":false},"StartDate":1158010732,"LastPoster":{"Id":278581,"Name":"beckys98","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bd