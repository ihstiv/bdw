{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":true,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":2,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":true,"Views":11,"MovedTo":null,"MovedOn":0,"FirstPostId":1899512,"Rating":0,"RatingHits":0,"Starter":{"Id":283749,"Name":"Sarahkey32","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":true},"StartDate":1435610798,"LastPoster":{"Id":277873,"Name":"calgarybride2015","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":true},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1899512,"PostDate":1435610798,"PostContent":"Hi all, new to the forum but looking for a little help from other women who are going through thi...","Author":{"Signature":"","Email":"chiodo4766@gmail.com","IpAddress":"166.137.244.49","GroupId":39,"GroupName":"Newbie","JoinDate":1435609956,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Sarahkey32","Id":283749,"Name":"Sarahkey32","IsOnline":true}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"166.137.244.49","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":false,"TopicId":79330,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6242c6e6faf506a2ba95d9cb1cfbae0d","RawContent":"Hi all, new to the forum but looking for a little help from other women who are going through this process too! We are planning our wedding in 6\/16 in Punta Cana and I&#039;m really stuck on invitations. We are booking through a travel agency and having our guests do the same, so we will be getting a wedding website through the agency. Do I need to send out save the dates and formal invitations when they really only need the date and the website?? In my head I think I can get away with a save the date type invitation with our website on it and since everyone will be booking far in advance the traditional invitation being sent out 8-10 weeks before the wedding seems useless to me. What has everyone else done?! Thanks!!!","Attachments":[],"Id":1899512,"PostDate":1435610798,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi all, new to the forum but looking for a little help from other women who are going through this process too! We are planning our wedding in 6\/16 in Punta Cana and I'm really stuck on invitations. We are booking through a travel agency and having our guests do the same, so we will be getting a wedding website through the agency. Do I need to send out save the dates and formal invitations when they really only need the date and the website?? In my head I think I can get away with a save the date type invitation with our website on it and since everyone will be booking far in advance the traditional invitation being sent out 8-10 weeks before the wedding seems useless to me. What has everyone else done?! Thanks!!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"chiodo4766@gmail.com","IpAddress":"166.137.244.49","GroupId":39,"GroupName":"Newbie","JoinDate":1435609956,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Sarahkey32","Id":283749,"Name":"Sarahkey32","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.146.146.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79330,"EditedBy":"<strong>Edited by calgarybride2015, Today, 01:04 PM.<\/strong>","EditDate":1435611881,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"69fefcf6335dfd852b109131a0a4d07a","RawContent":"Welcome and congrats on your wedding. \n\n\nWe also did a wedding website. To spread the news we did an invitation but not a STD. We sent our invites out mid May for our January wedding.  They were boarding passes and fairly basic in info as they were directed to the website on the invite itself. \n\n\nHere is a picture. \n\n\nSome brides do STD, some invites, some\n\nBoth, some do everything electronically. Anything goes :)\n\n\nHope that helps some. \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1899513,"PostDate":1435611819,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Welcome and congrats on your wedding. <br><br>\nWe also did a wedding website. To spread the news we did an invitation but not a STD. We sent our invites out mid May for our January wedding.  They were boarding passes and fairly basic in info as they were directed to the website on the invite itself. <br><br>\nHere is a picture. <a class='resized_img' rel='lightbox[1899513]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_06_2015\/post-277873-14356117972.jpg\" title=\"ImageUploadedByTapatalk1435611793.918202.jpg - Size: 224.45KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_06_2015\/post-277873-14356117972.jpg\" class='bbc_img linked-image' alt=\"ImageUploadedByTapatalk1435611793.918202.jpg\" \/><\/a>\n\n<br><br>\nSome brides do STD, some invites, some<br>\nBoth, some do everything electronically. Anything goes <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br><br>\nHope that helps some. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399428602,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":true}}],"Id":"79330","Title":"Invitations!","LastPostDate":1435611819},"Pages":{"TotalItems":2,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
