{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":1,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":647,"MovedTo":null,"MovedOn":0,"FirstPostId":1915218,"Rating":0,"RatingHits":0,"Starter":{"Id":287289,"Name":"u2bjohnson06","Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-287289.jpg?_r=1467833530","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"IsOnline":false},"StartDate":1470712065,"LastPoster":{"Id":287289,"Name":"u2bjohnson06","Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-287289.jpg?_r=1467833530","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":89,"Preview":{"Id":1915218,"PostDate":1470712065,"PostContent":"I am soooooo upset right now! I received a call from my wedding planner at Sandals Montego Bay tw...","Author":{"Signature":"<p>Counting down 10\/29\/16!! <img src='https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_emoticons\/default\/wub.png' class='bbc_emoticon' alt=':wub:' \/>\u00a0 <img src='https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_emoticons\/default\/biggrin.png' class='bbc_emoticon' alt=':D' \/>\u00a0 <img src='https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/>\u00a0 <img src='https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>","Email":"u2bjohnson06@yahoo.com","IpAddress":"99.144.138.87","GroupId":39,"GroupName":"Newbie","JoinDate":1467561667,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-287289.jpg?_r=1467833530","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"u2bjohnson06","Id":287289,"Name":"u2bjohnson06","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.144.138.87","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80238,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"505a583841cd880edf5b51f1c59aece2","RawContent":"&lt;p&gt;I am soooooo upset right now! I received a call from my wedding planner at Sandals Montego Bay two days ago advising me that Sandals no longer allow copy written music on my wedding video! Meaning, I can walk down the isle to \"our song\" but the video will not have ANY of our actual chosen music!! How can they do this? They provided me with a list of unknown songs and composers that sound like \"karaoke\" at best! OMG!!! This is horrible. My FI states we can just bring the DVD home and have it modified with our music. However, thats additional costs for us! &amp;nbsp;Has anyone else encountered this problem? I also advised her there is no way I will agree to that and asked for a manager to call me back. I haven&#039;t received a response as of yet. What are your thoughts?&lt;\/p&gt;","Attachments":[],"Id":1915218,"PostDate":1470712065,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I am soooooo upset right now! I received a call from my wedding planner at Sandals Montego Bay two days ago advising me that Sandals no longer allow copy written music on my wedding video! Meaning, I can walk down the isle to \"our song\" but the video will not have ANY of our actual chosen music!! How can they do this? They provided me with a list of unknown songs and composers that sound like \"karaoke\" at best! OMG!!! This is horrible. My FI states we can just bring the DVD home and have it modified with our music. However, thats additional costs for us! \u00a0Has anyone else encountered this problem? I also advised her there is no way I will agree to that and asked for a manager to call me back. I haven't received a response as of yet. What are your thoughts?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Counting down 10\/29\/16!! <img src='https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_emoticons\/default\/wub.png' class='bbc_emoticon' alt=':wub:' \/>\u00a0 <img src='https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_emoticons\/default\/biggrin.png' class='bbc_emoticon' alt=':D' \/>\u00a0 <img src='https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/>\u00a0 <img src='https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>","Email":"u2bjohnson06@yahoo.com","IpAddress":"99.144.138.87","GroupId":39,"GroupName":"Newbie","JoinDate":1467561667,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-287289.jpg?_r=1467833530","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"u2bjohnson06","Id":287289,"Name":"u2bjohnson06","IsOnline":false}}],"Id":"80238","Title":"Sandals Changed Video Packages Wont Allow My Personal Music!","LastPostDate":1470712065},"Pages":{"TotalItems":1,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
