{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":true,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":7,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":5517,"MovedTo":null,"MovedOn":0,"FirstPostId":731190,"Rating":0,"RatingHits":0,"Starter":{"Id":206696,"Name":"TammyWright","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"IsOnline":false},"StartDate":1245553731,"LastPoster":{"Id":284817,"Name":"kelbiiztd","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":28,"Preview":{"Id":731190,"PostDate":1245553731,"PostContent":"Hey Everyone,  Have you ever wondered who started and owns BDW?  The forum is owned and funded b...","Author":{"Signature":"<p><span style=\"font-family:arial, helvetica, sans-serif;\">Founder and Owner of BestDestinationWedding.com \u00a0\/ \u00a0<\/span><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/'><strong><span style=\"font-family:arial, helvetica, sans-serif;\">Bride & Groom Fly FREE Promotion<\/span><\/strong><\/a><\/p>\n<p>\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><a data-ipb='nomediaparse' href='https:\/\/www.wrighttravelagency.com\/go\/destination-wedding\/?source=EMLSIG'><strong><span style=\"color:#008080;\">Looking for a travel agency that specializes in Destination Weddings-CLICK HERE<\/span><\/strong><\/a><span style=\"color:#008080;\"><strong>?<\/strong> \u00a0We are an award winning travel agency and you can <\/span><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style=\"color:#008080;\">read our reviews\u00a0here.<\/span><\/a><\/strong><\/span><br>\n\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"color:#008080;\"><strong>Awards and recognition:\u00a0<\/strong><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Palace Resorts Winner \"Top Travel Agent\", \"Top Homebased Travel Agency\" PRO Platinum Agency (Top Award) \u00a0 \u00a0 | \u00a0 \u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">AMResorts Master Agent & Top Agency \u00a0<\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/68050-karisma-hotels-givc-and-gi-wedding-consultants-wright-travel-agency\/'><strong>Wright Travel & Karisma GIVC Benefits<\/strong><\/a><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Travel Impressions Best of the Best Globe Winner \u00a0 \u00a0| \u00a0 \u00a0\u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Apple Vacations Golden Apple Winner \u00a0<\/span><\/span><br><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17612\/sml_gallery_206696_17612_13451.png\" alt=\"sml_gallery_206696_17612_13451.png\"><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"> \u00a0 \u00a0<img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"font-size:14px;\"><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010'>Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><\/span><\/span><strong><span style=\"color:#b22222;\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a data-ipb='nomediaparse' href='mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com'>ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"admin@bestdestinationwedding.com","IpAddress":"71.202.225.11","GroupId":4,"GroupName":"Administrators","JoinDate":1137227820,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"FormattedName":"TammyWright","Id":206696,"Name":"TammyWright","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":38104,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bbff2ad7ac83867d23a4f83ad3482596","RawContent":"&lt;p&gt; Hey Everyone,\n \n Have you ever wondered who started and owns BDW?\n \n The forum is owned and funded by me and I also own Wright Travel Agency.\n \n If you need TA assistance, please contact me or one of the BDW specialists below. They have a lot of destination wedding experience from working with Wright Travel Agency and I am so excited that they will add their expertise and experience to the forum.\n \n &lt;strong&gt;Click here to contact any of us &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.wrighttravelagency.com\/leads\/inquiry\/\"&gt;Best Destination Wedding - Travel Agent Contact Form&lt;\/a&gt;&lt;\/strong&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;strong id=\"yui_3_7_3_1_1361302262031_803\" style=\"font-style: inherit; color: rgb(24, 24, 24); font-family: arial, helvetica, sans-serif; line-height: normal;\"&gt;&lt;span id=\"yui_3_7_3_1_1361302262031_809\" style=\"color: rgb(178, 34, 34);\"&gt;You can read some of our reviews here:&lt;\/span&gt;&amp;nbsp;&lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.bestdestinationwedding.com\/products\/wright-travel-agency-destination-wedding-and-honeymoon-specialists\"&gt;Wright Travel Agency ~ Destination Wedding Specialist Reviews HERE&lt;\/a&gt;&lt;\/strong&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;strong&gt;Here are some of the agents on BDW:&lt;\/strong&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;ul&gt; &lt;li&gt; &lt;strong id=\"yui_3_7_3_1_1361302262031_872\" style=\"font-style: inherit; color: rgb(24, 24, 24); font-family: arial, helvetica, sans-serif; line-height: normal; background-color: rgb(253, 252, 250);\"&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.bestdestinationwedding.com\/user\/tammy+host\"&gt;Tammy Host -&amp;nbsp;Founder and Owner of BDW&lt;\/a&gt;. &lt;\/strong&gt;&lt;span style=\"color: rgb(24, 24, 24); font-family: arial, helvetica, sans-serif; line-height: normal; background-color: rgb(253, 252, 250);\"&gt;&amp;nbsp;I got married at Dreams Los Cabos in 2006&lt;\/span&gt;&lt;\/li&gt; &lt;li&gt; &lt;span style=\"color: rgb(24, 24, 24); font-family: arial, helvetica, sans-serif; line-height: normal; background-color: rgb(253, 252, 250);\"&gt;&lt;strong&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.bestdestinationwedding.com\/u\/15081\/ta-wendy\"&gt;TA Wendy from Wright Travel:&lt;\/a&gt;&amp;nbsp;&lt;\/strong&gt;US Agency- Riviera Maya and Mexico Specialist&lt;\/span&gt;&lt;\/li&gt; &lt;li&gt; &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.bestdestinationwedding.com\/u\/29308\/ta-patty\"&gt;&lt;strong&gt;&lt;span style=\"color: rgb(24, 24, 24); font-family: arial, helvetica, sans-serif; line-height: normal; background-color: rgb(253, 252, 250);\"&gt;TA Patty&amp;nbsp;&lt;\/span&gt;&lt;span style=\"background-color: rgb(253, 252, 250); color: rgb(24, 24, 24); font-family: arial, helvetica, sans-serif; line-height: normal;\"&gt;from Wright Travel&lt;\/span&gt;&lt;\/strong&gt;&lt;\/a&gt;&lt;span style=\"background-color: rgb(253, 252, 250); color: rgb(24, 24, 24); font-family: arial, helvetica, sans-serif; line-height: normal;\"&gt;: US Agency- Dominican Republic Specialist&lt;\/span&gt;&lt;\/li&gt; &lt;li&gt; &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.bestdestinationwedding.com\/u\/49647\/ta-babs\"&gt;&lt;strong&gt;&lt;span style=\"color: rgb(24, 24, 24); font-family: arial, helvetica, sans-serif; line-height: normal; background-color: rgb(253, 252, 250);\"&gt;TA Babs&amp;nbsp;&lt;\/span&gt;&lt;span style=\"background-color: rgb(253, 252, 250); color: rgb(24, 24, 24); font-family: arial, helvetica, sans-serif; line-height: normal;\"&gt;from Wright Travel&lt;\/span&gt;&lt;\/strong&gt;&lt;\/a&gt;&lt;span style=\"background-color: rgb(253, 252, 250); color: rgb(24, 24, 24); font-family: arial, helvetica, sans-serif; line-height: normal;\"&gt;: US Agency -Jamaica and Caribbean Specialist&lt;\/span&gt;&lt;\/li&gt; &lt;li&gt; &lt;span style=\"background-color: rgb(253, 252, 250); color: rgb(24, 24, 24); font-family: arial, helvetica, sans-serif; line-height: normal;\"&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.bestdestinationwedding.com\/u\/39213\/jessica4luxe\"&gt;&lt;strong&gt;Jessica from Luxe&lt;\/strong&gt;&lt;\/a&gt;: Canadian Agency&lt;\/span&gt;&lt;\/li&gt; &lt;li&gt; &lt;span style=\"background-color: rgb(253, 252, 250); color: rgb(24, 24, 24); font-family: arial, helvetica, sans-serif; line-height: normal;\"&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.bestdestinationwedding.com\/u\/67739\/jilltran\"&gt;&lt;strong&gt;Jill Tran from Blue Petal&lt;\/strong&gt;&lt;\/a&gt;: Canadian Agency&lt;\/span&gt;&lt;\/li&gt; &lt;\/ul&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"line-height: 1.231;\"&gt;Please feel free to pick their brain or PM them if you need any help planning the travel portion of your wedding.&lt;\/span&gt;\n \n &lt;strong&gt;Also, as a courtesy to me and the other TA&#039;s on the forum, if you are using another TA, you are welcome to participate on the forum but please do not advertise or solicit for your TA either on the forum or via PM. If it is found that you have done so, you may lose forum priviledges.&lt;\/strong&gt;\n \n &lt;img alt=\"\" border=\"0\" class=\"inlineimg\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/grouphug.gif\" title=\"Grouphug\" \/&gt;&lt;\/p&gt;","Attachments":[],"Id":731190,"PostDate":1245553731,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hey Everyone,<br \/> <br \/> Have you ever wondered who started and owns BDW?<br \/> <br \/> The forum is owned and funded by me and I also own Wright Travel Agency.<br \/> <br \/> If you need TA assistance, please contact me or one of the BDW specialists below. They have a lot of destination wedding experience from working with Wright Travel Agency and I am so excited that they will add their expertise and experience to the forum.<br \/> <br \/> <strong>Click here to contact any of us <a href='http:\/\/www.wrighttravelagency.com\/leads\/inquiry\/' class='bbc_url' title='External link' rel='nofollow external'>Best Destination Wedding - Travel Agent Contact Form<\/a><\/strong><\/p> <p> \u00a0<\/p> <p> <strong id=\"yui_3_7_3_1_1361302262031_803\" style=\"font-style: inherit; color: rgb(24, 24, 24); font-family: arial, helvetica, sans-serif; line-height: normal;\"><span id=\"yui_3_7_3_1_1361302262031_809\"  style=\"color: rgb(178, 34, 34)\">You can read some of our reviews here:<\/span>\u00a0<a href='http:\/\/www.bestdestinationwedding.com\/products\/wright-travel-agency-destination-wedding-and-honeymoon-specialists' class='bbc_url' title=''>Wright Travel Agency ~ Destination Wedding Specialist Reviews HERE<\/a><\/strong><\/p> <p> \u00a0<\/p> <p> <strong>Here are some of the agents on BDW:<\/strong><\/p> <p> \u00a0<\/p> <ul> <li> <strong id=\"yui_3_7_3_1_1361302262031_872\" style=\"font-style: inherit; color: rgb(24, 24, 24); font-family: arial, helvetica, sans-serif; line-height: normal; background-color: rgb(253, 252, 250);\"><a href='http:\/\/www.bestdestinationwedding.com\/user\/tammy+host' class='bbc_url' title=''>Tammy Host -\u00a0Founder and Owner of BDW<\/a>. <\/strong><span  style=\"color: rgb(24, 24, 24);font-family: arial, helvetica, sans-serif;background-color: rgb(253, 252, 250)\">\u00a0I got married at Dreams Los Cabos in 2006<\/span><\/li> <li> <span  style=\"color: rgb(24, 24, 24);font-family: arial, helvetica, sans-serif;background-color: rgb(253, 252, 250)\"><strong><a href='http:\/\/www.bestdestinationwedding.com\/u\/15081\/ta-wendy' class='bbc_url' title=''>TA Wendy from Wright Travel:<\/a>\u00a0<\/strong>US Agency- Riviera Maya and Mexico Specialist<\/span><\/li> <li> <a href='http:\/\/www.bestdestinationwedding.com\/u\/29308\/ta-patty' class='bbc_url' title=''><strong><span  style=\"color: rgb(24, 24, 24);font-family: arial, helvetica, sans-serif;background-color: rgb(253, 252, 250)\">TA Patty\u00a0<\/span><span  style=\"background-color: rgb(253, 252, 250);color: rgb(24, 24, 24);font-family: arial, helvetica, sans-serif\">from Wright Travel<\/span><\/strong><\/a><span  style=\"background-color: rgb(253, 252, 250);color: rgb(24, 24, 24);font-family: arial, helvetica, sans-serif\">: US Agency- Dominican Republic Specialist<\/span><\/li> <li> <a href='http:\/\/www.bestdestinationwedding.com\/u\/49647\/ta-babs' class='bbc_url' title=''><strong><span  style=\"color: rgb(24, 24, 24);font-family: arial, helvetica, sans-serif;background-color: rgb(253, 252, 250)\">TA Babs\u00a0<\/span><span  style=\"background-color: rgb(253, 252, 250);color: rgb(24, 24, 24);font-family: arial, helvetica, sans-serif\">from Wright Travel<\/span><\/strong><\/a><span  style=\"background-color: rgb(253, 252, 250);color: rgb(24, 24, 24);font-family: arial, helvetica, sans-serif\">: US Agency -Jamaica and Caribbean Specialist<\/span><\/li> <li> <span  style=\"background-color: rgb(253, 252, 250);color: rgb(24, 24, 24);font-family: arial, helvetica, sans-serif\"><a href='http:\/\/www.bestdestinationwedding.com\/u\/39213\/jessica4luxe' class='bbc_url' title=''><strong>Jessica from Luxe<\/strong><\/a>: Canadian Agency<\/span><\/li> <li> <span  style=\"background-color: rgb(253, 252, 250);color: rgb(24, 24, 24);font-family: arial, helvetica, sans-serif\"><a href='http:\/\/www.bestdestinationwedding.com\/u\/67739\/jilltran' class='bbc_url' title=''><strong>Jill Tran from Blue Petal<\/strong><\/a>: Canadian Agency<\/span><\/li> <\/ul> <p> \u00a0<\/p> <p> <span>Please feel free to pick their brain or PM them if you need any help planning the travel portion of your wedding.<\/span><br \/> <br \/> <strong>Also, as a courtesy to me and the other TA's on the forum, if you are using another TA, you are welcome to participate on the forum but please do not advertise or solicit for your TA either on the forum or via PM. If it is found that you have done so, you may lose forum priviledges.<\/strong><br \/> <br \/> <span rel='lightbox'><img class='bbc_img' alt=\"\" border=\"0\" class=\"inlineimg\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/grouphug.gif\" title=\"Grouphug\" \/><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-family:arial, helvetica, sans-serif;\">Founder and Owner of BestDestinationWedding.com \u00a0\/ \u00a0<\/span><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/'><strong><span style=\"font-family:arial, helvetica, sans-serif;\">Bride & Groom Fly FREE Promotion<\/span><\/strong><\/a><\/p>\n<p>\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><a data-ipb='nomediaparse' href='https:\/\/www.wrighttravelagency.com\/go\/destination-wedding\/?source=EMLSIG'><strong><span style=\"color:#008080;\">Looking for a travel agency that specializes in Destination Weddings-CLICK HERE<\/span><\/strong><\/a><span style=\"color:#008080;\"><strong>?<\/strong> \u00a0We are an award winning travel agency and you can <\/span><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style=\"color:#008080;\">read our reviews\u00a0here.<\/span><\/a><\/strong><\/span><br>\n\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"color:#008080;\"><strong>Awards and recognition:\u00a0<\/strong><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Palace Resorts Winner \"Top Travel Agent\", \"Top Homebased Travel Agency\" PRO Platinum Agency (Top Award) \u00a0 \u00a0 | \u00a0 \u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">AMResorts Master Agent & Top Agency \u00a0<\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/68050-karisma-hotels-givc-and-gi-wedding-consultants-wright-travel-agency\/'><strong>Wright Travel & Karisma GIVC Benefits<\/strong><\/a><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Travel Impressions Best of the Best Globe Winner \u00a0 \u00a0| \u00a0 \u00a0\u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Apple Vacations Golden Apple Winner \u00a0<\/span><\/span><br><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17612\/sml_gallery_206696_17612_13451.png\" alt=\"sml_gallery_206696_17612_13451.png\"><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"> \u00a0 \u00a0<img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"font-size:14px;\"><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010'>Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><\/span><\/span><strong><span style=\"color:#b22222;\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a data-ipb='nomediaparse' href='mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com'>ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"admin@bestdestinationwedding.com","IpAddress":"71.202.225.11","GroupId":4,"GroupName":"Administrators","JoinDate":1137227820,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r