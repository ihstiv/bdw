p:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206965.gif?_r=0","PhotoWidth":100,"PhotoHeight":67,"PhotoType":"custom"},"FormattedName":"Christine","Id":206965,"Name":"Christine","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":6365,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7ad8ec8025aacabfb7ab37e041a1946e","RawContent":"If I add correctly about $105, with shipping... not too shabby","Attachments":[],"Id":108063,"PostDate":1189561457,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                If I add correctly about $105, with shipping... not too shabby\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<a class='bbc_url' href='http:\/\/i641.photobucket.com\/albums\/uu135\/dieselpug\/AdamMay2010226-1.jpg'>http:\/\/i641.photobucket.com\/albums\/u...y2010226-1.jpg<\/a>","Email":"shelleyringrose@hotmail.com","IpAddress":"96.234.167.104","GroupId":46,"GroupName":"VIP Member","JoinDate":1181266560,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207447.jpg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"MsShelley","Id":207447,"Name":"MsShelley","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":6365,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0ec7c8cda581d019907be5651d635e24","RawContent":"just found one picture of the inserts ...\n \n &lt;img src=\"http:\/\/im1.shutterfly.com\/procserv\/47b7d622b3127cceb8e5ba17d59100000025100Abt2zdw3btmKg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;","Attachments":[],"Id":108064,"PostDate":1189561475,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                just found one picture of the inserts ...<br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/im1.shutterfly.com\/procserv\/47b7d622b3127cceb8e5ba17d59100000025100Abt2zdw3btmKg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<a class='bbc_url' href='http:\/\/bestdestinationwedding.com\/forum\/f77\/anns-annr-las-caletas-dreams-pv-hawaii-review-looooooong-6068\/'>Ann's Caletas Wedding & Hawaii Honeymoon Review<\/a><br \/>\n<a class='bbc_url' href='http:\/\/www.leighmillerphotography.com\/darkroom\/share\/?n=ann_paul'>Our Caletas Wedding Slideshow (by Leigh Miller)<\/a><br \/>\n<a class='bbc_url' href='http:\/\/www.onetruemedia.com\/shared?p=31de360c85cec8376c35a5&skin_id=701&utm_source=otm&utm_medium=image'>Our Caletas Wedding Video<\/a>","Email":"annkherrick@yahoo.com","IpAddress":"76.16.7.43","GroupId":46,"GroupName":"VIP Member","JoinDate":1161392880,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206863.jpg?_r=1429384252","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"LCBride2007","Id":206863,"Name":"LCBride2007","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":6365,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"25faa42b905668a31d91adb32a9118f5","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;Ryjaxs19&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;We spent way to much, the total was somewhere between $500-$550 for 75 invites including postage which looking back I should have gotten them cheaper. \n I was kind of in a jam and needed to order and get them out ASAP because our resort fills up so quickly and there are a few wedding the same week as mine. I spent a couple of hours looking on line and got so fed up that I said screw it and just went with the ones I thought looked nice, could fit all of our travel info on them, and were easiest to order online. \n I would not do this again though.&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;Where did you order them from? Do you still have the website info?\n \n &lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;naughie&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;we&#039;re doing message in a bottle invites...so far i&#039;d say about $140 for 60 glass invites and extra material (bottles, paper, sand, etc) to spare...shipping will be the rough part, but can&#039;t imagine costing more than $1.00\/invite.&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;\n Are you making them yourself?","Attachments":[],"Id":108065,"PostDate":1189561488,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>Ryjaxs19<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">We spent way to much, the total was somewhere between $500-$550 for 75 invites including postage which looking back I should have gotten them cheaper. <br \/> I was kind of in a jam and needed to order and get them out ASAP because our resort fills up so quickly and there are a few wedding the same week as mine. I spent a couple of hours looking on line and got so fed up that I said screw it and just went with the ones I thought looked nice, could fit all of our travel info on them, and were easiest to order online. <br \/> I would not do this again though.<\/div> <\/td> <\/tr> <\/table> <\/div>Where did you order them from? Do you still have the website info?<br \/> <br \/> <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>naughie<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">we're doing message in a bottle invites...so far i'd say about $140 for 60 glass invites and extra material (bottles, paper, sand, etc) to spare...shipping will be the rough part, but can't imagine costing more than $1.00\/invite.<\/div> <\/td> <\/tr> <\/table> <\/div><br \/> Are you making them yourself?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/www.JenandBrendanWedding.com\">Our Wedding Website<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t20073\">NYJen's Wedding Summary<\/a><\/div><\/div>","Email":"jenlmcf725@yahoo.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1181267196,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207448.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"NYJen","Id":207448,"Name":"NYJen","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":6365,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"934f66617c5992833a799ef1777304a8","RawContent":"Invitations: approx. $4.60 each, sent about 50\n \n STD&#039;s: around $8.00 each, send about 75...yup those were expensive","Attachments":[],"Id":108066,"PostDate":1189561500,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Invitations: approx. $4.60 each, sent about 50<br \/> <br \/> STD's: around $8.00 each, send about 75...yup those were expensive\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"aqharider@hotmail.com","IpAddress":"76.20.179.61","GroupId":46,"GroupName":"VIP Member","JoinDate":1154388180,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/9\/9f\/9fd8e240_user-274-avatar?_r=0","PhotoWidth":180,"PhotoHeight":120,"PhotoType":"custom"},"FormattedName":"Sarah","Id":206770,"Name":"Sarah","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":6365,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f5064eac11c4f8778d26c5d8f2e2d332","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;akh&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;i made them myself - so it&#039;s hard to total the cost. i bought the paper, envelopes, and stamps - it had to have been less than $100&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;i think i lied. it was probably closer to $150-200 after all the postage (to mail, and the return envelopes)","Attachments":[],"Id":108067,"PostDate":1189561562,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>akh<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">i made them myself - so it's hard to total the cost. i bought the paper, envelopes, and stamps - it had to have been less than $100<\/div> <\/td> <\/tr> <\/table> <\/div>i think i lied. it was probably closer to $150-200 after all the postage (to mail, and the return envelopes)\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<a class='bbc_url' href='http:\/\/bestdestinationwedding.com\/forum\/f77\/anns-annr-las-caletas-dreams-pv-hawaii-review-looooooong-6068\/'>Ann's Caletas Wedding & Hawaii Honeymoon Review<\/a><br \/>\n<a class='bbc_url' href='http:\/\/www.leighmillerphotography.com\/darkroom\/share\/?n=ann_paul'>Our Caletas Wedding Slideshow (by Leigh Miller)<\/a><br \/>\n<a class='bbc_url' href='http:\/\/www.onetruemedia.com\/shared?p=31de360c85cec8376c35a5&skin_id=701&utm_source=otm&utm_medium=image'>Our Caletas Wedding 