{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":4,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":558,"MovedTo":null,"MovedOn":0,"FirstPostId":1496595,"Rating":0,"RatingHits":0,"Starter":{"Id":243083,"Name":"anad1027","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-243083.jpeg?_r=0","PhotoWidth":143,"PhotoHeight":165,"PhotoType":"custom"},"IsOnline":false},"StartDate":1312220631,"LastPoster":{"Id":281796,"Name":"Sandraco8","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":23,"Preview":{"Id":1496595,"PostDate":1312220631,"PostContent":"Hi all! \u00a0I'm new here. \u00a0My fiance and I are looking to get married in Montego Bay, and we are po...","Author":{"Signature":"","Email":"dcavooris@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1312219172,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-243083.jpeg?_r=0","PhotoWidth":143,"PhotoHeight":165,"PhotoType":"custom"},"FormattedName":"anad1027","Id":243083,"Name":"anad1027","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62627,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"069508cea3223b4509f4254214581b0d","RawContent":"&lt;p&gt; Hi all! &amp;nbsp;I&#039;m new here. &amp;nbsp;My fiance and I are looking to get married in Montego Bay, and we are potentially interested in booking at the Hilton Rose Hall. &amp;nbsp;I sent an RFP last week, and still have not heard back. &amp;nbsp;I called today, and was told it&#039;s a national holiday in Jamaica. &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Does anyone happen to have the current event\/banquet menus for Hilton Rose Hall? &amp;nbsp;The only one I can find online is from November 2010, which is before the resort was completely all inclusive, so I&#039;m guessing the pricing has changed. &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Thanks!&lt;\/p&gt;","Attachments":[],"Id":1496595,"PostDate":1312220631,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hi all! \u00a0I'm new here. \u00a0My fiance and I are looking to get married in Montego Bay, and we are potentially interested in booking at the Hilton Rose Hall. \u00a0I sent an RFP last week, and still have not heard back. \u00a0I called today, and was told it's a national holiday in Jamaica. \u00a0<\/p> <p> \u00a0<\/p> <p> Does anyone happen to have the current event\/banquet menus for Hilton Rose Hall? \u00a0The only one I can find online is from November 2010, which is before the resort was completely all inclusive, so I'm guessing the pricing has changed. \u00a0<\/p> <p> \u00a0<\/p> <p> Thanks!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"dcavooris@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1312219172,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-243083.jpeg?_r=0","PhotoWidth":143,"PhotoHeight":165,"PhotoType":"custom"},"FormattedName":"anad1027","Id":243083,"Name":"anad1027","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62627,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5e68b7a1b34de08ff08f68fe22aa083d","RawContent":"&lt;p&gt; Anad1027,&lt;\/p&gt; &lt;p&gt; I&#039;m getting married at Hilton Rose Hall June 2012 and I&#039;m very excited about it. They have a AIP (all inclusive plan) menu for people that will be staying a the hotel and attending the wedding, but a different price for people who are not staying at the Hilton Rose Hall but attending the wedding reception.&amp;nbsp; Their price does not include taxes which is an additional 28%.&amp;nbsp; Their wedding package is a la carte which can be a pain in the but then you are trying to create a budget.&amp;nbsp; Just remember to ask your wedding coordinator whats included. It a beautiful property but can be costly for Bride and Wedding Guests.&lt;\/p&gt;","Attachments":[],"Id":1511838,"PostDate":1314469681,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Anad1027,<\/p> <p> I'm getting married at Hilton Rose Hall June 2012 and I'm very excited about it. They have a AIP (all inclusive plan) menu for people that will be staying a the hotel and attending the wedding, but a different price for people who are not staying at the Hilton Rose Hall but attending the wedding reception.\u00a0 Their price does not include taxes which is an additional 28%.\u00a0 Their wedding package is a la carte which can be a pain in the but then you are trying to create a budget.\u00a0 Just remember to ask your wedding coordinator whats included. It a beautiful property but can be costly for Bride and Wedding Guests.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lasmalling28@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1311989534,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-242979.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"Mona28","Id":242979,"Name":"Mona28","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"2.223.226.95","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62627,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d598043542b74e70350894d735e3b067","RawContent":"Hey everyone, I&#039;m new.\n\nMe and my partner are getting married in 2016. \n\nWe have chosen the Hilton rose hall resort.\n\nCan&#039;t decide on gazebo, beach, or aquaducts for the ceremony! \n\nWould love the actual rose hall great house but I&#039;ve heard it&#039;s $10000. Out of our price range.\n\nHoping to get some photos there though. \n\nIs anyone else getting married at the Hilton?x","Attachments":[],"Id":1881706,"PostDate":1420359929,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hey everyone, I'm new.<br>\nMe and my partner are getting married in 2016. <br>\nWe have chosen the Hilton rose hall resort.<br>\nCan't decide on gazebo, beach, or aquaducts for the ceremony! <br>\nWould love the actual rose hall great house but I've heard it's $10000. Out of our price range.<br>\nHoping to get some photos there though. <br>\nIs anyone else getting married at the Hilton?x\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"** Hilton Rose Hall, Jamaica Bride**","Email":"carmell787@googlemail.com","IpAddress":"2.127.231.148","GroupId":39,"GroupName":"Newbie","JoinDate":1420246395,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"carmell87","Id":281568,"Name":"carmell87","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.196.44.37","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":62627,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c90439618e9536f0dd6612fa71bacf5c","RawContent":"@[member=\"carmell87\"] I am getting married at the Hilton Rose Hall this October.  I will be visiting the resort in a few weeks and would be happy to answer any questions you may have.  We elected to get married at the beach and are planning a reception at the West Lawn Gazebo but I want to tour all of the options while we are there in case we want to make any changes.","Attachments":[],"Id":1890674,"PostDate":1427235957,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"281568\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281568-carmell87\/' title='Member profile'><span itemprop=\"name\">carmell87<\/span><\/a> I am getting married at the Hilton Rose Hall this October.  I will be visiting the resort in a few weeks and would be happy to answer any questions you may have.  We elected to get married at the beach and are planning a reception at the West Lawn Gazebo but I want to tour all of the options while we are there in case we want to make any changes. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sandra_co8@icloud.com","IpAddress":"50.162.188.193","GroupId":39,"GroupName":"Newbie","JoinDate":1421707270,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Sandraco8","Id":281796,"Name":"Sandraco8","IsOnline":false}}],"Id":"62627","Title":"Hilton Rose Hall","LastPostDate":1427235957},"Pages":{"TotalItems":4,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
