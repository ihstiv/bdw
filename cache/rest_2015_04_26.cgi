> Time: 1430055202 / Sun, 26 Apr 2015 13:33:22 +0000
> URL: /index.php?/REST/Forums/topic?startFromPostId=1828589&SessionId=46862390cfaf5a822152d5a00ed54c52
> User Jaycee31 (282805)
Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":106,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":true,"Views":14058,"MovedTo":null,"MovedOn":0,"FirstPostId":1828589,"Rating":0,"RatingHits":0,"Starter":{"Id":275352,"Name":"Francine Braham","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275352.jpg?_r=1430050176","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"StartDate":1390585291,"LastPoster":{"Id":275352,"Name":"Francine Braham","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275352.jpg?_r=1430050176","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":23,"Preview":{"Id":1828589,"PostDate":1390585291,"PostContent":"Hi,\u00a0 \u00a0 My name is Francine and I am getting married in my home island, Jamaica in June 2015. \u00a0I l...","Author":{"Signature":"","Email":"brahamf@student.wpunj.edu","IpAddress":"173.251.113.202","GroupId":39,"GroupName":"Newbie","JoinDate":1385514427,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275352.jpg?_r=1430050176","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"Francine Braham","Id":275352,"Name":"Francine Braham","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.251.113.202","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76118,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"38ca77ecb132106c1413104217f7abf1","RawContent":"&lt;p&gt;Hi,&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;My name is Francine and I am getting married in my home island, Jamaica in June 2015. &amp;nbsp;I live in NJ. I am so excited, but my fiance and I don&#039;t even know where to start. &amp;nbsp;We are going to Jamaica in March 2014 for vacation to try to visit a couple resorts and reserve a date for the wedding.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I read a lot of these posts and viewed a lot of beautiful pictures. We want a small wedding of 50 - 60 ppl. I like Sunset Beach resort because it seems to be affordable, but I also like Rosehall Beach Resort because their grounds are beautiful and spacious. &amp;nbsp;It seems to be more private.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Does anyone mind sharing how much they spent for their wedding? What were your big money items? Is it best to go with the resort for everything for the ceremony and reception? Or is it cheaper to get vendors outside the resort for things like decorations, flowers, DJ, photographer? Recommendations? I appreciate any feedback.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;When I go and come back I&#039;ll be sure to update on the forum.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thanks&amp;nbsp; :)&lt;\/p&gt;","Attachments":[],"Id":1828589,"PostDate":1390585291,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi,\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>My name is Francine and I am getting married in my home island, Jamaica in June 2015. \u00a0I live in NJ. I am so excited, but my fiance and I don't even know where to start. \u00a0We are going to Jamaica in March 2014 for vacation to try to visit a couple resorts and reserve a date for the wedding.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I read a lot of these posts and viewed a lot of beautiful pictures. We want a small wedding of 50 - 60 ppl. I like Sunset Beach resort because it seems to be affordable, but I also like Rosehall Beach Resort because their grounds are beautiful and spacious. \u00a0It seems to be more private.<\/p>\n<p>\u00a0<\/p>\n<p>Does anyone mind sharing how much they spent for their wedding? What were your big money items? Is it best to go with the resort for everything for the ceremony and reception? Or is it cheaper to get vendors outside the resort for things like decorations, flowers, DJ, photographer? Recommendations? I appreciate any feedback.<\/p>\n<p>\u00a0<\/p>\n<p>When I go and come back I'll be sure to update on the forum.<\/p>\n<p>\u00a0<\/p>\n<p>Thanks\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"brahamf@student.wpunj.edu","IpAddress":"173.251.113.202","GroupId":39,"GroupName":"Newbie","JoinDate":1385514427,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275352.jpg?_r=1430050176","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"Francine Braham","Id":275352,"Name":"Francine Braham","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"206.223.185.220","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76118,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"de2a793b169cafdf5fdc6e6d6d13ef87","RawContent":"&lt;p style=\"margin-left:40px;\"&gt;I would also highly recommend taking a look at Gran Bahia Principe Jamaica in Runaway Bay. it&#039;s beautiful and there is a huge forum on here of brides that have been married and are getting married there! I did in October 2011 and would recommend it to anyone!!&lt;\/p&gt;\n&lt;p style=\"margin-left:40px;\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"margin-left:40px;\"&gt;A lot of resorts are going to charging outside vendor fees and some are very high. I used Tai Flora in Ocho Rios for my flowers rather than the resort and I was thrilled with them! They did a great job! GBPJ does decorations for you but i know a LOT of brides bring their own chair sashes and so on if they have a specific colour preference. GBPJ also has it&#039;s own DJ that is available and you can rent out the restaurants for the entire evening so that you&#039;re completely private.&lt;\/p&gt;\n&lt;p style=\"margin-left:40px;\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"margin-left:40px;\"&gt;The outside vendor fee at GBPJ is high - $800 because they are trying to push their onsite photographer, who isn&#039;t actually very good from the reviews I&#039;ve seen. I would highly recommend Merrick Cousley - merrickcousley.com&amp;nbsp; He is a native that lives in Kingston and he will go pretty much anywhere on the island. He is easy to work with, quick to return emails and his work is beautiful. Depending on your budget, if you can get around the vendor fee somehow, he is well worth it.&lt;\/p&gt;\n&lt;p style=\"margin-left:40px;\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"margin-left:40px;\"&gt;Check out the forum and read through it. You&#039;ll find a ton of tips, pics and reviews and comments. Our wedding was our first time in Jamaica and we fell in love and very much want to go back. Good luck with your planning and enjoy!!&lt;\/p&gt;","Attachments":[],"Id":1828613,"PostDate":1390594851,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p  style=\"margin-left:40px\">I would also highly recommend taking a look at Gran Bahia Principe Jamaica in Runaway Bay. it's beautiful and there is a huge forum on here of brides that have been married and are getting married there! I did in October 2011 and would recommend it to anyone!!<\/p>\n<p  style=\"margin-left:40px\">\u00a0<\/p>\n<p  style=\"margin-left:40px\">A lot of resorts are going to charging outside vendor fees and some are very high. I used Tai Flora in Ocho Rios for my flowers rather than the resort and I was thrilled with them! They did a great job! GBPJ does decorations for you but i know a LOT of brides bring their own chair sashes and so on if they have a specific colour preference. GBPJ also has it's own DJ that is available and you can rent out the restaurants for the entire evening so that you're completely private.<\/p>\n<p  style=\"margin-left:40px\">\u00a0<\/p>\n<p  style=\"margin-left:40px\">The outside vendor fee at GBPJ is high - $800 because they are trying to push their onsite photographer, who isn't actually very good from the reviews I've seen. I would highly recommend Merrick Cousley - merrickcousley.com\u00a0 He is a native that lives in Kingston and he will go pretty much anywhere on the island. He is easy to work with, quick to return emails and his work is beautiful. Depending on your budget, if you can get around the vendor fee somehow, he is well worth it.<\/p>\n<p  style=\"margin-left:40px\">\u00a0<\/p>\n<p  style=\"margin-left:40px\">Check out the forum and read through it. You'll find a ton of tips, pics and reviews and comments. Our wedding was our first time in Jamaica and we fell in love and very much want to go back. Good luck with your planning and enjoy!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283458999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1426134867","PhotoWidth":668,"PhotoHeight":600,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"100.1.15.74","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76118,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"74f6b2d672d8eb13acd3f18f832dd22b","RawContent":"&lt;p&gt;Thank you for your response!! &amp;nbsp;I did not even consider that resort. &amp;nbsp;I will def check it out.&amp;nbsp;&lt;\/p&gt;\n\n&lt;p&gt;Did anyone have their wedding at a villa in Jamaica? &amp;nbsp;How did that work out for you?&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1828650,"PostDate":1390609132,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thank you for your response!! \u00a0I did not even consider that resort. \u00a0I will def check it out.\u00a0<\/p>\n<br \/><p>Did anyone have their wedding at a villa in Jamaica? \u00a0How did that work out for you?\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"brahamf@student.wpunj.edu","IpAddress":"173.251.113.202","GroupId":39,"GroupName":"Newbie","JoinDate":1385514427,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275352.jpg?_r=1430050176","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"Francine Braham","Id":275352,"Name":"Francine Braham","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.215.172.212","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76118,"EditedBy":"","EditDate":1413047895,"EditReason":"","DeleteDate":0,"TotalLikes":3,"IsLiked":false,"PostKey":"09fdfd4de8cfb96d7deccf202175f8c8","RawContent":"&lt;p&gt;Hello, just wanted to introduce myself. My name is Gigi and I&#039;m also having my dream wedding in June 2015!! My grandparents and father are from Jamaica, tho I have never been so I&#039;m super excited!!\n\nI&#039;m pretty sure I have decided on the Iberostar Rose Hall Suites. (IRHS) I have to accommodate kids so No Couples only resorts. Iberostar has three different resorts to choice from with different price points.&amp;nbsp;\n\nSorry I can&#039;t offer more help as I am just starting myself. Congratulations and Good luck on you planning process!!&lt;\/p&gt;","Attachments":[],"Id":1828668,"PostDate":1390619596,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello, just wanted to introduce myself. My name is Gigi and I'm also having my dream wedding in June 2015!! My grandparents and father are from Jamaica, tho I have never been so I'm super excited!!<br>\nI'm pretty sure I have decided on the Iberostar Rose Hall Suites. (IRHS) I have to accommodate kids so No Couples only resorts. Iberostar has three different resorts to choice from with different price points.\u00a0<br>\nSorry I can't offer more help as I am just starting myself. Congratulations and Good luck on you planning process!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ggray513@yahoo.com","IpAddress":"72.49.59.178","GroupId":39,"GroupName":"Newbie","JoinDate":1390156893,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276198.jpg?_r=1390624230","PhotoWidth":200,"PhotoHeight":215,"PhotoType":"custom"},"FormattedName":"DG315","Id":276198,"Name":"DG315","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"100.1.15.74","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76118,"EditedBy":"","EditDate":1413047876,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0ddb60142b884223eb5637f4ddb0e922","RawContent":"[quote name=\"DG315\" post=\"1828668\" timestamp=\"1390619596\"]\nHello, just wanted to introduce myself. My name is Gigi and I&#039;m also having my dream wedding in June 2015!! My grandparents and father are from Jamaica, tho I have never been so I&#039;m super excited!!\nI&#039;m pretty sure I have decided on the Iberostar Rose Hall Suites. (IRHS) I have to accommodate kids so No Couples only resorts. Iberostar has three different resorts to choice from with different price points. \nSorry I can&#039;t offer more help as I am just starting myself. Congratulations and Good luck on you planning process!![\/quote]\nThanks Gigi.  Most of my family is from Jamaica.  I have family in Jamaica so I am hoping that they have some connections, lol.  But I think I am going to have my wedding at a Villa instead.  Have close family and friends stay at the villa to split the cost of staying there.  And maybe also hire a wedding planner and different vendors for flowers, food, etc.  \n\nCongrats to you too and Good Luck!!","Attachments":[],"Id":1828844,"PostDate":1390709844,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>DG315, on 24 January 2014 - 07:13 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hello, just wanted to introduce myself. My name is Gigi and I'm also having my dream wedding in June 2015!! My grandparents and father are from Jamaica, tho I have never been so I'm super excited!!<br>\nI'm pretty sure I have decided on the Iberostar Rose Hall Suites. (IRHS) I have to accommodate kids so No Couples only resorts. Iberostar has three different resorts to choice from with different price points.\u00a0<br>\nSorry I can't offer more help as I am just starting myself. Congratulations and Good luck on you planning process!!<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>Thanks Gigi. \u00a0Most of my family is from Jamaica. \u00a0I have family in Jamaica so I am hoping that they have some connections, lol. \u00a0But I think I am going to have my wedding at a Villa instead. \u00a0Have close family and friends stay at the villa to split the cost of staying there. \u00a0And maybe also hire a wedding planner and different vendors for flowers, food, etc. \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Congrats to you too and Good Luck!!\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"brahamf@student.wpunj.edu","IpAddress":"173.251.113.202","GroupId":39,"GroupName":"Newbie","JoinDate":1385514427,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275352.jpg?_r=1430050176","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"Francine Braham","Id":275352,"Name":"Francine Braham","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.244.114.38","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76118,"EditedBy":"","EditDate":1413047859,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"069659b3ccb00d929148e78c8daa8708","RawContent":"[quote name=\"DG315\" post=\"1828668\" timestamp=\"1390619596\"]\nHello, just wanted to introduce myself. My name is Gigi and I&#039;m also having my dream wedding in June 2015!! My grandparents and father are from Jamaica, tho I have never been so I&#039;m super excited!!\nI&#039;m pretty sure I have decided on the Iberostar Rose Hall Suites. (IRHS) I have to accommodate kids so No Couples only resorts. Iberostar has three different resorts to choice from with different price points. \nSorry I can&#039;t offer more help as I am just starting myself. Congratulations and Good luck on you planning process!![\/quote]\nHi Gigi! We have also decided that we&#039;d like to do the Iberostar Rose Hall for our Apr 2015 wedding (great ratings, and we picked Jamaica so that we can hopefully do a Hindu ceremony), but we&#039;re just starting out too so I don&#039;t have much else to offer. But congrats to you and everyone else!","Attachments":[],"Id":1829027,"PostDate":1390794307,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>DG315, on 24 January 2014 - 07:13 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hello, just wanted to introduce myself. My name is Gigi and I'm also having my dream wedding in June 2015!! My grandparents and father are from Jamaica, tho I have never been so I'm super excited!!<br>\nI'm pretty sure I have decided on the Iberostar Rose Hall Suites. (IRHS) I have to accommodate kids so No Couples only resorts. Iberostar has three different resorts to choice from with different price points.\u00a0<br>\nSorry I can't offer more help as I am just starting myself. Congratulations and Good luck on you planning process!!<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>Hi Gigi! We have also decided that we'd like to do the Iberostar Rose Hall for our Apr 2015 wedding (great ratings, and we picked Jamaica so that we can hopefully do a Hindu ceremony), but we're just starting out too so I don't have much else to offer. But congrats to you and everyone else!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"smitha_r@yahoo.com","IpAddress":"99.244.114.38","GroupId":39,"GroupName":"Newbie","JoinDate":1389143480,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275928.jpg?_r=1403747949","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"mysticjade","Id":275928,"Name":"mysticjade","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.215.172.212","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76118,"EditedBy":"<strong>Edited by DG315, 27 January 2014 - 09:07 AM.<\/strong>","EditDate":1390842452,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"457d29a2acfb04aacae1e9d6ec5183ff","RawContent":"&lt;p&gt;Thanks @[member=\"mysticjade\"] Congrats to you also!! @[member=\"Francine\"] I really thought about that option too! I came across a beautiful one (I don&#039;t remember the name but I will look it up if&amp;nbsp;you want)&amp;nbsp;but it was a lil too remote\/total relaxation for me.&amp;nbsp;I need some action\/nightlife. Please let me know about them hookups if you come across some!?&amp;nbsp; ;) LOL  I hope your plans go smoothly and I look forward to seeing your future post.&lt;\/p&gt;","Attachments":[],"Id":1829110,"PostDate":1390842293,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thanks @<a hovercard-ref=\"member\" hovercard-id=\"275928\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/275928-mysticjade\/' title='Member profile'><span itemprop=\"name\">mysticjade<\/span><\/a> Congrats to you also!! @<a hovercard-ref=\"member\" hovercard-id=\"212362\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/212362-francine\/' title='Member profile'><span itemprop=\"name\">Francine<\/span><\/a> I really thought about that option too! I came across a beautiful one (I don't remember the name but I will look it up if\u00a0you want)\u00a0but it was a lil too remote\/total relaxation for me.\u00a0I need some action\/nightlife. Please let me know about them hookups if you come across some!?\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/> LOL\u00a0\u00a0I hope your plans go smoothly and I look forward to seeing your future post.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ggray513@yahoo.com","IpAddress":"72.49.59.178","GroupId":39,"GroupName":"Newbie","JoinDate":1390156893,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276198.jpg?_r=1390624230","PhotoWidth":200,"PhotoHeight":215,"PhotoType":"custom"},"FormattedName":"DG315","Id":276198,"Name":"DG315","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"100.1.15.74","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76118,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bea9ebf05a417f0562f362a4f15b3841","RawContent":"[quote name=\"DG315\" post=\"1829110\" timestamp=\"1390842293\"]\nThanks @[member=\"mysticjade\"] Congrats to you also!! @[member=\"Francine\"] I really thought about that option too! I came across a beautiful one (I don&#039;t remember the name but I will look it up if you want) but it was a lil too remote\/total relaxation for me. I need some action\/nightlife. Please let me know about them hookups if you come across some!?  ;) LOL  I hope your plans go smoothly and I look forward to seeing your future post.[\/quote]\n@DG3515 Lol, I most definitely will Gigi.  I go in March for 10 days, when I come back I will let you know. I know that in Jamaica some things are much cheaper for locals than \"foreigners\"\n\nI also look forward to your future posts as well.  I see lots of beautiful villas and have contacted the owners\/brokers.  We are hoping to get a villa in Montego Bay thats private but a close drive to the Hip Strip and nightlife action in Montego Bay. \n\nI&#039;m so excited!","Attachments":[],"Id":1829332,"PostDate":1390910253,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>DG315, on 27 January 2014 - 09:04 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Thanks @<a hovercard-ref=\"member\" hovercard-id=\"275928\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/275928-mysticjade\/' title='Member profile'><span itemprop=\"name\">mysticjade<\/span><\/a> Congrats to you also!! @<a hovercard-ref=\"member\" hovercard-id=\"212362\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/212362-francine\/' title='Member profile'><span itemprop=\"name\">Francine<\/span><\/a> I really thought about that option too! I came across a beautiful one (I don't remember the name but I will look it up if\u00a0you want)\u00a0but it was a lil too remote\/total relaxation for me.\u00a0I need some action\/nightlife. Please let me know about them hookups if you come across some!?\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/> LOL\u00a0\u00a0I hope your plans go smoothly and I look forward to seeing your future post.<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>@DG3515 Lol, I most definitely will Gigi. \u00a0I go in March for 10 days, when I come back I will let you know. I know that in Jamaica some things are much cheaper for locals than \"foreigners\"<\/p>\n<p>\u00a0<\/p>\n<p>I also look forward to your future posts as well. \u00a0I see lots of beautiful villas and have contacted the owners\/brokers. \u00a0We are hoping to get a villa in Montego Bay thats private but a close drive to the Hip Strip and nightlife action in Montego Bay.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I'm so excited!\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"brahamf@student.wpunj.edu","IpAddress":"173.251.113.202","GroupId":39,"GroupName":"Newbie","JoinDate":1385514427,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275352.jpg?_r=1430050176","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"Francine Braham","Id":275352,"Name":"Francine Braham","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"206.223.185.220","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76118,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"f285e9f30714c4151f0e0b74cd2a7fbe","RawContent":"&lt;p&gt;I think one of the best things is the anticipation! Then the countdown! Enjoy your planning! Have fun with it and above all, try very hard not to stress! The one over riding thing you will see on this forum is the brides that come back and tell everyone how beautiful it was and how easy. The wedding coordinators know what they&#039;re doing (or at least 95% of them lol) and these resorts do this kind of thing all the time. Your day will be wonderful! Good luck and congrats ladies! There are a ton of things to read through on this site so again, enjoy!!&lt;\/p&gt;","Attachments":[],"Id":1832031,"PostDate":1391624109,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I think one of the best things is the anticipation! Then the countdown! Enjoy your planning! Have fun with it and above all, try very hard not to stress! The one over riding thing you will see on this forum is the brides that come back and tell everyone how beautiful it was and how easy. The wedding coordinators know what they're doing (or at least 95% of them lol) and these resorts do this kind of thing all the time. Your day will be wonderful! Good luck and congrats ladies! There are a ton of things to read through on this site so again, enjoy!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283458999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1426134867","PhotoWidth":668,"PhotoHeight":600,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"100.1.15.74","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76118,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"47ddc0fde2e3ed6de1f030eabcba1c0e","RawContent":"[quote name=\"acw271011\" post=\"1832031\" timestamp=\"1391624109\"]\nI think one of the best things is the anticipation! Then the countdown! Enjoy your planning! Have fun with it and above all, try very hard not to stress! The one over riding thing you will see on this forum is the brides that come back and tell everyone how beautiful it was and how easy. The wedding coordinators know what they&#039;re doing (or at least 95% of them lol) and these resorts do this kind of thing all the time. Your day will be wonderful! Good luck and congrats ladies! There are a ton of things to read through on this site so again, enjoy!![\/quote]\nThanks! I have been looking through the forums trying to find a good wedding planner and other vendors.","Attachments":[],"Id":1834276,"PostDate":1392682937,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>acw271011, on 05 February 2014 - 10:15 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>I think one of the best things is the anticipation! Then the countdown! Enjoy your planning! Have fun with it and above all, try very hard not to stress! The one over riding thing you will see on this forum is the brides that come back and tell everyone how beautiful it was and how easy. The wedding coordinators know what they're doing (or at least 95% of them lol) and these resorts do this kind of thing all the time. Your day will be wonderful! Good luck and congrats ladies! There are a ton of things to read through on this site so again, enjoy!!<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>Thanks! I have been looking through the forums trying to find a good wedding planner and other vendors.\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"brahamf@student.wpunj.edu","IpAddress":"173.251.113.202","GroupId":39,"GroupName":"Newbie","JoinDate":1385514427,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275352.jpg?_r=1430050176","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"Francine Braham","Id":275352,"Name":"Francine Braham","IsOnline":false}}],"Id":"76118","Title":"2015 Jamaica Brides - Post Here! Lets Help Each Other :-)","LastPostDate":1428175222},"Pages":{"TotalItems":106,"TotalPages":11,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":100},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
