{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":18,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":4422,"MovedTo":null,"MovedOn":0,"FirstPostId":1137030,"Rating":0,"RatingHits":0,"Starter":{"Id":223717,"Name":"gigiram77","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223717.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"IsOnline":false},"StartDate":1272920525,"LastPoster":{"Id":281751,"Name":"deecol","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281751.jpg?_r=1443808962","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":32,"Preview":{"Id":1137030,"PostDate":1272920525,"PostContent":"Hello! My passport is valid but it expires withing 3 months of the date I'm traveling. I'm going...","Author":{"Signature":"","Email":"blackbetty2004@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1259945336,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223717.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"gigiram77","Id":223717,"Name":"gigiram77","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":51487,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"dc1565413045a0b3bd879f2fe8fe0ef1","RawContent":"Hello!\n My passport is valid but it expires withing 3 months of the date I&#039;m traveling. I&#039;m going to Meixco in October and my passport expires in January. Does anyone think that will be a problem? I&#039;ve tried to research it but most sites only state if it expires fairly recently, but 3 months is not too close to the date is it? Thanks for any info or direction you can point me to. \n gigi","Attachments":[],"Id":1137030,"PostDate":1272920525,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hello!<br \/> My passport is valid but it expires withing 3 months of the date I'm traveling. I'm going to Meixco in October and my passport expires in January. Does anyone think that will be a problem? I've tried to research it but most sites only state if it expires fairly recently, but 3 months is not too close to the date is it? Thanks for any info or direction you can point me to. <br \/> gigi\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"blackbetty2004@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1259945336,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223717.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"gigiram77","Id":223717,"Name":"gigiram77","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":51487,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"953b7bbad3a59a89d5bca1a9e1aa7b72","RawContent":"You will be totally fine. I used to work for Customs in Chicago. As long as your passport is valid at the time of entry into Mexico.","Attachments":[],"Id":1137103,"PostDate":1272923107,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                You will be totally fine. I used to work for Customs in Chicago. As long as your passport is valid at the time of entry into Mexico.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>[IMG]<\/span><br \/>\n<span>Mr. & Mrs. Rangel!!!<\/span><\/div><\/div>","Email":"ldeavila22@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1247517925,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-219387.gif?_r=0","PhotoWidth":66,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"ldeavila","Id":219387,"Name":"ldeavila","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":51487,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"45e668e4da636964aa57390840fdb62d","RawContent":"you&#039;ll be absolutely fine. i think it would only pose a problem if it was to expire within a week of your travel, kwim? because anything can happen (like the icelandic volcano ash that prevented flights out of europe for a bit) ... in the event of some unexpected delay, you wouldn&#039;t want your passport to expire before you were able to get a flight home!\n \n 3 months? you&#039;re golden!","Attachments":[],"Id":1137152,"PostDate":1272925444,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                you'll be absolutely fine. i think it would only pose a problem if it was to expire within a week of your travel, kwim? because anything can happen (like the icelandic volcano ash that prevented flights out of europe for a bit) ... in the event of some unexpected delay, you wouldn't want your passport to expire before you were able to get a flight home!<br \/> <br \/> 3 months? you're golden!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-size:10px;\"><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/forum\/thread\/48680\/mummergirl-s-totally-after-the-fact-planning-thread#post_963823\">My After-the-Fact Planning Thread<\/a><\/span>","Email":"mummergirl@yahoo.com","IpAddress":"68.83.34.78","GroupId":46,"GroupName":"VIP Member","JoinDate":1207092360,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208981.jpg?_r=1389220347","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"cougs","Id":208981,"Name":"cougs","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":51487,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"13bafdd2898d6093916a18720e2dff3c","RawContent":"Some countries do not allow you to travel there if your passport expires within 6 months of when you are travelling, but from the above replies, it sould like Mexico is not one of them.","Attachments":[],"Id":1137163,"PostDate":1272926503,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Some countries do not allow you to travel there if your passport expires within 6 months of when you are travelling, but from the above replies, it sould like Mexico is not one of them.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ckontra@hotmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1262841687,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-224409.JPG?_r=0","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"Cindy*","Id":224409,"Name":"Cindy*","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":51487,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d5eac26954eec0d0f1449ce355fdab97","RawContent":"hmm this whole thing really piqued my curosity, so i looked further and just found this:\n \n (&lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.mexperience.com\/guide\/essentials\/entry_req.htm#ReqTourists\"&gt;Mexico Entry Requirements Immigration Customs Lone Parent&lt;\/a&gt;)\n &lt;strong&gt;Passport Validity&lt;\/strong&gt;\n \n The maximum period of time that a visitor may stay in Mexico without a formal visa is six months. Therefore your passport, regardless of country of origin, should be valid for a minimum period of six months, however long you intend to stay to avoid any potential problems at the port of entry.\n \n Immigration authorities at the port of entry may allow or deny entry of any person into Mexico. If you have a passport that is valid for less than six months and you intend to stay in Mexico for a short period of time -- perhaps a vacation -- the Immigration Officer might allow you entry.\n \n Notwithstanding this, we recommend that you and your family members hold passports valid for at least six months from the date you plan to enter Mexico.","Attachments":[],"Id":1137200,"PostDate":1272928322,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                hmm this whole thing really piqued my curosity, so i looked further and just found this:<br \/> <br \/> (<a href='http:\/\/www.mexperience.com\/guide\/essentials\/entry_req.htm#ReqTourists' class='bbc_url' title='External link' rel='nofollow external'>Mexico Entry Requirements Immigration Customs Lone Parent<\/a>)<br \/> <strong>Passport Validity<\/strong><br \/> <br \/> The maximum period of time that a visitor may stay in Mexico without a formal visa is six months. Therefore your passport, regardless of country of origin, should be valid for a minimum period of six months, however long you intend to stay to avoid any potential problems at the port of entry.<br \/> <br \/> Immigration authorities at the port of entry may allow or deny entry of any person into Mexico. If you have a passport that is valid for less than six months and you intend to stay in Mexico for a short period of time -- perhaps a vacation -- the Immigration Officer might allow you entry.<br \/> <br \/> Notwithstanding this, we recommend that you and your family members hold passports valid for at least six months from the date you plan to enter Mexico.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-size:10px;\"><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/forum\/thread\/48680\/mummergirl-s-totally-after-the-fact-planning-thread#post_963823\">My After-the-Fact Planning Thread<\/a><\/span>","Email":"mummergirl@yahoo.com","IpAddress":"68.83.34.78","GroupId":46,"GroupName":"VIP Member","JoinDate":1207092360,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208981.jpg?_r=1389220347","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"cougs","Id":208981,"Name":"cougs","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":51487,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"627d9ef6263d0801a4b392d1218ef07d","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;cougs&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;hmm this whole thing really piqued my curosity, so i looked further and just found this:\n \n (&lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.mexperience.com\/guide\/essentials\/entry_req.htm#ReqTourists\"&gt;Mexico Entry Requirements Immigration Customs Lone Parent&lt;\/a&gt;)\n &lt;strong&gt;Passport Validity&lt;\/strong&gt;\n \n The maximum period of time that a visitor may stay in Mexico without a formal visa is six months. Therefore your passport, regardless of country of origin, should be valid for a minimum period of six months, however long you intend to stay to avoid any potential problems at the port of entry.\n \n Immigration authorities at the port of entry may allow or deny entry of any person into Mexico. If you have a passport that is valid for less than six months and you intend to stay in Mexico for a short period of time -- perhaps a vacation -- the Immigration Officer might allow you entry.\n \n Notwithstanding this, we recommend that you and your family members hold passports valid for at least six months from the date you plan to enter Mexico.&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;So are you saying that our passport has to be valid for six months? We won&#039;t get ours for a few weeks and we leave July 19th.","Attachments":[],"Id":1137268,"PostDate":1272932421,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>cougs<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">hmm this whole thing really piqued my curosity, so i looked further and just found this:<br \/> <br \/> (<a href='http:\/\/www.mexperience.com\/guide\/essentials\/entry_req.htm#ReqTourists' class='bbc_url' title='External link' rel='nofollow external'>Mexico Entry Requirements Immigration Customs Lone Parent<\/a>)<br \/> <strong>Passport Validity<\/strong><br \/> <br \/> The maximum period of time that a visitor may stay in Mexico without a formal visa is six months. Therefore your passport, regardless of country of origin, should be valid for a minimum period of six months, however long you intend to stay to avoid any potential problems at the port of entry.<br \/> <br \/> Immigration authorities at the port of entry may allow or deny entry of any person into Mexico. If you have a passport that is valid for less than six months and you intend to stay in Mexico for a short period of time -- perhaps a vacation -- the Immigration Officer might allow you entry.<br \/> <br \/> Notwithstanding this, we recommend that you and your family members hold passports valid for at least six months from the date you plan to enter Mexico.<\/div> <\/td> <\/tr> <\/table> <\/div>So are you saying that our passport has to be valid for six months? We won't get ours for a few weeks and we leave July 19th.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><strong><a data-ipb='nomediaparse' href=\"http:\/\/meredithandjedd.com\">My Planning Site<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/t\/wqxRY9P\/weight.png\">http:\/\/tickers.TickerFactory.com\/ezt...Y9P\/weight.png<\/a><br><br><\/strong><strong><a data-ipb='nomediaparse' href=\"http:\/\/img.weddingcountdown.com\/ticker\/jk46iybq93.png\">http:\/\/img.weddingcountdown.com\/ticker\/jk46iybq93.png<\/a><\/strong><\/div><\/div>","Email":"meredithhaley@hotmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1264175810,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-224948.gif?_r=0","PhotoWidth":73,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Mere","Id":224948,"Name":"Mere","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":51487,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3fddd1720f9862f0becc11ec80656b6a","RawContent":"WAIT-I think I understand now-we will be fine-I hope-lol","Attachments":[],"Id":1137270,"PostDate":1272932496,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                WAIT-I think I understand now-we will be fine-I hope-lol\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><strong><a data-ipb='nomediaparse' href=\"http:\/\/meredithandjedd.com\">My Planning Site<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/t\/wqxRY9P\/weight.png\">http:\/\/tickers.TickerFactory.com\/ezt...Y9P\/weight.png<\/a><br><br><\/strong><strong><a data-ipb='nomediaparse' href=\"http:\/\/img.weddingcountdown.com\/ticker\/jk46iybq93.png\">http:\/\/img.weddingcountdown.com\/ticker\/jk46iybq93.png<\/a><\/strong><\/div><\/div>","Email":"meredithhaley@hotmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1264175810,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-224948.gif?_r=0","PhotoWidth":73,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Mere","Id":224948,"Name":"Mere","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":51487,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"61344b891fb570378e1708fd9a2853c2","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;Mere&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;So are you saying that our passport has to be valid for six months? We won&#039;t get ours for a few weeks and we leave July 19th.&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;haha no, it has to have 6 months left on it before it expires. you&#039;re fine!","Attachments":[],"Id":1137470,"PostDate":1272944188,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>Mere<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">So are you saying that our passport has to be valid for six months? We won't get ours for a few weeks and we leave July 19th.<\/div> <\/td> <\/tr> <\/table> <\/div>haha no, it has to have 6 months left on it before it expires. you're fine!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-size:10px;\"><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/forum\/thread\/48680\/mummergirl-s-totally-after-the-fact-planning-thread#post_963823\">My After-the-Fact Planning Thread<\/a><\/span>","Email":"mummergirl@yahoo.com","IpAddress":"68.83.34.78","GroupId":46,"GroupName":"VIP Member","JoinDate":1207092360,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208981.jpg?_r=1389220347","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"cougs","Id":208981,"Name":"cougs","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":51487,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3fe0e1faf55c5c888497b85e51ce7823","RawContent":"Thanks, Cougs-it took me a few readings to understand-lol","Attachments":[],"Id":1137609,"PostDate":1272971298,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks, Cougs-it took me a few readings to understand-lol\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><strong><a data-ipb='nomediaparse' href=\"http:\/\/meredithandjedd.com\">My Planning Site<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/t\/wqxRY9P\/weight.png\">http:\/\/tickers.TickerFactory.com\/ezt...Y9P\/weight.png<\/a><br><br><\/strong><strong><a data-ipb='nomediaparse' href=\"http:\/\/img.weddingcountdown.com\/ticker\/jk46iybq93.png\">http:\/\/img.weddingcountdown.com\/ticker\/jk46iybq93.png<\/a><\/strong><\/div><\/div>","Email":"meredithhaley@hotmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1264175810,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-224948.gif?_r=0","PhotoWidth":73,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Mere","Id":224948,"Name":"Mere","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":51487,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a8dc4e2541c7f8045511e80021d224ae","RawContent":"I usually always renew my passport if I am going to be travelling with less than 6 months left because I am too lazy to check which countries have this rule. It is pretty common though. The sucky thinng is you are paying for a passport which is supposed to be good for 5 years but really it is only good for 4 1\/2 years.","Attachments":[],"Id":1137624,"PostDate":1272972177,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I usually always renew my passport if I am going to be travelling with less than 6 months left because I am too lazy to check which countries have this rule. It is pretty common though. The sucky thinng is you are paying for a passport which is supposed to be good for 5 years but really it is only good for 4 1\/2 years.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ckontra@hotmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1262841687,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-224409.JPG?_r=0","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"Cindy*","Id":224409,"Name":"Cindy*","IsOnline":false}}],"Id":"51487","Title":"Okay to travel with passport 3 months before it expires?","LastPostDate":1443693550},"Pages":{"TotalItems":18,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
