\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...f02c\/event.png<\/a><\/div><\/div>","Email":"jcrsby@yahoo.ca","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1227292774,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-212805.gif?_r=0","PhotoWidth":130,"PhotoHeight":97,"PhotoType":"custom"},"FormattedName":"JCrosby","Id":212805,"Name":"JCrosby","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":16523,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"440eba11ec9e30d5e59b89bc50397ca4","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;JCrosby&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Has anyone heard of weddingdressmart.com? They have tons of Maggie Sottero dresses for $350! And the shipping is free...even to Canada. It seems too good to be true...maybe they&#039;re knock offs?&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;check resellerratings.com","Attachments":[],"Id":592884,"PostDate":1234668550,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>JCrosby<\/strong> <a href='\/forum\/post\/693279' class='bbc_url' title='External link' rel='nofollow external'><span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span><\/a>  <div  style=\"font-style:italic\">Has anyone heard of weddingdressmart.com? They have tons of Maggie Sottero dresses for $350! And the shipping is free...even to Canada. It seems too good to be true...maybe they're knock offs?<\/div> <\/td> <\/tr> <\/table> <\/div>check resellerratings.com\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"morganleigh03@yahoo.com","IpAddress":"75.177.182.183","GroupId":46,"GroupName":"VIP Member","JoinDate":1182650580,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"rodent","Id":207489,"Name":"rodent","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":16523,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9833951bf5bb7ac8805dafe349d9f163","RawContent":"I just ran into this thread now and thought I&#039;d add how I saved $$ on my dress. I was looking for something appropriate for the beach and I wanted to be practical and get a dress that wasn&#039;t too heavy. Even destination wedding gowns seemed to have too much material. I ended up ordering a bridesmaid&#039;s dress in white and it&#039;s perfect!! and I saved sooooo much money because it&#039;s not a &amp;quot;wedding gown&amp;quot;. I only paid $199","Attachments":[],"Id":592921,"PostDate":1234674629,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I just ran into this thread now and thought I'd add how I saved $$ on my dress. I was looking for something appropriate for the beach and I wanted to be practical and get a dress that wasn't too heavy. Even destination wedding gowns seemed to have too much material. I ended up ordering a bridesmaid's dress in white and it's perfect!! and I saved sooooo much money because it's not a \"wedding gown\". I only paid $199\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/www.ezticker.com\/ticker\/558\/562\/20090415\/Our+Jamaican+Wedding\/ticker.png\">http:\/\/www.ezticker.com\/ticker\/558\/5...ing\/ticker.png<\/a><\/div><\/div>","Email":"ganaime@nstu.ca","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1221509883,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211745.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"montegobay09","Id":211745,"Name":"montegobay09","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":16523,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a77206fc91ca3ba1aaab707256b123df","RawContent":"Hey everyone, I know this is an old thread, but I was hoping to revive it. I found the exact wedding dress I want to get on &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/discountbridal.org\/\"&gt;Discount Bridal Gowns, Bridesmaid Dress, Flower Girls and Formal Wear - Discount Bridal&lt;\/a&gt; . It&#039;s a pretty sustantial savings at 400 less than the store here wants for it. I&#039;m a little scared to order online, and I&#039;m having trouble finding reviews of this place. All the bridal shops have warned me about ordering my dress online, but I realize that that&#039;s how they stay in business. Still, they&#039;ve planted a seed of doubt in me. Has anyone gotten their dress or BM dresses from here?","Attachments":[],"Id":693487,"PostDate":1242438960,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hey everyone, I know this is an old thread, but I was hoping to revive it. I found the exact wedding dress I want to get on <a href='http:\/\/discountbridal.org\/' class='bbc_url' title='External link' rel='nofollow external'>Discount Bridal Gowns, Bridesmaid Dress, Flower Girls and Formal Wear - Discount Bridal<\/a> . It's a pretty sustantial savings at 400 less than the store here wants for it. I'm a little scared to order online, and I'm having trouble finding reviews of this place. All the bridal shops have warned me about ordering my dress online, but I realize that that's how they stay in business. Still, they've planted a seed of doubt in me. Has anyone gotten their dress or BM dresses from here?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kelly.beaudry@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1232983409,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-214320.gif?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"chloe55","Id":214320,"Name":"chloe55","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":16523,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"13fd30865c238c37dbcae8e549ae9ff4","RawContent":"check out reseller ratings\n \n i have not ordered from there, but my two online BM dress shopping experiences have been great.","Attachments":[],"Id":693499,"PostDate":1242440216,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                check out reseller ratings<br \/> <br \/> i have not ordered from there, but my two online BM dress shopping experiences have been great.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"morganleigh03@yahoo.com","IpAddress":"75.177.182.183","GroupId":46,"GroupName":"VIP Member","JoinDate":1182650580,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"rodent","Id":207489,"Name":"rodent","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":16523,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e861858ef854b1aeb801e413a9c447ab","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;Morgan&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;so far chrissy Os has been the cheapest for our BM dresses. $94 no tax no shipping.&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;Morgan&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;i just ordered a BM dress from chrissy O&#039;s. The beat Lee Philip by 6% &amp;amp; their shipping was less. Both Chrissy O&#039;s &amp;amp; Lee Philip had excellent customer service.&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;I just saw this thread get bumped &amp;amp; thought I should say how my last online BM shopping experience went.\n \n I ordered from Chrissy O&#039;s because they will beat the lowest price by 6%. Customer service was fantastic. \n \n With both dresses I ordered, I compared my measurements to the brand&#039;s size guide. Both times the dress first perfect out of the box.","Attachments":[],"Id":693502,"PostDate":1242440490,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>Morgan<\/strong> <a href='\/forum\/post\/395531' class='bbc_url' title='External link' rel='nofollow external'><span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span><\/a>  <div  style=\"font-style:italic\">so far chrissy Os has been the cheapest for our BM dresses. $94 no tax no shipping.<\/div> <\/td> <\/tr> <\/table> <\/div><div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>Morgan<\/strong> <a href='\/forum\/post\/636098' class='bbc_url' title='External link' rel='nofollow external'><span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span><\/a>  <div  style=\"font-style:italic\">i just ordered a BM dress from chrissy O's. The beat Lee Philip by 6% & their shipping was less. Both Chrissy O's & Lee Philip had excellent customer service.<\/div> <\/td> <\/tr> <\/table> <\/div>I just saw this thread get bumped & thought I should say how my last online BM shopping experience went.<br \/> <br \/> I ordered from Chrissy O's because they will beat the lowest price by 6%. Customer service was fantastic. <br \/> <br \/> With both dresses I ordered, I compared my measurements to the brand's size guide. Both times the dress first perfect out of the box.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"morganleigh03@yahoo.com","IpAddress":"75.177.182.183","GroupId":46,"GroupName":"VIP Member","JoinDate":1182650580,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"rodent","Id":207489,"Name":"rodent","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":16523,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f9f8040f0661fc5a351046824f586d76","RawContent":"Thanks for the website! Nothing on there about Discount Bridal though. Thats weird, right?","Attachments":[],"Id":693507,"PostDate":1242441149,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks for the website! Nothing on there about Discount Bridal though. Thats weird, right?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kelly.beaudry@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1232983409,"Photo":{"H