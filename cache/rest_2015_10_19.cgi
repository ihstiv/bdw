ite says based out of South Florida?\u00a0 Do you have to pay for the travel too?<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lkterry@zoominternet.net","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1332569944,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-253117.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"lkterry","Id":253117,"Name":"lkterry","IsOnline":false}}],"Id":"59924","Title":"Hairstylists and Makeup In Negril, Jamaica","LastPostDate":1338371208},"Pages":{"TotalItems":11,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
