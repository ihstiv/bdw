{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":1,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":202,"MovedTo":null,"MovedOn":0,"FirstPostId":1741456,"Rating":0,"RatingHits":0,"Starter":{"Id":268120,"Name":"sarbur00","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268120.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"StartDate":1364967040,"LastPoster":{"Id":268120,"Name":"sarbur00","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268120.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":67,"Preview":{"Id":1741456,"PostDate":1364967040,"PostContent":"Zuluspro, without a doubt they need to be your photographer. There are so many reasons, and now...","Author":{"Signature":"","Email":"sarbur00@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1364966766,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268120.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"sarbur00","Id":268120,"Name":"sarbur00","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73499,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6cee4eb0e689b7a1c0e49fe773fed09f","RawContent":"&lt;p&gt; &lt;span style=\"font-family: tahoma, geneva, arial, sans-serif; font-size: 12px; text-align: -webkit-auto; \"&gt;Zuluspro, without a doubt they need to be your photographer. There are so many reasons, and now having been a bride every single reason you can think of Zuluspro tops the list. They were professional, creative, affordable, reliable, personable, and incredibly talented. When i spoke with Chris on the phone prior to booking with him, i was set at ease, he took the time to explain exactly how the day would work, which really set my mind at ease. We talked about what shots i was looking for and it was like we shared the same vision, well not the same vision, Chris is way too talented, but we shared the same thoughts and descriptions of the feeling i was going for. The day of, Chris and Paul arrived right on time and they had actually arrived early to take some shots of the resort ahead of time. Chris was so professional, and fun to work with, he was good at describing shots and prompting for a change in position without ever posing us. He scouted the ceremony and reception site even when the bride and groom were not allowed to go, and he got some awesome photos of the site. He took all the obligatory photos and so many creatie shots. Chris came early and stayed late. He is a true master of the profession! The next day we did trash the dress, and Chris took us to some amazing sites, we went into town center and under waterfalls on under trees, and diving into the ocean. Zuluspro captured so many great moments that i wasn&#039;t able to see at the ceremony and reception and for that i am soooo thankful. If you have a chance to work with Zuluspro, DO IT!! He also travels and i have recommended him for places outside of Jamaica, its his vision and passion that make his work so outstanding!! Thank you Christopher and Zuluspro!!&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-family: tahoma, geneva, arial, sans-serif; font-size: 12px; text-align: -webkit-auto; \"&gt;Sarah J. Hanson&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1741456,"PostDate":1364967040,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <span  style=\"font-family: tahoma, geneva, arial, sans-serif;font-size: 12px;text-align: -webkit-auto\">Zuluspro, without a doubt they need to be your photographer. There are so many reasons, and now having been a bride every single reason you can think of Zuluspro tops the list. They were professional, creative, affordable, reliable, personable, and incredibly talented. When i spoke with Chris on the phone prior to booking with him, i was set at ease, he took the time to explain exactly how the day would work, which really set my mind at ease. We talked about what shots i was looking for and it was like we shared the same vision, well not the same vision, Chris is way too talented, but we shared the same thoughts and descriptions of the feeling i was going for. The day of, Chris and Paul arrived right on time and they had actually arrived early to take some shots of the resort ahead of time. Chris was so professional, and fun to work with, he was good at describing shots and prompting for a change in position without ever posing us. He scouted the ceremony and reception site even when the bride and groom were not allowed to go, and he got some awesome photos of the site. He took all the obligatory photos and so many creatie shots. Chris came early and stayed late. He is a true master of the profession! The next day we did trash the dress, and Chris took us to some amazing sites, we went into town center and under waterfalls on under trees, and diving into the ocean. Zuluspro captured so many great moments that i wasn't able to see at the ceremony and reception and for that i am soooo thankful. If you have a chance to work with Zuluspro, DO IT!! He also travels and i have recommended him for places outside of Jamaica, its his vision and passion that make his work so outstanding!! Thank you Christopher and Zuluspro!!<\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-family: tahoma, geneva, arial, sans-serif;font-size: 12px;text-align: -webkit-auto\">Sarah J. Hanson<\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sarbur00@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1364966766,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268120.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"sarbur00","Id":268120,"Name":"sarbur00","IsOnline":false}}],"Id":"73499","Title":"The BEST Wedding Photographer in Jamaica","LastPostDate":1364967040},"Pages":{"TotalItems":1,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
