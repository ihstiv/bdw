nging a friend to do pictures too!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cd_rain79@yahoo.com","IpAddress":"68.185.207.107","GroupId":40,"GroupName":"Jr. Member","JoinDate":1384731219,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275126.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Rainmaker","Id":275126,"Name":"Rainmaker","IsOnline":false}}],"Id":"74445","Title":"Bringing Own Photographer - Etiquette","LastPostDate":1391193132},"Pages":{"TotalItems":5,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
