   <\/head>\r\n              <body>\r\n                <p>Any Canadian Brides getting quotes for November AI packages? The best I've gotten is $1700, anyone else?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"juliareddy@gmail.com","IpAddress":"209.91.179.179","GroupId":39,"GroupName":"Newbie","JoinDate":1409160121,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279601.jpg?_r=1420814517","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"julianow","Id":279601,"Name":"julianow","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.68.109.248","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":74739,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"50cff53f9b080e340e8f942d529bcc1c","RawContent":"@ Brod63, at least November is at the tail end of hurricane season. Crossing fingers for good weather.","Attachments":[],"Id":1886134,"PostDate":1423725963,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @ Brod63, at least November is at the tail end of hurricane season. Crossing fingers for good weather.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"pinkiesup08@gmail.com","IpAddress":"75.181.5.152","GroupId":47,"GroupName":"Site Supporter","JoinDate":1374599724,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-271841.j