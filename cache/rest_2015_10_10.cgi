{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":4,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":171,"MovedTo":null,"MovedOn":0,"FirstPostId":1906015,"Rating":0,"RatingHits":0,"Starter":{"Id":285037,"Name":"aliciakevin2017","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1444223004,"LastPoster":{"Id":258213,"Name":"LasCaletas","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-258213.jpeg?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1906093,"PostDate":1444385834,"PostContent":"Hi dear congratulations\u00a0on your engagement!!! \u00a0let us introduce you our venue & wedding services;...","Author":{"Signature":"","Email":"dennise@adventureweddingsvallarta.com","IpAddress":"187.146.166.254","GroupId":49,"GroupName":"Insiders","JoinDate":1343044403,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-258213.jpeg?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"LasCaletas","Id":258213,"Name":"LasCaletas","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"165.155.196.100","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79639,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"aea8f37b17a18f9ec36414e21fa80ece","RawContent":"&lt;p&gt;Hello All! &amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I just got engaged about a week ago and although I am planning a destination wedding for April 2017 I wanted to get started on my research! I know a year and a half is a long ways away however I would really love to give my guests a year or more notice to save up! We are anticipating a larger amount of guests (possibly 50+) so my questions are:&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;What are the best family friendly resorts? (I want everyone to have the option to bring their children if they wish but I also don&#039;t want a complete kiddy land)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Which resorts offer a \"preview\"?- my fiance and I were thinking of travelling to Mexico possibly in February to scope a few places out if any offered deals specifically for this reason.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;And which resorts are best for larger groups?&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We are thinking Playa\/Riviera Maya area however I am flexible and really anywhere from Isla Mujeres to a little past Playa will be considered.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thank you so much for your help!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Future Mrs. K&amp;nbsp; :)&lt;\/p&gt;","Attachments":[],"Id":1906015,"PostDate":1444223004,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello All! \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I just got engaged about a week ago and although I am planning a destination wedding for April 2017 I wanted to get started on my research! I know a year and a half is a long ways away however I would really love to give my guests a year or more notice to save up! We are anticipating a larger amount of guests (possibly 50+) so my questions are:\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>What are the best family friendly resorts? (I want everyone to have the option to bring their children if they wish but I also don't want a complete kiddy land)<\/p>\n<p>\u00a0<\/p>\n<p>Which resorts offer a \"preview\"?- my fiance and I were thinking of travelling to Mexico possibly in February to scope a few places out if any offered deals specifically for this reason.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>And which resorts are best for larger groups?\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>We are thinking Playa\/Riviera Maya area however I am flexible and really anywhere from Isla Mujeres to a little past Playa will be considered.<\/p>\n<p>\u00a0<\/p>\n<p>Thank you so much for your help!<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Future Mrs. K\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"straaf56@gmail.com","IpAddress":"165.155.196.100","GroupId":39,"GroupName":"Newbie","JoinDate":1444222312,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"aliciakevin2017","Id":285037,"Name":"aliciakevin2017","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.202.225.11","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79639,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"c32a9b338b1865d0bd83e780e1cc585c","RawContent":"&lt;p&gt;welcome to BDW! Usually we try to qualify clients and help find the best resort that fits their checklist of wants.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;To answer some of your questions:&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Hard Rock and Karisma hotels offer sites visits for reduced stays. &amp;nbsp;If you book the karisma one, and then book your wedding date, you can get $500 back off Food and beverage for your wedding.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;For larger groups, the larger resorts are best as the boutique resorts will have limited inventory and may not have the space to hold large groups (rooms as well as events)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Most of the resorts also offer a reduced rate for your stay for site visits as well. If you would like more info, feel free to click the link in my siggy or email me at info@wrighttravelagency.com and we can answer more of your questions.&lt;\/p&gt;","Attachments":[],"Id":1906016,"PostDate":1444223447,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>welcome to BDW! Usually we try to qualify clients and help find the best resort that fits their checklist of wants.<\/p>\n<p>\u00a0<\/p>\n<p>To answer some of your questions:<\/p>\n<p>\u00a0<\/p>\n<p>Hard Rock and Karisma hotels offer sites visits for reduced stays. \u00a0If you book the karisma one, and then book your wedding date, you can get $500 back off Food and beverage for your wedding.<\/p>\n<p>\u00a0<\/p>\n<p>For larger groups, the larger resorts are best as the boutique resorts will have limited inventory and may not have the space to hold large groups (rooms as well as events)<\/p>\n<p>\u00a0<\/p>\n<p>Most of the resorts also offer a reduced rate for your stay for site visits as well. If you would like more info, feel free to click the link in my siggy or email me at info@wrighttravelagency.com and we can answer more of your questions.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-family:arial, helvetica, sans-serif;\">Founder and Owner of BestDestinationWedding.com \u00a0\/ \u00a0<\/span><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/'><strong><span style=\"font-family:arial, helvetica, sans-serif;\">Bride & Groom Fly FREE Promotion<\/span><\/strong><\/a><\/p>\n<p>\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><strong><a data-ipb='nomediaparse' href='http:\/\/wrighttravelagency.com\/inquiry\/'><span style=\"color:#008080;\">Looking for a travel agency that specializes in Destination Weddings<\/span><\/a><\/strong><span style=\"color:#008080;\"><strong>?<\/strong> \u00a0We are an award winning travel agency and you can <\/span><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style=\"color:#008080;\">read our reviews\u00a0here.<\/span><\/a><\/strong><\/span><br>\n\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"color:#008080;\"><strong>Awards and recognition:\u00a0<\/strong><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Palace Resorts PRO Platinum Agency (Top Award) \u00a0 \u00a0 | \u00a0 \u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">AMResorts Master Agent & Top Agency \u00a0<\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/68050-karisma-hotels-givc-and-gi-wedding-consultants-wright-travel-agency\/'><strong>Wright Travel & Karisma GIVC Benefits<\/strong><\/a><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Travel Impressions Best of the Best Globe Winner \u00a0 \u00a0| \u00a0 \u00a0\u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Apple Vacations Golden Apple Winner \u00a0<\/span><\/span><br><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"> \u00a0 \u00a0<img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"font-size:14px;\"><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010'>Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><\/span><\/span><strong><span style=\"color:#b22222;\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a data-ipb='nomediaparse' href='mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com'>ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"admin@bestdestinationwedding.com","IpAddress":"71.202.225.11","GroupId":4,"GroupName":"Administrators","JoinDate":1137209820,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"FormattedName":"TammyWright","Id":206696,"Name":"TammyWright","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"190.167.67.230","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79639,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ca5aad9c6c9e0d80a52b777d5317a9c7","RawContent":"&lt;p&gt;Welcome to the forum, FutureMrsK and Congrats on your 2017 dw!!! You&#039;re right about starting early to give your guests more time to save for their travel expenses - well done!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;You&#039;ll find lots of great ideas, info and advice from everyone here, so welcome aboard and happy research!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;To inspire you even further, here are some magical wedding moments that matter we captured in our magnificant Mayan Riviera .....to show you what your photo backdrops could look like......enjoy!!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Taken from our &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10150695320839487.414941.18683524486&amp;amp;type=3&#039;&gt;Cover Photos Album: &lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-dfw1-1.xx.fbcdn.net\/hphotos-xlt1\/t31.0-8\/11707991_10153655634389487_1188119404337915805_o.jpg\" alt=\"11707991_10153655634389487_1188119404337\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-dfw1-1.xx.fbcdn.net\/hphotos-xap1\/t31.0-8\/11951533_10153610355409487_3502002007315431031_o.jpg\" alt=\"11951533_10153610355409487_3502002007315\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-dfw1-1.xx.fbcdn.net\/hphotos-xat1\/t31.0-8\/10860945_10152904701714487_5561915454500185241_o.jpg\" alt=\"10860945_10152904701714487_5561915454500\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Enjoy your journey ahead, and all the best with your plans - cheers!!! team MTM :)&lt;\/p&gt;","Attachments":[],"Id":1906056,"PostDate":1444300593,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome to the forum, FutureMrsK and Congrats on your 2017 dw!!! You're right about starting early to give your guests more time to save for their travel expenses - well done!<\/p>\n<p>\u00a0<\/p>\n<p>You'll find lots of great ideas, info and advice from everyone here, so welcome aboard and happy research!<\/p>\n<p>\u00a0<\/p>\n<p>To inspire you even further, here are some magical wedding moments that matter we captured in our magnificant Mayan Riviera .....to show you what your photo backdrops could look like......enjoy!!!<\/p>\n<p>\u00a0<\/p>\n<p>Taken from our <a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10150695320839487.414941.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>Cover Photos Album: <\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-dfw1-1.xx.fbcdn.net\/hphotos-xlt1\/t31.0-8\/11707991_10153655634389487_1188119404337915805_o.jpg\" alt=\"11707991_10153655634389487_1188119404337\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-dfw1-1.xx.fbcdn.net\/hphotos-xap1\/t31.0-8\/11951533_10153610355409487_3502002007315431031_o.jpg\" alt=\"11951533_10153610355409487_3502002007315\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-dfw1-1.xx.fbcdn.net\/hphotos-xat1\/t31.0-8\/10860945_10152904701714487_5561915454500185241_o.jpg\" alt=\"10860945_10152904701714487_5561915454500\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>Enjoy your journey ahead, and all the best with your plans - cheers!!! team MTM <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280196260,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"201.116.201.71","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79639,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1da991053af364c3cd1ddc3d3a717bf3","RawContent":"&lt;p&gt;&lt;span style=\"color:#808080;\"&gt;Hi dear congratulations&amp;nbsp;on your engagement!!! &amp;nbsp;let us introduce you our venue &amp;amp; wedding services; we would&amp;nbsp;love&amp;nbsp;to be part of such a special event.&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"color:#595959;\"&gt;Las Caletas is a truly magical place to exchange your vows and celebrate this special occasion. It is our private beach cove in the south bay and is only accessible by sea, giving it the seclusion and ambiance of an island hideaway. It covers an enormous area and features several beaches, a pyramid amphitheater built into the tropical forest and mountain side, various facilities\/buildings (spa, kitchens, eating areas\/restaurants, bars, restrooms, etc.), and several hundred acres of tropical forest.&lt;\/span&gt;&lt;span style=\"color:rgb(89,89,89);\"&gt;on your engagement!!! And thank you for your interest in our venue &amp;amp; wedding services; we would&amp;nbsp;love&amp;nbsp;to be part of such a special event.&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:81815]&lt;\/div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:82068]&lt;\/div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:81812]&lt;\/div&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;\/div&gt;\n&lt;div&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.adventureweddingsvallarta.com\/&#039;&gt;http:\/\/www.adventureweddingsvallarta.com\/&lt;\/a&gt;&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;&amp;lt;3 &amp;lt;3 &amp;lt;3&lt;\/div&gt;","Attachments":[],"Id":1906093,"PostDate":1444385834,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span  style=\"color:#808080\">Hi dear congratulations\u00a0on your engagement!!! \u00a0let us introduce you our venue & wedding services; we would\u00a0love\u00a0to be part of such a special event.<\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"color:#595959\">Las Caletas is a truly magical place to exchange your vows and celebrate this special occasion. It is our private beach cove in the south bay and is only accessible by sea, giving it the seclusion and ambiance of an island hideaway. It covers an enormous area and features several beaches, a pyramid amphitheater built into the tropical forest and mountain side, various facilities\/buildings (spa, kitchens, eating areas\/restaurants, bars, restrooms, etc.), and several hundred acres of tropical forest.<\/span><span  style=\"color:rgb(89,89,89)\">on your engagement!!! And thank you for your interest in our venue & wedding services; we would\u00a0love\u00a0to be part of such a special event.<\/span><\/p>\n<p>\u00a0<\/p>\n<div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/81815-sorrounding-ceremony\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_18083\/sml_gallery_258213_18083_70302.jpg' class='galattach galimageview sharedmedia_screenshot' title='Sorrounding Ceremony'  width='200' height='177'  alt='Sorrounding Ceremony' id='sml_image_view_81815' \/><\/a>\n<br \/><\/div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/82068-awcj-251014-78\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_18100\/sml_gallery_258213_18100_53261.jpg' class='galattach galimageview sharedmedia_screenshot' title='AWCJ 251014 78'  width='200' height='134'  alt='AWCJ 251014 78' id='sml_image_view_82068' \/><\/a>\n<br \/><\/div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/81812-dress\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_18074\/sml_gallery_258213_18074_286992.jpg' class='galattach galimageview sharedmedia_screenshot' title='dress'  width='200' height='200'  alt='dress' id='sml_image_view_81812' \/><\/a>\n<br \/><\/div>\n<p>\u00a0<\/p>\n<\/div>\n<div><a href='http:\/\/www.adventureweddingsvallarta.com\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.adventure...gsvallarta.com\/<\/a><\/div>\n<div>\u00a0<\/div>\n<div><3 <3 <3<\/div>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"dennise@adventureweddingsvallarta.com","IpAddress":"187.146.166.254","GroupId":49,"GroupName":"Insiders","JoinDate":1343044403,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-258213.jpeg?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"LasCaletas","Id":258213,"Name":"LasCaletas","IsOnline":false}}],"Id":"79639","Title":"So Many Options!","LastPostDate":1444385834},"Pages":{"TotalItems":4,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
