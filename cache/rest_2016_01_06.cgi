dding.com'>ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"admin@bestdestinationwedding.com","IpAddress":"71.202.225.11","GroupId":4,"GroupName":"Administrators","JoinDate":1137202620,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"FormattedName":"TammyWright","Id":206696,"Name":"TammyWright","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"98.210.33.53","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79819,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"aaeef15a764133ac7b23c5d101f643d0","RawContent":"[quote name=\"kristendelpin\" post=\"1908730\" timestamp=\"1451316216\"]\n[color=rgb(31,31,31)][font=Arial]I am looking into a destination wedding in Jamaica for May 2017 most likely in Montego Bay. Has anyone attended or had a wedding in Jamaica? Or stayed at a great resort that is affordable? I would like to get recommendations for all inclusive resorts in the area. If anyone could tell me both good and bad things about different resorts, it would be very helpful! Thanks![\/font][\/color][\/quote]Hi Kristen,\n\nI am a Top 50 booking agent for Jamaica and would be happy to assist you with any questions you have about resorts.  Feel free to PM me.\nThanks!\nBabs","Attachments":[],"Id":1908792,"PostDate":1451505214,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>kristendelpin, on 28 December 2015 - 09:23 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p><span  style=\"color:rgb(31,31,31);font-family:Arial, sans-serif\">I am looking into a destination wedding in Jamaica for May 2017 most likely in Montego Bay. Has anyone attended or had a wedding in Jamaica? Or stayed at a great resort that is affordable? I would like to get recommendations for all inclusive resorts in the area. If anyone could tell me both good and bad things about different resorts, it would be very helpful! Thanks!<\/span><\/p>\n<\/div>\n<\/div><\/div>\n<p>Hi Kristen,<\/p>\n<p>\u00a0<\/p>\n<p>I am a Top 50 booking agent for Jamaica and would be happy to assist you with any questions you have about resorts. \u00a0Feel free to PM me.<\/p>\n<p>\nThanks!<\/p>\n<p>Babs<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><a class='bbc_url' href='http:\/\/wrighttravelagency.com\/inquiry\/'><span style='color: rgb(0,128,128)'>Looking for a travel agency that specializes in Destination Weddings<\/span><\/a><span style='color: rgb(0,128,128)'>? We are an award winning travel agency and you can read our reviews <\/span><a class='bbc_url' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style='color: rgb(0,128,128)'><strong class='bbc'>HERE.<\/strong><\/span><\/a><\/span><\/span><br \/>\n<br \/>\n<span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'><strong class='bbc'>Awards and recognition: <\/strong><\/span><\/span><\/span><\/span><br \/>\n<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'>Palace Resorts Top PRO Agency <\/span><\/span><\/span><\/span><br \/>\n<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'>Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator <\/span><\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>AMResorts Master Agent & Top Agency<\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>Travel Impressions Best of the Best Globe Winner<\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>Apple Vacations Golden Apple Winner<\/span><\/span><\/span>","Email":"barbara@wrighttravelagency.com","IpAddress":"69.57.225.114","GroupId":49,"GroupName":"Insiders","JoinDate":1325595105,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-249263.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"TA Babs","Id":249263,"Name":"TA Babs","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.14.13.91","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79819,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3e9e5efcd20af935d6c3c3ccd29a9439","RawContent":"Hi TA Babs\n\n\nSo far I have narrowed down to these resorts:\n\n\nRoyalton white sands \n\nIberostar rose hall\n\nSunscape resort\n\nGrand palladium\n\nSea garden beach resort\n\n\nAny good or bad feedback about any of these? Thanks!","Attachments":[],"Id":1908803,"PostDate":1451552580,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                 