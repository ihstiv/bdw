{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":2,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":523,"MovedTo":null,"MovedOn":0,"FirstPostId":1908201,"Rating":0,"RatingHits":0,"Starter":{"Id":282541,"Name":"chantel333","Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1449518763,"LastPoster":{"Id":284777,"Name":"ammbeer","Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":38,"Preview":{"Id":1908201,"PostDate":1449518763,"PostContent":"I don't know where else to turn to ask this question. I habe exhausted every possible option I ca...","Author":{"Signature":"","Email":"cpaetkau@axiomwell.com","IpAddress":"174.136.119.43","GroupId":39,"GroupName":"Newbie","JoinDate":1427302993,"Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"chantel333","Id":282541,"Name":"chantel333","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"104.160.214.184","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79785,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"716bb38655eaeffc63e3ae12b67e3682","RawContent":"I don&#039;t know where else to turn to ask this question. I habe exhausted every possible option I can think of. I am hoping someone here has some experience or could even give me other options of who to contact. \n\n\nWe have a rustic theme to our wedding. I would absolutely love to bring some wooden rounds\/wooden disks\/wooden slabs (heard them called many things) down to use as centerpieces. I&#039;m having trouble however figuring out if I can bring this stuff. I know it says we have to declare this stuff coming to mexico from canada but are they going to allow it ? They would be stained and sealed if it makes any difference.\n\n\nI would be devistated to have this stuff taken away by customs and have no centerpieces. So if anyone has any ideas or experience with this I&#039;d love to hear some answers haha.\n\n\nThanks ladies !!!","Attachments":[],"Id":1908201,"PostDate":1449518763,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I don't know where else to turn to ask this question. I habe exhausted every possible option I can think of. I am hoping someone here has some experience or could even give me other options of who to contact. <br><br>\nWe have a rustic theme to our wedding. I would absolutely love to bring some wooden rounds\/wooden disks\/wooden slabs (heard them called many things) down to use as centerpieces. I'm having trouble however figuring out if I can bring this stuff. I know it says we have to declare this stuff coming to mexico from canada but are they going to allow it ? They would be stained and sealed if it makes any difference.<br><br>\nI would be devistated to have this stuff taken away by customs and have no centerpieces. So if anyone has any ideas or experience with this I'd love to hear some answers haha.<br><br>\nThanks ladies !!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cpaetkau@axiomwell.com","IpAddress":"174.136.119.43","GroupId":39,"GroupName":"Newbie","JoinDate":1427302993,"Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"chantel333","Id":282541,"Name":"chantel333","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.198.33.28","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79785,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d7a59242768c5ee426372e8c0399ef88","RawContent":"&lt;p&gt;I would like to know this too. &amp;nbsp;We are using a wooden anchor for our guest book.&lt;\/p&gt;","Attachments":[],"Id":1908965,"PostDate":1451926919,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I would like to know this too. \u00a0We are using a wooden anchor for our guest book.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"amberlhanson@gmail.com","IpAddress":"72.200.248.13","GroupId":39,"GroupName":"Newbie","JoinDate":1441972231,"Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"ammbeer","Id":284777,"Name":"ammbeer","IsOnline":false}}],"Id":"79785","Title":"Anyonr Know If I Can I Take Wooden Decor To Cabo?","LastPostDate":1451926919},"Pages":{"TotalItems":2,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
