{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":65148,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"425a07b11173d027d828f8a8571fc44c","RawContent":"When I first started my wedding planning, my planner at the Riu was wonderful but they changed planners two times. It did make a big difference.","Attachments":[],"Id":1717150,"PostDate":1360153959,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                When I first started my wedding planning, my planner at the Riu was wonderful but they changed planners two times. It did make a big difference.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Schulzme@comcast.net","IpAddress":"63.230.177.44","GroupId":39,"GroupName":"Newbie","JoinDate":1353932326,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-262688.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Melissa015","Id":262688,"Name":"Melissa015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":65148,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b996faea36f52489ccfe4dde8986f742","RawContent":"Kerri85, I greatly appreciate your feedback on the spa at RIU Santa Fe! I am strongly considering booking Suzanne Morel. Do you have any other feedback on the wedding experience at this resort? Which package did you choose? We just booked our date for 2\/14\/14 so it&#039;s a ways off but can&#039;t help but start thinking of ideas :)","Attachments":[],"Id":1717856,"PostDate":1360269936,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Kerri85, I greatly appreciate your feedback on the spa at RIU Santa Fe! I am strongly considering booking Suzanne Morel. Do you have any other feedback on the wedding experience at this resort? Which package did you choose? We just booked our date for 2\/14\/14 so it's a ways off but can't help but start thinking of ideas <img src='https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"emk415@gmail.com","IpAddress":"67.170.48.211","GroupId":39,"GroupName":"Newbie","JoinDate":1358271446,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-264523.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"emk415","Id":264523,"Name":"emk415","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":65148,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"675caa981cc791170e433728340224a1","RawContent":"Hey ladies, So I&#039;m getting married at the Riu Santa Fe on the 21st. I will let you know how it goes :). I will say.. Planning over the phone\/ internet makes it harder, my planner has also changed a couple of times. I have to keep reminding myself, this is Mexico and things are probably going to go wrong. I will try to post pictures and let you know things to bring or do differently. :)","Attachments":[],"Id":1717996,"PostDate":1360313139,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hey ladies, So I'm getting married at the Riu Santa Fe on the 21st. I will let you know how it goes <img src='https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>. I will say.. Planning over the phone\/ internet makes it harder, my planner has also changed a couple of times. I have to keep reminding myself, this is Mexico and things are probably going to go wrong. I will try to post pictures and let you know things to bring or do differently. <img src='https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kiska1010@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1348592054,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-260687.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":101,"PhotoType":"custom"},"FormattedName":"kiska","Id":260687,"Name":"kiska","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":65148,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ef4235cf779c8bb267d099c71e6d6134","RawContent":"&lt;p&gt; We just got confirmation that our wedding date is submitted, march 31, 2014 at the RIU Santa Fe!\n \n We love the RIU, it was our first trip together, I cannot wait till our special day BUT it&amp;nbsp;seems like a headache talking to the people who cofirm your wedding, theres so many things that have changed! We have aprox 50-60 guest comming, we booked the royal package which is for 20 people and each extra person is 22 extra (which we were fine with) After i got my wedding confirmed she said if i have over 50 people I will have to book a private dinner event, Which looking at the 2013 pricing will be 600 for the venue and 26-60 dollars extra per person (for buffet). Am i the only one who thinks that is silly to pay extra at a all inclusive hotel? like 60 dollars a plate is ALOT\n \n &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1718009,"PostDate":1360313865,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> We just got confirmation that our wedding date is submitted, march 31, 2014 at the RIU Santa Fe!<br \/> <br \/> We love the RIU, it was our first trip together, I cannot wait till our special day BUT it\u00a0seems like a headache talking to the people who cofirm your wedding, theres so many things that have changed! We have aprox 50-60 guest comming, we booked the royal package which is for 20 people and each extra person is 22 extra (which we were fine with) After i got my wedding confirmed she said if i have over 50 people I will have to book a private dinner event, Which looking at the 2013 pricing will be 600 for the venue and 26-60 dollars extra per person (for buffet). Am i the only one who thinks that is silly to pay extra at a all inclusive hotel? like 60 dollars a plate is ALOT<br \/> <br \/> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bkmatchem@gmail.com","IpAddress":"142.179.206.191","GroupId":39,"GroupName":"Newbie","JoinDate":1355931153,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-263379.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":105,"PhotoType":"custom"},"FormattedName":"knelson","Id":263379,"Name":"knelson","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":65148,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"efd0ecfa15c206ded3a42d1c3c00cd83","RawContent":"Kiska, that is so exciting, your big day is almost here!!!!! I would greatly appreciate any and all advice you can provide :) I am trying to keep in mind that a lot if things will be out of my control and to be somewhat laid back about the whole thing. I know that every little thing is not going to be perfect, but what could be better than getting married in paradise!! We only plan to have 25-30 guests, sounds like it is expensive once you get above 50.","Attachments":[],"Id":1718057,"PostDate":1360317620,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Kiska, that is so exciting, your big day is almost here!!!!! I would greatly appreciate any and all advice you can provide <img src='https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> I am trying to keep in mind that a lot if things will be out of my control and to be somewhat laid back about the whole thing. I know that every little thing is not going to be perfect, but what could be better than getting married in paradise!! We only plan to have 25-30 guests, sounds like it is expensive once you get above 50.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"emk415@gmail.com","IpAddress":"67.170.48.211","GroupId":39,"GroupName":"Newbie","JoinDate":1358271446,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-264523.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"emk415","Id":264523,"Name":"emk415","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":65148,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7106d68091fd5c2979d73dc506b9fc7b","RawContent":"&lt;p&gt; Hey girls,&lt;\/p&gt; &lt;p&gt; I have March 3rd, 2014 booked for a ceremony on the beach at 4 pm.&amp;nbsp; I booked the caprice package only because I thought it would satisfy my guests more as I am anticipating 55-70 people.&amp;nbsp; I want a private dinner\/reception but I have not yet been able to get ahold of the coordinator.&amp;nbsp; It is helpful to know that anything over 50 is manatory to have a private reception but do you know if they have anything other than a buffet style- as I was really hoping to have a served dinner?&amp;nbsp; Knelson- I agree with you that it is crazy that they are expecting us to pay more and more for food as it is all inculsive.&amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I was hoping that if someone had a private reception if they would be able to answer some of my questions.&lt;\/p&gt; &lt;p&gt; Where is the private reception: indoors or outdoors?&lt;\/p&gt; &lt;p&gt; Did you have the option of having buffet or served dinner?&lt;\/p&gt; &lt;p&gt; What were the additional costs of having a private reception?&lt;\/p&gt; &lt;p&gt; Has anyone had a private reception on the beach?&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Any comments or advice would be so greatly appeciated!!&lt;\/p&gt; &lt;p&gt; -Janelle&lt;\/p&gt;","Attachments":[],"Id":1729895,"PostDate":1362559208,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hey girls,<\/p> <p> I have March 3rd, 2014 booked for a ceremony on the beach at 4 pm.\u00a0 I booked the caprice package only because I thought it would satisfy my guests more as I am anticipating 55-70 people.\u00a0 I want a private dinner\/reception but I have not yet been able to get ahold of the coordinator.\u00a0 It is helpful to know that anything over 50 is manatory to have a private reception but do you know if they have anything other than a buffet style- as I was really hoping to have a served dinner?\u00a0 Knelson- I agree with you that it is crazy that they are expecting us to pay more and more for food as it is all inculsive.\u00a0<\/p> <p> \u00a0<\/p> <p> I was hoping that if someone had a private reception if they would be able to answer some of my questions.<\/p> <p> Where is the private reception: indoors or outdoors?<\/p> <p> Did you have the option of having buffet or served dinner?<\/p> <p> What were the additional costs of having a private reception?<\/p> <p> Has anyone had a private reception on the beach?<\/p> <p> \u00a0<\/p> <p> Any comments or advice would be so greatly appeciated!!<\/p> <p> -Janelle<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"umwakalu@cc.umanitoba.ca","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1362558550,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-266967.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"janellekrista","Id":266967,"Name":"janellekrista","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":65148,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"90c3f36b05ba3731cf3033754d074471","RawContent":"&lt;p&gt; I talked to the person booking the riu again and she said something about you can book just the resturant for a fee and dont need to pay per plate (lets hope she is right)\n \n remember that as soon as you go over the amount of people that is allowed in the wedding package you have to pay a extra 22 dollars per person, as we have the royal package so we get 20 people for free then pay for the other say 35 people attending.\n \n she said the wedding planner wont contact us 2014 brides for a while as she is workin gon 2013 brides right now&lt;\/p&gt;","Attachments":[],"Id":1730728,"PostDate":1362660758,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I talked to the person booking the riu again and she said something about you can book just the resturant for a fee and dont need to pay per plate (lets hope she is right)<br \/> <br \/> remember that as soon as you go over the amount of people that is allowed in the wedding package you have to pay a extra 22 dollars per person, as we have the royal package so we get 20 people for free then pay for the other say 35 people attending.<br \/> <br \/> she said the wedding planner wont contact us 2014 brides for a while as she is workin gon 2013 brides right now<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bkmatchem@gmail.com","IpAddress":"142.179.206.191","GroupId":39,"GroupName":"Newbie","JoinDate":1355931153,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-263379.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":105,"PhotoType":"custom"},"FormattedName":"knelson","Id":263379,"Name":"knelson","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":65148,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a493b6c17e516e469e9e3b92afaec8c2","RawContent":"&lt;p&gt; also the private venues, one goes for 600$ and for buffet the plate is between 36-60 dollars the non buffet menu is more expensive&lt;\/p&gt;","Attachments":[],"Id":1730729,"PostDate":1362660830,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> also the private venues, one goes for 600$ and for buffet the plate is between 36-60 dollars the non buffet menu is more expensive<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bkmatchem@gmail.com","IpAddress":"142.179.206.191","GroupId":39,"GroupName":"Newbie","JoinDate":1355931153,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-263379.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":105,"PhotoType":"custom"},"FormattedName":"knelson","Id":263379,"Name":"knelson","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":65148,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5527bd505fd9d986ca309fcc0025f999","RawContent":"&lt;p&gt; &lt;span style=\"font-size: 10pt;\"&gt;&lt;span style=\"font-family: arial,sans-serif;\"&gt;&lt;span style=\"color: black;\"&gt;Good Afternoon Ladies,&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt;\"&gt;&lt;span style=\"font-family: arial,sans-serif;\"&gt;&lt;span style=\"color: black;\"&gt;I wanted to give you my review on the Riu Santa fe as I just got back from Cabo and was married there on February 11, 2013. We were all together in Cabo for 3 weeks which was great because the first week( wedding week) is crazy! I think we enjoyed the pools and the beach for maybe 4 out of the 7. So a tip would be to stay longer cause the wedding makes everything crazy. For this Wedding I did hire a wedding planner to deal with the planning.&amp;nbsp; This made it very easy for us not having to worry about the details as she had planned weddings here before.&amp;nbsp; She was a local from Vancouver Sarah from Mason Horvath travel.&amp;nbsp; Another godsent decision on our part!&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt;\"&gt;&lt;span style=\"font-family: arial,sans-serif;\"&gt;&lt;span style=\"color: black;\"&gt;Arrived Thursday the 7th everything was great Rooms are beautiful.&amp;nbsp; We Paid for an ocean view suite and got one on the Corner of building 7 which gave us a 180 view of the arches,beach and downtown Cabo.&amp;nbsp; We could actually lay in our bed and look at the arches through the window!&amp;nbsp; All my guests\u00e2\u20ac\u2122 rooms, even though they did not pay for the ocean view rooms, got to be in building 7 and had a good view as well.&amp;nbsp; We did all book together and this could have been the factor in this because they put wedding guests and party together.&amp;nbsp; &lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt;\"&gt;&lt;span style=\"font-family: arial,sans-serif;\"&gt;&lt;span style=\"color: black;\"&gt;Friday 8&lt;sup&gt;th&lt;\/sup&gt;-&amp;nbsp; Had a meeting with our outside Photographer Gilda Billado, She is amazing! Great attitude and saw some of the pictures from the day on her camera and they were amazing! &lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt;\"&gt;&lt;span style=\"font-family: arial,sans-serif;\"&gt;&lt;span style=\"color: black;\"&gt;Then a meeting with the wedding planner at the resort.&amp;nbsp; That meeting went well they go over how the day will go and all the details needed. We had a very simple ceremony so not much to go over.&amp;nbsp; The one problem was they did not book us a minister.&amp;nbsp; This was a problem.&amp;nbsp; We ended up calling our wedding planner in Vancouver after that meeting to figure things out. &amp;nbsp;Even thou my wedding planner in Vancouver had asked them about this in particular, they emailed her and said it was included! She thank god figured everything out for us which helped us enjoy a little bit our day in the sun! Otherwise we would have had that stress! We ended up paying the extra fee but my wedding planner is trying to get the $700 back because they had told her no cost!&amp;nbsp; With all the mix-up we got a free bottle of champagne that day in our room! And on the wedding day we got breakfast in bed which was great also. &lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt;\"&gt;&lt;span style=\"font-family: arial,sans-serif;\"&gt;&lt;span style=\"color: black;\"&gt;Monday the 11&lt;sup&gt;th&lt;\/sup&gt; \u00e2\u20ac\u201c Wedding Day&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt;\"&gt;&lt;span style=\"font-family: arial,sans-serif;\"&gt;&lt;span style=\"color: black;\"&gt;Renvova Spa- all us girls got our hair and makeup done at the spa on site and it was great! We all had hair pictures of what we wanted.&amp;nbsp; They also had a book of hair designs in the studio.&amp;nbsp; Everything looked exactly how we wanted.&amp;nbsp; They use MAC makeup and did an excellent job no complaints at all.&amp;nbsp; And when you book in advance before you go you get an extra 10% off.&amp;nbsp; I ended up spending $596.00 to get 3 bridesmaids hair and makeup and the brides makeup and Hair.&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt;\"&gt;&lt;span style=\"font-family: arial,sans-serif;\"&gt;&lt;span style=\"color: black;\"&gt;Flowers- excellent, colorful absolutely worth the money.&amp;nbsp; Because we were there an extra 2.5 weeks after the wedding we brought them to our other hotel and they lasted till we left Mexico after keeping them watered!&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt;\"&gt;&lt;span style=\"font-family: arial,sans-serif;\"&gt;&lt;span style=\"color: black;\"&gt;Setup- everything was how we wanted it on the beach&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt;\"&gt;&lt;span style=\"font-family: arial,sans-serif;\"&gt;&lt;span style=\"color: black;\"&gt;Marachi band 3pc- we got this for 45 minutes for the ceremony was great for a mexican wedding!&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt;\"&gt;&lt;span style=\"font-family: arial,sans-serif;\"&gt;&lt;span style=\"color: black;\"&gt;Minister- Amazing even with the hiccup He said very kind words and just had a meeting for like 30 minutes prior to the ceremony to ask about us and it was perfect.&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt;\"&gt;&lt;span style=\"font-family: arial,sans-serif;\"&gt;&lt;span style=\"color: black;\"&gt;In between we got pictures done and all the guests just went to the pool bar and waited for us or till dinner.&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt;\"&gt;&lt;span style=\"font-family: arial,sans-serif;\"&gt;&lt;span style=\"color: black;\"&gt;Reception 630 semi private at the steakhouse.&amp;nbsp; \u00e2\u20ac\u201cThis was very private.&amp;nbsp; There is about 6 other tables in the restaurant but on the other side so it was absolutely perfect no need for a private dinner.&amp;nbsp; Everyone\u00e2\u20ac\u2122s food was good and cake was good too! The only thing is there is a time limit and they defiantly got us out of there at 8.&amp;nbsp; We also played our Ipod dock right in the restaurant and there was no issue.&amp;nbsp; We did our first dance at that time too!&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt;\"&gt;&lt;span style=\"font-family: arial,sans-serif;\"&gt;&lt;span style=\"color: black;\"&gt;After dinner- we walked with all our guests back to the main square where all the restaurants , club, bars are and pulled some tables together right by the bar and did the bouquet and garter toss then played our ipod a little more until the club opened at 10 and then danced in there all night!&amp;nbsp; It was a great free alternative.&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt;\"&gt;&lt;span style=\"font-family: arial,sans-serif;\"&gt;&lt;span style=\"color: black;\"&gt;Basically the whole wedding was great exactly what we wanted.&amp;nbsp; We ended up paying $2630 for the \"Free wedding\" at the riu including flowers, mariachi, the extra 21 people setup, outside photographer cost and an extra 20 bottles of champagne.&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt;\"&gt;&lt;span style=\"font-family: arial,sans-serif;\"&gt;&lt;span style=\"color: black;\"&gt;I hope that helps some people decide on the riu. Please let me know if you have any questions.&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1731169,"PostDate":1362741593,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial,sans-serif\"><span  style=\"color: black\">Good Afternoon Ladies,<\/span><\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial,sans-serif\"><span  style=\"color: black\">I wanted to give you my review on the Riu Santa fe as I just got back from Cabo and was married there on February 11, 2013. We were all together in Cabo for 3 weeks which was great because the first week( wedding week) is crazy! I think we enjoyed the pools and the beach for maybe 4 out of the 7. So a tip would be to stay longer cause the wedding makes everything crazy. For this Wedding I did hire a wedding planner to deal with the planning.\u00a0 This made it very easy for us not having to worry about the details as she had planned weddings here before.\u00a0 She was a local from Vancouver Sarah from Mason Horvath travel.\u00a0 Another godsent decision on our part!<\/span><\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial,sans-serif\"><span  style=\"color: black\">Arrived Thursday the 7th everything was great Rooms are beautiful.\u00a0 We Paid for an ocean view suite and got one on the Corner of building 7 which gave us a 180 view of the arches,beach and downtown Cabo.\u00a0 We could actually lay in our bed and look at the arches through the window!\u00a0 All my guests\u00e2\u20ac\u2122 rooms, even though they did not pay for the ocean view rooms, got to be in building 7 and had a good view as well.\u00a0 We did all book together and this could have been the factor in this because they put wedding guests and party together.\u00a0 <\/span><\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial,sans-serif\"><span  style=\"color: black\">Friday 8<sup>th<\/sup>-\u00a0 Had a meeting with our outside Photographer Gilda Billado, She is amazing! Great attitude and saw some of the pictures from the day on her camera and they were amazing! <\/span><\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial,sans-serif\"><span  style=\"color: black\">Then a meeting with the wedding planner at the resort.\u00a0 That meeting went well they go over how the day will go and all the details needed. We had a very simple ceremony so not much to go over.\u00a0 The one problem was they did not book us a minister.\u00a0 This was a problem.\u00a0 We ended up calling our wedding planner in Vancouver after that meeting to figure things out. \u00a0Even thou my wedding planner in Vancouver had asked them about this in particular, they emailed her and said it was included! She thank god figured everything out for us which helped us enjoy a little bit our day in the sun! Otherwise we would have had that stress! We ended up paying the extra fee but my wedding planner is trying to get the $700 back because they had told her no cost!\u00a0 With all the mix-up we got a free bottle of champagne that day in our room! And on the wedding day we got breakfast in bed which was great also. <\/span><\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial,sans-serif\"><span  style=\"color: black\">Monday the 11<sup>th<\/sup> \u00e2\u20ac\u201c Wedding Day<\/span><\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial,sans-serif\"><span  style=\"color: black\">Renvova Spa- all us girls got our hair and makeup done at the spa on site and it was great! We all had hair pictures of what we wanted.\u00a0 They also had a book of hair designs in the studio.\u00a0 Everything looked exactly how we wanted.\u00a0 They use MAC makeup and did an excellent job no complaints at all.\u00a0 And when you book in advance before you go you get an extra 10% off.\u00a0 I ended up spending $596.00 to get 3 bridesmaids hair and makeup and the brides makeup and Hair.<\/span><\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial,sans-serif\"><span  style=\"color: black\">Flowers- excellent, colorful absolutely worth the money.\u00a0 Because we were there an extra 2.5 weeks after the wedding we brought them to our other hotel and they lasted till we left Mexico after keeping them watered!<\/span><\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial,sans-serif\"><span  style=\"color: black\">Setup- everything was how we wanted it on the beach<\/span><\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial,sans-serif\"><span  style=\"color: black\">Marachi band 3pc- we got this for 45 minutes for the ceremony was great for a mexican wedding!<\/span><\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial,sans-serif\"><span  style=\"color: black\">Minister- Amazing even with the hiccup He said very kind words and just had a meeting for like 30 minutes prior to the ceremony to ask about us and it was perfect.<\/span><\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial,sans-serif\"><span  style=\"color: black\">In between we got pictures done and all the guests just went to the pool bar and waited for us or till dinner.<\/span><\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial,sans-serif\"><span  style=\"color: black\">Reception 630 semi private at the steakhouse.\u00a0 \u00e2\u20ac\u201cThis was very private.\u00a0 There is about 6 other tables in the restaurant but on the other side so it was absolutely perfect no need for a private dinner.\u00a0 Everyone\u00e2\u20ac\u2122s food was good and cake was good too! The only thing is there is a time limit and they defiantly got us out of there at 8.\u00a0 We also played our Ipod dock right in the restaurant and there was no issue.\u00a0 We did our first dance at that time too!<\/span><\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial,sans-serif\"><span  style=\"color: black\">After dinner- we walked with all our guests back to the main square where all the restaurants , club, bars are and pulled some tables together right by the bar and did the bouquet and garter toss then played our ipod a little more until the club opened at 10 and then danced in there all night!\u00a0 It was a great free alternative.<\/span><\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial,sans-serif\"><span  style=\"color: black\">Basically the whole wedding was great exactly what we wanted.\u00a0 We ended up paying $2630 for the \"Free wedding\" at the riu including flowers, mariachi, the extra 21 people setup, outside photographer cost and an extra 20 bottles of champagne.<\/span><\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial,sans-serif\"><span  style=\"color: black\">I hope that helps some people decide on the riu. Please let me know if you have any questions.<\/span><\/span><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"arlakaulbars@gmail.com","IpAddress":"174.1.0.18","GroupId":39,"GroupName":"Newbie","JoinDate":1338468194,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-256099.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Arla","Id":256099,"Name":"Arla","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":65148,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4db94065e46e75ae614d051601a4117d","RawContent":"&lt;p&gt; Congrats!&amp;nbsp; I would love to hear about your experience at the Santa Fe Resort and how your wedding went.&amp;nbsp; Also would love to see pictures!&amp;nbsp; I am getting married there April 22, next month.&amp;nbsp;&lt;span alt=\":feedback:\" id=\"yui_3_7_3_1_1363238456126_814\" rel=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/feedback.gif\"&gt;&lt;img height=\"60\" id=\"yui_3_7_3_1_1363238456126_813\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/feedback.gif\" width=\"50\" \/&gt;&lt;\/span&gt;&amp;nbsp; Thank you!&lt;\/p&gt;","Attachments":[],"Id":1733553,"PostDate":1363209811,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Congrats!\u00a0 I would love to hear about your experience at the Santa Fe Resort and how your wedding went.\u00a0 Also would love to see pictures!\u00a0 I am getting married there April 22, next month.\u00a0<span alt=\":feedback:\" id=\"yui_3_7_3_1_1363238456126_814\" rel=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/feedback.gif\"><span rel='lightbox'><img class='bbc_img' height=\"60\" id=\"yui_3_7_3_1_1363238456126_813\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/feedback.gif\" width=\"50\" \/><\/span><\/span>\u00a0 Thank you!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cgrzeskowiak@msn.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1363208543,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-267332.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"cg1227","Id":267332,"Name":"cg1227","IsOnline":false}}],"Pages":{"TotalItems":94,"TotalPages":10,"CurrentPage":50,"NextPage":60,"PreviousPage":40,"LastPage":90},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
