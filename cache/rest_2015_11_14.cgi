{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":8,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":677,"MovedTo":null,"MovedOn":0,"FirstPostId":1905092,"Rating":0,"RatingHits":0,"Starter":{"Id":284874,"Name":"smfahey","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1442794391,"LastPoster":{"Id":230711,"Name":"Moments That Matter","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1905092,"PostDate":1442794391,"PostContent":"Hello, \u00a0 My name is Stacy and I am planning a destination wedding for February 2017.\u00a0 I know I'm...","Author":{"Signature":"","Email":"stasia2914@yahoo.com","IpAddress":"75.73.80.191","GroupId":39,"GroupName":"Newbie","JoinDate":1442793909,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"smfahey","Id":284874,"Name":"smfahey","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.73.80.191","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79605,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"2d57f50a679b19a249813725f80c4be9","RawContent":"&lt;p&gt;Hello,&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;My name is Stacy and I am planning a destination wedding for February 2017.&amp;nbsp; I know I&#039;m a bit early but thought I would see if there are any other brides out there also getting married in the area or around the same date?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Are there any recommendations on AI hotels that allow kids, daily activities, yet reasonable priced.&amp;nbsp; I looked into Catalonia Riviera Maya which seems very reasonable but am open to all suggestions.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thanks :)&lt;\/p&gt;","Attachments":[],"Id":1905092,"PostDate":1442794391,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello,<\/p>\n<p>\u00a0<\/p>\n<p>My name is Stacy and I am planning a destination wedding for February 2017.\u00a0 I know I'm a bit early but thought I would see if there are any other brides out there also getting married in the area or around the same date?<\/p>\n<p>\u00a0<\/p>\n<p>Are there any recommendations on AI hotels that allow kids, daily activities, yet reasonable priced.\u00a0 I looked into Catalonia Riviera Maya which seems very reasonable but am open to all suggestions.<\/p>\n<p>\u00a0<\/p>\n<p>Thanks <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"stasia2914@yahoo.com","IpAddress":"75.73.80.191","GroupId":39,"GroupName":"Newbie","JoinDate":1442793909,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"smfahey","Id":284874,"Name":"smfahey","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.199.84.88","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79605,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f46e7a7526405729afa46ad4ac906f39","RawContent":"I got married last month at NOW sapphire. It was amazing!!","Attachments":[],"Id":1905094,"PostDate":1442794591,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I got married last month at NOW sapphire. It was amazing!! \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lornj29@aim.com","IpAddress":"68.192.37.147","GroupId":39,"GroupName":"Newbie","JoinDate":1410109020,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"lornj29","Id":279723,"Name":"lornj29","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.146.146.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79605,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5d53d66d239511457bdf7123ea7c73d6","RawContent":"I got married at the Grand Sirenis in January and loved it.   Maybe have a peak in the review section too :)\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1905098,"PostDate":1442796201,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I got married at the Grand Sirenis in January and loved it.   Maybe have a peak in the review section too <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399428602,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.73.80.191","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79605,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fcc355cc746c1438e71582fc16848bad","RawContent":"[quote name=\"lornj29\" post=\"1905094\" timestamp=\"1442794591\"]\nI got married last month at NOW sapphire. It was amazing!![\/quote]\n When did you get married here?  Were there any group perks given?\n\nThanks for the input :)\n[quote name=\"calgarybride2015\" post=\"1905098\" timestamp=\"1442796201\"]\nI got married at the Grand Sirenis in January and loved it. Maybe have a peak in the review section too :)\n\n\nSent from my iPhone using Tapatalk[\/quote] I&#039;ll check this one out as well thank you .","Attachments":[],"Id":1905101,"PostDate":1442797436,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>lornj29, on 20 September 2015 - 04:16 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>I got married last month at NOW sapphire. It was amazing!!<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>\u00a0When did you get married here?\u00a0 Were there any group perks given?<\/p>\n<p>\u00a0<\/p>\n<p>Thanks for the input <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p><br \/><p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>calgarybride2015, on 20 September 2015 - 04:43 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>I got married at the Grand Sirenis in January and loved it. Maybe have a peak in the review section too <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br><br><br>\nSent from my iPhone using Tapatalk<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0I'll check this one out as well thank you .<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"stasia2914@yahoo.com","IpAddress":"75.73.80.191","GroupId":39,"GroupName":"Newbie","JoinDate":1442793909,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"smfahey","Id":284874,"Name":"smfahey","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.192.32.8","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79605,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6540795948b59c7835752d4b839b265d","RawContent":"[quote name=\"smfahey\" post=\"1905101\" timestamp=\"1442797319\"]\nWhen did you get married here?  Were there any group perks given?\n \nThanks for the input :)[\/quote]I got married there August 15th. There were some perks through destination weddings.com like we got a room credit and some upgrades but it all depends on what kind of specials they are running . There weren&#039;t any at the time we went. But I know some hotels have more perks than others","Attachments":[],"Id":1905103,"PostDate":1442797556,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>smfahey, on 20 September 2015 - 05:01 PM, said:<\/p><div class='blockquote'><div class='quote'><p>\nWhen did you get married here?\u00a0 Were there any group perks given?<br>\n\u00a0<br>\nThanks for the input <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p><\/div><\/div>\n<br>\nI got married there August 15th. There were some perks through destination weddings.com like we got a room credit and some upgrades but it all depends on what kind of specials they are running . There weren't any at the time we went. But I know some hotels have more perks than others\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lornj29@aim.com","IpAddress":"68.192.37.147","GroupId":39,"GroupName":"Newbie","JoinDate":1410109020,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"lornj29","Id":279723,"Name":"lornj29","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.73.80.191","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79605,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"72263d551b657ec257400556953fce8f","RawContent":"[quote name=\"1weddingirl\" post=\"1905106\" timestamp=\"1442802651\"]\nCongrats, Stacy!\n\nDifferent hotels run different promotions and you could get a hotel you didn&#039;t think was affordable based on the promotion. Do you have any idea how many people may attend?\n\nI agree the Now properties are great for families. Gran Porto and Gran Caribe are also great choices. I know the Gran properties have the Big Day Preview to visit the properties.[\/quote]\nI will know more in a few months but as of now I have for sure 10 rooms(double occupancy) all staying 7 nights.\n\nWe are a youngish group (33-37) and would prefer pool activities, nightly shows, and a variety of things to do.  Just having trouble finding something reasonably priced as well.  I will check out the Gran properties thank you :)","Attachments":[],"Id":1905108,"PostDate":1442803522,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>1weddingirl, on 20 September 2015 - 06:30 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Congrats, Stacy!<\/p>\n<p>\u00a0<\/p>\n<p>Different hotels run different promotions and you could get a hotel you didn't think was affordable based on the promotion. Do you have any idea how many people may attend?<\/p>\n<p>\u00a0<\/p>\n<p>I agree the Now properties are great for families. Gran Porto and Gran Caribe are also great choices. I know the Gran properties have the Big Day Preview to visit the properties.\u00a0<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>I will know more in a few months but as of now I have for sure 10 rooms(double occupancy) all staying 7 nights.<\/p>\n<p>\u00a0<\/p>\n<p>We are a youngish group (33-37) and would prefer pool activities, nightly shows, and a variety of things to do.\u00a0 Just having trouble finding something reasonably priced as well.\u00a0 I will check out the Gran properties thank you <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"stasia2914@yahoo.com","IpAddress":"75.73.80.191","GroupId":39,"GroupName":"Newbie","JoinDate":1442793909,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"smfahey","Id":284874,"Name":"smfahey","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"200.79.251.123","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79605,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"088dfe79eaf012aa500c350fd3bb0bbd","RawContent":"[quote name=\"smfahey\" post=\"1905092\" timestamp=\"1442794391\"]\nHello,\n\nMy name is Stacy and I am planning a destination wedding for February 2017.  I know I&#039;m a bit early but thought I would see if there are any other brides out there also getting married in the area or around the same date?\n\nAre there any recommendations on AI hotels that allow kids, daily activities, yet reasonable priced.  I looked into Catalonia Riviera Maya which seems very reasonable but am open to all suggestions.\n\nThanks :)[\/quote]@[member=\"1weddingirl\"] its never too early to start planning  :) !  Have you spoken to a travel agent yet?   they can give you some options based on your requests.  also what is a reasonable price for you and for how many nights?  almost all all inclusive hotels offer some group rates and every hotel is different on their benefits you get when having a group staying there.\n\nHappy Planning!","Attachments":[],"Id":1905145,"PostDate":1442851063,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>smfahey, on 20 September 2015 - 04:13 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hello,<\/p>\n<p>\u00a0<\/p>\n<p>My name is Stacy and I am planning a destination wedding for February 2017.\u00a0 I know I'm a bit early but thought I would see if there are any other brides out there also getting married in the area or around the same date?<\/p>\n<p>\u00a0<\/p>\n<p>Are there any recommendations on AI hotels that allow kids, daily activities, yet reasonable priced.\u00a0 I looked into Catalonia Riviera Maya which seems very reasonable but am open to all suggestions.<\/p>\n<p>\u00a0<\/p>\n<p>Thanks <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<\/div>\n<\/div><\/div>\n<p>@\n\t1weddingirl\n its never too early to start planning\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> ! \u00a0Have you spoken to a travel agent yet? \u00a0 they can give you some options based on your requests. \u00a0also what is a reasonable price for you and for how many nights? \u00a0almost all all inclusive hotels offer some group rates and every hotel is different on their benefits you get when having a group staying there.<\/p>\n<p>\u00a0<\/p>\n<p>Happy Planning!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"Dream Weddings Riviera Maya- We pay attention to your wishes and coordinate closely with you to ensure your wedding or event is planned to perfection!<br \/>\n<br \/>\n<span style='color: rgb(40,40,40)'><span style='font-family: arial'><span style='font-size: 12px;'>Dream Weddings Riviera Maya<\/span><\/span><\/span><br \/>\n<span style='font-family: arial'><span style='font-size: 12px;'>weddingsinplayadelcarmen@gmail.com<\/span><\/span><br \/>\n<a class='bbc_url' href='http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html'>http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html<\/a><br \/>\n<br \/>\n<span style='color: rgb(40,40,40)'><span style='font-family: arial'><span style='font-size: 12px;'>Happy Planning!<\/span><\/span><\/span><br \/>\n<span style='color: rgb(40,40,40)'><span style='font-family: arial'><span style='font-size: 12px;'>Joyce<\/span><\/span><\/span>","Email":"weddingsinplayadelcarmen@gmail.com","IpAddress":"187.252.44.28","GroupId":84,"GroupName":"Insiders w\/ Articles","JoinDate":1326854387,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250090.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"dreamweddings","Id":250090,"Name":"dreamweddings","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"190.167.84.73","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79605,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"804b4979a89bcc6105f33a9b7c5df785","RawContent":"&lt;p&gt;Welcome to our forum community Stacy, and Congrats on your upcoming dw in 2017!!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;You may already have seen this, but in case you haven&#039;t, here&#039;s a link to some reviews of popular resorts in our area: &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/reviews\/c\/13-playa-del-carmen\/&#039;&gt;Resort Reviews &lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;As you can see there are numerous amazing choices, so we wish you happy research and all the best with your plans - cheers!!! team MTM :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;....for some added inspiration, here are a few magical wedding moments that matter we captured in our area, taken from our &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/MomentsThatMatterPhotography\/photos_stream?tab=photos_stream&#039;&gt;Cover Photos Album:&lt;\/a&gt; ......enjoy :)&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-mia1-1.xx.fbcdn.net\/hphotos-xpa1\/t31.0-8\/11951533_10153610355409487_3502002007315431031_o.jpg\" alt=\"11951533_10153610355409487_3502002007315\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-mia1-1.xx.fbcdn.net\/hphotos-xpf1\/t31.0-8\/11879252_10153584042509487_2314249334204118902_o.jpg\" alt=\"11879252_10153584042509487_2314249334204\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-mia1-1.xx.fbcdn.net\/hphotos-xfp1\/t31.0-8\/11894532_10153584042694487_5503370004056539156_o.jpg\" alt=\"11894532_10153584042694487_5503370004056\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-mia1-1.xx.fbcdn.net\/hphotos-xft1\/t31.0-8\/11900831_10153584042979487_1960166416525908520_o.jpg\" alt=\"11900831_10153584042979487_1960166416525\"&gt;&lt;\/p&gt;","Attachments":[],"Id":1905148,"PostDate":1442854492,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome to our forum community Stacy, and Congrats on your upcoming dw in 2017!!!<\/p>\n<p>\u00a0<\/p>\n<p>You may already have seen this, but in case you haven't, here's a link to some reviews of popular resorts in our area: <a href='http:\/\/www.bestdestinationwedding.com\/reviews\/c\/13-playa-del-carmen\/' class='bbc_url' title=''>Resort Reviews <\/a><\/p>\n<p>As you can see there are numerous amazing choices, so we wish you happy research and all the best with your plans - cheers!!! team MTM <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>....for some added inspiration, here are a few magical wedding moments that matter we captured in our area, taken from our <a href='https:\/\/www.facebook.com\/MomentsThatMatterPhotography\/photos_stream?tab=photos_stream' class='bbc_url' title='External link' rel='nofollow external'>Cover Photos Album:<\/a> ......enjoy <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-mia1-1.xx.fbcdn.net\/hphotos-xpa1\/t31.0-8\/11951533_10153610355409487_3502002007315431031_o.jpg\" alt=\"11951533_10153610355409487_3502002007315\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-mia1-1.xx.fbcdn.net\/hphotos-xpf1\/t31.0-8\/11879252_10153584042509487_2314249334204118902_o.jpg\" alt=\"11879252_10153584042509487_2314249334204\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-mia1-1.xx.fbcdn.net\/hphotos-xfp1\/t31.0-8\/11894532_10153584042694487_5503370004056539156_o.jpg\" alt=\"11894532_10153584042694487_5503370004056\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-mia1-1.xx.fbcdn.net\/hphotos-xft1\/t31.0-8\/11900831_10153584042979487_1960166416525908520_o.jpg\" alt=\"11900831_10153584042979487_1960166416525\"><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280210660,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}}],"Id":"79605","Title":"Playa Del Carmen\/riviera Maya Wedding 2017!","LastPostDate":1442854492},"Pages":{"TotalItems":8,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
