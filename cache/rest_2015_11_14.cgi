{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":true,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":68,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":47980,"MovedTo":null,"MovedOn":0,"FirstPostId":1467,"Rating":0,"RatingHits":0,"Starter":{"Id":206696,"Name":"TammyWright","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"IsOnline":false},"StartDate":1159167576,"LastPoster":{"Id":232000,"Name":"acw271011","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":67,"Preview":{"Id":1467,"PostDate":1159167576,"PostContent":"These are the new vendor rules as of 11\/29\/2011. (slight revision adding 8 & 9 3\/23\/2014)We will...","Author":{"Signature":"<p><span style=\"font-family:arial, helvetica, sans-serif;\">Founder and Owner of BestDestinationWedding.com \u00a0\/ \u00a0<\/span><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/'><strong><span style=\"font-family:arial, helvetica, sans-serif;\">Bride & Groom Fly FREE Promotion<\/span><\/strong><\/a><\/p>\n<p>\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><strong><a data-ipb='nomediaparse' href='http:\/\/wrighttravelagency.com\/inquiry\/'><span style=\"color:#008080;\">Looking for a travel agency that specializes in Destination Weddings<\/span><\/a><\/strong><span style=\"color:#008080;\"><strong>?<\/strong> \u00a0We are an award winning travel agency and you can <\/span><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style=\"color:#008080;\">read our reviews\u00a0here.<\/span><\/a><\/strong><\/span><br>\n\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"color:#008080;\"><strong>Awards and recognition:\u00a0<\/strong><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Palace Resorts Winner \"Top Travel Agent\", \"Top Homebased Travel Agency\" PRO Platinum Agency (Top Award) \u00a0 \u00a0 | \u00a0 \u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">AMResorts Master Agent & Top Agency \u00a0<\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/68050-karisma-hotels-givc-and-gi-wedding-consultants-wright-travel-agency\/'><strong>Wright Travel & Karisma GIVC Benefits<\/strong><\/a><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Travel Impressions Best of the Best Globe Winner \u00a0 \u00a0| \u00a0 \u00a0\u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Apple Vacations Golden Apple Winner \u00a0<\/span><\/span><br><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"> \u00a0 \u00a0<img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"font-size:14px;\"><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010'>Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><\/span><\/span><strong><span style=\"color:#b22222;\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a data-ipb='nomediaparse' href='mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com'>ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"admin@bestdestinationwedding.com","IpAddress":"71.202.225.11","GroupId":4,"GroupName":"Administrators","JoinDate":1137224220,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"FormattedName":"TammyWright","Id":206696,"Name":"TammyWright","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":274,"EditedBy":"","EditDate":1395628523,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ffd515eb1ebf465e8ffa801a1e3d9584","RawContent":"&lt;p&gt;&lt;strong&gt;These are the new vendor rules as of 11\/29\/2011. (slight revision adding 8 &amp;amp; 9 3\/23\/2014)&lt;\/strong&gt;\n\n&lt;u&gt;&lt;strong&gt;We will now have paid memberships for ALL Vendors to participate in the forum. &lt;\/strong&gt;&lt;\/u&gt;\n\n&lt;strong&gt;We have NEW vendor options:&lt;\/strong&gt;&lt;\/p&gt;\n&lt;ul&gt;&lt;li&gt;Please email &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;mailto:ads@bestdestinationwedding.com&#039;&gt;ads@bestdestinationwedding.com&lt;\/a&gt; for rates and available options.&lt;\/li&gt;\n&lt;\/ul&gt;&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;u&gt;&lt;strong&gt;ONLY INSIDER ACCOUNTS are allowed to participate on this forum but must abide by the following rules:&lt;\/strong&gt;&lt;\/u&gt;\n\n\n1. Please be honest about who you are. DO NOT pretend to be a bride or groom to promote your business.\n\n\n2. You are allowed 1 thread (in the \"Vendor Marketplace\" Forum) to introduce yourself and post your information advertising your business. Do not post your info in multiple threads.\n\n\n3. &lt;strong&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/bestdestinationwedding.com\/forum\/f98\/&#039;&gt;Vendors Marketplace&lt;\/a&gt;:&lt;\/strong&gt; Vendors are allowed to post 1 thread in the &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/bestdestinationwedding.com\/forum\/f98\/&#039;&gt;Vendor Marketplace&lt;\/a&gt; with their business info, website, pictures, etc. All other ads\/promotions\/specials must be approved by BDW so please send the information to us for approval.\n\n\n4. Please do not actively or aggressively solicit our members (PM-ing them or emailing them directly). &lt;strong&gt;If they would like information from you, they will contact you. We do not allow solicitations via pm. If it has been found that you have done so you may risk being banned from the forum. &lt;\/strong&gt;\n\n\n5. &lt;strong&gt;Spamming:&lt;\/strong&gt; Although it is ok to put your company information in your signature (please reference siggy rule regarding putting website links) and profile, SPAMMING is PROHIBITED. You will get one warning about spamming. One example of spamming is welcoming newbies and saying something like \"go to my website or contact me for more info\". &amp;nbsp;Try to at least post something helpful or welcoming in the post.\n&lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/spamsign.gif\" title=\"spam\" alt=\"spamsign.gif\"&gt;\n\n\n6. &lt;strong&gt;Promotions or Giveaways:&lt;\/strong&gt; If you are a Vendor and have a \"promotion\" or \"freebie\" offer that you would like to post, &lt;strong&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/bestdestinationwedding.com&#039;&gt;please email us&lt;\/a&gt;.&lt;\/strong&gt; &amp;nbsp; We do not want conflicting promos that may take away from another vendors give-away, etc.&amp;nbsp;\n\n\n7. &lt;strong&gt;Starting new threads that profile&lt;\/strong&gt; your work (photography, invitations, etc.), please be sure that the following requirements are met:&lt;\/p&gt;\n&lt;ul&gt;&lt;li&gt;the subject is a Destination Wedding (ex. photogs - do not post great pics from a wedding in Georgia) OR the subject is a BDW member.&lt;\/li&gt;\n&lt;\/ul&gt;&lt;p&gt;8. &lt;strong&gt;Stay ON TOPIC&lt;\/strong&gt;: If the thread is about NOW Jade, do not post a random picture of another resort. &amp;nbsp;If the discussion is about a bride&#039;s frustration because her bridesmaid have backed out of the wedding, it is NOT appropriate to post pictures of a wedding picture you took with bunch of bridesmaids. &amp;nbsp;Try to be sensitive to the topic that is being discussed and share or support NOT just promote your business.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;9. &lt;strong&gt;Where to post your images:&lt;\/strong&gt; It is best to post them in your image gallery with the image properly named, categorize and\/or tagged. &amp;nbsp;Another great place to post them is in your &lt;strong&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/blogs\/&#039;&gt;Vendor Blog.&lt;\/a&gt;&lt;\/strong&gt;&amp;nbsp;If a member is asking for images of the gazebo at Dreams Los Cabos, it is appropriate to post one f your images of the gazebo at Dreams Los Cabos. &amp;nbsp;It is not appropriate to just post random images derailing the thread discussion.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;This includes business that are not wedding related (ie. your side photography business, your modeling portfolio, anything you are trying to advertise, etc.)\n\n\nTravel Agents: &lt;\/strong&gt;If you are a travel agent and would like to advertise and\/or participate on the site, please email &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;mailto:ads@bestdestinationwedding.com&#039;&gt;ads@bestdestinationwedding.com&lt;\/a&gt;. You must have destination wedding experience and there is a waiting list for travel agents to participate on the forum.&lt;strong&gt; &lt;\/strong&gt;\n\n&lt;span&gt;If you have paid for your yearly membership dues and\/or any advertising and break one of the &lt;\/span&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/a\/terms-of-service&#039;&gt;forum rules&lt;\/a&gt;&lt;span&gt;&amp;nbsp;or vendor rules and are &lt;\/span&gt;&lt;u&gt;banned from the forum, you will not receive a refund of any membership dues or advertising fees.&lt;\/u&gt;\n\n&lt;strong&gt;* The membership fees do not apply to the Administrator(s) or Moderators. Administrator(s) and Moderators are allowed same&amp;nbsp;privileges&amp;nbsp;as Insider Vendors.&lt;\/strong&gt;\n\n\n__________________\n\n\n\nThanks for joining us and we look forward to hearing from all of you.\n\n&lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/grouphug.gif\" title=\"Grouphug\" alt=\"grouphug.gif\"&gt;&lt;\/p&gt;","Attachments":[],"Id":1467,"PostDate":1159167576,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><strong>These are the new vendor rules as of 11\/29\/2011. (slight revision adding 8 & 9 3\/23\/2014)<\/strong><br><br><u><strong>We will now have paid memberships for ALL Vendors to participate in the forum. <\/strong><\/u><br><br><strong>We have NEW vendor options:<\/strong><\/p>\n<ul><li>Please email <a href='mailto:ads@bestdestinationwedding.com' class='bbc_url' title='External link' rel='nofollow external'>ads@bestdestinationwedding.com<\/a> for rates and available options.<\/li>\n<\/ul><p>\u00a0<\/p>\n<p><u><strong>ONLY INSIDER ACCOUNTS are allowed to participate on this forum but must abide by the following rules:<\/strong><\/u><br><br>\n1. Please be honest about who you are. DO NOT pretend to be a bride or groom to promote your business.<br><br>\n2. You are allowed 1 thread (in the \"Vendor Marketplace\" Forum) to introduce yourself and post your information advertising your business. Do not post your info in multiple threads.<br><br>\n3. <strong><a href='http:\/\/bestdestinationwedding.com\/forum\/f98\/' class='bbc_url' title='External link' rel='nofollow external'>Vendors Marketplace<\/a>:<\/strong> Vendors are allowed to post 1 thread in the <a href='http:\/\/bestdestinationwedding.com\/forum\/f98\/' class='bbc_url' title='External link' rel='nofollow external'>Vendor Marketplace<\/a> with their business info, website, pictures, etc. All other ads\/promotions\/specials must be approved by BDW so please send the information to us for approval.<br><br>\n4. Please do not actively or aggressively solicit our members (PM-ing them or emailing them directly). <strong>If they would like information from you, they will contact you. We do not allow solicitations via pm. If it has been found that you have done so you may risk being banned from the forum. <\/strong><br><br>\n5. <strong>Spamming:<\/strong> Although it is ok to put your company information in your signature (please reference siggy rule regarding putting website links) and profile, SPAMMING is PROHIBITED. You will get one warning about spamming. One example of spamming is welcoming newbies and saying something like \"go to my website or contact me for more info\". \u00a0Try to at least post something helpful or welcoming in the post.<br><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/spamsign.gif\" title=\"spam\" alt=\"spamsign.gif\"><\/span><br><br>\n6. <strong>Promotions or Giveaways:<\/strong> If you are a Vendor and have a \"promotion\" or \"freebie\" offer that you would like to post, <strong><a href='http:\/\/bestdestinationwedding.com' class='bbc_url' title='External link' rel='nofollow external'>please email us<\/a>.<\/strong> \u00a0 We do not want conflicting promos that may take away from another vendors give-away, etc.\u00a0<br><br>\n7. <strong>Starting new threads that profile<\/strong> your work (photography, invitations, etc.), please be sure that the following requirements are met:<\/p>\n<ul><li>the subject is a Destination Wedding (ex. photogs - do not post great pics from a wedding in Georgia) OR the subject is a BDW member.<\/li>\n<\/ul><p>8. <strong>Stay ON TOPIC<\/strong>: If the thread is about NOW Jade, do not post a random picture of another resort. \u00a0If the discussion is about a bride's frustration because her bridesmaid have backed out of the wedding, it is NOT appropriate to post pictures of a wedding picture you took with bunch of bridesmaids. \u00a0Try to be sensitive to the topic that is being discussed and share or support NOT just promote your business.<\/p>\n<p>\u00a0<\/p>\n<p>9. <strong>Where to post your images:<\/strong> It is best to post them in your image gallery with the image properly named, categorize and\/or tagged. \u00a0Another great place to post them is in your <strong><a href='http:\/\/www.bestdestinationwedding.com\/blogs\/' class='bbc_url' title=''>Vendor Blog.<\/a><\/strong>\u00a0If a member is asking for images of the gazebo at Dreams Los Cabos, it is appropriate to post one f your images of the gazebo at Dreams Los Cabos. \u00a0It is not appropriate to just post random images derailing the thread discussion.<\/p>\n<p>\u00a0<\/p>\n<p><strong>This includes business that are not wedding related (ie. your side photography business, your modeling portfolio, anything you are trying to advertise, etc.)<br><br>\nTravel Agents: <\/strong>If you are a travel agent and would like to advertise and\/or participate on the site, please email <a href='mailto:ads@bestdestinationwedding.com' class='bbc_url' title='External link' rel='nofollow external'>ads@bestdestinationwedding.com<\/a>. You must have destination wedding experience and there is a waiting list for travel agents to participate on the forum.<strong> <\/strong><br><br><span>If you have paid for your yearly membership dues and\/or any advertising and break one of the <\/span><a href='http:\/\/www.bestdestinationwedding.com\/a\/terms-of-service' class='bbc_url' title=''>forum rules<\/a><span>\u00a0or vendor rules and are <\/span><u>banned from the forum, you will not receive a refund of any membership dues or advertising fees.<\/u><br><br><strong>* The membership fees do not apply to the Administrator(s) or Moderators. Administrator(s) and Moderators are allowed same\u00a0privileges\u00a0as Insider Vendors.<\/strong><br><br>\n__________________<br><br><br>\nThanks for joining us and we look forward to hearing from all of you.<br><br><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/grouphug.gif\" title=\"Grouphug\" alt=\"grouphug.gif\"><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-family:arial, helvetica, sans-serif;\">Founder and Owner of BestDestinationWedding.com \u00a0\/ \u00a0<\/span><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/'><strong><span style=\"font-family:arial, helvetica, sans-serif;\">Bride & Groom Fly FREE Promotion<\/span><\/strong><\/a><\/p>\n<p>\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><strong><a data-ipb='nomediaparse' href='http:\/\/wrighttravelagency.com\/inquiry\/'><span style=\"color:#008080;\">Looking for a travel agency that specializes in Destination Weddings<\/span><\/a><\/strong><span style=\"color:#008080;\"><strong>?<\/strong> \u00a0We are an award winning travel agency and you can <\/span><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style=\"color:#008080;\">read our reviews\u00a0here.<\/span><\/a><\/strong><\/span><br>\n\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"color:#008080;\"><strong>Awards and recognition:\u00a0<\/strong><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Palace Resorts Winner \"Top Travel Agent\", \"Top Homebased Travel Agency\" PRO Platinum Agency (Top Award) \u00a0 \u00a0 | \u00a0 \u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">AMResorts Master Agent & Top Agency \u00a0<\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/68050-karisma-hotels-givc-and-gi-wedding-consultants-wright-travel-agency\/'><strong>Wright Travel & Karisma GIVC Benefits<\/strong><\/a><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Travel Impressions Best of the Best Globe Winner \u00a0 \u00a0| \u00a0 \u00a0\u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Apple Vacations Golden Apple Winner \u00a0<\/span><\/span><br><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"> \u00a0 \u00a0<img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"font-size:14px;\"><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010'>Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><\/span><\/span><strong><span style=\"color:#b22222;\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a data-ipb='nomediaparse' href='mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com'>ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"admin@bestdestinationwedding.com","IpAddress":"71.202.225.11","GroupId":4,"GroupName":"Administrators","JoinDate":1137224220,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"FormattedName":"TammyWright","Id":206696,"Name":"TammyWright","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":274,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9068b8f3764949c61af040a1a2dcc48e","RawContent":"It has come to my attention that there are vendors sending private messages to members of this forum soliciting their services. This is not allowed, period. If a member of this forum is interested in contacting you, they will. Please consider this a warning to all vendors - we will ban any vendors that continue to break these rules.","Attachments":[],"Id":111391,"PostDate":1190148861,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                It has come to my attention that there are vendors sending private messages to members of this forum soliciting their services. This is not allowed, period. If a member of this forum is interested in contacting you, they will. Please consider this a warning to all vendors - we will ban any vendors that continue to break these rules.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<a class='bbc_url' href='http:\/\/bestdestinationwedding.com\/forum\/f77\/anns-annr-las-caletas-dreams-pv-hawaii-review-looooooong-6068\/'>Ann's Caletas Wedding & Hawaii Honeymoon Review<\/a><br \/>\n<a class='bbc_url' href='http:\/\/www.leighmillerphotography.com\/darkroom\/share\/?n=ann_paul'>Our Caletas Wedding Slideshow (by Leigh Miller)<\/a><br \/>\n<a class='bbc_url' href='http:\/\/www.onetruemedia.com\/shared?p=31de360c85cec8376c35a5&skin_id=701&utm_source=otm&utm_medium=image'>Our Caletas Wedding Video<\/a>","Email":"annkherrick@yahoo.com","IpAddress":"76.16.7.43","GroupId":46,"GroupName":"VIP Member","JoinDate":1161392880,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206863.jpg?_r=1429384252","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"LCBride2007","Id":206863,"Name":"LCBride2007","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":274,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"52a5ab34d0ee95813ff3f0b91f8221e3","RawContent":"I also want to encourage members to continue to let Tammy (host) or any of the moderators know if a vendor contacts you about using their services. It&#039;s ok to communicate with vendors privately, but we just don&#039;t want any of our members to feel unfomfortable when contacted by a vendor.","Attachments":[],"Id":111414,"PostDate":1190150242,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I also want to encourage members to continue to let Tammy (host) or any of the moderators know if a vendor contacts you about using their services. It's ok to communicate with vendors privately, but we just don't want any of our members to feel unfomfortable when contacted by a vendor.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<a class='bbc_url' href='http:\/\/bestdestinationwedding.com\/forum\/f77\/anns-annr-las-caletas-dreams-pv-hawaii-review-looooooong-6068\/'>Ann's Caletas Wedding & Hawaii Honeymoon Review<\/a><br \/>\n<a class='bbc_url' href='http:\/\/www.leighmillerphotography.com\/darkroom\/share\/?n=ann_paul'>Our Caletas Wedding Slideshow (by Leigh Miller)<\/a><br \/>\n<a class='bbc_url' href='http:\/\/www.onetruemedia.com\/shared?p=31de360c85cec8376c35a5&skin_id=701&utm_source=otm&utm_medium=image'>Our Caletas Wedding Video<\/a>","Email":"annkherrick@yahoo.com","IpAddress":"76.16.7.43","GroupId":46,"GroupName":"VIP Member","JoinDate":1161392880,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206863.jpg?_r=1429384252","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"LCBride2007","Id":206863,"Name":"LCBride2007","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":274,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"02423f405377c035c06af3f3bbc36c4e","RawContent":"Does the 1 month,100+ posts rule still apply for the vendor section?","Attachments":[],"Id":651234,"PostDate":1239590681,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Does the 1 month,100+ posts rule still apply for the vendor section?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"d@dmitrimarkine.com","IpAddress":"","GroupId":44,"GroupName":"Vendor","JoinDate":1239163920,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-216553.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Dmitri_Markine","Id":216553,"Name":"Dmitri_Markine","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":274,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a18e74dde53962b30b867d7eff24533b","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;Dmitri_Markine&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Does the 1 month,100+ posts rule still apply for the vendor section?&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;no, only vendors with paid registration will now be allowed to post in the vendor marketplace (see rules above). all vendors that are no longer part of the forum will have their posts removed.","Attachments":[],"Id":651247,"PostDate":1239592145,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>Dmitri_Markine<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Does the 1 month,100+ posts rule still apply for the vendor section?<\/div> <\/td> <\/tr> <\/table> <\/div>no, only vendors with paid registration will now be allowed to post in the vendor marketplace (see rules above). all vendors that are no longer part of the forum will have their posts removed.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-family:arial, helvetica, sans-serif;\">Founder and Owner of BestDestinationWedding.com \u00a0\/ \u00a0<\/span><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/'><strong><span style=\"font-family:arial, helvetica, sans-serif;\">Bride & Groom Fly FREE Promotion<\/span><\/strong><\/a><\/p>\n<p>\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><strong><a data-ipb='nomediaparse' href='http:\/\/wrighttravelagency.com\/inquiry\/'><span style=\"color:#008080;\">Looking for a travel agency that specializes in Destination Weddings<\/span><\/a><\/strong><span style=\"color:#008080;\"><strong>?<\/strong> \u00a0We are an award winning travel agency and you can <\/span><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style=\"color:#008080;\">read our reviews\u00a0here.<\/span><\/a><\/strong><\/span><br>\n\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"color:#008080;\"><strong>Awards and recognition:\u00a0<\/strong><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Palace Resorts Winner \"Top Travel Agent\", \"Top Homebased Travel Agency\" PRO Platinum Agency (Top Award) \u00a0 \u00a0 | \u00a0 \u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">AMResorts Master Agent & Top Agency \u00a0<\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/68050-karisma-hotels-givc-and-gi-wedding-consultants-wright-travel-agency\/'><strong>Wright Travel & Karisma GIVC Ben