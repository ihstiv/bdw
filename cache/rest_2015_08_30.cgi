{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":1009,"QueuedPosts":0,"DeletedPosts":7,"HasUnreadPosts":true,"HasAttachments":true,"Views":89641,"MovedTo":null,"MovedOn":0,"FirstPostId":1699849,"Rating":0,"RatingHits":0,"Starter":{"Id":263113,"Name":"superlawyer87","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-263113.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"IsOnline":false},"StartDate":1357145233,"LastPoster":{"Id":274657,"Name":"misbosox","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-274657.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":2,"Preview":{"Id":1755827,"PostDate":1368045595,"PostContent":"Beautiful photos! \u00a0","Author":{"Signature":"","Email":"breynolds87@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1367376497,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-269177.jpeg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Futurefiler87","Id":269177,"Name":"Futurefiler87","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71504,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ab07c249fab7e86fc76cf05f44904cfe","RawContent":"&lt;p&gt; Beautiful photos!\n &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1755827,"PostDate":1368045595,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Beautiful photos!<br \/> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"breynolds87@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1367376497,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-269177.jpeg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Futurefiler87","Id":269177,"Name":"Futurefiler87","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71504,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b354862bb6270da767ce4012bf8d2b73","RawContent":"Vivi224 and Jenvens7, Thanks for your help. My TA has confirmed I will get the perks for 2014 phew. What is the room block contract you talk about? The only contract I have signed is my wedding contract so this worries me. Should there be anther contract?","Attachments":[],"Id":1755831,"PostDate":1368045816,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Vivi224 and Jenvens7, Thanks for your help. My TA has confirmed I will get the perks for 2014 phew. What is the room block contract you talk about? The only contract I have signed is my wedding contract so this worries me. Should there be anther contract?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kaliellis@hotmail.com","IpAddress":"208.99.156.92","GroupId":39,"GroupName":"Newbie","JoinDate":1360750848,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-266018.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"kaliellis10","Id":266018,"Name":"kaliellis10","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71504,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a8b214acd703fd5fa6d70661c996f992","RawContent":"&lt;p&gt; Has anyone done a site visit or vacationed Moon Palace before? I am really leaning toward this location for my wedding. It seems like there&#039;s so much to offer. I have heard, however, that the ocean is very seaweedy. Also, can you customize the complimentary wedding package to add pops of color and whatnot? Finally, one more question for now. Many of the places I have looked into I have ruled out because of the huge extra cost for everyone to eat dinner together after the wedding. I will be having about 30 guests. I don&#039;t want to pay a bunch of extra money for a \"reception\" as we are having a big reception when we get home. Moon seems to have more accommodating options for everyone being able to eat together without the extra cost, but I wanted to make sure? xoxo&lt;\/p&gt;","Attachments":[],"Id":1756042,"PostDate":1368103664,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Has anyone done a site visit or vacationed Moon Palace before? I am really leaning toward this location for my wedding. It seems like there's so much to offer. I have heard, however, that the ocean is very seaweedy. Also, can you customize the complimentary wedding package to add pops of color and whatnot? Finally, one more question for now. Many of the places I have looked into I have ruled out because of the huge extra cost for everyone to eat dinner together after the wedding. I will be having about 30 guests. I don't want to pay a bunch of extra money for a \"reception\" as we are having a big reception when we get home. Moon seems to have more accommodating options for everyone being able to eat together without the extra cost, but I wanted to make sure? xoxo<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"breynolds87@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1367376497,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-269177.jpeg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Futurefiler87","Id":269177,"Name":"Futurefiler87","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71504,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"665fdd9abd2411fdc423d9d18848a9d5","RawContent":"&lt;p&gt; kaliellis10,&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; There is a wedding contract, and that&#039;s the one just to reserve the ceremony location and time. Then there&#039;s the group contract where you get all the unlimited events, complimentary nights, etc for guest staying at the resort for your wedding. If you do the group contract, then the depending on the nights that guests stay, you earn those additional items. For the&amp;nbsp;group contract,&amp;nbsp;you have to decide on room&amp;nbsp;categories, the&amp;nbsp;dates to&amp;nbsp;block off, and how many rooms in each category. There is a \"good faith\" deposit for this. I&#039;m still at this stage with my travel agent and waiting to her back from Moon Palace about some&amp;nbsp;questions we had.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1756226,"PostDate":1368127475,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> kaliellis10,<\/p> <p> \u00a0<\/p> <p> There is a wedding contract, and that's the one just to reserve the ceremony location and time. Then there's the group contract where you get all the unlimited events, complimentary nights, etc for guest staying at the resort for your wedding. If you do the group contract, then the depending on the nights that guests stay, you earn those additional items. For the\u00a0group contract,\u00a0you have to decide on room\u00a0categories, the\u00a0dates to\u00a0block off, and how many rooms in each category. There is a \"good faith\" deposit for this. I'm still at this stage with my travel agent and waiting to her back from Moon Palace about some\u00a0questions we had.\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"vloeza@gmail.com","IpAddress":"216.47.137.164","GroupId":47,"GroupName":"Site Supporter","JoinDate":1341182021,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-257337.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Vivi224","Id":257337,"Name":"Vivi224","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71504,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bda778cd955f35c31d52686b0c4b2ac3","RawContent":"Hi Vivi224, I have a group booking through West Jet via my Travel agent. We did have to say how many rooms, what category and the dates\/lengths of stay...we also put down a deposit. I am guessing this must be it....luckily we confirmed the room credits and free nights afterwards but they still said we could have them. Thanks for your help.","Attachments":[],"Id":1756472,"PostDate":1368166379,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi Vivi224, I have a group booking through West Jet via my Travel agent. We did have to say how many rooms, what category and the dates\/lengths of stay...we also put down a deposit. I am guessing this must be it....luckily we confirmed the room credits and free nights afterwards but they still said we could have them. Thanks for your help.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kaliellis@hotmail.com","IpAddress":"208.99.156.92","GroupId":39,"GroupName":"Newbie","JoinDate":1360750848,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-266018.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"kaliellis10","Id":266018,"Name":"kaliellis10","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71504,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"073367b01d6724c271875377a931f7b5","RawContent":"&lt;p&gt; My fiance and i just got back from our site visit at Moon palace. We had a great time!!!! The beach is seaweedy but there are so many different area on the property to have your ceremony\/reception. I&#039;m not a big fan of the beach so for me this doesnt bother me much but the ocean in the background is breath taking. From what i understand from the site inspection you can add on to the different packages. As for you last question about cost it depends on how many room nights&amp;nbsp;if you have between your self and all your guest 75 room night i believe you can have unlimited events if not i think there is a cost just not sure how much. Hope I was able to help.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Holly&lt;\/p&gt;","Attachments":[],"Id":1756964,"PostDate":1368302677,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> My fiance and i just got back from our site visit at Moon palace. We had a great time!!!! The beach is seaweedy but there are so many different area on the property to have your ceremony\/reception. I'm not a big fan of the beach so for me this doesnt bother me much but the ocean in the background is breath taking. From what i understand from the site inspection you can add on to the different packages. As for you last question about cost it depends on how many room nights\u00a0if you have between your self and all your guest 75 room night i believe you can have unlimited events if not i think there is a cost just not sure how much. Hope I was able to help.<\/p> <p> \u00a0<\/p> <p> Holly<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"hollys1229@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1365206370,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268236.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"hollys29","Id":268236,"Name":"hollys29","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71504,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d1489e0e5df9b2f5cbae3b7ab25514be","RawContent":"&lt;p&gt; Glad to hear you had a great experience! I doubt we will be able to do a site visit as I have limited days I can take off work, so I like hearing other people&#039;s impressions when they go there. I have heard about the seaweed, but I am not much of an ocean person. My TA told us that Beach Palace has a really clear and clean ocean that you can take the shuttle to anytime you want, so that&#039;ll be nice for people if they like to swim in the ocean.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; We are in the process of booking our wedding for May 25, 2014! Does anyone know what all is included in the 30 person dinner reservation that comes with the wedding packages? Is that just a reservation at one of the restaurants or at a private location?\n &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1757637,"PostDate":1368553905,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Glad to hear you had a great experience! I doubt we will be able to do a site visit as I have limited days I can take off work, so I like hearing other people's impressions when they go there. I have heard about the seaweed, but I am not much of an ocean person. My TA told us that Beach Palace has a really clear and clean ocean that you can take the shuttle to anytime you want, so that'll be nice for people if they like to swim in the ocean.<\/p> <p> \u00a0<\/p> <p> We are in the process of booking our wedding for May 25, 2014! Does anyone know what all is included in the 30 person dinner reservation that comes with the wedding packages? Is that just a reservation at one of the restaurants or at a private location?<br \/> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"breynolds87@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1367376497,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-269177.jpeg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Futurefiler87","Id":269177,"Name":"Futurefiler87","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71504,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"eb9babb91a87d49063f076c8c7b72772","RawContent":"&lt;p&gt; hola,&lt;\/p&gt; &lt;p&gt; the 30 person dinner reservation is in one of the restaurants (your wedding planner will give you different options according to the number of guest you have for your party) however if you want a private event this one have an extra charge or if you have the 75 room nights booked trough the same source you can have this event as a courtesy due the number of room nights you accumulate, also there is some fees that may apply like if you want your event on the beach or in an area with difficult access.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; around 90 days prior the wedding date you will be contacted for your wedding planner and she will explain you everything in detail,&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I recommend you to hurrry up and select your date and time as April and May are the months with more weddings of the year :)\n &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1758290,"PostDate":1368678041,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> hola,<\/p> <p> the 30 person dinner reservation is in one of the restaurants (your wedding planner will give you different options according to the number of guest you have for your party) however if you want a private event this one have an extra charge or if you have the 75 room nights booked trough the same source you can have this event as a courtesy due the number of room nights you accumulate, also there is some fees that may apply like if you want your event on the beach or in an area with difficult access.<\/p> <p> \u00a0<\/p> <p> around 90 days prior the wedding date you will be contacted for your wedding planner and she will explain you everything in detail,<\/p> <p> \u00a0<\/p> <p> I recommend you to hurrry up and select your date and time as April and May are the months with more weddings of the year <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br \/> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ana.espipadi@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1367116535,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-269044.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"ana26","Id":269044,"Name":"ana26","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71504,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"65b1a56adae1c82c71de00ba5ae0806d","RawContent":"&lt;p&gt; Thank you for the info! I have a contract for 6PM on May 25, 2014 that I hope to get filled out and sent back to the Moon by tomorrow :)\n &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1758320,"PostDate":1368707718,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Thank you for the info! I have a contract for 6PM on May 25, 2014 that I hope to get filled out and sent back to the Moon by tomorrow <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br \/> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"breynolds87@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1367376497,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-269177.jpeg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Futurefiler87","Id":269177,"Name":"Futurefiler87","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71504,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1bf6331054c1cea33d4aa055ccb005f0","RawContent":"[quote name=\"Futurefiler87\"]\nThank you for the info! I have a contract for 6PM on May 25, 2014 that I hope to get filled out and sent back to the Moon by tomorrow :)  [\/quote] Congrats!!! Are you getting more excited now?!","Attachments":[],"Id":1759169,"PostDate":1368922924,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <blockquote class='ipsBlockquote' data-author=\"Futurefiler87\" url=\"\/t\/83792\/moon&#045;palace&#045;2014\/30#post_1906389\"><p>Thank you for the info! I have a contract for 6PM on May 25, 2014 that I hope to get filled out and sent back to the Moon by tomorrow <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> \u00a0<\/p><\/blockquote> Congrats!!! Are you getting more excited now?!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"juliedrew2014@gmail.com","IpAddress":"76.123.8.194","GroupId":39,"GroupName":"Newbie","JoinDate":1366604745,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268836.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Juliebeth","Id":268836,"Name":"Juliebeth","IsOnline":false}}],"Id":"71504","Title":"Moon Palace- 2014","LastPostDate":1440308889},"Pages":{"TotalItems":1009,"TotalPages":101,"CurrentPage":50,"NextPage":60,"PreviousPage":40,"LastPage":1000},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
