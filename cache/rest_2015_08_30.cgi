,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"nsheth36","Id":264864,"Name":"nsheth36","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71504,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"dfefbba840b4cfb4a0506d5a9ec487b4","RawContent":"&lt;p&gt; Hi brides!! Just finished my review of Moon Palace! Check it out here...&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.bestdestinationwedding.com\/products\/moon-palace-golf-spa-resort-all-inclusive\/reviews\/7374\"&gt;http:\/\/www.bestdestinationwedding.com\/products\/moon-palace-golf-spa-resort-all-inclusive\/reviews\/7374&lt;\/a&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Let me know if you have any questions! Happy to help!!&lt;\/p&gt;","Attachments":[],"Id":1768452,"PostDate":1371235836,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hi brides!! Just finished my review of Moon Palace! Check it out here...<\/p> <p> \u00a0<\/p> <p> <a href='http:\/\/www.bestdestinationwedding.com\/products\/moon-palace-golf-spa-resort-all-inclusive\/reviews\/7374' class='bbc_url' title=''>http:\/\/www.bestdesti...ve\/reviews\/7374<\/a><\/p> <p> \u00a0<\/p> <p> Let me know if you have any questions! Happy to help!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"deannasauchuk@gmail.com","IpAddress":"38.111.32.194","GroupId":39,"GroupName":"Newbie","JoinDate":1317220959,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-245941.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"dzaccaria","Id":245941,"Name":"dzaccaria","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71504,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"677b574367c98405ce61c34576cdcc64","RawContent":"&lt;p&gt; I&#039;ve been busy trying to do some DIY things, and here are a couple of things I&#039;ve done so far:&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; 1. Asking my friends to by my bridesmaids.\n I got the idea from Wedding Chicks&amp;nbsp;&lt;img alt=\" \" data-id=\"208738\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/208738\/width\/200\/height\/400\" \/&gt;&lt;\/p&gt; &lt;p&gt; \n inside items:&lt;\/p&gt; &lt;p&gt; &lt;img alt=\" \" data-id=\"208739\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/208739\/width\/200\/height\/400\" \/&gt;&lt;\/p&gt; &lt;p&gt; \n items assembled inside box:&lt;\/p&gt; &lt;p&gt; &lt;img alt=\" \" data-id=\"208740\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/208740\/width\/200\/height\/400\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; 2. Save the Dates&lt;\/p&gt; &lt;p&gt; I go the idea for boarding pass STD from previous brides here, but I didn&#039;t want them to be beachy. Sarah from Signatures by Sarah&amp;nbsp;&lt;img alt=\" \" data-id=\"208753\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/208753\/width\/200\/height\/400\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\" \" data-id=\"208754\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/208754\/width\/200\/height\/400\" \/&gt;&lt;\/p&gt;","Attachments":[],"Id":1769610,"PostDate":1371517821,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I've been busy trying to do some DIY things, and here are a couple of things I've done so far:<\/p> <p> \u00a0<\/p> <p> 1. Asking my friends to by my bridesmaids.<br \/> I got the idea from Wedding Chicks\u00a0<span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"208738\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/208738\/width\/200\/height\/400\" \/><\/span><\/p> <p> <br \/> inside items:<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"208739\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/208739\/width\/200\/height\/400\" \/><\/span><\/p> <p> <br \/> items assembled inside box:<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"208740\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/208740\/width\/200\/height\/400\" \/><\/span><\/p> <p> \u00a0<\/p> <p> 2. Save the Dates<\/p> <p> I go the idea for boarding pass STD from previous brides here, but I didn't want them to be beachy. Sarah from Signatures by Sarah\u00a0<span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"208753\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/208753\/width\/200\/height\/400\" \/><\/span><\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"208754\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/208754\/width\/200\/height\/400\" \/><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"vloeza@gmail.com","IpAddress":"216.47.137.164","GroupId":47,"GroupName":"Site Supporter","JoinDate":1341182021,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-257337.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Vivi224","Id":257337,"Name":"Vivi224","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71504,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"3764244668afb314ba7011b93b1036cf","RawContent":"OMG! They look awesome! You&#039;ll be getting hitched exactly ONE MONTH before we will! Such cute idea with the boarding pass and such, I&#039;m gonna totally check out her website! \n \n Thanks for posting! [quote]\nOriginally Posted by [b]Vivi224[\/b] \/img\/forum\/go_quote.gif\n \n \n I&#039;ve been busy trying to do some DIY things, and here are a couple of things I&#039;ve done so far: \n \n 1. Asking my friends to by my bridesmaids.\n I got the idea from Wedding Chicks [img]http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/208738\/width\/200\/height\/400[\/img] \n \n inside items: \n [img]http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/208739\/width\/200\/height\/400[\/img] \n \n items assembled inside box: \n [img]http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/208740\/width\/200\/height\/400[\/img] \n \n 2. Save the Dates \n I go the idea for boarding pass STD from previous brides here, but I didn&#039;t want them to be beachy. Sarah from Signatures by Sarah [img]http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/208753\/width\/200\/height\/400[\/img] \n \n [img]http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/208754\/width\/200\/height\/400[\/img][\/quote]","Attachments":[],"Id":1769802,"PostDate":1371573741,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> OMG! They look awesome! You'll be getting hitched exactly ONE MONTH before we will! Such cute idea with the boarding pass and such, I'm gonna totally check out her website!<\/p> <p> \u00a0<\/p> <p> Thanks for posting!<\/p> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>Vivi224<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <p> I've been busy trying to do some DIY things, and here are a couple of things I've done so far:<\/p> <p> \u00a0<\/p> <p> 1. Asking my friends to by my bridesmaids.<br \/> I got the idea from Wedding Chicks\u00a0<span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"208738\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/208738\/width\/200\/height\/400\" \/><\/span><\/p> <p> <br \/> inside items:<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"208739\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/208739\/width\/200\/height\/400\" \/><\/span><\/p> <p> <br \/> items assembled inside box:<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"208740\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/208740\/width\/200\/height\/400\" \/><\/span><\/p> <p> \u00a0<\/p> <p> 2. Save the Dates<\/p> <p> I go the idea for boarding pass STD from previous brides here, but I didn't want them to be beachy. Sarah from Signatures by Sarah\u00a0<span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"208753\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/208753\/width\/200\/height\/400\" \/><\/span><\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"208754\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/208754\/width\/200\/height\/400\" \/><\/span><\/p> <\/blockquote>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jenvens7@gmail.com","IpAddress":"24.227.210.51","GroupId":39,"GroupName":"Newbie","JoinDate":1358454948,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-264628.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":211,"PhotoType":"custom"},"FormattedName":"jenvens7","Id":264628,"Name":"jenvens7","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71504,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"af6e2841cb1e2d68b481bd9b021fc4df","RawContent":"&lt;p&gt; Is anyone on here having a reception when you come back home rather than a full reception at MP? We are having one two weeks after we return, so I don&#039;t want to pay a bunch of extra money to do form reception related things at the resort, but I don&#039;t want to just disperse everyone after the ceremony. I am thinking just use the dinner reservation and then go dancing at the disco afterward. Just wondering if there are others doing something similar and how they&#039;re going about it :) Thanks!&lt;\/p&gt;","Attachments":[],"Id":1769848,"PostDate":1371577454,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Is anyone on here having a reception when you come back home rather than a full reception at MP? We are having one two weeks after we return, so I don't want to pay a bunch of extra money to do form reception related things at the resort, but I don't want to just disperse everyone after the ceremony. I am thinking just use the dinner reservation and then go dancing at the disco afterward. Just wondering if there are others doing something similar and how they're going about it <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> Thanks!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"breynolds87@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1367376497,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-269177.jpeg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Futurefiler87","Id":269177,"Name":"Futurefiler87","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71504,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"239ef8c5db3cb42998f0a576403ce65a","RawContent":"&lt;p&gt; My So and I are getting married on Feb. 19th 2014 at moon palace.&amp;nbsp; Super excited and interested in comments from others who used the complementary package.&amp;nbsp; Also interested in approved photographers.&amp;nbsp; Thanks in advance ladies.&lt;\/p&gt;","Attachments":[],"Id":1770355,"PostDate":1371679468,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> My So and I are getting married on Feb. 19th 2014 at moon palace.\u00a0 Super excited and interested in comments from others who used the complementary package.\u00a0 Also interested in approved photographers.\u00a0 Thanks in advance ladies.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lsalkeld27@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1371679204,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270746.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Shimmyshimmy27","Id":270746,"Name":"Shimmyshimmy27","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71504,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"93299ae7f413b2611d34f114e706e295","RawContent":"[quote]\nOriginally Posted by [b]Shimmyshimmy27[\/b] \/img\/forum\/go_quote.gif\n \n \n My So and I are getting married on Feb. 19th 2014 at moon palace.  Super excited and interested in comments from others who used the complementary package.  Also interested in approved photographers.  Thanks in advance ladies.[\/quote] \n We did the complimentary package and loved it! It was nice to just be able to pick everything ourselves and not be limited to certain table clothes, flowers, etc. We used Zuniga for all of our centerpieces and decorations and they were great to work with and prices weren&#039;t too bad! We used Ocean Photo Studio for photo and video and found that they did a great job! I am expecting to get pictures and video back from them this week and will definitely be posting a review once I do! They actually have an office at Moon Palace so they are very familiar with the resort and know the best places to take pictures!","Attachments":[],"Id":1770521,"PostDate":1371730940,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>Shimmyshimmy27<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <p> My So and I are getting married on Feb. 19th 2014 at moon palace.\u00a0 Super excited and interested in comments from others who used the complementary package.\u00a0 Also interested in approved photographers.\u00a0 Thanks in advance ladies.<\/p> <\/blockquote> <p> We did the complimentary package and loved it! It was nice to just be able to pick everything ourselves and not be limited to certain table clothes, flowers, etc. We used Zuniga for all of our centerpieces and decorations and they were great to work with and prices weren't too bad! We used Ocean Photo Studio\u00a0for photo and video and found that they did a great job! I am expecting to get pictures and\u00a0video back from them this week and will definitely be posting a review once I do! They actually have an office at Moon Palace so they are very familiar with the resort and know the best places to take pictures! \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"deannasauchuk@gmail.com","IpAddress":"38.111.32.194","GroupId":39,"GroupName":"Newbie","JoinDate":1317220959,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-245941.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"dzaccaria","Id":245941,"Name":"dzaccaria","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71504,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c69d1780673a8970672c8bbc0341a2aa","RawContent":"&lt;p&gt; Hi Ladies, I was on here quite a while ago reading but have since confirmed that I will be getting married January 23, 2014 at MP!! I\u00e2\u20ac\u2122m so excited!!! I haven\u00e2\u20ac\u2122t quite had a chance to read over all of the 2012 and 2013 forum yet but I\u00e2\u20ac\u2122m wondering mostly about the photography package that comes with the wedding package and the DJ that the resort offers. It seems for both of these most people seem to go with an outside vendor. Has any one chosen to go with the resorts options and have you heard any reviews about them good or bad?&lt;\/p&gt; &lt;p&gt; Thanks!&lt;\/p&gt;","Attachments":[],"Id":1771183,"PostDate":1371845056,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hi Ladies, I was on here quite a while ago reading but have since confirmed that I will be getting married January 23, 2014 at MP!! I\u00e2\u20ac\u2122m so excited!!! I haven\u00e2\u20ac\u2122t quite had a chance to read over all of the 2012 and 2013 forum yet but I\u00e2\u20ac\u2122m wondering mostly about the photography package that comes with the wedding package and the DJ that the resort offers. It seems for both of these most people seem to go with an outside vendor. Has any one chosen to go with the resorts options and have you heard any reviews about them good or bad?<\/p> <p> Thanks!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/75127-britt-and-mikes-moon-palace-2014-wedding-planning-journal\/'>http:\/\/www.bestdestinationwedding.com\/topic\/75127-britt-and-mikes-moon-palace-2014-wedding-planning-journal\/<\/a>","Email":"brittanys@bellnet.ca","IpAddress":"70.30.61.254","GroupId":39,"GroupName":"Newbie","JoinDate":1359430387,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265301.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Britt","Id":265301,"Name":"Britt","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71504,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2ac396bc1f99d1ac19a9ff5882edc19a","RawContent":"Fe[quote name=\"ckl22\" url=\"\/t\/83792\/moon-palace-2014\/60#post_1909808\"]Hey All! Any February 2014 Brides here? I just booked my wedding for February 27th :) What is everyone doing for dancing? Are you paying extra for a DJ at private dinner or... ? I was thinking of maybe just using the night club.. but I have heard all they play is techno. Anyone been able to experience what it really is like? I&#039;m trying to plan a site visit I&#039;m just not sure if it will happen or not :( [\/quob February 19th 2014, we will be there from the 16th-23rd.","Attachments":[],"Id":1771463,"PostDate":1371938623,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Fe[quote name=\"ckl22\" url=\"\/t\/83792\/moon-palace-2014\/60#post_1909808\"]Hey All! Any February 2014 Brides here? I just booked my wedding for February 27th <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> What is everyone doing for dancing? Are you paying extra for a DJ at private dinner or... ? I was thinking of maybe just using the night club.. but I have heard all they play is techno. Anyone been able to experience what it really is like? I'm trying to plan a site visit I'm just not sure if it will happen or not <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/sad.png' class='bbc_emoticon' alt=':(' \/> [\/quob February 19th 2014, we will be there from the 16th-23rd.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lsalkeld27@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1371679204,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270746.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Shimmyshimmy27","Id":270746,"Name":"Shimmyshimmy27","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71504,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"00077dab6369b4f406e3cdf102ab2ce4","RawContent":"&lt;p&gt; We booked our January 10, 2014 wedding! &amp;nbsp;AHHHHHH!! &amp;nbsp;So Excited!&lt;\/p&gt;","Attachments":[],"Id":1772489,"PostDate":1372220834,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> We booked our January 10, 2014 wedding! \u00a0AHHHHHH!! \u00a0So Excited!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"elizabethbusscher@yahoo.com","IpAddress":"","GroupId":47,"GroupName":"Site Supporter","JoinDate":1369025811,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-269761.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"lizzieqball","Id":269761,"Name":"lizzieqball","IsOnline":false}}],"Pages":{"TotalItems":1009,"TotalPages":101,"CurrentPage":80,"Next