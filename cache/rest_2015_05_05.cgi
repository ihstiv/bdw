{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":3,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":149,"MovedTo":null,"MovedOn":0,"FirstPostId":1894868,"Rating":0,"RatingHits":0,"Starter":{"Id":282892,"Name":"FutureMrsVanthof","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1430327160,"LastPoster":{"Id":282893,"Name":"giigiixo","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282893.jpg?_r=1430781184","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":22,"Preview":{"Id":1894868,"PostDate":1430327160,"PostContent":"Hi Everyone! My finance and I just decided we are going to get married down south next March (201...","Author":{"Signature":"","Email":"ton_03@hotmail.com","IpAddress":"142.67.2.225","GroupId":39,"GroupName":"Newbie","JoinDate":1430234976,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"FutureMrsVanthof","Id":282892,"Name":"FutureMrsVanthof","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"142.67.2.225","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79129,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b4a7ac14c5fd4ee940dc98d27ff59027","RawContent":"&lt;p&gt;Hi Everyone!&lt;\/p&gt;\n&lt;p&gt;My finance and I just decided we are going to get married down south next March (2016)! I am having a really hard time deciding where to go. My travel agent is currently on vacation herself, and not back until next week, but in the meantime im trying to do as much research as i can myself, but am only getting MORE confused!!!&lt;\/p&gt;\n&lt;p&gt;I am wondering .. what resorts in Punta Cana give the best group rates, like, every 9th person you get a free trip, etc.&lt;\/p&gt;\n&lt;p&gt;I have a book from Air Canada and it shows two kinds of \"freebies\" a \"free adult\" and a \"free room(2 adults)\" for options .. and i dont know what the difference is!!&lt;\/p&gt;\n&lt;p&gt;I am realllly interested in the Majestic Elegance\/Colonal but the price is throwing me off as im trying to keep the cost low for my guests. I see on this Air Canada book it says every 16th person booked, you get a free adult. . so thats not bad .. but the Grand Bahia Principe Punta Cana gives you a \"free adult\" every 11th person that books .. so im leaning toward the GB because we would in the end get more free trips to get the group rate down the lowest possible..... does anyone have any advice as to how to get the best group rate? Do different travel agencies give different rates? We have a Sell off Vacations here, and a Maritime Travel.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thanks so much :) .. my head has been spinning these last few days!&lt;\/p&gt;","Attachments":[],"Id":1894868,"PostDate":1430327160,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Everyone!<\/p>\n<p>My finance and I just decided we are going to get married down south next March (2016)! I am having a really hard time deciding where to go. My travel agent is currently on vacation herself, and not back until next week, but in the meantime im trying to do as much research as i can myself, but am only getting MORE confused!!!<\/p>\n<p>I am wondering .. what resorts in Punta Cana give the best group rates, like, every 9th person you get a free trip, etc.<\/p>\n<p>I have a book from Air Canada and it shows two kinds of \"freebies\" a \"free adult\" and a \"free room(2 adults)\" for options .. and i dont know what the difference is!!<\/p>\n<p>I am realllly interested in the Majestic Elegance\/Colonal but the price is throwing me off as im trying to keep the cost low for my guests. I see on this Air Canada book it says every 16th person booked, you get a free adult. . so thats not bad .. but the Grand Bahia Principe Punta Cana gives you a \"free adult\" every 11th person that books .. so im leaning toward the GB because we would in the end get more free trips to get the group rate down the lowest possible..... does anyone have any advice as to how to get the best group rate? Do different travel agencies give different rates? We have a Sell off Vacations here, and a Maritime Travel.<\/p>\n<p>\u00a0<\/p>\n<p>Thanks so much <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> .. my head has been spinning these last few days!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ton_03@hotmail.com","IpAddress":"142.67.2.225","GroupId":39,"GroupName":"Newbie","JoinDate":1430234976,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"FutureMrsVanthof","Id":282892,"Name":"FutureMrsVanthof","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"161.185.150.180","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79129,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"d167ba5bf8f2e83d7bd5e6a4789677a9","RawContent":"&lt;p&gt;@[member=\"FutureMrsVanthof\"] Congrats on your engagement my love. The hotel that seems to give the best group discounts is Now Larimar or any of the sister hotels. Such as Dreams Palm Beach and Secrets (adults only) Hope this helps :)&lt;\/p&gt;","Attachments":[],"Id":1894881,"PostDate":1430337298,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"282892\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282892-futuremrsvanthof\/' title='Member profile'><span itemprop=\"name\">FutureMrsVanthof<\/span><\/a> Congrats on your engagement my love. The hotel that seems to give the best group discounts is Now Larimar or any of the sister hotels. Such as Dreams Palm Beach and Secrets (adults only) Hope this helps <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p style=\"text-align:center;\">\u00a0 \u00a0 \u00a0 \u00a0 \u00a0 Future Mrs. Bonitto 10\/14\/16<\/p>\n<div><br><div>\u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0<a  class=\"bbc_url\" href=\"http:\/\/www.theknot.com\/?utm_source=ticker&utm_medium=UBB&utm_campaign=tickers\"><img src=\"http:\/\/global.theknot.com\/tickers\/tt1c2490.aspx\" alt=\"tt1c2490.aspx\"><\/a><\/div>\n<div>\u00a0\u00a0<\/div>\n<\/div>\n<p>\u00a0","Email":"shamicaglover@yahoo.com","IpAddress":"161.185.157.23","GroupId":40,"GroupName":"Jr. Member","JoinDate":1394136776,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277031.jpg?_r=1397251056","PhotoWidth":200,"PhotoHeight":203,"PhotoType":"custom"},"FormattedName":"MrandMrsBonitto2016","Id":277031,"Name":"MrandMrsBonitto2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.227.250.95","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79129,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"582d05dba5c207368c253e65886939e2","RawContent":"@[member=\"FutureMrsVanthof\"] - shop around like crazy until you find the best deal ! More people estimated in your group drops the price even more .\n\nAlso they give you free people for every x amount of two people per room booked. They usually give you only a maximum of 4 people free which sucks if you hav more people coming it could of really helped . \n\nI have been to majestic colonial for a wedding and was amazed ! \n\nI am getting married next year at Royalton (next door to majestic) amazing beach !!  \n\nI recommend really really shop around and  there are price increases and decreases per each month. \n\nKeep getting prices for resorts and look into each wedding package they offer contact the resorts directly also (unless you hire a wedding planner you won&#039;t need too )  and they will give you  all the info you need ie: hidden wedding costs wedding packages prices etc..","Attachments":[],"Id":1894937,"PostDate":1430409876,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"282892\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282892-futuremrsvanthof\/' title='Member profile'><span itemprop=\"name\">FutureMrsVanthof<\/span><\/a> - shop around like crazy until you find the best deal ! More people estimated in your group drops the price even more .<br>\nAlso they give you free people for every x amount of two people per room booked. They usually give you only a maximum of 4 people free which sucks if you hav more people coming it could of really helped . <br>\nI have been to majestic colonial for a wedding and was amazed ! <br>\nI am getting married next year at Royalton (next door to majestic) amazing beach !!  <br>\nI recommend really really shop around and  there are price increases and decreases per each month. <br>\nKeep getting prices for resorts and look into each wedding package they offer contact the resorts directly also (unless you hire a wedding planner you won't need too )  and they will give you  all the info you need ie: hidden wedding costs wedding packages prices etc..\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><br><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;484\/st\/20160506\/e\/Our+Wedding\/k\/be22\/event.png\" alt=\"event.png\"><br><\/a>","Email":"jessica.galvao21@gmail.com","IpAddress":"99.227.250.95","GroupId":39,"GroupName":"Newbie","JoinDate":1430238623,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282893.jpg?_r=1430781184","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"giigiixo","Id":282893,"Name":"giigiixo","IsOnline":false}}],"Id":"79129","Title":"2016 Bride - Punta Cana - Group Rates","LastPostDate":1430409876},"Pages":{"TotalItems":3,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
