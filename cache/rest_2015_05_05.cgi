":180,"PhotoType":"custom"},"FormattedName":"SPRINGBRIDE","Id":206767,"Name":"SPRINGBRIDE","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":994,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7772151921909225792d8abd2a5c44fb","RawContent":"I just learned how to post a pic last night! So, I hear ya (but I had my setting wrongs, so I couldn&#039;t even see the smilies)!\n \n Anyway, now that I can post pics, here are a couple of hair ideas I&#039;ve saved. I like the first one best.\n \n &lt;img src=\"http:\/\/i140.photobucket.com\/albums\/r39\/jessalynj_2007\/hairidea2.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n &lt;img src=\"http:\/\/i140.photobucket.com\/albums\/r39\/jessalynj_2007\/hairideacopy.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;","Attachments":[],"Id":20242,"PostDate":1169684337,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I just learned how to post a pic last night! So, I hear ya (but I had my setting wrongs, so I couldn't even see the smilies)!<br \/> <br \/> Anyway, now that I can post pics, here are a couple of hair ideas I've saved. I like the first one best.<br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i140.photobucket.com\/albums\/r39\/jessalynj_2007\/hairidea2.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i140.photobucket.com\/albums\/r39\/jessalynj_2007\/hairideacopy.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>My new man....Donovan<\/span><br><br><span>Wedding photos and avatar by Jonathan Thrasher Photography - <\/span><a data-ipb='nomediaparse' href=\"http:\/\/www.jthrasherphoto.com\">www.jthrasherphoto.com<\/a><br><span>Our wedding slide show <\/span><a data-ipb='nomediaparse' href=\"http:\/\/www.jthrasherphoto.com\/slideshows\/jessalyn\">www.jthrasherphoto.com\/slideshows\/jessalyn<\/a><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/2;54;107\/st\/20090205\/n\/Donovan\/dt\/-3\/k\/27c1\/age.png\">http:\/\/tickers.TickerFactory.com\/ezt...k\/27c1\/age.png<\/a><\/div><\/div>","Email":"jessalynj@aol.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1143658200,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206728.gif?_r=0","PhotoWidth":61,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Jessalyn","Id":206728,"Name":"Jessalyn","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":994,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9d009bded987e02a0a16c5fd1bfd6cf7","RawContent":"I came across a few more styles that I like. I know my hair won&#039;t hold the curl in the 2nd set, but I love, and if your hair will hold curl, well you might like it. \n \n &lt;img src=\"http:\/\/bestdestinationwedding.com\/forum\/imagehosting\/24445bcf4d6b2b4c.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n &lt;img src=\"http:\/\/bestdestinationwedding.com\/forum\/imagehosting\/24445bcf4d707230.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n &lt;img src=\"http:\/\/bestdestinationwedding.com\/forum\/imagehosting\/24445bcf4d719af1.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n FI asked me last night what we were talking about on the board, and when I said hair - his only comments was &amp;quot;all up is not good&amp;quot; - so apparently, that is off the table for me as an option.... I really wanted up. O&#039;well.","Attachments":[],"Id":21116,"PostDate":1170011470,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I came across a few more styles that I like. I know my hair won't hold the curl in the 2nd set, but I love, and if your hair will hold curl, well you might like it. <br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bestdestinationwedding.com\/forum\/imagehosting\/24445bcf4d6b2b4c.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bestdestinationwedding.com\/forum\/imagehosting\/24445bcf4d707230.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bestdestinationwedding.com\/forum\/imagehosting\/24445bcf4d719af1.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> FI asked me last night what we were talking about on the board, and when I said hair - his only comments was \"all up is not good\" - so apparently, that is off the table for me as an option.... I really wanted up. O'well.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Stephanie & Jason ~ RIU Palace ~ Cabo San Lucas<\/span><br><span>June 23, 2007<\/span><br><span>Visit our wedding slideshow <\/span><a data-ipb='nomediaparse' href=\"http:\/\/www.bajaimagebank.com\/Portfolio\/StephanieJason\/index.html\">Stephanie & Jason<\/a><br><span>Photography by <\/span><a data-ipb='nomediaparse' href=\"http:\/\/www.bajaimagebank.com\/index.html\">Jose \"Pepe\" Lima<\/a><\/div><\/div>","Email":"pugliess@bellsouth.net","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1152824100,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206762.gif?_r=0","PhotoWidth":93,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"RAENJAY","Id":206762,"Name":"RAENJAY","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":994,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"67b5d3b748b12dc7c32abb5098e35ea0","RawContent":"for those of you with really curly hair - i just thought i&#039;d share this Knot Bio\n \n &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/talk.theknot.com\/boards\/User\/Profile.aspx?bioname=curlyhairbio\"&gt;The Knot Forums&lt;\/a&gt;","Attachments":