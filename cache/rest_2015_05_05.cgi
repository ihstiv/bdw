\/twitti\/wed7.jpg\">http:\/\/i63.photobucket.com\/albums\/h160\/twitti\/wed7.jpg<\/a><\/div><\/div>","Email":"tobi_jessell@quakeroats.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1201200251,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208350.gif?_r=0","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"Tobi","Id":208350,"Name":"Tobi","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":17711,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"34a1c38a6d997914d3d60bed817363f7","RawContent":"^^ WHat a lovely cake! It&#039;s so whimsical! :)","Attachments":[],"Id":349456,"PostDate":1213968667,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                ^^ WHat a lovely cake! It's so whimsical! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cmmdee@yahoo.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1187868242,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207666.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Copita","Id":207666,"Name":"Copita","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":17711,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e00b7c7609b93566b025abc7519eab49","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;kerryjbrown&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Denise,\n \n Who did your cake in Cabo? What was so different? Just want to make sure I don&#039;t choose someone that doesn&#039;t do what we order. Thanks&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;\n The restaurant that we had our dinner at made our cake. It tasted great and it was very pretty, it was just the wrong colors. It was supposed to have matched our renewal colors. The cake should have been coral in color and the shells should have been the teal and made out of chocolate, instead they were the hard candy shells. The bottom layer was fake.","Attachments":[],"Id":349487,"PostDate":1213969684,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>kerryjbrown<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Denise,<br \/> <br \/> Who did your cake in Cabo? What was so different? Just want to make sure I don't choose someone that doesn't do what we order. Thanks<\/div> <\/td> <\/tr> <\/table> <\/div><br \/> The restaurant that we had our dinner at made our cake. It tasted great and it was very pretty, it was just the wrong colors. It was supposed to have matched our renewal colors. The cake should have been coral in color and the shells should have been the teal and made out of chocolate, instead they were the hard candy shells. The bottom layer was fake.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Denise<\/span><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;23\/st\/20080602\/e\/Our+25th+Ann.-Vow+Renewal\/dt\/-1\/k\/a1ad\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...a1ad\/event.png<\/a><\/div><\/div>","Email":"River4me@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1203907980,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208639.gif?_r=0","PhotoWidth":100,"PhotoHeight":66,"PhotoType":"custom"},"FormattedName":"Denise40","Id":208639,"Name":"Denise40","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":17711,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"010e9a3ba4c7d29e9661e0c5b24e2b33","RawContent":"Great thread! Unfortunately, I don&#039;t think we got a picture of our cake at the resort. I never even noticed that until now. I haven&#039;t decided what we will fo for the AHR yet, so this thread is giving me ideas.","Attachments":[],"Id":349549,"PostDate":1213972016,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Great thread! Unfortunately, I don't think we got a picture of our cake at the resort. I never even noticed that until now. I haven't decided what we will fo for the AHR yet, so this thread is giving me ideas.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"carlydorazio@gmail.com","IpAddress":"72.92.56.95","GroupId":46,"GroupName":"VIP Member","JoinDate":1177530900,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207375.jpg?_r=1414982962","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"boscobel","Id":207375,"Name":"boscobel","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":17711,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7f5f0c553d5b5769ae9a78aa4be27eee","RawContent":"Here is ours:\n &lt;img src=\"http:\/\/i163.photobucket.com\/albums\/t302\/yellowred24\/IMG_8683.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n I put together ideas from a few cakes and from a greeting card and gave them to our baker. She rocks!\n \n &lt;img src=\"http:\/\/i163.photobucket.com\/albums\/t302\/yellowred24\/IMG_8685.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;","Attachments":[],"Id":349723,"PostDate":1213977136,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Here is ours:<br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i163.photobucket.com\/albums\/t302\/yellowred24\/IMG_8683.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> I put together ideas from a few cakes and from a greeting card and gave them to our baker. She rocks!<br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i163.photobucket.com\/albums\/t302\/yellowred24\/IMG_8685.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i163.photobucket.com\/albums\/t302\/yellowred24\/2-2.jpg\">http:\/\/i163.photobucket.com\/albums\/t...wred24\/2-2.jpg<\/a><br><br><br><br><span>Married May 2, 2008<\/span><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t20561\">Link to some wedding photos<\/a><a data-ipb='nomediaparse' href=\"http:\/\/vividpeachdesigns.com\">Vivid Peach Designs- Custom Photo Shows<\/a><\/div><\/div>","Email":"stephanie525@gmail.com","IpAddress":"","GroupId":42,"GroupName"