                   width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm not getting married at Dreams, but I would think there would be different package options.<br \/> <br \/> Included in our beach reception is a buffett and open bar (3 hours) for $2500.<br \/> <br \/> We are also doing a private bar 1\/2 before and 1\/2 hour after the ceremony right next to the gazebo. That is priced per person\/per hour.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i104.photobucket.com\/albums\/m161\/foxytv\/Slide1-7.jpg\">http:\/\/i104.photobucket.com\/albums\/m...v\/Slide1-7.jpg<\/a><\/div><\/div>","Email":"scwinetastings@gmail.com","IpAddress":"","GroupId":46,"GroupName":"VIP Member","JoinDate":1177660740,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207379.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"foxytv","Id":207379,"Name":"foxytv","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":11205,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"269fa4e5ac072929f9a6acf0dad25df6","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;foxytv&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:itali