{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":true,"CanReply":true,"CanFollow":true,"TotalPosts":1,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":0,"MovedTo":null,"MovedOn":0,"FirstPostId":1898932,"Rating":0,"RatingHits":0,"Starter":{"Id":283554,"Name":"Mickeyb","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":true},"StartDate":1434816537,"LastPoster":{"Id":283554,"Name":"Mickeyb","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":true},"PollState":"0","LastVote":0,"ForumId":34,"Preview":{"Id":1898932,"PostDate":1434816537,"PostContent":"Hey everyone just need some advice and opinions. My fianc\u00e9 and I are doing a destination wedding in Mexico from Toronto and I am wondering about doing actual paper invitations. We are sending out electronic save the dates with a link to the website but I am debating sending out paper invitations as well. <br><br>\nIn all honestly we do not believe either of our families will be able to make it for monetary reasons and small children but do we need to send invitations anyways and spend the money. <br><br>\nIs it tacky to not send them or send all free electronic versions? Don't wanna be the tacky couple but at the same time would like to save money as much as we can and be able to put it into the week and having an awesome wedding there?<br><br>\nPlease let me know your thought. ","Author":{"Signature":"","Email":"bidlofs@gmail.com","IpAddress":"99.226.139.21","GroupId":39,"GroupName":"Newbie","JoinDate":1434417744,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Mickeyb","Id":283554,"Name":"Mickeyb","IsOnline":true}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"184.151.178.78","IsFirstPost":true,"IsQueued":false,"IsVisible":false,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":false,"TopicId":79296,"EditedBy":null,"EditDate":0,"EditReason":null,"DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"488421101b6b14f67f3d3bbf50c3df74","RawContent":"","Attachments":[],"Id":1898932,"PostDate":1434816537,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hey everyone just need some advice and opinions. My fianc\u00e9 and I are doing a destination wedding in Mexico from Toronto and I am wondering about doing actual paper invitations. We are sending out electronic save the dates with a link to the website but I am debating sending out paper invitations as well. <br><br>\nIn all honestly we do not believe either of our families will be able to make it for monetary reasons and small children but do we need to send invitations anyways and spend the money. <br><br>\nIs it tacky to not send them or send all free electronic versions? Don't wanna be the tacky couple but at the same time would like to save money as much as we can and be able to put it into the week and having an awesome wedding there?<br><br>\nPlease let me know your thought. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bidlofs@gmail.com","IpAddress":"99.226.139.21","GroupId":39,"GroupName":"Newbie","JoinDate":1434417744,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Mickeyb","Id":283554,"Name":"Mickeyb","IsOnline":true}}],"Id":"79296","Title":"Not Doing Invitations?","LastPostDate":1434816537},"Pages":null,"PushNotifications":[{"Key":"notifications","Value":4,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
