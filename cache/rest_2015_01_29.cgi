}\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Here's my dress. We're still shopping for my MOH's dress, but it's definitely going to be aqua\/pastel blue color. Tammy - did you get your BM dresses on Bluefly.com??<br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i197.photobucket.com\/albums\/aa240\/carlymcmullen\/BDW%20Photos%20for%20Others\/weddingdress-christa.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/70218\/width\/525\/height\/525\/flags\/LL\"><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"clb26@yahoo.com","IpAddress":"67.182.138.230","GroupId":46,"GroupName":"VIP Member","JoinDate":1148484240,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206736.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Christa","Id":206736,"Name":"Christa","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":71,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8748b8ed290e62f981d9cee03996727f","RawContent":"Here&#039;s my wedding dress\n \n &lt;img src=\"http:\/\/i107.photobucket.com\/albums\/m303\/nrabe123\/front_smaller.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n &lt;img src=\"http:\/\/i107.photobucket.com\/albums\/m303\/nrabe123\/5f0c1a53.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;","Attachments":[],"Id":1486,"PostDate":1159190668,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Here's my wedding dress<br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i107.photobucket.com\/albums\/m303\/nrabe123\/front_smaller.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i107.photobucket.com\/albums\/m303\/nrabe123\/5f0c1a53.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Shawn and NatashaHappily MarriedNovember 11, 2006<\/span><\/div><\/div>","Email":"xtra858sd@yahoo.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1143507420,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206727.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"NATASHA","Id":206727,"Name":"NATASHA","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":71,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"aefc252859f7f55405f0ca5dfb77b1ea","RawContent":"Here are the bridesmaids dresses\n \n &lt;img src=\"http:\/\/i107.photobucket.com\/albums\/m303\/nrabe123\/5f0c2feb.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n &lt;img src=\"http:\/\/i107.photobucket.com\/albums\/m303\/nrabe123\/ce59c688.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;","Attachments":[],"Id":1487,"PostDate":1159190767,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Here are the bridesmaids dresses<br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i107.photobucket.com\/albums\/m303\/nrabe123\/5f0c2feb.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i107.photobucket.com\/albums\/m303\/nrabe123\/ce59c688.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Shawn and NatashaHappily MarriedNovember 11, 2006<\/span><\/div><\/div>","Email":"xtra858sd@yahoo.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1143507420,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206727.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"NATASHA","Id":206727,"Name":"NATASHA","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":71,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cee50ab1e838f49e229283afc79069de","RawContent":"Thanks for the other website Christa! I went shopping last night and could not find any jewelry, so I really appreciate the links!\n \n My dress has some gold embroidery in it, so the gold was pretty much chosen for me. I&#039;m actually not a huge fan of gold jewelry, I prefer silver so I think that&#039;s why I&#039;m having a hard time choosing something. Everything I&#039;ve seen in gold does not appeal to me as much as the silver toned jewelry. \n \n Here&#039;s the dress in the Casablanca website. I&#039;ll post once I get pics of me in it this weekend. Funny story, I saw this dress in 3 different shops and every time I would try it on (with different people there) they would all LOVE it, yet I could not get myself to chose it. I kept saying... it&#039;s got gold embroidery AND ruffles?!? Yet I kept going back to it. So the 3rd time I tried it on, I fell in love with it.... Go figure!\n \n Sorry took me long to post, I usually barely have time to post on the forum when I&#039;m at work. Can you tell I&#039;m totally slacking today??\n &lt;img src=\"http:\/\/i197.photobucket.com\/albums\/aa240\/carlymcmullen\/BDW%20Photos%20for%20Others\/weddingdress-karla.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n &lt;img src=\"http:\/\/i197.photobucket.com\/albums\/aa240\/carlymcmullen\/BDW%20Photos%20for%20Others\/weddingdress-karla1.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n&lt;img src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/70202\/width\/525\/height\/525\/flags\/LL\"&gt;\n&lt;img src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/70230\/width\/525\/height\/525\/flags\/LL\"&gt;","Attachments":[],"Id":1893,"PostDate":1159530570,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks for the other website Christa! I went shopping last night and could not find any jewelry, so I really appreciate the links!<br \/> <br \/> My dress has some gold embroidery in it, so the gold was pretty much chosen for me. I'm actually not a huge fan of gold jewelry, I prefer silver so I think that's why I'm having a hard time choosing something. Everything I've seen in gold does not appeal to me as much as the silver toned jewelry. <br \/> <br \/> Here's the dress in the Casablanca website. I'll post once I get pics of me in it this weekend. Funny story, I saw this dress in 3 different shops and every time I would try it on (with different people there) they would all LOVE it, yet I could not get myself to chose it. I kept saying... it's got gold embroidery AND ruffles?!? Yet I kept going back to it. So the 3rd time I tried it on, I fell in love with it.... Go figure!<br \/> <br \/> Sorry took me long to post, I usually barely have time to post on the forum when I'm at work. Can you tell I'm totally slacking today??<br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i197.photobucket.com\/albums\/aa240\/carlymcmullen\/BDW%20Photos%20for%20Others\/weddingdress-karla.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i197.photobucket.com\/albums\/aa240\/carlymcmullen\/BDW%20Photos%20for%20Others\/weddingdress-karla1.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/70202\/width\/525\/height\/525\/flags\/LL\"><\/span><br><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/70230\/width\/525\/height\/525\/flags\/LL\"><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"karlaroldan@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1153910880,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206766.gif?_r=0","PhotoWidth":80,"PhotoHeight":56,"PhotoType":"custom"},"FormattedName":"KARLA","Id":206766,"Name":"KARLA","IsOnline":false}}],"Id":"71","Title":"Show us your wedding dress!","LastPostDate":1422464271},"Pages":{"TotalItems":8219,"TotalPages":822,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":8210},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
