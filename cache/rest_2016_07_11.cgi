Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":3,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":1139,"MovedTo":null,"MovedOn":0,"FirstPostId":1823059,"Rating":0,"RatingHits":0,"Starter":{"Id":275890,"Name":"Floridabride","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275890.jpg?_r=1388974504","PhotoWidth":197,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":false},"StartDate":1388960044,"LastPoster":{"Id":277265,"Name":"rebeccagold","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":67,"Preview":{"Id":1823059,"PostDate":1388960044,"PostContent":"My fiance and I want to have a small elopement in Italy. There would be a few very close family m...","Author":{"Signature":"","Email":"erinklucio@gmail.com","IpAddress":"216.9.210.194","GroupId":39,"GroupName":"Newbie","JoinDate":1388953871,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275890.jpg?_r=1388974504","PhotoWidth":197,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Floridabride","Id":275890,"Name":"Floridabride","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"216.9.210.194","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75873,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"38a8a3dbb6b490a7852f7a58c24b4ff4","RawContent":"&lt;p&gt;My fiance and I want to have a small elopement in Italy. There would be a few very close family members joining us, then we plan to continue our honeymoon for 2 weeks.I am having trouble finding information on weddings there. We would be perfectly OK in our wedding attire, marrying in a town hall, and having a very intimate dinner at a fine dining restaurant. However we are pretty much open to all other suggestions there. Any brides using\/have used a planner they recommend, and any recommended venues?? Oh, did I mention we want to do this May THIS YEAR?!&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;SOS&lt;\/p&gt;","Attachments":[],"Id":1823059,"PostDate":1388960044,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>My fiance and I want to have a small elopement in Italy. There would be a few very close family members joining us, then we plan to continue our honeymoon for 2 weeks.I am having trouble finding information on weddings there. We would be perfectly OK in our wedding attire, marrying in a town hall, and having a very intimate dinner at a fine dining restaurant. However we are pretty much open to all other suggestions there. Any brides using\/have used a planner they recommend, and any recommended venues?? Oh, did I mention we want to do this May THIS YEAR?!\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>SOS<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"erinklucio@gmail.com","IpAddress":"216.9.210.194","GroupId":39,"GroupName":"Newbie","JoinDate":1388953871,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275890.jpg?_r=1388974504","PhotoWidth":197,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Floridabride","Id":275890,"Name":"Floridabride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"122.111.235.236","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75873,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9f389d0f94705a36befc0b834128284e","RawContent":"There are loads of wedding planners that come up in a simple google search. I have heard good things about SposiamoVi planners, and there are also quite a few listed on Style Me Pretty in their Italian destination weddings.\n\n\nThe wedding website matrimonio.com is also a good resource. \nAlso  whereabouts in Italy would you like to get married? That, and your budget will help narrow down your options.","Attachments":[],"Id":1839186,"PostDate":1395210358,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                There are loads of wedding planners that come up in a simple google search. I have heard good things about SposiamoVi planners, and there are also quite a few listed on Style Me Pretty in their Italian destination weddings.<br><br>\nThe wedding website matrimonio.com is also a good resource. <br \/>Also  whereabouts in Italy would you like to get married? That, and your budget will help narrow down your options. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"Using Tapatalk","Email":"barnes.stephaniej@gmail.com","IpAddress":"122.111.235.236","GroupId":39,"GroupName":"Newbie","JoinDate":1395210170,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277228.jpg?_r=1395224567","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"stephanie880","Id":277228,"Name":"stephanie880","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"79.6.234.249","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75873,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7744c7b5a8d9c96b80ea2114b8c92f13","RawContent":"&lt;p&gt;are you getting married in the south or in the north of Italy?&lt;\/p&gt;\n&lt;p&gt;I am getting married in Venice with Soave Italian Wedding, they&#039;re caring about everything and I can skype them any day and any hour!&lt;\/p&gt;","Attachments":[],"Id":1839582,"PostDate":1395337927,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>are you getting married in the south or in the north of Italy?<\/p>\n<p>I am getting married in Venice with Soave Italian Wedding, they're caring about everything and I can skype them any day and any hour!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"goldrebecca123@gmail.com","IpAddress":"79.6.234.249","GroupId":39,"GroupName":"Newbie","JoinDate":1395337418,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"rebeccagold","Id":277265,"Name":"rebeccagold","IsOnline":false}}],"Id":"75873","Title":"Italy- Help!","LastPostDate":1395337927},"Pages":{"TotalItems":3,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
