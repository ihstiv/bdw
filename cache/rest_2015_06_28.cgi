{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":5,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":130,"MovedTo":null,"MovedOn":0,"FirstPostId":1899407,"Rating":0,"RatingHits":0,"Starter":{"Id":280992,"Name":"MissFrench","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280992.jpg?_r=1421507914","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":true},"StartDate":1435392716,"LastPoster":{"Id":278581,"Name":"beckys98","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":true},"PollState":"0","LastVote":0,"ForumId":7,"Preview":{"Id":0,"PostDate":0,"PostContent":"","Author":{"Signature":"","Email":"","IpAddress":"","GroupId":0,"GroupName":"","JoinDate":0,"Photo":{"HasPhoto":false,"PhotoUrl":null,"PhotoWidth":0,"PhotoHeight":0,"PhotoType":""},"FormattedName":"","Id":0,"Name":"","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.179.187.201","IsFirstPost":false,"IsQueued":false,"IsVisible":false,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":false,"TopicId":79326,"EditedBy":null,"EditDate":0,"EditReason":null,"DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5c21e295221b44f295d32e71259cfe9a","RawContent":"","Attachments":[],"Id":1899455,"PostDate":1435499994,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We did not hire a professional videographer because the cost for video of ONE day of our amazing trip wasn't where we wanted to spend our money. We bought a GoPro and we are currently going through so much video of the entire week to edit into a video we can share with our guests. There is so much fun stuff on there!<br><br>\nWe did have someone record the ceremony on the GoPro as well and it turned out great! It records in high definition and the sound quality is perfect - you can hear the whole ceremony even though it was crazy windy. Not professional, of course, but definitely will give us a way to relive the memories. <br><br>\nTrust me, all those feelings will come rushing back when you watch the video...whether it is professionally done or not! \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rebecca.shaffer@gmail.com","IpAddress":"159.53.174.144","GroupId":40,"GroupName":"Jr. Member","JoinDate":1403098087,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"beckys98","Id":278581,"Name":"beckys98","IsOnline":true}}],"Id":"79326","Title":"To Video Or Not...advice Appreciated!","LastPostDate":1435499994},"Pages":null,"PushNotifications":[{"Key":"notifications","Value":2,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
