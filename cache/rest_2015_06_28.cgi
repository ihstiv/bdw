n and Ashley Armitage, and we booked Ashley. She&#039;s been soooo nice, and she&#039;s even given us advice on other vendors and venues. Check out her site at www.ashleyphotovi.com&lt;\/p&gt;","Attachments":[],"Id":1277988,"PostDate":1283527875,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I met with Eric Johnson and Ashley Armitage, and we booked Ashley. She's been soooo nice, and she's even given us advice on other vendors and venues. Check out her site at www.ashleyphotovi.com<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"andrea.cordts@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1273856420,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-228211.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Willow188","Id":228211,"Name":"Willow188","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":39143,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"55ee11a9fe8d6f39788d14dc21436ce0","RawContent":"&lt;p&gt; I plan on booking Elisha Orin as wel! Once I get the date set and can start making deposits. She does amazinggg work- I just love it!&lt;\/p&gt;","Attachments":[],"Id":1278230,"PostDate":1283538576,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I plan on booking Elisha Orin as wel! Once I get the date set and can start making deposits. She does amazinggg work- I just love it!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"TaraBinkoski@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1275585123,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-228820.gif?_r=0","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"FormattedName":"TaraBinki","Id":228820,"Name":"TaraBinki","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":39143,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ad1b9cbd3d3fcce1471c676e6e30e07e","RawContent":"&lt;p&gt; I already got my pictures from Elisha and they came out just awesome - I love her work. This is the link to my pics:&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; http:\/\/www.facebook.com\/album.php?id=620664133&amp;amp;aid=328662&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; http:\/\/www.facebook.com\/album.php?aid=328676&amp;amp;id=620664133&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I definitely recommend her:)&lt;\/p&gt;","Attachments":[],"Id":1419023,"PostDate":1300422991,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I already got my pictures from Elisha and they came out just awesome - I love her work. This is the link to my pics:<\/p> <p> \u00a0<\/p> <p> <a href='http:\/\/www.facebook.com\/album.php?id=620664133&aid=328662' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.facebook....4133&aid=328662<\/a><\/p> <p> \u00a0<\/p> <p> <a href='http:\/\/www.facebook.com\/album.php?aid=328676&id=620664133' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.facebook....76&id=620664133<\/a><\/p> <p> \u00a0<\/p> <p> I definitely recommend her:)<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"aniaandbill@googlemail.com","IpAddress":"50.250.243.86","GroupId":40,"GroupName":"Jr. Member","JoinDate":1271271077,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-227333.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"butterflyaniam","Id":227333,"Name":"butterflyaniam","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":39143,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c07d847e8441b7ae273f05ec12c71df5","RawContent":"&lt;p&gt; OMGGGG&lt;\/p&gt; &lt;p&gt; &amp;nbsp;they are stunning GORGEOUS perfectt just like how you looked!! I lovedd all the details..honestly incredible all the colors omgg..did you use islandbliss for your coordinator? wow you have a ton of amazing pictures! the water ones are unreal!!&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Congratss :)&lt;\/p&gt;","Attachments":[],"Id":1419391,"PostDate":1300460939,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> OMGGGG<\/p> <p> \u00a0they are stunning GORGEOUS perfectt just like how you looked!! I lovedd all the details..honestly incredible all the colors omgg..did you use islandbliss for your coordinator? wow you have a ton of amazing pictures! the water ones are unreal!!<\/p> <p> \u00a0<\/p> <p> Congratss <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"TaraBinkoski@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1275585123,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-228820.gif?_r=0","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"FormattedName":"TaraBinki","Id":228820,"Name":"TaraBinki","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":39143,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"17ee0277e0776115d51cf2b645e0bb73","RawContent":"&lt;p&gt; I got married on February 25, 2011 and we used Elisha Orin as well.&amp;nbsp; She is a sweetheart and does amazing work.&amp;nbsp; We had our first at home reception last night and had a slide show of around 250 pictures and everyone was saying how absolutely stunning her work is!&lt;\/p&gt; &lt;p&gt; We spent over 7 hours with her....1 hour&amp;nbsp;two days before for engagement\/getting used to her style pictures, 5 hours day of the wedding (got married at Villa Botanica, but I wanted pictures on the beach beforehand) and 1 hour the next days for TTD.&amp;nbsp; I couldn&#039;t be happier with the amount of pictures we have and how they turned out!&amp;nbsp; She is amazing!&amp;nbsp; And keep in mine, these prices are high, but you get the disk to&amp;nbsp;keep for yourself.&amp;nbsp; You can print them and use them however you like!&amp;nbsp; A lot of photogs make you order through them which can cost a fortune.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt;    &lt;img alt=\"amy-blog.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/339624\/width\/1000\/height\/500\" \/&gt;&lt;\/p&gt;","Attachments":[],"Id":1420887,"PostDate":1300727766,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I got married on February 25, 2011 and we used Elisha Orin as well.\u00a0 She is a sweetheart and does amazing work.\u00a0 We had our first at home reception last night and had a slide show of around 250 pictures and everyone was saying how absolutely stunning her work is!<\/p> <p> We spent over 7 hours with her....1 hour\u00a0two days before for engagement\/getting used to her style pictures, 5 hours day of the wedding (got married at Villa Botanica, but I wanted pictures on the beach beforehand) and 1 hour the next days for TTD.\u00a0 I couldn't be happier with the amount of pictures we have and how they turned out!\u00a0 She is amazing!\u00a0 And keep in mine, these prices are high, but you get the disk to\u00a0keep for yourself.\u00a0 You can print them and use them however you like!\u00a0 A lot of photogs make you order through them which can cost a fortune.<\/p> <p> \u00a0<\/p> <p> \u00a0\u00a0 <span rel='lightbox'><img class='bbc_img' alt=\"amy-blog.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/339624\/width\/1000\/height\/500\" \/><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"amys325@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1270822898,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"StThomas2011","Id":227187,"Name":"StThomas2011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":39143,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7c658029ea0f0c79f761a1cd947f3d4f","RawContent":"&lt;p&gt; We used Elisha....for about 8 hours during our stay (we did engagement, wedding, and trash the dress)&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Here are a few from her blog :)&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/thatstalk.elishaorin.com\/?p=3679\"&gt;http:\/\/thatstalk.elishaorin.com\/?p=3679&lt;\/a&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I definitely recommend her.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1425326,"PostDate":1301336201,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> We used Elisha....for about 8 hours during our stay (we did engagement, wedding, and trash the dress)<\/p> <p> \u00a0<\/p> <p> Here are a few from her blog <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p> <p> \u00a0<\/p> <p> <a href='http:\/\/thatstalk.elishaorin.com\/?p=3679' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/thatstalk.eli...rin.com\/?p=3679<\/a><\/p> <p> \u00a0<\/p> <p> I definitely recommend her.<\/p> <p> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"amys325@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1270822898,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"StThomas2011","Id":227187,"Name":"StThomas2011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":39143,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6e131c6e06984daf6f42c851eeef0162","RawContent":"&lt;p&gt; I will definitely check into these photographers.&lt;\/p&gt;","Attachments":[],"Id":1435081,"PostDate":1302821321,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I will definitely check into these photographers.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"atharris2@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1302820535,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-238891.jpg?_r=0","PhotoWidth":150,"PhotoHeight":108,"PhotoType":"custom"},"FormattedName":"atharris2","Id":238891,"Name":"atharris2","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":39143,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"88f0cb3e99fb84df6ea193132c9f968f","RawContent":"&lt;p&gt; Thanks for the advice on St Thomas photographers, you ladies are awesome!&lt;\/p&gt;","Attachments":[],"Id":1456628,"PostDate":1306162495,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Thanks for the advice on St Thomas photographers, you ladies are awesome!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mellojess83@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1305807112,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-240183.JPG?_r=0","PhotoWidth":200,"PhotoHeight":160,"PhotoType":"custom"},"FormattedName":"MelloJess83","Id":240183,"Name":"MelloJess83","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":39143,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f7a4ec27a70d9d32e0054c0c47c361e4","RawContent":"&lt;p&gt; Hi St. Thomas Brides! &amp;nbsp;Have you considered a Wedding Film?&amp;nbsp;We are Higher Definition Media. &amp;nbsp;We won&#039;t bore you with a sales pitch, instead, we&#039;ll let our work speak for itself. &amp;nbsp;Here is a recent wedding that we shot in Playa del Carmen:&lt;\/p&gt; &lt;p&gt; &lt;img _huddler_custom=\"vimeo-23929630\" width=\"425\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; If you have ay questions, visit our website at:&amp;nbsp;&lt;span style=\"text-decoration: underline ; color: #184fae\"&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.hdmweb.com\/gallery\/wedding\/wedding.html\"&gt;www.hdmweb.com&lt;\/a&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin: 0.0px 0.0px 0.0px 0.0px; line-height: 20.0px; font: 16.0px Helvetica\"&gt; &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1469194,"PostDate":1308059039,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hi St. Thomas Brides! \u00a0Have you considered a Wedding Film?\u00a0We are Higher Definition Media. \u00a0We won't bore you with a sales pitch, instead, we'll let our work speak for itself. \u00a0Here is a recent wedding that we shot in Playa del Carmen:<\/p> <p> <span rel='lightbox'><img class='bbc_img' _huddler_custom=\"vimeo-23929630\" width=\"425\" \/><\/span><\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> If you have ay questions, visit our website at:\u00a0<span  style=\"color: #184fae\"><a href='http:\/\/www.hdmweb.com\/gallery\/wedding\/wedding.html' class='bbc_url' title='External link' rel='nofollow external'>www.hdmweb.com<\/a><\/span><\/p> <p  style=\"margin: 0.0px 0.0px 0.0px 0.0px\"> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"andrew@hdmweb.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1289572183,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-233902.png?_r=0","PhotoWidth":200,"PhotoHeight":115,"PhotoType":"custom"},"FormattedName":"LovestruckFilms","Id":233902,"Name":"LovestruckFilms","IsOnline":false}}],"Pages":{"TotalItems":21,"TotalPages":3,"CurrentPage":10,"NextPage":20,"PreviousPage":0,"LastPage":20},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
