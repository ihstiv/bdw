1454211559,"Content":"Hello Natasha28,Welcome to BestDestinationWedding.com (BDW). BDW is the Ultimate Resource for pla...","PostKey":"6a38096706e13a4acaa10bca241dddf3","CanDelete":false,"Attachments":[]},"IsRead":true,"IsDeleted":false,"TotalReplies":0,"Notifications":false,"CanReply":false}],"Pages":{"TotalItems":2,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":3,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
