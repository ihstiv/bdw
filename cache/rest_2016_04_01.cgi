Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":3,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":306,"MovedTo":null,"MovedOn":0,"FirstPostId":1911951,"Rating":0,"RatingHits":0,"Starter":{"Id":286483,"Name":"sittingpretty","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1458076967,"LastPoster":{"Id":277873,"Name":"calgarybride2015","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":60,"Preview":{"Id":1911951,"PostDate":1458076967,"PostContent":"Hi Ladies Would love some advice, we are looking at getting married in thailand next year. After...","Author":{"Signature":"","Email":"cherrishm@hotmail.com","IpAddress":"60.224.7.226","GroupId":39,"GroupName":"Newbie","JoinDate":1458074387,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"sittingpretty","Id":286483,"Name":"sittingpretty","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"60.224.7.226","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79994,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3d0fbef9ce00c697f1a73a42c91e6851","RawContent":"Hi Ladies\n\n\nWould love some advice, we are looking at getting married in thailand next year. After looking at the legalities of it all we will more than likely sign the paperwork shortly before the dw.\n\nMy question however is, my australian passport is up for expiry before we depart. I think it would make sense to legally have my name changed now, and have my new passport reissued with my future married name. What do you think? Would you do this step and just keep it a secret from family and friends etc? \n\n\nThanks for your input.","Attachments":[],"Id":1911951,"PostDate":1458076967,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi Ladies<br><br>\nWould love some advice, we are looking at getting married in thailand next year. After looking at the legalities of it all we will more than likely sign the paperwork shortly before the dw.<br>\nMy question however is, my australian passport is up for expiry before we depart. I think it would make sense to legally have my name changed now, and have my new passport reissued with my future married name. What do you think? Would you do this step and just keep it a secret from family and friends etc? <br><br>\nThanks for your input.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cherrishm@hotmail.com","IpAddress":"60.224.7.226","GroupId":39,"GroupName":"Newbie","JoinDate":1458074387,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"sittingpretty","Id":286483,"Name":"sittingpretty","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"189.221.32.119","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79994,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"31c02ac564b249533d839b56975b2e6e","RawContent":"[quote name=\"sittingpretty\" post=\"1911951\" timestamp=\"1458091367\"]\nHi Ladies\n\nWould love some advice, we are looking at getting married in thailand next year. After looking at the legalities of it all we will more than likely sign the paperwork shortly before the dw.\nMy question however is, my australian passport is up for expiry before we depart. I think it would make sense to legally have my name changed now, and have my new passport reissued with my future married name. What do you think? Would you do this step and just keep it a secret from family and friends etc?\n\nThanks for your input.[\/quote]@[member=\"sittingpretty\"] a lot of brides actually do the legal part before going for their DW and having a symbolic ceremony.  I personally wanted to do the same thing when I got married , but I didn&#039;t have enough time.\n\nI would say do what makes you comfortable. \n\nHappy Planning!","Attachments":[],"Id":1912046,"PostDate":1458391654,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>sittingpretty, on 15 March 2016 - 09:22 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hi Ladies<br><br>\nWould love some advice, we are looking at getting married in thailand next year. After looking at the legalities of it all we will more than likely sign the paperwork shortly before the dw.<br>\nMy question however is, my australian passport is up for expiry before we depart. I think it would make sense to legally have my name changed now, and have my new passport reissued with my future married name. What do you think? Would you do this step and just keep it a secret from family and friends etc?<br><br>\nThanks for your input.<\/p>\n<\/div>\n<\/div><\/div>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"286483\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/286483-sittingpretty\/' title='Member profile'><span itemprop=\"name\">sittingpretty<\/span><\/a> a lot of brides actually do the legal part before going for their DW and having a symbolic ceremony. \u00a0I personally wanted to do the same thing when I got married , but I didn't have enough time.<\/p>\n<p>\u00a0<\/p>\n<p>I would say do what makes you comfortable.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Happy Planning!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Dream Weddings Riviera Maya- We pay attention to your wishes and coordinate closely with you to ensure your wedding or event is planned to perfection! Supporting you brides and help you feel less overwhelmed during the wedding planning process.<\/p>\n<p>Have fun the best is yet to come!<\/p>\n<p>\u00a0<\/p>\n<p>This is where I will be posting all videos about most common question about Destination wedding<\/p>\n<p> <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0\u00a0<a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/groups\/1664036763874450\/'>https:\/\/www.facebook.com\/groups\/1664036763874450\/<\/a><br><br><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Dream Weddings Riviera Maya<\/span><\/span><\/span><br><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">weddingsinplayadelcarmen@gmail.com<\/span><\/span><br><a  class=\"bbc_url\" href=\"http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html\">http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html<\/a><br><br><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Happy Planning!<\/span><\/span><\/span><br><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Joyce<\/span><\/span><\/span>","Email":"weddingsinplayadelcarmen@gmail.com","IpAddress":"187.252.44.28","GroupId":84,"GroupName":"Insiders w\/ Articles","JoinDate":1326839987,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250090.jpg?_r=1451923195","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"dreamweddings","Id":250090,"Name":"dreamweddings","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.66.68.111","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79994,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"37db76dc5834036b22dcd51c0f041cdf","RawContent":"I would. Passports aren&#039;t cheap!!\n\n\nWe legally married in Canada before our DW. It was only a week before and since I didn&#039;t have time to change my passport I still haven&#039;t. Been traveling in my maiden name as I have a few years left \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1912051,"PostDate":1458416545,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I would. Passports aren't cheap!!<br><br>\nWe legally married in Canada before our DW. It was only a week before and since I didn't have time to change my passport I still haven't. Been traveling in my maiden name as I have a few years left <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}}],"Id":"79994","Title":"Name Change Before Wedding","LastPostDate":1458416545},"Pages":{"TotalItems":3,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
