{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"64.231.97.33","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79036,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a69c2e1f65534af924f533a176ee827f","RawContent":"&lt;p&gt;@[member=\"AllieH\"] Oh you both look so happy!!! Your dress is beautiful!!!&lt;\/p&gt;","Attachments":[],"Id":1893144,"PostDate":1429048208,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"241884\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/241884-allieh\/' title='Member profile'><span itemprop=\"name\">AllieH<\/span><\/a> Oh you both look so happy!!! Your dress is beautiful!!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><em><span style=\"color:rgb(51,153,255);\">I'm lucky enough to\u00a0tell my husband how much I love him and say yes again\u00a0on October 20, 2015 at Grand Coral Beach Club!\u00a0<\/span><\/em>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.41.59","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79036,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"6fecffc3fbede061e82258c1976dfdac","RawContent":"&lt;p&gt;@[member=\"AllieH\"], I also agree :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;My dress is sitting dirty in my basement in its garment bag.&lt;\/p&gt;\n&lt;p&gt;Don&#039;t think paying for it to be cleaned is worth the $$$$ &amp;nbsp;may give it away for free but they have to get it cleaned themselves. Not sure yet!&lt;\/p&gt;","Attachments":[],"Id":1893145,"PostDate":1429048407,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"241884\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/241884-allieh\/' title='Member profile'><span itemprop=\"name\">AllieH<\/span><\/a>, I also agree <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>My dress is sitting dirty in my basement in its garment bag.<\/p>\n<p>Don't think paying for it to be cleaned is worth the $$$$ \u00a0may give it away for free but they have to get it cleaned themselves. Not sure yet!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.49.155.73","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79036,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":3,"IsLiked":false,"PostKey":"a110adc5628abd2788fc1d9ebc0d7808","RawContent":"&lt;div&gt;[sharedmedia=gallery:images:81116]&lt;\/div&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I hope you can see it, but that&#039;s a picture of my dress! &amp;nbsp;It needs to be altered a bit (needs to be bustled, the bust needs to be adjusted, the panel in the back needs to be replaced, and some of the beading needs to be replaced). &amp;nbsp;I bought my dress second-hand and got a really good deal on it.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1894724,"PostDate":1430229447,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/81116-my-dress\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_18018\/sml_gallery_276748_18018_34470.jpg' class='galattach galimageview sharedmedia_screenshot' title='My Dress'  width='150' height='200'  alt='My Dress' id='sml_image_view_81116' \/><\/a>\n<br \/><\/div>\n<p>\u00a0<\/p>\n<p>I hope you can see it, but that's a picture of my dress! \u00a0It needs to be altered a bit (needs to be bustled, the bust needs to be adjusted, the panel in the back needs to be replaced, and some of the beading needs to be replaced). \u00a0I bought my dress second-hand and got a really good deal on it.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div><br><div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;484\/st\/20150924\/e\/Our+Wedding\/k\/8745\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<\/div>\n<div>\u00a0<\/div>\n<div>My Planning Thread:<\/div>\n<div>\u00a0<\/div>\n<div><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79153-diadiamonds-planning-thread-iberostar-varadero-cuba-sept242015\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79153-diadiamonds-planning-thread-iberostar-varadero-cuba-sept242015\/<\/a><\/div>\n<div>\u00a0<\/div>\n<div>\u00a0<\/div>\n","Email":"fadia.daniel@gmail.com","IpAddress":"76.64.81.211","GroupId":40,"GroupName":"Jr. Member","JoinDate":1392649643,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276748.jpg?_r=1445822927","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"diadiamond","Id":276748,"Name":"diadiamond","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"161.185.150.180","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79036,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"4fcb6312347605317b6660ca7d34b97e","RawContent":"&lt;p&gt;@[member=\"diadiamond\"] You look beautiful :) four months to go how exciting.&lt;\/p&gt;","Attachments":[],"Id":1894729,"PostDate":1430230242,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"276748\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/276748-diadiamond\/' title='Member profile'><span itemprop=\"name\">diadiamond<\/span><\/a> You look beautiful <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> four months to go how exciting.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p style=\"text-align:center;\">\u00a0 \u00a0 \u00a0 \u00a0 \u00a0 Future Mrs. Bonitto 10\/14\/16<\/p>\n<div><br><div>\u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0<a  class=\"bbc_url\" href=\"http:\/\/www.theknot.com\/?utm_source=ticker&utm_medium=UBB&utm_campaign=tickers\"><img src=\"http:\/\/global.theknot.com\/tickers\/tt1c2490.aspx\" alt=\"tt1c2490.aspx\"><\/a><\/div>\n<div>\u00a0\u00a0<\/div>\n<\/div>\n<p>\u00a0","Email":"shamicaglover@yahoo.com","IpAddress":"161.185.157.23","GroupId":40,"GroupName":"Jr. Member","JoinDate":1394118776,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277031.jpg?_r=1397251056","PhotoWidth":200,"PhotoHeight":203,"PhotoType":"custom"},"FormattedName":"MrandMrsBonitto2016","Id":277031,"Name":"MrandMrsBonitto2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.87.237.180","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79036,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"09ff023618e18090ea7d1c100a0761de","RawContent":"&lt;p&gt;That&#039;s so pretty!! It looks beautiful on you!!!&amp;nbsp; I was looking second hand too. Still am actually. There really are good deals out there if you take the time to look!!&amp;nbsp;No final decision yet. I was all finished with my dress, or so I thought. Then hubby asked if there was a way to bring the cost down, and the way he asked was so nicely that I couldn&#039;t say no. So...... I&#039;m back in the hunt. There is one dress I&#039;m waiting for details on then I&#039;ll go from there. Thought it would be by now but the site owner is saying not until about May18th now. That&#039;s ok. Lots of time yet.&lt;\/p&gt;","Attachments":[],"Id":1894736,"PostDate":1430231551,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>That's so pretty!! It looks beautiful on you!!!\u00a0 I was looking second hand too. Still am actually. There really are good deals out there if you take the time to look!!\u00a0No final decision yet. I was all finished with my dress, or so I thought. Then hubby asked if there was a way to bring the cost down, and the way he asked was so nicely that I couldn't say no. So...... I'm back in the hunt. There is one dress I'm waiting for details on then I'll go from there. Thought it would be by now but the site owner is saying not until about May18th now. That's ok. Lots of time yet.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><em><span style=\"color:rgb(51,153,255);\">I'm lucky enough to\u00a0tell my husband how much I love him and say yes again\u00a0on October 20, 2015 at Grand Coral Beach Club!\u00a0<\/span><\/em>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.49.155.73","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79036,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"a004c79ec16b8a4f941a087abedd9be9","RawContent":"&lt;p&gt;@[member=\"MrandMrsBonitto2016\"] Thanks hun =) &amp;nbsp;I know it&#039;s so exciting!!! I&#039;ve been on this forum for almost a year and a half and I&#039;m finally at the point where I&#039;m doing stuff =) &amp;nbsp;&lt;\/p&gt;\n\n&lt;p&gt;@[member=\"acw271011\"] Thanks hun! &amp;nbsp;I&#039;ll admit I got really lucky with my dress. &amp;nbsp;I was on Facebook in a brides group and this woman was selling a dress she bought for her daughter that her daughter didn&#039;t like and when I saw the pictures and realized it was a size 18 I had to at least make the effort to try it on. &amp;nbsp;It was never worn and I got it for $350.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I know that there are some websites out there devoted to selling second hand gowns, I don&#039;t know the names, but I know they are out there. &amp;nbsp;I went shopping at David&#039;s Bridal and their dresses weren&#039;t that bad. &amp;nbsp;I liked one that was $599. &amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Hopefully the dress you want becomes available for you. &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1894753,"PostDate":1430238365,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"277031\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277031-mrandmrsbonitto2016\/' title='Member profile'><span itemprop=\"name\">MrandMrsBonitto2016<\/span><\/a> Thanks hun =) \u00a0I know it's so exciting!!! I've been on this forum for almost a year and a half and I'm finally at the point where I'm doing stuff =) \u00a0<\/p>\n<br \/><p>@<a hovercard-ref=\"member\" hovercard-id=\"232000\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/232000-acw271011\/' title='Member profile'><span itemprop=\"name\">acw271011<\/span><\/a> Thanks hun! \u00a0I'll admit I got really lucky with my dress. \u00a0I was on Facebook in a brides group and this woman was selling a dress she bought for her daughter that her daughter didn't like and when I saw the pictures and realized it was a size 18 I had to at least make the effort to try it on. \u00a0It was never worn and I got it for $350.<\/p>\n<p>\u00a0<\/p>\n<p>I know that there are some websites out there devoted to selling second hand gowns, I don't know the names, but I know they are out there. \u00a0I went shopping at David's Bridal and their dresses weren't that bad. \u00a0I liked one that was $599. \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Hopefully the dress you want becomes available for you. \u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div><br><div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;484\/st\/20150924\/e\/Our+Wedding\/k\/8745\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<\/div>\n<div>\u00a0<\/div>\n<div>My Planning Thread:<\/div>\n<div>\u00a0<\/div>\n<div><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79153-diadiamonds-planning-thread-iberostar-varadero-cuba-sept242015\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79153-diadiamonds-planning-thread-iberostar-varadero-cuba-sept242015\/<\/a><\/div>\n<div>\u00a0<\/div>\n<div>\u00a0<\/div>\n","Email":"fadia.daniel@gmail.com","IpAddress":"76.64.81.211","GroupId":40,"GroupName":"Jr. Member","JoinDate":1392649643,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276748.jpg?_r=1445822927","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"diadiamond","Id":276748,"Name":"diadiamond","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"161.185.150.180","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79036,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"bd49c63f26641193096af48d15db7147","RawContent":"&lt;p&gt;@[member=\"diadiamond\"] I&#039;ve been on this site forever. And I still have an eternity to go :( But, I get so excited for the other brides. I&#039;m a geek I know. LOL......&lt;\/p&gt;","Attachments":[],"Id":1894759,"PostDate":1430241735,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"276748\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/276748-diadiamond\/' title='Member profile'><span itemprop=\"name\">diadiamond<\/span><\/a> I've been on this site forever. And I still have an eternity to go <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/sad.png' class='bbc_emoticon' alt=':(' \/> But, I get so excited for the other brides. I'm a geek I know. LOL......<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p style=\"text-align:center;\">\u00a0 \u00a0 \u00a0 \u00a0 \u00a0 Future Mrs. Bonitto 10\/14\/16<\/p>\n<div><br><div>\u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0<a  class=\"bbc_url\" href=\"http:\/\/www.theknot.com\/?utm_source=ticker&utm_medium=UBB&utm_campaign=tickers\"><img src=\"http:\/\/global.theknot.com\/tickers\/tt1c2490.aspx\" alt=\"tt1c2490.aspx\"><\/a><\/div>\n<div>\u00a0\u00a0<\/div>\n<\/div>\n<p>\u00a0","Email":"shamicaglover@yahoo.com","IpAddress":"161.185.157.23","GroupId":40,"GroupName":"Jr. Member","JoinDate":1394118776,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277031.jpg?_r=1397251056","PhotoWidth":200,"PhotoHeight":203,"PhotoType":"custom"},"FormattedName":"MrandMrsBonitto2016","Id":277031,"Name":"MrandMrsBonitto2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.49.155.73","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79036,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"3ba7d8d422f2e9db1426894b674f25c2","RawContent":"&lt;p&gt;@[member=\"MrandMrsBonitto2016\"] I was in your shoes before and time feels like it will go so slow. &amp;nbsp;Since I hit the 6 month mark time has just been flying by! &amp;nbsp;I get excited for other brides too and I often creep planning threads.&lt;\/p&gt;","Attachments":[],"Id":1894768,"PostDate":1430245826,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"277031\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277031-mrandmrsbonitto2016\/' title='Member profile'><span itemprop=\"name\">MrandMrsBonitto2016<\/span><\/a> I was in your shoes before and time feels like it will go so slow. \u00a0Since I hit the 6 month mark time has just been flying by! \u00a0I get excited for other brides too and I often creep planning threads.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div><br><div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;484\/st\/20150924\/e\/Our+Wedding\/k\/8745\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<\/div>\n<div>\u00a0<\/div>\n<div>My Planning Thread:<\/div>\n<div>\u00a0<\/div>\n<div><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79153-diadiamonds-planning-thread-iberostar-varadero-cuba-sept242015\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79153-diadiamonds-planning-thread-iberostar-varadero-cuba-sept242015\/<\/a><\/div>\n<div>\u00a0<\/div>\n<div>\u00a0<\/div>\n","Email":"fadia.daniel@gmail.com","IpAddress":"76.64.81.211","GroupId":40,"GroupName":"Jr. Member","JoinDate":1392649643,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276748.jpg?_r=1445822927","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"diadiamond","Id":276748,"Name":"diadiamond","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"206.75.51.136","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79036,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"a98b5174f5c665e2610e1875f235753e","RawContent":"[quote name=\"diadiamond\" post=\"1894768\" timestamp=\"1430260226\"]\n@[member=\"MrandMrsBonitto2016\"] I was in your shoes before and time feels like it will go so slow.  Since I hit the 6 month mark time has just been flying by!  I get excited for other brides too and I often creep planning threads.[\/quote]Same h\u00e9roe! We&#039;ve been engaged for 2 years and a half and I&#039;ve been around since then. It felt like time was going at continental drift speed but the last 6 months are going by really quickly! \n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1894787,"PostDate":1430258769,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>diadiamond, on 28 April 2015 - 06:30 PM, said:<\/p><div class='blockquote'><div class='quote'><p>@<a hovercard-ref=\"member\" hovercard-id=\"277031\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277031-mrandmrsbonitto2016\/' title='Member profile'><span itemprop=\"name\">MrandMrsBonitto2016<\/span><\/a> I was in your shoes before and time feels like it will go so slow.  Since I hit the 6 month mark time has just been flying by!  I get excited for other brides too and I often creep planning threads.<\/p><\/div><\/div>\n<br>\nSame h\u00e9roe! We've been engaged for 2 years and a half and I've been around since then. It felt like time was going at continental drift speed but the last 6 months are going by really quickly! <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<br><p><a data-ipb='nomediaparse' href='http:\/\/www.TickerFactory.com\/'><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;31;484\/st\/20150813\/e\/Wedding+time%21+\/dt\/-2\/k\/b92c\/event.png\" alt=\"event.png\"><\/a><\/p>\n<p style=\"text-align:center;\">\u00a0<\/p>\n<p style=\"text-align:center;\">\u00a0","Email":"sblopezb@gmail.com","IpAddress":"172.219.193.22","GroupId":42,"GroupName":"Sr. Member","JoinDate":1359748704,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265511.jpg?_r=1442890536","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"TinkerSofi","Id":265511,"Name":"TinkerSofi","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"142.176.81.105","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79036,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":3,"IsLiked":false,"PostKey":"cd83ad38eca5a5306b823987116e00a5","RawContent":"&lt;p&gt;I bought my dress last week! I&#039;m so excited !! My mother is going to kill me when she finds out lol. I went shopping by myself just to try on a couple and see what fit looked good on me. The second one I tried on was THE ONE though and it was HALF PRICE! I had to buy it lol. Right? I may need to stage a mock dress shopping trip for my mother though haha.&lt;\/p&gt;\n&lt;div&gt;[sharedmedia=gallery:albums:18075]&lt;\/div&gt;","Attachments":[],"Id":1900735,"PostDate":1437331573,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I bought my dress last week! I'm so excited !! My mother is going to kill me when she finds out lol. I went shopping by myself just to try on a couple and see what fit looked good on me. The second one I tried on was THE ONE though and it was HALF PRICE! I had to buy it lol. Right? I may need to stage a mock dress shopping trip for my mother though haha.<\/p>\n<div><div class='_sharedMediaBbcode'>\n\t<div class='bbcode_mediaWrap clearfix'>\n\t\t<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/album\/18075-streel-wedding\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_18075\/tn_gallery_283685_18075_1507604.jpg' class='sharedmedia_screenshot cover_img_75' title='gorgeous basketweave detail'  width='75' height='75'  alt='gorgeous basketweave detail' id='tn_image_view_81629_cover' \/><\/a>\n\t\t<div class='details'>\n\t\t\t<h5><a href='http:\/\/www.bestdestinationwedding.com\/gallery\/album\/18075-streel-wedding\/' class='bbc_url' title=''>Album: Streel Wedding<\/a><\/h5>\n\t\t\t<div>6 images<\/div>\n\t\t\t<div>0 comments<\/div>\n\t\t<\/div>\n\t<\/div>\n<\/div>\n<br \/><\/div>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sarah_e_collier@hotmail.com","IpAddress":"142.176.60.154","GroupId":39,"GroupName":"Newbie","JoinDate":1435226162,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283685.jpg?_r=1437401496","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"streelbride","Id":283685,"Name":"streelbride","IsOnline":false}}],"Pages":{"TotalItems":39,"TotalPages":4,"CurrentPage":10,"NextPage":20,"PreviousPage":0,"LastPage":30},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
