a, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Omgosh I just love this idea. Thank you for sharing. I bet you are getting super excited about your big day!! Looking forward to hearing all about it! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p style=\"text-align:center;\"><img src=\"http:\/\/www.tickerclub.com\/tickers\/wedding\/preview\/idTicker\/206838\/rulerId\/\/sliderId\/\/\" alt=\"sliderId\"><\/p>\n<p style=\"text-align:center;\">\u00a0","Email":"amanda@roamcanada.com","IpAddress":"41.218.252.222","GroupId":39,"GroupName":"Newbie","JoinDate":1411393687,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279936.jpg?_r=1414239845","PhotoWidth":200,"PhotoHeight":246,"PhotoType":"custom"},"FormattedName":"amanda2016","Id":279936,"Name":"amanda2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"162.234.72.154","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78217,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"f6b89af2f5425670f5a7d0c724fcb380","RawContent":"[quote name=\"palmtree99\" post=\"1876078\" timestamp=\"1413646878\"]\n@[member=\"khmciver\"] would you share your three templetes for the mini gift bags? I&#039;m obsessed with your bags! I love how everything matches. What did you use to design the logos? My email is cathyr99@yahoo.com[\/quote]Sure! I can email them to you tonight. Thanks!","Attachments":[],"Id":1876290,"PostDate":1413812715,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>palmtree99, on 18 October 2014 - 11:41 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>@khmciver would you share your three templetes for the mini gift bags? I'm obsessed with your bags! I love how everything matches. What did you use to design the logos? My email is cathyr99@yahoo.com<\/p>\n<\/div>\n<\/div><\/div>\n<p>Sure! I can email them to you tonight. Thanks!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Wedding Date: November 1, 2015<br>\nWedding Location: Azul Fives Hotel in Playa del Carmen<\/p>\n<p>Photographer: Photos in Cancun - Derek Campbell<br>\n<a data-ipb='nomediaparse' href='http:\/\/www.photosincancun.com'>http:\/\/www.photosincancun.com<\/a><\/p>\n<p>Decoration Rentals: Love & Lace Wedding Decor<br>\n<a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/loveandlacedecor'>https:\/\/www.facebook.com\/loveandlacedecor<\/a><\/p>\n<div>Wedding Photo Album: <a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/media\/set\/?set=a.10100809953124424.1073741834.18310150&type=1&l=581de87d2f'>https:\/\/www.facebook.com\/media\/set\/?set=a.10100809953124424.1073741834.18310150&type=1&l=581de87d2f<\/a><\/div>\n","Email":"khmciver@gmail.com","IpAddress":"108.223.176.224","GroupId":47,"GroupName":"Site Supporter","JoinDate":1386793154,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275598.jpg?_r=1426649427","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"kellymenning","Id":275598,"Name":"kellymenning","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"38.112.94.76","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78217,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5d057376d4a1dc7cac4a0e34496a4eef","RawContent":"&lt;p&gt;This is absolutely amazing!!!!!!&amp;nbsp; Your guests are going to love it!&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I just sent out my invites so I&#039;m not ready to prep for this yet but when I am I will be looking to this for inspiration.&lt;\/p&gt;","Attachments":[],"Id":1876301,"PostDate":1413820408,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>This is absolutely amazing!!!!!!\u00a0 Your guests are going to love it!\u00a0<\/p>\n<p>I just sent out my invites so I'm not ready to prep for this yet but when I am I will be looking to this for inspiration.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div><br><div>\u00a0<\/div>\n<div>\u00a0<\/div>\n<div>Married on June 20th, 2015 at the Grand Sunset Princess Riviera Gazebo & Reception at the Chill Out with 60 guests<\/div>\n<div>\u00a0<\/div>\n<\/div>\n<div>\u00a0<\/div>\n<p>My planning thread:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/<\/a><\/p>\n<p>My review thread: \u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/<\/a>","Email":"rebecca.valero@gmail.com","IpAddress":"38.112.94.76","GroupId":3,"GroupName":"Member","JoinDate":1396968452,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277519.jpg?_r=1439827749","PhotoWidth":200,"PhotoHeight":132,"PhotoType":"custom"},"FormattedName":"veryvalentine","Id":277519,"Name":"veryvalentine","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"107.201.33.67","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78217,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b48e0ad96d88a86b7dab15ba42703f17","RawContent":"@[member=\"khmciver\"] thank you! :)))","Attachments":[],"Id":1876309,"PostDate":1413823908,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @khmciver thank you! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>))\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cathyr99@yahoo.com","IpAddress":"107.201.33.67","GroupId":40,"GroupName":"Jr. Member","JoinDate":1412551851,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280304.jpg?_r=1412569727","PhotoWidth":200,"PhotoHeight":281,"PhotoType":"custom"},"FormattedName":"palmtree99","Id":280304,"Name":"palmtree99","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.41.59","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78217,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b9c17c141c3f21ac0fda0246c249c0cb","RawContent":"&lt;span&gt;@&lt;a  class=\"\" href=\"http:\/\/www.bestdestinationwedding.com\/user\/275598-khmciver\/\" title=\"\"&gt;khmciver&lt;\/a&gt;&lt;\/span&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span&gt;Did you make the itineraries, thank you letter, etc. yourself or did you purchase it from Etsy?&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span&gt;I would possibly like to do something similar.&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span&gt;Thank you!&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1876389,"PostDate":1413883470,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                \n\t<span>@<a href='http:\/\/www.bestdestinationwedding.com\/user\/275598-khmciver\/' class='bbc_url' title=''>khmciver<\/a><\/span>\n<p>\u00a0<\/p>\n<p><span>Did you make the itineraries, thank you letter, etc. yourself or did you purchase it from Etsy?<\/span><\/p>\n<p><span>I would possibly like to do something similar.<\/span><\/p>\n<p>\u00a0<\/p>\n<p><span>Thank you!<\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.223.176.224","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78217,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"37305018fb8ec48670478f11ea8702b9","RawContent":"@[member=\"calgarybride2015\"] I got them designed by Amie Lee. Inspirationsbyamielee.com.  She&#039;s definitely the most expensive thing I did, but I really wanted them to be nice and I needed a lot of them. They turned out great!!","Attachments":[],"Id":1876392,"PostDate":1413887037,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"277873\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/277873-calgarybride2015\/' title='Member profile'><span itemprop=\"name\">calgarybride2015<\/span><\/a> I got them designed by Amie Lee. Inspirationsbyamielee.com.  She's definitely the most expensive thing I did, but I really wanted them to be nice and I needed a lot of them. They turned out great!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Wedding Date: November 1, 2015<br>\nWedding Location: Azul Fives Hotel in Playa del Carmen<\/p>\n<p>Photographer: Photos in Cancun - Derek Campbell<br>\n<a data-ipb='nomediaparse' href='http:\/\/www.photosincancun.com'>http:\/\/www.photosincancun.com<\/a><\/p>\n<p>Decoration Rentals: Love & Lace Wedding Decor<br>\n<a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/loveandlacedecor'>https:\/\/www.facebook.com\/loveandlacedecor<\/a><\/p>\n<div>Wedding Photo Album: <a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/media\/set\/?set=a.10100809953124424.1073741834.18310150&type=1&l=581de87d2f'>https:\/\/www.facebook.com\/media\/set\/?set=a.10100809953124424.1073741834.18310150&type=1&l=581de87d2f<\/a><\/div>\n","Email":"khmciver@gmail.com","IpAddress":"108.223.176.224","GroupId":47,"GroupName":"Site Supporter","JoinDate":1386793154,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275598.jpg?_r=1426649427","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"kellymenning","Id":275598,"Name":"kellymenning","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"184.151.222.253","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78217,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f9f94547738a9be27fc83181523951d1","RawContent":"[quote name=\"khmciver\" post=\"1876392\" timestamp=\"1413901437\"]\n@[member=\"calgarybride2015\"] I got them designed by Amie Lee. Inspirationsbyamielee.com.  She&#039;s definitely the most expensive thing I did, but I really wanted them to be nice and I needed a lot of them. They turned out great!![\/quote]They did turn out great. Thank you! I&#039;ll take a peak. I love the thank you letter but since we are only doing tumblers, unsure where\/when to give it. \n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1876396,"PostDate":1413887787,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>khmciver, on 21 October 2014 - 10:23 AM, said:<\/p><div class='blockquote'><div class='quote'><p>@<a hovercard-ref=\"member\" hovercard-id=\"277873\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/277873-calgarybride2015\/' title='Member profile'><span itemprop=\"name\">calgarybride2015<\/span><\/a> I got them designed by Amie Lee. Inspirationsbyamielee.com.  She's definitely the most expensive thing I did, but I really wanted them to be nice and I needed a lot of them. They turned out great!!<\/p><\/div><\/div>\n<br>\nThey did turn out great. Thank you! I'll take a peak. I love the thank you letter but since we are only doing tumblers, unsure where\/when to give it. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.188.120.34","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78217,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"d944517a2d9a9152027df3815f7f05aa","RawContent":"&lt;p&gt;They look great and thanks for the template. The link to the bags would be very helpful. I just love this website so many ideas and for you guys who upload your pics and links your the best. I have spent hours online trying to find these things now I can just come on here.&lt;\/p&gt;","Attachments":[],"Id":1876399,"PostDate":1413889143,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>They look great and thanks for the template. The link to the bags would be very helpful. I just love this website so many ideas and for you guys who upload your pics and links your the best. I have spent hours online trying to find these things now I can just come on here.<\/p>\n\r\n              <\/body>\r\n            <\/html>",