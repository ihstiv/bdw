sFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78404,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"70fc08e0cc63a13c09b8654bafb279b3","RawContent":"[quote name=\"acw271011\" post=\"1878894\" timestamp=\"1416621204\"]\nWow! I can&#039;t think of anything else to say except beautiful! And what is that awesome song that plays with your video??[\/quote]\nThe song is All This Time by One Republic. It&#039;s one of my favorite songs and the song I walked down the aisle to.","Attachments":[],"Id":1878913,"PostDate":1416662654,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>acw271011, on 21 November 2014 - 05:53 PM, said:<\/p><div class='blockquote'><div class='quote'><p>Wow! I can't think of anything else to say except beautiful! And what is that awesome song that plays with your video??<\/p><\/div><\/div>\n<br>\nThe song is All This Time by One Republic. It's one of my favorite songs and the song I walked down the aisle to. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Wedding Date: November 1, 2015<br>\nWedding Location: Azul Fives Hotel in Playa del Carmen<\/p>\n<p>Photographer: Photos in Cancun - Derek Campbell<br>\n<a data-ipb='nomediaparse' href='http:\/\/www.photosincancun.com'>http:\/\/www.photosincancun.com<\/a><\/p>\n<p>Decoration Rentals: Love & Lace Wedding Decor<br>\n<a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/loveandlacedecor'>https:\/\/www.facebook.com\/loveandlacedecor<\/a><\/p>\n<div>Wedding Photo Album: <a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/media\/set\/?set=a.10100809953124424.1073741834.18310150&type=1&l=581de87d2f'>https:\/\/www.facebook.com\/media\/set\/?set=a.10100809953124424.1073741834.18310150&type=1&l=581de87d2f<\/a><\/div>\n","Email":"khmciver@gmail.com","IpAddress":"108.223.176.224","GroupId":47,"GroupName":"Site Supporter","JoinDate":1386807554,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275598.jpg?_r=1426649427","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"kellymenning","Id":275598,"Name":"kellymenning","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"76.16.100.44","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78404,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3fb9223d95a0f2b91aec04b9bb575db2","RawContent":"[quote name=\"khmciver\" post=\"1878906\" timestamp=\"1416635936\"]\nI&#039;m sort of Stupid sometimes. What do you mean how did I use them? I&#039;m confused.[\/quote]\nSorry for the confusion! \nDid you do it at the beginning of the reception? During your first dance? as your exit for the night? etc.\n\nthanks!","Attachments":[],"Id":1878927,"PostDate":1416675648,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>khmciver, on 21 November 2014 - 09:58 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>I'm sort of Stupid sometimes. What do you mean how did I use them? I'm confused.<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>Sorry for the confusion!\u00a0<\/p>\n<p>Did you do it at the beginning of the reception? During your first dance? as your exit for the night? etc.<\/p>\n<p>\u00a0<\/p>\n<p>thanks!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kelseybutson@gmail.com","IpAddress":"173.161.18.162","GroupId":39,"GroupName":"Newbie","JoinDate":1389648734,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kjb123","Id":276061,"Name":"kjb123","IsOnline":false}}],"Id":"78404","Title":"My Amazing Wedding Video! (At Azul Fives In Playa)","LastPostDate":1432657196},"Pages":{"TotalItems":22,"TotalPages":3,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":20},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
