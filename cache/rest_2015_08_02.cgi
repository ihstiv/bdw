{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":13,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":1520,"MovedTo":null,"MovedOn":0,"FirstPostId":1882435,"Rating":0,"RatingHits":0,"Starter":{"Id":279680,"Name":"hannahlf11","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279680.jpg?_r=1432154147","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"StartDate":1420853551,"LastPoster":{"Id":279680,"Name":"hannahlf11","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279680.jpg?_r=1432154147","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":34,"Preview":{"Id":1882435,"PostDate":1420853551,"PostContent":"Hi ladies! My wedding is July 18. So far, all that has been sent out is just the email that our T...","Author":{"Signature":"","Email":"hannahfarris4@yahoo.com","IpAddress":"108.230.30.121","GroupId":39,"GroupName":"Newbie","JoinDate":1409802442,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279680.jpg?_r=1432154147","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"hannahlf11","Id":279680,"Name":"hannahlf11","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.223.133.100","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78577,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b229232d4dc7721e562b9f753e760969","RawContent":"&lt;p&gt;Hi ladies! My wedding is July 18. So far, all that has been sent out is just the email that our TA made for us to send out, it was basically a paperless save the date. When should I be sending out the invitations? ASAP?&amp;nbsp; I was hoping to only send the invites to people that were already booked, but its impossilbe for me to know because most people arent going through our TA, they are booking on their own.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Also, what all are yall including in yalls invite? Are yall doing the welcome letter that goes over details? Sorry if this is confusing, I feel so lost in this whole process. I&#039;m starting to freak out lol&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1882435,"PostDate":1420853551,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi ladies! My wedding is July 18. So far, all that has been sent out is just the email that our TA made for us to send out, it was basically a paperless save the date. When should I be sending out the invitations? ASAP?\u00a0 I was hoping to only send the invites to people that were already booked, but its impossilbe for me to know because most people arent going through our TA, they are booking on their own.<\/p>\n<p>\u00a0<\/p>\n<p>Also, what all are yall including in yalls invite? Are yall doing the welcome letter that goes over details? Sorry if this is confusing, I feel so lost in this whole process. I'm starting to freak out lol<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"hannahfarris4@yahoo.com","IpAddress":"108.230.30.121","GroupId":39,"GroupName":"Newbie","JoinDate":1409802442,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279680.jpg?_r=1432154147","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"hannahlf11","Id":279680,"Name":"hannahlf11","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.41.59","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78577,"EditedBy":"<strong>Edited by calgarybride2015, 10 January 2015 - 01:50 AM.<\/strong>","EditDate":1420854650,"EditReason":"","DeleteDate":0,"TotalLikes":4,"IsLiked":false,"PostKey":"6e4ecdc11b5612ad395ec257955cfb21","RawContent":"Welcome and congrats \n\n\nI sent my invites out to everyone at about 7.5 months out. My invite said where and when but directed them to our wedding website for TA info, prices, RSVP, and all other info for Mexico.   \n\n\nWe made the RSVP date the same as the booking deadline from the travel agent. \n\n\nAfter people paid their final Payment, about 2.5 months before the wedding, we sent a pre travel brochure which mimicked our webpage and had some extra info and each person got a luggage tag.  \n\n\nThat&#039;s all I did -- so everyone we wanted to invite got an invite but only people who were 100% paid and coming got the pre travel package. We picked our resort in may and are marrying in less 2 weeks. We leave in 8 days :) \n\n\n\n\n\nSent from my iPhone using Tapatalk\n\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1882442,"PostDate":1420854707,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Welcome and congrats <br><br>\nI sent my invites out to everyone at about 7.5 months out. My invite said where and when but directed them to our wedding website for TA info, prices, RSVP, and all other info for Mexico.   <br><br>\nWe made the RSVP date the same as the booking deadline from the travel agent. <br><br>\nAfter people paid their final Payment, about 2.5 months before the wedding, we sent a pre travel brochure which mimicked our webpage and had some extra info and each person got a luggage tag.  <br><br>\nThat's all I did -- so everyone we wanted to invite got an invite but only people who were 100% paid and coming got the pre travel package. We picked our resort in may and are marrying in less 2 weeks. We leave in 8 days <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> <br>\n[attachment=30366:ImageUploadedByTapatalk1420851012.730280.jpg]<br><br><br>\nSent from my iPhone using Tapatalk<br \/><a class='resized_img' rel='lightbox[1882442]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_01_2015\/post-277873-142085110526.jpg\" title=\"ImageUploadedByTapatalk1420851105.339686.jpg - Size: 224.45KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_01_2015\/post-277873-142085110526.jpg\" class='bbc_img linked-image' alt=\"ImageUploadedByTapatalk1420851105.339686.jpg\" \/><\/a>\n\n<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399432202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"209.91.107.234","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78577,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"20ed0e8f1c3ff679a98aad4e26ce29fa","RawContent":"Congratulations and welcome to the board. \n\n\nI am also getting married in July. I sent my  invites out in the month of September, since my TA could only gurantee prices and rooms until mid November. \n\nI decided to make a passport type invatation, it included everything my guest would need to know about Mexico, the resort, booking information etc, I also had my website link on the information sheet. The feed back I got was that people loved having all the information up front so there were no suprises. \n\n\nHappy planning","Attachments":[],"Id":1882455,"PostDate":1420874064,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Congratulations and welcome to the board. <br><br>\nI am also getting married in July. I sent my  invites out in the month of September, since my TA could only gurantee prices and rooms until mid November. <br>\nI decided to make a passport type invatation, it included everything my guest would need to know about Mexico, the resort, booking information etc, I also had my website link on the information sheet. The feed back I got was that people loved having all the information up front so there were no suprises. <br><br>\nHappy planning  \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kcrosby86@msn.com","IpAddress":"142.179.243.111","GroupId":40,"GroupName":"Jr. Member","JoinDate":1398833231,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Kayla88","Id":277780,"Name":"Kayla88","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.139.45.237","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78577,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"95268314ecac81d90f2483cc05b5dfb9","RawContent":"Hola! Sent out ours in Sept. for our June weddings. Our families are well low on funds hmm hmm ;) so we had to give lots of notice.\n\n\nTake your guests needs into consideration and mail it based on that; that&#039;s my advice.","Attachments":[],"Id":1882497,"PostDate":1420949234,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hola! Sent out ours in Sept. for our June weddings. Our families are well low on funds hmm hmm <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/> so we had to give lots of notice.<br><br>\nTake your guests needs into consideration and mail it based on that; that's my advice.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lisananth@yahoo.com","IpAddress":"166.137.101.169","GroupId":40,"GroupName":"Jr. Member","JoinDate":1401140033,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278120.jpg?_r=1421810202","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"LisaAnthonyPoppy","Id":278120,"Name":"LisaAnthonyPoppy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"198.163.47.9","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78577,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f9aeb97822c5cd99e762692e11783700","RawContent":"&lt;p&gt;@[member=\"hannahlf11\"]&lt;\/p&gt;\n&lt;p&gt;My intention is to send invites about 8 months in advance. &amp;nbsp;I&#039;m only including the basic info (where &amp;amp; when) and directing them to our wedding website and our travel agent for additional info. &amp;nbsp;I&#039;m going to wait until the booking deadline has passed before sending our pre-travel mailer, because then I&#039;ll know how many people are coming (give or take a few tragglers).&lt;\/p&gt;","Attachments":[],"Id":1882630,"PostDate":1421089869,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"279680\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/279680-hannahlf11\/' title='Member profile'><span itemprop=\"name\">hannahlf11<\/span><\/a><\/p>\n<p>My intention is to send invites about 8 months in advance. \u00a0I'm only including the basic info (where & when) and directing them to our wedding website and our travel agent for additional info. \u00a0I'm going to wait until the booking deadline has passed before sending our pre-travel mailer, because then I'll know how many people are coming (give or take a few tragglers).<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"slfehr@outlook.com","IpAddress":"24.114.26.10","GroupId":39,"GroupName":"Newbie","JoinDate":1420226577,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"pykx82","Id":281560,"Name":"pykx82","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.230.17.225","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78577,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4614e2ed526253693c8f68fb1682600d","RawContent":"&lt;p&gt;Thanks everyone!&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I guess we need to start customizing our &amp;nbsp;invites ASAP! Like I said, we sent out the \"save the date\" emails about a year in advance. That had the info needed to get in touch with the travel agent. We only invited close family and friends so they have been in touch with us on any questions they need.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I found some invites on weddingpaperdivas so I will probably just do those and get them out as soon as I can. The reason I&#039;ve been so confused is because most of our guests are booking the trip on their own because they found cheaper prices than our travel agent. So it has been pretty difficult to plan anything because I dont have an exact number going.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1884087,"PostDate":1422224305,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thanks everyone!\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I guess we need to start customizing our \u00a0invites ASAP! Like I said, we sent out the \"save the date\" emails about a year in advance. That had the info needed to get in touch with the travel agent. We only invited close family and friends so they have been in touch with us on any questions they need.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I found some invites on weddingpaperdivas so I will probably just do those and get them out as soon as I can. The reason I've been so confused is because most of our guests are booking the trip on their own because they found cheaper prices than our travel agent. So it has been pretty difficult to plan anything because I dont have an exact number going.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"hannahfarris4@yahoo.com","IpAddress":"108.230.30.121","GroupId":39,"GroupName":"Newbie","JoinDate":1409802442,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279680.jpg?_r=1432154147","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"hannahlf11","Id":279680,"Name":"hannahlf11","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.139.45.237","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78577,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b934767af4c9ac38aab00a060f3e2f47","RawContent":"And you won&#039;t be able to give a firm count for anything until your RSVP deadline, but you can have your vendors give you estimates based on your estimated guest count, and usually they will not need a final count until your wedding is a stone throws away. And as far as planning anything else non wedding oriented like an excursion you can usually plan those a month out from your trip with no problem.\n\n\nAn example of pre RSVP planning;\n\nI estimated to have about 30 guests. 10 to a table. I bought 3 table overlays months ago, figured if I had more guests (highly unlikely) I could just get another after RSVP deadline. So I found it not a problem to do what I could do in advance and my RSVP deadline is 3 months prior to wedding so I can finalize the totals in that time. \n\n\nIt looks like you have given yourself plenty of time to plan your details in between your RSVP date and your actual wedding date. \n\n\nHave fun :)","Attachments":[],"Id":1884101,"PostDate":1422234148,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                And you won't be able to give a firm count for anything until your RSVP deadline, but you can have your vendors give you estimates based on your estimated guest count, and usually they will not need a final count until your wedding is a stone throws away. And as far as planning anything else non wedding oriented like an excursion you can usually plan those a month out from your trip with no problem.<br><br>\nAn example of pre RSVP planning;<br>\nI estimated to have about 30 guests. 10 to a table. I bought 3 table overlays months ago, figured if I had more guests (highly unlikely) I could just get another after RSVP deadline. So I found it not a problem to do what I could do in advance and my RSVP deadline is 3 months prior to wedding so I can finalize the totals in that time. <br><br>\nIt looks like you have given yourself plenty of time to plan your details in between your RSVP date and your actual wedding date. <br><br>\nHave fun <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lisananth@yahoo.com","IpAddress":"166.137.101.169","GroupId":40,"GroupName":"Jr. Member","JoinDate":1401140033,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278120.jpg?_r=1421810202","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"LisaAnthonyPoppy","Id":278120,"Name":"LisaAnthonyPoppy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"216.99.65.83","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78577,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"96a59900d558998e34325e3064c22e90","RawContent":"&lt;p&gt;i will actually not be doing a save the date, and just sending an invitation come April, and directing everyone to our website! Our guest list are all very computer oriented, so it works for us!&lt;\/p&gt;","Attachments":[],"Id":1884339,"PostDate":1422388048,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>i will actually not be doing a save the date, and just sending an invitation come April, and directing everyone to our website! Our guest list are all very computer oriented, so it works for us!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"alison.hardy1@gmail.com","IpAddress":"216.99.65.83","GroupId":39,"GroupName":"Newbie","JoinDate":1422378323,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281894.jpg?_r=1422907392","PhotoWidth":200,"PhotoHeight":226,"PhotoType":"custom"},"FormattedName":"hardyali","Id":281894,"Name":"hardyali","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.9.77.196","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78577,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0e3ad622e1c36644e7a1b75d9d0d4048","RawContent":"&lt;p&gt;Welcome and congrats. It seems like a lot of people are sending their invitations out ahead of time. I got my invitations and RSVP cards done through Mixbook because they were having a 50% sale. My wedding is in April and I will be mailing out the invitations this week. (Yikes, I know.) I did a save-the-date email and mailed a save-the-date card in September with all our travel agent information and where we were staying at.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck!&lt;\/p&gt;","Attachments":[],"Id":1884522,"PostDate":1422493765,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome and congrats. It seems like a lot of people are sending their invitations out ahead of time. I got my invitations and RSVP cards done through Mixbook because they were having a 50% sale. My wedding is in April and I will be mailing out the invitations this week. (Yikes, I know.) I did a save-the-date email and mailed a save-the-date card in September with all our travel agent information and where we were staying at.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Good luck!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><strong>N&C<\/strong><\/p>\n<p><em>April 17, 2015<\/em><\/p>\n<p>Gran Caribe Real (Cancun, Mexico)<\/p>\n<p>Including Bride & Groom: 22 guests (19 adults & 3 children)","Email":"nancysoup@att.net","IpAddress":"216.23.195.134","GroupId":39,"GroupName":"Newbie","JoinDate":1411664662,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280004.jpg?_r=1412891058","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"hellosassypants","Id":280004,"Name":"hellosassypants","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"107.77.87.63","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78577,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ebe525633a04dbe2569561f1d7e00eab","RawContent":"We sent fornal STDs in the mail in July, which including the date, location and wedding website. We sent out invitations in the mail in mid-December with an RSVP date of two months prior to our May 16th wedding.","Attachments":[],"Id":1884527,"PostDate":1422495608,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We sent fornal STDs in the mail in July, which including the date, location and wedding website. We sent out invitations in the mail in mid-December with an RSVP date of two months prior to our May 16th wedding. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jhowe114@gmail.com","IpAddress":"38.98.131.98","GroupId":40,"GroupName":"Jr. Member","JoinDate":1402429989,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278395.jpg?_r=1421871115","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"JenniferH114","Id":278395,"Name":"JenniferH114","IsOnline":false}}],"Id":"78577","Title":"Invitation Help!","LastPostDate":1424316658},"Pages":{"TotalItems":13,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}