{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":19,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":2090,"MovedTo":null,"MovedOn":0,"FirstPostId":1847755,"Rating":0,"RatingHits":0,"Starter":{"Id":277783,"Name":"rachm7","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277783.jpg?_r=1400106010","PhotoWidth":200,"PhotoHeight":143,"PhotoType":"facebook"},"IsOnline":false},"StartDate":1398930038,"LastPoster":{"Id":283516,"Name":"priscilla31185","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1847755,"PostDate":1398930038,"PostContent":"Hi!! \u00a0 We are new to this site... We recently got engaged in Cancun Mexico, at Sun Palace, we wer...","Author":{"Signature":"<p>Rachael & Aaron<\/p>\n<p>Cancun April 2016<\/p>\n<p> <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wub.png' class='bbc_emoticon' alt=':wub:' \/>","Email":"rach_m7@hotmail.com","IpAddress":"83.104.233.6","GroupId":39,"GroupName":"Newbie","JoinDate":1398863648,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277783.jpg?_r=1400106010","PhotoWidth":200,"PhotoHeight":143,"PhotoType":"facebook"},"FormattedName":"rachm7","Id":277783,"Name":"rachm7","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"2.223.222.164","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76974,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a6599db6210f4304b78d200f193b852a","RawContent":"&lt;p&gt;&lt;span style=\"color:rgb(128,0,128);\"&gt;Hi!!&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"color:rgb(128,0,128);\"&gt;We are new to this site... We recently got engaged in Cancun Mexico, at Sun Palace, we were looking at going back there to get married but they won&#039;t allow children to attend the wedding and I have a baby nephew &amp;amp; 7 year old neice so have ruled this out. We are now considering Beach Palace ? Any Thoughts? We are struggling big time with communication with them, I don&#039;t get a response on email for days on end!! I had also considered the Royal as I believe they allow children to attend the wedding there even though its adults only. We like the hotel zone as that&#039;s where we know the beach was beautiful, we went to the Riveria Maya but didn&#039;t like the beach there at all (Moon palace we&amp;nbsp;visited for a day trip). Thank you!!&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1847755,"PostDate":1398930038,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span  style=\"color:rgb(128,0,128)\">Hi!!<\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"color:rgb(128,0,128)\">We are new to this site... We recently got engaged in Cancun Mexico, at Sun Palace, we were looking at going back there to get married but they won't allow children to attend the wedding and I have a baby nephew & 7 year old neice so have ruled this out. We are now considering Beach Palace ? Any Thoughts? We are struggling big time with communication with them, I don't get a response on email for days on end!! I had also considered the Royal as I believe they allow children to attend the wedding there even though its adults only. We like the hotel zone as that's where we know the beach was beautiful, we went to the Riveria Maya but didn't like the beach there at all (Moon palace we\u00a0visited for a day trip). Thank you!!<\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Rachael & Aaron<\/p>\n<p>Cancun April 2016<\/p>\n<p> <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wub.png' class='bbc_emoticon' alt=':wub:' \/>","Email":"rach_m7@hotmail.com","IpAddress":"83.104.233.6","GroupId":39,"GroupName":"Newbie","JoinDate":1398863648,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277783.jpg?_r=1400106010","PhotoWidth":200,"PhotoHeight":143,"PhotoType":"facebook"},"FormattedName":"rachm7","Id":277783,"Name":"rachm7","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"63.119.183.254","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76974,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"ed46e6a4c4287ccedd66176956be373a","RawContent":"Congratulations......I attended a wedding July 2013 at Moon Palace. It was beautiful and that is also where my FI proposed to me. Moon palace does allow children and the resort credits were nice.\n\n\nGood luck and happy planning!","Attachments":[],"Id":1847786,"PostDate":1398954477,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Congratulations......I attended a wedding July 2013 at Moon Palace. It was beautiful and that is also where my FI proposed to me. Moon palace does allow children and the resort credits were nice.<br><br><br>Good luck and happy planning!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"letitia_leaks@verizon.net","IpAddress":"63.119.183.254","GroupId":40,"GroupName":"Jr. Member","JoinDate":1397070122,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277534.jpg?_r=1397086760","PhotoWidth":160,"PhotoHeight":160,"PhotoType":"custom"},"FormattedName":"FutureMrsGlover","Id":277534,"Name":"FutureMrsGlover","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"187.153.62.113","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76974,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"344f32ac19aaa1b51db0153af88a9a24","RawContent":"&lt;p&gt;Congrats @[member=\"rachm7\"] on your engagement here in Cancun! It&#039;s awesome that you loved Mexico so much that you now also want to come back again for your big day...yay!!! :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;You&#039;re right that there is a HUGE difference between the beaches at Moon Palace and Beach Palace. Because the water is very still by Moon you end up getting a lot of seaweed all year long and the water is darker.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Of course anything like Beach Palace right here in the Cancun hotel zone is gorgeous but there ARE other incredible family friendly resorts out there in the Riviera Maya like &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.645588758813427.1073741896.116179758420999&amp;amp;type=3&#039;&gt;Grand Palladium Riviera Maya&lt;\/a&gt;&amp;nbsp;or even something in Playacar like &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.520886744616963.1073741830.116179758420999&amp;amp;type=3&#039;&gt;Sandos Playacar&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Below are a few photos but feel free to do some beach scouting through some of the various weddings we&#039;ve shot on our &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bicoastalimages.com&#039;&gt;website&lt;\/a&gt; or &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.facebook.com\/bicoastalimages&#039;&gt;Facebook page&lt;\/a&gt;.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Happy planning!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;u&gt;&lt;strong&gt;&lt;span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\"&gt;Palace Resort Colin Cowie Wedding \"Sunrise Collection\"&lt;\/span&gt;&lt;\/strong&gt;&lt;\/u&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;a  class=\"bbc_url\" href=\"http:\/\/s598.photobucket.com\/user\/bicoastalimages\/media\/Destination%20Weddings\/DSC_5770-9logo.jpg.html\"&gt;&lt;img src=\"http:\/\/i598.photobucket.com\/albums\/tt68\/bicoastalimages\/Destination%20Weddings\/DSC_5770-9logo.jpg\" alt=\"DSC_5770-9logo.jpg\"&gt;&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;a  class=\"bbc_url\" href=\"http:\/\/s598.photobucket.com\/user\/bicoastalimages\/media\/Destination%20Weddings\/DSC_5768-8logo.jpg.html\"&gt;&lt;img src=\"http:\/\/i598.photobucket.com\/albums\/tt68\/bicoastalimages\/Destination%20Weddings\/DSC_5768-8logo.jpg\" alt=\"DSC_5768-8logo.jpg\"&gt;&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;a  class=\"bbc_url\" href=\"http:\/\/s598.photobucket.com\/user\/bicoastalimages\/media\/Destination%20Weddings\/DSC_5755-6logo.jpg.html\"&gt;&lt;img src=\"http:\/\/i598.photobucket.com\/albums\/tt68\/bicoastalimages\/Destination%20Weddings\/DSC_5755-6logo.jpg\" alt=\"DSC_5755-6logo.jpg\"&gt;&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;u&gt;&lt;strong&gt;Grand Palladium Riviera Maya&lt;\/strong&gt;&lt;\/u&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;a  class=\"bbc_url\" href=\"http:\/\/s598.photobucket.com\/user\/bicoastalimages\/media\/Destination%20Weddings\/DSC_6384-229copy.jpg.html\"&gt;&lt;img src=\"http:\/\/i598.photobucket.com\/albums\/tt68\/bicoastalimages\/Destination%20Weddings\/DSC_6384-229copy.jpg\" alt=\"DSC_6384-229copy.jpg\"&gt;&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;a  class=\"bbc_url\" href=\"http:\/\/s598.photobucket.com\/user\/bicoastalimages\/media\/Destination%20Weddings\/DSC_6693-358acopy.jpg.html\"&gt;&lt;img src=\"http:\/\/i598.photobucket.com\/albums\/tt68\/bicoastalimages\/Destination%20Weddings\/DSC_6693-358acopy.jpg\" alt=\"DSC_6693-358acopy.jpg\"&gt;&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;a  class=\"bbc_url\" href=\"http:\/\/s598.photobucket.com\/user\/bicoastalimages\/media\/Destination%20Weddings\/DSC_1042-310copy.jpg.html\"&gt;&lt;img src=\"http:\/\/i598.photobucket.com\/albums\/tt68\/bicoastalimages\/Destination%20Weddings\/DSC_1042-310copy.jpg\" alt=\"DSC_1042-310copy.jpg\"&gt;&lt;\/a&gt;&lt;\/p&gt;","Attachments":[],"Id":1847787,"PostDate":1398954894,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats @<a hovercard-ref=\"member\" hovercard-id=\"277783\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/277783-rachm7\/' title='Member profile'><span itemprop=\"name\">rachm7<\/span><\/a> on your engagement here in Cancun! It's awesome that you loved Mexico so much that you now also want to come back again for your big day...yay!!! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>You're right that there is a HUGE difference between the beaches at Moon Palace and Beach Palace. Because the water is very still by Moon you end up getting a lot of seaweed all year long and the water is darker.<\/p>\n<p>\u00a0<\/p>\n<p>Of course anything like Beach Palace right here in the Cancun hotel zone is gorgeous but there ARE other incredible family friendly resorts out there in the Riviera Maya like <a href='https:\/\/www.facebook.com\/media\/set\/?set=a.645588758813427.1073741896.116179758420999&type=3' class='bbc_url' title='External link' rel='nofollow external'>Grand Palladium Riviera Maya<\/a>\u00a0or even something in Playacar like <a href='https:\/\/www.facebook.com\/media\/set\/?set=a.520886744616963.1073741830.116179758420999&type=3' class='bbc_url' title='External link' rel='nofollow external'>Sandos Playacar<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Below are a few photos but feel free to do some beach scouting through some of the various weddings we've shot on our <a href='http:\/\/www.bicoastalimages.com' class='bbc_url' title='External link' rel='nofollow external'>website<\/a> or <a href='http:\/\/www.facebook.com\/bicoastalimages' class='bbc_url' title='External link' rel='nofollow external'>Facebook page<\/a>.<\/p>\n<p>\u00a0<\/p>\n<p>Happy planning!<\/p>\n<p>\u00a0<\/p>\n<p><u><strong><span  style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif\">Palace Resort Colin Cowie Wedding \"Sunrise Collection\"<\/span><\/strong><\/u><\/p>\n<p><a href='http:\/\/s598.photobucket.com\/user\/bicoastalimages\/media\/Destination%20Weddings\/DSC_5770-9logo.jpg.html' class='bbc_url' title='External link' rel='nofollow external'><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i598.photobucket.com\/albums\/tt68\/bicoastalimages\/Destination%20Weddings\/DSC_5770-9logo.jpg\" alt=\"DSC_5770-9logo.jpg\"><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p><a href='http:\/\/s598.photobucket.com\/user\/bicoastalimages\/media\/Destination%20Weddings\/DSC_5768-8logo.jpg.html' class='bbc_url' title='External link' rel='nofollow external'><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i598.photobucket.com\/albums\/tt68\/bicoastalimages\/Destination%20Weddings\/DSC_5768-8logo.jpg\" alt=\"DSC_5768-8logo.jpg\"><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p><a href='http:\/\/s598.photobucket.com\/user\/bicoastalimages\/media\/Destination%20Weddings\/DSC_5755-6logo.jpg.html' class='bbc_url' title='External link' rel='nofollow external'><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i598.photobucket.com\/albums\/tt68\/bicoastalimages\/Destination%20Weddings\/DSC_5755-6logo.jpg\" alt=\"DSC_5755-6logo.jpg\"><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p><u><strong>Grand Palladium Riviera Maya<\/strong><\/u><\/p>\n<p><a href='http:\/\/s598.photobucket.com\/user\/bicoastalimages\/media\/Destination%20Weddings\/DSC_6384-229copy.jpg.html' class='bbc_url' title='External link' rel='nofollow external'><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i598.photobucket.com\/albums\/tt68\/bicoastalimages\/Destination%20Weddings\/DSC_6384-229copy.jpg\" alt=\"DSC_6384-229copy.jpg\"><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p><a href='http:\/\/s598.photobucket.com\/user\/bicoastalimages\/media\/Destination%20Weddings\/DSC_6693-358acopy.jpg.html' class='bbc_url' title='External link' rel='nofollow external'><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i598.photobucket.com\/albums\/tt68\/bicoastalimages\/Destination%20Weddings\/DSC_6693-358acopy.jpg\" alt=\"DSC_6693-358acopy.jpg\"><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p><a href='http:\/\/s598.photobucket.com\/user\/bicoastalimages\/media\/Destination%20Weddings\/DSC_1042-310copy.jpg.html' class='bbc_url' title='External link' rel='nofollow external'><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i598.photobucket.com\/albums\/tt68\/bicoastalimages\/Destination%20Weddings\/DSC_1042-310copy.jpg\" alt=\"DSC_1042-310copy.jpg\"><\/span><\/a><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bicoastalimages@gmail.com","IpAddress":"187.153.57.154","GroupId":44,"GroupName":"Vendor","JoinDate":1328011268,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250764.jpg?_r=1392999583","PhotoWidth":200,"PhotoHeight":160,"PhotoType":"custom"},"FormattedName":"bicoastalimages","Id":250764,"Name":"bicoastalimages","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"206.223.185.220","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76974,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"0f773873fad1b332429075a0ebbf77b8","RawContent":"&lt;p&gt;@[member=\"rachm7\"] Congrats on your engagement and welcome to BDW! You will find a ton of information here that will help you through the planning process! And everyone is more than willing to share!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;One thing that might help you out is the resort reviews tab at the top. It covers if not all, then probably most of the resorts between Cancun and the Riviera Maya! lol And the Palace resorts are very popular so I know there are reviews there that will help with your decision.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I see you&#039;re a UK bride to be&amp;nbsp;- do you have a travel agent yet? That will be another resource that will help with your location decision. The resort credits that @[member=\"FutureMrsGlover\"] mentioned I believe are still available to you but I don&#039;t believe on the scale that are available in the US. They do their room and flight bookings differently in the US than in Canada and the UK. We are much more on all inclusive package deals! Yay us!! lol&amp;nbsp; Still, again that&#039;s something that your TA will be able to help you with as to what will be most beneficial to you. As well, a TA will take a lot of the stress off you and your guests&#039; inquiries.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Best of luck and happy planning!&lt;\/p&gt;","Attachments":[],"Id":1847789,"PostDate":1398955501,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"277783\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/277783-rachm7\/' title='Member profile'><span itemprop=\"name\">rachm7<\/span><\/a> Congrats on your engagement and welcome to BDW! You will find a ton of information here that will help you through the planning process! And everyone is more than willing to share!<\/p>\n<p>\u00a0<\/p>\n<p>One thing that might help you out is the resort reviews tab at the top. It covers if not all, then probably most of the resorts between Cancun and the Riviera Maya! lol And the Palace resorts are very popular so I know there are reviews there that will help with your decision.<\/p>\n<p>\u00a0<\/p>\n<p>I see you're a UK bride to be\u00a0- do you have a travel agent yet? That will be another resource that will help with your location decision. The resort credits that @<a hovercard-ref=\"member\" hovercard-id=\"277534\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/277534-futuremrsglover\/' title='Member profile'><span itemprop=\"name\">FutureMrsGlover<\/span><\/a> mentioned I believe are still available to you but I don't believe on the scale that are available in the US. They do their room and flight bookings differently in the US than in Canada and the UK. We are much more on all inclusive package deals! Yay us!! lol\u00a0 Still, again that's something that your TA will be able to help you with as to what will be most beneficial to you. As well, a TA will take a lot of the stress off you and your guests' inquiries.<\/p>\n<p>\u00a0<\/p>\n<p>Best of luck and happy planning!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283462599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"2.127.43.179","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76974,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ac685d4085211b1ae16098c9d360d430","RawContent":"&lt;p&gt;Hi @Mention&lt;\/p&gt;\n&lt;p&gt;We don&#039;t have a travel agent in the UK yet no I will look into it though now you have suggested it!&lt;\/p&gt;\n&lt;p&gt;I&#039;m finding it very difficult communicating with Beach Palace and starting to look at other resorts, they just don&#039;t seem to get back to you! I&#039;ve been waiting for over a week and still nothing. I&#039;m consider the Royal Cancun, any thoughts on that? I know it is more expensive but guests can stay at the Gran Caribe which is reasonably priced, and I have contacted them to ask if&amp;nbsp;we&amp;nbsp;can have children attend the wedding at&amp;nbsp;The Royal, don&#039;t know if anyone knows? &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1848028,"PostDate":1399065140,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi @Mention<\/p>\n<p>We don't have a travel agent in the UK yet no I will look into it though now you have suggested it!<\/p>\n<p>I'm finding it very difficult communicating with Beach Palace and starting to look at other resorts, they just don't seem to get back to you! I've been waiting for over a week and still nothing. I'm consider the Royal Cancun, any thoughts on that? I know it is more expensive but guests can stay at the Gran Caribe which is reasonably priced, and I have contacted them to ask if\u00a0we\u00a0can have children attend the wedding at\u00a0The Royal, don't know if anyone knows? \u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Rachael & Aaron<\/p>\n<p>Cancun April 2016<\/p>\n<p> <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wub.png' class='bbc_emoticon' alt=':wub:' \/>","Email":"rach_m7@hotmail.com","IpAddress":"83.104.233.6","GroupId":39,"GroupName":"Newbie","JoinDate":1398863648,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277783.jpg?_r=1400106010","PhotoWidth":200,"PhotoHeight":143,"PhotoType":"facebook"},"FormattedName":"rachm7","Id":277783,"Name":"rachm7","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.77.36.17","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76974,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"223a8b94b2f44fa936fbfc092e651bc3","RawContent":"&lt;p&gt;Congrats on your Sun Palace Engagement, rachm7!!! and welcome to our forum community :) as you can see, there&#039;s lots of great advice, info and support here to help you with your planning decisions.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Wishing you all the best with your plans, and that it&#039;s everything you envision - or Even Better!!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;some magical wedding \"moments that matter\" captured at the NOW Jade....with more at the album link here: &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10152371453279487.1073741888.18683524486&amp;amp;type=3&#039;&gt;NOW Jade Wedding&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-b-ord.xx.fbcdn.net\/hphotos-prn2\/t1.0-9\/1794686_10152371454089487_9026781559561669334_n.jpg\" alt=\"1794686_10152371454089487_90267815595616\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Cheers! team MTM :)&lt;\/p&gt;","Attachments":[],"Id":1848366,"PostDate":1399340860,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats on your Sun Palace Engagement, rachm7!!! and welcome to our forum community <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> as you can see, there's lots of great advice, info and support here to help you with your planning decisions.<\/p>\n<p>\u00a0<\/p>\n<p>Wishing you all the best with your plans, and that it's everything you envision - or Even Better!!!<\/p>\n<p>\u00a0<\/p>\n<p>some magical wedding \"moments that matter\" captured at the NOW Jade....with more at the album link here: <a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10152371453279487.1073741888.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>NOW Jade Wedding<\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-b-ord.xx.fbcdn.net\/hphotos-prn2\/t1.0-9\/1794686_10152371454089487_9026781559561669334_n.jpg\" alt=\"1794686_10152371454089487_90267815595616\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>Cheers! team MTM <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280214260,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.119.162.30","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76974,"EditedBy":"<strong>Edited by tygrrlily, 07 May 2014 - 01:58 AM.<\/strong>","EditDate":1399427888,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2ad6d07ecc4f772bc558cac79bcb3540","RawContent":"&lt;p&gt;Hello, I&#039;m getting married at Beach Palace! Biggest recommendation is definitely to get a travel agent. I find the resort does respond quicker when it is through the travel agent. However, I&#039;ve also been in contact with Alejandro Ulibarri who is the Canada Sales Rep, and he replies very quickly. This is his email: aulibarri @ palace resorts . com (no spaces). Maybe you can email him and he will forward it to the UK sales rep. Good luck with the planning!&lt;\/p&gt;","Attachments":[],"Id":1848551,"PostDate":1399427834,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello, I'm getting married at Beach Palace! Biggest recommendation is definitely to get a travel agent. I find the resort does respond quicker when it is through the travel agent. However, I've also been in contact with Alejandro Ulibarri who is the Canada Sales Rep, and he replies very quickly. This is his email: aulibarri @ palace resorts . com (no spaces). Maybe you can email him and he will forward it to the UK sales rep. Good luck with the planning!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Married December 19, 2014 at Beach Palace Resort in Cancun, Mexico<\/p>\n<p>\u00a0<\/p>\n<p>My Planning Thread - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/'>http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>My Wedding Review<\/p>\n<p>Part 1 - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881197'>http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881197<\/a><\/p>\n<p>Part 2 - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881590'>http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881590<\/a><\/p>\n<p>Part 3 - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881861'>http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881861<\/a><\/p>\n<p>\u00a0","Email":"lilyluu83@gmail.com","IpAddress":"174.119.162.30","GroupId":3,"GroupName":"Member","JoinDate":1395612948,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277296.jpg?_r=1421643766","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"tygrrlily","Id":277296,"Name":"tygrrlily","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"96.46.112.169","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76974,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"a1798ab08824ba3e19be68cf6ea7dcf8","RawContent":"2016 seems so far away! I can hardly wait for mine in April 2015. At least you&#039;ll have plenty of time to find the best option for you! \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1849575,"PostDate":1399779866,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                2016 seems so far away! I can hardly wait for mine in April 2015. At least you'll have plenty of time to find the best option for you! <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kathyandethan@gmail.com","IpAddress":"96.46.112.169","GroupId":40,"GroupName":"Jr. Member","JoinDate":1399278140,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277838.jpg?_r=1399427613","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"KathyandEthan","Id":277838,"Name":"KathyandEthan","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.65.17.253","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76974,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5164ba46b3b0ba77bac1ea82432c3958","RawContent":"We are also looking at April 2016 but trying to decide between Cancun and Puerto Vallarta. We are coming from Alberta Canada and want to get a good price for our guests.","Attachments":[],"Id":1850922,"PostDate":1400374056,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We are also looking at April 2016 but trying to decide between Cancun and Puerto Vallarta. We are coming from Alberta Canada and want to get a good price for our guests. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kdevries@shaw.ca","IpAddress":"50.65.17.253","GroupId":39,"GroupName":"Newbie","JoinDate":1359780644,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265520.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Kardev","Id":265520,"Name":"Kardev","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.114.24.237","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76974,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"12fafc844f885f9a83b665f1ab739080","RawContent":"[quote name=\"Kardev\" post=\"1850922\" timestamp=\"1400370456\"]\nWe are also looking at April 2016 but trying to decide between Cancun and Puerto Vallarta. We are coming from Alberta Canada and want to get a good price for our guests.[\/quote]There are a bunch of us from Alberta! I would suggest reaching out to a great TA who can help you narrow down some choices... Mine has been fantastic planning so far out, you may want to call\/email her! Laurielee.ca \n\n\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1850934,"PostDate":1400378745,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Kardev, on 18 May 2014 - 12:47 AM, said:<\/p><div class='blockquote'><div class='quote'><p>We are also looking at April 2016 but trying to decide between Cancun and Puerto Vallarta. We are coming from Alberta Canada and want to get a good price for our guests.<\/p><\/div><\/div>\n<br>\nThere are a bunch of us from Alberta! I would suggest reaching out to a great TA who can help you narrow down some choices... Mine has been fantastic planning so far out, you may want to call\/email her! Laurielee.ca <br><br><br><br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kmkwedding2016@gmail.com","IpAddress":"70.72.195.234","GroupId":38,"GroupName":"Moderators","JoinDate":1390260208,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kmk2016","Id":276231,"Name":"kmk2016","IsOnline":false}}],"Id":"76974","Title":"Bride To Be Cancun April 2016 !","LastPostDate":1435173433},"Pages":{"TotalItems":19,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
