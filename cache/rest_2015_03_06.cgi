{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":true,"CanReply":true,"CanFollow":true,"TotalPosts":25,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":856,"MovedTo":null,"MovedOn":0,"FirstPostId":1884463,"Rating":0,"RatingHits":0,"Starter":{"Id":281804,"Name":"lilumpkin","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1422441586,"LastPoster":{"Id":230711,"Name":"Moments That Matter","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1884463,"PostDate":1422441586,"PostContent":"Hi. I am having a destination wedding. I will be in white of course and FH in khaki shorts and wh...","Author":{"Signature":"","Email":"hedoeslovecats@gmail.com","IpAddress":"208.76.203.236","GroupId":39,"GroupName":"Newbie","JoinDate":1421742025,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"lilumpkin","Id":281804,"Name":"lilumpkin","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.76.203.236","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":false,"CanLike":true,"TopicId":78696,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7e10123a8afa156ceb33bf04e3810641","RawContent":"Hi. I am having a destination wedding. I will be in white of course and FH in khaki shorts and white shirt. I originally thought to have guest wear khaki shorts and white tips since ot looks so clean in photos on beach.I am getting feedback from guest that they would prefer to wear colored sundresses instead. I want everyone to be happy and excited more than pics looking a certain way. Any color or ideas? Pastels?? Or should I be bride and make them do it.","Attachments":[],"Id":1884463,"PostDate":1422441586,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi. I am having a destination wedding. I will be in white of course and FH in khaki shorts and white shirt. I originally thought to have guest wear khaki shorts and white tips since ot looks so clean in photos on beach.I am getting feedback from guest that they would prefer to wear colored sundresses instead. I want everyone to be happy and excited more than pics looking a certain way. Any color or ideas? Pastels?? Or should I be bride and make them do it. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"hedoeslovecats@gmail.com","IpAddress":"208.76.203.236","GroupId":39,"GroupName":"Newbie","JoinDate":1421742025,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"lilumpkin","Id":281804,"Name":"lilumpkin","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.183.193.17","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":78696,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":4,"IsLiked":false,"PostKey":"c251263e9c15aaa3e881d01bf9b921da","RawContent":"&lt;p&gt;Congrats!!! Wedding planning is exciting!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I think its nice to have your bridal party all matchy matchy but I personally think you should let your guest wear whatever. You want them to be comfortable! It will be hot and every person has different comfort levels. As well as some people cant pull off certain colours etc.&amp;nbsp; :)&lt;\/p&gt;","Attachments":[],"Id":1884468,"PostDate":1422443096,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats!!! Wedding planning is exciting!<\/p>\n<p>\u00a0<\/p>\n<p>I think its nice to have your bridal party all matchy matchy but I personally think you should let your guest wear whatever. You want them to be comfortable! It will be hot and every person has different comfort levels. As well as some people cant pull off certain colours etc.\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"briannehillier@gmail.com","IpAddress":"173.183.193.17","GroupId":39,"GroupName":"Newbie","JoinDate":1422346922,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281895.jpg?_r=1422484746","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"breezie","Id":281895,"Name":"breezie","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"143.58.161.6","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":78696,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"91676bf6debb8be32c31e30147c90db8","RawContent":"&lt;p&gt;@[member=\"lilumpkin\"] - We are not requiring our guests to wear anything in particular. More of the guys have asked us what we would like them to wear, and we are fine with polos or short sleeve button-ups and a nice pair of shorts or pants. (Though I doubt many people would wear pants.) Ladies are easier because most will wear dresses. We want our guests to be comfortable. If they are happy, then we are happy. :)&lt;\/p&gt;","Attachments":[],"Id":1884508,"PostDate":1422454364,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"281804\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281804-lilumpkin\/' title='Member profile'><span itemprop=\"name\">lilumpkin<\/span><\/a> - We are not requiring our guests to wear anything in particular. More of the guys have asked us what we would like them to wear, and we are fine with polos or short sleeve button-ups and a nice pair of shorts or pants. (Though I doubt many people would wear pants.) Ladies are easier because most will wear dresses. We want our guests to be comfortable. If they are happy, then we are happy. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jhowe114@gmail.com","IpAddress":"38.98.131.98","GroupId":39,"GroupName":"Newbie","JoinDate":1402397589,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278395.jpg?_r=1421871115","PhotoWidth":200,"PhotoHeight":285,"PhotoType":"custom"},"FormattedName":"JenniferH114","Id":278395,"Name":"JenniferH114","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.139.45.237","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":78696,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"38abfafc0d5891fee0c6212109890a46","RawContent":"I always get a kick out of this topic bc I&#039;ve never been told what to wear to weddings  and I&#039;ve never heard any family\/friend brides discuss guests attire aside from DW brides on here. Reminds me of like uniforms. My man in me dancing in identical outfits hahaha ok I&#039;ll stop. Sorry I mean well. Just in need of a laugh!","Attachments":[],"Id":1884531,"PostDate":1422464427,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I always get a kick out of this topic bc I've never been told what to wear to weddings  and I've never heard any family\/friend brides discuss guests attire aside from DW brides on here. Reminds me of like uniforms. My man in me dancing in identical outfits hahaha ok I'll stop. Sorry I mean well. Just in need of a laugh! \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lisananth@yahoo.com","IpAddress":"166.137.101.169","GroupId":40,"GroupName":"Jr. Member","JoinDate":1401107633,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278120.jpg?_r=1421810202","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"LisaAnthonyPoppy","Id":278120,"Name":"LisaAnthonyPoppy","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.41.59","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":78696,"EditedBy":"<strong>Edited by calgarybride2015, 28 January 2015 - 05:05 PM.<\/strong>","EditDate":1422464703,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"bea691b8fbad5f74af7c3bb3424d41af","RawContent":"I also don&#039;t get the whole thing of dictating what they wear. We just asked for no swim suits and for those who wanted more we said anything you&#039;d wear to a nice restaurant. Our men wore shorts so of course that was ok for our guests. Most people have brains enough to know what is acceptable or not.    Thinking back though we had quite a few of the older men in pants. They must have been dying as it was hotter than hell out. Lol. \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1884533,"PostDate":1422464631,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I also don't get the whole thing of dictating what they wear. We just asked for no swim suits and for those who wanted more we said anything you'd wear to a nice restaurant. Our men wore shorts so of course that was ok for our guests. Most people have brains enough to know what is acceptable or not.    Thinking back though we had quite a few of the older men in pants. They must have been dying as it was hotter than hell out. Lol. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399399802,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.139.45.237","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":78696,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f3a9a4f624484c3d829d381af342bc2e","RawContent":"I guess I should say \"my man and me\" not \"my man in me\" Hahahaha well I guess I got a laugh after all! \n@[member=\"calgarybride2015\"] hey what time of day was your ceremony? Can you remember how it felt once the sunset? Ive been quite a few times but it&#039;s been almost 3 years n I can&#039;t remember.","Attachments":[],"Id":1884540,"PostDate":1422471224,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I guess I should say \"my man and me\" not \"my man in me\" Hahahaha well I guess I got a laugh after all! <br \/>@<a hovercard-ref=\"member\" hovercard-id=\"277873\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277873-calgarybride2015\/' title='Member profile'><span itemprop=\"name\">calgarybride2015<\/span><\/a> hey what time of day was your ceremony? Can you remember how it felt once the sunset? Ive been quite a few times but it's been almost 3 years n I can't remember. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lisananth@yahoo.com","IpAddress":"166.137.101.169","GroupId":40,"GroupName":"Jr. Member","JoinDate":1401107633,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278120.jpg?_r=1421810202","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"LisaAnthonyPoppy","Id":278120,"Name":"LisaAnthonyPoppy","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.41.59","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":78696,"EditedBy":"<strong>Edited by calgarybride2015, 28 January 2015 - 07:01 PM.<\/strong>","EditDate":1422471692,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"41c3598104c4381cfb3426ebcdad7f9e","RawContent":"[quote name=\"LisaAnthonyPoppy\" post=\"1884540\" timestamp=\"1422500024\"]\nI guess I should say \"my man and me\" not \"my man in me\" Hahahaha well I guess I got a laugh after all!\n@[member=\"calgarybride2015\"] hey what time of day was your ceremony? Can you remember how it felt once the sunset? Ive been quite a few times but it&#039;s been almost 3 years n I can&#039;t remember.[\/quote]\nI did my ceremony at 3pm.   I had planned to do it at 330pm but I was worried if they ran late starting that we wouldn&#039;t have enough time to get our photos in before the sun set at 530pm.      We definately had enough time, but you know Murphy&#039;s Law. Honestly though, even at 330pm and 400pm it was still as hot as heck and sunny!\n\nWe were in the palapa when the sun set -- there was no air flow in there once the wind died down, so we were pretty hot.\n\nSo to be honest, it was hot the entire night, if it wasn&#039;t for the breeze off the ocean we would have died.   Sorry I am really no help.\n\nEdit: I did bring cardigans to Mexico just in case and didn&#039;t use them. I was never cold.","Attachments":[],"Id":1884542,"PostDate":1422471483,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>LisaAnthonyPoppy, on 28 January 2015 - 06:53 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>I guess I should say \"my man and me\" not \"my man in me\" Hahahaha well I guess I got a laugh after all!<br>\n@<a hovercard-ref=\"member\" hovercard-id=\"277873\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277873-calgarybride2015\/' title='Member profile'><span itemprop=\"name\">calgarybride2015<\/span><\/a> hey what time of day was your ceremony? Can you remember how it felt once the sunset? Ive been quite a few times but it's been almost 3 years n I can't remember.<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>I did my ceremony at 3pm. \u00a0 I had planned to do it at 330pm but I was worried if they ran late starting that we wouldn't have enough time to get our photos in before the sun set at 530pm. \u00a0 \u00a0 \u00a0We definately had enough time, but you know Murphy's Law. Honestly though, even at 330pm and 400pm it was still as hot as heck and sunny!<\/p>\n<p>\u00a0<\/p>\n<p>We were in the palapa when the sun set -- there was no air flow in there once the wind died down, so we were pretty hot.<\/p>\n<p>\u00a0<\/p>\n<p>So to be honest, it was hot the entire night, if it wasn't for the breeze off the ocean we would have died. \u00a0 Sorry I am really no help.<\/p>\n<p>\u00a0<\/p>\n<p>Edit: I did bring cardigans to Mexico just in case and didn't use them. I was never cold.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399399802,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.139.45.237","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":78696,"EditedBy":"<strong>Edited by LisaAnthonyPoppy, 28 January 2015 - 07:32 PM.<\/strong>","EditDate":1422473565,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"afaccc004e11e5112783120ee5b9b77e","RawContent":"Well that isn&#039;t what I wanted to hear :\/we are getting married in June at 7pm and the kid and the husband r gonna be hot in their tux and bow ties.","Attachments":[],"Id":1884546,"PostDate":1422473427,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Well that isn't what I wanted to hear :\/we are getting married in June at 7pm and the kid and the husband r gonna be hot in their tux and bow ties.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lisananth@yahoo.com","IpAddress":"166.137.101.169","GroupId":40,"GroupName":"Jr. Member","JoinDate":1401107633,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278120.jpg?_r=1421810202","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"LisaAnthonyPoppy","Id":278120,"Name":"LisaAnthonyPoppy","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.41.59","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":78696,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4589c2db0b11fd526d32315c0a6ff1b3","RawContent":"[quote name=\"LisaAnthonyPoppy\" post=\"1884546\" timestamp=\"1422502227\"]\nWell that isn&#039;t what I wanted to hear :\/we are getting married in June at 7pm and the kid and the husband r gonna be hot in their tux and bow ties.[\/quote]\nI&#039;ve never traveled anywhere tropical during our summer time so I can&#039;t help there anyways ...\nI&#039;ve only traveled Jan-April.\n\nSorry :(","Attachments":[],"Id":1884547,"PostDate":1422473654,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>LisaAnthonyPoppy, on 28 January 2015 - 07:30 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Well that isn't what I wanted to hear :\/we are getting married in June at 7pm and the kid and the husband r gonna be hot in their tux and bow ties.<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>I've never traveled anywhere tropical during our summer time so I can't help there anyways ...<\/p>\n<p>I've only traveled Jan-April.<\/p>\n<p>\u00a0<\/p>\n<p>Sorry <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/sad.png' class='bbc_emoticon' alt=':(' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399399802,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.26.164.62","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":78696,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"85b82d181649a2143d209b61c107fc45","RawContent":"We are not having a wedding party, so essentially all of our guests are the wedding party. We are planning to ask everyone to wear blue because it will look nice in pictures. We will not be picky about what shade of blue.","Attachments":[],"Id":1884558,"PostDate":1422477397,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We are not having a wedding party, so essentially all of our guests are the wedding party. We are planning to ask everyone to wear blue because it will look nice in pictures. We will not be picky about what shade of blue.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lm_sprowl@hotmail.com","IpAddress":"75.26.164.62","GroupId":39,"GroupName":"Newbie","JoinDate":1418246631,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"cruisebride2016","Id":281378,"Name":"cruisebride2016","IsOnline":false}}],"Id":"78696","Title":"Beach Wedding Guest Attire","LastPostDate":1425449824},"Pages":{"TotalItems":25,"TotalPages":3,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":20},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
