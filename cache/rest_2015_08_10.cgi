.com\/image\/id\/70219\/width\/525\/height\/525\/flags\/LL\"&gt;","Attachments":[],"Id":1361,"PostDate":1158980545,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                i dont know why but it wont let me cut and paste- but here is mine- very very simple and classic!<br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i197.photobucket.com\/albums\/aa240\/carlymcmullen\/BDW%20Photos%20for%20Others\/nhptring.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/70219\/width\/525\/height\/525\/flags\/LL\"><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Destination Wedding Cabo San Lucas (3-29-07) Proud Momma to Avery (3-21-08) and Gracyn (10-12-10)<\/span><\/div><\/div>","Email":"nicolewinston21@gmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1149137100,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206738.gif?_r=0","PhotoWidth":75,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"NHPT","Id":206738,"Name":"NHPT","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cbc4f43c454729e80b962f7c7cfc4569","RawContent":"I don&#039;t have a close up of my ring, and I couldn&#039;t find the exact band on the Tacori website, but it&#039;s a Tacori platinum with 1.5ct round center and some pave and tooling on the sides.\n &lt;img src=\"http:\/\/i108.photobucket.com\/albums\/n26\/AQHARider\/myring.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n&lt;img src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/70222\/width\/525\/height\/525\/flags\/LL\"&gt;","Attachments":[],"Id":1390,"PostDate":1159043000,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I don't have a close up of my ring, and I couldn't find the exact band on the Tacori website, but it's a Tacori platinum with 1.5ct round center and some pave and tooling on the sides.<br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i108.photobucket.com\/albums\/n26\/AQHARider\/myring.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/70222\/width\/525\/height\/525\/flags\/LL\"><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"aqharider@hotmail.com","IpAddress":"76.20.179.61","GroupId":46,"GroupName":"VIP Member","JoinDate":1154391780,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/9\/9f\/9fd8e240_user-274-avatar?_r=0","PhotoWidth":180,"PhotoHeight":120,"PhotoType":"custom"},"FormattedName":"Sarah","Id":206770,"Name":"Sarah","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2ca542a3ffd14ac55bfbdd36eea39dd0","RawContent":"&lt;img src=\"http:\/\/img223.imageshack.us\/img223\/9746\/img0660cb1.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n here it is....","Attachments":[],"Id":5128,"PostDate":1162290941,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/img223.imageshack.us\/img223\/9746\/img0660cb1.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> here it is....\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i173.photobucket.com\/albums\/w80\/natalieberns\/wedding\/AMB_9144BW.jpg\">http:\/\/i173.photobucket.com\/albums\/w...AMB_9144BW.jpg<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;128\/st\/20071012\/e\/the+big+day\/dt\/-3\/k\/9829\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...9829\/event.png<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/www.natalieandkevinberns.com\">www.natalieandkevinberns.com<\/a><\/div><\/div>","Email":"natalieberns@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1153083360,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206763.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"TOESNTHESND","Id":206763,"Name":"TOESNTHESND","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"880ff9507662cf9acd52f06424e2060a","RawContent":"Ok I&#039;m going to try this! The ring is kind of blurry. It&#039;s platinum and the center is 2.2 cts and the sides have 3 diamonds on each side. I still can&#039;t find a band that looks good with it yet! &lt;img src=\"http:\/\/i116.photobucket.com\/albums\/o4\/gnat1711\/ring_00612.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;","Attachments":[],"Id":5353,"PostDate":1162425701,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Ok I'm going to try this! The ring is kind of blurry. It's platinum and the center is 2.2 cts and the sides have 3 diamonds on each side. I still can't find a band that looks good with it yet! <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i116.photobucket.com\/albums\/o4\/gnat1711\/ring_00612.jpg\" border=\"0\" alt=\"