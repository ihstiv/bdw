{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":1,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":0,"MovedTo":null,"MovedOn":0,"FirstPostId":1902229,"Rating":0,"RatingHits":0,"Starter":{"Id":284352,"Name":"dzamech","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":true},"StartDate":1439233138,"LastPoster":{"Id":284352,"Name":"dzamech","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":true},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1902229,"PostDate":1439233138,"PostContent":"Hi! I'm very new to this site, I am newly engaged and my fiance and I are planning a destination...","Author":{"Signature":"","Email":"dzamechansky@gmail.com","IpAddress":"98.109.118.103","GroupId":39,"GroupName":"Newbie","JoinDate":1439232775,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"dzamech","Id":284352,"Name":"dzamech","IsOnline":true}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"98.109.118.103","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79478,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ddc4f21dbebec5499674a5c36789df8b","RawContent":"&lt;p&gt;Hi! I&#039;m very new to this site, I am newly engaged and my fiance and I are planning a destination wedding in the Iberostar Rose hall, Jamaica in May 2016!! We were wondering if anyone has been there before, done their wedding there, seen anything or has any suggestions! We are so excited and there is so much to do! Any help would be appreciated!!\n\nThanks!\n\nDanielle&lt;\/p&gt;","Attachments":[],"Id":1902229,"PostDate":1439233138,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi! I'm very new to this site, I am newly engaged and my fiance and I are planning a destination wedding in the Iberostar Rose hall, Jamaica in May 2016!! We were wondering if anyone has been there before, done their wedding there, seen anything or has any suggestions! We are so excited and there is so much to do! Any help would be appreciated!!<br>\nThanks!<br>\nDanielle<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"dzamechansky@gmail.com","IpAddress":"98.109.118.103","GroupId":39,"GroupName":"Newbie","JoinDate":1439232775,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"dzamech","Id":284352,"Name":"dzamech","IsOnline":true}}],"Id":"79478","Title":"Iberostar Rose Hall Jamaica","LastPostDate":1439233138},"Pages":{"TotalItems":1,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
