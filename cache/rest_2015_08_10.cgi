33.gif?_r=0","PhotoWidth":83,"PhotoHeight":99,"PhotoType":"custom"},"FormattedName":"NABUMBAH","Id":206733,"Name":"NABUMBAH","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"bcc9fd5b6e76be948cca75aa412e8588","RawContent":"Go ahead, brag a little. show everyone your ering &amp;amp; wedding band.\n \n &lt;strong&gt;&lt;font color=\"DarkOrchid\"&gt;&lt;u&gt;12\/02\/08 - A few tips for this thread&lt;\/u&gt;\n \n - use the macro setting on your camera to take photos of your ring\n - create a free &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.photobucket.com\"&gt;photobucket&lt;\/a&gt; account to upload and share your photos\n - resize your photos if necessary so that it isn&#039;t so large that it resizes everyone screens\n - paste the entire IMG code into the thread to share your photos here\n \n Check out this thread for lots of help - &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/bestdestinationwedding.com\/forum\/t32313\"&gt;**Click Here for FAQ and BDW How to&#039;s**&lt;\/a&gt;&lt;\/font&gt;&lt;\/strong&gt;","Attachments":[],"Id":1342,"PostDate":1158964188,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Go ahead, brag a little. show everyone your ering & wedding band.<br \/> <br \/> <strong><font color=\"DarkOrchid\"><u>12\/02\/08 - A few tips for this thread<\/u><br \/> <br \/> - use the macro setting on your camera to take photos of your ring<br \/> - create a free <a href='http:\/\/www.photobucket.com' class='bbc_url' title='External link' rel='nofollow external'>photobucket<\/a> account to upload and share your photos<br \/> - resize your photos if necessary so that it isn't so large that it resizes everyone screens<br \/> - paste the entire IMG code into the thread to share your photos here<br \/> <br \/> Check out this thread for lots of help - <a href='http:\/\/bestdestinationwedding.com\/forum\/t32313' class='bbc_url' title='External link' rel='nofollow external'>**Click Here for FAQ and BDW How to's**<\/a><\/font><\/strong>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/jimkennedyphotography.com\/movienatasha\/\">3.24.07 cabo surf<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/nabumbah.livejournal.com\/\">year two.<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/20th.teamintraining.org\/?utm_source=google&utm_medium=cpc&utm_campaign=20th%2BAdwords\">i ran 26.2 - I helped save lives.<\/a><a data-ipb='nomediaparse' href=\"http:\/\/img.photobucket.com\/albums\/v396\/nabumbah\/family157-1.jpg\">http:\/\/img.photobucket.com\/albums\/v3...amily157-1.jpg<\/a><\/div><\/div>","Email":"nabumbah@gmail.com","IpAddress":"","GroupId":46,"GroupName":"VIP Member","JoinDate":1147466760,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206733.gif?_r=0","PhotoWidth":83,"PhotoHeight":99,"PhotoType":"custom"},"FormattedName":"NABUMBAH","Id":206733,"Name":"NABUMBAH","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":254,"EditedBy":"","E