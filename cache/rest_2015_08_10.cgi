{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":1,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":301,"MovedTo":null,"MovedOn":0,"FirstPostId":1898920,"Rating":0,"RatingHits":0,"Starter":{"Id":281796,"Name":"Sandraco8","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1434752298,"LastPoster":{"Id":281796,"Name":"Sandraco8","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":23,"Preview":{"Id":1898920,"PostDate":1434752298,"PostContent":"Hello ladies - I am hoping for some advice as we start to plan out our wedding weekend in Montego...","Author":{"Signature":"","Email":"sandra_co8@icloud.com","IpAddress":"50.162.188.193","GroupId":39,"GroupName":"Newbie","JoinDate":1421710870,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Sandraco8","Id":281796,"Name":"Sandraco8","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.196.44.37","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79293,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c8bcf96a753552c865dd81a91a3f69c8","RawContent":"Hello ladies - I am hoping for some advice as we start to plan out our wedding weekend in Montego Bay. I&#039;m searching for a fun, laid back place to listen to good music, dance and have some drinks with our guests in the evenings. The majority of the group is in their 30&#039;s so nothing in the Spring Break category ;)\n\n\nThe disco at our hotel is known for being pretty dead so I want to be prepared with some offsite options, possibly on the Hip Strip.\n\n\nThank you in advance for your help!\n\nSandra","Attachments":[],"Id":1898920,"PostDate":1434752298,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hello ladies - I am hoping for some advice as we start to plan out our wedding weekend in Montego Bay. I'm searching for a fun, laid back place to listen to good music, dance and have some drinks with our guests in the evenings. The majority of the group is in their 30's so nothing in the Spring Break category <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/><br><br>\nThe disco at our hotel is known for being pretty dead so I want to be prepared with some offsite options, possibly on the Hip Strip.<br><br>\nThank you in advance for your help!<br>\nSandra\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sandra_co8@icloud.com","IpAddress":"50.162.188.193","GroupId":39,"GroupName":"Newbie","JoinDate":1421710870,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Sandraco8","Id":281796,"Name":"Sandraco8","IsOnline":false}}],"Id":"79293","Title":"Montego Bay Nightlife","LastPostDate":1434752298},"Pages":{"TotalItems":1,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
