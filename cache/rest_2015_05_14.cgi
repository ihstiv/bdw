{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":8,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":681,"MovedTo":null,"MovedOn":0,"FirstPostId":1891082,"Rating":0,"RatingHits":0,"Starter":{"Id":282492,"Name":"AshleyNYC323","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282492.jpg?_r=1431603506","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"StartDate":1427507722,"LastPoster":{"Id":282492,"Name":"AshleyNYC323","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282492.jpg?_r=1431603506","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":22,"Preview":{"Id":1891082,"PostDate":1427507722,"PostContent":"Hi! \u00a0Curious to know if there are any 2016 Now Larimar couples out there ... \u00a0we are April 9. \u00a0 C...","Author":{"Signature":"","Email":"ashley225@gmail.com","IpAddress":"66.87.117.140","GroupId":39,"GroupName":"Newbie","JoinDate":1426945785,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282492.jpg?_r=1431603506","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"AshleyNYC323","Id":282492,"Name":"AshleyNYC323","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.65.74.207","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78994,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0a454e5df60a327340700dd77cf6a008","RawContent":"&lt;p&gt;Hi! &amp;nbsp;Curious to know if there are any 2016 Now Larimar couples out there ... &amp;nbsp;we are April 9. &amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Congrats to everyone!&lt;\/p&gt;","Attachments":[],"Id":1891082,"PostDate":1427507722,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi! \u00a0Curious to know if there are any 2016 Now Larimar couples out there ... \u00a0we are April 9. \u00a0<\/p>\n<p>Congrats to everyone!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ashley225@gmail.com","IpAddress":"66.87.117.140","GroupId":39,"GroupName":"Newbie","JoinDate":1426945785,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282492.jpg?_r=1431603506","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"AshleyNYC323","Id":282492,"Name":"AshleyNYC323","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"216.99.65.82","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78994,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"e6b882f311eafc016f4a55887b84f02e","RawContent":"&lt;p&gt;Us! We are traveling the Feb. 13-20th with our wedding on the 18th!&lt;\/p&gt;","Attachments":[],"Id":1892508,"PostDate":1428607715,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Us! We are traveling the Feb. 13-20th with our wedding on the 18th!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"alison.hardy1@gmail.com","IpAddress":"216.99.65.83","GroupId":39,"GroupName":"Newbie","JoinDate":1422374723,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281894.jpg?_r=1422907392","PhotoWidth":200,"PhotoHeight":226,"PhotoType":"custom"},"FormattedName":"hardyali","Id":281894,"Name":"hardyali","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.65.74.207","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78994,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"32cf9aaaf3b3c4e6196efa23d147f9d7","RawContent":"[quote name=\"hardyali\" post=\"1892508\" timestamp=\"1428607715\"]\nUs! We are traveling the Feb. 13-20th with our wedding on the 18th![\/quote]Congrats!  I saw your post in the other thread about venting ... I totally get it. It took about 10 days to receive the information from the wedding planner after we paid our deposit. I&#039;ve since asked a few questions in response and have been waiting almost another week. \nI&#039;m so glad I started planning early or this would be making my eye twitch!","Attachments":[],"Id":1892596,"PostDate":1428665239,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>hardyali, on 09 April 2015 - 11:28 AM, said:<\/p><div class='blockquote'><div class='quote'><p>Us! We are traveling the Feb. 13-20th with our wedding on the 18th!<\/p><\/div><\/div>\n<br>\nCongrats!  I saw your post in the other thread about venting ... I totally get it. It took about 10 days to receive the information from the wedding planner after we paid our deposit. I've since asked a few questions in response and have been waiting almost another week. <br>\nI'm so glad I started planning early or this would be making my eye twitch!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ashley225@gmail.com","IpAddress":"66.87.117.140","GroupId":39,"GroupName":"Newbie","JoinDate":1426945785,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282492.jpg?_r=1431603506","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"AshleyNYC323","Id":282492,"Name":"AshleyNYC323","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"216.99.65.82","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78994,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"acd0f9c879bb7962db196fdb64d896b4","RawContent":"&lt;p&gt;Thanks you too!!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I know, I feel so much better about planning early. I finally got the spreadsheet, and now I keep forgetting to use it.&lt;\/p&gt;\n&lt;p&gt;We got our boarding pass invitations, so I am making my fianc\u00e9 sit down and send them this weekend!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;good luck to you!!!&lt;\/p&gt;","Attachments":[],"Id":1892668,"PostDate":1428685734,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thanks you too!!!<\/p>\n<p>\u00a0<\/p>\n<p>I know, I feel so much better about planning early. I finally got the spreadsheet, and now I keep forgetting to use it.<\/p>\n<p>We got our boarding pass invitations, so I am making my fianc\u00e9 sit down and send them this weekend!<\/p>\n<p>\u00a0<\/p>\n<p>good luck to you!!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"alison.hardy1@gmail.com","IpAddress":"216.99.65.83","GroupId":39,"GroupName":"Newbie","JoinDate":1422374723,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281894.jpg?_r=1422907392","PhotoWidth":200,"PhotoHeight":226,"PhotoType":"custom"},"FormattedName":"hardyali","Id":281894,"Name":"hardyali","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.114.22.192","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78994,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ec4ce824a84b7d2a21e8c1011c36d428","RawContent":"Hi!! We are getting married here on April 08, 2016!!","Attachments":[],"Id":1894980,"PostDate":1430435070,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi!! We are getting married here on April 08, 2016!! \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sarah.scammell@hotmail.com","IpAddress":"24.114.22.192","GroupId":39,"GroupName":"Newbie","JoinDate":1430434834,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Soontobemrsminogue","Id":282930,"Name":"Soontobemrsminogue","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.65.74.207","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78994,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"fe85e83d36a0497a0b99a9f5f6417b3f","RawContent":"[quote name=\"Soontobemrsminogue\" post=\"1894980\" timestamp=\"1430435070\"]\nHi!! We are getting married here on April 08, 2016!![\/quote]Congrats!  We are the day after you!  Have you planned on anything yet?  We are doing the fountain for the ceremony and poolside for the reception.","Attachments":[],"Id":1895220,"PostDate":1430665890,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Soontobemrsminogue, on 30 April 2015 - 03:04 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hi!! We are getting married here on April 08, 2016!!<\/p>\n<\/div>\n<\/div><\/div>\n<p>Congrats! \u00a0We are the day after you! \u00a0Have you planned on anything yet? \u00a0We are doing the fountain for the ceremony and poolside for the reception.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ashley225@gmail.com","IpAddress":"66.87.117.140","GroupId":39,"GroupName":"Newbie","JoinDate":1426945785,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282492.jpg?_r=1431603506","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"AshleyNYC323","Id":282492,"Name":"AshleyNYC323","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.159.242.193","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78994,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ef4ad81bde34d36bf0e3c34355f2cde0","RawContent":"Congrats to you as well. We were thinking about having the ceremony on the beach but after reading reviews I may switch to the fountain. I&#039;m unsure yet of where to have the reception. Have you made any decisions regarding flowers and decorations?","Attachments":[],"Id":1895225,"PostDate":1430669270,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Congrats to you as well. We were thinking about having the ceremony on the beach but after reading reviews I may switch to the fountain. I'm unsure yet of where to have the reception. Have you made any decisions regarding flowers and decorations? \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sarah.scammell@hotmail.com","IpAddress":"24.114.22.192","GroupId":39,"GroupName":"Newbie","JoinDate":1430434834,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Soontobemrsminogue","Id":282930,"Name":"Soontobemrsminogue","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.65.74.207","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78994,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"497eeb34f8c938a32fe56f07ed63a1b0","RawContent":"[quote name=\"Soontobemrsminogue\" post=\"1895225\" timestamp=\"1430669270\"]\nCongrats to you as well. We were thinking about having the ceremony on the beach but after reading reviews I may switch to the fountain. I&#039;m unsure yet of where to have the reception. Have you made any decisions regarding flowers and decorations?[\/quote]\nWe haven&#039;t yet... I go back and forth between keeping things simple and wanting things to be amazing for photos.\nWhat about you?","Attachments":[],"Id":1895332,"PostDate":1430789264,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Soontobemrsminogue, on 03 May 2015 - 08:07 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Congrats to you as well. We were thinking about having the ceremony on the beach but after reading reviews I may switch to the fountain. I'm unsure yet of where to have the reception. Have you made any decisions regarding flowers and decorations?<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>We haven't yet... I go back and forth between keeping things simple and wanting things to be amazing for photos.<\/p>\n<p>What about you?<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ashley225@gmail.com","IpAddress":"66.87.117.140","GroupId":39,"GroupName":"Newbie","JoinDate":1426945785,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282492.jpg?_r=1431603506","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"AshleyNYC323","Id":282492,"Name":"AshleyNYC323","IsOnline":false}}],"Id":"78994","Title":"Now Larimar - 2016","LastPostDate":1430789264},"Pages":{"TotalItems":8,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
