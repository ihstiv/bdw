{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":34,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":9312,"MovedTo":null,"MovedOn":0,"FirstPostId":1105927,"Rating":0,"RatingHits":0,"Starter":{"Id":222063,"Name":"md2002","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-222063.jpg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"StartDate":1270745682,"LastPoster":{"Id":286918,"Name":"AdamnJenn17","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286918.jpg?_r=1462901352","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":45,"Preview":{"Id":1105927,"PostDate":1270745682,"PostContent":"Has anyone here used a Bose Sound dock on the beach for their ceremony? I have heard some people...","Author":{"Signature":"","Email":"maddog1991@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1254096844,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-222063.jpg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"md2002","Id":222063,"Name":"md2002","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50551,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fa19bf6ace28ef9500eed7593d23a7cc","RawContent":"Has anyone here used a Bose Sound dock on the beach for their ceremony? I have heard some people talk about it but I&#039;m wondering if that was loud enough of if I should get a PA system. I have the Sound Dock and was planning on using it.","Attachments":[],"Id":1105927,"PostDate":1270745682,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Has anyone here used a Bose Sound dock on the beach for their ceremony? I have heard some people talk about it but I'm wondering if that was loud enough of if I should get a PA system. I have the Sound Dock and was planning on using it.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"maddog1991@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1254096844,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-222063.jpg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"md2002","Id":222063,"Name":"md2002","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50551,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4e3aeb584e9a3d06084bc46df19871c8","RawContent":"I&#039;d be interested in hearing the responses to this as well. We&#039;re most likely going to play music off of our iPods, and purchase a sound dock for it...!","Attachments":[],"Id":1105942,"PostDate":1270746454,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'd be interested in hearing the responses to this as well. We're most likely going to play music off of our iPods, and purchase a sound dock for it...!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i1009.photobucket.com\/albums\/af215\/cranstonba\/3008_86364263754_511593754_2566972_.jpg\">http:\/\/i1009.photobucket.com\/albums\/...4_2566972_.jpg<\/a><br><br><strong>Brandi & Doug - November 5, 2010<\/strong><br><a data-ipb='nomediaparse' href=\"http:\/\/www.mywedding.com\/brandianddoug\">http:\/\/www.mywedding.com\/brandianddoug<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/dwdf.daisypath.com\/mPwAm5.png\">http:\/\/dwdf.daisypath.com\/mPwAm5.png<\/a><\/div><\/div>","Email":"brandibowers@gmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1263796196,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-224801.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"DWbridetobe","Id":224801,"Name":"DWbridetobe","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50551,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"639cc353dd5f8f159bbe29ae38216a5a","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;DWbridetobe&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;I&#039;d be interested in hearing the responses to this as well. We&#039;re most likely going to play music off of our iPods, and purchase a sound dock for it...!&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;I can tell you I work for Bose, and the Sound Dock is LOUD - REAL LOUD!! We are getting married on the beach though.. I&#039;m not sure if the sound of the beach, wind and other things will drown it out? We also have about 46 people at the ceremony and my FI will be starting her walk about 50 feet away. I&#039;m not sure if she or everyone else would be able to hear it.\n \n I know if I play it in my yard I can hear it at my next doors neighbors house clear as day. The issue is I love the songs we chose, and I want to be sure everyone can hear them.","Attachments":[],"Id":1105954,"PostDate":1270746950,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>DWbridetobe<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">I'd be interested in hearing the responses to this as well. We're most likely going to play music off of our iPods, and purchase a sound dock for it...!<\/div> <\/td> <\/tr> <\/table> <\/div>I can tell you I work for Bose, and the Sound Dock is LOUD - REAL LOUD!! We are getting married on the beach though.. I'm not sure if the sound of the beach, wind and other things will drown it out? We also have about 46 people at the ceremony and my FI will be starting her walk about 50 feet away. I'm not sure if she or everyone else would be able to hear it.<br \/> <br \/> I know if I play it in my yard I can hear it at my next doors neighbors house clear as day. The issue is I love the songs we chose, and I want to be sure everyone can hear them.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"maddog1991@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1254096844,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-222063.jpg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"md2002","Id":222063,"Name":"md2002","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50551,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c88481c76e6383f3562ea1b4f618f079","RawContent":"yeah i would like to know if anyone has used it for their wedding. I am thinking about buying it this weekend to use at my birthday party and then use for the wedding. \n How do you charge the sound dock?","Attachments":[],"Id":1114177,"PostDate":1271298946,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                yeah i would like to know if anyone has used it for their wedding. I am thinking about buying it this weekend to use at my birthday party and then use for the wedding. <br \/> How do you charge the sound dock?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tiffani@josephinsurancegroup.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1246294039,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-218912.jpg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"lovelytlc","Id":218912,"Name":"lovelytlc","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50551,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"82e698bdfbb6d2ddafc29912e66f28c7","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;lovelytlc&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;yeah i would like to know if anyone has used it for their wedding. I am thinking about buying it this weekend to use at my birthday party and then use for the wedding. \n How do you charge the sound dock?&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;You just plug it into the wall... it charges your Ipod as well","Attachments":[],"Id":1114543,"PostDate":1271341370,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>lovelytlc<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">yeah i would like to know if anyone has used it for their wedding. I am thinking about buying it this weekend to use at my birthday party and then use for the wedding. <br \/> How do you charge the sound dock?<\/div> <\/td> <\/tr> <\/table> <\/div>You just plug it into the wall... it charges your Ipod as well\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"maddog1991@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1254096844,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-222063.jpg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"md2002","Id":222063,"Name":"md2002","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50551,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0c698f891b30755bd0a5fd9e0c25352d","RawContent":"I&#039;m so glad someone posed this question, I&#039;m thinking of having my reception poolside, and to save some money thought about using speakers for the ipod rather than renting the sound system from the resort. Would be interested to know if people have done this!","Attachments":[],"Id":1114546,"PostDate":1271341562,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm so glad someone posed this question, I'm thinking of having my reception poolside, and to save some money thought about using speakers for the ipod rather than renting the sound system from the resort. Would be interested to know if people have done this!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"anitaperry@eastlink.ca","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1262707803,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-224334.jpg?_r=0","PhotoWidth":200,"PhotoHeight":136,"PhotoType":"custom"},"FormattedName":"barbiegirl_27","Id":224334,"Name":"barbiegirl_27","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50551,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fd9aa17c91a9e8ef220a16433f725cd8","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;barbiegirl_27&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;I&#039;m so glad someone posed this question, I&#039;m thinking of having my reception poolside, and to save some money thought about using speakers for the ipod rather than renting the sound system from the resort. Would be interested to know if people have done this!&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;The Sound Dock pool side should be OK. My worry is I will be on the beach for my ceremony. The beach has a lot of noise around it so I&#039;m not sure if it will get drowned out. \n \n The Sound Dock is VERY loud. If there is a Bose store in your area you should go check it out. Of course the best way to know is to ask someone who has done this but no one is responding :)","Attachments":[],"Id":1114656,"PostDate":1271345767,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>barbiegirl_27<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">I'm so glad someone posed this question, I'm thinking of having my reception poolside, and to save some money thought about using speakers for the ipod rather than renting the sound system from the resort. Would be interested to know if people have done this!<\/div> <\/td> <\/tr> <\/table> <\/div>The Sound Dock pool side should be OK. My worry is I will be on the beach for my ceremony. The beach has a lot of noise around it so I'm not sure if it will get drowned out. <br \/> <br \/> The Sound Dock is VERY loud. If there is a Bose store in your area you should go check it out. Of course the best way to know is to ask someone who has done this but no one is responding <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"maddog1991@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1254096844,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-222063.jpg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"md2002","Id":222063,"Name":"md2002","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50551,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e43b5df55b4ee71feb74c735865c5530","RawContent":"I plan on buying it for my wedding next month so I&#039;ll let you know when we get back. Going to be using it at the Gazebo for the ceremony and for the reception on the beach.","Attachments":[],"Id":1114662,"PostDate":1271345932,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I plan on buying it for my wedding next month so I'll let you know when we get back. Going to be using it at the Gazebo for the ceremony and for the reception on the beach.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"hahawryluk@hotmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1221055369,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211661.JPG?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"dolfinluck","Id":211661,"Name":"dolfinluck","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50551,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"25cb5624d7fb3f8053d8ba141662a197","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;dolfinluck&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;I plan on buying it for my wedding next month so I&#039;ll let you know when we get back. Going to be using it at the Gazebo for the ceremony and for the reception on the beach.&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;Awesome! Your feedback would be greatly appreciated! \n My brother has a dock, plus we both have the travel speakers.....they both get quite large but hard to judge when you don&#039;t know what it&#039;s going to be like around.\n \n I was thinking of getting the sound system for the ceremony b\/c it comes with a mic, and i&#039;ve read that people aren&#039;t able to hear your vows without the mic when the ceremony is on the beach!","Attachments":[],"Id":1114673,"PostDate":1271346456,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>dolfinluck<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">I plan on buying it for my wedding next month so I'll let you know when we get back. Going to be using it at the Gazebo for the ceremony and for the reception on the beach.<\/div> <\/td> <\/tr> <\/table> <\/div>Awesome! Your feedback would be greatly appreciated! <br \/> My brother has a dock, plus we both have the travel speakers.....they both get quite large but hard to judge when you don't know what it's going to be like around.<br \/> <br \/> I was thinking of getting the sound system for the ceremony b\/c it comes with a mic, and i've read that people aren't able to hear your vows without the mic when the ceremony is on the beach!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"anitaperry@eastlink.ca","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1262707803,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-224334.jpg?_r=0","PhotoWidth":200,"PhotoHeight":136,"PhotoType":"custom"},"FormattedName":"barbiegirl_27","Id":224334,"Name":"barbiegirl_27","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50551,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c78b6d66c59cab8882b3f23448472fcd","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;dolfinluck&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;I plan on buying it for my wedding next month so I&#039;ll let you know when we get back. Going to be using it at the Gazebo for the ceremony and for the reception on the beach.&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;Thanks, but too late... getting married Wednesday &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/wink.gif\" border=\"0\" alt=\"\" title=\"Wink\" class=\"inlineimg\" \/&gt;","Attachments":[],"Id":1114952,"PostDate":1271358745,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>dolfinluck<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">I plan on buying it for my wedding next month so I'll let you know when we get back. Going to be using it at the Gazebo for the ceremony and for the reception on the beach.<\/div> <\/td> <\/tr> <\/table> <\/div>Thanks, but too late... getting married Wednesday <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/wink.gif\" border=\"0\" alt=\"\" title=\"Wink\" class=\"inlineimg\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"maddog1991@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1254096844,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-222063.jpg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"md2002","Id":222063,"Name":"md2002","IsOnline":false}}],"Id":"50551","Title":"Bose sound dock loud enough","LastPostDate":1462889273},"Pages":{"TotalItems":34,"TotalPages":4,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":30},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
