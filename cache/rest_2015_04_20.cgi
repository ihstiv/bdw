p:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270939.jpg?_r=1423518723","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"pamelas21","Id":270939,"Name":"pamelas21","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.226.206.246","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76145,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fdc31edda375b81aa81a2450eabeca51","RawContent":"[quote name=\"pamelas21\" post=\"1843903\" timestamp=\"1397232701\"]\nHi Nicole,\n\nJust sent you everything! :)\n\nPam[\/quote]\nThanks Pam \nVery much appreciated.","Attachments":[],"Id":1844022,"PostDate":1397309819,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>pamelas21, on 11 April 2014 - 08:11 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hi Nicole,<\/p>\n<p>\u00a0<\/p>\n<p>Just sent you everything! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Pam<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>Thanks Pam\u00a0<\/p>\n<p>Very much appreciated.\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"spadeincwedding@yahoo.com","IpAddress":"99.226.206.246","GroupId":40,"GroupName":"Jr. Member","JoinDate":1396402180,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277449.jpg?_r=1404699929","PhotoWidth":200,"PhotoHeight":259,"PhotoType":"custom"},"FormattedName":"NixSpade","Id":277449,"Name":"NixSpade","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"63.119.183.254","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76145,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7202b8d70d15edde20966446092ec764","RawContent":"&lt;p&gt;Hi everyone.....I am new to this.&amp;nbsp; In the process of planning an October 2015 wedding.&amp;nbsp; I have been considering Iberostar and Secrets but I ran across RWS on tripadvisor.&amp;nbsp; The resort is lovely.&amp;nbsp; I knew planning a wedding would be stressful but a destination seems even harder! :)&amp;nbsp; I can&#039;t make up my mind. &amp;nbsp;I will be emailing the wedding planner.&amp;nbsp; I look forward to reading everyone&#039;s updates.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Tish&lt;\/p&gt;","Attachments":[],"Id":1844253,"PostDate":1397489749,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi everyone.....I am new to this.\u00a0 In the process of planning an October 2015 wedding.\u00a0 I have been considering Iberostar and Secrets but I ran across RWS on tripadvisor.\u00a0 The resort is lovely.\u00a0 I knew planning a wedding would be stressful but a destination seems even harder! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0 I can't make up my mind. \u00a0I will be emailing the wedding planner.\u00a0 I look forward to reading everyone's updates.<\/p>\n<p>\u00a0<\/p>\n<p>Tish<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"letitia_leaks@verizon.net","IpAddress":"63.119.183.254","GroupId":40,"GroupName":"Jr. Member","JoinDate":1397066522,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277534.jpg?_r=1397086760","PhotoWidth":160,"PhotoHeight":160,"PhotoType":"custom"},"FormattedName":"FutureMrsGlover","Id":277534,"Name":"FutureMrsGlover","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"69.58.97.194","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76145,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"1052ab08b622ef83bfc4900774655663","RawContent":"[quote name=\"FutureMrsGlover\" post=\"1844253\" timestamp=\"1397489749\"]\nHi everyone.....I am new to this.  In the process of planning an October 2015 wedding.  I have been considering Iberostar and Secrets but I ran across RWS on tripadvisor.  The resort is lovely.  I knew planning a wedding would be stressful but a destination seems even harder! :)  I can&#039;t make up my mind.  I will be emailing the wedding planner.  I look forward to reading everyone&#039;s updates.\n\nTish[\/quote]\nHi Tish!\n\nCongrats on getting engaged! These are exciting times!\n\nI know what you mean about it being harder! I researched for a few months before deciding on the Royalton!\n\nThere\u2019s so many factors: things that my fianc\u00e9 and I want in a resort and things my guests would want in a resort, etc!\n\nBut I\u2019m confident I made the right choice! So excited and happy to be getting married in beautiful Montego Bay! [font=wingdings]:)[\/font]\n\nMy date is November 17, 2014 \u2013 so far we have 54 guests booked! Can\u2019t wait to see everyone at the airport LOL what a party it will be!\n\nHappy Planning! [font=wingdings]:)[\/font]\n\nPam","Attachments":[],"Id":1844260,"PostDate":1397490547,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>FutureMrsGlover, on 14 April 2014 - 07:35 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hi everyone.....I am new to this.\u00a0 In the process of planning an October 2015 wedding.\u00a0 I have been considering Iberostar and Secrets but I ran across RWS on tripadvisor.\u00a0 The resort is lovely.\u00a0 I knew planning a wedding would be stressful but a destination seems even harder! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0 I can't make up my mind. \u00a0I will be emailing the wedding planner.\u00a0 I look forward to reading everyone's updates.<\/p>\n<p>\u00a0<\/p>\n<p>Tish<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>Hi Tish!<\/p>\n<p>\u00a0<\/p>\n<p>Congrats on getting engaged! These are exciting times!<\/p>\n<p>\u00a0<\/p>\n<p>I know what you mean about it being harder! I researched for a few months before deciding on the Royalton!<\/p>\n<p>\u00a0<\/p>\n<p>There\u2019s so many factors: things that my fianc\u00e9 and I want in a resort and things my guests would want in a resort, etc!<\/p>\n<p>\u00a0<\/p>\n<p>But I\u2019m confident I made the right choice! So excited and happy to be getting married in beautiful Montego Bay! <span  style=\"font-family:wingdings\"><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/span><\/p>\n<p>\u00a0<\/p>\n<p>My date is November 17, 2014 \u2013 so far we have 54 guests booked! Can\u2019t wait to see everyone at the airport LOL what a party it will be!<\/p>\n<p>\u00a0<\/p>\n<p>Happy Planning! <span  style=\"font-family:wingdings\"><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/span><\/p>\n<p>\u00a0<\/p>\n<p>Pam<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Happy Planning Future Brides!<\/p>\n<p>Love, Mrs. Gedney! <3<\/p>\n<p>11.18.2014","Email":"psaca@me.com","IpAddress":"99.227.231.192","GroupId":40,"GroupName":"Jr. Member","JoinDate":1372253473,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270939.jpg?_r=1423518723","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"pamelas21","Id":270939,"Name":"pamelas21","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"63.119.183.254","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76145,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"697a3ad460b3ebbc13e262cb25aadb41","RawContent":"[quote name=\"pamelas21\" post=\"1844260\" timestamp=\"1397490547\"]\nHi Tish!\n\nCongrats on getting engaged! These are exciting times!\n\nI know what you mean about it being harder! I researched for a few months before deciding on the Royalton!\n\nThere\u2019s so many factors: things that my fianc\u00e9 and I want in a resort and things my guests would want in a resort, etc!\n\nBut I\u2019m confident I made the right choice! So excited and happy to be getting married in beautiful Montego Bay! [font=wingdings] :)[\/font]\n\nMy date is November 17, 2014 \u2013 so far we have 54 guests booked! Can\u2019t wait to see everyone at the airport LOL what a party it will be!\n\nHappy Planning! [font=wingdings] :)[\/font]\n\nPam[\/quote]Thank you Pam.   I am thinking we will have approximately 50 guests also.  Please keep me posted with helpful hints.  I know I will need it.  :)\n\nTish","Attachments":[],"Id":1844291,"PostDate":1397495392,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>pamelas21, on 14 April 2014 - 07:49 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hi Tish!<\/p>\n<p>\u00a0<\/p>\n<p>Congrats on getting engaged! These are exciting times!<\/p>\n<p>\u00a0<\/p>\n<p>I know what you mean about it being harder! I researched for a few months before deciding on the Royalton!<\/p>\n<p>\u00a0<\/p>\n<p>There\u2019s so many factors: things that my fianc\u00e9 and I want in a resort and things my guests would want in a resort, etc!<\/p>\n<p>\u00a0<\/p>\n<p>But I\u2019m confident I made the right choice! So excited and happy to be getting married in beautiful Montego Bay! <span  style=\"font-family:wingdings\"> <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/span><\/p>\n<p>\u00a0<\/p>\n<p>My date is November 17, 2014 \u2013 so far we have 54 guests booked! Can\u2019t wait to see everyone at the airport LOL what a party it will be!<\/p>\n<p>\u00a0<\/p>\n<p>Happy Planning! <span  style=\"font-family:wingdings\"> <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/span><\/p>\n<p>\u00a0<\/p>\n<p>Pam<\/p>\n<\/div>\n<\/div><\/div>\n<p>Thank you Pam.\u00a0\u00a0 I am thinking we will have approximately 50 guests also.\u00a0 Please keep me posted with helpful hints.\u00a0 I know I will need it.\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Tish<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"letitia_leaks@verizon.net","IpAddress":"63.119.183.254","GroupId":40,"GroupName":"Jr. Member","JoinDate":1397066522,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277534.jpg?_r=1397086760","PhotoWidth":160,"PhotoHeight":160,"PhotoType":"custom"},"FormattedName":"FutureMrsGlover","Id":277534,"Name":"FutureMrsGlover","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"216.13.133.90","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76145,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"22e992dc6c406f9c86f305d99c53cf83","RawContent":"[quote name=\"FutureMrsGlover\" post=\"1844253\" timestamp=\"1397489749\"]\nHi everyone.....I am new to this.  In the process of planning an October 2015 wedding.  I have been considering Iberostar and Secrets but I ran across RWS on tripadvisor.  The resort is lovely.  I knew planning a wedding would be stressful but a destination seems even harder! :)  I can&#039;t make up my mind.  I will be emailing the wedding planner.  I look forward to reading everyone&#039;s updates.\n\nTish[\/quote]We were also (basically) decided on Iberostar but RWS came out of nowhere and stole our hearts. It\u2019s definitely a matter of balancing what we want and what will make for a fantastic vacation for our guests. We want them to have an experience they never forget!","Attachments":[],"Id":1844441,"PostDate":1397574333,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>FutureMrsGlover, on 14 April 2014 - 07:35 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hi everyone.....I am new to this.\u00a0 In the process of planning an October 2015 wedding.\u00a0 I have been considering Iberostar and Secrets but I ran across RWS on tripadvisor.\u00a0 The resort is lovely.\u00a0 I knew planning a wedding would be stressful but a destination seems even harder! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0 I can't make up my mind. \u00a0I will be emailing the wedding planner.\u00a0 I look forward to reading everyone's updates.<\/p>\n<p>\u00a0<\/p>\n<p>Tish<\/p>\n<\/div>\n<\/div><\/div>\n<p>We were also (basically) decided on Iberostar but RWS came out of nowhere and stole our hearts. It\u2019s definitely a matter of balancing what we want and what will make for a fantastic vacation for our guests. We want them to have an experience they never forget!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"smitha_r@yahoo.com","IpAddress":"99.244.114.38","GroupId":39,"GroupName":"Newbie","JoinDate":1389143480,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275928.jpg?_r=1403747949","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"mysticjade","Id":275928,"Name":"mysticjade","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"63.119.183.254","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76145,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fce4126a136d6c393ec32207be56011c","RawContent":"[quote name=\"mysticjade\" post=\"1844441\" timestamp=\"1397574333\"]\nWe were also (basically) decided on Iberostar but RWS came out of nowhere and stole our hearts. It\u2019s definitely a matter of balancing what we want and what will make for a fantastic vacation for our guests. We want them to have an experience they never forget![\/quote]I just received the information from Ellie.  RWS has definitely moved up to the top.  It has vision I was looking for.  Also, the prices are very good for the extras I can&#039;t bring along with me. \nI too believe my guests will have an awesome experience at RWS.","Attachments":[],"Id":1844478,"PostDate":1397586359,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>mysticjade, on 15 April 2014 - 07:05 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>We were also (basically) decided on Iberostar but RWS came out of nowhere and stole our hearts. It\u2019s definitely a matter of balancing what we want and what will make for a fantastic vacation for our guests. We want them to have an experience they never forget!<\/p>\n<\/div>\n<\/div><\/div>\n<p>I just received the information from Ellie.\u00a0 RWS has definitely moved up to the top.\u00a0 It has vision I was looking for.\u00a0 Also, the prices are very good for the extras I can't bring along with me.\u00a0<\/p>\n<p>I too believe my guests will have an awesome experience at RWS.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"letitia_leaks@verizon.net","IpAddress":"63.119.183.254","GroupId":40,"GroupName":"Jr. Member","JoinDate":1397066522,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277534.jpg?_r=1397086760","PhotoWidth":160,"PhotoHeight":160,"PhotoType":"custom"},"FormattedName":"FutureMrsGlover","Id":277534,"Name":"FutureMrsGlover","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.14.40.154","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76145,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8606c4bfaef183b4885677d56e598a84","RawContent":"&lt;p&gt;Hi everyone!&lt;\/p&gt;\n&lt;p&gt;Just joined this site today and my fianc\u00e9 and I are planning a DW in Jamaica in October 2015. The Royalton is at the top of my list along with the Riu Palace Tropical Bay and the Grand Palladium Lady Hamilton. I too can&#039;t make up my mind and hope to read everyones responses and reviews to hopefully decide.&lt;\/p&gt;\n&lt;p&gt;Can&#039;t wait to go through this process with all of you!!&lt;\/p&gt;\n&lt;p&gt;-Kailin&lt;\/p&gt;","Attachments":[],"Id":1845536,"PostDate":1398179739,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi everyone!<\/p>\n<p>Just joined this site today and my fianc\u00e9 and I are planning a DW in Jamaica in October 2015. The Royalton is at the top of my list along with the Riu Palace Tropical Bay and the Grand Palladium Lady Hamilton. I too can't make up my mind and hope to read everyones responses and reviews to hopefully decide.<\/p>\n<p>Can't wait to go through this process with all of you!!<\/p>\n<p>-Kailin<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"k-brown_@hotmail.com","IpAddress":"74.14.40.154","GroupId":39,"GroupName":"Newbie","JoinDate":1398174431,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277678.jpg?_r=1403101424","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"kail28","Id":277678,"Name":"kail28","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"63.119.183.254","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76145,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2d123a24bd9ac21fa2c05ce575078c6c","RawContent":"[quote name=\"kail28\" post=\"1845536\" timestamp=\"1398179739\"]\nHi everyone!\nJust joined this site today and my fianc\u00e9 and I are planning a DW in Jamaica in October 2015. The Royalton is at the top of my list along with the Riu Palace Tropical Bay and the Grand Palladium Lady Hamilton. I too can&#039;t make up my mind and hope to read everyones responses and reviews to hopefully decide.\nCan&#039;t wait to go through this process with all of you!!\n-Kailin[\/quote]Hi Kailin,\n\nCongratulations!  I am an October 2015 bride also!  I have put Royalton at the top.  I am actually going to Jamaica from June 6 -10th and I am hoping to do a site visit at the Royalton while I am there. \nI believe that will definitely help me decide between Secrets, Iberostar and the Royalton.  (I have already visited Secrets and Iberostar).  I will let you know what I think when I return. \n\nHappy planning!\n\nTish","Attachments":[],"Id":1845550,"PostDate":1398182957,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>kail28, on 22 April 2014 - 07:15 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hi everyone!<\/p>\n<p>Just joined this site today and my fianc\u00e9 and I are planning a DW in Jamaica in October 2015. The Royalton is at the top of my list along with the Riu Palace Tropical Bay and the Grand Palladium Lady Hamilton. I too can't make up my mind and hope to read everyones responses and reviews to hopefully decide.<\/p>\n<p>Can't wait to go through this process with all of you!!<\/p>\n<p>-Kailin<\/p>\n<\/div>\n<\/div><\/div>\n<p>Hi Kailin,<\/p>\n<p>\u00a0<\/p>\n<p>Congratulations!\u00a0 I am an October 2015 bride also!\u00a0 I have put Royalton at the top.\u00a0 I am actually going to Jamaica from June 6 -10th and I am hoping to do a site visit at the Royalton while I am there.\u00a0<\/p>\n<p>I believe that will definitely help me decide between Secrets, Iberostar and the Royalton.\u00a0\u00a0(I have already visited Secrets and Iberostar).\u00a0 I will let you know what I think when I return.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Happy planning!<\/p>\n<p>\u00a0<\/p>\n<p>Tish<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"letitia_leaks@verizon.net","IpAddress":"63.119.183.254","GroupId":40,"GroupName":"Jr. Member","JoinDate":1397066522,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277534.jpg?_r=1397086760","PhotoWidth":160,"PhotoHeight":160,"PhotoType":"custom"},"FormattedName":"FutureMrsGlover","Id":277534,"Name":"FutureMrsGlover","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"69.58.97.194","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76145,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"877b1fc07c45b3df574e238cb1f46fb7","RawContent":"[quote name=\"kail28\" post=\"1845536\" timestamp=\"1398179739\"]\nHi everyone!\nJust joined this site today and my fianc\u00e9 and I are planning a DW in Jamaica in October 2015. The Royalton is at the top of my list along with the Riu Palace Tropical Bay and the Grand Palladium Lady Hamilton. I too can&#039;t make up my mind and hope to read everyones responses and reviews to hopefully decide.\nCan&#039;t wait to go through this process with all of you!!\n-Kailin[\/quote]\nHi Kailin!\n\nWelcome to the forum! I sent you everything I have BUT I forgot to mention....\n\nMy fiance proposed back in March 2013. We were house hunting at the time so decided on November 2014 date for our wedding.\n\nBut because it was so far off we found the quotes we were getting for the all inclusive were too high SO we decided to wait until a year before the date literally November\/December 2013....if you can wait I would suggest it! Because your date is so far off you might find prices are based on standard pricing from their books NOT up to date pricing - hope this makes sense!?\n\nAnyways, happy planning girl! &amp;lt;3\n\nPam\n[quote name=\"FutureMrsGlover\" post=\"1845550\" timestamp=\"1398182957\"]\nHi Kailin,\n\nCongratulations!  I am an October 2015 bride also!  I have put Royalton at the top.  I am actually going to Jamaica from June 6 -10th and I am hoping to do a site visit at the Royalton while I am there. \nI believe that will definitely help me decide between Secrets, Iberostar and the Royalton.  (I have already visited Secrets and Iberostar).  I will let you know what I think when I return. \n\nHappy planning!\n\nTish[\/quote]\nHi Tish!\n\nOMG you are so lucky to be able to go and visit the sites before choosing!\n\nAnyways, I have a favor to ask - if it&#039;s no trouble at all - would you mind checking and taking pictures of the ballroom at the royalton and posting them on here?\n\nI would and I&#039;m sure some brides would appreciate it! I&#039;m considering the ballroom (long story) but have no idea what it looks like!\n\nAny pictures you can post would be great! Just to give us an idea!\n\nWish there was more on this resort already!\n\nAnyways, can&#039;t thank you enough!\n\nFingers crossed you come back with an amazing review of the Royalton &amp;lt;3\n\nPam","Attachments":[],"Id":1845568,"PostDate":1398187905,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>kail28, on 22 April 2014 - 07:15 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hi everyone!<\/p>\n<p>Just joined this site today and my fianc\u00e9 and I are planning a DW in Jamaica in October 2015. The Royalton is at the top of my list along with the Riu Palace Tropical Bay and the Grand Palladium Lady Hamilton. I too can't make up my mind and hope to read everyones responses and reviews to hopefully decide.<\/p>\n<p>Can't wait to go through this process with all of you!!<\/p>\n<p>-Kailin<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>Hi Kailin!<\/p>\n<p>\u00a0<\/p>\n<p>Welcome to the forum! I sent you everything I have BUT I forgot to mention....<\/p>\n<p>\u00a0<\/p>\n<p>My fiance proposed back in March 2013. We were house hunting at the time so decided on November 2014 date for our wedding.<\/p>\n<p>\u00a0<\/p>\n<p>But because it was so far off we found the quotes we were getting for the all inclusive were too high SO we decided to wait until a year before the date literally November\/December 2013....if you can wait I would suggest it! Because your date is so far off you might find prices are based on standard pricing from their books NOT up to date pricing - hope this makes sense!?<\/p>\n<p>\u00a0<\/p>\n<p>Anyways, happy planning girl! <3<\/p>\n<p>\u00a0<\/p>\n<p>Pam<\/p><br \/><p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>FutureMrsGlover, on 22 April 2014 - 08:09 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hi Kailin,<\/p>\n<p>\u00a0<\/p>\n<p>Congratulations!\u00a0 I am an October 2015 bride also!\u00a0 I have put Royalton at the top.\u00a0 I am actually going to Jamaica from June 6 -10th and I am hoping to do a site visit at the Royalton while I am there.\u00a0<\/p>\n<p>I believe that will definitely help me decide between Secrets, Iberostar and the Royalton.\u00a0\u00a0(I have already visited Secrets and Iberostar).\u00a0 I will let you know what I think when I return.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Happy planning!<\/p>\n<p>\u00a0<\/p>\n<p>Tish<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>Hi Tish!<\/p>\n<p>\u00a0<\/p>\n<p>OMG you are so lucky to be able to go and visit the sites before choosing!<\/p>\n<p>\u00a0<\/p>\n<p>Anyways, I have a favor to ask - if it's no trouble at all - would you mind checking and taking pictures of the ballroom at the royalton and posting them on here?<\/p>\n<p>\u00a0<\/p>\n<p>I would and I'm sure some brides would appreciate it! I'm considering the ballroom (long story) but have no idea what it looks like!<\/p>\n<p>\u00a0<\/p>\n<p>Any pictures you can post would be great! Just to give us an idea!<\/p>\n<p>\u00a0<\/p>\n<p>Wish there was more on this resort already!<\/p>\n<p>\u00a0<\/p>\n<p>Anyways, can't thank you enough!<\/p>\n<p>\u00a0<\/p>\n<p>Fingers crossed you come back with an amazing review of the Royalton <3<\/p>\n<p>\u00a0<\/p>\n<p>Pam<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Happy Planning Future Brides!<\/p>\n<p>Love, Mrs. Gedney! <3<\/p>\n<p>11.18.2014","Email":"psaca@me.com","IpAddress":"99.227.231.192","GroupId":40,"GroupName":"Jr. Member","JoinDate":1372253473,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270939.jpg?_r=1423518723","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"pamelas21","Id":270939,"Name":"pamelas21","IsOnline":false}}],"Pages":{"TotalItems":323,"TotalPages":33,"CurrentPage":30,"NextPage":40,"PreviousPage":20,"LastPage":320},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
