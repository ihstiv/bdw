-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I took the pics! lol and selfies just aren't in my line of work ! but yeah the humidity disaster is me<br><br>\nSent from my SGH-I337M using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><em><span style=\"color:rgb(51,153,255);\">I'm lucky enough to say yes again....October 20, 2015\u00a0<\/span><\/em>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.49.243.226","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79202,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":4,"IsLiked":false,"PostKey":"d85265265611a719fb8bc69a0ac04c98","RawContent":"&lt;p&gt;It was so great to meet you ladies! Hope we can do it again soon!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;@[member=\"Meandhim\"] round tables are a proven must have for the wedding! ;)&lt;\/p&gt;","Attachments":[],"Id":1902585,"PostDate":1439642013,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>It was so great to meet you ladies! Hope we can do it again soon!<\/p>\n<p>\u00a0<\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"268499\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/268499-meandhim\/' title='Member profile'><span itemprop=\"name\">Meandhim<\/span><\/a> round tables are a proven must have for the wedding! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>My planning thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78916-snswedding2016-planning-thread-jan-9-2016-azul-fives\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78916-snswedding2016-planning-thread-jan-9-2016-azul-fives\/<\/a><\/p>\n<p>\u00a0<\/p>\n<div><a class='bbc_url' href='http:\/\/www.TickerFactory.com\/'><\/div>\n<div><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10730;0\/st\/20160109\/e\/Our+Wedding\/k\/9fa9\/event.png\" alt=\"event.png\"><\/div>\n<div><\/a><\/div>\n","Email":"sean.n.steph2016@gmail.com","IpAddress":"74.12.52.42","GroupId":40,"GroupName":"Jr. Member","JoinDate":1415533111,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281055.jpg?_r=1415590512","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"snswedding2016","Id":281055,"Name":"snswedding2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.146.146.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79202,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"4a440afab32ce023ac8ec5321a864e63","RawContent":"I love your hair. \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1902586,"PostDate":1439642886,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I love your hair. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.179.187.201","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79202,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"1502e2c2aa11570f2ce92a16476f027d","RawContent":"&lt;p&gt;Ah - this is so cool to see you all together! Thanks for sharing the pics! Cheers!&lt;\/p&gt;","Attachments":[],"Id":1902620,"PostDate":1439727008,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Ah - this is so cool to see you all together! Thanks for sharing the pics! Cheers!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rebecca.shaffer@gmail.com","IpAddress":"159.53.174.144","GroupId":3,"GroupName":"Member","JoinDate":1403101687,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"beckys98","Id":278581,"Name":"beckys98","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.49.233.46","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79202,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":5,"IsLiked":false,"PostKey":"0fb2b4c3b79ab62c15d1286dd88643f7","RawContent":"[quote name=\"acw271011\" post=\"1902573\" timestamp=\"1439611895\"]\nSo here they are fresh from Oliver &amp;amp; Bonacini the BDW GTA Brides get together (well at least the first one). Sadly we were missing a couple of ladies but hoping there will be another meet up and they will be able to join!\n\n[img]http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif[\/img][url=\"http:\/\/www.bestdestinationwedding.com\/index.php?app=core&amp;amp;module=attach&amp;amp;section=attach&amp;amp;attach_rel_module=post&amp;amp;attach_id=33343\"]GTA brides.jpg[\/url]\nthe 8 that were able to make it tonight!\n\n[img]http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif[\/img][url=\"http:\/\/www.bestdestinationwedding.com\/index.php?app=core&amp;amp;module=attach&amp;amp;section=attach&amp;amp;attach_rel_module=post&amp;amp;attach_id=33344\"]krystalball and diadiamond.jpg[\/url]\n@[member=\"krystalball\"] and @[member=\"diadiamond\"]\n\n[img]http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif[\/img][url=\"http:\/\/www.bestdestinationwedding.com\/index.php?app=core&amp;amp;module=attach&amp;amp;section=attach&amp;amp;attach_rel_module=post&amp;amp;attach_id=33345\"]meandhim and snswedding2016 and laurena1229.jpg[\/url]\n@[member=\"Meandhim\"], @[member=\"snswedding2016\"] and @[member=\"Laurena1229\"]\n\n\n[img]http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif[\/img][url=\"http:\/\/www.bestdestinationwedding.com\/index.php?app=core&amp;amp;module=attach&amp;amp;section=attach&amp;amp;attach_rel_module=post&amp;amp;attach_id=33346\"]perianjay and veryvalentine.jpg[\/url]\n@[member=\"perianjay\"] and @[member=\"veryvalentine\"][\/quote]\nThanks for posting the pictures!  LOL at my face in the second picture.  \n\nThanks to everyone who was involved with the planning of this and thanks to everyone who came out.  I had a blast with you ladies, it was so nice to meet you all!!! I wish that I got to chat more with some of the ladies at the other side of the table.  I hope we get to do this again sometime! \n[quote name=\"perianjay\" post=\"1902566\" timestamp=\"1439606145\"]\nAgreed. I had fun meeting everyone! Wish I got to chat with the other end of the table a bit more! :) definitely will have to meet up again soon.[\/quote]\nI wish we got more of a chance to talk.  I wanted to mention how much I LOVE your eyebrows and your eyelashes.  Also, I&#039;m a huge fan of your planning thread so far.  I love your proposal story.","Attachments":[],"Id":1902625,"PostDate":1439747328,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>acw271011, on 15 August 2015 - 12:11 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>So here they are fresh from Oliver & Bonacini the BDW GTA Brides get together (well at least the first one). Sadly we were missing a couple of ladies but hoping there will be another meet up and they will be able to join!<br><br><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif\" alt=\"attachicon.gif\"><\/span><a href='http:\/\/www.bestdestinationwedding.com\/index.php?app=core&module=attach&section=attach&attach_rel_module=post&attach_id=33343' class='bbc_url' title=''>GTA brides.jpg<\/a><br>\nthe 8 that were able to make it tonight!<br><br><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif\" alt=\"attachicon.gif\"><\/span><a href='http:\/\/www.bestdestinationwedding.com\/index.php?app=core&module=attach&section=attach&attach_rel_module=post&attach_id=33344' class='bbc_url' title=''>krystalball and diadiamond.jpg<\/a><br>\n@<a hovercard-ref=\"member\" hovercard-id=\"281820\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281820-krystalball\/' title='Member profile'><span itemprop=\"name\">krystalball<\/span><\/a> and @<a hovercard-ref=\"member\" hovercard-id=\"276748\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/276748-diadiamond\/' title='Member profile'><span itemprop=\"name\">diadiamond<\/span><\/a><br><br><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif\" alt=\"attachicon.gif\"><\/span><a href='http:\/\/www.bestdestinationwedding.com\/index.php?app=core&module=attach&section=attach&attach_rel_module=post&attach_id=33345' class='bbc_url' title=''>meandhim and snswedding2016 and laurena1229.jpg<\/a><br>\n@<a hovercard-ref=\"member\" hovercard-id=\"268499\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/268499-meandhim\/' title='Member profile'><span itemprop=\"name\">Meandhim<\/span><\/a>, @<a hovercard-ref=\"member\" hovercard-id=\"281055\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281055-snswedding2016\/' title='Member profile'><span itemprop=\"name\">snswedding2016<\/span><\/a> and @<a hovercard-ref=\"member\" hovercard-id=\"283004\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/283004-laurena1229\/' title='Member profile'><span itemprop=\"name\">Laurena1229<\/span><\/a><br><br><br><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif\" alt=\"attachicon.gif\"><\/span><a href='http:\/\/www.bestdestinationwedding.com\/index.php?app=core&module=attach&section=attach&attach_rel_module=post&attach_id=33346' class='bbc_url' title=''>perianjay and veryvalentine.jpg<\/a><\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"281478\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281478-perianjay\/' title='Member profile'><span itemprop=\"name\">perianjay<\/span><\/a> and @<a hovercard-ref=\"member\" hovercard-id=\"277519\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277519-veryvalentine\/' title='Member profile'><span itemprop=\"name\">veryvalentine<\/span><\/a><\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>Thanks for posting the pictures! \u00a0LOL at my face in the second picture. \u00a0<\/p><br \/><p>Thanks to everyone who was involved with the planning of this and thanks to everyone who came out. \u00a0I had a blast with you ladies, it was so nice to meet you all!!! I wish that I got to chat more with some of the ladies at the other side of the table. \u00a0I hope we get to do this again sometime!\u00a0<\/p>\n<br \/><p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>perianjay, on 14 August 2015 - 10:35 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Agreed. I had fun meeting everyone! Wish I got to chat with the other end of the table a bit more! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> definitely will have to meet up again soon.<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>I wish we got more of a chance to talk. \u00a0I wanted to mention how much I LOVE your eyebrows and your eyelashes. \u00a0Also, I'm a huge fan of your planning thread so far. \u00a0I love your proposal story.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div><br><div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;484\/st\/20150924\/e\/Our+Wedding\/k\/8745\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<\/div>\n<div>\u00a0<\/div>\n<div>My Planning Thread:<\/div>\n<div>\u00a0<\/div>\n<div><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79153-diadiamonds-planning-thread-iberostar-varadero-cuba-sept242015\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79153-diadiamonds-planning-thread-iberostar-varadero-cuba-sept242015\/<\/a><\/div>\n<div>\u00a0<\/div>\n<div>\u00a0<\/div>\n","Email":"fadia.daniel@gmail.com","IpAddress":"76.64.81.211","GroupId":40,"GroupName":"Jr. Member","JoinDate":1392649643,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276748.jpg?_r=1392867144","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"diadiamond","Id":276748,"Name":"diadiamond","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79202,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"0c2713fa5fb94eb5479d8dc529e7dc65","RawContent":"&lt;p&gt;@[member=\"diadiamond\"] aww thanks girl!!! We will definitely have to meet again and chat some more. That was the only thing I felt like I missed out on that night, talking with you ladies on the other side of the table! :) Oh well, just an excuse to meet up again ;) haha&lt;\/p&gt;","Attachments":[],"Id":1902655,"PostDate":1439805832,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"276748\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/276748-diadiamond\/' title='Member profile'><span itemprop=\"name\">diadiamond<\/span><\/a> aww thanks girl!!! We will definitely have to meet again and chat some more. That was the only thing I felt like I missed out on that night, talking with you ladies on the other side of the table! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> Oh well, just an excuse to meet up again <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/> haha<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419423414,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1436293677","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"38.112.94.76","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79202,"EditedBy":"","EditDate":1439811552,"EditReason":"","DeleteDate":0,"TotalLikes":5,"IsLiked":false,"PostKey":"f2cf3abb4ce77f023f569976da78121e","RawContent":"&lt;p&gt;A big thank you to all you lovely ladies! &amp;nbsp;It was so nice to finally meet you in person. &amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;As @[member=\"diadiamond\"] said earlier, we have an instant bond over such an epic life experience. &amp;nbsp;There is nothing ordinary about you extraordinary ladies!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thank you @[member=\"snswedding2016\"] for making the reservation. &amp;nbsp;It was so nice meeting you and I&#039;m sure we will meet again. &amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;@[member=\"acw271011\"] &amp;nbsp;it was very lovely to meet you. &amp;nbsp;Thank you for all you do on the forum. &amp;nbsp;It&#039;s very obvious how much time you put into it and it honestly helps brides-to-be feel more comfortable sharing their stories when they have someone supporting their stories and literally, \"liking\" their stories.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;@[member=\"perianjay\"] &amp;nbsp;So nice to meet you!! &amp;nbsp;I probably e-interacted with you the most. &amp;nbsp;I was always literally 10 steps behind you in my planning process and you helped me out with so many things, whether it was BM dress, kimonos and just plain logical solutions. &amp;nbsp;You were like my forum bridesmaid! &amp;nbsp;hahaha. It was so great to meet you and meeting you in person confirmed that I knew we&#039;d totally be friends in real life! &amp;nbsp; :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;@[member=\"Meandhim\"] &amp;amp; krystalball &amp;nbsp;It was a pleasure meeting you ladies. &amp;nbsp;I&#039;m so glad I was able to share my pictures with you ladies. &amp;nbsp;I think I was a casualty of the rectangle tables as I totally missed out on bonding with you ladies. &amp;nbsp;I hope that when the second round comes I can hear more about your experiences. &amp;nbsp; :)   &lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;@[member=\"Laurena1229\"] &amp;nbsp;It super nice meeting you as well and learning about your planning stages and sharing some of the same frustrations. &amp;nbsp;I hope you can make it to next one and I can&#039;t wait to see pictures of you in your dress. &amp;nbsp;Just hearing you describe it I&#039;m sure it&#039;s epic! &amp;nbsp; :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;special shout out to @[member=\"calgarybride2015\"] &amp;nbsp;I definitely mentioned your name a few times during our meetup, very grateful for you on this forum. :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;","Attachments":[],"Id":1902659,"PostDate":1439810005,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>A big thank you to all you lovely ladies! \u00a0It was so nice to finally meet you in person. \u00a0<\/p>\n<p>As @<a hovercard-ref=\"member\" hovercard-id=\"276748\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/276748-diadiamond\/' title='Member profile'><span itemprop=\"name\">diadiamond<\/span><\/a> said earlier, we have an instant bond over such an epic life experience. \u00a0There is nothing ordinary about you extraordinary ladies!<\/p>\n<p>\u00a0<\/p>\n<p>Thank you @<a hovercard-ref=\"member\" hovercard-id=\"281055\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281055-snswedding2016\/' title='Member profile'><span itemprop=\"name\">snswedding2016<\/span><\/a> for making the reservation. \u00a0It was so nice meeting you and I'm sure we will meet again. \u00a0<\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"232000\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/232000-acw271011\/' title='Member profile'><span itemprop=\"name\">acw271011<\/span><\/a> \u00a0it was very lovely to meet you. \u00a0Thank you for all you do on the forum. \u00a0It's very obvious how much time you put into it and it honestly helps brides-to-be feel more comfortable sharing their stories when they have someone supporting their stories and literally, \"liking\" their stories.<\/p>\n<p>\u00a0<\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"281478\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281478-perianjay\/' title='Member profile'><span itemprop=\"name\">perianjay<\/span><\/a> \u00a0So nice to meet you!! \u00a0I probably e-interacted with you the most. \u00a0I was always literally 10 steps behind you in my planning process and you helped me out with so many things, whether it was BM dress, kimonos and just plain logical solutions. \u00a0You were like my forum bridesmaid! \u00a0hahaha. It was so great to meet you and meeting you in person confirmed that I knew we'd totally be friends in real life! \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"268499\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/268499-meandhim\/' title='Member profile'><span itemprop=\"name\">Meandhim<\/span><\/a> & krystalball \u00a0It was a pleasure meeting you ladies. \u00a0I'm so glad I was able to share my pictures with you ladies. \u00a0I think I was a casualty of the rectangle tables as I totally missed out on bonding with you ladies. \u00a0I hope that when the second round comes I can hear more about your experiences. \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> \u00a0\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"283004\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/283004-laurena1229\/' title='Member profile'><span itemprop=\"name\">Laurena1229<\/span><\/a> \u00a0It super nice meeting you as well and learning about your planning stages and sharing some of the same frustrations. \u00a0I hope you can make it to next one and I can't wait to see pictures of you in your dress. \u00a0Just hearing you describe it I'm sure it's epic! \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>special shout out to @<a hovercard-ref=\"member\" hovercard-id=\"277873\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277873-calgarybride2015\/' title='Member profile'><span itemprop=\"name\">calgarybride2015<\/span><\/a> \u00a0I definitely mentioned your name a few times during our meetup, very grateful for you on this forum. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p><a class='resized_img' rel='lightbox[1902659]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2015\/post-277519-0-41514000-1439823824.jpg\" title=\"FullSizeRender (14).jpg -  104.8KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2015\/post-277519-0-41514000-1439823824.jpg\" class='bbc_img linked-image' alt=\"FullSizeRender (14).jpg\" \/><\/a>\n\n<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div><br><div>\u00a0<\/div>\n<div>\u00a0<\/div>\n<div>Married on June 20th, 2015 at the Grand Sunset Princess Riviera Gazebo & Reception at the Chill Out with 60 guests<\/div>\n<div>\u00a0<\/div>\n<\/div>\n<div>\u00a0<\/div>\n<p>My planning thread:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/<\/a><\/p>\n<p>My review thread: \u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/<\/a>","Email":"rebecca.valero@gmail.com","IpAddress":"38.112.94.76","GroupId":3,"GroupName":"Member","JoinDate":1396968452,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277519.jpg?_r=1439827749","PhotoWidth":200,"PhotoHeight":132,"PhotoType":"custom"},"FormattedName":"veryvalentine","Id":277519,"Name":"veryvalentine","IsOnline":false}}],"Pages":{"TotalItems":215,"TotalPages":22,"CurrentPage":160,"NextPage":170,"PreviousPage":150,"LastPage":210},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
