> Time: 1443167309 / Fri, 25 Sep 2015 07:48:29 +0000
> URL: /index.php?/REST/Forums/topic?startFromPostId=1903303&SessionId=d7e4aba2496919b366ef9d72f5bf26ed
> User jacquewedding (283943)
array (
  '/REST/Forums/topic?startFromPostId' => '1903303',
  'SessionId' => 'd7e4aba2496919b366ef9d72f5bf26ed',
  'module' => 'REST',
  'section' => 'run',
