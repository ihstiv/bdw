{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":5,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":79,"MovedTo":null,"MovedOn":0,"FirstPostId":1905246,"Rating":0,"RatingHits":0,"Starter":{"Id":281615,"Name":"SunshineDreamKay","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1442978636,"LastPoster":{"Id":281615,"Name":"SunshineDreamKay","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":34,"Preview":{"Id":1905246,"PostDate":1442978636,"PostContent":"Hey ladies,  I want to go down the formal route but it's proving difficult due to mine and FI sur...","Author":{"Signature":"","Email":"ricardoandkershia@hotmail.com","IpAddress":"82.16.59.180","GroupId":39,"GroupName":"Newbie","JoinDate":1420500004,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"SunshineDreamKay","Id":281615,"Name":"SunshineDreamKay","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"85.255.232.15","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79609,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5c7e426d7c78e99e3604184e9d3ec800","RawContent":"Hey ladies, \n\n\nI want to go down the formal route but it&#039;s proving difficult due to mine and FI surnames and our parents. Now, FI and I are actually hosting the wedding but we want to include our parents names as it&#039;s not because our parents don&#039;t want to pay, it&#039;s just that financially they can&#039;t so we would still love them to be included rather than \"together with their parents\" which seems to be where we are heading.\n\n\nMy FI has his Dad&#039;s surname, who won&#039;t be on the invitation. It will be his mum and stepdad, so their surname is different to my FI. \n\n\nMy surname is the same as my mum&#039;s. My parents are not married so my dads surname is different. I don&#039;t really think my dad needs to be on the invite but out of not hurting his feelings I will add it. \n\n\nHere&#039;s an example.\n\n\nMs. Mother of the Bride Jones\n\nMr. Father of the Bride Smith\n\n\nRequest the honour of your presence at the marriage of their daughter.\n\n\nBride Jones (I wouldn&#039;t usually have my surname here but as my parents have different surnames I thought it would make sense?)\n\n\nTo \n\n\nGroom Clarke\n\n\nSon of \n\n\nMr. and Mrs. Stepdad Wright.\n\n\nThere&#039;s so many surnames and my FI doesn&#039;t match anyones. I can&#039;t find any advice online but we know it would mean the world to our parents to have their names on the invite. \n\n\nAny help would be appreciated.","Attachments":[],"Id":1905246,"PostDate":1442978636,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hey ladies, <br><br>\nI want to go down the formal route but it's proving difficult due to mine and FI surnames and our parents. Now, FI and I are actually hosting the wedding but we want to include our parents names as it's not because our parents don't want to pay, it's just that financially they can't so we would still love them to be included rather than \"together with their parents\" which seems to be where we are heading.<br><br>\nMy FI has his Dad's surname, who won't be on the invitation. It will be his mum and stepdad, so their surname is different to my FI. <br><br>\nMy surname is the same as my mum's. My parents are not married so my dads surname is different. I don't really think my dad needs to be on the invite but out of not hurting his feelings I will add it. <br><br>\nHere's an example.<br><br>\nMs. Mother of the Bride Jones<br>\nMr. Father of the Bride Smith<br><br>\nRequest the honour of your presence at the marriage of their daughter.<br><br>\nBride Jones (I wouldn't usually have my surname here but as my parents have different surnames I thought it would make sense?)<br><br>\nTo <br><br>\nGroom Clarke<br><br>\nSon of <br><br>\nMr. and Mrs. Stepdad Wright.<br><br>\nThere's so many surnames and my FI doesn't match anyones. I can't find any advice online but we know it would mean the world to our parents to have their names on the invite. <br><br>\nAny help would be appreciated.  \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ricardoandkershia@hotmail.com","IpAddress":"82.16.59.180","GroupId":39,"GroupName":"Newbie","JoinDate":1420500004,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"SunshineDreamKay","Id":281615,"Name":"SunshineDreamKay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.146.146.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79609,"EditedBy":"<strong>Edited by calgarybride2015, Yesterday, 09:39 AM.<\/strong>","EditDate":1443001196,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"3642e4e158b31fbe325e9a5a566b4fa8","RawContent":"I feel your pain!\n\n\nGiven then there is many names and only so much room on the invite, could you just use the term &#039;parents&#039;\n\n\nMaybe something like\n\n\nBride and groom, along with their parents invite you to join them......\n\n\nI think it would keep it cleaner and crisper and much easier to read. \n\n\nOr if you really want names say something like\n\nBride and groom, along with their parents Shelly, Steve, Bob, Mary, and Joe invite you ...... \n\n\nHope you get the answer you hope for :)\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1905257,"PostDate":1443001039,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I feel your pain!<br><br>\nGiven then there is many names and only so much room on the invite, could you just use the term 'parents'<br><br>\nMaybe something like<br><br>\nBride and groom, along with their parents invite you to join them......<br><br>\nI think it would keep it cleaner and crisper and much easier to read. <br><br>\nOr if you really want names say something like<br>\nBride and groom, along with their parents Shelly, Steve, Bob, Mary, and Joe invite you ...... <br><br>\nHope you get the answer you hope for <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"85.255.235.236","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79609,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"624e08ed5d609ffc4c8e3c109d6f9b26","RawContent":"Thanks @[member=\"calgarybride2015\"]. I did suggest the term &#039;parents&#039; to FI but he thinks we should include their names which doesn&#039;t look good to me!\n\n\nMoon Palace Cancun Bride, April 2016","Attachments":[],"Id":1905310,"PostDate":1443064490,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks @<a hovercard-ref=\"member\" hovercard-id=\"277873\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277873-calgarybride2015\/' title='Member profile'><span itemprop=\"name\">calgarybride2015<\/span><\/a>. I did suggest the term 'parents' to FI but he thinks we should include their names which doesn't look good to me!<br><br>\nMoon Palace Cancun Bride, April 2016\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ricardoandkershia@hotmail.com","IpAddress":"82.16.59.180","GroupId":39,"GroupName":"Newbie","JoinDate":1420500004,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"SunshineDreamKay","Id":281615,"Name":"SunshineDreamKay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"200.79.251.123","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79609,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0f2e7d4b0176adac9264534f5f2f3aea","RawContent":"[quote name=\"SunshineDreamKay\" post=\"1905246\" timestamp=\"1442993036\"]\nHey ladies,\n\nI want to go down the formal route but it&#039;s proving difficult due to mine and FI surnames and our parents. Now, FI and I are actually hosting the wedding but we want to include our parents names as it&#039;s not because our parents don&#039;t want to pay, it&#039;s just that financially they can&#039;t so we would still love them to be included rather than \"together with their parents\" which seems to be where we are heading.\n\nMy FI has his Dad&#039;s surname, who won&#039;t be on the invitation. It will be his mum and stepdad, so their surname is different to my FI.\n\nMy surname is the same as my mum&#039;s. My parents are not married so my dads surname is different. I don&#039;t really think my dad needs to be on the invite but out of not hurting his feelings I will add it.\n\nHere&#039;s an example.\n\nMs. Mother of the Bride Jones\nMr. Father of the Bride Smith\n\nRequest the honour of your presence at the marriage of their daughter.\n\nBride Jones (I wouldn&#039;t usually have my surname here but as my parents have different surnames I thought it would make sense?)\n\nTo\n\nGroom Clarke\n\nSon of\n\nMr. and Mrs. Stepdad Wright.\n\nThere&#039;s so many surnames and my FI doesn&#039;t match anyones. I can&#039;t find any advice online but we know it would mean the world to our parents to have their names on the invite.\n\nAny help would be appreciated.[\/quote]@[member=\"SunshineDreamKay\"] I would definitely go with the term \"Parents\".  It is straight to the point and your guests will receive the message crispy clear.  \n\nHappy Planning","Attachments":[],"Id":1905335,"PostDate":1443093983,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>SunshineDreamKay, on Yesterday, 03:23 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hey ladies,<br><br>\nI want to go down the formal route but it's proving difficult due to mine and FI surnames and our parents. Now, FI and I are actually hosting the wedding but we want to include our parents names as it's not because our parents don't want to pay, it's just that financially they can't so we would still love them to be included rather than \"together with their parents\" which seems to be where we are heading.<br><br>\nMy FI has his Dad's surname, who won't be on the invitation. It will be his mum and stepdad, so their surname is different to my FI.<br><br>\nMy surname is the same as my mum's. My parents are not married so my dads surname is different. I don't really think my dad needs to be on the invite but out of not hurting his feelings I will add it.<br><br>\nHere's an example.<br><br>\nMs. Mother of the Bride Jones<br>\nMr. Father of the Bride Smith<br><br>\nRequest the honour of your presence at the marriage of their daughter.<br><br>\nBride Jones (I wouldn't usually have my surname here but as my parents have different surnames I thought it would make sense?)<br><br>\nTo<br><br>\nGroom Clarke<br><br>\nSon of<br><br>\nMr. and Mrs. Stepdad Wright.<br><br>\nThere's so many surnames and my FI doesn't match anyones. I can't find any advice online but we know it would mean the world to our parents to have their names on the invite.<br><br>\nAny help would be appreciated.<\/p>\n<\/div>\n<\/div><\/div>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"281615\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281615-sunshinedreamkay\/' title='Member profile'><span itemprop=\"name\">SunshineDreamKay<\/span><\/a> I would definitely go with the term \"Parents\". \u00a0It is straight to the point and your guests will receive the message crispy clear. \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Happy Planning\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"Dream Weddings Riviera Maya- We pay attention to your wishes and coordinate closely with you to ensure your wedding or event is planned to perfection!<br \/>\n<br \/>\n<span style='color: rgb(40,40,40)'><span style='font-family: arial'><span style='font-size: 12px;'>Dream Weddings Riviera Maya<\/span><\/span><\/span><br \/>\n<span style='font-family: arial'><span style='font-size: 12px;'>weddingsinplayadelcarmen@gmail.com<\/span><\/span><br \/>\n<a class='bbc_url' href='http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html'>http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html<\/a><br \/>\n<br \/>\n<span style='color: rgb(40,40,40)'><span style='font-family: arial'><span style='font-size: 12px;'>Happy Planning!<\/span><\/span><\/span><br \/>\n<span style='color: rgb(40,40,40)'><span style='font-family: arial'><span style='font-size: 12px;'>Joyce<\/span><\/span><\/span>","Email":"weddingsinplayadelcarmen@gmail.com","IpAddress":"187.252.44.28","GroupId":84,"GroupName":"Insiders w\/ Articles","JoinDate":1326839987,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250090.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"dreamweddings","Id":250090,"Name":"dreamweddings","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"2.216.11.165","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79609,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"318a5af56c6b1a0a777bb70017f2aea6","RawContent":"Thanks @[member=\"dreamweddings\"], it does make sense to go with parents I guess [emoji4] \n\n\nMoon Palace Cancun Bride, April 2016","Attachments":[],"Id":1905361,"PostDate":1443113537,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks @<a hovercard-ref=\"member\" hovercard-id=\"250090\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/250090-dreamweddings\/' title='Member profile'><span itemprop=\"name\">dreamweddings<\/span><\/a>, it does make sense to go with parents I guess [emoji4] <br><br>\nMoon Palace Cancun Bride, April 2016\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ricardoandkershia@hotmail.com","IpAddress":"82.16.59.180","GroupId":39,"GroupName":"Newbie","JoinDate":1420500004,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"SunshineDreamKay","Id":281615,"Name":"SunshineDreamKay","IsOnline":false}}],"Id":"79609","Title":"Surnames On Wedding Invitation","LastPostDate":1443113537},"Pages":{"TotalItems":5,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
