ewright.netdna-cdn.com\/cdn\/profile\/photo-210316.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"HeidiJ","Id":210316,"Name":"HeidiJ","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26274,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f57031432ca29244437cd55297f7cb01","RawContent":"Heidi... your day is just around the corner! Have you had much contact with the wedding coordinators?","Attachments":[],"Id":505267,"PostDate":1226342355,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Heidi... your day is just around the corner! Have you had much contact with the wedding coordinators?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"frankanddiana2007@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1193859521,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207892.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Diana","Id":207892,"Name":"Diana","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26274,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7d2fde90b3ee18904de8c897a22edfaa","RawContent":"Oh Heidi - you will have to give us all the details when you get back! &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile72.gif\" border=\"0\" alt=\"\" title=\"Smile72\" class=\"inlineimg\" \/&gt;","Attachments":[],"Id":507818,"PostDate":1226553565,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Oh Heidi - you will have to give us all the details when you get back! <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile72.gif\" border=\"0\" alt=\"\" title=\"Smile72\" class=\"inlineimg\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cuteglutes@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1221611284,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211773.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"SBertling","Id":211773,"Name":"SBertling","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26274,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"72d4d44d99d1fc9c5498dba202942234","RawContent":"&lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.elizabethmedina.com\/blog\/2008\/11\/sandos-playacar-destination-wedding-and-trash-the-dress-photo-session-with-tina-and-garrett-in-playa-del-carmen-mexico\/\"&gt;Elizabeth Medina Photography Blog Archive Sandos Playacar Destination Wedding and Trash the Dress Photo Session with Tina and Garrett in Playa del Carmen, Mexico&lt;\/a&gt;\n \n The above link is to a wedding photographed at the Sandos Playacar by Elizabeth Medina.","Attachments":[],"Id":513290,"PostDate":1227087071,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <a href='http:\/\/www.elizabethmedina.com\/blog\/2008\/11\/sandos-playacar-destination-wedding-and-trash-the-dress-photo-session-with-tina-and-garrett-in-playa-del-carmen-mexico\/' class='bbc_url' title='External link' rel='nofollow external'>Elizabeth Medina Photography Blog Archive Sandos Playacar Destination Wedding and Trash the Dress Photo Session with Tina and Garrett in Playa del Carmen, Mexico<\/a><br \/> <br \/> The above link is to a wedding photographed at the Sandos Playacar by Elizabeth Medina.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"barbaraannh@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1220437428,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211531.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"bah9358","Id":211531,"Name":"bah9358","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26274,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"baddfd9e202851b5beea8e92694178e5","RawContent":"I&#039;m getting married there June 20, 2009. I&#039;m so glad there is a Sandos forum! I am getting SOOO frustrated because the correspondence back and forth hasn&#039;t been good. The latest thing I&#039;m dealing with is rooms. How are you guys handling it? Do you have a travel agent that when your guests call in then they find the best price? Or did you block rooms? I can&#039;t do this because I have so many people invited AND they are coming in and leaving at different times. HELP!!&lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile124.gif\" border=\"0\" alt=\"\" title=\"Smile124\" class=\"inlineimg\" \/&gt;","Attachments":[],"Id":513465,"PostDate":1227099767,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm getting married there June 20, 2009. I'm so glad there is a Sandos forum! I am getting SOOO frustrated because the correspondence back and forth hasn't been good. The latest thing I'm dealing with is rooms. How are you guys handling it? Do you have a travel agent that when your guests call in then they find the best price? Or did you block rooms? I can't do this because I have so many people invited AND they are coming in and leaving at different times. HELP!!<span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile124.gif\" border=\"0\" alt=\"\" title=\"Smile124\" class=\"inlineimg\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kanakekiss@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1213188364,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209886.gif?_r=0","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"FormattedName":"candiekiss","Id":209886,"Name":"candiekiss","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26274,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3d10b44a4c60c29f4108765b321a260e","RawContent":"Our guests are coming and going at different times too. (my aunt and uncle are actuallly going to be there before us and leave after us!) Our travel agent let the resort know that we will be a group for the wedding but that is pretty much it. I plan on keeping track of when everyone is arriving and leaving and trying to meet them when they arrive. I am also going to pick a day that everyone is there and try to do a group excursion. So really, we are flying by the seat of our pants!","Attachments":[],"Id":513771,"PostDate":1227133998,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Our guests are coming and going at different times too. (my aunt and uncle are actuallly going to be there before us and leave after us!) Our travel agent let the resort know that we will be a group for the wedding but that is pretty much it. I plan on keeping track of when everyone is arriving and leaving and trying to meet them when they arrive. I am also going to pick a day that everyone is there and try to do a group excursion. So really, we are flying by the seat of our pants!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"frankanddiana2007@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1193859521,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207892.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Diana","Id":207892,"Name":"Diana","IsOnline":false}}],"Pages":{"TotalItems":1094,"TotalPages":110,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":1090},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}