{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.99.50.82","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80055,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"2ccba94c0f9d2d0bf6ccd23abe3fc245","RawContent":"When&#039;s your wedding? Where is your wedding? Where are you in your time line?","Attachments":[],"Id":1913089,"PostDate":1461581847,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                When's your wedding? Where is your wedding? Where are you in your time line?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"wonderlandgrl3@yahoo.com","IpAddress":"75.99.50.82","GroupId":40,"GroupName":"Jr. Member","JoinDate":1407859786,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279411.jpg?_r=1408152053","PhotoWidth":200,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Mangosong","Id":279411,"Name":"Mangosong","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.202.203.126","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80055,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"4bfa1d8514701236c53c461fa11fe250","RawContent":"&lt;p&gt;Hi @[member=\"Mangosong\"]! I&#039;m a 2017 bride! My wedding is on April 23. I&#039;ll be getting married at the Hyatt Ziva in Montego Bay, Jamaica. So far most everything has been booked. I have paid for the room block, booked my photographer, and my travel agent is currently working on our site for our guests book their rooms, our wedding website is pretty much done, just waiting on the room block site to be live so I can add that link to it.&lt;\/p&gt;\n&lt;p&gt;I am in the process of working on my save the dates, I hope to get them out within the next 2-3 weeks.&lt;\/p&gt;","Attachments":[],"Id":1913090,"PostDate":1461584791,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi @<a hovercard-ref=\"member\" hovercard-id=\"279411\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/279411-mangosong\/' title='Member profile'><span itemprop=\"name\">Mangosong<\/span><\/a>! I'm a 2017 bride! My wedding is on April 23. I'll be getting married at the Hyatt Ziva in Montego Bay, Jamaica. So far most everything has been booked. I have paid for the room block, booked my photographer, and my travel agent is currently working on our site for our guests book their rooms, our wedding website is pretty much done, just waiting on the room block site to be live so I can add that link to it.<\/p>\n<p>I am in the process of working on my save the dates, I hope to get them out within the next 2-3 weeks.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"townsendsmithwed@gmail.com","IpAddress":"173.66.3.166","GroupId":39,"GroupName":"Newbie","JoinDate":1427028004,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282503.jpeg?_r=1462490971","PhotoWidth":200,"PhotoHeight":199,"PhotoType":"custom"},"FormattedName":"tiffanyt","Id":282503,"Name":"tiffanyt","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.99.50.82","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80055,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"325a5b5e8ac201777c6a050f4d0f1c56","RawContent":"&lt;p&gt;@[member=\"tiffanyt\"] Hi!&lt;\/p&gt;\n&lt;p&gt;Eep! I feel like I&#039;m a little behind! Our wedding is March 20th at the westin playa conchal. I need to pay for my room block. But I&#039;m waiting on our contract and my travel agent is away until May 3rd. Our wedding website is done except for the rooms\/pricing. Our STDs hopefully go out this week. Need to book my photographer asap!!!&lt;\/p&gt;","Attachments":[],"Id":1913093,"PostDate":1461585185,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"282503\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282503-tiffanyt\/' title='Member profile'><span itemprop=\"name\">tiffanyt<\/span><\/a> Hi!<\/p>\n<p>Eep! I feel like I'm a little behind! Our wedding is March 20th at the westin playa conchal. I need to pay for my room block. But I'm waiting on our contract and my travel agent is away until May 3rd. Our wedding website is done except for the rooms\/pricing. Our STDs hopefully go out this week. Need to book my photographer asap!!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"wonderlandgrl3@yahoo.com","IpAddress":"75.99.50.82","GroupId":40,"GroupName":"Jr. Member","JoinDate":1407859786,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279411.jpg?_r=1408152053","PhotoWidth":200,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Mangosong","Id":279411,"Name":"Mangosong","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.184.166.142","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80055,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f751324df3993f936ee732e1243eea4d","RawContent":"Hello all I just got engaged and our goal is to have a wedding in Cabo \n\nWe want the Rui palace but we just found out they will be closed 8\/16-12\/16 for renovation. The Gazebo we want may not be available... They can&#039;t guarantee it! Ugh\n\nAny other suggestions?!?!?","Attachments":[],"Id":1913110,"PostDate":1461625991,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hello all I just got engaged and our goal is to have a wedding in Cabo <br>\nWe want the Rui palace but we just found out they will be closed 8\/16-12\/16 for renovation. The Gazebo we want may not be available... They can't guarantee it! Ugh<br>\nAny other suggestions?!?!?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"marablanza@aol.com","IpAddress":"166.137.246.27","GroupId":39,"GroupName":"Newbie","JoinDate":1461602492,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286810.jpg?_r=1463707701","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"MaraO","Id":286810,"Name":"MaraO","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.161.145.102","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80055,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d90217a8d4c83715460c0ede4dc1bdd9","RawContent":"I&#039;m a 2017 bride as well with my date being January 21st. We booked the Grand Sirenis Riviera Maya. I&#039;m full force planning mode as we just passed our deposit date for our guests to book their spot. So far we have 48 guests attending. \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1913137,"PostDate":1461708585,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm a 2017 bride as well with my date being January 21st. We booked the Grand Sirenis Riviera Maya. I'm full force planning mode as we just passed our deposit date for our guests to book their spot. So far we have 48 guests attending. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"setteewedding@gmail.com","IpAddress":"207.161.145.102","GroupId":39,"GroupName":"Newbie","JoinDate":1456262677,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286318.jpg?_r=1456278648","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"WPGBride17","Id":286318,"Name":"WPGBride17","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.5.177.164","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80055,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"d18eccf7ad6ab8d8d9508d77898d5575","RawContent":"My date is May 19, 2017. We chose to switch after some original planning to Majestic Elegance Punta Cana from Hard Rock Punta Cana. HR wasn&#039;t communicating all that well and their pricing kept going up with extra charges.\n\nMajestic has been a breeze and they are answering every email that day or by noon the next. \n\n\nWe are waiting to do the block and booking until July when flights are available... This is after many talks with our guests who won&#039;t commit until the full price is available and not only hotel.  So I told my fiance we can just make our deposit due date labor day. We will be sending out STD this month that will have info for the website. Time is moving quick!!","Attachments":[],"Id":1913302,"PostDate":1462330457,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                My date is May 19, 2017. We chose to switch after some original planning to Majestic Elegance Punta Cana from Hard Rock Punta Cana. HR wasn't communicating all that well and their pricing kept going up with extra charges.<br>\nMajestic has been a breeze and they are answering every email that day or by noon the next. <br><br>\nWe are waiting to do the block and booking until July when flights are available... This is after many talks with our guests who won't commit until the full price is available and not only hotel.  So I told my fiance we can just make our deposit due date labor day. We will be sending out STD this month that will have info for the website. Time is moving quick!! \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"aparke10@gmail.com","IpAddress":"50.5.177.164","GroupId":39,"GroupName":"Newbie","JoinDate":1456549152,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286351.jpg?_r=1469445427","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"Aparke10","Id":286351,"Name":"Aparke10","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.147.88.241","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80055,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"0886041b8e5de08ea62a66f859400236","RawContent":"&lt;p&gt;Hi!! My wedding is May 13 at Hyatt zilara in jamaica. So far the save the dates will e out next week. Im in the process of booking a photographer ( the group i want to go with seem to be on island time =p) Room blocks are done and wedding website up!&lt;\/p&gt;","Attachments":[],"Id":1913683,"PostDate":1463072898,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi!! My wedding is May 13 at Hyatt zilara in jamaica. So far the save the dates will e out next week. Im in the process of booking a photographer ( the group i want to go with seem to be on island time =p) Room blocks are done and wedding website up!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kcusack89@gmail.com","IpAddress":"96.245.61.215","GroupId":39,"GroupName":"Newbie","JoinDate":1460394513,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286706.jpg?_r=1463087234","PhotoWidth":200,"PhotoHeight":198,"PhotoType":"facebook"},"FormattedName":"Kcusack89","Id":286706,"Name":"Kcusack89","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.35.43.137","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80055,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6295c78214184669e4deb7d04fda31c9","RawContent":"&lt;p&gt;@[member=\"MaraO\"] good luck! Are you looking for an all inclusive? Adults only?&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;@[member=\"Kcusack89\"] The vendors being on \"island time\" is one of my biggest issues. Getting a response from the wedding coordinator... My photographer... My DJ is pretty on top of things (so far), but we can&#039;t give him answers until the coordinator gets back to us!&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Our STDs went out and our travel agent is supposed to update our website on monday with the pricing, etc.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;My invites are decided on except the font.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1913741,"PostDate":1463337095,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"286810\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/286810-marao\/' title='Member profile'><span itemprop=\"name\">MaraO<\/span><\/a> good luck! Are you looking for an all inclusive? Adults only?\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"286706\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/286706-kcusack89\/' title='Member profile'><span itemprop=\"name\">Kcusack89<\/span><\/a> The vendors being on \"island time\" is one of my biggest issues. Getting a response from the wedding coordinator... My photographer... My DJ is pretty on top of things (so far), but we can't give him answers until the coordinator gets back to us!\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Our STDs went out and our travel agent is supposed to update our website on monday with the pricing, etc.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>My invites are decided on except the font.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"wonderlandgrl3@yahoo.com","IpAddress":"75.99.50.82","GroupId":40,"GroupName":"Jr. Member","JoinDate":1407859786,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279411.jpg?_r=1408152053","PhotoWidth":200,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Mangosong","Id":279411,"Name":"Mangosong","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"189.149.98.29","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80055,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4e3a718f86b83ea4f8ce8888d8c2d82f","RawContent":"&lt;p&gt;@[member=\"tiffanyt\"] Congrats!!!&lt;\/p&gt;\n&lt;p&gt;We know you had your photographer &amp;nbsp;but if &amp;nbsp;we can help you with trash the dress or videography, we will be glad.&lt;\/p&gt;\n&lt;div&gt;[sharedmedia=gallery:albums:18203]&lt;\/div&gt;","Attachments":[],"Id":1914435,"PostDate":1466164361,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"282503\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282503-tiffanyt\/' title='Member profile'><span itemprop=\"name\">tiffanyt<\/span><\/a> Congrats!!!<\/p>\n<p>We know you had your photographer \u00a0but if \u00a0we can help you with trash the dress or videography, we will be glad.<\/p>\n<div><div class='_sharedMediaBbcode'>\n\t<div class='bbcode_mediaWrap clearfix'>\n\t\t<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/album\/18203-jamaica\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_18203\/tn_gallery_287113_18203_1056790.jpg' class='sharedmedia_screenshot cover_img_75' title='jam2'  width='75' height='75'  alt='jam2' id='tn_image_view_83640_cover' \/><\/a>\n\t\t<div class='details'>\n\t\t\t<h5><a href='http:\/\/www.bestdestinationwedding.com\/gallery\/album\/18203-jamaica\/' class='bbc_url' title=''>Album: Jamaica<\/a><\/h5>\n\t\t\t<div>15 images<\/div>\n\t\t\t<div>0 comments<\/div>\n\t\t<\/div>\n\t<\/div>\n<\/div>\n<br \/><\/div>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span>Saludos<\/span><\/p>\n<p><span><b>Virginia Hermosillo<\/b><\/span><\/p>\n<p><b>Dream Art \u00a0Wedding Photography<\/b><\/p>\n<p><span><span>contact<a data-ipb='nomediaparse' href='mailto:vhermosillo@dreamartphotography.com'>@dreamartphotography.com<\/a><\/span><\/span><\/p>\n<p><span>Tel: +(52) 998 246-5657<\/span><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/weddings.dreamartphotography.com'>http:\/\/weddings.dreamartphotography.com<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><img src=\"http:\/\/weddings.dreamartphotography.com\/images\/wedding-logo-moto.png\" alt=\"wedding-logo-moto.png\"><\/p>\n<p><span>\u00a0<\/span>","Email":"contact@dreamartphotography.com","IpAddress":"189.221.43.89","GroupId":49,"GroupName":"Insiders","JoinDate":1465480401,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-287113.jpg?_r=1469625864","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"DreamArtPhotography","Id":287113,"Name":"DreamArtPhotography","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.33.206.197","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80055,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8818fadd5a0c42ab98c79ca6771cbac6","RawContent":"&lt;p&gt;Videographer, photographer, entertainment, resort, notary, wedding coordinator and travel agent booked. &amp;nbsp;Now having major issues on relaying the info to my guests need a reliable FREE website.&lt;\/p&gt;\n\n&lt;p&gt;@mention&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;how did you do your website, what company did you go with and how much did it cost? &amp;nbsp;We attempt to use WIX spent 2 months entering info, uploading pic and lost everything....someone then suggested Wordpress and did not have much luck either....so need help &amp;nbsp;since everything is confirmed we just need to relay info to guests somehow.&lt;\/p&gt;","Attachments":[],"Id":1914530,"PostDate":1466668277,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Videographer, photographer, entertainment, resort, notary, wedding coordinator and travel agent booked. \u00a0Now having major issues on relaying the info to my guests need a reliable FREE website.<\/p>\n<br \/><p>@mention<\/p>\n<p>\u00a0how did you do your website, what company did you go with and how much did it cost? \u00a0We attempt to use WIX spent 2 months entering info, uploading pic and lost everything....someone then suggested Wordpress and did not have much luck either....so need help \u00a0since everything is confirmed we just need to relay info to guests somehow.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"fabio.krista2010@yahoo.ca","IpAddress":"173.33.206.197","GroupId":39,"GroupName":"Newbie","JoinDate":1466542634,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Hola20162","Id":287215,"Name":"Hola20162","IsOnline":false}}],"Pages":{"TotalItems":22,"TotalPages":3,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":20},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
