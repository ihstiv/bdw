\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"><\/span>\u00a0\u00a0 \u00a0<span><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><\/span><br><span style=\"color:rgb(0,128,128);\"><strong><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010\" title=\"\">Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><strong><span style=\"color:rgb(178,34,34);\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a  class=\"bbc_url\" href=\"mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com\" title=\"External link\">ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"trisha@wrighttravelagency.com","IpAddress":"12.24.226.126","GroupId":46,"GroupName":"VIP Member","JoinDate":1171995300,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207201.jpg?_r=1452788764","PhotoWidth":200,"PhotoHeight":296,"PhotoType":"custom"},"FormattedName":"TATrisha","Id":207201,"Name":"TATrisha","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":66415,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9b4a00727e8747e56e44dbf593ce81a8","RawContent":"&lt;p&gt; &lt;strong&gt;&lt;span style=\"font-size: 12px\"&gt;Details - &lt;\/span&gt;&lt;\/strong&gt;&lt;span style=\"font-size: 12px\"&gt;if you uncover some other random expenses or options, please PM or email me!&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;The wedding canopy is 2 meters per side (approximately 6 ft x 6 ft)&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Walkway can be red or white to Pergola&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;3 foot long sparklers $5 per sparkler.&amp;nbsp; Small metal ones $3\/6&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Projector for slideshow $300&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Welcome bag distribution $2-3 a bag&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;$40 for dress cleaning (after TTD session!)&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;20 minutes from Playa Del Carmen, 15 minutes from Cancun&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Daily van from the resort takes you into town for $1 a person&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Chair bows $5 each, if you bring your own there is a $1 iron fee&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;White tiffany chairs $9&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Brown tiffany chairs $7&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Fire dancers $1,000 a performance&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Excursion contact alex.orozco@yourcancundmc.com , her name is Alejandra&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Day Pass $55 per persona&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1595159,"PostDate":1331759394,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n 