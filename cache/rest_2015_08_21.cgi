ail.com","IpAddress":"199.180.174.8","GroupId":3,"GroupName":"Member","JoinDate":1395332214,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277264.jpg?_r=1429937323","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"kcole123","Id":277264,"Name":"kcole123","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.196.202.228","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71,"EditedBy":"","EditDate":1412260499,"EditReason":"","DeleteDate":0,"TotalLikes":5,"IsLiked":false,"PostKey":"2d3a7ae4645834e6b697ce9d9e287e95","RawContent":"&lt;p&gt;I haven&#039;t been on here in a while! I was unhappy with my original dress that I bought, and am SO happy that I kept looking...I just bought a new dress that I can truly say I am in love with!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;div&gt;[sharedmedia=gallery:images:78535]&lt;\/div&gt;\n&lt;div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:78533]&lt;\/div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:78534]&lt;\/div&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;\/div&gt;","Attachments":[],"Id":1874068,"PostDate":1412260456,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I haven't been on here in a while! I was unhappy with my original dress that I bought, and am SO happy that I kept looking...I just bought a new dress that I can truly say I am in love with!!<\/p>\n<p>\u00a0<\/p>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a hr