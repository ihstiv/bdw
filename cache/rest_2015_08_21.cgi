Request Time: 1 seconds
{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"93ed33f21146e3429f49255a0237bc6e","RawContent":"&lt;img src=\"http:\/\/i11.tinypic.com\/2ir9ehf.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n \n This is mine, except the setting is white gold instead of platinum, and the stone is a 1.25 ct radiant cut instead of the princess cut. I really don&#039;t know what band would go with it, since it seems most bands would cover up the scrollwork on the side, and I don&#039;t want to do that!\n \n Of course, I should probably wait until I actually have the ring on my finger before I worry about the band, huh? LOL! I&#039;m hoping it&#039;s this weekend.\n \n Oh, and I totally picked this out myself. I feel kinda bad about that, but not as bad as I knew I would feel if he picked something I didn&#039;t like!","Attachments":[],"Id":5429,"PostDate":1162437205,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <a href='http:\/\/i11.tinypic.com\/2ir9ehf.jpg' class='bbc_url' title='External link' rel='nofollow external'><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i11.tinypic.com\/2ir9ehf.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><\/a><br \/> <br \/> <br \/> This is mine, except the setting is white gold instead of platinum, and the stone is a 1.25 ct radiant cut instead of the princess cut. I really don't know what band would go with it, since it seems most bands would cover up the scrollwork on the side, and I don't want to do that!<br \/> <br \/> Of course, I should probably wait until I actually have the ring on my finger before I worry about the band, huh? LOL! I'm hoping it's this weekend.<br \/> <br \/> Oh, and I totally picked this out myself. I feel kinda bad about that, but not as bad as I knew I would feel if he picked something I didn't like!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"caroljohnston_2000@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1161815371,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206870.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"carolj","Id":206870,"Name":"carolj","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"46ca1b7fa539584798dab72ac270de29","RawContent":"Jackie and Tasha - I also loooooove the cushion cut! And Sarah - I love all the little detailing in your ring. I am totally a sucker for anything that looks romantic\/antique I guess.\n \n And I finally took a good pic of my e-ring and band together. I can&#039;t wait to finally wear them both!\n \n &lt;img src=\"http:\/\/static.flickr.com\/101\/290082520_9994c19570_m.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;","Attachments":[],"Id":6163,"PostDate":1162842964,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Jackie and Tasha - I also loooooove the cushion cut! And Sarah - I love all the little detailing in your ring. I am totally a sucker for anything that looks romantic\/antique I guess.<br \/> <br \/> And I finally took a good pic of my e-ring and band together. I can't wait to finally wear them both!<br \/> <br \/> <a href='http:\/\/static.flickr.com\/101\/290082520_9994c19570_m.jpg' class='bbc_url' title='External link' rel='nofollow external'><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/static.flickr.com\/101\/290082520_9994c19570_m.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><\/a>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"janet.daly@gmail.com","IpAddress":"71.33.145.106","GroupId":46,"GroupName":"VIP Member","JoinDate":1138253340,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206713.jpg?_r=0","PhotoWidth":200,"PhotoHeight":288,"PhotoType":"custom"},"FormattedName":"Janet","Id":206713,"Name":"Janet","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5ee216e53a048e3d8d868bcc136a781b","RawContent":"&lt;img src=\"http:\/\/i83.photobucket.com\/albums\/j286\/caboweddingforum\/MBP_6975.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n Here is a picture of mine from when we did our pictures in Cabo with Manuel Burgoin. It is a oval center stone with a pear on each side. I love it!!! I don&#039;t think we will be able to have a band that will work with it since the shape is different than normal - I have had people tell me they can make something but I am afraid it would take away from the stones and overall look of the ring. Maybe I can convince FI to get me a ring for my other hand - fat chance!!!\n \n On a side note - I found his ring and COSTCO and paid $1800 for it. It is platnum and has 8 or 9 rund stones in it - very pretty but not something I would ever picture him liking! He really showed no interest in shopping for a ring so since we were there I had him try one on - I got it with the thought that he might become more interested in shopping for a ring if he saw I was going to buy one and he might get stuck with it (I know COSTCO will take anything back so I wasn&#039;t really concerned.) Well that was last Tuesday and he has yet to take the ring off! I told him that he wasn&#039;t suppost to wear the ring until we get married and he said that since I get to wear my ring he should get to wear his too! Kinda cute but not at all what I expected from him! I guess this is the ring he is going to end up with afterall!","Attachments":[],"Id":8068,"PostDate":1163956926,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <a href='http:\/\/i83.photobucket.com\/albums\/j286\/caboweddingforum\/MBP_6975.jpg' class='bbc_url' title='External link' rel='nofollow external'><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i83.photobucket.com\/albums\/j286\/caboweddingforum\/MBP_6975.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><\/a><br \/> <br \/> Here is a picture of mine from when we did our pictures in Cabo with Manuel Burgoin. It is a oval center stone with a pear on each side. I love it!!! I don't think we will be able to have a band that will work with it since the shape is different than normal - I have had people tell me they can make something but I am afraid it would take away from the stones and overall look of the ring. Maybe I can convince FI to get me a ring for my other hand - fat chance!!!<br \/> <br \/> On a side note - I found his ring and COSTCO and paid $1800 for it. It is platnum and has 8 or 9 rund stones in it - very pretty but not something I would ever picture him liking! He really showed no interest in shopping for a ring so since we were there I had him try one on - I got it with the thought that he might become more interested in shopping for a ring if he saw I was going to buy one and he might get stuck with it (I know COSTCO will take anything back so I wasn't really concerned.) Well that was last Tuesday and he has yet to take the ring off! I told him that he wasn't suppost to wear the ring until we get married and he said that since I get to wear my ring he should get to wear his too! Kinda cute but not at all what I expected from him! I guess this is the ring he is going to end up with afterall!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><strong>Sarah's little girl-Isabella Nicole-10\/31\/08<\/strong><br><a data-ipb='nomediaparse' href=\"http:\/\/i83.photobucket.com\/albums\/j286\/caboweddingforum\/isabella034.jpg\">http:\/\/i83.photobucket.com\/albums\/j2...sabella034.jpg<\/a><\/div><\/div>","Email":"sarahseay@sbcglobal.net","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1143847500,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206730.gif?_r=0","PhotoWidth":75,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"SASSYGIRL","Id":206730,"Name":"SASSYGIRL","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"156ecf9e1bd05fa5f4e0c04a13d7fa99","RawContent":"Here&#039;s mine! &lt;img src=\"http:\/\/www.pricescope.com\/idealbb\/files\/anillo02.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;","Attachments":[],"Id":8075,"PostDate":1163965255,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Here's mine! <a href='http:\/\/www.pricescope.com\/idealbb\/files\/anillo02.jpg' class='bbc_url' title='External link' rel='nofollow external'><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/www.pricescope.com\/idealbb\/files\/anillo02.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><\/a>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>- Anny.<\/span><br><br><a data-ipb='nomediaparse' href=\"http:\/\/i75.photobucket.com\/albums\/i284\/anacristina_ge\/Biz\/bdwsiggy.jpg\">http:\/\/i75.photobucket.com\/albums\/i2...z\/bdwsiggy.jpg<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/www.passportinvitations.com\">www.passportinvitations.com<\/a><span> <\/span><a data-ipb='nomediaparse' href=\"http:\/\/www.anaderoux.com\">My webpage<\/a><span> <\/span><a data-ipb='nomediaparse' href=\"http:\/\/anaderoux.blogspot.com\">My blog<\/a><span> <\/span><a data-ipb='nomediaparse' href=\"http:\/\/global.thebump.com\/tickers\/tt8b0dc.aspx\">http:\/\/global.thebump.com\/tickers\/tt8b0dc.aspx<\/a><\/div><\/div>","Email":"anacristina_ge@hotmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1163924520,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/d\/d1\/d1295c45_user-674-avatar?_r=0","PhotoWidth":180,"PhotoHeight":120,"PhotoType":"custom"},"FormattedName":"anaderoux","Id":206916,"Name":"anaderoux","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"faf97d3ad27ad2941cf50f7846aa3148","RawContent":"Hey, I finally get to post a *real* picture of my ring here! Scott officially proposed Saturday night.\n \n &lt;img src=\"http:\/\/i7.tinypic.com\/4hwf6a8.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n &lt;img src=\"http:\/\/i10.tinypic.com\/48rq8n6.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n I&#039;m like a little girl - I can&#039;t help but look at it in every possible light to see just how sparkly it is!\n \n P.S. Sorry for the huge pics! I don&#039;t know how to resize them to make them smaller.","Attachments":[],"Id":8189,"PostDate":1164032588,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hey, I finally get to post a *real* picture of my ring here! Scott officially proposed Saturday night.<br \/> <br \/> <a href='http:\/\/i7.tinypic.com\/4hwf6a8.jpg' class='bbc_url' title='External link' rel='nofollow external'><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i7.tinypic.com\/4hwf6a8.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><\/a><br \/> <br \/> <a href='http:\/\/i10.tinypic.com\/48rq8n6.jpg' class='bbc_url' title='External link' rel='nofollow external'><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i10.tinypic.com\/48rq8n6.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><\/a><br \/> <br \/> I'm like a little girl - I can't help but look at it in every possible light to see just how sparkly it is!<br \/> <br \/> P.S. Sorry for the huge pics! I don't know how to resize them to make them smaller.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"caroljohnston_2000@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1161815371,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206870.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"carolj","Id":206870,"Name":"carolj","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":254,"EditedBy":"","Edit