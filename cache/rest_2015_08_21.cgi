stdestinationwedding.com\/index.php?app=core&amp;amp;module=attach&amp;amp;section=attach&amp;amp;attach_rel_module=post&amp;amp;attach_id=30350\"]ImageUploadedByTapatalk1420764761.667994.jpg[\/url]\n\n\nFinally found my dress! Yay!\n\n\nSent from my iPhone using Tapatalk[\/quote]\n@[member=\"pykx82\"] - this dress is gorgeous. will work for so many locations! \n[quote name=\"pykx82\" post=\"1882413\" timestamp=\"1420838629\"]\nSo far the ONLY thing I&#039;ve decided on for the wedding is my dress, haha.\n\n[url=\"http:\/\/www.maggiesottero.com\/dress.aspx?style=5MS162&amp;amp;page=0&amp;amp;pageSize=36&amp;amp;keywordText=&amp;amp;keywordType=All\"]http:\/\/www.maggiesottero.com\/dress.aspx?style=5MS162&amp;amp;page=0&amp;amp;pageSize=36&amp;amp;keywordText=&amp;amp;keywordType=All[\/url][\/quote]","Attachments":[],"Id":1882434,"PostDate":1420835251,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"278186\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/278186-helenk\/' title='Member profile'><span itemprop=\"name\">helenk<\/span><\/a> - beautiful dress!!!\u00a0<\/p>\n<p>\u00a0<\/p>\n<p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>helenk, on 08 January 2015 - 08:53 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Sorry I totally just saw this! Hadn't been on here in a while and I don't get notifications on my phone when I get replies for some reason. I started dress shopping last month and I found my dress this week!<br><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif\" alt=\"attachicon.gif\"><\/span><a href='http:\/\/www.bestdestinationwedding.com\/index.php?app=core&module=attach&section=attach&attach_rel_module=post&attach_id=30350' class='bbc_url' title=''>ImageUploadedByTapatalk1420764761.667994.jpg<\/a><br><br><br>\nFinally found my dress! Yay!<br><br><br>\nSent from my iPhone using Tapatalk<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"281560\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281560-pykx82\/' title='Member profile'><span itemprop=\"name\">pykx82<\/span><\/a> - this dress is gorgeous. will work for so many locations!\u00a0<\/p>\n<p>\u00a0<\/p>\n<p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>pykx82, on 09 January 2015 - 05:23 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>So far the ONLY thing I've decided on for the wedding is my dress, haha.<\/p>\n<p>\u00a0<\/p>\n<p><a href='http:\/\/www.maggiesottero.com\/dress.aspx?style=5MS162&page=0&pageSize=36&keywordText=&keywordType=All' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.maggiesot...keywordType=All<\/a><\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<br><p><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div>\u00a0<\/div>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/73076-official-el-dorado-royaleel-dorado-casitas-royale-thread\/'>Official El Dorado Royale\/El Dorado Casitas Royale Thread<\/a>\u00a0<---check here for all info about EDR\/EDCR<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'>Wright Travel Agency<\/a> <--for all your Destination Wedding needs! Contact the experts and reduce your stress.\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/5182-el-dorado-royale-edr-brides-post-here\/'>El Dorado Royale Brides Thread<\/a> <---come chat with other EDR brides<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/69372-allie-hs-edr-rm-mexico-11-5-2012-planning-thread\/'>AllieH's EDR 11-5-2012 Planning Thread<\/a> <--because it was so awesome","Email":"allisonmoore817@gmail.com","IpAddress":"75.20.174.181","GroupId":55,"GroupName":"Resort\/Area Ambassadors","JoinDate":1309643480,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-241884.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"AllieH","Id":241884,"Name":"AllieH","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"198.163.47.9","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3c1365e80a97877c0fddeec715b26e5e","RawContent":"&lt;p&gt;@[member=\"AllieH\"] Thanks! &amp;nbsp;I can&#039;t wait for it to come in so I can actually try it on in my size. &amp;nbsp;Now if only our travel agent would get back to us with our group rate so we could do some legit planning...&lt;\/p&gt;","Attachments":[],"Id":1882616,"PostDate":1421059666,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"241884\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/241884-allieh\/' title='Member profile'><span itemprop=\"name\">AllieH<\/span><\/a> Thanks! \u00a0I can't wait for it to come in so I can actually try it on in my size. \u00a0Now if only our travel agent would get back to us with our group rate so we could do some legit planning...<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"slfehr@outlook.com","IpAddress":"24.114.26.10","GroupId":39,"GroupName":"Newbie","JoinDate":1420208577,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"pykx82","Id":281560,"Name":"pykx82","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"170.115.248.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3539f2b60cd268f5b2bc1405a6dc78ba","RawContent":"&lt;p&gt;Anyone interested in a Maggie Sottero Divina sz 12? I fell in love with Maggie Sottero Marianne this weekend.&lt;\/p&gt;","Attachments":[],"Id":1883511,"PostDate":1421773815,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Anyone interested in a Maggie Sottero Divina sz 12? I fell in love with Maggie Sottero Marianne this weekend.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"So far 41 guests + bride and groom + 10 kids = 95 room nights.    Focused on planning without stressing.","Email":"bush.chanel@gmail.com","IpAddress":"170.115.248.23","GroupId":40,"GroupName":"Jr. Member","JoinDate":1401288470,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"TheBHolders","Id":278146,"Name":"TheBHolders","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"143.58.161.6","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":3,"IsLiked":false,"PostKey":"ed2f76f955553c2e98c5bed5b8371fef","RawContent":"&lt;p&gt;I actually just posted this on another dress forum, and just saw this one, too...&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I ended up going with something more formal than I had thought I wanted, but it&#039;s still flowy and beachy. When I put it on, I just loved it and felt comfortable. I, personally, am not a fan of satin, so I knew I didn&#039;t want to go that route. Also, I have a large chest, so I knew I didn&#039;t want strapless. This dress has a nice little train too. I also have a mid-length veil with subtle silver beading along the edge and the flower clip for my hair (the beading and stitching is more silver in person). (I have long hair but I plan to wear it back in a loose bun of some sort.) Then I have my glitter shoes (!!!!), which I&#039;ll be wearing for the reception.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;The short dress is my \"back-up\" dress. I am trying to be realistic in thinking that I might get overheated being in my dress for 6+ hours, so I wanted to get a cute white dress that I could change into, if need be, and still look like the bride. This one was very reasonably priced, so it was worth it to me to at least have it. I might get a glitzy belt\/sash for it.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;div&gt;[sharedmedia=gallery:images:79858]&lt;\/div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:79859]&lt;\/div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:79860]&lt;\/div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:79861]&lt;\/div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:79862]&lt;\/div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:79863]&lt;\/div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:79864]&lt;\/div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:79865]&lt;\/div&gt;","Attachments":[],"Id":1883771,"PostDate":1421949198,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I actually just posted this on another dress forum, and just saw this one, too...<\/p>\n<p>\u00a0<\/p>\n<p>I ended up going with something more formal than I had thought I wanted, but it's still flowy and beachy. When I put it on, I just loved it and felt comfortable. I, personally, am not a fan of satin, so I knew I didn't want to go that route. Also, I have a large chest, so I knew I didn't want strapless. This dress has a nice little train too. I also have a mid-length veil with subtle silver beading along the edge and the flower clip for my hair (the beading and stitching is more silver in person). (I have long hair but I plan to wear it back in a loose bun of some sort.) Then I have my glitter shoes (!!!!), which I'll be wearing for the reception.<\/p>\n<p>\u00a0<\/p>\n<p>The short dress is my \"back-up\" dress. I am trying to be realistic in thinking that I might get overheated being in my dress for 6+ hours, so I wanted to get a cute white dress that I could change into, if need be, and still look like the bride. This one was very reasonably priced, so it was worth it to me to at least have it. I might get a glitzy belt\/sash for it.<\/p>\n<p>\u00a0<\/p>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/79858-1\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17950\/sml_gallery_278395_17950_41064.png' class='galattach galimageview sharedmedia_screenshot' title='1'  width='143' height='200'  alt='1' id='sml_image_view_79858' \/><\/a>\n<br \/><\/div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/79859-2\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17950\/sml_gallery_278395_17950_32926.png' class='galattach galimageview sharedmedia_screenshot' title='2'  width='118' height='200'  alt='2' id='sml_image_view_79859' \/><\/a>\n<br \/><\/div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/79860-3\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17950\/sml_gallery_278395_17950_3292.png' class='galattach galimageview sharedmedia_screenshot' title='3'  width='134' height='200'  alt='3' id='sml_image_view_79860' \/><\/a>\n<br \/><\/div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/79861-4\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17950\/sml_gallery_278395_17950_137666.png' class='galattach galimageview sharedmedia_screenshot' title='4'  width='150' height='200'  alt='4' id='sml_image_view_79861' \/><\/a>\n<br \/><\/div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/79862-5\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17950\/sml_gallery_278395_17950_4907.png' class='galattach galimageview sharedmedia_screenshot' title='5'  width='169' height='200'  alt='5' id='sml_image_view_79862' \/><\/a>\n<br \/><\/div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/79863-6\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17950\/sml_gallery_278395_17950_27314.png' class='galattach galimageview sharedmedia_screenshot' title='6'  width='136' height='200'  alt='6' id='sml_image_view_79863' \/><\/a>\n<br \/><\/div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/79864-7\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17950\/sml_gallery_278395_17950_90057.png' class='galattach galimageview sharedmedia_screenshot' title='7'  width='140' height='200'  alt='7' id='sml_image_view_79864' \/><\/a>\n<br \/><\/div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/79865-8\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17950\/sml_gallery_278395_17950_37675.png' class='galattach galimageview sharedmedia_screenshot' title='8'  width='134' height='200'  alt='8' id='sml_image_view_79865' \/><\/a>\n<br \/><\/div>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jhowe114@gmail.com","IpAddress":"38.98.131.98","GroupId":40,"GroupName":"Jr. Member","JoinDate":1402411989,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278395.jpg?_r=1421871115","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"JenniferH114","Id":278395,"Name":"JenniferH114","IsOnline":false}}],"Pages":{"TotalItems":8285,"TotalPages":829,"CurrentPage":8180,"NextPage":8190,"PreviousPage":8170,"LastPage":8280},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
