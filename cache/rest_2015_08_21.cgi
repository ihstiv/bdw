 for a ines di santo I see one seller but he cannot provide the pictures of the actual dress to see the quality of the lace \ud83d\ude02\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1834739,"PostDate":1392897149,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Did anyone see an off shoulder dress in dhgate? I'm looking for a ines di santo I see one seller but he cannot provide the pictures of the actual dress to see the quality of the lace \ud83d\ude02<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cardenas.carla@gmail.com","IpAddress":"171.159.194.11","GroupId":40,"GroupName":"Jr. Member","JoinDate":1378978345,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"none"},"FormattedName":"Carlicardenas","Id":273425,"Name":"Carlicardenas","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.185.99.211","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"76f7d99560f826e76e5834caced67bf1","RawContent":"&lt;img src=\"http:\/\/img.tapatalk.com\/d\/14\/02\/24\/ymyta7ez.jpg\" alt=\"ymyta7ez.jpg\"&gt;\n\n&lt;img src=\"http:\/\/img.tapatalk.com\/d\/14\/02\/24\/ese5e2et.jpg\" alt=\"ese5e2et.jpg\"&gt;\n\n&lt;img src=\"http:\/\/img.tapatalk.com\/d\/14\/02\/24\/2avyzaga.jpg\" alt=\"2avyzaga.jpg\"&gt;\n\n\nHi ladies! Sorry it took so long- but here they are! Pics of my dress from babyonline. I need to get a crinoline (and some spanks lol) but this is it! Sorry for the bad pic quality. :)\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1835254,"PostDate":1393175935,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/img.tapatalk.com\/d\/14\/02\/24\/ymyta7ez.jpg\" alt=\"ymyta7ez.jpg\"><\/span><br><br><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/img.tapatalk.com\/d\/14\/02\/24\/ese5e2et.jpg\" alt=\"ese5e2et.jpg\"><\/span><br><br><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/img.tapatalk.com\/d\/14\/02\/24\/2avyzaga.jpg\" alt=\"2avyzaga.jpg\"><\/span><br><br>\nHi ladies! Sorry it took so long- but here they are! Pics of my dress from babyonline. I need to get a crinoline (and some spanks lol) but this is it! Sorry for the bad pic quality. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kristinacavanaugh@gmail.com","IpAddress":"204.87.40.1","GroupId":40,"GroupName":"Jr. Member","JoinDate":1369072692,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-269788.jpeg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Tinkerbell82","Id":269788,"Name":"Tinkerbell82","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"184.148.79.60","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"dfdd6f04103d36b68b21972ecaca6080","RawContent":"&lt;p&gt;that&#039;s beautiful!&lt;\/p&gt;","Attachments":[],"Id":1835283,"PostDate":1393191284,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>that's beautiful!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.181.5.152","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"38c2d123bf1f2c830a647c46f83ec21a","RawContent":"Looks GREAT!!","Attachments":[],"Id":1835285,"PostDate":1393195399,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Looks GREAT!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"pinkiesup08@gmail.com","IpAddress":"75.181.5.152","GroupId":47,"GroupName":"Site Supporter","JoinDate":1374599724,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-271841.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"RandL2015","Id":271841,"Name":"RandL2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.181.77.182","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"19ce4cc8ddfabdac87cb30e8369ad1cf","RawContent":"Wow! Looks great! What do you think about the quality of the dress?\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1835290,"PostDate":1393197694,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Wow! Looks great! What do you think about the quality of the dress?<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cardenas.carla@gmail.com","IpAddress":"171.159.194.11","GroupId":40,"GroupName":"Jr. Member","JoinDate":1378978345,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"none"},"FormattedName":"Carlicardenas","Id":273425,"Name":"Carlicardenas","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"184.148.79.60","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a8236091ceccbb5f80b80bb775e09fb8","RawContent":"&lt;p&gt;I have a couple of questions.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I can&#039;t believe the dresses that are on the dressilyme site. I found several of the ones I&#039;ve been looking at - Allure, Maggie Sottero &amp;amp; Essense Designs.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;How are you deciding what to order? Are you trying on dresses first to see what you like? Or just taking a chance on what&#039;s on the website and ordering?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;My wedding dress was very simple. With everything we&#039;ve been through, and still have to get through, if we&#039;re able to do a vow renewal next year I want something that&#039;s going to my his jaw drop. I want drama and bling! I&#039;m torn between 2 styles but like I said, I found several of them on the dressilyme site. Even though the prices are super reasonable, I was thinking I would definitely want to try stuff on before I decide.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Anyone else doing the same thing?&lt;\/p&gt;","Attachments":[],"Id":1835291,"PostDate":1393197770,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I have a couple of questions.<\/p>\n<p>\u00a0<\/p>\n<p>I can't believe the dresses that are on the dressilyme site. I found several of the ones I've been looking at - Allure, Maggie Sottero & Essense Designs.<\/p>\n<p>\u00a0<\/p>\n<p>How are you deciding what to order? Are you trying on dresses first to see what you like? Or just taking a chance on what's on the website and ordering?<\/p>\n<p>\u00a0<\/p>\n<p>My wedding dress was very simple. With everything we've been through, and still have to get through, if we're able to do a vow renewal next year I want something that's going to my his jaw drop. I want drama and bling! I'm torn between 2 styles but like I said, I found several of them on the dressilyme site. Even though the prices are super reasonable, I was thinking I would definitely want to try stuff on before I decide.<\/p>\n<p>\u00a0<\/p>\n<p>Anyone else doing the same thing?<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.185.99.211","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f3a7064d1e710f2d8f906ff2fe095cda","RawContent":"[quote name=\"acw271011\" post=\"1835291\" timestamp=\"1393212170\"]\nI have a couple of questions.\n\nI can&#039;t believe the dresses that are on the dressilyme site. I found several of the ones I&#039;ve been looking at - Allure, Maggie Sottero &amp;amp; Essense Designs.\n\nHow are you deciding what to order? Are you trying on dresses first to see what you like? Or just taking a chance on what&#039;s on the website and ordering?\n\nMy wedding dress was very simple. With everything we&#039;ve been through, and still have to get through, if we&#039;re able to do a vow renewal next year I want something that&#039;s going to my his jaw drop. I want drama and bling! I&#039;m torn between 2 styles but like I said, I found several of them on the dressilyme site. Even though the prices are super reasonable, I was thinking I would definitely want to try stuff on before I decide.\n\nAnyone else doing the same thing?[\/quote]Definitely go try on styles before you order. The style I thought I wanted ended up not being what I ordered because I didn&#039;t like it on me. \n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1835307,"PostDate":1393204653,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>acw271011, on 23 February 2014 - 11:22 PM, said:<\/p><div class='blockquote'><div class='quote'><p>I have a couple of questions.<br><br>\nI can't believe the dresses that are on the dressilyme site. I found several of the ones I've been looking at - Allure, Maggie Sottero & Essense Designs.<br><br>\nHow are you deciding what to order? Are you trying on dresses first to see what you like? Or just taking a chance on what's on the website and ordering?<br><br>\nMy wedding dress was very simple. With everything we've been through, and still have to get through, if we're able to do a vow renewal next year I want something that's going to my his jaw drop. I want drama and bling! I'm torn between 2 styles but like I said, I found several of them on the dressilyme site. Even though the prices are super reasonable, I was thinking I would definitely want to try stuff on before I decide.<br><br>\nAnyone else doing the same thing?<\/p><\/div><\/div>\n<br>\nDefinitely go try on styles before you order. The style I thought I wanted ended up not being what I ordered because I didn't like it on me. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kristinacavanaugh@gmail.com","IpAddress":"204.87.40.1","GroupId":40,"GroupName":"Jr. Member","JoinDate":1369072692,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-269788.jpeg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Tinkerbell82","Id":269788,"Name":"Tinkerbell82","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.222.215.154","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"11376fd38fda541a3dbf9a7996ad50ab","RawContent":"My dress has been shipped!! According to UPS it should arrive on Friday!! I am so nervous and excited!","Attachments":[],"Id":1835755,"PostDate":1393450233,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                My dress has been shipped!! According to UPS it should arrive on Friday!! I am so nervous and excited!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"candle_23@hotmail.com","IpAddress":"66.222.215.154","GroupId":40,"GroupName":"Jr. Member","JoinDate":1375747301,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272291.jpg?_r=1388954341","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"candle23","Id":272291,"Name":"candle23","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"171.159.64.10","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"995b836522e6b72ba83138f0b9b725b3","RawContent":"&lt;p&gt;have you guys heard of &lt;u&gt;bestdavid seller from DHGATE? please let me know :)&lt;\/u&gt;&lt;\/p&gt;","Attachments":[],"Id":1835848,"PostDate":1393509404,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>have you guys heard of <u>bestdavid seller from DHGATE? please let me know <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/u><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cardenas.carla@gmail.com","IpAddress":"171.159.194.11","GroupId":40,"GroupName":"Jr. Member","JoinDate":1378978345,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"none"},"FormattedName":"Carlicardenas","Id":273425,"Name":"Carlicardenas","IsOnline":false}}],"Pages":{"TotalItems":6402,"TotalPages":641,"CurrentPage":6180,"NextPage":6190,"PreviousPage":6170,"LastPage":6400},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
