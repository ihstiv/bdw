Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":26,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":9556,"MovedTo":null,"MovedOn":0,"FirstPostId":1342310,"Rating":0,"RatingHits":0,"Starter":{"Id":233439,"Name":"schayer","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-233439.JPG?_r=0","PhotoWidth":200,"PhotoHeight":149,"PhotoType":"custom"},"IsOnline":false},"StartDate":1290020171,"LastPoster":{"Id":284300,"Name":"rahulthakur01","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":33,"Preview":{"Id":1426816,"PostDate":1301515386,"PostContent":"You are absolutely right, about checking it off the list. \u00a0  \u00a0","Author":{"Signature":"","Email":"traceychung@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1296771657,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-236352.jpeg?_r=0","PhotoWidth":195,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"traceysteve","Id":236352,"Name":"traceysteve","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":58148,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"279481fd009774061c5db1dd7d881d00","RawContent":"&lt;p&gt; We already have our&#039;s picked out and will be purchasing soon, since mine is being custom made. &amp;nbsp;We have the money right now and want to get things checked off the list!&lt;\/p&gt;","Attachments":[],"Id":1362318,"PostDate":1292851905,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> We already have our's picked out and will be purchasing soon, since mine is being custom made. \u00a0We have the money right now and want to get things checked off the list!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lizagehl@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1292185300,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-234570.jpg?_r=0","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"schmizer","Id":234570,"Name":"schmizer","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":58148,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fa4f2ae517fb06fecc2345e8a9332609","RawContent":"&lt;p&gt; It&#039;s really whenever you want to get them like most girls have said.&amp;nbsp; We bought my band about 2 weeks after he proposed, which was 1.5 years ago.&amp;nbsp; FI ordered his band 3 weeks ago and it just came in today actually! Our wedding is May 6.&amp;nbsp; I like to have things checked off the list so I would say the sooner the better just so it&#039;s one more thing you&#039;ll have done.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1362379,"PostDate":1292857668,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> It's really whenever you want to get them like most girls have said.\u00a0 We bought my band about 2 weeks after he proposed, which was 1.5 years ago.\u00a0 FI ordered his band 3 weeks ago and it just came in today actually! Our wedding is May 6.\u00a0 I like to have things checked off the list so I would say the sooner the better just so it's one more thing you'll have done.\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><em>Veronica & Adam - May 6, 2011 - Dreams Tulum<\/em><\/div><\/div>","Email":"watsonvl@my.hiram.edu","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1248538747,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-219820.jpg?_r=0","PhotoWidth":199,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"vlynnw","Id":219820,"Name":"vlynnw","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":58148,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0ef8b22fc95dcdb65940d5312741b9ee","RawContent":"&lt;p&gt; We&#039;re getting married end of June 2011.&amp;nbsp; We were going to buy with all the Christmas sales going on, but finances aren&#039;t exactly great right now, so we&#039;re shooting for the Valentine&#039;s Day sales in February!&lt;\/p&gt;","Attachments":[],"Id":1362388,"PostDate":1292858988,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> We're getting married end of June 2011.\u00a0 We were going to buy with all the Christmas sales going on, but finances aren't exactly great right now, so we're shooting for the Valentine's Day sales in February!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sendscoxemail@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1288254950,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-233554.jpg?_r=0","PhotoWidth":200,"PhotoHeight":266,"PhotoType":"custom"},"FormattedName":"islandbride8","Id":233554,"Name":"islandbride8","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":58148,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"257ede872271f7c0f3ce7fba4d0db70c","RawContent":"&lt;p&gt; You should have them at least a month before your wedding date to prevent any undue stress.&amp;nbsp; But, you should start looking and doing your research about 3-4 months before your wedding date.&amp;nbsp; You probably don&#039;t need 3-4 months to figure out what you want, but usually, if you know what you want, you can wait until there is a holiday and occasion for jewelry stores to hae a sale.&amp;nbsp; then you can save some money and buy them during the sale so you save some money.&amp;nbsp; I guess the saying &amp;quot;The early bird, gets the worm&amp;quot; applies here.&lt;\/p&gt;","Attachments":[],"Id":1378814,"PostDate":1295391589,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> You should have them at least a month before your wedding date to prevent any undue stress.\u00a0 But, you should start looking and doing your research about 3-4 months before your wedding date.\u00a0 You probably don't need 3-4 months to figure out what you want, but usually, if you know what you want, you can wait until there is a holiday and occasion for jewelry stores to hae a sale.\u00a0 then you can save some money and buy them during the sale so you save some money.\u00a0 I guess the saying \"The early bird, gets the worm\" applies here.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"christinebauer51@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1294004349,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-235008.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"christinebauer","Id":235008,"Name":"christinebauer","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":false,"TopicId":58148,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"06679bf1f0c2aedcb59c3940eb24007d","RawContent":"&lt;p&gt; If you have time, then you should shop sooner rather than later and then wait for sales.&amp;nbsp; We bought our bands about 11 months in advance just because it is one of the easier things to check off the list without knowing a guest count!&amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; The jewlery store I got my ring from was having a 20% off sale the first weekend in December so we lucked out.&amp;nbsp; Best to know what you want and then keep an eye out for a sale.&lt;\/p&gt;","Attachments":[],"Id":1379001,"PostDate":1295433552,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> If you have time, then you should shop sooner rather than later and then wait for sales.\u00a0 We bought our bands about 11 months in advance just because it is one of the easier things to check off the list without knowing a guest count!\u00a0<\/p> <p> \u00a0<\/p> <p> The jewlery store I got my ring from was having a 20% off sale the first weekend in December so we lucked out.\u00a0 Best to know what you want and then keep an eye out for a sale.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"clgriffi7@yahoo.com","IpAddress":"","GroupId":5,"GroupName":"Banned","JoinDate":1276111330,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-229026.JPG?_r=0","PhotoWidth":150,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"clgriffi7","Id":229026,"Name":"clgriffi7","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":58148,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"821db48facaf721db901f980763f86db","RawContent":"&lt;p&gt; You should really buy them as early as possible.   Our wedding is not for another year but we bought ours from &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.larsonjewelers.com\/\"&gt;http:\/\/www.larsonjewelers.com\/&lt;\/a&gt; already.   We expected the rings to arrive in 2 days but since we wanted engraving, it added an additional 2 days so if we were having the wedding in 2 days, it would not have made it.  &amp;nbsp;A friend of mine&amp;nbsp;completely forgot and they needed their rings sent to their hotel in Vega&amp;nbsp;the day before their wedding.&lt;\/p&gt;","Attachments":[],"Id":1379500,"PostDate":1295461013,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> You should really buy them as early as possible.\u00a0\u00a0 Our wedding is not for another year but we bought ours from <a href='http:\/\/www.larsonjewelers.com\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.larsonjewelers.com\/<\/a> already.\u00a0\u00a0 We expected the rings to arrive in 2 days but since we wanted engraving, it added an additional 2 days so if we were having the wedding in 2 days, it would not have made it.\u00a0\u00a0\u00a0A friend of mine\u00a0completely forgot and they needed their rings sent to their hotel in Vega\u00a0the day before their wedding.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ryanparker190@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1294025696,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-235029.jpg?_r=0","PhotoWidth":200,"PhotoHeight":159,"PhotoType":"custom"},"FormattedName":"ryan190","Id":235029,"Name":"ryan190","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":58148,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2c0ae5d52bccae05759700890d6cf2f9","RawContent":"&lt;p&gt; The earlier the better! We priced out my ring in the middle of November because I wanted the matching Platinum band, the price has gone up $250 since then. Thankfully, the store has honored the original quote. My ring is Tacori, so they never go on sale, the price just rises with the cost of metals. FI&#039;s ring we luckily found a 50% off sale, and the day after we bought was back up to $1800!&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; So it&#039;s never too early to look around.&lt;\/p&gt;","Attachments":[],"Id":1384990,"PostDate":1296123313,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> The earlier the better! We priced out my ring in the middle of November because I wanted the matching Platinum band, the price has gone up $250 since then. Thankfully, the store has honored the original quote. My ring is Tacori, so they never go on sale, the price just rises with the cost of metals. FI's ring we luckily found a 50% off sale, and the day after we bought was back up to $1800!<\/p> <p> \u00a0<\/p> <p> So it's never too early to look around.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sherrif@acanac.net","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1281457220,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-231230.jpg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"mochamakes3","Id":231230,"Name":"mochamakes3","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":58148,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b176ee6d92bf0d0875501a753caa53db","RawContent":"&lt;p&gt; We&#039;re getting married Aug 2012..so I&#039;d say something in the spring\/early summer..or sooner if we find a sale. We just want plain bands. No biggies :P&lt;\/p&gt;","Attachments":[],"Id":1385254,"PostDate":1296139775,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> We're getting married Aug 2012..so I'd say something in the spring\/early summer..or sooner if we find a sale. We just want plain bands. No biggies <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/tongue.png' class='bbc_emoticon' alt=':P' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"janice.miriam@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1276552100,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-229169.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"babestaaa","Id":229169,"Name":"babestaaa","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":58148,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e1ac84fe8d0d53017d08d4e3267a1bb2","RawContent":"&lt;p&gt; FI and I went ring shopping last weekend.&amp;nbsp; Our wedding is in&amp;nbsp;3 weeks.&amp;nbsp; Truthfully, we left it a little too late!&amp;nbsp; Most of the jewelery stores told us that anything that needed to be ordered would take 6 weeks to come in.&amp;nbsp; Luckily, we were able to find the rings that we wanted and in our sizes and bought them on the spot!&amp;nbsp; Phew!&lt;\/p&gt;","Attachments":[],"Id":1387173,"PostDate":1296383643,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> FI and I went ring shopping last weekend.\u00a0 Our wedding is in\u00a03 weeks.\u00a0 Truthfully, we left it a little too late!\u00a0 Most of the jewelery stores told us that anything that needed to be ordered would take 6 weeks to come in.\u00a0 Luckily, we were able to find the rings that we wanted and in our sizes and bought them on the spot!\u00a0 Phew!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ablj209@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1262988821,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-224465.jpg?_r=0","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"ablj209","Id":224465,"Name":"ablj209","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":58148,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bf74af6b65ce9b6ad8561af9eabdd23b","RawContent":"[quote]\nOriginally Posted by [b]clgriffi7[\/b] \/img\/forum\/go_quote.gif\n \n \n If you have time, then you should shop sooner rather than later and then wait for sales.  We bought our bands about 11 months in advance just because it is one of the easier things to check off the list without knowing a guest count!  \n \n The jewlery store I got my ring from was having a 20% off sale the first weekend in December so we lucked out.  Best to know what you want and then keep an eye out for a sale.[\/quote] \n \n You are absolutely right, about checking it off the list.","Attachments":[],"Id":1426816,"PostDate":1301515386,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <br \/> <br \/> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>clgriffi7<\/strong>\u00a0<a href='\/forum\/thread\/65738\/when-should-we-buy-the-wedding-bands\/10#post_1525136' class='bbc_url' title='External link' rel='nofollow external'><span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" style=\"border-bottom: 0px solid; border-left: 0px solid; border-top: 0px solid; border-right: 0px solid\" \/><\/span><\/a><br \/> <br \/> <p> If you have time, then you should shop sooner rather than later and then wait for sales.\u00a0 We bought our bands about 11 months in advance just because it is one of the easier things to check off the list without knowing a guest count!\u00a0<\/p> <p> \u00a0<\/p> <p> The jewlery store I got my ring from was having a 20% off sale the first weekend in December so we lucked out.\u00a0 Best to know what you want and then keep an eye out for a sale.<\/p> <\/blockquote> <p> <br \/> You are absolutely right, about checking it off the list.<br \/> \u00a0<\/p> <p> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"traceychung@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1296771657,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-236352.jpeg?_r=0","PhotoWidth":195,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"traceysteve","Id":236352,"Name":"traceysteve","IsOnline":false}}],"Id":"58148","Title":"When should we buy the wedding bands?","LastPostDate":1440059597},"Pages":{"TotalItems":26,"TotalPages":3,"CurrentPage":10,"NextPage":20,"PreviousPage":0,"LastPage":20},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
