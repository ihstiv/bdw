","JoinDate":1403184280,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278601.jpg?_r=1403203318","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"atennille","Id":278601,"Name":"atennille","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.208.82","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"a299d105b00ff3a805f22cfbf42696d1","RawContent":"[quote name=\"atennille\" post=\"1862830\" timestamp=\"1406574743\"]\nHas anyone ever heard or used ericdress.com ?[\/quote]\nNever heard of them! I wouldn&#039;t have a company not highly reviewed by other brides, entrusted to make my dress! I would be way to nervous!","Attachments":[],"Id":1862842,"PostDate":1406563638,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>atennille, on 28 July 2014 - 03:12 PM, said:<\/p><div class='blockquote'><div class='quote'><p>Has anyone ever heard or used ericdress.com ?<\/p><\/div><\/div>\n<br>\nNever heard of them! I wouldn't have a company not highly reviewed by other brides, entrusted to make my dress! I would be way to nervous! \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kmkwedding2016@gmail.com","IpAddress":"70.72.195.234","GroupId":38,"GroupName":"Moderators","JoinDate":1390242208,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kmk2016","Id":276231,"Name":"kmk2016","IsOnline":false}}],"Pages":{"TotalItems":6402,"TotalPages":641,"CurrentPage":6310,"NextPage":6320,"PreviousPage":6300,"LastPage":6400},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
