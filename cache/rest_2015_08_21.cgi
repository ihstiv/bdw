a-cdn.com\/public\/style_images\/destination\/attachicon.gif\" alt=\"attachicon.gif\"><\/span><a href='http:\/\/www.bestdestinationwedding.com\/index.php?app=core&module=attach&section=attach&attach_rel_module=post&attach_id=30477' class='bbc_url' title=''>ImageUploadedByTapatalk1422260112.048854.jpg<\/a>. This is my dress, I can't wait to wear it! It might be a little fancy for a beach wedding but it  what I've always dreamed of wearing!<\/p><\/div><\/div>\nThat's a beautiful dress xx\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"shelina_nessa@yahoo.co.uk","IpAddress":"149.254.56.238","GroupId":39,"GroupName":"Newbie","JoinDate":1421807139,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"maybeoneday","Id":281816,"Name":"maybeoneday","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.155.94.124","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"685333d3403920f60e568353ef463d8a","RawContent":"&lt;p&gt;@[member=\"colleentf09\"] I think it will look great on the beach :)&lt;\/p&gt;","Attachments":[],"Id":1884168,"PostDate":1422272847,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"280885\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/280885-colleentf09\/' title='Member profile'><span itemprop=\"name\">colleentf09<\/span><\/a> I think it will look great on the beach <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<br><p><a data-ipb='nomediaparse' href='http:\/\/www.TickerFactory.com\/'><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;31;484\/st\/20150813\/e\/Wedding+time%21+\/dt\/-2\/k\/b92c\/event.png\" alt=\"event.png\"><\/a><\/p>\n<p style=\"text-align:center;\">\u00a0<\/p>\n<p style=\"text-align:center;\">\u00a0","Email":"sblopezb@gmail.com","IpAddress":"172.219.193.22","GroupId":42,"GroupName":"Sr. Member","JoinDate":1359748704,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265511.jpg?_r=1440029562","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"TinkerSofi","Id":265511,"Name":"TinkerSofi","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.172.122.57","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":3,"IsLiked":false,"PostKey":"fcc94cffbeb565121beef3e09b2ea0b5","RawContent":"&lt;p&gt;Hey Girls,&lt;\/p&gt;\n&lt;p&gt;Took some convincing but my fianc\u00e9 finally decided to do a trash the dress with me. So I am ordering a second dress just under $200. I think this dress is great for a trash the dress and also if I feel too warm in my other dress at the reception I just may change into this one. But I am holding off on that as I would like to stay in my original dress the whole day of the wedding because it wasn&#039;t cheap to just wear for a couple hours.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;My original dress for the wedding day is on pay 815 of this thread.&lt;\/p&gt;","Attachments":[{"Id":30478,"Name":"IMG_0693.PNG","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_01_2015\/post-277264-0-87220700-1422287523.png","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_01_2015\/post-277264-0-87220700-1422287523_thumb.png","Width":640,"Height":1136}],"Id":1884170,"PostDate":1422273278,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hey Girls,<\/p>\n<p>Took some convincing but my fianc\u00e9 finally decided to do a trash the dress with me. So I am ordering a second dress just under $200. I think this dress is great for a trash the dress and also if I feel too warm in my other dress at the reception I just may change into this one. But I am holding off on that as I would like to stay in my original dress the whole day of the wedding because it wasn't cheap to just wear for a couple hours.<\/p>\n<p>\u00a0<\/p>\n<p>My original dress for the wedding day is on pay 815 of this thread.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p style=\"text-align:center;\"><strong>Kristy and Nathan<\/strong><\/p>\n<p style=\"text-align:center;\"><strong>Melia Caribe Tropical <\/strong><\/p>\n<p style=\"text-align:center;\"><strong>April 17, 2015<\/strong>","Email":"colek_64@hotmail.com","IpAddress":"199.180.174.8","GroupId":3,"GroupName":"Member","JoinDate":1395332214,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277264.jpg?_r=1429937323","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"kcole123","Id":277264,"Name":"kcole123","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.90.222.96","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"a708387c12f436ea44d61a261288bab5","RawContent":"[quote name=\"kcole123\" post=\"1884170\" timestamp=\"1422287678\"]\nHey Girls,\nTook some convincing but my fianc\u00e9 finally decided to do a trash the dress with me. So I am ordering a second dress just under $200. I think this dress is great for a trash the dress and also if I feel too warm in my other dress at the reception I just may change into this one. But I am holding off on that as I would like to stay in my original dress the whole day of the wedding because it wasn&#039;t cheap to just wear for a couple hours.\n\nMy original dress for the wedding day is on pay 815 of this thread.[\/quote]I wore mine all night but I was hotter than heck lol. If I would have had a towel to wipe between my legs I would have. Hahah\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1884221,"PostDate":1422300471,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>kcole123, on 26 January 2015 - 11:54 AM, said:<\/p><div class='blockquote'><div class='quote'><p>Hey Girls,<br>\nTook some convincing but my fianc\u00e9 finally decided to do a trash the dress with me. So I am ordering a second dress just under $200. I think this dress is great for a trash the dress and also if I feel too warm in my other dress at the reception I just may change into this one. But I am holding off on that as I would like to stay in my original dress the whole day of the wedding because it wasn't cheap to just wear for a couple hours.<br><br>\nMy original dress for the wedding day is on pay 815 of this thread.<\/p><\/div><\/div>\n<br>\nI wore mine all night but I was hotter than heck lol. If I would have had a towel to wipe between my legs I would have. Hahah<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"216.200.128.254","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"badf82009e9946084e40b3ada9612467","RawContent":"[quote name=\"calgarybride2015\" post=\"1884221\" timestamp=\"1422314871\"]\nI wore mine all night but I was hotter than heck lol. If I would have had a towel to wipe between my legs I would have. Hahah\n\n\nSent from my iPhone using Tapatalk[\/quote]\n\nI&#039;m not going to lie, I&#039;m worried about this LOL!  My dress is satin and weighs like 20 pounds!  But it&#039;s gorgeous and it&#039;s the only time I&#039;m going to ever wear it, and damn it, I&#039;m going to tough it out! ;)","Attachments":[],"Id":1884222,"PostDate":1422300570,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>calgarybride2015, on 26 January 2015 - 07:27 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>I wore mine all night but I was hotter than heck lol. If I would have had a towel to wipe between my legs I would have. Hahah<br><br><br>\nSent from my iPhone using Tapatalk<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I'm not going to lie, I'm worried about this LOL! \u00a0My dress is satin and weighs like 20 pounds! \u00a0But it's gorgeous and it's the only time I'm going to ever wear it, and damn it, I'm going to tough it out! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>30 guests, Bride & Groom & 2 kids - one FANTASTIC time!<\/p>\n<p>\u00a0<\/p>\n<p><strong>Planning Thread<\/strong> - Includes lots of DIY (picture-heavy)<br><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/77321-marinah84s-planning-thread-31415-crown-paradise-club-cancun\/\"><span style=\"color:rgb(0,0,255);\">http:\/\/www.bestdestinationwedding.com\/topic\/77321-marinah84s-planning-thread-31415-crown-paradise-club-cancun\/<\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p><strong>Underwater Trash The Dress Session Photos<\/strong> - Samuel Luna (Photographer)<\/p>\n<p><a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/media\/set\/?set=a.784031153664.1073741863.54300091&type=1&l=a8a5688cd7'>https:\/\/www.facebook.com\/media\/set\/?set=a.784031153664.1073741863.54300091&type=1&l=a8a5688cd7<\/a><\/p>\n<p>\u00a0<\/p>\n<p><strong>Resort Review<\/strong> - <em>Crown Paradise Club Cancun<\/em><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77321-marinah84s-planning-thread-31415-crown-paradise-club-cancun\/page-28#entry1894872'>http:\/\/www.bestdestinationwedding.com\/topic\/77321-marinah84s-planning-thread-31415-crown-paradise-club-cancun\/page-28#entry1894872<\/a><\/p>\n<p>\u00a0<\/p>\n<p><strong>Photographer Review <\/strong>- <em>Samuel Luna<\/em> - Coming Soon!<\/p>\n<p>\u00a0<\/p>\n<p><strong>Makeup\/Hair Artist Review\u00a0<\/strong>-\u00a0<em>Sara Tamargo<\/em><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4968-sara-tamargo-makeup-artistry\/'>http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4968-sara-tamargo-makeup-artistry\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p><strong>For Sale Items<\/strong> -\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79146-wedding-items-for-sale\/#entry1895327'>http:\/\/www.bestdestinationwedding.com\/topic\/79146-wedding-items-for-sale\/#entry1895327<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"marinarhianne@gmail.com","IpAddress":"67.149.51.114","GroupId":40,"GroupName":"Jr. Member","JoinDate":1387570652,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275696.jpg?_r=1429206783","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"marinah84","Id":275696,"Name":"marinah84","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.113.233.65","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2c09c52171bd8e9e576b8208932e8fcd","RawContent":"&lt;p&gt;@[member=\"kcole123\"] - I changed into my other dress once the dancing started.&amp;nbsp; Way too hot to wear (and we were inside w\/ AC haha)&lt;\/p&gt;","Attachments":[],"Id":1884229,"PostDate":1422305444,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"277264\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277264-kcole123\/' title='Member profile'><span itemprop=\"name\">kcole123<\/span><\/a> - I changed into my other dress once the dancing started.\u00a0 Way too hot to wear (and we were inside w\/ AC haha)<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Married December 19, 2014 at Beach Palace Resort in Cancun, Mexico<\/p>\n<p>\u00a0<\/p>\n<p>My Planning Thread - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/'>http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>My Wedding Review<\/p>\n<p>Part 1 - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881197'>http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881197<\/a><\/p>\n<p>Part 2 - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881590'>http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881590<\/a><\/p>\n<p>Part 3 - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881861'>http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881861<\/a><\/p>\n<p>\u00a0","Email":"lilyluu83@gmail.com","IpAddress":"174.119.162.30","GroupId":3,"GroupName":"Member","JoinDate":1395594948,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277296.jpg?_r=1421643766","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"tygrrlily","Id":277296,"Name":"tygrrlily","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.155.94.124","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"43f151a5c0824950e6d27ea23826a69f","RawContent":"I&#039;m going to tough it out. I just love my dress too much so I want to wear it as much as I can :) \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1884232,"PostDate":1422308939,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm going to tough it out. I just love my dress too much so I want to wear it as much as I can <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<br><p><a data-ipb='nomediaparse' href='http:\/\/www.TickerFactory.com\/'><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;31;484\/st\/20150813\/e\/Wedding+time%21+\/dt\/-2\/k\/b92c\/event.png\" alt=\"event.png\"><\/a><\/p>\n<p style=\"text-align:center;\">\u00a0<\/p>\n<p style=\"text-align:center;\">\u00a0","Email":"sblopezb@gmail.com","Ip