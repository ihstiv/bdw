right.netdna-cdn.com\/cdn\/profile\/photo-282430.jpg?_r=1434377756","PhotoWidth":200,"PhotoHeight":287,"PhotoType":"custom"},"FormattedName":"IzzyDeee","Id":282430,"Name":"IzzyDeee","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.137.211.49","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"167d74b6eadc27cee13b71f5ea18d621","RawContent":"&lt;p&gt;pretty!&lt;\/p&gt;","Attachments":[],"Id":1890967,"PostDate":1427413728,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>pretty!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"phimoez@yahoo.com","IpAddress":"50.137.211.49","GroupId":39,"GroupName":"Newbie","JoinDate":1425862236,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"MNsunseeker","Id":282367,"Name":"MNsunseeker","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.90.223.128","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"ac5f25f52228188be44aead832f8b440","RawContent":"[quote name=\"krystalball\" post=\"1890858\" timestamp=\"1427388345\"]\nWasn&#039;t planning to buy a dress more than a year before my wedding date, but there was a sample sale and the dress of my dreams was $350 off! Now I just need to resist the temptation to try it on again since it&#039;s in my house until I get it altered many months from now, lol\n\n\n\nThis is the dress on the model since the lighting isn&#039;t great in my pic. [url=\"http:\/\/www.maggiesottero.com\/dress.aspx?style=4MC844\"]http:\/\/www.maggiesottero.com\/dress.aspx?style=4MC844[\/url]\n\nI love that the bottom of the dress becomes sand coloured  :)[\/quote]It&#039;s gorgeous. I love it. \nI also had a lace one on my short list. \nOhhhh I also had mine on a lot :) we are allowed hehehe\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1890969,"PostDate":1427414403,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>krystalball, on 26 March 2015 - 12:45 PM, said:<\/p><div class='blockquote'><div class='quote'><p>Wasn't planning to buy a dress more than a year before my wedding date, but there was a sample sale and the dress of my dreams was $350 off! Now I just need to resist the temptation to try it on again since it's in my house until I get it altered many months from now, lol<br><br><br><br>\nThis is the dress on the model since the lighting isn't great in my pic. <a href='http:\/\/www.maggiesottero.com\/dress.aspx?style=4MC844' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.maggiesot...px?style=4MC844<\/a><br><br>\nI love that the bottom of the dress becomes sand coloured  <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p><\/div><\/div>\n<br>\nIt's gorgeous. I love it. <br>\nI also had a lace one on my short list. <br>\nOhhhh I also had mine on a lot <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> we are allowed hehehe<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl"