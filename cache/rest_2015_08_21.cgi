> URL: /index.php?/REST/Forums/topic/getPosts?topicId=30824&start=6290&SessionId=3f98263b65d1a9d37c28ef2ea4e416c5
> User jacquewedding (283943)
Request Time: 1 seconds
{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"216.211.99.179","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"afd461333cd3309c77e58fbfca918857","RawContent":"&lt;p&gt;I am considering buying a knock off dress because the original dress I purchased is 6 sizes too big. The problem it, may not be here in time (according to the sales people). Anyone have any good links to some knock off sites? The ones mentioned in the earlier thread are no longer available.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thanks&lt;\/p&gt;","Attachments":[],"Id":1861468,"PostDate":1406027048,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I am considering buying a knock off dress because the original dress I purchased is 6 sizes too big. The problem it, may not be here in time (according to the sales people). Anyone have any good links to some knock off sites? The ones mentioned in the earlier thread are no longer available.<\/p>\n<p>\u00a0<\/p>\n<p>Thanks<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tammy.jacobs@gmail.com","IpAddress":"216.211.99.179","GroupId":39,"GroupName":"Newbie","JoinDate":1405943365,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279107.jpg?_r=1408932832","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"projecttwayne2015","Id":279107,"Name":"projecttwayne2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.114.25.122","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"745d017e27cace192949ec00b6a40b56","RawContent":"[quote name=\"projecttwayne2015\" post=\"1861468\" timestamp=\"1406041448\"]\nI am considering buying a knock off dress because the original dress I purchased is 6 sizes too big. The problem it, may not be here in time (according to the sales people). Anyone have any good links to some knock off sites? The ones mentioned in the earlier thread are no longer available.\n\nThanks[\/quote]Depending on the style\/ hands down for a higher end replica with either intricate beading or lace- Jasmines bridal is the best option. For less complicated dresses Cara bridal on etsy, or dressilyme seem to have the best results behind jasmines. \n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1861471,"PostDate":1406027939,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>projecttwayne2015, on 22 July 2014 - 11:04 AM, said:<\/p><div class='blockquote'><div class='quote'><p>I am considering buying a knock off dress because the original dress I purchased is 6 sizes too big. The problem it, may not be here in time (according to the sales people). Anyone have any good links to some knock off sites? The ones mentioned in the earlier thread are no longer available.<br><br>\nThanks<\/p><\/div><\/div>\n<br>\nDepending on the style\/ hands down for a higher end replica with either intricate beading or lace- Jasmines bridal is the best option. For less complicated dresses Cara bridal on etsy, or dressilyme seem to have the best results behind jasmines. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kmkwedding2016@gmail.com","IpAddress":"70.72.195.234","GroupId":38,"GroupName":"Moderators","JoinDate":1390242208,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kmk2016","Id":276231,"Name":"kmk2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.219.69.189","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"96fe8bd7054144e466359978441e0e15","RawContent":"Ooooooh that sounds great! Thank you for the leads.","Attachments":[],"Id":1861481,"PostDate":1406029588,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Ooooooh that sounds great! Thank you for the leads.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tammy.jacobs@gmail.com","IpAddress":"216.211.99.179","GroupId":39,"GroupName":"Newbie","JoinDate":1405943365,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279107.jpg?_r=1408932832","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"projecttwayne2015","Id":279107,"Name":"projecttwayne2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.222.215.154","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"d56d75be56358e9c3bbcf219c4cce614","RawContent":"I bought my dress from Dressilyme. They did a great job, fits perfectly and came super quick! \n\n\nOn another note, I am having second thoughts about my dress now!! I have tried it on and I am just nervous that it is quite tight as it&#039;s sort of modified mermaid\/trumpet style. I am on the fence about ordering another dress....since the first was super reasonable, I kinda want to buy another just to ow that I will be comfy on the big day! Thoughts?? Am I crazy?\n\n\nThis is me in my dress\n\n\n\n\n\nThese are the dresses I was thinking about....\n","Attachments":[{"Id":28775,"Name":"image.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2014\/post-272291-0-44288700-1406133416.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2014\/post-272291-0-44288700-1406133416_thumb.jpg","Width":900,"Height":1200}],"Id":1861774,"PostDate":1406119142,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I bought my dress from Dressilyme. They did a great job, fits perfectly and came super quick! <br><br>\nOn another note, I am having second thoughts about my dress now!! I have tried it on and I am just nervous that it is quite tight as it's sort of modified mermaid\/trumpet style. I am on the fence about ordering another dress....since the first was super reasonable, I kinda want to buy another just to ow that I will be comfy on the big day! Thoughts?? Am I crazy?<br><br>\nThis is me in my dress<br>\n<a class='resized_img' rel='lightbox[1861774]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2014\/post-272291-0-83846300-1406132970.jpg\" title=\"image.jpg -  123.46KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2014\/post-272291-0-83846300-1406132970.jpg\" class='bbc_img linked-image' alt=\"image.jpg\" \/><\/a>\n\n<br><br><br>\nThese are the dresses I was thinking about....<br>\n<a class='resized_img' rel='lightbox[1861774]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2014\/post-272291-0-18323700-1406133172.jpg\" title=\"image.jpg -  98.81KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2014\/post-272291-0-18323700-1406133172.jpg\" class='bbc_img linked-image' alt=\"image.jpg\" \/><\/a>\n\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"candle_23@hotmail.com","IpAddress":"66.222.215.154","GroupId":40,"GroupName":"Jr. Member","JoinDate":1375747301,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272291.jpg?_r=1388954341","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"candle23","Id":272291,"Name":"candle23","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.114.25.122","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"009324ba56fa0a69f38e5a455776472c","RawContent":"[quote name=\"candle23\" post=\"1861774\" timestamp=\"1406133542\"]\nI bought my dress from Dressilyme. They did a great job, fits perfectly and came super quick! \n\nOn another note, I am having second thoughts about my dress now!! I have tried it on and I am just nervous that it is quite tight as it&#039;s sort of modified mermaid\/trumpet style. I am on the fence about ordering another dress....since the first was super reasonable, I kinda want to buy another just to ow that I will be comfy on the big day! Thoughts?? Am I crazy?\n\nThis is me in my dress\n[img]http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif[\/img][url=\"http:\/\/www.bestdestinationwedding.com\/index.php?app=core&amp;amp;module=attach&amp;amp;section=attach&amp;amp;attach_rel_module=post&amp;amp;attach_id=28773\"]image.jpg[\/url]\n\n\nThese are the dresses I was thinking about....\n[img]http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif[\/img][url=\"http:\/\/www.bestdestinationwedding.com\/index.php?app=core&amp;amp;module=attach&amp;amp;section=attach&amp;amp;attach_rel_module=post&amp;amp;attach_id=28774\"]image.jpg[\/url][\/quote]I love your dress on you so I wouldn&#039;t not wear it! But how about a reception dress that is easier to dance in and relax and party? You could go with a totally different style so it was obvious- or the one you like is really pretty and paired with a fun sash could be gorgeous and obvious that it&#039;s a different dress! That&#039;s part of the reason I am going this route! So I can spoil myself with two dresses! (One tight mermaid and one sheath as well!) \n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1861784,"PostDate":1406119783,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>candle23, on 23 July 2014 - 12:39 PM, said:<\/p><div class='blockquote'><div class='quote'><p>I bought my dress from Dressilyme. They did a great job, fits perfectly and came super quick! <br><br>\nOn another note, I am having second thoughts about my dress now!! I have tried it on and I am just nervous that it is quite tight as it's sort of modified mermaid\/trumpet style. I am on the fence about ordering another dress....since the first was super reasonable, I kinda want to buy another just to ow that I will be comfy on the big day! Thoughts?? Am I crazy?<br><br>\nThis is me in my dress<br><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif\" alt=\"attachicon.gif\"><\/span><a href='http:\/\/www.bestdestinationwedding.com\/index.php?app=core&module=attach&section=attach&attach_rel_module=post&attach_id=28773' class='bbc_url' title=''>image.jpg<\/a><br><br><br>\nThese are the dresses I was thinking about....<br><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif\" alt=\"attachicon.gif\"><\/span><a href='http:\/\/www.bestdestinationwedding.com\/index.php?app=core&module=attach&section=attach&attach_rel_module=post&attach_id=28774' class='bbc_url' title=''>image.jpg<\/a><\/p><\/div><\/div>\n<br>\nI love your dress on you so I wouldn't not wear it! But how about a reception dress that is easier to dance in and relax and party? You could go with a totally different style so it was obvious- or the one you like is really pretty and paired with a fun sash could be gorgeous and obvious that it's a different dress! That's part of the reason I am going this route! So I can spoil myself with two dresses! (One tight mermaid and one sheath as well!) <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kmkwedding2016@gmail.com","IpAddress":"70.72.195.234","GroupId":38,"GroupName":"Moderators","JoinDate":1390242208,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kmk2016","Id":276231,"Name":"kmk2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"4.31.207.18","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"2546c5df185e49a706187654f8e40a7c","RawContent":"&lt;p&gt;Hello Im a noobie! I saw this forum and just had to join you ladies are WONDERFUL and have been such a huge HELP!!&lt;\/p&gt;\n&lt;p&gt;I just ordered my dress From Dhgate Babyonline, B)&lt;\/p&gt;\n&lt;p&gt;What havent seen on the forum was &amp;nbsp;a princess ball room gown, I have always had the dream of looking like a princess on my wedding like the fairy tales with the BIG PUFFY DRESS. I ordered my Dress on 07\/18\/2014 and my wedding is September 14th. Im on pins and needles this has to be the one!!! I paid $160 on the dress. I will post a picture if you guys want....&lt;\/p&gt;","Attachments":[],"Id":1861849,"PostDate":1406128800,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello Im a noobie! I saw this forum and just had to join you ladies are WONDERFUL and have been such a huge HELP!!<\/p>\n<p>I just ordered my dress From Dhgate Babyonline, <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/cool.png' class='bbc_emoticon' alt='B)' \/><\/p>\n<p>What havent seen on the forum was \u00a0a princess ball room gown, I have always had the dream of looking like a princess on my wedding like the fairy tales with the BIG PUFFY DRESS. I ordered my Dress on 07\/18\/2014 and my wedding is September 14th. Im on pins and needles this has to be the one!!! I paid $160 on the dress. I will post a picture if you guys want....<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"brittkneexods@aol.com","IpAddress":"4.31.207.18","GroupId":39,"GroupName":"Newbie","JoinDate":1406127259,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"none"},"FormattedName":"Imaculent","Id":279144,"Name":"Imaculent","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.114.25.122","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"9570722af0482be105eaf987728ea2a2","RawContent":"[quote name=\"Imaculent\" post=\"1861849\" timestamp=\"1406143200\"]\nHello Im a noobie! I saw this forum and just had to join you ladies are WONDERFUL and have been such a huge HELP!!\nI just ordered my dress From Dhgate Babyonline, B)\nWhat havent seen on the forum was  a princess ball room gown, I have always had the dream of looking like a princess on my wedding like the fairy tales with the BIG PUFFY DRESS. I ordered my Dress on 07\/18\/2014 and my wedding is September 14th. Im on pins and needles this has to be the one!!! I paid $160 on the dress. I will post a picture if you guys want....[\/quote]Welcome! Definitely post pics! Are you getting mid production pics done? Post your inspiration pic too! \n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1861852,"PostDate":1406129342,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Imaculent, on 23 July 2014 - 03:20 PM, said:<\/p><div class='blockquote'><div class='quote'><p>Hello Im a noobie! I saw this forum and just had to join you ladies are WONDERFUL and have been such a huge HELP!!<br>\nI just ordered my dress From Dhgate Babyonline, <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/cool.png' class='bbc_emoticon' alt='B)' \/><br>\nWhat havent seen on the forum was  a princess ball room gown, I have always had the dream of looking like a princess on my wedding like the fairy tales with the BIG PUFFY DRESS. I ordered my Dress on 07\/18\/2014 and my wedding is September 14th. Im on pins and needles this has to be the one!!! I paid $160 on the dress. I will post a picture if you guys want....<\/p><\/div><\/div>\n<br>\nWelcome! Definitely post pics! Are you getting mid production pics done? Post your inspiration pic too! <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kmkwedding2016@gmail.com","IpAddress":"70.72.195.234","GroupId":38,"GroupName":"Moderators","JoinDate":1390242208,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kmk2016","Id":276231,"Name":"kmk2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"131.96.28.10","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0cb864d064ac4157210fc1fe54fc3df0","RawContent":"&lt;p&gt;@[member=\"candle23\"] your dress is beautiful, but I can understand if you want to be more comfortable, it really looks great on you.&lt;\/p&gt;","Attachments":[],"Id":1861901,"PostDate":1406147822,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"272291\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/272291-candle23\/' title='Member profile'><span itemprop=\"name\">candle23<\/span><\/a> your dress is beautiful, but I can understand if you want to be more comfortable, it really looks great on you.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff8c00;\"><span style=\"font-family:'comic sans ms', cursive;\"><span style=\"font-size:14px;\">\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 AnnaTennille & Eric<\/span><\/span><\/span><\/p>\n<p><span style=\"color:#ff8c00;\"><span style=\"font-family:'comic sans ms', cursive;\"><span style=\"font-size:14px;\">\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 May 16, 2015<\/span><\/span><\/span><\/p>\n<p><span style=\"font-family:'comic sans ms', cursive;\"><span style=\"font-size:14px;\"><span style=\"color:#ff8c00;\">\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 Montego Bay, Jamaica<\/span><\/span><\/span><\/p>\n<p><span style=\"font-family:'comic sans ms', cursive;\"><span style=\"font-size:14px;\"><span style=\"color:#ff8c00;\">\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 \u00a0 \u00a0 \u00a0 \u00a0\u00a0 <\/span><\/span><\/span><\/p>\n<p>\u00a0\u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0\u00a0 <img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10765;484\/st\/20150516\/e\/The+Day+We+Say+I+Do%21\/k\/b124\/event.png\" alt=\"event.png\"><\/p>\n<p>\u00a0","Email":"a.johnson1013@yahoo.com","IpAddress":"99.108.237.58","GroupId":40,"GroupName":"Jr. Member","JoinDate":1403184280,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278601.jpg?_r=1403203318","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"atennille","Id":278601,"Name":"atennille","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"96.246.202.15","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"30aedc552644b78ef4e3a63cd9622f9c","RawContent":"&lt;p&gt;I bought my dress from dressilyme. If you&#039;re flexible in the end product you&#039;ll love your dress. If you want the exact replica to the dress you tried on or your favorite dress in a magazine you might be disappointed. My dress wasn&#039;t like the picture posted on their site BUT it was a beautiful dress than made everyone cry at the wedding. Best bang for your buck. Do yourself and order your dress in the size you are today.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1861959,"PostDate":1406162784,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I bought my dress from dressilyme. If you're flexible in the end product you'll love your dress. If you want the exact replica to the dress you tried on or your favorite dress in a magazine you might be disappointed. My dress wasn't like the picture posted on their site BUT it was a beautiful dress than made everyone cry at the wedding. Best bang for your buck. Do yourself and order your dress in the size you are today.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"djernigan6@gmail.com","IpAddress":"96.246.202.15","GroupId":39,"GroupName":"Newbie","JoinDate":1374823976,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-271922.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"bride6","Id":271922,"Name":"bride6","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"182.253.48.94","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8d50836b975e0fc2e5c9cd8957afb5ff","RawContent":"&lt;p&gt;can anyone tell me the great &amp;amp; elegant wedding dress?&lt;\/p&gt;","Attachments":[],"Id":1861966,"PostDate":1406172123,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>can anyone tell me the great & elegant wedding dress?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"louis.mcwright@gmail.com","IpAddress":"182.253.48.94","GroupId":39,"GroupName":"Newbie","JoinDate":1406070757,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"louis123","Id":279132,"Name":"louis123","IsOnline":false}}],"Pages":{"TotalItems":6402,"TotalPages":641,"CurrentPage":6290,"NextPage":6300,"PreviousPage":6280,"LastPage":6400},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
