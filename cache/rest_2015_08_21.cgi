{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.222.215.154","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b1af7860d876640adfddc0e2f6a0452c","RawContent":"Lol, so somehow I got the email at 2:55am that my dress and veil had shipped, and they just arrived at 1:45pm!! Of course they did since Brad is home!! Looks pretty good, I can&#039;t get into it by myself so have to wait for some help! The dress is definitely not the like the picture I ordered, but it is very pretty still! The only thing is I bought it because it was a line and this one is for sure more fitting in the hips and thighs!! Oh, and it smells a lil funky but nothing a little airing out can&#039;t fix! I will post some pics once I get my butt into it properly!","Attachments":[],"Id":1868839,"PostDate":1408982458,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Lol, so somehow I got the email at 2:55am that my dress and veil had shipped, and they just arrived at 1:45pm!! Of course they did since Brad is home!! Looks pretty good, I can't get into it by myself so have to wait for some help! The dress is definitely not the like the picture I ordered, but it is very pretty still! The only thing is I bought it because it was a line and this one is for sure more fitting in the hips and thighs!! Oh, and it smells a lil funky but nothing a little airing out can't fix! I will post some pics once I get my butt into it properly!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"candle_23@hotmail.com","IpAddress":"66.222.215.154","GroupId":40,"GroupName":"Jr. Member","JoinDate":1375747301,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272291.jpg?_r=1388954341","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"candle23","Id":272291,"Name":"candle23","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.222.215.154","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":4,"IsLiked":false,"PostKey":"701fef832c180b379bc50c0cca100f3b","RawContent":"Okay ladies, got it on, and it fits perfectly! Maybe needs a little tweaking around the bust...but nothing really! I will attach a few pictures of it, don&#039;t mind my lovely hair do!!\n\n\n\n\n","Attachments":[],"Id":1868956,"PostDate":1409006380,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Okay ladies, got it on, and it fits perfectly! Maybe needs a little tweaking around the bust...but nothing really! I will attach a few pictures of it, don't mind my lovely hair do!!<br>\n<a class='resized_img' rel='lightbox[1868956]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2014\/post-272291-0-10217200-1409020664.jpg\" title=\"image.jpg -  108.25KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2014\/post-272291-0-10217200-1409020664.jpg\" class='bbc_img linked-image' alt=\"image.jpg\" \/><\/a>\n\n<br>\n<a class='resized_img' rel='lightbox[1868956]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2014\/post-272291-0-50961600-1409020712.jpg\" title=\"image.jpg -  142.66KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2014\/post-272291-0-50961600-1409020712.jpg\" class='bbc_img linked-image' alt=\"image.jpg\" \/><\/a>\n\n<br>\n<a class='resized_img' rel='lightbox[1868956]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2014\/post-272291-0-79211000-1409020743.jpg\" title=\"image.jpg -  122.87KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2014\/post-272291-0-79211000-1409020743.jpg\" class='bbc_img linked-image' alt=\"image.jpg\" \/><\/a>\n\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"candle_23@hotmail.com","IpAddress":"66.222.215.154","GroupId":40,"GroupName":"Jr. Member","JoinDate":1375747301,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272291.jpg?_r=1388954341","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"candle23","Id":272291,"Name":"candle23","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.208.82","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"bfcf16378da66f95614b8e9592f74d30","RawContent":"[quote name=\"candle23\" post=\"1868956\" timestamp=\"1409020780\"]\nOkay ladies, got it on, and it fits perfectly! Maybe needs a little tweaking around the bust...but nothing really! I will attach a few pictures of it, don&#039;t mind my lovely hair do!!\n[img]http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif[\/img][url=\"http:\/\/www.bestdestinationwedding.com\/index.php?app=core&amp;amp;module=attach&amp;amp;section=attach&amp;amp;attach_rel_module=post&amp;amp;attach_id=29222\"]image.jpg[\/url]\n[img]http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif[\/img][url=\"http:\/\/www.bestdestinationwedding.com\/index.php?app=core&amp;amp;module=attach&amp;amp;section=attach&amp;amp;attach_rel_module=post&amp;amp;attach_id=29223\"]image.jpg[\/url]\n[img]http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif[\/img][url=\"http:\/\/www.bestdestinationwedding.com\/index.php?app=core&amp;amp;module=attach&amp;amp;section=attach&amp;amp;attach_rel_module=post&amp;amp;attach_id=29224\"]image.jpg[\/url][\/quote]So pretty on you!!!! \n\nCan you remind everyone of the details? Who the vendor was- the ordering process, how much you paid and how long it took to arrive? It&#039;s gorgeous!!!! You must be sooooo relieved\/happy! \n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1868957,"PostDate":1409006639,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>candle23, on 25 August 2014 - 10:39 PM, said:<\/p><div class='blockquote'><div class='quote'><p>Okay ladies, got it on, and it fits perfectly! Maybe needs a little tweaking around the bust...but nothing really! I will attach a few pictures of it, don't mind my lovely hair do!!<br><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif\" alt=\"attachicon.gif\"><\/span><a href='http:\/\/www.bestdestinationwedding.com\/index.php?app=core&module=attach&section=attach&attach_rel_module=post&attach_id=29222' class='bbc_url' title=''>image.jpg<\/a><br><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif\" alt=\"attachicon.gif\"><\/span><a href='http:\/\/www.bestdestinationwedding.com\/index.php?app=core&module=attach&section=attach&attach_rel_module=post&attach_id=29223' class='bbc_url' title=''>image.jpg<\/a><br><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif\" alt=\"attachicon.gif\"><\/span><a href='http:\/\/www.bestdestinationwedding.com\/index.php?app=core&module=attach&section=attach&attach_rel_module=post&attach_id=29224' class='bbc_url' title=''>image.jpg<\/a><\/p><\/div><\/div>\n<br>\nSo pretty on you!!!! <br><br>\nCan you remind everyone of the details? Who the vendor was- the ordering process, how much you paid and how long it took to arrive? It's gorgeous!!!! You must be sooooo relieved\/happy! <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kmkwedding2016@gmail.com","IpAddress":"70.72.195.234","GroupId":38,"GroupName":"Moderators","JoinDate":1390242208,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kmk2016","Id":276231,"Name":"kmk2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.222.215.154","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0c9f97fc934b6f50cac96e74d9361b75","RawContent":"Thanks! \n\n\nI ordered it from DHGate, the seller is idobridal. The order date was August 4 and I received it today, so three weeks!! I also got a veil with it. The total cost for the dress was $219 and the veil was $40. I am very happy with it!!\n\n\nI did ask for pictures before they sent it, and I never got any, but she did send pictures of the lace they used before they made it. The response time was usually within 12 hours of me sending a message. \n\n\nHere is a pic of the original and then of mine...you can see they are different for sure. But I am still happy :)\n\n\n\n\n","Attachments":[],"Id":1868959,"PostDate":1409007376,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks! <br><br>\nI ordered it from DHGate, the seller is idobridal. The order date was August 4 and I received it today, so three weeks!! I also got a veil with it. The total cost for the dress was $219 and the veil was $40. I am very happy with it!!<br><br>\nI did ask for pictures before they sent it, and I never got any, but she did send pictures of the lace they used before they made it. The response time was usually within 12 hours of me sending a message. <br><br>\nHere is a pic of the original and then of mine...you can see they are different for sure. But I am still happy <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br><br>\n<a class='resized_img' rel='lightbox[1868959]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2014\/post-272291-0-10177300-1409021698.jpg\" title=\"image.jpg -  99.87KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2014\/post-272291-0-10177300-1409021698.jpg\" class='bbc_img linked-image' alt=\"image.jpg\" \/><\/a>\n\n<br><br>\n<a class='resized_img' rel='lightbox[1868959]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2014\/post-272291-0-36329900-1409021739.jpg\" title=\"image.jpg -  109.44KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2014\/post-272291-0-36329900-1409021739.jpg\" class='bbc_img linked-image' alt=\"image.jpg\" \/><\/a>\n\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"candle_23@hotmail.com","IpAddress":"66.222.215.154","GroupId":40,"GroupName":"Jr. Member","JoinDate":1375747301,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272291.jpg?_r=1388954341","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"candle23","Id":272291,"Name":"candle23","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.157.233.83","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"c4cffd108f80dfa5923639f9f3731f90","RawContent":"[quote name=\"candle23\" post=\"1868959\" timestamp=\"1409021776\"]\nThanks!\n\nI ordered it from DHGate, the seller is idobridal. The order date was August 4 and I received it today, so three weeks!! I also got a veil with it. The total cost for the dress was $219 and the veil was $40. I am very happy with it!!\n\nI did ask for pictures before they sent it, and I never got any, but she did send pictures of the lace they used before they made it. The response time was usually within 12 hours of me sending a message.\n\nHere is a pic of the original and then of mine...you can see they are different for sure. But I am still happy :)\n\n[img]http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif[\/img][url=\"http:\/\/www.bestdestinationwedding.com\/index.php?app=core&amp;amp;module=attach&amp;amp;section=attach&amp;amp;attach_rel_module=post&amp;amp;attach_id=29225\"]image.jpg[\/url]\n\n[img]http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif[\/img][url=\"http:\/\/www.bestdestinationwedding.com\/index.php?app=core&amp;amp;module=attach&amp;amp;section=attach&amp;amp;attach_rel_module=post&amp;amp;attach_id=29226\"]image.jpg[\/url][\/quote]It&#039;s beautiful!!! Wow all this in 3 weeks?!? I will definitely check them out. Now there is only one question @[member=\"candle23\"]... Are you saying yes to the dress????","Attachments":[],"Id":1868960,"PostDate":1409008011,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>candle23, on 25 August 2014 - 10:56 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Thanks!<br><br>\nI ordered it from DHGate, the seller is idobridal. The order date was August 4 and I received it today, so three weeks!! I also got a veil with it. The total cost for the dress was $219 and the veil was $40. I am very happy with it!!<br><br>\nI did ask for pictures before they sent it, and I never got any, but she did send pictures of the lace they used before they made it. The response time was usually within 12 hours of me sending a message.<br><br>\nHere is a pic of the original and then of mine...you can see they are different for sure. But I am still happy <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br><br><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif\" alt=\"attachicon.gif\"><\/span><a href='http:\/\/www.bestdestinationwedding.com\/index.php?app=core&module=attach&section=attach&attach_rel_module=post&attach_id=29225' class='bbc_url' title=''>image.jpg<\/a><br><br><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/attachicon.gif\" alt=\"attachicon.gif\"><\/span><a href='http:\/\/www.bestdestinationwedding.com\/index.php?app=core&module=attach&section=attach&attach_rel_module=post&attach_id=29226' class='bbc_url' title=''>image.jpg<\/a><\/p>\n<\/div>\n<\/div><\/div>\n<p>It's beautiful!!! Wow all this in 3 weeks?!? I will definitely check them out. Now there is only one question @<a hovercard-ref=\"member\" hovercard-id=\"272291\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/272291-candle23\/' title='Member profile'><span itemprop=\"name\">candle23<\/span><\/a>... Are you saying yes to the dress????<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><em><span style=\"font-family:arial, helvetica, sans-serif;\">I'm lucky I'm in love with my best friend<\/span><\/em>","Email":"lily_1202@hotmail.com","IpAddress":"24.157.233.83","GroupId":40,"GroupName":"Jr. Member","JoinDate":1406376249,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279175.jpg?_r=1406605860","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"Lilian84","Id":279175,"Name":"Lilian84","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.222.215.154","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a2cfc3961a42a34e635f777d211a6482","RawContent":"@[member=\"Lilian84\"] YES!! This dress is perfect!!","Attachments":[],"Id":1868972,"PostDate":1409009150,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"279175\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/279175-lilian84\/' title='Member profile'><span itemprop=\"name\">Lilian84<\/span><\/a> YES!! This dress is perfect!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"candle_23@hotmail.com","IpAddress":"66.222.215.154","GroupId":40,"GroupName":"Jr. Member","JoinDate":1375747301,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272291.jpg?_r=1388954341","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"candle23","Id":272291,"Name":"candle23","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"142.165.85.229","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e61951a6a3fe3ef3ced8fecd92a0781c","RawContent":"candle23 the dress looks awesome on you!! ya you can see its a different dress but as long as your happy with the one you got that&#039;s all that matters...and honestly it is gorgeous..","Attachments":[],"Id":1869320,"PostDate":1409101520,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                candle23 the dress looks awesome on you!! ya you can see its a different dress but as long as your happy with the one you got that's all that matters...and honestly it is gorgeous..\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"crazycdngirl26@yahoo.ca","IpAddress":"71.17.139.242","GroupId":40,"GroupName":"Jr. Member","JoinDate":1344488438,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-258970.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":112,"PhotoType":"custom"},"FormattedName":"MJTK","Id":258970,"Name":"MJTK","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"23.16.108.59","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7cc1ee38bdbb3d10164f604d48d3e6fd","RawContent":"&lt;p&gt;@[member=\"candle23\"], you look stunning! Congrats on having such a pretty dress!&lt;\/p&gt;","Attachments":[],"Id":1869384,"PostDate":1409148865,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"272291\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/272291-candle23\/' title='Member profile'><span itemprop=\"name\">candle23<\/span><\/a>, you look stunning! Congrats on having such a pretty dress!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Our Awesome <a data-ipb='nomediaparse' href='https:\/\/www.wevideo.com\/hub\/#media\/ci\/113639543'>Video<\/a><\/p>\n<p>Our <a data-ipb='nomediaparse' href='http:\/\/itslegendary2014.wix.com\/fasa'>Website<\/a><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/76802-elsas-arthurs-wedding-rprm-20141208\/'>Riu Palace Riviera Maya Planning Thread<\/a><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/76802-elsas-arthurs-wedding-rprm-20141208\/?p=1864158'>Pre-wedding photos<\/a>,\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/76802-elsas-arthurs-wedding-rprm-20141208\/?p=1878020'>OOT Baskets<\/a>, <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/76802-elsas-arthurs-wedding-rprm-20141208\/?p=1878578'>Centrepieces<\/a><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/76802-elsas-arthurs-wedding-rprm-20141208\/?p=1852686'>DIY - Giant Crepe Roses<\/a>,\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/76802-elsas-arthurs-wedding-rprm-20141208\/?p=1867378'>DIY - Hangers & Boutonnieres<\/a>,\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/76802-elsas-arthurs-wedding-rprm-20141208\/?p=1867696'>DIY - Kissing Menu\/I Spy & Guestbook<\/a><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/76802-elsas-arthurs-wedding-rprm-20141208\/page-6#entry1878023'>More DIYs - Passport to Riviera Maya, Bookmarks, Tumbler Inserts, Luggage Tags, Keycard Holder Inserts, Something Special for You Inserts<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"elsa_jam@yahoo.com","IpAddress":"23.16.109.98","GroupId":40,"GroupName":"Jr. Member","JoinDate":1372273518,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270962.png?_r=1397000926","PhotoWidth":200,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Icis","Id":270962,"Name":"Icis","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"23.16.108.59","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a000756381b5b18ea4ad06bb3a484427","RawContent":"&lt;p&gt;I am such a sucker for dresses. I always say to my fiance that I don&#039;t have shoe obsession like other girls, but I have a crazy dress obsession instead. Anyways, I&#039;ve been really in love with the illusion-back dress look. I ask different sellers on AliExpress, Ebay and DHgate to show me real pictures of the dress they are selling before I will consider purchasing from them. Most of the sellers are nice and will provide pictures. One particular seller&#039;s dress caught my eye. I mulled and chewed over this dress since I bought one already from DressilyMe...and I still have my MaggieSottero.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;5 months after talking to the seller and receiving pictures of the real dress, I still can&#039;t stop thinking about the dress.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I bit the bullet and bought this dress because I just LOVE dresses and it looks so purrrrttty! :wub:&amp;nbsp;I am planning to wear this dress either the day before the wedding&#039;s photoshoot or for the reception or for the TTD session. I haven&#039;t made the decision yet but I honestly think this dress looks pretty good for the price I paid ($166). It doesn&#039;t look too much like the original dress but it looks good even without looking at the original. Anyhoo, I bought the dress from YongGang Lin@ AliExpress. The seller is nice, willing to provide real pictures of the dress, and quick to respond. The dress came faster than expected.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;My fiance doesn&#039;t know how to present the dress so unfortunately he doesn&#039;t know how to present the end of the dress. The only thing I&#039;m concern about is fixing the illusion back.&amp;nbsp;They just expected my torso to be that of a supermodel so there is just a tad too much fabric on the back. I need to talk to my seamstress...&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;","Attachments":[],"Id":1869855,"PostDate":1409357218,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I am such a sucker for dresses. I always say to my fiance that I don't have shoe obsession like other girls, but I have a crazy dress obsession instead. Anyways, I've been really in love with the illusion-back dress look. I ask different sellers on AliExpress, Ebay and DHgate to show me real pictures of the dress they are selling before I will consider purchasing from them. Most of the sellers are nice and will provide pictures. One particular seller's dress caught my eye. I mulled and chewed over this dress since I bought one already from DressilyMe...and I still have my MaggieSottero.<\/p>\n<p>\u00a0<\/p>\n<p>5 months after talking to the seller and receiving pictures of the real dress, I still can't stop thinking about the dress.<\/p>\n<p>\u00a0<\/p>\n<p>I bit the bullet and bought this dress because I just LOVE dresses and it looks so purrrrttty! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wub.png' class='bbc_emoticon' alt=':wub:' \/>\u00a0I am planning to wear this dress either the day before the wedding's photoshoot or for the reception or for the TTD session. I haven't made the decision yet but I honestly think this dress looks pretty good for the price I paid ($166). It doesn't look too much like the original dress but it looks good even without looking at the original. Anyhoo, I bought the dress from YongGang Lin@ AliExpress. The seller is nice, willing to provide real pictures of the dress, and quick to respond. The dress came faster than expected.<\/p>\n<p>\u00a0<\/p>\n<p>My fiance doesn't know how to present the dress so unfortunately he doesn't know how to present the end of the dress. The only thing I'm concern about is fixing the illusion back.\u00a0They just expected my torso to be that of a supermodel so there is just a tad too much fabric on the back. I need to talk to my seamstress...<\/p>\n<p>\u00a0<\/p>\n<p><a class='resized_img' rel='lightbox[1869855]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2014\/post-270962-0-89700000-1409371496.jpg\" title=\"IMG_20140829_195113.jpg -  83.35KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2014\/post-270962-0-89700000-1409371496.jpg\" class='bbc_img linked-image' alt=\"IMG_20140829_195113.jpg\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n<p><a class='resized_img' rel='lightbox[1869855]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2014\/post-270962-0-82666700-1409371531.jpg\" title=\"IMG_20140829_195200.jpg -  104.32KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2014\/post-270962-0-82666700-1409371531.jpg\" class='bbc_img linked-image' alt=\"IMG_20140829_195200.jpg\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n<p><a class='resized_img' rel='lightbox[1869855]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2014\/post-270962-0-30481300-1409371564.jpg\" title=\"IMG_20140829_200251.jpg -  141.11KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2014\/post-270962-0-30481300-1409371564.jpg\" class='bbc_img linked-image' alt=\"IMG_20140829_200251.jpg\" \/><\/a>\n\n<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Our Awesome <a data-ipb='nomediaparse' href='https:\/\/www.wevideo.com\/hub\/#media\/ci\/113639543'>Video<\/a><\/p>\n<p>Our <a data-ipb='nomediaparse' href='http:\/\/itslegendary2014.wix.com\/fasa'>Website<\/a><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/76802-elsas-arthurs-wedding-rprm-20141208\/'>Riu Palace Riviera Maya Planning Thread<\/a><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/76802-elsas-arthurs-wedding-rprm-20141208\/?p=1864158'>Pre-wedding photos<\/a>,\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/76802-elsas-arthurs-wedding-rprm-20141208\/?p=1878020'>OOT Baskets<\/a>, <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/76802-elsas-arthurs-wedding-rprm-20141208\/?p=1878578'>Centrepieces<\/a><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/76802-elsas-arthurs-wedding-rprm-20141208\/?p=1852686'>DIY - Giant Crepe Roses<\/a>,\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/76802-elsas-arthurs-wedding-rprm-20141208\/?p=1867378'>DIY - Hangers & Boutonnieres<\/a>,\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/76802-elsas-arthurs-wedding-rprm-20141208\/?p=1867696'>DIY - Kissing Menu\/I Spy & Guestbook<\/a><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/76802-elsas-arthurs-wedding-rprm-20141208\/page-6#entry1878023'>More DIYs - Passport to Riviera Maya, Bookmarks, Tumbler Inserts, Luggage Tags, Keycard Holder Inserts, Something Special for You Inserts<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"elsa_jam@yahoo.com","IpAddress":"23.16.109.98","GroupId":40,"GroupName":"Jr. Member","JoinDate":1372273518,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270962.png?_r=1397000926","PhotoWidth":200,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Icis","Id":270962,"Name":"Icis","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.47.27.141","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"df9ee89d1d7ba6ffc6f6dee238a79b48","RawContent":"Any recent updates from those who ordered a dress from Jasmine?","Attachments":[],"Id":1875356,"PostDate":1413103337,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Any recent updates from those who ordered a dress from Jasmine?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"carter.watson2015@gmail.com","IpAddress":"71.47.13.201","GroupId":39,"GroupName":"Newbie","JoinDate":1393524530,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276925.jpg?_r=1393540000","PhotoWidth":150,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"AyeWatSoon","Id":276925,"Name":"AyeWatSoon","IsOnline":false}}],"Pages":{"TotalItems":6402,"TotalPages":641,"CurrentPage":6340,"NextPage":6350,"PreviousPage":6330,"LastPage":6400},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
