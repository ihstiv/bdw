TotalLikes":0,"IsLiked":false,"PostKey":"960f01b359d0e4bcfe4b2b72991afd67","RawContent":"Hanssel finally &amp;quot;officially&amp;quot; proposed last night! Now I can show off my ring.&lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile159.gif\" border=\"0\" alt=\"\" title=\"Smile159\" class=\"inlineimg\" \/&gt; &lt;img src=\"http:\/\/bestdestinationwedding.com\/forum\/imagehosting\/584457c50bd9bb05.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;&lt;\/a&gt;","Attachments":[],"Id":11102,"PostDate":1165778648,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hanssel finally \"officially\" proposed last night! Now I can show off my ring.<span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile159.gif\" border=\"0\" alt=\"\" title=\"Smile159\" class=\"inlineimg\" \/><\/span> <a href='http:\/\/bestdestinationwedding.com\/forum\/vbimghost.php?do=displayimg&imgid=388' class='bbc_url' title='External link' rel='nofollow external'><a href=\"http:\/\/bestdestinationwedding.com\/forum\/imagehosting\/584457c50bd9bb05.jpg\" rel=\"lytebox[posts]\"><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bestdestinationwedding.com\/forum\/imagehosting\/584457c50bd9bb05.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><\/a><\/a>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"Photo by <a class='bbc_url' href='http:\/\/www.monicamartinphotography.com\/blog'>www.monicamartinphotography.com\/blog<\/a><br \/>\n<a class='bbc_url' href='http:\/\/bestdestinationwedding.com\/forum\/f128\/amyhs-planning-galore-24132\/index10.html'>Planning Pics!<\/a> <a class='bbc_url' href='http:\/\/bestdestinationwedding.com\/forum\/f77\/amyhs-puerto-vallarta-wedding-more-review-works-25255\/index4.html'>PV and Wedding Review<\/a><strong class='bbc'><a class='bbc_url' href='http:\/\/picasaweb.google.com\/amyhmartin\/ProfessionalWeddingPictures?authkey=w0DgS3ao1sI#'>Pro Pics (1)<\/a>; <a class='bbc_url' href='http:\/\/picasaweb.google.com\/amyhmartin\/ProfessionalWeddingPictures2?authkey=vbG3xUMVk1s#'>Pro Pics (2)<\/a><\/strong> <strong class='bbc'>By Nataly Lemus Photography and Rodolfo Arpia Photography<\/strong> <a class='bbc_url' href='http:\/\/natalylemusphoto.blogspot.com\/2008\/07\/amy-hanssel-married.html'>Teaser Pro Pics from Nataly Lemus Photogaphy<\/a><a class='bbc_url' href='http:\/\/www.arpiaphotoblog.com\/2008\/07\/puerto-vallarta-destination-wedding_3102.html'>Teaser Pro Pics from Rodolfo Arpia Photography<\/a>","Email":"amyhmartin@gmail.com","IpAddress":"98.119.192.139","GroupId":46,"GroupName":"VIP Member","JoinDate":1162157640,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206875.jpg?_r=0","PhotoWidth":200,"PhotoHeight":285,"PhotoType":"custom"},"FormattedName":"amyh","Id":206875,"Name":"amyh","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"85b5239be896afe6f07013de6077b98f","RawContent":"&lt;font face=\"Times New Roman\"&gt;&lt;font face=\"Century Gothic\"&gt;All these gorgeous rings - agh...&lt;\/font&gt;&lt;\/font&gt;\n \n &lt;font face=\"Times New Roman\"&gt;&lt;font face=\"Century Gothic\"&gt;My ring is a cushion cut in a platinum diamond wire setting. The ring&#039;s shank is single not double wire with a Single Row of Pave Diamonds unlike in the attached picture. When i saw it, I knew I had to have it :)\n \n &lt;\/font&gt;&lt;\/font&gt;\n &lt;img src=\"http:\/\/i197.photobucket.com\/albums\/aa240\/carlymcmullen\/BDW%20Photos%20for%20Others\/loretuke1.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt; &lt;img src=\"http:\/\/i197.photobucket.com\/albums\/aa240\/carlymcmullen\/BDW%20Photos%20for%20Others\/loretuke2.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;&lt;p&gt;&amp;nbsp;&lt;\/p&gt;&lt;span huddler_attributes=\"{&amp;quot;plugin&amp;quot;:&amp;quot;attachment&amp;quot;,&amp;quot;params&amp;quot;:{&amp;quot;id&amp;quot;:&amp;quot;3800&amp;quot;,&amp;quot;name&amp;quot;:&amp;quot;my ring.doc&amp;quot;,&amp;quot;description&amp;quot;:&amp;quot;&amp;quot;,&amp;quot;size&amp;quot;:75.5,&amp;quot;type&amp;quot;:&amp;quot;doc&amp;quot;}}\" huddler_plugin=\"attachment\"&gt;&amp;nbsp;&lt;\/span&gt;","Attachments":[],"Id":11223,"PostDate":1165871816,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <font face=\"Times New Roman\"><font face=\"Century Gothic\">All these gorgeous rings - agh...<\/font><\/font><br \/> <br \/> <font face=\"Times New Roman\"><font face=\"Century Gothic\">My ring is a cushion cut in a platinum diamond wire setting. The ring's shank is single not double wire with a Single Row of Pave Diamonds unlike in the attached picture. When i saw it, I knew I had to have it <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br \/> <br \/> <\/font><\/font><br \/> <a href='http:\/\/i197.photobucket.com\/albums\/aa240\/carlymcmullen\/BDW%20Photos%20for%20Others\/loretuke1.jpg' class='bbc_url' title='External link' rel='nofollow external'><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i197.photobucket.com\/albums\/aa240\/carlymcmullen\/BDW%20Photos%20for%20Others\/loretuke1.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><\/a> <a href='http:\/\/i197.photobucket.com\/albums\/aa240\/carlymcmullen\/BDW%20Photos%20for%20Others\/loretuke2.jpg' class='bbc_url' title='External link' rel='nofollow external'><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i197.photobucket.com\/albums\/aa240\/carlymcmullen\/BDW%20Photos%20for%20Others\/loretuke2.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><\/a><p>\u00a0<\/p><span huddler_attributes=\"{\"plugin\":\"attachment\",\"params\":{\"id\":\"3800\",\"name\":\"my ring.doc\",\"description\":\"\",\"size\":75.5,\"type\":\"doc\"}}\" huddler_plugin=\"attachment\">\u00a0<\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Loreta<\/span><br><br><a data-ipb='nomediaparse' href=\"http:\/\/www.studiocontempo.com\/trashthedress\/\">http:\/\/www.studiocontempo.com\/trashthedress\/<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/ourwedding.studiocontempo.com\">http:\/\/ourwedding.studiocontempo.com<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/studiocontempo.blogspot.com\">http:\/\/studiocontempo.blogspot.com<\/a><\/div><\/div>","Email":"lray@spt.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1163542740,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206901.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"loretuke","Id":206901,"Name":"loretuke","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7d70db30a0ee74defdbd642236647d18","RawContent":"Natasha - I (this Natasha) did the same thing. I either wear my engagement ring:\n \n &lt;img src=\"http:\/\/www.tiffany.com\/shared\/images\/diamond\/photo\/engagement_fancy_pearsides.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;&lt;\/a&gt;\n \n or my wedding band (this is actually a really pretty ring but this image is awful!)\n \n &lt;font face=\"Times New Roman\"&gt;&lt;img src=\"http:\/\/bestdestinationwedding.com\/forum\/imagehosting\/111457e2280cc2f4.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;&lt;\/font&gt;\n \n \n But I don&#039;t ever wear them together. Also, my Ering is still way too big even though I had it sized once. I just don&#039;t have time to deal with it, though!","Attachments":[],"Id":11299,"PostDate":1165898119,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Natasha - I (this Natasha) did the same thing. I either wear my engagement ring:<br \/> <br \/> <a href='http:\/\/javascript%3cb%3e%3c\/b%3E:enlargedView('engagement_fancy_pearsides','',2);' class='bbc_url' title='External link' rel='nofollow external'><a href=\"http:\/\/www.tiffany.com\/shared\/images\/diamond\/photo\/engagement_fancy_pearsides.jpg\" rel=\"lytebox[posts]\"><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/www.tiffany.com\/shared\/images\/diamond\/photo\/engagement_fancy_pearsides.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><\/a><\/a><br \/> <br \/> or my wedding band (this is actually a really pretty ring but this image is awful!)<br \/> <br \/> <font face=\"Times New Roman\"><a href='http:\/\/bestdestinationwedding.com\/forum\/imagehosting\/111457e2280cc2f4.jpg' class='bbc_url' title='External link' rel='nofollow external'><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bestdestinationwedding.com\/forum\/imagehosting\/111457e2280cc2f4.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><\/a><\/font><br \/> <br \/> <br \/> But I don't ever wear them together. Also, my Ering is still way too big even though I had it sized once. I just don't have time to deal with it, though!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Shawn and NatashaHappily MarriedNovember 11, 2006<\/span><\/div><\/div>","Email":"xtra858sd@yahoo.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1143521820,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206727.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"NATASHA","Id":206727,"Name":"NATASHA","IsOnline":false}}],"Pages":{"TotalItems":2108,"TotalPages":211,"CurrentPage":10,"NextPage":20,"PreviousPage":0,"LastPage":2100},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
