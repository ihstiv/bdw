{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":58148,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9b9d42d00de25ebd6d46f50f75c4f95f","RawContent":"&lt;p&gt; Earlier is always better than later.&lt;\/p&gt;","Attachments":[],"Id":1426913,"PostDate":1301525173,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Earlier is always better than later.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Dreams Palm Beach Punta Cana<\/span><br><strong>April 2012<\/strong><\/div><\/div>","Email":"mandys827@aim.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1299610689,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-237577.JPG?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"mandys","Id":237577,"Name":"mandys","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":58148,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c71567cb3e4fd0a612c6b1216eb550d7","RawContent":"&lt;p&gt; We bought ours last thursday and we are not getting married until july 28th 2012! : )&lt;\/p&gt;","Attachments":[],"Id":1426919,"PostDate":1301525698,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> We bought ours last thursday and we are not getting married until july 28th 2012! : )<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jamieblum@ymail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1298334194,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-237060.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"jamieirene","Id":237060,"Name":"jamieirene","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":58148,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2647002413bad44781613cdad74a7058","RawContent":"&lt;p&gt; Personally, I want to get that step out of the way as soon as possible, but we&#039;re also going short engagement (engagement: soon, wedding: 9\/3\/11)&lt;\/p&gt;","Attachments":[],"Id":1427979,"PostDate":1301673060,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Personally, I want to get that step out of the way as soon as possible, but we're also going short engagement (engagement: soon, wedding: 9\/3\/11)<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"harkatea@bethel.edu","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1301592357,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-238405.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"harkatea","Id":238405,"Name":"harkatea","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":58148,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7ae686bbce37179be7de7db4e0539ff6","RawContent":"&lt;p&gt; I bought mine already but FI hasnt bought his yet.&amp;nbsp; We decided to buy mine as I knew exactly what I wanted and found it on 50% sale at the store, we had the money and thought might as well buy it now then wait till its not on sale.&amp;nbsp; We saved ourselves over $400 dollars.&amp;nbsp; FI knows what he wants but we are just waiting until hopefully it will go on sale soon!&amp;nbsp; I don&#039;t think there is a set time to buy it.&lt;\/p&gt;","Attachments":[],"Id":1428931,"PostDate":1301917944,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I bought mine already but FI hasnt bought his yet.\u00a0 We decided to buy mine as I knew exactly what I wanted and found it on 50% sale at the store, we had the money and thought might as well buy it now then wait till its not on sale.\u00a0 We saved ourselves over $400 dollars.\u00a0 FI knows what he wants but we are just waiting until hopefully it will go on sale soon!\u00a0 I don't think there is a set time to buy it.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jkergen@hotmail.com","IpAddress":"137.186.71.240","GroupId":42,"GroupName":"Sr. Member","JoinDate":1293145500,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-234788.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"JayKay","Id":234788,"Name":"JayKay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"122.173.227.242","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":58148,"EditedBy":"","EditDate":1437023458,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a619266e1f39a5a842e08d8c06b52be3","RawContent":"&lt;div&gt;Hi Stephanie,&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;Congratulations!!&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;Its always advisable to buy the wedding rings only after you have done a proper research and you are sure that you are getting the ring at the best price.&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;Well, I purchased my &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.eternitybyyoni.com&#039;&gt;&lt;strong&gt;wedding bands&lt;\/strong&gt;&lt;\/a&gt; 6 months before my wedding and after a thorough research.&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;After seen wedding ring pictures of other people, I got tempted to post mine... oops ...&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;&lt;img src=\"http:\/\/www.eternitybyyoni.com\/products\/Bands\/3523BD.jpg\" alt=\"3523BD.jpg\"&gt;&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;Have a good day!&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;Thanks&lt;\/div&gt;","Attachments":[],"Id":1900563,"PostDate":1437023050,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div>Hi Stephanie,\u00a0<\/div>\n<div>\u00a0<\/div>\n<div>Congratulations!!\u00a0<\/div>\n<div>\u00a0<\/div>\n<div>Its always advisable to buy the wedding rings only after you have done a proper research and you are sure that you are getting the ring at the best price.\u00a0<\/div>\n<div>\u00a0<\/div>\n<div>Well, I purchased my <a href='http:\/\/www.eternitybyyoni.com' class='bbc_url' title='External link' rel='nofollow external'><strong>wedding bands<\/strong><\/a> 6 months before my wedding and after a thorough research.\u00a0<\/div>\n<div>\u00a0<\/div>\n<div>After seen wedding ring pictures of other people, I got tempted to post mine... oops ...<\/div>\n<div>\u00a0<\/div>\n<div><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/www.eternitybyyoni.com\/products\/Bands\/3523BD.jpg\" alt=\"3523BD.jpg\"><\/span><\/div>\n<div>\u00a0<\/div>\n<div>Have a good day!<\/div>\n<div>\u00a0<\/div>\n<div>Thanks<\/div>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"christinaandersonus@gmail.com","IpAddress":"122.173.175.233","GroupId":39,"GroupName":"Newbie","JoinDate":1437021772,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283990.jpg?_r=1437037518","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"ChristianaAnderson","Id":283990,"Name":"ChristianaAnderson","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"122.15.103.61","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":58148,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f687a6a5f07cc8f2eac193edd677e049","RawContent":"&lt;p&gt;Most of the wedding take place at winter season so that that you will get most of the fresh stock for your dress. so i will suggest to search near by oct to dec month.&lt;\/p&gt;","Attachments":[],"Id":1902970,"PostDate":1440059597,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Most of the wedding take place at winter season so that that you will get most of the fresh stock for your dress. so i will suggest to search near by oct to dec month.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rahulthakur01@hotmail.com","IpAddress":"122.15.103.61","GroupId":39,"GroupName":"Newbie","JoinDate":1438822568,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"rahulthakur01","Id":284300