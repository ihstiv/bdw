50\" timestamp=\"1431366163\"]\nWhat was your date[\/quote]\nMay 1, 2016","Attachments":[],"Id":1895976,"PostDate":1431384040,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>carrieandsam, on Yesterday, 11:42 AM, said:<\/p><div class='blockquote'><div class='quote'><p>What was your date<\/p><\/div><\/div><br>\nMay 1, 2016\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"paul_stacy@hotmail.com","IpAddress":"75.159.217.151","GroupId":39,"GroupName":"Newbie","JoinDate":1431077321,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"StacyPaul","Id":283027,"Name":"StacyPaul","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"76.169.241.1","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":18414,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2d2501c8fd20e8583bdd27597ba80b13","RawContent":"Hopefully it does work out for. May does seem like a popular month for weddings down there. Best of luck","Attachments":[],"Id":1895977,"PostDate":1431385552,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hopefully it does work out for. May does seem like a popular month for weddings down there. Best of luck\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"carrieandsamswedding15@gmail.com","IpAddress":"76.169.253.92","GroupId":39,"GroupName":"Newbie","JoinDate":1412813196,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280407.jpg?_r=1425426307","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"carrieandsam","Id":280407,"Name":"carrieandsam","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.225.204.185","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":18414,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"b18f8fee58e2a6d60156c00b8f504aaf","RawContent":"Hi Past and Future Brides, \n\nWe are working on our gratuity list and budget. Who did you\/do you plan to tip?","Attachments":[],"Id":1896075,"PostDate":1431458064,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi Past and Future Brides, <br>\nWe are working on our gratuity list and budget. Who did you\/do you plan to tip? \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"keredondo@gmail.com","IpAddress":"108.225.204.185","GroupId":39,"GroupName":"Newbie","JoinDate":1403624419,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278682.jpg?_r=1414954781","PhotoWidth":187,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"BecomingaRiggio","Id":278682,"Name":"BecomingaRiggio","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.46.210.160","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":18414,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"76b2b437fab67c5fd16a692c89f0796b","RawContent":"[quote name=\"BecomingaRiggio\" post=\"1896075\" timestamp=\"1431479664\"]\nHi Past and Future Brides, \nWe are working on our gratuity list and budget. Who did you\/do you plan to tip?[\/quote]Great question! I would like to know as well.\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1896076,"PostDate":1431458140,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>BecomingaRiggio, on Today, 07:14 PM, said:<\/p><div class='blockquote'><div class='quote'><p>Hi Past and Future Brides, <br>\nWe are working on our gratuity list and budget. Who did you\/do you plan to tip?<\/p><\/div><\/div>\n<br>\nGreat question! I would like to know as well.<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lauren.rapkin@gmail.com","IpAddress":"100.2.22.205","GroupId":39,"GroupName":"Newbie","JoinDate":1330612103,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-252152.jpg?_r=1397073315","PhotoWidth":200,"PhotoHeight":193,"PhotoType":"custom"},"FormattedName":"LaurenR","Id":252152,"Name":"LaurenR","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.225.204.185","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":18414,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"66a7be08cb1f3668049b93b2214177bd","RawContent":"@[member=\"LaurenR\"] so far we have this list: \n\nWedding coordinator (on site), housekeeping, favorite bartender, reception staff, welcome dinner staff, brunch staff, favorite bartender and photographer. Shoot, long list.","Attachments":[],"Id":1896079,"PostDate":1431458673,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"252152\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/252152-laurenr\/' title='Member profile'><span itemprop=\"name\">LaurenR<\/span><\/a> so far we have this list: <br>\nWedding coordinator (on site), housekeeping, favorite bartender, reception staff, welcome dinner staff, brunch staff, favorite bartender and photographer. Shoot, long list. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"keredondo@gmail.com","IpAddress":"108.225.204.185","GroupId":39,"GroupName":"Newbie","JoinDate":1403624419,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278682.jpg?_r=1414954781","PhotoWidth":187,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"BecomingaRiggio","Id":278682,"Name":"BecomingaRiggio","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.46.210.160","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":18414,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e999597d99a463329c48f45ec470ec70","RawContent":"How much is an appropriate amount to tip? I have no clue!! \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1896082,"PostDate":1431459736,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                How much is an appropriate amount to tip? I have no clue!! <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lauren.rapkin@gmail.com","IpAddress":"100.2.22.205","GroupId":39,"GroupName":"Newbie","JoinDate":1330612103,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-252152.jpg?_r=1397073315","PhotoWidth":200,"PhotoHeight":193,"PhotoType":"custom"},"FormattedName":"LaurenR","Id":252152,"Name":"LaurenR","IsOnline":false}}],"Id":"18414","Title":"Azul Sensatori Brides - POST HERE!","LastPostDate":1431459736},"Pages":{"TotalItems":18709,"TotalPages":1871,"CurrentPage":18700,"NextPage":-1,"PreviousPage":18690,"LastPage":18700},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
