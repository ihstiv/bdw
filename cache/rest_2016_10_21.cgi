125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Sara88","Id":285131,"Name":"Sara88","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"180.215.230.224","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":69230,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"37c2ee1af686333d2b2b6734e8775b81","RawContent":"&lt;p&gt;&lt;span style=\"font-family:calibri, sans-serif;\"&gt;&lt;span style=\"font-size:11pt;\"&gt;I have been shopping from Dressilyme since last 2 years. It is a trust worthy site to buy products from it. Its my personal suggestion to buy from this site, because the quality they provide is too good and at a nice discounts.&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1907620,"PostDate":1447735493,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span  style=\"font-family:calibri, sans-serif\"><span  style=\"font-size:11pt\">I have been shopping from Dressilyme since last 2 years. It is a trust worthy site to buy products from it. Its my personal suggestion to buy from this site, because the quality they provide is too good and at a nice discounts.<\/span><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mihir_padariya@yahoo.com","IpAddress":"180.215.230.224","GroupId":39,"GroupName":"Newbie","JoinDate":1447735245,"Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"sara1roy","Id":285358,"Name":"sara1roy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"119.152.190.205","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":69230,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"eff86a0e96ece51b3ba097e59a5cd058","RawContent":"&lt;p&gt;&lt;span style=\"font-family:calibri, sans-serif;\"&gt;Hi, I recently purchased my wedding dress from Dressilyme.com It is elegant and glamorous and I feel like a movie star!&amp;nbsp; The dress is the perfect length for a summer\u2019s eve beach wedding. The lace details on the bodice are absolutely stunning and the back of the dress is exquisite!I was so worried about having to have it taken in, but it fits like a glove! Their prices are amazing and delivery time is superb! I will be purchasing my honeymoon lingerie from Dressilyme as well!&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-family:calibri, sans-serif;\"&gt;re: product: &lt;span style=\"color:rgb(51,51,51);\"&gt;STYLE NO.WWD27955&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1908617,"PostDate":1450844710,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span  style=\"font-family:calibri, sans-serif\">Hi, I recently purchased my wedding dress from Dressilyme.com It is elegant and glamorous and I feel like a movie star!\u00a0 The dress is the perfect length for 