{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":5,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":705,"MovedTo":null,"MovedOn":0,"FirstPostId":1902397,"Rating":0,"RatingHits":0,"Starter":{"Id":284394,"Name":"JonathanB","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284394.jpg?_r=1439445484","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":false},"StartDate":1439445408,"LastPoster":{"Id":278581,"Name":"beckys98","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":37,"Preview":{"Id":1902397,"PostDate":1439445408,"PostContent":"Hi! Need a small advice here. I\u2019m going to propose my girl after 3.5 years long relationship! For...","Author":{"Signature":"","Email":"daliamist@outlook.com","IpAddress":"209.44.96.58","GroupId":39,"GroupName":"Newbie","JoinDate":1439445148,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284394.jpg?_r=1439445484","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"JonathanB","Id":284394,"Name":"JonathanB","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"209.44.96.58","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79491,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"3911a1ad70b73ca39936d03d41ec7695","RawContent":"&lt;p&gt;&lt;span&gt;&lt;span style=\"font-size:12px;font-family:Georgia;color:rgb(20,20,20);\"&gt;Hi! Need a small advice here.&lt;\/span&gt;&lt;span style=\"font-size:12px;font-family:Georgia;color:rgb(20,20,20);\"&gt;&lt;span&gt; &lt;\/span&gt;&lt;\/span&gt;&lt;span style=\"font-size:12px;font-family:Georgia;color:rgb(20,20,20);\"&gt;I\u2019m going to propose my girl after 3.5 years long relationship! For past 8 months it\u2019s been a long distance relationship and she is coming to visit me this October for a week. We have a lot of plans and the best part is she\u2019s not expecting me to propose and I can imagine how happy and excited she will be once I propose her. I &amp;nbsp;got her a &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.pheradiamonds.com\/shop\/ballerine\/&#039;&gt;pretty antique engagement ring&lt;\/a&gt; from Vancouver. I am deciding between 3 places, top of the CN Tower maybe in the skydome, somewhere in the royal gardens, or niagara falls. Thing is, I\u2019ve never been there before so if anyone has and can shed some ideas on where would be perfect.&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span&gt;&lt;span style=\"font-size:12px;font-family:Georgia;color:rgb(20,20,20);\"&gt;Help please!&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;","Attachments":[],"Id":1902397,"PostDate":1439445408,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span><span  style=\"font-size:12px;font-family:Georgia;color:rgb(20,20,20)\">Hi! Need a small advice here.<\/span><span  style=\"font-size:12px;font-family:Georgia;color:rgb(20,20,20)\"><span> <\/span><\/span><span  style=\"font-size:12px;font-family:Georgia;color:rgb(20,20,20)\">I\u2019m going to propose my girl after 3.5 years long relationship! For past 8 months it\u2019s been a long distance relationship and she is coming to visit me this October for a week. We have a lot of plans and the best part is she\u2019s not expecting me to propose and I can imagine how happy and excited she will be once I propose her. I \u00a0got her a <a href='http:\/\/www.pheradiamonds.com\/shop\/ballerine\/' class='bbc_url' title='External link' rel='nofollow external'>pretty antique engagement ring<\/a> from Vancouver. I am deciding between 3 places, top of the CN Tower maybe in the skydome, somewhere in the royal gardens, or niagara falls. Thing is, I\u2019ve never been there before so if anyone has and can shed some ideas on where would be perfect.<\/span><\/span><\/p>\n<p><span><span  style=\"font-size:12px;font-family:Georgia;color:rgb(20,20,20)\">Help please!<\/span><\/span><\/p>\n<div>\u00a0<\/div>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"daliamist@outlook.com","IpAddress":"209.44.96.58","GroupId":39,"GroupName":"Newbie","JoinDate":1439445148,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284394.jpg?_r=1439445484","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"JonathanB","Id":284394,"Name":"JonathanB","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.87.237.201","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79491,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ed81d9eb9a9683da136f7c4882f9fc55","RawContent":"&lt;p&gt;Oh that&#039;s so sweet! The places you&#039;re thinking about are all wonderful but do you want somewhere private? Those places at this time of the year will all have a lot of people around. There are beautiful gardens in a lot of places but everywhere I think of will have other people. Could you go away for a night maybe? Somewhere that it can be just the two of you?&lt;\/p&gt;","Attachments":[],"Id":1902451,"PostDate":1439492170,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Oh that's so sweet! The places you're thinking about are all wonderful but do you want somewhere private? Those places at this time of the year will all have a lot of people around. There are beautiful gardens in a lot of places but everywhere I think of will have other people. Could you go away for a night maybe? Somewhere that it can be just the two of you?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span><\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/ann.chadwick.5\/media_set?set=a.10153262834771016.1073741828.569791015&type=3'><span style=\"color:#ff0099;\"><em>https:\/\/www.facebook.com\/ann.chadwick.5\/media_set?set=a.10153262834771016.1073741828.569791015&type=3<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/'><span style=\"color:#ff0099;\"><em>http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283458999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.87.42.110","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79491,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ae8082198fb4bb0698261fed336fa3b9","RawContent":"&lt;p&gt;My fiance proposed to me on a hot air balloon, it was so unique and I loved it! Just an idea.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1902505,"PostDate":1439561530,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>My fiance proposed to me on a hot air balloon, it was so unique and I loved it! Just an idea.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nicolechin4@yahoo.com","IpAddress":"68.87.42.110","GroupId":39,"GroupName":"Newbie","JoinDate":1407436909,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"JamaicaNicole","Id":279353,"Name":"JamaicaNicole","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.49.243.226","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79491,"EditedBy":"<strong>Edited by snswedding2016, 14 August 2015 - 07:00 AM.<\/strong>","EditDate":1439564431,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"e9be274c544c03c6736b5dc9ecb3faa5","RawContent":"&lt;p&gt;@[member=\"JonathanB\"] That&#039;s so exciting!! Congrats on the upcoming proposal! So it sounds like you&#039;ll be here in Toronto in October correct? (based on the CN tower and skydive mention)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I agree with @[member=\"acw271011\"] that those are great places but not the most private for a proposal if you&#039;re going for that. If you do want a little more public setting than those are big iconic sites in the city for sure.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;If you like the CN tower for the view you could book a reservation for dinner at the 360 restaurant (the rotating one that gives you a view of the entire city) or for something similar you could take her to The One Eighty (top of the Manulife centre at bay and floor) which also has AMAZING views and a rooftop balcony that you can have a gorgeous romantic moment.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;If you are willing to travel outside of the city - along the lines of Niagara Falls which you mentioned, you may want to consider Niagara on the Lake. It can be a bit pricey that time of year but will be absolutely beautiful in the fall. It&#039;s my favourite time to visit. They have some really amazing b&amp;amp;b&#039;s, great restaurant and many many wine tours available (if you&#039;re into that).&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I also love the Distillery District - the cobblestone, the lights, it&#039;s very charming...I really love walking around that area.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Is she from Toronto - is there a place that has special significance to her? That would also be very special.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1902515,"PostDate":1439564411,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"284394\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/284394-jonathanb\/' title='Member profile'><span itemprop=\"name\">JonathanB<\/span><\/a> That's so exciting!! Congrats on the upcoming proposal! So it sounds like you'll be here in Toronto in October correct? (based on the CN tower and skydive mention)<\/p>\n<p>\u00a0<\/p>\n<p>I agree with @<a hovercard-ref=\"member\" hovercard-id=\"232000\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/232000-acw271011\/' title='Member profile'><span itemprop=\"name\">acw271011<\/span><\/a> that those are great places but not the most private for a proposal if you're going for that. If you do want a little more public setting than those are big iconic sites in the city for sure.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>If you like the CN tower for the view you could book a reservation for dinner at the 360 restaurant (the rotating one that gives you a view of the entire city) or for something similar you could take her to The One Eighty (top of the Manulife centre at bay and floor) which also has AMAZING views and a rooftop balcony that you can have a gorgeous romantic moment.<\/p>\n<p>\u00a0<\/p>\n<p>If you are willing to travel outside of the city - along the lines of Niagara Falls which you mentioned, you may want to consider Niagara on the Lake. It can be a bit pricey that time of year but will be absolutely beautiful in the fall. It's my favourite time to visit. They have some really amazing b&b's, great restaurant and many many wine tours available (if you're into that).\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I also love the Distillery District - the cobblestone, the lights, it's very charming...I really love walking around that area.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Is she from Toronto - is there a place that has special significance to her? That would also be very special.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>My planning thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78916-snswedding2016-planning-thread-jan-9-2016-azul-fives\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78916-snswedding2016-planning-thread-jan-9-2016-azul-fives\/<\/a><\/p>\n<p>\u00a0<\/p>\n<div><a class='bbc_url' href='http:\/\/www.TickerFactory.com\/'><\/div>\n<div><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10730;0\/st\/20160109\/e\/Our+Wedding\/k\/9fa9\/event.png\" alt=\"event.png\"><\/div>\n<div><\/a><\/div>\n","Email":"sean.n.steph2016@gmail.com","IpAddress":"74.12.52.42","GroupId":3,"GroupName":"Member","JoinDate":1415547511,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281055.jpg?_r=1415590512","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"snswedding2016","Id":281055,"Name":"snswedding2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"159.53.46.141","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79491,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fbd346cba3871d7c436603f158888169","RawContent":"&lt;p&gt;@[member=\"JonathanB\"] obviously I don&#039;t know you or your bride, but my advice would definitely be to make sure proposing somewhere public is a good match with what she would want. My husband proposed at home (still a complete surprise) and I was so, so glad he did. It is a very surreal and special moment and I just wanted time to stand still to enjoy each other and appreciate the moment. I wanted to remember every second, every word he said, every detail of our surroundings. He did, however, have my friends and family waiting for us at a bar to party afterward which was so perfect! We got the private moment AND the celebration.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;m sure you know your gal, but just wanted to throw it out there.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;CONGRATULATIONS!&lt;\/p&gt;","Attachments":[],"Id":1902543,"PostDate":1439575572,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"284394\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/284394-jonathanb\/' title='Member profile'><span itemprop=\"name\">JonathanB<\/span><\/a> obviously I don't know you or your bride, but my advice would definitely be to make sure proposing somewhere public is a good match with what she would want. My husband proposed at home (still a complete surprise) and I was so, so glad he did. It is a very surreal and special moment and I just wanted time to stand still to enjoy each other and appreciate the moment. I wanted to remember every second, every word he said, every detail of our surroundings. He did, however, have my friends and family waiting for us at a bar to party afterward which was so perfect! We got the private moment AND the celebration.<\/p>\n<p>\u00a0<\/p>\n<p>I'm sure you know your gal, but just wanted to throw it out there.<\/p>\n<p>\u00a0<\/p>\n<p>CONGRATULATIONS!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rebecca.shaffer@gmail.com","IpAddress":"159.53.174.144","GroupId":3,"GroupName":"Member","JoinDate":1403116087,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"beckys98","Id":278581,"Name":"beckys98","IsOnline":false}}],"Id":"79491","Title":"Romantic Place To Propose","LastPostDate":1439575572},"Pages":{"TotalItems":5,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
