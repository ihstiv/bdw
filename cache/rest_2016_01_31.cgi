.com\/blog\/real-wedding-chanel-derick%E2%80%A8<\/a><\/p><span><\/span><\/div><\/div>","Email":"chanel.conley@gmail.com","IpAddress":"72.78.193.252","GroupId":42,"GroupName":"Sr. Member","JoinDate":1275117649,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-228663.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"coconoir1908","Id":228663,"Name":"coconoir1908","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":61925,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a34cd340db96ae0d1400e22eb131fe6d","RawContent":"&lt;p&gt; I ordered through Etsy - seller was Mavora&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I then attached a papaya colored card to the magnet and sent them in the cream envelopes.&amp;nbsp; Guests loved them!&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"Stefanie%20tag[1].JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/498770\/width\/1000\/height\/500\" \/&gt;&lt;\/p&gt;","Attachments":[],"Id":1494717,"PostDate":1311871250,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I ordered through Etsy - seller was Mavora<\/p> <p> \u00a0<\/p> <p> I then attached a papaya colored card to the magnet and sent them in the cream envelopes.\u00a0 Guests loved them!<\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"Stefanie%20tag[1].JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/498770\/width\/1000\/height\/500\" \/><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"shaunandstefanie@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1295551451,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-235778.jpg?_r=0","PhotoWidth":200,"PhotoHeight":215,"PhotoType":"custom"},"FormattedName":"Starfish0512","Id":235778,"Name":"Starfish0512","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":61925,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8ec9c649e439241116fcd6609fdaae80","RawContent":"Great colors!!!  Did you make these?!  I&#039;m taking the boarding pass route for our invites!\n \n   [quote]\nOriginally Posted by [b]coconoir1908[\/b] \/img\/forum\/go_quote.gif\n \n \n Fly STDs ladies... Here&#039;s ours \n [img]http:\/\/www.bestdestinationwedding.com\/image\/id\/470838\/width\/1000\/height\/500[\/img] \n [img]http:\/\/www.bestdestinationwedding.com\/image\/id\/470840\/width\/1000\/height\/500[\/img] \n [img]http:\/\/www.bestdestinationwedding.com\/image\/id\/470842\/width\/1000\/height\/500[\/img][\/quote]","Attachments":[],"Id":1494718,"PostDate":1311871312,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Great colors!!!\u00a0 Did you make these?!\u00a0 I'm taking the boarding pass route for our invites!<br \/> <br \/> \u00a0<\/p> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>coconoir1908<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" style=\"border-bottom: 0px solid; border-left: 0px solid; border-top: 0px solid; border-right: 0px solid\" \/><\/span><br \/> <br \/> <p> Fly STDs ladies... Here's ours<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"095.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/470838\/width\/1000\/height\/500\" \/><\/span><\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"098.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/470840\/width\/1000\/height\/500\" \/><\/span><\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"110.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/470842\/width\/1000\/height\/500\" \/><\/span><\/p> <\/blockquote> <br \/> <br \/> <p> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"shaunandstefanie@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1295551451,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-235778.jpg?_r=0","PhotoWidth":200,"PhotoHeight":215,"PhotoType":"custom"},"FormattedName":"Starfish0512","Id":235778,"Name":"Starfish0512","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":61925,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"e1cd7b5b82147142920c38198fbffc28","RawContent":"&lt;p&gt; Here are our STD&#039;s Sorry I dont know why the pictures are so small...&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p