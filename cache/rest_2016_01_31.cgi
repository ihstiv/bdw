irthday weekend. It was a great birthday surprise <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tanyamaynigo@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1204702359,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208722.gif?_r=0","PhotoWidth":73,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"antonia321","Id":208722,"Name":"antonia321","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":12665,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"92ce2be8b69345fca307ccbc26c79aef","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;trisha0612&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;2 1\/2 before we got engaged, but we just had our 3 year anniversary..although, we always overlook them. I usually say..awww...3 years ago (2 yrs, 1 yr) we had our first date....and he says...HONEY and resumes his Call of Duty 4&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;\n Hehe... gotta love boys! I write ours on the calender and my FI is so proud when he &amp;quot;remembers&amp;quot; and says it first.","Attachments":[],"Id":223770,"PostDate":1205213416,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>trisha0612<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">2 1\/2 before we got engaged, but we just had our 3 year anniversary..although, we always overlook them. I usually say..awww...3 years ago (2 yrs, 1 yr) we had our first date....and he says...HONEY and resumes his Call of Duty 4<\/div> <\/td> <\/tr> <\/table> <\/div><br \/> Hehe... gotta love boys! I write ours on the calender and my FI is so proud when he \"remembers\" and says it first.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bnagan09@yahoo.com","IpAddress":"71.195.38.131","GroupId":42,"GroupName":"Sr. Member","JoinDate":1196754998,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208004.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Bride010101","Id":208004,"Name":"Bride010101","IsOnline":false}}],"Pages":{"TotalItems":875,"TotalPages":88,"CurrentPage":20,"NextPage":30,"PreviousPage":10,"LastPage":870},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
