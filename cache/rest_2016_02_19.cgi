{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":2,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":585,"MovedTo":null,"MovedOn":0,"FirstPostId":1908879,"Rating":0,"RatingHits":0,"Starter":{"Id":285746,"Name":"shanay0321","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-285746.jpg?_r=1451801267","PhotoWidth":200,"PhotoHeight":113,"PhotoType":"custom"},"IsOnline":false},"StartDate":1451804065,"LastPoster":{"Id":230028,"Name":"TA Patty","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230028.jpg?_r=1398727965","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":22,"Preview":{"Id":1908879,"PostDate":1451804065,"PostContent":"Hi everyone  My name is shanay. I got engaged in October 2015 in the Dominican Republic and will...","Author":{"Signature":"","Email":"swong0321@gmail.com","IpAddress":"104.136.185.51","GroupId":3,"GroupName":"Member","JoinDate":1451801265,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-285746.jpg?_r=1451801267","PhotoWidth":200,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"shanay0321","Id":285746,"Name":"shanay0321","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"104.136.185.51","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79829,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"09b7957b71396cbee642351ad89aed8b","RawContent":"Hi everyone \n\nMy name is shanay. I got engaged in October 2015 in the Dominican Republic and will also be getting married there in November of this year. After a long search and lot&#039;s of headaches we finally made a decision on the Riu palace.\n\n\nThe package they offering is the best out of all the other resorts we looked at and it covers up to 40 guest with a 25 dollars free for anything over the 40 which isn&#039;t bad at all. My only problem is the cost per person per night. I have a travel agent and she got us $122 double occupancy, which in my heart I know is a good deal but I can&#039;t help but feel it&#039;s still a lot.\n\n\nWe are only doing 4 nights 5 day&#039;s nothing more. Also some of the people we are inviting have kids which is 60 dollars a night for two year&#039;s and older. So my question is have anyone stayed at this hotel before or know anyone that got married there? And if yes how was the experience?\n\n\n\nThank you in advance!\n\n\nSent from my SM-G900T using Tapatalk","Attachments":[],"Id":1908879,"PostDate":1451804065,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi everyone <br>\nMy name is shanay. I got engaged in October 2015 in the Dominican Republic and will also be getting married there in November of this year. After a long search and lot's of headaches we finally made a decision on the Riu palace.<br><br>\nThe package they offering is the best out of all the other resorts we looked at and it covers up to 40 guest with a 25 dollars free for anything over the 40 which isn't bad at all. My only problem is the cost per person per night. I have a travel agent and she got us $122 double occupancy, which in my heart I know is a good deal but I can't help but feel it's still a lot.<br><br>\nWe are only doing 4 nights 5 day's nothing more. Also some of the people we are inviting have kids which is 60 dollars a night for two year's and older. So my question is have anyone stayed at this hotel before or know anyone that got married there? And if yes how was the experience?<br><br><br>\nThank you in advance!<br><br>\nSent from my SM-G900T using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"swong0321@gmail.com","IpAddress":"104.136.185.51","GroupId":3,"GroupName":"Member","JoinDate":1451801265,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-285746.jpg?_r=1451801267","PhotoWidth":200,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"shanay0321","Id":285746,"Name":"shanay0321","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"172.88.206.62","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79829,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0d9169260b4eda5d5e306b30829c2db4","RawContent":"&lt;p&gt;Hi Shanay - Congratulations on your engagement! My name is Patty Jordan and I am one of the BDW TA&#039;s and have stayed at Riu Palace Bavaro. Please let me know what quesiotns I can answer for you. You can email me directly at patty@wrighttravelagency.com. Thanks! TA Patty&lt;\/p&gt;","Attachments":[],"Id":1908880,"PostDate":1451805125,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Shanay - Congratulations on your engagement! My name is Patty Jordan and I am one of the BDW TA's and have stayed at Riu Palace Bavaro. Please let me know what quesiotns I can answer for you. You can email me directly at patty@wrighttravelagency.com. Thanks! TA Patty<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><a class='bbc_url' href='http:\/\/wrighttravelagency.com\/inquiry\/'><span style='color: rgb(0,128,128)'>Looking for a travel agency that specializes in Destination Weddings<\/span><\/a><span style='color: rgb(0,128,128)'>? We are an award winning travel agency and you can read our reviews <\/span><a class='bbc_url' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style='color: rgb(0,128,128)'><strong class='bbc'>HERE.<\/strong><\/span><\/a><\/span><\/span><br \/>\n<br \/>\n<span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'><strong class='bbc'>Awards and recognition: <\/strong><\/span><\/span><\/span><\/span><br \/>\n<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'>Palace Resorts Top PRO Agency <\/span><\/span><\/span><\/span><br \/>\n<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'>Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator <\/span><\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>AMResorts Master Agent & Top Agency<\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>Travel Impressions Best of the Best Globe Winner<\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>Apple Vacations Golden Apple Winner<\/span><\/span><\/span><span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='font-size: 12px;'><span style='color: rgb(0,128,128)'>5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | AMResorts Master Agent & Top Agency | <\/span><span style='color: rgb(0,128,128)'>Travel Impressions Best of the Best Globe Winner | Apple Vacations Golden Apple Winner <\/span><\/span><\/span><\/span>","Email":"patty@wrighttravelagency.com","IpAddress":"76.95.92.213","GroupId":49,"GroupName":"Insiders","JoinDate":1278657480,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230028.jpg?_r=1398727965","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"TA Patty","Id":230028,"Name":"TA Patty","IsOnline":false}}],"Id":"79829","Title":"Riu Palace, Punta Cana","LastPostDate":1451805125},"Pages":{"TotalItems":2,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
