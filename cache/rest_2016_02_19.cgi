mg .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Did u guys have to send your desposit via Western Union?  Did anyone have any hiccups with this ?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nagrant84@gmail.com","IpAddress":"71.179.102.89","GroupId":39,"GroupName":"Newbie","JoinDate":1376793703,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272689.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"MzDimplez915","Id":272689,"Name":"MzDimplez915","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.63.242.236","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76767,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"dd89228da3553a81bf04aafaf6c082b2","RawContent":"&lt;p&gt;My fianc\u00e9 and I are getting married at Kukua on 12-13-14!!&amp;nbsp; We can&#039;t wait for December to get here!!!!&lt;\/p&gt;","Attachments":[],"Id":1845313,"PostDate":1398048634,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>My fianc\u00e9 and I are getting married at Kukua on 12-13-14!!\u00a0 We can't wait for December to get here!!!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"olivia_colt.murski@outlook.com","IpAddress":"68.63.242.236","GroupId":40,"GroupName":"Jr. Member","JoinDate":1392688576,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276756.jpg?_r=1399903658","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"colivia","Id":276756,"Name":"colivia","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"161.185.158.21","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76767,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"14ac1bc82a3fd936a25d53493d64520f","RawContent":"&lt;p&gt;@[member=\"colivia\"] Congrats:) How is the planning going?&lt;\/p&gt;","Attachments":[],"Id":1845337,"PostDate":1398086589,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"276756\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/276756-colivia\/' title='Member profile'><span itemprop=\"name\">colivia<\/span><\/a> Congrats:) How is the planning going?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p style=\"text-align:center;\">\u00a0 \u00a0 \u00a0 \u00a0 \u00a0 Future Mrs. Bonitto 12\/14\/16<\/p>\n<div><br><div style=\"text-align:center;\"><br><div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.weddingcountdown.com\/\"><img src=\"http:\/\/img.weddingcountdown.com\/ticker\/30ag12yqu333h.png\" alt=\"30ag12yqu333h.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<\/div>\n<\/div>\n<p>\u00a0","Email":"shamicaglover@yahoo.com","IpAddress":"161.185.157.23","GroupId":40,"GroupName":"Jr. Member","JoinDate":1394133176,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277031.jpg?_r=1397251056","PhotoWidth":200,"PhotoHeight":203,"PhotoType":"custom"},"FormattedName":"MrandMrsBonitto2016","Id":277031,"Name":"MrandMrsBonitto2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.210.17.128","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76767,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2756f03e4d84662cfec1f90e24c070f3","RawContent":"Thank you so much! The planning is going great. We haven&#039;t chosen a color scheme or anything yet. We have booked our photographer, videographer, sent out save the dates, and almost have our invites ready to print and assemble. That&#039;s all we&#039;ve done so far. I feel like we&#039;ve done a ton more, but on paper it doesn&#039;t look like we&#039;ve done much. haha. Bego has been amazing this far and was very quick to answer the million questions I emailed her. We have chosen Now Larimar as our resort. One of my best friends was married in Punta Cana a little over a year ago. They had their wedding &amp;amp; reception at the Jellyfish, and it was beautiful!! They chose Majestic Elegance as their resort.","Attachments":[],"Id":1845564,"PostDate":1398186026,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thank you so much! The planning is going great. We haven't chosen a color scheme or anything yet. We have booked our photographer, videographer, sent out save the dates, and almost have our invites ready to print and assemble. That's all we've done so far. I feel like we've done a ton more, but on paper it doesn't look like we've done much. haha. Bego has been amazing this far and was very quick to answer the million questions I emailed her. We have chosen Now Larimar as our resort. One of my best friends was married in Punta Cana a little over a year ago. They had their wedding & reception at the Jellyfish, and it was beautiful!! They chose Majestic Elegance as their resort. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"olivia_colt.murski@outlook.com","IpAddress":"68.63.242.236","GroupId":40,"GroupName":"Jr. Member","JoinDate":1392688576,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276756.jpg?_r=1399903658","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"colivia","Id":276756,"Name":"colivia","IsOnline":false}}],"Pages":{"TotalItems":63,"TotalPages":7,"CurrentPage":10,"NextPage":20,"PreviousPage":0,"LastPage":60},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
