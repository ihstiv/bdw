{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":33667,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a650b622dff2bf12160c1aac9d97c9cb","RawContent":"Here&#039;s pictures I got from the wedding coordinator. It looks beautiful!\n \n &lt;img src=\"http:\/\/i83.photobucket.com\/albums\/j286\/caboweddingforum\/Bodas236.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n &lt;img src=\"http:\/\/i83.photobucket.com\/albums\/j286\/caboweddingforum\/Bodas110.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n &lt;img src=\"http:\/\/i83.photobucket.com\/albums\/j286\/caboweddingforum\/Bodas148.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n &lt;img src=\"http:\/\/i83.photobucket.com\/albums\/j286\/caboweddingforum\/Bodas012.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n &lt;img src=\"http:\/\/i83.photobucket.com\/albums\/j286\/caboweddingforum\/Bodas261.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n &lt;img src=\"http:\/\/i83.photobucket.com\/albums\/j286\/caboweddingforum\/Bodas247.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n &lt;img src=\"http:\/\/i83.photobucket.com\/albums\/j286\/caboweddingforum\/Bodas113.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;","Attachments":[],"Id":690251,"PostDate":1242260331,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Here's pictures I got from the wedding coordinator. It looks beautiful!<br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i83.photobucket.com\/albums\/j286\/caboweddingforum\/Bodas236.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i83.photobucket.com\/albums\/j286\/caboweddingforum\/Bodas110.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i83.photobucket.com\/albums\/j286\/caboweddingforum\/Bodas148.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i83.photobucket.com\/albums\/j286\/caboweddingforum\/Bodas012.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i83.photobucket.com\/albums\/j286\/caboweddingforum\/Bodas261.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i83.photobucket.com\/albums\/j286\/caboweddingforum\/Bodas247.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i83.photobucket.com\/albums\/j286\/caboweddingforum\/Bodas113.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/ticker.7910.org\/as1cHl10g410500NTQxNzJvfDQ1MjQzNWx8R2V0dGluZyBtYXJyaWVkISEh.gif\">http:\/\/ticker.7910.org\/as1cHl10g4105...JyaWVkISEh.gif<\/a><\/div><\/div>","Email":"sschuster@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1232157739,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-214015.gif?_r=0","PhotoWidth":100,"PhotoHeight":70,"PhotoType":"custom"},"FormattedName":"sarah310","Id":214015,"Name":"sarah310","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":33667,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cd46207d8ecd4a9f4443392a96e890b8","RawContent":"Yay! Thank you for posting these photos! I just confirmed my date at the DLR for April 22, 2010. We decided to do the Ulitmate Dreams Wedding package. Has anyone done this one? Was it worth it?\n \n &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile29.gif\" border=\"0\" alt=\"\" title=\"Smile29\" class=\"inlineimg\" \/&gt;","Attachments":[],"Id":696975,"PostDate":1242797802,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Yay! Thank you for posting these photos! I just confirmed my date at the DLR for April 22, 2010. We decided to do the Ulitmate Dreams Wedding package. Has anyone done this one? Was it worth it?<br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile29.gif\" border=\"0\" alt=\"\" title=\"Smile29\" class=\"inlineimg\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>24 Booked!<\/span><br><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.tickerfactory.com\/ezt\/d\/4;10748;6\/st\/20100422\/e\/Our+Wedding\/k\/21d4\/event.png\">http:\/\/tickers.tickerfactory.com\/ezt...21d4\/event.png<\/a><\/div><\/div>","Email":"staceyjahn@yahoo.ca","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1233273660,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-214437.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"La Romana Stacey","Id":214437,"Name":"La Romana Stacey","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":33667,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"860db6c3e195da86fb88766c86b105cd","RawContent":"Me too I&#039;m looking for this package. I&#039;m still hesitating between Dreams La Romana and Excellence Punta Cana. \n But these pictures looks just amazing!!","Attachments":[],"Id":701988,"PostDate":1243313571,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Me too I'm looking for this package. I'm still hesitating between Dreams La Romana and Excellence Punta Cana. <br \/> But these pictures looks just amazing!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"melsavard1@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1241628368,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-217329.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Boudou33","Id":217329,"Name":"Boudou33","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":33667,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1f0b9a2be48833f8dc76bc5dfaa42597","RawContent":"so, do you have to be there 4 business days before the wedding? i am from uk and they only do flights 2 times a week on wed and sun and i am want to go there for a week if possible...","Attachments":[],"Id":720424,"PostDate":1244760365,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                so, do you have to be there 4 business days before the wedding? i am from uk and they only do flights 2 times a week on wed and sun and i am want to go there for a week if possible...\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lukyc@cardiff.ac.uk","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1243983133,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-218047.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":109,"PhotoType":"custom"},"FormattedName":"Vonnie6","Id":218047,"Name":"Vonnie6","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":33667,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"57017c71901fe6d6d9b200ac7901966a","RawContent":"i am hoping to get married in dreams la romana as well. my fiancee works shifts and only get 2 weeks at christmas and 3 weeks in the summer (last week of july and first 2 weeks in august) off each year. i was wondering if anyone has a rough guess of the chance that there would be a hurricane or a storm...","Attachments":[],"Id":720446,"PostDate":1244760899,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                i am hoping to get married in dreams la romana as well. my fiancee works shifts and only get 2 weeks at christmas and 3 weeks in the summer (last week of july and first 2 weeks in august) off each year. i was wondering if anyone has a rough guess of the chance that there would be a hurricane or a storm...\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lukyc@cardiff.ac.uk","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1243983133,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-218047.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":109,"PhotoType":"custom"},"FormattedName":"Vonnie6","Id":218047,"Name":"Vonnie6","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":33667,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"76c7f82f598f6c064a9abf6eff5d4be2","RawContent":"Hi Vonnie6,\n \n Your question about how many days before the wedding you need to arrive depends on the resort planner: There is NO legal law in DR that specifies you need to be there in advance, LEGALLY you could get married the day you arrive. That said the planners will want you there in advance becuase they make all the arrangements once you arrive, hence they have 3 or 4 days to book flowers, cake etc etc.\n Hope this helps :)","Attachments":[],"Id":720474,"PostDate":1244761724,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi Vonnie6,<br \/> <br \/> Your question about how many days before the wedding you need to arrive depends on the resort planner: There is NO legal law in DR that specifies you need to be there in advance, LEGALLY you could get married the day you arrive. That said the planners will want you there in advance becuase they make all the arrangements once you arrive, hence they have 3 or 4 days to book flowers, cake etc etc.<br \/> Hope this helps <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Kelly<\/span><\/div><\/div>","Email":"kellysamantha1@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1244760272,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-218361.gif?_r=0","PhotoWidth":200,"PhotoHeight":147,"PhotoType":"custom"},"FormattedName":"KSH","Id":218361,"Name":"KSH","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":33667,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"43d52619b383ae5e8a43573d6092579c","RawContent":"Looks beautiful! But I&#039;m not a fan of red...wonder if they would let you remove\/change the pieces in red...?","Attachments":[],"Id":749620,"PostDate":1246927257,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Looks beautiful! But I'm not a fan of red...wonder if they would let you remove\/change the pieces in red...?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span><p class='bbc_center'><\/span><a data-ipb='nomediaparse' href=\"http:\/\/www.theknot.com\/ourwedding\/AmyWalter&RoySquire\">http:\/\/www.theknot.com\/ourwedding\/AmyWalter&RoySquire<\/a><span><\/p><\/span><br \/>\n<br \/>\n<a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10719;116\/st\/20100428\/e\/Our+Wedding+in+Paradise%21\/k\/ba76\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...ba76\/event.png<\/a><\/div><\/div>","Email":"amygirl1169@hotmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1244355104,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-218196.gif?_r=0","PhotoWidth":71,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"amygirl1169","Id":218196,"Name":"amygirl1169","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":33667,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"35ba2dff675ea4a8c0786f8daed421c0","RawContent":"I&#039;m deciding between Dreams La Romana and Dreams Tulum in Mexico. The reason why I like La Romana more is because the ceremony locations are exactly what I want. But the wedding coordinator hasn&#039;t gotten back to me (the DT coordinator has written me twice already) and i&#039;m nervous about some of the reviews on the resort itself... I think doing a site visit is amazing- I wish I could do the same.\n \n It seems like there are a million Dreams Tulum brides but no La Romana brides! I have all the details I want on DT - but would love to know more about La Romana! :) I guess it&#039;s because it&#039;s so new?","Attachments":[],"Id":751482,"PostDate":1247031319,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm deciding between Dreams La Romana and Dreams Tulum in Mexico. The reason why I like La Romana more is because the ceremony locations are exactly what I want. But the wedding coordinator hasn't gotten back to me (the DT coordinator has written me twice already) and i'm nervous about some of the reviews on the resort itself... I think doing a site visit is amazing- I wish I could do the same.<br \/> <br \/> It seems like there are a million Dreams Tulum brides but no La Romana brides! I have all the details I want on DT - but would love to know more about La Romana! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> I guess it's because it's so new?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sashahutton3@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1246380505,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-218948.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"shybear","Id":218948,"Name":"shybear","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":33667,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d8bac718dda9b67bd08ab9368679c0ba","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;shybear&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;I&#039;m deciding between Dreams La Romana and Dreams Tulum in Mexico. The reason why I like La Romana more is because the ceremony locations are exactly what I want. But the wedding coordinator hasn&#039;t gotten back to me (the DT coordinator has written me twice already) and i&#039;m nervous about some of the reviews on the resort itself... I think doing a site visit is amazing- I wish I could do the same.\n \n It seems like there are a million Dreams Tulum brides but no La Romana brides! I have all the details I want on DT - but would love to know more about La Romana! :) I guess it&#039;s because it&#039;s so new?&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;I&#039;m booked for next May at DLR, PM me with your email if you want me to send info that the WC send me. She was quick to respond to me but that was back in March\/April and i think she has gotten a lot busier and need to hire her an assistant.","Attachments":[],"Id":751916,"PostDate":1247076707,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>shybear<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">I'm deciding between Dreams La Romana and Dreams Tulum in Mexico. The reason why I like La Romana more is because the ceremony locations are exactly what I want. But the wedding coordinator hasn't gotten back to me (the DT coordinator has written me twice already) and i'm nervous about some of the reviews on the resort itself... I think doing a site visit is amazing- I wish I could do the same.<br \/> <br \/> It seems like there are a million Dreams Tulum brides but no La Romana brides! I have all the details I want on DT - but would love to know more about La Romana! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> I guess it's because it's so new?<\/div> <\/td> <\/tr> <\/table> <\/div>I'm booked for next May at DLR, PM me with your email if you want me to send info that the WC send me. She was quick to respond to me but that was back in March\/April and i think she has gotten a lot busier and need to hire her an assistant.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"hahawryluk@hotmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1221069769,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211661.JPG?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"dolfinluck","Id":211661,"Name":"dolfinluck","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":33667,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"edb9b4d844011a17abda73b90e9ef4fa","RawContent":"i am still trying to work out the amount i need to get the wedding i want. i am not marrying till jul 2011 or july 2012 and she was very helpful and went into great lengths to find out the cost for the specific flowers i wanted and other little details like that. so, she may just be a bit busy but if you have any questions, i will try to answer some of it.","Attachments":[],"Id":752765,"PostDate":1247144611,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                i am still trying to work out the amount i need to get the wedding i want. i am not marrying till jul 2011 or july 2012 and she was very helpful and went into great lengths to find out the cost for the specific flowers i wanted and other little details like that. so, she may just be a bit busy but if you have any questions, i will try to answer some of it.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lukyc@cardiff.ac.uk","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1243983133,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-218047.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":109,"PhotoType":"custom"},"FormattedName":"Vonnie6","Id":218047,"Name":"Vonnie6","IsOnline":false}}],"Pages":{"TotalItems":3925,"TotalPages":393,"CurrentPage":10,"NextPage":20,"PreviousPage":0,"LastPage":3920},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
