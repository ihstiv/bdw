56.jpeg?_r=0","PhotoWidth":180,"PhotoHeight":239,"PhotoType":"custom"},"IsOnline":false},"StartDate":1362602995,"LastPoster":{"Id":282561,"Name":"Sammi2016","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282561.jpg?_r=1431728812","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":22,"Preview":{"Id":1730081,"PostDate":1362602995,"PostContent":"Hello,  \u00a0  Lots of threads on this restaurant but I'm hoping to gather some info on pricing with...","Author":{"Signature":"","Email":"asha_sips@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1362162436,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-266756.jpeg?_r=0","PhotoWidth":180,"PhotoHeight":239,"PhotoType":"custom"},"FormattedName":"Asha","Id":266756,"Name":"Asha","IsOnline":false}},"Posts":[],"Id":"73031","Title":"TOTAL COST OF WEDDING AT JELLYFISH PUNTA CANA","LastPostDate":1427988157},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":4,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":281,"MovedTo":null,"MovedOn":0,"FirstPostId":1891360,"Rating":0,"RatingHits":0,"Starter":{"Id":282446,"Name":"ssoliman422","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1427762164,"LastPoster":{"Id":278395,"Name":"JenniferH114","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278395.jpg?_r=1421871115","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":22,"Preview":{"Id":1891360,"PostDate":1427762164,"PostContent":"Hello Ladies, \u00a0 My fiance and I are trying to decide which hotel to choose for our wedding. We've...","Author":{"Signature":"","Email":"ssoliman422@gmail.com","IpAddress":"72.69.195.21","GroupId":39,"GroupName":"Newbie","JoinDate":1426638062,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"ssoliman422","Id":282446,"Name":"ssoliman422","IsOnline":false}},"Posts":[],"Id":"79005","Title":"Majestic Colonial Or Barcelo Bavaro?","LastPostDate":1427772570},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":6,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":383,"MovedTo":null,"MovedOn":0,"FirstPostId":1890113,"Rating":0,"RatingHits":0,"Starter":{"Id":206696,"Name":"TammyWright","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"IsOnline":false},"StartDate":1426804899,"LastPoster":{"Id":281649,"Name":"Everly","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281649.jpg?_r=1421027393","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":22,"Preview":{"Id":1890113,"PostDate":1426804899,"PostContent":"Does anyone know when they hold the party? \u00a0 Share your experiences....","Author":{"Signature":"<p><span style=\"font-family:arial, helvetica, sans-serif;\">Founder and Owner of BestDestinationWedding.com \u00a0\/ \u00a0<\/span><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-gro