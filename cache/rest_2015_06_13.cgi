{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":182,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":23118,"MovedTo":null,"MovedOn":0,"FirstPostId":1432129,"Rating":0,"RatingHits":0,"Starter":{"Id":237049,"Name":"cole379","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-237049.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"IsOnline":false},"StartDate":1302390337,"LastPoster":{"Id":281283,"Name":"vancouverpetunia","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281283.jpg?_r=1428779369","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1432129,"PostDate":1302390337,"PostContent":"Hello fellow brides!  \u00a0  I wanted to make a wedding website so that it is easy for family and fr...","Author":{"Signature":"","Email":"ndeault@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1298329351,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-237049.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"cole379","Id":237049,"Name":"cole379","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60641,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"d4c651f7136b62bffb8dc90f791abdd3","RawContent":"&lt;p&gt; Hello fellow brides!&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I wanted to make a wedding website so that it is easy for family and friends to get all of the information that they need. I was thinking of wedding wire or the knot. Are either of these good ones for creating a wedding website. I want to personalize it but also be easy to set up.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Thanks!&lt;\/p&gt;","Attachments":[],"Id":1432129,"PostDate":1302390337,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hello fellow brides!<\/p> <p> \u00a0<\/p> <p> I wanted to make a wedding website so that it is easy for family and friends to get all of the information that they need. I was thinking of wedding wire or the knot. Are either of these good ones for creating a wedding website. I want to personalize it but also be easy to set up.<\/p> <p> \u00a0<\/p> <p> Thanks!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ndeault@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1298329351,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-237049.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"cole379","Id":237049,"Name":"cole379","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60641,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"dc1cd2a9d967118874b8248c2d8f82ab","RawContent":"&lt;p&gt; I did my wedding website through wedding wire.&amp;nbsp; It was easy to make and it looked really professional.&amp;nbsp; Everyone that has gone on the website always comment that they like it.&lt;\/p&gt;","Attachments":[],"Id":1432145,"PostDate":1302393691,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I did my wedding website through wedding wire.\u00a0 It was easy to make and it looked really professional.\u00a0 Everyone that has gone on the website always comment that they like it.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"farlem311@yahoo.com","IpAddress":"108.250.176.192","GroupId":40,"GroupName":"Jr. Member","JoinDate":1292775139,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-234687.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"farlem311","Id":234687,"Name":"farlem311","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60641,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"a776fcb61fd18fdd779de03acba1d6ad","RawContent":"&lt;p&gt; We are using mywedding.com.&amp;nbsp; It can be personalized and we are finding it super easy to use.&amp;nbsp; There are also tons of different designs to choose from and its free!&lt;\/p&gt;","Attachments":[],"Id":1432161,"PostDate":1302396463,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> We are using mywedding.com.\u00a0 It can be personalized and we are finding it super easy to use.\u00a0 There are also tons of different designs to choose from and its free!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jkergen@hotmail.com","IpAddress":"137.186.71.240","GroupId":42,"GroupName":"Sr. Member","JoinDate":1293159900,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-234788.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"JayKay","Id":234788,"Name":"JayKay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60641,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"5b1de70ec6baeb8fe215a1cd95ceb78a","RawContent":"&lt;p&gt; We are using the wedding website at projectwedding.com. The reason we chose to go with projectwedding.com is because they have a wedding map which I haven&#039;t seen with any other website and thought that might be fun for our guests to see. The only complaint I have is that they don&#039;t offer a wide selection of themes.&lt;\/p&gt;","Attachments":[],"Id":1432179,"PostDate":1302399012,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> We are using the wedding website at projectwedding.com. The reason we chose to go with projectwedding.com is because they have a wedding map which I haven't seen with any other website and thought that might be fun for our guests to see. The only complaint I have is that they don't offer a wide selection of themes.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"melissabittle@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1271051655,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Mel2010","Id":227251,"Name":"Mel2010","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60641,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cdf42a07af49444201a5aa025edd8f1d","RawContent":"&lt;p&gt; i&#039;m using mywedding.com. I chose based on design.. that one had the design I liked the most. :)&lt;\/p&gt;","Attachments":[],"Id":1432186,"PostDate":1302399385,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> i'm using mywedding.com. I chose based on design.. that one had the design I liked the most. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sailor_x_8@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1289423307,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-233856.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"X-Chan","Id":233856,"Name":"X-Chan","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60641,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1c4393bb9eb89ee949e9c10fc7c52c95","RawContent":"&lt;p&gt; I use mywedding.com as well and I like that it can be personalized or you can use their standard pages.&lt;\/p&gt;","Attachments":[],"Id":1432191,"PostDate":1302399586,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I use mywedding.com as well and I like that it can be personalized or you can use their standard pages.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"klikawedding@gmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1294541892,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-235285.jpg?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"merrylee","Id":235285,"Name":"merrylee","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60641,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6bd7f518bad75d93246733ce9f5f3af4","RawContent":"&lt;p&gt; i&#039;m using mywedding.com and I really like it. It&#039;s simple to use, simple to update. Can even keep track of RSVP&#039;s, has a nice guestbook feature, and you can add music if you like.&lt;\/p&gt;","Attachments":[],"Id":1432215,"PostDate":1302407347,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> i'm using mywedding.com and I really like it. It's simple to use, simple to update. Can even keep track of RSVP's, has a nice guestbook feature, and you can add music if you like.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"aaronlori@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1301141382,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-238189.jpg?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"aaronlori","Id":238189,"Name":"aaronlori","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60641,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"82703c7aafe40f16eaee759ec857a375","RawContent":"&lt;p&gt; Hi!&amp;nbsp; I originally used the Knot as my website, but a few months in, all of our pictures disappeared and we couldn&#039;t upload them again.&amp;nbsp; I was so frustrated.&amp;nbsp; Then I recreated our website on wedding wire and I love it -- SO much better!&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1432218,"PostDate":1302407808,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hi!\u00a0 I originally used the Knot as my website, but a few months in, all of our pictures disappeared and we couldn't upload them again.\u00a0 I was so frustrated.\u00a0 Then I recreated our website on wedding wire and I love it -- SO much better!\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>June 18, 2011 * Cabo Azul Resort<\/span><\/div><\/div>","Email":"lisnewman@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1283125933,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-231873.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"LisaandJeff","Id":231873,"Name":"LisaandJeff","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60641,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"91327486cfabbf69c42f6dbb507ab571","RawContent":"&lt;p&gt; I&#039;m using eweddings.com - they have lots of different designs and very simple to use.&lt;\/p&gt;","Attachments":[],"Id":1432428,"PostDate":1302479900,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I'm using eweddings.com - they have lots of different designs and very simple to use.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jbutcher@hotmail.ca","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1299350996,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-237449.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"JessicaP2012","Id":237449,"Name":"JessicaP2012","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60641,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"713564da3ae8e26b3351755f56376468","RawContent":"&lt;p&gt; FI and I used TheKnot, and then I made a tinyurl so guests can get to it easily.&lt;\/p&gt;","Attachments":[],"Id":1432474,"PostDate":1302486252,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> FI and I used TheKnot, and then I made a tinyurl so guests can get to it easily.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nairay@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1268899366,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-226545.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"nairay","Id":226545,"Name":"nairay","IsOnline":false}}],"Id":"60641","Title":"Wedding website?","LastPostDate":1433855112},"Pages":{"TotalItems":182,"TotalPages":19,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":180},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
