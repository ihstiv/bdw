{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":24565,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"19462cc77e25d7cbbb5fb96f1ebb0daf","RawContent":"Yes! We met on match.com. He was actually one of those &amp;quot;matches&amp;quot; they send you every week. He caught my eye and I winked at him two days before my subscription ran out. I renewed my subscription so we could email. And now we&#039;re getting married next year!","Attachments":[],"Id":511950,"PostDate":1226981357,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Yes! We met on match.com. He was actually one of those \"matches\" they send you every week. He caught my eye and I winked at him two days before my subscription ran out. I renewed my subscription so we could email. And now we're getting married next year!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>We're married! Jamie<\/span><\/div><\/div>","Email":"smith3576@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1226120379,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-212590.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"smith3576","Id":212590,"Name":"smith3576","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":24565,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"28fcd4b17f5d38276439a711401c792e","RawContent":"We met through our friend&#039;s MySpace!! We no longer talk to our friend, but am so thankful I met him through her MySpace!!","Attachments":[],"Id":512131,"PostDate":1227013226,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We met through our friend's MySpace!! We no longer talk to our friend, but am so thankful I met him through her MySpace!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"oo0ehxtahcee0oo@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1222144751,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211893.gif?_r=0","PhotoWidth":100,"PhotoHeight":69,"PhotoType":"custom"},"FormattedName":"trophywife","Id":211893,"Name":"trophywife","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":24565,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"48fb872146580b4ac4040812adae6871","RawContent":"FI found me on mIRC lol We were in a music room, and he saw &amp;quot;NewfieGal&amp;quot; pop up because I had just logged in and though &amp;quot;Newfie? There are no Newfoundlanders in here!&amp;quot; So he did a WhoIs? and found out that I was in St. John&#039;s and decided to message me. I was dating someone at the time, so I was going to set him up with one of my friends lol But then about a week later the guy I was dating started acting like a complete a$$ and kept it up for two weeks so I dumped him and snatched up FI before my friend had the chance lol","Attachments":[],"Id":513069,"PostDate":1227058953,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                FI found me on mIRC lol We were in a music room, and he saw \"NewfieGal\" pop up because I had just logged in and though \"Newfie? There are no Newfoundlanders in here!\" So he did a WhoIs? and found out that I was in St. John's and decided to message me. I was dating someone at the time, so I was going to set him up with one of my friends lol But then about a week later the guy I was dating started acting like a complete a$$ and kept it up for two weeks so I dumped him and snatched up FI before my friend had the chance lol\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sharmaineking@hotmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1216000294,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-210518.jpg?_r=0","PhotoWidth":200,"PhotoHeight":181,"PhotoType":"custom"},"FormattedName":"FutureMrsLewis","Id":210518,"Name":"FutureMrsLewis","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":24565,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"857e8487a299e7b751b0e4f0419f10d4","RawContent":"POF seems to be the popular one here ladies. I was on that site but never had any luck with it!\n I met my man via online but he would never admit that to anyone..*lol*. To this day he told everyone we met at a bar. It was some fluky site called findsomeone.ca where we intially found each other. He used one of those cheesy lines which actually worked (i must have been drunk..*lol*). Here is how it went &amp;quot;I think u have a gorgeous smile and i would love to conversate with u and get to know u&amp;quot; \n We talked for a few months on and off on msn and kept throwing around the idea to meet but I never thought it would happen.\n One night I said I was going to the casino for something to do so he decided he would meet there (I am an avid gambler at times). It was history from there. That was four years ago :) Strange how things happen.","Attachments":[],"Id":513086,"PostDate":1227059627,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                POF seems to be the popular one here ladies. I was on that site but never had any luck with it!<br \/> I met my man via online but he would never admit that to anyone..*lol*. To this day he told everyone we met at a bar. It was some fluky site called findsomeone.ca where we intially found each other. He used one of those cheesy lines which actually worked (i must have been drunk..*lol*). Here is how it went \"I think u have a gorgeous smile and i would love to conversate with u and get to know u\" <br \/> We talked for a few months on and off on msn and kept throwing around the idea to meet but I never thought it would happen.<br \/> One night I said I was going to the casino for something to do so he decided he would meet there (I am an avid gambler at times). It was history from there. That was four years ago <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> Strange how things happen.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"chicklet22@hotmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1206665275,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208937.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"chicklet","Id":208937,"Name":"chicklet","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":24565,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b70847aecfc1ed4e45aa2dbbdf423edf","RawContent":"We met on Match.com!!!!!!","Attachments":[],"Id":513351,"PostDate":1227071990,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We met on Match.com!!!!!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>~Katie & CJ~<\/span><br><span>Pictures & Video: <\/span><a data-ipb='nomediaparse' href=\"http:\/\/www.mywedding.com\/katieandcj\">www.mywedding.com\/katieandcj<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/i734.photobucket.com\/albums\/ww350\/igo4ku0801\/8x10IMG_5496.jpg\">http:\/\/i734.photobucket.com\/albums\/w...10IMG_5496.jpg<\/a><\/div><\/div>","Email":"sunshinekc08@aol.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1212432840,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209713.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"sunshinekc08","Id":209713,"Name":"sunshinekc08","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":24565,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bffc923533089ff85d5682be72da40b8","RawContent":"hehe this is great ... my FI &amp;amp; I met on Lavalife!!\n I was so tired of all the crappy dates I had been on that past year I was just about delete my profile and he sent me smile :) I emailed him, we chatted for awhile and when we finally went on our first date I knew he was the one..and I am so thankful I didn&#039;t delete my profile that day!!","Attachments":[],"Id":513397,"PostDate":1227073930,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                hehe this is great ... my FI & I met on Lavalife!!<br \/> I was so tired of all the crappy dates I had been on that past year I was just about delete my profile and he sent me smile <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> I emailed him, we chatted for awhile and when we finally went on our first date I knew he was the one..and I am so thankful I didn't delete my profile that day!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"savvyfashions@shaw.ca","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1210455123,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209333.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"BC Bride2be","Id":209333,"Name":"BC Bride2be","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":24565,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d075b414b956fe2b63e74f4af2543d82","RawContent":"Nope I didn&#039;t. I met my FI at our current school in Canada.","Attachments":[],"Id":521217,"PostDate":1227834806,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Nope I didn't. I met my FI at our current school in Canada.