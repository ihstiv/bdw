 Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats and Welcome to the best source of info!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"angela.jackson@urs.com","IpAddress":"208.38.3.13","GroupId":47,"GroupName":"Site Supporter","JoinDate":1399541909,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277894.jpg?_r=1399556581","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"angelajackson","Id":277894,"Name":"angelajackson","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"142.179.243.111","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72192,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4353070fdba560be1e51204f162d4ec4","RawContent":"Congrats to all the 2015 brides :) I feel like I&#039;m behind the game since some of you have been planning since 2013!  Hopefully I will be able to pull it all together for my July 2015 wedding. :)","Attachments":[],"Id":1852691,"PostDate":1401406030,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Congrats to all the 2015 brides <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> I feel like I'm behind the game since some of you have been planning since 2013!  Hopefully I will be able to pull it all together for my July 2015 wedding. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kcrosby86@msn.com","IpAddress":"142.179.243.111","GroupId":40,"GroupName":"Jr. Member","JoinDate":1398815231,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Kayla88","Id":277780,"Name":"Kayla88","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.38.55.174","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72192,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"af410a265ea71b388427086c1fd6e071","RawContent":"&lt;p&gt;I am getting married in Feb of 2015 hows your planning going?&lt;\/p&gt;","Attachments":[],"Id":1852748,"PostDate":1401446153,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I am getting married in Feb of 2015 hows your planning going?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sammy_frog63@hotmail.com","IpAddress":"72.38.55.174","GroupId":39,"GroupName":"Newbie","JoinDate":1381325481,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-274116.jpg?_r=1401456666","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"SamanthaC","Id":274116,"Name":"SamanthaC","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.101.152.253","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72192,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2c0d1bf930d3d6f16073402c25b73273","RawContent":"Hi \n\n\nWe are getting  married January 21,2015 at gran bahia principe coba. I also sent out save the dates to give everyone lots of time to decide but now I know who is coming and who isn&#039;t because they have spoken with me, so now I have to send out invitations to people that already said they were not coming or that I already know are coming , seems silly. In hind sight if would have just sent out an invitation and skipped the entire save the date. \n\n\nCongrats to you all !!!","Attachments":[],"Id":1852843,"PostDate":1401463384,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi <br><br>\nWe are getting  married January 21,2015 at gran bahia principe coba. I also sent out save the dates to give everyone lots of time to decide but now I know who is coming and who isn't because they have spoken with me, so now I have to send out invitations to people that already said they were not coming or that I already know are coming , seems silly. In hind sight if would have just sent out an invitation and skipped the entire save the date. <br><br>\nCongrats to you all !!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>55 guests booked plus bride and groom <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>","Email":"drkt0010@hotmail.com","IpAddress":"50.101.144.156","GroupId":40,"GroupName":"Jr. Member","JoinDate":1396294378,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277431.jpg?_r=1423500629","PhotoWidth":200,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"Dreamteam17","Id":277431,"Name":"Dreamteam17","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.224.203.82","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72192,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1b3e9615307b8bbf148a184960abc83c","RawContent":"May 16th 2015, still haven&#039;t picked a location!! Aaaarrrrrrgggghhhhh\n[quote name=\"Kayla88\" post=\"1852691\" timestamp=\"1401420430\"]\nCongrats to all the 2015 brides :) I feel like I&#039;m behind the game since some of you have been planning since 2013!  Hopefully I will be able to pull it all together for my July 2015 wedding. :)[\/quote]I&#039;m right behind you! \nI feel like a year is more than enough time to plan... Well here is to hoping lol","Attachments":[],"Id":1852845,"PostDate":1401464324,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                May 16th 2015, still haven't picked a location!! Aaaarrrrrrgggghhhhh<br \/><p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Kayla88, on 29 May 2014 - 11:27 PM, said:<\/p><div class='blockquote'><div class='quote'><p>Congrats to all the 2015 brides <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> I feel like I'm behind the game since some of you have been planning since 2013!  Hopefully I will be able to pull it all together for my July 2015 wedding. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p><\/div><\/div>\n<br>\nI'm right behind you! <br>\nI feel like a year is more than enough time to plan... Well here is to hoping lol\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"Using Tapatalk","Email":"kiannabanana69@gmail.com","IpAddress":"200.106.87.106","GroupId":3,"GroupName":"Member","JoinDate":1397888214,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277650.png?_r=1402827462","PhotoWidth":60,"PhotoHeight":80,"PhotoType":"custom"},"FormattedName":"MrsRoy","Id":277650,"Name":"MrsRoy","IsOnline":false}}],"Pages":{"TotalItems":272,"TotalPages":28,"CurrentPage":220,"NextPage":230,"PreviousPage":210,"LastPage":270},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
