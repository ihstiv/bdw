...thanks for the info.....I did talk with my travel agent who was with me on my site...","Author":{"Signature":"","Email":"letitia_leaks@verizon.net","IpAddress":"63.119.183.254","GroupId":40,"GroupName":"Jr. Member","JoinDate":1397052122,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277534.jpg?_r=1397086760","PhotoWidth":160,"PhotoHeight":160,"PhotoType":"custom"},"FormattedName":"FutureMrsGlover","Id":277534,"Name":"FutureMrsGlover","IsOnline":false}},"Posts":[],"Id":"77397","Title":"Worried Royalton White Sands Will Not Have Enough Rooms","LastPostDate":1403797315},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":10,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":617,"MovedTo":null,"MovedOn":0,"FirstPostId":1851700,"Rating":0,"RatingHits":0,"Starter":{"Id":273327,"Name":"kay2015","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-273327.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"IsOnline":false},"StartDate":1400747629,"LastPoster":{"Id":273327,"Name":"kay2015","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-273327.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":28,"Preview":{"Id":1853772,"PostDate":1401871017,"PostContent":"Im trying ladies I am to stay off trip adviser ol....one the plus said we are already booked so w...","Author":{"Signature":"","Email":"kay.vaillancourt@gmail.com","IpAddress":"173.252.61.182","GroupId":40,"GroupName":"Jr. Member","JoinDate":1378730769,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-273327.jpg?_r=0","PhotoWidth":180,"PhotoHeight":1