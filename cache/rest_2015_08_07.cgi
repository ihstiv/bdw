Author":{"Signature":"","Email":"jenna32schap@yahoo.com","IpAddress":"75.97.32.162","GroupId":39,"GroupName":"Newbie","JoinDate":1394365500,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277065.jpg?_r=1438546602","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"jenna32schap","Id":277065,"Name":"jenna32schap","IsOnline":false}},"Posts":[],"Id":"79455","Title":"Married At The Riu Santa Fe July 20, 2015","LastPostDate":1438524866},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":48,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":1982,"MovedTo":null,"MovedOn":0,"FirstPostId":1899717,"Rating":0,"RatingHits":0,"Starter":{"Id":277519,"Name":"veryvalentine","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277519.jpg?_r=1435850174","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"StartDate":1435846504,"LastPoster":{"Id":283685,"Name":"streelbride","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283685.jpg?_r=1437401496","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":2,"Preview":{"Id":1899717,"PostDate":1435846504,"PostContent":"We got married at the Grand Sunset Princess on June 20th, 2015. The majority of our guests stayed...","Author":{"Signature":"<div><br><div>\u00a0<\/div>\n<div>\u00a0<\/div>\n<div>Married on June 20th, 2015 at the Grand Sunset Princess Riviera Gazebo & Reception at the Chill Out with 60 guests<\/div>\n<div>\u00a0<\/div>\n<\/div>\n<div>\u00a0<\/div>\n<p>My planning thread:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planni