{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.48.213.67","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72192,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8d769bed6e491d6a5f11551e87e87a6f","RawContent":"Happy planning everyone :)","Attachments":[],"Id":1874529,"PostDate":1412628436,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Happy planning everyone <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>55 guests booked plus bride and groom <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>","Email":"drkt0010@hotmail.com","IpAddress":"50.101.144.156","GroupId":40,"GroupName":"Jr. Member","JoinDate":1396294378,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277431.jpg?_r=1423500629","PhotoWidth":200,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"Dreamteam17","Id":277431,"Name":"Dreamteam17","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"38.126.108.7","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72192,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":3,"IsLiked":false,"PostKey":"53a89a5cb732ae184b8dbaa9ff2cc5cb","RawContent":"&lt;p&gt;Good afternoon ladies!!&lt;\/p&gt;\n&lt;p&gt;I haven&#039;t posted in awhile and want to say congratulations to anybody that has already gotten married and hope everything is going as planned for those that will be soon.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;My day of July 18th is approaching fast and I can&#039;t wait for it to be here. I need a vacation and my life back badly!! lol If anyone needs any advise, have questions or any words of wisdom for me please let me know. I know the next few months I will be freaking out.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Happy planning!!&lt;\/p&gt;","Attachments":[],"Id":1888790,"PostDate":1425913701,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Good afternoon ladies!!<\/p>\n<p>I haven't posted in awhile and want to say congratulations to anybody that has already gotten married and hope everything is going as planned for those that will be soon.<\/p>\n<p>\u00a0<\/p>\n<p>My day of July 18th is approaching fast and I can't wait for it to be here. I need a vacation and my life back badly!! lol If anyone needs any advise, have questions or any words of wisdom for me please let me know. I know the next few months I will be freaking out.<\/p>\n<p>\u00a0<\/p>\n<p>Happy planning!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"chalonda26@yahoo.com","IpAddress":"38.126.108.7","GroupId":39,"GroupName":"Newbie","JoinDate":1359479090,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265340.jpg?_r=1438712626","PhotoWidth":169,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"crcombs","Id":265340,"Name":"crcombs","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.115.225.3","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72192,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ac8cf8a93f6b233626204ebd08ca129f","RawContent":"&lt;p&gt;Hello everyone, I too am so excited to be a part of this site. I am a 2016 bride tobe. So I am looking forward to getting plenty ideas from everyone. I have put my deposit down for The Royal in Playa del Carmen. But as far as booking the room, we can can not do that until possible July since it is so far out.&lt;\/p&gt;","Attachments":[],"Id":1888813,"PostDate":1425933436,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello everyone, I too am so excited to be a part of this site. I am a 2016 bride tobe. So I am looking forward to getting plenty ideas from everyone. I have put my deposit down for The Royal in Playa del Carmen. But as far as booking the room, we can can not do that until possible July since it is so far out.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"dwesle6@yahoo.com","IpAddress":"70.115.225.3","GroupId":39,"GroupName":"Newbie","JoinDate":1425933000,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"none"},"FormattedName":"dwesle","Id":282372,"Name":"dwesle","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72192,"EditedBy":"","EditDate":1426240122,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7a554a45e1c7bddacada6ee2ae892123","RawContent":"&lt;p&gt;@[member=\"dwesle\"] Congrats on finding your resort this early.. that&#039;s great - definitely can be one of the most challenging aspects of planning a DW.&lt;\/p&gt;\n&lt;p&gt;Good luck with your planning and welcome to an awesome forum. This place will help you so much during your planning and the girls here are really great and supportive. It&#039;s also pretty addictive haha&lt;\/p&gt;","Attachments":[],"Id":1889164,"PostDate":1426240103,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"282372\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282372-dwesle\/' title='Member profile'><span itemprop=\"name\">dwesle<\/span><\/a> Congrats on finding your resort this early.. that's great - definitely can be one of the most challenging aspects of planning a DW.<\/p>\n<p>Good luck with your planning and welcome to an awesome forum. This place will help you so much during your planning and the girls here are really great and supportive. It's also pretty addictive haha<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419423414,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1436293677","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.236.130.168","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72192,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"49c52b6030e835b93729ac3bc606e0bb","RawContent":"Hello ladies!! [emoji4] I will be getting married May 6th,2015 at the Riu Montego Bay in Jamaica! My FI and I got engaged Sept 19th, 2013 on a lovely getaway to Toronto for the weekend! We have been planning our destination wedding ever since [emoji5]\ufe0f[emoji267] \n\n\nWe pretty much have everything decided! Check out my planning thread if you&#039;d like [emoji1]\n\n\n\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1890966,"PostDate":1427413082,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hello ladies!! [emoji4] I will be getting married May 6th,2015 at the Riu Montego Bay in Jamaica! My FI and I got engaged Sept 19th, 2013 on a lovely getaway to Toronto for the weekend! We have been planning our destination wedding ever since [emoji5]\ufe0f[emoji267] <br><br>\nWe pretty much have everything decided! Check out my planning thread if you'd like [emoji1]<br><br>\n<a class='resized_img' rel='lightbox[1890966]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_03_2015\/post-282430-142742744484.jpg\" title=\"ImageUploadedByTapatalk1427427444.261189.jpg -  207.79KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_03_2015\/post-282430-142742744484.jpg\" class='bbc_img linked-image' alt=\"ImageUploadedByTapatalk1427427444.261189.jpg\" \/><\/a>\n\n<a class='resized_img' rel='lightbox[1890966]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_03_2015\/post-282430-142742747429.jpg\" title=\"ImageUploadedByTapatalk1427427473.257198.jpg -  119.14KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_03_2015\/post-282430-142742747429.jpg\" class='bbc_img linked-image' alt=\"ImageUploadedByTapatalk1427427473.257198.jpg\" \/><\/a>\n\n<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"izabella.david@gmail.com","IpAddress":"99.237.26.51","GroupId":40,"GroupName":"Jr. Member","JoinDate":1426447978,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282430.jpg?_r=1434377756","PhotoWidth":200,"PhotoHeight":287,"PhotoType":"custom"},"FormattedName":"IzzyDeee","Id":282430,"Name":"IzzyDeee","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"98.194.252.252","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72192,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a4f20e1fda5de9c7d5247a44a8570e23","RawContent":"&lt;p&gt;I am in the stages of getting a date at the gran Caribe real hotel in December 2015? They only have a 10am chapel available and am not to happy that my guest would like a early wedding. But, I want a catholic wedding and am now considering a symbolic wedding. What do you suggest? :unsure:&lt;\/p&gt;\n&lt;p&gt;Hi, hope you can help me out, I&#039;m a newbie. Getting married in December 2015 also at the grand Caribe Real in Cancun. Are you using a TA for your guest ?&lt;\/p&gt;","Attachments":[],"Id":1892376,"PostDate":1428506645,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I am in the stages of getting a date at the gran Caribe real hotel in December 2015? They only have a 10am chapel available and am not to happy that my guest would like a early wedding. But, I want a catholic wedding and am now considering a symbolic wedding. What do you suggest? <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/unsure.png' class='bbc_emoticon' alt=':unsure:' \/><\/p><br \/><p>Hi, hope you can help me out, I'm a newbie. Getting married in December 2015 also at the grand Caribe Real in Cancun. Are you using a TA for your guest ?<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"elia.moreno@aol.com","IpAddress":"98.194.252.252","GroupId":39,"GroupName":"Newbie","JoinDate":1428505140,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"emore3173","Id":282676,"Name":"emore3173","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"216.23.195.134","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72192,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"58aa9fc09b6ced836fe57b1762a9466d","RawContent":"[quote name=\"emore3173\" post=\"1892376\" timestamp=\"1428521045\"]\nI am in the stages of getting a date at the gran Caribe real hotel in December 2015? They only have a 10am chapel available and am not to happy that my guest would like a early wedding. But, I want a catholic wedding and am now considering a symbolic wedding. What do you suggest? :unsure:\n\nHi, hope you can help me out, I&#039;m a newbie. Getting married in December 2015 also at the grand Caribe Real in Cancun. Are you using a TA for your guest ?[\/quote]I am getting married at the Gran Caribe Real. We are currently going through a TA. Are you doing a Saturday wedding?.","Attachments":[],"Id":1892935,"PostDate":1428933935,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>emore3173, on 08 April 2015 - 03:24 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>I am in the stages of getting a date at the gran Caribe real hotel in December 2015? They only have a 10am chapel available and am not to happy that my guest would like a early wedding. But, I want a catholic wedding and am now considering a symbolic wedding. What do you suggest? <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/unsure.png' class='bbc_emoticon' alt=':unsure:' \/><\/p>\n<br><p>Hi, hope you can help me out, I'm a newbie. Getting married in December 2015 also at the grand Caribe Real in Cancun. Are you using a TA for your guest ?<\/p>\n<\/div>\n<\/div><\/div>\n<p>I am getting married at the Gran Caribe Real. We are currently going through a TA. Are you doing a Saturday wedding?.\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><strong>N&C<\/strong><\/p>\n<p><em>April 17, 2015<\/em><\/p>\n<p>Gran Caribe Real (Cancun, Mexico)<\/p>\n<p>Including Bride & Groom: 22 guests (19 adults & 3 children)","Email":"nancysoup@att.net","IpAddress":"216.23.195.134","GroupId":39,"GroupName":"Newbie","JoinDate":1411646662,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280004.jpg?_r=1412891058","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"hellosassypants","Id":280004,"Name":"hellosassypants","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"201.127.146.220","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72192,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"1a4fb143d45c842256325f0bf93def47","RawContent":"[color=rgb(40,40,40)][font=arial]Hello brides!!! im getting married in 4 days in Azul Fives Hotel in the Mayan Riviera. I just want to invite you to read my new blog entry:[\/font][\/color]\n[color=rgb(40,40,40)][font=arial]\n[color=rgb(0,0,0)][font=Helvetica][size=3][url=\"http:\/\/www.bestdestinationwedding.com\/blog\/113-step-by-step-azul-fives-hotel-2015\/\"]http:\/\/www.bestdesti...ves-hotel-2015\/[\/url][\/size][\/font][\/color][\/font][\/color]\n[color=rgb(40,40,40)][font=arial]\nSo you can follow it and I now how did I do with all the vendors, the hotel, etc![\/font][\/color]\n[color=rgb(40,40,40)][font=arial]\nI&#039;d like to share and recommend my wedding vendors!![\/font][\/color]\n[color=rgb(40,40,40)][font=arial]\nFor photography : www.shenkophoto.com[\/font][\/color][color=rgb(40,40,40)][font=arial]\n[img]http:\/\/www.shenkophoto.com\/wp-content\/themes\/twentytwelve\/images\/home-bg.jpg[\/img][\/font][\/color]\n[color=rgb(40,40,40)][font=arial]\nFor the music: [\/font][\/color]\n[quote]\n[quote]\n[quote]\n[quote]\n[quote]\n[quote]\nRicardo Trujillo Duran\n[i]Entertainment Manager[\/i]\n[b]9981604069[\/b] \u00b7 [email=\"dj.rickalvin@hotmail.com\"]dj.rickalvin@hotmail.com[\/email]\nFuzion Musical\nCancun Q.Roo, Mexico \u00b7 C.P. 77539\n[email=\"fuzion.musical@icloud.com\"]fuzion.musical@icloud.com[\/email] \u00b7 [url=\"http:\/\/www.facebook.com\/fuzionmusical\"]www.facebook.com\/fuzionmusical[\/url][\/quote][\/quote][\/quote][\/quote][\/quote][\/quote][color=rgb(40,40,40)][font=arial]\nAnd my wedding planner:[\/font][\/color]\n[color=rgb(0,0,0)][font=&#039;Century Gothic&#039;][size=1]\nLIC. LORENA MONTEMAYOR PE\u00d1A\n[email=\"wedding1@saasilkantenah.com\"]wedding1@saasilkantenah.com[\/email]\nSAASIL KANTENAH \/\nANHEXO AMBIENTACI\u00d3N Y MOBILIARIO\nEDIF NEST 3ER PISO[\/size][\/font][\/color]\n[color=rgb(0,0,0)][font=&#039;Century Gothic&#039;][size=1]\nAV.10 ENTRE CALLE 38 Y 40\nPLAYA DEL CARMEN. Q ROO.\nCEL. (984) 1577453\nTEL (984) 859 43 10[\/size][\/font][\/color]","Attachments":[],"Id":1894709,"PostDate":1430223075,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span  style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif\">Hello brides!!! im getting married in 4 days in Azul Fives Hotel in the Mayan Riviera. I just want to invite you to read my new blog entry:<\/span><\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\"><span  style=\"color:rgb(0,0,0);font-family:Helvetica;font-size:12px\"><a href='http:\/\/www.bestdestinationwedding.com\/blog\/113-step-by-step-azul-fives-hotel-2015\/' class='bbc_url' title=''>http:\/\/www.bestdesti...ves-hotel-2015\/<\/a><\/span><\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">So you can follow it and I now how did I do with all the vendors, the hotel, etc!<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">I'd like to share and recommend my wedding vendors!!<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">For photography :\u00a0<span>www.shenkophoto.com<\/span><\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\"><span><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/www.shenkophoto.com\/wp-content\/themes\/twentytwelve\/images\/home-bg.jpg\" alt=\"home-bg.jpg\"><\/span><\/span><\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">For the music:\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">\u00a0<\/p>\n<blockquote>\n<blockquote>\n<blockquote>\n<blockquote>\n<blockquote>\n<blockquote>\n<p>Ricardo Trujillo Duran<br><em>Entertainment Manager<\/em><br><strong>9981604069<\/strong>\u00a0\u00b7\u00a0<a href='mailto:dj.rickalvin@hotmail.com' class='bbc_url' title='External link' rel='nofollow external'>dj.rickalvin@hotmail.com<\/a><\/p>\n<p>Fuzion Musical<br>\nCancun Q.Roo, Mexico \u00b7 C.P. 77539<br><a href='mailto:fuzion.musical@icloud.com' class='bbc_url' title='External link' rel='nofollow external'>fuzion.musical@icloud.com<\/a>\u00a0\u00b7\u00a0<a href='http:\/\/www.facebook.com\/fuzionmusical' class='bbc_url' title='External link' rel='nofollow external'>www.facebook.com\/fuzionmusical<\/a><\/p>\n<\/blockquote>\n<\/blockquote>\n<\/blockquote>\n<\/blockquote>\n<\/blockquote>\n<\/blockquote>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">And my wedding planner:<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">\u00a0<\/p>\n<div  style=\"margin:0px;font-family:'Century Gothic';color:rgb(0,0,0);font-size:medium;\">LIC. LORENA MONTEMAYOR PE\u00d1A<br><a href='mailto:wedding1@saasilkantenah.com' class='bbc_url' title='External link' rel='nofollow external'>wedding1@saasilkantenah.com<\/a><br>\nSAASIL KANTENAH \/<br>\nANHEXO AMBIENTACI\u00d3N Y\u00a0MOBILIARIO<br>\nEDIF NEST 3ER PISO<\/div>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">\u00a0<\/p>\n<div  style=\"margin:0px;font-family:'Century Gothic';color:rgb(0,0,0);font-size:medium;\"><span>AV.10<\/span>\u00a0ENTRE CALLE 38 Y 40<br>\nPLAYA DEL CARMEN. Q ROO.<br>\nCEL. (984) 1577453<br>\nTEL (984) 859 43 10<\/div>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"andieyjerry@gmail.com","IpAddress":"187.172.196.170","GroupId":39,"GroupName":"Newbie","JoinDate":1405593676,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279051.png?_r=1405694655","PhotoWidth":200,"PhotoHeight":185,"PhotoType":"custom"},"FormattedName":"andreaberretta","Id":279051,"Name":"andreaberretta","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"199.85.228.129","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72192,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cff9b4913ad9280fca1966c180654d56","RawContent":"&lt;p&gt;Very exciting!!! Enjoy your wedding day :)&lt;\/p&gt;","Attachments":[],"Id":1894725,"PostDate":1430229903,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Very exciting!!! Enjoy your wedding day <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"katie_mcbride48@yahoo.ca","IpAddress":"199.85.228.129","GroupId":39,"GroupName":"Newbie","JoinDate":1424099850,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282132.jpg?_r=1437519508","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"KatieMcBride","Id":282132,"Name":"KatieMcBride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"76.119.165.154","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72192,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1adf7170bd7f4872fdc97210e17eb220","RawContent":"[quote name=\"crcombs\" post=\"1888790\" timestamp=\"1425928101\"]\nGood afternoon ladies!!\nI haven&#039;t posted in awhile and want to say congratulations to anybody that has already gotten married and hope everything is going as planned for those that will be soon.\n\nMy day of July 18th is approaching fast and I can&#039;t wait for it to be here. I need a vacation and my life back badly!! lol If anyone needs any advise, have questions or any words of wisdom for me please let me know. I know the next few months I will be freaking out.\n\nHappy planning!![\/quote]@[member=\"crcombs\"] Wedding Date Twin!  How are your plans coming along?  79 days until we do!!!","Attachments":[],"Id":1894989,"PostDate":1430423901,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>crcombs, on 09 March 2015 - 03:08 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Good afternoon ladies!!<\/p>\n<p>I haven't posted in awhile and want to say congratulations to anybody that has already gotten married and hope everything is going as planned for those that will be soon.<\/p>\n<p>\u00a0<\/p>\n<p>My day of July 18th is approaching fast and I can't wait for it to be here. I need a vacation and my life back badly!! lol If anyone needs any advise, have questions or any words of wisdom for me please let me know. I know the next few months I will be freaking out.<\/p>\n<p>\u00a0<\/p>\n<p>Happy planning!!<\/p>\n<\/div>\n<\/div><\/div>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"265340\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/265340-crcombs\/' title='Member profile'><span itemprop=\"name\">crcombs<\/span><\/a> Wedding Date Twin!\u00a0 How are your plans coming along?\u00a0 79 days until we do!!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"candice.french@gmail.com","IpAddress":"24.62.169.169","GroupId":39,"GroupName":"Newbie","JoinDate":1415106695,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280992.jpg?_r=1421507914","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"MissFrench","Id":280992,"Name":"MissFrench","IsOnline":false}}],"Pages":{"TotalItems":272,"TotalPages":28,"CurrentPage":260,"NextPage":270,"PreviousPage":250,"LastPage":270},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
