Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":10,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":180,"MovedTo":null,"MovedOn":0,"FirstPostId":1895129,"Rating":0,"RatingHits":0,"Starter":{"Id":282068,"Name":"Kristin18","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1430526090,"LastPoster":{"Id":282068,"Name":"Kristin18","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":23,"Preview":{"Id":1895129,"PostDate":1430526090,"PostContent":"Hello! I'm starting to plan a wedding for June 2016 at Rose Hall Suites in Montego Bay and I'm ho...","Author":{"Signature":"","Email":"kristinfarrell89@yahoo.com","IpAddress":"73.160.45.46","GroupId":39,"GroupName":"Newbie","JoinDate":1423588105,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Kristin18","Id":282068,"Name":"Kristin18","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.147.115.46","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79139,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c0c783fe93739f8736f4f5e1bb32ad6b","RawContent":"Hello! I&#039;m starting to plan a wedding for June 2016 at Rose Hall Suites in Montego Bay and I&#039;m hoping and previous\/current brides can help me out! I&#039;m finding it difficult to get any information online and I want to know more about pricing. We are thinking we will have roughly 40 guests and I only see packages for much smaller wedding parties. I&#039;m wondering how exactly the price works ( $ per head, any package deals, etc.). Thanks in advance for your help!","Attachments":[],"Id":1895129,"PostDate":1430526090,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hello! I'm starting to plan a wedding for June 2016 at Rose Hall Suites in Montego Bay and I'm hoping and previous\/current brides can help me out! I'm finding it difficult to get any information online and I want to know more about pricing. We are thinking we will have roughly 40 guests and I only see packages for much smaller wedding parties. I'm wondering how exactly the price works ( $ per head, any package deals, etc.). Thanks in advance for your help!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kristinfarrell89@yahoo.com","IpAddress":"73.160.45.46","GroupId":39,"GroupName":"Newbie","JoinDate":1423588105,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Kristin18","Id":282068,"Name":"Kristin18","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.202.225.11","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79139,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c56c7ec84e70bd922724b1ef9d798562","RawContent":"&lt;p&gt;Welcome Kristin. &amp;nbsp;You might want to reach out to TA babs. &amp;nbsp;She has a bunch of Rose Hall Suites brides and can probably help with that information.&lt;\/p&gt;","Attachments":[],"Id":1895147,"PostDate":1430534705,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome Kristin. \u00a0You might want to reach out to TA babs. \u00a0She has a bunch of Rose Hall Suites brides and can probably help with that information.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-family:arial, helvetica, sans-serif;\">Founder and Owner of BestDestinationWedding.com \u00a0\/ \u00a0<\/span><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/'><strong><span style=\"font-family:arial, helvetica, sans-serif;\">Bride & Groom Fly FREE Promotion<\/span><\/strong><\/a><\/p>\n<p>\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><strong><a data-ipb='nomediaparse' href='http:\/\/wrighttravelagency.com\/inquiry\/'><span style=\"color:#008080;\">Looking for a travel agency that specializes in Destination Weddings<\/span><\/a><\/strong><span style=\"color:#008080;\"><strong>?<\/strong> \u00a0We are an award winning travel agency and you can <\/span><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style=\"color:#008080;\">read our reviews\u00a0here.<\/span><\/a><\/strong><\/span><br>\n\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"color:#008080;\"><strong>Awards and recognition:\u00a0<\/strong><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Palace Resorts PRO Platinum Agency (Top Award) \u00a0 \u00a0 | \u00a0 \u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">AMResorts Master Agent & Top Agency \u00a0<\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/68050-karisma-hotels-givc-and-gi-wedding-consultants-wright-travel-agency\/'><strong>Wright Travel & Karisma GIVC Benefits<\/strong><\/a><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Travel Impressions Best of the Best Globe Winner \u00a0 \u00a0| \u00a0 \u00a0\u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Apple Vacations Golden Apple Winner \u00a0<\/span><\/span><br><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"> \u00a0 \u00a0<img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"font-size:14px;\"><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010'>Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><\/span><\/span><strong><span style=\"color:#b22222;\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a data-ipb='nomediaparse' href='mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com'>ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"admin@bestdestinationwedding.com","IpAddress":"71.202.225.11","GroupId":4,"GroupName":"Administrators","JoinDate":1137224220,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"FormattedName":"TammyWright","Id":206696,"Name":"TammyWright","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.227.250.95","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79139,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0964aae02fb4a7ab7447624f17accd81","RawContent":"I am actually going there this November for a friends wedding !! As soon as I get back I can post photos from her wedding and room etc. it&#039;s easier to email the resort directly go to there home page and email them they will send info over right away.","Attachments":[],"Id":1895217,"PostDate":1430665152,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I am actually going there this November for a friends wedding !! As soon as I get back I can post photos from her wedding and room etc. it's easier to email the resort directly go to there home page and email them they will send info over right away. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><br><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;484\/st\/20160506\/e\/Our+Wedding\/k\/be22\/event.png\" alt=\"event.png\"><br><\/a>","Email":"jessica.galvao21@gmail.com","IpAddress":"99.227.250.95","GroupId":39,"GroupName":"Newbie","JoinDate":1430235023,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282893.jpg?_r=1431348606","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"giigiixo","Id":282893,"Name":"giigiixo","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.165.141.121","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79139,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"e879e33916abe5b47c881f09f451fa3e","RawContent":"Hi @[member=\"Kristin18\"]! I am getting married there in 5 short weeks with about 65 adults staying at the resort! Happy to answer any questions you need. \n\nWe are just doing the basic star package, which includes 15 guests. Then, we pay $20 per person over the 15, which includes the champagne toast, set up and cake pretty much - oh and the semi-private dinner if you choose to go that route. Most brides have said the semi-private dinner is perfectly great and usually follow it with a bonfire party on the beach or they rent out the mango walk disco for dancing. \n\nWe are doing a private reception at Calabash, which is $800 to rent out which includes the meal and beer and wine. We are adding a bar package on top of that, which depending on how high end you want it is either $7 or $10 per person, per hour. I just really want air conditioning for my reception so I didn&#039;t want to do dancing on the beach! The night before we are doing a semi-private dinner (no extra charge) and then a bonfire on the beach with a steel drum band! I don&#039;t care if I&#039;m a sweaty mess the night before :)\n\nLike I said, let me know what other questions you have! I&#039;m in the homestretch! \n\n[quote name=\"Kristin18\" post=\"1895129\" timestamp=\"1430526090\"]\nHello! I&#039;m starting to plan a wedding for June 2016 at Rose Hall Suites in Montego Bay and I&#039;m hoping and previous\/current brides can help me out! I&#039;m finding it difficult to get any information online and I want to know more about pricing. We are thinking we will have roughly 40 guests and I only see packages for much smaller wedding parties. I&#039;m wondering how exactly the price works ( $ per head, any package deals, etc.). Thanks in advance for your help![\/quote]","Attachments":[],"Id":1895239,"PostDate":1430697738,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi @<a hovercard-ref=\"member\" hovercard-id=\"282068\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/282068-kristin18\/' title='Member profile'><span itemprop=\"name\">Kristin18<\/span><\/a>! I am getting married there in 5 short weeks with about 65 adults staying at the resort! Happy to answer any questions you need.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>We are just doing the basic star package, which includes 15 guests. Then, we pay $20 per person over the 15, which includes the champagne toast, set up and cake pretty much - oh and the semi-private dinner if you choose to go that route. Most brides have said the semi-private dinner is perfectly great and usually follow it with a bonfire party on the beach or they rent out the mango walk disco for dancing.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>We are doing a private reception at Calabash, which is $800 to rent out which includes the meal and beer and wine. We are adding a bar package on top of that, which depending on how high end you want it is either $7 or $10 per person, per hour. I just really want air conditioning for my reception so I didn't want to do dancing on the beach! The night before we are doing a semi-private dinner (no extra charge) and then a bonfire on the beach with a steel drum band! I don't care if I'm a sweaty mess the night before <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Like I said, let me know what other questions you have! I'm in the homestretch!\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Kristin18, on 01 May 2015 - 04:21 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hello! I'm starting to plan a wedding for June 2016 at Rose Hall Suites in Montego Bay and I'm hoping and previous\/current brides can help me out! I'm finding it difficult to get any information online and I want to know more about pricing. We are thinking we will have roughly 40 guests and I only see packages for much smaller wedding parties. I'm wondering how exactly the price works ( $ per head, any package deals, etc.). Thanks in advance for your help!<\/p>\n<\/div>\n<\/div><\/div>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rebecca.shaffer@gmail.com","IpAddress":"159.53.174.144","GroupId":40,"GroupName":"Jr. Member","JoinDate":1403116087,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"beckys98","Id":278581,"Name":"beckys98","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.215.66.93","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79139,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"987db5947ab7093200c9655f6489af5e","RawContent":"I&#039;ve been trying to email the resort and have yet to receive a response. It&#039;s very frustrating when I want to start this process and I have guests asking about details and I don&#039;t have the answers! I used the wedding email I found on the Iberostar site.","Attachments":[],"Id":1895377,"PostDate":1430839109,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I've been trying to email the resort and have yet to receive a response. It's very frustrating when I want to start this process and I have guests asking about details and I don't have the answers! I used the wedding email I found on the Iberostar site. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kristinfarrell89@yahoo.com","IpAddress":"73.160.45.46","GroupId":39,"GroupName":"Newbie","JoinDate":1423588105,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Kristin18","Id":282068,"Name":"Kristin18","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.215.66.93","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79139,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0618ba25d3aa316aa157a78f5e949eba","RawContent":"[quote name=\"giigiixo\" post=\"1895217\" timestamp=\"1430665152\"]\nI am actually going there this November for a friends wedding !! As soon as I get back I can post photos from her wedding and room etc. it&#039;s easier to email the resort directly go to there home page and email them they will send info over right away.[\/quote]\nI did use that email and I&#039;ve emailed them three times and no response!","Attachments":[],"Id":1895402,"PostDate":1430844304,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>giigiixo, on 03 May 2015 - 06:59 AM, said:<\/p><div class='blockquote'><div class='quote'><p>I am actually going there this November for a friends wedding !! As soon as I get back I can post photos from her wedding and room etc. it's easier to email the resort directly go to there home page and email them they will send info over right away.<\/p><\/div><\/div>\n<br>\nI did use that email and I've emailed them three times and no response!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kristinfarrell89@yahoo.com","IpAddress":"73.160.45.46","GroupId":39,"GroupName":"Newbie","JoinDate":1423588105,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Kristin18","Id":282068,"Name":"Kristin18","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"159.53.174.143","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79139,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3a6f9049d78fc4226b193e57135cf2e1","RawContent":"Hi @[member=\"Kristin18\"] - Do you have a travel agent? Before I had confirmed my wedding date my travel agent did all the communication with them and it was very quick. Then after we booked I&#039;ve just been working with them directly and haven&#039;t had any issues - usually 2-3 days for a response. I save up my questions and send several at a time!\n\nweddings.suites@iberostar.com.jm is the email address I use.\n\nAny other questions I can help you with in the meantime?\n[quote name=\"Kristin18\" post=\"1895377\" timestamp=\"1430839109\"]\nI&#039;ve been trying to email the resort and have yet to receive a response. It&#039;s very frustrating when I want to start this process and I have guests asking about details and I don&#039;t have the answers! I used the wedding email I found on the Iberostar site.[\/quote]","Attachments":[],"Id":1895404,"PostDate":1430845863,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi @<a hovercard-ref=\"member\" hovercard-id=\"282068\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/282068-kristin18\/' title='Member profile'><span itemprop=\"name\">Kristin18<\/span><\/a> - Do you have a travel agent? Before I had confirmed my wedding date my travel agent did all the communication with them and it was very quick. Then after we booked I've just been working with them directly and haven't had any issues - usually 2-3 days for a response. I save up my questions and send several at a time!<\/p>\n<p>\u00a0<\/p>\n<p>weddings.suites@iberostar.com.jm is the email address I use.<\/p>\n<p>\u00a0<\/p>\n<p>Any other questions I can help you with in the meantime?<\/p>\n<p>\u00a0<\/p>\n<p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Kristin18, on 05 May 2015 - 07:18 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>I've been trying to email the resort and have yet to receive a response. It's very frustrating when I want to start this process and I have guests asking about details and I don't have the answers! I used the wedding email I found on the Iberostar site.<\/p>\n<\/div>\n<\/div><\/div>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rebecca.shaffer@gmail.com","IpAddress":"159.53.174.144","GroupId":40,"GroupName":"Jr. Member","JoinDate":1403116087,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"beckys98","Id":278581,"Name":"beckys98","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.215.66.93","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79139,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"78a2fb56f6f52f64bec6d7641b468375","RawContent":"[quote name=\"beckys98\" post=\"1895404\" timestamp=\"1430845863\"]\nHi @[member=\"Kristin18\"] - Do you have a travel agent? Before I had confirmed my wedding date my travel agent did all the communication with them and it was very quick. Then after we booked I&#039;ve just been working with them directly and haven&#039;t had any issues - usually 2-3 days for a response. I save up my questions and send several at a time!\n \nweddings.suites@iberostar.com.jm is the email address I use.\n \nAny other questions I can help you with in the meantime?[\/quote]\nThat&#039;s the email address I used. The travel agent is a whole other issue. I spoke with one my parents and other family members have used and highly recommended. However, I&#039;m having issues contacting her as well! I can&#039;t catch a break lol. I just wanna get this thing booked before I lose our date!","Attachments":[],"Id":1895406,"PostDate":1430846086,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>beckys98, on 05 May 2015 - 09:11 AM, said:<\/p><div class='blockquote'><div class='quote'><p>Hi @<a hovercard-ref=\"member\" hovercard-id=\"282068\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/282068-kristin18\/' title='Member profile'><span itemprop=\"name\">Kristin18<\/span><\/a> - Do you have a travel agent? Before I had confirmed my wedding date my travel agent did all the communication with them and it was very quick. Then after we booked I've just been working with them directly and haven't had any issues - usually 2-3 days for a response. I save up my questions and send several at a time!<br>\n\u00a0<br>\nweddings.suites@iberostar.com.jm is the email address I use.<br>\n\u00a0<br>\nAny other questions I can help you with in the meantime?<\/p><\/div><\/div>\n<br><br>\nThat's the email address I used. The travel agent is a whole other issue. I spoke with one my parents and other family members have used and highly recommended. However, I'm having issues contacting her as well! I can't catch a break lol. I just wanna get this thing booked before I lose our date!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kristinfarrell89@yahoo.com","IpAddress":"73.160.45.46","GroupId":39,"GroupName":"Newbie","JoinDate":1423588105,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Kristin18","Id":282068,"Name":"Kristin18","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"159.53.46.141","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79139,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7fc73ce916e2bb6719cc3ee3e847e429","RawContent":"&lt;p&gt;Oh no!! We booked our June 2015 date in July 2014 and had plenty of date options. I think with DWs people get married on all days of the week so it isn&#039;t like everyone is competing for just a few Saturdays! I know the feeling though - once you&#039;re ready to book you just want it finalized :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Ours is on a Thursday and I&#039;m SO glad we did it that way - I wanted to have a few days AFTER the wedding with our guests where I&#039;m completely and totally relaxed and done with all chores :) But the resort is so close to the airport that if people were just coming for a long weekend they could still get in the day of the wedding in plenty of time to make it. We only have 1 couple coming the day of the wedding though. Most people arrive Tuesday or Wednesday and are staying until Sunday or Monday.&lt;\/p&gt;","Attachments":[],"Id":1895409,"PostDate":1430846544,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Oh no!! We booked our June 2015 date in July 2014 and had plenty of date options. I think with DWs people get married on all days of the week so it isn't like everyone is competing for just a few Saturdays! I know the feeling though - once you're ready to book you just want it finalized <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Ours is on a Thursday and I'm SO glad we did it that way - I wanted to have a few days AFTER the wedding with our guests where I'm completely and totally relaxed and done with all chores <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> But the resort is so close to the airport that if people were just coming for a long weekend they could still get in the day of the wedding in plenty of time to make it. We only have 1 couple coming the day of the wedding though. Most people arrive Tuesday or Wednesday and are staying until Sunday or Monday.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rebecca.shaffer@gmail.com","IpAddress":"159.53.174.144","GroupId":40,"GroupName":"Jr. Member","JoinDate":1403116087,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"beckys98","Id":278581,"Name":"beckys98","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.215.66.93","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79139,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c4656eb5a1f63e2a29b333f150fdbc6d","RawContent":"[quote name=\"beckys98\" post=\"1895409\" timestamp=\"1430846544\"]\nOh no!! We booked our June 2015 date in July 2014 and had plenty of date options. I think with DWs people get married on all days of the week so it isn&#039;t like everyone is competing for just a few Saturdays! I know the feeling though - once you&#039;re ready to book you just want it finalized :)\n \nOurs is on a Thursday and I&#039;m SO glad we did it that way - I wanted to have a few days AFTER the wedding with our guests where I&#039;m completely and totally relaxed and done with all chores :) But the resort is so close to the airport that if people were just coming for a long weekend they could still get in the day of the wedding in plenty of time to make it. We only have 1 couple coming the day of the wedding though. Most people arrive Tuesday or Wednesday and are staying until Sunday or Monday.[\/quote]Her ears must&#039;ve been burning bracts I JUST got an email from her asking what my date choices are! We really want 6\/25\/16 because we have some guests who are in the school system and any earlier is cutting it too close and any later and were getting closer to 4th of July and the rainier season! The 26th is our second option but I know the weekend just works out best for most of our guests and that&#039;s our goal-keeping it as easy as possible for those willing to travel for us!","Attachments":[],"Id":1895410,"PostDate":1430847254,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>beckys98, on 05 May 2015 - 09:22 AM, said:<\/p><div class='blockquote'><div class='quote'><p>Oh no!! We booked our June 2015 date in July 2014 and had plenty of date options. I think with DWs people get married on all days of the week so it isn't like everyone is competing for just a few Saturdays! I know the feeling though - once you're ready to book you just want it finalized <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br>\n\u00a0<br>\nOurs is on a Thursday and I'm SO glad we did it that way - I wanted to have a few days AFTER the wedding with our guests where I'm completely and totally relaxed and done with all chores <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> But the resort is so close to the airport that if people were just coming for a long weekend they could still get in the day of the wedding in plenty of time to make it. We only have 1 couple coming the day of the wedding though. Most people arrive Tuesday or Wednesday and are staying until Sunday or Monday.<\/p><\/div><\/div>\n<br>\nHer ears must've been burning bracts I JUST got an email from her asking what my date choices are! We really want 6\/25\/16 because we have some guests who are in the school system and any earlier is cutting it too close and any later and were getting closer to 4th of July and the rainier season! The 26th is our second option but I know the weekend just works out best for most of our guests and that's our goal-keeping it as easy as possible for those willing to travel for us!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kristinfarrell89@yahoo.com","IpAddress":"73.160.45.46","GroupId":39,"GroupName":"Newbie","JoinDate":1423588105,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Kristin18","Id":282068,"Name":"Kristin18","IsOnline":false}}],"Id":"79139","Title":"Possible Rose Hall Suites Bride","LastPostDate":1430847254},"Pages":{"TotalItems":10,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
