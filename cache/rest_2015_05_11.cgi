Request Time: 1 seconds
{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.87.66.102","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":18414,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"85e0bef73a5222116778bc62ead21b32","RawContent":"@[member=\"StacyPaul\"] the beach was something my mom and I really worried about but in the end when Sam and I went on our BdR it didn&#039;t really bother me just because we hung out by the swim up bars since the pool is more relaxing then being in the ocean regardless of where you are. \n\n\nMost guest will venture to the pools and swim up bars and that was the case when we were down there for the BdR. However there were people laying out on the beds more than I would think but the area was groomed and the seaweed is picked up everyday. I had a family reunion in destin Florida where the beaches are beautiful and all the family hung out in the pool area. So that seems to be the case everywhere you go.\n\nIf you have snorkelers in your group the  tour guide up front has snorkel tours that take groups out past all the seaweed to coral and it&#039;s beautiful.\n\n\nJust like all the others have said, the service and the resort is absolutely breathtaking. Before going to the BdR I was a mess and meeting the staff there  completely calmed and reassured me that everything would be good. \n\n\nPlus Karisma is one of the better hotels for weddings in that area and that&#039;s saying something since the area is the number one destination wedding spot in the world.","Attachments":[],"Id":1895870,"PostDate":1431271666,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"283027\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/283027-stacypaul\/' title='Member profile'><span itemprop=\"name\">StacyPaul<\/span><\/a> the beach was something my mom and I really worried about but in the end when Sam and I went on our BdR it didn't really bother me just because we hung out by the swim up bars since the pool is more relaxing then being in the ocean regardless of where you are. <br><br>\nMost guest will venture to the pools and swim up bars and that was the case when we were down there for the BdR. However there were people laying out on the beds more than I would think but the area was groomed and the seaweed is picked up everyday. I had a family reunion in destin Florida where the beaches are beautiful and all the family hung out in the pool area. So that seems to be the case everywhere you go.<br>\nIf you have snorkelers in your group the  tour guide up front has snorkel tours that take groups out past all the seaweed to coral and it's beautiful.<br><br>\nJust like all the others have said, the service and the resort is absolutely breathtaking. Before going to the BdR I was a mess and meeting the staff there  completely calmed and reassured me that everything would be good. <br><br>\nPlus Karisma is one of the better hotels for weddings in that area and that's saying something since the area is the number one destination wedding spot in the world.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"carrieandsamswedding15@gmail.com","IpAddress":"76.169.253.92","GroupId":39,"GroupName":"Newbie","JoinDate":1412813196,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280407.jpg?_r=1425426307","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"carrieandsam","Id":280407,"Name":"carrieandsam","IsOnline":false}}],"Pages":{"TotalItems":18701,"TotalPages":1871,"CurrentPage":18700,"NextPage":-1,"PreviousPage":18690,"LastPage":18700},"PushNotifications":[{"Key":"notifications","Value":1,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
