{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":222,"QueuedPosts":0,"DeletedPosts":1,"HasUnreadPosts":false,"HasAttachments":true,"Views":16116,"MovedTo":null,"MovedOn":0,"FirstPostId":381035,"Rating":0,"RatingHits":0,"Starter":{"Id":209280,"Name":"~Andie~","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209280.gif?_r=0","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"IsOnline":false},"StartDate":1216139386,"LastPoster":{"Id":239002,"Name":"AmyandMike","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-239002.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":5,"Preview":{"Id":381035,"PostDate":1216139386,"PostContent":"I was just wondering if there are any other brides out there, that are getting married at the Dre...","Author":{"Signature":"","Email":"scott.andrea.2009@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1210109409,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209280.gif?_r=0","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"FormattedName":"~Andie~","Id":209280,"Name":"~Andie~","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":20066,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"60358134699bbd0efebb1346e1a0a600","RawContent":"I was just wondering if there are any other brides out there, that are getting married at the Dreams Huatulco Resort in Mexico. Dreams is taking over the Gala Resort in Huatulco, and are doing a multimillion dollar renovation as we speak. They will be re0opening in Nov.&#039;08. I would love to talk to some other Dreams Huatulco Brides....&lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif\" border=\"0\" alt=\"\" title=\"Cheesy\" class=\"inlineimg\" \/&gt;","Attachments":[],"Id":381035,"PostDate":1216139386,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I was just wondering if there are any other brides out there, that are getting married at the Dreams Huatulco Resort in Mexico. Dreams is taking over the Gala Resort in Huatulco, and are doing a multimillion dollar renovation as we speak. They will be re0opening in Nov.'08. I would love to talk to some other Dreams Huatulco Brides....<span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif\" border=\"0\" alt=\"\" title=\"Cheesy\" class=\"inlineimg\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"scott.andrea.2009@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1210109409,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209280.gif?_r=0","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"FormattedName":"~Andie~","Id":209280,"Name":"~Andie~","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":20066,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"999e98215b008566c6a86abf56120426","RawContent":"We are strongly considering it. Our travel agent can&#039;t get a hold of them though. Do you know any contact information for a wedding coordinator for Dreams Huatulco?","Attachments":[],"Id":381391,"PostDate":1216158157,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We are strongly considering it. Our travel agent can't get a hold of them though. Do you know any contact information for a wedding coordinator for Dreams Huatulco?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"aniloeffler@att.net","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1215709138,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-210451.gif?_r=0","PhotoWidth":150,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"Hazzies","Id":210451,"Name":"Hazzies","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":20066,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"55e5975abe3f0aaf515c06cd7b6fcf08","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;Hazzies&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;We are strongly considering it. Our travel agent can&#039;t get a hold of them though. Do you know any contact information for a wedding coordinator for Dreams Huatulco?&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;My travel agent is just waiting to hear back which coordinator is going to be assigned to our wedding....well that is what she told me anyways.\n When is your wedding??","Attachments":[],"Id":381399,"PostDate":1216158401,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>Hazzies<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">We are strongly considering it. Our travel agent can't get a hold of them though. Do you know any contact information for a wedding coordinator for Dreams Huatulco?<\/div> <\/td> <\/tr> <\/table> <\/div>My travel agent is just waiting to hear back which coordinator is going to be assigned to our wedding....well that is what she told me anyways.<br \/> When is your wedding??\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"scott.andrea.2009@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1210109409,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209280.gif?_r=0","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"FormattedName":"~Andie~","Id":209280,"Name":"~Andie~","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":20066,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fc732558467ad53520925af0ab39b7e7","RawContent":"It is going to be in June 2009. We heard great things about Huatulco, great things about the former resort Gala, and real good things about the Dreams Resorts. We figured that if all those things were good about it before, it should be just as good, if not better than it was before. Still, it makes us a little nervous choosing a resort that is hasn&#039;t opened yet. When brand new resorts open they tend to have kinks to work out, but this resort isn&#039;t going to be brand new, just renovated. We&#039;re hoping it doesn&#039;t affect it much. Were you able to receive information from the resort even though they are closed? How many people are you having? Is that giving you a better price for the wedding? Upgrades? Keep in touch. It will be nice to hear from someone who is going through the same thing.\n \n Congratulations on your wedding!","Attachments":[],"Id":382314,"PostDate":1216223315,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                It is going to be in June 2009. We heard great things about Huatulco, great things about the former resort Gala, and real good things about the Dreams Resorts. We figured that if all those things were good about it before, it should be just as good, if not better than it was before. Still, it makes us a little nervous choosing a resort that is hasn't opened yet. When brand new resorts open they tend to have kinks to work out, but this resort isn't going to be brand new, just renovated. We're hoping it doesn't affect it much. Were you able to receive information from the resort even though they are closed? How many people are you having? Is that giving you a better price for the wedding? Upgrades? Keep in touch. It will be nice to hear from someone who is going through the same thing.<br \/> <br \/> Congratulations on your wedding!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"aniloeffler@att.net","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1215709138,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-210451.gif?_r=0","PhotoWidth":150,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"Hazzies","Id":210451,"Name":"Hazzies","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":20066,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"58f8e6813a51924e3dc5fa8bf6301429","RawContent":"Sorry &amp;quot;Hazzies&amp;quot; that is took so long to get back to you. I just spoke with my Travel agent today, and yes, she is having problems getting a hold of the Wedding Coordinator as well. She told me she would contact Dreams directly, and see if she could get a hold of the coordinator that way...I guess we will see. I&#039;m a little nervous as well, about choosing a resort that is under going extensive renovations....but my fiance and I had gone to Jamaica a couple years ago, and the resort we stayed at was still being built, and it was still amazing!!! :) We are estimating we will have 35-45 guests coming with us...so I&#039;m really excited?? And you?? We also, feel we did get a better rate at this resort because of the renovations...we wanted the price to be under $2000, taxes include. It took awhile to find a package (3 months) but we finally succeeded!!!\n \n Congratulations to you as well!!!\n Let me know if you found out anything...and I will do the same!!","Attachments":[],"Id":395435,"PostDate":1217034432,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Sorry \"Hazzies\" that is took so long to get back to you. I just spoke with my Travel agent today, and yes, she is having problems getting a hold of the Wedding Coordinator as well. She told me she would contact Dreams directly, and see if she could get a hold of the coordinator that way...I guess we will see. I'm a little nervous as well, about choosing a resort that is under going extensive renovations....but my fiance and I had gone to Jamaica a couple years ago, and the resort we stayed at was still being built, and it was still amazing!!! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> We are estimating we will have 35-45 guests coming with us...so I'm really excited?? And you?? We also, feel we did get a better rate at this resort because of the renovations...we wanted the price to be under $2000, taxes include. It took awhile to find a package (3 months) but we finally succeeded!!!<br \/> <br \/> Congratulations to you as well!!!<br \/> Let me know if you found out anything...and I will do the same!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"scott.andrea.2009@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1210109409,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209280.gif?_r=0","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"FormattedName":"~Andie~","Id":209280,"Name":"~Andie~","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":20066,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"36fe12a0c1340ced35def908587436b1","RawContent":"Hi to both of you!\n I am also a dreams huatulco bride :) We are getting married Dec 30th, 2009. I haven&#039;t received any wedding information yet either but my travel agent is supposed to be emailing it to me today. If I get it I will forward it on to the two of you. \n I would not be too worried about the renovations as I was jsut at the punta cana dreams resort this past january for a wedding and they had just underwent renovations as well but you never would have known it! Dreams resorts are all very similar and their wedding pkgs are wonderful. We are super excited!\n \n Also-there is another bride &#039;jenluvsmike&#039; on the &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.weddingbells.ca\"&gt;Weddingbells.ca&lt;\/a&gt; forum that I have been talking with and she is getting married there this coming january. \n \n keep in touch!","Attachments":[],"Id":397577,"PostDate":1217278561,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi to both of you!<br \/> I am also a dreams huatulco bride <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> We are getting married Dec 30th, 2009. I haven't received any wedding information yet either but my travel agent is supposed to be emailing it to me today. If I get it I will forward it on to the two of you. <br \/> I would not be too worried about the renovations as I was jsut at the punta cana dreams resort this past january for a wedding and they had just underwent renovations as well but you never would have known it! Dreams resorts are all very similar and their wedding pkgs are wonderful. We are super excited!<br \/> <br \/> Also-there is another bride 'jenluvsmike' on the <a href='http:\/\/www.weddingbells.ca' class='bbc_url' title='External link' rel='nofollow external'>Weddingbells.ca<\/a> forum that I have been talking with and she is getting married there this coming january. <br \/> <br \/> keep in touch!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i210.photobucket.com\/albums\/bb46\/nadinecloss\/rocks.jpg\">http:\/\/i210.photobucket.com\/albums\/b...loss\/rocks.jpg<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f77\/nadine-s-dreams-huatulco-review-12-29-09-a-53920\/\">My Dreams Huatulco Wedding Review<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f128\/nadine-s-planning-thread-52947\/\">My Planning Thread<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f76\/nadine-s-wedding-day-after-photots-54891\/#post1161576\">Photographer Review<\/a><\/div><\/div>","Email":"nadinecloss@hotmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1215636060,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-210423.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"*Nadine*","Id":210423,"Name":"*Nadine*","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":20066,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"63e270cad7855174b5a077586f23f6f8","RawContent":"btw andie, I live in Calgary as well!\n \n What are you doing for a photographer??","Attachments":[],"Id":397590,"PostDate":1217279550,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                btw andie, I live in Calgary as well!<br \/> <br \/> What are you doing for a photographer??\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i210.photobucket.com\/albums\/bb46\/nadinecloss\/rocks.jpg\">http:\/\/i210.photobucket.com\/albums\/b...loss\/rocks.jpg<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f77\/nadine-s-dreams-huatulco-review-12-29-09-a-53920\/\">My Dreams Huatulco Wedding Review<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f128\/nadine-s-planning-thread-52947\/\">My Planning Thread<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f76\/nadine-s-wedding-day-after-photots-54891\/#post1161576\">Photographer Review<\/a><\/div><\/div>","Email":"nadinecloss@hotmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1215636060,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-210423.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"*Nadine*","Id":210423,"Name":"*Nadine*","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":20066,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1b40b0c3b229d71530543b620f77af98","RawContent":"Good luck to you all in finding your vendors, you may want to consider using the forum&#039;s search function.\n \n Best,\n \n d!no","Attachments":[],"Id":398911,"PostDate":1217364719,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Good luck to you all in finding your vendors, you may want to consider using the forum'