{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":8,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":2211,"MovedTo":null,"MovedOn":0,"FirstPostId":1787975,"Rating":0,"RatingHits":0,"Starter":{"Id":271379,"Name":"tritter1","Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-271379.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"StartDate":1375834656,"LastPoster":{"Id":288219,"Name":"Danyella","Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1787975,"PostDate":1375834656,"PostContent":"Hello Ladies and congrats to you all. I am getting married GOD willing on March 7, 2015 at 5pm a...","Author":{"Signature":"","Email":"tanisharitter@gmail.com","IpAddress":"159.53.110.143","GroupId":39,"GroupName":"Newbie","JoinDate":1373466198,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-271379.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"tritter1","Id":271379,"Name":"tritter1","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":74774,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"671f61379aea7ed3a26220541f634a02","RawContent":"&lt;p&gt; Hello Ladies and congrats to you all. I am getting married GOD willing on March 7, 2015 at 5pm at the fabulous Azul Sensatori in Negril Jamaica and I am sooooooo excited. I paid my deposit and have my confirmation. I choose this date as it is my mother&#039;s birthday and she passed 12\/01\/2012. I felt this would be a great way to celebrate her life and keep her memory alive by choosing her birthday. She would have been so happy, so I will celebrate her on her day and soon it will also be my day (mother and daughter) Once again congrats to all of you lovely ladies&lt;\/p&gt;","Attachments":[],"Id":1787975,"PostDate":1375834656,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hello Ladies and congrats to you all. I am getting married GOD willing on March 7, 2015 at 5pm at the fabulous Azul Sensatori in Negril Jamaica and I am sooooooo excited. I paid my deposit and have my confirmation. I choose this date as it is my mother's birthday and she passed 12\/01\/2012. I felt this would be a great way to celebrate her life and keep her memory alive by choosing her birthday. She would have been so happy, so I will celebrate her on her day and soon it will also be my day (mother and daughter) Once again congrats to all of you lovely ladies<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tanisharitter@gmail.com","IpAddress":"159.53.110.143","GroupId":39,"GroupName":"Newbie","JoinDate":1373466198,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-271379.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"tritter1","Id":271379,"Name":"tritter1","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":74774,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5842feabd3de16e1b193e03a73f91801","RawContent":"&lt;p&gt; Welcome tritter1, and Congrats on your amazing wedding date choice to honor your Mom!!! sounds like she raised an equally wonderful daughter.... how special :)&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Wishing you every happiness going forward......Cheers :)&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p id=\"yui_3_10_0_1_1375912624733_839\"&gt; &lt;img alt=\"*&#10;\" data-id=\"215838\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/215838\/width\/500\/height\/1000\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p id=\"yui_3_10_0_1_1375912624733_1189\"&gt; &lt;img alt=\"*&#10;\" data-id=\"215840\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/215840\/width\/500\/height\/1000\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p id=\"yui_3_10_0_1_1375912624733_1533\"&gt; &lt;img alt=\"&#10;\" data-id=\"215841\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/215841\/width\/500\/height\/1000\" \/&gt;&lt;\/p&gt; &lt;p&gt; team MTM :)&lt;\/p&gt;","Attachments":[],"Id":1788557,"PostDate":1375909322,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Welcome tritter1, and Congrats on your amazing wedding date choice to honor your Mom!!! sounds like she raised an equally wonderful daughter.... how special <img src='https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p> <p> \u00a0<\/p> <p> Wishing you every happiness going forward......Cheers <img src='https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p> <p> \u00a0<\/p> <p id=\"yui_3_10_0_1_1375912624733_839\"> <span rel='lightbox'><img class='bbc_img' alt=\"*&#10;\" data-id=\"215838\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/215838\/width\/500\/height\/1000\" \/><\/span><\/p> <p> \u00a0<\/p> <p id=\"yui_3_10_0_1_1375912624733_1189\"> <span rel='lightbox'><img class='bbc_img' alt=\"*&#10;\" data-id=\"215840\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/215840\/width\/500\/height\/1000\" \/><\/span><\/p> <p> \u00a0<\/p> <p id=\"yui_3_10_0_1_1375912624733_1533\"> <span rel='lightbox'><img class='bbc_img' alt=\"&#10;\" data-id=\"215841\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/215841\/width\/500\/height\/1000\" \/><\/span><\/p> <p> team MTM <img src='https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i1378.photobucket.com\/albums\/ah106\/ContactIDoMexico\/MTM%20Logo%202016_zps4tzm05my.png\" alt=\"MTM%20Logo%202016_zps4tzm05my.png\"><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography , Cancun, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving the Riviera Maya<\/p>\n<p>\u00a0<\/p>\n<p>Email: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p><span style=\"color:#0000cd;\"><strong>Why we're Ranked #1<\/strong><\/span> ~ Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21512-moments-that-matter-photography\/'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a><\/p>\n<p>\u00a0<\/p>\n<p><strong><span style=\"color:#0000cd;\"><span style=\"font-family:'comic sans ms', cursive;\">We Offer<\/span><\/span><\/strong>: <strong><em><u>100% Vendor Fee Discount<\/u><br>\n\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 <u>100% Deposit Guarantee<\/u><\/em><\/strong><\/p>\n<p><strong><em>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 \u00a0 <u>100% Satisfaction Guarantee<\/u><\/em><\/strong>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280210660,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"159.253.79.42","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":74774,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e51b5e2ffdb8a6528b664ebc925e8878","RawContent":"Hi tritter1. I&#039;m so glad I found this thread. I&#039;m hoping you log in some time soon and see this. I am really hoping to get married at the Sensatori Resort Jamaica in August 2015. I really love the look of the resort but I must admit it makes me apprehensive to book before the resort is fully open and before there have been any other weddings held there. Can I ask what your experience has been so far with the WCs at the resort? Have you been able to get cost information for the reception etc? Any help, advice or info you have received from the resort that you can give me would be very much appreciated!\n\n\nThanks","Attachments":[],"Id":1827019,"PostDate":1389984082,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi tritter1. I'm so glad I found this thread. I'm hoping you log in some time soon and see this. I am really hoping to get married at the Sensatori Resort Jamaica in August 2015. I really love the look of the resort but I must admit it makes me apprehensive to book before the resort is fully open and before there have been any other weddings held there. Can I ask what your experience has been so far with the WCs at the resort? Have you been able to get cost information for the reception etc? Any help, advice or info you have received from the resort that you can give me would be very much appreciated!<br><br>\nThanks\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"clairekathompson@googlemail.com","IpAddress":"62.239.159.6","GroupId":39,"GroupName":"Newbie","JoinDate":1389958604,"Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"clairabello","Id":276154,"Name":"clairabello","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"38.114.98.51","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":74774,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e819893b6aaaf0f4963c41c65514a62e","RawContent":"&lt;p&gt;Congratulations!!! What a wonderful way to honor your grandmother.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Since AS Jamaica is part of the Karisma family, Lomas will be your wedding coordinators. While the resort will be new, Lomas is very experienced in planning and executing amazing weddings at their Mexico resorts. They pride themselves on service and making dreams come true. I have no doubt that you will be in VERY good hands with the Lomas team who will work with you to throw a dream wedding in Jamaica. Can&#039;t wait to hear about your experience!!&lt;\/p&gt;","Attachments":[],"Id":1827041,"PostDate":1389990344,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congratulations!!! What a wonderful way to honor your grandmother.<\/p>\n<p>\u00a0<\/p>\n<p>Since AS Jamaica is part of the Karisma family, Lomas will be your wedding coordinators. While the resort will be new, Lomas is very experienced in planning and executing amazing weddings at their Mexico resorts. They pride themselves on service and making dreams come true. I have no doubt that you will be in VERY good hands with the Lomas team who will work with you to throw a dream wedding in Jamaica. Can't wait to hear about your experience!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div>\u00a0<\/div>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/73076-official-el-dorado-royaleel-dorado-casitas-royale-thread\/'>Official El Dorado Royale\/El Dorado Casitas Royale Thread<\/a>\u00a0<---check here for all info about EDR\/EDCR<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'>Wright Travel Agency<\/a> <--for all your Destination Wedding needs! Contact the experts and reduce your stress.\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/5182-el-dorado-royale-edr-brides-post-here\/'>El Dorado Royale Brides Thread<\/a> <---come chat with other EDR brides<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/69372-allie-hs-edr-rm-mexico-11-5-2012-planning-thread\/'>AllieH's EDR 11-5-2012 Planning Thread<\/a> <--because it was so awesome","Email":"allisonmoore817@gmail.com","IpAddress":"75.20.174.181","GroupId":55,"GroupName":"Resort\/Area Ambassadors","JoinDate":1309657880,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-241884.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"AllieH","Id":241884,"Name":"AllieH","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.202.225.11","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":74774,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"31a022daf2e6e72fd044b894d9cc66bb","RawContent":"&lt;p&gt;Congratulations! &amp;nbsp;We are diamond level 5 with Karisma Hotels. &amp;nbsp;We sell them because they are beautiful properties and have a consistent level of great food and service.&lt;\/p&gt;","Attachments":[],"Id":1827166,"PostDate":1390067533,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congratulations! \u00a0We are diamond level 5 with Karisma Hotels. \u00a0We sell them because they are beautiful properties and have a consistent level of great food and service.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-family:arial, helvetica, sans-serif;\">Founder and Owner of BestDestinationWedding.com \u00a0\/ \u00a0<\/span><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/'><strong><span style=\"font-family:arial, helvetica, sans-serif;\">Bride & Groom Fly FREE Promotion<\/span><\/strong><\/a><\/p>\n<p>\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><a data-ipb='nomediaparse' href='https:\/\/www.wrighttravelagency.com\/go\/destination-wedding\/?source=EMLSIG'><strong><span style=\"color:#008080;\">Looking for a travel agency that specializes in Destination Weddings-CLICK HERE<\/span><\/strong><\/a><span style=\"color:#008080;\"><strong>?<\/strong> \u00a0We are an award winning travel agency and you can <\/span><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style=\"color:#008080;\">read our reviews\u00a0here.<\/span><\/a><\/strong><\/span><br>\n\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"color:#008080;\"><strong>Awards and recognition:\u00a0<\/strong><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Palace Resorts Winner \"Top Travel Agent\", \"Top Homebased Travel Agency\" PRO Platinum Agency (Top Award) \u00a0 \u00a0 | \u00a0 \u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">AMResorts Master Agent & Top Agency \u00a0<\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/68050-karisma-hotels-givc-and-gi-wedding-consultants-wright-travel-agency\/'><strong>Wright Travel & Karisma GIVC Benefits<\/strong><\/a><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Travel Impressions Best of the Best Globe Winner \u00a0 \u00a0| \u00a0 \u00a0\u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Apple Vacations Golden Apple Winner \u00a0<\/span><\/span><br><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17612\/sml_gallery_206696_17612_13451.png\" alt=\"sml_gallery_206696_17612_13451.png\"><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"> \u00a0 \u00a0<img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"font-size:14px;\"><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010'>Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><\/span><\/span><strong><span style=\"color:#b22222;\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a data-ipb='nomediaparse' href='mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com'>ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"admin@bestdestinationwedding.com","IpAddress":"71.202.225.11","GroupId":4,"GroupName":"Administrators","JoinDate":1137224220,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"FormattedName":"TammyWright","Id":206696,"Name":"TammyWright","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"159.253.79.42","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":74774,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c6697be24dace4e8b62450ae13451e8e","RawContent":"Thanks guys for replying. You have helped put me at ease. I will almost certainly book this resort. I&#039;m from the UK and my travel agent can&#039;t book for next summer til the end of April. Longest 3 months of my life!","Attachments":[],"Id":1827194,"PostDate":1390082609,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks guys for replying. You have helped put me at ease. I will almost certainly book this resort. I'm from the UK and my travel agent can't book for next summer til the end of April. Longest 3 months of my life!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"clairekathompson@googlemail.com","IpAddress":"62.239.159.6","GroupId":39,"GroupName":"Newbie","JoinDate":1389958604,"Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"clairabello","Id":276154,"Name":"clairabello","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"67.175.107.83","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":74774,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"041067f256f2da99dd4d3d9d820b0d6a","RawContent":"&lt;p&gt;Congratulations!&amp;nbsp; What a meaningful wedding date!&amp;nbsp; :)&lt;\/p&gt;","Attachments":[],"Id":1831109,"PostDate":1391291415,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congratulations!\u00a0 What a meaningful wedding date!\u00a0 <img src='https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"a.baio330@gmail.com","IpAddress":"38.104.228.158","GroupId":40,"GroupName":"Jr. Member","JoinDate":1369663457,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-269996.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"amy330","Id":269996,"Name":"amy330","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.98.202.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":74774,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5b9cabf406eaa9c1a14eb2844592b5c5","RawContent":"\n\n\nThis is a great site! So glad I found it!!\n\n\nI&#039;m torn right now. \n\n\nI&#039;m in the process of planning my wedding and have decided destination is the way we want to go. I&#039;ve done a lot of research and have narrowed it down to Azul Sensatori in Negril, which is a Karisma Resort and Rose Hall Suites Montego Bay.\n\n\nWe&#039;re in our early 30&#039;s, we love the beach, great food, and a beautiful resort. Customer service is huge to us!\n\n\nIt would also be great if there were some cool things to do outside of the resort as well for our guests and our honeymoon. Since we&#039;d be getting married at one of the above locations, ease of planning and working with their staff is super important too!\n\n\nDoes anyone have any suggestions on which they&#039;d select and why? If they&#039;ve been married at either location, attended a wedding, or been a guest at either?\n\n\nLastly, any travel agent recommendations?\n\n\nThanks for any feedback you can provide.","Attachments":[],"Id":1916937,"PostDate":1483318040,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <br><br>\nThis is a great site! So glad I found it!!<br><br>\nI'm torn right now. <br><br>\nI'm in the process of planning my wedding and have decided destination is the way we want to go. I've done a lot of research and have narrowed it down to Azul Sensatori in Negril, which is a Karisma Resort and Rose Hall Suites Montego Bay.<br><br>\nWe're in our early 30's, we love the beach, great food, and a beautiful resort. Customer service is huge to us!<br><br>\nIt would also be great if there were some cool things to do outside of the resort as well for our guests and our honeymoon. Since we'd be getting married at one of the above locations, ease of planning and working with their staff is super important too!<br><br>\nDoes anyone have any suggestions on which they'd select and why? If they've been married at either location, attended a wedding, or been a guest at either?<br><br>\nLastly, any travel agent recommendations?<br><br>\nThanks for any feedback you can provide.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"danyella_davis@yahoo.com","IpAddress":"174.218.1.184","GroupId":39,"GroupName":"Newbie","JoinDate":1483242862,"Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Danyella","Id":288219,"Name":"Danyella","IsOnline":false}}],"Id":"74774","Title":"Jamaica 2015 Bride (Azul Sensatori)","LastPostDate":1483318040},"Pages":{"TotalItems":8,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
