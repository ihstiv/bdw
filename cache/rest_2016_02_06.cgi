some advice here, or even just hearing of others who are in the same\/similar si...","Author":{"Signature":"","Email":"millar_devon@hotmail.com","IpAddress":"154.20.36.21","GroupId":39,"GroupName":"Newbie","JoinDate":1423329313,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282027.jpg?_r=1429713632","PhotoWidth":169,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Victoriabride","Id":282027,"Name":"Victoriabride","IsOnline":false}},"Posts":[],"Id":"78943","Title":"Is It Inappropriate To Ask Parents For Help With Wedding Expenses?","LastPostDate":1427063070},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":8,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":605,"MovedTo":null,"MovedOn":0,"FirstPostId":1890229,"Rating":0,"RatingHits":0,"Starter":{"Id":278661,"Name":"jeffandrobyn","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278661.jpg?_r=1404161707","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"IsOnline":false},"StartDate":1426894076,"LastPoster":{"Id":281055,"Name":"snswedding2016","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":60,"Preview":{"Id":1890229,"PostDate":1426894076,"PostContent":"Unfortunately my MOH\/best friend can no longer come to my wedding because of money. I was heartbr...","Author":{"Signature":"","Email":"robynbrooke81@gmail.com","IpAddress":"75.99.18.219","GroupId":40,"GroupName":"Jr. Member","JoinDate":1403547389,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278661.jpg