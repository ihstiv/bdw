e":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"9aa6526587f1250261c51102980be3fa","RawContent":"&lt;p&gt;Hello Everyone,&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;My name is amanda I am 28 years old recently engaged to the man of my dreams. He asked me to marry him in Istanbul, Turkey on September 9th. We decided on a destination wedding after attending his cousins in 2012. We really had a great time and I like the no fuss kind of idea. I stumbled upon this website and I haven&#039;t been able to get off. Looking forward to reading all of your posts and getting to know you girls.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thanks for reading and I&#039;m sure I&#039;ll see you around,&lt;\/p&gt;\n&lt;p&gt;Amanda&lt;\/p&gt;","Attachments":[],"Id":1872971,"PostDate":1411569729,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello Everyone,<\/p>\n<p>\u00a0<\/p>\n<p>My name is amanda I am 28 years old recently engaged to the man of my dreams. He asked me to marry him in Istanbul, Turkey on September 9th. We decided on a destination wedding after attending his cousins in 2012. We really had a great time and I like the no fuss kind of idea. I stumbled upon this website and I haven't been able to get off. Looking forward to reading all of your posts and getting to know you girls.<\/p>\n<p>\u00a0<\/p>\n<p>Thanks for reading and I'm sure I'll see you around,<\/p>\n<p>Amanda<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p style=\"text-align:center;\"><img src=\"http:\/\/www.tickerclub.com\/tickers\/wedding\/preview\/idTicker\/206838\/rulerId\/\/sliderId\/\/\" alt=\"sliderId\"><\/p>\n<p style=\"text-align:center;\">\u00a0","Email":"amanda@roamcanada.com","IpAddress":"41.218.252.222","GroupId":39,"GroupName":"Newbie","JoinDate":1411408087,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279936.jpg?_r=1414239845","PhotoWidth":200,"PhotoHeight":246,"PhotoType":"custom"},"FormattedName":"amanda2016","Id":279936,"Name":"amanda2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"161.185.150.180","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78081,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"d1efbc7081904ba1e4b9875d8b92ac94","RawContent":"&lt;p&gt;@[member=\"amandankeith\"] Congrats on your engagement. This site is awesome!!! Happy Planning.&lt;\/p&gt;","Attachments":[],"Id":1872975,"PostDate":1411569945,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@amandankeith Congrats on your engagement. This site is awesome!!! Happy Planning.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p style=\"text-align:center;\">\u00a0 \u00a0 \u00a0 \u00a0 \u00a0 Future Mrs. Bonitto 10\/14\/16<\/p>\n<div><br><div>\u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0<a  class=\"bbc_url\" href=\"http:\/\/www.theknot.com\/?utm_source=ticker&utm_medium=UBB&utm_campaign=tickers\"><img src=\"http:\/\/global.theknot.com\/tickers\/tt1c2490.aspx\" alt=\"tt1c2490.aspx\"><\/a><\/div>\n<div>\u00a0\u00a0<\/div>\n<\/div>\n<p>\u00a0","Email":"shamicaglover@yahoo.com","IpAddress":"161.185.157.23","GroupId":40,"GroupName":"Jr. Member","JoinDate":1394133176,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277031.jpg?_r=1397251056","PhotoWidth":200,"PhotoHeight":203,"PhotoType":"custom"},"FormattedName":"MrandMrsBonitto2016","Id":277031,"Name":"MrandMrsBonitto2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"184.69.200.21","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78081,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"d07381ca7988f9aedca2d19d176f5385","RawContent":"&lt;p&gt;Congrats and welcome! &amp;nbsp;This board has been a life saver for me. &amp;nbsp; Without it, my wedding might be rather boring LOL!&lt;\/p&gt;","Attachments":[],"Id":1872983,"PostDate":1411571695,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats and welcome! \u00a0This board has been a life saver for me. \u00a0 Without it, my wedding might be rather boring LOL!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399428602,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"96.227.239.208","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78081,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"21893a6c82bea64286485ece2e883fb1","RawContent":"&lt;p&gt;Congrats Amanda!!&lt;\/p&gt;","Attachments":[],"Id"