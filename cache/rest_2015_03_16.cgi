{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":8,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":true,"Views":257,"MovedTo":null,"MovedOn":0,"FirstPostId":1887891,"Rating":0,"RatingHits":0,"Starter":{"Id":275259,"Name":"Megg","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275259.jpg?_r=1421618186","PhotoWidth":200,"PhotoHeight":113,"PhotoType":"custom"},"IsOnline":false},"StartDate":1425219260,"LastPoster":{"Id":282430,"Name":"IzzyDeee","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282430.jpg?_r=1426462827","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":23,"Preview":{"Id":1887891,"PostDate":1425219260,"PostContent":"Hey everyone! \u00a0 Our wedding is two months away. I have searched past posts, but a lot of them, wi...","Author":{"Signature":"","Email":"Meggan.Kole@gmail.com","IpAddress":"68.82.4.242","GroupId":39,"GroupName":"Newbie","JoinDate":1385134977,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275259.jpg?_r=1421618186","PhotoWidth":200,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"Megg","Id":275259,"Name":"Megg","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.82.4.242","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78865,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e5af9c63779ecae15983e53904da91c5","RawContent":"&lt;p&gt;Hey everyone!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Our wedding is two months away. I have searched past posts, but a lot of them, with the most information, are from a few years ago. The W.C has been helpful so far, but I am still unclear on set up and what is included. Does the wedding package include any decorations? I know some brides bring their own. I can&#039;t see myself lugging around candles, flowers, table linen etc. I&#039;m not very picky but I am just trying to get an idea of what it will look like or what I will need to bring. It is also hard to find pictures.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;thanks in advance!&lt;\/p&gt;","Attachments":[],"Id":1887891,"PostDate":1425219260,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hey everyone!<\/p>\n<p>\u00a0<\/p>\n<p>Our wedding is two months away. I have searched past posts, but a lot of them, with the most information, are from a few years ago. The W.C has been helpful so far, but I am still unclear on set up and what is included. Does the wedding package include any decorations? I know some brides bring their own. I can't see myself lugging around candles, flowers, table linen etc. I'm not very picky but I am just trying to get an idea of what it will look like or what I will need to bring. It is also hard to find pictures.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>thanks in advance!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Meggan.Kole@gmail.com","IpAddress":"68.82.4.242","GroupId":39,"GroupName":"Newbie","JoinDate":1385134977,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275259.jpg?_r=1421618186","PhotoWidth":200,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"Megg","Id":275259,"Name":"Megg","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.252.183.8","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78865,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"694619d3f15732b151d13a51d6d318c2","RawContent":"&lt;p&gt;Hi @[member=\"Megg\"]. I have a friend that got married there last year. I get some info for you. In the mean time have you booked your wedding photographer, hair and makeup stylists already?&lt;\/p&gt;","Attachments":[],"Id":1887999,"PostDate":1425301054,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi @<a hovercard-ref=\"member\" hovercard-id=\"275259\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/275259-megg\/' title='Member profile'><span itemprop=\"name\">Megg<\/span><\/a>. I have a friend that got married there last year. I get some info for you. In the mean time have you booked your wedding photographer, hair and makeup stylists already?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sashi2hot@gmail.com","IpAddress":"72.252.183.8","GroupId":39,"GroupName":"Newbie","JoinDate":1425298509,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"BrookM","Id":282293,"Name":"BrookM","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.42.51","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78865,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f13ef18fa74a5249ca4c8e928d5047b6","RawContent":"&lt;p&gt;If you still have questions I would still strongly recommend going back to your wedding coordinator. They&#039;re the best ones to answer your questions. I don&#039;t know about the forums here for your resort. They&#039;re usually really great for helping out with information but if you&#039;re still in doubt, your coordinator is the best person to help.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I was married in Jamaica but at a different resort so I&#039;m afraid I can&#039;t offer any info.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck!&lt;\/p&gt;","Attachments":[],"Id":1888015,"PostDate":1425303232,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>If you still have questions I would still strongly recommend going back to your wedding coordinator. They're the best ones to answer your questions. I don't know about the forums here for your resort. They're usually really great for helping out with information but if you're still in doubt, your coordinator is the best person to help.<\/p>\n<p>\u00a0<\/p>\n<p>I was married in Jamaica but at a different resort so I'm afraid I can't offer any info.<\/p>\n<p>\u00a0<\/p>\n<p>Good luck!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283440999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1426134867","PhotoWidth":668,"PhotoHeight":600,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.82.4.242","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78865,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9d90e9a9b28fcabd4f68cf0adda5a63b","RawContent":"@[member=\"acw271011\"] thanks for your reply! It&#039;s hard to get a lot of detailed information from the resort wc, which I understand because they deal with three weddings a day and I am sure they are swamped.  I&#039;m just getting down to the wire and and getting nervous about everything lol","Attachments":[],"Id":1888041,"PostDate":1425316172,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"232000\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/232000-acw271011\/' title='Member profile'><span itemprop=\"name\">acw271011<\/span><\/a> thanks for your reply! It's hard to get a lot of detailed information from the resort wc, which I understand because they deal with three weddings a day and I am sure they are swamped.  I'm just getting down to the wire and and getting nervous about everything lol\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Meggan.Kole@gmail.com","IpAddress":"68.82.4.242","GroupId":39,"GroupName":"Newbie","JoinDate":1385134977,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275259.jpg?_r=1421618186","PhotoWidth":200,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"Megg","Id":275259,"Name":"Megg","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.43.64","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78865,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"b52b6e915d128f2f51b71e5d58b7f0b4","RawContent":"&lt;p&gt;Have you thought about a phone call? I went and bought one of those phone cards, just ten bucks and phoned down to the resort. It was easiest to get my questions answered. All of our plans fell apart and it ended up being just hubby and me so I needed to get some answers pretty quick. You&#039;re close enough now that your wedding should be close to being on the higher up list. Usually it&#039;s about 3 months out when they sort of bump you up higher so you should be getting better responses by now. You can always try to go over the WCs head if you don&#039;t think you&#039;re getting the responses that you should. You would also be surprise at how much gets worked out at your meeting once you arrive at the resort. It may not seem like it but all of your little details are all worked out and you walk away feeling happy!&lt;\/p&gt;","Attachments":[],"Id":1888048,"PostDate":1425320448,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Have you thought about a phone call? I went and bought one of those phone cards, just ten bucks and phoned down to the resort. It was easiest to get my questions answered. All of our plans fell apart and it ended up being just hubby and me so I needed to get some answers pretty quick. You're close enough now that your wedding should be close to being on the higher up list. Usually it's about 3 months out when they sort of bump you up higher so you should be getting better responses by now. You can always try to go over the WCs head if you don't think you're getting the responses that you should. You would also be surprise at how much gets worked out at your meeting once you arrive at the resort. It may not seem like it but all of your little details are all worked out and you walk away feeling happy!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283440999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1426134867","PhotoWidth":668,"PhotoHeight":600,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"23.228.159.228","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78865,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"00cfbb3b87cd2fa53bac8db12ea61686","RawContent":"My wedding is there in a month from tomorrow! I feel like I don&#039;t have much planned... Looking for hair stylists and make up artist is my next to do. Has anyone used the salon on the resort?","Attachments":[],"Id":1888264,"PostDate":1425429577,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                My wedding is there in a month from tomorrow! I feel like I don't have much planned... Looking for hair stylists and make up artist is my next to do. Has anyone used the salon on the resort? \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"np_2003@hotmail.com","IpAddress":"66.87.74.175","GroupId":39,"GroupName":"Newbie","JoinDate":1391204466,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276426.jpg?_r=1425447500","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"NikkiMarie05","Id":276426,"Name":"NikkiMarie05","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"166.137.240.29","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78865,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"930c16a554bac61635bf3b6d4ef2c42a","RawContent":"@[member=\"acw271011\"] that&#039;s not a bad idea. I didn&#039;t think about calling! @[member=\"NikkiMarie05\"] I was wondering the same thing about the salon. I&#039;m going to use them regardless. I really don&#039;t feel like finding an outside person. I&#039;m going to email them and see if they have pictures. I did get an email address for someone who sets up the appointments. \n@[member=\"BrookM\"] I did book my photographer a while back and I&#039;m going to use the resort salon. Thanks. What ever you have would be great","Attachments":[],"Id":1888298,"PostDate":1425468579,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"232000\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/232000-acw271011\/' title='Member profile'><span itemprop=\"name\">acw271011<\/span><\/a> that's not a bad idea. I didn't think about calling! @<a hovercard-ref=\"member\" hovercard-id=\"276426\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/276426-nikkimarie05\/' title='Member profile'><span itemprop=\"name\">NikkiMarie05<\/span><\/a> I was wondering the same thing about the salon. I'm going to use them regardless. I really don't feel like finding an outside person. I'm going to email them and see if they have pictures. I did get an email address for someone who sets up the appointments. <br \/>@<a hovercard-ref=\"member\" hovercard-id=\"282293\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282293-brookm\/' title='Member profile'><span itemprop=\"name\">BrookM<\/span><\/a> I did book my photographer a while back and I'm going to use the resort salon. Thanks. What ever you have would be great\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Meggan.Kole@gmail.com","IpAddress":"68.82.4.242","GroupId":39,"GroupName":"Newbie","JoinDate":1385134977,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275259.jpg?_r=1421618186","PhotoWidth":200,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"Megg","Id":275259,"Name":"Megg","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.236.130.168","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78865,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"53546d70f9a74d03dd5adf29a45edb0e","RawContent":"I&#039;m in the same boat! My wedding date is May 6th! So it&#039;s coming up really quick!!! \ud83d\ude01\ud83d\ude01\ud83d\ude01\n\n\nThe WC Nekeisha hardly answers half the questions I ask, which is frustrating but understandable since they are probably swamped! I have already booked my hair appointment as well as my bridesmaids, but I&#039;m curious if anyone has had any issues with their salon? Or if they were able to do what you requested to be done! I will share a picture of what I would like it to look like (let me know if you think it is possible \ud83d\ude1d) \n\n\nWhat should I do for decor? \n\nWe are getting married at the plaza gazebo, what type of decorations would people suggest? Our wedding color is an eggplant purple (have pics of bridesmaids and groomsmen outfits; take a peak \ud83d\ude1c) will this be an issue? My wedding dress is ivory with gold embroidery I&#039;ll post a pic \u263a\ufe0f","Attachments":[{"Id":30923,"Name":"image.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_03_2015\/post-282430-0-56359600-1426470762.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_03_2015\/post-282430-0-56359600-1426470762_thumb.jpg","Width":675,"Height":1200},{"Id":30924,"Name":"image.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_03_2015\/post-282430-0-21656500-1426470850.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_03_2015\/post-282430-0-21656500-1426470850_thumb.jpg","Width":640,"Height":960}],"Id":1889352,"PostDate":1426452854,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm in the same boat! My wedding date is May 6th! So it's coming up really quick!!! \ud83d\ude01\ud83d\ude01\ud83d\ude01<br><br>\nThe WC Nekeisha hardly answers half the questions I ask, which is frustrating but understandable since they are probably swamped! I have already booked my hair appointment as well as my bridesmaids, but I'm curious if anyone has had any issues with their salon? Or if they were able to do what you requested to be done! I will share a picture of what I would like it to look like (let me know if you think it is possible \ud83d\ude1d) <br><br>\nWhat should I do for decor? <br>\nWe are getting married at the plaza gazebo, what type of decorations would people suggest? Our wedding color is an eggplant purple (have pics of bridesmaids and groomsmen outfits; take a peak \ud83d\ude1c) will this be an issue? My wedding dress is ivory with gold embroidery I'll post a pic \u263a\ufe0f\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"izabella.david@gmail.com","IpAddress":"99.237.26.51","GroupId":39,"GroupName":"Newbie","JoinDate":1426444378,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282430.jpg?_r=1426462827","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"IzzyDeee","Id":282430,"Name":"IzzyDeee","IsOnline":false}}],"Id":"78865","Title":"Riu Montego Bay! Looking For Advice, Past Brides,...any Info :-)","LastPostDate":1426452854},"Pages":{"TotalItems":8,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
