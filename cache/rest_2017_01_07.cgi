Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":53,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":8832,"MovedTo":null,"MovedOn":0,"FirstPostId":1901269,"Rating":0,"RatingHits":0,"Starter":{"Id":284112,"Name":"CaboBride6252016","Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-284112.jpg?_r=1437784941","PhotoWidth":200,"PhotoHeight":258,"PhotoType":"custom"},"IsOnline":false},"StartDate":1437998941,"LastPoster":{"Id":288086,"Name":"jbo337","Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":38,"Preview":{"Id":1914716,"PostDate":1467801098,"PostContent":"Hi everyone! I am new to this forum and I'm  looking at RIU Palace for our wedding in July 2017....","Author":{"Signature":"","Email":"vasquez.gr@gmail.com","IpAddress":"66.87.65.12","GroupId":39,"GroupName":"Newbie","JoinDate":1467800133,"Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Grizzme","Id":287303,"Name":"Grizzme","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"69.42.28.44","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79438,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ddb3c67024446ab2252ba122c2cf1974","RawContent":"&lt;p&gt;@MrsMakasa&amp;nbsp; Hi there!&amp;nbsp; We recently had our wedding and everything was AMAZING!&amp;nbsp; We had our ceremony at the San Jose Gazebo and it was very private.&amp;nbsp; We didn&#039;t find anyone wandering around except the staff who set-up the chairs\/decor.&amp;nbsp; There is another gazebo closer to the Riu Santa Fe pool area.&amp;nbsp; I was told by the WC that they don&#039;t recommend it because of the noise but stated is was an option.&amp;nbsp; I did see one guest watching from their balcony.&amp;nbsp; We had family members who spotted a wedding going on at the beach site.&amp;nbsp; Guests were just watching from the infinity pool and balcony but I don&#039;t think they were walking around the ceremony.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We had our reception at Baja Norte and they did end the music promptly at 11:00 PM (all outdoor music ends at this time), but you have the option of moving the party to Club Pacha or going up to the lobby bar (we did this).&amp;nbsp; 4 hours for the reception was plenty of time.&amp;nbsp; We had our first dance right after our entrance.&amp;nbsp; I believe our father-daughter and mother-son dances followed because we were still waiting for the dinner service to start.&amp;nbsp; This also worked out perfectly because the sun was starting to set.&amp;nbsp; To fill up dead time, we also had speeches in between courses.&amp;nbsp; Then the cake followed and we had the rest of the night for dancing and drinking.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Let me know if you have any other questions.&amp;nbsp; I&#039;m hoping I will be able to write a complete review and post pictures. &amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;@[member=\"Grizzme\"] I sent you an email&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1914721,"PostDate":1467811089,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@MrsMakasa\u00a0 Hi there!\u00a0 We recently had our wedding and everything was AMAZING!\u00a0 We had our ceremony at the San Jose Gazebo and it was very private.\u00a0 We didn't find anyone wandering around except the staff who set-up the chairs\/decor.\u00a0 There is another gazebo closer to the Riu Santa Fe pool area.\u00a0 I was told by the WC that they don't recommend it because of the noise but stated is was an option.\u00a0 I did see one guest watching from their balcony.\u00a0 We had family members who spotted a wedding going on at the beach site.\u00a0 Guests were just watching from the infinity pool and balcony but I don't think they were walking around the ceremony.<\/p>\n<p>\u00a0<\/p>\n<p>We had our reception at Baja Norte and they did end the music promptly at 11:00 PM (all outdoor music ends at this time), but you have the option of moving the party to Club Pacha or going up to the lobby bar (we did this).\u00a0 4 hours for the reception was plenty of time.\u00a0 We had our first dance right after our entrance.\u00a0 I believe our father-daughter and mother-son dances followed because we were still waiting for the dinner service to start.\u00a0 This also worked out perfectly because the sun was starting to set.\u00a0 To fill up dead time, we also had speeches in between courses.\u00a0 Then the cake followed and we had the rest of the night for dancing and drinking.<\/p>\n<p>\u00a0<\/p>\n<p>Let me know if you have any other questions.\u00a0 I'm hoping I will be able to write a complete review and post pictures. \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"287303\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='https:\/\/www.bestdestinationwedding.com\/user\/287303-grizzme\/' title='Member profile'><span itemprop=\"name\">Grizzme<\/span><\/a> I sent you an email\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jrcorrales@gmail.com","IpAddress":"69.42.28.220","GroupId":39,"GroupName":"Newbie","JoinDate":1413927246,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-280778.jpg?_r=1421562169","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"AmorDeMiVida","Id":280778,"Name":"AmorDeMiVida","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.87.234.202","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79438,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c45b774ad66983b0fd5f9e84563d17b4","RawContent":"&lt;p&gt;Hey Brides,&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am back from Cabo and I must say...I had the wedding of my dreams. Riu Palace was gorgeous and all my guests were in love with the resort. My wedding was perfect!&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I wanted to share a few pics with you guys!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;My photographer was Gilda Badillo! She was the sweetest, most professional, most amazing photographer! Highly recommended!!!&lt;\/p&gt;","Attachments":[{"Id":36197,"Name":"-cabo-wedding113 - Copy.jpg","Url":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/monthly_07_2016\/post-284112-0-78204900-1467897595.jpg","ScaledUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/monthly_07_2016\/post-284112-0-78204900-1467897595_thumb.jpg","Width":458,"Height":687},{"Id":36198,"Name":"-cabo-wedding123 - Copy.jpg","Url":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/monthly_07_2016\/post-284112-0-73249300-1467897596.jpg","ScaledUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/monthly_07_2016\/post-284112-0-73249300-1467897596_thumb.jpg","Width":1000,"Height":667},{"Id":36199,"Name":"-cabo-wedding124 - Copy.jpg","Url":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/monthly_07_2016\/post-284112-0-76544600-1467897597.jpg","ScaledUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/monthly_07_2016\/post-284112-0-76544600-1467897597_thumb.jpg","Width":1000,"Height":436},{"Id":36200,"Name":"-cabo-wedding129.jpg","Url":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/monthly_07_2016\/post-284112-0-97292000-1467897598.jpg","ScaledUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/monthly_07_2016\/post-284112-0-97292000-1467897598_thumb.jpg","Width":1000,"Height":461},{"Id":36201,"Name":"-cabo-wedding131 - Copy.jpg","Url":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/monthly_07_2016\/post-284112-0-12973600-1467897600.jpg","ScaledUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/monthly_07_2016\/post-284112-0-12973600-1467897600_thumb.jpg","Width":1000,"Height":641},{"Id":36202,"Name":"-cabo-wedding137 - Copy.jpg","Url":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/monthly_07_2016\/post-284112-0-15237800-1467897601.jpg","ScaledUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/monthly_07_2016\/post-284112-0-15237800-1467897601_thumb.jpg","Width":1000,"Height":671},{"Id":36203,"Name":"-cabo-wedding138.jpg","Url":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/monthly_07_2016\/post-284112-0-15817200-1467897602.jpg","ScaledUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/monthly_07_2016\/post-284112-0-15817200-1467897602_thumb.jpg","Width":1000,"Height":614},{"Id":36204,"Name":"-cabo-wedding139.jpg","Url":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/monthly_07_2016\/post-284112-0-16660600-1467897603.jpg","ScaledUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/monthly_07_2016\/post-284112-0-16660600-1467897603_thumb.jpg","Width":1000,"Height":667},{"Id":36205,"Name":"-cabo-wedding146.jpg","Url":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/monthly_07_2016\/post-284112-0-20919100-1467897604.jpg","ScaledUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/monthly_07_2016\/post-284112-0-20919100-1467897604_thumb.jpg","Width":803,"Height":687},{"Id":36206,"Name":"-cabo-wedding153.jpg","Url":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/monthly_07_2016\/post-284112-0-20340900-1467897605.jpg","ScaledUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/monthly_07_2016\/post-284112-0-20340900-1467897605_thumb.jpg","Width":1000,"Height":667}],"Id":1914732,"PostDate":1467868921,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hey Brides,<\/p>\n<p>\u00a0<\/p>\n<p>I am back from Cabo and I must say...I had the wedding of my dreams. Riu Palace was gorgeous and all my guests were in love with the resort. My wedding was perfect!\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I wanted to share a few pics with you guys!<\/p>\n<p>\u00a0<\/p>\n<p>My photographer was Gilda Badillo! She was the sweetest, most professional, most amazing photographer! Highly recommended!!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ana.avant87@gmail.com","IpAddress":"72.35.67.10","GroupId":39,"GroupName":"Newbie","JoinDate":1437709337,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-284112.jpg?_r=1437784941","PhotoWidth":200,"PhotoHeight":258,"PhotoType":"custom"},"FormattedName":"CaboBride6252016","Id":284112,"Name":"CaboBride6252016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.136.25.153","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79438,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7feaf5f2dc22769d376ff7f9cc957e8a","RawContent":"&lt;p&gt;Hi all! &amp;nbsp;Getting married June 16th and was wondering if any of you can send me info on the locations\/checklists with pricing!!! thanks in advance! jbolognani@[member=\"gmail\"].com&lt;\/p&gt;","Attachments":[],"Id":1916803,"PostDate":1480261745,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi all! \u00a0Getting married June 16th and was wondering if any of you can send me info on the locations\/checklists with pricing!!! thanks in advance! jbolognani@<a hovercard-ref=\"member\" hovercard-id=\"219734\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='https:\/\/www.bestdestinationwedding.com\/user\/219734-gmail\/' title='Member profile'><span itemprop=\"name\">gmail<\/span><\/a>.com<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jbolognani@gmail.com","IpAddress":"24.136.25.153","GroupId":39,"GroupName":"Newbie","JoinDate":1480261520,"Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"jbo337","Id":288086,"Name":"jbo337","IsOnline":false}}],"Id":"79438","Title":"2016 Riu Palace Cabo Bride!","LastPostDate":1480261745},"Pages":{"TotalItems":53,"TotalPages":6,"CurrentPage":50,"NextPage":-1,"PreviousPage":40,"LastPage":50},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
