{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":2,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":1164,"MovedTo":null,"MovedOn":0,"FirstPostId":1912776,"Rating":0,"RatingHits":0,"Starter":{"Id":286696,"Name":"Rissarroyo","Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1460324740,"LastPoster":{"Id":268688,"Name":"ktan7","Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-268688.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":38,"Preview":{"Id":1912776,"PostDate":1460324740,"PostContent":"Hi everyone! I'm new here but have read many many posts about Cabo weddings! I'm currently planni...","Author":{"Signature":"","Email":"marissaarroyo@rocketmail.com","IpAddress":"107.77.109.15","GroupId":39,"GroupName":"Newbie","JoinDate":1460324011,"Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Rissarroyo","Id":286696,"Name":"Rissarroyo","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"107.77.109.15","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80033,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c875abb281dfcf18f953f44307e26131","RawContent":"Hi everyone! I&#039;m new here but have read many many posts about Cabo weddings! I&#039;m currently planning a wedding for Cabo Del Sol with Yarai from Memories! I wanted to find out experiences from other about rehearsal dinners and after wedding day breakfast etc. My fianc\u00e9 and I originally did not think about this aspect of the wedding but now that we are we don&#039;t know what a good option is for either! I would really appreciate any feedback and if you&#039;re a Cabo Del Sol bride any advice you have on keeping the costs lower would be appreciated! Thanks ladies :)","Attachments":[],"Id":1912776,"PostDate":1460324740,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi everyone! I'm new here but have read many many posts about Cabo weddings! I'm currently planning a wedding for Cabo Del Sol with Yarai from Memories! I wanted to find out experiences from other about rehearsal dinners and after wedding day breakfast etc. My fianc\u00e9 and I originally did not think about this aspect of the wedding but now that we are we don't know what a good option is for either! I would really appreciate any feedback and if you're a Cabo Del Sol bride any advice you have on keeping the costs lower would be appreciated! Thanks ladies <img src='https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"marissaarroyo@rocketmail.com","IpAddress":"107.77.109.15","GroupId":39,"GroupName":"Newbie","JoinDate":1460324011,"Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Rissarroyo","Id":286696,"Name":"Rissarroyo","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.84.216.185","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80033,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3ba77a3deb09fa5baef42dae5b5769df","RawContent":"&lt;div&gt;Hey there,&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;I&#039;m a destination wedding photographer based out of Vancouver. I was just browsing the site and somehow bumped into your post. Thought I would reach out to you and see if you are searching for a wedding photographer.&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;I&#039;m actually part of the preferred photographers from Wedluxe Magazine (&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/wedluxe.com\/service\/vendor-locations&#039;&gt;http:\/\/wedluxe.com\/service\/vendor-locations&lt;\/a&gt;). These are amongst the best wedding photographers in Canada. My work has also been published in Style Me Pretty and Destination I Do Magazine. &amp;nbsp;If you are interested in my work, I&#039;ll be more than happy to customize a package for you.&amp;nbsp; &lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;My email is info@kentanphoto.com (www.kentanphoto.com is my website).&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;Good luck on your wedding planning again :)&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;-Ken&amp;nbsp;&lt;\/div&gt;","Attachments":[],"Id":1915880,"PostDate":1475754091,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div>Hey there,\u00a0<\/div>\n<div>\u00a0<\/div>\n<div>I'm a destination wedding photographer based out of Vancouver. I was just browsing the site and somehow bumped into your post. Thought I would reach out to you and see if you are searching for a wedding photographer.\u00a0<\/div>\n<div>\u00a0<\/div>\n<div>I'm actually part of the preferred photographers from Wedluxe Magazine (<a href='http:\/\/wedluxe.com\/service\/vendor-locations' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/wedluxe.com\/s...endor-locations<\/a>). These are amongst the best wedding photographers in Canada. My work has also been published in Style Me Pretty and Destination I Do Magazine. \u00a0If you are interested in my work, I'll be more than happy to customize a package for you.\u00a0 <\/div>\n<div>\u00a0<\/div>\n<div>My email is info@kentanphoto.com (www.kentanphoto.com is my website).\u00a0<\/div>\n<div>\u00a0<\/div>\n<div>Good luck on your wedding planning again <img src='https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/div>\n<div>\u00a0<\/div>\n<div>-Ken\u00a0<\/div>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kennycmtan@hotmail.com","IpAddress":"24.84.216.185","GroupId":39,"GroupName":"Newbie","JoinDate":1366215414,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-268688.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"ktan7","Id":268688,"Name":"ktan7","IsOnline":false}}],"Id":"80033","Title":"January 2017 Wedding!","LastPostDate":1475754091},"Pages":{"TotalItems":2,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
