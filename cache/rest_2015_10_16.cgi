{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":3,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":795,"MovedTo":null,"MovedOn":0,"FirstPostId":1850240,"Rating":0,"RatingHits":0,"Starter":{"Id":262375,"Name":"1fungrl","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-262375.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":279,"PhotoType":"custom"},"IsOnline":false},"StartDate":1400060289,"LastPoster":{"Id":206696,"Name":"TammyWright","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":124,"Preview":{"Id":1850240,"PostDate":1400060289,"PostContent":"SOME SECRETS ARE WORTH SHARING! \u00a0 \u00a0 Receive One Complimentary Room\u00a0for Every 5 Paid (6th room fre...","Author":{"Signature":"","Email":"bobbified@yahoo.com","IpAddress":"71.189.75.149","GroupId":56,"GroupName":"Community Manager","JoinDate":1352934615,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-262375.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":279,"PhotoType":"custom"},"FormattedName":"1fungrl","Id":262375,"Name":"1fungrl","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.189.75.149","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77059,"EditedBy":"","EditDate":1400281185,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4974b5b4711a28747e73dd72044dde88","RawContent":"&lt;p style=\"color:rgb(51,51,51);font-family:Georgia, &#039;Times New Roman&#039;, &#039;Bitstream Charter&#039;, Times, serif;font-size:13px;\"&gt;&lt;strong&gt;SOME SECRETS ARE WORTH SHARING! &amp;nbsp;&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p style=\"color:rgb(51,51,51);font-family:Georgia, &#039;Times New Roman&#039;, &#039;Bitstream Charter&#039;, Times, serif;font-size:13px;\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"color:rgb(51,51,51);font-family:Georgia, &#039;Times New Roman&#039;, &#039;Bitstream Charter&#039;, Times, serif;font-size:13px;\"&gt;&lt;strong&gt;Receive One Complimentary Room&amp;nbsp;for Every 5 Paid (6th room free) at Secrets Resort and Spa!&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p style=\"color:rgb(51,51,51);font-family:Georgia, &#039;Times New Roman&#039;, &#039;Bitstream Charter&#039;, Times, serif;font-size:13px;\"&gt;&lt;strong&gt;(Maximum of 3 rooms)&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p style=\"color:rgb(51,51,51);font-family:Georgia, &#039;Times New Roman&#039;, &#039;Bitstream Charter&#039;, Times, serif;font-size:13px;\"&gt;&lt;strong&gt;Booking and Travel Window: 1\/2\/14 \u2013 12\/22\/14&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p style=\"color:rgb(51,51,51);font-family:Georgia, &#039;Times New Roman&#039;, &#039;Bitstream Charter&#039;, Times, serif;font-size:13px;\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"color:rgb(51,51,51);font-family:Georgia, &#039;Times New Roman&#039;, &#039;Bitstream Charter&#039;, Times, serif;font-size:13px;\"&gt;PLUS receive these great added values!&lt;\/p&gt;\n&lt;ul&gt;&lt;li&gt;Private Check-in&lt;\/li&gt;\n&lt;li&gt;Welcome beverage&lt;\/li&gt;\n&lt;li&gt;One Complimentary VIP Room Upgrade&amp;nbsp;for Every 10 Rooms Paid (maximum two upgrades per stay&lt;\/li&gt;\n&lt;li&gt;$200 in Resort Coupons Per Room, Per Stay&lt;\/li&gt;\n&lt;\/ul&gt;&lt;p style=\"color:rgb(51,51,51);font-family:Georgia, &#039;Times New Roman&#039;, &#039;Bitstream Charter&#039;, Times, serif;font-size:13px;\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"color:rgb(51,51,51);font-family:Georgia, &#039;Times New Roman&#039;, &#039;Bitstream Charter&#039;, Times, serif;font-size:13px;\"&gt;&lt;strong&gt;BOOK NOW WITH WRIGHT TRAVEL AGENCY&amp;nbsp;&lt;\/strong&gt;\n&lt;strong&gt;Call:&amp;nbsp;888-471-1950   &lt;\/strong&gt;&lt;\/p&gt;\n&lt;p style=\"color:rgb(51,51,51);font-family:Georgia, &#039;Times New Roman&#039;, &#039;Bitstream Charter&#039;, Times, serif;font-size:13px;\"&gt;&lt;img height=\"29\" src=\"http:\/\/www.wrighttravelagency.com\/wp-content\/uploads\/2012\/10\/contact-us1.jpg\" width=\"102\" alt=\"contact-us1.jpg\"&gt;&lt;\/p&gt;\n&lt;p style=\"color:rgb(51,51,51);font-family:Georgia, &#039;Times New Roman&#039;, &#039;Bitstream Charter&#039;, Times, serif;font-size:13px;\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"color:rgb(51,51,51);font-family:Georgia, &#039;Times New Roman&#039;, &#039;Bitstream Charter&#039;, Times, serif;font-size:13px;\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"color:rgb(51,51,51);font-family:Georgia, &#039;Times New Roman&#039;, &#039;Bitstream Charter&#039;, Times, serif;font-size:13px;\"&gt;&lt;strong&gt;MORE ABOUT WRIGHT TRAVEL AGENCY&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p style=\"color:rgb(51,51,51);font-family:Georgia, &#039;Times New Roman&#039;, &#039;Bitstream Charter&#039;, Times, serif;font-size:13px;\"&gt;Wright Travel Agency is a boutique travel agency that specializes in Honeymoons and Destination Weddings and is the Official Travel Agency for&amp;nbsp;BestDestinationWedding.com! &amp;nbsp;Check out the link for promotions and offers exclusive to Wright Travel&amp;nbsp;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.wrighttravelagency.com\/WWW.WRIGHTTRAVELAGENCY.COM&#039;&gt;HERE&lt;\/a&gt;. &amp;nbsp;For more information about Wright Travel Agency, call 1-866-498-4951 \/ 415-839-7511, email us at info@wrighttravelagency.com, or visit us on the social media space:&amp;nbsp;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.wrighttravelagency.com\/WWW.FACEBOOK.COM\/WRIGHTTRAVEL&#039;&gt;Facebook&lt;\/a&gt;,&amp;nbsp;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.wrighttravelagency.com\/WWW.PINTEREST.COM\/WRIGHTTRAVEL&#039;&gt;Pinterest&lt;\/a&gt;, or&amp;nbsp;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.wrighttravelagency.com\/WWW.TWITTER.COM\/WRIGHTTRAVEL&#039;&gt;Twitter&lt;\/a&gt;&lt;\/p&gt;\n&lt;p style=\"color:rgb(51,51,51);font-family:Georgia, &#039;Times New Roman&#039;, &#039;Bitstream Charter&#039;, Times, serif;font-size:13px;\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"color:rgb(51,51,51);font-family:Georgia, &#039;Times New Roman&#039;, &#039;Bitstream Charter&#039;, Times, serif;font-size:13px;\"&gt;&lt;strong&gt;MORE ABOUT SECRETS RESORT AND SPA&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p style=\"color:rgb(51,51,51);font-family:Georgia, &#039;Times New Roman&#039;, &#039;Bitstream Charter&#039;, Times, serif;font-size:13px;\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"color:rgb(51,51,51);font-family:Georgia, &#039;Times New Roman&#039;, &#039;Bitstream Charter&#039;, Times, serif;font-size:13px;\"&gt;&lt;strong&gt;Secrets Marquis Los Cabos&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p style=\"color:rgb(51,51,51);font-family:Georgia, &#039;Times New Roman&#039;, &#039;Bitstream Charter&#039;, Times, serif;font-size:13px;\"&gt;Secrets Marquis Los Cabos, a proud member of The Leading Hotels of the World, offers adults Unlimited-Luxury\u00ae on Mexico&#039;s Baja Peninsula. Situated where the tranquil desert meets the untamed waters of the Pacific Ocean, guests will feel a sense of excitement and experience a world of pleasure. This adults-only seaside escape is an all-suite, all ocean view resort featuring unique, one-bedroom casitas - each with their own private pool. The expansive, world-class 15,000 square foot Spa, recognized as one of the top Spas in Mexico, provides guests with an indulgent pampering experience with result-driven treatments and massages designed to relax, refresh and rejuvenate the senses (spa services available at additional cost).&lt;\/p&gt;\n&lt;p style=\"color:rgb(51,51,51);font-family:Georgia, &#039;Times New Roman&#039;, &#039;Bitstream Charter&#039;, Times, serif;font-size:13px;\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"color:rgb(51,51,51);font-family:Georgia, &#039;Times New Roman&#039;, &#039;Bitstream Charter&#039;, Times, serif;font-size:13px;\"&gt;&lt;strong&gt;Secrets Vallarta Bay Puerto Vallarta&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p style=\"color:rgb(51,51,51);font-family:Georgia, &#039;Times New Roman&#039;, &#039;Bitstream Charter&#039;, Times, serif;font-size:13px;\"&gt;Secrets Vallarta Bay Puerto Vallarta - This resort offers adults an Unlimited-Luxury\u00ae escape on the golden beaches of the Banderas Bay. This all-suite resort provides guests with a wealth of amenities ranging from 24-hour room service, top-shelf spirits and gourmet dining without reservations to daily activities. Ideally situated just minutes from vibrant downtown Puerto Vallarta, guests will find an array of attractions including the famous El Malecon, a mile long oceanfront boardwalk lined with shops, restaurants and bars.&lt;\/p&gt;\n&lt;p style=\"color:rgb(51,51,51);font-family:Georgia, &#039;Times New Roman&#039;, &#039;Bitstream Charter&#039;, Times, serif;font-size:13px;\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"color:rgb(51,51,51);font-family:Georgia, &#039;Times New Roman&#039;, &#039;Bitstream Charter&#039;, Times, serif;font-size:13px;\"&gt;&lt;strong&gt;Secrets Capri Riviera Cancun&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p style=\"color:rgb(51,51,51);font-family:Georgia, &#039;Times New Roman&#039;, &#039;Bitstream Charter&#039;, Times, serif;font-size:13px;\"&gt;Secrets Capri Riviera Cancun - This all-adult, all Preferred Club, AAA Four Diamond resort in Riviera Maya offers guests extra attention with its unique, concierge-style setup. Intimate, villa-style surroundings set the tone for achieving ultimate rejuvenation and were designed to inspire the experience-seeking traveler. Savor international cuisine at five gourmet restaurants and delight in health-conscious meal options, including gluten-free, sugar-free, vegetarian and organic selections. The Unlimited-Luxury\u00ae journey continues with on-site cultural experiences, enriching classes and complimentary Unlimited Connectivity\u2014a new way to stay in touch at the resort with free WiFi, free calling and more.&lt;\/p&gt;\n&lt;p style=\"color:rgb(51,51,51);font-family:Georgia, &#039;Times New Roman&#039;, &#039;Bitstream Charter&#039;, Times, serif;font-size:13px;\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"color:rgb(51,51,51);font-family:Georgia, &#039;Times New Roman&#039;, &#039;Bitstream Charter&#039;, Times, serif;font-size:13px;\"&gt;&lt;strong&gt;&lt;em&gt;Introducing the Unlimited Connectivity App Suite (download to your Smartphone before departure). Get free WiFi and free calling while at resort as part of Unlimited-Luxury\u00ae - no additional cost, no VIP upgrade and no Preferred Club room necessary. Download each brand&#039;s mobile app on your smartphone, tablet or mobile device and experience everything Unlimited Connectivity has to offer, without international roaming charges, fees, or service upgrades.&lt;\/em&gt;&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p style=\"color:rgb(51,51,51);font-family:Georgia, &#039;Times New Roman&#039;, &#039;Bitstream Charter&#039;, Times, serif;font-size:13px;\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"color:rgb(51,51,51);font-family:Georgia, &#039;Times New Roman&#039;, &#039;Bitstream Charter&#039;, Times, serif;font-size:13px;\"&gt;&lt;strong&gt;&lt;span style=\"color:rgb(0,0,0);\"&gt;TERMS AND CONDITIONS&lt;\/span&gt;&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p style=\"color:rgb(51,51,51);font-family:Georgia, &#039;Times New Roman&#039;, &#039;Bitstream Charter&#039;, Times, serif;font-size:13px;\"&gt;&lt;span style=\"color:rgb(0,0,0);\"&gt;Groups must book a minimum of six rooms to receive the sixth room free. Complimentary rooms are issued for every sixth room booked per group with a maximum of 3 complimentary rooms per group booking. Complimentary rooms will be given in the lowest room category with the lowest rate. Private check-in and welcome beverage are applicable when groups arrive and check in all together. Room upgrades are based on availability. Room nights are calculated daily and are not cumulative. $200 in Resort Coupons Coupons are per room and are applicable: at the Spa with up to $40 per every 50-minute treatment (not applicable to Beauty Salon and Spa Products), for Romantic Dinners (up to $60 per every romantic dinner) scheduled with the Concierge, and up to $10 for every purchase of bottled wine from wine cellars. Coupons cannot be combined and are not: accumulative, redeemable for cash, transferrable, nor refundable. Coupons cannot be applied towards private functions, coffee breaks, audiovisual or entertainment. Coupons must be presented at time of service request. Blackout, weekend, holiday peak season surcharges apply. Promotion (3G) is accurate at time of publication and is subject to changes, exceptions, cancellation charges and restrictions. Not responsible for errors or omissions in the publication of this information. Valid for new bookings only.&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"color:rgb(51,51,51);font-family:Georgia, &#039;Times New Roman&#039;, &#039;Bitstream Charter&#039;, Times, serif;font-size:13px;\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"color:rgb(51,51,51);font-family:Georgia, &#039;Times New Roman&#039;, &#039;Bitstream Charter&#039;, Times, serif;font-size:13px;\"&gt;&lt;img height=\"397\" src=\"http:\/\/www.wrighttravelagency.com\/wp-content\/uploads\/2014\/05\/Wtsecretacapri-550x397.jpg\" width=\"550\" alt=\"Wtsecretacapri-550x397.jpg\"&gt;&lt;\/p&gt;","Attachments":[],"Id":1850240,"PostDate":1400060289,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p  style=\"color:rgb(51,51,51);font-family:Georgia,'Times New Roman', 'Bitstream Charter', Times, serif;font-size:13px;\"><strong>SOME SECRETS ARE WORTH SHARING! \u00a0<\/strong><\/p>\n<p  style=\"color:rgb(51,51,51);font-family:Georgia,'Times New Roman', 'Bitstream Charter', Times, serif;font-size:13px;\">\u00a0<\/p>\n<p  style=\"color:rgb(51,51,51);font-family:Georgia,'Times New Roman', 'Bitstream Charter', Times, serif;font-size:13px;\"><strong>Receive One Complimentary Room\u00a0for Every 5 Paid (6th room free) at Secrets Resort and Spa!<\/strong><\/p>\n<p  style=\"color:rgb(51,51,51);font-family:Georgia,'Times New Roman', 'Bitstream Charter', Times, serif;font-size:13px;\"><strong>(Maximum of 3 rooms)<\/strong><\/p>\n<p  style=\"color:rgb(51,51,51);font-family:Georgia,'Times New Roman', 'Bitstream Charter', Times, serif;font-size:13px;\"><strong>Booking and Travel Window: 1\/2\/14 \u2013 12\/22\/14<\/strong><\/p>\n<p  style=\"color:rgb(51,51,51);font-family:Georgia,'Times New Roman', 'Bitstream Charter', Times, serif;font-size:13px;\">\u00a0<\/p>\n<p  style=\"color:rgb(51,51,51);font-family:Georgia,'Times New Roman', 'Bitstream Charter', Times, serif;font-size:13px;\">PLUS receive these great added values!<\/p>\n<ul><li>Private Check-in<\/li>\n<li>Welcome beverage<\/li>\n<li>One Complimentary VIP Room Upgrade\u00a0for Every 10 Rooms Paid (maximum two upgrades per stay<\/li>\n<li>$200 in Resort Coupons Per Room, Per Stay<\/li>\n<\/ul><p  style=\"color:rgb(51,51,51);font-family:Georgia,'Times New Roman', 'Bitstream Charter', Times, serif;font-size:13px;\">\u00a0<\/p>\n<p  style=\"color:rgb(51,51,51);font-family:Georgia,'Times New Roman', 'Bitstream Charter', Times, serif;font-size:13px;\"><strong>BOOK NOW WITH WRIGHT TRAVEL AGENCY\u00a0<\/strong><br><strong>Call:\u00a0888-471-1950 \u00a0\u00a0<\/strong><\/p>\n<p  style=\"color:rgb(51,51,51);font-family:Georgia,'Times New Roman', 'Bitstream Charter', Times, serif;font-size:13px;\"><span rel='lightbox'><img class='bbc_img' height=\"29\" src=\"http:\/\/www.wrighttravelagency.com\/wp-content\/uploads\/2012\/10\/contact-us1.jpg\" width=\"102\" alt=\"contact-us1.jpg\"><\/span><\/p>\n<p  style=\"color:rgb(51,51,51);font-family:Georgia,'Times New Roman', 'Bitstream Charter', Times, serif;font-size:13px;\">\u00a0<\/p>\n<p  style=\"color:rgb(51,51,51);font-family:Georgia,'Times New Roman', 'Bitstream Charter', Times, serif;font-size:13px;\">\u00a0<\/p>\n<p  style=\"color:rgb(51,51,51);font-family:Georgia,'Times New Roman', 'Bitstream Charter', Times, serif;font-size:13px;\"><strong>MORE ABOUT WRIGHT TRAVEL AGENCY<\/strong><\/p>\n<p  style=\"color:rgb(51,51,51);font-family:Georgia,'Times New Roman', 'Bitstream Charter', Times, serif;font-size:13px;\">Wright Travel Agency is a boutique travel agency that specializes in Honeymoons and Destination Weddings and is the Official Travel Agency for\u00a0BestDestinationWedding.com! \u00a0Check out the link for promotions and offers exclusive to Wright Travel\u00a0<a href='http:\/\/www.wrighttravelagency.com\/WWW.WRIGHTTRAVELAGENCY.COM' class='bbc_url' title='External link' rel='nofollow external'>HERE<\/a>. \u00a0For more information about Wright Travel Agency, call 1-866-498-4951 \/ 415-839-7511, email us at info@wrighttravelagency.com, or visit us on the social media space:\u00a0<a href='http:\/\/www.wrighttravelagency.com\/WWW.FACEBOOK.COM\/WRIGHTTRAVEL' class='bbc_url' title='External link' rel='nofollow external'>Facebook<\/a>,\u00a0<a href='http:\/\/www.wrighttravelagency.com\/WWW.PINTEREST.COM\/WRIGHTTRAVEL' class='bbc_url' title='External link' rel='nofollow external'>Pinterest<\/a>, or\u00a0<a href='http:\/\/www.wrighttravelagency.com\/WWW.TWITTER.COM\/WRIGHTTRAVEL' class='bbc_url' title='External link' rel='nofollow external'>Twitter<\/a><\/p>\n<p  style=\"color:rgb(51,51,51);font-family:Georgia,'Times New Roman', 'Bitstream Charter', Times, serif;font-size:13px;\">\u00a0<\/p>\n<p  style=\"color:rgb(51,51,51);font-family:Georgia,'Times New Roman', 'Bitstream Charter', Times, serif;font-size:13px;\"><strong>MORE ABOUT SECRETS RESORT AND SPA<\/strong><\/p>\n<p  style=\"color:rgb(51,51,51);font-family:Georgia,'Times New Roman', 'Bitstream Charter', Times, serif;font-size:13px;\">\u00a0<\/p>\n<p  style=\"color:rgb(51,51,51);font-family:Georgia,'Times New Roman', 'Bitstream Charter', Times, serif;font-size:13px;\"><strong>Secrets Marquis Los Cabos<\/strong><\/p>\n<p  style=\"color:rgb(51,51,51);font-family:Georgia,'Times New Roman', 'Bitstream Charter', Times, serif;font-size:13px;\">Secrets Marquis Los Cabos, a proud member of The Leading Hotels of the World, offers adults Unlimited-Luxury\u00ae on Mexico's Baja Peninsula. Situated where the tranquil desert meets the untamed waters of the Pacific Ocean, guests will feel a sense of excitement and experience a world of pleasure. This adults-only seaside escape is an all-suite, all ocean view resort featuring unique, one-bedroom casitas - each with their own private pool. The expansive, world-class 15,000 square foot Spa, recognized as one of the top Spas in Mexico, provides guests with an indulgent pampering experience with result-driven treatments and massages designed to relax, refresh and rejuvenate the senses (spa services available at additional cost).<\/p>\n<p  style=\"color:rgb(51,51,51);font-family:Georgia,'Times New Roman', 'Bitstream Charter', Times, serif;font-size:13px;\">\u00a0<\/p>\n<p  style=\"color:rgb(51,51,51);font-family:Georgia,'Times New Roman', 'Bitstream Charter', Times, serif;font-size:13px;\"><strong>Secrets Vallarta Bay Puerto Vallarta<\/strong><\/p>\n<p  style=\"color:rgb(51,51,51);font-family:Georgia,'Times New Roman', 'Bitstream Charter', Times, serif;font-size:13px;\">Secrets Vallarta Bay Puerto Vallarta - This resort offers adults an Unlimited-Luxury\u00ae escape on the golden beaches of the Banderas Bay. This all-suite resort provides guests with a wealth of amenities ranging from 24-hour room service, top-shelf spirits and gourmet dining without reservations to daily activities. Ideally situated just minutes from vibrant downtown Puerto Vallarta, guests will find an array of attractions including the famous El Malecon, a mile long oceanfront boardwalk lined with shops, restaurants and bars.<\/p>\n<p  style=\"color:rgb(51,51,51);font-family:Georgia,'Times New Roman', 'Bitstream Charter', Times, serif;font-size:13px;\">\u00a0<\/p>\n<p  style=\"color:rgb(51,51,51);font-family:Georgia,'Times New Roman', 'Bitstream Charter', Times, serif;font-size:13px;\"><strong>Secrets Capri Riviera Cancun<\/strong><\/p>\n<p  style=\"color:rgb(51,51,51);font-family:Georgia,'Times New Roman', 'Bitstream Charter', Times, serif;font-size:13px;\">Secrets Capri Riviera Cancun - This all-adult, all Preferred Club, AAA Four Diamond resort in Riviera Maya offers guests extra attention with its unique, concierge-style setup. Intimate, villa-style surroundings set the tone for achieving ultimate rejuvenation and were designed to inspire the experience-seeking traveler. Savor international cuisine at five gourmet restaurants and delight in health-conscious meal options, including gluten-free, sugar-free, vegetarian and organic selections. The Unlimited-Luxury\u00ae journey continues with on-site cultural experiences, enriching classes and complimentary Unlimited Connectivity\u2014a new way to stay in touch at the resort with free WiFi, free calling and more.<\/p>\n<p  style=\"color:rgb(51,51,51);font-family:Georgia,'Times New Roman', 'Bitstream Charter', Times, serif;font-size:13px;\">\u00a0<\/p>\n<p  style=\"color:rgb(51,51,51);font-family:Georgia,'Times New Roman', 'Bitstream Charter', Times, serif;font-size:13px;\"><strong><em>Introducing the Unlimited Connectivity App Suite (download to your Smartphone before departure). Get free WiFi and free calling while at resort as part of Unlimited-Luxury\u00ae - no additional cost, no VIP upgrade and no Preferred Club room necessary. Download each brand's mobile app on your smartphone, tablet or mobile device and experience everything Unlimited Connectivity has to offer, without international roaming charges, fees, or service upgrades.<\/em><\/strong><\/p>\n<p  style=\"color:rgb(51,51,51);font-family:Georgia,'Times New Roman', 'Bitstream Charter', Times, serif;font-size:13px;\">\u00a0<\/p>\n<p  style=\"color:rgb(51,51,51);font-family:Georgia,'Times New Roman', 'Bitstream Charter', Times, serif;font-size:13px;\"><strong><span  style=\"color:rgb(0,0,0)\">TERMS AND CONDITIONS<\/span><\/strong><\/p>\n<p  style=\"color:rgb(51,51,51);font-family:Georgia,'Times New Roman', 'Bitstream Charter', Times, serif;font-size:13px;\"><span  style=\"color:rgb(0,0,0)\">Groups must book a minimum of six rooms to receive the sixth room free. Complimentary rooms are issued for every sixth room booked per group with a maximum of 3 complimentary rooms per group booking. Complimentary rooms will be given in the lowest room category with the lowest rate. Private check-in and welcome beverage are applicable when groups arrive and check in all together. Room upgrades are based on availability. Room nights are calculated daily and are not cumulative. $200 in Resort Coupons Coupons are per room and are applicable: at the Spa with up to $40 per every 50-minute treatment (not applicable to Beauty Salon and Spa Products), for Romantic Dinners (up to $60 per every romantic dinner) scheduled with the Concierge, and up to $10 for every purchase of bottled wine from wine cellars. Coupons cannot be combined and are not: accumulative, redeemable for cash, transferrable, nor refundable. Coupons cannot be applied towards private functions, coffee breaks, audiovisual or entertainment. Coupons must be presented at time of service request. Blackout, weekend, holiday peak season surcharges apply. Promotion (3G) is accurate at time of publication and is subject to changes, exceptions, cancellation charges and restrictions. Not responsible for errors or omissions in the publication of this information. Valid for new bookings only.<\/span><\/p>\n<p  style=\"color:rgb(51,51,51);font-family:Georgia,'Times New Roman', 'Bitstream Charter', Times, serif;font-size:13px;\">\u00a0<\/p>\n<p  style=\"color:rgb(51,51,51);font-family:Georgia,'Times New Roman', 'Bitstream Charter', Times, serif;font-size:13px;\"><span rel='lightbox'><img class='bbc_img' height=\"397\" src=\"http:\/\/www.wrighttravelagency.com\/wp-content\/uploads\/2014\/05\/Wtsecretacapri-550x397.jpg\" width=\"550\" alt=\"Wtsecretacapri-550x397.jpg\"><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bobbified@yahoo.com","IpAddress":"71.189.75.149","GroupId":56,"GroupName":"Community Manager","JoinDate":1352934615,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-262375.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":279,"PhotoType":"custom"},"FormattedName":"1fungrl","Id":262375,"Name":"1fungrl","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.147.0.145","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77059,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e39c5de0e49907c421c8ee5ab739b23c","RawContent":"&lt;p&gt;Good Morning, I&#039;m currently working with this resort to block rooms for my wedding. Am I still able to use this promotion even though my group will be receiving a \"group rate\"?&lt;\/p&gt;","Attachments":[],"Id":1850251,"PostDate":1400080124,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Good Morning, I'm currently working with this resort to block rooms for my wedding. Am I still able to use this promotion even though my group will be receiving a \"group rate\"?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"amanda.hodges1@snhu.edu","IpAddress":"24.62.217.165","GroupId":39,"GroupName":"Newbie","JoinDate":1398541937,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277733.jpg?_r=1400873765","PhotoWidth":200,"PhotoHeight":213,"PhotoType":"custom"},"FormattedName":"BusyBee280","Id":277733,"Name":"BusyBee280","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.202.225.11","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77059,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"12f0106907c122d4f2f1ff928505388c","RawContent":"If you would like to email us, we can definitely try to negotiate this promotion for you!\n[quote name=\"BusyBee280\" post=\"1850251\" timestamp=\"1400076524\"]\nGood Morning, I&#039;m currently working with this resort to block rooms for my wedding. Am I still able to use this promotion even though my group will be receiving a \"group rate\"?[\/quote]","Attachments":[],"Id":1850570,"PostDate":1400210446,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>If you would like to email us, we can definitely try to negotiate this promotion for you!<\/p>\n<p>\u00a0<\/p>\n<p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>BusyBee280, on 14 May 2014 - 07:08 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Good Morning, I'm currently working with this resort to block rooms for my wedding. Am I still able to use this promotion even though my group will be receiving a \"group rate\"?<\/p>\n<\/div>\n<\/div><\/div>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-family:arial, helvetica, sans-serif;\">Founder and Owner of BestDestinationWedding.com \u00a0\/ \u00a0<\/span><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/'><strong><span style=\"font-family:arial, helvetica, sans-serif;\">Bride & Groom Fly FREE Promotion<\/span><\/strong><\/a><\/p>\n<p>\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><strong><a data-ipb='nomediaparse' href='http:\/\/wrighttravelagency.com\/inquiry\/'><span style=\"color:#008080;\">Looking for a travel agency that specializes in Destination Weddings<\/span><\/a><\/strong><span style=\"color:#008080;\"><strong>?<\/strong> \u00a0We are an award winning travel agency and you can <\/span><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style=\"color:#008080;\">read our reviews\u00a0here.<\/span><\/a><\/strong><\/span><br>\n\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"color:#008080;\"><strong>Awards and recognition:\u00a0<\/strong><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Palace Resorts Winner \"Top Travel Agent\", \"Top Homebased Travel Agency\" PRO Platinum Agency (Top Award) \u00a0 \u00a0 | \u00a0 \u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">AMResorts Master Agent & Top Agency \u00a0<\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/68050-karisma-hotels-givc-and-gi-wedding-consultants-wright-travel-agency\/'><strong>Wright Travel & Karisma GIVC Benefits<\/strong><\/a><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Travel Impressions Best of the Best Globe Winner \u00a0 \u00a0| \u00a0 \u00a0\u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Apple Vacations Golden Apple Winner \u00a0<\/span><\/span><br><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"> \u00a0 \u00a0<img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"font-size:14px;\"><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010'>Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><\/span><\/span><strong><span style=\"color:#b22222;\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a data-ipb='nomediaparse' href='mailto:ads@be