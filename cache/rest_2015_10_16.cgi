{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":6,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":413,"MovedTo":null,"MovedOn":0,"FirstPostId":1898633,"Rating":0,"RatingHits":0,"Starter":{"Id":283554,"Name":"Mickeyb","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1434422226,"LastPoster":{"Id":277873,"Name":"calgarybride2015","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":true},"PollState":"0","LastVote":0,"ForumId":57,"Preview":{"Id":1898643,"PostDate":1434426328,"PostContent":"Welcome! \u00a0 Proud Grand Sirenis brides here (LOL!) \u00a0 Looks like @yycbride2016 sent you all the han...","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399432202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":true}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.226.139.21","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79279,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"75babd86b56092599b0657ac435770cb","RawContent":"Hello Fellow brides. I need your help. \n\n\nI am currently looking into getting married in June 2016 and working through different resorts (suggestions always welcome). I am looking for good food good service and a reasonable wedding package. \n\n\nThe and Sirenis has come across my table and one that is quite on the list because it&#039;s a good price and the package seems good. \n\n\n\nI am looking for any help from brides that are currently looking there or have gotten married there. What package did you use what extras did you get. My concern is I am looking at the presidential package because it comes with a DJ and private event and that&#039;s important to me but it says only for 10 people does that mean I have to pay a ton for extra guests? Has anyone dealt with this?? \n\n\nWanted to go to moon palace where they offer free private events but the resort seems to be coming in high costs and grand Sirenis package seemed good! \n\n\n\nAny help is much appreciated. \n\n\nThanks brides!!!","Attachments":[],"Id":1898633,"PostDate":1434422226,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hello Fellow brides. I need your help. <br><br>\nI am currently looking into getting married in June 2016 and working through different resorts (suggestions always welcome). I am looking for good food good service and a reasonable wedding package. <br><br>\nThe and Sirenis has come across my table and one that is quite on the list because it's a good price and the package seems good. <br><br><br>\nI am looking for any help from brides that are currently looking there or have gotten married there. What package did you use what extras did you get. My concern is I am looking at the presidential package because it comes with a DJ and private event and that's important to me but it says only for 10 people does that mean I have to pay a ton for extra guests? Has anyone dealt with this?? <br><br>\nWanted to go to moon palace where they offer free private events but the resort seems to be coming in high costs and grand Sirenis package seemed good! <br><br><br>\nAny help is much appreciated. <br><br>\nThanks brides!!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bidlofs@gmail.com","IpAddress":"99.226.139.21","GroupId":39,"GroupName":"Newbie","JoinDate":1434421344,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Mickeyb","Id":283554,"Name":"Mickeyb","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.15.187","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79279,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"e89f31af4cad95e1cb0209c90dd61db0","RawContent":"&lt;p&gt;Check out the thread for calgarybride2015&amp;nbsp; She was married there in January and gave it a glowing review. i know when she gets a chance she&#039;ll chime in here with a comment because I know she loved the resort and has great things to say about it!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;@calgarybride2015&amp;nbsp; Kim - you&#039;re on!!&lt;\/p&gt;","Attachments":[],"Id":1898634,"PostDate":1434422872,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Check out the thread for calgarybride2015\u00a0 She was married there in January and gave it a glowing review. i know when she gets a chance she'll chime in here with a comment because I know she loved the resort and has great things to say about it!<\/p>\n<p>\u00a0<\/p>\n<p>@calgarybride2015\u00a0 Kim - you're on!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><em><span style=\"color:rgb(51,153,255);\">I'm lucky enough to\u00a0tell my husband how much I love him and say yes again\u00a0on October 20, 2015 at Grand Coral Beach Club!\u00a0<\/span><\/em>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283462599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"162.157.216.37","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79279,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7a14faa30a5310fe1d728e64b9fe45f9","RawContent":"@[member=\"Mickeyb\"] I am getting married there February 2016! We are hoping to do the free wedding package (you need 10 double rooms booked for 7days) and then we are going to pay to upgrade to the private beach for the ceremony and private reception. \n\n\nYou do have to pay more for guests after 10 but it should say on the package list if you got one from the coordinators. They are well priced. We will be bringing a few things of our own to save on renting costs (decorations and chair sashes). \n\n\nSo far the resort is quick to respond and really helpful if I have any questions. I&#039;d recommend this resort this far. \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1898637,"PostDate":1434423456,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"283554\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/283554-mickeyb\/' title='Member profile'><span itemprop=\"name\">Mickeyb<\/span><\/a> I am getting married there February 2016! We are hoping to do the free wedding package (you need 10 double rooms booked for 7days) and then we are going to pay to upgrade to the private beach for the ceremony and private reception. <br><br>\nYou do have to pay more for guests after 10 but it should say on the package list if you got one from the coordinators. They are well priced. We will be bringing a few things of our own to save on renting costs (decorations and chair sashes). <br><br>\nSo far the resort is quick to respond and really helpful if I have any questions. I'd recommend this resort this far. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>~*~YYCBRIDE2016~*~<\/p><p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79227-yycbride2016-grand-sirenis-planning-thread-february-2016\/'>My planning thread\u00a0<\/a><\/p><p>\u00a0<\/p><p><a class='bbc_url' href='http:\/\/www.TickerFactory.com\/'><br><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10730;484\/st\/20160223\/e\/Our+Wedding\/dt\/-1\/k\/4bd8\/event.png\" alt=\"event.png\"><br><\/a><br>\u00a0","Email":"janellepaquin@hotmail.com","IpAddress":"162.157.216.37","GroupId":40,"GroupName":"Jr. Member","JoinDate":1432104904,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283167.jpg?_r=1432133572","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"yycbride2016","Id":283167,"Name":"yycbride2016","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.226.139.21","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79279,"EditedBy":"<strong>Edited by Mickeyb, 15 June 2015 - 07:05 PM.<\/strong>","EditDate":1434423906,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"704f9667fb2622e25cc8d80c1eb103a8","RawContent":"@[member=\"yycbride2016\"] would you be able to send me the list they sent you. I&#039;m not sure what&#039;s going wrong on my end but they haven&#039;t gotten back to me at all. I would be interested in seeing what they sent you cause I was hoping the same for free package and paying for private  \n\n\nThanks so much. \n\n\nBidlofs@[member=\"gmail\"].com\n\n\nalso sorry if this post comes up often. Phone keeps being weird","Attachments":[],"Id":1898638,"PostDate":1434423837,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"283167\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/283167-yycbride2016\/' title='Member profile'><span itemprop=\"name\">yycbride2016<\/span><\/a> would you be able to send me the list they sent you. I'm not sure what's going wrong on my end but they haven't gotten back to me at all. I would be interested in seeing what they sent you cause I was hoping the same for free package and paying for private  <br><br>\nThanks so much. <br><br>\nBidlofs@<a hovercard-ref=\"member\" hovercard-id=\"219734\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/219734-gmail\/' title='Member profile'><span itemprop=\"name\">gmail<\/span><\/a>.com<br><br>\nalso sorry if this post comes up often. Phone keeps being weird \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bidlofs@gmail.com","IpAddress":"99.226.139.21","GroupId":39,"GroupName":"Newbie","JoinDate":1434421344,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Mickeyb","Id":283554,"Name":"Mickeyb","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"162.157.216.37","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79279,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"85acaf08c866270dca7d7e47e26102fc","RawContent":"&lt;p&gt;@[member=\"Mickeyb\"] Yup I will send you a few emails as I have loads of different pdfs on the resort (spa packages --&amp;gt; hair and makup, music, extras, food, packages, restaurants, photography, etc.)&amp;nbsp;&lt;\/p&gt;\n\n&lt;p&gt;@[member=\"Mickeyb\"] Sent you a load of files!&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1898640,"PostDate":1434424575,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"283554\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/283554-mickeyb\/' title='Member profile'><span itemprop=\"name\">Mickeyb<\/span><\/a> Yup I will send you a few emails as I have loads of different pdfs on the resort (spa packages --> hair and makup, music, extras, food, packages, restaurants, photography, etc.)\u00a0<\/p>\n<br \/><p>@<a hovercard-ref=\"member\" hovercard-id=\"283554\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/283554-mickeyb\/' title='Member profile'><span itemprop=\"name\">Mickeyb<\/span><\/a> Sent you a load of files!\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>~*~YYCBRIDE2016~*~<\/p><p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79227-yycbride2016-grand-sirenis-planning-thread-february-2016\/'>My planning thread\u00a0<\/a><\/p><p>\u00a0<\/p><p><a class='bbc_url' href='http:\/\/www.TickerFactory.com\/'><br><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10730;484\/st\/20160223\/e\/Our+Wedding\/dt\/-1\/k\/4bd8\/event.png\" alt=\"event.png\"><br><\/a><br>\u00a0","Email":"janellepaquin@hotmail.com","IpAddress":"162.157.216.37","GroupId":40,"GroupName":"Jr. Member","JoinDate":1432104904,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283167.jpg?_r=1432133572","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"yycbride2016","Id":283167,"Name":"yycbride2016","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.146.146.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79279,"EditedBy":"<strong>Edited by calgarybride2015, 15 June 2015 - 07:46 PM.<\/strong>","EditDate":1434426406,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"9fdc54620c929ffff4b1d015457c1009","RawContent":"&lt;p&gt;Welcome!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Proud Grand Sirenis brides here (LOL!)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Looks like @[member=\"yycbride2016\"] sent you all the handouts which is great. They are very thorough and walk you thru all your options, add ons, extra fees, etc.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;What I did was choose the free wedding package (10 dbl rooms booked for 7 nights - otherwise it&#039;s the silver package) and upgrade my location to the palapa. I then added on all the extras I wanted, like the DJ, mariachi band, etc. &amp;nbsp; &amp;nbsp;I found that the presidential package was just a bit too much for what I wanted, and when I just did the basic package with add ons the cost was much lower.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;You are right, the packages include 10 people. That said, if you pick a package and upgrade to the palapa the 10 are no longer included and you pay per person. This is what I had to do. I had 2 food options and I picked the buffet. That was about $32 Canadian per person with the exchange at the time. &amp;nbsp; The surf and turf was around $50 per person. &amp;nbsp; This per person fee also includes the toast\/appetizers after the ceremony, the booze for 3 hours, cake, the chairs, tables, etc. &amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I brought all my own decor and just rented the chair ribbons! &amp;nbsp; &amp;nbsp;What I loved about the GS is that their packages were pretty inclusive, their extras were reasonable in cost, and they didn&#039;t charge you any hidden fees or set up fees.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Below are all my links to check out my planning, my wedding review, and pics!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck!&lt;\/p&gt;","Attachments":[],"Id":1898643,"PostDate":1434426328,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome!<\/p>\n<p>\u00a0<\/p>\n<p>Proud Grand Sirenis brides here (LOL!)<\/p>\n<p>\u00a0<\/p>\n<p>Looks like @<a hovercard-ref=\"member\" hovercard-id=\"283167\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/283167-yycbride2016\/' title='Member profile'><span itemprop=\"name\">yycbride2016<\/span><\/a> sent you all the handouts which is great. They are very thorough and walk you thru all your options, add ons, extra fees, etc.<\/p>\n<p>\u00a0<\/p>\n<p>What I did was choose the free wedding package (10 dbl rooms booked for 7 nights - otherwise it's the silver package) and upgrade my location to the palapa. I then added on all the extras I wanted, like the DJ, mariachi band, etc. \u00a0 \u00a0I found that the presidential package was just a bit too much for what I wanted, and when I just did the basic package with add ons the cost was much lower.<\/p>\n<p>\u00a0<\/p>\n<p>You are right, the packages include 10 people. That said, if you pick a package and upgrade to the palapa the 10 are no longer included and you pay per person. This is what I had to do. I had 2 food options and I picked the buffet. That was about $32 Canadian per person with the exchange at the time. \u00a0 The surf and turf was around $50 per person. \u00a0 This per person fee also includes the toast\/appetizers after the ceremony, the booze for 3 hours, cake, the chairs, tables, etc. \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I brought all my own decor and just rented the chair ribbons! \u00a0 \u00a0What I loved about the GS is that their packages were pretty inclusive, their extras were reasonable in cost, and they didn't charge you any hidden fees or set up fees.<\/p>\n<p>\u00a0<\/p>\n<p>Below are all my links to check out my planning, my wedding review, and pics!<\/p>\n<p>\u00a0<\/p>\n<p>Good luck!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399432202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":true}}],"Id":"79279","Title":"Grand Sirenis Mexico","LastPostDate":1434426328},"Pages":{"TotalItems":6,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
