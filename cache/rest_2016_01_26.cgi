{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"94575e6a3b8c9e8fa8c8084001ac3e77","RawContent":"Does anyone have a pricelist for the Spa? Trying to get a hold of someone but can&#039;t seem to get a response?","Attachments":[],"Id":1191944,"PostDate":1277177083,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Does anyone have a pricelist for the Spa? Trying to get a hold of someone but can't seem to get a response?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>October 28th 2010<\/span><br><span>EPM Here We Come!!<\/span><br><a data-ipb='nomediaparse' href=\"http:\/\/www.justproposed.com\/benandmelissa\/\">www.justproposed.com\/benandmelissa\/<\/a><\/div><\/div>","Email":"ncarolinadaisy@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1275538188,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-228794.jpg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"ncarolinadaisy","Id":228794,"Name":"ncarolinadaisy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"22d5b922f6e1ffc234b540439b5e17ee","RawContent":"I just found the pricelist on their website while I was poking around... try this link:\n \n &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.excellence-resorts.com\/all-inclusive-resorts\/playa-mujeres-mexico\/playa-mujeres-mexico-pdfs\/spa_priselist_playa.pdf\"&gt;http:\/\/www.excellence-resorts.com\/al...list_playa.pdf&lt;\/a&gt;","Attachments":[],"Id":1191993,"PostDate":1277179445,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I just found the pricelist on their website while I was poking around... try this link:<br \/> <br \/> <a href='http:\/\/www.excellence-resorts.com\/all-inclusive-resorts\/playa-mujeres-mexico\/playa-mujeres-mexico-pdfs\/spa_priselist_playa.pdf' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.excellenc....list_playa.pdf<\/a>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"knitgirl13@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1275409307,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-228743.gif?_r=0","PhotoWidth":100,"PhotoHeight":65,"PhotoType":"custom"},"FormattedName":"knitgirl13","Id":228743,"Name":"knitgirl13","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3e8841259198501c976424e88e1829af","RawContent":"Geeze! Thanks so much! I can&#039;t believe as many times as I have been to that site I didn&#039;t find it there!","Attachments":[],"Id":1192008,"PostDate":1277180362,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Geeze! Thanks so much! I can't believe as many times as I have been to that site I didn't find it there!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>October 28th 2010<\/span><br><span>EPM Here We Come!!<\/span><br><a data-ipb='nomediaparse' href=\"http:\/\/www.justproposed.com\/benandmelissa\/\">www.justproposed.com\/benandmelissa\/<\/a><\/div><\/div>","Email":"ncarolinadaisy@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1275538188,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-228794.jpg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"ncarolinadaisy","Id":228794,"Name":"ncarolinadaisy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6952e63d4a1f2b2104f61fef137980f6","RawContent":"do you ladies know if Yamina or another WC is going to be present to direct the wedding and\/or MC? Or are you just going to designate someone from your wedding party to MC the wedding?","Attachments":[],"Id":1192310,"PostDate":1277224357,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                do you ladies know if Yamina or another WC is going to be present to direct the wedding and\/or MC? Or are you just going to designate someone from your wedding party to MC the wedding?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"starzayc@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1276749599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-229259.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"uhleesa","Id":229259,"Name":"uhleesa","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"164268be886efc4ec158e7159e6456e1","RawContent":"Uhleesa- I am using DJ Mannia and his services include an MC. It was $930 for 4 hours and that includes the equipment, DJ services, MC, lights, and a wireless microphone. I dont think that Yamina will MC, if you arent using a DJ service, you may have to just have someone from your wedding party or a guest do it. \n \n Hope that helps! \n \n Did any of you girls get pictures of what the possible venues for the reception\/cocktail hour look like? I am a VERY visual person and I need to see what the space looks like before confirming venues with Yamina.\n \n Thanks, happy planning!\n \n Valerie","Attachments":[],"Id":1192338,"PostDate":1277226258,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Uhleesa- I am using DJ Mannia and his services include an MC. It was $930 for 4 hours and that includes the equipment, DJ services, MC, lights, and a wireless microphone. I dont think that Yamina will MC, if you arent using a DJ service, you may have to just have someone from your wedding party or a guest do it. <br \/> <br \/> Hope that helps! <br \/> <br \/> Did any of you girls get pictures of what the possible venues for the reception\/cocktail hour look like? I am a VERY visual person and I need to see what the space looks like before confirming venues with Yamina.<br \/> <br \/> Thanks, happy planning!<br \/> <br \/> Valerie\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"valeriefearns@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1254520310,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-222240.gif?_r=0","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"ValerieandBrian2010","Id":222240,"Name":"ValerieandBrian2010","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0099c4d8215df17665435974f9d22260","RawContent":"I have not seen the different options for spaces, but if any of you get them please send them my way...\n \n &lt;a data-ipb=&#039;nomediaparse&#039; href=\"mailto:ncarolinadaisy@yahoo.com\"&gt;ncarolinadaisy@yahoo.com&lt;\/a&gt;","Attachments":[],"Id":1192462,"PostDate":1277231417,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I have not seen the different options for spaces, but if any of you get them please send them my way...<br \/> <br \/> <a href='mailto:ncarolinadaisy@yahoo.com' class='bbc_url' title='External link' rel='nofollow external'>ncarolinadaisy@yahoo.com<\/a>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>October 28th 2010<\/span><br><span>EPM Here We Come!!<\/span><br><a data-ipb='nomediaparse' href=\"http:\/\/www.justproposed.com\/benandmelissa\/\">www.justproposed.com\/benandmelissa\/<\/a><\/div><\/div>","Email":"ncarolinadaisy@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1275538188,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-228794.jpg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"ncarolinadaisy","Id":228794,"Name":"ncarolinadaisy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fa242081353c26c78d24ad3f13dd7728","RawContent":"Hey everyone. I&#039;m not getting married here but I did just book my honeymoon. I was wondering if any of you could tell me about what excursions are the best here.\n Thanks!","Attachments":[],"Id":1192499,"PostDate":1277232483,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hey everyone. I'm not getting married here but I did just book my honeymoon. I was wondering if any of you could tell me about what excursions are the best here.<br \/> Thanks!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/signaturepics\/sigpic27721_1.gif\">http:\/\/bestdestinationwedding.com\/fo...pic27721_1.gif<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/global.theknot.com\/tickers\/tt89ffc.aspx\">http:\/\/global.theknot.com\/tickers\/tt89ffc.aspx<\/a><\/div><\/div>","Email":"sierraporter@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1274650811,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-228475.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"Tissey","Id":228475,"Name":"Tissey","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6622bef1c2f18befd0e98da6e8a0f8b7","RawContent":"No info on trips. I know there is lots to do, but my friends just honeymooned there last June and said that they never wanted to leave the resort. I have read a lot of reviews from trip advisor who said the same thing. The trips are an all day thing where a bunch of sweaty people are crammed on a bus? I am guessing they are talking about going to the ruins, and zip lining? \n \n I am not going to research it too much. I guess I will just feel it out when I get there?","Attachments":[],"Id":1192515,"PostDate":1277233214,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                No info on trips. I know there is lots to do, but my friends just honeymooned there last June and said that they never wanted to leave the resort. I have read a lot of reviews from trip advisor who said the same thing. The trips are an all day thing where a bunch of sweaty people are crammed on a bus? I am guessing they are talking about going to the ruins, and zip lining? <br \/> <br \/> I am not going to research it too much. I guess I will just feel it out when I get there?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>October 28th 2010<\/span><br><span>EPM Here We Come!!<\/span><br><a data-ipb='nomediaparse' href=\"http:\/\/www.justproposed.com\/benandmelissa\/\">www.justproposed.com\/benandmelissa\/<\/a><\/div><\/div>","Email":"ncarolinadaisy@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1275538188,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-228794.jpg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"ncarolinadaisy","Id":228794,"Name":"ncarolinadaisy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"50f2ab591050767d18c23f69802335ae","RawContent":"I can&#039;t remember who was asking me for Gazebo pics, but I found them! If you want me to email them please let me know!","Attachments":[],"Id":1192963,"PostDate":1277251588,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I can't remember who was asking me for Gazebo pics, but I found them! If you want me to email them please let me know!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>October 28th 2010<\/span><br><span>EPM Here We Come!!<\/span><br><a dat