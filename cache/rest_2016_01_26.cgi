this-is-not-a-planning-thread-but\/<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283440999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},"Posts":[],"Id":"79893","Title":"Looking For Feedback On My Flowers","LastPostDate":1453795982},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":3,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":88,"MovedTo":null,"MovedOn":0,"FirstPostId":1909896,"Rating":0,"RatingHits":0,"Starter":{"Id":284050,"Name":"2ndTimeMrs","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":true},"StartDate":1453459457,"LastPoster":{"Id":284050,"Name":"2ndTimeMrs","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":true},"PollState":"0","LastVote":0,"ForumId":23,"Preview":{"Id":1910047,"PostDate":1453793221,"PostContent":"Thanks for the links\u00a0@acw271011\u00a0I reached out to a tour operator that booked our golf excursion a...","Author":{"Signature":"","Email":"webgrl74@gmail.com","IpAddress":"99.224.73.70","GroupId":39,"GroupName":"Newbie","JoinDate":1437418985,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png"