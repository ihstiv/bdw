iles.bestdestinationwedding.com\/images\/smilies\/smile43.gif\" border=\"0\" alt=\"\" title=\"Smile43\" class=\"inlineimg\" \/&gt;&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;Thope - Where did you get your actual OOT bags from?\n \n Rebecca","Attachments":[],"Id":1105170,"PostDate":1270703720,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>thope<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Thanks Ladies for the dress code info! I am booking DJ Mannia and will let you know the total cost soon..the dance floor is not included but lighting is. Also I'm waiting to hear back on photo packages from Juan to compare with C R.<br \/> ~Have you all done your OOT bags yet..I'm a little behind and only have the actual bags and advil..so nervous I wont get everything done.. <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile43.gif\" border=\"0\" alt=\"\" title=\"Smile43\" class=\"inlineimg\" \/><\/span><\/div> <\/td> <\/tr> <\/table> <\/div>Thope - Where did you get your actual OOT bags from?<br \/> <br \/> Rebecca\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;95\/st\/20101203\/e\/Our+Dream+Wedding\/k\/adc5\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...adc5\/event.png<\/a><\/div><\/div>","Email":"rebecca.ooyen@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1260949542,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223947.gif?_r=0","PhotoWidth":78,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"ButterflyR12","Id":223947,"Name":"ButterflyR12","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"967e07cdcd57efbb13c2cba72b1f7098","RawContent":"Wow time in flying by. I feel like I have so much to do and so little time. I can&#039;t wait to be in Mexico and guess what I wont have to wait very much longer. I just got my dress yesterday my alterations look amazing and I also got married yesterday at the courthouse. I need to finish up my OOT bags by buying more beach towels and tissue paper.","Attachments":[],"Id":1105417,"PostDate":1270718494,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Wow time in flying by. I feel like I have so much to do and so little time. I can't wait to be in Mexico and guess what I wont have to wait very much longer. I just got my dress yesterday my alterations look amazing and I also got married yesterday at the courthouse. I need to finish up my OOT bags by buying more beach towels and tissue paper.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;130\/st\/20100417\/e\/the+wedding+of+my+dreams\/dt\/-1\/k\/0f53\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...0f53\/event.png<\/a><br><br><i><strong>Excellence Playa Mujeres Bride<br>April 17, 2010<\/strong><\/i><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/t\/wukvjpB\/weight.png\">http:\/\/tickers.TickerFactory.com\/ezt...jpB\/weight.png<\/a><\/div><\/div>","Email":"s_katrese@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1229629965,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213251.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"s_katrese","Id":213251,"Name":"s_katrese","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7f0ec10e107459fe61ef5a3bcd5feb57","RawContent":"S Katrese your date is so close!! I know how excited you must be. \n \n Just a note about my OOT bags - I wanted to do more of a beach bag for mine and I found some big canvas ones at Bed Bath &amp;amp; Beyond last week for $4.99!! They are off white with either red or blue handles. I wanted them pretty big because I&#039;m using one bag for each couple I think these will hold 2 towels, two mugs and all the other stuff I end up with! \n \n I was wondering about when to pick the flowers and cake too. Yamina has been very responsive anytime I&#039;ve had to email her. I might send her an email and see what she suggests.","Attachments":[],"Id":1105822,"PostDate":1270756617,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                S Katrese your date is so close!! I know how excited you must be. <br \/> <br \/> Just a note about my OOT bags - I wanted to do more of a beach bag for mine and I found some big canvas ones at Bed Bath & Beyond last week for $4.99!! They are off white with either red or blue handles. I wanted them pretty big because I'm using one bag for each couple I think these will hold 2 towels, two mugs and all the other stuff I end up with! <br \/> <br \/> I was wondering about when to pick the flowers and cake too. Yamina has been very responsive anytime I've had to email her. I might send her an email and see what she suggests.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"anandres@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1266628838,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-225754.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"anandres","Id":225754,"Name":"anandres","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":27268,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"20a579ddaacebfcbff96e06ce78ce3eb","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;thope&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Hey site visitors and past brides...what was the dress code like for dinner? From what I have read on the website..looks like men have to wear slacks, is that true..I want to prepare my guest...THANKS&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;The dress codes for men were pretty strict. Make sure your guest are prepared!&lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/grouphug.gif\" border=\"0\" alt=\"\" title=\"Grouphug\" class=\"inlineimg\" \/&gt;","Attachments":[],"Id":1109312,"PostDate":1271042704,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>thope<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Hey site visitors and past brides...what was the dress code like for dinner? From what I have read on the website..looks like men have to wear slacks, is that true..I want to prepare my guest...THANKS<\/div> <\/td> <\/tr> <\/table> <\/div>The dress codes for men were pretty strict. Make sure your guest are prepared!<span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/grouphug.gif\" border=\"0\" alt=\"\" title=\"Grouphug\" class=\"inlineimg\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/www.weddingcountdown.com\/ticker\/6qscsou.png\">http:\/\/www.weddingcountdown.com\/ticker\/6qscsou.png<\/a><br><span>[\/CENTER]<\/span><\/div><\/div>","Email":"reeveswedding@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1219377984,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211327.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"reevesbride","Id":211327,"Name":"reevesbride","IsOnline":false}}],"Pages":{"TotalItems":2874,"TotalPages":288,"CurrentPage":490,"NextPage":500,"PreviousPage":480,"LastPage":2870},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
