se\" Priority=\"67\" SemiHidden=\"false\" UnhideWhenUsed=\"false\" Name=\"Medium Grid 1\"\/&gt; &lt;w:LsdException Locked=\"false\" Priority=\"68\" SemiHidden=\"false\" UnhideWhenUsed=\"false\" Name=\"Medium Grid 2\"\/&gt; &lt;w:LsdException Locked=\"false\" Priority=\"69\" SemiHidden=\"false\" UnhideWhenUsed=\"false\" Name=\"Medium Grid 3\"\/&gt; &lt;w:LsdException Locked=\"false\" Priority=\"70\" SemiHidden=\"false\" UnhideWhenUsed=\"false\" Name=\"Dark List\"\/&gt; &lt;w:LsdException Locked=\"false\" Priority=\"71\" SemiHidden=\"false\" UnhideWhenUsed=\"false\" Name=\"Colorful Shading\"\/&gt; &lt;w:LsdException Locked=\"false\" Priority=\"72\" Se","Attachments":[],"Id":1514321,"PostDate":1314944072,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><u><strong>Wedding Packages 2014<\/strong><\/u>.\u00a0 If you are sent a more up to date version, please PM me.<\/p> <p>\u00a0<\/p> <p><a href='http:\/\/www.bestdestinationwedding.com\/t\/786\/gran-bahia-principe-akumal-tulum-coba-post-here\/2330#post_1124798' class='bbc_url' title=''>Post #2333<\/a> has the Civil Ceremony Order<\/p> <ul> <li><span  style=\"display:none\">iliv Wedding Pkia\u00a0<\/span><\/li> <\/ul> <p><strong>SUNSHINE - $1,490 (Legal ceremony) $1345 (Symbolic ceremony)<\/strong><\/p> <p  style=\"margin-left:27.0pt\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Civil wedding (judge fees, marriage license and certificate.) **WHEN LEGAL WEDDING**<\/span><\/p> <p  style=\"margin-left:27.0pt;text-align:justify\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Minister\u00b4s Fee ** When Symbolic Wedding ( non legal) \u00e2\u20ac\u201c Renewal of Vows**<\/span><\/p> <p  style=\"margin-left:27.0pt\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Marriage ceremony with music from CD.(couple may bring their own).<\/span><\/p> <p  style=\"margin-left:27.0pt\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Romantic Ornamental decoration of the wedding site, location will be assigned after arrival.<\/span><\/p> <p  style=\"margin-left:27.0pt\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Picturesque Wedding location \u00e2\u20ac\u201c may be celebrated on the beach or gazebo (upon confirmation)<\/span><\/p> <p  style=\"margin-left:27.0pt\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Music for the Ceremony with recorded CD ( couple may bring their own)<\/span><\/p> <p  style=\"margin-left:27.0pt\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Bride & Groom\u00e2\u20ac\u2122s bouquet & boutonniere (Tropical Local Flowers) \u00e2\u20ac\u201c just for the couple. <\/span><\/p> <p  style=\"margin-left:27.0pt;text-align:justify\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Domestic sparkling wine celebration toast after the ceremony (1 bottle per 7 adults, maximum total of\u00a0 4 bottles)<\/span><\/p> <p  style=\"margin-left:27.0pt;text-align:justify\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Sit down dinner in one of our restaurants with set menu ( semi private)<\/span><\/p> <p  style=\"margin-left:27.0pt;text-align:justify\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Standard Wedding Cake for all wedding guests or dessert choice (Dessert from our specialty restaurant menu rather than the traditional wedding cake) <\/span><\/p> <p  style=\"margin-left:27.0pt;text-align:justify\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Room Upgrade for the couple & parents (subject to availability upon arrival). <\/span><\/p> <p  style=\"margin-left:27.0pt;text-align:justify\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Upgraded in-room Amenities (just for the couple)<\/span><\/p> <p  style=\"margin-left:27.0pt;text-align:justify\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Transfer to wedding location for the couple. <\/span><\/p> <p  style=\"margin-left:27.0pt;text-align:justify\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Bottle of wine upon arrival in room (wedding couple)<\/span><\/p> <p  style=\"margin-left:27.0pt;text-align:justify\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Luxury Turn down service (wedding couple & parents)<\/span><\/p> <p  style=\"margin-left:27.0pt;text-align:justify\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">10 professional full digital colored pictures of the wedding ceremony<\/span><\/p> <p  style=\"margin-left:27.0pt;text-align:justify\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">15% Discount on Spa treatments (except pedicure, manicure, hairdresser & makeup)<\/span><\/p> <p  style=\"margin-left:27.0pt;text-align:justify\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Late Check out ( wedding couple & parents, upon request at the check in & subject to availability)<\/span><\/p> <p  style=\"margin-left:27.0pt;text-align:justify\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Professional Services of an Onsite Wedding Coordinator.<\/span><\/p> <p  style=\"margin-left:27.0pt;text-align:justify\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Witnesses (if required)<\/span><\/p> <p  style=\"margin-left:27.0pt;text-align:justify\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Romantic Decoration in couple room ( welcome surprise)<\/span><\/p> <p  style=\"margin-left:27.0pt;text-align:justify\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">VIP treatment for the couple<\/span><\/p> <p  style=\"margin-left:27.0pt;text-align:justify\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">1 Newlywed\u00e2\u20ac\u2122s Romantic breakfast in bed ( just for the couple)<\/span><\/p> <p><!--[if gte mso 9]><xml> <w:WordDocument> <w:View>Normal<\/w:View> <w:Zoom>0<\/w:Zoom> <w:TrackMoves\/> <w:TrackFormatting\/> <w:PunctuationKerning\/> <w:ValidateAgainstSchemas\/> <w:SaveIfXMLInvalid>false<\/w:SaveIfXMLInvalid> <w:IgnoreMixedContent>false<\/w:IgnoreMixedContent> <w:AlwaysShowPlaceholderText>false<\/w:AlwaysShowPlaceholderText> <w:DoNotPromoteQF\/> <w:LidThemeOther>EN-US<\/w:LidThemeOther> <w:LidThemeAsian>X-NONE<\/w:LidThemeAsian> <w:LidThemeComplexScript>X-NONE<\/w:LidThemeComplexScript> <w:Compatibility> <w:BreakWrappedTables\/> <w:SnapToGridInCell\/> <w:WrapTextWithPunct\/> <w:UseAsianBreakRules\/> <w:DontGrowAutofit\/> <w:SplitPgBreakAndParaMark\/> <w:EnableOpenTypeKerning\/> <w:DontFlipMirrorIndents\/> <w:OverrideTableStyleHps\/> <\/w:Compatibility> <w:BrowserLevel>MicrosoftInternetExplorer4<\/w:BrowserLevel> <m:mathPr> <m:mathFont m:val=\"Cambria Math\"\/> <m:brkBin m:val=\"before\"\/> <m:brkBinSub m:val=\"&#45;-\"\/> <m:smallFrac m:val=\"off\"\/> <m:dispDef\/> <m:lMargin m:val=\"0\"\/> <m:rMargin m:val=\"0\"\/> <m:defJc m:val=\"centerGroup\"\/> <m:wrapIndent m:val=\"1440\"\/> <m:intLim m:val=\"subSup\"\/> <m:naryLim m:val=\"undOvr\"\/> <\/m:mathPr><\/w:WordDocument> <\/xml><![endif]--><!--[if gte mso 9]><xml> <w:LatentStyles DefLockedState=\"false\" DefUnhideWhenUsed=\"true\" DefSemiHidden=\"true\" DefQFormat=\"false\" DefPriority=\"99\" LatentStyleCount=\"267\"> <w:LsdException Locked=\"false\" Priority=\"0\" SemiHidden=\"false\" UnhideWhenUsed=\"false\" QFormat=\"true\" Name=\"Normal\"\/> <w:LsdException Locked=\"false\" Priority=\"9\" SemiHidden=\"false\" UnhideWhenUsed=\"false\" QFormat=\"true\" Name=\"heading 1\"\/> <w:LsdException Locked=\"false\" Priority=\"9\" Q