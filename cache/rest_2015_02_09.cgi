n=\"false\" UnhideWhenUsed=\"false\" QFormat=\"true\" Name=\"Book Title\"\/> <w:LsdException Locked=\"false\" Priority=\"37\" Name=\"Bibliography\"\/> <w:LsdException Locked=\"false\" Priority=\"39\" QFormat=\"true\" Name=\"TOC Heading\"\/> <\/w:LatentStyles> <\/xml><![endif]--><\/p> <p>\u00a0<\/p> <p><strong><span  style=\"color:#333333\"><span  style=\"font-size:small\">UNFORGETTABLE - $1,710 (Legal Ceremony) $1575 (Symbolic Ceremony)<\/span><\/span><\/strong><\/p> <p><!--[if gte mso 9]><xml> <o:OfficeDocumentSettings> <o:TargetScreenSize>800x600<\/o:TargetScreenSize> <\/o:OfficeDocumentSettings> <\/xml><![endif]--><\/p> <p  style=\"margin-left:27.0pt\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Civil wedding (judge fees, marriage license and certificate.) ***WHEN LEGAL WEDINGS**<\/span><\/p> <p  style=\"margin-left:27.0pt;text-align:justify\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Minister\u00e2\u20ac\u2122s Fee **When Symbolic Wedding (non legal)\u00a0 -\u00a0 Renewal of Vows**.<\/span><\/p> <p  style=\"margin-left:27.0pt\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Marriage ceremony with music from CD (couple may bring their own).<\/span><\/p> <p  style=\"margin-left:27.0pt\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Romantic Ornamental decoration of the wedding site, location will be assigned after arrival.<\/span><\/p> <p  style=\"margin-left:27.0pt\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Bride & Groom\u00e2\u20ac\u2122s bouquet & boutonniere (Tropical Local Flowers) \u00e2\u20ac\u201cjust for the couple -. <\/span><\/p> <p  style=\"margin-left:27.0pt\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Fresh Elegant Floral Decor on Bridal Table<\/span><\/p> <p  style=\"margin-left:27.0pt\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Picturesque Wedding location \u00e2\u20ac\u201c may be celebrated on the beach or gazebo (upon confirmation)<\/span><\/p> <p  style=\"margin-left:27.0pt\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Music for the Ceremony with recorded CD ( couple may bring their own)<\/span><\/p> <p  style=\"margin-left:27.0pt;text-align:justify\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Champagne Luxury Toast after the ceremony with M\u00b6et Chandon (max. \u00a04 bottles \u00e2\u20ac\u201c 1 p\/7 persons)<\/span><\/p> <p  style=\"margin-left:27.0pt;text-align:justify\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Sit-Down Dinner in one of our restaurants with set menu. (semi private)<\/span><\/p> <p  style=\"margin-left:27.0pt;text-align:justify\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Standard Wedding Cake for all wedding guests or dessert choice (dessert from our specialty restaurant menu, rather than the traditional wedding cake).<\/span><\/p> <p  style=\"margin-left:27.0pt;text-align:justify\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Room Upgrade for couple & parents (subject to availability upon arrival). <\/span><\/p> <p  style=\"margin-left:.5in;text-align:justify\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">1 Newlywed\u00e2\u20ac\u2122s Romantic Breakfast in bed \u00a0(just for the couple)<\/span><\/p> <p  style=\"margin-left:27.0pt;text-align:justify\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Transfer to wedding location. (for the couple)<\/span><\/p> <p  style=\"margin-left:27.0pt;text-align:justify\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Romantic Candlelight Dinner with Reservation (wedding couple - must be requested before arrival)<\/span><\/p> <p  style=\"margin-left:27.0pt;text-align:justify\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Upgraded in-room Amenities \u00e2\u20ac\u201c ( for the couple & parents) <\/span><\/p> <p  style=\"margin-left:27.0pt;text-align:justify\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Romantic decoration in couple\u00e2\u20ac\u2122s room ( welcome surprise)<\/span><\/p> <p  style=\"margin-left:27.0pt;text-align:justify\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Bottle of International wine will be served in the room upon arrival. (wedding couple)<\/span><\/p> <p  style=\"margin-left:27.0pt;text-align:justify\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Luxury Turn down service. (wedding couple & parents)<\/span><\/p> <p  style=\"margin-left:27.0pt;text-align:justify\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">15 professional full digital colored pictures of the wedding ceremony<\/span><\/p> <p  style=\"margin-left:27.0pt;text-align:justify\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">20% Discount on Spa treatments (except pedicure, manicure, hairdresser & makeup)<\/span><\/p> <p  style=\"margin-left:27.0pt;text-align:justify\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Late Check ( wedding couple & parents, upon request at check in & subject to availability)<\/span><\/p> <p  style=\"margin-left:27.0pt;text-align:justify\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Live Musical Trio (to play at ceremony or dinner)<\/span><\/p> <p  style=\"margin-left:27.0pt;text-align:justify\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Luxury Turn down service. (wedding couple & parents)<\/span><\/p> <p  style=\"margin-left:27.0pt;text-align:justify\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Professional Services of an Onsite Wedding Coordinator.<\/span><\/p> <p  style=\"margin-left:27.0pt;text-align:justify\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Witnesses ( if required)<\/span><\/p> <p  style=\"margin-left:27.0pt;text-align:justify\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">VIP Treatment for the couple<\/span><\/p> <p>\u00a0<\/p> <p><strong>ROMANCE EXTRAVAGANZA - $3,140 (Legal Ceremony) $2,995 (Symbolic Ceremony)<\/strong><\/p> <p>\u00a0\u00a0 - Maximum 30 people.\u00a0 $40 each additional guest<br \/> <!--[if gte mso 9]><xml> <o:OfficeDocumentSettings> <o:TargetScreenSize>800x600<\/o:TargetScreenSize> <\/o:OfficeDocumentSettings> <\/xml><![endif]--><\/p> <p  style=\"margin-left:27.0pt;text-align:justify\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Civil wedding (judge fees, marriage license and certificate.) ***WHEN LEGAL WEDINGS**<\/span>\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Minister\u00e2\u20ac\u2122s Fee **When Symbolic Wedding (non legal)\u00a0 -\u00a0 Renewal of Vows**.<\/span><\/p> <p  style=\"margin-left:27.0pt\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Marriage ceremony with music from CD (couple may bring their own).<\/span><\/p> <p  style=\"margin-left:27.0pt\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Romantic Ornamental decoration of the wedding site, location will be assigned after arrival.<\/span><\/p> <p  style=\"margin-left:27.0pt\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Bride & Groom\u00e2\u20ac\u2122s bouquet & boutonniere (Tropical Local Flowers) \u00e2\u20ac\u201cjust for the couple -. <\/span><\/p> <p  style=\"margin-left:27.0pt\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Fresh Elegant Floral Decor on Bridal Table<\/span><\/p> <p  style=\"margin-left:27.0pt\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Picturesque Wedding location \u00e2\u20ac\u201c may be celebrated on the beach or gazebo (upon confirmation)<\/span><\/p> <p  style=\"margin-left:27.0pt\">\u00b7<span>\u00a0\u00a0 <\/span><span  style=\"color:#333333\">Music for the Ceremony with recorded CD ( couple may bring their own)<\/span><\/p> <p  style=\"margin-left:27.0pt;text-alig