Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":true,"CanReply":true,"CanFollow":true,"TotalPosts":14,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":1362,"MovedTo":null,"MovedOn":0,"FirstPostId":1737381,"Rating":0,"RatingHits":0,"Starter":{"Id":267689,"Name":"LueseeWin","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-267689.jpeg?_r=0","PhotoWidth":113,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"StartDate":1363990429,"LastPoster":{"Id":279087,"Name":"Msmimi","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":88,"Preview":{"Id":1885001,"PostDate":1422895201,"PostContent":"Congrats!","Author":{"Signature":"","Email":"njwood000@gmail.com","IpAddress":"71.7.173.185","GroupId":40,"GroupName":"Jr. Member","JoinDate":1405795991,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Msmimi","Id":279087,"Name":"Msmimi","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":false,"CanLike":true,"TopicId":73377,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"57073eadc6e781f08e55f2eb7d6cf5f3","RawContent":"&lt;p&gt; Hi everyone,&lt;\/p&gt; &lt;p&gt; My Fiance and I want to plan a small cruise wedding with our closest friends and family for 2014. I personally never been on a cruise so I don&#039;t know what to expect. I read all the different packages Carnival has to offer and I just want to know what would be the best deals for small group about 10-15 people and kind of wanted to know the lay out of how everything is going to. We wanted to be kind of cheap and inexpensive for our guests so we to port from Orange County L.A. area since it is a lot closer to home.I can be kind of a control freak, so not knowing how the ceremony will go or reception wise is killing me.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Please Help. Lucy&lt;\/p&gt;","Attachments":[],"Id":1737381,"PostDate":1363990429,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hi everyone,<\/p> <p> My Fiance and I want to plan a small cruise wedding with our closest friends and family for 2014. I personally never been on a cruise so I don't know what to expect. I read all the different packages Carnival has to offer and I just want to know what would be the best deals for small group about 10-15 people and kind of wanted to know the lay out of how everything is going to. We wanted to be kind of cheap and inexpensive for our guests so we to port from Orange County L.A. area since it is a lot closer to home.I can be kind of a control freak, so not knowing how the ceremony will go or reception wise is killing me.<\/p> <p> \u00a0<\/p> <p> Please Help. Lucy<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lucyisthao@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1363989980,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-267689.jpeg?_r=0","PhotoWidth":113,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"LueseeWin","Id":267689,"Name":"LueseeWin","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":73377,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2671abaa9330d9c61eab85bf817c5d65","RawContent":"&lt;p&gt; Hi LueseeWin!&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I personally don&#039;t have experience going a cruise wedding but am planning on one in the future. There isn&#039;t that much information on cruise weddings but I have read reviews on other bride&#039;s experiences! Have you looked on the cruise critic website? There is a section called \"Honeymoons and Wedding Cruises\" where there are a few recent reviews and information. Here is a link to a recent review from a Carnival cruise leaving Galveston, TX:&amp;nbsp;&lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/boards.cruisecritic.com\/showthread.php?t=1806249\"&gt;http:\/\/boards.cruisecritic.com\/showthread.php?t=1806249&lt;\/a&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Hope this helps!&lt;\/p&gt;","Attachments":[],"Id":1737617,"PostDate":1364071142,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hi LueseeWin!<\/p> <p> \u00a0<\/p> <p> I personally don't have experience going a cruise wedding but am planning on one in the future. There isn't that much information on cruise weddings but I have read reviews on other bride's experiences! Have you looked on the cruise critic website? There is a section called \"Honeymoons and Wedding Cruises\" where there are a few recent reviews and information. Here is a link to a recent review from a Carnival cruise leaving Galveston, TX:\u00a0<a href='http:\/\/boards.cruisecritic.com\/showthread.php?t=1806249' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/boards.cruise...d.php?t=1806249<\/a><\/p> <p> \u00a0<\/p> <p> Hope this helps!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lyna_89_07@mugglenet.com","IpAddress":"172.8.174.118","GroupId":39,"GroupName":"Newbie","JoinDate":1362328691,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-266841.jpeg?_r=0","PhotoWidth":180,"PhotoHeight":161,"PhotoType":"custom"},"FormattedName":"lyna89","Id":266841,"Name":"lyna89","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":73377,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d5ec16ff4d8de8731fd37e88fb46bfac","RawContent":"&lt;p&gt; I forgot to mention it also depends on whether you want your wedding on embarkation day (the day the ship is set to sail) or at one of the ports during the cruise. If you choose one of the ports, I&#039;ve heard of brides not going through the cruise line and using the resort planner or other destination wedding planner. I think Royal Caribbean and maybe another cruise line give the option to get married at sea (on a sea day), but it&#039;s more expensive than the other packages.&amp;nbsp;\n \n As for the packages Carnival offers, I think it depends on what you want. Most of them (if not all) include up to 20 guests in their packages so you would not have to pay for extra people. I have heard that the luncheon is more of a sit down meal with the family and the deluxe package has more of the dancing and music with guests being able to eat your choice of different hot and cold hors d&#039;oeuvres during the reception.\n \n Ok now I&#039;m done! I hope I answered at least one of your questions!&lt;\/p&gt;","Attachments":[],"Id":1737623,"PostDate":1364072175,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I forgot to mention it also depends on whether you want your wedding on embarkation day (the day the ship is set to sail) or at one of the ports during the cruise. If you choose one of the ports, I've heard of brides not going through the cruise line and using the resort planner or other destination wedding planner. I think Royal Caribbean and maybe another cruise line give the option to get married at sea (on a sea day), but it's more expensive than the other packages.\u00a0<br \/> <br \/> As for the packages Carnival offers, I think it depends on what you want. Most of them (if not all) include up to 20 guests in their packages so you would not have to pay for extra people. I have heard that the luncheon is more of a sit down meal with the family and the deluxe package has more of the dancing and music with guests being able to eat your choice of different hot and cold hors d'oeuvres during the reception.<br \/> <br \/> Ok now I'm done! I hope I answered at least one of your questions!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lyna_89_07@mugglenet.com","IpAddress":"172.8.174.118","GroupId":39,"GroupName":"Newbie","JoinDate":1362328691,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-266841.jpeg?_r=0","PhotoWidth":180,"PhotoHeight":161,"PhotoType":"custom"},"FormattedName":"lyna89","Id":266841,"Name":"lyna89","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":73377,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b23201d479b8eb9b046751dde292656e","RawContent":"&lt;p&gt; Thanks for the link to cruise critic, I too am apprehensive about not being able to \"control\" all the planning. I will check it out. I like to at least know what to expect so that I am able to prepare accordingly.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I have done 21 cruises and this will be my first wedding aboard one. Alot can happen in the 5 hours that has to accommodate getting to the ship, getting ready, the ceremony and the reception all in time for the mandatory boat drill....ugh! It just seems like not enough time for the wedding experience. (I have been to some wedding that last like 6-8 hours.) Even so, I have always wanted a cruise wedding, so I am gonna do it!&lt;\/p&gt; &lt;p&gt; As far as cruising, once the cruise has started, you can do as little or as much as you like. The atmosphere is laid back and the cruise line gives you a daily itenerary the night before so you can plan your next days events.&lt;\/p&gt;","Attachments":[],"Id":1737624,"PostDate":1364072269,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Thanks for the link to cruise critic, I too am apprehensive about not being able to \"control\" all the planning. I will check it out. I like to at least know what to expect so that I am able to prepare accordingly.<\/p> <p> \u00a0<\/p> <p> I have done 21 cruises and this will be my first wedding aboard one. Alot can happen in the 5 hours that has to accommodate getting to the ship, getting ready, the ceremony and the reception all in time for the mandatory boat drill....ugh! It just seems like not enough time for the wedding experience. (I have been to some wedding that last like 6-8 hours.) Even so, I have always wanted a cruise wedding, so I am gonna do it!<\/p> <p> As far as cruising, once the cruise has started, you can do as little or as much as you like. The atmosphere is laid back and the cruise line gives you a daily itenerary the night before so you can plan your next days events.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mscheryl10@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1361001449,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-266139.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"mscheryl10","Id":266139,"Name":"mscheryl10","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":73377,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7c9bfabe05022c896e1d8675aae26f9a","RawContent":"[quote]\nOriginally Posted by [b]mscheryl10[\/b] \/img\/forum\/go_quote.gif\n \n \n Thanks for the link to cruise critic, I too am apprehensive about not being able to \"control\" all the planning. I will check it out. I like to at least know what to expect so that I am able to prepare accordingly. \n \n I have done 21 cruises and this will be my first wedding aboard one. Alot can happen in the 5 hours that has to accommodate getting to the ship, getting ready, the ceremony and the reception all in time for the mandatory boat drill....ugh! [b]It just seems like not enough time for the wedding experience[\/b]. (I have been to some wedding that last like 6-8 hours.) Even so, I have always wanted a cruise wedding, so I am gonna do it! \n As far as cruising, once the cruise has started, you can do as little or as much as you like. The atmosphere is laid back and the cruise line gives you a daily itenerary the night before so you can plan your next days events.[\/quote] \n I know what you mean! It&#039;s usual for the weddings in my family to last 6-8 hours so a wedding cruise reception for them will feel rushed if they are not sailing with us. But nevertheless I really want one as well! I have only been on 4 cruises but I am so in love with the experience.","Attachments":[],"Id":1737772,"PostDate":1364133232,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>mscheryl10<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <p> Thanks for the link to cruise critic, I too am apprehensive about not being able to \"control\" all the planning. I will check it out. I like to at least know what to expect so that I am able to prepare accordingly.<\/p> <p> \u00a0<\/p> <p> I have done 21 cruises and this will be my first wedding aboard one. Alot can happen in the 5 hours that has to accommodate getting to the ship, getting ready, the ceremony and the reception all in time for the mandatory boat drill....ugh! <strong>It just seems like not enough time for the wedding experience<\/strong>. (I have been to some wedding that last like 6-8 hours.) Even so, I have always wanted a cruise wedding, so I am gonna do it!<\/p> <p> As far as cruising, once the cruise has started, you can do as little or as much as you like. The atmosphere is laid back and the cruise line gives you a daily itenerary the night before so you can plan your next days events.<\/p> <\/blockquote> <p> I know what you mean! It's usual for the weddings in my family to last 6-8 hours so a wedding cruise reception for them will feel rushed if they are not sailing with us. But nevertheless I really want one as well! I have only been on 4 cruises but I am so in love with the experience. \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lyna_89_07@mugglenet.com","IpAddress":"172.8.174.118","GroupId":39,"GroupName":"Newbie","JoinDate":1362328691,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-266841.jpeg?_r=0","PhotoWidth":180,"PhotoHeight":161,"PhotoType":"custom"},"FormattedName":"lyna89","Id":266841,"Name":"lyna89","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":73377,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"31d7245fef66add72dcb8018217eedde","RawContent":"[color=#ff0099]Cruising is absolutely A-M-A-Z-I-N-G!!![\/color] \n [color=#ff0099]Hopefully, you, your FH and guests will enjoy it, as well. [\/color] \n \n [color=#ff0099]Have you decided which cruise with Carnival you want to go on? [\/color] [quote]\nOriginally Posted by [b]LueseeWin[\/b] \/img\/forum\/go_quote.gif\n \n \n Hi everyone, \n My Fiance and I want to plan a small cruise wedding with our closest friends and family for 2014. I personally never been on a cruise so I don&#039;t know what to expect. I read all the different packages Carnival has to offer and I just want to know what would be the best deals for small group about 10-15 people and kind of wanted to know the lay out of how everything is going to. We wanted to be kind of cheap and inexpensive for our guests so we to port from Orange County L.A. area since it is a lot closer to home.I can be kind of a control freak, so not knowing how the ceremony will go or reception wise is killing me. \n \n Please Help. Lucy[\/quote] \n \n [color=#ff0099]Thank you for the link on cruisecritic! Unfortunately there are not a lot of threads on here for cruise DW brides...and the few threads that are on here have very little chatter! [\/color][img]http:\/\/files.bestdestinationwedding.com\/images\/smilies\/sad.gif[\/img] [quote]\nOriginally Posted by [b]lyna89[\/b] \/img\/forum\/go_quote.gif\n \n \n Hi LueseeWin! \n &lt;p&gt; I personally don&#039;t have experience going a cruise wedding but am planning on one in the future. There isn&#039;t that much information on cruise weddings but I have read reviews on other bride&#039;s experiences! Have you looked on the cruise critic website? There is a section called \"Honeymoons and Wedding Cruises\" where there are a few recent reviews and information. Here is a link to a recent review from a Carnival cruise leaving Galveston, TX: \/img\/forum\/go_quote.gif\n \n \n I forgot to mention it also depends on whether you want your wedding on embarkation day (the day the ship is set to sail) or at one of the ports during the cruise. If you choose one of the ports, I&#039;ve heard of brides not going through the cruise line and using the resort planner or other destination wedding planner. I think Royal Caribbean and maybe another cruise line give the option to get married at sea (on a sea day), but it&#039;s more expensive than the other packages. \n \n As for the packages Carnival offers, I think it depends on what you want. Most of them (if not all) include up to 20 guests in their packages so you would not have to pay for extra people. I have heard that the luncheon is more of a sit down meal with the family and the deluxe package has more of the dancing and music with guests being able to eat your choice of different hot and cold hors d&#039;oeuvres during the reception.\n \n Ok now I&#039;m done! I hope I answered at least one of your questions![\/quote]","Attachments":[],"Id":1751243,"PostDate":1366985165,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <font color=\"#ff0099\">Cruising is absolutely A-M-A-Z-I-N-G!!!<\/font><\/p> <p> <font color=\"#ff0099\">Hopefully, you, your FH and guests will enjoy it, as well.\u00a0<\/font><\/p> <p> \u00a0<\/p> <p> <font color=\"#ff0099\">Have you decided which cruise with Carnival you want to go on?\u00a0<\/font><\/p> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>LueseeWin<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <p> Hi everyone,<\/p> <p> My Fiance and I want to plan a small cruise wedding with our closest friends and family for 2014. I personally never been on a cruise so I don't know what to expect. I read all the different packages Carnival has to offer and I just want to know what would be the best deals for small group about 10-15 people and kind of wanted to know the lay out of how everything is going to. We wanted to be kind of cheap and inexpensive for our guests so we to port from Orange County L.A. area since it is a lot closer to home.I can be kind of a control freak, so not knowing how the ceremony will go or reception wise is killing me.<\/p> <p> \u00a0<\/p> <p> Please Help. Lucy<\/p> <\/blockquote> <p> \u00a0<\/p> <p> <span  style=\"color:#ff0099\">Thank you for the link on cruisecritic! Unfortunately there are not a lot of threads on here for cruise DW brides...and the few threads that are on here have very little chatter!\u00a0<\/span><span rel='lightbox'><img class='bbc_img' id=\"yui_3_7_3_1_1367010205082_1809\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/sad.gif\" style=\"font-size: 13px; line-height: 1.231;\" \/><\/span><\/p> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>lyna89<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <p> Hi LueseeWin!<\/p> <p> \u00a0<\/p> <p> I personally don't have experience going a cruise wedding but am planning on one in the future. There isn't that much information on cruise weddings but I have read reviews on other bride's experiences! Have you looked on the cruise critic website? There is a section called \"Honeymoons and Wedding Cruises\" where there are a few recent reviews and information. Here is a link to a recent review from a Carnival cruise leaving Galveston, TX:\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <p> I forgot to mention it also depends on whether you want your wedding on embarkation day (the day the ship is set to sail) or at one of the ports during the cruise. If you choose one of the ports, I've heard of brides not going through the cruise line and using the resort planner or other destination wedding planner. I think Royal Caribbean and maybe another cruise line give the option to get married at sea (on a sea day), but it's more expensive than the other packages.\u00a0<br \/> <br \/> As for the packages Carnival offers, I think it depends on what you want. Most of them (if not all) include up to 20 guests in their packages so you would not have to pay for extra people. I have heard that the luncheon is more of a sit down meal with the family and the deluxe package has more of the dancing and music with guests being able to eat your choice of different hot and cold hors d'oeuvres during the reception.<br \/> <br \/> Ok now I'm done! I hope I answered at least one of your questions!<\/p> <\/blockquote>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Bride2be4414@gmail.com","IpAddress":"96.58.36.78","GroupId":40,"GroupName":"Jr. Member","JoinDate":1366284832,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268722.png?_r=0","PhotoWidth":200,"PhotoHeight":164,"PhotoType":"custom"},"FormattedName":"CAKnight","Id":268722,"Name":"CAKnight","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":73377,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"91e7c9128806c762c89ea157da4fb762","RawContent":"[quote]\nOriginally Posted by [b]CAKnight[\/b] \/img\/forum\/go_quote.gif\n \n \n [color=#ff0099]Thank you for the link on cruisecritic! Unfortunately there are not a lot of threads on here for cruise DW brides...and the few threads that are on here have very little chatter! [\/color][img]http:\/\/files.bestdestinationwedding.com\/images\/smilies\/sad.gif[\/img][\/quote] \n \n We can rebuild it, we can make it better, faster, stronger!!! [img]http:\/\/files.bestdestinationwedding.com\/images\/smilies\/wink.gif[\/img]","Attachments":[],"Id":1754291,"PostDate":1367608817,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>CAKnight<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <p> <span  style=\"color:#ff0099\">Thank you for the link on cruisecritic! Unfortunately there are not a lot of threads on here for cruise DW brides...and the few threads that are on here have very little chatter!\u00a0<\/span><span rel='lightbox'><img class='bbc_img' id=\"yui_3_7_3_1_1367010205082_1809\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/sad.gif\" style=\"font-size: 13px; line-height: 1.231;\" \/><\/span><\/p> <\/blockquote> <p> \u00a0<\/p> <p> We can rebuild it, we can make it better, faster, stronger!!!\u00a0<span rel='lightbox'><img class='bbc_img' id=\"yui_3_7_3_1_1367637536779_1513\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/wink.gif\" style=\"line-height: 1.231;\" \/><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"atlaeludlow@gmail.com","IpAddress":"98.234.104.236","GroupId":40,"GroupName":"Jr. Member","JoinDate":1367238386,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-269116.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"gresley","Id":269116,"Name":"gresley","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":73377,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"47f0724f699bf86a3b12d7c1fdfa0cff","RawContent":"[color=#ff0099]Yes, I agree with you, Gresley! :)[\/color] \n [quote]\nOriginally Posted by [b]gresley[\/b] \/img\/forum\/go_quote.gif\n \n \n \n We can rebuild it, we can make it better, faster, stronger!!! [img]http:\/\/files.bestdestinationwedding.com\/images\/smilies\/wink.gif[\/img][\/quote]","Attachments":[],"Id":1759129,"PostDate":1368883593,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <span  style=\"color:#ff0099\">Yes, I agree with you, Gresley! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/span><\/p> <p> \u00a0<\/p> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>gresley<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <p> \u00a0<\/p> <p> We can rebuild it, we can make it better, faster, stronger!!!\u00a0<span rel='lightbox'><img class='bbc_img' id=\"yui_3_7_3_1_1367637536779_1513\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/wink.gif\" style=\"line-height: 1.231;\" \/><\/span><\/p> <\/blockquote>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Bride2be4414@gmail.com","IpAddress":"96.58.36.78","GroupId":40,"GroupName":"Jr. Member","JoinDate":1366284832,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268722.png?_r=0","PhotoWidth":200,"PhotoHeight":164,"PhotoType":"custom"},"FormattedName":"CAKnight","Id":268722,"Name":"CAKnight","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":false,"TopicId":73377,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e5d9a8766e4cc33e55f2f300446660d4","RawContent":"&lt;p&gt; Carnival Cruises has a variety of dream wedding cruise packages including cruise ship weddings and &lt;strong&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.eventmanagementindia.com\"&gt;destination weddings&lt;\/a&gt;&lt;\/strong&gt; to make your special day. Thinking about getting married at sea? Our editor picks eight great cruise lines for onboard (and on-shore) weddings!&lt;\/p&gt;","Attachments":[],"Id":1788164,"PostDate":1375829729,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Carnival Cruises has a variety of dream wedding cruise packages including cruise ship weddings and <strong><a href='http:\/\/www.eventmanagementindia.com' class='bbc_url' title='External link' rel='nofollow external'>destination weddings<\/a><\/strong> to make your special day. Thinking about getting married at sea? Our editor picks eight great cruise lines for onboard (and on-shore) weddings!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"eventmanagementindia1@gmail.com","IpAddress":"","GroupId":5,"GroupName":"Banned","JoinDate":1374112664,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Davindane89","Id":271676,"Name":"Davindane89","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"69.117.93.162","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":73377,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cca834711e5ad11b0e267f1fbbcafaa5","RawContent":"Hope you guys weddings were awesome!","Attachments":[],"Id":1861359,"PostDate":1405962845,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hope you guys weddings were awesome!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bseasebey@yahoo.com","IpAddress":"69.117.93.162","GroupId":40,"GroupName":"Jr. Member","JoinDate":1402033168,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"SuchALady777","Id":278273,"Name":"SuchALady777","IsOnline":false}}],"Id":"73377","Title":"Cruise Wedding","LastPostDate":1422895201},"Pages":{"TotalItems":14,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
