riority=\"70\" SemiHidden=\"false\" UnhideWhenUsed=\"false\" Name=\"Dark List Accent 6\"\/&gt; &lt;w:LsdException Locked=\"false\" Priority=\"71\" SemiHidden=\"false\" UnhideWhenUsed=\"false\" Name=\"Colorful Shading Accent 6\"\/&gt; &lt;w:LsdException Locked=\"false\" Priority=\"72\" SemiHidden=\"false\" UnhideWhenUsed=\"false\" Name=\"Colorful List Accent 6\"\/&gt; &lt;w:LsdException Locked=\"false\" Priority=\"73\" SemiHidden=\"false\" UnhideWhenUsed=\"false\" Name=\"Colorful Grid Accent 6\"\/&gt; &lt;w:LsdException Locked=\"false\" Priority=\"19\" SemiHidden=\"false\" UnhideWhenUsed=\"false\" QFormat=\"true\" Name=\"Subtle Emphasis\"\/&gt; &lt;w:LsdException Locked=\"false\" Priority=\"21\" SemiHidden=\"false\" UnhideWhenUsed=\"false\" QFormat=\"true\" Name=\"Intense Emphasis\"\/&gt; &lt;w:LsdException Locked=\"false\" Priority=\"31\" SemiHidden=\"false\" UnhideWhenUsed=\"false\" QFormat=\"true\" Name=\"Subtle Reference\"\/&gt; &lt;w:LsdException Locked=\"false\" Priority=\"32\" SemiHidden=\"false\" UnhideWhenUsed=\"false\" QFormat=\"true\" Name=\"Intense Reference\"\/&gt; &lt;w:LsdException Locked=\"false\" Priority=\"33\" SemiHidden=\"false\" UnhideWhenUsed=\"false\" QFormat=\"true\" Name=\"Book Title\"\/&gt; &lt;w:LsdException Locked=\"false\" Priority=\"37\" Name=\"Bibliography\"\/&gt; &lt;w:LsdException Locked=\"false\" Priority=\"39\" QFormat=\"true\" Name=\"TOC Heading\"\/&gt; &lt;\/w:LatentStyles&gt; &lt;\/xml&gt;&lt;![endif]--&gt;&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;&lt;strong&gt;&lt;span style=\"color:#333333\"&gt;&lt;span style=\"font-size:small\"&gt;UNFORGETTABLE - $1,710 (Legal Ceremony) $1575 (Symbolic Ceremony)&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/p&gt; &lt;p&gt;&lt;!--[if gte mso 9]&gt;&lt;xml&gt; &lt;o:OfficeDocumentSettings&gt; &lt;o:TargetScreenSize&gt;800x600&lt;\/o:TargetScreenSize&gt; &lt;\/o:OfficeDocumentSettings&gt; &lt;\/xml&gt;&lt;![endif]--&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Civil wedding (judge fees, marriage license and certificate.) ***WHEN LEGAL WEDINGS**&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-align:justify; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Minister\u00e2\u20ac\u2122s Fee **When Symbolic Wedding (non legal)&amp;nbsp; -&amp;nbsp; Renewal of Vows**.&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Marriage ceremony with music from CD (couple may bring their own).&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Romantic Ornamental decoration of the wedding site, location will be assigned after arrival.&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Bride &amp;amp; Groom\u00e2\u20ac\u2122s bouquet &amp;amp; boutonniere (Tropical Local Flowers) \u00e2\u20ac\u201cjust for the couple -. &lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Fresh Elegant Floral Decor on Bridal Table&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Picturesque Wedding location \u00e2\u20ac\u201c may be celebrated on the beach or gazebo (upon confirmation)&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Music for the Ceremony with recorded CD ( couple may bring their own)&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-align:justify; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Champagne Luxury Toast after the ceremony with M\u00b6et Chandon (max. &amp;nbsp;4 bottles \u00e2\u20ac\u201c 1 p\/7 persons)&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-align:justify; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Sit-Down Dinner in one of our restaurants with set menu. (semi private)&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-align:justify; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Standard Wedding Cake for all wedding guests or dessert choice (dessert from our specialty restaurant menu, rather than the traditional wedding cake).&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-align:justify; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Room Upgrade for couple &amp;amp; parents (subject to availability upon arrival). &lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:.5in; text-align:justify; text-indent:-9.0pt\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;1 Newlywed\u00e2\u20ac\u2122s Romantic Breakfast in bed &amp;nbsp;(just for the couple)&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-align:justify; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Transfer to wedding location. (for the couple)&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-align:justify; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Romantic Candlelight Dinner with Reservation (wedding couple - must be requested before arrival)&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-align:justify; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Upgraded in-room Amenities \u00e2\u20ac\u201c ( for the couple &amp;amp; parents) &lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-align:justify; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Romantic decoration in couple\u00e2\u20ac\u2122s room ( welcome surprise)&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-align:justify; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Bottle of International wine will be served in the room upon arrival. (wedding couple)&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-align:justify; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Luxury Turn down service. (wedding couple &amp;amp; parents)&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-align:justify; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;15 professional full digital colored pictures of the wedding ceremony&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-align:justify; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;20% Discount on Spa treatments (except pedicure, manicure, hairdresser &amp;amp; makeup)&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-align:justify; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Late Check ( wedding couple &amp;amp; parents, upon request at check in &amp;amp; subject to availability)&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-align:justify; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Live Musical Trio (to play at ceremony or dinner)&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-align:justify; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Luxury Turn down service. (wedding couple &amp;amp; parents)&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-align:justify; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Professional Services of an Onsite Wedding Coordinator.&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-align:justify; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Witnesses ( if required)&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-align:justify; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;VIP Treatment for the couple&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;&lt;strong&gt;ROMANCE EXTRAVAGANZA - $3,140 (Legal Ceremony) $2,995 (Symbolic Ceremony)&lt;\/strong&gt;&lt;\/p&gt; &lt;p&gt;   - Maximum 30 people.&amp;nbsp; $40 each additional guest\n &lt;!--[if gte mso 9]&gt;&lt;xml&gt; &lt;o:OfficeDocumentSettings&gt; &lt;o:TargetScreenSize&gt;800x600&lt;\/o:TargetScreenSize&gt; &lt;\/o:OfficeDocumentSettings&gt; &lt;\/xml&gt;&lt;![endif]--&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-align:justify; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Civil wedding (judge fees, marriage license and certificate.) ***WHEN LEGAL WEDINGS**&lt;\/span&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Minister\u00e2\u20ac\u2122s Fee **When Symbolic Wedding (non legal)&amp;nbsp; -&amp;nbsp; Renewal of Vows**.&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Marriage ceremony with music from CD (couple may bring their own).&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Romantic Ornamental decoration of the wedding site, location will be assigned after arrival.&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Bride &amp;amp; Groom\u00e2\u20ac\u2122s bouquet &amp;amp; boutonniere (Tropical Local Flowers) \u00e2\u20ac\u201cjust for the couple -. &lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Fresh Elegant Floral Decor on Bridal Table&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Picturesque Wedding location \u00e2\u20ac\u201c may be celebrated on the beach or gazebo (upon confirmation)&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Music for the Ceremony with recorded CD ( couple may bring their own)&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-align:justify; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Champagne Luxury Toast after the ceremony with M\u00b6et Chandon (max.&amp;nbsp; 7 bottles \u00e2\u20ac\u201c 1 p\/7 persons)&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-align:justify; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;1 hour cocktails &amp;amp; canap\u00a9s served after the ceremony&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-align:justify; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;2 hours of open domestic bar after reception dinner&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-align:justify; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Sit-Down Dinner in one of our restaurants with set menu. (semi private)&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-align:justify; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Standard Wedding Cake for all wedding guests or dessert choice (dessert from our specialty restaurant menu, rather than the traditional wedding cake).&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-align:justify; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Room Upgrade for couple &amp;amp; parents (subject to availability upon arrival). &lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:.5in; text-align:justify; text-indent:-9.0pt\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;1 Newlywed\u00e2\u20ac\u2122s Romantic Breakfast in bed&amp;nbsp; (just for the couple)&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-align:justify; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Transfer to wedding location. (for the couple)&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-align:justify; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Romantic Candlelight Dinner with Reservation (wedding couple - must be requested before arrival)&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-align:justify; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Upgraded in-room Amenities \u00e2\u20ac\u201c ( for the couple &amp;amp; parents) &lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-align:justify; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Romantic decoration in couple\u00e2\u20ac\u2122s room ( welcome surprise)&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-align:justify; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Bottle of International wine will be served in the room upon arrival. (wedding couple)&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-align:justify; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Luxury Turn down service. (wedding couple &amp;amp; parents)&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-align:justify; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;25 professional full digital colored pictures of the wedding ceremony&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-align:justify; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;20% Discount on Spa treatments (except pedicure, manicure, hairdresser &amp;amp; makeup)&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-align:justify; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Manicure &amp;amp; Pedicure (for the Bride)&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-align:justify; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Late Check ( wedding couple &amp;amp; parents, upon request at check in &amp;amp; subject to availability)&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-align:justify; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Live Musical Trio (to play at ceremony or dinner)&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-align:justify; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Luxury Turn down service. (wedding couple &amp;amp; parents)&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-align:justify; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Professional Services of an Onsite Wedding Coordinator.&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-align:justify; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Witnesses ( if required)&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-align:justify; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;VIP Treatment for the couple &amp;amp; parents&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left:27.0pt; text-align:justify; text-indent:0in\"&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;   &lt;\/span&gt;&lt;span style=\"color:#333333\"&gt;Special Wedding Present from Bahia Principe ( 3 complimentary nights for your next reservation from may 1&lt;sup&gt;st&lt;\/sup&gt; to December 7&lt;sup&gt;th&lt;\/sup&gt;, 2014 ( minimum stay of 7 nights)&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt;&lt;!--[if gte mso 9]&gt;&lt;xml&gt; &lt;w:WordDocument&gt; &lt;w:View&gt;Normal&lt;\/w:View&gt; &lt;w:Zoom&gt;0&lt;\/w:Zoom&gt; &lt;w:TrackMoves\/&gt; &lt;w:TrackFormatting\/&gt; &lt;w:PunctuationKerning\/&gt; &lt;w:ValidateAgainstSchemas\/&gt; &lt;w:SaveIfXMLInvalid&gt;false&lt;\/w:SaveIfXMLInvalid&gt; &lt;w:IgnoreMixedContent&gt;false&lt;\/w:IgnoreMixedContent&gt; &lt;w:AlwaysShowPlaceholderText&gt;false&lt;\/w:AlwaysShowPlaceholderText&gt; &lt;w:DoNotPromoteQF\/&gt; &lt;w:LidThemeOther&gt;EN-US&lt;\/w:LidThemeOther&gt; &lt;w:LidThemeAsian&gt;X-NONE&lt;\/w:LidThemeAsian&gt; &lt;w:LidThemeComplexScript&gt;X-NONE&lt;\/w:LidThemeComplexScript&gt; &lt;w:Compatibility&gt; &lt;w:BreakWrappedTables\/&gt; &lt;w:SnapToGridInCell\/&gt; &lt;w:WrapTextWithPunct\/&gt; &lt;w:UseAsianBreakRules\/&gt; &lt;w:DontGrowAutofit\/&gt; &lt;w:SplitPgBreakAndParaMark\/&gt; &lt;w:EnableOpenTypeKerning\/&gt; &lt;w:DontFlipMirrorIndents\/&gt; &lt;w:OverrideTableStyleHps\/&gt; &lt;\/w:Compatibility&gt; &lt;w:BrowserLevel&gt;MicrosoftInternetExplorer4&lt;\/w:BrowserLevel&gt; &lt;m:mathPr&gt; &lt;m:mathFont m:val=\"Cambria Math\"\/&gt; &lt;m:brkBin m:val=\"before\"\/&gt; &lt;m:brkBinSub m:val=\"&#45;-\"\/&gt; &lt;m:smallFrac m:val=\"off\"\/&gt; &lt;m:dispDef\/&gt; &lt;m:lMargin m:val=\"0\"\/&gt; &lt;m:rMargin m:val=\"0\"\/&gt; &lt;m:defJc m:val=\"centerGroup\"\/&gt; &lt;m:wrapIndent m:val=\"1440\"\/&gt; &lt;m:intLim m:val=\"subSup\"\/&gt; &lt;m:naryLim m:val=\"undOvr\"\/&gt; &lt;\/m:mathPr&gt;&lt;\/w:WordDocument&gt; &lt;\/xml&gt;&lt;![endif]--&gt;&lt;!--[if gte mso 9]&gt;&lt;xml&gt; &lt;w:LatentStyles DefLockedState=\"false\" DefUnhideWhenUsed=\"true\" DefSemiHidden=\"true\" DefQFormat=\"false\" DefPriority=\"99\" LatentStyleCount=\"267\"&gt; &lt;w:LsdException Locked=\"false\" Priority=\"0\" SemiHidden=\"false\" UnhideWhenUsed=\"false\" QFormat=\"true\" Name=\"Normal\"\/&gt; &lt;w:LsdException Locked=\"false\" Priority=\"9\" SemiHidden=\"false\" UnhideWhenUsed=\"false\" QFormat=\"true\" Name=