5909,"Content":"Hello Rubyy,Welcome to BestDestinationWedding.com (BDW). BDW is the Ultimate Resource for plannin...","PostKey":"de954a8f666cc535349a12f9c839608c","CanDelete":false,"Attachments":[]},"IsRead":true,"IsDeleted":false,"TotalReplies":0,"Notifications":true,"CanReply":false}],"Pages":{"TotalItems":2,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":1,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
