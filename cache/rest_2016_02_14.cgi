51,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I am having my wedding at Dreams PC. If you purchase a private reception (cocktail or full dinner) the open bar is included.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Loving Married Life!<\/span><\/div><\/div>","Email":"ticia277@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1198918901,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208072.gif?_r=0","PhotoWidth":100,"PhotoHeight":54,"PhotoType":"custom"},"FormattedName":"ticia277","Id":208072,"Name":"ticia277","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":11205,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8808e914ab25757417998833246e4d87","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;ticia277&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;I am having my wedding at Dreams PC. If you purchase a private reception (cocktail or full dinner) the open bar is included.&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;Thx Ticia for the info. I was looking at the Melia as a possibility but if I wanted a private reception they would charge me extra for the open bar...it really added up!!","Attachments":[],"Id":191836,"PostDate":1202717331,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>ticia277<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">I am having my wedding at Dreams PC. If you purchase a private reception (cocktail or full dinner) the open bar is included.<\/div> <\/td> <\/tr> <\/table> <\/div>Thx Ticia for the info. I was looking at the Melia as a possibility but if I wanted a private reception they would charge me extra for the open bar...it really added up!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/im1.shutterfly.com\/media\/47b8cc39b3127ccec5b04ffd9d7100000060O08YaNWzVw4B7efCQ\/cC\/f%3D0\/ps%3D50\/r%3D0\/rx%3D400\/ry%3D300\/\">http:\/\/im1.shutterfly.com\/media\/47b8...D400\/ry%3D300\/<\/a><br><a data-ipb='nomedia