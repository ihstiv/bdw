tml>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>visit my wedsite @ <\/span><a data-ipb='nomediaparse' href=\"http:\/\/web.mac.com\/kimlemire\/Lemire_Lennon_wedsite\/How_we_Met.html\">http:\/\/web.mac.com\/kimlemire\/Lemire_...ow_we_Met.html<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;116\/st\/20090404\/e\/Our+Wedding\/k\/e37d\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...e37d\/event.png<\/a><br><span>28 Guests Booked so far!<\/span><\/div><\/div>","Email":"kimba1177@comcast.net","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1201082886,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208333.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"S2BLennon","Id":208333,"Name":"S2BLennon","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":11205,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"84622337632a7e502274893771c791b1","RawContent":"Hi Ladies, \n My wedding date is set for december 12 2008 .....I&#039;m so excited!!!.....have you recieved your wedding time yet?....I&#039;m having a civil wedding and the only time I could get was 7 pm....so it looks like I&#039;m having a night wedding.","Attachments":[],"Id":323736,"PostDate":1212300112,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r