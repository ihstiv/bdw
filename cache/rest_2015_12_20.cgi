Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":10,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":1739,"MovedTo":null,"MovedOn":0,"FirstPostId":1881268,"Rating":0,"RatingHits":0,"Starter":{"Id":281338,"Name":"sbodnar4","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1419897564,"LastPoster":{"Id":281338,"Name":"sbodnar4","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":38,"Preview":{"Id":1890675,"PostDate":1427236040,"PostContent":"Ladies please help!!!!! \u00a0 \u00a0 I do not know how to do speeches at all!!!!! \u00a0 who does speeches... h...","Author":{"Signature":"","Email":"stephbodnar4@gmail.com","IpAddress":"198.161.231.10","GroupId":39,"GroupName":"Newbie","JoinDate":1417989526,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"sbodnar4","Id":281338,"Name":"sbodnar4","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"198.161.231.10","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78518,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"e9f332a0b7ead2a05603757650e36031","RawContent":"&lt;p&gt;I am so soo soooo excited to finally say that our save the dates have been emailed!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I sent them out this morning and quickly had responses back.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I wanted to share with everyone the site I used for them because it was great. Its &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.paperlesspost.com&#039;&gt;https:\/\/www.paperlesspost.com&lt;\/a&gt;. It was great free tool. All you do is design your save the date, add a message to your guests, plug in their emails and tweek a few options for personal preference and send away! &lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;This is all just so exciting im glad things are all coming together... now to pick wedding colors and I will breath a sigh of relief!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1881268,"PostDate":1419897564,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I am so soo soooo excited to finally say that our save the dates have been emailed!<\/p>\n<p>\u00a0<\/p>\n<p>I sent them out this morning and quickly had responses back.<\/p>\n<p>\u00a0<\/p>\n<p>I wanted to share with everyone the site I used for them because it was great. Its <a href='https:\/\/www.paperlesspost.com' class='bbc_url' title='External link' rel='nofollow external'>https:\/\/www.paperlesspost.com<\/a>. It was great free tool. All you do is design your save the date, add a message to your guests, plug in their emails and tweek a few options for personal preference and send away! <\/p>\n<p>\u00a0<\/p>\n<p>This is all just so exciting im glad things are all coming together... now to pick wedding colors and I will breath a sigh of relief!<\/p>\n<p>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"stephbodnar4@gmail.com","IpAddress":"198.161.231.10","GroupId":39,"GroupName":"Newbie","JoinDate":1417989526,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"sbodnar4","Id":281338,"Name":"sbodnar4","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.202.225.11","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78518,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"b2737d0b02b3bf8dbbbfcaab565b2ef8","RawContent":"&lt;p&gt;congratulations on booking your date! &amp;nbsp;May is one of my favorite months in cabo. &amp;nbsp;I got married that time :)&lt;\/p&gt;","Attachments":[],"Id":1881276,"PostDate":1419904287,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>congratulations on booking your date! \u00a0May is one of my favorite months in cabo. \u00a0I got married that time <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-family:arial, helvetica, sans-serif;\">Founder and Owner of BestDestinationWedding.com \u00a0\/ \u00a0<\/span><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/'><strong><span style=\"font-family:arial, helvetica, sans-serif;\">Bride & Groom Fly FREE Promotion<\/span><\/strong><\/a><\/p>\n<p>\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><strong><a data-ipb='nomediaparse' href='http:\/\/wrighttravelagency.com\/inquiry\/'><span style=\"color:#008080;\">Looking for a travel agency that specializes in Destination Weddings<\/span><\/a><\/strong><span style=\"color:#008080;\"><strong>?<\/strong> \u00a0We are an award winning travel agency and you can <\/span><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style=\"color:#008080;\">read our reviews\u00a0here.<\/span><\/a><\/strong><\/span><br>\n\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"color:#008080;\"><strong>Awards and recognition:\u00a0<\/strong><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Palace Resorts Winner \"Top Travel Agent\", \"Top Homebased Travel Agency\" PRO Platinum Agency (Top Award) \u00a0 \u00a0 | \u00a0 \u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">AMResorts Master Agent & Top Agency \u00a0<\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/68050-karisma-hotels-givc-and-gi-wedding-consultants-wright-travel-agency\/'><strong>Wright Travel & Karisma GIVC Benefits<\/strong><\/a><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Travel Impressions Best of the Best Globe Winner \u00a0 \u00a0| \u00a0 \u00a0\u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Apple Vacations Golden Apple Winner \u00a0<\/span><\/span><br><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"> \u00a0 \u00a0<img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"font-size:14px;\"><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010'>Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><\/span><\/span><strong><span style=\"color:#b22222;\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a data-ipb='nomediaparse' href='mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com'>ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"admin@bestdestinationwedding.com","IpAddress":"71.202.225.11","GroupId":4,"GroupName":"Administrators","JoinDate":1137224220,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"FormattedName":"TammyWright","Id":206696,"Name":"TammyWright","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"69.42.28.220","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78518,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6958f5075fd76d8d9374da870fb0277a","RawContent":"&lt;p&gt;@[member=\"sbodnar4\"]&lt;\/p&gt;\n&lt;p&gt;Congratulations!&amp;nbsp; I&#039;m so glad there is another 2016 Riu Palace bride on here.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;That&#039;s great that you sent out your STD.&amp;nbsp; We have been seeing a lot of our guests for the holidays and everyone is excited about Cabo.&amp;nbsp; Since we are giving everyone a year and a half, we may have a big turnout.&amp;nbsp; I&#039;m still trying to work out our room block.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I have emailed Ana Maria and she has been responding quickly (usually within a day or two) although she had missed answering some questions as it looks like information is copied and pasted from the documents they have already sent me.&amp;nbsp; I understand they are very busy, but there are some things that are still unclear.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;For example, she emailed:&lt;\/p&gt;\n&lt;div style=\"font-family:verdana, sans-serif;\"&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div style=\"font-family:verdana, sans-serif;\"&gt;\"Unfortunately in order to have drinks at Baja Norte you need to have the open bar, the drinks are not included in the private reception. The open bar will include all the alcohol but it include non alcoholic beverages, sodas and juices as well.&lt;\/div&gt;\n&lt;div style=\"font-family:verdana, sans-serif;\"&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div style=\"font-family:verdana, sans-serif;\"&gt;The other option for you would be to have your dinner in one of our terraces. The site fee includes the menu from the restaurant and the regular drinks (beer, wine ,soda)\"&lt;\/div&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;When I read that I had to email back to get clarification because the way it&#039;s worded it sounds like they don&#039;t serve any drinks with dinner.&amp;nbsp; I just want to make sure water and soft drinks are served to our guests if we don&#039;t opt for the open bar.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;How many guests are you inviting and have you decided on a reception venue?&lt;\/p&gt;","Attachments":[],"Id":1881359,"PostDate":1420002340,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"281338\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281338-sbodnar4\/' title='Member profile'><span itemprop=\"name\">sbodnar4<\/span><\/a><\/p>\n<p>Congratulations!\u00a0 I'm so glad there is another 2016 Riu Palace bride on here.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>That's great that you sent out your STD.\u00a0 We have been seeing a lot of our guests for the holidays and everyone is excited about Cabo.\u00a0 Since we are giving everyone a year and a half, we may have a big turnout.\u00a0 I'm still trying to work out our room block.<\/p>\n<p>\u00a0<\/p>\n<p>I have emailed Ana Maria and she has been responding quickly (usually within a day or two) although she had missed answering some questions as it looks like information is copied and pasted from the documents they have already sent me.\u00a0 I understand they are very busy, but there are some things that are still unclear.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>For example, she emailed:<\/p>\n<div  style=\"font-family:verdana, sans-serif\">\u00a0<\/div>\n<div  style=\"font-family:verdana, sans-serif\">\"Unfortunately in order to have drinks at Baja Norte you need to have the open bar, the drinks are not included in the private reception. The open bar will include all the alcohol but it include non alcoholic beverages, sodas and juices as well.<\/div>\n<div  style=\"font-family:verdana, sans-serif\">\u00a0<\/div>\n<div  style=\"font-family:verdana, sans-serif\">The other option for you would be to have your dinner in one of our terraces. The site fee includes the menu from the restaurant and the regular drinks (beer, wine ,soda)\"<\/div>\n<p>\u00a0<\/p>\n<p>When I read that I had to email back to get clarification because the way it's worded it sounds like they don't serve any drinks with dinner.\u00a0 I just want to make sure water and soft drinks are served to our guests if we don't opt for the open bar.<\/p>\n<p>\u00a0<\/p>\n<p>How many guests are you inviting and have you decided on a reception venue?<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jrcorrales@gmail.com","IpAddress":"69.42.28.220","GroupId":39,"GroupName":"Newbie","JoinDate":1413956046,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280778.jpg?_r=1421562169","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"AmorDeMiVida","Id":280778,"Name":"AmorDeMiVida","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.101.83.185","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78518,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0f04a7aed4e70f263ece760607c5c80f","RawContent":"&lt;p&gt;Congrats and welcome! Cabo is beautiful! You&#039;ll find a ton of info here that will help you on your planning journey!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck and happy planning!&lt;\/p&gt;","Attachments":[],"Id":1881405,"PostDate":1420052750,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats and welcome! Cabo is beautiful! You'll find a ton of info here that will help you on your planning journey!<\/p>\n<p>\u00a0<\/p>\n<p>Good luck and happy planning!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283458999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"198.161.231.10","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78518,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"74a8902d45b0ee9aa87573a201191f31","RawContent":"&lt;span&gt;&lt;a  class=\"\" href=\"http:\/\/www.bestdestinationwedding.com\/user\/280778-amordemivida\/\" title=\"\"&gt;&lt;span&gt;@[member=\"AmorDeMiVida\"]&lt;\/span&gt;&lt;\/a&gt;&lt;\/span&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I really like the Baja Norte. However, I am conflicted on the bar service. I just cant get over the fact that we are in an all inclusive resort and we have to pay extra for a bar and alcohol. I understand its to pay for the staffs time there to work but $20 a person seems a little unreasonable to me.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We are expecting about 70. We have already had a few people tell us they couldnt come and had a few put their deposit down. I am hoping by giving everyone so much notice that this will result in more people coming. How many are you planning on having??&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Have you decided on wedding colors yet? I am stuck on this one. I have some ideas but i keep changing my mind.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I feel like there is so much to do that things could get a little crazy in the upcoming months!&lt;\/p&gt;","Attachments":[],"Id":1881497,"PostDate":1420207901,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                \n\t<span><a  class=\"\" href=\"http:\/\/www.bestdestinationwedding.com\/user\/280778-amordemivida\/\" title=\"\"><span>@<a hovercard-ref=\"member\" hovercard-id=\"280778\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/280778-amordemivida\/' title='Member profile'><span itemprop=\"name\">AmorDeMiVida<\/span><\/a><\/span><\/a><\/span>\n<p>\u00a0<\/p>\n<p>I really like the Baja Norte. However, I am conflicted on the bar service. I just cant get over the fact that we are in an all inclusive resort and we have to pay extra for a bar and alcohol. I understand its to pay for the staffs time there to work but $20 a person seems a little unreasonable to me.<\/p>\n<p>\u00a0<\/p>\n<p>We are expecting about 70. We have already had a few people tell us they couldnt come and had a few put their deposit down. I am hoping by giving everyone so much notice that this will result in more people coming. How many are you planning on having??<\/p>\n<p>\u00a0<\/p>\n<p>Have you decided on wedding colors yet? I am stuck on this one. I have some ideas but i keep changing my mind.<\/p>\n<p>\u00a0<\/p>\n<p>I feel like there is so much to do that things could get a little crazy in the upcoming months!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"stephbodnar4@gmail.com","IpAddress":"198.161.231.10","GroupId":39,"GroupName":"Newbie","JoinDate":1417989526,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"sbodnar4","Id":281338,"Name":"sbodnar4","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.15.193.73","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78518,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ca7aecf1eef13f5d001351128fadc38f","RawContent":"&lt;p&gt;I am getting married at the Riu Santa Fe in July. I&#039;m going to share our current plans incase anyone has questions or needs suggestions! We currently have 65 guests booked and may have up to 20 more guests (they have until March to book). We are getting married on the beach and having&amp;nbsp;a semi-private dinner at one of the restaurants that overlook the ocean. Our dinner will take place&amp;nbsp;during sunset which should turn out nice! Being that we have so many guests,&amp;nbsp;I doubt we will even notice the other guests that may be at the restaurant. This option is nice because you don&#039;t have to pay per plate (although we do have a fee for each guest over the amount allotted in our wedding package). After dinner, we are going to one of the reception areas. We have to pay the reception fee of $600. We are having open bar there for 3 hours ($18pp). We are also having a DJ there. This helped a lot with costs because the dinner was included so paying for the open bar wasn&#039;t much of a problem then. Hope this helps!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1881617,"PostDate":1420300054,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I am getting married at the Riu Santa Fe in July. I'm going to share our current plans incase anyone has questions or needs suggestions! We currently have 65 guests booked and may have up to 20 more guests (they have until March to book). We are getting married on the beach and having\u00a0a semi-private dinner at one of the restaurants that overlook the ocean. Our dinner will take place\u00a0during sunset which should turn out nice! Being that we have so many guests,\u00a0I doubt we will even notice the other guests that may be at the restaurant. This option is nice because you don't have to pay per plate (although we do have a fee for each guest over the amount allotted in our wedding package). After dinner, we are going to one of the reception areas. We have to pay the reception fee of $600. We are having open bar there for 3 hours ($18pp). We are also having a DJ there. This helped a lot with costs because the dinner was included so paying for the open bar wasn't much of a problem then. Hope this helps!<\/p>\n<p>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jenna32schap@yahoo.com","IpAddress":"75.97.32.162","GroupId":39,"GroupName":"Newbie","JoinDate":1394387100,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277065.jpg?_r=1438546602","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"jenna32schap","Id":277065,"Name":"jenna32schap","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"69.42.28.220","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78518,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2cb59beff8a91393bb17fbaec77267be","RawContent":"[quote name=\"sbodnar4\" post=\"1881497\" timestamp=\"1420207901\"]\n[url=\"http:\/\/www.bestdestinationwedding.com\/user\/280778-amordemivida\/\"]@[member=\"AmorDeMiVida\"][\/url]\n\nI really like the Baja Norte. However, I am conflicted on the bar service. I just cant get over the fact that we are in an all inclusive resort and we have to pay extra for a bar and alcohol. I understand its to pay for the staffs time there to work but $20 a person seems a little unreasonable to me.\n\nWe are expecting about 70. We have already had a few people tell us they couldnt come and had a few put their deposit down. I am hoping by giving everyone so much notice that this will result in more people coming. How many are you planning on having??\n\nHave you decided on wedding colors yet? I am stuck on this one. I have some ideas but i keep changing my mind.\n\nI feel like there is so much to do that things could get a little crazy in the upcoming months!\n[\/quote]\n@[member=\"sbodnar4\"]\nWe are expecting about 60-70 guests out of the 90 invited.  Our color scheme will include coral, gold, peach and champagne.  I&#039;m planning on bringing our own decor instead of flower centerpieces and hanging paper lanterns\/lights.\n\nI agree that there is so much to do.  I started listing everything out and started a timeline.  Currently I have to finalize our room block and get that submitted to our TA, decide on our STD and get back on my workout routine lol.  We have our engagement photo shoot coming up and my 3 sisters are already asking when we&#039;re going bridal dress shopping.\n[quote name=\"jenna32schap\" post=\"1881617\" timestamp=\"1420300054\"]\nI am getting married at the Riu Santa Fe in July. I&#039;m going to share our current plans incase anyone has questions or needs suggestions! We currently have 65 guests booked and may have up to 20 more guests (they have until March to book). We are getting married on the beach and having a semi-private dinner at one of the restaurants that overlook the ocean. Our dinner will take place during sunset which should turn out nice! Being that we have so many guests, I doubt we will even notice the other guests that may be at the restaurant. This option is nice because you don&#039;t have to pay per plate (although we do have a fee for each guest over the amount allotted in our wedding package). After dinner, we are going to one of the reception areas. We have to pay the reception fee of $600. We are having open bar there for 3 hours ($18pp). We are also having a DJ there. This helped a lot with costs because the dinner was included so paying for the open bar wasn&#039;t much of a problem then. Hope this helps![\/quote]\nThanks for sharing @[member=\"jenna32schap\"].  A sunset dinner overlooking the ocean sounds perfect! That is a great idea to have the semi-private dinner then drinks and dancing at a private location.  That would be something I would consider, but probably not feasible at the Palace.  For the semi-private dinner the max is 40 people at both restaurants, San Jose and Mar de Cortes.","Attachments":[],"Id":1881662,"PostDate":1420325044,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>sbodnar4, on 02 January 2015 - 06:11 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p><span><a href='http:\/\/www.bestdestinationwedding.com\/user\/280778-amordemivida\/' class='bbc_url' title=''><span>@<a hovercard-ref=\"member\" hovercard-id=\"280778\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/280778-amordemivida\/' title='Member profile'><span itemprop=\"name\">AmorDeMiVida<\/span><\/a><\/span><\/a><\/span><\/p>\n<p>\u00a0<\/p>\n<p>I really like the Baja Norte. However, I am conflicted on the bar service. I just cant get over the fact that we are in an all inclusive resort and we have to pay extra for a bar and alcohol. I understand its to pay for the staffs time there to work but $20 a person seems a little unreasonable to me.<\/p>\n<p>\u00a0<\/p>\n<p>We are expecting about 70. We have already had a few people tell us they couldnt come and had a few put their deposit down. I am hoping by giving everyone so much notice that this will result in more people coming. How many are you planning on having??<\/p>\n<p>\u00a0<\/p>\n<p>Have you decided on wedding colors yet? I am stuck on this one. I have some ideas but i keep changing my mind.<\/p>\n<p>\u00a0<\/p>\n<p>I feel like there is so much to do that things could get a little crazy in the upcoming months!<\/p>\n<p>\u00a0<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"281338\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281338-sbodnar4\/' title='Member profile'><span itemprop=\"name\">sbodnar4<\/span><\/a><\/p>\n<p>We are expecting about 60-70 guests out of the 90 invited.\u00a0 Our color scheme will include coral, gold, peach and champagne.\u00a0 I'm planning on bringing our own decor instead of flower centerpieces and hanging paper lanterns\/lights.<\/p>\n<p>\u00a0<\/p>\n<p>I agree that there is so much to do.\u00a0 I started listing everything out and started a timeline.\u00a0 Currently I have to finalize our room block and get that submitted to our TA, decide on our STD and get back on my workout routine lol.\u00a0 We have our engagement photo shoot coming up and my 3 sisters are already asking when we're going bridal dress shopping.<\/p>\n<p>\u00a0<\/p>\n<p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>jenna32schap, on 03 January 2015 - 07:47 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>I am getting married at the Riu Santa Fe in July. I'm going to share our current plans incase anyone has questions or needs suggestions! We currently have 65 guests booked and may have up to 20 more guests (they have until March to book). We are getting married on the beach and having\u00a0a semi-private dinner at one of the restaurants that overlook the ocean. Our dinner will take place\u00a0during sunset which should turn out nice! Being that we have so many guests,\u00a0I doubt we will even notice the other guests that may be at the restaurant. This option is nice because you don't have to pay per plate (although we do have a fee for each guest over the amount allotted in our wedding package). After dinner, we are going to one of the reception areas. We have to pay the reception fee of $600. We are having open bar there for 3 hours ($18pp). We are also having a DJ there. This helped a lot with costs because the dinner was included so paying for the open bar wasn't much of a problem then. Hope this helps!<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>Thanks for sharing @<a hovercard-ref=\"member\" hovercard-id=\"277065\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277065-jenna32schap\/' title='Member profile'><span itemprop=\"name\">jenna32schap<\/span><\/a>.\u00a0 A sunset dinner overlooking the ocean sounds perfect! That is a great idea to have the semi-private dinner then drinks and dancing at a private location.\u00a0 That would be something I would consider, but probably not feasible at the Palace.\u00a0 For the semi-private dinner the max is 40 people at both restaurants, San Jose and Mar de Cortes.\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jrcorrales@gmail.com","IpAddress":"69.42.28.220","GroupId":39,"GroupName":"Newbie","JoinDate":1413956046,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280778.jpg?_r=1421562169","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"AmorDeMiVida","Id":280778,"Name":"AmorDeMiVida","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.202.6.92","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78518,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6ae3f49c128d0dd4c43d246c599f7e05","RawContent":"&lt;p&gt;Congrats!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am still trying to book my hotel and date for a 2016 Cabo wedding - look forward to following everyone&#039;s journey.&lt;\/p&gt;","Attachments":[],"Id":1883898,"PostDate":1422060216,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats!<\/p>\n<p>\u00a0<\/p>\n<p>I am still trying to book my hotel and date for a 2016 Cabo wedding - look forward to following everyone's journey.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"hilary.wren@mail.mcgill.ca","IpAddress":"24.202.6.92","GroupId":39,"GroupName":"Newbie","JoinDate":1421368114,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281741.jpg?_r=1421368589","PhotoWidth":200,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"HilaryMWren","Id":281741,"Name":"HilaryMWren","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.89.236.44","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78518,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"aff13f7b72369f281a4269d0eeb67470","RawContent":"&lt;p&gt;Congrats on choosing a resort, now the planning fun begins.&lt;\/p&gt;","Attachments":[],"Id":1885248,"PostDate":1423100111,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats on choosing a resort, now the planning fun begins.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"njwood000@gmail.com","IpAddress":"71.7.173.185","GroupId":40,"GroupName":"Jr. Member","JoinDate":1405824791,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Msmimi","Id":279087,"Name":"Msmimi","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"198.161.230.10","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78518,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"158d09e1420759d7c47607312555a096","RawContent":"&lt;p&gt;Ladies please help!!!!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I do not know how to do speeches at all!!!!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;who does speeches... how do we wlecome the families... any info please help!&lt;\/p&gt;","Attachments":[],"Id":1890675,"PostDate":1427236040,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Ladies please help!!!!!<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I do not know how to do speeches at all!!!!!<\/p>\n<p>\u00a0<\/p>\n<p>who does speeches... how do we wlecome the families... any info please help!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"stephbodnar4@gmail.com","IpAddress":"198.161.231.10","GroupId":39,"GroupName":"Newbie","JoinDate":1417989526,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"sbodnar4","Id":281338,"Name":"sbodnar4","IsOnline":false}}],"Id":"78518","Title":"Cabo 2016 Bride Officially Booked!","LastPostDate":1427236040},"Pages":{"TotalItems":10,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}