{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":37,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":20839,"MovedTo":null,"MovedOn":0,"FirstPostId":1622483,"Rating":0,"RatingHits":0,"Starter":{"Id":225954,"Name":"ellie0717","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-225954.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":false},"StartDate":1337635654,"LastPoster":{"Id":283868,"Name":"Kendia","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":74,"Preview":{"Id":1622483,"PostDate":1337635654,"PostContent":"We made passport invitations\u00a0to match the theme of our Kraft Paper Save-the-dates:  \u00a0  http:\/\/ww...","Author":{"Signature":"","Email":"ellie@cprcontractors.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1267154569,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-225954.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"ellie0717","Id":225954,"Name":"ellie0717","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":67667,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"54c456683208b1717165c07ab5903266","RawContent":"&lt;p&gt; &lt;span style=\"font-size: medium;\"&gt;&lt;span style=\"font-family: calibri;\"&gt;We made passport invitations&amp;nbsp;to match the theme of our Kraft Paper Save-the-dates:&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"2012 Save the Dates 069.JPG\" height=\"700\" src=\"http:\/\/cdn.bestdestinationwedding.com\/a\/a1\/467x700px-LL-a199159b_2012SavetheDates069.jpeg\" width=\"467\" \/&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: medium;\"&gt;&lt;span style=\"font-family: calibri;\"&gt;Below are the INVITATIONS:&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: medium;\"&gt;&lt;span style=\"font-family: calibri;\"&gt;I made the envelope liner and band by customizing a map that I found and just cutting and&lt;\/span&gt;&lt;\/span&gt;&lt;span style=\"font-size: medium;\"&gt;&lt;span style=\"font-family: calibri;\"&gt; glueing them into the envelope. I used glue dots for the bands.&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: medium;\"&gt;&lt;span style=\"font-family: calibri;\"&gt;&lt;a class=\"H-lightbox-open\" href=\"http:\/\/cdn.bestdestinationwedding.com\/a\/ad\/adb6d7f2_IphonePicsUploaded5.21.12324.jpeg\" target=\"_blank\"&gt;&lt;img alt=\"Iphone Pics Uploaded 5.21.12 324.JPG\" height=\"700\" src=\"http:\/\/cdn.bestdestinationwedding.com\/a\/ad\/525x700px-LL-adb6d7f2_IphonePicsUploaded5.21.12324.jpeg\" width=\"525\" \/&gt;&lt;\/a&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: medium;\"&gt;&lt;span style=\"font-family: calibri;\"&gt;My Fianc\u00a9 trying to help but his lines weren\u00e2\u20ac\u2122t exactly the quality I was hoping for &lt;span style=\"font-family: wingdings;\"&gt;J&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt; A for effort!&lt;\/p&gt; &lt;p&gt; &lt;a class=\"H-lightbox-open\" href=\"http:\/\/cdn.bestdestinationwedding.com\/0\/06\/0603f058_IphonePicsUploaded5.21.12323-Copy.jpeg\" target=\"_blank\"&gt;&lt;img alt=\"Iphone Pics Uploaded 5.21.12 323 - Copy.JPG\" height=\"700\" src=\"http:\/\/cdn.bestdestinationwedding.com\/0\/06\/525x700px-LL-0603f058_IphonePicsUploaded5.21.12323-Copy.jpeg\" width=\"525\" \/&gt;&lt;\/a&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;a class=\"H-lightbox-open\" href=\"http:\/\/cdn.bestdestinationwedding.com\/7\/7e\/7e909d9b_IphonePicsUploaded5.21.12321-Copy.jpeg\" target=\"_blank\"&gt;&lt;img alt=\"Iphone Pics Uploaded 5.21.12 321 - Copy.JPG\" height=\"700\" src=\"http:\/\/cdn.bestdestinationwedding.com\/7\/7e\/525x700px-LL-7e909d9b_IphonePicsUploaded5.21.12321-Copy.jpeg\" width=\"525\" \/&gt;&lt;\/a&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: medium;\"&gt;&lt;span style=\"font-family: calibri;\"&gt;&lt;a class=\"H-lightbox-open\" href=\"http:\/\/cdn.bestdestinationwedding.com\/7\/78\/78cc9812_IphonePicsUploaded5.21.12320-Copy.jpeg\" target=\"_blank\"&gt;&lt;img alt=\"Iphone Pics Uploaded 5.21.12 320 - Copy.JPG\" height=\"700\" src=\"http:\/\/cdn.bestdestinationwedding.com\/7\/78\/525x700px-LL-78cc9812_IphonePicsUploaded5.21.12320-Copy.jpeg\" width=\"525\" \/&gt;&lt;\/a&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: medium;\"&gt;&lt;span style=\"font-family: calibri;\"&gt;I created the first page on picmonkey.com, I wanted a unique invitation.&amp;nbsp; I think it worked well with the fun style of the passport invite.&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: medium;\"&gt;&lt;span style=\"font-family: calibri;\"&gt;&lt;a class=\"H-lightbox-open\" href=\"http:\/\/cdn.bestdestinationwedding.com\/c\/cd\/cd0158e8_IphonePicsUploaded5.21.12315-Copy.jpeg\" target=\"_blank\"&gt;&lt;img alt=\"Iphone Pics Uploaded 5.21.12 315 - Copy.JPG\" height=\"450\" src=\"http:\/\/cdn.bestdestinationwedding.com\/c\/cd\/600x450px-LL-cd0158e8_IphonePicsUploaded5.21.12315-Copy.jpeg\" width=\"600\" \/&gt;&lt;\/a&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: medium;\"&gt;&lt;span style=\"font-family: calibri;\"&gt;Below is the file of that page: (one of my FAVORITE QUOTES by DMB)&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: medium;\"&gt;&lt;span style=\"font-family: calibri;\"&gt;&lt;a class=\"H-lightbox-open\" href=\"http:\/\/cdn.bestdestinationwedding.com\/b\/bb\/bb1bc852_InviteFinalnopalmtree.jpeg\" target=\"_blank\"&gt;&lt;img alt=\"Invite Final no palm tree.jpg\" height=\"700\" src=\"http:\/\/cdn.bestdestinationwedding.com\/b\/bb\/522x700px-LL-bb1bc852_InviteFinalnopalmtree.jpeg\" width=\"522\" \/&gt;&lt;\/a&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;a class=\"H-lightbox-open\" href=\"http:\/\/cdn.bestdestinationwedding.com\/e\/e8\/e8a6874b_IphonePicsUploaded5.21.12324-Copy.jpeg\" target=\"_blank\"&gt;&lt;img alt=\"Iphone Pics Uploaded 5.21.12 324 - Copy.JPG\" height=\"700\" src=\"http:\/\/cdn.bestdestinationwedding.com\/e\/e8\/525x700px-LL-e8a6874b_IphonePicsUploaded5.21.12324-Copy.jpeg\" width=\"525\" \/&gt;&lt;\/a&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: medium;\"&gt;&lt;span style=\"font-family: calibri;\"&gt;I didn\u00e2\u20ac\u2122t have too much information to put into my invites because I put all prices and packages on our wedding website.  I used the  Aylee Designs Template for the passports:&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: medium;\"&gt;&lt;span style=\"font-family: calibri;\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p align=\"center\"&gt; &lt;span style=\"font-size: medium;\"&gt;&lt;span style=\"font-family: calibri;\"&gt;&lt;span style=\"font-size: medium;\"&gt;&lt;span style=\"font-family: times new roman;\"&gt;PASSPORT INVITATION TEMPLATE (4 pages)&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p align=\"center\"&gt; &lt;span style=\"font-size: medium;\"&gt;&lt;span style=\"font-family: calibri;\"&gt;&lt;span style=\"font-size: medium;\"&gt;&lt;span style=\"font-family: times new roman;\"&gt;by Aylee (www.ayleebits.com)&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: medium;\"&gt;&lt;span style=\"font-family: calibri;\"&gt;&lt;span style=\"font-size: medium;\"&gt;&lt;span style=\"font-family: times new roman;\"&gt;Page 1 (On the inside of the cover) Invitation&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: medium;\"&gt;&lt;span style=\"font-family: times new roman;\"&gt;Page 2 Fun Passport picture page&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: medium;\"&gt;&lt;span style=\"font-family: times new roman;\"&gt;Page 3 Accommodations&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: medium;\"&gt;&lt;span style=\"font-family: times new roman;\"&gt;Page 4 Travel&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: medium;\"&gt;&lt;span style=\"font-family: times new roman;\"&gt;Page 5 Passort Info&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: medium;\"&gt;&lt;span style=\"font-family: times new roman;\"&gt;Page 6 Letter to our guests&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: medium;\"&gt;&lt;span style=\"font-family: calibri;\"&gt;&lt;a class=\"H-lightbox-open\" href=\"http:\/\/cdn.bestdestinationwedding.com\/d\/d2\/d218d2ad_IphonePicsUploaded5.21.12454.jpeg\" target=\"_blank\"&gt;&lt;img alt=\"Iphone Pics Uploaded 5.21.12 454.JPG\" height=\"700\" src=\"http:\/\/cdn.bestdestinationwedding.com\/d\/d2\/525x700px-LL-d218d2ad_IphonePicsUploaded5.21.12454.jpeg\" width=\"525\" \/&gt;&lt;\/a&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;a class=\"H-lightbox-open\" href=\"http:\/\/cdn.bestdestinationwedding.com\/8\/8f\/8fffffb1_IphonePicsUploaded5.21.12455.jpeg\" target=\"_blank\"&gt;&lt;img alt=\"Iphone Pics Uploaded 5.21.12 455.JPG\" height=\"700\" src=\"http:\/\/cdn.bestdestinationwedding.com\/8\/8f\/525x700px-LL-8fffffb1_IphonePicsUploaded5.21.12455.jpeg\" width=\"525\" \/&gt;&lt;\/a&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: medium;\"&gt;&lt;span style=\"font-family: calibri;\"&gt;I made address labels to match the pages of the passport and then just hand wrote the address in:&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;a class=\"H-lightbox-open\" href=\"http:\/\/cdn.bestdestinationwedding.com\/5\/53\/539ca5fd_addresslabelss.jpeg\" target=\"_blank\"&gt;&lt;img alt=\"address labelss.jpg\" height=\"181\" src=\"http:\/\/cdn.bestdestinationwedding.com\/5\/53\/363x181px-LL-539ca5fd_addresslabelss.jpeg\" width=\"338\" \/&gt;&lt;\/a&gt;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"address labels with adress blocked.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/838983\/width\/525\/height\/700\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; RSVP POSTCARDS:&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I used one of our engagement pictures, microsoft paint, dafont.com &amp;amp; picmonkey.com to create the RSVP card, I then uploaded the front and back to vistaprint.com and was able to print 100 RSVP postcards for just the cost of uploading the 2 files and shipping!&lt;\/p&gt; &lt;p&gt; &lt;a class=\"H-lightbox-open\" href=\"http:\/\/cdn.bestdestinationwedding.com\/e\/e0\/e05cf4f2_IphonePicsUploaded5.21.12421.jpeg\" target=\"_blank\"&gt;&lt;img alt=\"Iphone Pics Uploaded 5.21.12 421.JPG\" height=\"465\" src=\"http:\/\/cdn.bestdestinationwedding.com\/e\/e0\/600x465px-LL-e05cf4f2_IphonePicsUploaded5.21.12421.jpeg\" width=\"600\" \/&gt;&lt;\/a&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"postcard with address blocked out.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/838985\/width\/600\/height\/465\" \/&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: medium;\"&gt;&lt;span style=\"font-family: calibri;\"&gt;I\u00e2\u20ac\u2122ve been working a crazy amount of hours and had no time to get my invites sent out. So one night last week when I was at the office late, my sister and personal attendant came and while I worked on work stuff they worked all night on the invites. Seriously I am so lucky with the people I have in my life!!&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: medium;\"&gt;&lt;span style=\"font-family: calibri;\"&gt;This entire project cost me just $39.00 because I was somehow able to utilize only supplies I already owned. I didn&#039;t even try to cut costs but in the end I realized that I&#039;d only&amp;nbsp;whipped out our wedding check card&amp;nbsp;twice! Once for the Postcard stamps (a had already saved up 100 regular stamps for the invites) and the second time for the shipping on the RSVP cards from Vistaprint. &lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: medium;\"&gt;&lt;span style=\"font-family: calibri;\"&gt;Other supplies I used but already had were:&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Kraft Paper Cardstock&lt;\/p&gt; &lt;p&gt; Brochure Paper (for inner pages)&lt;\/p&gt; &lt;p&gt; Avery 8163 shipping labels for addresses&lt;\/p&gt; &lt;p&gt; Avery 8293 1\" round labels for return addresses&lt;\/p&gt; &lt;p&gt; Reg paper for envelope liners and bands&lt;\/p&gt; &lt;p&gt; Envelopes (already had from a previous VistaPrint order)&lt;\/p&gt; &lt;p&gt; Staples&lt;\/p&gt; &lt;p&gt; Cutter&lt;\/p&gt; &lt;p&gt; Martha Stewart Boning Folder&lt;\/p&gt; &lt;p&gt; Forever Stamps&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I think that that is everything. Please let me know if you have any questions! Happy Planning Ladies!&lt;\/p&gt;","Attachments":[],"Id":1622483,"PostDate":1337635654,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <span  style=\"font-size: medium\"><span  style=\"font-family: calibri\">We made passport invitations\u00a0to match the theme of our Kraft Paper Save-the-dates:<\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"2012 Save the Dates 069.JPG\" height=\"700\" src=\"http:\/\/cdn.bestdestinationwedding.com\/a\/a1\/467x700px-LL-a199159b_2012SavetheDates069.jpeg\" width=\"467\" \/><\/span><\/p> <p> <span  style=\"font-size: medium\"><span  style=\"font-family: calibri\">Below are the INVITATIONS:<\/span><\/span><\/p> <p> <span  style=\"font-size: medium\"><span  style=\"font-family: calibri\">I made the envelope liner and band by customizing a map that I found and just cutting and<\/span><\/span><span  style=\"font-size: medium\"><span  style=\"font-family: calibri\"> glueing them into the envelope. I used glue dots for the bands.<\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: medium\"><span  style=\"font-family: calibri\"><a href='http:\/\/cdn.bestdestinationwedding.com\/a\/ad\/adb6d7f2_IphonePicsUploaded5.21.12324.jpeg' class='bbc_url' title='External link' rel='nofollow external'><span rel='lightbox'><img class='bbc_img' alt=\"Iphone Pics Uploaded 5.21.12 324.JPG\" height=\"700\" src=\"http:\/\/cdn.bestdestinationwedding.com\/a\/ad\/525x700px-LL-adb6d7f2_IphonePicsUploaded5.21.12324.jpeg\" width=\"525\" \/><\/span><\/a><\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: medium\"><span  style=\"font-family: calibri\">My Fianc\u00a9 trying to help but his lines weren\u00e2\u20ac\u2122t exactly the quality I was hoping for <span  style=\"font-family: wingdings\">J<\/span><\/span><\/span> A for effort!<\/p> <p> <a href='http:\/\/cdn.bestdestinationwedding.com\/0\/06\/0603f058_IphonePicsUploaded5.21.12323-Copy.jpeg' class='bbc_url' title='External link' rel='nofollow external'><span rel='lightbox'><img class='bbc_img' alt=\"Iphone Pics Uploaded 5.21.12 323 - Copy.JPG\" height=\"700\" src=\"http:\/\/cdn.bestdestinationwedding.com\/0\/06\/525x700px-LL-0603f058_IphonePicsUploaded5.21.12323-Copy.jpeg\" width=\"525\" \/><\/span><\/a><\/p> <p> \u00a0<\/p> <p> <a href='http:\/\/cdn.bestdestinationwedding.com\/7\/7e\/7e909d9b_IphonePicsUploaded5.21.12321-Copy.jpeg' class='bbc_url' title='External link' rel='nofollow external'><span rel='lightbox'><img class='bbc_img' alt=\"Iphone Pics Uploaded 5.21.12 321 - Copy.JPG\" height=\"700\" src=\"http:\/\/cdn.bestdestinationwedding.com\/7\/7e\/525x700px-LL-7e909d9b_IphonePicsUploaded5.21.12321-Copy.jpeg\" width=\"525\" \/><\/span><\/a><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: medium\"><span  style=\"font-family: calibri\"><a href='http:\/\/cdn.bestdestinationwedding.com\/7\/78\/78cc9812_IphonePicsUploaded5.21.12320-Copy.jpeg' class='bbc_url' title='External link' rel='nofollow external'><span rel='lightbox'><img class='bbc_img' alt=\"Iphone Pics Uploaded 5.21.12 320 - Copy.JPG\" height=\"700\" src=\"http:\/\/cdn.bestdestinationwedding.com\/7\/78\/525x700px-LL-78cc9812_IphonePicsUploaded5.21.12320-Copy.jpeg\" width=\"525\" \/><\/span><\/a><\/span><\/span><\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: medium\"><span  style=\"font-family: calibri\">I created the first page on picmonkey.com, I wanted a unique invitation.\u00a0 I think it worked well with the fun style of the passport invite.<\/span><\/span><\/p> <p> <span  style=\"font-size: medium\"><span  style=\"font-family: calibri\"><a href='http:\/\/cdn.bestdestinationwedding.com\/c\/cd\/cd0158e8_IphonePicsUploaded5.21.12315-Copy.jpeg' class='bbc_url' title='External link' rel='nofollow external'><span rel='lightbox'><img class='bbc_img' alt=\"Iphone Pics Uploaded 5.21.12 315 - Copy.JPG\" height=\"450\" src=\"http:\/\/cdn.bestdestinationwedding.com\/c\/cd\/600x450px-LL-cd0158e8_IphonePicsUploaded5.21.12315-Copy.jpeg\" width=\"600\" \/><\/span><\/a><\/span><\/span><\/p> <p> <span  style=\"font-size: medium\"><span  style=\"font-family: calibri\">Below is the file of that page: (one of my FAVORITE QUOTES by DMB)<\/span><\/span><\/p> <p> <span  style=\"font-size: medium\"><span  style=\"font-family: calibri\"><a href='http:\/\/cdn.bestdestinationwedding.com\/b\/bb\/bb1bc852_InviteFinalnopalmtree.jpeg' class='bbc_url' title='External link' rel='nofollow external'><span rel='lightbox'><img class='bbc_img' alt=\"Invite Final no palm tree.jpg\" height=\"700\" src=\"http:\/\/cdn.bestdestinationwedding.com\/b\/bb\/522x700px-LL-bb1bc852_InviteFinalnopalmtree.jpeg\" width=\"522\" \/><\/span><\/a><\/span><\/span><\/p> <p> \u00a0<\/p> <p> <a href='http:\/\/cdn.bestdestinationwedding.com\/e\/e8\/e8a6874b_IphonePicsUploaded5.21.12324-Copy.jpeg' class='bbc_url' title='External link' rel='nofollow external'><span rel='lightbox'><img class='bbc_img' alt=\"Iphone Pics Uploaded 5.21.12 324 - Copy.JPG\" height=\"700\" src=\"http:\/\/cdn.bestdestinationwedding.com\/e\/e8\/525x700px-LL-e8a6874b_IphonePicsUploaded5.21.12324-Copy.jpeg\" width=\"525\" \/><\/span><\/a><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: medium\"><span  style=\"font-family: calibri\">I didn\u00e2\u20ac\u2122t have too much information to put into my invites because I put all prices and packages on our wedding website.\u00a0\u00a0I used the\u00a0\u00a0Aylee Designs Template for the passports:<\/span><\/span><\/p> <p> <span  style=\"font-size: medium\"><span  style=\"font-family: calibri\">\u00a0<\/span><\/span><\/p> <p align=\"center\"> <span  style=\"font-size: medium\"><span  style=\"font-family: calibri\"><span  style=\"font-size: medium\"><span  style=\"font-family: times new roman\">PASSPORT INVITATION TEMPLATE (4 pages)<\/span><\/span><\/span><\/span><\/p> <p align=\"center\"> <span  style=\"font-size: medium\"><span  style=\"font-family: calibri\"><span  style=\"font-size: medium\"><span  style=\"font-family: times new roman\">by Aylee (www.ayleebits.com)<\/span><\/span><\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: medium\"><span  style=\"font-family: calibri\"><span  style=\"font-size: medium\"><span  style=\"font-family: times new roman\">Page 1 (On the inside of the cover) Invitation<\/span><\/span><\/span><\/span><\/p> <p> <span  style=\"font-size: medium\"><span  style=\"font-family: times new roman\">Page 2 Fun Passport picture page<\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: medium\"><span  style=\"font-family: times new roman\">Page 3 Accommodations<\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: medium\"><span  style=\"font-family: times new roman\">Page 4 Travel<\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: medium\"><span  style=\"font-family: times new roman\">Page 5 Passort Info<\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: medium\"><span  style=\"font-family: times new roman\">Page 6 Letter to our guests<\/span><\/span><\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: medium\"><span  style=\"font-family: calibri\"><a href='http:\/\/cdn.bestdestinationwedding.com\/d\/d2\/d218d2ad_IphonePicsUploaded5.21.12454.jpeg' class='bbc_url' title='External link' rel='nofollow external'><span rel='lightbox'><img class='bbc_img' alt=\"Iphone Pics Uploaded 5.21.12 454.JPG\" height=\"700\" src=\"http:\/\/cdn.bestdestinationwedding.com\/d\/d2\/525x700px-LL-d218d2ad_IphonePicsUploaded5.21.12454.jpeg\" width=\"525\" \/><\/span><\/a><\/span><\/span><\/p> <p> \u00a0<\/p> <p> <a href='http:\/\/cdn.bestdestinationwedding.com\/8\/8f\/8fffffb1_IphonePicsUploaded5.21.12455.jpeg' class='bbc_url' title='External link' rel='nofollow external'><span rel='lightbox'><img class='bbc_img' alt=\"Iphone Pics Uploaded 5.21.12 455.JPG\" height=\"700\" src=\"http:\/\/cdn.bestdestinationwedding.com\/8\/8f\/525x700px-LL-8fffffb1_IphonePicsUploaded5.21.12455.jpeg\" width=\"525\" \/><\/span><\/a><\/p> <p> <span  style=\"font-size: medium\"><span  style=\"font-family: calibri\">I made address labels to match the pages of the passport and then just hand wrote the address in:<\/span><\/span><\/p> <p> <a href='http:\/\/cdn.bestdestinationwedding.com\/5\/53\/539ca5fd_addresslabelss.jpeg' class='bbc_url' title='External link' rel='nofollow external'><span rel='lightbox'><img class='bbc_img' alt=\"address labelss.jpg\" height=\"181\" src=\"http:\/\/cdn.bestdestinationwedding.com\/5\/53\/363x181px-LL-539ca5fd_addresslabelss.jpeg\" width=\"338\" \/><\/span><\/a><\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"address labels with adress blocked.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/838983\/width\/525\/height\/700\" \/><\/span><\/p> <p> \u00a0<\/p> <p> RSVP POSTCARDS:<\/p> <p> \u00a0<\/p> <p> I used one of our engagement pictures, microsoft paint, dafont.com & picmonkey.com to create the RSVP card, I then uploaded the front and back to vistaprint.com and was able to print 100 RSVP postcards for just the cost of uploading the 2 files and shipping!<\/p> <p> <a href='http:\/\/cdn.bestdestinationwedding.com\/e\/e0\/e05cf4f2_IphonePicsUploaded5.21.12421.jpeg' class='bbc_url' title='External link' rel='nofollow external'><span rel='lightbox'><img class='bbc_img' alt=\"Iphone Pics Uploaded 5.21.12 421.JPG\" height=\"465\" src=\"http:\/\/cdn.bestdestinationwedding.com\/e\/e0\/600x465px-LL-e05cf4f2_IphonePicsUploaded5.21.12421.jpeg\" width=\"600\" \/><\/span><\/a><\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"postcard with address blocked out.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/838985\/width\/600\/height\/465\" \/><\/span><\/p> <p> <span  style=\"font-size: medium\"><span  style=\"font-family: calibri\">I\u00e2\u20ac\u2122ve been working a crazy amount of hours and had no time to get my invites sent out. So one night last week when I was at the office late, my sister and personal attendant came and while I worked on work stuff they worked all night on the invites. Seriously I am so lucky with the people I have in my life!!<\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: medium\"><span  style=\"font-family: calibri\">This entire project cost me just $39.00 because I was somehow able to utilize only supplies I already owned. I didn't even try to cut costs but in the end I realized that I'd only\u00a0whipped out our wedding check card\u00a0twice! Once for the Postcard stamps (a had already saved up 100 regular stamps for the invites) and the second time for the shipping on the RSVP cards from Vistaprint. <\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: medium\"><span  style=\"font-family: calibri\">Other supplies I used but already had were:<\/span><\/span><\/p> <p> \u00a0<\/p> <p> Kraft Paper Cardstock<\/p> <p> Brochure Paper (for inner pages)<\/p> <p> Avery 8163 shipping labels for addresses<\/p> <p> Avery 8293 1\" round labels for return addresses<\/p> <p> Reg paper for envelope liners and bands<\/p> <p> Envelopes (already had from a previous VistaPrint order)<\/p> <p> Staples<\/p> <p> Cutter<\/p> <p> Martha Stewart Boning Folder<\/p> <p> Forever Stamps<\/p> <p> \u00a0<\/p> <p> I think that that is everything. Please let me know if you have any questions! Happy Planning Ladies!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ellie@cprcontractors.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1267154569,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-225954.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"ellie0717","Id":225954,"Name":"ellie0717","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":67667,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7ffcf66afc91be77115c0f8e4d5e9237","RawContent":"&lt;p&gt; These are awesome!&amp;nbsp; Thanks for sharing!&lt;\/p&gt;","Attachments":[],"Id":1622523,"PostDate":1337640813,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> These are awesome!\u00a0 Thanks for sharing!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"annemariedesir@gmail.com","IpAddress":"","GroupId":47,"GroupName":"Site Supporter","JoinDate":1334682180,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-254131.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Adesir8","Id":254131,"Name":"Adesir8","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true