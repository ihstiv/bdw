img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Very cute! Yay for being creative because of this site. <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheer2.gif\" border=\"0\" alt=\"\" title=\"Cheer2\" class=\"inlineimg\" \/><\/span> I've gotten lots of good ideas from here and I am NOT creative at all. These ladies rock!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><strong>~Kelly<\/strong><br><br><strong>Our Awesome Wedding Pics:<\/strong><span> <\/span><a data-ipb='nomediaparse' href=\"http:\/\/www.delsolphotography.com\/weddings\/kelly&ron\/\">http:\/\/www.delsolphotography.com\/weddings\/kelly&ron\/<\/a><\/div><\/div>","Email":"kcoby@hotmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1211279995,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209491.jpg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"KLC77","Id":209491,"Name":"KLC77","IsOnline":false}}],"Pages":{"TotalItems":53,"TotalPages":6,"CurrentPage":20,"NextPage":30,"PreviousPage":10,"LastPage":50},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
