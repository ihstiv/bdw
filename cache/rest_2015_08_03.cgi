ca & Al - April 3, 2012 - St. Thomas, USVI<\/span><\/p><span><\/span><p><strong><span><em><a data-ipb='nomediaparse' href=\"http:\/\/www.bestdestinationwedding.com\/t\/78715\/aciretas-planning-journal-april-3-2012-cruise-wedding\">Planning Thread<\/a><\/em><\/span><\/strong><\/p><span><\/span><p><a data-ipb='nomediaparse' href=\"http:\/\/www.bestdestinationwedding.com\/t\/79320\/aciretas-wedding-ahr-pics\"><strong><span><em>Wedding & AHR Pics<\/em><\/span><\/strong><\/a><\/p><span><\/span><\/div><\/div>","Email":"ericataffs@gmail.com","IpAddress":"99.11.245.41","GroupId":47,"GroupName":"Site Supporter","JoinDate":1288624566,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-233628.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":197,"PhotoType":"custom"},"FormattedName":"acireta","Id":233628,"Name":"acireta","IsOnline":false}},"Posts":[],"Id":"65763","Title":"Pre-trip Packet: Passport, Packing List & Luggage Tags","LastPostDate":1424763141},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":87,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":5741,"MovedTo":null,"MovedOn":0,"FirstPostId":447728,"Rating":0,"RatingHits":0,"Starter":{"Id":210111,"Name":"mexicobride2009","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-210111.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"IsOnline":false},"StartDate":1221168008,"LastPoster":{"Id":282128,"Name":"JoannaBanana","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282128.jpg?_r=1435421499","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":74,"Preview":{"Id":447728,"PostDate":1221168008,"PostContent":"This is what I've been working on lately. I'm working on a pre-travel brochure to send to people...","Author":{"Signature":"","Email":"taraspurrier@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1214252125,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-210111.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"mexicobride2009","Id":210111,"Name":"mexicobride2009","IsOnline":false}},"Posts":[],"Id":"23512","Title":"My DIY stuff so far :)","LastPostDate":1424117410}],"Pages":{"TotalItems":2114,"TotalPages":141,"CurrentPage":15,"NextPage":30,"PreviousPage":0,"LastPage":2100},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
