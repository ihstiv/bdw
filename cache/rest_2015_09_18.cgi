{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":6,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":72,"MovedTo":null,"MovedOn":0,"FirstPostId":1904979,"Rating":0,"RatingHits":0,"Starter":{"Id":284851,"Name":"Natandjeff","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":true},"StartDate":1442581799,"LastPoster":{"Id":284851,"Name":"Natandjeff","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":true},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1905023,"PostDate":1442616654,"PostContent":"Jeff and I met in Cuba 7 years ago. We are both from GTA Canada. 2 years before he popped the que...","Author":{"Signature":"","Email":"natandjeffsayido@gmail.com","IpAddress":"70.27.71.58","GroupId":39,"GroupName":"Newbie","JoinDate":1442547781,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Natandjeff","Id":284851,"Name":"Natandjeff","IsOnline":true}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.114.67.24","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":false,"TopicId":79598,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"2e5292267149e5997f1cf96a2644857b","RawContent":"Jeff and I met in Cuba 7 years ago. We are both from GTA Canada. 2 years before he popped the question we thought about getting married in the Caribbean! All of our friends and family can&#039;t wait! We expect between 70-100 to come!\n\nWe met on August 24th! So we would like to get married on the same date! \n\nWe have looked at many resorts! But everything is so expensive! I&#039;m trying to find a resort which will only cost our guests between 1500-1800 Canadian 5 star, all inclusive! Is this possible? We do not prefer Cuba for our wedding due to poor variety of food and connection service ie. wifi\n\nWhere is the best place to go in August and a good bang for your buck? \n\nSo far my fave is Grand Riviera Princess in Mayan Riveria, but the cost is $1900 per person. Help!","Attachments":[],"Id":1904979,"PostDate":1442581799,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Jeff and I met in Cuba 7 years ago. We are both from GTA Canada. 2 years before he popped the question we thought about getting married in the Caribbean! All of our friends and family can't wait! We expect between 70-100 to come!<br>\nWe met on August 24th! So we would like to get married on the same date! <br>\nWe have looked at many resorts! But everything is so expensive! I'm trying to find a resort which will only cost our guests between 1500-1800 Canadian 5 star, all inclusive! Is this possible? We do not prefer Cuba for our wedding due to poor variety of food and connection service ie. wifi<br>\nWhere is the best place to go in August and a good bang for your buck? <br>\nSo far my fave is Grand Riviera Princess in Mayan Riveria, but the cost is $1900 per person. Help!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"natandjeffsayido@gmail.com","IpAddress":"70.27.71.58","GroupId":39,"GroupName":"Newbie","JoinDate":1442547781,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Natandjeff","Id":284851,"Name":"Natandjeff","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79598,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":true,"PostKey":"59213a5237391bfb7e4845c2897cdc39","RawContent":"&lt;p&gt;Congrats and welcome!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I definitely think it&#039;s more than possible to get what you are looking for in your budget. Have you been in contact with a Travel Agent yet? I&#039;d probably say that&#039;s your best bet right now.&lt;\/p&gt;\n&lt;p&gt;This forum is very helpful!!&lt;\/p&gt;","Attachments":[],"Id":1904984,"PostDate":1442585909,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats and welcome!!<\/p>\n<p>\u00a0<\/p>\n<p>I definitely think it's more than possible to get what you are looking for in your budget. Have you been in contact with a Travel Agent yet? I'd probably say that's your best bet right now.<\/p>\n<p>This forum is very helpful!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419441414,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1436293677","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.146.146.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79598,"EditedBy":"<strong>Edited by calgarybride2015, Today, 07:25 AM.<\/strong>","EditDate":1442589924,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":true,"PostKey":"e398377f5e35b72954f0b62e7790950b","RawContent":"Welcome!! \n\nI got engaged in Cuba so that country will always have a special place in my heart ... And well it&#039;s gorgeous. \n\n\nI agree with @[member=\"perianjay\"]\n\nYou should find a good travel agent. They will be able to get you a group rate for all your guests that could probably drive the price you see online right into your budget range. August is also off season so it&#039;s possible those prices will go down in a few more months. It&#039;s still almost a year away!!   Also with a group rate and those types of numbers you may see a lot of perks from your airline and possibly your resort, if the one you end up choosing does that sort of thing. (Ours had a free wedding package but lots give you free events or services) Good luck!!!\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1904990,"PostDate":1442589857,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Welcome!! <br>\nI got engaged in Cuba so that country will always have a special place in my heart ... And well it's gorgeous. <br><br>\nI agree with @<a hovercard-ref=\"member\" hovercard-id=\"281478\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281478-perianjay\/' title='Member profile'><span itemprop=\"name\">perianjay<\/span><\/a><br>\nYou should find a good travel agent. They will be able to get you a group rate for all your guests that could probably drive the price you see online right into your budget range. August is also off season so it's possible those prices will go down in a few more months. It's still almost a year away!!   Also with a group rate and those types of numbers you may see a lot of perks from your airline and possibly your resort, if the one you end up choosing does that sort of thing. (Ours had a free wedding package but lots give you free events or services) Good luck!!!<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399432202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.134.141.162","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79598,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":true,"PostKey":"73b544120405a054af80489964a0979e","RawContent":"&lt;p&gt;@[member=\"Natandjeff\"] Congrats!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I would definitely speak to a Travel Agent like&amp;nbsp;@[member=\"perianjay\"] and&amp;nbsp;@[member=\"calgarybride2015\"] said.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I was able to get my rate for 7 nights from Apr 26-May 3, 2016 at the Grand Bahia Principe Coba in Riviera Maya for $1259 pp. &amp;nbsp;It&#039;s a 4.5-5 star (depending where you look) So it is definitely possible. &amp;nbsp;I got my quote from Total Advantage Travel &amp;amp; Tours in Toronto.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck &amp;amp; keep us posted!&lt;\/p&gt;","Attachments":[],"Id":1904991,"PostDate":1442591457,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"284851\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/284851-natandjeff\/' title='Member profile'><span itemprop=\"name\">Natandjeff<\/span><\/a> Congrats!<\/p>\n<p>\u00a0<\/p>\n<p>I would definitely speak to a Travel Agent like\u00a0@<a hovercard-ref=\"member\" hovercard-id=\"281478\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281478-perianjay\/' title='Member profile'><span itemprop=\"name\">perianjay<\/span><\/a> and\u00a0@<a hovercard-ref=\"member\" hovercard-id=\"277873\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277873-calgarybride2015\/' title='Member profile'><span itemprop=\"name\">calgarybride2015<\/span><\/a> said.<\/p>\n<p>\u00a0<\/p>\n<p>I was able to get my rate for 7 nights from Apr 26-May 3, 2016 at the Grand Bahia Principe Coba in Riviera Maya for $1259 pp. \u00a0It's a 4.5-5 star (depending where you look) So it is definitely possible. \u00a0I got my quote from Total Advantage Travel & Tours in Toronto.<\/p>\n<p>\u00a0<\/p>\n<p>Good luck & keep us posted!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div><img src=\"http:\/\/\" alt=\"\"><\/div>\n<div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;32;116\/st\/20160430\/e\/we+say+I+do%21\/k\/8afc\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<\/div>\n<p>\u00a0<\/p>\n<p>My Planning Thread:<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79580-deecols-planning-thread-gbp-april-30th-2016\/#entry1904529'>http:\/\/www.bestdestinationwedding.com\/topic\/79580-deecols-planning-thread-gbp-april-30th-2016\/#entry1904529<\/a>","Email":"deannaproteau@hotmail.com","IpAddress":"207.134.141.162","GroupId":40,"GroupName":"Jr. Member","JoinDate":1421446169,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281751.jpg?_r=1442083173","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"deecol","Id":281751,"Name":"deecol","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"179.53.154.191","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79598,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"59100847c2a42874bfb568e09c6f0a7e","RawContent":"&lt;p&gt;Welcome to our forum community Natandjeff and Congrats on your upcoming dw!!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Our magnificent Mayan Riviera is certainly a very popular choice for wedding destinations and offers amazing options for everyone&#039;s spending plans!!!&lt;\/p&gt;\n&lt;p&gt;You can see what a beautiful backdrop the Grand Riviera Princess would make for your wedding day love story in photos as seen in these magical wedding moments that matter we captured there... &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10153088034599487.1073741921.18683524486&amp;amp;type=3&#039;&gt;Grand Riviera Princess Wedding Album:&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-atl3-1.xx.fbcdn.net\/hphotos-xpf1\/t31.0-8\/10991598_10153088036004487_7192033829563147234_o.jpg\" alt=\"10991598_10153088036004487_7192033829563\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-atl3-1.xx.fbcdn.net\/hphotos-xfp1\/t31.0-8\/10984165_10153088037854487_978619956832048698_o.jpg\" alt=\"10984165_10153088037854487_9786199568320\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-atl3-1.xx.fbcdn.net\/hphotos-xft1\/l\/t31.0-8\/10495823_10153088039654487_3785513967959091353_o.jpg\" alt=\"10495823_10153088039654487_3785513967959\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Wishing you happy research, and a wonderful journey ahead - cheers!!! team mtm :)&lt;\/p&gt;","Attachments":[],"Id":1904992,"PostDate":1442593579,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome to our forum community Natandjeff and Congrats on your upcoming dw!!!<\/p>\n<p>\u00a0<\/p>\n<p>Our magnificent Mayan Riviera is certainly a very popular choice for wedding destinations and offers amazing options for everyone's spending plans!!!<\/p>\n<p>You can see what a beautiful backdrop the Grand Riviera Princess would make for your wedding day love story in photos as seen in these magical wedding moments that matter we captured there... <a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10153088034599487.1073741921.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>Grand Riviera Princess Wedding Album:<\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-atl3-1.xx.fbcdn.net\/hphotos-xpf1\/t31.0-8\/10991598_10153088036004487_7192033829563147234_o.jpg\" alt=\"10991598_10153088036004487_7192033829563\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-atl3-1.xx.fbcdn.net\/hphotos-xfp1\/t31.0-8\/10984165_10153088037854487_978619956832048698_o.jpg\" alt=\"10984165_10153088037854487_9786199568320\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-atl3-1.xx.fbcdn.net\/hphotos-xft1\/l\/t31.0-8\/10495823_10153088039654487_3785513967959091353_o.jpg\" alt=\"10495823_10153088039654487_3785513967959\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>Wishing you happy research, and a wonderful journey ahead - cheers!!! team mtm <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280214260,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.114.68.247","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":false,"CanLike":false,"TopicId":79598,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3e5155585f4fc178dac319bf54467e77","RawContent":"Jeff and I met in Cuba 7 years ago. We are both from GTA Canada. 2 years before he popped the question we thought about getting married in the Caribbean! All of our friends and family can&#039;t wait! We expect between 70-100 to come!\n\n\nWe met on August 24th! So we would like to get married on the same date! \n\n\nWe have looked at many resorts! But everything is so expensive! I&#039;m trying to find a resort which will only cost our guests between 1500-1800 Canadian 5 star, all inclusive! Is this possible? We do not prefer Cuba for our wedding due to poor variety of food and connection service ie. wifi\n\n\nWhere is the best place to go in August and a good bang for your buck? \n\n\nSo far my fave is Grand Riviera Princess in Mayan Riveria, but the cost is $1900 per person. Help!\nThank you all for you comments. \n\nI am speaking with three travel agents actually!! ..shh haha \n\n\nSo far - $1850 per double occupancy is the best price for Aug 21-27 at Grand Riviera Princess! \n\n\nThe search continues!! \n\nI just really want white sand and turquoise water as the back drop :)","Attachments":[],"Id":1905023,"PostDate":1442616654,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Jeff and I met in Cuba 7 years ago. We are both from GTA Canada. 2 years before he popped the question we thought about getting married in the Caribbean! All of our friends and family can't wait! We expect between 70-100 to come!<br><br>\nWe met on August 24th! So we would like to get married on the same date! <br><br>\nWe have looked at many resorts! But everything is so expensive! I'm trying to find a resort which will only cost our guests between 1500-1800 Canadian 5 star, all inclusive! Is this possible? We do not prefer Cuba for our wedding due to poor variety of food and connection service ie. wifi<br><br>\nWhere is the best place to go in August and a good bang for your buck? <br><br>\nSo far my fave is Grand Riviera Princess in Mayan Riveria, but the cost is $1900 per person. Help!<br \/>Thank you all for you comments. <br>\nI am speaking with three travel agents actually!! ..shh haha <br><br>\nSo far - $1850 per double occupancy is the best price for Aug 21-27 at Grand Riviera Princess! <br><br>\nThe search continues!! <br>\nI just really want white sand and turquoise water as the back drop <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"natandjeffsayido@gmail.com","IpAddress":"70.27.71.58","GroupId":39,"GroupName":"Newbie","JoinDate":1442547781,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Natandjeff","Id":284851,"Name":"Natandjeff","IsOnline":true}}],"Id":"79598","Title":"Destination - August 2016? Help!","LastPostDate":1442616654},"Pages":{"TotalItems":6,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":2,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}