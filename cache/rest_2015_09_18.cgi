{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":6,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":72,"MovedTo":null,"MovedOn":0,"FirstPostId":1904979,"Rating":0,"RatingHits":0,"Starter":{"Id":284851,"Name":"Natandjeff","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":true},"StartDate":1442581799,"LastPoster":{"Id":284851,"Name":"Natandjeff","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":true},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":0,"PostDate":0,"PostContent":"","Author":{"Signature":"","Email":"","IpAddress":"","GroupId":0,"GroupName":"","JoinDate":0,"Photo":{"HasPhoto":false,"PhotoUrl":null,"PhotoWidth":0,"PhotoHeight":0,"PhotoType":""},"FormattedName":"","Id":0,"Name":"","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.114.68.247","IsFirstPost":false,"IsQueued":false,"IsVisible":false,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":false,"TopicId":79598,"EditedBy":null,"EditDate":0,"EditReason":null,"DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3e5155585f4fc178dac319bf54467e77","RawContent":"","Attachments":[],"Id":1905023,"PostDate":1442616654,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Jeff and I met in Cuba 7 years ago. We are both from GTA Canada. 2 years before he popped the question we thought about getting married in the Caribbean! All of our friends and family can't wait! We expect between 70-100 to come!<br><br>\nWe met on August 24th! So we would like to get married on the same date! <br><br>\nWe have looked at many resorts! But everything is so expensive! I'm trying to find a resort which will only cost our guests between 1500-1800 Canadian 5 star, all inclusive! Is this possible? We do not prefer Cuba for our wedding due to poor variety of food and connection service ie. wifi<br><br>\nWhere is the best place to go in August and a good bang for your buck? <br><br>\nSo far my fave is Grand Riviera Princess in Mayan Riveria, but the cost is $1900 per person. Help!<br \/>Thank you all for you comments. <br>\nI am speaking with three travel agents actually!! ..shh haha <br><br>\nSo far - $1850 per double occupancy is the best price for Aug 21-27 at Grand Riviera Princess! <br><br>\nThe search continues!! <br>\nI just really want white sand and turquoise water as the back drop <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"natandjeffsayido@gmail.com","IpAddress":"70.27.71.58","GroupId":39,"GroupName":"Newbie","JoinDate":1442547781,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Natandjeff","Id":284851,"Name":"Natandjeff","IsOnline":true}}],"Id":"79598","Title":"Destination - August 2016? Help!","LastPostDate":1442616654},"Pages":null,"PushNotifications":[{"Key":"notifications","Value":2,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
