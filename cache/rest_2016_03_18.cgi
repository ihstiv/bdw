Request Time: 0 seconds
{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.254.200.130","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79955,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"059f260c526a1477ea7bfdb18df1f267","RawContent":"&lt;p&gt;Hi everybody! I&#039;m a 2017 bride, but I already start making preparations for my wedding. I plan a destination wedding but still have no idea about the wedding venue. Anyone has some great ideas? I also would like to know your budget and wedding theme! xx~&lt;\/p&gt;","Attachments":[],"Id":1911247,"PostDate":1456295044,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi everybody! I'm a 2017 bride, but I already start making preparations for my wedding. I plan a destination wedding but still have no idea about the wedding venue. Anyone has some great ideas? I also would like to know your budget and wedding theme! xx~<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sherry_xlx@hotmail.com","IpAddress":"121.127.226.122","GroupId":39,"GroupName":"Newbie","JoinDate":1455702247,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"GloriaEvans","Id":286249,"Name":"GloriaEvans","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"200.68.137.204","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79955,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"94a0a3d72910f6f1548714ebf27d4705","RawContent":"Heyy!! Good luck. My theme.is coral and gold in a private villa. About my budget.....still worki g on it. I only have my budget for flowers and the venue itself. Looking for a caterer!! And music....\n\n\nEnviado desde mi SM-N910C mediante Tapatalk","Attachments":[],"Id":1911506,"PostDate":1456922611,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Heyy!! Good luck. My theme.is coral and gold in a private villa. About my budget.....still worki g on it. I only have my budget for flowers and the venue itself. Looking for a caterer!! And music....<br><br>\nEnviado desde mi SM-N910C mediante Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>ADRIANNE\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wub.png' class='bbc_emoticon' alt=':wub:' \/>\u00a0 \u00a0\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>WEDDING DATE JUNE 16 2016 \u00a0<\/p>\n<p>VILLA ALBATROZ CANCUN","Email":"eadrianne1990@gmail.com","IpAddress":"187.147.233.0","GroupId":39,"GroupName":"Newbie","JoinDate":1455587087,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286231.jpg?_r=1455591065","PhotoWidth":199,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Eadrianne1990","Id":286231,"Name":"Eadrianne1990","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"76.186.105.63","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79955,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"35d8d80dd8cd9641fe38538467f72810","RawContent":"Puerto Plata Dominican  at Lifestyle Holiday Resorts","Attachments":[],"Id":1911600,"PostDate":1457201454,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Puerto Plata Dominican  at Lifestyle Holiday Resorts\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"candance01@yahoo.com","IpAddress":"50.11.52.41","GroupId":39,"GroupName":"Newbie","JoinDate":1440948862,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284619.jpg?_r=1440956169","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"CandanceWilliams2be","Id":284619,"Name":"CandanceWilliams2be","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"64.231.184.57","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79955,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"30c532f761d9372003fc92834d760335","RawContent":"&lt;p&gt;What are you looking for in a wedding venue? Do you want something that has a nice beach? Do you want to have an all inclusive resort? What country\/region do you want?&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Making a list of what you want and don&#039;t want helps. &amp;nbsp;I had a list and then did my research and also went and did site-inspections\/ youtube video tours in the Riviera Maya area in Mexico which helped me figure out where to book my wedding.&lt;\/p&gt;","Attachments":[],"Id":1911695,"PostDate":1457561250,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>What are you looking for in a wedding venue? Do you want something that has a nice beach? Do you want to have an all inclusive resort? What country\/region do you want?\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Making a list of what you want and don't want helps. \u00a0I had a list and then did my research and also went and did site-inspections\/ youtube video tours in the Riviera Maya area in Mexico which helped me figure out where to book my wedding.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"falleneight@gmail.com","IpAddress":"70.26.14.237","GroupId":39,"GroupName":"Newbie","JoinDate":1441731031,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284728.jpg?_r=1448387511","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"OttawaBride2017","Id":284728,"Name":"OttawaBride2017","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"122.15.103.61","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79955,"EditedBy":"","EditDate":1458041535,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"46e9448c20e4c34ae0737a1da9636ea4","RawContent":"&lt;p&gt;I would prefer goa as my destination venue in India.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/bharatkirayabhandar.com\/&#039;&gt;http:\/\/bharatkirayabhandar.com\/&lt;\/a&gt;&lt;\/p&gt;","Attachments":[],"Id":1911904,"PostDate":1458041485,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I would prefer goa as my destination venue in India.<\/p>\n<p>\u00a0<\/p>\n<p><a href='http:\/\/bharatkirayabhandar.com\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/bharatkirayabhandar.com\/<\/a><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><a data-ipb='nomediaparse' href='http:\/\/www.bharatkirayabhandar.com\/'>http:\/\/www.bharatkirayabhandar.com\/<\/a>","Email":"priyamsharma73@hotmail.com","IpAddress":"122.15.103.61","GroupId":39,"GroupName":"Newbie","JoinDate":1450180104,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Priyam","Id":285595,"Name":"Priyam","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"69.157.81.30","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79955,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8dffd4b175b22b0c036e04a5b200872e","RawContent":"&lt;p&gt;Hello&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am getting married in October 2016. &amp;nbsp;We chose to have it at the Royalton Punta Cana, DR. &amp;nbsp;Our budget is $12000.00&lt;\/p&gt;\n&lt;p&gt;Hope that helps!&lt;\/p&gt;","Attachments":[],"Id":1911944,"PostDate":1458080328,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello\u00a0<\/p>\n<p>I am getting married in October 2016. \u00a0We chose to have it at the Royalton Punta Cana, DR. \u00a0Our budget is $12000.00<\/p>\n<p>Hope that helps!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nsramsingh@gmail.com","IpAddress":"174.114.203.239","GroupId":39,"GroupName":"Newbie","JoinDate":1454207922,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Natasha28","Id":286090,"Name":"Natasha28","IsOnline":false}}],"Pages":{"TotalItems":6,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
