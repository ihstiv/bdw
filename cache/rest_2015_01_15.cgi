Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":true,"CanReply":true,"CanFollow":true,"TotalPosts":5,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":192,"MovedTo":null,"MovedOn":0,"FirstPostId":1882472,"Rating":0,"RatingHits":0,"Starter":{"Id":281666,"Name":"Majix26","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":true},"StartDate":1420882945,"LastPoster":{"Id":281666,"Name":"Majix26","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":true},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1882989,"PostDate":1421308360,"PostContent":"Hey! Congrats on your engagement!  We have rented a 26 person villa in Reunion Resort for the wee...","Author":{"Signature":"","Email":"himojo86@aol.com","IpAddress":"207.164.255.140","GroupId":3,"GroupName":"Member","JoinDate":1420867657,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Majix26","Id":281666,"Name":"Majix26","IsOnline":true}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.100.196.75","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":false,"CanLike":true,"TopicId":78581,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d762d074cd15c17795c47c4c674c2324","RawContent":"Hey!\n\n I&#039;m very excited to have stumbled across this forum. I&#039;m getting married in October 2015 in Orlando, Florida.\n\n\nMy fianc\u00e9, Sean, and I got engaged last February after almost four years including two years living together in England. \n\n\nIdeally we wanted a Disney wedding, but realised there was just no way. So we have settled on a wedding just outside but having the funds to visit Disney lots throughout the week. \n\n\nHas anyone else done something similar?\n\n\nI&#039;m so excited!\n\nI&#039;m currently struggling with what to buy for our guests for their oot bags and especially for my bridesmaids and the groomsmen. Any assistance would be great!\n\nAre these then considered favours?\n\n\nI can&#039;t wait to get to know you ladies and start sharing ideas!\n\n\nMaj\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1882472,"PostDate":1420882945,"PostContent":"                <html>\r\n                  <head>\r\n                    <style type=\"\"text\/css\"\">\r\n                      body {\r\n                        font-size: 16px;\r\n                        font-family: Helvetica, Verdana;\r\n                      }\r\n                      img .bbc_img {\r\n                        width: 100%;\r\n                      }\r\n                    <\/style>\r\n                  <\/head>\r\n                  <body>\r\n                    Hey!<br>\n I'm very excited to have stumbled across this forum. I'm getting married in October 2015 in Orlando, Florida.<br><br>\nMy fianc\u00e9, Sean, and I got engaged last February after almost four years including two years living together in England. <br><br>\nIdeally we wanted a Disney wedding, but realised there was just no way. So we have settled on a wedding just outside but having the funds to visit Disney lots throughout the week. <br><br>\nHas anyone else done something similar?<br><br>\nI'm so excited!<br>\nI'm currently struggling with what to buy for our guests for their oot bags and especially for my bridesmaids and the groomsmen. Any assistance would be great!<br>\nAre these then considered favours?<br><br>\nI can't wait to get to know you ladies and start sharing ideas!<br><br>\nMaj<br><br><br>\nSent from my iPhone using Tapatalk\r\n                  <\/body>\r\n                <\/html>","Author":{"Signature":"","Email":"himojo86@aol.com","IpAddress":"207.164.255.140","GroupId":3,"GroupName":"Member","JoinDate":1420867657,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Majix26","Id":281666,"Name":"Majix26","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"73.43.233.7","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":78581,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"22eb3d7188c1c4c969dbb112cb0c2f34","RawContent":"&lt;p&gt;welcome to BDW! there&#039;s so much to see\/do in the Orlando area (it&#039;s my hometown).&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;the OOT could be favors, or you could do something separate as \"the wedding favor\" like a wine bottle topper, ornament, or various other trinkets. it&#039;s really up to you!&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;you could include things in the OOT bags like sunscreen, hand fans, cooling bandanas, and a tote bag to be carried around the parks themselves for your guests. it&#039;s really about including things you think your guests will use while they are on their trip. snacks, basic medication (aspirin, anti-diarrhea, etc.) - there&#039;s a lot of options out there.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1882482,"PostDate":1420892992,"PostContent":"                <html>\r\n                  <head>\r\n                    <style type=\"\"text\/css\"\">\r\n                      body {\r\n                        font-size: 16px;\r\n                        font-family: Helvetica, Verdana;\r\n                      }\r\n                      img .bbc_img {\r\n                        width: 100%;\r\n                      }\r\n                    <\/style>\r\n                  <\/head>\r\n                  <body>\r\n                    <p>welcome to BDW! there's so much to see\/do in the Orlando area (it's my hometown).\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>the OOT could be favors, or you could do something separate as \"the wedding favor\" like a wine bottle topper, ornament, or various other trinkets. it's really up to you!\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>you could include things in the OOT bags like sunscreen, hand fans, cooling bandanas, and a tote bag to be carried around the parks themselves for your guests. it's really about including things you think your guests will use while they are on their trip. snacks, basic medication (aspirin, anti-diarrhea, etc.) - there's a lot of options out there.\u00a0<\/p>\n\r\n                  <\/body>\r\n                <\/html>","Author":{"Signature":"<div>\u00a0<\/div>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/73076-official-el-dorado-royaleel-dorado-casitas-royale-thread\/'>Official El Dorado Royale\/El Dorado Casitas Royale Thread<\/a>\u00a0<---check here for all info about EDR\/EDCR<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'>Wright Travel Agency<\/a> <--for all your Destination Wedding needs! Contact the experts and reduce your stress.\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/5182-el-dorado-royale-edr-brides-post-here\/'>El Dorado Royale Brides Thread<\/a> <---come chat with other EDR brides<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/69372-allie-hs-edr-rm-mexico-11-5-2012-planning-thread\/'>AllieH's EDR 11-5-2012 Planning Thread<\/a> <--because it was so awesome","Email":"allisonmoore817@gmail.com","IpAddress":"75.20.174.181","GroupId":55,"GroupName":"Resort\/Area Ambassadors","JoinDate":1309629080,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-241884.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"AllieH","Id":241884,"Name":"AllieH","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"190.167.163.87","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":78581,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a1fe865895bd59663342de0944270a61","RawContent":"&lt;p&gt;Congrats on your upcoming Disney Wedding, Maj &amp;amp; Sean, and welcome to the forum!!! you&#039;ve come to the right place for lots of great ideas, info and support to help with your unique wedding planning decisons :)\n\n\nWishing you happy research, and all the best with your plans - cheers!!! team MTM&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/fbcdn-sphotos-e-a.akamaihd.net\/hphotos-ak-xfp1\/t31.0-8\/10550048_10152554171919487_661902947592730776_o.jpg\" alt=\"10550048_10152554171919487_6619029475927\"&gt;&lt;\/p&gt;","Attachments":[],"Id":1882522,"PostDate":1420963348,"PostContent":"                <html>\r\n                  <head>\r\n                    <style type=\"\"text\/css\"\">\r\n                      body {\r\n                        font-size: 16px;\r\n                        font-family: Helvetica, Verdana;\r\n                      }\r\n                      img .bbc_img {\r\n                        width: 100%;\r\n                      }\r\n                    <\/style>\r\n                  <\/head>\r\n                  <body>\r\n                    <p>Congrats on your upcoming Disney Wedding, Maj & Sean, and welcome to the forum!!! you've come to the right place for lots of great ideas, info and support to help with your unique wedding planning decisons <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br><br>\nWishing you happy research, and all the best with your plans - cheers!!! team MTM<\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' width='100%' src=\"https:\/\/fbcdn-sphotos-e-a.akamaihd.net\/hphotos-ak-xfp1\/t31.0-8\/10550048_10152554171919487_661902947592730776_o.jpg\" alt=\"10550048_10152554171919487_6619029475927\"><\/span><\/p>\n\r\n                  <\/body>\r\n                <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280181860,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.237.87.24","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":78581,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7d2e45dce54afce33ee0a8939dc80e87","RawContent":"&lt;p&gt;Congrats on setting the date! &amp;nbsp;And yay Disney! &amp;nbsp;We got engaged there this past October. I would love to have a Disney wedding but it is so $$$ and I worried it would stress me out making sure everyone had an awesome Disney experience (cause you know I love it so they have to love it right?! lol)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Wherabouts are &amp;nbsp;you tying the knot? I have seen someone have it on one of the decks at Fulton&#039;s at Downtown Disney although with the current transition to Disney Springs that would probably be less then ideal.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Are any of your guests going to be hitting the parks? If they are and never been or unfamiliar I would suggest including a chest sheet to the Disney parks in their OOT bags. Just a &#039;there will be lines, use the fastpass system, have a mickey bar..etc\"&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;For my bridesmaids I&#039;m currently planning to get some matching robes on etsy to wear while we get ready. Just clear an hour or two in your schedule and search wedding favors in etsy and you&#039;ll be overcome with ideas.&amp;nbsp; :D&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Congrats again!&lt;\/p&gt;","Attachments":[],"Id":1882606,"PostDate":1421004665,"PostContent":"                <html>\r\n                  <head>\r\n                    <style type=\"\"text\/css\"\">\r\n                      body {\r\n                        font-size: 16px;\r\n                        font-family: Helvetica, Verdana;\r\n                      }\r\n                      img .bbc_img {\r\n                        width: 100%;\r\n                      }\r\n                    <\/style>\r\n                  <\/head>\r\n                  <body>\r\n                    <p>Congrats on setting the date! \u00a0And yay Disney! \u00a0We got engaged there this past October. I would love to have a Disney wedding but it is so $$$ and I worried it would stress me out making sure everyone had an awesome Disney experience (cause you know I love it so they have to love it right?! lol)<\/p>\n<p>\u00a0<\/p>\n<p>Wherabouts are \u00a0you tying the knot? I have seen someone have it on one of the decks at Fulton's at Downtown Disney although with the current transition to Disney Springs that would probably be less then ideal.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Are any of your guests going to be hitting the parks? If they are and never been or unfamiliar I would suggest including a chest sheet to the Disney parks in their OOT bags. Just a 'there will be lines, use the fastpass system, have a mickey bar..etc\"<\/p>\n<p>\u00a0<\/p>\n<p>For my bridesmaids I'm currently planning to get some matching robes on etsy to wear while we get ready. Just clear an hour or two in your schedule and search wedding favors in etsy and you'll be overcome with ideas.\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/biggrin.png' class='bbc_emoticon' alt=':D' \/><\/p>\n<p>\u00a0<\/p>\n<p>Congrats again!<\/p>\n\r\n                  <\/body>\r\n                <\/html>","Author":{"Signature":"<p>Currently lurking on BDW just waiting on some info to help us decide on Punta Cana or Ottawa (which being 4-5 hours away is still destination right? Right? <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/blink.png' class='bbc_emoticon' alt=':blink:' \/>\u00a0)","Email":"seriouslyamber@gmail.com","IpAddress":"99.237.87.24","GroupId":39,"GroupName":"Newbie","JoinDate":1420744142,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281649.jpg?_r=1421027393","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"Everly","Id":281649,"Name":"Everly","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.100.196.75","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":78581,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"49af8ad365472c1a217c8cae360233a0","RawContent":"Hey! Congrats on your engagement! \n\n\nWe have rented a 26 person villa in Reunion Resort for the week of the wedding and will be having the ceremony and reception in the back yard.  We&#039;re hoping to do photos at Disney&#039;s Boardwalk while our guests enjoy mimosas and relax before the evening. \n\n\nI&#039;m unsure whether our guests will be going to disney, but I think that&#039;s a great idea! \n\n\nI love the getting ready outfits. I was thinking t-shirts but robes might be better. We&#039;ll probably also pay for all of the wedding party to do Mickey&#039;s Not So Scary Halloween Party and also I&#039;ll buy flipflops for the girls. \n\n\nI&#039;m currently researching make up artists for the day. My bridesmaids want to do their own makeup but in dreadful at it! \n\n\nI want to do mickey and Minnie Mouse ears for favours, do you think that&#039;s okay? Or do you think they&#039;d prefer sunglasses or candy? Lol. So many decisions!\n\n\n\n\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1882989,"PostDate":1421308360,"PostContent":"                <html>\r\n                  <head>\r\n                    <style type=\"\"text\/css\"\">\r\n                      body {\r\n                        font-size: 16px;\r\n                        font-family: Helvetica, Verdana;\r\n                      }\r\n                      img .bbc_img {\r\n                        width: 100%;\r\n                      }\r\n                    <\/style>\r\n                  <\/head>\r\n                  <body>\r\n                    Hey! Congrats on your engagement! <br><br>\nWe have rented a 26 person villa in Reunion Resort for the week of the wedding and will be having the ceremony and reception in the back yard.  We're hoping to do photos at Disney's Boardwalk while our guests enjoy mimosas and relax before the evening. <br><br>\nI'm unsure whether our guests will be going to disney, but I think that's a great idea! <br><br>\nI love the getting ready outfits. I was thinking t-shirts but robes might be better. We'll probably also pay for all of the wedding party to do Mickey's Not So Scary Halloween Party and also I'll buy flipflops for the girls. <br><br>\nI'm currently researching make up artists for the day. My bridesmaids want to do their own makeup but in dreadful at it! <br><br>\nI want to do mickey and Minnie Mouse ears for favours, do you think that's okay? Or do you think they'd prefer sunglasses or candy? Lol. So many decisions!<br><br><br><br><br><br><br>\nSent from my iPhone using Tapatalk\r\n                  <\/body>\r\n                <\/html>","Author":{"Signature":"","Email":"himojo86@aol.com","IpAddress":"207.164.255.140","GroupId":3,"GroupName":"Member","JoinDate":1420867657,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Majix26","Id":281666,"Name":"Majix26","IsOnline":true}}],"Id":"78581","Title":"Orlando, Florida Newbie Bride!","LastPostDate":1421308360},"Pages":{"TotalItems":5,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
