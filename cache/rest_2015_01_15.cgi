.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_2474.jpg' class='galattach galimageview sharedmedia_screenshot' title='PRO PALACE SPECIALIST AGENT PLATINUM Sm'  width='200' height='118'  alt='PRO PALACE SPECIALIST AGENT PLATINUM Sm' id='sml_image_view_77453' \/><\/a>\n<br \/><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"font-size:14px;\"><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010'>Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><\/span><\/span><strong><span style=\"color:#b22222;\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a data-ipb='nomediaparse' href='mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com'>ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"admin@bestdestinationwedding.com","IpAddress":"71.202.225.11","GroupId":4,"GroupName":"Administrators","JoinDate":1137195420,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"FormattedName":"TammyWright","Id":206696,"Name":"TammyWright","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"76.103.74.40","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":70337,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0de9b304ba1799b27352d68c1401288a","RawContent":"&lt;p&gt;I &amp;nbsp;am getting married in July 2014 at The Royal&lt;\/p&gt;","Attachments":[],"Id":1840335,"PostDate":1395701287,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I \u00a0am getting married in July 2014 at The Royal<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"gmgnubla@msn.com","IpAddress":"23.24.208.251","GroupId":39,"GroupName":"Newbie","JoinDate":1392135772,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"JGCwedding","Id":276641,"Name":"JGCwedding","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.217.89.208","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":70337,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"1464bb7e68bc05ff0ceb3642edf0908d","RawContent":"&lt;p&gt;For anyone getting married at The Royal PDC, don&#039;t worry, it will be fantastic! I just returned from there and had a beautiful wedding :)&lt;\/p&gt;","Attachments":[],"Id":1849771,"PostDate":1399826343,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>For anyone getting married at The Royal PDC, don't worry, it will be fantastic! I just returned from there and had a beautiful wedding <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"hunziker.simone@gmail.com","IpAddress":"66.190.138.116","GroupId":47,"GroupName":"Site Supporter","JoinDate":1362381148,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-266863.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Shunzik","Id":266863,"Name":"Shunzik","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"98.201.43.131","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":70337,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"ccdd141a3946f678bb5e18915b469074","RawContent":"&lt;p&gt;Anyone in search for a photographer needs to consider Octavio Montes. He was absolutely amazing at my wedding in Cancun. I think his work speaks for itself. My husband and I were so happy with choosing him as our photographer. So easy to work with and very creative. The following is his link: &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.octaviomontes.com\/&#039;&gt;http:\/\/www.OctavioMontes.com&lt;\/a&gt;&lt;\/p&gt;","Attachments":[{"Id":28209,"Name":"DPP_0429.JPG","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_06_2014\/post-277334-0-94218100-1402364992.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_06_2014\/post-277334-0-94218100-1402364992_thumb.jpg","Width":1000,"Height":667}],"Id":1854499,"PostDate":1402336377,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Anyone in search for a photographer needs to consider Octavio Montes. He was absolutely amazing at my wedding in Cancun. I think his work speaks for itself. My husband and I were so happy with choosing him as our photographer. So easy to work with and very creative. The following is his link: <a href='http:\/\/www.octaviomontes.com\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.OctavioMontes.com<\/a><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"myra.pena21@gmail.com","IpAddress":"206.83.48.110","GroupId":39,"GroupName":"Newbie","JoinDate":1395756643,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"myra21","Id":277334,"Name":"myra21","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"200.78.138.205","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":70337,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b86ed7bed91164260616525cbd6d5056","RawContent":"Hi ladies! I am at the resort now and they have set up for  a wedding, is it one of yours?","Attachments":[],"Id":1856914,"PostDate":1403702476,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi ladies! I am at the resort now and they have set up for  a wedding, is it one of yours?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>The Royal Playa del Carmen 12.11.10 \/ 46 people + bride & groom attended!!!!!<\/span><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f103\/our-key-card-holders-60637\/\">Our keycard holders w\/ template & pics<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/www.jadicaandraveyn.com\">www.jadicaandraveyn.com<\/a><\/div><\/div>","Email":"msglave@sbcglobal.net","IpAddress":"162.229.216.240","GroupId":3,"GroupName":"Member","JoinDate":1254149271,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-222084.jpg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"msglave","Id":222084,"Name":"msglave","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.209.95.8","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":70337,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9a4686fa8fbbb4d2a61100be604df0c8","RawContent":"&lt;p&gt;Referring back to my earlier post, we decided to contract with the Shine Band. So far the communication has been fantastic and they are really easy to work with and VERY quick with answering all my questions. &amp;nbsp;I will post after the wedding to give a full review of their services.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;To all the upcoming Royal Playa Del Carmen Brides, have you had a difficult time communicating with your off site coordinator?&lt;\/p&gt;","Attachments":[],"Id":1875831,"PostDate":1413384728,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Referring back to my earlier post, we decided to contract with the Shine Band. So far the communication has been fantastic and they are really easy to work with and VERY quick with answering all my questions. \u00a0I will post after the wedding to give a full review of their services.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>To all the upcoming Royal Playa Del Carmen Brides, have you had a difficult time communicating with your off site coordinator?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"samara66@aol.com","IpAddress":"71.52.36.225","GroupId":39,"GroupName":"Newbie","JoinDate":1388338713,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275780.jpg?_r=1419314753","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Sammiegirl66","Id":275780,"Name":"Sammiegirl66","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.217.89.246","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":70337,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"db9379255175d0af775acd860f2f359c","RawContent":"&lt;p&gt;My offsite coordinator took about 2-3 days to reply back.&lt;\/p&gt;","Attachments":[],"Id":1876216,"PostDate":1413722491,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>My offsite coordinator took about 2-3 days to reply back.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"hunziker.simone@gmail.com","IpAddress":"66.190.138.116","GroupId":47,"GroupName":"Site Supporter","JoinDate":1362381148,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-266863.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Shunzik","Id":266863,"Name":"Shunzik","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"187.153.64.121","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":70337,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6176ec319559cb6646bddc9bf6638319","RawContent":"&lt;p&gt;Congratulations! The Royal has the best location in Playa. It&#039;s the perfect spot for destination wedding. We love it so much that we moved our office 5 mins away from the resort!!!&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We would like to invite you to read our article \"Top Tips for WOW beach wedding Photos\" you can find it on the home page of the forum or by using the below link.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/wedding-tips\/c\/wedding-tips\/top-tips-for-wow-beach-wedding-photos-by-vincen-r2226&#039;&gt;http:\/\/www.bestdestinationwedding.com\/wedding-tips\/c\/wedding-tips\/top-tips-for-wow-beach-wedding-photos-by-vincen-r2226&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Here are some images from a recent Royal Playa del Carmen wedding we photographed.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"http:\/\/pixanphoto.com\/blog\/wp-content\/uploads\/2013\/06\/56WEDDING-PIXAN-PHOTO-MEL-KEV-.jpg\" alt=\"56WEDDING-PIXAN-PHOTO-MEL-KEV-.jpg\"&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"http:\/\/pixanphoto.com\/blog\/wp-content\/uploads\/2013\/06\/52WEDDING-PIXAN-PHOTO-MEL-KEV-.jpg\" alt=\"52WEDDING-PIXAN-PHOTO-MEL-KEV-.jpg\"&gt;&lt;img src=\"http:\/\/pixanphoto.com\/blog\/wp-content\/uploads\/2013\/06\/32WEDDING-PIXAN-PHOTO-MEL-KEV-.jpg\" alt=\"32WEDDING-PIXAN-PHOTO-MEL-KEV-.jpg\"&gt;&lt;img src=\"http:\/\/pixanphoto.com\/blog\/wp-content\/uploads\/2013\/06\/63WEDDING-PIXAN-PHOTO-MEL-KEV-.jpg\" alt=\"63WEDDING-PIXAN-PHOTO-MEL-KEV-.jpg\"&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"http:\/\/pixanphoto.com\/blog\/wp-content\/uploads\/2013\/06\/67WEDDING-PIXAN-PHOTO-MEL-KEV-.jpg\" alt=\"67WEDDING-PIXAN-PHOTO-MEL-KEV-.jpg\"&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"http:\/\/pixanphoto.com\/blog\/wp-content\/uploads\/2013\/06\/51WEDDING-PIXAN-PHOTO-MEL-KEV-.jpg\" alt=\"51WEDDING-PIXAN-PHOTO-MEL-KEV-.jpg\"&gt;&lt;img src=\"http:\/\/pixanphoto.com\/blog\/wp-content\/uploads\/2013\/06\/48WEDDING-PIXAN-PHOTO-MEL-KEV-.jpg\" alt=\"48WEDDING-PIXAN-PHOTO-MEL-KEV-.jpg\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck with the planning. If you have any question we are here to help.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1876320,"PostDate":1413814843,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congratulations! The Royal has the best location in Playa. It's the perfect spot for destination wedding. We love it so much that we moved our office 5 mins away from the resort!!!\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>We would like to invite you to read our article \"Top Tips for WOW beach wedding Photos\" you can find it on the home page of the forum or by using the below link.<\/p>\n<p>\u00a0<\/p>\n<p><a href='http:\/\/www.bestdestinationwedding.com\/wedding-tips\/c\/wedding-tips\/top-tips-for-wow-beach-wedding-photos-by-vincen-r2226' class='bbc_url' title=''>http:\/\/www.bestdesti...by-vincen-r2226<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Here are some images from a recent Royal Playa del Carmen wedding we photographed.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/pixanphoto.com\/blog\/wp-content\/uploads\/2013\/06\/56WEDDING-PIXAN-PHOTO-MEL-KEV-.jpg\" alt=\"56WEDDING-PIXAN-PHOTO-MEL-KEV-.jpg\"><\/span><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/pixanphoto.com\/blog\/wp-content\/uploads\/2013\/06\/52WEDDING-PIXAN-PHOTO-MEL-KEV-.jpg\" alt=\"52WEDDING-PIXAN-PHOTO-MEL-KEV-.jpg\"><\/span><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/pixanphoto.com\/blog\/wp-content\/uploads\/2013\/06\/32WEDDING-PIXAN-PHOTO-MEL-KEV-.jpg\" alt=\"32WEDDING-PIXAN-PHOTO-MEL-KEV-.jpg\"><\/span><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/pixanphoto.com\/blog\/wp-content\/uploads\/2013\/06\/63WEDDING-PIXAN-PHOTO-MEL-KEV-.jpg\" alt=\"63WEDDING-PIXAN-PHOTO-MEL-KEV-.jpg\"><\/span><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/pixanphoto.com\/blog\/wp-content\/uploads\/2013\/06\/67WEDDING-PIXAN-PHOTO-MEL-KEV-.jpg\" alt=\"67WEDDING-PIXAN-PHOTO-MEL-KEV-.jpg\"><\/span><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/pixanphoto.com\/blog\/wp-content\/uploads\/2013\/06\/51WEDDING-PIXAN-PHOTO-MEL-KEV-.jpg\" alt=\"51WEDDING-PIXAN-PHOTO-MEL-KEV-.jpg\"><\/span><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/pixanphoto.com\/blog\/wp-content\/uploads\/2013\/06\/48WEDDING-PIXAN-PHOTO-MEL-KEV-.jpg\" alt=\"48WEDDING-PIXAN-PHOTO-MEL-KEV-.jpg\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>Good luck with the planning. If you have any question we are here to help.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#696969;\"><span style=\"font-family:helvetica, sans-serif;\"><span style=\"font-size:9pt;\">Please <strong>click<\/strong> on the 5 thumbnail images below to view more info on each topic<\/span><\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.pixanphoto.com\/portfolio-1-weddings'><img src=\"http:\/\/pixanphoto.com\/blog\/wp-content\/uploads\/2014\/06\/01weddings-and-great-moments-pixan.jpg\" alt=\"01weddings-and-great-moments-pixan.jpg\"><\/a>\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.pixanphoto.com\/portfolio-7-trash-the-dress'><img src=\"http:\/\/pixanphoto.com\/blog\/wp-content\/uploads\/2014\/06\/amazing-trash-the-dress-pixan-photography.jpg\" alt=\"amazing-trash-the-dress-pixan-photograph\"><\/a>\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.pixanphoto.com'><img src=\"http:\/\/pixanphoto.com\/blog\/wp-content\/uploads\/2014\/06\/01pixan-photography-logo-bdwf.jpg\" alt=\"01pixan-photography-logo-bdwf.jpg\"><\/a>\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.pixanphoto.com'><img src=\"http:\/\/pixanphoto.com\/blog\/wp-content\/uploads\/2014\/06\/01download-our-wedding-welcome-guide-pixan.jpg\" alt=\"01download-our-wedding-welcome-guide-pix\"><\/a>\u00a0<a data-ipb='nomediaparse' href='http:\/\/mad.ly\/3112b4'><img src=\"http:\/\/pixanphoto.com\/blog\/wp-content\/uploads\/2014\/06\/01pixan-riviera-maya-honeymoon-photo-adventure.jpg\" alt=\"01pixan-riviera-maya-honeymoon-photo-adv\"><\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/pixanphoto'><img src=\"http:\/\/pixanphoto.com\/blog\/wp-content\/uploads\/2014\/04\/Facebook.png\" alt=\"Facebook.png\"><\/a><a data-ipb='nomediaparse' href='https:\/\/plus.google.com\/u\/0\/102756607804404106269\/posts'><img src=\"http:\/\/pixanphoto.com\/blog\/wp-content\/uploads\/2014\/04\/Google+.png\" alt=\"Google+.png\"><\/a><a data-ipb='nomediaparse' href='http:\/\/www.pinterest.com\/pixanphotograph\/'><img src=\"http:\/\/pixanphoto.com\/blog\/wp-content\/uploads\/2014\/04\/Pinterest.png\" alt=\"Pinterest.png\"><\/a><img src=\"http:\/\/pixanphoto.com\/blog\/wp-content\/uploads\/2014\/04\/Vimeo.png\" alt=\"Vimeo.png\"><a data-ipb='nomediaparse' href='http:\/\/skype'><img src=\"http:\/\/pixanphoto.com\/blog\/wp-content\/uploads\/2014\/04\/Skype.png\" alt=\"Skype.png\"><\/a><a data-ipb='nomediaparse' href='http:\/\/www.linkedin.com\/company\/pixan-photography'><img src=\"http:\/\/pixanphoto.com\/blog\/wp-content\/uploads\/2014\/04\/LinkedIn.png\" alt=\"LinkedIn.png\"><\/a><a data-ipb='nomediaparse' href='http:\/\/pixanphoto.com\/blog\/'><img src=\"http:\/\/pixanphoto.com\/blog\/wp-content\/uploads\/2014\/04\/Wordpress.png\" alt=\"Wordpress.png\"><\/a>\u00a0<strong><span style=\"color:rgb(245,177,71);\"><span style=\"font-family:helvetica, sans-serif;\"><span style=\"font-size:9pt;\">Vincent van den Berg<\/span><\/span><\/span><\/strong><strong><span style=\"color:rgb(94,94,94);\"><span style=\"font-family:helvetica, sans-serif;\"><span style=\"font-size:9pt;\">\u00a0|\u00a0<\/span><\/span><\/span><\/strong><a data-ipb='nomediaparse' href='http:\/\/www.pixanphoto.com'><strong><span style=\"color:rgb(133,126,119);\"><span style=\"font-family:helvetica, sans-serif;\"><span style=\"font-size:9pt;\">www.pixanphoto.com\u00a0<\/span><\/span><\/span><\/strong><\/a><strong><span style=\"font-family:helvetica, sans-serif;\"><span style=\"font-size:9pt;\">|\u00a0<\/span><\/span><\/strong><a data-ipb='nomediaparse' href='mailto:vincent@pixanphoto.com?subject=BDWF%20enquiry'><strong><span style=\"color:rgb(132,197,191);\"><span style=\"font-family:helvetica, sans-serif;\"><span style=\"font-size:9pt;\">vincent@pixanphoto.com<\/span><\/span><\/span><\/strong><\/a><\/p>\n<div>\n<div>\u00a0<\/div>\n<\/div>\n<p>\u00a0","Email":"vincent@pixanphoto.com","IpAddress":"200.79.230.62","GroupId":49,"GroupName":"Insiders","JoinDate":1396007012,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277385.jpg?_r=1412260548","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"VincentvandenBerg","Id":277385,"Name":"VincentvandenBerg","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.171.131.187","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":70337,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"445aae4827673a3e24f7bec2ed82990a","RawContent":"&lt;p&gt;Hello Ladies..&lt;\/p&gt;\n&lt;p&gt;I&#039;m recently engaged and were thinking of having a wedding here. I spoke with a travel agent and they seem to be pushing the karisma hotels on me, they are all really nice but a friend of mine went here and said she loved how close it was to 5th Ave. Anywho, without being too nosy can someone give me a ball park figure on what ther spent on their wedding for guest between 40-50.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thanks.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I get worried that cost here will be the same as cost if I stayed at home to do it.&lt;\/p&gt;","Attachments":[],"Id":1882893,"PostDate":1421237464,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello Ladies..<\/p>\n<p>I'm recently engaged and were thinking of having a wedding here. I spoke with a travel agent and they seem to be pushing the karisma hotels on me, they are all really nice but a friend of mine went here and said she loved how close it was to 5th Ave. Anywho, without being too nosy can someone give me a ball park figure on what ther spent on their wedding for guest between 40-50.<\/p>\n<p>\u00a0<\/p>\n<p>Thanks.<\/p>\n<p>\u00a0<\/p>\n<p>I get worried that cost here will be the same as cost if I stayed at home to do it.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jparedes1215@aol.com","IpAddress":"172.56.12.94","GroupId":39,"GroupName":"Newbie","JoinDate":1410962255,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"joacevedo15","Id":279880,"Name":"joacevedo15","IsOnline":false}}],"Id":"70337","Title":"Royal Playa Del Carmen 2014","LastPostDate":1421237464},"Pages":{"TotalItems":109,"TotalPages":11,"CurrentPage":100,"NextPage":-1,"PreviousPage":90,"LastPage":100},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}