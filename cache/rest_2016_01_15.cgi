{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":11,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":1048,"MovedTo":null,"MovedOn":0,"FirstPostId":1901711,"Rating":0,"RatingHits":0,"Starter":{"Id":284242,"Name":"SimpleBliss","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284242.jpg?_r=1439936957","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"StartDate":1438546951,"LastPoster":{"Id":232000,"Name":"acw271011","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1901711,"PostDate":1438546951,"PostContent":"Hello everyone! \u00a0 I am very glad to join the community here. I am in the midst of planning my own...","Author":{"Signature":"","Email":"ntruong5@alumni.uwo.ca","IpAddress":"75.155.45.68","GroupId":39,"GroupName":"Newbie","JoinDate":1438532023,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284242.jpg?_r=1439936957","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"SimpleBliss","Id":284242,"Name":"SimpleBliss","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.155.45.68","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79457,"EditedBy":"<strong>Edited by SimpleBliss, 02 August 2015 - 08:27 PM.<\/strong>","EditDate":1438547230,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d1706094e7039a06a96871516b40f1c9","RawContent":"&lt;p&gt;Hello everyone!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am very glad to join the community here. I am in the midst of planning my own wedding set tentatively for April 2016 in Playa Del Carmen, Mexico.&lt;\/p&gt;\n&lt;p&gt;Duration of our stay would be 5 days and 4 nights as my fiance cannot get anymore days off. Not planning to have anything too formal and all-inclusive resorts are not our thing. Our top two priorities are Food and Photography. Decor would be minimal, especially when you have the ocean as your background.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Through my research and price quotes I am getting discouraged that planning a destination wedding with under 20 guests is not possible for my small budget of $5000 - $10000. (Everyone is pretty much paying their own flights and accommodations to get there).&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Just &amp;nbsp;wondering if any other brides were able to pull this off with that amount. I am looking to have a semi-private to private beach ceremony.&lt;\/p&gt;\n&lt;p&gt;The reception could either be at the same venue or at a villa where my family and I would be staying at (this means we would need to hire catering)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;If not we could all just go out to a nice restaurant to have dinner?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Any feedback or advice would be greatly appreciated!&lt;\/p&gt;","Attachments":[],"Id":1901711,"PostDate":1438546951,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello everyone!<\/p>\n<p>\u00a0<\/p>\n<p>I am very glad to join the community here. I am in the midst of planning my own wedding set tentatively for April 2016 in Playa Del Carmen, Mexico.<\/p>\n<p>Duration of our stay would be 5 days and 4 nights as my fiance cannot get anymore days off. Not planning to have anything too formal and all-inclusive resorts are not our thing. Our top two priorities are Food and Photography. Decor would be minimal, especially when you have the ocean as your background.<\/p>\n<p>\u00a0<\/p>\n<p>Through my research and price quotes I am getting discouraged that planning a destination wedding with under 20 guests is not possible for my small budget of $5000 - $10000. (Everyone is pretty much paying their own flights and accommodations to get there).<\/p>\n<p>\u00a0<\/p>\n<p>Just \u00a0wondering if any other brides were able to pull this off with that amount. I am looking to have a semi-private to private beach ceremony.<\/p>\n<p>The reception could either be at the same venue or at a villa where my family and I would be staying at (this means we would need to hire catering)<\/p>\n<p>\u00a0<\/p>\n<p>If not we could all just go out to a nice restaurant to have dinner?<\/p>\n<p>\u00a0<\/p>\n<p>Any feedback or advice would be greatly appreciated!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ntruong5@alumni.uwo.ca","IpAddress":"75.155.45.68","GroupId":39,"GroupName":"Newbie","JoinDate":1438532023,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284242.jpg?_r=1439936957","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"SimpleBliss","Id":284242,"Name":"SimpleBliss","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.49.243.226","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79457,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b4fd7b5a25cab2e8bb076ee02cab3ef0","RawContent":"&lt;p&gt;@[member=\"SimpleBliss\"] Welcome and congrats on your engagement! Is your $5000-10 000 budget including travel costs for you and your fianc\u00e9? Are you completely opposed to having it at an all inclusive? My resort budget for 60 people for just the wedding was $6000 and we&#039;re definitely under that so it is possible but I know you mentioned the all inclusive thing isn&#039;t really your first choice.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;There are definitely other options too though (I unfortunately don&#039;t have any experience in that department however) with beach clubs, boat cruises and restaurants...not too sure on the range of costs there. @[member=\"acw271011\"] may be able to give some words of wisdom as she&#039;s planning a small reception off site.&lt;\/p&gt;","Attachments":[],"Id":1901714,"PostDate":1438552055,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"284242\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/284242-simplebliss\/' title='Member profile'><span itemprop=\"name\">SimpleBliss<\/span><\/a> Welcome and congrats on your engagement! Is your $5000-10 000 budget including travel costs for you and your fianc\u00e9? Are you completely opposed to having it at an all inclusive? My resort budget for 60 people for just the wedding was $6000 and we're definitely under that so it is possible but I know you mentioned the all inclusive thing isn't really your first choice.<\/p>\n<p>\u00a0<\/p>\n<p>There are definitely other options too though (I unfortunately don't have any experience in that department however) with beach clubs, boat cruises and restaurants...not too sure on the range of costs there. @<a hovercard-ref=\"member\" hovercard-id=\"232000\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/232000-acw271011\/' title='Member profile'><span itemprop=\"name\">acw271011<\/span><\/a> may be able to give some words of wisdom as she's planning a small reception off site.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>My planning thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78916-snswedding2016-planning-thread-jan-9-2016-azul-fives\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78916-snswedding2016-planning-thread-jan-9-2016-azul-fives\/<\/a><\/p>\n<p>\u00a0<\/p>\n<div><a class='bbc_url' href='http:\/\/www.TickerFactory.com\/'><\/div>\n<div><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10730;0\/st\/20160109\/e\/Our+Wedding\/k\/9fa9\/event.png\" alt=\"event.png\"><\/div>\n<div><\/a><\/div>\n","Email":"sean.n.steph2016@gmail.com","IpAddress":"74.12.52.42","GroupId":3,"GroupName":"Member","JoinDate":1415525911,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281055.jpg?_r=1415590512","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"snswedding2016","Id":281055,"Name":"snswedding2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.114.22.167","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79457,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3c10c628b0e492cb5fa6643806a597e4","RawContent":"&lt;p&gt;Welcome to our forum community and upcoming PdC wedding, SimpleBliss!!! you&#039;ll find lots of great resources here to help with your planning decisions, so well done on getting off to an excellent start :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Wishing you happy research, and all the best with your plans - cheers!!! team MTM :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;....for some added inspiration, here are some magical wedding moments that matter Linc captured in our magnificent Mayan Riviera - enjoy! .......from our &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10150344652834487.362195.18683524486&amp;amp;type=3&#039;&gt;Timeline Photo Album: &lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xtp1\/t31.0-8\/11698723_10153452760859487_6040784462924892829_o.jpg\" alt=\"11698723_10153452760859487_6040784462924\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xpa1\/t31.0-8\/11112904_10153437585749487_5606464172347900185_o.jpg\" alt=\"11112904_10153437585749487_5606464172347\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xpa1\/v\/t1.0-9\/554493_10151792595844487_1520592021_n.jpg?oh=0b40c559fba756b3adb110a0bbd25419&amp;amp;oe=5640D9EA\" alt=\"554493_10151792595844487_1520592021_n.jp\"&gt;&lt;\/p&gt;","Attachments":[],"Id":1901715,"PostDate":1438554539,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome to our forum community and upcoming PdC wedding, SimpleBliss!!! you'll find lots of great resources here to help with your planning decisions, so well done on getting off to an excellent start <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Wishing you happy research, and all the best with your plans - cheers!!! team MTM <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>....for some added inspiration, here are some magical wedding moments that matter Linc captured in our magnificent Mayan Riviera - enjoy! .......from our <a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10150344652834487.362195.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>Timeline Photo Album: <\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xtp1\/t31.0-8\/11698723_10153452760859487_6040784462924892829_o.jpg\" alt=\"11698723_10153452760859487_6040784462924\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xpa1\/t31.0-8\/11112904_10153437585749487_5606464172347900185_o.jpg\" alt=\"11112904_10153437585749487_5606464172347\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xpa1\/v\/t1.0-9\/554493_10151792595844487_1520592021_n.jpg?oh=0b40c559fba756b3adb110a0bbd25419&oe=5640D9EA\" alt=\"554493_10151792595844487_1520592021_n.jp\"><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280189060,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.155.45.224","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79457,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c5ea6e60976f6c4381fa0194b54c29da","RawContent":"[quote name=\"snswedding2016\" post=\"1901714\" timestamp=\"1438573655\"]\n@[member=\"SimpleBliss\"] Welcome and congrats on your engagement! Is your $5000-10 000 budget including travel costs for you and your fianc\u00e9? Are you completely opposed to having it at an all inclusive? My resort budget for 60 people for just the wedding was $6000 and we&#039;re definitely under that so it is possible but I know you mentioned the all inclusive thing isn&#039;t really your first choice.\n\nThere are definitely other options too though (I unfortunately don&#039;t have any experience in that department however) with beach clubs, boat cruises and restaurants...not too sure on the range of costs there. @[member=\"acw271011\"] may be able to give some words of wisdom as she&#039;s planning a small reception off site.[\/quote]\nThe $5000 - $10000 budget does not include airfare costs (which is probabely going to be $700\/pp coming from Calgary\/Toronto\/Edmonton)\n\nThe reason why I don&#039;t like All Inclusives Resort because I feel I won&#039;t be staying on the resort much to benefit from their amenities. We are big foodies and prefer to go out to town to eat and try new things and like going to the odd hole in the wall restaurant that serves awesome delicious food! In addition, I heard many resorts push you to have their own photographers+make up artist and would charge you for outside vendor fees. \n\nI would prefer to have control over using my own photographer of choice as pictures are very important to me and my own make-up artist.\n\nI am amazed that you managed to have $6000 budget for AI and 60 guests attending!? I would love to see your budget breakdown on your wedding because it&#039;s giving me a glimmer of hope that mine might be doable.","Attachments":[],"Id":1901716,"PostDate":1438558450,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>snswedding2016, on 02 August 2015 - 09:47 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"284242\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/284242-simplebliss\/' title='Member profile'><span itemprop=\"name\">SimpleBliss<\/span><\/a> Welcome and congrats on your engagement! Is your $5000-10 000 budget including travel costs for you and your fianc\u00e9? Are you completely opposed to having it at an all inclusive? My resort budget for 60 people for just the wedding was $6000 and we're definitely under that so it is possible but I know you mentioned the all inclusive thing isn't really your first choice.<\/p>\n<p>\u00a0<\/p>\n<p>There are definitely other options too though (I unfortunately don't have any experience in that department however) with beach clubs, boat cruises and restaurants...not too sure on the range of costs there. @<a hovercard-ref=\"member\" hovercard-id=\"232000\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/232000-acw271011\/' title='Member profile'><span itemprop=\"name\">acw271011<\/span><\/a> may be able to give some words of wisdom as she's planning a small reception off site.<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>The $5000 - $10000 budget does not include airfare costs (which is probabely going to be $700\/pp coming from Calgary\/Toronto\/Edmonton)<\/p>\n<p>\u00a0<\/p>\n<p>The reason why I don't like All Inclusives Resort because I feel I won't be staying on the resort much to benefit from their amenities. We are big foodies and prefer to go out to town to eat and try new things and like going to the odd hole in the wall restaurant that serves awesome delicious food! In addition, I heard many resorts push you to have their own photographers+make up artist and would charge you for outside vendor fees.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I would prefer to have control over using my own photographer of choice as pictures are very important to me and my own make-up artist.<\/p>\n<p>\u00a0<\/p>\n<p>I am amazed that you managed to have $6000 budget for AI and 60 guests attending!? I would love to see your budget breakdown on your wedding because it's giving me a glimmer of hope that mine might be doable.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ntruong5@alumni.uwo.ca","IpAddress":"75.155.45.68","GroupId":39,"GroupName":"Newbie","JoinDate":1438532023,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284242.jpg?_r=1439936957","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"SimpleBliss","Id":284242,"Name":"SimpleBliss","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.90.223.12","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79457,"EditedBy":"<strong>Edited by calgarybride2015, 03 August 2015 - 09:09 AM.<\/strong>","EditDate":1438592942,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"24dc4ff91d9da7dae0eb9278dcbc266c","RawContent":"Welcome!!\n\n\nI also had an AI wedding with 45 people and the wedding itself was around $5500.  With photography I paid around $7500.   We paid our AI package over and above that cost plus my dress, decor, favors, etc. \n\n\nSooooo I&#039;d say it&#039;s totally doable!!!    \n\n\nI&#039;ve only researched AI but hopefully @[member=\"acw271011\"] jumps in as hers is off site.  Another bride used the Venado Beach club (sorry if I spelt that wrong).  Good luck. \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1901723,"PostDate":1438592914,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Welcome!!<br><br>\nI also had an AI wedding with 45 people and the wedding itself was around $5500.  With photography I paid around $7500.   We paid our AI package over and above that cost plus my dress, decor, favors, etc. <br><br>\nSooooo I'd say it's totally doable!!!    <br><br>\nI've only researched AI but hopefully @<a hovercard-ref=\"member\" hovercard-id=\"232000\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/232000-acw271011\/' title='Member profile'><span itemprop=\"name\">acw271011<\/span><\/a> jumps in as hers is off site.  Another bride used the Venado Beach club (sorry if I spelt that wrong).  Good luck. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399407002,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.49.243.226","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79457,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":3,"IsLiked":false,"PostKey":"11bbe2398b22effbadd42ec674e84f31","RawContent":"&lt;p&gt;@[member=\"SimpleBliss\"] we&#039;re not big all inclusive people either and we are also foodies! My ideal vacation is wandering and exploring a city but that being said after attending my cousin&#039;s DW a couple of years ago, it totally changed my mind. The cost factor alone was a major thing, especially for our guests. It huge to be able to tell our guests \"yes, you&#039;re paying all this money up front but you won&#039;t have to spend anything else while you&#039;re there unless you really want to\" (i.e. excursions etc). I don&#039;t know if you have any kids attending your wedding but it is a huge plus for parents to go to an AI for a family vacation, there is no stress of when the kids eat, how much and if they are wasting money\/food etc. We have 8-10 kids coming so that was a big consideration especially having it at a resort that could keep them entertained.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;When we went to look for our resort our top \"must-haves\" were:&lt;\/p&gt;\n&lt;p&gt;-Good food (we&#039;re foodies plus my future brother in law is the head of the culinary school in PEI-no pressure)&lt;\/p&gt;\n&lt;p&gt;-Family Friendly&lt;\/p&gt;\n&lt;p&gt;-Affordable&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;This is not to try and convince you on AIs but just my experience as AIs were not always my first choice either.&lt;\/p&gt;\n&lt;p&gt;Not sure how it compares to having it offsite but I think with 20 people your budget is totally doable especially if you&#039;re keeping it simple.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;My wedding budget (just for the ceremony and reception) ...at the moment we have 51 people&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Ceremony package - $950&lt;\/p&gt;\n&lt;p&gt;Decor - $270 (I&#039;m bringing some things from home as well and it is not included in this number)&lt;\/p&gt;\n&lt;p&gt;Outside vendor fee - $800 (for photographer)&lt;\/p&gt;\n&lt;p&gt;Food - $810 (3 course plated meal)&lt;\/p&gt;\n&lt;p&gt;Sound equipment rental - $250&lt;\/p&gt;\n&lt;p&gt;Set up fee - TBA (probably around $300 so that would be added to the total below)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Total - $3080&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Outside Vendor:&lt;\/p&gt;\n&lt;p&gt;Photography $1100&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;From home:&lt;\/p&gt;\n&lt;p&gt;Real touch flowers - $100&lt;\/p&gt;\n&lt;p&gt;OOT bags- $150-200&lt;\/p&gt;\n&lt;p&gt;Other decor - $300-350&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Of course this doesn&#039;t include travel, attire and gifts. I hope this helps! Happy planning! :)&lt;\/p&gt;","Attachments":[],"Id":1901726,"PostDate":1438593675,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"284242\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/284242-simplebliss\/' title='Member profile'><span itemprop=\"name\">SimpleBliss<\/span><\/a> we're not big all inclusive people either and we are also foodies! My ideal vacation is wandering and exploring a city but that being said after attending my cousin's DW a couple of years ago, it totally changed my mind. The cost factor alone was a major thing, especially for our guests. It huge to be able to tell our guests \"yes, you're paying all this money up front but you won't have to spend anything else while you're there unless you really want to\" (i.e. excursions etc). I don't know if you have any kids attending your wedding but it is a huge plus for parents to go to an AI for a family vacation, there is no stress of when the kids eat, how much and if they are wasting money\/food etc. We have 8-10 kids coming so that was a big consideration especially having it at a resort that could keep them entertained.<\/p>\n<p>\u00a0<\/p>\n<p>When we went to look for our resort our top \"must-haves\" were:<\/p>\n<p>-Good food (we're foodies plus my future brother in law is the head of the culinary school in PEI-no pressure)<\/p>\n<p>-Family Friendly<\/p>\n<p>-Affordable<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>This is not to try and convince you on AIs but just my experience as AIs were not always my first choice either.<\/p>\n<p>Not sure how it compares to having it offsite but I think with 20 people your budget is totally doable especially if you're keeping it simple.<\/p>\n<p>\u00a0<\/p>\n<p>My wedding budget (just for the ceremony and reception) ...at the moment we have 51 people<\/p>\n<p>\u00a0<\/p>\n<p>Ceremony package - $950<\/p>\n<p>Decor - $270 (I'm bringing some things from home as well and it is not included in this number)<\/p>\n<p>Outside vendor fee - $800 (for photographer)<\/p>\n<p>Food - $810 (3 course plated meal)<\/p>\n<p>Sound equipment rental - $250<\/p>\n<p>Set up fee - TBA (probably around $300 so that would be added to the total below)<\/p>\n<p>\u00a0<\/p>\n<p>Total - $3080<\/p>\n<p>\u00a0<\/p>\n<p>Outside Vendor:<\/p>\n<p>Photography $1100<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>From home:<\/p>\n<p>Real touch flowers - $100<\/p>\n<p>OOT bags- $150-200<\/p>\n<p>Other decor - $300-350<\/p>\n<p>\u00a0<\/p>\n<p>Of course this doesn't include travel, attire and gifts. I hope this helps! Happy planning! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>My planning thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78916-snswedding2016-planning-thread-jan-9-2016-azul-fives\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78916-snswedding2016-planning-thread-jan-9-2016-azul-fives\/<\/a><\/p>\n<p>\u00a0<\/p>\n<div><a class='bbc_url' href='http:\/\/www.TickerFactory.com\/'><\/div>\n<div><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10730;0\/st\/20160109\/e\/Our+Wedding\/k\/9fa9\/event.png\" alt=\"event.png\"><\/div>\n<div><\/a><\/div>\n","Email":"sean.n.steph2016@gmail.com","IpAddress":"74.12.52.42","GroupId":3,"GroupName":"Member","JoinDate":1415525911,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281055.jpg?_r=1415590512","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"snswedding2016","Id":281055,"Name":"snswedding2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"159.53.174.143","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79457,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"b0f262d716460724084c45f2b12ae16e","RawContent":"&lt;p&gt;I would agree with @[member=\"snswedding2016\"] - Balancing what we wanted for our wedding and what was best for our guests was a big factor in deciding our location. In some ways, our guests were more important to us than we were to us! My husband is from Jamaica so having it off resort would have been amazing, but with most guests staying only 4 nights we wanted to make the whole experience as easy for them as possible. We also wanted to maximize our time with them so having everyone in close proximity to each other with max relaxing time at an AI was the right choice for us. We did plan 2 optional excursions with our guests as well (not formal tours) which was perfect for some off-resort access to authentic food and adventure.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I didn&#039;t do any research into non AI options, but we had 66 adults and 3 kids. Our resort tab for the wedding was under $6,000 and we didn&#039;t skimp so I think your budget is doable! Mexico is typically less expensive than Jamaica as well. We hired an outside photographer for about $2,000 - the photographer paid the vendor fee. Our resort salon had excellent reviews from past brides so I felt comfortable using them and I was very happy with my hair and makeup.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Once you do get your venue figured out the planning gets MUCH easier! It is the hardest part. Don&#039;t get discouraged!&lt;\/p&gt;","Attachments":[],"Id":1901834,"PostDate":1438702290,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I would agree with @<a hovercard-ref=\"member\" hovercard-id=\"281055\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/281055-snswedding2016\/' title='Member profile'><span itemprop=\"name\">snswedding2016<\/span><\/a> - Balancing what we wanted for our wedding and what was best for our guests was a big factor in deciding our location. In some ways, our guests were more important to us than we were to us! My husband is from Jamaica so having it off resort would have been amazing, but with most guests staying only 4 nights we wanted to make the whole experience as easy for them as possible. We also wanted to maximize our time with them so having everyone in close proximity to each other with max relaxing time at an AI was the right choice for us. We did plan 2 optional excursions with our guests as well (not formal tours) which was perfect for some off-resort access to authentic food and adventure.<\/p>\n<p>\u00a0<\/p>\n<p>I didn't do any research into non AI options, but we had 66 adults and 3 kids. Our resort tab for the wedding was under $6,000 and we didn't skimp so I think your budget is doable! Mexico is typically less expensive than Jamaica as well. We hired an outside photographer for about $2,000 - the photographer paid the vendor fee. Our resort salon had excellent reviews from past brides so I felt comfortable using them and I was very happy with my hair and makeup.<\/p>\n<p>\u00a0<\/p>\n<p>Once you do get your venue figured out the planning gets MUCH easier! It is the hardest part. Don't get discouraged!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rebecca.shaffer@gmail.com","IpAddress":"159.53.174.144","GroupId":3,"GroupName":"Member","JoinDate":1403094487,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"beckys98","Id":278581,"Name":"beckys98","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.87.237.201","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79457,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"05b58b1fb53f4d48360077f6c5c6b030","RawContent":"&lt;p&gt;We have a super small group and I found the resorts aren&#039;t great with small groups but we ended up going off resort to Grand Coral Beach Club and it has worked out great so far! I&#039;m looking forward to it.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Joyce at Dream Weddings has the contact info to deal with Grand Coral. There is also Blue Venado Beach Club which can accommodate a pretty good size group and the reviews that I&#039;ve seen have been great!!&lt;\/p&gt;","Attachments":[],"Id":1902041,"PostDate":1438872015,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>We have a super small group and I found the resorts aren't great with small groups but we ended up going off resort to Grand Coral Beach Club and it has worked out great so far! I'm looking forward to it.<\/p>\n<p>\u00a0<\/p>\n<p>Joyce at Dream Weddings has the contact info to deal with Grand Coral. There is also Blue Venado Beach Club which can accommodate a pretty good size group and the reviews that I've seen have been great!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span><\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/ann.chadwick.5\/media_set?set=a.10153262834771016.1073741828.569791015&type=3'><span style=\"color:#ff0099;\"><em>https:\/\/www.facebook.com\/ann.chadwick.5\/media_set?set=a.10153262834771016.1073741828.569791015&type=3<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/'><span style=\"color:#ff0099;\"><em>http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283437399,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"200.79.251.123","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79457,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"ce05453d3ab003d07ea7d9f90c672daf","RawContent":"[quote name=\"SimpleBliss\" post=\"1901711\" timestamp=\"1438568551\"]\nHello everyone!\n\nI am very glad to join the community here. I am in the midst of planning my own wedding set tentatively for April 2016 in Playa Del Carmen, Mexico.\nDuration of our stay would be 5 days and 4 nights as my fiance cannot get anymore days off. Not planning to have anything too formal and all-inclusive resorts are not our thing. Our top two priorities are Food and Photography. Decor would be minimal, especially when you have the ocean as your background.\n\nThrough my research and price quotes I am getting discouraged that planning a destination wedding with under 20 guests is not possible for my small budget of $5000 - $10000. (Everyone is pretty much paying their own flights and accommodations to get there).\n\nJust  wondering if any other brides were able to pull this off with that amount. I am looking to have a semi-private to private beach ceremony.\nThe reception could either be at the same venue or at a villa where my family and I would be staying at (this means we would need to hire catering)\n\nIf not we could all just go out to a nice restaurant to have dinner?\n\nAny feedback or advice would be greatly appreciated![\/quote]@[member=\"SimpleBliss\"] what are your dates in April?  because some of the off resorts location can offer you a great deal when getting married on a week day.\n\n\nPlease feel free to reach and I will be happy to help!\n\nJoyce","Attachments":[],"Id":1902528,"PostDate":1439545091,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>SimpleBliss, on 02 August 2015 - 08:22 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hello everyone!<\/p>\n<p>\u00a0<\/p>\n<p>I am very glad to join the community here. I am in the midst of planning my own wedding set tentatively for April 2016 in Playa Del Carmen, Mexico.<\/p>\n<p>Duration of our stay would be 5 days and 4 nights as my fiance cannot get anymore days off. Not planning to have anything too formal and all-inclusive resorts are not our thing. Our top two priorities are Food and Photography. Decor would be minimal, especially when you have the ocean as your background.<\/p>\n<p>\u00a0<\/p>\n<p>Through my research and price quotes I am getting discouraged that planning a destination wedding with under 20 guests is not possible for my small budget of $5000 - $10000. (Everyone is pretty much paying their own flights and accommodations to get there).<\/p>\n<p>\u00a0<\/p>\n<p>Just \u00a0wondering if any other brides were able to pull this off with that amount. I am looking to have a semi-private to private beach ceremony.<\/p>\n<p>The reception could either be at the same venue or at a villa where my family and I would be staying at (this means we would need to hire catering)<\/p>\n<p>\u00a0<\/p>\n<p>If not we could all just go out to a nice restaurant to have dinner?<\/p>\n<p>\u00a0<\/p>\n<p>Any feedback or advice would be greatly appreciated!<\/p>\n<\/div>\n<\/div><\/div>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"284242\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/284242-simplebliss\/' title='Member profile'><span itemprop=\"name\">SimpleBliss<\/span><\/a> what are your dates in April? \u00a0because some of the off resorts location can offer you a great deal when getting married on a week day.<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Please feel free to reach and I will be happy to help!<\/p>\n<p>\u00a0<\/p>\n<p>Joyce<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Dream Weddings Riviera Maya- We pay attention to your wishes and coordinate closely with you to ensure your wedding or event is planned to perfection! Supporting you brides and help you feel less overwhelmed during the wedding planning process.<\/p>\n<p>Have fun the best is yet to come!<\/p>\n<p>\u00a0<\/p>\n<p>This is where I will be posting all videos about most common question about Destination wedding<\/p>\n<p> <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0\u00a0<a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/groups\/1664036763874450\/'>https:\/\/www.facebook.com\/groups\/1664036763874450\/<\/a><br><br><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Dream Weddings Riviera Maya<\/span><\/span><\/span><br><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">weddingsinplayadelcarmen@gmail.com<\/span><\/span><br><a  class=\"bbc_url\" href=\"http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html\">http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html<\/a><br><br><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Happy Planning!<\/span><\/span><\/span><br><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Joyce<\/span><\/span><\/span>","Email":"weddingsinplayadelcarmen@gmail.com","IpAddress":"187.252.44.28","GroupId":84,"GroupName":"Insiders w\/ Articles","JoinDate":1326832787,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250090.jpg?_r=1451923195","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"dreamweddings","Id":250090,"Name":"dreamweddings","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"137.175.150.26","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79457,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"46be79e96b49b799ed91dfe440a07be2","RawContent":"[quote name=\"acw271011\" post=\"1902041\" timestamp=\"1438893615\"]\nWe have a super small group and I found the resorts aren&#039;t great with small groups but we ended up going off resort to Grand Coral Beach Club and it has worked out great so far! I&#039;m looking forward to it.\n\nJoyce at Dream Weddings has the contact info to deal with Grand Coral. There is also Blue Venado Beach Club which can accommodate a pretty good size group and the reviews that I&#039;ve seen have been great!![\/quote]Hello, \nI just want to let you know that i wrote you a private message because i have questions about your wedding if you would like to help us ;)\nThank you very much\nHave a great day\nKarina :)","Attachments":[],"Id":1908149,"PostDate":1449402733,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>acw271011, on 06 August 2015 - 02:40 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>We have a super small group and I found the resorts aren't great with small groups but we ended up going off resort to Grand Coral Beach Club and it has worked out great so far! I'm looking forward to it.<\/p>\n<p>\u00a0<\/p>\n<p>Joyce at Dream Weddings has the contact info to deal with Grand Coral. There is also Blue Venado Beach Club which can accommodate a pretty good size group and the reviews that I've seen have been great!!<\/p>\n<\/div>\n<\/div><\/div>\n<p>Hello,\u00a0<\/p>\n<p>I just want to let you know that i wrote you a private message because i have questions about your wedding if you would like to help us <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/><\/p>\n<p>Thank you very much<\/p>\n<p>Have a great day<\/p>\n<p>Karina <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kariferland@hotmail.com","IpAddress":"137.175.150.26","GroupId":39,"GroupName":"Newbie","JoinDate":1421568790,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Kari26","Id":281770,"Name":"Kari26","IsOnline":false}}],"Id":"79457","Title":"Distressed And Discouraged","LastPostDate":1449493748},"Pages":{"TotalItems":11,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
