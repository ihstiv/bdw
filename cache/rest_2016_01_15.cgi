oupId":39,"GroupName":"Newbie","JoinDate":1394832914,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277149.jpg?_r=1394854514","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"DoubleD2015","Id":277149,"Name":"DoubleD2015","IsOnline":false}},"Posts":[],"Id":"76592","Title":"Newbie!  Grand Palladium Vallarta Bride 2015 :)","LastPostDate":1449171796},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":7,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":738,"MovedTo":null,"MovedOn":0,"FirstPostId":1907838,"Rating":0,"RatingHits":0,"Starter":{"Id":284728,"Name":"OttawaBride2017","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284728.jpg?_r=1448387511","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"IsOnline":false},"StartDate":1448356534,"LastPoster":{"Id":281478,"Name":"perianjay","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1452788091","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1908095,"PostDate":1449164677,"PostContent":"I've been to both Moon and Beach. They are the exact same when it comes to decor and I have to sl...","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_u