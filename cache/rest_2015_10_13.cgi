            <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks for making me feel at ease with the whole idea of buying a knockoff. I hope to order one myself. <br \/> <br \/> It's just ridiculous what designers charge for their dresses. Maybe they wouldn't lose so much money with brides who buy from China if they'd make their prices a little more reasonable....\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10748;0\/st\/20100223\/e\/Our+Wedding\/dt\/-2\/k\/67d5\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...67d5\/event.png<\/a><\/div><\/div>","Email":"katie.torley@gmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1232061403,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213991.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"KJT1985","Id":213991,"Name":"KJT1985","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a81bab4d861e401030d9ffd8a2192259","RawContent":"Hey ladies, I just saw today that Light in the Box is having an end of the month sale if anyone is interested :)","Attachments":[],"Id":860359,"PostDate":1253898944,"PostCon