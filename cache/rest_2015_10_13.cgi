{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":4,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":252,"MovedTo":null,"MovedOn":0,"FirstPostId":1903779,"Rating":0,"RatingHits":0,"Starter":{"Id":284045,"Name":"Hydewedding","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1441044557,"LastPoster":{"Id":284045,"Name":"Hydewedding","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":44,"Preview":{"Id":1903779,"PostDate":1441044557,"PostContent":"This may be really out there, but I am trying to make Bridesmaid's tank tops for my wedding party...","Author":{"Signature":"","Email":"brittnoel448@gmail.com","IpAddress":"99.247.243.11","GroupId":3,"GroupName":"Member","JoinDate":1437422692,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Hydewedding","Id":284045,"Name":"Hydewedding","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.247.243.11","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79552,"EditedBy":"<strong>Edited by Hydewedding, 31 August 2015 - 10:12 AM.<\/strong>","EditDate":1441044720,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"73ed6720df13b0962e10308b2bd478ba","RawContent":"&lt;p&gt;This may be really out there, but I am trying to make Bridesmaid&#039;s tank tops for my wedding party and found great ones online, which are too expensive but I found a lady in my city willing to print similar ones. She told me just to find the font and the shirts I want and she will put it on.&lt;\/p&gt;\n&lt;p&gt;Does anyone know the name of the following font? It seems to be on a lot of the Bridesmaids apparel. Even at David&#039;s Bridal and in a lot of Etsy shops. I have been on font downloaders all morning with no luck!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1903779,"PostDate":1441044557,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>This may be really out there, but I am trying to make Bridesmaid's tank tops for my wedding party and found great ones online, which are too expensive but I found a lady in my city willing to print similar ones. She told me just to find the font and the shirts I want and she will put it on.<\/p>\n<p>Does anyone know the name of the following font? It seems to be on a lot of the Bridesmaids apparel. Even at David's Bridal and in a lot of Etsy shops. I have been on font downloaders all morning with no luck!<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"brittnoel448@gmail.com","IpAddress":"99.247.243.11","GroupId":3,"GroupName":"Member","JoinDate":1437422692,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Hydewedding","Id":284045,"Name":"Hydewedding","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79552,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9c5c095c75219ec1a6ed5def4fa950cf","RawContent":"&lt;p&gt;Not 100% sure about that particular font, but there&#039;s a lot of similar fonts. Try searching for a font you like on www.myfonts.com :)&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;You may be able to find it there. Almost every font that is popular can be found on that website.&lt;\/p&gt;","Attachments":[],"Id":1903791,"PostDate":1441051309,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Not 100% sure about that particular font, but there's a lot of similar fonts. Try searching for a font you like on www.myfonts.com <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0<\/p>\n<p>You may be able to find it there. Almost every font that is popular can be found on that website.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419441414,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1436293677","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.12.21","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79552,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b8938580bf5093cf6bb7162c1e3c942a","RawContent":"[quote name=\"Hydewedding\" post=\"1903779\" timestamp=\"1441040957\"]\nThis may be really out there, but I am trying to make Bridesmaid&#039;s tank tops for my wedding party and found great ones online, which are too expensive but I found a lady in my city willing to print similar ones. She told me just to find the font and the shirts I want and she will put it on.\nDoes anyone know the name of the following font? It seems to be on a lot of the Bridesmaids apparel. Even at David&#039;s Bridal and in a lot of Etsy shops. I have been on font downloaders all morning with no luck![\/quote]\nIt&#039;s not exact but I found this one. Might help a bit.  Good luck!","Attachments":[],"Id":1903812,"PostDate":1441072798,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Hydewedding, on 31 August 2015 - 10:09 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>This may be really out there, but I am trying to make Bridesmaid's tank tops for my wedding party and found great ones online, which are too expensive but I found a lady in my city willing to print similar ones. She told me just to find the font and the shirts I want and she will put it on.<\/p>\n<p>Does anyone know the name of the following font? It seems to be on a lot of the Bridesmaids apparel. Even at David's Bridal and in a lot of Etsy shops. I have been on font downloaders all morning with no luck!<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>It's not exact but I found this one. Might help a bit.\u00a0 Good luck!<\/p>\n<p>\n<a href=\"http:\/\/www.bestdestinationwedding.com\/index.phpapp=core&amp;module=attach&amp;section=attach&amp;attach_id=33558\" title=\"Download attachment\"><img src=\"http:\/\/www.bestdestinationwedding.com\/public\/style_extra\/mime_types\/doc.gif\" alt=\"Attached File\" \/><\/a>\n&nbsp;<a href=\"http:\/\/www.bestdestinationwedding.com\/index.phpapp=core&amp;module=attach&amp;section=attach&amp;attach_id=33558\" title=\"Download attachment\"><strong>Shirt Font-2.doc<\/strong><\/a> &nbsp;&nbsp;<span class='desc'><strong>87.5KB<\/strong><\/span>\n&nbsp;&nbsp;<span class=\"desc lighter\">4 downloads<\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><em><span style=\"color:rgb(51,153,255);\">I'm lucky enough to\u00a0tell my husband how much I love him and say yes again\u00a0on October 20, 2015 at Grand Coral Beach Club!\u00a0<\/span><\/em>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283462599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.247.243.11","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79552,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d92c58f65a80e47606a8ef8bf203cdae","RawContent":"&lt;p&gt;Thanks so much! That is super close!&lt;\/p&gt;","Attachments":[],"Id":1903813,"PostDate":1441073183,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thanks so much! That is super close!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"brittnoel448@gmail.com","IpAddress":"99.247.243.11","GroupId":3,"GroupName":"Member","JoinDate":1437422692,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Hydewedding","Id":284045,"Name":"Hydewedding","IsOnline":false}}],"Id":"79552","Title":"Bridesmaids Shirts","LastPostDate":1441073183},"Pages":{"TotalItems":4,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
