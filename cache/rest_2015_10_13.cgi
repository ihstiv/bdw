erdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                OH my gosh I'm excited to see 2 more Landy dresses!!!!!!!!!!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Photo by <\/span><a data-ipb='nomediaparse' href=\"http:\/\/www.dlweddings.com\">www.dlweddings.com<\/a><br><br><span>My Planning Thread<\/span><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t46588\">http:\/\/bestdestinationwedding.com\/forum\/t46588<\/a><span>My Wedding Review w\/ Lots of Pics<\/span><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t48352\">http:\/\/bestdestinationwedding.com\/forum\/t48352<\/a><span>Our TTD pics<\/span><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t48445\">http:\/\/bestdestinationwedding.com\/forum\/t48445<\/a><\/div><\/div>","Email":"jacilyn.m.gannon@gmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1212460200,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209727.jpg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Jacilynda","Id":209727,"Name":"Jacilynda","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"63327d22d1a3f04f5a17a84eb46168d4","RawContent":"Okay ladies the wait is over. Im having mixed feelings. Mostly I think due to my size, and I think its not fitting the way I imagined....\n \n Here is what we based the dress off of...\n \n &lt;img src=\"http:\/\/sites.google.com\/site\/melissagrantswedding\/_\/rsrc\/1254099436482\/wedding-attire\/dress3a.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n &lt;img src=\"http:\/\/sites.google.com\/site\/melissagrantswedding\/_\/rsrc\/1254099452315\/wedding-attire\/dress3b.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n First laugh - my dress is in this bag? \n \n &lt;img src=\"http:\/\/i992.photobucket.com\/albums\/af49\/fortmyersbride\/Dresses\/IMG_2250.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n &lt;img src=\"http:\/\/i992.photobucket.com\/albums\/af49\/fortmyersbride\/Dresses\/IMG_2263.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n &lt;img src=\"http:\/\/i992.photobucket.com\/albums\/af49\/fortmyersbride\/Dresses\/IMG_2264.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n &lt;img src=\"http:\/\/i992.photobucket.com\/albums\/af49\/fortmyersbride\/Dresses\/IMG_2265.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n &lt;img src=\"http:\/\/i992.photobucket.com\/albums\/af49\/fortmyersbride\/Dresses\/IMG_2257.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n &lt;img src=\"http:\/\/i992.photobucket.com\/albums\/af49\/fortmyersbride\/Dresses\/IMG_2255.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;","Attachments":[],"Id":883834,"PostDate":1255485217,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Okay ladies the wait is over. Im having mixed feelings. Mostly I think due to my size, and I think its not fitting the way I imagined....<br \/> <br \/> Here is what we based the dress off of...<br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/sites.google.com\/site\/melissagrantswedding\/_\/rsrc\/1254099436482\/wedding-attire\/dress3a.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/sites.google.com\/site\/melissagrantswedding\/_\/rsrc\/1254099452315\/wedding-attire\/dress3b.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> First laugh - my dress is in this bag? <br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i992.photobucket.com\/albums\/af49\/fortmyersbride\/Dresses\/IMG_2250.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i992.photobucket.com\/albums\/af49\/fortmyersbride\/Dresses\/IMG_2263.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i992.photobucket.com\/albums\/af49\/fortmyersbride\/Dresses\/IMG_2264.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i992.photobucket.com\/albums\/af49\/fortmyersbride\/Dresses\/IMG_2265.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i992.photobucket.com\/albums\/af49\/fortmyersbride\/Dresses\/IMG_2257.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i992.photobucket.com\/albums\/af49\/fortmyersbride\/Dresses\/IMG_2255.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cajaya@gmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1210010430,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209276.gif?_r=0","PhotoWidth":100,"PhotoHeight":67,"PhotoType":"custom"},"FormattedName":"SgtPepperette","Id":209276,"Name":"SgtPepperette","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9bf39cdf9d0a5151cb60b461196afbd8","RawContent":"Well first off, it absolutely does NOT look bad on you!! Mostly I think the floraly detail is just different but maybe its the lighting. In the original, the smooth material looks more like its wrapped over a full &amp;quot;lace&amp;quot; dress but in yours it looks a bit more sewn in. \n \n However, I&#039;m being completely honest when I say that it gives you a really REALLY nice shape!! And I LOVE the train!","Attachments":[],"Id":883846,"PostDate":1255485577,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Well first off, it absolutely does NOT look bad on you!! Mostly I think the floraly detail is just different but maybe its the lighting. In the original, the smooth material looks more like its wrapped over a full \"lace\" dress but in yours it looks a bit more sewn in. <br \/> <br \/> However, I'm being completely honest when I say that it gives you a really REALLY nice shape!! And I LOVE the train!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10748;0\/st\/20100223\/e\/Our+Wedding\/dt\/-2\/k\/67d5\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...67d5\/event.png<\/a><\/div><\/div>","Email":"katie.torley@gmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1232061403,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213991.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"KJT1985","Id":213991,"Name":"KJT1985","IsOnline":false}}],"Pages":{"TotalItems":6407,"TotalPages":641,"CurrentPage":180,"NextPage":190,"PreviousPage":170,"LastPage":6400},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
