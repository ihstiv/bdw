edName":"LeeLee1106","Id":272208,"Name":"LeeLee1106","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"199.173.226.235","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77134,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"8ea15177c28b8f419495eda5449a09d0","RawContent":"&lt;p&gt;&lt;span style=\"font-family:georgia, serif;\"&gt;&lt;span style=\"color:#ffa07a;\"&gt;Hello everyone!!! :)&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-family:georgia, serif;\"&gt;&lt;span style=\"color:#ffa07a;\"&gt;I just wanted to see if there are any &lt;strong&gt;2015 Beaches Turks &amp;amp; Caicos&lt;\/strong&gt; brides out there? I&#039;ve been a member of this site for a while but finally made the decision to go with Beaches T&amp;amp;C and gave my deposit :D&amp;nbsp;. &lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-family:georgia, serif;\"&gt;&lt;span style=\"color:#ffa07a;\"&gt;I recently had my first call with Roxi and now I&#039;m in the process of deciding what I want in terms of decor, extras, etc. &lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-family:georgia, serif;\"&gt;&lt;span style=\"color:#ffa07a;\"&gt;I&#039;m still sifting through all of the various forums but I&#039;ll gladly take any tips or suggestions from anyone who has been married there or is getting married there. We&#039;re getting married in May 2015.&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1851971,"PostDate":1400937050,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span  style=\"font-family:georgia, serif\"><span  style=\"color:#ffa07a\">Hello everyone!!! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0<\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-family:georgia, serif\"><span  style=\"color:#ffa07a\">I just wanted to see if there are any <strong>2015 Beaches Turks & Caicos<\/strong> brides out there? I've been a member of this site for a while but finally made the decision to go with Beaches T&C and gave my deposit <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/biggrin.png' class='bbc_emoticon' alt=':D' \/>\u00a0. <\/span><\/span><\/p>\n<p><span  style=\"font-family:georgia, serif\"><span  style=\"color:#ffa07a\">I recently had my first call with Roxi and now I'm in the process of deciding what I want in terms of decor, extras, etc. <\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-family:georgia, serif\"><span  style=\"color:#ffa07a\">I'm still sifting through all of the various forums but I'll gladly take any tips or suggestions from anyone who has been married there or is getting married there. We're getting married in May 2015.<\/span><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ffa07a;\"><span style=\"font-size:18px;\"><em> <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wub.png' class='bbc_emoticon' alt=':wub:' \/>\u00a0 <span style=\"font-size:14px;\"><span style=\"font-family:georgia, serif;\">\"I Would Gladly Live Out Of A Suitcase If It Meant I Could See The World.\"<\/span><\/span> <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wub.png' class='bbc_emoticon' alt=':wub:' \/>\u00a0<\/em><\/span><\/span>","Email":"kennyandaliciawedding@gmail.com","IpAddress":"199.173.226.235","GroupId":39,"GroupName":"Newbie","JoinDate":1375536036,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272208.jpg?_r=1403268709","PhotoWidth":200,"PhotoHeight":250,"PhotoType":"custom"},"FormattedName":"LeeLee1106","Id":272208,"Name":"LeeLee1106","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.249.122.85","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77134,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"417a2248beb730074dbcc52939e39e75","RawContent":"&lt;p&gt;Congrats! Beaches Turks &amp;amp; Caicos was my dream wedding location, but unfortunately out budget (or our guests budgets!) wouldn&#039;t allow for this location. Happy Planning!&lt;\/p&gt;","Attachments":[],"Id":1852076,"PostDate":1401057310,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats! Beaches Turks & Caicos was my dream wedding location, but unfortunately out budget (or our guests budgets!) wouldn't allow for this location. Happy Planning!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kelly_miller_@hotmail.com","IpAddress":"99.249.122.85","GroupId":40,"GroupName":"Jr. Member","JoinDate":1390772931,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kellymiller","Id":276338,"Name":"kellymiller","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.7.68.104","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77134,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"204530d21a972103cb60329c9a437f88","RawContent":"Hi!  Congrats!  I&#039;m getting married there in December.  Have you checked out the Beaches T&amp;amp;C forum?  It look several hours but I read through every post and got LOTS of tips and ideas!  \n&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/topic\/58017-beaches-turks-caicos-roll-call\/&#039;&gt;http:\/\/www.bestdestinationwedding.com\/topic\/58017-beaches-turks-caicos-roll-call\/&lt;\/a&gt;","Attachments":[],"Id":1853020,"PostDate":1401569593,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi!  Congrats!  I'm getting married there in December.  Have you checked out the Beaches T&C forum?  It look several hours but I read through every post and got LOTS of tips and ideas!  <br \/><a href='http:\/\/www.bestdestinationwedding.com\/topic\/58017-beaches-turks-caicos-roll-call\/' class='bbc_url' title=''>http:\/\/www.bestdesti...icos-roll-call\/<\/a>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"megthomson78@gmail.com","IpAddress":"173.76.163.5","GroupId":40,"GroupName":"Jr. Member","JoinDate":1388753198,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275858.jpg?_r=1394079727","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"megthomson","Id":275858,"Name":"megthomson","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.224.203.82","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77134,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"fbfcf41c97920e2380b4bf7da03d1fde","RawContent":"Hey ladies...\n\nWe still haven&#039;t decided between T&amp;amp;C or Jamaica. I&#039;m still flip flopping between the two.\n\nT&amp;amp;C is my #1 choice but it&#039;s really pricey ... \n\nI&#039;m thinking maybe my partner and I should go to T&amp;amp;C for Xmas and check it out before our May wedding... I&#039;m too much of a control freak to not know what I will be expecting","Attachments":[],"Id":1853058,"PostDate":1401630622,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hey ladies...<br>\nWe still haven't decided between T&C or Jamaica. I'm still flip flopping between the two.<br>\nT&C is my #1 choice but it's really pricey ... <br>\nI'm thinking maybe my partner and I should go to T&C for Xmas and check it out before our May wedding... I'm too much of a control freak to not know what I will be expecting\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"Using Tapatalk","Email":"kiannabanana69@gmail.com","IpAddress":"200.106.87.106","GroupId":3,"GroupName":"Member","JoinDate":1397902614,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277650.png?_r=1402827462","PhotoWidth":60,"PhotoHeight":80,"PhotoType":"custom"},"FormattedName":"MrsRoy","Id":277650,"Name":"MrsRoy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.71.237.188","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77134,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"501d1228d1da2609ef242afbbae1ff96","RawContent":"If anyone is looking for a photographer for their wedding, I highly recommend The Memory Factory. They are destination wedding photographers and travel panywhere. We got married in December and we contracted them for the entire event. They photographed our welcome party and our wedding day. They were fantastic and very reasonable. You can contact them at thememoryfactory@hotmail.com&amp;nbsp;","Attachments":[],"Id":1853084,"PostDate":1401640659,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                If anyone is looking for a photographer for their wedding, I highly recommend The Memory Factory. They are destination wedding photographers and travel panywhere. We got married in December and we contracted them for the entire event. They photographed our welcome party and our wedding day. They were fantastic and very reasonable. You can contact them at thememoryfactory@hotmail.com\u00a0\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"joannaandwilson2013@gmail.com","IpAddress":"71.71.237.188","GroupId":39,"GroupName":"Newbie","JoinDate":1369784483,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270067.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":183,"PhotoType":"custom"},"FormattedName":"JoWil JoWil","Id":270067,"Name":"JoWil JoWil","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"155.201.35.153","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77134,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"408d266894ba5a0adedb79e257f6da29","RawContent":"&lt;p&gt;Hi! I&#039;m new to the site and excited to meet other brides getting married at Beaches in T&amp;amp;C.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Our wedding date is 5\/23\/2015.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;ve been to T&amp;amp;C before (in 2011 for a girls trip) and fell in love with the island!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Looking forward to sharing tips! :)&lt;\/p&gt;","Attachments":[],"Id":1854170,"PostDate":1402074326,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi! I'm new to the site and excited to meet other brides getting married at Beaches in T&C.<\/p>\n<p>\u00a0<\/p>\n<p>Our wedding date is 5\/23\/2015.<\/p>\n<p>\u00a0<\/p>\n<p>I've been to T&C before (in 2011 for a girls trip) and fell in love with the island!<\/p>\n<p>\u00a0<\/p>\n<p>Looking forward to sharing tips! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"akim1115@gmail.com","IpAddress":"155.201.35.153","GroupId":39,"GroupName":"Newbie","JoinDate":1402074095,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"AK15","Id":278277,"Name":"AK15","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"199.173.224.32","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77134,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7d7a1f1320ee310dc3a5fd50e6c3cb5c","RawContent":"&lt;p&gt;@[member=\"megthomson\"], That Roll Call thread was actually one of the reasons I fell in love with the resort a few years ago. There&#039;s just SO much to go through - I&#039;ve picked up some great tips from there too. I love it!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;@[member=\"AK15\"], 1 week after me!! It&#039;s so exciting!!&amp;nbsp; How far are you in your planning? I recently sent out our Save the Dates that gives everyone the link to our wedding website &amp;amp; refers them to our travel agent. So now I&#039;m working on picking out items in the wedding catalog to prep for my 2nd phone meeting with Roxi. So exciting! :)&lt;\/p&gt;","Attachments":[],"Id":1856362,"PostDate":1403268397,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"275858\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/275858-megthomson\/' title='Member profile'><span itemprop=\"name\">megthomson<\/span><\/a>, That Roll Call thread was actually one of the reasons I fell in love with the resort a few years ago. There's just SO much to go through - I've picked up some great tips from there too. I love it!<\/p>\n<p>\u00a0<\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"278277\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/278277-ak15\/' title='Member profile'><span itemprop=\"name\">AK15<\/span><\/a>, 1 week after me!! It's so exciting!!\u00a0 How far are you in your planning? I recently sent out our Save the Dates that gives everyone the link to our wedding website & refers them to our travel agent. So now I'm working on picking out items in the wedding catalog to prep for my 2nd phone meeting with Roxi. So exciting! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ffa07a;\"><span style=\"font-size:18px;\"><em> <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wub.png' class='bbc_emoticon' alt=':wub:' \/>\u00a0 <span style=\"font-size:14px;\"><span style=\"font-family:georgia, serif;\">\"I Would Gladly Live Out Of A Suitcase If It Meant I Could See The World.\"<\/span><\/span> <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wub.png' class='bbc_emoticon' alt=':wub:' \/>\u00a0<\/em><\/span><\/span>","Email":"kennyandaliciawedding@gmail.com","IpAddress":"199.173.226.235","GroupId":39,"GroupName":"Newbie","JoinDate":1375536036,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272208.jpg?_r=1403268709","PhotoWidth":200,"PhotoHeight":250,"PhotoType":"custom"},"FormattedName":"LeeLee1106","Id":272208,"Name":"LeeLee1106","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"67.243.167.228","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77134,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f15411d65b649b42b6fbdfb95cd009c0","RawContent":"&lt;p&gt;I am getting married at the beaches T&amp;amp;C august 2015. we originally wanted bahamas but decided on a more unique location that way we can all experience and visit a new place together very excited&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1858894,"PostDate":1404962864,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I am getting married at the beaches T&C august 2015. we originally wanted bahamas but decided on a more unique location that way we can all experience and visit a new place together very excited\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"katevarela@yahoo.com","IpAddress":"108.29.83.138","GroupId":39,"GroupName":"Newbie","JoinDate":1370626907,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270352.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"katevarela1","Id":270352,"Name":"katevarela1","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.242.230.18","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77134,"EditedBy":"<strong>Edited by soitsmox, 14 August 2014 - 09:53 AM.<\/strong>","EditDate":1408038828,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7d0172a0606a25291b8d4478542cc3a6","RawContent":"&lt;p&gt;Hi all! We will be getting married in April 2016. I couldn&#039;t find a 2016 forum so I thought posting here would be beneficial. I am actually calling to book at Beaches T&amp;amp;C resort tomorrow morning to get started on our wedding planning process.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Does anyone have any idea what the average price is for guests of the wedding?&lt;\/p&gt;","Attachments":[],"Id":1866376,"PostDate":1408038787,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi all! We will be getting married in April 2016. I couldn't find a 2016 forum so I thought posting here would be beneficial. I am actually calling to book at Beaches T&C resort tomorrow morning to get started on our wedding planning process.<\/p>\n<p>\u00a0<\/p>\n<p>Does anyone have any idea what the average price is for guests of the wedding?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"soitsmox@yahoo.com","IpAddress":"66.242.230.18","GroupId":39,"GroupName":"Newbie","JoinDate":1408037350,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279439.jpg?_r=1417844148","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"soitsmox","Id":279439,"Name":"soitsmox","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"98.178.240.147","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77134,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6f3f159dbd1b79b12d65fa7eba2ac014","RawContent":"&lt;p&gt;I say read all the reviews on here... We have worked all over the bahamas and Jamaica, there are definitely things to look out for and research. Feel free to ask us any quesions as we have been in the business for 8 years and can give you insight as to what the norm is - rates - what to avoid - and what questions to ask your photographer :)&amp;nbsp; Happy to help!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thank you,\n\n\nJanel Conlan\n\nFocus Photography, Inc.\n\n&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.focusphotoinc.com&#039;&gt;http:\/\/www.focusphotoinc.com&lt;\/a&gt;\n\n&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.focusphotoinc.com\/blog&#039;&gt;http:\/\/www.focusphotoinc.com\/blog&lt;\/a&gt;\n\nP: 949.342.4443 F: 949.272.5147\n\n\nSee us featured in:&amp;nbsp; Grace Ormonde, Ceremony, Style Me Pretty, and Green Wedding Shoes!\n\n\nBecome a Fan!&amp;nbsp; &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.facebook.com\/focusphotoinc&#039;&gt;http:\/\/www.facebook.com\/focusphotoinc&lt;\/a&gt;\n\nFollow Us!&amp;nbsp; &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/twitter.com\/#!\/focusphotoinc&#039;&gt;http:\/\/twitter.com\/#!\/focusphotoinc&lt;\/a&gt;\n\nPin Us! &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.pinterest.com\/focusphotoinc\/&#039;&gt;http:\/\/www.pinterest.com\/focusphotoinc\/&lt;\/a&gt;\n\n\n\n&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1868163,"PostDate":1408683782,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I say read all the reviews on here... We have worked all over the bahamas and Jamaica, there are definitely things to look out for and research. Feel free to ask us any quesions as we have been in the business for 8 years and can give you insight as to what the norm is - rates - what to avoid - and what questions to ask your photographer <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0 Happy to help!<\/p>\n<p>\u00a0<\/p>\n<p>Thank you,<br><br>\nJanel Conlan<br>\nFocus Photography, Inc.<br>\n<a href='http:\/\/www.focusphotoinc.com' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.focusphotoinc.com<\/a><br>\n<a href='http:\/\/www.focusphotoinc.com\/blog' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.focusphotoinc.com\/blog<\/a><br>\nP: 949.342.4443 F: 949.272.5147<br><br>\nSee us featured in:\u00a0 Grace Ormonde, Ceremony, Style Me Pretty, and Green Wedding Shoes!<br><br>\nBecome a Fan!\u00a0 <a href='http:\/\/www.facebook.com\/focusphotoinc' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.facebook.com\/focusphotoinc<\/a><br>\nFollow Us!\u00a0 <a href='http:\/\/twitter.com\/#!\/focusphotoinc' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/twitter.com\/#!\/focusphotoinc<\/a><br>\nPin Us! <a href='http:\/\/www.pinterest.com\/focusphotoinc\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.pinterest...\/focusphotoinc\/<\/a><br><br><br>\n\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"janel@focusphotoinc.com","IpAddress":"98.178.240.147","GroupId":40,"GroupName":"Jr. Member","JoinDate":1220269500,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211497.gif?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"focusphoto","Id":211497,"Name":"focusphoto","IsOnline":false}}],"Id":"77134","Title":"2015 Beaches Turks & Caicos Brides","LastPostDate":1436763353},"Pages":{"TotalItems":16,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
