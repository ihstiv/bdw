{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":3,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":171,"MovedTo":null,"MovedOn":0,"FirstPostId":1908398,"Rating":0,"RatingHits":0,"Starter":{"Id":285602,"Name":"MissWest","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1450224178,"LastPoster":{"Id":230711,"Name":"Moments That Matter","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1908398,"PostDate":1450224178,"PostContent":"Hello everyone my name is Shaneque and I recently got engaged in August of this year. I was plann...","Author":{"Signature":"","Email":"annalee2913@gmail.com","IpAddress":"104.229.187.230","GroupId":39,"GroupName":"Newbie","JoinDate":1450223862,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"MissWest","Id":285602,"Name":"MissWest","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"104.229.187.230","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79797,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6b8976a3dc8009135ed6503c68d01946","RawContent":"Hello everyone my name is Shaneque and I recently got engaged in August of this year. I was planning a traditional wedding but then a coworker told me about his destination wedding and the price of it was half the reception fee. I went researching and tried a lady who does the planning but got discouraged today once she sent me pricing options for hotels for my guest. I mean is 600-700 the normal range for 3 night stays? I thought that was ridiculous. Also ladies if you have any tips or recommendations please let me know. If you planned your destination wedding on your own please fill me in. \n\n\n\nSincerely, \n\n\nA Newbie","Attachments":[],"Id":1908398,"PostDate":1450224178,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hello everyone my name is Shaneque and I recently got engaged in August of this year. I was planning a traditional wedding but then a coworker told me about his destination wedding and the price of it was half the reception fee. I went researching and tried a lady who does the planning but got discouraged today once she sent me pricing options for hotels for my guest. I mean is 600-700 the normal range for 3 night stays? I thought that was ridiculous. Also ladies if you have any tips or recommendations please let me know. If you planned your destination wedding on your own please fill me in. <br><br><br>\nSincerely, <br><br>\nA Newbie \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"annalee2913@gmail.com","IpAddress":"104.229.187.230","GroupId":39,"GroupName":"Newbie","JoinDate":1450223862,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"MissWest","Id":285602,"Name":"MissWest","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"200.79.251.123","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79797,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9ab3f9c3cab672b5e01792596a262b1e","RawContent":"[quote name=\"MissWest\" post=\"1908398\" timestamp=\"1450245778\"]\nHello everyone my name is Shaneque and I recently got engaged in August of this year. I was planning a traditional wedding but then a coworker told me about his destination wedding and the price of it was half the reception fee. I went researching and tried a lady who does the planning but got discouraged today once she sent me pricing options for hotels for my guest. I mean is 600-700 the normal range for 3 night stays? I thought that was ridiculous. Also ladies if you have any tips or recommendations please let me know. If you planned your destination wedding on your own please fill me in.\n\n\nSincerely,\n\nA Newbie[\/quote]@[member=\"MissWest\"] Congrats on your engagement and welcome to the forum.  My first advice , you might want to get in touch with a travel agent who specializes in Destination Wedding. There owners of this page are travel agent.  Also check out the low season resort prices depending on where you prefer to have your wedding. you might find some good deals.  \n\nSo many Brides do plan on their own especially when having a resort wedding.\n\n\nHappy Planning!\nJoyce","Attachments":[],"Id":1908406,"PostDate":1450259519,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>MissWest, on 16 December 2015 - 12:02 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hello everyone my name is Shaneque and I recently got engaged in August of this year. I was planning a traditional wedding but then a coworker told me about his destination wedding and the price of it was half the reception fee. I went researching and tried a lady who does the planning but got discouraged today once she sent me pricing options for hotels for my guest. I mean is 600-700 the normal range for 3 night stays? I thought that was ridiculous. Also ladies if you have any tips or recommendations please let me know. If you planned your destination wedding on your own please fill me in.<br><br><br>\nSincerely,<br><br>\nA Newbie<\/p>\n<\/div>\n<\/div><\/div>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"285602\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/285602-misswest\/' title='Member profile'><span itemprop=\"name\">MissWest<\/span><\/a> Congrats on your engagement and welcome to the forum. \u00a0My first advice , you might want to get in touch with a travel agent who specializes in Destination Wedding. There owners of this page are travel agent. \u00a0Also check out the low season resort prices depending on where you prefer to have your wedding. you might find some good deals. \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>So many Brides do plan on their own especially when having a resort wedding.<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Happy Planning!<\/p>\n<p>Joyce<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"Dream Weddings Riviera Maya- We pay attention to your wishes and coordinate closely with you to ensure your wedding or event is planned to perfection!<br \/>\n<br \/>\n<span style='color: rgb(40,40,40)'><span style='font-family: arial'><span style='font-size: 12px;'>Dream Weddings Riviera Maya<\/span><\/span><\/span><br \/>\n<span style='font-family: arial'><span style='font-size: 12px;'>weddingsinplayadelcarmen@gmail.com<\/span><\/span><br \/>\n<a class='bbc_url' href='http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html'>http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html<\/a><br \/>\n<br \/>\n<span style='color: rgb(40,40,40)'><span style='font-family: arial'><span style='font-size: 12px;'>Happy Planning!<\/span><\/span><\/span><br \/>\n<span style='color: rgb(40,40,40)'><span style='font-family: arial'><span style='font-size: 12px;'>Joyce<\/span><\/span><\/span>","Email":"weddingsinplayadelcarmen@gmail.com","IpAddress":"187.252.44.28","GroupId":84,"GroupName":"Insiders w\/ Articles","JoinDate":1326832787,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250090.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"dreamweddings","Id":250090,"Name":"dreamweddings","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.173.185.200","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79797,"EditedBy":"<strong>Edited by Moments That Matter, Yesterday, 12:43 PM.<\/strong>","EditDate":1450356237,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d8807b38cdaf60e155ebef9ef669cefd","RawContent":"&lt;p&gt;Welcome to our forum community Shaneque and Congrats on your engagement!!! Having a destination wedding is a very popular choice with so many wedding couples now - it must have lots going for it :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Also, well done on getting a great start by joining these boards - where you&#039;ll find loads of great info, advice, suggestions and support from everyone :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;For some added inspiration, here are some magical beach wedding moments that matter we captured in our magnificent Mayan Riviera .....enjoy!!!&lt;\/p&gt;\n&lt;p&gt;....taken from our &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10150695320839487.414941.18683524486&amp;amp;type=3&#039;&gt;Cover Photos Album: &lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xlt1\/t31.0-8\/12304126_10153785339774487_6948717609887949276_o.jpg\" alt=\"12304126_10153785339774487_6948717609887\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xlf1\/t31.0-8\/12377667_10153801991899487_5768906123118180581_o.jpg\" alt=\"12377667_10153801991899487_5768906123118\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xtp1\/t31.0-8\/12322648_10153777529559487_6837158251311223462_o.jpg\" alt=\"12322648_10153777529559487_6837158251311\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Wishing you happy research and all the best with your plans - cheers!!! team MTM :)&lt;\/p&gt;","Attachments":[],"Id":1908442,"PostDate":1450355675,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome to our forum community Shaneque and Congrats on your engagement!!! Having a destination wedding is a very popular choice with so many wedding couples now - it must have lots going for it <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Also, well done on getting a great start by joining these boards - where you'll find loads of great info, advice, suggestions and support from everyone <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>For some added inspiration, here are some magical beach wedding moments that matter we captured in our magnificent Mayan Riviera .....enjoy!!!<\/p>\n<p>....taken from our <a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10150695320839487.414941.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>Cover Photos Album: <\/a><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xlt1\/t31.0-8\/12304126_10153785339774487_6948717609887949276_o.jpg\" alt=\"12304126_10153785339774487_6948717609887\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xlf1\/t31.0-8\/12377667_10153801991899487_5768906123118180581_o.jpg\" alt=\"12377667_10153801991899487_5768906123118\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xtp1\/t31.0-8\/12322648_10153777529559487_6837158251311223462_o.jpg\" alt=\"12322648_10153777529559487_6837158251311\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>Wishing you happy research and all the best with your plans - cheers!!! team MTM <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280189060,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}}],"Id":"79797","Title":"Discouraged And Confused","LastPostDate":1450355675},"Pages":{"TotalItems":3,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
