{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":6,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":1002,"MovedTo":null,"MovedOn":0,"FirstPostId":1849315,"Rating":0,"RatingHits":0,"Starter":{"Id":277909,"Name":"lnb2014","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1399670658,"LastPoster":{"Id":283797,"Name":"michaelgoodall","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":57,"Preview":{"Id":1899744,"PostDate":1435930154,"PostContent":"Congrats dear.","Author":{"Signature":"","Email":"johnshepard2015@outlook.com","IpAddress":"45.61.34.188","GroupId":39,"GroupName":"Newbie","JoinDate":1435928814,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"michaelgoodall","Id":283797,"Name":"michaelgoodall","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"170.20.11.11","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77026,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"08e944c025a9465a1f14244a8a741384","RawContent":"&lt;p&gt;&lt;span style=\"color:#2c2c2c;\"&gt;&lt;span style=\"font-family:calibri, sans-serif;\"&gt;My husband and I got married on a beautiful private beach in Montego Bay in April 2014 with only 8 days of planning!! We could not have done this without all of the hard and diligent work of Dawn Sherman of Jamaica Elegant Weddings. We had received a free trip to Jamaica that we booked 3 weeks before, and after being engaged for over 2 \u00bd years and trying to save $ for a wedding, honeymoon, and new house, &amp;nbsp;we felt in our hearts that we wanted to finally get married while in Jamaica, just the 2 of us. After researching online, I didn\u2019t think we would be able to find anyone who could help us get it planned on such short notice. I read a lot of great reviews about Dawn and Jamaica Elegant Weddings, and really liked what I saw on her website (the \u201cMini Package\u201d) which was exactly what we wanted! I sent her an email late in the day 10 days before our trip telling her the situation and our travel dates and asking if there was any way possible she could help us. &amp;nbsp;I thought that if it were meant to me, then I would have a reply from her the next morning. When I got to work the next morning and saw that she had replied and said she would be happy to help us, I knew it was meant to be! I had such a great feeling about her from the start. She was so warm and accommodating. We emailed daily up until the day before we left for Jamaica, and she made it so easy!! She walked me through everything and answered all questions quickly \u2013 from the required legal paperwork that I scanned and emailed to her to the wedding agreement, ceremony details, photographer, flowers colors, etc. This was all done on email, and we never spoke on the phone, yet I still had total trust in her. We finally met in person the day before the wedding when she came to our resort to meet with us. She was exactly what I had expected, so kind with a beautiful soul! Our wedding was perfect!!! We had a lovely floral arch and flower petal decorated aisle, beautiful bouquet, boutonniere, and wedding cake. We could not have been happier with the minister, Reverend Trevor Ruddock. He made our ceremony so special. We felt so lucky to have him marry us. The photographer, Andrew Vassell, exceeded our expectations. He took pictures during the wedding and did a photo shoot afterwards. He was so easy going and friendly and took some amazing photos! There were 10 photos on DVD included in our package, but we ended up buying &amp;nbsp;several more from him at a good price since we could not choose only 10. This was such a stress free experience, which usually is not the case with weddings! Dawn took care of everything, and all we had to do was show up and relax and enjoy ourselves. I cannot express enough how grateful I am for putting my faith in Dawn to make this such a memorable and stress free wedding. If you are wanting to get married in Jamaica- big or small, Dawn from Jamaica Elegant Weddings is the one to use! &lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1849315,"PostDate":1399670658,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span  style=\"color:#2c2c2c\"><span  style=\"font-family:calibri, sans-serif\">My husband and I got married on a beautiful private beach in Montego Bay in April 2014 with only 8 days of planning!! We could not have done this without all of the hard and diligent work of Dawn Sherman of Jamaica Elegant Weddings. We had received a free trip to Jamaica that we booked 3 weeks before, and after being engaged for over 2 \u00bd years and trying to save $ for a wedding, honeymoon, and new house, \u00a0we felt in our hearts that we wanted to finally get married while in Jamaica, just the 2 of us. After researching online, I didn\u2019t think we would be able to find anyone who could help us get it planned on such short notice. I read a lot of great reviews about Dawn and Jamaica Elegant Weddings, and really liked what I saw on her website (the \u201cMini Package\u201d) which was exactly what we wanted! I sent her an email late in the day 10 days before our trip telling her the situation and our travel dates and asking if there was any way possible she could help us. \u00a0I thought that if it were meant to me, then I would have a reply from her the next morning. When I got to work the next morning and saw that she had replied and said she would be happy to help us, I knew it was meant to be! I had such a great feeling about her from the start. She was so warm and accommodating. We emailed daily up until the day before we left for Jamaica, and she made it so easy!! She walked me through everything and answered all questions quickly \u2013 from the required legal paperwork that I scanned and emailed to her to the wedding agreement, ceremony details, photographer, flowers colors, etc. This was all done on email, and we never spoke on the phone, yet I still had total trust in her. We finally met in person the day before the wedding when she came to our resort to meet with us. She was exactly what I had expected, so kind with a beautiful soul! Our wedding was perfect!!! We had a lovely floral arch and flower petal decorated aisle, beautiful bouquet, boutonniere, and wedding cake. We could not have been happier with the minister, Reverend Trevor Ruddock. He made our ceremony so special. We felt so lucky to have him marry us. The photographer, Andrew Vassell, exceeded our expectations. He took pictures during the wedding and did a photo shoot afterwards. He was so easy going and friendly and took some amazing photos! There were 10 photos on DVD included in our package, but we ended up buying \u00a0several more from him at a good price since we could not choose only 10. This was such a stress free experience, which usually is not the case with weddings! Dawn took care of everything, and all we had to do was show up and relax and enjoy ourselves. I cannot express enough how grateful I am for putting my faith in Dawn to make this such a memorable and stress free wedding. If you are wanting to get married in Jamaica- big or small, Dawn from Jamaica Elegant Weddings is the one to use! <\/span><\/span><\/p>\n<p>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lsnorman@cbs.com","IpAddress":"170.20.11.11","GroupId":39,"GroupName":"Newbie","JoinDate":1399669999,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"lnb2014","Id":277909,"Name":"lnb2014","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.235.105.205","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77026,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"267ff45ad53c249f6c55e3828a1af7a9","RawContent":"&lt;p&gt;Congratulations!&lt;\/p&gt;","Attachments":[],"Id":1849333,"PostDate":1399677957,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congratulations!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"malyna@gmail.com","IpAddress":"71.235.105.205","GroupId":40,"GroupName":"Jr. Member","JoinDate":1397443622,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277580.jpg?_r=1397779480","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"malyna","Id":277580,"Name":"malyna","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.227.231.192","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77026,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c8fce5d354bdcf6745603be7411e6be1","RawContent":"&lt;p&gt;Congrats!&lt;\/p&gt;","Attachments":[],"Id":1849345,"PostDate":1399684727,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Happy Planning Future Brides!<\/p>\n<p>Love, Mrs. Gedney! <3<\/p>\n<p>11.18.2014","Email":"psaca@me.com","IpAddress":"99.227.231.192","GroupId":40,"GroupName":"Jr. Member","JoinDate":1372257073,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270939.jpg?_r=1423518723","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"pamelas21","Id":270939,"Name":"pamelas21","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.177.207.218","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77026,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bd843dcacb102ef80132582832b67337","RawContent":"&lt;p&gt;Congrats! We leave in 3 days!! We are going to Sandals Whitehouse&lt;\/p&gt;","Attachments":[],"Id":1849352,"PostDate":1399689432,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats! We leave in 3 days!! We are going to Sandals Whitehouse<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jessica.f.waggoner.mil@mail.mil","IpAddress":"192.138.57.36","GroupId":40,"GroupName":"Jr. Member","JoinDate":1399564397,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"seka21","Id":277895,"Name":"seka21","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"98.24.148.177","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77026,"EditedBy":"<strong>Edited by lnb2014, 10 May 2014 - 01:20 PM.<\/strong>","EditDate":1399756832,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f4d3e8661661b75dda75c580a5efe884","RawContent":"&lt;p&gt;Thank you all!! I forgot to include that Jamaica Elegant Weddings was so affordable!!! Dawn has different packages online, but allows you to customize them (add, remove services) based on your budget. I kept the Mini Package as is since it was such a great price!!&lt;\/p&gt;","Attachments":[],"Id":1849512,"PostDate":1399756616,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thank you all!! I forgot to include that Jamaica Elegant Weddings was so affordable!!! Dawn has different packages online, but allows you to customize them (add, remove services) based on your budget. I kept the Mini Package as is since it was such a great price!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lsnorman@cbs.com","IpAddress":"170.20.11.11","GroupId":39,"GroupName":"Newbie","JoinDate":1399669999,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"lnb2014","Id":277909,"Name":"lnb2014","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"45.61.34.188","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77026,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"52237480ef1116eeeba2213122fd11e8","RawContent":"&lt;p&gt;Congrats dear.&lt;\/p&gt;","Attachments":[],"Id":1899744,"PostDate":1435930154,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats dear.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"johnshepard2015@outlook.com","IpAddress":"45.61.34.188","GroupId":39,"GroupName":"Newbie","JoinDate":1435928814,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"michaelgoodall","Id":283797,"Name":"michaelgoodall","IsOnline":false}}],"Id":"77026","Title":"Jamaica Elegant Weddings","LastPostDate":1435930154},"Pages":{"TotalItems":6,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}