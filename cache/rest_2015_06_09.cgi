{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":55,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":2930,"MovedTo":null,"MovedOn":0,"FirstPostId":1856587,"Rating":0,"RatingHits":0,"Starter":{"Id":276748,"Name":"diadiamond","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276748.jpg?_r=1392867144","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"IsOnline":false},"StartDate":1403512144,"LastPoster":{"Id":278186,"Name":"helenk","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278186.jpg?_r=1417419505","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":39,"Preview":{"Id":1883070,"PostDate":1421364014,"PostContent":"I'm so jealous!! I can't wait to be on the plane!","Author":{"Signature":"","Email":"hkorkovilis@gmail.com","IpAddress":"162.238.70.23","GroupId":40,"GroupName":"Jr. Member","JoinDate":1401609292,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278186.jpg?_r=1417419505","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"helenk","Id":278186,"Name":"helenk","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.234.136.182","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77385,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e2699e43c7e3dfa5f46f14613951bb0c","RawContent":"&lt;p&gt;Hi Everyone!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;m just wondering what your fitness goals are and how you plan to achieve it?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Weight has always been a struggle for me my entire life. &amp;nbsp;I was always overweight. &amp;nbsp;I got up to 265 lbs when I was 17 and then decided to join Herbal Magic where I lost 100 lbs. &amp;nbsp;When I started University I gained 70 of the 100 lbs that I lost. &amp;nbsp;At the end of University I got back up to 235 lbs and decided to make another healthy lifestyle change in my life. &amp;nbsp;Through diet and exercise with a trainer I managed to lose 40 lbs. &amp;nbsp;I went back to college and gained the 40 lbs that I lost.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I haven&#039;t booked my wedding yet, but we&#039;re hoping for the end of 2015. &amp;nbsp;I&#039;d really like to lose about 50 or 60 pounds. &amp;nbsp;I feel so discouraged because I have gained and lost it so many times that I feel like I&#039;m just bound to fail. &amp;nbsp;I&#039;m also torn between using another weight loss program or doing it the old fashioned way again.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1856587,"PostDate":1403512144,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Everyone!<\/p>\n<p>\u00a0<\/p>\n<p>I'm just wondering what your fitness goals are and how you plan to achieve it?<\/p>\n<p>\u00a0<\/p>\n<p>Weight has always been a struggle for me my entire life. \u00a0I was always overweight. \u00a0I got up to 265 lbs when I was 17 and then decided to join Herbal Magic where I lost 100 lbs. \u00a0When I started University I gained 70 of the 100 lbs that I lost. \u00a0At the end of University I got back up to 235 lbs and decided to make another healthy lifestyle change in my life. \u00a0Through diet and exercise with a trainer I managed to lose 40 lbs. \u00a0I went back to college and gained the 40 lbs that I lost.<\/p>\n<p>\u00a0<\/p>\n<p>I haven't booked my wedding yet, but we're hoping for the end of 2015. \u00a0I'd really like to lose about 50 or 60 pounds. \u00a0I feel so discouraged because I have gained and lost it so many times that I feel like I'm just bound to fail. \u00a0I'm also torn between using another weight loss program or doing it the old fashioned way again.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div><br><div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;484\/st\/20150924\/e\/Our+Wedding\/k\/8745\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<\/div>\n<div>\u00a0<\/div>\n<div>My Planning Thread:<\/div>\n<div>\u00a0<\/div>\n<div><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79153-diadiamonds-planning-thread-iberostar-varadero-cuba-sept242015\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79153-diadiamonds-planning-thread-iberostar-varadero-cuba-sept242015\/<\/a><\/div>\n<div>\u00a0<\/div>\n<div>\u00a0<\/div>\n","Email":"fadia.daniel@gmail.com","IpAddress":"76.64.81.211","GroupId":40,"GroupName":"Jr. Member","JoinDate":1392646043,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276748.jpg?_r=1392867144","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"diadiamond","Id":276748,"Name":"diadiamond","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.147.0.145","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77385,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"13f2b268f36f4aacd18cff2837a1dc62","RawContent":"&lt;p&gt;If you want the \"grass isn&#039;t greener\" scenerio- I&#039;m actually trying to gain weight. I&#039;ve always been underweight, which doesnt help when coupled with my hate for taking the time to cook &amp;amp; eat meals. I weigh 109 right now (104 when I started 3 months ago) and I&#039;m hoping to get up to 115 by the time my wedding comes in November.&lt;\/p&gt;","Attachments":[],"Id":1856590,"PostDate":1403512818,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>If you want the \"grass isn't greener\" scenerio- I'm actually trying to gain weight. I've always been underweight, which doesnt help when coupled with my hate for taking the time to cook & eat meals. I weigh 109 right now (104 when I started 3 months ago) and I'm hoping to get up to 115 by the time my wedding comes in November.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"amanda.hodges1@snhu.edu","IpAddress":"24.62.217.165","GroupId":39,"GroupName":"Newbie","JoinDate":1398520337,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277733.jpg?_r=1400873765","PhotoWidth":200,"PhotoHeight":213,"PhotoType":"custom"},"FormattedName":"BusyBee280","Id":277733,"Name":"BusyBee280","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.222.215.154","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77385,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"e3ecb7f61177f688d49b62b7407e609a","RawContent":"I am starting my get fit plan today!! I am 160lbs, have been this same weight for years, but I would like to lose 10-15 lbs and just not feel so soft! Hopefully I can achieve my goals in the next 4 months!","Attachments":[],"Id":1856594,"PostDate":1403514459,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I am starting my get fit plan today!! I am 160lbs, have been this same weight for years, but I would like to lose 10-15 lbs and just not feel so soft! Hopefully I can achieve my goals in the next 4 months!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"candle_23@hotmail.com","IpAddress":"66.222.215.154","GroupId":40,"GroupName":"Jr. Member","JoinDate":1375743701,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272291.jpg?_r=1388954341","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"candle23","Id":272291,"Name":"candle23","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.197.53.90","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77385,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":3,"IsLiked":false,"PostKey":"2ca3ea6ba7722af6727b87115a3b9971","RawContent":"&lt;p&gt;I am trying to lose 10 lbs before my wedding in April 2015. It is really tough to lose it and keep it off. My fiance and I have been working out together and it has been helping to keep us both motivated.We dont go to the gym but are using at home workout videos that incorporate weight training and cardio. We hurt like crazy when we are done but its so worth it. I havent lost any weight but I have turned fat into muscle and thats a great start. Keep trying and don&#039;t get discouraged. You can do it.&lt;\/p&gt;","Attachments":[],"Id":1856595,"PostDate":1403514789,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I am trying to lose 10 lbs before my wedding in April 2015. It is really tough to lose it and keep it off. My fiance and I have been working out together and it has been helping to keep us both motivated.We dont go to the gym but are using at home workout videos that incorporate weight training and cardio. We hurt like crazy when we are done but its so worth it. I havent lost any weight but I have turned fat into muscle and thats a great start. Keep trying and don't get discouraged. You can do it.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mandiesueb@yahoo.com","IpAddress":"38.99.122.168","GroupId":40,"GroupName":"Jr. Member","JoinDate":1388865717,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275879.jpg?_r=1431174019","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"Mandiesue","Id":275879,"Name":"Mandiesue","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"206.223.185.220","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77385,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"04b48e4febf2d33b7141e967811d08e1","RawContent":"&lt;p&gt;When you get old like me, weight becomes even more of a struggle. I never had a weight problem until I hit 40. I had been warned.... lol The doctor said it gets harder after that age. Well, add on a few more years past 40, and the fact that I truly have met the love of my life and am happier than I have ever been, that translates into weight gain. Plus serious health issues, major surgery with lingering issues and an extended hospital stay. Well that all adds up to about 35 extra pounds. I would love nothing more than to lose it. I have arthritis as well, so exercise is a love hate relationship. I love to hate it because of how painful it can be. With the next hospital stay now booked and what the hopes are this time around, it should mean losing about 20 lbs and hoping it doesn&#039;t come back on. Then with everything hopefully normal after this, trying to lose an additional 15 to 20 lbs.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;All depending on how things go and the hope that more surgery isn&#039;t needed in the spring, which would throw all the plans right out the window!!!&lt;\/p&gt;","Attachments":[],"Id":1856600,"PostDate":1403517183,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>When you get old like me, weight becomes even more of a struggle. I never had a weight problem until I hit 40. I had been warned.... lol The doctor said it gets harder after that age. Well, add on a few more years past 40, and the fact that I truly have met the love of my life and am happier than I have ever been, that translates into weight gain. Plus serious health issues, major surgery with lingering issues and an extended hospital stay. Well that all adds up to about 35 extra pounds. I would love nothing more than to lose it. I have arthritis as well, so exercise is a love hate relationship. I love to hate it because of how painful it can be. With the next hospital stay now booked and what the hopes are this time around, it should mean losing about 20 lbs and hoping it doesn't come back on. Then with everything hopefully normal after this, trying to lose an additional 15 to 20 lbs.<\/p>\n<p>\u00a0<\/p>\n<p>All depending on how things go and the hope that more surgery isn't needed in the spring, which would throw all the plans right out the window!!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283440999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1426134867","PhotoWidth":668,"PhotoHeight":600,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.208.77.90","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77385,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"16defe6650bb003f6a7cbfe85cd7a33d","RawContent":"I am currently 170-175 depending on the day....my very realistic goal is 150 since I dropped to that last yr doing isagenix for 6 weeks....my ideal goal would be 135....but I am looking to do more working out this time and would be content at 150 but toned with some muscle...I don&#039;t have time to go to the gym so I have been doing the elliptical 2-3x a week and then alternating arms, legs, and abs...hopefully I can stick with it","Attachments":[],"Id":1856604,"PostDate":1403518310,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I am currently 170-175 depending on the day....my very realistic goal is 150 since I dropped to that last yr doing isagenix for 6 weeks....my ideal goal would be 135....but I am looking to do more working out this time and would be content at 150 but toned with some muscle...I don't have time to go to the gym so I have been doing the elliptical 2-3x a week and then alternating arms, legs, and abs...hopefully I can stick with it\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Jamie","Email":"lovinmylilone@yahoo.com","IpAddress":"70.192.94.81","GroupId":40,"GroupName":"Jr. Member","JoinDate":1400754382,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Nybride525","Id":278074,"Name":"Nybride525","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"206.223.185.220","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77385,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"67f307ee4d9fb899aec13d79005ce2e8","RawContent":"&lt;p&gt;You know, I&#039;m thinking while reading the different comments here that there really is absolutely no reason why wedding dresses should be modelled by women that would disappear if they turned sideways!!&lt;\/p&gt;","Attachments":[],"Id":1856653,"PostDate":1403538310,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>You know, I'm thinking while reading the different comments here that there really is absolutely no reason why wedding dresses should be modelled by women that would disappear if they turned sideways!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283440999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1426134867","PhotoWidth":668,"PhotoHeight":600,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"69.157.30.223","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77385,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"37f3ccc3d7f59a44edae2a0f12eaf5ea","RawContent":"I agree not really a good representation of how it will look. It&#039;s the same with bathing suits. I am ordering bathing suits from Victoria secret and every girl wearing them are tooth picks, that&#039;s not how I will look wearing it. \n\nI personally don&#039;t struggle with weight but I just had a baby and would like to tone up a bunch before the wedding. My fianc\u00e9 has gained much more and I am trying to motivate us both to help each other but he isn&#039;t into it much. I will keep trying though. \n\n@[member=\"diadiamond\"] I think it&#039;s great how much success you have had in the past, you defiantly have the motivation, it&#039;s tough when you end up back where you started. If you did it then you can do it now! I am a believer of the old fashion way eating well and tons of exercise but that&#039;s all I have ever needed. I do hear curves is really good from some friends who have lost tons of weight. I just keep thinking how beautiful I want to feel in my dress and on the beach and it&#039;s keeping me motivated :)","Attachments":[],"Id":1856664,"PostDate":1403539866,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I agree not really a good representation of how it will look. It's the same with bathing suits. I am ordering bathing suits from Victoria secret and every girl wearing them are tooth picks, that's not how I will look wearing it. <br>\nI personally don't struggle with weight but I just had a baby and would like to tone up a bunch before the wedding. My fianc\u00e9 has gained much more and I am trying to motivate us both to help each other but he isn't into it much. I will keep trying though. <br>\n@<a hovercard-ref=\"member\" hovercard-id=\"276748\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/276748-diadiamond\/' title='Member profile'><span itemprop=\"name\">diadiamond<\/span><\/a> I think it's great how much success you have had in the past, you defiantly have the motivation, it's tough when you end up back where you started. If you did it then you can do it now! I am a believer of the old fashion way eating well and tons of exercise but that's all I have ever needed. I do hear curves is really good from some friends who have lost tons of weight. I just keep thinking how beautiful I want to feel in my dress and on the beach and it's keeping me motivated <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>55 guests booked plus bride and groom <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>","Email":"drkt0010@hotmail.com","IpAddress":"50.101.144.156","GroupId":40,"GroupName":"Jr. Member","JoinDate":1396290778,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277431.jpg?_r=1423500629","PhotoWidth":200,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"Dreamteam17","Id":277431,"Name":"Dreamteam17","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.249.122.85","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77385,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"3c6a5ed3753416676c31f51cb3608a00","RawContent":"&lt;p&gt;I am about 140lbs right now, since starting grad school about&amp;nbsp;4 years ago I have slowly gained about 15 pounds. I&amp;nbsp; actually decided before I got engaged that I was tired of how I felt so I started going to the gym (Goodlife). Since starting I haven&#039;t actually lost any weight, but I have lost inches and have toned up. I do cardio and weights 4-6 times a week. I do Body pump, so if anyone in Canada is looking to get in better shape I would recommended going to that class. It is definitely tough, but it pays off!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;m more worried about looking good in a bathing suit in front of friends and family than what I look like in my dress!&lt;\/p&gt;","Attachments":[],"Id":1856686,"PostDate":1403548173,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I am about 140lbs right now, since starting grad school about\u00a04 years ago I have slowly gained about 15 pounds. I\u00a0 actually decided before I got engaged that I was tired of how I felt so I started going to the gym (Goodlife). Since starting I haven't actually lost any weight, but I have lost inches and have toned up. I do cardio and weights 4-6 times a week. I do Body pump, so if anyone in Canada is looking to get in better shape I would recommended going to that class. It is definitely tough, but it pays off!<\/p>\n<p>\u00a0<\/p>\n<p>I'm more worried about looking good in a bathing suit in front of friends and family than what I look like in my dress!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kelly_miller_@hotmail.com","IpAddress":"99.249.122.85","GroupId":40,"GroupName":"Jr. Member","JoinDate":1390754931,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kellymiller","Id":276338,"Name":"kellymiller","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.75.116.50","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77385,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"3a3447778dcc197228ecc284d043d403","RawContent":"I&#039;m struggling with weight. I&#039;m approx. 182-188 depending on what I ate that week. I would love to get to 165-170. I have been power walking lately, and going to sign up for a 5k. My goal is to do 1 5k every other month until the wedding date.","Attachments":[],"Id":1856692,"PostDate":1403554460,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm struggling with weight. I'm approx. 182-188 depending on what I ate that week. I would love to get to 165-170. I have been power walking lately, and going to sign up for a 5k. My goal is to do 1 5k every other month until the wedding date.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"pinkiesup08@gmail.com","IpAddress":"75.181.5.152","GroupId":47,"GroupName":"Site Supporter","JoinDate":1374596124,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-271841.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"RandL2015","Id":271841,"Name":"RandL2015","IsOnline":false}}],"Id":"77385","Title":"What Are Your Fitness Goals?","LastPostDate":1421364014},"Pages":{"TotalItems":55,"TotalPages":6,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":50},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
