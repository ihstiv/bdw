g if anyone has stayed in either of the Riu Palaces (Mexico\/Riviera M...","Author":{"Signature":"","Email":"joanne.aguiar@gmail.com","IpAddress":"99.234.116.105","GroupId":39,"GroupName":"Newbie","JoinDate":1424038909,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282128.jpg?_r=1426731614","PhotoWidth":200,"PhotoHeight":114,"PhotoType":"custom"},"FormattedName":"JoannaBanana","Id":282128,"Name":"JoannaBanana","IsOnline":false}},"Posts":[],"Id":"78807","Title":"Question Re: Riviera Maya Rius","LastPostDate":1433418940},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":23,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":906,"MovedTo":null,"MovedOn":0,"FirstPostId":1893924,"Rating":0,"RatingHits":0,"Starter":{"Id":282824,"Name":"yuniedo","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1429693952,"LastPoster":{"Id":282648,"Name":"ckelly2581","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":2,"Preview":{"Id":1893924,"PostDate":1429693952,"PostContent":"Hi everyone,\u00a0 \u00a0 I didn't see a thread for us 2016 brides at Dreams Riviera Cancun so I thought I...","Author":{"Signature":"","Email":"do.yune@yahoo.com","IpAddress":"199.19.250.89","GroupId":39,"GroupName":"Newbie","JoinDate":1429692165,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"yuniedo","Id":282824,"Name":"yuniedo","IsOnline":false}},"Posts":[],"Id":"79096","Title":"Dreams Riviera Cancun 2016!","LastPostDate":1433363696},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":1890,"QueuedPosts":0,"DeletedPosts":8,"HasUnreadPosts":true,"HasAttachments":true,"Views":144225,"MovedTo":null,"MovedOn":0,"FirstPostId":1521871,"Rating":0,"RatingHits":0,"Starter":{"Id":245483,"Name":"IdoBeach2012","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-245483.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"IsOnline":false},"StartDate":1316457814,"LastPoster":{"Id":283264,"Name":"stephygirl","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283264.jpg?_r=1432750548","PhotoWidth":200,"PhotoHeight":220,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":2,"Preview":{"Id":1521871,"PostDate":1316457814,"PostContent":"I'm torn between 2 Palace locations but totally in love with BPC.  Where are all the Beach Place...","Author":{"Signature":"","Email":"danakstout@comcast.net","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1316351391,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-245483.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"IdoBeach2012","Id":245483,"Name":"IdoBeach2012","IsOnline":false}},"Posts":[],"Id":"63613","Title":"Beach Palace Cancun Brides","LastPostDate":1433343568}],"Pages":{"TotalItems":4909,"TotalPages":328,"CurrentPage":0,"NextPage":15,"PreviousPage":-1,"LastPage":4905},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
