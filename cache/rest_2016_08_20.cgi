{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":1,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":0,"MovedTo":null,"MovedOn":0,"FirstPostId":1915260,"Rating":0,"RatingHits":0,"Starter":{"Id":286776,"Name":"scadeau","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286776.jpg?_r=1461191272","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"StartDate":1470837338,"LastPoster":{"Id":286776,"Name":"scadeau","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286776.jpg?_r=1461191272","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":33,"Preview":{"Id":1915260,"PostDate":1470837338,"PostContent":"Good news for budget friendly brides - For all GTA brides, the boutique Ritche Bridal is closing...","Author":{"Signature":"","Email":"cadeau.samantha@gmail.com","IpAddress":"216.123.7.202","GroupId":39,"GroupName":"Newbie","JoinDate":1461163493,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286776.jpg?_r=1461191272","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"scadeau","Id":286776,"Name":"scadeau","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"216.123.7.202","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80242,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4c13e67584e714c978553a8d6f30bae3","RawContent":"&lt;p&gt;Good news for budget friendly brides - For all GTA brides, the boutique Ritche Bridal is closing down because the owners of 64 years are retiring. Everything is on sale and bridesmaids dresses are 50% off.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;The bad news - &amp;nbsp;I bought my dress from Ritche and it is supposed to arrive late September to the boutique. The store is closing in November so I will not get to use their in house alternations (which was a huge selling point in me buying the dress from there). I am very upset by this because I do not have a place to store my dress during the alternation process\/am losing the convenience of the one stop shopping wedding dress experience. My sister and mom both bought their wedding dresses from here (and had alternations done) and the dresses turned out absolutely beautiful.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;None the less this situation is out of my control, so I am trying to stay positive! Just wondering if anyone have seamstress recommendations in the GTA?&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Also, does anyone know if the seamstress keeps your dress between fitting sessions or do you have to bring it back and forth?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Any help would be VERY appreciated :)&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1915260,"PostDate":1470837338,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Good news for budget friendly brides - For all GTA brides, the boutique Ritche Bridal is closing down because the owners of 64 years are retiring. Everything is on sale and bridesmaids dresses are 50% off.<\/p>\n<p>\u00a0<\/p>\n<p>The bad news - \u00a0I bought my dress from Ritche and it is supposed to arrive late September to the boutique. The store is closing in November so I will not get to use their in house alternations (which was a huge selling point in me buying the dress from there). I am very upset by this because I do not have a place to store my dress during the alternation process\/am losing the convenience of the one stop shopping wedding dress experience. My sister and mom both bought their wedding dresses from here (and had alternations done) and the dresses turned out absolutely beautiful.<\/p>\n<p>\u00a0<\/p>\n<p>None the less this situation is out of my control, so I am trying to stay positive! Just wondering if anyone have seamstress recommendations in the GTA?\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Also, does anyone know if the seamstress keeps your dress between fitting sessions or do you have to bring it back and forth?<\/p>\n<p>\u00a0<\/p>\n<p>Any help would be VERY appreciated <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cadeau.samantha@gmail.com","IpAddress":"216.123.7.202","GroupId":39,"GroupName":"Newbie","JoinDate":1461163493,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286776.jpg?_r=1461191272","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"scadeau","Id":286776,"Name":"scadeau","IsOnline":false}}],"Id":"80242","Title":"Gta Ritche Bridal Closing\/seamstress Recommendations","LastPostDate":1470837338},"Pages":{"TotalItems":1,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
