{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50551,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1af9b44318ea46a56536c17b26cc7788","RawContent":"We are going to use our Bose portable Ipod speaker and glad to hear it works great! Thank you for sharing and my doubts of using it for the cocktail\/ Dinner reception are now gone!","Attachments":[],"Id":1159882,"PostDate":1274584580,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We are going to use our Bose portable Ipod speaker and glad to hear it works great! Thank you for sharing and my doubts of using it for the cocktail\/ Dinner reception are now gone!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><strong>Cristi & Jamie<\/strong><br><a data-ipb='nomediaparse' href=\"http:\/\/img.weddingcountdown.com\/ticker\/7nhul9k2.png\">http:\/\/img.weddingcountdown.com\/ticker\/7nhul9k2.png<\/a><span>32 guests including Bride and Groom... and counting<\/span><\/div><\/div>","Email":"capvirgo79@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1257977126,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223233.gif?_r=0","PhotoWidth":200,"PhotoHeight":250,"PhotoType":"custom"},"FormattedName":"CristiandJamie","Id":223233,"Name":"CristiandJamie","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50551,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f5ca19de742e87f20f6042a12c81bfd4","RawContent":"We leave tomorrow to get married Sat! We&#039;ll be using the Bose system for our ceremony, which is on the beach. Hopefully it&#039;ll work just fine, but I&#039;m a little concerned it won&#039;t be loud enough. I&#039;ll report back in a couple weeks to let people know how it worked!","Attachments":[],"Id":1160350,"PostDate":1274655454,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We leave tomorrow to get married Sat! We'll be using the Bose system for our ceremony, which is on the beach. Hopefully it'll work just fine, but I'm a little concerned it won't be loud enough. I'll report back in a couple weeks to let people know how it worked!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kmccreary14@yahoo.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1231619875,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213815.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":125,"PhotoType":"custom"},"FormattedName":"KarenM","Id":213815,"Name":"KarenM","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50551,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"55b215221b7319088c7041176330bc17","RawContent":"Looks like I need to go out and get one! Thanks ladies :)","Attachments":[],"Id":1160421,"PostDate":1274660491,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Looks like I need to go out and get one! Thanks ladies <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"questle.khalia314@gmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1262139431,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-224186.jpg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Diva","Id":224186,"Name":"Diva","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50551,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"51afbdcc4f96c2ce07326872ea79918a","RawContent":"We&#039;re back, but sadly I can&#039;t report on the Bose speakers for the beach. We ended up just using the DJ cuz the wedding coordinator had already booked him (plus I&#039;m not sure if DH&#039;s parents actually brought the speakers!). Anyway, good luck to those of you who are considering using them! I&#039;m sure they&#039;ll work just fine!","Attachments":[],"Id":1188662,"PostDate":1276830024,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We're back, but sadly I can't report on the Bose speakers for the beach. We ended up just using the DJ cuz the wedding coordinator had already booked him (plus I'm not sure if DH's parents actually brought the speakers!). Anyway, good luck to those of you who are considering using them! I'm sure they'll work just fine!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kmccreary14@yahoo.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1231619875,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213815.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":125,"PhotoType":"custom"},"FormattedName":"KarenM","Id":213815,"Name":"KarenM","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50551,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d8dccf66a46b91103ffb8cf10ae1aebd","RawContent":"I&#039;m going to have to look into this Bose dock it seems.","Attachments":[],"Id":1216771,"PostDate":1279147742,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm going to have to look into this Bose dock it seems.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"janinelatkinson@gmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1263754522,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-224781.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"JanineA","Id":224781,"Name":"JanineA","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50551,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e8c6f9ca1cb78e6f7ba4284ba86f73d1","RawContent":"[quote]\nOriginally Posted by [b]dolfinluck[\/b] \/img\/forum\/go_quote.gif\n \n We used the portable bose sound dock for the reception. we were on the beach and it worked perfectly. It was very loud, still could hear the music 50 ft away and could still make it louder. we didnt use it for the ceremony as the resort had a mic and speakers for us to use free of charge.[\/quote] \n \n \n  Thanks for the info.  What resort did you stay at Dolfinluck?","Attachments":[],"Id":1374013,"PostDate":1294757749,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <br \/> <br \/> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>dolfinluck<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" style=\"border-right: 0px solid; border-top: 0px solid; border-left: 0px solid; border-bottom: 0px solid\" \/><\/span><br \/> <br \/> We used the portable bose sound dock for the reception. we were on the beach and it worked perfectly. It was very loud, still could hear the music 50 ft away and could still make it louder. we didnt use it for the ceremony as the resort had a mic and speakers for us to use free of charge.<\/blockquote> <br \/> <br \/> <p> \u00a0Thanks for the info.\u00a0 What resort did you stay at Dolfinluck?<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"shanna0487@hotmail.com","IpAddress":"63.122.89.3","GroupId":42,"GroupName":"Sr. Member","JoinDate":1294245874,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-235127.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"shan0487","Id":235127,"Name":"shan0487","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50551,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bf27aeb201771cc04fab77c5dc9fe4da","RawContent":"&lt;p&gt; Glad I found this post. I really wanted to buy a BOSE system. I figured that for how much Dreams PA was going to charge for a DJ or for the use of their equipment I should invest in my own system. I can either keep it or sell it! Thanks for the info!&lt;\/p&gt;","Attachments":[],"Id":1519152,"PostDate":1315917511,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Glad I found this post. I really wanted to buy a BOSE system. I figured that for how much Dreams PA was going to charge for a DJ or for the use of their equipment I should invest in my own system. I can either keep it or sell it! Thanks for the info!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lindsayradko@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1315248466,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-244922.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"LindsayR","Id":244922,"Name":"LindsayR","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"162.119.64.119","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50551,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"02c026c89294a4bd38f9ac1a7da97593","RawContent":"&lt;p&gt;Any other speaker options besides the bose?&amp;nbsp; It&#039;s SOOOOOOOOO expensive!!&lt;\/p&gt;","Attachments":[],"Id":1838996,"PostDate":1395172215,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Any other speaker options besides the bose?\u00a0 It's SOOOOOOOOO expensive!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kellis_baby@hotmail.com","IpAddress":"108.222.71.55","GroupId":40,"GroupName":"Jr. Member","JoinDate":1386889365,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275607.jpg?_r=1425326341","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"kellisbaby","Id":275607,"Name":"kellisbaby","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.87.31.101","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50551,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0a76086da9626a98cffbe5b91e901c0b","RawContent":"Thanks for this thread! We have one already and were wondering the same...","Attachments":[],"Id":1851524,"PostDate":1400650155,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks for this thread! We have one already and were wondering the same... \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rheanna@uwalumni.com","IpAddress":"75.135.169.141","GroupId":40,"GroupName":"Jr. Member","JoinDate":1400445451,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278018.jpg?_r=1410892817","PhotoWidth":200,"PhotoHeight":131,"PhotoType":"custom"},"FormattedName":"Rheannarudy","Id":278018,"Name":"Rheannarudy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.155.94.124","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50551,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8770aecce38e6047b3e4c5b6291839e9","RawContent":"&lt;p&gt;thanks for posting this! We&#039;re thinking of getting one to play music from our ipod at our reception. Do you think I would need an amplifier? The ceremony would be on a terrace. I think the biggest thing is the noise of the wind up there!&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1852760,"PostDate":1401447132,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>thanks for posting this! We're thinking of getting one to play music from our ipod at our reception. Do you think I would need an amplifier? The ceremony would be on a terrace. I think the biggest thing is the noise of the wind up there!\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<br><p><a data-ipb='nomediaparse' href='http:\/\/www.TickerFactory.com\/'><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;31;484\/st\/20150813\/e\/Wedding+time%21+\/dt\/-2\/k\/b92c\/event.png\" alt=\"event.png\"><\/a><\/p>\n<p style=\"text-align:center;\">\u00a0<\/p>\n<p style=\"text-align:center;\">\u00a0","Email":"sblopezb@gmail.com","IpAddress":"172.219.193.22","GroupId":42,"GroupName":"Sr. Member","JoinDate":1359748704,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265511.jpg?_r=1442890536","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"TinkerSofi","Id":265511,"Name":"TinkerSofi","IsOnline":false}}],"Pages":{"TotalItems":33,"TotalPages":4,"CurrentPage":20,"NextPage":30,"PreviousPage":10,"LastPage":30},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
