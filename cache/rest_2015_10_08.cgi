{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":17,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":1197,"MovedTo":null,"MovedOn":0,"FirstPostId":1857679,"Rating":0,"RatingHits":0,"Starter":{"Id":277449,"Name":"NixSpade","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"none"},"IsOnline":false},"StartDate":1404205089,"LastPoster":{"Id":278661,"Name":"jeffandrobyn","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278661.jpg?_r=1404161707","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1857679,"PostDate":1404205089,"PostContent":"HI\u00a0 I am new here and I am planning an Oct 2015 wedding at the Hyatt Ziva Rose and the hotel does...","Author":{"Signature":"","Email":"spadeincwedding@yahoo.com","IpAddress":"99.226.206.246","GroupId":40,"GroupName":"Jr. Member","JoinDate":1396405780,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"none"},"FormattedName":"NixSpade","Id":277449,"Name":"NixSpade","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.226.199.68","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77444,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"eb0df74e4d025ea028db44b6ec7f7520","RawContent":"&lt;p&gt;HI&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am new here and I am planning an Oct 2015 wedding at the Hyatt Ziva Rose and the hotel doesn&#039;t eve open till November of this year. Hopefully it gets rave reviews on Tripadvisor. I am so nervous, but I know that the Hyatt has a good reputation.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1857679,"PostDate":1404205089,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>HI\u00a0<\/p>\n<p>I am new here and I am planning an Oct 2015 wedding at the Hyatt Ziva Rose and the hotel doesn't eve open till November of this year. Hopefully it gets rave reviews on Tripadvisor. I am so nervous, but I know that the Hyatt has a good reputation.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"spadeincwedding@yahoo.com","IpAddress":"99.226.206.246","GroupId":40,"GroupName":"Jr. Member","JoinDate":1396405780,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"none"},"FormattedName":"NixSpade","Id":277449,"Name":"NixSpade","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.114.22.243","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77444,"EditedBy":"<strong>Edited by kmk2016, 01 July 2014 - 05:17 AM.<\/strong>","EditDate":1404220641,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"a2a2a49f42187b8eeeaabf2e22fb0971","RawContent":"[quote name=\"NixSpade\" post=\"1857679\" timestamp=\"1404201489\"]\nHI \nI am new here and I am planning an Oct 2015 wedding at the Hyatt Ziva Rose and the hotel doesn&#039;t eve open till November of this year. Hopefully it gets rave reviews on Tripadvisor. I am so nervous, but I know that the Hyatt has a good reputation.[\/quote]From past openings, Hyatt Ziva hotels are normally other resorts who are being rebranded and purchased by Hyatt. With a little help from google, I noticed this we the former Ritz Carlton Rose Hall resort- so start by reading the reviews from there and it will give you an idea (minus the amenities) I stayed at the Barcelo Palace Deluxe 3 months before it converted to Hyatt Ziva Los Cabos and then again after conversion and there weren&#039;t many changes aside from the name on the door. \n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1857687,"PostDate":1404220611,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>NixSpade, on 01 July 2014 - 12:58 AM, said:<\/p><div class='blockquote'><div class='quote'><p>\nHI <br>\nI am new here and I am planning an Oct 2015 wedding at the Hyatt Ziva Rose and the hotel doesn't eve open till November of this year. Hopefully it gets rave reviews on Tripadvisor. I am so nervous, but I know that the Hyatt has a good reputation.<\/p><\/div><\/div>\nFrom past openings, Hyatt Ziva hotels are normally other resorts who are being rebranded and purchased by Hyatt. With a little help from google, I noticed this we the former Ritz Carlton Rose Hall resort- so start by reading the reviews from there and it will give you an idea (minus the amenities) I stayed at the Barcelo Palace Deluxe 3 months before it converted to Hyatt Ziva Los Cabos and then again after conversion and there weren't many changes aside from the name on the door. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kmkwedding2016@gmail.com","IpAddress":"70.72.195.234","GroupId":38,"GroupName":"Moderators","JoinDate":1390260208,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kmk2016","Id":276231,"Name":"kmk2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.99.18.219","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77444,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"81ca5a86bc830255382ef4ad725d2ac6","RawContent":"&lt;p&gt;Hi! I work in the travel industry and my suggestion would be to not do this. When new hotels open (regardless of if they&#039;re former properties with new ownership), they always have some kinks to work out that usually last three months or so. And that&#039;s assuming it opens on time (they usually don&#039;t unfortunately.)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Hyatt overall is an awesome brand, but also keep in mind that it has several levels - for example Grand Hyatts are in a different class than Hyatt Regency - and prices and service levels reflect that. Also, Hyatt is relatively new to the all-inclusive concept. Just fyi.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1857714,"PostDate":1404232538,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi! I work in the travel industry and my suggestion would be to not do this. When new hotels open (regardless of if they're former properties with new ownership), they always have some kinks to work out that usually last three months or so. And that's assuming it opens on time (they usually don't unfortunately.)<\/p>\n<p>\u00a0<\/p>\n<p>Hyatt overall is an awesome brand, but also keep in mind that it has several levels - for example Grand Hyatts are in a different class than Hyatt Regency - and prices and service levels reflect that. Also, Hyatt is relatively new to the all-inclusive concept. Just fyi.<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"robynbrooke81@gmail.com","IpAddress":"75.99.18.219","GroupId":40,"GroupName":"Jr. Member","JoinDate":1403550989,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278661.jpg?_r=1404161707","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"jeffandrobyn","Id":278661,"Name":"jeffandrobyn","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.226.199.68","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77444,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"04480d54e22be90c9cb63857eeb3bdbb","RawContent":"[quote name=\"jeffandrobyn\" post=\"1857714\" timestamp=\"1404228938\"]\nHi! I work in the travel industry and my suggestion would be to not do this. When new hotels open (regardless of if they&#039;re former properties with new ownership), they always have some kinks to work out that usually last three months or so. And that&#039;s assuming it opens on time (they usually don&#039;t unfortunately.)\n\nHyatt overall is an awesome brand, but also keep in mind that it has several levels - for example Grand Hyatts are in a different class than Hyatt Regency - and prices and service levels reflect that. Also, Hyatt is relatively new to the all-inclusive concept. Just fyi.[\/quote]HI Jeffandrobyn \nI am aware that it does take some time to work out any kinks, my wedding is a full year after the opening. I wasn&#039;t aware of the levels of the Hyatt, but thanks, I&#039;m going to look into it now. I do know that the all inclusive part is run (?) by Playa resorts. The other Hyatt&#039;s seem to have great reviews.","Attachments":[],"Id":1857717,"PostDate":1404234863,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>jeffandrobyn, on 01 July 2014 - 08:35 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hi! I work in the travel industry and my suggestion would be to not do this. When new hotels open (regardless of if they're former properties with new ownership), they always have some kinks to work out that usually last three months or so. And that's assuming it opens on time (they usually don't unfortunately.)<\/p>\n<p>\u00a0<\/p>\n<p>Hyatt overall is an awesome brand, but also keep in mind that it has several levels - for example Grand Hyatts are in a different class than Hyatt Regency - and prices and service levels reflect that. Also, Hyatt is relatively new to the all-inclusive concept. Just fyi.<\/p>\n<\/div>\n<\/div><\/div>\n<p>HI Jeffandrobyn\u00a0<\/p>\n<p>I am aware that it does take some time to work out any kinks, my wedding is a full year after the opening. I wasn't aware of the levels of the Hyatt, but thanks, I'm going to look into it now. I do know that the all inclusive part is run (?) by Playa resorts. The other Hyatt's seem to have great reviews.\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"spadeincwedding@yahoo.com","IpAddress":"99.226.206.246","GroupId":40,"GroupName":"Jr. Member","JoinDate":1396405780,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"none"},"FormattedName":"NixSpade","Id":277449,"Name":"NixSpade","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"198.53.129.168","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77444,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5eab6d642a9dfa0042436074ef98196a","RawContent":"&lt;p&gt;Welcome to the forum, NixSpade, and Congrats on your Jamaican wedding coming up next year!!! hope you find all the info you&#039;re looking for here, to make the best plans Ever!!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-b-sea.xx.fbcdn.net\/hphotos-xfp1\/t1.0-9\/10341437_10152470866119487_4343003096167656174_n.jpg\" alt=\"10341437_10152470866119487_4343003096167\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;cheers! team MTM :)&lt;\/p&gt;","Attachments":[],"Id":1857955,"PostDate":1404327145,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome to the forum, NixSpade, and Congrats on your Jamaican wedding coming up next year!!! hope you find all the info you're looking for here, to make the best plans Ever!!!<\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-b-sea.xx.fbcdn.net\/hphotos-xfp1\/t1.0-9\/10341437_10152470866119487_4343003096167656174_n.jpg\" alt=\"10341437_10152470866119487_4343003096167\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>cheers! team MTM <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280214260,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.231.156.214","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77444,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"608ce4e4231051dea836aa3f1693041e","RawContent":"Congrats and happy planning. \n\n\nI would be scared to take the chance","Attachments":[],"Id":1859982,"PostDate":1405481564,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Congrats and happy planning. <br><br>\nI would be scared to take the chance \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"noeljennifer1@yahoo.com","IpAddress":"12.52.150.2","GroupId":40,"GroupName":"Jr. Member","JoinDate":1403621919,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278674.jpg?_r=1405114043","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"jennifernoel1","Id":278674,"Name":"jennifernoel1","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"69.117.93.162","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77444,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c32ce4d562c31ecff186e61e6f28eae7","RawContent":"Congrats!  It does seem a little scary,  bbuuttttt..... keep everything in writing and have fun with it. Happy Planning","Attachments":[],"Id":1860860,"PostDate":1405781536,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Congrats!  It does seem a little scary,  bbuuttttt..... keep everything in writing and have fun with it. Happy Planning\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bseasebey@yahoo.com","IpAddress":"69.117.93.162","GroupId":40,"GroupName":"Jr. Member","JoinDate":1402065568,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"SuchALady777","Id":278273,"Name":"SuchALady777","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"162.238.70.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77444,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6a8a439ec2c0a01c5c9bdfd642685033","RawContent":"I&#039;d be too scared since we rely on reviews for a lot of our purchases and decisions on places! But I am sure it will be gorgeous! \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1861012,"PostDate":1405832770,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'd be too scared since we rely on reviews for a lot of our purchases and decisions on places! But I am sure it will be gorgeous! <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"hkorkovilis@gmail.com","IpAddress":"162.238.70.23","GroupId":40,"GroupName":"Jr. Member","JoinDate":1401630892,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278186.jpg?_r=1417419505","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"helenk","Id":278186,"Name":"helenk","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.227.172.254","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77444,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9e64d77379f034d8b18de3b18a74c969","RawContent":"You&#039;re so brave! I&#039;m sure it&#039;ll be beautiful. Congrats and good luck!","Attachments":[],"Id":1861123,"PostDate":1405906464,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                You're so brave! I'm sure it'll be beautiful. Congrats and good luck!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"maryluong@hotmail.com","IpAddress":"99.227.172.254","GroupId":39,"GroupName":"Newbie","JoinDate":1405286690,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"none"},"FormattedName":"maredith","Id":278988,"Name":"maredith","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"172.56.14.39","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77444,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"60a9d6ffc7a12007c80111472b4af2cc","RawContent":"Hi\n\nI was also interested in this hotel\/location because it is formerly Dreams Cancun and it has a wonderful private gazebo for the ceremony site.  I actually almost booked another location thinking it was the same one.  But as i keep researching,  it saysit&#039;s not due to open until late 2015.... not 2014. Do you have any more details about that? \nIgnore me. .. different location. Sorry!","Attachments":[],"Id":1865176,"PostDate":1407506421,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi<br>\nI was also interested in this hotel\/location because it is formerly Dreams Cancun and it has a wonderful private gazebo for the ceremony site.  I actually almost booked another location thinking it was the same one.  But as i keep researching,  it saysit's not due to open until late 2015.... not 2014. Do you have any more details about that? <br \/>Ignore me. .. different location. Sorry! \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"khglover_99@yahoo.com","IpAddress":"76.30.134.169","GroupId":39,"GroupName":"Newbie","JoinDate":1406684136,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"ksylve","Id":279220,"Name":"ksylve","IsOnline":false}}],"Id":"77444","Title":"Plannig A Wedding And Hotel Isn't Even Opened","LastPostDate":1407942718},"Pages":{"TotalItems":17,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
