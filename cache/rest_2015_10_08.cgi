{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60469,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4c8669013aa3f427697aa3a029c76e6d","RawContent":"&lt;p&gt; I&#039;m getting married in Jamaica on May 12, 2012. I am not planning on having a private reception, but instead plan to arrange for the group (about 15 of us) to eat dinner&amp;nbsp;together at one of the restaurants. Any suggestions for what to do after dinner? I&#039;m on a tight budget and don&#039;t have the money to hire a DJ at the resort. I thought I read in a post that some people take their i-pod to one of the bars and hook it up so people can dance. Does anyone know if the bars have their own DJ&#039;s so guests could dance if they choose to?&lt;\/p&gt;","Attachments":[],"Id":1425979,"PostDate":1301416730,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I'm getting married in Jamaica on May 12, 2012. I am not planning on having a private reception, but instead plan to arrange for the group (about 15 of us) to eat dinner\u00a0together at one of the restaurants. Any suggestions for what to do after dinner? I'm on a tight budget and don't have the money to hire a DJ at the resort. I thought I read in a post that some people take their i-pod to one of the bars and hook it up so people can dance. Does anyone know if the bars have their own DJ's so guests could dance if they choose to?<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tammy.sova@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1299451037,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-237505.JPG?_r=0","PhotoWidth":200,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"tammy 2012","Id":237505,"Name":"tammy 2012","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60469,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"18aabd412b4f5aec9a6e08134b1c74dd","RawContent":"&lt;p&gt; Welcome to the site!&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I&#039;m sure that depends on the hotel you have chosen. We chose the Iberostar Rose Hall Suites in Montego Bay and you can only have your own music if you privatize a restaurant\/location (cost is anywhere from $350-$800 to do that).&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; If you haven&#039;t selected your resort yet, you should probably go to the Jamaica forum and read all of the hotel reviews. I chose mine based off of reviews and from my TA. There is so much information on this site, I am sure someone has discussed that before.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Best of luck!&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1426000,"PostDate":1301417890,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Welcome to the site!<\/p> <p> \u00a0<\/p> <p> I'm sure that depends on the hotel you have chosen. We chose the Iberostar Rose Hall Suites in Montego Bay and you can only have your own music if you privatize a restaurant\/location (cost is anywhere from $350-$800 to do that).<\/p> <p> \u00a0<\/p> <p> If you haven't selected your resort yet, you should probably go to the Jamaica forum and read all of the hotel reviews. I chose mine based off of reviews and from my TA. There is so much information on this site, I am sure someone has discussed that before.<\/p> <p> \u00a0<\/p> <p> Best of luck!<\/p> <p> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"keciaj@gmail.com","IpAddress":"108.5.132.168","GroupId":47,"GroupName":"Site Supporter","JoinDate":1279129654,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230243.jpg?_r=1395786339","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Prettysparklie","Id":230243,"Name":"Prettysparklie","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60469,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bea93e8f91636f448a46e15c2e088d28","RawContent":"&lt;p&gt; Thank you! I have already booked the wedding at Sandals Grand Rivera in Ocho Rios, but I will take a look at the Jamaica Forums.&lt;\/p&gt;","Attachments":[],"Id":1426079,"PostDate":1301424851,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Thank you! I have already booked the wedding at Sandals Grand Rivera in Ocho Rios, but I will take a look at the Jamaica Forums.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tammy.sova@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1299451037,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-237505.JPG?_r=0","PhotoWidth":200,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"tammy 2012","Id":237505,"Name":"tammy 2012","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60469,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"46819a527fedd61c5472fb8f2f89113f","RawContent":"&lt;p&gt; I have a question for you lovely ladies, my ipod rental (ha! what a joke!) and reception details only go until 9pm, are there others in similar situation? What are we going to do after 9? Ideas?&lt;\/p&gt;","Attachments":[],"Id":1427706,"PostDate":1301652712,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I have a question for you lovely ladies, my ipod rental (ha! what a joke!) and reception details only go until 9pm, are there others in similar situation? What are we going to do after 9? Ideas?<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"traceychung@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1296771657,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-236352.jpeg?_r=0","PhotoWidth":195,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"traceysteve","Id":236352,"Name":"traceysteve","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60469,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d934529fb58c717a37117bbeb9d70d4e","RawContent":"&lt;p&gt; Are you able to stay in your location after 9, or do you have to clear out?&amp;nbsp; I am renting out the sound system at my resort, but I think they charge by the hour.&amp;nbsp; I have a logitech iPod speaker system that I will bring as backup.&amp;nbsp; I have heard of other receptions moving into the resort&#039;s disco\/club after the dinner\/reception is over to keep the party going into the night.&lt;\/p&gt;","Attachments":[],"Id":1432550,"PostDate":1302484213,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Are you able to stay in your location after 9, or do you have to clear out?\u00a0 I am renting out the sound system at my resort, but I think they charge by the hour.\u00a0 I have a logitech iPod speaker system that I will bring as backup.\u00a0 I have heard of other receptions moving into the resort's disco\/club after the dinner\/reception is over to keep the party going into the night.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nairay@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1268884966,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-226545.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"nairay","Id":226545,"Name":"nairay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60469,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"548bb4c509bd05673e85faba50ac9c9b","RawContent":"&lt;p&gt; Yeah, I like the idea of taking over a bar.&amp;nbsp; I think personally we are having a late dinner so that we can call it a night and enjoy ourselves alone :)&lt;\/p&gt;","Attachments":[],"Id":1435035,"PostDate":1302817850,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Yeah, I like the idea of taking over a bar.\u00a0 I think personally we are having a late dinner so that we can call it a night and enjoy ourselves alone <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"harkatea@bethel.edu","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1301592357,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-238405.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"harkatea","Id":238405,"Name":"harkatea","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60469,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"20f9c018171ddde1e927499419756f81","RawContent":"Oooo...now you&#039;re talking! [quote]\nOriginally Posted by [b]harkatea[\/b] \/img\/forum\/go_quote.gif\n \n \n Yeah, I like the idea of taking over a bar.  I think personally we are having a late dinner so that we can call it a night and enjoy ourselves alone :)[\/quote]","Attachments":[],"Id":1435550,"PostDate":1302901638,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <br \/> <br \/> Oooo...now you're talking!<\/p> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>harkatea<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" style=\"border-bottom: 0px solid; border-left: 0px solid; border-top: 0px solid; border-right: 0px solid\" \/><\/span><br \/> <br \/> <p> Yeah, I like the idea of taking over a bar.\u00a0 I think personally we are having a late dinner so that we can call it a night and enjoy ourselves alone <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p> <\/blockquote> <br \/> <br \/> <p> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"traceychung@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1296771657,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-236352.jpeg?_r=0","PhotoWidth":195,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"traceysteve","Id":236352,"Name":"traceysteve","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60469,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4d61cc1ccd2f8fe8329d98bbc4c0018f","RawContent":"&lt;p&gt; After my reception dinner, I&#039;m thinking Beach Party! I have to pay $15\/pp at the Riu for a personal bartender on the beach, but I&#039;m thinking about the ipod idea too. A DJ is $300\/hr and I would probably just give him the music to play anyway. I wonder if they&#039;ll let us play the music ourselves on the beach? I think the resort provides tiki lights and I might spring the $150 for a bonfire too. I&#039;m planning on having my first dance with my FI and Dad on the beach!&lt;\/p&gt;","Attachments":[],"Id":1439368,"PostDate":1303480890,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> After my reception dinner, I'm thinking Beach Party! I have to pay $15\/pp at the Riu for a personal bartender on the beach, but I'm thinking about the ipod idea too. A DJ is $300\/hr and I would probably just give him the music to play anyway. I wonder if they'll let us play the music ourselves on the beach? I think the resort provides tiki lights and I might spring the $150 for a bonfire too. I'm planning on having my first dance with my FI and Dad on the beach!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kimberlyscott3@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1300641342,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-237990.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"kimberyly","Id":237990,"Name":"kimberyly","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60469,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"954a06758a692de30cd5b8470aaf747d","RawContent":"&lt;p&gt; I&#039;ll be having private reception on the terrace and we have to stop playing music at 11pm. Then we are heading to the club on the resort that is open until 2am for the after party!&lt;\/p&gt;","Attachments":[],"Id":1441500,"PostDate":1303854459,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I'll be having private reception on the terrace and we have to stop playing music at 11pm. Then we are heading to the club on the resort that is open until 2am for the after party!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"skaskamorales@yahoo.com","IpAddress":"","GroupId":47,"GroupName":"Site Supporter","JoinDate":1273780985,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-228176.jpeg?_r=0","PhotoWidth":142,"PhotoHeight":166,"PhotoType":"custom"},"FormattedName":"ska2m","Id":228176,"Name":"ska2m","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"188.29.166.79","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60469,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7f2225a540d7ef504cfa6675112b7384","RawContent":"&lt;p&gt;I love the sound of a beach party!&lt;\/p&gt;","Attachments":[],"Id":1872966,"PostDate":1411553226,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I love the sound of a beach party!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"justineatack@gmail.com","IpAddress":"31.54.1.116","GroupId":40,"GroupName":"Jr. Member","JoinDate":1409997456,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279711.jpg?_r=1410256327","PhotoWidth":200,"PhotoHeight":125,"PhotoType":"custom"},"FormattedName":"Bride2b15","Id":279711,"Name":"Bride2b15","IsOnline":false}}],"Pages":{"TotalItems":12,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
