 Iberostar Varadero, Cuba - Sept.24.2015","LastPostDate":1444302964},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":7,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":545,"MovedTo":null,"MovedOn":0,"FirstPostId":1833630,"Rating":0,"RatingHits":0,"Starter":{"Id":276338,"Name":"kellymiller","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1392326794,"LastPoster":{"Id":265282,"Name":"Bride2B1130","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265282.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":22,"Preview":{"Id":1833630,"PostDate":1392326794,"PostContent":"This is a question for brides that did a legal ceremony in the DR. How long did it take you get y...","Author":{"Signature":"","Email":"kelly_miller_@hotmail.com","IpAddress":"99.249.122.85","GroupId":40,"GroupName":"Jr. Member","JoinDate":1390758531,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kellymiller","Id":276338,"Name":"kellymiller","IsOnline":false}},"Posts":[],"Id":"76362","Title":"How Long Does It Take To Get Your Marriage Licence From The Dr?","LastPostDate":1444302541},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":210,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":6189,"MovedTo":null,"MovedOn":0,"FirstPostId":1903483,"Rating":0,"RatingHits":0,"Starter":{"Id":279721,"Name":"Wafflesmom","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279721.jpg?_r=1441055220","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"IsOnline":false},"StartDate":1440607486,"LastPoster":{"Id":279902,"Name":"RivieraBride15","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":true},"PollState":"0","LastVote":0,"ForumId":39,"Preview":{"Id":1905380,"PostDate":1443153839,"PostContent":"this is fantatic i love it","Author":{"Signature":"<p><a data-ipb='nomediaparse' href='http:\/\/dochoitinhduc368.com'><em><b>\u0110\u1ed3 ch\u01a1i t\u00ecnh d\u1ee5c cho n\u1eef<\/b><\/em><\/a>","Email":"lapdatcameraquansathaphuong@gmail.com","IpAddress":"14.177.241.215","GroupId":39,"GroupName":"Newbie","JoinDate":1439246576,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284359.jpg?_r=1439261366","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"thuytien146","Id":284359,"Name":"thuytien146","IsOnline":false}},"Posts":[],"Id":"79536","Title":"Support And Accountability Group","LastPostDate":1444301195},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":1027,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":31541,"MovedTo":null,"MovedOn":0,"FirstPostId":1885622,"Rating":0,"RatingHits":0,"Starter":{"Id":281478,"Name":"perianjay","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1436293677","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":true},"StartDate":1423396005,"LastPoster":{"Id":232000,"Name":"acw271011","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"IsOnline":true},"PollState":"0","LastVote":0,"ForumId":91,"Preview":{"Id":1887495,"PostDate":1424871985,"PostContent":"Hi there!\u00a0 Let me know when the dresses come in!\u00a0 I have told my BMs about this other option and...","Author":{"Signature":"<div><br><div>\u00a0<\/div>\n<div>\u00a0<\/div>\n<div>Married on June 20th, 2015 at the Grand Sunset Princess Riviera Gazebo & Reception at the Chill Out with 60 guests<\/div>\n<div>\u00a0<\/div>\n<\/div>\n<div>\u00a0<\/div>\n<p>My planning thread:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/<\/a><\/p>\n<p>My review thread: \u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/<\/a>","Email":"rebecca.valero@gmail.com","IpAddress":"38.112.94.76","GroupId":3,"GroupName":"Member","JoinDate":1396968452,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277519.jpg?_r=1439827749","PhotoWidth":200,"PhotoHeight":132,"PhotoType":"custom"},"FormattedName":"veryvalentine","Id":277519,"Name":"veryvalentine","IsOnline":false}},"Posts":[],"Id":"78755","Title":"Perianjay Planning Thread - December 15, 2015 Beach Palace","LastPostDate":1444301171},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":44,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":1562,"MovedTo":null,"MovedOn":0,"FirstPostId":1904322,"Rating":0,"RatingHits":0,"Starter":{"Id":279902,"Name":"RivieraBride15","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":true},"StartDate":1441717046,"LastPoster":{"Id":279902,"Name":"RivieraBride15","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":true},"PollState":"0","LastVote":0,"ForumId":37,"Preview":{"Id":1905974,"PostDate":1444139142,"PostContent":"3rd and hopefully last dress fitting tomorrow! \u00a0 3 weeks today is our wedding! Was able to get de...","Author":{"Signature":"<p>My Planning Thread:<\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79575-rivierabrides-planning-thread-102715\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79575-rivierabrides-planning-thread-102715\/<\/a>","Email":"erind285@gmail.com","IpAddress":"63.86.124.4","GroupId":39,"GroupName":"Newbie","JoinDate":1411109203,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"RivieraBride15","Id":279902,"Name":"RivieraBride15","IsOnline":true}},"Posts":[],"Id":"79575","Title":"Rivierabride's Planning Thread 10\/27\/15","LastPostDate":1444301012},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":3,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":70,"MovedTo":null,"MovedOn":0,"FirstPostId":1906015,"Rating":0,"RatingHits":0,"Starter":{"Id":285037,"Name":"aliciakevin2017","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1444223004,"LastPoster":{"Id":230711,"Name":"Moments That Matter","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1906015,"PostDate":1444223004,"PostContent":"Hello All! \u00a0 \u00a0 I just got engaged about a week ago and although I am planning a destination weddi...","Author":{"Signature":"","Email":"straaf56@gmail.com","IpAddress":"165.155.196.100","GroupId":39,"GroupName":"Newbie","JoinDate":1444222312,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"aliciakevin2017","Id":285037,"Name":"aliciakevin2017","IsOnline":false}},"Posts":[],"Id":"79639","Title":"So Many Options!","LastPostDate":1444300593},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":364,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":7497,"MovedTo":null,"MovedOn":0,"FirstPostId":1888258,"Rating":0,"RatingHits":0,"Starter":{"Id":232000,"Name":"acw271011","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"IsOnline":true},"StartDate":1425429433,"LastPoster":{"Id":281478,"Name":"perianjay","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1436293677","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":true},"PollState":"0","LastVote":0,"ForumId":91,"Preview":{"Id":1888545,"PostDate":1425593695,"PostContent":"I said I needed advice and I meant it! lol I'm loving this..... but is it too young for an old la...","Author":{"Signature":"<p><em><span style=\"color:rgb(51,153,255);\">I'm lucky enough to\u00a0tell my husband how much I love him and say yes again\u00a0on October 20, 2015 at Grand Coral Beach Club!\u00a0<\/span><\/em>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},"Posts":[],"Id":"78874","Title":"Acw271011 So This Is Not A Planning Thread.... But","LastPostDate":1444297944}],"Filters":{"Period":["unread","lastvisit","today","week","weeks","month","months","year"],"Other":["followed","all","title"]}},{"Application":"users","ContentType":"","TotalResults":0,"Results":[],"Filters":{"Period":["lastvisit","today","week","weeks","month","months","year"],"Other":[]}}],"Pages":{"TotalItems":8,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[]}
