out this! what a great idea!!&lt;\/p&gt;","Attachments":[],"Id":1852765,"PostDate":1401447418,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>oh wow, I just bought this for my fiance and honestly didn't even think about this! what a great idea!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jlynnmape@gmail.com","IpAddress":"199.202.144.192","GroupId":40,"GroupName":"Jr. Member","JoinDate":1389380770,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"jayejayelynn","Id":275997,"Name":"jayejayelynn","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"146.235.0.9","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50551,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"78ad0f26a70efd7159bc4d5e0ec30481","RawContent":"&lt;p&gt;Is anyone using a microphone for speeches with this Speaker?&lt;\/p&gt;","Attachments":[],"Id":1884163,"PostDate":1422269834,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Is anyone using a microphone for speeches with this Speaker?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"erobin2@gmail.com","IpAddress":"146.235.0.9","GroupId":39,"GroupName":"Newbie","JoinDate":1401289524,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278147.jpg?_r=1417725779","PhotoWidth":200,"PhotoHeight":220,"PhotoType":"custom"},"FormattedName":"erobin223","Id":278147,"Name":"erobin223","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.139.45.237","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50551,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7944084cec9490916e849f3a01dd6deb","RawContent":"I&#039;m getting married in Mex on the beach. From visiting Mexico many other times and bring my BOSE sound link \/dock I can say it is NOT loud enough. The sound gets lost outside a lot more that you would think. It&#039;s ok if your right up on it in a lounge chair but def not loud enough for wedding. \n\n\nI am having a speaker and dj play the music. And giving officiant microphone. \n\n\nOnce I told dj my Bose speaker plan he said it wouldn&#039;t work and he would not charge me more to playtime ceremony music so for me it was a no brainer.","Attachments":[],"Id":1884841,"PostDate":1422793155,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm getting married in Mex on the beach. From visiting Mexico many other times and bring my BOSE sound link \/dock I can say it is NOT loud enough. The sound gets lost outside a lot more that you would think. It's ok if your right up on it in a lounge chair but def not loud enough for wedding. <br><br>\nI am having a speaker and dj play the music. And giving officiant microphone. <br><br>\nOnce I told dj my Bose speaker plan he said it wouldn't work and he would not charge me more to playtime ceremony music so for me it was a no brainer. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lisananth@yahoo.com","IpAddress":"166.137.101.169","GroupId":40,"GroupName":"Jr. Member","JoinDate":1401122033,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278120.jpg?_r=1421810202","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"LisaAnthonyPoppy","Id":278120,"Name":"LisaAnthonyPoppy","IsOnline":false}}],"Id":"50551","Title":"Bose sound dock loud enough","LastPostDate":1422793155},"Pages":{"TotalItems":33,"TotalPages":4,"CurrentPage":30,"NextPage":-1,"PreviousPage":20,"LastPage":30},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
