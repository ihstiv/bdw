{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":11,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":true,"Views":1005,"MovedTo":null,"MovedOn":0,"FirstPostId":1852767,"Rating":0,"RatingHits":0,"Starter":{"Id":265511,"Name":"TinkerSofi","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265511.jpg?_r=1442890536","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"StartDate":1401447520,"LastPoster":{"Id":277873,"Name":"calgarybride2015","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":45,"Preview":{"Id":1905127,"PostDate":1442815698,"PostContent":"That's a good idea for photobooth","Author":{"Signature":"<p><span style=\"color:rgb(62,62,62);font-family:Tahoma, Calibri, Verdana, Geneva, sans-serif;font-size:13px;background-color:rgb(250,250,250);\">Online updates fastest score at\u00a0<\/span><a data-ipb='nomediaparse' href='http:\/\/u99bet.net\/ca-do-bong-da-online-ca-cuoc-the-thao-truc-tuyen\/'>7m<\/a>","Email":"levdung.exc@gmail.com","IpAddress":"116.100.178.162","GroupId":39,"GroupName":"Newbie","JoinDate":1439164840,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284343.jpg?_r=1439179533","PhotoWidth":199,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"excpomelo","Id":284343,"Name":"excpomelo","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.155.94.124","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77174,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9493ebb352712a24d78a956b6670cfac","RawContent":"&lt;p&gt;Hi everyone! I&#039;m wondering if anyone had a DIY photobooth at their reception. I know there is a topic on doing one at the at home reception, but I&#039;m interested in what kinds of things I would need to bring to Mexico and if it would even be possible? Here&#039;s what I was thinking: I have a SLR camera with a remote control, a tripod and I was thinking of bringing light and simple things for the backdrop, plus, of course, any props for the actual pictures. What about the light? Do I need anything else? Any help is appreciated!&lt;\/p&gt;","Attachments":[],"Id":1852767,"PostDate":1401447520,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi everyone! I'm wondering if anyone had a DIY photobooth at their reception. I know there is a topic on doing one at the at home reception, but I'm interested in what kinds of things I would need to bring to Mexico and if it would even be possible? Here's what I was thinking: I have a SLR camera with a remote control, a tripod and I was thinking of bringing light and simple things for the backdrop, plus, of course, any props for the actual pictures. What about the light? Do I need anything else? Any help is appreciated!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<br><p><a data-ipb='nomediaparse' href='http:\/\/www.TickerFactory.com\/'><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;31;484\/st\/20150813\/e\/Wedding+time%21+\/dt\/-2\/k\/b92c\/event.png\" alt=\"event.png\"><\/a><\/p>\n<p style=\"text-align:center;\">\u00a0<\/p>\n<p style=\"text-align:center;\">\u00a0","Email":"sblopezb@gmail.com","IpAddress":"172.219.193.22","GroupId":42,"GroupName":"Sr. Member","JoinDate":1359748704,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265511.jpg?_r=1442890536","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"TinkerSofi","Id":265511,"Name":"TinkerSofi","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.246.139.68","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77174,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":3,"IsLiked":false,"PostKey":"350ec627356370085cd3c3f92a7b2915","RawContent":"&lt;p&gt;I&#039;m planning on doing a diy photobooth at my reception. &amp;nbsp;At first I considered booking the company my resort uses but it would be around $600 or 2 hours and I just couldn&#039;t add that cost on top of everything else. &amp;nbsp;I just bought a Instamax camera the other day and its basically like a polaroid that takes instant pictures. &amp;nbsp;I bought it as a bundle for $100 and it came with camera, 2 packs of film, carrying case, rechargeable batteries and i think a cleaning kit you can also get the film cheap on amazon. &amp;nbsp;As for props i&#039;m going to make some with cardstock and buy some fun stuff we can use like boas and masks. &amp;nbsp;I found a cute laser cut wood frame from Michaels really cheap and spray painted it gold its light weight so it&#039;ll be easy to travel with. I plan on just setting up a table on the side and letting people take pics as they please and putting a book so they can leave us messages with their photos I just need to make sure to buy enough instant film. &amp;nbsp;I was going to use my ipad and do the tripod thing and then set up a printer but seemed like more trouble the instax camera is simple and lightweight to bring with me to Mexico. &amp;nbsp;I&#039;m actually going to test it out at my bridal shower at the end of this month to see how my guests like it.   &lt;\/p&gt;","Attachments":[],"Id":1852785,"PostDate":1401449315,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I'm planning on doing a diy photobooth at my reception. \u00a0At first I considered booking the company my resort uses but it would be around $600 or 2 hours and I just couldn't add that cost on top of everything else. \u00a0I just bought a Instamax camera the other day and its basically like a polaroid that takes instant pictures. \u00a0I bought it as a bundle for $100 and it came with camera, 2 packs of film, carrying case, rechargeable batteries and i think a cleaning kit you can also get the film cheap on amazon. \u00a0As for props i'm going to make some with cardstock and buy some fun stuff we can use like boas and masks. \u00a0I found a cute laser cut wood frame from Michaels really cheap and spray painted it gold its light weight so it'll be easy to travel with. I plan on just setting up a table on the side and letting people take pics as they please and putting a book so they can leave us messages with their photos I just need to make sure to buy enough instant film. \u00a0I was going to use my ipad and do the tripod thing and then set up a printer but seemed like more trouble the instax camera is simple and lightweight to bring with me to Mexico. \u00a0I'm actually going to test it out at my bridal shower at the end of this month to see how my guests like it. \u00a0\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div>\n<p>43 guests plus bride and groom.... <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Engagement Photos - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/76051-engagement-pictures-by-del-sol-photography-pic-heavy\/#entry1827276'>http:\/\/www.bestdestinationwedding.com\/topic\/76051-engagement-pictures-by-del-sol-photography-pic-heavy\/#entry1827276<\/a><\/p>\n<\/div>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77563-njbride2014-planning-thread-leblanc-spa-resort-91314-pic-heavy\/#entry1860630'>http:\/\/www.bestdestinationwedding.com\/topic\/77563-njbride2014-planning-thread-leblanc-spa-resort-91314-pic-heavy\/#entry1860630<\/a>","Email":"sandyycaza@yahoo.com","IpAddress":"66.246.139.68","GroupId":40,"GroupName":"Jr. Member","JoinDate":1357660461,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-264077.jpg?_r=1415048239","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"NJBride2014","Id":264077,"Name":"NJBride2014","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.155.94.124","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77174,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"925623abdb01faae4af8c1d723cd7879","RawContent":"[quote name=\"NJBride2014\" post=\"1852785\" timestamp=\"1401463715\"]\nI&#039;m planning on doing a diy photobooth at my reception.  At first I considered booking the company my resort uses but it would be around $600 or 2 hours and I just couldn&#039;t add that cost on top of everything else.  I just bought a Instamax camera the other day and its basically like a polaroid that takes instant pictures.  I bought it as a bundle for $100 and it came with camera, 2 packs of film, carrying case, rechargeable batteries and i think a cleaning kit you can also get the film cheap on amazon.  As for props i&#039;m going to make some with cardstock and buy some fun stuff we can use like boas and masks.  I found a cute laser cut wood frame from Michaels really cheap and spray painted it gold its light weight so it&#039;ll be easy to travel with. I plan on just setting up a table on the side and letting people take pics as they please and putting a book so they can leave us messages with their photos I just need to make sure to buy enough instant film.  I was going to use my ipad and do the tripod thing and then set up a printer but seemed like more trouble the instax camera is simple and lightweight to bring with me to Mexico.  I&#039;m actually going to test it out at my bridal shower at the end of this month to see how my guests like it.[\/quote]thanks! That&#039;s a great idea. We&#039;re on the same boat, we don&#039;t have that much money to pay the photographer to do it so that&#039;s why I thought of putting it together myself. They might not look as professional, but they&#039;ll be every bit of fun. Plus, I find that when people are taking their own pictures rather than having a stranger take them they might feel more comfortable :).\n\nI originally wanted to make my guestbook as a photo album with polaroid pictures and then people leave a message if they want, so it would be two birds with one stone. One of my friends did that and so she has the camera that she could lend me. I would just have to buy the film. On the other hand, I thought that if [size=4]I used the digital camera, I would print one picture of every guest later and send it to them as a thank you for coming. Tough choice! [\/size]\nI&#039;m really concerned that they will come out really dark if I don&#039;t have the proper light, but I guess I could try something out in my backyard one night and see what happens haha. \n\nLet me know how it goes at the bridal shower! I&#039;m sure they&#039;ll love it because photobooths are just so much fun!","Attachments":[],"Id":1852787,"PostDate":1401450741,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>NJBride2014, on 30 May 2014 - 11:28 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>I'm planning on doing a diy photobooth at my reception. \u00a0At first I considered booking the company my resort uses but it would be around $600 or 2 hours and I just couldn't add that cost on top of everything else. \u00a0I just bought a Instamax camera the other day and its basically like a polaroid that takes instant pictures. \u00a0I bought it as a bundle for $100 and it came with camera, 2 packs of film, carrying case, rechargeable batteries and i think a cleaning kit you can also get the film cheap on amazon. \u00a0As for props i'm going to make some with cardstock and buy some fun stuff we can use like boas and masks. \u00a0I found a cute laser cut wood frame from Michaels really cheap and spray painted it gold its light weight so it'll be easy to travel with. I plan on just setting up a table on the side and letting people take pics as they please and putting a book so they can leave us messages with their photos I just need to make sure to buy enough instant film. \u00a0I was going to use my ipad and do the tripod thing and then set up a printer but seemed like more trouble the instax camera is simple and lightweight to bring with me to Mexico. \u00a0I'm actually going to test it out at my bridal shower at the end of this month to see how my guests like it. \u00a0\u00a0<\/p>\n<\/div>\n<\/div><\/div>\n<p>thanks! That's a great idea. We're on the same boat, we don't have that much money to pay the photographer to do it so that's why I thought of putting it together myself. They might not look as professional, but they'll be every bit of fun. Plus, I find that when people are taking their own pictures rather than having a stranger take them they might feel more comfortable <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>.<\/p>\n<p>\u00a0<\/p>\n<p>I originally wanted to make my guestbook as a photo album with polaroid pictures and then people leave a message if they want, so it would be two birds with one stone. One of my friends did that and so she has the camera that she could lend me. I would just have to buy the film. On the other hand, I thought that if\u00a0<span  style=\"font-size:14px\">I used the digital camera, I would print one picture of every guest later and send it to them as a thank you for coming. Tough choice!\u00a0<\/span><\/p>\n<p>I'm really concerned that they will come out really dark if I don't have the proper light, but I guess I could try something out in my backyard one night and see what happens haha.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Let me know how it goes at the bridal shower! I'm sure they'll love it because photobooths are just so much fun!\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<br><p><a data-ipb='nomediaparse' href='http:\/\/www.TickerFactory.com\/'><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;31;484\/st\/20150813\/e\/Wedding+time%21+\/dt\/-2\/k\/b92c\/event.png\" alt=\"event.png\"><\/a><\/p>\n<p style=\"text-align:center;\">\u00a0<\/p>\n<p style=\"text-align:center;\">\u00a0","Email":"sblopezb@gmail.com","IpAddress":"172.219.193.22","GroupId":42,"GroupName":"Sr. Member","JoinDate":1359748704,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265511.jpg?_r=1442890536","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"TinkerSofi","Id":265511,"Name":"TinkerSofi","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"188.29.166.86","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77174,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b68bc14b06d0dee2504c2ca2dae1cc4d","RawContent":"&lt;p&gt;Good idea!!&lt;\/p&gt;","Attachments":[],"Id":1872930,"PostDate":1411543898,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Good idea!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"justineatack@gmail.com","IpAddress":"31.54.1.116","GroupId":40,"GroupName":"Jr. Member","JoinDate":1409997456,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279711.jpg?_r=1410256327","PhotoWidth":200,"PhotoHeight":125,"PhotoType":"custom"},"FormattedName":"Bride2b15","Id":279711,"Name":"Bride2b15","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"76.10.147.106","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77174,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0d4df1e801043ed666e930ac01ce68bb","RawContent":"&lt;p&gt;What a great idea! @[member=\"NJBride2014\"] how did it turn out?&lt;\/p&gt;","Attachments":[],"Id":1896695,"PostDate":1432154235,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>What a great idea! @<a hovercard-ref=\"member\" hovercard-id=\"264077\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/264077-njbride2014\/' title='Member profile'><span itemprop=\"name\">NJBride2014<\/span><\/a> how did it turn out?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rmaranjyan@gmail.com","IpAddress":"24.114.56.222","GroupId":39,"GroupName":"Newbie","JoinDate":1421753212,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281803.jpg?_r=1431571558","PhotoWidth":200,"PhotoHeight":160,"PhotoType":"custom"},"FormattedName":"Ruzanna","Id":281803,"Name":"Ruzanna","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"203.176.176.18","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77174,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0c63cbc66b632312f8381dc87b3c60a4","RawContent":"&lt;p&gt;ya,,, exactly like that! photografer and camera SLR and then backdrop, some flower or accesories (like hat, big eyeglasses, wig, etc)&lt;\/p&gt;\n&lt;p&gt;good luck!&lt;\/p&gt;","Attachments":[],"Id":1898010,"PostDate":1433584504,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>ya,,, exactly like that! photografer and camera SLR and then backdrop, some flower or accesories (like hat, big eyeglasses, wig, etc)<\/p>\n<p>good luck!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"samwillow39@gmail.com","IpAddress":"114.121.164.128","GroupId":39,"GroupName":"Newbie","JoinDate":1430650422,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282964.jpg?_r=1431149209","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"samwillow","Id":282964,"Name":"samwillow","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.246.139.68","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77174,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3fa7831ccd168fa0dc755705f1692eb2","RawContent":"[quote name=\"Ruzanna\" post=\"1896695\" timestamp=\"1432168635\"]\nWhat a great idea! @[member=\"NJBride2014\"] how did it turn out?[\/quote]Hi Ruzanna,\n\nSorry I&#039;m not on this site much anymore so I just saw this post.  I actually bit the bullet and just hired the professional photo booth for 2 hours and it was so worth it.  As for the DIY it can still totally be done.  I used the DIY booth at both my bridal shower and bachelorette party and it was so much fun and would be a great alternative to a full on professional booth.  The instamax camera is great and you can buy a lot of film for a decent price on amazon.  Props you can buy either at Michaels or on Etsy.  I actually just made my own props on card stock so you can make this an affordable option. Hope this helps.","Attachments":[],"Id":1899946,"PostDate":1436284339,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Ruzanna, on 20 May 2015 - 08:37 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>What a great idea! @<a hovercard-ref=\"member\" hovercard-id=\"264077\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/264077-njbride2014\/' title='Member profile'><span itemprop=\"name\">NJBride2014<\/span><\/a> how did it turn out?<\/p>\n<\/div>\n<\/div><\/div>\n<p>Hi Ruzanna,<\/p>\n<p>\u00a0<\/p>\n<p>Sorry I'm not on this site much anymore so I just saw this post. \u00a0I actually bit the bullet and just hired the professional photo booth for 2 hours and it was so worth it. \u00a0As for the DIY it can still totally be done. \u00a0I used the DIY booth at both my bridal shower and bachelorette party and it was so much fun and would be a great alternative to a full on professional booth. \u00a0The instamax camera is great and you can buy a lot of film for a decent price on amazon. \u00a0Props you can buy either at Michaels or on Etsy. \u00a0I actually just made my own props on card stock so you can make this an affordable option. Hope this helps. \u00a0\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div>\n<p>43 guests plus bride and groom.... <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Engagement Photos - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/76051-engagement-pictures-by-del-sol-photography-pic-heavy\/#entry1827276'>http:\/\/www.bestdestinationwedding.com\/topic\/76051-engagement-pictures-by-del-sol-photography-pic-heavy\/#entry1827276<\/a><\/p>\n<\/div>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77563-njbride2014-planning-thread-leblanc-spa-resort-91314-pic-heavy\/#entry1860630'>http:\/\/www.bestdestinationwedding.com\/topic\/77563-njbride2014-planning-thread-leblanc-spa-resort-91314-pic-heavy\/#entry1860630<\/a>","Email":"sandyycaza@yahoo.com","IpAddress":"66.246.139.68","GroupId":40,"GroupName":"Jr. Member","JoinDate":1357660461,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-264077.jpg?_r=1415048239","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"NJBride2014","Id":264077,"Name":"NJBride2014","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"201.116.201.71","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77174,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"ce87e5709ce6dc50c3f3cf8a7ded6dd9","RawContent":"&lt;p&gt;&lt;span style=\"font-family:georgia, serif;\"&gt;&lt;span style=\"font-size:14px;\"&gt;Hi girls!&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-family:georgia, serif;\"&gt;&lt;span style=\"font-size:14px;\"&gt;We recently had a couple choosing to have their photobooth with their iPad; they brought the props which were mexican theme, as well as an instagram frame that was really fun for guests to take their pictures on. And we setup the background with lovely tassels. Totally go for it! it makes great memories and people have fun during the reception.&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;div&gt;[sharedmedia=gallery:images:81625]&lt;\/div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:81626]\n&lt;div&gt;[sharedmedia=gallery:images:81627]&lt;\/div&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;\/div&gt;\n\n\t\t\t\t&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n\t\t\t\n\t\t\n\t\t\t\t&lt;p&gt;&lt;strong&gt;&lt;span style=\"color:#61a5b9;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;&lt;span style=\"font-size:9pt;\"&gt;Adventure Weddings&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/p&gt;\n\t\t\t\n\t\t\n\t\t\t\t&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.adventureweddingsvallarta.com\/&#039;&gt;&lt;span style=\"color:#0000FF;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;&lt;span style=\"font-size:8.5pt;\"&gt;www.adventureweddingsvallarta.com&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/a&gt;&lt;\/p&gt;\n\t\t\t\n\t\t\n\t\t\t\t&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n\t\t\t\n\t\t\n\t\t\t\t&lt;p&gt;&lt;span style=\"color:#61a5b9;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;&lt;span style=\"font-size:9pt;\"&gt;Toll Free: 1 866.731.8152&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n\t\t\t\n\t\t\n\t\t\t\t\n\t\t\t\t\t\t\t\t&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/AdventureWedding&#039;&gt;&lt;span style=\"color:#0000FF;\"&gt;&lt;span style=\"font-family:&#039;times new roman&#039;, serif;\"&gt;&lt;span style=\"font-size:12pt;\"&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/a&gt;&lt;\/p&gt;\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t&lt;p&gt;&lt;span style=\"color:#FFFFFF;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;&lt;span style=\"font-size:1pt;\"&gt;VAD&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.pinterest.com\/adventurew\/&#039;&gt;&lt;span style=\"color:#0000FF;\"&gt;&lt;span style=\"font-family:&#039;times new roman&#039;, serif;\"&gt;&lt;span style=\"font-size:12pt;\"&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/a&gt;&lt;\/p&gt;\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t&lt;p&gt;&lt;span style=\"color:#FFFFFF;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;&lt;span style=\"font-size:1pt;\"&gt;VAD&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21577-adventure-weddings-las-caletas\/&#039;&gt;&lt;span style=\"color:#0000FF;\"&gt;&lt;span style=\"font-family:&#039;times new roman&#039;, serif;\"&gt;&lt;span style=\"font-size:12pt;\"&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/a&gt;&lt;\/p&gt;","Attachments":[],"Id":1900699,"PostDate":1437225158,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span  style=\"font-family:georgia, serif\"><span  style=\"font-size:14px\">Hi girls!<\/span><\/span><\/p>\n<p><span  style=\"font-family:georgia, serif\"><span  style=\"font-size:14px\">We recently had a couple choosing to have their photobooth with their iPad; they brought the props which were mexican theme, as well as an instagram frame that was really fun for guests to take their pictures on. And we setup the background with lovely tassels. Totally go for it! it makes great memories and people have fun during the reception.<\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/81625-diy-photoboot\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17896\/sml_gallery_258213_17896_2088956.jpg' class='galattach galimageview sharedmedia_screenshot' title='DIY Photoboot'  width='200' height='134'  alt='DIY Photoboot' id='sml_image_view_81625' \/><\/a>\n<br \/><\/div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/81626-fun-reception-at-las-caletas\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17896\/sml_gallery_258213_17896_1689900.jpg' class='galattach galimageview sharedmedia_screenshot' title='Fun Reception at Las Caletas'  width='200' height='134'  alt='Fun Reception at Las Caletas' id='sml_image_view_81626' \/><\/a>\n<br \/>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/81627-wedding-reception-at-las-caletas\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17896\/sml_gallery_258213_17896_661060.jpg' class='galattach galimageview sharedmedia_screenshot' title='Wedding Reception at Las Caletas'  width='200' height='154'  alt='Wedding Reception at Las Caletas' id='sml_image_view_81627' \/><\/a>\n<br \/><\/div>\n<p>\u00a0<\/p>\n<\/div>\n\n\t\t\t\t<p>\u00a0<\/p>\n\t\t\t\n\t\t\n\t\t\t\t<p><strong><span  style=\"color:#61a5b9\"><span  style=\"font-family:arial, sans-serif\"><span  style=\"font-size:9pt\">Adventure Weddings\u00a0<\/span><\/span><\/span><\/strong><\/p>\n\t\t\t\n\t\t\n\t\t\t\t<p><a href='https:\/\/www.adventureweddingsvallarta.com\/' class='bbc_url' title='External link' rel='nofollow external'><span  style=\"color:#0000FF\"><span  style=\"font-family:arial, sans-serif\"><span  style=\"font-size:8.5pt\">www.adventureweddingsvallarta.com<\/span><\/span><\/span><\/a><\/p>\n\t\t\t\n\t\t\n\t\t\t\t<p>\u00a0<\/p>\n\t\t\t\n\t\t\n\t\t\t\t<p><span  style=\"color:#61a5b9\"><span  style=\"font-family:arial, sans-serif\"><span  style=\"font-size:9pt\">Toll Free: 1 866.731.8152<\/span><\/span><\/span><\/p>\n\t\t\t\n\t\t\n\t\t\t\t\n\t\t\t\t\t\t\t\t<p><a href='https:\/\/www.facebook.com\/AdventureWedding' class='bbc_url' title='External link' rel='nofollow external'><span  style=\"color:#0000FF\"><span  style=\"font-family:'times new roman', serif;\"><span  style=\"font-size:12pt\"><\/span><\/span><\/span><\/a><\/p>\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t<p><span  style=\"color:#FFFFFF\"><span  style=\"font-family:arial, sans-serif\"><span  style=\"font-size:1pt\">VAD<\/span><\/span><\/span><\/p>\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t<p><a href='https:\/\/www.pinterest.com\/adventurew\/' class='bbc_url' title='External link' rel='nofollow external'><span  style=\"color:#0000FF\"><span  style=\"font-family:'times new roman', serif;\"><span  style=\"font-size:12pt\"><\/span><\/span><\/span><\/a><\/p>\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t<p><span  style=\"color:#FFFFFF\"><span  style=\"font-family:arial, sans-serif\"><span  style=\"font-size:1pt\">VAD<\/span><\/span><\/span><\/p>\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t<p><a href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21577-adventure-weddings-las-caletas\/' class='bbc_url' title=''><span  style=\"color:#0000FF\"><span  style=\"font-family:'times new roman', serif;\"><span  style=\"font-size:12pt\"><\/span><\/span><\/span><\/a><\/p>\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"dennise@adventureweddingsvallarta.com","IpAddress":"187.146.166.254","GroupId":49,"GroupName":"Insiders","JoinDate":1343044403,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-258213.jpeg?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"LasCaletas","Id":258213,"Name":"LasCaletas","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"116.100.186.162","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77174,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9c4547713c9be1749e74460a3e77de7c","RawContent":"&lt;p&gt;That&#039;s a good idea for photobooth :)&lt;\/p&gt;","Attachments":[],"Id":1905127,"PostDate":1442815698,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>That's a good idea for photobooth <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:rgb(62,62,62);font-family:Tahoma, Calibri, Verdana, Geneva, sans-serif;font-size:13px;background-color:rgb(250,250,250);\">Online updates fastest score at\u00a0<\/span><a data-ipb='nomediaparse' href='http:\/\/u99bet.net\/ca-do-bong-da-online-ca-cuoc-the-thao-truc-tuyen\/'>7m<\/a>","Email":"levdung.exc@gmail.com","IpAddress":"116.100.178.162","GroupId":39,"GroupName":"Newbie","JoinDate":1439164840,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284343.jpg?_r=1439179533","PhotoWidth":199,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"excpomelo","Id":284343,"Name":"excpomelo","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.98.196.2","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77174,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"fea261797909017d0e429cb16e651ecb","RawContent":"&lt;p&gt;that photo booth looks great!&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Just an update:&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We decided to do our own photo booth for our wedding. We had found a local company in the Mayan Riviera that had very reasonable prices but unfortunately our hotel didn&#039;t let us work with them so we had to improvise a little.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We used a tripod and my dad&#039;s dslr camera. I went through some old halloween costumes that we had and brought what I could. Then I also bought some chalkboard sign printables from etsy and made my own signs. We did not use any extra lighting and we used one of the walls at the venues as the backdrop. Overall, the whole thing cost about $15 tops, including the paper and ink to print the signs. I already had most of the props, so I didn&#039;t count that as part of the budget.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;This was the result:&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;","Attachments":[],"Id":1905139,"PostDate":1442834042,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>that photo booth looks great!\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Just an update:\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>We decided to do our own photo booth for our wedding. We had found a local company in the Mayan Riviera that had very reasonable prices but unfortunately our hotel didn't let us work with them so we had to improvise a little.<\/p>\n<p>\u00a0<\/p>\n<p>We used a tripod and my dad's dslr camera. I went through some old halloween costumes that we had and brought what I could. Then I also bought some chalkboard sign printables from etsy and made my own signs. We did not use any extra lighting and we used one of the walls at the venues as the backdrop. Overall, the whole thing cost about $15 tops, including the paper and ink to print the signs. I already had most of the props, so I didn't count that as part of the budget.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>This was the result:\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><a class='resized_img' rel='lightbox[1905139]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_09_2015\/post-265511-0-76754700-1442848254.jpg\" title=\"photo booth .jpg - Size: 79.01KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_09_2015\/post-265511-0-76754700-1442848254.jpg\" class='bbc_img linked-image' alt=\"photo booth .jpg\" \/><\/a>\n\n<\/p>\n<p><a class='resized_img' rel='lightbox[1905139]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_09_2015\/post-265511-0-87495400-1442848261.jpg\" title=\"photobooth 3.jpg - Size: 65.91KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_09_2015\/post-265511-0-87495400-1442848261.jpg\" class='bbc_img linked-image' alt=\"photobooth 3.jpg\" \/><\/a>\n\n<\/p>\n<p><a class='resized_img' rel='lightbox[1905139]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_09_2015\/post-265511-0-86522800-1442848258.jpg\" title=\"photobooth 2.jpg - Size: 59.26KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_09_2015\/post-265511-0-86522800-1442848258.jpg\" class='bbc_img linked-image' alt=\"photobooth 2.jpg\" \/><\/a>\n\n<\/p>\n<p><a class='resized_img' rel='lightbox[1905139]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_09_2015\/post-265511-0-80008200-1442848265.jpg\" title=\"photobooth 4.jpg - Size: 69.66KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_09_2015\/post-265511-0-80008200-1442848265.jpg\" class='bbc_img linked-image' alt=\"photobooth 4.jpg\" \/><\/a>\n\n<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<br><p><a data-ipb='nomediaparse' href='http:\/\/www.TickerFactory.com\/'><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;31;484\/st\/20150813\/e\/Wedding+time%21+\/dt\/-2\/k\/b92c\/event.png\" alt=\"event.png\"><\/a><\/p>\n<p style=\"text-align:center;\">\u00a0<\/p>\n<p style=\"text-align:center;\">\u00a0","Email":"sblopezb@gmail.com","IpAddress":"172.219.193.22","GroupId":42,"GroupName":"Sr. Member","JoinDate":1359748704,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265511.jpg?_r=1442890536","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"TinkerSofi","Id":265511,"Name":"TinkerSofi","IsOnline":false}}],"Id":"77174","Title":"Diy Photobooth At Reception","LastPostDate":1442841400},"Pages":{"TotalItems":11,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
