ason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e235cdc8538b7e50d121c51d3fa61fcd","RawContent":"&lt;p&gt;Congratulations. Always good to start planning early.&lt;\/p&gt;","Attachments":[],"Id":1880627,"PostDate":1418848343,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congratulations. Always good to start planning early.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"vsschick@gmail.com","IpAddress":"162.208.80.15","GroupId":40,"GroupName":"Jr. Member","JoinDate":1404469910,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"vsschick1234","Id":278832,"Name":"vsschick1234","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"38.109.117.155","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":74739,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"61abfb5cb8c7e29cf56f1343e95ba540","RawContent":"&lt;p&gt;HI all!! Getting so nervous as I&#039;ve been super laid back about planning the whole thing.&amp;nbsp; Looking to get married in November and have to book the date!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;IS anyone nervous about the weather in Nov?&lt;\/p&gt;","Attachments":[],"Id":1882735,"PostDate":1421159218,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>HI all!! Getting so nervous as I've been super laid back about planning the whole thing.\u00a0 Looking to get married in November and have to book the date!<\/p>\n<p>\u00a0<\/p>\n<p>IS anyone nervous about the weather in Nov?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cbrody@citco.com","IpAddress":"24.184.135.35","GroupId":39,"GroupName":"Newbie","JoinDate":1420761613,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281650.jpg?_r=1420831294","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"Brod63","Id":281650,"Name":"Brod63","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"69.171.137.145","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":74739,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e32e425133fbfca098461cf0500f14c9","RawContent":"&lt;p&gt;Any Canadian Brides getting quotes for November AI packages? The best I&#039;ve gotten is $1700, anyone else?&lt;\/p&gt;","Attachments":[],"Id":1886108,"PostDate":1423682359,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Any Canadian Brides getting quotes for November AI packages? The best I've gotten is $1700, anyone else?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"juliareddy@gmail.com","IpAddress":"209.91.179.179","GroupId":39,"GroupName":"Newbie","JoinDate":1409160121,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279601.jpg?_r=1420814517","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"julianow","Id":279601,"Name":"julianow","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.68.109.248","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":74739,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"50cff53f9b080e340e8f942d529bcc1c","RawContent":"@ Brod63, at least November is at the tail end of hurricane season. Crossing fingers for good weather.","Attachments":[],"Id":1886134,"PostDate":1423725963,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @ Brod63, at least November is at the tail end of hurricane season. Crossing fingers for good weather.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"pinkiesup08@gmail.com","IpAddress":"75.181.5.152","GroupId":47,"GroupName":"Site Supporter","JoinDate":1374599724,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-271841.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"RandL2015","Id":271841,"Name":"RandL2015","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.164.79.68","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":74739,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"39ef155647f487b7369295df05e940e2","RawContent":"We were married in Jamaica in October and the weather is fantastic. yes hurricanes were a concern but the Jamaica people love to tell you that they just pass by the island. I know Mexico gets hit more frequently but the really peak months are August and September. Fingers crossed!","Attachments":[],"Id":1886135,"PostDate":1423727114,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We were married in Jamaica in October and the weather is fantastic. yes hurricanes were a concern but the Jamaica people love to tell you that they just pass by the island. I know Mexico gets hit more frequently but the really peak months are August and September. Fingers crossed!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><em><span style=\"color:rgb(51,153,255);\">I'm lucky enough to\u00a0tell my husband how much I love him and say yes again\u00a0on October 20, 2015 at Grand Coral Beach Club!\u00a0<\/span><\/em>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":74739,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4e063d931d24459f99173448a7092ee1","RawContent":"&lt;p&gt;Congrats! I&#039;m getting married December 15, 2015. It can&#039;t come soon enough -&amp;nbsp;i&#039;m so excited!&lt;\/p&gt;","Attachments":[],"Id":1886164,"PostDate":1423745179,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats! I'm getting married December 15, 2015. It can't come soon enough -\u00a0i'm so excited!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419423414,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1436293677","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":true}}],"Pages":{"TotalItems":49,"TotalPages":5,"CurrentPage":20,"NextPage":30,"PreviousPage":10,"LastPage":40},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
