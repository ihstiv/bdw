{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":true,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":10,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":336,"MovedTo":null,"MovedOn":0,"FirstPostId":1900916,"Rating":0,"RatingHits":0,"Starter":{"Id":283575,"Name":"JessieL","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1437581305,"LastPoster":{"Id":264357,"Name":"Ems85","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-264357.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":100,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1901074,"PostDate":1437734203,"PostContent":"Just to let you know they don't need to put up structures for the lanterns as they use the lamp...","Author":{"Signature":"","Email":"emilykate.field@hotmail.co.uk","IpAddress":"151.228.109.2","GroupId":39,"GroupName":"Newbie","JoinDate":1358111979,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-264357.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Ems85","Id":264357,"Name":"Ems85","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.197.65.169","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79424,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"dbd98932aec34fa98ae3a1aceb4e1817","RawContent":"&lt;p&gt;&lt;span style=\"color:rgb(20,24,35);font-family:helvetica, arial, sans-serif;\"&gt;Does anyone have any information about the lighting at any of the Moon Palace terrace&#039;s? We&#039;re having our reception at one in November at 6pm &amp;amp; I&#039;m trying to figure out if the lamps they have surrounding the terrace&#039;s will put off enough light. I know it gets dark early that time of year in Mexico. But the prices I&#039;m being quoted for lighting is outrageous (&amp;amp; outside my budget) so I&#039;m just trying to figure out what to do. Any information would be appreciated!&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1900916,"PostDate":1437581305,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span  style=\"color:rgb(20,24,35);font-family:helvetica, arial, sans-serif\">Does anyone have any information about the lighting at any of the Moon Palace terrace's? We're having our reception at one in November at 6pm & I'm trying to figure out if the lamps they have surrounding the terrace's will put off enough light. I know it gets dark early that time of year in Mexico. But the prices I'm being quoted for lighting is outrageous (& outside my budget) so I'm just trying to figure out what to do. Any information would be appreciated!<\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"traveling_chica@hotmail.com","IpAddress":"50.197.65.169","GroupId":39,"GroupName":"Newbie","JoinDate":1434494018,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"JessieL","Id":283575,"Name":"JessieL","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79424,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"c56fa513dd888111dc379c333fd7556b","RawContent":"&lt;p&gt;I&#039;ve stayed there and i&#039;ve seen that terrace at night. I&#039;ve also seen a wedding happening on that terrace when I stayed there. I can say that it would probably be slightly dim if you don&#039;t get a few extra lights. You may be able to pull it off if you bring lots of lighting (votives etc) for the tables.&lt;\/p&gt;","Attachments":[],"Id":1900917,"PostDate":1437581499,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I've stayed there and i've seen that terrace at night. I've also seen a wedding happening on that terrace when I stayed there. I can say that it would probably be slightly dim if you don't get a few extra lights. You may be able to pull it off if you bring lots of lighting (votives etc) for the tables.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419441414,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1436293677","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"142.161.170.48","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79424,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"96db4e86ba4962dc616e0290b715a3d9","RawContent":"&lt;p&gt;Welcome to our forum community JessieL and Congrats on your Moon Palace wedding coming up!!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We&#039;ve captured numerous beautiful weddings there, and can assure you it will make a gorgeous backdrop for your photo memories as well :) Here are a few examples of what we&#039;re talking about......enoy!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;....&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;\/\/www.facebook.com\/media\/set\/?set=a.10153122555899487.1073741922.18683524486&amp;amp;type=3&#039;&gt;Moon Palace Wedding Album 1:&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xpt1\/t31.0-8\/10864005_10153122561094487_4283491233577296478_o.jpg\" alt=\"10864005_10153122561094487_4283491233577\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;....&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10153058061334487.1073741919.18683524486&amp;amp;type=3&#039;&gt;Moon Palace Wedding Album 2:&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xfp1\/t31.0-8\/10904548_10153058072764487_833388014720734260_o.jpg\" alt=\"10904548_10153058072764487_8333880147207\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xpf1\/t31.0-8\/10960290_10153058074174487_1506614105010351576_o.jpg\" alt=\"10960290_10153058074174487_1506614105010\"&gt;&lt;\/p&gt;\n&lt;p&gt;.&lt;\/p&gt;\n&lt;p&gt;...&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10151930921014487.1073741866.18683524486&amp;amp;type=3&#039;&gt;Moon Palace Wedding Album 3:&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xap1\/t31.0-8\/1415241_10151930926689487_1675104903_o.jpg\" alt=\"1415241_10151930926689487_1675104903_o.j\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Wishing you happy research, and all the best with your plans - cheers!!! team MTM :)&lt;\/p&gt;","Attachments":[],"Id":1900932,"PostDate":1437592672,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome to our forum community JessieL and Congrats on your Moon Palace wedding coming up!!!<\/p>\n<p>\u00a0<\/p>\n<p>We've captured numerous beautiful weddings there, and can assure you it will make a gorgeous backdrop for your photo memories as well <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> Here are a few examples of what we're talking about......enoy!<\/p>\n<p>\u00a0<\/p>\n<p>....<a href='\/\/www.facebook.com\/media\/set\/?set=a.10153122555899487.1073741922.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>Moon Palace Wedding Album 1:<\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xpt1\/t31.0-8\/10864005_10153122561094487_4283491233577296478_o.jpg\" alt=\"10864005_10153122561094487_4283491233577\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>....<a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10153058061334487.1073741919.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>Moon Palace Wedding Album 2:<\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xfp1\/t31.0-8\/10904548_10153058072764487_833388014720734260_o.jpg\" alt=\"10904548_10153058072764487_8333880147207\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xpf1\/t31.0-8\/10960290_10153058074174487_1506614105010351576_o.jpg\" alt=\"10960290_10153058074174487_1506614105010\"><\/span><\/p>\n<p>.<\/p>\n<p>...<a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10151930921014487.1073741866.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>Moon Palace Wedding Album 3:<\/a><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xap1\/t31.0-8\/1415241_10151930926689487_1675104903_o.jpg\" alt=\"1415241_10151930926689487_1675104903_o.j\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Wishing you happy research, and all the best with your plans - cheers!!! team MTM <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280214260,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"62.172.139.39","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":false,"TopicId":79424,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"871daa5169690c4acbb9f1f939bfcbfa","RawContent":"&lt;p&gt;This information would be helpful for me too, my wedding is in Ocrober.&lt;\/p&gt;\n&lt;p&gt;We have now been moved to the Venado Terrace as the Caribbean Terrace is closing due to refurbishment works :(&lt;\/p&gt;\n&lt;p&gt;The lighting is so expensive, we liked the lanterns and string lights but the need to put up structures plus the lights so will work out over budget for me too.&lt;\/p&gt;\n&lt;p&gt;Any tips or ideas would be much appreciated.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;x&lt;\/p&gt;","Attachments":[],"Id":1901011,"PostDate":1437661637,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>This information would be helpful for me too, my wedding is in Ocrober.<\/p>\n<p>We have now been moved to the Venado Terrace as the Caribbean Terrace is closing due to refurbishment works <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/sad.png' class='bbc_emoticon' alt=':(' \/><\/p>\n<p>The lighting is so expensive, we liked the lanterns and string lights but the need to put up structures plus the lights so will work out over budget for me too.<\/p>\n<p>Any tips or ideas would be much appreciated.<\/p>\n<p>\u00a0<\/p>\n<p>x<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"surekha_18@hotmail.com","IpAddress":"62.172.139.39","GroupId":39,"GroupName":"Newbie","JoinDate":1436799592,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"SUREKHA","Id":283937,"Name":"SUREKHA","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.114.39.229","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79424,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"0f684eb8461c8a164fc4cad76476f733","RawContent":"Hi @[member=\"SUREKHA\"] I&#039;m so sorry to hear that they&#039;ve had to change your reception venue on you. I know it can be quite disappointing, especially if you&#039;ve already had a vision of what your day will look like.\n\n\nI&#039;ve seen some photos of the Venado terrace on this forum and it was beautiful! Based on your post, did you say there&#039;s no structure to hang lights? If that&#039;s the case, there are lots of other options. @[member=\"perianjay\"] ran into this same problem and is now using the lanterns on bamboo fixtures. There&#039;s also hanging chandeliers if you prefer. Or you can always get the lighting options from a DJ if you choose to have one. Another idea may be to do the under table lights, and have a light up dance floor. You have plenty of options :)","Attachments":[],"Id":1901017,"PostDate":1437665188,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi @<a hovercard-ref=\"member\" hovercard-id=\"283937\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/283937-surekha\/' title='Member profile'><span itemprop=\"name\">SUREKHA<\/span><\/a> I'm so sorry to hear that they've had to change your reception venue on you. I know it can be quite disappointing, especially if you've already had a vision of what your day will look like.<br><br>\nI've seen some photos of the Venado terrace on this forum and it was beautiful! Based on your post, did you say there's no structure to hang lights? If that's the case, there are lots of other options. @<a hovercard-ref=\"member\" hovercard-id=\"281478\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281478-perianjay\/' title='Member profile'><span itemprop=\"name\">perianjay<\/span><\/a> ran into this same problem and is now using the lanterns on bamboo fixtures. There's also hanging chandeliers if you prefer. Or you can always get the lighting options from a DJ if you choose to have one. Another idea may be to do the under table lights, and have a light up dance floor. You have plenty of options <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"My planning thread: <a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/79425-wafflesmom-moon-palace-planning-thread-january-23-2016\/\">http:\/\/www.bestdestinationwedding.com\/topic\/79425-wafflesmom-moon-palace-planning-thread-january-23-2016\/<\/a><br><br>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;4;484\/st\/20160123\/e\/Our+Wedding\/dt\/-2\/k\/44c5\/event.png\" alt=\"event.png\"><\/a>","Email":"jerilee.valenzuela@shaw.ca","IpAddress":"24.114.26.77","GroupId":3,"GroupName":"Member","JoinDate":1410102185,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279721.jpg?_r=1441055220","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"Wafflesmom","Id":279721,"Name":"Wafflesmom","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79424,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"f0f828a22a82c55115a013bdd64ba767","RawContent":"&lt;p&gt;@[member=\"Wafflesmom\"] is totally right. I went through Zuniga as a vendor and they had these arched bamboo poles that have two chinese lanterns hanging from them. I can&#039;t remember the exact price off the top of my head.. but it was a lot less and it required no poles to be installed. I basically have one beside each guest table (3 tables) and I have 4 of them to frame the \"dance floor\" area in the shape of a square. I rented a &amp;nbsp;hanging chandelier for above the head table. The chandeliers are quite a bit more than the bamboo poles which is why I am only renting one.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Lighting is definitely a necessity in most cases. I know that at Beach Palace, almost every single terrace they have available for the reception has no lighting. I felt super stressed about lighting when I first started planning, but now i&#039;m happy I found a cheaper option. The string lights (for three strings + tensors) would&#039;ve cost me $1000 USD if I did them. Lighting is now costing me half of that (including the chandelier).&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1901022,"PostDate":1437667602,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"279721\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/279721-wafflesmom\/' title='Member profile'><span itemprop=\"name\">Wafflesmom<\/span><\/a> is totally right. I went through Zuniga as a vendor and they had these arched bamboo poles that have two chinese lanterns hanging from them. I can't remember the exact price off the top of my head.. but it was a lot less and it required no poles to be installed. I basically have one beside each guest table (3 tables) and I have 4 of them to frame the \"dance floor\" area in the shape of a square. I rented a \u00a0hanging chandelier for above the head table. The chandeliers are quite a bit more than the bamboo poles which is why I am only renting one.<\/p>\n<p>\u00a0<\/p>\n<p>Lighting is definitely a necessity in most cases. I know that at Beach Palace, almost every single terrace they have available for the reception has no lighting. I felt super stressed about lighting when I first started planning, but now i'm happy I found a cheaper option. The string lights (for three strings + tensors) would've cost me $1000 USD if I did them. Lighting is now costing me half of that (including the chandelier).\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419441414,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1436293677","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"62.172.139.39","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":false,"TopicId":79424,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a36a37fe03c47f890b8d22b124c937d1","RawContent":"&lt;p&gt;My wedding coordinator did not give me a brochure or send me information on Zuniga, I will need to ask her for this. &amp;nbsp;Are they a preferred vendor also?&lt;\/p&gt;","Attachments":[],"Id":1901028,"PostDate":1437670175,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>My wedding coordinator did not give me a brochure or send me information on Zuniga, I will need to ask her for this. \u00a0Are they a preferred vendor also?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"surekha_18@hotmail.com","IpAddress":"62.172.139.39","GroupId":39,"GroupName":"Newbie","JoinDate":1436799592,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"SUREKHA","Id":283937,"Name":"SUREKHA","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.114.39.229","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79424,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"d41dfb61efe70a0c638662b55e205779","RawContent":"@[member=\"SUREKHA\"] unless they&#039;ve changed this recently, there are three palace approved vendors for decor: Gama, zuniga and LatinAsia","Attachments":[],"Id":1901029,"PostDate":1437670267,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"283937\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/283937-surekha\/' title='Member profile'><span itemprop=\"name\">SUREKHA<\/span><\/a> unless they've changed this recently, there are three palace approved vendors for decor: Gama, zuniga and LatinAsia\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"My planning thread: <a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/79425-wafflesmom-moon-palace-planning-thread-january-23-2016\/\">http:\/\/www.bestdestinationwedding.com\/topic\/79425-wafflesmom-moon-palace-planning-thread-january-23-2016\/<\/a><br><br>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;4;484\/st\/20160123\/e\/Our+Wedding\/dt\/-2\/k\/44c5\/event.png\" alt=\"event.png\"><\/a>","Email":"jerilee.valenzuela@shaw.ca","IpAddress":"24.114.26.77","GroupId":3,"GroupName":"Member","JoinDate":1410102185,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279721.jpg?_r=1441055220","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"Wafflesmom","Id":279721,"Name":"Wafflesmom","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"113.193.27.174","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79424,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ad827050eab21db18c24a6cbc03b8b64","RawContent":"[quote name=\"SUREKHA\" post=\"1901011\" timestamp=\"1437658037\"]\nCaribbean Terrace is closing due to refurbishment works :([\/quote]That&#039;s too bad. I was supposed to attend a wedding there in a few weeks. I guess that I will get a call about venue change soon.","Attachments":[],"Id":1901043,"PostDate":1437682694,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>SUREKHA, on 23 July 2015 - 02:27 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Caribbean Terrace is closing due to refurbishment works <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/sad.png' class='bbc_emoticon' alt=':(' \/><\/p>\n<\/div>\n<\/div><\/div>\n<p>That's too bad. I was supposed to attend a wedding there in a few weeks. I guess that I will get a call about venue change soon.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"weddingjams1@gmail.com","IpAddress":"113.193.27.174","GroupId":39,"GroupName":"Newbie","JoinDate":1437436408,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284049.png?_r=1437433269","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"LeoMax","Id":284049,"Name":"LeoMax","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"31.51.79.245","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79424,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f6390e22b4dda6386a8c12869adb477c","RawContent":"[quote name=\"SUREKHA\" post=\"1901011\" timestamp=\"1437658037\"]\nThis information would be helpful for me too, my wedding is in Ocrober.\nWe have now been moved to the Venado Terrace as the Caribbean Terrace is closing due to refurbishment works :(\nThe lighting is so expensive, we liked the lanterns and string lights but the need to put up structures plus the lights so will work out over budget for me too.\nAny tips or ideas would be much appreciated.\n \nx[\/quote]Just to let you know they don&#039;t need to put up structures for the lanterns as they use the lamp posts which are already there to attach them to.","Attachments":[],"Id":1901074,"PostDate":1437734203,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>SUREKHA, on 23 July 2015 - 02:27 PM, said:<\/p><div class='blockquote'><div class='quote'><p>\nThis information would be helpful for me too, my wedding is in Ocrober.<br>\nWe have now been moved to the Venado Terrace as the Caribbean Terrace is closing due to refurbishment works <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/sad.png' class='bbc_emoticon' alt=':(' \/><br>\nThe lighting is so expensive, we liked the lanterns and string lights but the need to put up structures plus the lights so will work out over budget for me too.<br>\nAny tips or ideas would be much appreciated.<br>\n\u00a0<br>\nx<\/p><\/div><\/div>\nJust to let you know they don't need to put up structures for the lanterns as they use the lamp posts which are already there to attach them to.<a class='resized_img' rel='lightbox[1901074]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-264357-0-70865500-1437730587.jpg\" title=\"image.jpg - Size: 66.66KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-264357-0-70865500-1437730587.jpg\" class='bbc_img linked-image' alt=\"image.jpg\" \/><\/a>\n\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"emilykate.field@hotmail.co.uk","IpAddress":"151.228.109.2","GroupId":39,"GroupName":"Newbie","JoinDate":1358111979,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-264357.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Ems85","Id":264357,"Name":"Ems85","IsOnline":false}}],"Id":"79424","Title":"Moon Palace Terrace Lighting?","LastPostDate":1437734203},"Pages":{"TotalItems":10,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
