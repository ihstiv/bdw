PhotoWidth":150,"PhotoHeight":87,"PhotoType":"custom"},"FormattedName":"MsJillss","Id":273634,"Name":"MsJillss","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"187.185.71.164","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":74806,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"acbd7e1bd751b69e66e56c736b97c358","RawContent":"[quote name=\"MsJillss\" post=\"1839846\" timestamp=\"1395506320\"]\nHi there!\n\nI know this thread was months ago, but I was wondering if anyone found out any information about pricing (food, decor, drinks etc...))\n\nWould love to hear from you!![\/quote]\nFeel free to e-mail me at julia@juliaeskin.com and I can send you contact info for a wedding planner who deals with Huracan Cafe and other venues outside hotels.","Attachments":[],"Id":1839928,"PostDate":1395592402,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>MsJillss, on 22 March 2014 - 08:38 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hi there!<\/p>\n<p>\u00a0<\/p>\n<p>I know this thread was months ago, but I was wondering if anyone found out any information about pricing (food, decor, drinks etc...))<\/p>\n<p>\u00a0<\/p>\n<p>Would love to hear from you!!<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>Feel free to e-mail me at julia@juliaeskin.com and I can send you contact info for a wedding planner who deals with Huracan Cafe and other venues outside hotels.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><strong><span style=\"color:#000080;\"><span style=\"font-size:18px;\"><em><span style=\"font-family:'times new roman', times, serif;\">Creative documentary wedding photographer in Punta Cana!<\/span><\/em><\/span><\/span><\/strong><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.juliaeskin.com'>www.juliaeskin.com<\/a><\/p>\n<p>\u00a0","Email":"julia@juliaeskin.com","IpAddress":"187.153.56.51","GroupId":49,"GroupName":"Insiders","JoinDate":1270582442,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-227096.jpg?_r=1392861573","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Julia Eskin","Id":227096,"Name":"Julia Eskin","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"161.185.157.22","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":74806,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5b586de8cd2e54f225ff2a9f62617722","RawContent":"&lt;p&gt;@[member=\"MsJillss\"] Did you ever get that info?&lt;\/p&gt;","Attachments":[],"Id":1844963,"PostDate":1397761466,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"273634\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/273634-msjillss\/'