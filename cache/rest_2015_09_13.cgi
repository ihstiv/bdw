{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":41,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":4162,"MovedTo":null,"MovedOn":0,"FirstPostId":1575581,"Rating":0,"RatingHits":0,"Starter":{"Id":250721,"Name":"Teemojo","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250721.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"StartDate":1327952492,"LastPoster":{"Id":278273,"Name":"SuchALady777","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":88,"Preview":{"Id":1861360,"PostDate":1405992229,"PostContent":"Good ideas","Author":{"Signature":"","Email":"bseasebey@yahoo.com","IpAddress":"69.117.93.162","GroupId":40,"GroupName":"Jr. Member","JoinDate":1402061968,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"SuchALady777","Id":278273,"Name":"SuchALady777","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":65582,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b89112fee1b2e0831f2ee77828df0b1b","RawContent":"&lt;p&gt; &lt;span style=\"font-size: 10pt;\"&gt;&lt;span style=\"font-family: arial,sans-serif;\"&gt;&lt;span style=\"color: black;\"&gt;Hello everyone, I think I am in sort of a pickle. Can anyone tell me about there booking experience for groups? I have called Carnival several times and each time I get a different story. &lt;strong&gt;1st Story&lt;\/strong&gt;: In order to book the group I had to put a deposit down on the min amount of rooms which is 8 and my total was $2400 and that would only hold the price for 2weeks. &lt;strong&gt;2nd Story&lt;\/strong&gt;: I could put the group on hold by putting a deposit down on my room which was $300 and that would only hold the rooms for 2weeks.&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt;\"&gt;&lt;span style=\"font-family: arial,sans-serif;\"&gt;&lt;span style=\"color: black;\"&gt;Anyone that has done this please tell me how you did it. We sent out emails telling our guests that we were in the final stages of planning our destination wedding and informed them that after they recived the formal invite they would be required to put down a deposit. The next issue is that we are doing the passport invitations and they take 2-3weeks to arrive after you order them . &lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt;\"&gt;&lt;span style=\"font-family: arial,sans-serif;\"&gt;&lt;span style=\"color: black;\"&gt;Someone please help me. My next option is to call a travel agent but all of the ones that I&#039;ve spoken to seem to be intimidated by the amount of knowledge that I have in this area becuase I&#039;m a coordinator by trade. &lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt;\"&gt;&lt;span style=\"font-family: arial,sans-serif;\"&gt;&lt;span style=\"color: black;\"&gt;Hopefully someone has some advice&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 10pt;\"&gt;&lt;span style=\"font-family: arial,sans-serif;\"&gt;&lt;span style=\"color: black;\"&gt;&lt;span alt=\":rolleyes:\" rel=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/rolleyes.gif\"&gt;&lt;img height=\"16\" id=\"yui_3_4_1_2_1327952364464_157\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/rolleyes.gif\" width=\"16\" \/&gt;&lt;\/span&gt;Thanks in advance!&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1575581,"PostDate":1327952492,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial,sans-serif\"><span  style=\"color: black\">Hello everyone, I think I am in sort of a pickle. Can anyone tell me about there booking experience for groups? I have called Carnival several times and each time I get a different story. <strong>1st Story<\/strong>: In order to book the group I had to put a deposit down on the min amount of rooms which is 8 and my total was $2400 and that would only hold the price for 2weeks. <strong>2nd Story<\/strong>: I could put the group on hold by putting a deposit down on my room which was $300 and that would only hold the rooms for 2weeks.<\/span><\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial,sans-serif\"><span  style=\"color: black\">Anyone that has done this please tell me how you did it. We sent out emails telling our guests that we were in the final stages of planning our destination wedding and informed them that after they recived the formal invite they would be required to put down a deposit. The next issue is that we are doing the passport invitations and they take 2-3weeks to arrive after you order them . <\/span><\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial,sans-serif\"><span  style=\"color: black\">Someone please help me. My next option is to call a travel agent but all of the ones that I've spoken to seem to be intimidated by the amount of knowledge that I have in this area becuase I'm a coordinator by trade. <\/span><\/span><\/span><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial,sans-serif\"><span  style=\"color: black\">Hopefully someone has some advice<\/span><\/span><\/span><\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial,sans-serif\"><span  style=\"color: black\"><span alt=\":rolleyes:\" rel=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/rolleyes.gif\"><span rel='lightbox'><img class='bbc_img' height=\"16\" id=\"yui_3_4_1_2_1327952364464_157\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/rolleyes.gif\" width=\"16\" \/><\/span><\/span>Thanks in advance!<\/span><\/span><\/span><\/p> <p> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"teemojo@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1327950611,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250721.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Teemojo","Id":250721,"Name":"Teemojo","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":65582,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"650ae16bee39a64323b6bf8234460e7b","RawContent":"&lt;p&gt; Hi Teemojo,&lt;\/p&gt; &lt;p&gt; The second is true. We put down our deposit and other deposits were due two to three weeks after ours. We went with a travel agency from the beginning. It appears to be some kind of unspoken courtesy that the travel agents ask for deposits extensions and they received them.. We received about 4 extensions in total.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; What I would suggest is that you, if you decide to do it by yourself, is to send out an email or letter (save the date) to your guests. Inform them of the dates and payment information, with a due date. When planning the due date, factor inn when you and your FI plan to make your deposit and two weeks after that.. so let&#039;s say you pay to make your deposit on February 28, the guest due date will be March 14, 2012. If you send that information out by February1, 2012 you give them a month and two weeks to get their money together and you are adhering to Carnivals guideline. (still do this if you have a travel agent so people don&#039;t feel pressure by a short turn around)&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; If you need a travel agent who you won&#039;t intimidate, let me know. Mine deals with the cruise stuff on a regular basis, so she knows her stuff.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1575726,"PostDate":1327966182,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hi Teemojo,<\/p> <p> The second is true. We put down our deposit and other deposits were due two to three weeks after ours. We went with a travel agency from the beginning. It appears to be some kind of unspoken courtesy that the travel agents ask for deposits extensions and they received them.. We received about 4 extensions in total.<\/p> <p> \u00a0<\/p> <p> What I would suggest is that you, if you decide to do it by yourself, is to send out an email or letter (save the date) to your guests. Inform them of the dates and payment information, with a due date. When planning the due date, factor inn when you and your FI plan to make your deposit and two weeks after that.. so let's say you pay to make your deposit on February 28, the guest due date will be March 14, 2012. If you send that information out by February1, 2012 you give them a month and two weeks to get their money together and you are adhering to Carnivals guideline. (still do this if you have a travel agent so people don't feel pressure by a short turn around)<\/p> <p> \u00a0<\/p> <p> If you need a travel agent who you won't intimidate, let me know. Mine deals with the cruise stuff on a regular basis, so she knows her stuff.\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kateyesis@yahoo.com","IpAddress":"","GroupId":47,"GroupName":"Site Supporter","JoinDate":1312169137,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-243058.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":250,"PhotoType":"custom"},"FormattedName":"kks2012","Id":243058,"Name":"kks2012","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":65582,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c916e822d2e0a839705d04b900c0973e","RawContent":"&lt;p&gt; Thanks so much. I met a TA at a bridal expo over the weekend. She seems to be easy to work with but we&#039;ll see. I gave her my cruise options and asked her what type of pricing, etc she could get. One thing I didnt anticipate was her asking for the passport information for the group. Hopefully she can hold the minimum (8cabins) without that information.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1576196,"PostDate":1328035355,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Thanks so much. I met a TA at a bridal expo over the weekend. She seems to be easy to work with but we'll see. I gave her my cruise options and asked her what type of pricing, etc she could get. One thing I didnt anticipate was her asking for the passport information for the group. Hopefully she can hold the minimum (8cabins) without that information.<\/p> <p> \u00a0<\/p> <p> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"teemojo@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1327950611,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250721.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Teemojo","Id":250721,"Name":"Teemojo","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":65582,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"315408b84e44b463fe71f76c22b023d0","RawContent":"&lt;p&gt; Hi Ladies!&amp;nbsp; I used a TA myself.&amp;nbsp; I actually started this process last year.&amp;nbsp; Our guests were able to put down a non refundable deposit of $25.00 per person and have the remaining balance due on March 1st of this year.&amp;nbsp; Of course there are a lot of people who have NOT made any interim payments since the initial deposit and then there are some who have paid the full deposit.&amp;nbsp; March 2nd will certainly allow us to weed out those who were all for the $25.00 in the beginning but have to come to the table with more money now.&amp;nbsp; As of today we have a total of 84 people who are \"supposed\" to be going.&amp;nbsp; We will see how that number changes come next month LOL. Good luck!&lt;\/p&gt;","Attachments":[],"Id":1576497,"PostDate":1328064412,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hi Ladies!\u00a0 I used a TA myself.\u00a0 I actually started this process last year.\u00a0 Our guests were able to put down a non refundable deposit of $25.00 per person and have the remaining balance due on March 1st of this year.\u00a0 Of course there are a lot of people who have NOT made any interim payments since the initial deposit and then there are some who have paid the full deposit.\u00a0 March 2nd will certainly allow us to weed out those who were all for the $25.00 in the beginning but have to come to the table with more money now.\u00a0 As of today we have a total of 84 people who are \"supposed\" to be going.\u00a0 We will see how that number changes come next month LOL. Good luck!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"latishasmith04@gmail.com","IpAddress":"","GroupId":47,"GroupName":"Site Supporter","JoinDate":1298782631,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-237228.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":166,"PhotoType":"custom"},"FormattedName":"luvfordalo","Id":237228,"Name":"luvfordalo","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":65582,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"dad07462e1cc91a2b8831fd4ae426932","RawContent":"&lt;p&gt; Just wanted to update everyone that&#039;s been so helpful. I found a TA and asked her to check out the rates on 2 cruises. She gave me the rates for only one of the cruises which happened to be my second choice plus is was more expensive than expected. I didn&#039;t want my guests to have to pay over $1000 for a few days in the lowest category room.&lt;\/p&gt; &lt;p&gt; Just when I was about to give my TA some more options I called Carnival and spoke to a specialist that suggested I not&amp;nbsp;go through the hassle of a group booking for&amp;nbsp;a minimum amount of rooms. He wayed the pro\/cons&amp;nbsp;of the situation and I decided to let everyone book seperately and link the rooms via pincode\/booking #. The specialist assured&amp;nbsp;me that it was the least expensive way to get all of my&amp;nbsp; \"frugal\" family and friends on&amp;nbsp;my Wedding Cruise.&lt;\/p&gt; &lt;p&gt; Now I have to find a WP in Ocho Rios. &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1577418,"PostDate":1328211656,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Just wanted to update everyone that's been so helpful. I found a TA and asked her to check out the rates on 2 cruises. She gave me the rates for only one of the cruises which happened to be my second choice plus is was more expensive than expected. I didn't want my guests to have to pay over $1000 for a few days in the lowest category room.<\/p> <p> Just when I was about to give my TA some more options I called Carnival and spoke to a specialist that suggested I not\u00a0go through the hassle of a group booking for\u00a0a minimum amount of rooms. He wayed the pro\/cons\u00a0of the situation and I decided to let everyone book seperately and link the rooms via pincode\/booking #. The specialist assured\u00a0me that it was the least expensive way to get all of my\u00a0 \"frugal\" family and friends on\u00a0my Wedding Cruise.<\/p> <p> Now I have to find a WP in Ocho Rios. \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"teemojo@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1327950611,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250721.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Teemojo","Id":250721,"Name":"Teemojo","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":false,"TopicId":65582,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4ce5ba1fd8bcfeb5561ab84e954c2674","RawContent":"&lt;p&gt; WELL,Cruise Dresses varying from informal casual dresses to beaded little black dresses and formal cruise gowns are available. A wide selection of cruise dresses in 2012 collection include styles shown in magazines, worn by celebrities, etc. It is not difficult to find your perfect cruise dress at Dressz.com. Browse fabulous cruise dresses in large quantity online. And choose the best one for you!&lt;\/p&gt; &lt;p&gt; http:\/\/www.dressz.com\/cruise-dresses-c118&lt;\/p&gt;","Attachments":[],"Id":1577691,"PostDate":1328258297,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> WELL,Cruise Dresses varying from informal casual dresses to beaded little black dresses and formal cruise gowns are available. A wide selection of cruise dresses in 2012 collection include styles shown in magazines, worn by celebrities, etc. It is not difficult to find your perfect cruise dress at Dressz.com. Browse fabulous cruise dresses in large quantity online. And choose the best one for you!<\/p> <p> <a href='http:\/\/www.dressz.com\/cruise-dresses-c118' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.dressz.co...se-dresses-c118<\/a><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Martincorinne87@yahoo.com","IpAddress":"","GroupId":5,"GroupName":"Banned","JoinDate":1328257972,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Matinfly","Id":250918,"Name":"Matinfly","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":65582,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b242cf5fc5ec61df6bd41d4525df7d6a","RawContent":"&lt;p&gt; We did the exact same thing. We put the deposit down for our cruise and paid for our reception through the Carnival wedding department. We then sent out Save The Dates to all guests with the cruise information. We are letting everyone book on their own, with who they want, because we didn&#039;t want to have to deal with calling and hunting people down about making payments. When one of our guest books they usually call or e-mail us and then we call Carnival and link the reservations together. Its been hassle free and very easy! So far we have 25 guests booked and our wedding is in December 2012. There are still some guests that plan to attend which is great, because they can book on their own time and with who they want and I don&#039;t have to worry about it. I&#039;d highly suggest going this route.&lt;\/p&gt;","Attachments":[],"Id":1578141,"PostDate":1328374789,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> We did the exact same thing. We put the deposit down for our cruise and paid for our reception through the Carnival wedding department. We then sent out Save The Dates to all guests with the cruise information. We are letting everyone book on their own, with who they want, because we didn't want to have to deal with calling and hunting people down about making payments. When one of our guest books they usually call or e-mail us and then we call Carnival and link the reservations together. Its been hassle free and very easy! So far we have 25 guests booked and our wedding is in December 2012. There are still some guests that plan to attend which is great, because they can book on their own time and with who they want and I don't have to worry about it. I'd highly suggest going this route.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sgipson88@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1324517050,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-248825.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"mrswilson2012","Id":248825,"Name":"mrswilson2012","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":65582,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"28cf92861eef6c7b780223714ae48d52","RawContent":"&lt;p&gt; I&#039;m getting married aboard the Carnival Dream in January 2013 and&amp;nbsp;I booked through a TA, but I have experience booking group cruises for my family and friends. It&#039;s way easier doing it through a TA or letting your guests with whoever they prefer and the link them to group booking. The Agent&amp;nbsp;that I am working with specializes in cruise weddings.&lt;\/p&gt;","Attachments":[],"Id":1580610,"PostDate":1328838353,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I'm getting married aboard the Carnival Dream in January 2013 and\u00a0I booked through a TA, but I have experience booking group cruises for my family and friends. It's way easier doing it through a TA or letting your guests with whoever they prefer and the link them to group booking. The Agent\u00a0that I am working with specializes in cruise weddings.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"amiris1@aol.com","IpAddress":"","GroupId":47,"GroupName":"Site Supporter","JoinDate":1321504421,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-247772.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"Amiris1","Id":247772,"Name":"Amiris1","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":65582,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"22f5c9b2cef5dab1f4f8a1a74be4e71d","RawContent":"&lt;p&gt; Hey Amiris1 we booked our wedding for the dream in feb 2013 so exciting :)&lt;\/p&gt;","Attachments":[],"Id":1582561,"PostDate":1329273447,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hey Amiris1 we booked our wedding for the dream in feb 2013 so exciting <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"amanda.bean08@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1326463955,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-249839.jpeg?_r=0","PhotoWidth":180,"PhotoHeight":198,"PhotoType":"custom"},"FormattedName":"cruisebride13","Id":249839,"Name":"cruisebride13","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":65582,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0e2220864d1b4274812d8aa75da903e5","RawContent":"&lt;p&gt; Have you found a wedding planer in Ocho Rios. I too am lookin to have a wedding there. Which crusie did you decide on . We picked the Carnival Breeze for April 2013&lt;\/p&gt;","Attachments":[],"Id":1587529,"PostDate":1330363214,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Have you found a wedding planer in Ocho Rios. I too am lookin to have a wedding there. Which crusie did you decide on . We picked the Carnival Breeze for April 2013<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tltimmon@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1326853641,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250088.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"FutureMrsDupont","Id":250088,"Name":"FutureMrsDupont","IsOnline":false}}],"Id":"65582","Title":"BOOKING my CRUISE Wedding","LastPostDate":1405992229},"Pages":{"TotalItems":41,"TotalPages":5,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":40},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
