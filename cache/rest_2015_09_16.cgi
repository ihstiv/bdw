{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":217,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":24929,"MovedTo":null,"MovedOn":0,"FirstPostId":1855399,"Rating":0,"RatingHits":0,"Starter":{"Id":258172,"Name":"BrandyMarie1023","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-258172.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"StartDate":1402876819,"LastPoster":{"Id":280700,"Name":"Jariana2010","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":22,"Preview":{"Id":1904437,"PostDate":1441830906,"PostContent":"Wow my apologies on my typo but glad you understood. I'm currently looking at the map of the com...","Author":{"Signature":"","Email":"ariadna.diaz89@hotmail.com","IpAddress":"104.162.168.61","GroupId":39,"GroupName":"Newbie","JoinDate":1413583874,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Jariana2010","Id":280700,"Name":"Jariana2010","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.65.109.157","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77311,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9f900452b8a77297918f8962bc5a4266","RawContent":"Has anyone heard anything about total decor options for 200-250 a table?  A bride on the Facebook group just mentioned doing that and I had heard nothing about it?  It would have been nice to know before I purchased decor stuff to take with me.","Attachments":[],"Id":1903729,"PostDate":1440851691,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Has anyone heard anything about total decor options for 200-250 a table?  A bride on the Facebook group just mentioned doing that and I had heard nothing about it?  It would have been nice to know before I purchased decor stuff to take with me.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"alwalters625@gmail.com","IpAddress":"71.243.246.55","GroupId":39,"GroupName":"Newbie","JoinDate":1405976695,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279112.jpg?_r=1442367586","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"alwalters625","Id":279112,"Name":"alwalters625","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"142.67.2.225","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77311,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b08d922c2aad8941ee6b1a6ba3e6abe2","RawContent":"&lt;p&gt;I am wondering if someone can tell me where exactly the relaxing pool is .. i am looking at the pools, and im wondering if its the one connected to the main pool where the bar is close to the beach??&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thanks :)&lt;\/p&gt;","Attachments":[],"Id":1904112,"PostDate":1441273571,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I am wondering if someone can tell me where exactly the relaxing pool is .. i am looking at the pools, and im wondering if its the one connected to the main pool where the bar is close to the beach??<\/p>\n<p>\u00a0<\/p>\n<p>Thanks <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ton_03@hotmail.com","IpAddress":"142.67.2.225","GroupId":39,"GroupName":"Newbie","JoinDate":1430216976,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282892.jpg?_r=1434622094","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"FutureMrsVanthof","Id":282892,"Name":"FutureMrsVanthof","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"104.162.136.86","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77311,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1e73071330a343524381e60df6442f81","RawContent":"[quote name=\"FutureMrsVanthof\" post=\"1904112\" timestamp=\"1441287971\"]\nI am wondering if someone can tell me where exactly the relaxing pool is .. i am looking at the pools, and im wondering if its the one connected to the main pool where the bar is close to the beach??\n\nThanks :)[\/quote]That pool that your seeing seems to be the most relaxing. When I walked by it, there wasn&#039;t much to going on.\n\nHowever, that pool is part of the preferred. So not everyone can hang out at that pool. You would need to pay the preferred pricing to gain access to that one, and the other pool which has a bar in it, I believe it&#039;s called splash but not 100% sure on the name.\n\nPS - I still have to post my thoughts regarding our wedding. Maybe a little later today when I&#039;m in front of my computer.\n\nSent from my LG-VS980 using Tapatalk","Attachments":[],"Id":1904271,"PostDate":1441607895,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>FutureMrsVanthof, on 03 September 2015 - 09:46 AM, said:<\/p><div class='blockquote'><div class='quote'><p>I am wondering if someone can tell me where exactly the relaxing pool is .. i am looking at the pools, and im wondering if its the one connected to the main pool where the bar is close to the beach??<br><br>\nThanks <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p><\/div><\/div>\nThat pool that your seeing seems to be the most relaxing. When I walked by it, there wasn't much to going on.<br><br>\nHowever, that pool is part of the preferred. So not everyone can hang out at that pool. You would need to pay the preferred pricing to gain access to that one, and the other pool which has a bar in it, I believe it's called splash but not 100% sure on the name.<br><br>\nPS - I still have to post my thoughts regarding our wedding. Maybe a little later today when I'm in front of my computer.<br><br>\nSent from my LG-VS980 using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ariadna.diaz89@hotmail.com","IpAddress":"104.162.168.61","GroupId":39,"GroupName":"Newbie","JoinDate":1413583874,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Jariana2010","Id":280700,"Name":"Jariana2010","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.65.74.207","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77311,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e2c82c4a2b3950be41c50872c6787d1d","RawContent":"&lt;p&gt;For past brides who had their reception at the Garden View Pool, where was your cocktail hour held?&lt;\/p&gt;\n&lt;p&gt;Our ceremony is at the Fountain and our Reception is at the pool... I assume that the cocktail hour will be there also?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thanks!&lt;\/p&gt;","Attachments":[],"Id":1904361,"PostDate":1441748355,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>For past brides who had their reception at the Garden View Pool, where was your cocktail hour held?<\/p>\n<p>Our ceremony is at the Fountain and our Reception is at the pool... I assume that the cocktail hour will be there also?<\/p>\n<p>\u00a0<\/p>\n<p>Thanks!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ashley225@gmail.com","IpAddress":"66.87.117.140","GroupId":39,"GroupName":"Newbie","JoinDate":1426931385,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282492.jpg?_r=1442363862","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"AshleyNYC323","Id":282492,"Name":"AshleyNYC323","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"104.162.136.86","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77311,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"f487cad45e194ed53bd6e0974668bb70","RawContent":"[quote name=\"AshleyNYC323\" post=\"1904361\" timestamp=\"1441762755\"]\nFor past brides who had their reception at the Garden View Pool, where was your cocktail hour held?\nOur ceremony is at the Fountain and our Reception is at the pool... I assume that the cocktail hour will be there also?\n\nThanks![\/quote]If i am not mistaken since the ceremony is at the ceremony the cocktail hour would be right next to it I&#039;m what&#039;s called the garden. \n\nWe selected the fountain as our ceremony location and that&#039;s where the cocktail hour was. It&#039;s literally right next to the fountain. On the grass area.\n\nSent from my LG-VS980 using Tapatalk","Attachments":[],"Id":1904366,"PostDate":1441750156,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>AshleyNYC323, on 08 September 2015 - 09:39 PM, said:<\/p><div class='blockquote'><div class='quote'><p>For past brides who had their reception at the Garden View Pool, where was your cocktail hour held?<br>\nOur ceremony is at the Fountain and our Reception is at the pool... I assume that the cocktail hour will be there also?<br><br>\nThanks!<\/p><\/div><\/div>\nIf i am not mistaken since the ceremony is at the ceremony the cocktail hour would be right next to it I'm what's called the garden. <br><br>\nWe selected the fountain as our ceremony location and that's where the cocktail hour was. It's literally right next to the fountain. On the grass area.<br><br>\nSent from my LG-VS980 using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ariadna.diaz89@hotmail.com","IpAddress":"104.162.168.61","GroupId":39,"GroupName":"Newbie","JoinDate":1413583874,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Jariana2010","Id":280700,"Name":"Jariana2010","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.65.74.207","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77311,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2107f9b29e5a545a947674b4fa4e2376","RawContent":"[quote name=\"Jariana2010\" post=\"1904366\" timestamp=\"1441764556\"]\nIf i am not mistaken since the ceremony is at the ceremony the cocktail hour would be right next to it I&#039;m what&#039;s called the garden.\n\nWe selected the fountain as our ceremony location and that&#039;s where the cocktail hour was. It&#039;s literally right next to the fountain. On the grass area.\n\nSent from my LG-VS980 using Tapatalk[\/quote]thank you!\nSo how far from the garden view pool is that?   Did you have music during your cocktail hour?\nI was hoping to use the same sound system for our reception and our cocktail hour but it sounds like that isn&#039;t an option.","Attachments":[],"Id":1904369,"PostDate":1441750370,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Jariana2010, on 08 September 2015 - 10:09 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>If i am not mistaken since the ceremony is at the ceremony the cocktail hour would be right next to it I'm what's called the garden.<br><br>\nWe selected the fountain as our ceremony location and that's where the cocktail hour was. It's literally right next to the fountain. On the grass area.<br><br>\nSent from my LG-VS980 using Tapatalk<\/p>\n<\/div>\n<\/div><\/div>\n<p>thank you!<\/p>\n<p>So how far from the garden view pool is that? \u00a0 Did you have music during your cocktail hour?<br>\nI was hoping to use the same sound system for our reception and our cocktail hour but it sounds like that isn't an option.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ashley225@gmail.com","IpAddress":"66.87.117.140","GroupId":39,"GroupName":"Newbie","JoinDate":1426931385,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282492.jpg?_r=1442363862","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"AshleyNYC323","Id":282492,"Name":"AshleyNYC323","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"104.162.136.86","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77311,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"50a12ed0bbe72434f0e5f47d80a0e27f","RawContent":"[quote name=\"AshleyNYC323\" post=\"1904369\" timestamp=\"1441764770\"]\nthank you!\nSo how far from the garden view pool is that?   Did you have music during your cocktail hour?\nI was hoping to use the same sound system for our reception and our cocktail hour but it sounds like that isn&#039;t an option.[\/quote]Wow my apologies on my typo but glad you understood.\n\nI&#039;m currently looking at the map of the complex and thinking back, I&#039;m assuming your referring to pool #42 (swim-up pool) and if you are looking at the same map this is a very poor representation of the complex as a whole. \n\nThe garden view rooms are not next to the lobby as the map makes it seem. They have a golf cart service to take guest to and from. So essentially its a little far. Hard to put an exact number as I never walked it. But with the sun beaming down it would seem like a long walk in my personal opinion. Maybe 10-15 min depending on your pace.\n\nWe did not have music during our cocktail hour and we haven&#039;t heard any guest complain. Pretty sure the photo session is the same for everyone and in that case your photo session is during the cocktail hour so you don&#039;t spend it with your guests, at least that&#039;s how it was for us.\n\nSent from my LG-VS980 using Tapatalk","Attachments":[],"Id":1904437,"PostDate":1441830906,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>AshleyNYC323, on 08 September 2015 - 10:12 PM, said:<\/p><div class='blockquote'><div class='quote'><p>thank you!<br>\nSo how far from the garden view pool is that?   Did you have music during your cocktail hour?<br>\nI was hoping to use the same sound system for our reception and our cocktail hour but it sounds like that isn't an option.<\/p><\/div><\/div>\nWow my apologies on my typo but glad you understood.<br><br>\nI'm currently looking at the map of the complex and thinking back, I'm assuming your referring to pool #42 (swim-up pool) and if you are looking at the same map this is a very poor representation of the complex as a whole. <br><br>\nThe garden view rooms are not next to the lobby as the map makes it seem. They have a golf cart service to take guest to and from. So essentially its a little far. Hard to put an exact number as I never walked it. But with the sun beaming down it would seem like a long walk in my personal opinion. Maybe 10-15 min depending on your pace.<br><br>\nWe did not have music during our cocktail hour and we haven't heard any guest complain. Pretty sure the photo session is the same for everyone and in that case your photo session is during the cocktail hour so you don't spend it with your guests, at least that's how it was for us.<br><br>\nSent from my LG-VS980 using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ariadna.diaz89@hotmail.com","IpAddress":"104.162.168.61","GroupId":39,"GroupName":"Newbie","JoinDate":1413583874,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Jariana2010","Id":280700,"Name":"Jariana2010","IsOnline":false}}],"Id":"77311","Title":"Now Larimar - 2015","LastPostDate":1441830906},"Pages":{"TotalItems":217,"TotalPages":22,"CurrentPage":210,"NextPage":-1,"PreviousPage":200,"LastPage":210},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
