1;116\/st\/20080215\/e\/Our+Wedding\/k\/1f03\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...1f03\/event.png<\/a><\/div><\/div>","Email":"tfafara1758@wowway.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1187665753,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207650.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"chicago88","Id":207650,"Name":"chicago88","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":6277,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4d16e102606d0d653f2446cf264607b7","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;chicago88&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Thanks for sharing - very cute idea&#039;s...\n \n I&#039;m not sure what I am going to do yet. I know I already have a ton of stuff to bring with. Hmmm...\n \n Does anyone know if Chandlyn at the ROR has any centerpieces that we can choose from?&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;Yes, but they&#039;re PRICEY!!! They&#039;re all posted in another Jamaica thread (I can&#039;t find them!) I&#039;d look...but on my way into a LONG meeting...","Attachments":[],"Id":135754,"PostDate":1194394412,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>chicago88<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Thanks for sharing - very cute idea's...<br \/> <br \/> I'm not sure what I am going to do yet. I know I already have a ton of stuff to bring with. Hmmm...<br \/> <br \/> Does anyone know if Chandlyn at the ROR has any centerpieces that we can choose from?<\/div> <\/td> <\/tr> <\/table> <\/div>Yes, but they're PRICEY!!! They're all posted in another Jamaica thread (I can't find them!) I'd look...but on my way into a LONG meeting...\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Married April 4, 2008 at the Riu Ocho Rios!<\/span><\/div><\/div>","Email":"hln321@aol.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1174603620,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207275.gif?_r=0","PhotoWidth":100,"PhotoHeight":67,"PhotoType":"custom"},"FormattedName":"Heidi","Id":207275,"Name":"Heidi","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":6277,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"423e39509e9ad1a2a14127c73c1cfdaf","RawContent":"This is so overdue but so many girls asked me who I used for my florist in Cabo and I didn&#039;t have the phone number for them and couldn&#039;t remember the name...I know what kind of bride am I?\n \n Well the other day I was browsing through our wedding pics and time down in Cabo and this is what I cam across a pic that our friend took of us going into the flower shop\n \n Hope this helps some of you out if you are still looking for a florist\n \n &lt;img src=\"http:\/\/i94.photobucket.com\/albums\/l89\/edytalorek\/IMG_0133.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;","Attachments":[],"Id":168090,"PostDate":1200349821,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                This is so overdue but so many girls asked me who I used for my florist in Cabo and I didn't have the phone number for them and couldn't remember the name...I know what kind of bride am I?<br \/> <br \/> Well the other day I was browsing through our wedding pics and time down in Cabo and this is what I cam across a pic that our friend took of us going into the flower shop<br \/> <br \/> Hope this helps some of you out if you are still looking for a florist<br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i94.photobucket.com\/albums\/l89\/edytalorek\/IMG_0133.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i94.photobucket.com\/albums\/l89\/edytalorek\/ZK9T9734.jpg\">http:\/\/i94.photobucket.com\/albums\/l8...k\/ZK9T9734.jpg<\/a><\/div><\/div>","Email":"edytalorek@rogers.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1154329080,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206769.gif?_r=0","PhotoWidth":100,"PhotoHeight":67,"PhotoType":"custom"},"FormattedName":"EDYTA","Id":206769,"Name":"EDYTA","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":6277,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d1b5fa5512302fc7fce9be781e8f49c6","RawContent":"So many great ideas. I have no idea what Beaches offers, so I guess I will inquire about that in a month or 2, when I know better how many guests we&#039;ll actually have.","Attachments":[],"Id":168108,"PostDate":1200351191,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                So many great ideas. I have no idea what Beaches offers, so I guess I will inquire about that in a month or 2, when I know better how many guests we'll actually have.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"carlydorazio@gmail.com","IpAddress":"72.92.56.95","GroupId":46,"GroupName":"VIP Member","JoinDate":1177552500,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207375.jpg?_r=1414982962","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"boscobel","Id":207375,"Name":"boscobel","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":6277,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"92947d9bea8971adacf25c3d8def44b5","RawContent":"This was a great thread!! I love all the ideas &amp;amp; pic&#039;s posted, very helpful!!","Attachments":[],"Id":168114,"PostDate":1200351383,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                This was a great thread!! I love all the ideas & pic's posted, very helpful!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Thomas & I<\/span><\/div><\/div>","Email":"amanda.cameron@sbcglobal.net","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1199747939,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208158.gif?_r=0","PhotoWidth":100,"PhotoHeight":67,"PhotoType":"custom"},"FormattedName":"AMANDA310","Id":208158,"Name":"AMANDA310","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":6277,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e635a778aececb059ed57a8a7c5165e7","RawContent":"Well, still don&#039;t know how many people we will have, but here are some of my inspiration photos. I bought a bunch of these votives...\n &lt;img src=\"http:\/\/i197.photobucket.com\/albums\/aa240\/carlymcmullen\/Table%20Settings\/BOUGHT-bluevotive.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt; &lt;img src=\"http:\/\/i197.photobucket.com\/albums\/aa240\/carlymcmullen\/Table%20Settings\/BOUGHT-orangevotive.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt; &lt;img src=\"http:\/\/i197.photobucket.com\/albums\/aa240\/carlymcmullen\/Table%20Settings\/BOUGHT-pinkvotive.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n LOVE THIS ONE! &lt;img src=\"http:\/\/i197.photobucket.com\/albums\/aa240\/carlymcmullen\/Table%20Settings\/tablesettingwshells.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n &lt;img src=\"http:\/\/i197.photobucket.com\/albums\/aa240\/carlymcmullen\/Table%20Settings\/tablesetting.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n I have a few more, but didn&#039;t want to post too many. I think I saved these photos from people on this site, so thanks!","Attachments":[],"Id":174631,"PostDate":1201052332,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Well, still don't know how many people we will have, but here are some of my inspiration photos. I bought a bunch of these votives...<br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i197.photobucket.com\/albums\/aa240\/carlymcmullen\/Table%20Settings\/BOUGHT-bluevotive.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i197.photobucket.com\/albums\/aa240\/carlymcmullen\/Table%20Settings\/BOUGHT-orangevotive.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i197.photobucket.com\/albums\/aa240\/carlymcmullen\/Table%20Settings\/BOUGHT-pinkvotive.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> LOVE THIS ONE! <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i197.photobucket.com\/albums\/aa240\/carlymcmullen\/Table%20Settings\/tablesettingwshells.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i197.photobucket.com\/albums\/aa240\/carlymcmullen\/Table%20Settings\/tablesetting.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> I have a few more, but didn't want to post too many. I think I saved these photos from people on this site, so thanks!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"carlydorazio@gmail.com","IpAddress":"72.92.56.95","GroupId":46,"GroupName":"VIP Member","JoinDate":1177552500,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207375.jpg?_r=1414982962","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"boscobel","Id":207375,"Name":"boscobel","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":6277,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"334adf3cd3038fb9df439cf860819e61","RawContent":"Our WC says they will provide everything included in the price of the beach reception, and has sent these pics.\n \n I will bring small starfish to sprinkle on the tables ... but since they will provide the candles, etc ... I&#039;ll let them. :-) One less thing to lug.\n \n She says they will string lights as well as have tiki torches around the perimeter, and it sounds lovely to me!\n \n Here are the pics she sent, albeit kind of hard to see any detailing (we&#039;ll probably have them add aqua and\/or coral cloths to the tables) -- and NO tents for ours!!!\n \n &lt;img src=\"http:\/\/i104.photobucket.com\/albums\/m161\/foxytv\/montajeplayadiaJPG.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n &lt;img src=\"http:\/\/i104.photobucket.com\/albums\/m161\/foxytv\/cenabajocarpa013.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n &lt;img src=\"http:\/\/i104.photobucket.com\/albums\/m161\/foxytv\/cenabajocarpa009.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;","Attachments":[],"Id":174754,"PostDate":1201057200,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Our WC says they will provide everything included in the price of the beach reception, and has sent these pics.<br \/> <br \/> I will bring small starfish to sprinkle on the tables ... but since they will provide the candles, etc ... I'll let them. :-) One less thing to lug.<br \/> <br \/> She says they will string lights as well as have tiki torches around the perimeter, and it sounds lovely to me!<br \/> <br \/> Here are the pics she sent, albeit kind of hard to see any detailing (we'll probably have them add aqua and\/or coral cloths to the tables) -- and NO tents for ours!!!<br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i104.photobucket.com\/albums\/m161\/foxytv\/montajeplayadiaJPG.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i104.photobucket.com\/albums\/m161\/foxytv\/cenabajocarpa013.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i104.photobucket.com\/albums\/m161\/foxytv\/cenabajocarpa009.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i104.photobucket.com\/albums\/m161\/foxytv\/Slide1-7.jpg\">http:\/\/i104.photobucket.com\/albums\/m...v\/Slide1-7.jpg<\/a><\/div><\/div>","Email":"scwinetastings@gmail.com","IpAddress":"","GroupId":46,"GroupName":"VIP Member","JoinDate":1177660740,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207379.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"foxytv","Id":207379,"Name":"foxytv","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":6277,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"74f5aa6da8fad61bfd76a7dbfce4c591","RawContent":"Here are osme ideas I&#039;m playing round with for my centerpieces.\n \n \n &amp;lt;a href=&amp;quot;http:\/\/s37.photobucket.com\/albums\/e83\/cuata2pink\/?action=view&amp;amp;current=callallillies2.jpg&amp;quot; target=&amp;quot;_blank&amp;quot;&amp;gt;&amp;lt;img src=&amp;quot;http:\/\/i37.photobucket.com\/albums\/e83\/cuata2pink\/callallillies2.jpg&amp;quot; border=&amp;quot;0&amp;quot; alt=&amp;quot;Photobucket&amp;quot;&amp;gt;&amp;lt;\/a&amp;gt;\n \n \n &amp;lt;a href=&amp;quot;http:\/\/s37.photobucket.com\/albums\/e83\/cuata2pink\/?action=view&amp;amp;current=callalillies5.jpg&amp;quot; target=&amp;quot;_blank&amp;quot;&amp;gt;&amp;lt;img src=&amp;quot;http:\/\/i37.photobucket.com\/albums\/e83\/cuata2pink\/callalillies5.jpg&amp;quot; border=&amp;quot;0&amp;quot; alt=&amp;quot;Photobucket&amp;quot;&amp;gt;&amp;lt;\/a&amp;gt;\n \n \n &amp;lt;a href=&amp;quot;http:\/\/s37.photobucket.com\/albums\/e83\/cuata2pink\/?action=view&amp;amp;current=callaliliies3.jpg&amp;quot; target=&amp;quot;_blank&amp;quot;&amp;gt;&amp;lt;img src=&amp;quot;http:\/\/i37.photobucket.com\/albums\/e83\/cuata2pink\/callaliliies3.jpg&amp;quot; border=&amp;quot;0&amp;quot; alt=&amp;quot;Photobucket&amp;quot;&amp;gt;&amp;lt;\/a&amp;gt;","Attachments":[],"Id":178242,"PostDate":1201423881,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Here are osme ideas I'm playing round with for my centerpieces.<br \/> <br \/> <br \/> <a href=\"http:\/\/s37.photobucket.com\/albums\/e83\/cuata2pink\/?action=view&current=callallillies2.jpg\" target=\"_blank\"><img src=\"http:\/\/i37.photobucket.com\/albums\/e83\/cuata2pink\/callallillies2.jpg\" border=\"0\" alt=\"Photobucket\"><\/a><br \/> <br \/> <br \/> <a href=\"http:\/\/s37.photobucket.com\/albums\/e83\/cuata2pink\/?action=view&current=callalillies5.jpg\" target=\"_blank\"><img src=\"http:\/\/i37.photobucket.com\/albums\/e83\/cuata2pink\/callalillies5.jpg\" border=\"0\" alt=\"Photobucket\"><\/a><br \/> <br \/> <br \/> <a href=\"http:\/\/s37.photobucket.com\/albums\/e83\/cuata2pink\/?action=view&current=callaliliies3.jpg\" target=\"_blank\"><img src=\"http:\/\/i37.photobucket.com\/albums\/e83\/cuata2pink\/callaliliies3.jpg\" border=\"0\" alt=\"Photobucket\"><\/a>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cuata2pink@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1194070799,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207898.gif?_r=0","PhotoWidth":183,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"cuata2pink","Id":207898,"Name":"cuata2pink","IsOnline":false}}],"Pages":{"TotalItems":1357,"TotalPages":136,"CurrentPage":30,"NextPage":40,"PreviousPage":20,"LastPage":1350},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
