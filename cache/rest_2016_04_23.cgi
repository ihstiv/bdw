Photo":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279721.jpg?_r=1454805895","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"Wafflesmom","Id":279721,"Name":"Wafflesmom","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.85.127.174","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79580,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"c91da4d79991f3e614efce59722250a9","RawContent":"@[member=\"deecol\"] Wow you have made some great progress! Love the suit (and thanks to Col for letting you share [emoji4]). Congrats on the workouts. Everyday, including Xmas?!? I&#039;m impressed. \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1908875,"PostDate":1451804490,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"281751\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/281751-deecol\/' title='Member profile'><span itemprop=\"name\">deecol<\/span><\/a> Wow you have made some great progress! Love the suit (and thanks to Col for letting you share [emoji4]). Congrats on the workouts. Everyday, including Xmas?!? I'm impressed. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>- Erin<\/p>\n<p>\u00a0<\/p>\n<p>My planning thread:\u00a0<a data-ipb='n