the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><\/div> <\/td> <\/tr> <\/table> <\/div>Oh I just love your tables, Kate! That looks sensational!!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i104.photobucket.com\/albums\/m161\/foxytv\/Slide1-7.jpg\">http:\/\/i104.photobucket.com\/albums\/m...v\/Slide1-7.jpg<\/a><\/div><\/div>","Email":"scwinetastings@gmail.com","IpAddress":"","GroupId":46,"GroupName":"VIP Member","JoinDate":1177660740,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207379.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"foxytv","Id":207379,"Name":"foxytv","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":6277,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"428a1d1b016df6a14760a2c4562e9ddc","RawContent":"&lt;img src=\"http:\/\/i230.photobucket.com\/albums\/ee11\/newfiebride\/IMG_2016.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n \n I think it looks really cute! Nice and simple. I love the blue&#039;s... is that sea glass or rocks or something? Also where did you get the plates?","Attachments":[],"Id":178524,"PostDate":1201482531,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i230.photobucket.com\/albums\/ee11\/newfiebride\/IMG_2016.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> <br \/> I think it looks really cute! Nice and simple. I love the blue's... is that sea glass or rocks or something? Also where did you get the plates?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bnagan09@yahoo.com","IpAddress":"71.195.38.131","GroupId":42,"GroupName":"Sr. Member","JoinDate":1196758598,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208004.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Bride010101","Id":208004,"Name":"Bride010101","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":6277,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ca9f0875690bd3e37694934a9e18aa79","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;naga0066&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;&lt;img src=\"http:\/\/i230.photobucket.com\/albums\/ee11\/newfiebride\/IMG_2016.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n \n I think it looks really cute! Nice and simple. I love the blue&#039;s... is that sea glass or rocks or something? Also where did you get the plates?&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;\n It&#039;s just blue rocks. And the plates came from a local store that carried weddingstar products.\n &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.weddingstar.com\/us\/7076+Starfish+Glass+Candle+Holders+%2F+Dishes_refine:423;\"&gt;Weddingstar United States: Starfish Glass Candle Holders \/ Dishes&lt;\/a&gt;","Attachments":[],"Id":178533,"PostDate":1201482910,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>naga0066<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\"><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i230.photobucket.com\/albums\/ee11\/newfiebride\/IMG_2016.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> <br \/> I think it looks really cute! Nice and simple. I love the blue's... is that sea glass or rocks or something? Also where did you get the plates?<\/div> <\/td> <\/tr> <\/table> <\/div><br \/> It's just blue rocks. And the plates came from a local store that carried weddingstar products.<br \/> <a href='http:\/\/www.weddingstar.com\/us\/7076+Starfish+Glass+Candle+Holders+%2F+Dishes_refine:423;' class='bbc_url' title='External link' rel='nofollow external'>Weddingstar United States: Starfish Glass Candle Holders \/ Dishes<\/a>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"corinahenstridge@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1189979099,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207745.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"newfiebride","Id":207745,"Name":"newfiebride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":6277,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"75d01865162590268062220c795a2c06","RawContent":"Kate, I love your tablescape! Did you bring your them from home or did you find the vases in Cabo?","Attachments":[],"Id":178538,"PostDate":1201483590,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Kate, I love your tablescape! Did you bring your them from home or did you find the vases in Cabo?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"Photo by <a class='bbc_url' href='http:\/\/www.monicamartinphotography.com\/blog'>www.monicamartinphotography.com\/blog<\/a><br \/>\n<a class='bbc_url' href='http:\/\/bestdestinationwedding.com\/forum\/f128\/amyhs-planning-galore-24132\/index10.html'>Planning Pics!<\/a> <a class='bbc_url' href='http:\/\/bestdestinationwedding.com\/forum\/f77\/amyhs-puerto-vallarta-wedding-more-review-works-25255\/index4.html'>PV and Wedding Review<\/a><strong class='bbc'><a class='bbc_url' href='http:\/\/picasaweb.google.com\/amyhmartin\/ProfessionalWeddingPictures?authkey=w0DgS3ao1sI#'>Pro Pics (1)<\/a>; <a class='bbc_url' href='http:\/\/picasaweb.google.com\/amyhmartin\/ProfessionalWeddingPictures2?authkey=vbG3xUMVk1s#'>Pro Pics (2)<\/a><\/strong> <strong class='bbc'>By Nataly Lemus Photography and Rodolfo Arpia Photography<\/strong> <a class='bbc_url' href='http:\/\/natalylemusphoto.blogspot.com\/2008\/07\/amy-hanssel-married.html'>Teaser Pro Pics from Nataly Lemus Photogaphy<\/a><a class='bbc_url' href='http:\/\/www.arpiaphotoblog.com\/2008\/07\/puerto-vallarta-destination-wedding_3102.html'>Teaser Pro Pics from Rodolfo Arpia Photography<\/a>","Email":"amyhmartin@gmail.com","IpAddress":"98.119.192.139","GroupId":46,"GroupName":"VIP Member","JoinDate":1162175640,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206875.jpg?_r=0","PhotoWidth":200,"PhotoHeight":285,"PhotoType":"custom"},"FormattedName":"amyh","Id":206875,"Name":"amyh","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":6277,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"594b6db9fca11fbcb492731fece1809c","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;amyh&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Kate, I love your tablescape! Did you bring your them from home or did you find the vases in Cabo?&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;Thanks! The vases Maye had made for me in MX. The mold was $18 and each one cost $12. Totally worth it in my opinion. We actually brought one back home with us we liked them so much. \n We brought down the coral, the red votives, and the table numbers and their holders.","Attachments":[],"Id":178635,"PostDate":1201492396,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>amyh<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Kate, I love your tablescape! Did you bring your them from home or did you find the vases in Cabo?<\/div> <\/td> <\/tr> <\/table> <\/div>Thanks! The vases Maye had made for me in MX. The mold was $18 and each one cost $12. Totally worth it in my opinion. We actually brought one back home with us we liked them so much. <br \/> We brought down the coral, the red votives, and the table numbers and their holders.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"katesig@yahoo.com","IpAddress":"98.247.242.206","GroupId":46,"GroupName":"VIP Member","JoinDate":1154937300,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206773.gif?_r=0","PhotoWidth":85,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"-Kate-","Id":206773,"Name":"-Kate-","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":6277,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b67d0114f8e367f11437414d935472e7","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;LALA&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Thanks! The vases Maye had made for me in MX. The mold was $18 and each one cost $12. Totally worth it in my opinion. We actually brought one back home with us we liked them so much. \n We brought down the coral, the red votives, and the table numbers and their holders.&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;I especially love the coral!","Attachments":[],"Id":178656,"PostDate":1201494657,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>LALA<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Thanks! The vases Maye had made for me in MX. The mold was $18 and each one cost $12. Totally worth it in my opinion. We actually brought one back home with us we liked them so much. <br \/> We brought down the coral, the red votives, and the table numbers and their holders.<\/div> <\/td> <\/tr> <\/table> <\/div>I especially love the coral!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i104.photobucket.com\/albums\/m161\/foxytv\/Slide1-7.jpg\">http:\/\/i104.photobucket.com\/albums\/m...v\/Slide1-7.jpg<\/a><\/div><\/div>","Email":"scwinetastings@gmail.com","IpAddress":"","GroupId":46,"GroupName":"VIP Member","JoinDate":1177660740,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207379.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"foxytv","Id":207379,"Name":"foxytv","IsOnline":false}}],"Pages":{"TotalItems":1357,"TotalPages":136,"CurrentPage":40,"NextPage":50,"PreviousPage":30,"LastPage":1350},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
