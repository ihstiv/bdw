00a0<span style=\"color:rgb(240,128,128);\"><a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/jasminandmatt\/'>Jasmin & Matt Photography<\/a><\/span><br><strong>Instagram:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);\"><a data-ipb='nomediaparse' href='https:\/\/www.instagram.com\/jasminandmattphotography\/'>@jasminandmattphotography<\/a><\/span><br><strong>Pinterest:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);\"><a data-ipb='nomediaparse' href='https:\/\/www.pinterest.com\/jasminandmatt'>Jasmin & Matt<\/a><\/span><\/span><\/span><\/p>\n<p><span style=\"font-family:tahoma, geneva, sans-serif;\"><span style=\"font-size:14px;\">Ask us how we can help you plan your perfect wedding day.<\/span><\/span>","Email":"forward@jasminandmatt.com","IpAddress":"187.153.21.84","GroupId":49,"GroupName":"Insiders","JoinDate":1464795939,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-287055.jpg?_r=1464796174","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"JasminMattPhoto","Id":287055,"Name":"JasminMattPhoto","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.171.71.115","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80279,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f47d0ab20bfcbc2a2ad60a93cbd6047c","RawContent":"&lt;p&gt;hi! We are planning for a feb. 2018 wedding. Still no resort and I just talked to a travel agent. Do you mind sharing how you found your local (mexico) travel agent? by the way...it will be one year this december of us being engaged :lol:  \u200b&lt;\/p&gt;","Attachments":[],"Id":1915699,"PostDate":1474336705,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n  