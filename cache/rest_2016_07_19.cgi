\/cdn\/profile\/photo-207924.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"LeXiee","Id":207924,"Name":"LeXiee","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":65,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"dfa197b29730e709e1d02bbd636d7cfe","RawContent":"don&#039;t worry about that... i&#039;m the only one staying at my resort too. there&#039;s still tons here to learn from even in the resort-specific threads.","Attachments":[],"Id":163550,"PostDate":1199811930,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                don't worry about that... i'm the only one staying at my resort too. there's still tons here to learn from even in the resort-specific threads.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"knaioti@gmail.com","IpAddress":"98.221.76.92","GroupId":46,"GroupName":"VIP Member","JoinDate":1188914280,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207699.gif?_r=0","PhotoWidth":100,"PhotoHeight":83,"PhotoType":"custom"},"FormattedName":"katrina","Id":207699,"Name":"katrina","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":65,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d8f753b33f57c22ad6332a097f784b72","RawContent":"My photographers are staying at this resort. It is next door to our DW resort but was more in the price range that she wanted and now she can stay for 5 days instead of 3. They will just have to get day passes to get in to shoot the wedding and for the TTD shoot the following day.\n \n I don&#039;t know much about his resort, but it sounds great!","Attachments":[],"Id":167461,"PostDate":1200261464,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                My photographers are staying at this resort. It is next door to our DW resort but was more in the price range that she wanted and now she can stay for 5 days instead of 3. They will just have to get day passes to get in to shoot the wedding and for the TTD shoot the following day.<br \/> <br \/> I don't know much about his resort, but it sounds great!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i104.photobucket.com\/albums\/m161\/foxytv\/Slide1-7.jpg\">http:\/\/i104.photobucket.com\/albums\/m...v\/Slide1-7.jpg<\/a><\/div><\/div>","Email":"scwinetastings@gmail.com","IpAddress":"","GroupId":46,"GroupName":"VIP Member","JoinDate":1177639140,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207379.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"foxytv","Id":207379,