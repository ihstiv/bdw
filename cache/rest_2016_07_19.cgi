{"Success":true,"Data":[{"Id":24091,"Author":{"Id":287346,"Name":"bellabride2018","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":true},"Date":1468674137,"Content":"Hello @kelly609<br><br>\nCongratulations!!!<br><br>\nI noticed you are planning your wedding at the same resort I am.  I am planning mine for 2018.  I am wondering if you would be able to share the wedding package information with me. <br><br>\nMy fianc\u00e9 and I are paying for this outselves (hence the 2018 date - time to save) and any numbers we can get our hands on are better than nothing.<br><br>\nAll I have heard are wonderful things about the hotel and everyone had amazing times.<br><br>\nAre you at all worried about you and your guests potentially being at risk of the zika virus?<br><br>\nHope to hear from you soon!","PostKey":"37c9e97056f75c28d07c573245c03c88","CanDelete":true,"Attachments":[]}],"Pages":{"TotalItems":1,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":1,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
