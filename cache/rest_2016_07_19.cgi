{"Success":true,"Data":[{"Id":24113,"Author":{"Id":287385,"Name":"TD2018","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"Date":1468895023,"Content":"Hi! I saw you were getting married in 2018, and I was wondering if and how you've gone about your save the dates. I am also getting married in 2018 and doing a type of destination wedding (a cruise) and was looking for some advice and ideas from anyone that's doing something similar! Thanks in advance and congratulations!! ","PostKey":"9acedea351f6f888d654c97eca23b448","CanDelete":false,"Attachments":[]}],"Pages":{"TotalItems":1,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
