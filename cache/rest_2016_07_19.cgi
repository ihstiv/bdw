{"Success":true,"Data":{"OtherParticipants":[],"Messages":[{"Id":24113,"Author":{"Id":287385,"Name":"TD2018","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"Date":1468895023,"Content":"Hi! I saw you were getting married in 2018, and I was wondering if and how you've gone about your save the dates. I am also getting married in 2018 and doing a type of destination wedding (a cruise) and was looking for some advice and ideas from anyone that's doing something similar! Thanks in advance and congratulations!! ","PostKey":"9acedea351f6f888d654c97eca23b448","CanDelete":false,"Attachments":[]},{"Id":24116,"Author":{"Id":287346,"Name":"bellabride2018","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":true},"Date":1468906064,"Content":"Hello TD2018!<br><br>\nCongratulations!!<br>\nFor my save the dates I sent them out last week via email.  I find the save the date is just a heads up to what is coming.  It doesnt have exact information on it.<br>\nMine said \"Pack Your Bags and Save the Date\".<br><br>\nIf your family and friends are like mine, they are all going to want to be there.  Unfortunately if I dropped this on them a year to 10 months before none of them would be able to afford to go.<br><br>\nSo my save the date is more like a start daving your pennies now situation.  <br><br>\nI am also using it to confirm everyones personal information by having them email me and confirm their personal information.  That way when I am ready to send the invites out I am not scrambling for information, and I also will have everything my TA needs.","PostKey":"9f2ef00119ef51b9a92608b17c6f6dc8","CanDelete":true,"Attachments":[]}],"Id":13948,"Subject":"Hi there! ","StartDate":1468895022,"Starter":{"Id":287385,"Name":"TD2018","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"To":{"Id":287346,"Name":"bellabride2018","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png?_r=0","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":true},"Preview":{"Id":24116,"Author":{"Id":287346,"Name":"bellabride2018","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":true},"Date":1468906064,"Content":"Hello TD2018!\nCongratulations!!\nFor my save the dates I sent them out last week via email.  I fin...","PostKey":"9f2ef00119ef51b9a92608b17c6f6dc8","CanDelete":true,"Attachments":[]},"IsRead":true,"IsDeleted":false,"TotalReplies":1,"Notifications":true,"CanReply":true},"Pages":{"TotalItems":2,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":1,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
