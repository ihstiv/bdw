             width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Is anyone else thinking of going with flowers not from Tai Flora? I looked into Jans flowers from Ocho Rios and they are reasonably priced but I havent really heard of anyone using her...thoughts?<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Today I marry my bestfriend, the one I laugh with, the one I love.<\/span><\/div><\/div>","Email":"kfairful@alumni.uoguelph.ca","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1272162450,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-227617.jpg?_r=0","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"katelynn","Id":227617,"Name":"katelynn","IsOnline":false}}],"Pages":{"TotalItems":5564,"TotalPages":557,"CurrentPage":340,"NextPage":350,"PreviousPage":330,"LastPage":5560},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
