nt-size: 12px\">Review<\/span><\/a><\/p> <p> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>~Trisha~<\/p>\n<p>Destination Wedding Photographer & Travel Agent<br><a  class=\"bbc_url\" href=\"http:\/\/www.faberphotography.com\">www.faberphotography.com<\/a>\u00a0-\u00a0My latest destination wedding photos can be found\u00a0<a  class=\"bbc_url\" href=\"http:\/\/faberphotography.com\/destination-wedding\/\">HERE<\/a><br><br><span style=\"font-family:arial, helvetica, sans-serif;color:rgb(0,128,128);\"><strong>Disney Specialist\u00a0<\/strong><\/span><span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\">\u00a0\/ \u00a0<\/span><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/\" title=\"\"><strong>Bride & Groom Fly FREE Promotion<\/strong><\/a><\/p>\n<p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\">\u00a0<br><strong><span style=\"color:rgb(0,128,128);\"><a  class=\"bbc_url\" href=\"http:\/\/wrighttravelagency.com\/inquiry\/\" title=\"External link\">Looking for a travel agent that KNOWS DISNEY?<\/a><\/span><\/strong><span style=\"color:rgb(0,128,128);\">\u00a0 We are an award winning travel agency and you can\u00a0<\/span><strong><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/\" title=\"\"><span style=\"color:rgb(0,128,128);\">read our reviews\u00a0here.<\/span><\/a><\/strong><br>\n\u00a0<br><span style=\"color:rgb(0,128,128);\"><strong>Awards and recognition:\u00a0<\/strong><\/span><br><span style=\"color:rgb(0,128,128);\">Palace Resorts Winner \"Top Travel Agent\", \"Top Homebased Travel Agency\" PRO Platinum Agency (Top Award) \u00a0 | \u00a0<\/span><span style=\"color:rgb(0,128,128);\">AMResorts Master Agent & Top Agency \u00a0| \u00a0<\/span><span style=\"color:rgb(0,128,128);\">Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator |\u00a0<strong><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/68050-karisma-hotels-givc-and-gi-wedding-consultants-wright-travel-agency\/\" title=\"\">Wright Travel & Karisma GIVC Benefits<\/a>\u00a0|\u00a0<\/strong><\/span><span style=\"color:rgb(0,128,128);\">Travel Impressions Best of the Best Globe Winner \u00a0 | \u00a0 <\/span><span style=\"color:rgb(0,128,128);\">Apple Vacations Golden Apple Winner \u00a0<\/span><br><span><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17612\/sml_gallery_206696_17612_13451.png\" alt=\"sml_gallery_206696_17612_13451.png\"><\/span><span><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"><\/span>\u00a0\u00a0 \u00a0<span><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><\/span><br><span style=\"color:rgb(0,128,128);\"><strong><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010\" title=\"\">Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><strong><span style=\"color:rgb(178,34,34);\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a  class=\"bbc_url\" href=\"mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com\" title=\"External link\">ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"trisha@wrighttravelagency.com","IpAddress":"12.24.226.126","GroupId":46,"GroupName":"VIP Member","JoinDate":1171995300,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207201.jpg?_r=1452788764","PhotoWidth":200,"PhotoHeight":296,"PhotoType":"custom"},"FormattedName":"TATrisha","Id":207201,"Name":"TATrisha","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":66415,"EditedBy":"","EditDate":1392117471,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1876d0689683f1e2b4b3455ca6ebd30b","RawContent":"&lt;p&gt;&lt;strong&gt;PHOTOGRAPHERS&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:12px;\"&gt;Onsite Photograhers:&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:12px;\"&gt;As of 2013 - Adventure Photo&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:12px;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;&lt;span&gt;Positive Photo Studio - Fernando&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:12px;\"&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.positiveweddings.com&#039;&gt;&lt;span style=\"font-family:calibri, sans-serif;\"&gt;&lt;span&gt;www.positiveweddings.com&lt;\/span&gt;&lt;\/span&gt;&lt;\/a&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:12px;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.rivieramayaphotography.com\/&#039;&gt;&lt;span style=\"color:#008080;\"&gt;&lt;span&gt;www.rivieramayaphotography.com&lt;\/span&gt;&lt;\/span&gt;&lt;\/a&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:12px;\"&gt;&lt;strong&gt;PHOTOGRAPHY AND VIDEOGRAPHY&lt;\/strong&gt;\n\nOnline Slideshow free with every wedding\n\nIndividual photos (8x6 prints or image cd\/license) $15 ea&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:12px;\"&gt;&lt;strong&gt;Standard Packages&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:12px;\"&gt;Standard Photo Package 1 $699\n\n1 Hour Coverage (Ceremony + Photo Session) + 40 images on CD&lt;\/span&gt;\n\n&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:12px;\"&gt;Standard Photo Package 2 $950\n\n3 Hours Coverage (getting ready, ceremony, photo session, cocktail party) + 60 images on cd&lt;\/span&gt;\n\n&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:12px;\"&gt;Standard Photo Package 3 $1,150\n\nFull 1 Day Coverage (getting ready, ceremony, photo session, cocktail party, reception, cake cutting) + 100 images on CD&lt;\/span&gt;\n\n&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:12px;\"&gt;Standard Photo Package 4 $1,599\n\nComplete Wedding Coverage (rehearsal dinner, spa, getting ready, ceremony, photo session, cocktail party, reception, cake cutting, trash the dress) +200 images&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:12px;\"&gt;Additional Photographer (per hour) $99&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:12px;\"&gt;Luxury Wedding Book\n\n30 layouts 30 pages up to 60 images $699\n\n40 layouts 40 pages up to 80 images $999\n\n60 layouts 60 pages up to 100 images $1,199&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:12px;\"&gt;Fine art canvas prints\n\n16x24 fine art canvas print $129\n\n20x30 fine art canvas print $169\n\n24x36 fine art canvas print $199&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:12px;\"&gt;&lt;strong&gt;Complete Wedding Collection&lt;\/strong&gt;\n\n300 images + Luxury Wedding Book with 15 Layouts (40 pages) $1,999&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:12px;\"&gt;300 high resolution images on disk, online slideshow, online gallery, vision art book with 15 layouts (30 pages) &amp;amp; 16x24 fine art canvas print $2,195&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:12px;\"&gt;All your high resolution wedding images on disk, online slideshow, online gallery vision art book with 20 layouts (40 pages) &amp;amp; 16x24 fine art canvas print $2,950&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:12px;\"&gt;Video Package #1 $590\n\n\u2022 Ceremony. Video studio by the beach. Includes digital &amp;amp; special effects, addition, music &amp;amp; titles.\n\n\u2022 Full digital edition. Professional digital camera.\n\n\u2022 90 to 120 min. of service. 30 to 40 minutes edited video. &lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:12px;\"&gt;&lt;span style=\"font-size:12px;\"&gt;\u2022 &lt;\/span&gt;Master DVD with interactive menus.&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:12px;\"&gt;Video Package #2 $1,000\n\n\u2022 Ceremony. Video studio by the beach. Includes digital &amp;amp; special effects, addition, music &amp;amp; titles.\n\n\u2022 Full digital edition. 1 professional digital camera.\n\n\u2022 3 to 4 hours of service. 60 minutes edited video. Master\n&lt;span style=\"font-size:12px;\"&gt;\u2022 &lt;\/span&gt;DVD with interactive menus.&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:12px;\"&gt;Video Package #3 $1,620&lt;\/span&gt;\n&lt;span style=\"font-size:12px;\"&gt;\u2022 Ceremony. Video studio by the beach. Includes digital &amp;amp; special effects, addition, music &amp;amp; titles\n\n\u2022 Full digital edition. 1 professional digital camera.\n\n\u2022 8 hours of service. 90 to 120 minutes edited video.\n\n\u2022 Master DVD with interactive menus.&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:12px;\"&gt;Video Package #4 $2,100\n\n\u2022 Ceremony. Video studio by the beach. Includes digital &amp;amp; special effects, addition, music &amp;amp; titles.\n\n\u2022 Full digital edition. 1 professional digital camera.\n\n\u2022 6 hours of service. 90 to 120 minutes edited video.\n\n\u2022 Master DVD with interactive menus.&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:12px;\"&gt;Additional copy of DVD $80\n\nAdditional Hour of Photo Services $280\n\nAdditional Hour of Video Service $280&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:12px;\"&gt;&lt;strong&gt;PHOTOBOOTH&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:12px;\"&gt;Silver $649&lt;\/span&gt;&lt;\/p&gt;\n&lt;ul&gt;&lt;li&gt;&lt;span style=\"font-size:12px;\"&gt;Includes 3 hours of service, photo booth attendee, 100 4x6 prints, party props, DVD of all photos and videos professionally edited, set-up and break-down.&lt;\/span&gt;&lt;\/li&gt;\n&lt;\/ul&gt;&lt;p style=\"margin-left:2.25pt;\"&gt;&lt;span style=\"font-size:12px;\"&gt;Gold $799&lt;\/span&gt;&lt;\/p&gt;\n&lt;ul&gt;&lt;li&gt;&lt;span style=\"font-size:12px;\"&gt;Includes 4 hours of service, photo booth attendee, 215 4x6 prints, party props, DVD of all photos and videos professionally edited, set-up and break-down&lt;\/span&gt;&lt;\/li&gt;\n&lt;\/ul&gt;&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:12px;\"&gt;Trash the Dress session - $950&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:12px;\"&gt;$1500 for the disc of all images&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;em&gt;&lt;span style=\"font-size:12px;\"&gt;\u00e2\u20ac\u0153I know you are supposed to get an album with 30 photos but it sort of felt like they tried to trick us when we went to look at them. He told us to go through and select all of our favorites. So we did. All 180 of them. After that he told us to narrow it down to 24 they would make into an album or choose 30 they would put on a dvd. If we wanted more than that it would be $15 per picture. I just wish he&#039;d been specific from the beginning. They did offer us all the pictures for $250 after that, which is not so bad a deal.\u00e2\u20ac&lt;\/span&gt;&lt;\/em&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:12px;\"&gt;If you hire an offsite, but local photographer, it\u00e2\u20ac\u2122s a $65 day pass&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:12px;\"&gt;If your photographer is staying at the resort for three days, there is not a problem.&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;strong&gt;VIDEOGRAPHER&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:10pt;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;Videographer - &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.oscarvideo.com.mx&#039;&gt;www.oscarvideo.com.mx&lt;\/a&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:10pt;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;&lt;span&gt;Miguel Angel Nunez and his email is&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&amp;nbsp;&lt;span style=\"font-size:10pt;\"&gt;&lt;span style=\"color:#0000FF;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;mailto:oscarvideos@prodigy.net.mx&#039;&gt;&lt;span style=\"color:#0000FF;\"&gt;&lt;span&gt;oscarvideos@prodigy.net.mx&lt;\/span&gt;&lt;\/span&gt;&lt;\/a&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;em&gt;&lt;span style=\"font-size:12px;\"&gt;\u00e2\u20ac\u0153The videographer shows up about 20minutes pre ceremony and starts filming the arrival of people, does the ceremony for about 30 minutes and a bit more just after the ceremony so about an hour of filming and then they edit a 30minute dvd for you. She said I would get total three hours for not taking the photographer from the resort. She also said you can split up the time so if you want the ceremony, not the cocktail hour or dinner but you want the dance they can ask them to wait.\u00e2\u20ac&lt;\/span&gt;&lt;\/em&gt;&lt;\/p&gt;","Attachments":[],"Id":1595162,"PostDate":1331759411,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><strong>PHOTOGRAPHERS<\/strong><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-size:12px\">Onsite Photograhers:<\/span><\/p>\n<p><span  style=\"font-size:12px\">As of 2013 - Adventure Photo<\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-size:12px\"><span  style=\"font-family:arial, sans-serif\"><span>Positive Photo Studio - Fernando<\/span><\/span><\/span><\/p>\n<p><span  style=\"font-size:12px\"><a href='http:\/\/www.positiveweddings.com' class='bbc_url' title='External link' rel='nofollow external'><span  style=\"font-family:calibri, sans-serif\"><span>www.positiveweddings.com<\/span><\/span><\/a><\/span><\/p>\n<p><span  style=\"font-size:12px\"><span  style=\"font-family:arial, sans-serif\"><a href='http:\/\/www.rivieramayaphotography.com\/' class='bbc_url' title='External link' rel='nofollow external'><span  style=\"color:#008080\"><span>www.rivieramayaphotography.com<\/span><\/span><\/a><\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-size:12px\"><strong>PHOTOGRAPHY AND VIDEOGRAPHY<\/strong><br>\nOnline Slideshow free with every wedding<br>\nIndividual photos (8x6 prints or image cd\/license) $15 ea<\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-size:12px\"><strong>Standard Packages<\/strong><\/span><\/p>\n<p><span  style=\"font-size:12px\">Standard Photo Package 1 $699<br>\n1 Hour Coverage (Ceremony + Photo Session) + 40 images on CD<\/span><br>\n\u00a0<\/p>\n<p><span  style=\"font-size:12px\">Standard Photo Package 2 $950<br>\n3 Hours Coverage (getting ready, ceremony, photo session, cocktail party) + 60 images on cd<\/span><br>\n\u00a0<\/p>\n<p><span  style=\"font-size:12px\">Standard Photo Package 3 $1,150<br>\nFull 1 Day Coverage (getting ready, ceremony, photo session, cocktail party, reception, cake cutting) + 100 images on CD<\/span><br>\n\u00a0<\/p>\n<p><span  style=\"font-size:12px\">Standard Photo Package 4 $1,599<br>\nComplete Wedding Coverage (rehearsal dinner, spa, getting ready, ceremony, photo session, cocktail party, reception, cake cutting, trash the dress) +200 images<\/span><\/p>\n<p><span  style=\"font-size:12px\">Additional Photographer (per hour) $99<\/span><\/p>\n<p><span  style=\"font-size:12px\">Luxury Wedding Book<br>\n30 layouts 30 pages up to 60 images $699<br>\n40 layouts 40 pages up to 80 images $999<br>\n60 layouts 60 pages up to 100 images $1,199<\/span><\/p>\n<p><span  style=\"font-size:12px\">Fine art canvas prints<br>\n16x24 fine art canvas print $129<br>\n20x30 fine art canvas print $169<br>\n24x36 fine art canvas print $199<\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-size:12px\"><strong>Complete Wedding Collection<\/strong><br>\n300 images + Luxury Wedding Book with 15 Layouts (40 pages) $1,999<\/span><\/p>\n<p><span  style=\"font-size:12px\">300 high resolution images on disk, online slideshow, online gallery, vision art book with 15 layouts (30 pages) & 16x24 fine art canvas print $2,195<\/span><\/p>\n<p><span  style=\"font-size:12px\">All your high resolution wedding images on disk, online slideshow, online gallery vision art book with 20 layouts (40 pages) & 16x24 fine art canvas print $2,950<\/span><\/p>\n<p><span  style=\"font-size:12px\">Video Package #1 $590<br>\n\u2022 Ceremony. Video studio by the beach. Includes digital & special effects, addition, music & titles.<br>\n\u2022 Full digital edition. Professional digital camera.<br>\n\u2022 90 to 120 min. of service. 30 to 40 minutes edited video. <\/span><\/p>\n<p><span  style=\"font-size:12px\"><span  style=\"font-size:12px\">\u2022 <\/span>Master DVD with interactive menus.<\/span><\/p>\n<p><span  style=\"font-size:12px\">Video Package #2 $1,000<br>\n\u2022 Ceremony. Video studio by the beach. Includes digital & special effects, addition, music & titles.<br>\n\u2022 Full digital edition. 1 professional digital camera.<br>\n\u2022 3 to 4 hours of service. 60 minutes edited video. Master<br><span  style=\"font-size:12px\">\u2022 <\/span>DVD with interactive menus.<\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-size:12px\">Video Package #3 $1,620<\/span><br><span  style=\"font-size:12px\">\u2022 Ceremony. Video studio by the beach. Includes digital & special effects, addition, music & titles<br>\n\u2022 Full digital edition. 1 professional digital camera.<br>\n\u2022 8 hours of service. 90 to 120 minutes edited video.<br>\n\u2022 Master DVD with interactive menus.<\/span><\/p>\n<p><span  style=\"font-size:12px\">Video Package #4 $2,100<br>\n\u2022 Ceremony. Video studio by the beach. Includes digital & special effects, addition, music & titles.<br>\n\u2022 Full digital edition. 1 professional digital camera.<br>\n\u2022 6 hours of service. 90 to 120 minutes edited video.<br>\n\u2022 Master DVD with interactive menus.<\/span><\/p>\n<p><span  style=\"font-size:12px\">Additional copy of DVD $80<br>\nAdditional Hour of Photo Services $280<br>\nAdditional Hour of Video Service $280<\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-size:12px\"><strong>PHOTOBOOTH<\/strong><\/span><\/p>\n<p><span  style=\"font-size:12px\">Silver $649<\/span><\/p>\n<ul><li><span  style=\"font-size:12px\">Includes 3 hours of service, photo booth attendee, 100 4x6 prints, party props, DVD of all photos and videos professionally edited, set-up and break-down.<\/span><\/li>\n<\/ul><p  style=\"margin-left:2.25pt\"><span  style=\"font-size:12px\">Gold $799<\/span><\/p>\n<ul><li><span  style=\"font-size:12px\">Includes 4 hours of service, photo booth attendee, 215 4x6 prints, party props, DVD of all photos and videos professionally edited, set-up and break-down<\/span><\/li>\n<\/ul><p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-size:12px\">Trash the Dress session - $950<\/span><\/p>\n<p><span  style=\"font-size:12px\">$1500 for the disc of all images<\/span><\/p>\n<p>\u00a0<\/p>\n<p><em><span  style=\"font-size:12px\">\u00e2\u20ac\u0153I know you are supposed to get an album with 30 photos but it sort of felt like they tried to trick us when we went to look at them. He told us to go through and select all of our favorites. So we did. All 180 of them. After that he told us to narrow it down to 24 they would make into an album or choose 30 they would put on a dvd. If we wanted more than that it would be $15 per picture. I just wish he'd been specific from the beginning. They did offer us all the pictures for $250 after that, which is not so bad a deal.\u00e2\u20ac<\/span><\/em><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-size:12px\">If you hire an offsite, but local photographer, it\u00e2\u20ac\u2122s a $65 day pass<\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-size:12px\">If your photographer is staying at the resort for three days, there is not a problem.<\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-size:14px\"><strong>VIDEOGRAPHER<\/strong><\/span><\/p>\n<p><span  style=\"font-size:10pt\"><span  style=\"font-family:arial, sans-serif\">Videographer - <a href='http:\/\/www.oscarvideo.com.mx' class='bbc_url' title='External link' rel='nofollow external'>www.oscarvideo.com.mx<\/a><\/span><\/span><\/p>\n<p><span  style=\"font-size:10pt\"><span  style=\"font-family:arial, sans-serif\"><span>Miguel Angel Nunez and his email is<\/span><\/span><\/span>\u00a0<span  style=\"font-size:10pt\"><span  style=\"color:#0000FF\"><span  style=\"font-family:arial, sans-serif\"><a href='mailto:oscarvideos@prodigy.net.mx' class='bbc_url' title='External link' rel='nofollow external'><span  style=\"color:#0000FF\"><span>oscarvideos@prodigy.net.mx<\/span><\/span><\/a><\/span><\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p><em><span  style=\"font-size:12px\">\u00e2\u20ac\u0153The videographer shows up about 20minutes pre ceremony and starts filming the arrival of people, does the ceremony for about 30 minutes and a bit more just after the ceremony so about an hour of filming and then they edit a 30minute dvd for you. She said I would get total three hours for not taking the photographer from the resort. She also said you can split up the time so if you want the ceremony, not the cocktail hour or dinner but you want the dance they can ask them to wait.\u00e2\u20ac<\/span><\/em><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>~Trisha~<\/p>\n<p>Destination Wedding Photographer & Travel Agent<br><a  class=\"bbc_url\" href=\"http:\/\/www.faberphotography.com\">www.faberphotography.com<\/a>\u00a0-\u00a0My latest destination wedding photos can be found\u00a0<a  class=\"bbc_url\" href=\"http:\/\/faberphotography.com\/destination-wedding\/\">HERE<\/a><br><br><span style=\"font-family:arial, helvetica, sans-serif;color:rgb(0,128,128);\"><strong>Disney Specialist\u00a0<\/strong><\/span><span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\">\u00a0\/ \u00a0<\/span><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/\" title=\"\"><strong>Bride & Groom Fly FREE Promotion<\/strong><\/a><\/p>\n<p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\">\u00a0<br><strong><span style=\"color:rgb(0,128,128);\"><a  class=\"bbc_url\" href=\"http:\/\/wrighttravelagency.com\/inquiry\/\" title=\"External link\">Looking for a travel agent that KNOWS DISNEY?<\/a><\/span><\/strong><span style=\"color:rgb(0,128,128);\">\u00a0 We are an award winning travel agency and you can\u00a0<\/span><strong><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/\" title=\"\"><span style=\"color:rgb(0,128,128);\">read our reviews\u00a0here.<\/span><\/a><\/strong><br>\n\u00a0<br><span style=\"color:rgb(0,128,128);\"><strong>Awards and recognition:\u00a0<\/strong><\/span><br><span style=\"color:rgb(0,128,128);\">Palace Resorts Winner \"Top Travel Agent\", \"Top Homebased Travel Agency\" PRO Platinum Agency (Top Award) \u00a0 | \u00a0<\/span><span style=\"color:rgb(0,128,128);\">AMResorts Master Agent & Top Agency \u00a0| \u00a0<\/span><span style=\"color:rgb(0,128,128);\">Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator |\u00a0<strong><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/68050-karisma-hotels-givc-and-gi-wedding-consultants-wright-travel-agency\/\" title=\"\">Wright Travel & Karisma GIVC Benefits<\/a>\u00a0|\u00a0<\/strong><\/span><span style=\"color:rgb(0,128,128);\">Travel Impressions Best of the Best Globe Winner \u00a0 | \u00a0 <\/span><span style=\"color:rgb(0,128,128);\">Apple Vacations Golden Apple Winner \u00a0<\/span><br><span><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17612\/sml_gallery_206696_17612_13451.png\" alt=\"sml_gallery_206696_17612_13451.png\"><\/span><span><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"><\/span>\u00a0\u00a0 \u00a0<span><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><\/span><br><span style=\"color:rgb(0,128,128);\"><strong><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010\" title=\"\">Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><strong><span style=\"color:rgb(178,34,34);\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a  class=\"bbc_url\" href=\"mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com\" title=\"External link\">ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"trisha@wrighttravelagency.com","IpAddress":"12.24.226.126","GroupId":46,"GroupName":"VIP Member","JoinDate":1171995300,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207201.jpg?_r=1452788764","PhotoWidth":200,"PhotoHeight":296,"PhotoType":"custom"},"FormattedName":"TATrisha","Id":207201,"Name":"TATrisha","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":66415,"EditedBy":"","EditDate":1393005067,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bd599417ccd968b46d4d5bad676d3a9a","RawContent":"&lt;p&gt;&lt;strong&gt;Wedding Reviews&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/t\/57821\/the-now-riviera-cancun\/960#post_1482202&#039;&gt;October 2010 Wedding&lt;\/a&gt;, Devine Wedding Package,&amp;nbsp;Pergola Wedding Ceremony, Blue Bar Cocktail Hour, Bamboo Room Reception&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/t\/57821\/the-now-riviera-cancun\/1040#post_1494362&#039;&gt;November 2010 Wedding&lt;\/a&gt;, Pergola Wedding Ceremony, Blue Bar Cocktail Hour, Bamboo Room Reception&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/products\/now-riviera-cancun-resort-spa-all-inclusive\/reviews\/4103&#039;&gt;November 2010 Wedding&lt;\/a&gt;, Pergola Wedding Ceremony, Blue Bar Cocktail Hour, Castaways Restaurant&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/products\/now-riviera-cancun-resort-spa-all-inclusive\/reviews\/4063&#039;&gt;December 2010 Wedding&lt;\/a&gt;, Pergola Wedding Ceremony, Blue Bar Cocktail Hour, Festival Terrace&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/t\/57821\/the-now-riviera-cancun\/1190#post_1515417&#039;&gt;January 2011 Wedding&lt;\/a&gt;, Eternity Wedding Package, Pergola Wedding Ceremony, Blue Bar Cocktail Hour&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/products\/now-riviera-cancun-resort-spa-all-inclusive\/reviews\/4530&#039;&gt;February 2011 Wedding&lt;\/a&gt;, Fountain Wedding Ceremony, Mercure Cocktail Hour and Reception&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/t\/57821\/the-now-riviera-cancun\/1470#post_1556771&#039;&gt;March 2011 Wedding&lt;\/a&gt;, Devine Wedding Package, Pergola Wedding Ceremony, Blue Bar Cocktail Hour, Castaways Restaurant&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/t\/57821\/the-now-riviera-cancun\/1570#post_1574148&#039;&gt;March 2011 Wedding&lt;\/a&gt;, Pergola Wedding Ceremony, Castaways Restaurant&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/products\/now-riviera-cancun-resort-spa-all-inclusive\/reviews\/4439&#039;&gt;April 2011 Wedding&lt;\/a&gt;, Devine Wedding Package, Beach Ceremony, Bamboo Room Reception&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/products\/now-riviera-cancun-resort-spa-all-inclusive\/reviews\/4453&#039;&gt;April 2011 Wedding&lt;\/a&gt;, Eternity Wedding Package, Pergola Wedding Ceremony, Blue Bar Cocktail Hour, Castaways Restaurant&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/products\/now-riviera-cancun-resort-spa-all-inclusive\/reviews\/4708&#039;&gt;June 2011 Wedding&lt;\/a&gt;, Beach Ceremony, Castaways Reception&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/t\/57821\/the-now-riviera-cancun\/1780#post_1620859&#039;&gt;June 2011 Wedding&lt;\/a&gt;, Beach Ceremony, Blue Bar Cocktail Hour, Castaways&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/products\/now-riviera-cancun-resort-spa-all-inclusive\/reviews\/4871&#039;&gt;July 2011 Wedding&lt;\/a&gt;, Pergola Wedding Ceremony, Blue Bar Cocktail Hour, Bamboo Room Reception&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/products\/now-riviera-cancun-resort-spa-all-inclusive\/reviews\/4971&#039;&gt;August 2011 Wedding&lt;\/a&gt;, Beach Ceremony, Bamboo Room Reception&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/t\/57821\/the-now-riviera-cancun\/1870#post_1656240&#039;&gt;August 2011 Wedding&lt;\/a&gt; - Just a quick review&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/t\/57821\/the-now-riviera-cancun\/1870#post_1657077&#039;&gt;August 2011 Wedding&lt;\/a&gt;, Beach Ceremony, Blue Bar Cocktail Hour, Bamboo Room Reception&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/products\/now-riviera-cancun-resort-spa-all-inclusive\/reviews\/5000&#039;&gt;August 2011 Wedding&lt;\/a&gt;, Devine Wedding Package, Beach Ceremony, Blue Bar Cocktail Hour, Castaways&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/products\/no