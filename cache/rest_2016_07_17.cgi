{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.75.51.111","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79819,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"d81edcb305fd93c558b9800dbbda69f6","RawContent":"&lt;p&gt;&lt;span style=\"font-family:&#039;comic sans ms&#039;, cursive;\"&gt;I&#039;m getting married at Jewel Dunn&#039;s River on 11\/5\/16 in Ocho Rios. We have the Ruby package and chose the sunset ceremony. Jewel Resorts&#039; website lists the documents that you need, which you upload online.&amp;nbsp;&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1909990,"PostDate":1453696971,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span  style=\"font-family:'comic sans ms', cursive;\">I'm getting married at Jewel Dunn's River on 11\/5\/16 in Ocho Rios. We have the Ruby package and chose the sunset ceremony. Jewel Resorts' website lists the documents that you need, which you upload online.\u00a0<\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"prewi007@gmail.com","IpAddress":"108.75.51.111","GroupId":39,"GroupName":"Newbie","JoinDate":1453693775,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286026.jpg?_r=1453692198","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"TShavonne","Id":286026,"Name":"TShavonne","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"152.120.130.110","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79819,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"57e7ec9b1807008c8519bb375c00e3b8","RawContent":"[quote name=\"Lisa35\" post=\"1909073\" timestamp=\"1452110881\"]\n@[member=\"kristendelpin\"] - we are getting married May 2016 at the Royalton White Sands.[\/quote]\n[color=#0000cd]Hello, can you please advise of your wedding experience details at RWS. I am scheduled to get married in November. CONGRATS!!! :)[\/color]","Attachments":[],"Id":1913324,"PostDate":1462396628,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Lisa35, on 06 January 2016 - 09:08 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"285703\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/285703-kristendelpin\/' title='Member profile'><span itemprop=\"name\">kristendelpin<\/span><\/a> - we are getting married May 2016 at the Royalton White Sands.<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p><span  style=\"color:#0000cd\">Hello, can you please advise of your wedding experience details at RWS. I am scheduled to get married in November. CONGRATS!!! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jnailaj@hotmail.com","IpAddress":"152.120.130.110","GroupId":39,"GroupName":"Newbie","JoinDate":1462303765,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286867.jpg?_r=1463598317","PhotoWidth":200,"PhotoHeight":199,"PhotoType":"facebook"},"FormattedName":"Jnj","Id":286867,"Name":"Jnj","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.15.166.172","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79819,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"07c6f97a09831f8c0b14f97f35e422ea","RawContent":"&lt;p&gt;What do you want to know?&lt;\/p&gt;","Attachments":[],"Id":1913901,"PostDate":1463763868,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>What do you want to know?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>The Future Mrs. Rodrigues","Email":"lisapereira11@hotmail.com","IpAddress":"74.15.166.172","GroupId":39,"GroupName":"Newbie","JoinDate":1426176386,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282406.jpg?_r=1426179017","PhotoWidth":177,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Lisa35","Id":282406,"Name":"Lisa35","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.212.143.91","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79819,"EditedBy":"","EditDate":1465943589,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"083e119e16da5e19052e4fe958a6697d","RawContent":"Hi @[member=\"LindsayHoward\"],\n\nthe jewels is a beautiful resort. I loved the time I spent there. The only reason I am not staying there is because they booked up early for next May. I cant say much for the weddings there, but staying there as a guest was a wonderful experience.\n\nWe are getting married in Canada first and then doing a symbolic wedding in Jamaica. All I need to show is my marriage certificate. There is a bit of paper work needed; but first make sure that a jamaican marriage is recognized in your country.\n[quote name=\"LindsayHoward\" post=\"1909162\" timestamp=\"1452282074\"]\nLove to see all the resort recommendations because I am also looking into getting married in Jamaica in Oct 2016. Right now leaning towards The Jewel Resort at dunns river. Any thoughts would be appriciated!\n\nAlso, was wondering about the legalities. A lot of the resorts there only do \"symbolic ceremonies\" and I want it to be 100% legal. What documents do I need to bring?[\/quote]","Attachments":[],"Id":1914393,"PostDate":1465943370,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi @<a hovercard-ref=\"member\" hovercard-id=\"285798\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/285798-lindsayhoward\/' title='Member profile'><span itemprop=\"name\">LindsayHoward<\/span><\/a>,<\/p>\n<p>\u00a0<\/p>\n<p>the jewels is a beautiful resort. I loved the time I spent there. The only reason I am not staying there is because they booked up early for next May. I cant say much for the weddings there, but staying there as a guest was a wonderful experience.<\/p>\n<p>\u00a0<\/p>\n<p>We are getting married in Canada first and then doing a symbolic wedding in Jamaica. All I need to show is my marriage certificate. There is a bit of paper work needed; but first make sure that a jamaican marriage is recognized in your country.<\/p>\n<p>\u00a0<\/p>\n<p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>LindsayHoward, on 08 January 2016 - 08:41 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Love to see all the resort recommendations because I am also looking into getting married in Jamaica in Oct 2016. Right now leaning towards The Jewel Resort at dunns river. Any thoughts would be appriciated!<br><br>\nAlso, was wondering about the legalities. A lot of the resorts there only do \"symbolic ceremonies\" and I want it to be 100% legal. What documents do I need to bring?<\/p>\n<\/div>\n<\/div><\/div>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"shack_era@hotmail.com","IpAddress":"173.212.143.91","GroupId":39,"GroupName":"Newbie","JoinDate":1465857726,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"MrsSLMP","Id":287154,"Name":"MrsSLMP","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"189.149.98.29","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79819,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4f3f08d302b1f4c6ce7c8100b4e49011","RawContent":"&lt;p&gt;@[member=\"kristendelpin\"] Congrats!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;What about Ocho Rios?&amp;nbsp;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/weddings.palaceresorts.com\/&#039;&gt;http:\/\/weddings.palaceresorts.com\/&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We have a very nice shoots there.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;div&gt;[sharedmedia=gallery:albums:18203]&lt;\/div&gt;","Attachments":[],"Id":1914540,"PostDate":1466724723,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"285703\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/285703-kristendelpin\/' title='Member profile'><span itemprop=\"name\">kristendelpin<\/span><\/a> Congrats!<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0What about Ocho Rios?\u00a0<a href='http:\/\/weddings.palaceresorts.com\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/weddings.palaceresorts.com\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>We have a very nice shoots there.<\/p>\n<p>\u00a0<\/p>\n<div><div class='_sharedMediaBbcode'>\n\t<div class='bbcode_mediaWrap clearfix'>\n\t\t<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/album\/18203-jamaica\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_18203\/tn_gallery_287113_18203_1056790.jpg' class='sharedmedia_screenshot cover_img_75' title='jam2'  width='75' height='75'  alt='jam2' id='tn_image_view_83640_cover' \/><\/a>\n\t\t<div class='details'>\n\t\t\t<h5><a href='http:\/\/www.bestdestinationwedding.com\/gallery\/album\/18203-jamaica\/' class='bbc_url' title=''>Album: Jamaica<\/a><\/h5>\n\t\t\t<div>15 images<\/div>\n\t\t\t<div>0 comments<\/div>\n\t\t<\/div>\n\t<\/div>\n<\/div>\n<br \/><\/div>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span>Saludos<\/span><\/p>\n<p><span><b>Virginia Hermosillo<\/b><\/span><\/p>\n<p><b>Dream Art \u00a0Wedding Photography<\/b><\/p>\n<p><span><span>contact<a data-ipb='nomediaparse' href='mailto:vhermosillo@dreamartphotography.com'>@dreamartphotography.com<\/a><\/span><\/span><\/p>\n<p><span>Tel: +(52) 998 246-5657<\/span><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/weddings.dreamartphotography.com'>http:\/\/weddings.dreamartphotography.com<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><img src=\"http:\/\/weddings.dreamartphotography.com\/images\/wedding-logo-moto.png\" alt=\"wedding-logo-moto.png\"><\/p>\n<p><span>\u00a0<\/span>","Email":"contact@dreamartphotography.com","IpAddress":"189.221.43.89","GroupId":49,"GroupName":"Insiders","JoinDate":1465498401,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-287113.jpg?_r=1468767861","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"DreamArtPhotography","Id":287113,"Name":"DreamArtPhotography","IsOnline":false}}],"Pages":{"TotalItems":15,"TotalPages":2,"CurrentPage":10,"NextPage":-1,"PreviousPage":0,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
