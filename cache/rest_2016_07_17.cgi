{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":true,"CanEdit":true,"CanReply":true,"CanFollow":true,"TotalPosts":1,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":0,"MovedTo":null,"MovedOn":0,"FirstPostId":1914898,"Rating":0,"RatingHits":0,"Starter":{"Id":287346,"Name":"bellabride2018","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":true},"StartDate":1468772113,"LastPoster":{"Id":287346,"Name":"bellabride2018","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":true},"PollState":"0","LastVote":0,"ForumId":23,"Preview":{"Id":1914898,"PostDate":1468772113,"PostContent":"Hello Ladies!! Congratulations to everyone!! The better half and I have decided on the Grand Bahi...","Author":{"Signature":"","Email":"mmcallister_80@hotmail.com","IpAddress":"99.227.35.118","GroupId":39,"GroupName":"Newbie","JoinDate":1468382124,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"bellabride2018","Id":287346,"Name":"bellabride2018","IsOnline":true}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.227.35.118","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":false,"CanLike":false,"TopicId":80197,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"903b44d49a52b0c1ec7e3e4a4b67400d","RawContent":"Hello Ladies!!\n\n\nCongratulations to everyone!!\n\n\nThe better half and I have decided on the Grand Bahia Principe for our destination wedding.  As we are paying for this ourselves and could potentially have 44 people we need time to save so we are planning May 2018.\n\n\nI am looking for some help in pricing for the wedding packages so that we can get and approximate budget and what we would be looking at.  We realize pricing will most likely change but it gives us something to work with.\n\nWe already have a TA who is a friend of the family.  She is helping us work numbers for the flight and everything. So its just the wedding packages and extras we have no idea about.\n\n\nWould anyone out there be able to help us out? \n\n\nThank you so much!","Attachments":[],"Id":1914898,"PostDate":1468772113,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hello Ladies!!<br><br>\nCongratulations to everyone!!<br><br>\nThe better half and I have decided on the Grand Bahia Principe for our destination wedding.  As we are paying for this ourselves and could potentially have 44 people we need time to save so we are planning May 2018.<br><br>\nI am looking for some help in pricing for the wedding packages so that we can get and approximate budget and what we would be looking at.  We realize pricing will most likely change but it gives us something to work with.<br>\nWe already have a TA who is a friend of the family.  She is helping us work numbers for the flight and everything. So its just the wedding packages and extras we have no idea about.<br><br>\nWould anyone out there be able to help us out? <br><br>\nThank you so much!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mmcallister_80@hotmail.com","IpAddress":"99.227.35.118","GroupId":39,"GroupName":"Newbie","JoinDate":1468382124,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"bellabride2018","Id":287346,"Name":"bellabride2018","IsOnline":true}}],"Id":"80197","Title":"Grand Bahia Principe Jamaica - 2018","LastPostDate":1468772113},"Pages":{"TotalItems":1,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
