{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":5564,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":true,"Views":437915,"MovedTo":null,"MovedOn":0,"FirstPostId":909811,"Rating":0,"RatingHits":0,"Starter":{"Id":220796,"Name":"kerrij","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-220796.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"IsOnline":false},"StartDate":1257286410,"LastPoster":{"Id":287055,"Name":"JasminMattPhoto","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-287055.jpg?_r=1464796174","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":23,"Preview":{"Id":1230503,"PostDate":1280118886,"PostContent":"Quote:     Originally Posted by mekanabr   thanks for the encouragement! I just had to vent! But...","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Married my best friend 04\/28\/11 at the Gran Bahia Principe Runaway Bay<\/span><\/div><\/div>","Email":"trista.lundquist@gmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1273793347,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-228171.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"tris","Id":228171,"Name":"tris","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"aafe89c80778978a0d254ad470fd3c55","RawContent":"thanks for the encouragement! I just had to vent! But we have bunch of mutual friends, soI think she&#039;ll change it...keeping my fingers crossed!!\n \n What are your FIs wearing for the wedding? I&#039;m trying to figure out what Trev should wear, as well as his groomsmen. I still want it to be formal, but a little laid back. But I&#039;m not sure where to look, the bridal shops are too formal. I found a great line from Jcrew, but its so expensive!","Attachments":[],"Id":1230180,"PostDate":1280093402,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                thanks for the encouragement! I just had to vent! But we have bunch of mutual friends, soI think she'll change it...keeping my fingers crossed!!<br \/> <br \/> What are your FIs wearing for the wedding? I'm trying to figure out what Trev should wear, as well as his groomsmen. I still want it to be formal, but a little laid back. But I'm not sure where to look, the bridal shops are too formal. I found a great line from Jcrew, but its so expensive!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mekanabr@gmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1259797911,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223677.JPG?_r=0","PhotoWidth":200,"PhotoHeight":299,"PhotoType":"custom"},"FormattedName":"mekanabr","Id":223677,"Name":"mekanabr","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"755b4b28f3110e1b24118b7ce32f4e63","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;mekanabr&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;thanks for the encouragement! I just had to vent! But we have bunch of mutual friends, soI think she&#039;ll change it...keeping my fingers crossed!!\n \n What are your FIs wearing for the wedding? I&#039;m trying to figure out what Trev should wear, as well as his groomsmen. I still want it to be formal, but a little laid back. But I&#039;m not sure where to look, the bridal shops are too formal. I found a great line from Jcrew, but its so expensive!&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;My FI is wearing a gorgeous tan coloured linen suit we&#039;re getting from Le Chateau. I&#039;m pretty sure it&#039;s just a Canadian store though. We paid a little more than we would have liked (about $250) but it fits him so well and it&#039;s so nice.","Attachments":[],"Id":1230503,"PostDate":1280118886,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>mekanabr<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">thanks for the encouragement! I just had to vent! But we have bunch of mutual friends, soI think she'll change it...keeping my fingers crossed!!<br \/> <br \/> What are your FIs wearing for the wedding? I'm trying to figure out what Trev should wear, as well as his groomsmen. I still want it to be formal, but a little laid back. But I'm not sure where to look, the bridal shops are too formal. I found a great line from Jcrew, but its so expensive!<\/div> <\/td> <\/tr> <\/table> <\/div>My FI is wearing a gorgeous tan coloured linen suit we're getting from Le Chateau. I'm pretty sure it's just a Canadian store though. We paid a little more than we would have liked (about $250) but it fits him so well and it's so nice.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Married my best friend 04\/28\/11 at the Gran Bahia Principe Runaway Bay<\/span><\/div><\/div>","Email":"trista.lundquist@gmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1273793347,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-228171.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"tris","Id":228171,"Name":"tris","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"16b711ffdc317f0f0231e5c7724be9c8","RawContent":"My FI was having trouble finding a suit. We want something light coloured but not linen (wrinkles easily). The problem is that he is very broad in the shoulders and needs a large jacket, the pants that usually come with that size jacket end up be way too big. We finally found a line of separates by Calvin Klein. The best part is that they are on sale at Tip Top Tailors! For the groomsmen we are thinking khaki pants and white button down shirt. Still debating if we want them to wear ties to match with the bridesmaid dresses.","Attachments":[],"Id":1230555,"PostDate":1280122931,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                My FI was having trouble finding a suit. We want something light coloured but not linen (wrinkles easily). The problem is that he is very broad in the shoulders and needs a large jacket, the pants that usually come with that size jacket end up be way too big. We finally found a line of separates by Calvin Klein. The best part is that they are on sale at Tip Top Tailors! For the groomsmen we are thinking khaki pants and white button down shirt. Still debating if we want them to wear ties to match with the bridesmaid dresses.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Getting married in Runaway Bay, Jamaica February 2011!!!<\/span><\/div><\/div>","Email":"ashleyl_84@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1271190989,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-227291.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"AshleyL","Id":227291,"Name":"AshleyL","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b432d5e01f9e531a7c1f9d6af1df0a6e","RawContent":"I don&#039;t think we&#039;re even going the suit route....just some dress pants and dress shirt...we&#039;re still even discussing if he wears a tie or knot. Before he wasn&#039;t but now that I got my dress it&#039;s a little fancier than I what I thought so he might need to wear a tie to not look underdressed.","Attachments":[],"Id":1230958,"PostDate":1280171930,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I don't think we're even going the suit route....just some dress pants and dress shirt...we're still even discussing if he wears a tie or knot. Before he wasn't but now that I got my dress it's a little fancier than I what I thought so he might need to wear a tie to not look underdressed.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;46;23\/st\/20110111\/e\/Our+Wedding\/k\/16e1\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...16e1\/event.png<\/a><\/div><\/div>","Email":"sara.willy@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1259221185,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223542.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"soontobemrsdow","Id":223542,"Name":"soontobemrsdow","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6739f19d298d0237064b6df9fbf6b080","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;soontobemrsdow&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;I don&#039;t think we&#039;re even going the suit route....just some dress pants and dress shirt...we&#039;re still even discussing if he wears a tie or knot. Before he wasn&#039;t but now that I got my dress it&#039;s a little fancier than I what I thought so he might need to wear a tie to not look underdressed.&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;Mike got his at Tristian and America which is in the Eaton Centre in Toronto. Its a plain linen pant and an off white button up shirt. It was sooo hard to find off white as we needed that to match my dress. He isnt wearing a tie, they are all going to wear a bright aqua flower on their lapel to match the girls. I think it came to like $175 for their whole outfit...shoes, pants and shirt..no to bad I guess.\n \n I wanted him to wear a tie to be a little more formal but I lost that battle...lol","Attachments":[],"Id":1231133,"PostDate":1280177744,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>soontobemrsdow<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">I don't think we're even going the suit route....just some dress pants and dress shirt...we're still even discussing if he wears a tie or knot. Before he wasn't but now that I got my dress it's a little fancier than I what I thought so he might need to wear a tie to not look underdressed.<\/div> <\/td> <\/tr> <\/table> <\/div>Mike got his at Tristian and America which is in the Eaton Centre in Toronto. Its a plain linen pant and an off white button up shirt. It was sooo hard to find off white as we needed that to match my dress. He isnt wearing a tie, they are all going to wear a bright aqua flower on their lapel to match the girls. I think it came to like $175 for their whole outfit...shoes, pants and shirt..no to bad I guess.<br \/> <br \/> I wanted him to wear a tie to be a little more formal but I lost that battle...lol\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Today I marry my bestfriend, the one I laugh with, the one I love.<\/span><\/div><\/div>","Email":"kfairful@alumni.uoguelph.ca","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1272162450,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-227617.jpg?_r=0","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"katelynn","Id":227617,"Name":"katelynn","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d9df51eb24e761cc427d5cd8451f2a6e","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;mekanabr&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;thanks for the encouragement! I just had to vent! But we have bunch of mutual friends, soI think she&#039;ll change it...keeping my fingers crossed!!\n \n What are your FIs wearing for the wedding? I&#039;m trying to figure out what Trev should wear, as well as his groomsmen. I still want it to be formal, but a little laid back. But I&#039;m not sure where to look, the bridal shops are too formal. I found a great line from Jcrew, but its so expensive!&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;hahaha I feel your pain...both my bestfriend (and I was here MOH) and Mike&#039;s brother have already backed out of the wedding. I actually got discouraged for awhile but then realized as long as Mike and I are there who cares now, I am not stressing about things like that anymore.","Attachments":[],"Id":1231140,"PostDate":1280177883,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>mekanabr<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">thanks for the encouragement! I just had to vent! But we have bunch of mutual friends, soI think she'll change it...keeping my fingers crossed!!<br \/> <br \/> What are your FIs wearing for the wedding? I'm trying to figure out what Trev should wear, as well as his groomsmen. I still want it to be formal, but a little laid back. But I'm not sure where to look, the bridal shops are too formal. I found a great line from Jcrew, but its so expensive!<\/div> <\/td> <\/tr> <\/table> <\/div>hahaha I feel your pain...both my bestfriend (and I was here MOH) and Mike's brother have already backed out of the wedding. I actually got discouraged for awhile but then realized as long as Mike and I are there who cares now, I am not stressing about things like that anymore.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Today I marry my bestfriend, the one I laugh with, the one I love.<\/span><\/div><\/div>","Email":"kfairful@alumni.uoguelph.ca","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1272162450,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-227617.jpg?_r=0","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"katelynn","Id":227617,"Name":"katelynn","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"43c8d07c0277db226b29c85816895415","RawContent":"&lt;p&gt; Hey,&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; My FI is wearing a white linen suit from Stockhomme (in Fairview Mall and Yorkdale Mall) and a light blue shirt (still not sure of the style for that). We decided to go against the tie as its probably gonna be too hot. The groomsmen are wearing the same pants and shirt as my FI, but they aren&#039;t going to have a jacket.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; On another note, I confirmed with Beverly that you are able to purchase bottles of liquor for our reception in the beach gazebo and therefore would not need a bartender. She didnt say how much each bottle cost, but it has to be less then a bartender!!&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1233982,"PostDate":1280279700,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hey,<\/p> <p> \u00a0<\/p> <p> My FI is wearing a white linen suit from Stockhomme (in Fairview Mall and Yorkdale Mall) and a light blue shirt (still not sure of the style for that). We decided to go against the tie as its probably gonna be too hot. The groomsmen are wearing the same pants and shirt as my FI, but they aren't going to have a jacket.<\/p> <p> \u00a0<\/p> <p> On another note, I confirmed with Beverly that you are able to purchase bottles of liquor for our reception in the beach gazebo and therefore would not need a bartender. She didnt say how much each bottle cost, but it has to be less then a bartender!!\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lchayim@rogers.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1265621673,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-225422.JPG?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"StephAli","Id":225422,"Name":"StephAli","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6199a1414edbecf401c3fc860a548c91","RawContent":"StephAli - thanks for the info from Beverly. Buying our own booze does seem like it would be much cheaper. Does anyone have an idea of what kind\/how much liquor for around 40 people?","Attachments":[],"Id":1234363,"PostDate":1280300195,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                StephAli - thanks for the info from Beverly. Buying our own booze does seem like it would be much cheaper. Does anyone have an idea of what kind\/how much liquor for around 40 people?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Getting married in Runaway Bay, Jamaica February 2011!!!<\/span><\/div><\/div>","Email":"ashleyl_84@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1271190989,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-227291.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"AshleyL","Id":227291,"Name":"AshleyL","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3b6448b348dfa34ca35c021aa75fa482","RawContent":"&lt;p&gt; I know! Same thing with me, I&amp;quot;m my Best friends MOH, and she&#039;s not evven coming to mine.&amp;nbsp; And neither is any of my sisters or any of my FI&#039;s siblings, its pretty much going to be some of our friends, my aunt and uncle and our parents, but whatever.&amp;nbsp; We&#039;ll have a good time regardless!&amp;nbsp; As long as we both show up...&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I&#039;m contemplating making my FI (hahaha) wear tan pants with either a white button up shirt, or a bright blue one.&amp;nbsp; Haven&#039;t been able to convince him about the blue yet, so we will see.&amp;nbsp; No suit jacket thouhg, he&#039;d be too hot.&lt;\/p&gt;","Attachments":[],"Id":1234832,"PostDate":1280333257,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I know! Same thing with me, I\"m my Best friends MOH, and she's not evven coming to mine.\u00a0 And neither is any of my sisters or any of my FI's siblings, its pretty much going to be some of our friends, my aunt and uncle and our parents, but whatever.\u00a0 We'll have a good time regardless!\u00a0 As long as we both show up...<\/p> <p> \u00a0<\/p> <p> I'm contemplating making my FI (hahaha) wear tan pants with either a white button up shirt, or a bright blue one.\u00a0 Haven't been able to convince him about the blue yet, so we will see.\u00a0 No suit jacket thouhg, he'd be too hot.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Gran Bahia Principe - Runaway Bay - February 22, 2011<\/span><\/div><\/div>","Email":"akua420@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1270637423,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-227119.jpg?_r=0","PhotoWidth":200,"PhotoHeight":161,"PhotoType":"custom"},"FormattedName":"akua420","Id":227119,"Name":"akua420","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":44634,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cdfb4161033ba6800a9d05d97ff9a2d0","RawContent":"&lt;p&gt; Thats really good to know about the booze as there is no way I can afford the $15pp for it...I would ask around of what people like, I would deff say Vodka and Rum and some beer...youll need some mixes too. I might ask if they can set up a table so its a little more forma. I know when I went to cuba we payed the one bartender we got to know and he gave us full bottles and mixes for like $10...looks like we all need to charm some bartenders, lol&lt;\/p&gt;","Attachments":[],"Id":1236982,"PostDate":1280444451,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Thats really good to know about the booze as there is no way I can afford the $15pp for it...I would ask around of what people like, I would deff say Vodka and Rum and some beer...youll need some mixes too. I might ask if they can set up a table so its a little more forma. I know when I went to cuba we payed the one bartender we got to know and he gave us full bottles and mixes for like $10...looks like we all need to charm some bartenders, lol<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Today I marry my bestfriend, the one I laugh with, the one I love.<\/span><\/div><\/div>","Email":"kfairful@alumni.uoguelph.ca","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1272162450,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-227617.jpg?_r=0","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"katelynn","Id":227617,"Name":"katelynn","IsOnline":false}}],"Id":"44634","Title":"Any Gran Bahia Principe Runaway Bay Brides out there?","LastPostDate":1467934433},"Pages":{"TotalItems":5564,"TotalPages":557,"CurrentPage":190,"NextPage":200,"PreviousPage":180,"LastPage":5560},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
