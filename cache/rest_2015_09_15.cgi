%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>So far we have:<\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"281478\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281478-perianjay\/' title='Member profile'><span itemprop=\"name\">perianjay<\/span><\/a><\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"281820\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281820-krystalball\/' title='Member profile'><span itemprop=\"name\">krystalball<\/span><\/a><\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"276748\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/276748-diadiamond\/' title='Member profile'><span itemprop=\"name\">diadiamond<\/span><\/a><\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"232000\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/232000-acw271011\/' title='Member profile'><span itemprop=\"name\">acw271011<\/span><\/a><\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"281055\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281055-snswedding2016\/' title='Member profile'><span itemprop=\"name\">snswedding2016<\/span><\/a><\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"277519\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277519-veryvalentine\/' title='Member profile'><span itemprop=\"name\">veryvalentine<\/span><\/a><\/p>\n<p>and me<\/p>\n<p>\u00a0<\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"282128\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdes