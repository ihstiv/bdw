{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":6,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":135,"MovedTo":null,"MovedOn":0,"FirstPostId":1904576,"Rating":0,"RatingHits":0,"Starter":{"Id":284595,"Name":"hirvine83","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1442081158,"LastPoster":{"Id":282006,"Name":"ashhtayy","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282006.png?_r=1423373502","PhotoWidth":200,"PhotoHeight":138,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1904576,"PostDate":1442081158,"PostContent":"Hi Everyone! My fiance and I are in the very beginning stages of planning our wedding in the Maya...","Author":{"Signature":"","Email":"hirvine83@hotmail.com","IpAddress":"184.145.100.229","GroupId":39,"GroupName":"Newbie","JoinDate":1440787166,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"hirvine83","Id":284595,"Name":"hirvine83","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"184.145.102.89","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79584,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"25976e12b16ef8e64600e056b8a67d7e","RawContent":"&lt;p&gt;Hi Everyone! My fiance and I are in the very beginning stages of planning our wedding in the Mayan Riviera for either November 2016 (likely) or Jan\/Feb 2017 (less likely). We are still trying to narrow down properties but I have so far absolutely fallen in love with Azul Fives, especially the option of the Sky wedding. Has anyone started the process of planning a wedding at this resort or have you considered it and chosen not to have you wedding there? Any tips or thoughts would be very helpful! Feeling overwhelmed, but very excited :)&amp;nbsp;\n\n&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thanks!!&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1904576,"PostDate":1442081158,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Everyone! My fiance and I are in the very beginning stages of planning our wedding in the Mayan Riviera for either November 2016 (likely) or Jan\/Feb 2017 (less likely). We are still trying to narrow down properties but I have so far absolutely fallen in love with Azul Fives, especially the option of the Sky wedding. Has anyone started the process of planning a wedding at this resort or have you considered it and chosen not to have you wedding there? Any tips or thoughts would be very helpful! Feeling overwhelmed, but very excited <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0<br>\n\u00a0<\/p>\n<p>Thanks!!\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"hirvine83@hotmail.com","IpAddress":"184.145.100.229","GroupId":39,"GroupName":"Newbie","JoinDate":1440787166,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"hirvine83","Id":284595,"Name":"hirvine83","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.146.146.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79584,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5d6c0f1a9e3d6d022b66c65626aff323","RawContent":"@[member=\"TinkerSofi\"] just got married here :)  there are threads for this resort if you use the search bar above. \n\n\nCongrats and welcome!! \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1904588,"PostDate":1442098234,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"265511\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/265511-tinkersofi\/' title='Member profile'><span itemprop=\"name\">TinkerSofi<\/span><\/a> just got married here <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>  there are threads for this resort if you use the search bar above. <br><br>\nCongrats and welcome!! <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399432202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"177.237.80.72","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79584,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"47a0410cc2e593e7d3b0b44c12ddb097","RawContent":"&lt;p&gt;Welcome to our forum community hirvine83 and Congrats on your upcoming dw!!! You&#039;ve come to the right place for lots of great resources to help with your planning decisions, so well done on getting off to an excellent start already :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;In case you haven&#039;t already seen them here&#039;s a link to some threads talking about Azul Fives here: &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/index.php?s=af2df7e3b3cbfbfec7781c0c2abf017a&amp;amp;app=googlecse#gsc.tab=0&amp;amp;gsc.q=Azul%20Fives&#039;&gt;Azul Fives Threads&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Happy research, and all the best with your plans - cheers!!! team mtm :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-mia1-1.xx.fbcdn.net\/hphotos-xpa1\/t31.0-8\/11951533_10153610355409487_3502002007315431031_o.jpg\" alt=\"11951533_10153610355409487_3502002007315\"&gt;&lt;\/p&gt;","Attachments":[],"Id":1904589,"PostDate":1442102461,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome to our forum community hirvine83 and Congrats on your upcoming dw!!! You've come to the right place for lots of great resources to help with your planning decisions, so well done on getting off to an excellent start already <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>In case you haven't already seen them here's a link to some threads talking about Azul Fives here: <a href='http:\/\/www.bestdestinationwedding.com\/index.php?s=af2df7e3b3cbfbfec7781c0c2abf017a&app=googlecse#gsc.tab=0&gsc.q=Azul%20Fives' class='bbc_url' title=''>Azul Fives Threads<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Happy research, and all the best with your plans - cheers!!! team mtm <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-mia1-1.xx.fbcdn.net\/hphotos-xpa1\/t31.0-8\/11951533_10153610355409487_3502002007315431031_o.jpg\" alt=\"11951533_10153610355409487_3502002007315\"><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280214260,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.12.104","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79584,"EditedBy":"","EditDate":1442276359,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e3f03db9456e7d857ebd44cc48ea19d4","RawContent":"&lt;p&gt;Congrats and welcome!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;ll totally agree with the two previous posts. There are several threads here about Azul Fives if you just search up top in the search bar, and MTM provided you with a couple as well. It&#039;s a beautiful resort and the Sky deck is very popular, but be aware that it&#039;s at a cost.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck and happy planning!&lt;\/p&gt;","Attachments":[],"Id":1904604,"PostDate":1442172754,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats and welcome!<\/p>\n<p>\u00a0<\/p>\n<p>I'll totally agree with the two previous posts. There are several threads here about Azul Fives if you just search up top in the search bar, and MTM provided you with a couple as well. It's a beautiful resort and the Sky deck is very popular, but be aware that it's at a cost.<\/p>\n<p>\u00a0<\/p>\n<p>Good luck and happy planning!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283462599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.67.238.222","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79584,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ff4fa7f9dfbf623682ebb6e00e4e8f44","RawContent":"&lt;p&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;&lt;span style=\"font-size:12px;\"&gt;Hi. My daughter is being married at Azul Fives in late Janaury 2016......not very far away. the wedding is taking place on the Sky Deck, I think. Truthfully, she lives in another city and i haven&#039;t been involved very much,other than to provide some money. I can tell you more in February after the wedding!!!&amp;nbsp; &lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1904691,"PostDate":1442264171,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span  style=\"font-family:arial, helvetica, sans-serif\"><span  style=\"font-size:12px\">Hi. My daughter is being married at Azul Fives in late Janaury 2016......not very far away. the wedding is taking place on the Sky Deck, I think. Truthfully, she lives in another city and i haven't been involved very much,other than to provide some money. I can tell you more in February after the wedding!!!\u00a0 <\/span><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"pamharris@shaw.ca","IpAddress":"70.67.238.222","GroupId":39,"GroupName":"Newbie","JoinDate":1442263762,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"motherofbridejanuary2016","Id":284812,"Name":"motherofbridejanuary2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"184.147.120.79","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79584,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8d45734957eb12ddc1961f85f634ceed","RawContent":"@[member=\"hirvine83\"] I&#039;m getting married at AF June 7th, 2016. Selecting the resort was definitely the hardest part...until I laid my eyes on the Sky Deck and then I was sold. Although I too haven&#039;t done much planning we are booked for a 4:30 ceremony followed by a cocktail hour at the sky bar and reception on the Sky Deck. \n\n\nJust an FYI if you do go with AF - there is a fee for the Sky Deck. We booked and got it for $1700 but I believe it&#039;s gone up to $1800. In my mind it&#039;s well worth it for that fantastic view :)\n\n\nHappy Planning!","Attachments":[],"Id":1904716,"PostDate":1442289101,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"284595\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/284595-hirvine83\/' title='Member profile'><span itemprop=\"name\">hirvine83<\/span><\/a> I'm getting married at AF June 7th, 2016. Selecting the resort was definitely the hardest part...until I laid my eyes on the Sky Deck and then I was sold. Although I too haven't done much planning we are booked for a 4:30 ceremony followed by a cocktail hour at the sky bar and reception on the Sky Deck. <br><br>\nJust an FYI if you do go with AF - there is a fee for the Sky Deck. We booked and got it for $1700 but I believe it's gone up to $1800. In my mind it's well worth it for that fantastic view <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br><br>\nHappy Planning!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>My Planning Thread: <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79377-ashhtayys-planning-thread-azul-fives-june-7-2016\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79377-ashhtayys-planning-thread-azul-fives-june-7-2016\/<\/a><br>\n\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;0;116\/st\/20160607\/e\/Our+Wedding\/dt\/1\/k\/bb99\/event.png\" alt=\"event.png\"><\/a>","Email":"ashley.taylor@live.ca","IpAddress":"184.147.135.4","GroupId":40,"GroupName":"Jr. Member","JoinDate":1423108661,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282006.png?_r=1423373502","PhotoWidth":200,"PhotoHeight":138,"PhotoType":"custom"},"FormattedName":"ashhtayy","Id":282006,"Name":"ashhtayy","IsOnline":false}}],"Id":"79584","Title":"Azul Fives 2016\/2017","LastPostDate":1442289101},"Pages":{"TotalItems":6,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
