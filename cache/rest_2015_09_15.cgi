{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":16,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":3193,"MovedTo":null,"MovedOn":0,"FirstPostId":1853705,"Rating":0,"RatingHits":0,"Starter":{"Id":278074,"Name":"Nybride525","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1401842198,"LastPoster":{"Id":277519,"Name":"veryvalentine","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277519.jpg?_r=1439827749","PhotoWidth":200,"PhotoHeight":132,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":124,"Preview":{"Id":1877791,"PostDate":1415221940,"PostContent":"I'm excited to see the price drop too !!\u00a0 So far our price for JUne 2015 has not dropped at all.....","Author":{"Signature":"<div><br><div>\u00a0<\/div>\n<div>\u00a0<\/div>\n<div>Married on June 20th, 2015 at the Grand Sunset Princess Riviera Gazebo & Reception at the Chill Out with 60 guests<\/div>\n<div>\u00a0<\/div>\n<\/div>\n<div>\u00a0<\/div>\n<p>My planning thread:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/<\/a><\/p>\n<p>My review thread: \u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/<\/a>","Email":"rebecca.valero@gmail.com","IpAddress":"38.112.94.76","GroupId":3,"GroupName":"Member","JoinDate":1396986452,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277519.jpg?_r=1439827749","PhotoWidth":200,"PhotoHeight":132,"PhotoType":"custom"},"FormattedName":"veryvalentine","Id":277519,"Name":"veryvalentine","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.192.65.98","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77225,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fa197e5a197f99a5c4b72b39950f71cb","RawContent":"I am looking at May 2015 and right now the now jade has kids free but only for 2014...around what time will specials applicable to May 2015 come out? And if I book now and there&#039;s a deal is there any way to get the cheaper price? I can&#039;t decide when to book and it&#039;s driving me nuts lol","Attachments":[],"Id":1853705,"PostDate":1401842198,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I am looking at May 2015 and right now the now jade has kids free but only for 2014...around what time will specials applicable to May 2015 come out? And if I book now and there's a deal is there any way to get the cheaper price? I can't decide when to book and it's driving me nuts lol\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Jamie","Email":"lovinmylilone@yahoo.com","IpAddress":"70.192.94.81","GroupId":40,"GroupName":"Jr. Member","JoinDate":1400775982,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Nybride525","Id":278074,"Name":"Nybride525","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.76.184.146","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77225,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ec79323f050c1a10e1763c39466bff2c","RawContent":"&lt;p&gt;I know Sunwing offers &#039;&#039;Price Drop Guarantee&#039;&#039; insurance for $50\/person. If the price drops after you book, Sunwing will refund the difference. I bet other carriers offer something similar.&lt;\/p&gt;","Attachments":[],"Id":1853713,"PostDate":1401843338,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I know Sunwing offers ''Price Drop Guarantee'' insurance for $50\/person. If the price drops after you book, Sunwing will refund the difference. I bet other carriers offer something similar.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"a_jansen1@hotmail.com","IpAddress":"24.76.184.146","GroupId":47,"GroupName":"Site Supporter","JoinDate":1395495927,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"ajansen1","Id":277283,"Name":"ajansen1","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.114.22.90","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77225,"EditedBy":"<strong>Edited by kmk2016, 03 June 2014 - 05:37 PM.<\/strong>","EditDate":1401845859,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"9606136daae8a2c32245c933262eb1b6","RawContent":"[quote name=\"ajansen1\" post=\"1853713\" timestamp=\"1401839738\"]\nI know Sunwing offers &#039;&#039;Price Drop Guarantee&#039;&#039; insurance for $50\/person. If the price drops after you book, Sunwing will refund the difference. I bet other carriers offer something similar.[\/quote]In most contracts that you sign your TA will insure you have a \"one time price drop protection\" so that if the price drops from the day you sign your contract and the day the final payments are due, they will adjust all guests signed under the contract&#039;s pricing! It saves you from having to worry about a price drop while securing your space at a popular hotel. \n\nThis isn&#039;t an add on that you have to pay for.,, this is something your TA can easily negotiate as part of your agreement, \n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1853722,"PostDate":1401845804,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>ajansen1, on 03 June 2014 - 04:55 PM, said:<\/p><div class='blockquote'><div class='quote'><p>\nI know Sunwing offers ''Price Drop Guarantee'' insurance for $50\/person. If the price drops after you book, Sunwing will refund the difference. I bet other carriers offer something similar.<\/p><\/div><\/div>\nIn most contracts that you sign your TA will insure you have a \"one time price drop protection\" so that if the price drops from the day you sign your contract and the day the final payments are due, they will adjust all guests signed under the contract's pricing! It saves you from having to worry about a price drop while securing your space at a popular hotel. <br><br>\nThis isn't an add on that you have to pay for.,, this is something your TA can easily negotiate as part of your agreement, <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kmkwedding2016@gmail.com","IpAddress":"70.72.195.234","GroupId":38,"GroupName":"Moderators","JoinDate":1390260208,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kmk2016","Id":276231,"Name":"kmk2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.14.134","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77225,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"07a8aa9f6a2626970adf76549abb6dbf","RawContent":"&lt;p&gt;Hi ladies. The catch to that though is that Sunwing is canadian. Things work a little differently in the US.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;@Nybride525&amp;nbsp; I think your travel agent, or someone on this site from Wright Travel would be the best person to help you with that since you&#039;re in the US. The other thing is that they have access to deals through the resorts that they can help you with. They&#039;re specialists in destination wedding travel and have won awards as top performers with some of the resort chains. If you can, I&#039;d check with them.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck!&lt;\/p&gt;","Attachments":[],"Id":1853737,"PostDate":1401853439,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi ladies. The catch to that though is that Sunwing is canadian. Things work a little differently in the US.<\/p>\n<p>\u00a0<\/p>\n<p>@Nybride525\u00a0 I think your travel agent, or someone on this site from Wright Travel would be the best person to help you with that since you're in the US. The other thing is that they have access to deals through the resorts that they can help you with. They're specialists in destination wedding travel and have won awards as top performers with some of the resort chains. If you can, I'd check with them.<\/p>\n<p>\u00a0<\/p>\n<p>Good luck!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283462599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.252.61.182","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77225,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"72e21ed9cf8abcb9388d689f4f7e02d3","RawContent":"&lt;p&gt;I am also with Sunwing, getting married may, 2015 and we have booked at the end of April. Sunwing offers the one time price drop (free of charge) to anyone that has put their deposit down until 45 days before the trip. But yes its a Canadian Operator. But if you wondering the best time to book i would say as soon as you can find a date and a place that you like and a resonable price for your guest I would book just because the dates get booked up soo fast and you may not get the dates that you want..good luck!!!&lt;\/p&gt;","Attachments":[],"Id":1853769,"PostDate":1401888273,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I am also with Sunwing, getting married may, 2015 and we have booked at the end of April. Sunwing offers the one time price drop (free of charge) to anyone that has put their deposit down until 45 days before the trip. But yes its a Canadian Operator. But if you wondering the best time to book i would say as soon as you can find a date and a place that you like and a resonable price for your guest I would book just because the dates get booked up soo fast and you may not get the dates that you want..good luck!!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kay.vaillancourt@gmail.com","IpAddress":"173.252.61.182","GroupId":40,"GroupName":"Jr. Member","JoinDate":1378748769,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-273327.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"kay2015","Id":273327,"Name":"kay2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"184.65.100.98","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77225,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d12f48fdeb3376b91207f0f639ccad3c","RawContent":"[quote name=\"kay2015\" post=\"1853769\" timestamp=\"1401884673\"]\nI am also with Sunwing, getting married may, 2015 and we have booked at the end of April. Sunwing offers the one time price drop (free of charge) to anyone that has put their deposit down until 45 days before the trip. But yes its a Canadian Operator. But if you wondering the best time to book i would say as soon as you can find a date and a place that you like and a resonable price for your guest I would book just because the dates get booked up soo fast and you may not get the dates that you want..good luck!!![\/quote]\nMe too! May 2015 bride and booked at the beginning of April. Also with Sunwing so we have the one time price drop guarantee. I would get on booking as soon as you can! I&#039;ve seen tons of May brides already, and if each hotel can only put on 3-4 weddings a day, you may miss the date or resort you want! (Especially Now Jade, since it&#039;s so popular!!)","Attachments":[],"Id":1853804,"PostDate":1401898968,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>kay2015, on 04 June 2014 - 05:24 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>I am also with Sunwing, getting married may, 2015 and we have booked at the end of April. Sunwing offers the one time price drop (free of charge) to anyone that has put their deposit down until 45 days before the trip. But yes its a Canadian Operator. But if you wondering the best time to book i would say as soon as you can find a date and a place that you like and a resonable price for your guest I would book just because the dates get booked up soo fast and you may not get the dates that you want..good luck!!!<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>Me too! May 2015 bride and booked at the beginning of April. Also with Sunwing so we have the one time price drop guarantee. I would get on booking as soon as you can! I've seen tons of May brides already, and if each hotel can only put on 3-4 weddings a day, you may miss the date or resort you want! (Especially Now Jade, since it's so popular!!)<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nikkicraig10@gmail.com","IpAddress":"204.174.77.34","GroupId":39,"GroupName":"Newbie","JoinDate":1395782738,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"nikkicraig10","Id":277331,"Name":"nikkicraig10","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.208.73.127","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77225,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"2c6f49f605a09f26f4a510e9d2f26a8f","RawContent":"Thanks out wedding date is already secured thru the wedding planner. My travel agent said they rebook once specials are available so we will be booking next week","Attachments":[],"Id":1854273,"PostDate":1402187012,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks out wedding date is already secured thru the wedding planner. My travel agent said they rebook once specials are available so we will be booking next week\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Jamie","Email":"lovinmylilone@yahoo.com","IpAddress":"70.192.94.81","GroupId":40,"GroupName":"Jr. Member","JoinDate":1400775982,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Nybride525","Id":278074,"Name":"Nybride525","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"67.193.91.193","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77225,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"64a42a48e93c29d56e3c87d0a0ace133","RawContent":"&lt;p&gt;The other thing you need to consider is that the rooms can fill quickly, so if you need a lot of rooms, you might want to reserve them sooner than later.&amp;nbsp;Then watch for a special, and adjust if need be.&lt;\/p&gt;","Attachments":[],"Id":1857776,"PostDate":1404252260,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>The other thing you need to consider is that the rooms can fill quickly, so if you need a lot of rooms, you might want to reserve them sooner than later.\u00a0Then watch for a special, and adjust if need be.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"boomer_396@hotmail.com","IpAddress":"67.193.91.193","GroupId":40,"GroupName":"Jr. Member","JoinDate":1404250553,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Brinley","Id":278775,"Name":"Brinley","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.108.237.58","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77225,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4ddc84ec699fa2e7a1e24a8a0010e418","RawContent":"Great question","Attachments":[],"Id":1861421,"PostDate":1406010393,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Great question\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff8c00;\"><span style=\"font-family:'comic sans ms', cursive;\"><span style=\"font-size:14px;\">\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 AnnaTennille & Eric<\/span><\/span><\/span><\/p>\n<p><span style=\"color:#ff8c00;\"><span style=\"font-family:'comic sans ms', cursive;\"><span style=\"font-size:14px;\">\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 May 16, 2015<\/span><\/span><\/span><\/p>\n<p><span style=\"font-family:'comic sans ms', cursive;\"><span style=\"font-size:14px;\"><span style=\"color:#ff8c00;\">\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 Montego Bay, Jamaica<\/span><\/span><\/span><\/p>\n<p><span style=\"font-family:'comic sans ms', cursive;\"><span style=\"font-size:14px;\"><span style=\"color:#ff8c00;\">\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 \u00a0 \u00a0 \u00a0 \u00a0\u00a0 <\/span><\/span><\/span><\/p>\n<p>\u00a0\u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0\u00a0 <img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10765;484\/st\/20150516\/e\/The+Day+We+Say+I+Do%21\/k\/b124\/event.png\" alt=\"event.png\"><\/p>\n<p>\u00a0","Email":"a.johnson1013@yahoo.com","IpAddress":"99.108.237.58","GroupId":40,"GroupName":"Jr. Member","JoinDate":1403202280,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278601.jpg?_r=1403203318","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"atennille","Id":278601,"Name":"atennille","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.215.245.97","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77225,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9e62687ccfb4cbb70d476c98bb2337c6","RawContent":"&lt;p&gt;I found that booking through sites like Expedia are much cheaper then booking through a T.A. or the hotel directly.&lt;\/p&gt;","Attachments":[],"Id":1868297,"PostDate":1408744753,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I found that booking through sites like Expedia are much cheaper then booking through a T.A. or the hotel directly.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"holly_youngquist@hotmail.com","IpAddress":"108.215.245.97","GroupId":40,"GroupName":"Jr. Member","JoinDate":1399573622,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"hyoungquist","Id":277896,"Name":"hyoungquist","IsOnline":false}}],"Id":"77225","Title":"When Do 2015 Special Deals Come Out?","LastPostDate":1415221940},"Pages":{"TotalItems":16,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
