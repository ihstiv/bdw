\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>aww, I'm getting married in 4 weeks!\u00a0 I'll probably already be married by the time you ladies meet up.\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/sad.png' class='bbc_emoticon' alt=':(' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div><br><div>\u00a0<\/div>\n<div>\u00a0<\/div>\n<div>Married on June 20th, 2015 at the Grand Sunset Princess Riviera Gazebo & Reception at the Chill Out with 60 guests<\/div>\n<div>\u00a0<\/div>\n<\/div>\n<div>\u00a0<\/div>\n<p>My planning thread:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/<\/a><\/p>\n<p>My review thread: \u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/<\/a>","Email":"rebecca.valero@gmail.com","IpAddress":"38.112.94.76","GroupId":3,"GroupName":"Member","JoinDate":1396986452,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277519.jpg?_r=1439827749","PhotoWidth":200,"PhotoHeight":132,"PhotoType":"custom"},"FormattedName":"veryvalentine","Id":277519,"Name":"veryvalentine","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79202,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":4,"IsLiked":false,"PostKe