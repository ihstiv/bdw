Request Time: 0 seconds
{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"189.221.32.251","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79963,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3e8cb2fbb34a2b3cb4393bc01b898811","RawContent":"&lt;p&gt;Welcome @[member=\"Kfred\"]! You&#039;ve come to the right place for you wedding planning. There are tons of resources here on the BDW forums. If you need and Sandos Caracol is a beautiful place to get married.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Something to consider in this tropical climate is your makeup. We specialize in airbrush makeup which works so well in the heat and humidity. Here&#039;s some more info for you if interested in learning more:&amp;nbsp;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/wedding-tips\/c\/planning\/q-a-is-airbrush-makeup-ideal-in-a-tropic-r2326&#039;&gt;http:\/\/www.bestdestinationwedding.com\/wedding-tips\/c\/planning\/q-a-is-airbrush-makeup-ideal-in-a-tropic-r2326&lt;\/a&gt;&lt;\/p&gt;","Attachments":[],"Id":1913973,"PostDate":1464039777,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome @<a hovercard-ref=\"member\" hovercard-id=\"286259\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/286259-kfred\/' title='Member profile'><span itemprop=\"name\">Kfred<\/span><\/a>! You've come to the right place for you wedding planning. There are tons of resources here on the BDW forums. If you need and Sandos Caracol is a beautiful place to get married.<\/p>\n<p>\u00a0<\/p>\n<p>Something to consider in this tropical climate is your makeup. We specialize in airbrush makeup which works so well in the heat and humidity. Here's some more info for you if interested in learning more:\u00a0<a href='http:\/\/www.bestdestinationwedding.com\/wedding-tips\/c\/planning\/q-a-is-airbrush-makeup-ideal-in-a-tropic-r2326' class='bbc_url' title=''>http:\/\/www.bestdesti...-a-tropic-r2326<\/a><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p style=\"font-family:arial, helvetica, sans-serif;color:rgb(90,90,90);\"><span style=\"font-size:18px;\"><span style=\"font-family:'lucida sans unicode', 'lucida grande', sans-serif;\">Dena DaSilva<\/span><\/span><\/p>\n<p style=\"font-family:arial, helvetica, sans-serif;color:rgb(90,90,90);\"><span style=\"font-size:18px;\"><span style=\"font-family:'lucida sans unicode', 'lucida grande', sans-serif;\">Online Concierge<\/span><\/span><\/p>\n<p style=\"font-family:arial, helvetica, sans-serif;color:rgb(90,90,90);\"><span style=\"color:#ff99cc;\"><span style=\"font-size:18px;\"><span style=\"font-family:'lucida sans unicode', 'lucida grande', sans-serif;\">US (+1) 713 589 4558<\/span><\/span><\/span><\/p>\n<p style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"font-family:'lucida sans unicode', 'lucida grande', sans-serif;\"><span style=\"font-size:18px;\"><span style=\"color:rgb(90,90,90);\"><span style=\"color:#ff99cc;\">MX (+52) 984 803 2816<br>\nconcierge@stylingtrio.com<\/span><\/span><br><span style=\"color:#ff99cc;\">www.stylingtrio.com<\/span><br><br><span style=\"color:rgb(105,105,105);\">Facebook: <\/span><span style=\"color:#ff99cc;\">facebook\/stylingtrio.com<\/span><br><span style=\"color:rgb(105,105,105);\">Twitter:<\/span><span style=\"color:rgb(238,130,238);\">\u00a0<\/span><span style=\"color:rgb(255,153,204);\">@stylingtrio<\/span><br><span style=\"color:rgb(105,105,105);\">Instagram:<\/span><span style=\"color:rgb(238,130,238);\">\u00a0<\/span><span style=\"color:rgb(255,153,204);\">@stylingtrio<\/span><br><span style=\"color:rgb(105,105,105);\">Pinterest: <\/span><span style=\"color:#ff99cc;\">www.pinterest.com\/stylingtrio<\/span><\/span><\/span><\/p>\n<p style=\"font-family:arial, helvetica, sans-serif;color:rgb(90,90,90);\">\u00a0<\/p>\n<p style=\"font-family:arial, helvetica, sans-serif;color:rgb(90,90,90);\"><span style=\"color:rgb(34,34,34);font-family:'Helvetica Neue', Arial, Verdana, sans-serif;\">\u00a0<\/span><\/p>\n<p style=\"font-family:arial, helvetica, sans-serif;color:rgb(90,90,90);\"><img src=\"https:\/\/ci4.googleusercontent.com\/proxy\/hapv1CMGpXYv2FEz6ZYtPWd2Y_yEKx8fi8QHoF6qa6giBtQe5Sq7Qu37JOO6-9XwSHFc1cI6Ke5Y2N3x9Ue9=s0-d-e1-ft#http:\/\/stylingtrio.com\/Firmas\/Styling.jpg\" alt=\"Styling.jpg\"><\/p>\n<p style=\"font-family:arial, helvetica, sans-serif;color:rgb(90,90,90);\">\u00a0<\/p>\n<p style=\"font-family:arial, helvetica, sans-serif;color:rgb(90,90,90);\">\u00a0","Email":"social@stylingtrio.com","IpAddress":"189.221.40.208","GroupId":84,"GroupName":"Insiders w\/ Articles","JoinDate":1462483132,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286883.jpg?_r=1463007029","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"StylingTrioRivieraMaya","Id":286883,"Name":"StylingTrioRivieraMaya","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.151.82.249","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79963,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9c3510f68d26bbc38e1dac5b877f3344","RawContent":"[quote name=\"MrsOHara\" post=\"1913668\" timestamp=\"1463029093\"]\nHi Ladies, \n\nWe are pretty sure this is where we want to get married September 2017. Super excited. We are pretty sure we will go with the Emerald Breeze package but I have a question regarding dinner. It says that the package includes 3 hr private dinner. This may be a silly question but do they charge you per head for the food or is that included when it says \"private dinner\"? I wasn&#039;t sure if it meant that its just giving you the space to eat privately or if its all included? \n\nThanks in advance :)[\/quote]I assume it would mean it&#039;s all included, but I&#039;d definitely check with the coordinator.  She&#039;s great with answering questions. \n\n\nSent from my SM-G930W8 using Tapatalk\n[quote name=\"Kfred\" post=\"1911586\" timestamp=\"1457190620\"]\nThank you so much @[member=\"tpenner\"] for responding with all of these details! so sorry it took me long to respond - my daughter is teething and has had a cold so it&#039;s been a rough week to sit down at the puter...\n\nWe too are going with the Caribbean Fantasy package. I am aiming for the gazebo but really like your point of not seeing\/using the natural beauty of the beach\/ocean which was always the plan while searching for our destination we always said on the beach, so who knows this one might change still. I really do love the gazebo though, it is so unique! Do you know how many guests you can have at this location though? We are inviting approx 80 people (not sure how many will come but I suspect at least 60). The resort asked if we would like 4pm, 5pm, or 6pm for our ceremony. We chose 4pm as that&#039;s what my fiance wanted - personally I was thinking 5 would be better, it&#039;s so bloody hot out still at 4 lol I&#039;m gonna be a mess! Maybe another good reason for the gazebo to have some guaranteed shade.\n\nI haven&#039;t seen any photos or good information on how the reception is set up on the beach, have you?! For now, we are moving forward with planning for the rooftop terrace. But there are so many details to figure out for the reception like table settings, centerpieces, flowers, etc. I&#039;m trying to figure out what I will bring with me for our own set up or what we will pay the resort to do. I haven&#039;t really seen examples of what they can do for centerpieces etc. (can&#039;t get over the upcharge for every little thing like even a napkin ring holder!!). I&#039;ve heard of other brides (other resorts) bringing their own materials for centerpieces, their own table runners and other decorations. What are your plans for that?\n\nAlso will pay for the extra hour, I can&#039;t imagine shutting the party down at 10 - and as far as I&#039;ve heard the resort DJ is just fine for the event so will be going that way. I haven&#039;t even begun researching photographers\/prices - amazing that it&#039;s cheaper for you to bring them with you from Edmonton (we are from Winnipeg). So hopefully I&#039;ll get to see some work from the resort photographer soon so I can move forward with planning on that front.\n\nOne of my bridesmaids is a hair stylist so I&#039;m super lucky in that regard. I think I&#039;m going to give the resort salon a try for the make up application. I think that if I really don&#039;t like it, I&#039;ll wash it off and do my makeup myself.\n\nHave you decided on buffet or plated dinner? how about your colors\/theme?\n\ntalk soon and thanks![\/quote]Wow..it&#039;s even a long time since I&#039;ve been on here!\n\nSo I was able to send an email to the coordinator and ask some questions.  Good  news!  They aren&#039;t charging us anything extra to have our reception on the rooftop!  I haven&#039;t put any thought into the buffet\/plated dinner.   \n\nAs for colors, we are having an aqua green and coral.\n\nI feel like planning is at a standstill until we have to figure out the details.  \n\nSent from my SM-G930W8 using Tapatalk","Attachments":[],"Id":1914073,"PostDate":1464586918,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>MrsOHara, on 11 May 2016 - 09:58 PM, said:<\/p><div class='blockquote'><div class='quote'><p>Hi Ladies, <br><br>\nWe are pretty sure this is where we want to get married September 2017. Super excited. We are pretty sure we will go with the Emerald Breeze package but I have a question regarding dinner. It says that the package includes 3 hr private dinner. This may be a silly question but do they charge you per head for the food or is that included when it says \"private dinner\"? I wasn't sure if it meant that its just giving you the space to eat privately or if its all included? <br><br>\nThanks in advance <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p><\/div><\/div>\nI assume it would mean it's all included, but I'd definitely check with the coordinator.  She's great with answering questions. <br><br><br>\nSent from my SM-G930W8 using Tapatalk<br \/><p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Kfred, on 05 March 2016 - 08:10 AM, said:<\/p><div class='blockquote'><div class='quote'><p>Thank you so much @<a hovercard-ref=\"member\" hovercard-id=\"285764\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/285764-tpenner\/' title='Member profile'><span itemprop=\"name\">tpenner<\/span><\/a> for responding with all of these details! so sorry it took me long to respond - my daughter is teething and has had a cold so it's been a rough week to sit down at the puter...<br><br>\nWe too are going with the Caribbean Fantasy package. I am aiming for the gazebo but really like your point of not seeing\/using the natural beauty of the beach\/ocean which was always the plan while searching for our destination we always said on the beach, so who knows this one might change still. I really do love the gazebo though, it is so unique! Do you know how many guests you can have at this location though? We are inviting approx 80 people (not sure how many will come but I suspect at least 60). The resort asked if we would like 4pm, 5pm, or 6pm for our ceremony. We chose 4pm as that's what my fiance wanted - personally I was thinking 5 would be better, it's so bloody hot out still at 4 lol I'm gonna be a mess! Maybe another good reason for the gazebo to have some guaranteed shade.<br><br>\nI haven't seen any photos or good information on how the reception is set up on the beach, have you?! For now, we are moving forward with planning for the rooftop terrace. But there are so many details to figure out for the reception like table settings, centerpieces, flowers, etc. I'm trying to figure out what I will bring with me for our own set up or what we will pay the resort to do. I haven't really seen examples of what they can do for centerpieces etc. (can't get over the upcharge for every little thing like even a napkin ring holder!!). I've heard of other brides (other resorts) bringing their own materials for centerpieces, their own table runners and other decorations. What are your plans for that?<br><br>\nAlso will pay for the extra hour, I can't imagine shutting the party down at 10 - and as far as I've heard the resort DJ is just fine for the event so will be going that way. I haven't even begun researching photographers\/prices - amazing that it's cheaper for you to bring them with you from Edmonton (we are from Winnipeg). So hopefully I'll get to see some work from the resort photographer soon so I can move forward with planning on that front.<br><br>\nOne of my bridesmaids is a hair stylist so I'm super lucky in that regard. I think I'm going to give the resort salon a try for the make up application. I think that if I really don't like it, I'll wash it off and do my makeup myself.<br><br>\nHave you decided on buffet or plated dinner? how about your colors\/theme?<br><br>\ntalk soon and thanks!<\/p><\/div><\/div>\nWow..it's even a long time since I've been on here!<br><br>\nSo I was able to send an email to the coordinator and ask some questions.  Good  news!  They aren't charging us anything extra to have our reception on the rooftop!  I haven't put any thought into the buffet\/plated dinner.   <br><br>\nAs for colors, we are having an aqua green and coral.<br><br>\nI feel like planning is at a standstill until we have to figure out the details.  <br><br>\nSent from my SM-G930W8 using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tpenner@ualberta.ca","IpAddress":"68.150.177.36","GroupId":3,"GroupName":"Member","JoinDate":1451963669,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-285764.jpg?_r=1451960071","PhotoWidth":200,"PhotoHeight":122,"PhotoType":"custom"},"FormattedName":"tpenner","Id":285764,"Name":"tpenner","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"189.221.32.251","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79963,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5bcf33bcbb8a85f1af2e54f5e3aa100d","RawContent":"&lt;p&gt;HI @[member=\"tpenner\"] just looking over your message from earlier this year and noted that you&#039;d received a hair and makeup quote from us. In the event you have not yet selected a hair and makeup vendor, I thought I&#039;d bring it to you attention that we now have another brand we&#039;ve recently started called La Bonita, it&#039;s also part of Styling Trio. Where the packages and pricing may work better for what you&#039;re looking for. If interested in learning more you can contact sales@stylingtrio.com. HAPPY PLANNING!&lt;\/p&gt;","Attachments":[],"Id":1914078,"PostDate":1464634512,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>HI @<a hovercard-ref=\"member\" hovercard-id=\"285764\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/285764-tpenner\/' title='Member profile'><span itemprop=\"name\">tpenner<\/span><\/a> just looking over your message from earlier this year and noted that you'd received a hair and makeup quote from us. In the event you have not yet selected a hair and makeup vendor, I thought I'd bring it to you attention that we now have another brand we've recently started called La Bonita, it's also part of Styling Trio. Where the packages and pricing may work better for what you're looking for. If interested in learning more you can contact sales@stylingtrio.com. HAPPY PLANNING!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p style=\"font-family:arial, helvetica, sans-serif;color:rgb(90,90,90);\"><span style=\"font-size:18px;\"><span style=\"font-family:'lucida sans unicode', 'lucida grande', sans-serif;\">Dena DaSilva<\/span><\/span><\/p>\n<p style=\"font-family:arial, helvetica, sans-serif;color:rgb(90,90,90);\"><span style=\"font-size:18px;\"><span style=\"font-family:'lucida sans unicode', 'lucida grande', sans-serif;\">Online Concierge<\/span><\/span><\/p>\n<p style=\"font-family:arial, helvetica, sans-serif;color:rgb(90,90,90);\"><span style=\"color:#ff99cc;\"><span style=\"font-size:18px;\"><span style=\"font-family:'lucida sans unicode', 'lucida grande', sans-serif;\">US (+1) 713 589 4558<\/span><\/span><\/span><\/p>\n<p style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"font-family:'lucida sans unicode', 'lucida grande', sans-serif;\"><span style=\"font-size:18px;\"><span style=\"color:rgb(90,90,90);\"><span style=\"color:#ff99cc;\">MX (+52) 984 803 2816<br>\nconcierge@stylingtrio.com<\/span><\/span><br><span style=\"color:#ff99cc;\">www.stylingtrio.com<\/span><br><br><span style=\"color:rgb(105,105,105);\">Facebook: <\/span><span style=\"color:#ff99cc;\">facebook\/stylingtrio.com<\/span><br><span style=\"color:rgb(105,105,105);\">Twitter:<\/span><span style=\"color:rgb(238,130,238);\">\u00a0<\/span><span style=\"color:rgb(255,153,204);\">@stylingtrio<\/span><br><span style=\"color:rgb(105,105,105);\">Instagram:<\/span><span style=\"color:rgb(238,130,238);\">\u00a0<\/span><span style=\"color:rgb(255,153,204);\">@stylingtrio<\/span><br><span style=\"color:rgb(105,105,105);\">Pinterest: <\/span><span style=\"color:#ff99cc;\">www.pinterest.com\/stylingtrio<\/span><\/span><\/span><\/p>\n<p style=\"font-family:arial, helvetica, sans-serif;color:rgb(90,90,90);\">\u00a0<\/p>\n<p style=\"font-family:arial, helvetica, sans-serif;color:rgb(90,90,90);\"><span style=\"color:rgb(34,34,34);font-family:'Helvetica Neue', Arial, Verdana, sans-serif;\">\u00a0<\/span><\/p>\n<p style=\"font-family:arial, helvetica, sans-serif;color:rgb(90,90,90);\"><img src=\"https:\/\/ci4.googleusercontent.com\/proxy\/hapv1CMGpXYv2FEz6ZYtPWd2Y_yEKx8fi8QHoF6qa6giBtQe5Sq7Qu37JOO6-9XwSHFc1cI6Ke5Y2N3x9Ue9=s0-d-e1-ft#http:\/\/stylingtrio.com\/Firmas\/Styling.jpg\" alt=\"Styling.jpg\"><\/p>\n<p style=\"font-family:arial, helvetica, sans-serif;color:rgb(90,90,90);\">\u00a0<\/p>\n<p style=\"font-family:arial, helvetica, sans-serif;color:rgb(90,90,90);\">\u00a0","Email":"social@stylingtrio.com","IpAddress":"189.221.40.208","GroupId":84,"GroupName":"Insiders w\/ Articles","JoinDate":1462483132,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286883.jpg?_r=1463007029","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"StylingTrioRivieraMaya","Id":286883,"Name":"StylingTrioRivieraMaya","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"184.151.222.93","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79963,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9ccebede10fff3cf790bb429c9e439b7","RawContent":"[quote name=\"StylingTrioRivieraMaya\" post=\"1914078\" timestamp=\"1464630912\"]\nHI @[member=\"tpenner\"] just looking over your message from earlier this year and noted that you&#039;d received a hair and makeup quote from us. In the event you have not yet selected a hair and makeup vendor, I thought I&#039;d bring it to you attention that we now have another brand we&#039;ve recently started called La Bonita, it&#039;s also part of Styling Trio. Where the packages and pricing may work better for what you&#039;re looking for. If interested in learning more you can contact sales@stylingtrio.com. HAPPY PLANNING![\/quote]I have already booked with someone else in the meantime. \n\nSent from my SM-G930W8 using Tapatalk","Attachments":[],"Id":1914179,"PostDate":1464998809,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>StylingTrioRivieraMaya, on 30 May 2016 - 10:55 AM, said:<\/p><div class='blockquote'><div class='quote'><p>HI @<a hovercard-ref=\"member\" hovercard-id=\"285764\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/285764-tpenner\/' title='Member profile'><span itemprop=\"name\">tpenner<\/span><\/a> just looking over your message from earlier this year and noted that you'd received a hair and makeup quote from us. In the event you have not yet selected a hair and makeup vendor, I thought I'd bring it to you attention that we now have another brand we've recently started called La Bonita, it's also part of Styling Trio. Where the packages and pricing may work better for what you're looking for. If interested in learning more you can contact sales@stylingtrio.com. HAPPY PLANNING!<\/p><\/div><\/div>\nI have already booked with someone else in the meantime. <br><br>\nSent from my SM-G930W8 using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tpenner@ualberta.ca","IpAddress":"68.150.177.36","GroupId":3,"GroupName":"Member","JoinDate":1451963669,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-285764.jpg?_r=1451960071","PhotoWidth":200,"PhotoHeight":122,"PhotoType":"custom"},"FormattedName":"tpenner","Id":285764,"Name":"tpenner","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"187.136.105.16","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79963,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7cb9ccce375aa85ce3d3bce392c4293b","RawContent":"&lt;p&gt;hola Kfred, congratulations on your upcoming wedding! Sandos Caracol is a beautiful resort, the staff are so helpful and friendly and the grounds are absolutely lovely. You are going to have a wonderful time there.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;The rooftop terrace for your reception is a great location. It&#039;s spacious and private. You and your guests can let loose, have fun and not worry about randoms coming and going :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;It&#039;s great to hear that you&#039;re from Winnipeg, so are we!!!&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;If you&#039;re looking for some inspiration check out the following galleries from our previous weddings and Sandos Caracol.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;If you have any questions at all, about sandos or about wedding planning in general please do not hesitate to ask us here, or in a private message or email.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.jasminandmatt.com\/portfolio\/deanna-stephanie\/&#039;&gt;http:\/\/www.jasminandmatt.com\/portfolio\/deanna-stephanie\/&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.jasminandmatt.com\/portfolio\/tiffany-sean\/&#039;&gt;http:\/\/www.jasminandmatt.com\/portfolio\/tiffany-sean\/&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Us friendly Manitobans gotta stick together ;)&lt;\/p&gt;","Attachments":[],"Id":1914223,"PostDate":1465314338,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>hola Kfred, congratulations on your upcoming wedding! Sandos Caracol is a beautiful resort, the staff are so helpful and friendly and the grounds are absolutely lovely. You are going to have a wonderful time there.<\/p>\n<p>\u00a0<\/p>\n<p>The rooftop terrace for your reception is a great location. It's spacious and private. You and your guests can let loose, have fun and not worry about randoms coming and going <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>It's great to hear that you're from Winnipeg, so are we!!!\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>If you're looking for some inspiration check out the following galleries from our previous weddings and Sandos Caracol.<\/p>\n<p>\u00a0<\/p>\n<p>If you have any questions at all, about sandos or about wedding planning in general please do not hesitate to ask us here, or in a private message or email.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><a href='http:\/\/www.jasminandmatt.com\/portfolio\/deanna-stephanie\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.jasminand...anna-stephanie\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a href='http:\/\/www.jasminandmatt.com\/portfolio\/tiffany-sean\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.jasminand...o\/tiffany-sean\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Us friendly Manitobans gotta stick together <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/www.jasminandmatt.com\/wp-content\/uploads\/2016\/05\/jasminandmattidomexicosignature.png\" alt=\"jasminandmattidomexicosignature.png\"><\/p>\n<p><strong>Website:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);font-size:14px;\"><a data-ipb='nomediaparse' href='http:\/\/www.jasminandmatt.com\/'>http:\/\/www.jasminandmatt.com<\/a><\/span><br><strong>Email:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);font-size:14px;\"><a data-ipb='nomediaparse' href='mailto:info@jasminandmatt.com'>info@jasminandmatt.com<\/a><\/span><br><strong>Phone:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);font-size:14px;\">+52 984-114-3386<\/span><br><strong>Facebook:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);font-size:14px;\"><a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/jasminandmatt\/'>Jasmin & Matt Photography<\/a><\/span><br><strong>Instagram:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);font-size:14px;\"><a data-ipb='nomediaparse' href='https:\/\/www.instagram.com\/jasminandmattphotography\/'>@jasminandmattphotography<\/a><\/span><br><strong>Pinterest:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);font-size:14px;\"><a data-ipb='nomediaparse' href='https:\/\/www.pinterest.com\/jasminandmatt'>Jasmin & Matt<\/a><\/span><\/p>\n<p>\u00a0","Email":"forward@jasminandmatt.com","IpAddress":"187.153.21.84","GroupId":49,"GroupName":"Insiders","JoinDate":1464799539,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-287055.jpg?_r=1464796174","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"JasminMattPhoto","Id":287055,"Name":"JasminMattPhoto","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"204.209.132.150","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79963,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"c4d472d8a65e769986675781debbb985","RawContent":"[quote name=\"JasminMattPhoto\" post=\"1914223\" timestamp=\"1465310738\"]\nhola Kfred, congratulations on your upcoming wedding! Sandos Caracol is a beautiful resort, the staff are so helpful and friendly and the grounds are absolutely lovely. You are going to have a wonderful time there.\n\nThe rooftop terrace for your reception is a great location. It&#039;s spacious and private. You and your guests can let loose, have fun and not worry about randoms coming and going :)\n\nIt&#039;s great to hear that you&#039;re from Winnipeg, so are we!!! \n\nIf you&#039;re looking for some inspiration check out the following galleries from our previous weddings and Sandos Caracol.\n\nIf you have any questions at all, about sandos or about wedding planning in general please do not hesitate to ask us here, or in a private message or email. \n\n[url=\"http:\/\/www.jasminandmatt.com\/portfolio\/deanna-stephanie\/\"]http:\/\/www.jasminandmatt.com\/portfolio\/deanna-stephanie\/[\/url]\n\n[url=\"http:\/\/www.jasminandmatt.com\/portfolio\/tiffany-sean\/\"]http:\/\/www.jasminandmatt.com\/portfolio\/tiffany-sean\/[\/url]\n\nUs friendly Manitobans gotta stick together ;)[\/quote]It&#039;s so nice to see pictures from our resort!  Thanks!\n\n\nSent from my SM-G930W8 using Tapatalk","Attachments":[],"Id":1914244,"PostDate":1465334948,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>JasminMattPhoto, on 07 June 2016 - 07:45 AM, said:<\/p><div class='blockquote'><div class='quote'><p>hola Kfred, congratulations on your upcoming wedding! Sandos Caracol is a beautiful resort, the staff are so helpful and friendly and the grounds are absolutely lovely. You are going to have a wonderful time there.<br><br>\nThe rooftop terrace for your reception is a great location. It's spacious and private. You and your guests can let loose, have fun and not worry about randoms coming and going <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br><br>\nIt's great to hear that you're from Winnipeg, so are we!!! <br><br>\nIf you're looking for some inspiration check out the following galleries from our previous weddings and Sandos Caracol.<br><br>\nIf you have any questions at all, about sandos or about wedding planning in general please do not hesitate to ask us here, or in a private message or email. <br><br><a href='http:\/\/www.jasminandmatt.com\/portfolio\/deanna-stephanie\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.jasminand...anna-stephanie\/<\/a><br><br><a href='http:\/\/www.jasminandmatt.com\/portfolio\/tiffany-sean\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.jasminand...o\/tiffany-sean\/<\/a><br><br>\nUs friendly Manitobans gotta stick together <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/><\/p><\/div><\/div>\nIt's so nice to see pictures from our resort!  Thanks!<br><br><br>\nSent from my SM-G930W8 using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tpenner@ualberta.ca","IpAddress":"68.150.177.36","GroupId":3,"GroupName":"Member","JoinDate":1451963669,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-285764.jpg?_r=1451960071","PhotoWidth":200,"PhotoHeight":122,"PhotoType":"custom"},"FormattedName":"tpenner","Id":285764,"Name":"tpenner","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.114.37.235","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79963,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"e42f7141c6e62fe92e12cdbc11925f95","RawContent":"Finally a Winnipeger Bride on here. I thought I was alone. Congrats on your upcoming wedding!\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1914245,"PostDate":1465335218,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Finally a Winnipeger Bride on here. I thought I was alone. Congrats on your upcoming wedding!<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"setteewedding@gmail.com","IpAddress":"207.161.145.102","GroupId":39,"GroupName":"Newbie","JoinDate":1456280677,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286318.jpg?_r=1456278648","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"WPGBride17","Id":286318,"Name":"WPGBride17","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"189.221.42.59","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79963,"EditedBy":"","EditDate":1465349748,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"85e391d6f347602e8d2ac97f7f083e2f","RawContent":"&lt;p&gt;@[member=\"Kfred\"] Welcome to the BDW Community and congrats on your upcoming wedding! Sandos Caracol is beautiful. What a nice location you will love it. You&#039;ve come to the right place to find helpful tips and advice for your Riviera Maya, Mexico wedding. if we can be of any assistance just let us know. We at Styling Trio have worked with many resorts and wedding planners and vendors and could be able to answer some of your questions. So enjoy your wedding planning and here&#039;s a helpful tip in case you&#039;re interested in getting professional hair and makeup done on your special day. This is a great article on how to keep your makeup in tip top shape that day in a tropical climate like here in Riviera Maya Mexico! &amp;nbsp;Check out link below and HAPPY PLANNING! &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/wedding-tips\/c\/planning\/q-a-is-airbrush-makeup-ideal-in-a-tropic-r2326%C2%A0&#039;&gt;http:\/\/www.bestdestinationwedding.com\/wedding-tips\/c\/planning\/q-a-is-airbrush-makeup-ideal-in-a-tropic-r2326&amp;nbsp;&lt;\/a&gt;&lt;\/p&gt;","Attachments":[],"Id":1914251,"PostDate":1465349721,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"286259\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/286259-kfred\/' title='Member profile'><span itemprop=\"name\">Kfred<\/span><\/a> Welcome to the BDW Community and congrats on your upcoming wedding! Sandos Caracol is beautiful. What a nice location you will love it. You've come to the right place to find helpful tips and advice for your Riviera Maya, Mexico wedding. if we can be of any assistance just let us know. We at Styling Trio have worked with many resorts and wedding planners and vendors and could be able to answer some of your questions. So enjoy your wedding planning and here's a helpful tip in case you're interested in getting professional hair and makeup done on your special day. This is a great article on how to keep your makeup in tip top shape that day in a tropical climate like here in Riviera Maya Mexico! \u00a0Check out link below and HAPPY PLANNING! <a href='http:\/\/www.bestdestinationwedding.com\/wedding-tips\/c\/planning\/q-a-is-airbrush-makeup-ideal-in-a-tropic-r2326%C2%A0' class='bbc_url' title=''>http:\/\/www.bestdesti...a-tropic-r2326\u00a0<\/a><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p style=\"font-family:arial, helvetica, sans-serif;color:rgb(90,90,90);\"><span style=\"font-size:18px;\"><span style=\"font-family:'lucida sans unicode', 'lucida grande', sans-serif;\">Dena DaSilva<\/span><\/span><\/p>\n<p style=\"font-family:arial, helvetica, sans-serif;color:rgb(90,90,90);\"><span style=\"font-size:18px;\"><span style=\"font-family:'lucida sans unicode', 'lucida grande', sans-serif;\">Online Concierge<\/span><\/span><\/p>\n<p style=\"font-family:arial, helvetica, sans-serif;color:rgb(90,90,90);\"><span style=\"color:#ff99cc;\"><span style=\"font-size:18px;\"><span style=\"font-family:'lucida sans unicode', 'lucida grande', sans-serif;\">US (+1) 713 589 4558<\/span><\/span><\/span><\/p>\n<p style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"font-family:'lucida sans unicode', 'lucida grande', sans-serif;\"><span style=\"font-size:18px;\"><span style=\"color:rgb(90,90,90);\"><span style=\"color:#ff99cc;\">MX (+52) 984 803 2816<br>\nconcierge@stylingtrio.com<\/span><\/span><br><span style=\"color:#ff99cc;\">www.stylingtrio.com<\/span><br><br><span style=\"color:rgb(105,105,105);\">Facebook: <\/span><span style=\"color:#ff99cc;\">facebook\/stylingtrio.com<\/span><br><span style=\"color:rgb(105,105,105);\">Twitter:<\/span><span style=\"color:rgb(238,130,238);\">\u00a0<\/span><span style=\"color:rgb(255,153,204);\">@stylingtrio<\/span><br><span style=\"color:rgb(105,105,105);\">Instagram:<\/span><span style=\"color:rgb(238,130,238);\">\u00a0<\/span><span style=\"color:rgb(255,153,204);\">@stylingtrio<\/span><br><span style=\"color:rgb(105,105,105);\">Pinterest: <\/span><span style=\"color:#ff99cc;\">www.pinterest.com\/stylingtrio<\/span><\/span><\/span><\/p>\n<p style=\"font-family:arial, helvetica, sans-serif;color:rgb(90,90,90);\">\u00a0<\/p>\n<p style=\"font-family:arial, helvetica, sans-serif;color:rgb(90,90,90);\"><span style=\"color:rgb(34,34,34);font-family:'Helvetica Neue', Arial, Verdana, sans-serif;\">\u00a0<\/span><\/p>\n<p style=\"font-family:arial, helvetica, sans-serif;color:rgb(90,90,90);\"><img src=\"https:\/\/ci4.googleusercontent.com\/proxy\/hapv1CMGpXYv2FEz6ZYtPWd2Y_yEKx8fi8QHoF6qa6giBtQe5Sq7Qu37JOO6-9XwSHFc1cI6Ke5Y2N3x9Ue9=s0-d-e1-ft#http:\/\/stylingtrio.com\/Firmas\/Styling.jpg\" alt=\"Styling.jpg\"><\/p>\n<p style=\"font-family:arial, helvetica, sans-serif;color:rgb(90,90,90);\">\u00a0<\/p>\n<p style=\"font-family:arial, helvetica, sans-serif;color:rgb(90,90,90);\">\u00a0","Email":"social@stylingtrio.com","IpAddress":"189.221.40.208","GroupId":84,"GroupName":"Insiders w\/ Articles","JoinDate":1462483132,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286883.jpg?_r=1463007029","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"StylingTrioRivieraMaya","Id":286883,"Name":"StylingTrioRivieraMaya","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"187.136.105.16","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79963,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3338b75c802ad1930a753f6de7768662","RawContent":"&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;p&gt;@[member=\"tpenner\"] We know how important it is to brides to see wedding photos utilizing their chosen resorts. It&#039;s a perfect chance to really give you a feel for the space, and what&#039;s all possible. Since you appreciated those, I figured I would also include a few photos of the makeup Besos Brides did for a recent bride of ours. We have been fortunate enough to work with both Styling Trio and Besos Brides and would recommend both companies! And our brides also highlight how happy they&#039;ve been both both companies.\n\n\n\n\n\n\n\n@[member=\"Kfred\"] You expressed concern for the amount of guests that are able to fit within the ceremony structure on the beach at Sandos Caracol, so I am including a photo to help show just how much space there is to this unique setting. The majority of the weddings we photographed there, the couples have opted for the rooftop terrace for the reception. This space is beautifully set up, offers plenty of space, has a shallow pool in the center that looks great in photos, with the ocean in the background. The lighting is great up on the roof as well, for the speeches, dancing, drinking and overall partying afterwards, as you can see from the included images. One couple we photographed (who opted to only hire us until the reception) did have their reception on the beach, and the space that is set up is beside the beach structure, with your own bar set up for your guests too. The space definitely feels tighter than on the rooftop (if you&#039;re concerned with 60 guests being comfortable in the space all night). Hope this helps! And let us know if you have any other questions regarding the resort, or otherwise. As Winnipeggers ourselves, who decided to move to the Riviera Maya and photograph weddings full time, we love being able to help other fellow Canadians, and more specifically, other fellow Winnipeggers\/Manitobans.&amp;nbsp;\n\n\n\n\n\n\n&lt;\/p&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;","Attachments":[],"Id":1914271,"PostDate":1465413387,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div>\u00a0<\/div>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"285764\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/285764-tpenner\/' title='Member profile'><span itemprop=\"name\">tpenner<\/span><\/a> We know how important it is to brides to see wedding photos utilizing their chosen resorts. It's a perfect chance to really give you a feel for the space, and what's all possible. Since you appreciated those, I figured I would also include a few photos of the makeup Besos Brides did for a recent bride of ours. We have been fortunate enough to work with both Styling Trio and Besos Brides and would recommend both companies! And our brides also highlight how happy they've been both both companies.<br><br>\n<a class='resized_img' rel='lightbox[1914271]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_06_2016\/post-287055-0-52021000-1465409656.jpg\" title=\"Sam_Seb_Teaser_17.jpg -  60.04KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_06_2016\/post-287055-0-52021000-1465409656.jpg\" class='bbc_img linked-image' alt=\"Sam_Seb_Teaser_17.jpg\" \/><\/a>\n\n<br>\n<a class='resized_img' rel='lightbox[1914271]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_06_2016\/post-287055-0-37656000-1465409643.jpg\" title=\"Sam_Seb_Teaser_03.jpg -  131.58KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_06_2016\/post-287055-0-37656000-1465409643.jpg\" class='bbc_img linked-image' alt=\"Sam_Seb_Teaser_03.jpg\" \/><\/a>\n\n<br><br>\n@<a hovercard-ref=\"member\" hovercard-id=\"286259\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/286259-kfred\/' title='Member profile'><span itemprop=\"name\">Kfred<\/span><\/a> You expressed concern for the amount of guests that are able to fit within the ceremony structure on the beach at Sandos Caracol, so I am including a photo to help show just how much space there is to this unique setting. The majority of the weddings we photographed there, the couples have opted for the rooftop terrace for the reception. This space is beautifully set up, offers plenty of space, has a shallow pool in the center that looks great in photos, with the ocean in the background. The lighting is great up on the roof as well, for the speeches, dancing, drinking and overall partying afterwards, as you can see from the included images. One couple we photographed (who opted to only hire us until the reception) did have their reception on the beach, and the space that is set up is beside the beach structure, with your own bar set up for your guests too. The space definitely feels tighter than on the rooftop (if you're concerned with 60 guests being comfortable in the space all night). Hope this helps! And let us know if you have any other questions regarding the resort, or otherwise. As Winnipeggers ourselves, who decided to move to the Riviera Maya and photograph weddings full time, we love being able to help other fellow Canadians, and more specifically, other fellow Winnipeggers\/Manitobans.\u00a0<br><br>\n<a class='resized_img' rel='lightbox[1914271]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_06_2016\/post-287055-0-87621900-1465409582.jpg\" title=\"Debbie_Kris_Teaser_16.jpg -  181.58KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_06_2016\/post-287055-0-87621900-1465409582.jpg\" class='bbc_img linked-image' alt=\"Debbie_Kris_Teaser_16.jpg\" \/><\/a>\n\n<br>\n<a class='resized_img' rel='lightbox[1914271]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_06_2016\/post-287055-0-62535700-1465409357.jpg\" title=\"Tiffany_Sean_Web_046.jpg -  92.19KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_06_2016\/post-287055-0-62535700-1465409357.jpg\" class='bbc_img linked-image' alt=\"Tiffany_Sean_Web_046.jpg\" \/><\/a>\n\n<br>\n<a class='resized_img' rel='lightbox[1914271]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_06_2016\/post-287055-0-30753900-1465409365.jpg\" title=\"Tiffany_Sean_Web_048.jpg -  113.71KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_06_2016\/post-287055-0-30753900-1465409365.jpg\" class='bbc_img linked-image' alt=\"Tiffany_Sean_Web_048.jpg\" \/><\/a>\n\n<\/p>\n<div>\u00a0<\/div>\n<div>\u00a0<\/div>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/www.jasminandmatt.com\/wp-content\/uploads\/2016\/05\/jasminandmattidomexicosignature.png\" alt=\"jasminandmattidomexicosignature.png\"><\/p>\n<p><strong>Website:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);font-size:14px;\"><a data-ipb='nomediaparse' href='http:\/\/www.jasminandmatt.com\/'>http:\/\/www.jasminandmatt.com<\/a><\/span><br><strong>Email:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);font-size:14px;\"><a data-ipb='nomediaparse' href='mailto:info@jasminandmatt.com'>info@jasminandmatt.com<\/a><\/span><br><strong>Phone:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);font-size:14px;\">+52 984-114-3386<\/span><br><strong>Facebook:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);font-size:14px;\"><a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/jasminandmatt\/'>Jasmin & Matt Photography<\/a><\/span><br><strong>Instagram:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);font-size:14px;\"><a data-ipb='nomediaparse' href='https:\/\/www.instagram.com\/jasminandmattphotography\/'>@jasminandmattphotography<\/a><\/span><br><strong>Pinterest:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);font-size:14px;\"><a data-ipb='nomediaparse' href='https:\/\/www.pinterest.com\/jasminandmatt'>Jasmin & Matt<\/a><\/span><\/p>\n<p>\u00a0","Email":"forward@jasminandmatt.com","IpAddress":"187.153.21.84","GroupId":49,"GroupName":"Insiders","JoinDate":1464799539,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-287055.jpg?_r=1464796174","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"JasminMattPhoto","Id":287055,"Name":"JasminMattPhoto","IsOnline":false}}],"Pages":{"TotalItems":19,"TotalPages":2,"CurrentPage":10,"NextPage":-1,"PreviousPage":0,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
