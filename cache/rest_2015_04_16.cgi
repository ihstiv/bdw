{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":true,"CanReply":true,"CanFollow":true,"TotalPosts":1,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":0,"MovedTo":null,"MovedOn":0,"FirstPostId":1893367,"Rating":0,"RatingHits":0,"Starter":{"Id":282681,"Name":"Shaylala","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":true},"StartDate":1429207329,"LastPoster":{"Id":282681,"Name":"Shaylala","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":true},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1893367,"PostDate":1429207329,"PostContent":"Ok Brides..I need help! For those of you from Canada..<br>\nI know I can look this stuff up on the internet but I'd like some first hand information.<br>\nWhat is the different between the requirement for getting legally married in Dominican & Mexico. Also, what is the cost associated?  How much work is it for each place and how much will it cost?<br><br>\nI've been hearing that Dominican is a lot of work and can cost between $600-$1000 for document translation.<br><br>\nI'd love some real life examples of what exactly you had to do for documents and the cost for both places! Thank you!!! ","Author":{"Signature":"","Email":"shayla.mcmahon@shaw.ca","IpAddress":"70.73.72.212","GroupId":39,"GroupName":"Newbie","JoinDate":1428547145,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Shaylala","Id":2826