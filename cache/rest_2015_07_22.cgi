{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":3,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":112,"MovedTo":null,"MovedOn":0,"FirstPostId":1900384,"Rating":0,"RatingHits":0,"Starter":{"Id":283948,"Name":"adrianaportela07","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1436829011,"LastPoster":{"Id":279978,"Name":"JJCB0418","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":22,"Preview":{"Id":1900384,"PostDate":1436829011,"PostContent":"Hello ladies  I'm already looking to book my wedding for 2016 at the beautiful resort in Bavaro b...","Author":{"Signature":"","Email":"adrianaportela07@gmail.com","IpAddress":"99.236.231.216","GroupId":3,"GroupName":"Member","JoinDate":1436826936,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"adrianaportela07","Id":283948,"Name":"adrianaportela07","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.236.231.216","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79382,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d6d64c36f92711979d0e3aa30a3aed4e","RawContent":"Hello ladies \n\n\nI&#039;m already looking to book my wedding for 2016 at the beautiful resort in Bavaro but I have some questions and would love to connect with any past brides or new brides that are going to the same resort ...\n\n\nMy main concern is the guest list .\n\nWe have a total of 91 invitations to be sent but we don&#039;t think all of them are going to show up..in the Package that I choose ( mint breeze ) says is for 20 guest.. Any idea how much it will be extra per chair and maybe per plate for the restaurant? \n\nI emailed the wedding coordinator but I haven&#039;t heard back yet :( \n\n\nAny help will be highly appreciated.\n\n\n\nThanks \n\n\n\nAdriana \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1900384,"PostDate":1436829011,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hello ladies <br><br>\nI'm already looking to book my wedding for 2016 at the beautiful resort in Bavaro but I have some questions and would love to connect with any past brides or new brides that are going to the same resort ...<br><br>\nMy main concern is the guest list .<br>\nWe have a total of 91 invitations to be sent but we don't think all of them are going to show up..in the Package that I choose ( mint breeze ) says is for 20 guest.. Any idea how much it will be extra per chair and maybe per plate for the restaurant? <br>\nI emailed the wedding coordinator but I haven't heard back yet <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/sad.png' class='bbc_emoticon' alt=':(' \/> <br><br>\nAny help will be highly appreciated.<br><br><br>\nThanks <br><br><br>\nAdriana <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"adrianaportela07@gmail.com","IpAddress":"99.236.231.216","GroupId":3,"GroupName":"Member","JoinDate":1436826936,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"adrianaportela07","Id":283948,"Name":"adrianaportela07","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.87.237.201","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79382,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8f8a16782a294de24d9e980e50a31fbc","RawContent":"&lt;p&gt;Congrats! Have you tried searching up top for the resort you&#039;re considering? Its definitely worth reading through the site to see if past brides have provided comments. You could also look through the resort reviews section to see if any past brides have written about their experience.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck and happy planning!&lt;\/p&gt;","Attachments":[],"Id":1900442,"PostDate":1436884410,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats! Have you tried searching up top for the resort you're considering? Its definitely worth reading through the site to see if past brides have provided comments. You could also look through the resort reviews section to see if any past brides have written about their experience.<\/p>\n<p>\u00a0<\/p>\n<p>Good luck and happy planning!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"171.161.160.10","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79382,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"db3af418c5923179b8d0530c744e61e0","RawContent":"&lt;p&gt;Hi Adriana,&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I had the Tangerine package and paid $60 for additional guests.&amp;nbsp; I&#039;m sure it&#039;s probably the same for the Mint package.&amp;nbsp; I&#039;m sure your coordinator will get back to you soon for confirmation!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Best of luck - it&#039;ll be beautiful!&lt;\/p&gt;","Attachments":[],"Id":1900452,"PostDate":1436888346,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Adriana,<\/p>\n<p>\u00a0<\/p>\n<p>I had the Tangerine package and paid $60 for additional guests.\u00a0 I'm sure it's probably the same for the Mint package.\u00a0 I'm sure your coordinator will get back to you soon for confirmation!<\/p>\n<p>\u00a0<\/p>\n<p>Best of luck - it'll be beautiful!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jenique.brown@yahoo.com","IpAddress":"171.159.64.10","GroupId":39,"GroupName":"Newbie","JoinDate":1411557695,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"JJCB0418","Id":279978,"Name":"JJCB0418","IsOnline":false}}],"Id":"79382","Title":"Barcelo Bavaro Resort ! Help!","LastPostDate":1436888346},"Pages":{"TotalItems":3,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
