> User jacquewedding (283943)
Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":4,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":true,"Views":161,"MovedTo":null,"MovedOn":0,"FirstPostId":1900380,"Rating":0,"RatingHits":0,"Starter":{"Id":279604,"Name":"Andrea2015","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"custom"},"IsOnline":false},"StartDate":1436827879,"LastPoster":{"Id":232000,"Name":"acw271011","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":22,"Preview":{"Id":1900380,"PostDate":1436827879,"PostContent":"Hi all,\u00a0 \u00a0 I just returned back to Canada last night after spending just over a week in Punta Can...","Author":{"Signature":"","Email":"andreacorsi2012@gmail.com","IpAddress":"174.0.176.157","GroupId":39,"GroupName":"Newbie","JoinDate":1409175969,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"custom"},"FormattedName":"Andrea2015","Id":279604,"Name":"Andrea2015","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.0.176.157","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79381,"EditedBy":"<strong>Edited by Andrea2015, 13 July 2015 - 11:19 PM.<\/strong>","EditDate":1436829556,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"0156b1f5950b22396b8a2471cd8e57de","RawContent":"&lt;p&gt;Hi all,&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I just returned back to Canada last night after spending just over a week in Punta Cana for my wedding. So I thought I&#039;d share my experience with you all.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I had never been to Punta Cana before so I was unsure as what to expect and I was not disappointed. I had picked the Iberostar because we had stayed at one of their hotels in Jamaica a few years ago and the staff and the hotel was amazing so we based our decision on that. Once we arrived after 2 plane rides (one with 5 hour layover) and drove up to the hotel I was blown away. The hotel is absolutely stunning and actually looked just like the pictures. We went to check in and were told that we were upgraded to the Grand hotel ( which is only a 5 minute walk from where our guests were staying). The room was of course.... amazing and the staff was so welcoming and friendly.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;This hotel is huge not gonna lie BUT my guests loved that cause it gave them a lot to do and they were never bored. The beach was nice however, it had A LOT of seaweed which I guess isn&#039;t too uncommon from this time of year and it didn&#039;t stop anyone from swimming in the ocean.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;The wedding day was absolutely perfect.... I expected some stuff to go wrong but not a single thing did. I didn&#039;t hire any outside vendors, I used the photographer &amp;amp; Dj from the resort and they I&#039;m glad I did. I got all my photos and I am so very happy with how they turned out. The DJ and MC were so fun and played all the songs that we requested. The MC was so funny and entertaining and everyone at the wedding had such a great time.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;If I could go back I wouldn&#039;t change a single thing we were happy with every decision we made. The wedding planner stuck around almost till the end to make sure everything went well. I had brought a ton of my own decor and they set it all up just how I asked them to. They decorated the reception just how I asked and I am soooo grateful for the hard work they put into ensuring my day was perfect.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Happy planning!!! AND my advice is to enjoy EVERY single minute of it cause it&#039;s over before you know it. I&#039;ve attached a few pics for you all to see :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Andrea&amp;nbsp;&lt;\/p&gt;","Attachments":[{"Id":33054,"Name":"wbastudio-78.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-279604-0-36775900-1436843104.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-279604-0-36775900-1436843104_thumb.jpg","Width":1000,"Height":666},{"Id":33055,"Name":"wbastudio-95.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-279604-0-63878800-1436843316.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-279604-0-63878800-1436843316_thumb.jpg","Width":799,"Height":1200},{"Id":33047,"Name":"wbastudio-205.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-279604-0-87373900-1436842151.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-279604-0-87373900-1436842151_thumb.jpg","Width":1000,"Height":666},{"Id":33056,"Name":"wbastudio-307.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-279604-0-83054300-1436843775.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-279604-0-83054300-1436843775_thumb.jpg","Width":1000,"Height":666},{"Id":33053,"Name":"wbastudio-9.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-279604-0-72745400-1436843041.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-279604-0-72745400-1436843041_thumb.jpg","Width":1000,"Height":666},{"Id":33057,"Name":"wbastudio-260.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-279604-0-52199100-1436843952.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-279604-0-52199100-1436843952_thumb.jpg","Width":1000,"Height":666}],"Id":1900380,"PostDate":1436827879,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi all,\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I just returned back to Canada last night after spending just over a week in Punta Cana for my wedding. So I thought I'd share my experience with you all.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I had never been to Punta Cana before so I was unsure as what to expect and I was not disappointed. I had picked the Iberostar because we had stayed at one of their hotels in Jamaica a few years ago and the staff and the hotel was amazing so we based our decision on that. Once we arrived after 2 plane rides (one with 5 hour layover) and drove up to the hotel I was blown away. The hotel is absolutely stunning and actually looked just like the pictures. We went to check in and were told that we were upgraded to the Grand hotel ( which is only a 5 minute walk from where our guests were staying). The room was of course.... amazing and the staff was so welcoming and friendly.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>This hotel is huge not gonna lie BUT my guests loved that cause it gave them a lot to do and they were never bored. The beach was nice however, it had A LOT of seaweed which I guess isn't too uncommon from this time of year and it didn't stop anyone from swimming in the ocean.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>The wedding day was absolutely perfect.... I expected some stuff to go wrong but not a single thing did. I didn't hire any outside vendors, I used the photographer & Dj from the resort and they I'm glad I did. I got all my photos and I am so very happy with how they turned out. The DJ and MC were so fun and played all the songs that we requested. The MC was so funny and entertaining and everyone at the wedding had such a great time.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>If I could go back I wouldn't change a single thing we were happy with every decision we made. The wedding planner stuck around almost till the end to make sure everything went well. I had brought a ton of my own decor and they set it all up just how I asked them to. They decorated the reception just how I asked and I am soooo grateful for the hard work they put into ensuring my day was perfect.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Happy planning!!! AND my advice is to enjoy EVERY single minute of it cause it's over before you know it. I've attached a few pics for you all to see <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Andrea\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"andreacorsi2012@gmail.com","IpAddress":"174.0.176.157","GroupId":39,"GroupName":"Newbie","JoinDate":1409175969,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"custom"},"FormattedName":"Andrea2015","Id":279604,"Name":"Andrea2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.75.116.50","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79381,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"9231210370940f35da98aab1c658a77a","RawContent":"So happy everything turned out GREAT!!","Attachments":[],"Id":1900381,"PostDate":1436828287,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                So happy everything turned out GREAT!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"pinkiesup08@gmail.com","IpAddress":"75.181.5.152","GroupId":47,"GroupName":"Site Supporter","JoinDate":1374599724,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-271841.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"RandL2015","Id":271841,"Name":"RandL2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.146.146.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79381,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"d486bbb20e21bd9c5d0a92dfc087be3e","RawContent":"Omg your photos are gorgeous!! I&#039;m so glad you had the wedding of your dreams!!!  Thank you so much for sharing. \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1900383,"PostDate":1436828661,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Omg your photos are gorgeous!! I'm so glad you had the wedding of your dreams!!!  Thank you so much for sharing. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.87.237.201","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79381,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"57e73f2eb364662a7ccb89850cd94075","RawContent":"&lt;p&gt;Congrats on being a Mrs! Your dress is stunning and you were a gorgeous bride!!! Your pictures are beautiful. Very happy it all turned out the way you wanted. Thanks for your review!&lt;\/p&gt;","Attachments":[],"Id":1900441,"PostDate":1436884239,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats on being a Mrs! Your dress is stunning and you were a gorgeous bride!!! Your pictures are beautiful. Very happy it all turned out the way you wanted. Thanks for your review!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}}],"Id":"79381","Title":"My Iberostar Bavaro Wedding","LastPostDate":1436884239},"Pages":{"TotalItems":4,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
