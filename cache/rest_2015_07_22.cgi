ine":false},"StartDate":1435760769,"LastPoster":{"Id":278581,"Name":"beckys98","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":23,"Preview":{"Id":1899604,"PostDate":1435760769,"PostContent":"Hello all, \u00a0 My fiance and I are planning our destination wedding hopefully early next summer. We...","Author":{"Signature":"","Email":"grimmy56789@yahoo.com","IpAddress":"50.207.94.226","GroupId":39,"GroupName":"Newbie","JoinDate":1435760032,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"none"},"FormattedName":"mgrimm412","Id":283773,"Name":"mgrimm412","IsOnline":false}},"Posts":[],"Id":"79337","Title":"Wedding In Jamaica","LastPostDate":1435777876},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":14,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":473,"MovedTo":null,"MovedOn":0,"FirstPostId":1899208,"Rating":0,"RatingHits":0,"Starter":{"Id":283672,"Name":"FutureMrsPaez","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1435164353,"LastPoster":{"Id":283672,"Name":"FutureMrsPaez","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":60,"Preview":{"Id":1899208,"PostDate":1435164353,"PostContent":"Earlier last week we brought up the idea of a DW in Mexico 11-3-15 (the anniversary of our first...","Author":{"Signature":"","Email":"toeshoes121@yahoo.com","IpAddress":"160.42.85.9","GroupId":39,"GroupName":"Newbie","JoinDate":1435160278,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"FutureMrsPaez","Id":283672,"Name":"FutureMrsPaez","IsOnline":false}},"Posts":[],"Id":"79316","Title":"Dw: Only Fi And I Before \"family\" Wedding? Yay Or Nay?","LastPostDate":1435261894},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":88,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":7581,"MovedTo":null,"MovedOn":0,"FirstPostId":1816208,"Rating":0,"RatingHits":0,"Starter":{"Id":275064,"Name":"27dress","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"custom"},"IsOnline":false},"StartDate":1385018382,"LastPoster":{"Id":250090,"Name":"dreamweddings","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250090.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1816208,"PostDate":1385018382,"PostContent":"Hello, I am a bride of 2016, any one else?and I'm new here.\u00a0 After reading so many threads, I was...","Author":{"Signature":"","Email":"27dressstore@gmail.com","IpAddress":"","GroupId":5,"GroupName":"Banned","JoinDate":1384485683,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"custom"},"FormattedName":"27dress","Id":275064,"Name":"27dress","IsOnline":false}},"Posts":[],"Id":"75627","Title":"Any other brides of 2016? Do we need to prepare now? ","LastPostDate":1435665976},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":6,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":494,"MovedTo":null,"MovedOn":0,"FirstPostId":1895559,"Rating":0,"RatingHits":0,"Starter":{"Id":282990,"Name":"knjones01","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1430944153,"LastPoster":{"Id":282406,"Name":"Lisa35","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282406.jpg?_r=1426179017","PhotoWidth":177,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1895559,"PostDate":1430944153,"PostContent":"Hey Ladies- \u00a0 I am still in the research stages of trying to narrow down my resort, and boyyy is...","Author":{"Signature":"","Email":"knjones01@gmail.com","IpAddress":"64.40.82.152","GroupId":39,"GroupName":"Newbie","JoinDate":1430879669,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"knjones01","Id":282990,"Name":"knjones01","IsOnline":false}},"Posts":[],"Id":"79156","Title":"2016 Bride Here! Looking To Get Married In Punta Cana","LastPostDate":1435324470},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":5,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":328,"MovedTo":null,"MovedOn":0,"FirstPostId":1895544,"Rating":0,"RatingHits":0,"Starter":{"Id":282892,"Name":"FutureMrsVanthof","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282892.jpg?_r=1434622094","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"StartDate":1430937143,"LastPoster":{"Id":284045,"Name":"Hydewedding","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":true},"PollState":"0","LastVote":0,"ForumId":23,"Preview":{"Id":1895544,"PostDate":1430937143,"PostContent":"HI! Im thinking of getting married in Grand Bahia Principe Jamaica next March (2016) but cant fin...","Author":{"Signature":"","Email":"ton_03@hotmail.com","IpAddress":"142.67.2.225","GroupId":39,"GroupName":"Newbie","JoinDate":1430231376,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282892.jpg?_r=1434622094","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"FutureMrsVanthof","Id":282892,"Name":"FutureMrsVanthof","IsOnline":false}},"Posts":[],"Id":"79155","Title":"Any Grand Bahia Principe Jamaica Brides!?!","LastPostDate":1437420038},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":348,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":45214,"MovedTo":null,"MovedOn":0,"FirstPostId":1829185,"Rating":0,"RatingHits":0,"Starter":{"Id":270939,"Name":"pamelas21","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270939.jpg?_r=1423518723","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"StartDate":1390861443,"LastPoster":{"Id":283966,"Name":"MaggieS","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283966.jpg?_r=1437504809","PhotoWidth":200,"PhotoHeight":266,"PhotoType":"facebook"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":23,"Preview":{"Id":1829185,"PostDate":1390861443,"PostContent":"Hello future brides!! I've been reading all your posts, comments and reviews for months now! (I w...","Author":{"Signature":"<p>Happy Planning Future Brides!<\/p>\n<p>Love, Mrs. Gedney! <3<\/p>\n<p>11.18.2014","Email":"psaca@me.com","IpAddress":"99.227.231.192","GroupId":40,"GroupName":"Jr. Member","JoinDate":1372253473,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270939.jpg?_r=1423518723","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"pamelas21","Id":270939,"Name":"pamelas21","IsOnline":false}},"Posts":[],"Id":"76145","Title":"Royalton White Sands","LastPostDate":1436916082}],"Filters":{"Period":[],"Other":[]}}],"Pages":{"TotalItems":100,"TotalPages":5,"CurrentPage":0,"NextPage":20,"PreviousPage":-1,"LastPage":80},"PushNotifications":[{"Key":"messages","Value":1,"Type":"int"}]}
