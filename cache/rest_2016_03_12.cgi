{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.35.109.240","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78994,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"886d47c5f80b6a9a55024c46084db86b","RawContent":"Hello everyone and congratulations!! If anyone is looking for favors we used Jimmy with Dominican favors for our 70 personalized bottle of Brugal rum! We had no problems with communication through out the entire process. I emailed him a week before we left to confirm date, time, and location of delivery- he confirmed date, time, and met us in the lobby of the resort. All of our guests loved the favors our coordinator was even blown away. Good luck and happy planning!","Attachments":[{"Id":32458,"Name":"image.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2015\/post-272393-0-43153300-1433001122.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2015\/post-272393-0-43153300-1433001122_thumb.jpg","Width":640,"Height":1136}],"Id":1897572,"PostDate":1432983125,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hello everyone and congratulations!! If anyone is looking for favors we used Jimmy with Dominican favors for our 70 personalized bottle of Brugal rum! We had no problems with communication through out the entire process. I emailed him a week before we left to confirm date, time, and location of delivery- he confirmed date, time, and met us in the lobby of the resort. All of our guests loved the favors our coordinator was even blown away. Good luck and happy planning!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"May 01, 2015- complete!! 73 guests+bride & groom! Now Larimar Punta Cana! ","Email":"cooper.tyshelle@gmail.com","IpAddress":"108.50.56.179","GroupId":40,"GroupName":"Jr. Member","JoinDate":1375995069,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272393.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"DR2015","Id":272393,"Name":"DR2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.192.106.120","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78994,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"be83e5ce9e2c0440f7daf927e30f18f7","RawContent":"Hi brides!! We are getting married March 2016... Week of 13-20! Just emailed the resort today for confirmation of our wedding date but I&#039;m hoping for the 16th. Question, in order to book your wedding date did you have to pay a deposit to the hotel? If so, I seen you can put down $100 for a wedding pkg or $500 if you want the larger packages. My question is, I can&#039;t afford $500 at the moment so does anyone know if we are able to put down the $100 now and then change our minds later and then give the additional $400??? Just curious !\n\nThanks :)","Attachments":[],"Id":1898870,"PostDate":1434656095,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi brides!! We are getting married March 2016... Week of 13-20! Just emailed the resort today for confirmation of our wedding date but I'm hoping for the 16th. Question, in order to book your wedding date did you have to pay a deposit to the hotel? If so, I seen you can put down $100 for a wedding pkg or $500 if you want the larger packages. My question is, I can't afford $500 at the moment so does anyone know if we are able to put down the $100 now and then change our minds later and then give the additional $400??? Just curious !<br>\nThanks <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ton_03@hotmail.com","IpAddress":"142.67.2.225","GroupId":39,"GroupName":"Newbie","JoinDate":1430213376,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282892.jpg?_r=1434622094","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"FutureMrsVanthof","Id":282892,"Name":"FutureMrsVanthof","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"216.99.65.82","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78994,"EditedBy":"","EditDate":1434707911,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"3d54f616aac87692a6a623292623fe5e","RawContent":"&lt;p&gt;@futuremrsvanthof&amp;nbsp; I THINK you can, but you can also make many upgrades from the your moments package. Once you get the spreadsheet, you will be able to see that! We went with the your moments, but adding on a cocktail hour and champagne toast for all our guests..&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;with that being said, I feel like we are planning the most casual destination wedding.... we are going to plan a welcome brunch when a majority of our guests arrive, and then a night out with the bride for the girls and night out with the groom for the guys. Those are our only things planned...&lt;\/p&gt;\n&lt;p&gt;then then wedding...&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Part of the reason we chose a destination wedding was because a big reception isn&#039;t us. For us, we love just hanging out on our porch with close friends having drinks, and appetizers. Initially, we thought only a handful of people would be coming, but we&#039;ve been getting a lot of &#039;we&#039;re coming!!\" \"can&#039;t wait!\" from unexpected family and friends, and need to PLAN on 50 or so guests.   Don&#039;t get me wrong, I am SO thankful and excited that they want to come, it was just more surprising based on initial reactions :P&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;When we thought we would have around 20 or so guests, we wanted to the ceremony, cocktail hour, and then just reserve some tables at a restaurant. We&#039;re having a reception at home, so we thought we&#039;d save the normal reception things for that, especially since my FSIL, FFIL and grand parents wont be making the trip...&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;however, now that we need to plan for more than that, we still want to do the ceremony, cocktail hour, and then a non-reception dinner.... However we have to have it at the buffet (25+ at buffet ).. does that scream tacky that we&#039;re not having a &#039;reception?\"&lt;\/p&gt;\n&lt;p&gt;\nBasically our timeline will go like this:&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;5:00pm: Let&#039;s get hitched!&lt;\/p&gt;\n&lt;p&gt;5:45: - 6:45pm: Cocktail Hour on the beach - champagne toast for all&lt;\/p&gt;\n&lt;p&gt;7:00 - 9:00: Join the bride and groom at XXXX Buffet&lt;\/p&gt;\n&lt;p&gt;9:00: After dinner drinks at XXX bar and continue to the discotheque&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;thoughts?\n\n&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1898892,"PostDate":1434707230,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@futuremrsvanthof\u00a0 I THINK you can, but you can also make many upgrades from the your moments package. Once you get the spreadsheet, you will be able to see that! We went with the your moments, but adding on a cocktail hour and champagne toast for all our guests..<\/p>\n<p>\u00a0<\/p>\n<p>with that being said, I feel like we are planning the most casual destination wedding.... we are going to plan a welcome brunch when a majority of our guests arrive, and then a night out with the bride for the girls and night out with the groom for the guys. Those are our only things planned...<\/p>\n<p>then then wedding...<\/p>\n<p>\u00a0<\/p>\n<p>Part of the reason we chose a destination wedding was because a big reception isn't us. For us, we love just hanging out on our porch with close friends having drinks, and appetizers. Initially, we thought only a handful of people would be coming, but we've been getting a lot of 'we're coming!!\" \"can't wait!\" from unexpected family and friends, and need to PLAN on 50 or so guests.\u00a0\u00a0 Don't get me wrong, I am SO thankful and excited that they want to come, it was just more surprising based on initial reactions <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/tongue.png' class='bbc_emoticon' alt=':P' \/><\/p>\n<p>\u00a0<\/p>\n<p>When we thought we would have around 20 or so guests, we wanted to the ceremony, cocktail hour, and then just reserve some tables at a restaurant. We're having a reception at home, so we thought we'd save the normal reception things for that, especially since my FSIL, FFIL and grand parents wont be making the trip...<\/p>\n<p>\u00a0<\/p>\n<p>however, now that we need to plan for more than that, we still want to do the ceremony, cocktail hour, and then a non-reception dinner.... However we have to have it at the buffet (25+ at buffet ).. does that scream tacky that we're not having a 'reception?\"<\/p>\n<p>\nBasically our timeline will go like this:<\/p>\n<p>\u00a0<\/p>\n<p>5:00pm: Let's get hitched!<\/p>\n<p>5:45: - 6:45pm: Cocktail Hour on the beach - champagne toast for all<\/p>\n<p>7:00 - 9:00: Join the bride and groom at XXXX Buffet<\/p>\n<p>9:00: After dinner drinks at XXX bar and continue to the discotheque<\/p>\n<p>\u00a0<\/p>\n<p>thoughts?<br>\n\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"alison.hardy1@gmail.com","IpAddress":"216.99.65.83","GroupId":39,"GroupName":"Newbie","JoinDate":1422356723,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281894.jpg?_r=1422907392","PhotoWidth":200,"PhotoHeight":226,"PhotoType":"custom"},"FormattedName":"hardyali","Id":281894,"Name":"hardyali","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"142.67.2.225","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78994,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"03563aff04243606a707b7572ebab551","RawContent":"&lt;p&gt;@[member=\"hardyali\"] thank you for your advice! I know .. we chose south because i wanted a cheaper option because we are having a at home reception next summer .. so thats also going to cost money! EVERYTHING costs money i am learning .. haha .. im just getting stressed because we dont have alot of money on hand right now, we have a private business that brings in some money at christmas so thats what we are counting on using for our trips .. so all these upfront costs are scaring me!&lt;\/p&gt;\n&lt;p&gt;I think im going to try to go with the $100 deposit .. im just scared i then wont be able to book a reception, because i really want to have a dance .. i couldnt believe how much it costs to have something at a resort that we are already paying for all these ammenities .. it boggles my mind, anyways, it is what it is i guess!&lt;\/p&gt;\n&lt;p&gt;I think your idea sounds really great, I too didnt expect many people to want to attend, and now i have a running list of 39 people .. our deposits are due July7th .. so once that date comes ,i will know how many are actually going to committ. . . so for that reason, until then i wont know what wedding package i want to have ... but im just more concerned about getting in the deposit and making sure i can book my wedding date!! haha My travel agent emailed the resort yesterday with the request form but we still havent heard back.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I went to this same resort a few years ago (6) for my sister in laws wedding and it was beautiful. she didnt have a reception, her ceremony was on the beach, then we had a private dinner at i think the french resturant .. and that was it .. after that we all went out to the lounge area and ended up going to bed early, so i dont want that to happen .. i want to have a dance&lt;\/p&gt;","Attachments":[],"Id":1898894,"PostDate":1434709600,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"281894\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281894-hardyali\/' title='Member profile'><span itemprop=\"name\">hardyali<\/span><\/a> thank you for your advice! I know .. we chose south because i wanted a cheaper option because we are having a at home reception next summer .. so thats also going to cost money! EVERYTHING costs money i am learning .. haha .. im just getting stressed because we dont have alot of money on hand right now, we have a private business that brings in some money at christmas so thats what we are counting on using for our trips .. so all these upfront costs are scaring me!<\/p>\n<p>I think im going to try to go with the $100 deposit .. im just scared i then wont be able to book a reception, because i really want to have a dance .. i couldnt believe how much it costs to have something at a resort that we are already paying for all these ammenities .. it boggles my mind, anyways, it is what it is i guess!<\/p>\n<p>I think your idea sounds really great, I too didnt expect many people to want to attend, and now i have a running list of 39 people .. our deposits are due July7th .. so once that date comes ,i will know how many are actually going to committ. . . so for that reason, until then i wont know what wedding package i want to have ... but im just more concerned about getting in the deposit and making sure i can book my wedding date!! haha My travel agent emailed the resort yesterday with the request form but we still havent heard back.<\/p>\n<p>\u00a0<\/p>\n<p>I went to this same resort a few years ago (6) for my sister in laws wedding and it was beautiful. she didnt have a reception, her ceremony was on the beach, then we had a private dinner at i think the french resturant .. and that was it .. after that we all went out to the lounge area and ended up going to bed early, so i dont want that to happen .. i want to have a dance<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ton_03@hotmail.com","IpAddress":"142.67.2.225","GroupId":39,"GroupName":"Newbie","JoinDate":1430213376,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282892.jpg?_r=1434622094","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"FutureMrsVanthof","Id":282892,"Name":"FutureMrsVanthof","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"216.99.65.82","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78994,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"58409f13f4bddbd76fb82056328b7a1d","RawContent":"&lt;p&gt;Do you have the wedding spreadsheet yet? I think it&#039;s in US dollars but I can send it to you!&lt;\/p&gt;","Attachments":[],"Id":1899150,"PostDate":1435074035,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Do you have the wedding spreadsheet yet? I think it's in US dollars but I can send it to you!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"alison.hardy1@gmail.com","IpAddress":"216.99.65.83","GroupId":39,"GroupName":"Newbie","JoinDate":1422356723,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281894.jpg?_r=1422907392","PhotoWidth":200,"PhotoHeight":226,"PhotoType":"custom"},"FormattedName":"hardyali","Id":281894,"Name":"hardyali","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.114.69.226","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78994,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"27ebb86fddd87eb47dc9442b436c676b","RawContent":"My fianc\u00e9 and I are getting married at Now Larimar the week of September 7-14 2016 (wedding day is the 10th).\n\n\nWe are so excited, but of course I&#039;m anxious.  We are waiting to see who all can commit to this fun in the sun adventure! I&#039;m so glad I found this website!  Congrats to all the brides :)","Attachments":[],"Id":1899899,"PostDate":1436237657,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                My fianc\u00e9 and I are getting married at Now Larimar the week of September 7-14 2016 (wedding day is the 10th).<br><br>\nWe are so excited, but of course I'm anxious.  We are waiting to see who all can commit to this fun in the sun adventure! I'm so glad I found this website!  Congrats to all the brides <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jackieehughes4@gmail.com","IpAddress":"24.114.69.226","GroupId":39,"GroupName":"Newbie","JoinDate":1436235138,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283840.jpg?_r=1436253442","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Jackattack2016","Id":283840,"Name":"Jackattack2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"142.67.2.225","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78994,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b708bbb5f8136bd747d24f02bb9ecf94","RawContent":"&lt;p&gt;Hey Brides!\n\nSo our wedding date is confirmed!! March 16th 2016 @ the fountain and a private reception at the relaxed pool!!!&lt;\/p&gt;\n&lt;p&gt;Has anyone booked a photographer yet?! I just emailed Photo Souvenir I had read a few reviews that their pictures were amazing, hopefully their prices aren&#039;t toooo bad .. considering I&#039;m going to have to also pay $500 to bring someone onto the resort .. i don&#039;t want to skimp on my photos .. but i also don&#039;t want to pay an arm and a leg! haha&lt;\/p&gt;","Attachments":[],"Id":1899982,"PostDate":1436341046,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hey Brides!<br>\nSo our wedding date is confirmed!! March 16th 2016 @ the fountain and a private reception at the relaxed pool!!!<\/p>\n<p>Has anyone booked a photographer yet?! I just emailed Photo Souvenir I had read a few reviews that their pictures were amazing, hopefully their prices aren't toooo bad .. considering I'm going to have to also pay $500 to bring someone onto the resort .. i don't want to skimp on my photos .. but i also don't want to pay an arm and a leg! haha<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ton_03@hotmail.com","IpAddress":"142.67.2.225","GroupId":39,"GroupName":"Newbie","JoinDate":1430213376,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282892.jpg?_r=1434622094","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"FutureMrsVanthof","Id":282892,"Name":"FutureMrsVanthof","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.114.70.84","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78994,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"74272ba411fb09bd1d5be10cbf8b1366","RawContent":"@[member=\"FutureMrsVanthof\"] I&#039;m in the same boat.  I&#039;m trying to avoid brig someone onsite.  I&#039;d rather put that $500 somewhere else.  I&#039;m hoping my sister in law can make it down and be my photographer lol.  She&#039;s family, she can&#039;t say no lol.\n\n\nIf that doesn&#039;t work we might just hire the resort photographer.  I know my wedding is over a year away but I can stop thinking about every little thing,  it&#039;s going to be a long 14 months haha.  I&#039;m so glad I found this site.","Attachments":[],"Id":1900128,"PostDate":1436463264,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"282892\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282892-futuremrsvanthof\/' title='Member profile'><span itemprop=\"name\">FutureMrsVanthof<\/span><\/a> I'm in the same boat.  I'm trying to avoid brig someone onsite.  I'd rather put that $500 somewhere else.  I'm hoping my sister in law can make it down and be my photographer lol.  She's family, she can't say no lol.<br><br>\nIf that doesn't work we might just hire the resort photographer.  I know my wedding is over a year away but I can stop thinking about every little thing,  it's going to be a long 14 months haha.  I'm so glad I found this site.  \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jackieehughes4@gmail.com","IpAddress":"24.114.69.226","GroupId":39,"GroupName":"Newbie","JoinDate":1436235138,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283840.jpg?_r=1436253442","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Jackattack2016","Id":283840,"Name":"Jackattack2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"216.99.65.82","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78994,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"bf955416b5ee66711459f2a9a00372c0","RawContent":"&lt;p&gt;apparently I don&#039;t know how to use this thing to @ someone&amp;nbsp; haha...&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Congrats on securing your date!! that is so exciting!!!  &lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I thought i got an email from someone on site... let me see if i can find it! I didn&#039;t think their packages were horrible either -- we are going to do a trash the dress session back at home so our fur-child can join us, so we&#039;ll probably just do the basic package!&lt;\/p&gt;","Attachments":[],"Id":1900655,"PostDate":1437140048,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>apparently I don't know how to use this thing to @ someone\u00a0 haha...<\/p>\n<p>\u00a0<\/p>\n<p>Congrats on securing your date!! that is so exciting!!!\u00a0\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I thought i got an email from someone on site... let me see if i can find it! I didn't think their packages were horrible either -- we are going to do a trash the dress session back at home so our fur-child can join us, so we'll probably just do the basic package!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"alison.hardy1@gmail.com","IpAddress":"216.99.65.83","GroupId":39,"GroupName":"Newbie","JoinDate":1422356723,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281894.jpg?_r=1422907392","PhotoWidth":200,"PhotoHeight":226,"PhotoType":"custom"},"FormattedName":"hardyali","Id":281894,"Name":"hardyali","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.49.143.76","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78994,"EditedBy":"","EditDate":1438209942,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bc80d5afe1926bbf7467592800c71cd8","RawContent":"&lt;p&gt;Hi everyone!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;m going to be getting married here December 3, 2016, on the beach. We haven&#039;t chose the reception location yet, but we were thinking of going with the carnival terrace. I&#039;ve already paid my deposit, but I haven&#039;t heard from the wedding coordinator yet.&lt;\/p&gt;","Attachments":[],"Id":1901550,"PostDate":1438209895,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi everyone!<\/p>\n<p>\u00a0<\/p>\n<p>I'm going to be getting married here December 3, 2016, on the beach. We haven't chose the reception location yet, but we were thinking of going with the carnival terrace. I've already paid my deposit, but I haven't heard from the wedding coordinator yet.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"adavis_88@hotmail.com","IpAddress":"70.49.143.76","GroupId":39,"GroupName":"Newbie","JoinDate":1437926497,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284148.jpg?_r=1440344425","PhotoWidth":200,"PhotoHeight":266,"PhotoType":"facebook"},"FormattedName":"adavis","Id":284148,"Name":"adavis","IsOnline":false}}],"Pages":{"TotalItems":52,"TotalPages":6,"CurrentPage":10,"NextPage":20,"PreviousPage":0,"LastPage":50},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
