otoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-287113.jpg?_r=1469320238","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"DreamArtPhotography","Id":287113,"Name":"DreamArtPhotography","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.227.237.126","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80133,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bbbe2bb016e332a871239d5e35224ac8","RawContent":"Hi all \n\nI was all set to book my 2017 wedding at the Azul Sensatori Jamaica and when I was searching the website I noticed that they didn&#039;t offer any of the wedding packages there. I&#039;m so disappointed. I have asked my TA to find info if she could but I&#039;m thinking I need to start over. \n\nSo here&#039;s what I&#039;m looking for, a resort that is family friendly as I am travelling with all my children (ages 1-22) and my 2 grandchildren, as well as my parents and pil to be. Any recommendations???","Attachments":[],"Id":1914347,"PostDate":1465770496,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi all <br>\nI was all set to book my 2017 wedding at the Azul Sensatori Jamaica and when I was searching the website I noticed that they didn't offer any of the wedding packages there. I'm so disappointed. I have asked my TA to find info if she could but I'm thinking I need to start over. <br>\nSo here's what I'm looking for, a resort that is family friendly as I am travelling with all my children (ages 1-22) and my 2 grandchildren, as well as my parents and pil to be. Any recommendations???\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"spadeincwedding@yahoo.com","IpAddress":"99.226.206.246","GroupId":40,"GroupName":"Jr. Member","JoinDate":1396384180,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"none"},"FormattedName":"NixSpade","Id":277449,"Name":"NixSpade","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"189.221.38.183","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80133,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"85b68a1120dbdfdefb4b77079176daa2","RawContent":"&lt;p&gt;@[member=\"NixSpade\"] is your heart only set to Jamaica? because you can have your wedding at Azul Sensatori Mexico.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Happy Planning!&lt;\/p&gt;","Attachments":[],"Id":1914376,"PostDate":1465851654,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"277449\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277449-nixspade\/' title='Member profile'><span itemprop=\"name\">NixSpade<\/span><\/a> is your heart only set to Jamaica? because you can have your wedding at Azul Sensatori Mexico.<\/p>\n<p>\u00a0<\/p>\n<p>Happy Planning!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Dream Weddings Riviera Maya- We pay attention to your wishes and coordinate closely with you to ensure your wedding or event is planned to perfection! Supporting you brides and help you feel less overwhelmed during the wedding planning process.<\/p>\n<p>Have fun the best is yet to come!<\/p>\n<p>\u00a0<\/p>\n<p>This is where I will be posting all videos about most common question about Destination wedding<\/p>\n<p> <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0\u00a0<a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/groups\/1664036763874450\/'>https:\/\/www.facebook.com\/groups\/1664036763874450\/<\/a><br><br><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Dream Weddings Riviera Maya<\/span><\/span><\/span><br><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">weddingsinplayadelcarmen@gmail.com<\/span><\/span><br><a  class=\"bbc_url\" href=\"http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html\">http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html<\/a><br><br><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Happy Planning!<\/span><\/span><\/span><br><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Joyce<\/span><\/span><\/span>","Email":"weddingsinplayadelcarmen@gmail.com","IpAddress":"187.252.44.28","GroupId":84,"GroupName":"Insiders w\/ Articles","JoinDate":1326836387,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250090.jpg?_r=1451923195","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"dreamweddings","Id":250090,"Name":