raphy.com\/movienatasha\/\">3.24.07 cabo surf<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/nabumbah.livejournal.com\/\">year two.<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/20th.teamintraining.org\/?utm_source=google&utm_medium=cpc&utm_campaign=20th%2BAdwords\">i ran 26.2 - I helped save lives.<\/a><a data-ipb='nomediaparse' href=\"http:\/\/img.photobucket.com\/albums\/v396\/nabumbah\/family157-1.jpg\">http:\/\/img.photobucket.com\/albums\/v3...amily157-1.jpg<\/a><\/div><\/div>","Email":"nabumbah@gmail.com","IpAddress":"","GroupId":46,"GroupName":"VIP Member","JoinDate":1147463160,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206733.gif?_r=0","PhotoWidth":83,"PhotoHeight":99,"PhotoType":"custom"},"FormattedName":"NABUMBAH","Id":206733,"Name":"NABUMBAH","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9135254ae815ca10b20c5f42445e2e89","RawContent":"This is my engagement ring and future wedding band. Engagement = 1.5ct. Wedding band = .55ct. Both rings are platinum. I love how smooth the band is on my Ering. It never cuts or scrapes me.\n \n \n &lt;img src=\"http:\/\/www.mondera.com\/images\/complete\/listimages\/3002433_Round.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n &lt;img src=\"http:\/\/www.mondera.com\/Images\/listimages\/3002269.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;&lt;\/a&gt;","Attachments":[],"Id":1354,"PostDate":1158970085,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 1