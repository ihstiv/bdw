Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":8,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":326,"MovedTo":null,"MovedOn":0,"FirstPostId":1911178,"Rating":0,"RatingHits":0,"Starter":{"Id":281935,"Name":"banana2016","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281935.png?_r=1422687667","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"StartDate":1456151327,"LastPoster":{"Id":286325,"Name":"alongcamepauline","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":43,"Preview":{"Id":1911178,"PostDate":1456151327,"PostContent":"Hello Ladies  I am in need of some serious help! I'm getting married at Now Sapphire, and I'm sur...","Author":{"Signature":"","Email":"hannahschlitt@gmail.com","IpAddress":"154.20.0.175","GroupId":39,"GroupName":"Newbie","JoinDate":1422546693,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281935.png?_r=1422687667","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"banana2016","Id":281935,"Name":"banana2016","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.199.12.234","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79953,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"d1c468193972e8dadebc154228fea8f2","RawContent":"Hello Ladies \n\n\nI am in need of some serious help! I&#039;m getting married at Now Sapphire, and I&#039;m sure like many other resorts, the floral arrangements are very pricey. I&#039;m also from Canada so I have to convert everything to Canadian dollars which makes the resort floral arrangements even more pricey. \n\n\nI&#039;ve thought about making my own artificial floral arrangements? Has anyone done this? Any advice? Did your flowers make it through customs okay? Did they pack easily? \n\n\nAny other ideas on what to do?\n\n\nI don&#039;t know what to do! Please help!","Attachments":[],"Id":1911178,"PostDate":1456151327,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hello Ladies <br><br>\nI am in need of some serious help! I'm getting married at Now Sapphire, and I'm sure like many other resorts, the floral arrangements are very pricey. I'm also from Canada so I have to convert everything to Canadian dollars which makes the resort floral arrangements even more pricey. <br><br>\nI've thought about making my own artificial floral arrangements? Has anyone done this? Any advice? Did your flowers make it through customs okay? Did they pack easily? <br><br>\nAny other ideas on what to do?<br><br>\nI don't know what to do! Please help!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"hannahschlitt@gmail.com","IpAddress":"154.20.0.175","GroupId":39,"GroupName":"Newbie","JoinDate":1422546693,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281935.png?_r=1422687667","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"banana2016","Id":281935,"Name":"banana2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.142.4.206","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79953,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"a9440324c21b5debcbaebc47e24f41b2","RawContent":"&lt;p&gt;Hello,\n\n\nI actually brought my own bouquets\/boutonnieres etc. I went through an Etsy vendor called stemple shop. I ordered bouquets of real touch peonies.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;It&#039;s definitely possible to bring your own flowers and it will save you a lot of money! Mine packed really easily and when I unpacked them they were fine, they weren&#039;t squished at all.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1911180,"PostDate":1456152936,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello,<br><br>\nI actually brought my own bouquets\/boutonnieres etc. I went through an Etsy vendor called stemple shop. I ordered bouquets of real touch peonies.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>It's definitely possible to bring your own flowers and it will save you a lot of money! Mine packed really easily and when I unpacked them they were fine, they weren't squished at all.\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419419814,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1453235488","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.199.12.234","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79953,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"13d815d7e33223eddd5bde9ae54149c0","RawContent":"[quote name=\"perianjay\" post=\"1911180\" timestamp=\"1456170936\"]\nHello,\nI actually brought my own bouquets\/boutonnieres etc. I went through an Etsy vendor called stemple shop. I ordered bouquets of real touch peonies. \n \nIt&#039;s definitely possible to bring your own flowers and it will save you a lot of money! Mine packed really easily and when I unpacked them they were fine, they weren&#039;t squished at all.\n[\/quote]Thanks so much! I will check that Etsy shop out.","Attachments":[],"Id":1911182,"PostDate":1456154105,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>perianjay, on 22 February 2016 - 02:55 PM, said:<\/p><div class='blockquote'><div class='quote'><p>Hello,<br>\nI actually brought my own bouquets\/boutonnieres etc. I went through an Etsy vendor called stemple shop. I ordered bouquets of real touch peonies.\u00a0<br>\n\u00a0<br>\nIt's definitely possible to bring your own flowers and it will save you a lot of money! Mine packed really easily and when I unpacked them they were fine, they weren't squished at all.<br><\/p><\/div><\/div>\n<br>\nThanks so much! I will check that Etsy shop out. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"hannahschlitt@gmail.com","IpAddress":"154.20.0.175","GroupId":39,"GroupName":"Newbie","JoinDate":1422546693,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281935.png?_r=1422687667","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"banana2016","Id":281935,"Name":"banana2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.2.49.178","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79953,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0000d3b6e9543fd2f30c7ef726b4a1e7","RawContent":"&lt;p&gt;Hi @[member=\"banana2016\"]&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;m also doing the same-- I&#039;m buying the silk\/fake flowers from a wholesaler here in Vancouver and assembling the bouquets myself. I&#039;ve youtubed it as well and it honestly doesn&#039;t look TOO difficult. I also want peonies which are super expensive down in Mexico so we&#039;ve opted for the silk flowers instead ;)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Hope that helps!&lt;\/p&gt;","Attachments":[],"Id":1911187,"PostDate":1456166663,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi @<a hovercard-ref=\"member\" hovercard-id=\"281935\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281935-banana2016\/' title='Member profile'><span itemprop=\"name\">banana2016<\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>I'm also doing the same-- I'm buying the silk\/fake flowers from a wholesaler here in Vancouver and assembling the bouquets myself. I've youtubed it as well and it honestly doesn't look TOO difficult. I also want peonies which are super expensive down in Mexico so we've opted for the silk flowers instead <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Hope that helps!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Jess<\/p>\n<p>\u00a0<\/p>\n<p>My Planning Thread:\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79659-jes0912-moon-palace-planning-thread\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79659-jes0912-moon-palace-planning-thread\/<\/a>","Email":"jessica.so@icloud.com","IpAddress":"70.36.49.204","GroupId":39,"GroupName":"Newbie","JoinDate":1444260503,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"none"},"FormattedName":"jes0912","Id":285044,"Name":"jes0912","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.92.144.183","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79953,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d7d16edb587646c3c2c43803982af3a7","RawContent":"@[member=\"jes0912\"] Thanks for replying! What wholesaler are you using? I make trips to Vancouver every so often. Maybe I&#039;ll check it out. I love peonies as well! \n@[member=\"perianjay\"]\n\n\nDid you also bring artificial flowers for your reception decor\/center prices?","Attachments":[],"Id":1911189,"PostDate":1456169209,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"285044\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/285044-jes0912\/' title='Member profile'><span itemprop=\"name\">jes0912<\/span><\/a> Thanks for replying! What wholesaler are you using? I make trips to Vancouver every so often. Maybe I'll check it out. I love peonies as well! <br \/>@<a hovercard-ref=\"member\" hovercard-id=\"281478\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281478-perianjay\/' title='Member profile'><span itemprop=\"name\">perianjay<\/span><\/a><br><br>\nDid you also bring artificial flowers for your reception decor\/center prices? \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"hannahschlitt@gmail.com","IpAddress":"154.20.0.175","GroupId":39,"GroupName":"Newbie","JoinDate":1422546693,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281935.png?_r=1422687667","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"banana2016","Id":281935,"Name":"banana2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.90.223.2","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79953,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"75b4c52e1f154487347de14972c13535","RawContent":"I am also considering doing this as well!  It&#039;s great to hear some input from others.  Any brides from Edmonton?  I&#039;d like to see if there&#039;s a good place here where I can see the flowers in person for the sake of color-matching \n\n\nSent from my SM-G900W8 using Tapatalk","Attachments":[],"Id":1911224,"PostDate":1456245267,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I am also considering doing this as well!  It's great to hear some input from others.  Any brides from Edmonton?  I'd like to see if there's a good place here where I can see the flowers in person for the sake of color-matching <br><br>\nSent from my SM-G900W8 using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tpenner@ualberta.ca","IpAddress":"68.150.177.36","GroupId":3,"GroupName":"Member","JoinDate":1451942069,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-285764.jpg?_r=1451960071","PhotoWidth":200,"PhotoHeight":122,"PhotoType":"custom"},"FormattedName":"tpenner","Id":285764,"Name":"tpenner","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.2.49.178","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79953,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6b07f524408f9813ecb13957d5a364b0","RawContent":"&lt;p&gt;@[member=\"banana2016\"] there are a whole bunch down in Burnaby on Marine Way; but the one i&#039;m going to is called \"Florists Supply\", this one isn&#039;t open to public, but there are a whole bunch in the area that are! I would definitely check it out when you can.&lt;\/p&gt;","Attachments":[],"Id":1911298,"PostDate":1456338801,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"281935\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281935-banana2016\/' title='Member profile'><span itemprop=\"name\">banana2016<\/span><\/a> there are a whole bunch down in Burnaby on Marine Way; but the one i'm going to is called \"Florists Supply\", this one isn't open to public, but there are a whole bunch in the area that are! I would definitely check it out when you can.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Jess<\/p>\n<p>\u00a0<\/p>\n<p>My Planning Thread:\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79659-jes0912-moon-palace-planning-thread\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79659-jes0912-moon-palace-planning-thread\/<\/a>","Email":"jessica.so@icloud.com","IpAddress":"70.36.49.204","GroupId":39,"GroupName":"Newbie","JoinDate":1444260503,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"none"},"FormattedName":"jes0912","Id":285044,"Name":"jes0912","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.54.35.149","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79953,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0b2f983c7c250ce3243bc115d4b563fd","RawContent":"[quote name=\"perianjay\" post=\"1911180\" timestamp=\"1456170936\"]\nHello,\n\nI actually brought my own bouquets\/boutonnieres etc. I went through an Etsy vendor called stemple shop. I ordered bouquets of real touch peonies. \n\nIt&#039;s definitely possible to bring your own flowers and it will save you a lot of money! Mine packed really easily and when I unpacked them they were fine, they weren&#039;t squished at all.[\/quote]Can I asked how you packed them? Did u keep them in the original packaging from stemple shop or repack it? Just curious.  I&#039;m really worried about traveling with bouquets\n\nSent from my HTC One_M8 using Tapatalk","Attachments":[],"Id":1911517,"PostDate":1456935235,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>perianjay, on 22 February 2016 - 02:55 PM, said:<\/p><div class='blockquote'><div class='quote'><p>Hello,<br><br>\nI actually brought my own bouquets\/boutonnieres etc. I went through an Etsy vendor called stemple shop. I ordered bouquets of real touch peonies. <br><br>\nIt's definitely possible to bring your own flowers and it will save you a lot of money! Mine packed really easily and when I unpacked them they were fine, they weren't squished at all.<\/p><\/div><\/div>\nCan I asked how you packed them? Did u keep them in the original packaging from stemple shop or repack it? Just curious.  I'm really worried about traveling with bouquets<br><br>\nSent from my HTC One_M8 using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"alongcamepauline@gmail.com","IpAddress":"208.54.90.151","GroupId":3,"GroupName":"Member","JoinDate":1456317391,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"alongcamepauline","Id":286325,"Name":"alongcamepauline","IsOnline":false}}],"Id":"79953","Title":"Artificial Flowers Vs Resort Flowers","LastPostDate":1456935235},"Pages":{"TotalItems":8,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
