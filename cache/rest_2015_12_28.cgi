{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":5,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":369,"MovedTo":null,"MovedOn":0,"FirstPostId":1908096,"Rating":0,"RatingHits":0,"Starter":{"Id":285382,"Name":"MarMig","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1449186763,"LastPoster":{"Id":281852,"Name":"MexicoWedding2015","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281852.jpg?_r=1422124879","PhotoWidth":152,"PhotoHeight":234,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1908096,"PostDate":1449186763,"PostContent":"Hi! I am getting married at Catalonia RM and wanted to know if they have videographers. I am inte...","Author":{"Signature":"","Email":"m_perello@hotmail.com","IpAddress":"96.57.145.250","GroupId":39,"GroupName":"Newbie","JoinDate":1447941462,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"MarMig","Id":285382,"Name":"MarMig","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.58.155.210","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79778,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f81b0f85c9b835200d8e00e0980f3b4c","RawContent":"Hi! I am getting married at Catalonia RM and wanted to know if they have videographers. I am interested in having a video made along with the photos.","Attachments":[],"Id":1908096,"PostDate":1449186763,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi! I am getting married at Catalonia RM and wanted to know if they have videographers. I am interested in having a video made along with the photos. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"m_perello@hotmail.com","IpAddress":"96.57.145.250","GroupId":39,"GroupName":"Newbie","JoinDate":1447941462,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"MarMig","Id":285382,"Name":"MarMig","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"200.79.251.123","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79778,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"e0909e45e87cdffcc618a6a576ae0d8d","RawContent":"[quote name=\"MarMig\" post=\"1908096\" timestamp=\"1449186763\"]\nHi! I am getting married at Catalonia RM and wanted to know if they have videographers. I am interested in having a video made along with the photos.[\/quote]@[member=\"MarMig\"] did you try checking with the hotel directly if they can send you their preferred list, so you can see if you like who they work with.  All resort have the service of both photographer and videographer.","Attachments":[],"Id":1908114,"PostDate":1449246994,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>MarMig, on 03 December 2015 - 03:52 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hi! I am getting married at Catalonia RM and wanted to know if they have videographers. I am interested in having a video made along with the photos.<\/p>\n<\/div>\n<\/div><\/div>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"285382\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/285382-marmig\/' title='Member profile'><span itemprop=\"name\">MarMig<\/span><\/a> did you try checking with the hotel directly if they can send you their preferred list, so you can see if you like who they work with. \u00a0All resort have the service of both photographer and videographer.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"Dream Weddings Riviera Maya- We pay attention to your wishes and coordinate closely with you to ensure your wedding or event is planned to perfection!<br \/>\n<br \/>\n<span style='color: rgb(40,40,40)'><span style='font-family: arial'><span style='font-size: 12px;'>Dream Weddings Riviera Maya<\/span><\/span><\/span><br \/>\n<span style='font-family: arial'><span style='font-size: 12px;'>weddingsinplayadelcarmen@gmail.com<\/span><\/span><br \/>\n<a class='bbc_url' href='http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html'>http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html<\/a><br \/>\n<br \/>\n<span style='color: rgb(40,40,40)'><span style='font-family: arial'><span style='font-size: 12px;'>Happy Planning!<\/span><\/span><\/span><br \/>\n<span style='color: rgb(40,40,40)'><span style='font-family: arial'><span style='font-size: 12px;'>Joyce<\/span><\/span><\/span>","Email":"weddingsinplayadelcarmen@gmail.com","IpAddress":"187.252.44.28","GroupId":84,"GroupName":"Insiders w\/ Articles","JoinDate":1326854387,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250090.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"dreamweddings","Id":250090,"Name":"dreamweddings","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"179.53.131.194","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79778,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"2c641a77f4127b6cba91588755ea43e2","RawContent":"&lt;p&gt;Welcome to the boards MarMig and Congrats on your upcoming Catalonia RM wedding here in our magnificent Mayan Riviera!!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;You&#039;re sure to find loads of wonderful info, advice, support and ideas here from your fellow wedding couple-planners - so well done on getting off to a great start :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;For some added inspiration, here are few magical wedding moments that matter we&#039;ve captured in our beautiful area over the years......taken from our &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10150344652834487.362195.18683524486&amp;amp;type=3&#039;&gt;Timeline Photos Album:&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-atl3-1.xx.fbcdn.net\/hphotos-xpt1\/t31.0-8\/11696407_10153437601474487_635021991081118739_o.jpg\" alt=\"11696407_10153437601474487_6350219910811\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-atl3-1.xx.fbcdn.net\/hphotos-xtp1\/t31.0-8\/11112904_10153437585749487_5606464172347900185_o.jpg\" alt=\"11112904_10153437585749487_5606464172347\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-atl3-1.xx.fbcdn.net\/hphotos-xft1\/t31.0-8\/11429440_10153422624264487_2720469933359524657_o.jpg\" alt=\"11429440_10153422624264487_2720469933359\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Hope you find all the answers you&#039;re looking for, and that you totally ENJOY your Amazing journey ahead - cheers!!! team MTM :)&lt;\/p&gt;","Attachments":[],"Id":1908135,"PostDate":1449347113,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome to the boards MarMig and Congrats on your upcoming Catalonia RM wedding here in our magnificent Mayan Riviera!!!<\/p>\n<p>\u00a0<\/p>\n<p>You're sure to find loads of wonderful info, advice, support and ideas here from your fellow wedding couple-planners - so well done on getting off to a great start <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>For some added inspiration, here are few magical wedding moments that matter we've captured in our beautiful area over the years......taken from our <a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10150344652834487.362195.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>Timeline Photos Album:<\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-atl3-1.xx.fbcdn.net\/hphotos-xpt1\/t31.0-8\/11696407_10153437601474487_635021991081118739_o.jpg\" alt=\"11696407_10153437601474487_6350219910811\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-atl3-1.xx.fbcdn.net\/hphotos-xtp1\/t31.0-8\/11112904_10153437585749487_5606464172347900185_o.jpg\" alt=\"11112904_10153437585749487_5606464172347\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-atl3-1.xx.fbcdn.net\/hphotos-xft1\/t31.0-8\/11429440_10153422624264487_2720469933359524657_o.jpg\" alt=\"11429440_10153422624264487_2720469933359\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>Hope you find all the answers you're looking for, and that you totally ENJOY your Amazing journey ahead - cheers!!! team MTM <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280210660,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.15.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79778,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f65318b3dbb410b3d51d8b6515be558c","RawContent":"&lt;p&gt;@MarMig&amp;nbsp; Congrats on your upcoming wedding!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I don&#039;t know if you&#039;ve looked through this site or not but it&#039;s definitely worth reading. I did find one forum for the resort you mentioned that is probably worth reviewing. Also look up the resort reviews and see if your resort is listed there. The ladies here are great at providing input too.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck and happy planning!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/topic\/17557-catalonia-riviera-maya\/&#039;&gt;http:\/\/www.bestdestinationwedding.com\/topic\/17557-catalonia-riviera-maya\/&lt;\/a&gt;&lt;\/p&gt;","Attachments":[],"Id":1908173,"PostDate":1449515776,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@MarMig\u00a0 Congrats on your upcoming wedding!<\/p>\n<p>\u00a0<\/p>\n<p>I don't know if you've looked through this site or not but it's definitely worth reading. I did find one forum for the resort you mentioned that is probably worth reviewing. Also look up the resort reviews and see if your resort is listed there. The ladies here are great at providing input too.<\/p>\n<p>\u00a0<\/p>\n<p>Good luck and happy planning!<\/p>\n<p>\u00a0<\/p>\n<p><a href='http:\/\/www.bestdestinationwedding.com\/topic\/17557-catalonia-riviera-maya\/' class='bbc_url' title=''>http:\/\/www.bestdesti...a-riviera-maya\/<\/a><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283458999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"12.176.230.9","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79778,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bc8d7a27bd70d5ac989a96fa80a8c383","RawContent":"&lt;p&gt;Hi @[member=\"MarMig\"],&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I just got back from my wedding at the Catalonia Riviera Maya on Dec. 12. Lots of good things to report and a few annoyances! Happy to answer any questions you have! The resort does have a photographer, but we weren&#039;t very happy with his portfolio. We had originally booked Sascha Gluck, but then ended up using a friend of a friend instead.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Andrea&lt;\/p&gt;","Attachments":[],"Id":1908598,"PostDate":1450807356,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi @<a hovercard-ref=\"member\" hovercard-id=\"285382\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/285382-marmig\/' title='Member profile'><span itemprop=\"name\">MarMig<\/span><\/a>,<\/p>\n<p>\u00a0<\/p>\n<p>I just got back from my wedding at the Catalonia Riviera Maya on Dec. 12. Lots of good things to report and a few annoyances! Happy to answer any questions you have! The resort does have a photographer, but we weren't very happy with his portfolio. We had originally booked Sascha Gluck, but then ended up using a friend of a friend instead.<\/p>\n<p>\u00a0<\/p>\n<p>Andrea<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"andrea.latta@gmail.com","IpAddress":"207.229.189.184","GroupId":39,"GroupName":"Newbie","JoinDate":1422123854,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281852.jpg?_r=1422124879","PhotoWidth":152,"PhotoHeight":234,"PhotoType":"custom"},"FormattedName":"MexicoWedding2015","Id":281852,"Name":"MexicoWedding2015","IsOnline":false}}],"Id":"79778","Title":"Catalonia Riviera Maya May 2017\/ Photos And Videos","LastPostDate":1450807356},"Pages":{"TotalItems":5,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
