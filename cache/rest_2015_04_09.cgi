{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":13,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":1041,"MovedTo":null,"MovedOn":0,"FirstPostId":1878491,"Rating":0,"RatingHits":0,"Starter":{"Id":281168,"Name":"islandbride2016","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1416084943,"LastPoster":{"Id":282503,"Name":"tiffanyt","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":23,"Preview":{"Id":1878491,"PostDate":1416084943,"PostContent":"I just recently got engaged and want to get married in Jamaica. Looking at wedding locations any...","Author":{"Signature":"","Email":"jamystique@yahoo.com","IpAddress":"207.204.112.216","GroupId":39,"GroupName":"Newbie","JoinDate":1416084699,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"islandbride2016","Id":281168,"Name":"islandbride2016","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.204.112.216","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78388,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3fa221d5b1a2978ddc251c037ef3fff1","RawContent":"&lt;p&gt;I just recently got engaged and want to get married in Jamaica. Looking at wedding locations any suggestions?&lt;\/p&gt;","Attachments":[],"Id":1878491,"PostDate":1416084943,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I just recently got engaged and want to get married in Jamaica. Looking at wedding locations any suggestions?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jamystique@yahoo.com","IpAddress":"207.204.112.216","GroupId":39,"GroupName":"Newbie","JoinDate":1416084699,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"islandbride2016","Id":281168,"Name":"islandbride2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.114.24.118","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78388,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"ed76d55c8e821c07bcdaf66fac47c5ca","RawContent":"Best advice is to find a great TA who specializes in destination weddings... They will be able to offer suggestions based on your wedding budget, you ideal guest costs, the look and feel you are wanting, and the amenities you require! Once you have them narrow it down for you, check here for wedding reviews and past brides comments about the resorts in question as the folks here are invaluable! Good luck and happy planning!","Attachments":[],"Id":1878508,"PostDate":1416138862,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Best advice is to find a great TA who specializes in destination weddings... They will be able to offer suggestions based on your wedding budget, you ideal guest costs, the look and feel you are wanting, and the amenities you require! Once you have them narrow it down for you, check here for wedding reviews and past brides comments about the resorts in question as the folks here are invaluable! Good luck and happy planning! \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kmkwedding2016@gmail.com","IpAddress":"70.72.195.234","GroupId":38,"GroupName":"Moderators","JoinDate":1390242208,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kmk2016","Id":276231,"Name":"kmk2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.101.83.185","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78388,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"0c41e9c2399b617c2c224c96bdcc4d4a","RawContent":"&lt;p&gt;I got married in Jamaica and we fell in love with the island. There are so many beautiful resorts available for hosting your wedding. We were married at Gran Bahia Principe Jamaica so of course I&#039;m biased in favour of that resort! lol but @[member=\"kmk2016\"] is absolutely right in terms of working with a travel agent to find a location that works for you. And there are lots of Jamaica brides here - both past and present so looking through the forums here will definitely help you through your planning journey.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck and happy planning!&lt;\/p&gt;","Attachments":[],"Id":1878550,"PostDate":1416165231,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I got married in Jamaica and we fell in love with the island. There are so many beautiful resorts available for hosting your wedding. We were married at Gran Bahia Principe Jamaica so of course I'm biased in favour of that resort! lol but @<a hovercard-ref=\"member\" hovercard-id=\"276231\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/276231-kmk2016\/' title='Member profile'><span itemprop=\"name\">kmk2016<\/span><\/a> is absolutely right in terms of working with a travel agent to find a location that works for you. And there are lots of Jamaica brides here - both past and present so looking through the forums here will definitely help you through your planning journey.<\/p>\n<p>\u00a0<\/p>\n<p>Good luck and happy planning!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1426134867","PhotoWidth":668,"PhotoHeight":600,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.204.112.216","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78388,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"3194835e40d9c18f5653819ccb4bc400","RawContent":"&lt;p&gt;We are considering a private villa on the beach or a private location on the beach so that we have privacy and we can do what we want and go as long as we want into the night.&lt;\/p&gt;","Attachments":[],"Id":1878580,"PostDate":1416204982,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>We are considering a private villa on the beach or a private location on the beach so that we have privacy and we can do what we want and go as long as we want into the night.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sashaharris2015@gmail.com","IpAddress":"207.204.112.216","GroupId":39,"GroupName":"Newbie","JoinDate":1416204608,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"sasha2016","Id":281180,"Name":"sasha2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"96.43.179.236","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78388,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"98d26c3d76fd872c92ff3a6f1b3404d4","RawContent":"I&#039;d suggest looking at some off resort and day of wedding venues. That way you can have your wedding the way you want it to be with less restrictions than what the typical hotel offers which can really add up. If you choose to go the hotel route, ensure that you have everything in writing and guaranteed before you get there. My friend recently got married at a well known JA hotel and had a tough time because the original staff she was dealing with changed and then they charged her for everything she was promised to get for free.","Attachments":[],"Id":1878784,"PostDate":1416486908,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'd suggest looking at some off resort and day of wedding venues. That way you can have your wedding the way you want it to be with less restrictions than what the typical hotel offers which can really add up. If you choose to go the hotel route, ensure that you have everything in writing and guaranteed before you get there. My friend recently got married at a well known JA hotel and had a tough time because the original staff she was dealing with changed and then they charged her for everything she was promised to get for free.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cgmcfarlane@yahoo.ca","IpAddress":"96.43.179.96","GroupId":40,"GroupName":"Jr. Member","JoinDate":1341103501,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-257321.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"JA2012","Id":257321,"Name":"JA2012","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"69.121.31.46","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78388,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"d6703524566914c851f2d841b5ed4106","RawContent":"&lt;p&gt;Congrats on your engagement! We&#039;re getting married in April at the Royalton White Sands, it&#039;s about 30 minutes from the Montego Bay airport. We visited in May and loved it. The wedding planner there (Chandlyn) is excellent and the grounds are beautiful, plus lots of choices for ceremony and reception spots.&amp;nbsp;I can email you photos we took while we&#039;re there if you like, just let me know.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Happy Planning!&amp;nbsp; :)&lt;\/p&gt;","Attachments":[],"Id":1878876,"PostDate":1416589385,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats on your engagement! We're getting married in April at the Royalton White Sands, it's about 30 minutes from the Montego Bay airport. We visited in May and loved it. The wedding planner there (Chandlyn) is excellent and the grounds are beautiful, plus lots of choices for ceremony and reception spots.\u00a0I can email you photos we took while we're there if you like, just let me know.<\/p>\n<p>\u00a0<\/p>\n<p>Happy Planning!\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jgugenheim@gmail.com","IpAddress":"69.121.31.46","GroupId":39,"GroupName":"Newbie","JoinDate":1391789727,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276557.jpg?_r=1392759726","PhotoWidth":185,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Soon2beMrsJ","Id":276557,"Name":"Soon2beMrsJ","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.204.112.216","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78388,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"8db926c5d8f74e089a9e240aa8b654ac","RawContent":"&lt;p&gt;We have been working with Helen G Events and she helped us find this gorgeous private villa in Ocho Rios. This way we can do exactly what we want and our guests can stay at an all inclusive close. We also looked at other locations but liked the idea of a private villa in Jamaica.&lt;\/p&gt;","Attachments":[],"Id":1878910,"PostDate":1416630824,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>We have been working with Helen G Events and she helped us find this gorgeous private villa in Ocho Rios. This way we can do exactly what we want and our guests can stay at an all inclusive close. We also looked at other locations but liked the idea of a private villa in Jamaica.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"hhellrazor@yahoo.com","IpAddress":"207.204.112.216","GroupId":39,"GroupName":"Newbie","JoinDate":1416081755,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"jamaicanbride2015","Id":281167,"Name":"jamaicanbride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"171.161.160.10","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78388,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"317a97d6e6c274864d1df412834aa6a4","RawContent":"congrats on your engagement, we did ours at Sandals Whitehouse and it was amazing. we chose there because all the rooms were ocean view, so noone had gto upgrade to have view of ocean and all have private balconies, loved it. [url=\"http:\/\/www.sandals.com\/whitehouse\"]www.sandals.com\/whitehouse[\/url]\n[quote name=\"pddcmc\" post=\"1845269\" timestamp=\"1398008010\"]\nHi ladies! I haven&#039;t seen any posts about arch or gazebo ceremony decor, so I thought I&#039;d try to get it started. \n\nWhat are your plans?\n\n-Tricia[\/quote]i did orange sheer fabric on my gazebo for decorations it was perfect","Attachments":[],"Id":1879312,"PostDate":1417267214,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>congrats on your engagement, we did ours at Sandals Whitehouse and it was amazing. we chose there because all the rooms were ocean view, so noone had gto upgrade to have view of ocean and all have private balconies, loved it. <a href='http:\/\/www.sandals.com\/whitehouse' class='bbc_url' title='External link' rel='nofollow external'>www.sandals.com\/whitehouse<\/a><\/p>\n<br \/><p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>pddcmc, on 20 April 2014 - 11:33 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hi ladies! I haven't seen any posts about arch or gazebo ceremony decor, so I thought I'd try to get it started.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>What are your plans?<\/p>\n<p>\u00a0<\/p>\n<p>-Tricia<\/p>\n<\/div>\n<\/div><\/div>\n<p>i did orange sheer fabric on my gazebo for decorations it was perfect<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"shugapop12@aol.com","IpAddress":"66.87.100.226","GroupId":3,"GroupName":"Member","JoinDate":1369902425,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270119.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"shugapop1","Id":270119,"Name":"shugapop1","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.252.115.75","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78388,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b1f203ef2783ca5f52353657501ef797","RawContent":"[quote name=\"islandbride2016\" post=\"1878491\" timestamp=\"1416099343\"]\nI just recently got engaged and want to get married in Jamaica. Looking at wedding locations any suggestions?[\/quote]Trident Hotel or Strawberry Hills Resort (best locations in my opinion for weddings :) )","Attachments":[],"Id":1884398,"PostDate":1422404919,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>islandbride2016, on 15 November 2014 - 08:55 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>I just recently got engaged and want to get married in Jamaica. Looking at wedding locations any suggestions?<\/p>\n<\/div>\n<\/div><\/div>\n<p>Trident Hotel or Strawberry Hills Resort (best locations in my opinion for weddings <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> )<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>We Did!\u00a0","Email":"charlettemontague@gmail.com","IpAddress":"72.252.115.75","GroupId":39,"GroupName":"Newbie","JoinDate":1422403448,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281910.jpg?_r=1422420999","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Samantha2015","Id":281910,"Name":"Samantha2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.47.125.123","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78388,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"a3e4c8a5971c8e0a5b7d1ec010e410d4","RawContent":"&lt;p&gt;We got married in Jamaica and have vacationed there since. &amp;nbsp;There are so many great locations to fit just about whatever you are looking for. &amp;nbsp;Montego bay is more of the city but plenty of resorts there that offer wedding packages on the resort. &amp;nbsp;Negril area has a lot of smaller hotels with the beautiful beach but may lack privacy if you are doing a beach ceremony. &amp;nbsp;The cliffs will offer more privacy but not beach. &amp;nbsp;Still amazingly beautiful though!&lt;\/p&gt;","Attachments":[],"Id":1884628,"PostDate":1422544043,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>We got married in Jamaica and have vacationed there since. \u00a0There are so many great locations to fit just about whatever you are looking for. \u00a0Montego bay is more of the city but plenty of resorts there that offer wedding packages on the resort. \u00a0Negril area has a lot of smaller hotels with the beautiful beach but may lack privacy if you are doing a beach ceremony. \u00a0The cliffs will offer more privacy but not beach. \u00a0Still amazingly beautiful though!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rachelchic81@gmail.com","IpAddress":"50.32.157.249","GroupId":39,"GroupName":"Newbie","JoinDate":1399992035,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"rachelchic81","Id":277950,"Name":"rachelchic81","IsOnline":false}}],"Id":"78388","Title":"Best Wedding Locations","LastPostDate":1427584209},"Pages":{"TotalItems":13,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
