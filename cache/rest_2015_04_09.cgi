{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":6,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":351,"MovedTo":null,"MovedOn":0,"FirstPostId":1887250,"Rating":0,"RatingHits":0,"Starter":{"Id":282217,"Name":"dana1018","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1424723441,"LastPoster":{"Id":282436,"Name":"S424242","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1887250,"PostDate":1424723441,"PostContent":"Hello All I am currently planning my wedding, it's November 7, 2015 at Azul Sensatori in Riveria...","Author":{"Signature":"","Email":"dnrs1018@aol.com","IpAddress":"170.163.60.6","GroupId":39,"GroupName":"Newbie","JoinDate":1424722328,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"dana1018","Id":282217,"Name":"dana1018","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"170.163.60.6","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78834,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5ab909fd54e253f7dfe130694fed2991","RawContent":"&lt;p&gt;Hello All&lt;\/p&gt;\n&lt;p&gt;I am currently planning my wedding, it&#039;s November 7, 2015 at Azul Sensatori in Riveria Maya.&amp;nbsp; The questions that I have questions about vendors and the cost of flowers, video, photo, and dj?&amp;nbsp; What were the costs and if they allow outside vendors.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thank you in advance&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Dana&lt;\/p&gt;","Attachments":[],"Id":1887250,"PostDate":1424723441,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello All<\/p>\n<p>I am currently planning my wedding, it's November 7, 2015 at Azul Sensatori in Riveria Maya.\u00a0 The questions that I have questions about vendors and the cost of flowers, video, photo, and dj?\u00a0 What were the costs and if they allow outside vendors.<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Thank you in advance<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Dana<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"dnrs1018@aol.com","IpAddress":"170.163.60.6","GroupId":39,"GroupName":"Newbie","JoinDate":1424722328,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"dana1018","Id":282217,"Name":"dana1018","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"184.149.182.226","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78834,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f4d202c9d4b24842ba18e4998093ff18","RawContent":"&lt;p&gt;@[member=\"dana1018\"] have you checked out the Azul Sensatori Brides thread? It is very active and has a ton of information, I&#039;m sure you will be able to find the answers you&#039;re looking for.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;m not getting married at Sensatori but at their sister resort - Azul Fives. I would imagine the outside vendor fee is the same which is $800. Hope that helps!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Happy planning!&lt;\/p&gt;","Attachments":[],"Id":1887256,"PostDate":1424727662,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"282217\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282217-dana1018\/' title='Member profile'><span itemprop=\"name\">dana1018<\/span><\/a> have you checked out the Azul Sensatori Brides thread? It is very active and has a ton of information, I'm sure you will be able to find the answers you're looking for.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I'm not getting married at Sensatori but at their sister resort - Azul Fives. I would imagine the outside vendor fee is the same which is $800. Hope that helps!<\/p>\n<p>\u00a0<\/p>\n<p>Happy planning!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>My planning thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78916-snswedding2016-planning-thread-jan-9-2016-azul-fives\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78916-snswedding2016-planning-thread-jan-9-2016-azul-fives\/<\/a><\/p>\n<p>\u00a0","Email":"sean.n.steph2016@gmail.com","IpAddress":"74.12.52.42","GroupId":39,"GroupName":"Newbie","JoinDate":1415547511,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281055.jpg?_r=1415590512","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"snswedding2016","Id":281055,"Name":"snswedding2016","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"32.213.51.214","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78834,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"23756fe2a6d2f3ab3bc97181b70e055e","RawContent":"Thank you I appreciate it!","Attachments":[],"Id":1887270,"PostDate":1424734739,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thank you I appreciate it! \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"dnrs1018@aol.com","IpAddress":"170.163.60.6","GroupId":39,"GroupName":"Newbie","JoinDate":1424722328,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"dana1018","Id":282217,"Name":"dana1018","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"177.237.111.26","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78834,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0b748e061ac4487c367f3817da5e68f2","RawContent":"&lt;p&gt;Welcome to the forum, Dana and Congrats on your upcoming Azul Sensatori wedding!!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Our last experience with their outside vendor fee for photographers was that they charged $800 or a 3-night stay. We&#039;ve recently adjusted our price packages to help wedding couples facing these kind of outside vendor fees, to give them a break.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;You&#039;re off to a great start already by joining BDW - with all the resources you&#039;ll find here to help with your planning decisions. You&#039;ve also chosen a very picturesque venue, as you can see in these magical wedding \"moments that matter\" Linc captured at one of his recent weddings there.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;...from the &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10152842370209487.1073741912.18683524486&amp;amp;type=3&#039;&gt;Azul Sensatori Wedding Album&lt;\/a&gt;&amp;nbsp;:&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-dfw.xx.fbcdn.net\/hphotos-xfa1\/t31.0-8\/1397568_10152842371624487_2041528875085357585_o.jpg\" alt=\"1397568_10152842371624487_20415288750853\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-dfw.xx.fbcdn.net\/hphotos-xfa1\/t31.0-8\/10662015_10152842372144487_7394194288487996462_o.jpg\" alt=\"10662015_10152842372144487_7394194288487\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-dfw.xx.fbcdn.net\/hphotos-xpf1\/t31.0-8\/10628802_10152842372954487_8167129920600888100_o.jpg\" alt=\"10628802_10152842372954487_8167129920600\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Enjoy your journey, and all the best with your plans, cheers!!! team MTM :)&lt;\/p&gt;","Attachments":[],"Id":1887337,"PostDate":1424790929,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome to the forum, Dana and Congrats on your upcoming Azul Sensatori wedding!!!<\/p>\n<p>\u00a0<\/p>\n<p>Our last experience with their outside vendor fee for photographers was that they charged $800 or a 3-night stay. We've recently adjusted our price packages to help wedding couples facing these kind of outside vendor fees, to give them a break.<\/p>\n<p>\u00a0<\/p>\n<p>You're off to a great start already by joining BDW - with all the resources you'll find here to help with your planning decisions. You've also chosen a very picturesque venue, as you can see in these magical wedding \"moments that matter\" Linc captured at one of his recent weddings there.<\/p>\n<p>\u00a0<\/p>\n<p>...from the <a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10152842370209487.1073741912.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>Azul Sensatori Wedding Album<\/a>\u00a0:<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-dfw.xx.fbcdn.net\/hphotos-xfa1\/t31.0-8\/1397568_10152842371624487_2041528875085357585_o.jpg\" alt=\"1397568_10152842371624487_20415288750853\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-dfw.xx.fbcdn.net\/hphotos-xfa1\/t31.0-8\/10662015_10152842372144487_7394194288487996462_o.jpg\" alt=\"10662015_10152842372144487_7394194288487\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-dfw.xx.fbcdn.net\/hphotos-xpf1\/t31.0-8\/10628802_10152842372954487_8167129920600888100_o.jpg\" alt=\"10628802_10152842372954487_8167129920600\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>Enjoy your journey, and all the best with your plans, cheers!!! team MTM <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280210660,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.137.211.49","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78834,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a0442784de1aabf8edf7fa7f77994e89","RawContent":"&lt;p&gt;Happy planning!&lt;\/p&gt;","Attachments":[],"Id":1889136,"PostDate":1426217602,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Happy planning!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"phimoez@yahoo.com","IpAddress":"50.137.211.49","GroupId":39,"GroupName":"Newbie","JoinDate":1425876636,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"MNsunseeker","Id":282367,"Name":"MNsunseeker","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"67.11.236.101","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78834,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fe9388cac95e4cfb9cc0d2a9c57183b5","RawContent":"&lt;p&gt;Hi Dana. &amp;nbsp;Have you found out much info? &amp;nbsp;I&#039;m hearing Lomas Travel is way over priced and that is who Azul Sensatori uses for decor. &amp;nbsp;I&#039;d love some advice on all the same things.&lt;\/p&gt;","Attachments":[],"Id":1889641,"PostDate":1426601538,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Dana. \u00a0Have you found out much info? \u00a0I'm hearing Lomas Travel is way over priced and that is who Azul Sensatori uses for decor. \u00a0I'd love some advice on all the same things.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ryder.stephanie@gmail.com","IpAddress":"67.11.236.101","GroupId":39,"GroupName":"Newbie","JoinDate":1426552172,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"S424242","Id":282436,"Name":"S424242","IsOnline":false}}],"Id":"78834","Title":"Azul Sensatori Riveira Maya Wedding","LastPostDate":1426601538},"Pages":{"TotalItems":6,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
