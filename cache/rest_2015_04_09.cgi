> Time: 1428549524 / Thu, 09 Apr 2015 03:18:44 +0000
> URL: /index.php?/REST/Forums/topic?startFromPostId=1885163&SessionId=7b4134e0964e0f2c62c174dbb84d71b3
> User Shaylala (282681)
Request Time: 1 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":16,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":635,"MovedTo":null,"MovedOn":0,"FirstPostId":1885163,"Rating":0,"RatingHits":0,"Starter":{"Id":281952,"Name":"racht33","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281952.jpg?_r=1424197509","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"StartDate":1423071906,"LastPoster":{"Id":282367,"Name":"MNsunseeker","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":true},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1885163,"PostDate":1423071906,"PostContent":"Hi all! I totally new to this and would love any feedback possible!\u00a0 I finally was able to convin...","Author":{"Signature":"","Email":"racht33@yahoo.com","IpAddress":"192.249.47.212","GroupId":3,"GroupName":"Member","JoinDate":1422632988,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281952.jpg?_r=1424197509","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"racht33","Id":281952,"Name":"racht33","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"192.249.47.212","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78734,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"09f3b12a75641840573f7acfebb49941","RawContent":"&lt;p&gt;&lt;span style=\"font-size:10pt;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;Hi all! I totally new to this and would love any feedback possible!&amp;nbsp; I finally was able to convince my Fianc\u00e9 to have a destination wedding for next year. With how small our budget is of (8,000). We really are having a hard time locking down where to actually have the wedding. There are so many beautiful places and beautiful resorts its overwhelming! Our number 1 location is the Bahamas because its where we had our first anniversary. To keep to the budget we have heard that Mexico is a prime location to have a great wedding for about 40-50 people( I think more 40 will attend) . I\u2019m not sure what is realistic. one of my bridesmaids just had her baby so by the time we travel her son will be 1 for next year. So I believe that sets us only with family friendly resorts? Am I correct?&amp;nbsp; We would love an all-inclusive resort to have everything covered under 1 price for everyone. &amp;nbsp;And a place that would offer a great wedding experience for the money. My friend is currently getting married at Dreams Riviera Maya and I just love &amp;nbsp;what dreams offers, &amp;nbsp;but the price tag on the resort is a bit steep and we\u2019re concerned that we will get many declines because of the $$ just for the resort.&amp;nbsp; So our locations are : Bahamas, Mexico, maybe Aruba , turks and\u2026. LOL AHHH the list could just go on and on. If anyone has some input on resorts with great prices I would really appreciate it! Also any thoughts on the seasons? We\u2019ve been reading about better deals for the fall months but does it rain a lot? Anyone had any experience with that? THANK YOU ALL SO MUCH!!!!! &lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1885163,"PostDate":1423071906,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span  style=\"font-size:10pt\"><span  style=\"font-family:arial, sans-serif\"><span  style=\"font-size:10pt\"><span  style=\"font-family:arial, sans-serif\">Hi all! I totally new to this and would love any feedback possible!\u00a0 I finally was able to convince my Fianc\u00e9 to have a destination wedding for next year. With how small our budget is of (8,000). We really are having a hard time locking down where to actually have the wedding. There are so many beautiful places and beautiful resorts its overwhelming! Our number 1 location is the Bahamas because its where we had our first anniversary. To keep to the budget we have heard that Mexico is a prime location to have a great wedding for about 40-50 people( I think more 40 will attend) . I\u2019m not sure what is realistic. one of my bridesmaids just had her baby so by the time we travel her son will be 1 for next year. So I believe that sets us only with family friendly resorts? Am I correct?\u00a0 We would love an all-inclusive resort to have everything covered under 1 price for everyone. \u00a0And a place that would offer a great wedding experience for the money. My friend is currently getting married at Dreams Riviera Maya and I just love \u00a0what dreams offers, \u00a0but the price tag on the resort is a bit steep and we\u2019re concerned that we will get many declines because of the $$ just for the resort.\u00a0 So our locations are : Bahamas, Mexico, maybe Aruba , turks and\u2026. LOL AHHH the list could just go on and on. If anyone has some input on resorts with great prices I would really appreciate it! Also any thoughts on the seasons? We\u2019ve been reading about better deals for the fall months but does it rain a lot? Anyone had any experience with that? THANK YOU ALL SO MUCH!!!!! <\/span><\/span><\/span><\/span><\/p>\n<p>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"racht33@yahoo.com","IpAddress":"192.249.47.212","GroupId":3,"GroupName":"Member","JoinDate":1422632988,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281952.jpg?_r=1424197509","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"racht33","Id":281952,"Name":"racht33","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.187.229.252","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78734,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7a0f861c5af41e63e88cb0313e2b8cde","RawContent":"&lt;p&gt;Hi Racht33!&lt;\/p&gt;\n&lt;p&gt;TA Wendy here! Just a quick suggestion, and if you like I am glad to do some more checking for you.. but if you like Dreams but find it a bit high for your guests, you might want to consider the Now properties, either Now Jade or Now Sapphire, both in Cancun\/ Riviera Maya area. They are owned by the same company, AM resorts, and offer the same generous amenites offered for Bride and Groom by Dreams.&lt;\/p&gt;\n&lt;p&gt;You are correct that the fall months would be in general at a lower price and also correct that this is the stormy season, but you could luck out and get no rain.. and actually October is a great time to go.. sort of a sweet spot for timing prior to higher prices closer to the holidays.&lt;\/p&gt;\n&lt;p&gt;If you would like to chat, I am most happy to give you more ideas and assistance! Just PM me!&lt;\/p&gt;\n&lt;p&gt;Best wishes for your planning!&lt;\/p&gt;\n&lt;p&gt;TA Wendy&lt;\/p&gt;","Attachments":[],"Id":1885165,"PostDate":1423072944,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Racht33!<\/p>\n<p>TA Wendy here! Just a quick suggestion, and if you like I am glad to do some more checking for you.. but if you like Dreams but find it a bit high for your guests, you might want to consider the Now properties, either Now Jade or Now Sapphire, both in Cancun\/ Riviera Maya area. They are owned by the same company, AM resorts, and offer the same generous amenites offered for Bride and Groom by Dreams.<\/p>\n<p>You are correct that the fall months would be in general at a lower price and also correct that this is the stormy season, but you could luck out and get no rain.. and actually October is a great time to go.. sort of a sweet spot for timing prior to higher prices closer to the holidays.<\/p>\n<p>If you would like to chat, I am most happy to give you more ideas and assistance! Just PM me!<\/p>\n<p>Best wishes for your planning!<\/p>\n<p>TA Wendy<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><a class='bbc_url' href='http:\/\/wrighttravelagency.com\/inquiry\/'><span style='color: rgb(0,128,128)'>Looking for a travel agency that specializes in Destination Weddings<\/span><\/a><span style='color: rgb(0,128,128)'>? We are an award winning travel agency and you can read our reviews <\/span><a class='bbc_url' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style='color: rgb(0,128,128)'><strong class='bbc'>HERE.<\/strong><\/span><\/a><\/span><\/span><br \/>\n<br \/>\n<span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'><strong class='bbc'>Awards and recognition: <\/strong><\/span><\/span><\/span><\/span><br \/>\n<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'>Palace Resorts Top PRO Agency <\/span><\/span><\/span><\/span><br \/>\n<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'>Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator <\/span><\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>AMResorts Master Agent & Top Agency<\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>Travel Impressions Best of the Best Globe Winner<\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>Apple Vacations Golden Apple Winner<\/span><\/span><\/span>","Email":"wendyhicks1@sbcglobal.net","IpAddress":"99.187.229.252","GroupId":49,"GroupName":"Insiders","JoinDate":1238034240,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-216154.jpg?_r=1419958783","PhotoWidth":200,"PhotoHeight":250,"PhotoType":"custom"},"FormattedName":"TA Wendy","Id":216154,"Name":"TA Wendy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"209.163.219.226","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78734,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"32a8ffd70b77354491680aed27620627","RawContent":"&lt;p&gt;Welcome to the group! &amp;nbsp;This is great place to gather information, it can also be overwhelming at first - so don&#039;t stress! &amp;nbsp;I would definitely suggest talking with TA Wendy - she&#039;s great. &amp;nbsp;I suggest you also start looking at the budget first thing. &amp;nbsp;I thought a destination wedding would be so much cheaper and it&#039;s maybe not really... &amp;nbsp;If you think about the experience you get (3-4 day with your guests or more vs 1 day) then its definitely cheaper, but total dollar amount maybe not... &amp;nbsp;That said I am still so happy we chose to do a destination wedding. &amp;nbsp;Your guest count will make a huge difference. &amp;nbsp;Most resorts have wedding packages for 20-25 people, over that and you start paying per person costs that add up quickly. &amp;nbsp;Also, spend some time thinking about who you really want to be there and if they can make it. &amp;nbsp;Thankfully both of our immediate families are all coming, but we have less friends coming than we originally thought - which is fine with us, but I&#039;ve seen lots of posts on here about wedding parties and family canceling near the end and that seems like a lot of added stress! &amp;nbsp;Good luck with your search and congrats!&lt;\/p&gt;","Attachments":[],"Id":1885166,"PostDate":1423073925,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome to the group! \u00a0This is great place to gather information, it can also be overwhelming at first - so don't stress! \u00a0I would definitely suggest talking with TA Wendy - she's great. \u00a0I suggest you also start looking at the budget first thing. \u00a0I thought a destination wedding would be so much cheaper and it's maybe not really... \u00a0If you think about the experience you get (3-4 day with your guests or more vs 1 day) then its definitely cheaper, but total dollar amount maybe not... \u00a0That said I am still so happy we chose to do a destination wedding. \u00a0Your guest count will make a huge difference. \u00a0Most resorts have wedding packages for 20-25 people, over that and you start paying per person costs that add up quickly. \u00a0Also, spend some time thinking about who you really want to be there and if they can make it. \u00a0Thankfully both of our immediate families are all coming, but we have less friends coming than we originally thought - which is fine with us, but I've seen lots of posts on here about wedding parties and family canceling near the end and that seems like a lot of added stress! \u00a0Good luck with your search and congrats!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"howard.tracyann@gmail.com","IpAddress":"209.163.219.226","GroupId":39,"GroupName":"Newbie","JoinDate":1399414256,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277868.jpg?_r=1400085061","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"tracyannhoward","Id":277868,"Name":"tracyannhoward","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"192.249.47.212","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78734,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1165d6de28028c431184799e3dfeac04","RawContent":"&lt;p&gt;Tracy i really apperciate your input. I had no idea addtional people over the 20-25 would cost us more. :( that is a bit discouraging. I thought this would be the best bet for it to be afforable. :( and&amp;nbsp;be able to get a honey moon out of it aswell.&amp;nbsp;I sent a message to Wendy and hopefully she can help clear things out.&amp;nbsp; Question - did you send out invites prior to locking a resort?&amp;nbsp; and then booked with a confirmed number. Or did you lock in a resort and send out the invites after ? We both have big families so this was a major reason to go away to try and just narrow it down to who we really wanted. But we have alot of friends that all love and care for us. They truly are our family away from acual family.&lt;\/p&gt;","Attachments":[],"Id":1885171,"PostDate":1423074626,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Tracy i really apperciate your input. I had no idea addtional people over the 20-25 would cost us more. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/sad.png' class='bbc_emoticon' alt=':(' \/> that is a bit discouraging. I thought this would be the best bet for it to be afforable. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/sad.png' class='bbc_emoticon' alt=':(' \/> and\u00a0be able to get a honey moon out of it aswell.\u00a0I sent a message to Wendy and hopefully she can help clear things out.\u00a0 Question - did you send out invites prior to locking a resort?\u00a0 and then booked with a confirmed number. Or did you lock in a resort and send out the invites after ? We both have big families so this was a major reason to go away to try and just narrow it down to who we really wanted. But we have alot of friends that all love and care for us. They truly are our family away from acual family.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"racht33@yahoo.com","IpAddress":"192.249.47.212","GroupId":3,"GroupName":"Member","JoinDate":1422632988,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281952.jpg?_r=1424197509","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"racht33","Id":281952,"Name":"racht33","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"107.77.83.28","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78734,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"13fbd08a9e4c8bc9ece9496eee3aba2e","RawContent":"@[member=\"racht33\"] lock down your resort and date before invites. What we did is spread through word-of-mouth about our destination wedding and by the time invites went out we already pretty much knew who was coming. There were a few surprises on the yes and no ends, but overall we pretty much knew who would be coming. \n\n\nI am getting married at Dreams Riviera Cancun in 2 weeks, and yes, the price tag is steep. There are so many resorts down the Riviera at all different price points - You should be able to find one that fits your budget. Also like someone said before, my package includes up to 20 people, everyone over that is additional. Destination does not always mean cheaper. And these resorts nickel and dime for every detail. I hope you find what you are looking for, and best of luck!\n@[member=\"racht33\"] also about the rain, it is unpredictable of course being in a tropical climate, but the heaviest chance for rain is in the fall. Every time I&#039;ve gone to Mexico (12 times) has been in the winter January or February and we&#039;ve probably total had two days of rain out of all those times. We went in September for our site visit, and out of five days we only had two that were sunny. The prices are cheaper in the fall, but there&#039;s a good chance that you could have rain on your day.","Attachments":[],"Id":1885175,"PostDate":1423078012,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"281952\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/281952-racht33\/' title='Member profile'><span itemprop=\"name\">racht33<\/span><\/a> lock down your resort and date before invites. What we did is spread through word-of-mouth about our destination wedding and by the time invites went out we already pretty much knew who was coming. There were a few surprises on the yes and no ends, but overall we pretty much knew who would be coming. <br><br>\nI am getting married at Dreams Riviera Cancun in 2 weeks, and yes, the price tag is steep. There are so many resorts down the Riviera at all different price points - You should be able to find one that fits your budget. Also like someone said before, my package includes up to 20 people, everyone over that is additional. Destination does not always mean cheaper. And these resorts nickel and dime for every detail. I hope you find what you are looking for, and best of luck!<br \/>@<a hovercard-ref=\"member\" hovercard-id=\"281952\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/281952-racht33\/' title='Member profile'><span itemprop=\"name\">racht33<\/span><\/a> also about the rain, it is unpredictable of course being in a tropical climate, but the heaviest chance for rain is in the fall. Every time I've gone to Mexico (12 times) has been in the winter January or February and we've probably total had two days of rain out of all those times. We went in September for our site visit, and out of five days we only had two that were sunny. The prices are cheaper in the fall, but there's a good chance that you could have rain on your day. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"natalie.zaval@gmail.com","IpAddress":"67.184.87.109","GroupId":40,"GroupName":"Jr. Member","JoinDate":1389131752,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275926.jpg?_r=1418313578","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"nattiegams325","Id":275926,"Name":"nattiegams325","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"192.249.47.212","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78734,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f371a81d94e05323d16cf60eac59c33f","RawContent":"&lt;p&gt;@[member=\"nattiegams325\"] thank you so much for your feedback. That is a major worry of mine. To have everyone travel to such a beautiful location and not beable to do anything because its pouring the entire time. Im not sure about the risk on that. AHH so many&amp;nbsp;things to think over. I also wanted to go&amp;nbsp;this route not just for it to be \"more afforable\" as it seems it possibly may not. But also&amp;nbsp;its suppose to be less stress..How do you feel about that aspect&amp;nbsp;? &amp;nbsp;Good Luck with your wedding!! Its crunch time and i know you much be super excited!!!&lt;\/p&gt;","Attachments":[],"Id":1885177,"PostDate":1423078470,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"275926\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/275926-nattiegams325\/' title='Member profile'><span itemprop=\"name\">nattiegams325<\/span><\/a> thank you so much for your feedback. That is a major worry of mine. To have everyone travel to such a beautiful location and not beable to do anything because its pouring the entire time. Im not sure about the risk on that. AHH so many\u00a0things to think over. I also wanted to go\u00a0this route not just for it to be \"more afforable\" as it seems it possibly may not. But also\u00a0its suppose to be less stress..How do you feel about that aspect\u00a0? \u00a0Good Luck with your wedding!! Its crunch time and i know you much be super excited!!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"racht33@yahoo.com","IpAddress":"192.249.47.212","GroupId":3,"GroupName":"Member","JoinDate":1422632988,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281952.jpg?_r=1424197509","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"racht33","Id":281952,"Name":"racht33","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"107.77.83.28","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78734,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"3ebe06c7f01002c2b4f5f81e63655a80","RawContent":"@[member=\"racht33\"] thanks girl!! I can&#039;t wait to be there :-)\n\n\nWhen it comes to stress, I actually found that the most stressful part was choosing the resort. I literally knew every single hotel in the Riviera Maya like the back of my hand from all the research I did lol. Seriously, it got weird. :-) but once you get the resort, everything just kind of falls into place. \n\n\nYou actually don&#039;t really do much planning until about three months before the wedding. So for the eight months or so before I officially started planning, I did things at home like the invitations, my dress, and tons of idea planning on Pinterest and photography sites and these forums! \n\n\nWe went for our site visit in September, if you can find it in your budget to go, I really recommend it. I feel like because we met our wedding planner in advance, she is being extra helpful. Plus then you can get a tour, do a tasting, and start making some decisions. So for stress, I found that it kind of came in waves..high stress in the beginning then nothing. Then high stress during invitation printing and dress finding, then nothing for a few months again. My last major stressor was going back-and-forth with the official planning form - so many decisions that I became really overwhelmed. But now that that&#039;s done I&#039;m not even nervous! \n\n\nDon&#039;t hesitate with any questions, I asked so many during my planning and the girls in this community are so helpful, it&#039;s only right that I return the favor :-) especially when I get back at the end of the month, I&#039;ll be right back on these forums helping out all my future brides again :-)","Attachments":[],"Id":1885179,"PostDate":1423078966,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"281952\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/281952-racht33\/' title='Member profile'><span itemprop=\"name\">racht33<\/span><\/a> thanks girl!! I can't wait to be there :-)<br><br>\nWhen it comes to stress, I actually found that the most stressful part was choosing the resort. I literally knew every single hotel in the Riviera Maya like the back of my hand from all the research I did lol. Seriously, it got weird. :-) but once you get the resort, everything just kind of falls into place. <br><br>\nYou actually don't really do much planning until about three months before the wedding. So for the eight months or so before I officially started planning, I did things at home like the invitations, my dress, and tons of idea planning on Pinterest and photography sites and these forums! <br><br>\nWe went for our site visit in September, if you can find it in your budget to go, I really recommend it. I feel like because we met our wedding planner in advance, she is being extra helpful. Plus then you can get a tour, do a tasting, and start making some decisions. So for stress, I found that it kind of came in waves..high stress in the beginning then nothing. Then high stress during invitation printing and dress finding, then nothing for a few months again. My last major stressor was going back-and-forth with the official planning form - so many decisions that I became really overwhelmed. But now that that's done I'm not even nervous! <br><br>\nDon't hesitate with any questions, I asked so many during my planning and the girls in this community are so helpful, it's only right that I return the favor :-) especially when I get back at the end of the month, I'll be right back on these forums helping out all my future brides again :-)\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"natalie.zaval@gmail.com","IpAddress":"67.184.87.109","GroupId":40,"GroupName":"Jr. Member","JoinDate":1389131752,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275926.jpg?_r=1418313578","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"nattiegams325","Id":275926,"Name":"nattiegams325","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"192.249.47.212","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78734,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"81e7629a6f634a6c78b694f403f8c70b","RawContent":"&lt;p&gt;Just being able to chat with people that have been in my shows is so nice! THank you again!! cant wait to hear how it all went when you get back! @[member=\"nattiegams325\"] !! :)&lt;\/p&gt;","Attachments":[],"Id":1885181,"PostDate":1423079575,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Just being able to chat with people that have been in my shows is so nice! THank you again!! cant wait to hear how it all went when you get back! @<a hovercard-ref=\"member\" hovercard-id=\"275926\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/275926-nattiegams325\/' title='Member profile'><span itemprop=\"name\">nattiegams325<\/span><\/a> !! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"racht33@yahoo.com","IpAddress":"192.249.47.212","GroupId":3,"GroupName":"Member","JoinDate":1422632988,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281952.jpg?_r=1424197509","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"racht33","Id":281952,"Name":"racht33","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"143.58.161.6","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78734,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"44dabb7b53a1a2e892221b6c378453c8","RawContent":"&lt;p&gt;@&lt;span&gt;&lt;a  class=\"\" href=\"http:\/\/www.bestdestinationwedding.com\/user\/281952-racht33\/\" title=\"\"&gt;&lt;span&gt;racht33&lt;\/span&gt;&lt;\/a&gt;&lt;\/span&gt;&amp;nbsp;- Good luck with your decision! I agree with @&lt;span&gt;&lt;a  class=\"\" href=\"http:\/\/www.bestdestinationwedding.com\/user\/275926-nattiegams325\/\" title=\"\"&gt;&lt;span&gt;nattiegams325&lt;\/span&gt;&lt;\/a&gt;&lt;\/span&gt;&amp;nbsp;that choosing the resort is probably one of the most difficult decisions in regards to a destination wedding. I am big on research, so I spent a lot of time picking apart the resorts we were interested in. Also, as was previously mentioned, many resorts charge a per person fee because only a certain number of guests are covered in the initial wedding package (usually 20-25).&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;In general (just from my own non-wedding related travel &amp;amp; planning), I think you will find Punta Cana and Mexico have a wider variety of resort options and more less expensive options that might fit your budget. Aruba is one of my favorite places, but it is pricey. Turks &amp;amp; Caicos is also more expensive.&lt;\/p&gt;","Attachments":[],"Id":1885190,"PostDate":1423083436,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<span><a href='http:\/\/www.bestdestinationwedding.com\/user\/281952-racht33\/' class='bbc_url' title=''><span>racht33<\/span><\/a><\/span>\u00a0- Good luck with your decision! I agree with @<span><a href='http:\/\/www.bestdestinationwedding.com\/user\/275926-nattiegams325\/' class='bbc_url' title=''><span>nattiegams325<\/span><\/a><\/span>\u00a0that choosing the resort is probably one of the most difficult decisions in regards to a destination wedding. I am big on research, so I spent a lot of time picking apart the resorts we were interested in. Also, as was previously mentioned, many resorts charge a per person fee because only a certain number of guests are covered in the initial wedding package (usually 20-25).<\/p>\n<p>\u00a0<\/p>\n<p>In general (just from my own non-wedding related travel & planning), I think you will find Punta Cana and Mexico have a wider variety of resort options and more less expensive options that might fit your budget. Aruba is one of my favorite places, but it is pricey. Turks & Caicos is also more expensive.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jhowe114@gmail.com","IpAddress":"38.98.131.98","GroupId":40,"GroupName":"Jr. Member","JoinDate":1402426389,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278395.jpg?_r=1421871115","PhotoWidth":200,"PhotoHeight":285,"PhotoType":"custom"},"FormattedName":"JenniferH114","Id":278395,"Name":"JenniferH114","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.89.236.44","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78734,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f7330bb7755cf204f6f33b3f8ed18af5","RawContent":"&lt;p&gt;Congratulations and welcome.&lt;\/p&gt;","Attachments":[],"Id":1885201,"PostDate":1423092030,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congratulations and welcome.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"njwood000@gmail.com","IpAddress":"71.7.173.185","GroupId":40,"GroupName":"Jr. Member","JoinDate":1405824791,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Msmimi","Id":279087,"Name":"Msmimi","IsOnline":false}}],"Id":"78734","Title":"Help Making A Decision","LastPostDate":1426218415},"Pages":{"TotalItems":16,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
