tica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>LaurenMoser2B - beautiful dress!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sunandfun2013@gmail.com","IpAddress":"173.33.41.254","GroupId":39,"GroupName":"Newbie","JoinDate":1361225297,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-266260.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":125,"PhotoType":"custom"},"FormattedName":"CdnBrideJoanne","Id":266260,"Name":"CdnBrideJoanne","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8cf936ef14eb17b49f2fbea080185f52","RawContent":"&lt;p&gt;And congratulations!!&lt;\/p&gt;","Attachments":[],"Id":1807338,"PostDate":1381857218,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>And congratulations!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sunandfun2013@gmail.com","IpAddress":"173.33.41.254","GroupId":39,"GroupName":"Newbie","JoinDate":1361225297,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-266260.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":125,"PhotoType":"custom"},"FormattedName":"CdnBrideJoanne","Id":266260,"Name":"CdnBrideJoanne","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a8ff8ad8baab187950ad8faba9584d65","RawContent":"&lt;div class=\"quote-container\"&gt;Quote: &lt;div class=\"quote-block\"&gt;Originally Posted by &lt;strong&gt;martap7&lt;\/strong&gt;&amp;nbsp;&lt;img alt=\"View Post\" src=\"\/img\/forum\/go_quote.gif\" \/&gt;\n &amp;nbsp; &lt;p&gt;When wedding dress shopping I knew what I was looking for (sweatheart strapless lace trumpet style dress)...so I thought! My maid of honor forced me to try on this Allure 8856 even though I made it clear to everyone, NO STRAPS!! After trying the dress on, that was it I fell in love! This Allure gown fit me to the T and hugged me in the right places, even my hips which look fabulous in the dress.&amp;nbsp;I cannot wait for the dress to arrive and will post pics with me in it :)\t\t  &lt;\/p&gt; &lt;p&gt;&lt;img alt=\" \" data-id=\"215504\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/215504\/width\/200\/height\/400\" \/&gt;&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;&lt;img alt=\" \" data-id=\"215505\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/215505\/width\/200\/height\/400\" \/&gt;&lt;\/p&gt; &lt;\/div&gt; &lt;\/div&gt; &lt;p&gt;I really love this style....can&#039;t wait to start trying on dresses.&lt;\/p&gt;","Attachments":[],"Id":1807373,"PostDate":1381864997,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div class=\"quote-container\">Quote: <div class=\"quote-block\">Originally Posted by <strong>martap7<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> \u00a0 <p>When wedding dress shopping I knew what I was looking for (sweatheart strapless lace trumpet style dress)...so I thought! My maid of honor forced me to try on this Allure 8856 even though I made it clear to everyone, NO STRAPS!! After trying the dress on, that was it I fell in love! This Allure gown fit me to the T and hugged me in the right places, even my hips which look fabulous in the dress.\u00a0I cannot wait for the dress to arrive and will post pics with me in it <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0<\/p> <p><span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"215504\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/215504\/width\/200\/height\/400\" \/><\/span><\/p> <p>\u00a0<\/p> <p><span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"215505\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/215505\/width\/200\/height\/400\" \/><\/span><\/p> <\/div> <\/div> <p>I really love this style....can't wait to start trying on dresses.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div>\n<p>43 guests plus bride and groom.... <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Engagement Photos - <a data-ipb='nomediaparse' href='ht