ic\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cassielalexander@gmail.com","IpAddress":"99.234.49.132","GroupId":39,"GroupName":"Newbie","JoinDate":1368222865,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-269486.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"CGervaisToBe","Id":269486,"Name":"CGervaisToBe","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c6610529d5829dfb696beada00696517","RawContent":"&lt;div class=\"quote-container\"&gt;Quote: &lt;div class=\"quote-block\"&gt;Originally Posted by &lt;strong&gt;AllieH&lt;\/strong&gt;&amp;nbsp;&lt;img alt=\"View Post\" src=\"\/img\/forum\/go_quote.gif\" \/&gt;\n &amp;nbsp;&lt;\/div&gt; &lt;\/div&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;Thank you!! :) I loved the detailing around the bottom so much, and was so happy I don&#039;t have to get it hemmed! Perks of being tall I guess ;)&lt;\/p&gt;","Attachments":[],"Id":1802720,"PostDate":1380126136,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div class=\"quote-container\">Quote: <div class=\"quote-block\">Originally Posted by <strong>AllieH<\/strong>\u00a0<a href='\/t\/85\/show-us-your-wedding-dress\/7590#post_1950701' class='bbc_url' title='External link' rel='nofollow external'><img class='bbc_img' alt=\"View Post\" src=\"\/img\/forum\/go_quote.gif\" \/><\/a><br \/> \u00a0<\/div> <\/div> <p>\u00a0<\/p> <p>Thank you!! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> I loved the detailing around the bottom so much, and was so happy I don't have to get it hemmed! Perks of being tall I guess <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cassielalexander@gmail.com","IpAddress":"99.234.49.132","GroupId":39,"GroupName":"Newbie","JoinDate":1368222865,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-269486.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"CGervaisToBe","Id":269486,"Name":"CGervaisToBe","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"dbe80626b506d14d7703a7d8e7e22b61","RawContent":"&lt;div class=\"quote-container\"&gt;Quote: &lt;div class=\"quote-block\"&gt;Originally Posted by &lt;strong&gt;VanessaBB&lt;\/strong&gt;&amp;nbsp;&lt;img alt=\"View Post\" src=\"\/img\/forum\/go_quote.gif\" \/&gt;\n \n &lt;img alt=\"\" data-id=\"221755\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/221755\/width\/200\/height\/400\" \/&gt;\n \n Just received my garter belt from etsy was wondering what else everyone was wearing ? Going with theme of your dresses ? I&#039;m quite happy with my :)&lt;\/div&gt; &lt;\/div&g