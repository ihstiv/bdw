ttp:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"154.20.36.21","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79157,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"2be7db564557748c2d0f3b5b72b43f28","RawContent":"&lt;p&gt;Such a tough decision... Maybe I will buy them both!? LOL&lt;\/p&gt;","Attachments":[],"Id":1895595,"PostDate":1430953807,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Such a tough decision... Maybe I will buy them both!? LOL<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"millar_devon@hotmail.com","IpAddress":"154.20.36.21","GroupId":39,"GroupName":"Newbie","JoinDate":1423314913,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282027.jpg?_r=1429713632","PhotoWidth":169,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Victoriabride","Id":282027,"Name":"Victoriabride","IsOn