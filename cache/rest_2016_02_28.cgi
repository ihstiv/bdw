Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":6,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":108,"MovedTo":null,"MovedOn":0,"FirstPostId":1911322,"Rating":0,"RatingHits":0,"Starter":{"Id":286259,"Name":"Kfred","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286259.jpg?_r=1456671938","PhotoWidth":200,"PhotoHeight":192,"PhotoType":"custom"},"IsOnline":true},"StartDate":1456414266,"LastPoster":{"Id":286259,"Name":"Kfred","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286259.jpg?_r=1456671938","PhotoWidth":200,"PhotoHeight":192,"PhotoType":"custom"},"IsOnline":true},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1911322,"PostDate":1456414266,"PostContent":"FINALLY! we have chosen our resort and about to book with our travel agent. In touch with the San...","Author":{"Signature":"","Email":"kelseyfred79@gmail.com","IpAddress":"204.112.247.38","GroupId":39,"GroupName":"Newbie","JoinDate":1455764783,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286259.jpg?_r=1456671938","PhotoWidth":200,"PhotoHeight":192,"PhotoType":"custom"},"FormattedName":"Kfred","Id":286259,"Name":"Kfred","IsOnline":true}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"204.112.247.38","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79963,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"4f25aa78d8da27b6cda5bcdd590e57bd","RawContent":"&lt;p&gt;FINALLY! we have chosen our resort and about to book with our travel agent. In touch with the Sandos Caracol wedding coordinator and it all begins to somewhat fall into place... PHEW!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Any other Sandos brides out there? Would love some help along the way (from anyone really). Have been looking at the wedding package information that the resort provides and boy do they want to nickel and dime for every last detail! Some advice on what is worth skipping, what is worth bringing from home (and paying for extra luggage I guess), what is worth paying for the outside vendor fee (photographer?, flowers? any experience with the resort vendors out there?)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thanks all and happy planning :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Kelsey&lt;\/p&gt;","Attachments":[],"Id":1911322,"PostDate":1456414266,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>FINALLY! we have chosen our resort and about to book with our travel agent. In touch with the Sandos Caracol wedding coordinator and it all begins to somewhat fall into place... PHEW!<\/p>\n<p>\u00a0<\/p>\n<p>Any other Sandos brides out there? Would love some help along the way (from anyone really). Have been looking at the wedding package information that the resort provides and boy do they want to nickel and dime for every last detail! Some advice on what is worth skipping, what is worth bringing from home (and paying for extra luggage I guess), what is worth paying for the outside vendor fee (photographer?, flowers? any experience with the resort vendors out there?)<\/p>\n<p>\u00a0<\/p>\n<p>Thanks all and happy planning <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Kelsey<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kelseyfred79@gmail.com","IpAddress":"204.112.247.38","GroupId":39,"GroupName":"Newbie","JoinDate":1455764783,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286259.jpg?_r=1456671938","PhotoWidth":200,"PhotoHeight":192,"PhotoType":"custom"},"FormattedName":"Kfred","Id":286259,"Name":"Kfred","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"201.160.139.119","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79963,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"0b2a16804a49221e911fe40a66e04f7c","RawContent":"&lt;p&gt;@[member=\"Kfred\"] Congrats on finding a perfect resort for you!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Its interesting I just did a mini video about this. hope it helps to get started.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;https:\/\/www.youtube.com\/watch?v=fDFU7ljTBcI&amp;amp;feature=youtu.be&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Happy Planning&lt;\/p&gt;\n&lt;p&gt;Joyce&lt;\/p&gt;","Attachments":[],"Id":1911325,"PostDate":1456417034,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"286259\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/286259-kfred\/' title='Member profile'><span itemprop=\"name\">Kfred<\/span><\/a> Congrats on finding a perfect resort for you!<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Its interesting I just did a mini video about this. hope it helps to get started.<\/p>\n<p>\u00a0<\/p>\n<p><iframe id=\"ytplayer\" class=\"EmbeddedVideo\" type=\"text\/html\" width=\"640\" height=\"390\" src=\"http:\/\/youtube.com\/embed\/fDFU7ljTBcI?html5=1&fs=1\" frameborder=\"0\" allowfullscreen webkitallowfullscreen \/><\/iframe><\/p>\n<p>\u00a0<\/p>\n<p>Happy Planning<\/p>\n<p>Joyce<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Dream Weddings Riviera Maya- We pay attention to your wishes and coordinate closely with you to ensure your wedding or event is planned to perfection! Supporting you brides and help you feel less overwhelmed during the wedding planning process.<\/p>\n<p>Have fun the best is yet to come!<\/p>\n<p>\u00a0<\/p>\n<p>This is where I will be posting all videos about most common question about Destination wedding<\/p>\n<p> <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0\u00a0<a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/groups\/1664036763874450\/'>https:\/\/www.facebook.com\/groups\/1664036763874450\/<\/a><br><br><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Dream Weddings Riviera Maya<\/span><\/span><\/span><br><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">weddingsinplayadelcarmen@gmail.com<\/span><\/span><br><a  class=\"bbc_url\" href=\"http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html\">http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html<\/a><br><br><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Happy Planning!<\/span><\/span><\/span><br><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Joyce<\/span><\/span><\/span>","Email":"weddingsinplayadelcarmen@gmail.com","IpAddress":"187.252.44.28","GroupId":84,"GroupName":"Insiders w\/ Articles","JoinDate":1326854387,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250090.jpg?_r=1451923195","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"dreamweddings","Id":250090,"Name":"dreamweddings","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"184.151.222.130","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79963,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"37f7c51d02d79520afbfc8c245544a74","RawContent":"I&#039;m a Sandos bride too!  Apparently we are rare because I never see Sandos Caracol brides.  My wedding is Dec 4, 2016.\n\n\nSent from my SM-G900W8 using Tapatalk","Attachments":[],"Id":1911333,"PostDate":1456427076,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm a Sandos bride too!  Apparently we are rare because I never see Sandos Caracol brides.  My wedding is Dec 4, 2016.<br><br>\nSent from my SM-G900W8 using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tpenner@ualberta.ca","IpAddress":"68.150.177.36","GroupId":3,"GroupName":"Member","JoinDate":1451960069,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-285764.jpg?_r=1451960071","PhotoWidth":200,"PhotoHeight":122,"PhotoType":"custom"},"FormattedName":"tpenner","Id":285764,"Name":"tpenner","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.0.142.65","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79963,"EditedBy":"<strong>Edited by Moments That Matter, 25 February 2016 - 12:15 PM.<\/strong>","EditDate":1456431314,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ebab2182cfe90867d543cb41fca1b1b5","RawContent":"&lt;p&gt;Welcome to our forum community, Kelsey and tpenner, and Congrats on your upcoming Sandos Caracol weddings!!! wow - so Exciting - what a great journey you&#039;re on :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Here&#039;s a link to some threads here discussing the&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/index.php?s=0be71afd68bb9d76696a39badcdea970&amp;amp;app=googlecse#gsc.tab=0&amp;amp;gsc.q=Sandos%20Caracol&#039;&gt; Sandos Caracol,&lt;\/a&gt; in case you haven&#039;t already seen them.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;These are magical wedding moments that matter we captured, taken from our &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.momentsthatmatterphotography.com\/#!blog\/lwgjq&#039;&gt;MTM Blog posts:&amp;nbsp; &lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;.....some shots of the &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.momentsthatmatterphotography.com\/#!blog\/lwgjq\/tag\/Sandos-Cancun-Wedding&#039;&gt;Sandos Cancun&lt;\/a&gt; Wedding Story - enjoy!!!&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/static.wixstatic.com\/media\/e89d55_6b7f82a726aa40ec8acc1f50d7f97a3c.jpg\/v1\/fill\/w_1200,h_800,al_c,q_90\/e89d55_6b7f82a726aa40ec8acc1f50d7f97a3c.jpg\" alt=\"e89d55_6b7f82a726aa40ec8acc1f50d7f97a3c.\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/static.wixstatic.com\/media\/e89d55_13947d498aa941e598fb67e084b0de71.jpg\/v1\/fill\/w_1200,h_800,al_c,q_90\/e89d55_13947d498aa941e598fb67e084b0de71.jpg\" alt=\"e89d55_13947d498aa941e598fb67e084b0de71.\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/static.wixstatic.com\/media\/e89d55_f16750a04ecd432b880520785d872ca4.jpg\/v1\/fill\/w_1200,h_800,al_c,q_90\/e89d55_f16750a04ecd432b880520785d872ca4.jpg\" alt=\"e89d55_f16750a04ecd432b880520785d872ca4.\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;...&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.momentsthatmatterphotography.com\/#!blog\/lwgjq\/tag\/Sandos-Playacar-Wedding&#039;&gt;Sandos Playacar Wedding Story Album: &lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/static.wixstatic.com\/media\/e89d55_a975087841314db480d289a150acef91.jpg\/v1\/fill\/w_1200,h_800,al_c,q_90\/e89d55_a975087841314db480d289a150acef91.jpg\" alt=\"e89d55_a975087841314db480d289a150acef91.\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/static.wixstatic.com\/media\/e89d55_88a530d673e44f2c9b61c2cc66301a99.jpg\/v1\/fill\/w_554,h_831,al_c,q_90,usm_0.66_1.00_0.01\/e89d55_88a530d673e44f2c9b61c2cc66301a99.jpg\" alt=\"e89d55_88a530d673e44f2c9b61c2cc66301a99.\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Wishing you all the best with your plans, and happy research - cheers!!! team MTM [:)]&lt;\/p&gt;","Attachments":[],"Id":1911339,"PostDate":1456431087,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome to our forum community, Kelsey and tpenner, and Congrats on your upcoming Sandos Caracol weddings!!! wow - so Exciting - what a great journey you're on <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Here's a link to some threads here discussing the<a href='http:\/\/www.bestdestinationwedding.com\/index.php?s=0be71afd68bb9d76696a39badcdea970&app=googlecse#gsc.tab=0&gsc.q=Sandos%20Caracol' class='bbc_url' title=''> Sandos Caracol,<\/a> in case you haven't already seen them.<\/p>\n<p>\u00a0<\/p>\n<p>These are magical wedding moments that matter we captured, taken from our <a href='http:\/\/www.momentsthatmatterphotography.com\/#!blog\/lwgjq' class='bbc_url' title='External link' rel='nofollow external'>MTM Blog posts:\u00a0 <\/a><\/p>\n<p>\u00a0<\/p>\n<p>.....some shots of the <a href='http:\/\/www.momentsthatmatterphotography.com\/#!blog\/lwgjq\/tag\/Sandos-Cancun-Wedding' class='bbc_url' title='External link' rel='nofollow external'>Sandos Cancun<\/a> Wedding Story - enjoy!!!<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/static.wixstatic.com\/media\/e89d55_6b7f82a726aa40ec8acc1f50d7f97a3c.jpg\/v1\/fill\/w_1200,h_800,al_c,q_90\/e89d55_6b7f82a726aa40ec8acc1f50d7f97a3c.jpg\" alt=\"e89d55_6b7f82a726aa40ec8acc1f50d7f97a3c.\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/static.wixstatic.com\/media\/e89d55_13947d498aa941e598fb67e084b0de71.jpg\/v1\/fill\/w_1200,h_800,al_c,q_90\/e89d55_13947d498aa941e598fb67e084b0de71.jpg\" alt=\"e89d55_13947d498aa941e598fb67e084b0de71.\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/static.wixstatic.com\/media\/e89d55_f16750a04ecd432b880520785d872ca4.jpg\/v1\/fill\/w_1200,h_800,al_c,q_90\/e89d55_f16750a04ecd432b880520785d872ca4.jpg\" alt=\"e89d55_f16750a04ecd432b880520785d872ca4.\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>...<a href='http:\/\/www.momentsthatmatterphotography.com\/#!blog\/lwgjq\/tag\/Sandos-Playacar-Wedding' class='bbc_url' title='External link' rel='nofollow external'>Sandos Playacar Wedding Story Album: <\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/static.wixstatic.com\/media\/e89d55_a975087841314db480d289a150acef91.jpg\/v1\/fill\/w_1200,h_800,al_c,q_90\/e89d55_a975087841314db480d289a150acef91.jpg\" alt=\"e89d55_a975087841314db480d289a150acef91.\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/static.wixstatic.com\/media\/e89d55_88a530d673e44f2c9b61c2cc66301a99.jpg\/v1\/fill\/w_554,h_831,al_c,q_90,usm_0.66_1.00_0.01\/e89d55_88a530d673e44f2c9b61c2cc66301a99.jpg\" alt=\"e89d55_88a530d673e44f2c9b61c2cc66301a99.\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>Wishing you all the best with your plans, and happy research - cheers!!! team MTM [<img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>]<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<\/p>\n<p>\u00a0<\/p>\n<p>Email: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p><span style=\"color:#0000cd;\"><strong>Why we're Ranked #1<\/strong><\/span> ~ Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a><\/p>\n<p>\u00a0<\/p>\n<p><strong><span style=\"color:#0000cd;\"><span style=\"font-family:'comic sans ms', cursive;\">We Offer<\/span><\/span><\/strong>: <strong><em><u>100% Vendor Fee Discount<\/u><br>\n\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 <u>100% Deposit Guarantee<\/u><\/em><\/strong><\/p>\n<p><strong><em>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 \u00a0 <u>100% Satisfaction Guarantee<\/u><\/em><\/strong>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280210660,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.90.223.125","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79963,"EditedBy":"<strong>Edited by calgarybride2015, 25 February 2016 - 03:27 PM.<\/strong>","EditDate":1456442852,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"48021c324c144e3c34fac3e705e07e65","RawContent":"I&#039;ve stayed at the Sandos. Back in 2013. We really loved it.  Resort advice, if you can, get a room near the pool (an upgrade) as we were in the very back of the resort and it was a trek. Not a bad one but it was far lol\n\nSooooo much to do there. Entertainment was great. Loved the a&#039;la cartes.  Nightly stuff was on\/off (some nights hopping others dead) but you&#039;ll have a blast with all your guests -- you make your own party. Enjoy!!!\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1911345,"PostDate":1456442793,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I've stayed at the Sandos. Back in 2013. We really loved it.  Resort advice, if you can, get a room near the pool (an upgrade) as we were in the very back of the resort and it was a trek. Not a bad one but it was far lol<br>\nSooooo much to do there. Entertainment was great. Loved the a'la cartes.  Nightly stuff was on\/off (some nights hopping others dead) but you'll have a blast with all your guests -- you make your own party. Enjoy!!!<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399428602,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"204.112.247.38","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79963,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ff1834e5dc59d25c466e1bf57212c12d","RawContent":"&lt;p&gt;@[member=\"tpenner\"] YAY another Sandos Caracol bride! Congrats!&amp;nbsp; how is the planning going? which wedding package are you going with? any other details falling into place for you yet?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;thanks all for the responses :)&lt;\/p&gt;","Attachments":[],"Id":1911416,"PostDate":1456671856,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"285764\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/285764-tpenner\/' title='Member profile'><span itemprop=\"name\">tpenner<\/span><\/a> YAY another Sandos Caracol bride! Congrats!\u00a0 how is the planning going? which wedding package are you going with? any other details falling into place for you yet?<\/p>\n<p>\u00a0<\/p>\n<p>thanks all for the responses <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kelseyfred79@gmail.com","IpAddress":"204.112.247.38","GroupId":39,"GroupName":"Newbie","JoinDate":1455764783,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286259.jpg?_r=1456671938","PhotoWidth":200,"PhotoHeight":192,"PhotoType":"custom"},"FormattedName":"Kfred","Id":286259,"Name":"Kfred","IsOnline":true}}],"Id":"79963","Title":"Sandos Caracol January 2017 - Newbie Just Started Planning","LastPostDate":1456671856},"Pages":{"TotalItems":6,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
