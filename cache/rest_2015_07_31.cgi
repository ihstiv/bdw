ad>\r\n              <body>\r\n                Ooo great idea!! I would love this with pink\/white petals scattered along the edge, and then beach brides wouldn't have to worry about their petals flying away in the wind!<br \/> <br \/> Yours looks wonderful, lots of petals left to go <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> I wish I could come help, glue gun in hand.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jackie_cepcion@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1269030731,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-226591.jpg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"jackie_c","Id":226591,"Name":"jackie_c","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":51182,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"516fa1d786eda94f2530481d206e3344","RawContent":"Still 1600 petals to glue hihi! :)\n Thank you for all your comment! I really appreciate it!","Attachments":[],"Id":1128049,"PostDate":1272242856,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Still 1600 petals to glue hihi! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br \/> Thank you for all your comment! I really appreciate it!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>RIVIERA MAYA 2011<\/span><br><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/t\/wxXZqCZ\/weight.png\">http:\/\/tickers.TickerFactory.com\/ezt...qCZ\/weight.png<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;128\/st\/20110412\/e\/Our+Wedding+in+Paradise%21\/k\/e320\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...e320\/event.png<\/a><\/div><\/div>","Email":"cberg008@uottawa.ca","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1269568492,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-226801.jpg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"futur_bride","Id":226801,"Name":"futur_bride","IsOnline":false}}],"Id":"51182","Title":"DIY aisle runner - MONOGRAM AND PETAL - UPDATE!","LastPostDate":1410268617},"Pages":{"TotalItems":57,"TotalPages":6,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":50},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
