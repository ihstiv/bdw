dth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"dominiqueamber","Id":229894,"Name":"dominiqueamber","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60896,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"aace1a3618bb08840274163272b3e83d","RawContent":"&lt;p&gt; BEAUTIFUL!!!&amp;nbsp; these are awesome!!!&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; R~&lt;\/p&gt;","Attachments":[],"Id":1461374,"PostDate":1306933003,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> BEAUTIFUL!!!\u00a0 these are awesome!!!<\/p> <p> \u00a0<\/p> <p> R~<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rashedah.davis@gmail.com","IpAddress":"137.53.241.7","GroupId":3,"GroupName":"Member","JoinDate":1304461292,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-239608.jpeg?_r=0","PhotoWidth":199,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"futuremrstgun","Id":239608,"Name":"futuremrstgun","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60896,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1e4ff563d8a9c8fb99f4c6339211fbbe","RawContent":"&lt;p&gt; Great job! If only I was patient enough to do something like that! They look awesome!&lt;\/p&gt;","Attachments":[],"Id":1462305,"PostDate":1307040227,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Great job! If only I was patient enough to do something like that! They look awesome!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"l_neal5@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1297634743,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-236762.bmp?_r=0","PhotoWidth":0,"PhotoHeight":0,"PhotoType":"custom"},"FormattedName":"Leah2012","Id":236762,"Name":"Leah2012","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60896,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"eae1854b47de2d93806ecaec78c7f80c","RawContent":"&lt;p&gt; I love these!! I did boarding pass invites but htis makes me want to do the passports for something too!!!&lt;\/p&gt;","Attachments":[],"Id":1462317,"PostDate":1307040793,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I love these!! I did boarding pass invites but htis makes me want to do the passports for something too!!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"torilynnsmith@hotmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1305063935,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-239852.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"torilynnsmith","Id":239852,"Name":"torilynnsmith","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60896,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5db12bcd73437c4da7f4155e1e2f654b","RawContent":"&lt;p&gt; I&#039;ve had a couple people ask about what size of stamps I ordered so I thought I would post it:&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; \"Passport\" - 1\/2\" x 2\"&lt;\/p&gt; &lt;p&gt; Palm Tree - 3\" x 2\"&lt;\/p&gt; &lt;p&gt; \"Kelsie &amp;amp; Tom July 19,2011\" - 3\/4\" x 2\"&lt;\/p&gt;","Attachments":[],"Id":1463878,"PostDate":1307298225,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I've had a couple people ask about what size of stamps I ordered so I thought I would post it:<\/p> <p> \u00a0<\/p> <p> \"Passport\" - 1\/2\" x 2\"<\/p> <p> Palm Tree - 3\" x 2\"<\/p> <p> \"Kelsie & Tom July 19,2011\" - 3\/4\" x 2\"<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kclists@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1297441220,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-236684.png?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"KCB2011","Id":236684,"Name":"KCB2011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60896,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ac654114391e0d9c440af0ff582179c3","RawContent":"&lt;p&gt; These look awesome! Thanks so much for all the info, I&#039;m from Canada so this is hugely helpful to me! I am seriously considering doing these invites for my destination wedding myself, but I&#039;m worried they are going to end up being too expensive. Did you find they were pricey per invite or in total?&lt;\/p&gt;","Attachments":[],"Id":1467193,"PostDate":1307750466,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> These look awesome! Thanks so much for all the info, I'm from Canada so this is hugely helpful to me! I am seriously considering doing these invites for my destination wedding myself, but I'm worried they are going to end up being too expensive. Did you find they were pricey per invite or in total?<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"stace_price@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1307750340,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-241007.JPG?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"SS2012","Id":241007,"Name":"SS2012","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60896,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"33df3c27bbca6933ba28e9b7a06a2454","RawContent":"&lt;p&gt; I was trying to figure out a ballpark cost....&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Metallic Paper for Cover: &amp;nbsp;$0.20 per invite (~$0.40 per page and you get 2 covers per page)&lt;\/p&gt; &lt;p&gt; Inside Paper:&amp;nbsp; $0.10 per invite ($10 for 100 pk at Staples and you need one page per invite&amp;nbsp;which is 4 passport size pages like mine)&lt;\/p&gt; &lt;p&gt; *If you use cardstock paper instead of the linen paper it is $8 for 125pk so a little cheaper*&lt;\/p&gt; &lt;p&gt; Note glued to back page paper: $0.02 per invite (used same paper as inside paper)&lt;\/p&gt; &lt;p&gt; &lt;strong&gt;Total Paper Cost Per Invite:&amp;nbsp; $0.32&lt;\/strong&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Staples\/Stapler:&amp;nbsp; I used mine from work but you can get&amp;nbsp;both of these at the dollar store for under $5&lt;\/p&gt; &lt;p&gt; Paper Cutter:&amp;nbsp; $12 (you can get more expensive, fancier ones if you want...)&lt;\/p&gt; &lt;p&gt; Corner Rounder Punch:&amp;nbsp; $8 (you can get more expensive ones of these too if you want)&lt;\/p&gt; &lt;p&gt; Glue: $5&lt;\/p&gt; &lt;p&gt; Computer Ink:  about $75  (I needed 2 colour and 1 black cartridge)&lt;\/p&gt; &lt;p&gt; Ink Pad:&amp;nbsp; $6-8 per pad (I only need one)&lt;\/p&gt; &lt;p&gt; Stamps:&amp;nbsp; about $35 for the stamps and shipping I think.&lt;\/p&gt; &lt;p&gt; &lt;strong&gt;Total Cost of Other Supplies:&amp;nbsp; $148.00&lt;\/strong&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Basically, I think it cost me approximately $1.50 per invite but that does not include my time - and they did take time!!&amp;nbsp; I made about 125 invites&amp;nbsp;in case&amp;nbsp;you want to compare the amount of ink you will need.&lt;\/p&gt;","Attachments":[],"Id":1468411,"PostDate":1307974397,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I was trying to figure out a ballpark cost....<\/p> <p> \u00a0<\/p> <p> Metallic Paper for Cover: \u00a0$0.20 per invite (~$0.40 per page and you get 2 covers per page)<\/p> <p> Inside Paper:\u00a0 $0.10 per invite ($10 for 100 pk at Staples and you need one page per invite\u00a0which is 4 passport size pages like mine)<\/p> <p> *If you use cardstock paper instead of the linen paper it is $8 for 125pk so a little cheaper*<\/p> <p> Note glued to back page paper: $0.02 per invite (used same paper as inside paper)<\/p> <p> <strong>Total Paper Cost Per Invite:\u00a0 $0.32<\/strong><\/p> <p> \u00a0<\/p> <p> Staples\/Stapler:\u00a0 I used mine from work but you can get\u00a0both of these at the dollar store for under $5<\/p> <p> Paper Cutter:\u00a0 $12 (you can get more expensive, fancier ones if you want...)<\/p> <p> Corner Rounder Punch:\u00a0 $8 (you can get more expensive ones of these too if you want)<\/p> <p> Glue: $5<\/p> <p> Computer Ink:\u00a0\u00a0about $75\u00a0\u00a0(I needed 2 colour and 1 black cartridge)<\/p> <p> Ink Pad:\u00a0 $6-8 per pad (I only need one)<\/p> <p> Stamps:\u00a0 about $35 for the stamps and shipping I think.<\/p> <p> <strong>Total Cost of Other Supplies:\u00a0 $148.00<\/strong><\/p> <p> \u00a0<\/p> <p> Basically, I think it cost me approximately $1.50 per invite but that does not include my time - and they did take time!!\u00a0 I made about 125 invites\u00a0in case\u00a0you want to compare the amount of ink you will need.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kclists@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1297441220,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-236684.png?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"KCB2011","Id":236684,"Name":"KCB2011","IsOnline":false}}],"Pages":{"TotalItems":53,"TotalPages":6,"CurrentPage":10,"NextPage":20,"PreviousPage":0,"LastPage":50},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
