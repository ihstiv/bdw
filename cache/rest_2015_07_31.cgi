Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223677.JPG?_r=0","PhotoWidth":200,"PhotoHeight":299,"PhotoType":"custom"},"FormattedName":"mekanabr","Id":223677,"Name":"mekanabr","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":55794,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"30abdd524e3fe1c09811ffafdb01ea2e","RawContent":"&lt;p&gt; these are absolutely perfect! Amazing job!!!!!!!&lt;\/p&gt;","Attachments":[],"Id":1257263,"PostDate":1282089908,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> these are absolutely perfect! Amazing job!!!!!!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><p><span>Getting married at Playa Pesquero! - 35 booked!!<\/span><\/p><span><\/span><\/div><\/div>","Email":"elisa1978@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1281538253,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-231261.JPG?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"elisamarie","Id":231261,"Name":"elisamarie","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":55794,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d0778e63fe1f8fc20c7a707fa8b8b8d7","RawContent":"&lt;p&gt; Very nice! Love the color combination!&lt;\/p&gt;","Attachments":[],"Id":1257335,"PostDate":1282116626,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Very nice! Love the color combination!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"themagicspork@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1273473686,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-228052.jpg?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"bizzyangel","Id":228052,"Name":"bizzyangel","IsOnline":false}}],"Pages":{"TotalItems":103,"TotalPages":11,"CurrentPage":10,"NextPage":20,"PreviousPage":0,"LastPage":100},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
