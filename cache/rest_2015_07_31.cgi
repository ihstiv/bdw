{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":1,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":true,"Views":264,"MovedTo":null,"MovedOn":0,"FirstPostId":1901038,"Rating":0,"RatingHits":0,"Starter":{"Id":284043,"Name":"CosmoMom","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284043.jpg?_r=1437675287","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"StartDate":1437660784,"LastPoster":{"Id":284043,"Name":"CosmoMom","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284043.jpg?_r=1437675287","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":98,"Preview":{"Id":1901038,"PostDate":1437662150,"PostContent":"This is one of the three dresses I bought prior to my destination wedding. \u00a0It was never used so...","Author":{"Signature":"","Email":"erinrachel78@gmail.com","IpAddress":"66.190.76.141","GroupId":39,"GroupName":"Newbie","JoinDate":1437388614,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284043.jpg?_r=1437675287","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"CosmoMom","Id":284043,"Name":"CosmoMom","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.190.76.141","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79428,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"de3cedb9bedba02eae8313002e6edcf7","RawContent":"&lt;p&gt;This is one of the three dresses I bought prior to my destination wedding. &amp;nbsp;It was never used so it is still new, in the original box, with tags. &amp;nbsp;Beautiful, simple lines with ivory lace. &amp;nbsp;David&#039;s Bridal, Galina, strapless trumpet style dress. &amp;nbsp;This would make a great destination wedding dress, or for a TTD session. &amp;nbsp;Original price was $950, selling for $199. &amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;You can find reviews on this dress at this link: &amp;nbsp;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/reviews.davidsbridal.com\/7294\/DB3748\/sy9501-lace-trumpet-with-tulle-overlay-and-beaded-lace-appliques-reviews\/reviews.htm&#039;&gt;http:\/\/reviews.davidsbridal.com\/7294\/DB3748\/sy9501-lace-trumpet-with-tulle-overlay-and-beaded-lace-appliques-reviews\/reviews.htm&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n\n&lt;p&gt;Sorry, this is a size 12 dress never altered. &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1901038,"PostDate":1437662150,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>This is one of the three dresses I bought prior to my destination wedding. \u00a0It was never used so it is still new, in the original box, with tags. \u00a0Beautiful, simple lines with ivory lace. \u00a0David's Bridal, Galina, strapless trumpet style dress. \u00a0This would make a great destination wedding dress, or for a TTD session. \u00a0Original price was $950, selling for $199. \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>You can find reviews on this dress at this link: \u00a0<a href='http:\/\/reviews.davidsbridal.com\/7294\/DB3748\/sy9501-lace-trumpet-with-tulle-overlay-and-beaded-lace-appliques-reviews\/reviews.htm' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/reviews.david...ews\/reviews.htm<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a class='resized_img' rel='lightbox[1901038]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-284043-0-21325400-1437675101.jpg\" title=\"David-s-Bridal-Trumpet--SY9501-Ivory-2008-1_t_w300_h400.jpg - Size: 6.6KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-284043-0-21325400-1437675101.jpg\" class='bbc_img linked-image' alt=\"David-s-Bridal-Trumpet--SY9501-Ivory-2008-1_t_w300_h400.jpg\" \/><\/a>\n\n<a class='resized_img' rel='lightbox[1901038]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-284043-0-73453700-1437675104.jpg\" title=\"IMG_3045.JPG - Size: 65.26KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-284043-0-73453700-1437675104.jpg\" class='bbc_img linked-image' alt=\"IMG_3045.JPG\" \/><\/a>\n\n<a class='resized_img' rel='lightbox[1901038]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-284043-0-31054600-1437675108.jpg\" title=\"IMG_3046.JPG - Size: 90.89KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-284043-0-31054600-1437675108.jpg\" class='bbc_img linked-image' alt=\"IMG_3046.JPG\" \/><\/a>\n\n<a class='resized_img' rel='lightbox[1901038]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-284043-0-82923700-1437675111.jpg\" title=\"IMG_3047.JPG - Size: 81.38KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2015\/post-284043-0-82923700-1437675111.jpg\" class='bbc_img linked-image' alt=\"IMG_3047.JPG\" \/><\/a>\n\n<\/p>\n<br \/><p>Sorry, this is a size 12 dress never altered. \u00a0<\/p>\n\r\