> Time: 1438341266 / Fri, 31 Jul 2015 11:14:26 +0000
> URL: /index.php?/REST/Forums/topic?startFromPostId=1441467&SessionId=eda2029342b08424be970b19494900d3
> User jacquewedding (283943)
Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":53,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":15308,"MovedTo":null,"MovedOn":0,"FirstPostId":1441467,"Rating":0,"RatingHits":0,"Starter":{"Id":236684,"Name":"KCB2011","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-236684.png?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"StartDate":1303851153,"LastPoster":{"Id":280018,"Name":"dimagama","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":74,"Preview":{"Id":1441467,"PostDate":1303851153,"PostContent":"I finally finished my passport invites and I'm pretty happy with the way they turned out conside...","Author":{"Signature":"","Email":"kclists@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1297441220,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-236684.png?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"KCB2011","Id":236684,"Name":"KCB2011","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60896,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b5c6f7e06f225c20381ed61a40f6901f","RawContent":"&lt;p&gt; I finally finished my passport invites and I&#039;m pretty happy with the way they turned out considering how much work they were!&amp;nbsp; I should also mention that I am a very frugal bride so&amp;nbsp;my goal with these was to save as much money as possible.&amp;nbsp; I used the free template from &lt;img alt=\"IMG_0306.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/394706\/width\/1000\/height\/500\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;strong&gt;Cover Paper&lt;\/strong&gt;:&amp;nbsp;&lt;em&gt; Stardream&amp;nbsp;&lt;\/em&gt;Fairway Metallic Paper&amp;nbsp;- Text weight (81lb\/120gsm) from &lt;img alt=\"pg1.png\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/394740\/width\/1000\/height\/500\" \/&gt;&lt;\/p&gt; &lt;p&gt; &lt;strong&gt;Page 1:&lt;\/strong&gt; I used the same palm tree graphic&amp;nbsp;from our STDs and made it a watermark (Recolor - \"washout\" under Format Picture in MS Word)&lt;\/p&gt; &lt;p&gt; &lt;strong&gt;&lt;img alt=\"pg2.png\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/394742\/width\/1000\/height\/500\" \/&gt;&lt;\/strong&gt;&lt;\/p&gt; &lt;p&gt; &lt;strong&gt;&lt;img alt=\"pg3.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/394744\/width\/1000\/height\/500\" \/&gt;&lt;\/strong&gt;&lt;\/p&gt; &lt;p&gt; &lt;strong&gt;&lt;img alt=\"pg6,7.png\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/394748\/width\/1000\/height\/500\" \/&gt;&lt;\/strong&gt;&lt;\/p&gt; &lt;p&gt; &lt;strong&gt;Passport Stamps:&lt;\/strong&gt;&amp;nbsp; I made a bunch of different ones on MS Powerpoint (using shapes and text boxes) and I made them personalized to our dates, location, etc.&amp;nbsp; I made these watermarked the same way I did for the palm tree on the first page and arranged them randomly on the pages behind the text.&lt;\/p&gt; &lt;p&gt; &lt;strong&gt;&lt;img alt=\"pg4,5.png\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/394746\/width\/1000\/height\/500\" \/&gt;&lt;\/strong&gt;&lt;\/p&gt; &lt;p&gt; I made these Passport type stamps the same way - they just aren&#039;t watermarked.&lt;\/p&gt; &lt;p&gt; &lt;strong&gt;&lt;img alt=\"pg8,9.png\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/394765\/width\/1000\/height\/500\" \/&gt;&lt;\/strong&gt;&lt;\/p&gt; &lt;p&gt; &lt;strong&gt;Last Page:&amp;nbsp; &lt;\/strong&gt;I printed the little note from us on linen paper (see below for brand etc) and glued (&lt;em&gt;Elmers&lt;\/em&gt; Craft Bond&amp;nbsp;stick from Michael&#039;s)&amp;nbsp;it on to the inside back cover - I tried card stock and it was didn&#039;t stick very well.&amp;nbsp; This actually made the back cover seem thicker.&amp;nbsp; (I used a page from the ayleebits template to get the correct size for the note and I just printed 4 per page)&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;strong&gt;Paper for inside pages&lt;\/strong&gt;:&amp;nbsp;&lt;em&gt; Staples &lt;\/em&gt;Cover Stock AND &lt;em&gt;Synergy Bond &lt;\/em&gt;Linen finish paper (also from Staples) - I started with the cover stock but ran out and wasn&#039;t going to buy a whole package for 10 more invites!&amp;nbsp; FYI:&amp;nbsp; both weights of paper worked perfectly fine so whichever you prefer would work - if you had more pages than me, you might want to use the lighter\/thinner paper.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I used a cheap paper cutter (&lt;em&gt;Fiskars&lt;\/em&gt;)&amp;nbsp;that I bought from Michael&#039;s on sale to cut all of the pages - then I used a corner punch (&lt;em&gt;Marvy Uchida&lt;\/em&gt;) to round the corners of all the pages - also bought at Michael&#039;s on sale.&amp;nbsp; I folded everything in half so I knew where the line was that I needed to staple and then I staple from the outside.&amp;nbsp; The last thing I did was stamp the front as the ink wouldn&#039;t really soak in to the paper so I didn&#039;t want it to smudge.&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"cutter.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/394909\/width\/1000\/height\/500\" \/&gt;&lt;img alt=\"corner punch.jpg\" height=\"116\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/394867\/width\/1000\/height\/500\" style=\"width: 147px; height: 135px\" width=\"120\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;u&gt;A few notes:&lt;\/u&gt;&lt;\/p&gt; &lt;p&gt; - I would suggest leaving the finished invites out to let the ink dry on the&amp;nbsp;cover&amp;nbsp;as there were a few that I smudged because the ink hadn&#039;t had time to dry&amp;nbsp;- It was never completely dry\/soaked in but it was not a problem once I started letting them sit for a bit.&lt;\/p&gt; &lt;p&gt; - I printed everything on my home inkjet computer with no problems but it did take a couple trials (I just used grayscale printing on cheap printer paper) to make sure that the inside pages were perfectly lined up for printing double-sided.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Hopefully this will help someone!&lt;\/p&gt;","Attachments":[],"Id":1441467,"PostDate":1303851153,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I finally finished my passport invites and I'm pretty happy with the way they turned out considering how much work they were!\u00a0 I should also mention that I am a very frugal bride so\u00a0my goal with these was to save as much money as possible.\u00a0 I used the free template from <span rel='lightbox'><img class='bbc_img' alt=\"IMG_0306.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/394706\/width\/1000\/height\/500\" \/><\/span><\/p> <p> \u00a0<\/p> <p> <strong>Cover Paper<\/strong>:\u00a0<em> Stardream\u00a0<\/em>Fairway Metallic Paper\u00a0- Text weight (81lb\/120gsm) from <span rel='lightbox'><img class='bbc_img' alt=\"pg1.png\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/394740\/width\/1000\/height\/500\" \/><\/span><\/p> <p> <strong>Page 1:<\/strong> I used the same palm tree graphic\u00a0from our STDs and made it a watermark (Recolor - \"washout\" under Format Picture in MS Word)<\/p> <p> <strong><span rel='lightbox'><img class='bbc_img' alt=\"pg2.png\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/394742\/width\/1000\/height\/500\" \/><\/span><\/strong><\/p> <p> <strong><span rel='lightbox'><img class='bbc_img' alt=\"pg3.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/394744\/width\/1000\/height\/500\" \/><\/span><\/strong><\/p> <p> <strong><span rel='lightbox'><img class='bbc_img' alt=\"pg6,7.png\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/394748\/width\/1000\/height\/500\" \/><\/span><\/strong><\/p> <p> <strong>Passport Stamps:<\/strong>\u00a0 I made a bunch of different ones on MS Powerpoint (using shapes and text boxes) and I made them personalized to our dates, location, etc.\u00a0 I made these watermarked the same way I did for the palm tree on the first page and arranged them randomly on the pages behind the text.<\/p> <p> <strong><span rel='lightbox'><img class='bbc_img' alt=\"pg4,5.png\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/394746\/width\/1000\/height\/500\" \/><\/span><\/strong><\/p> <p> I made these Passport type stamps the same way - they just aren't watermarked.<\/p> <p> <strong><span rel='lightbox'><img class='bbc_img' alt=\"pg8,9.png\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/394765\/width\/1000\/height\/500\" \/><\/span><\/strong><\/p> <p> <strong>Last Page:\u00a0 <\/strong>I printed the little note from us on linen paper (see below for brand etc) and glued (<em>Elmers<\/em> Craft Bond\u00a0stick from Michael's)\u00a0it on to the inside back cover - I tried card stock and it was didn't stick very well.\u00a0 This actually made the back cover seem thicker.\u00a0 (I used a page from the ayleebits template to get the correct size for the note and I just printed 4 per page)<\/p> <p> \u00a0<\/p> <p> <strong>Paper for inside pages<\/strong>:\u00a0<em> Staples <\/em>Cover Stock AND <em>Synergy Bond <\/em>Linen finish paper (also from Staples) - I started with the cover stock but ran out and wasn't going to buy a whole package for 10 more invites!\u00a0 FYI:\u00a0 both weights of paper worked perfectly fine so whichever you prefer would work - if you had more pages than me, you might want to use the lighter\/thinner paper.<\/p> <p> \u00a0<\/p> <p> I used a cheap paper cutter (<em>Fiskars<\/em>)\u00a0that I bought from Michael's on sale to cut all of the pages - then I used a corner punch (<em>Marvy Uchida<\/em>) to round the corners of all the pages - also bought at Michael's on sale.\u00a0 I folded everything in half so I knew where the line was that I needed to staple and then I staple from the outside.\u00a0 The last thing I did was stamp the front as the ink wouldn't really soak in to the paper so I didn't want it to smudge.<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"cutter.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/394909\/width\/1000\/height\/500\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\"corner punch.jpg\" height=\"116\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/394867\/width\/1000\/height\/500\" style=\"width: 147px; height: 135px\" width=\"120\" \/><\/span><\/p> <p> \u00a0<\/p> <p> <u>A few notes:<\/u><\/p> <p> - I would suggest leaving the finished invites out to let the ink dry on the\u00a0cover\u00a0as there were a few that I smudged because the ink hadn't had time to dry\u00a0- It was never completely dry\/soaked in but it was not a problem once I started letting them sit for a bit.<\/p> <p> - I printed everything on my home inkjet computer with no problems but it did take a couple trials (I just used grayscale printing on cheap printer paper) to make sure that the inside pages were perfectly lined up for printing double-sided.<\/p> <p> \u00a0<\/p> <p> Hopefully this will help someone!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kclists@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1297441220,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-236684.png?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"KCB2011","Id":236684,"Name":"KCB2011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60896,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"285bfb7ee5319c02e3b75b3aae45fbf9","RawContent":"Those look awesome! Great info for Canadian brides. How did you get the pages to print double sided? When I printed a free one off aylee bits I found they didn&#039;t align very well. How did you order the pages when printing? I&#039;d love to see your template for these!","Attachments":[],"Id":1441473,"PostDate":1303851556,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Those look awesome! Great info for Canadian brides. How did you get the pages to print double sided? When I printed a free one off aylee bits I found they didn't align very well. How did you order the pages when printing? I'd love to see your template for these!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><\/div><\/div>","Email":"clairmoney@hotmail.com","IpAddress":"68.148.77.44","GroupId":40,"GroupName":"Jr. Member","JoinDate":1289868635,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-233985.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"780chick","Id":233985,"Name":"780chick","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60896,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a61f2a5d2bee9d98b7b5de19b85bd824","RawContent":"&lt;p&gt; For the alignment I found it helpful to turn on the gridlines on Word (under the View tab) - On my printer I had to do the double sided manually (wait for all the first pages to print, then re-insert the pages in the printer for the second page to print) so I had to check the \"manual duplex\" box on the print settings.&amp;nbsp; I know that some printers don&#039;t have this capability, but you can still specify only to print page 1, then go to print again and print only page 2.&amp;nbsp; Like I said, if you print a couple trials, you can see how far off they are from lining up, then go to the Home Tab and on the far right&amp;nbsp;click \"select\" then \"select objects\" - make a box with the arrow around EVERYTHING on one of the pages (ONLY ONE PAGE), then hold down CTRL and use the arrows to move everything side to side (make sure you don&#039;t click anywhere after this or it will unselect everything and you will have to do the select objects thing over again).&amp;nbsp; Vertically, both pages had to be even when compared to the gridlines, but horizontally, both pages did not match up on the gridlines (one looked way further to the left than the other).&amp;nbsp; Does that make any sense or is it more confusing? haha.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; To get the right order, I printed the template with just page numbers on it, then I cut it out as though I was making the invite and that&#039;s how I knew what page I wanted things to be on - I made a print screen of the two pages that I printed back to back to get my inside pages if that helps:&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"screen shot of word.png\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/394952\/width\/1000\/height\/500\" \/&gt;&lt;\/p&gt;","Attachments":[],"Id":1441483,"PostDate":1303852997,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> For the alignment I found it helpful to turn on the gridlines on Word (under the View tab) - On my printer I had to do the double sided manually (wait for all the first pages to print, then re-insert the pages in the printer for the second page to print) so I had to check the \"manual duplex\" box on the print settings.\u00a0 I know that some printers don't have this capability, but you can still specify only to print page 1, then go to print again and print only page 2.\u00a0 Like I said, if you print a couple trials, you can see how far off they are from lining up, then go to the Home Tab and on the far right\u00a0click \"select\" then \"select objects\" - make a box with the arrow around EVERYTHING on one of the pages (ONLY ONE PAGE), then hold down CTRL and use the arrows to move everything side to side (make sure you don't click anywhere after this or it will unselect everything and you will have to do the select objects thing over again).\u00a0 Vertically, both pages had to be even when compared to the gridlines, but horizontally, both pages did not match up on the gridlines (one looked way further to the left than the other).\u00a0 Does that make any sense or is it more confusing? haha.<\/p> <p> \u00a0<\/p> <p> To get the right order, I printed the template with just page numbers on it, then I cut it out as though I was making the invite and that's how I knew what page I wanted things to be on - I made a print screen of the two pages that I printed back to back to get my inside pages if that helps:<\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"screen shot of word.png\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/394952\/width\/1000\/height\/500\" \/><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kclists@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1297441220,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-236684.png?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"KCB2011","Id":236684,"Name":"KCB2011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60896,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d77835f66c2224952d46f965a3b4a35c","RawContent":"&lt;p&gt; Those look fantastic!&amp;nbsp; I love all your custom passport stamps - I had lots of trouble trying to print words in an arch so I finally gave up and paid for Aylee&#039;s template with the watermarks.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; 780chick - the $10 Aylee template has 2 formats - one like the one shown above and one which prints 2 of the same thing on each page.&amp;nbsp; I used that one and found it much easier to line up and order the pages.&amp;nbsp; &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1442465,"PostDate":1303985718,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Those look fantastic!\u00a0 I love all your custom passport stamps - I had lots of trouble trying to print words in an arch so I finally gave up and paid for Aylee's template with the watermarks.<\/p> <p> \u00a0<\/p> <p> 780chick - the $10 Aylee template has 2 formats - one like the one shown above and one which prints 2 of the same thing on each page.\u00a0 I used that one and found it much easier to line up and order the pages.\u00a0 \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><p><span>Steph & John........Atlantis.......June 18, 2011......happily married<\/span><\/p><span><\/span><\/div><\/div>","Email":"steph@tmgatl.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1283270642,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-231931.JPG?_r=0","PhotoWidth":200,"PhotoHeight":146,"PhotoType":"custom"},"FormattedName":"skp1","Id":231931,"Name":"skp1","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60896,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"76068308da84b2d1add2486472f3e561","RawContent":"&lt;p&gt; These came out great!!! You did a great job, love the stamps too!&lt;\/p&gt;","Attachments":[],"Id":1442477,"PostDate":1303986410,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> These came out great!!! You did a great job, love the stamps too!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ssanzick@gmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1295370669,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-235711.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Sharon99","Id":235711,"Name":"Sharon99","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60896,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6cfbfe71e2645efe734f06ed0582c792","RawContent":"&lt;p&gt; You did a great job! I am working on my passport Save the Dates using the same template. I have been going back &amp;amp; forth about the cover color b\/c I really wanted navy blue or dark green, but couldnt figure out how to print on it. Thanks so much for posting about those stamps...I&#039;m headed to that website now!&lt;\/p&gt; \n &lt;p&gt; &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1442679,"PostDate":1304000489,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> You did a great job! I am working on my passport Save the Dates using the same template. I have been going back & forth about the cover color b\/c I really wanted navy blue or dark green, but couldnt figure out how to print on it. Thanks so much for posting about those stamps...I'm headed to that website now!<\/p> <br \/> <p> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kristinstiffler@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1283250187,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-231919.JPG?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"kris9685","Id":231919,"Name":"kris9685","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60896,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5c4d1e094d95d502950fa61b2d274ba1","RawContent":"&lt;p&gt; These turned out so well! I love the idea to stamp the covers.&lt;\/p&gt;","Attachments":[],"Id":1442993,"PostDate":1304028478,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> These turned out so well! I love the idea to stamp the covers.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>November 26th 2011 - Gran Bahai Principe Jamacia<\/span><br><span>Booked: 31 Adults + 5 children + Bride and Groom!!!<\/span><\/div><\/div>","Email":"melissa_prior@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1299794807,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-237667.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"missmeliss","Id":237667,"Name":"missmeliss","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60896,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d3f4a4912d9b4ff4719ba03000c891cf","RawContent":"&lt;p&gt; They look fantastic!!&lt;\/p&gt;","Attachments":[],"Id":1443660,"PostDate":1304117535,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> They look fantastic!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jkergen@hotmail.com","IpAddress":"137.186.71.240","GroupId":42,"GroupName":"Sr. Member","JoinDate":1293145500,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-234788.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"JayKay","Id":234788,"Name":"JayKay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60896,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1d4d370b3e17e8ad7e512e0ac81f2c4c","RawContent":"&lt;p&gt; i love your colors and thank you so much for the detailed step by step soo very helpful!&lt;\/p&gt;","Attachments":[],"Id":1444905,"PostDate":1304351256,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> i love your colors and thank you so much for the detailed step by step soo very helpful!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ellie@cprcontractors.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1267136569,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-225954.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"ellie0717","Id":225954,"Name":"ellie0717","IsOnline