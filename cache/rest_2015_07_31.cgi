":1639873,"Rating":0,"RatingHits":0,"Starter":{"Id":253310,"Name":"KrystalDawn","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-253310.jpeg?_r=0","PhotoWidth":160,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":false},"StartDate":1341908565,"LastPoster":{"Id":279175,"Name":"Lilian84","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279175.jpg?_r=1406605860","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":37,"Preview":{"Id":1639873,"PostDate":1341908565,"PostContent":"I know the title may sound bad, but I'm curious if anyone else out there was proposed to in a wa...","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><p><span>Even a trillion hearts are still too few to hold all the love I have for you<3<\/span><\/p><span><\/span><\/div><\/div>","Email":"kdthompson@eprod.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1332934642,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-253310.jpeg?_r=0","PhotoWidth":160,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"KrystalDawn","Id":253310,"Name":"KrystalDawn","IsOnline":false}},"Posts":[],"Id":"68420","Title":"Anyone have a not so \"magical\" proposal?","LastPostDate":1406754306},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":27,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":1449,"MovedTo":null,"MovedOn":0,"FirstPostId":1502715,"Rating":0,"RatingHits":0,"Starter":{"Id":238489,"Name":"Peach","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-238489.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":113,"PhotoType":"custom"},"IsOnline":false},"StartDate":1313019536,"LastPoster":{"Id":278601,"Name":"atennille","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278601.jpg?_r=1403203318","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":37,"Preview":{"Id":1502715,"PostDate":1313019536,"PostContent":"Okay, so I have been reading everyone else's stories and am so excited to get to add my own fina...","Author":{"Signature":"","Email":"krys85418@gmail.com","IpAddress":"108.181.124.120","GroupId":42,"GroupName":"Sr. Member","JoinDate":1301859312,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-238489.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"Peach","Id":238489,"Name":"Peach","IsOnline":false}},"Posts":[],"Id":"62813","Title":"Engaged!","LastPostDate":1405489611},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":37,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":2829,"MovedTo":null,"MovedOn":0,"FirstPostId":1227100,"Rating":0,"RatingHits":0,"Starter":{"Id":216462,"Name":"Danyelle","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-216462.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"IsOnline":false},"StartDate":1279835209,"LastPoster":{"Id":278601,"Name":"atennille","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278601.jpg?_r=1403203318","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":37,"Preview":{"Id":1227100,"PostDate":1279835209,"PostContent":"But I love the one th