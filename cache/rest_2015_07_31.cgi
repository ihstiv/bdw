{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":13,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":737,"MovedTo":null,"MovedOn":0,"FirstPostId":1884637,"Rating":0,"RatingHits":0,"Starter":{"Id":281895,"Name":"breezie","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281895.jpg?_r=1432318131","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"StartDate":1422547608,"LastPoster":{"Id":281895,"Name":"breezie","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281895.jpg?_r=1432318131","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":60,"Preview":{"Id":1884637,"PostDate":1422547608,"PostContent":"We opted out of the civil ceremony in Mexico and are just doing the symbolic one and getting lega...","Author":{"Signature":"","Email":"briannehillier@gmail.com","IpAddress":"173.183.193.17","GroupId":39,"GroupName":"Newbie","JoinDate":1422361322,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281895.jpg?_r=1432318131","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"breezie","Id":281895,"Name":"breezie","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.183.193.17","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78706,"EditedBy":"<strong>Edited by breezie, 29 January 2015 - 04:08 PM.<\/strong>","EditDate":1422547694,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4e8827f297b6a28efddf9b6995fa897e","RawContent":"&lt;p&gt;We opted out of the civil ceremony in Mexico and are just doing the symbolic one and getting legally married at home.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Which date do we celebrate as our anniversary?&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1884637,"PostDate":1422547608,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>We opted out of the civil ceremony in Mexico and are just doing the symbolic one and getting legally married at home.<\/p>\n<p>\u00a0<\/p>\n<p>Which date do we celebrate as our anniversary?\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"briannehillier@gmail.com","IpAddress":"173.183.193.17","GroupId":39,"GroupName":"Newbie","JoinDate":1422361322,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281895.jpg?_r=1432318131","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"breezie","Id":281895,"Name":"breezie","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.249.106.58","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78706,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"01dfd2fb7a3b400d29fe0840450815f3","RawContent":"&lt;p&gt;It&#039;s totally up to you!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We are getting legally married back home after our symbolic ceremony in Punta Cana. We will celebrate our destination wedding date as our anniversary because to us that is the date we will be getting married. The legal ceremony back home is just paperwork to us!&lt;\/p&gt;","Attachments":[],"Id":1884638,"PostDate":1422548272,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>It's totally up to you!<\/p>\n<p>\u00a0<\/p>\n<p>We are getting legally married back home after our symbolic ceremony in Punta Cana. We will celebrate our destination wedding date as our anniversary because to us that is the date we will be getting married. The legal ceremony back home is just paperwork to us!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kelly_miller_@hotmail.com","IpAddress":"99.249.122.85","GroupId":40,"GroupName":"Jr. Member","JoinDate":1390758531,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kellymiller","Id":276338,"Name":"kellymiller","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"64.53.250.35","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78706,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"10718b7c6c04dc42a5f3f8314b6171e1","RawContent":"&lt;p&gt;I agree with @[member=\"kellymiller\"] , ultimately up to you, but since my destination wedding is going to be the day I truly celebrate my marriage with my family and friends, it&#039;s the one I want to remember for years to come, even if it&#039;s not the \"legal\" date!&lt;\/p&gt;","Attachments":[],"Id":1884640,"PostDate":1422549509,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I agree with @<a hovercard-ref=\"member\" hovercard-id=\"276338\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/276338-kellymiller\/' title='Member profile'><span itemprop=\"name\">kellymiller<\/span><\/a> , ultimately up to you, but since my destination wedding is going to be the day I truly celebrate my marriage with my family and friends, it's the one I want to remember for years to come, even if it's not the \"legal\" date!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rachelia160@aim.com","IpAddress":"66.61.104.237","GroupId":40,"GroupName":"Jr. Member","JoinDate":1388717497,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275855.jpg?_r=1435853657","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"rachelia160","Id":275855,"Name":"rachelia160","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.90.222.96","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78706,"EditedBy":"<strong>Edited by calgarybride2015, 29 January 2015 - 05:23 PM.<\/strong>","EditDate":1422552203,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"4fa2016aa85ae524a1f05d55400afae4","RawContent":"Mexico&#039;s date!!! That to us is our wedding and same for our guests. Canada&#039;s was just a requirement in the process we say :)\n\n\nObviously for legal stuff we have to use the Canadian date.","Attachments":[],"Id":1884649,"PostDate":1422552042,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Mexico's date!!! That to us is our wedding and same for our guests. Canada's was just a requirement in the process we say <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br><br>\nObviously for legal stuff we have to use the Canadian date. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.183.193.17","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78706,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":3,"IsLiked":false,"PostKey":"7fa53555cd3b9c0d0f8224f146e5fad1","RawContent":"&lt;p&gt;Think i can get away with two anniversaries?&amp;nbsp; :P &amp;nbsp;LOL&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1884651,"PostDate":1422552508,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Think i can get away with two anniversaries?\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/tongue.png' class='bbc_emoticon' alt=':P' \/> \u00a0LOL\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"briannehillier@gmail.com","IpAddress":"173.183.193.17","GroupId":39,"GroupName":"Newbie","JoinDate":1422361322,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281895.jpg?_r=1432318131","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"breezie","Id":281895,"Name":"breezie","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.113.233.65","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78706,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"1bf26f6ad37370b7723b94f69799380f","RawContent":"&lt;p&gt;@[member=\"breezie\"] - Haha I said that to my husband too :p&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We&#039;re going to celebrate our Mexico wedding date.&amp;nbsp; We got legally married in Canada the week before but it didn&#039;t \"feel\" like our wedding and it wasn&#039;t what we envisioned as our real wedding&lt;\/p&gt;","Attachments":[],"Id":1884654,"PostDate":1422553425,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"281895\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/281895-breezie\/' title='Member profile'><span itemprop=\"name\">breezie<\/span><\/a> - Haha I said that to my husband too <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/tongue.png' class='bbc_emoticon' alt=':P' \/><\/p>\n<p>\u00a0<\/p>\n<p>We're going to celebrate our Mexico wedding date.\u00a0 We got legally married in Canada the week before but it didn't \"feel\" like our wedding and it wasn't what we envisioned as our real wedding<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Married December 19, 2014 at Beach Palace Resort in Cancun, Mexico<\/p>\n<p>\u00a0<\/p>\n<p>My Planning Thread - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/'>http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>My Wedding Review<\/p>\n<p>Part 1 - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881197'>http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881197<\/a><\/p>\n<p>Part 2 - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881590'>http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881590<\/a><\/p>\n<p>Part 3 - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881861'>http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881861<\/a><\/p>\n<p>\u00a0","Email":"lilyluu83@gmail.com","IpAddress":"174.119.162.30","GroupId":3,"GroupName":"Member","JoinDate":1395594948,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277296.jpg?_r=1421643766","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"tygrrlily","Id":277296,"Name":"tygrrlily","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.247.221.156","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78706,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"4ff75ff7a32ca13b7ec0af1362ac7ad0","RawContent":"&lt;p&gt;As of now my FI and I plan on getting legally married the Friday before we leave (we leave on a Tuesday), but celebrating our anniversary on Nov 20th (symbolic ceremony date).&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1884655,"PostDate":1422553715,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>As of now my FI and I plan on getting legally married the Friday before we leave (we leave on a Tuesday), but celebrating our anniversary on Nov 20th (symbolic ceremony date).\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jen.tipler@gmail.com","IpAddress":"99.247.221.156","GroupId":40,"GroupName":"Jr. Member","JoinDate":1404859344,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278914.jpg?_r=1427504777","PhotoWidth":200,"PhotoHeight":146,"PhotoType":"custom"},"FormattedName":"MissJen3","Id":278914,"Name":"MissJen3","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.9.77.196","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78706,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"0f506b668b0a9883a1a7096255a61811","RawContent":"[quote name=\"breezie\" post=\"1884651\" timestamp=\"1422566908\"]\nThink i can get away with two anniversaries?  :P  LOL[\/quote]Lol, my fianc\u00e9 wants to do this! Lol.","Attachments":[],"Id":1884827,"PostDate":1422752680,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>breezie, on 29 January 2015 - 05:28 PM, said:<\/p><div class='blockquote'><div class='quote'><p>Think i can get away with two anniversaries?  <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/tongue.png' class='bbc_emoticon' alt=':P' \/>  LOL<\/p><\/div><\/div>\nLol, my fianc\u00e9 wants to do this! Lol. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><strong>N&C<\/strong><\/p>\n<p><em>April 17, 2015<\/em><\/p>\n<p>Gran Caribe Real (Cancun, Mexico)<\/p>\n<p>Including Bride & Groom: 22 guests (19 adults & 3 children)","Email":"nancysoup@att.net","IpAddress":"216.23.195.134","GroupId":39,"GroupName":"Newbie","JoinDate":1411646662,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280004.jpg?_r=1412891058","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"hellosassypants","Id":280004,"Name":"hellosassypants","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.26.164.62","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78706,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a471fa3db12521743bf81b2d8c1e1327","RawContent":"@breezie- Men usually have trouble remembering one date, so having to remember two would be especially difficult.\n\n\nWe will celebrate the destination wedding date.","Attachments":[],"Id":1884830,"PostDate":1422765668,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @breezie- Men usually have trouble remembering one date, so having to remember two would be especially difficult.<br><br>\nWe will celebrate the destination wedding date.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lm_sprowl@hotmail.com","IpAddress":"75.26.164.62","GroupId":39,"GroupName":"Newbie","JoinDate":1418261031,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"cruisebride2016","Id":281378,"Name":"cruisebride2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.100.61.37","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78706,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"266a99a211fcfaa3dabf1ef2aebd6421","RawContent":"&lt;p&gt;So my hubby and I have two anniversaries too!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We did our civil\/legal ceremony in court here in California a week before our destination wedding in Mexico. And yes, we dressed up, but nothing too fancy -- just beautiful white attire and we went to have a delicious lunch afterwards&amp;nbsp; :D&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Then we had our official ceremony in Mexico in front of all our family and close friends -- and that&#039;s when we wore our full wedding attire complete with bridesmaids and groomsmen. We recognize that day as our official anniversary because it had all the bells and whistles. BUT we also try to acknowledge our legal date with a small and simple dinner each year -- if we remember, hahahaha. :lol:  &lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Two reasons to dress up and celebrate -- always a good idea&amp;nbsp; :D&lt;\/p&gt;","Attachments":[],"Id":1884831,"PostDate":1422766358,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>So my hubby and I have two anniversaries too!<\/p>\n<p>\u00a0<\/p>\n<p>We did our civil\/legal ceremony in court here in California a week before our destination wedding in Mexico. And yes, we dressed up, but nothing too fancy -- just beautiful white attire and we went to have a delicious lunch afterwards\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/biggrin.png' class='bbc_emoticon' alt=':D' \/><\/p>\n<p>\u00a0<\/p>\n<p>Then we had our official ceremony in Mexico in front of all our family and close friends -- and that's when we wore our full wedding attire complete with bridesmaids and groomsmen. We recognize that day as our official anniversary because it had all the bells and whistles. BUT we also try to acknowledge our legal date with a small and simple dinner each year -- if we remember, hahahaha. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/laugh.png' class='bbc_emoticon' alt=':lol:' \/>\u00a0\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Two reasons to dress up and celebrate -- always a good idea\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/biggrin.png' class='bbc_emoticon' alt=':D' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-size:18px;\"><span style=\"font-family:georgia;\"><strong>MARIESAM SANCHEZ PHOTOGRAPHY<\/strong><\/span><\/span><br>\nWEBSITE: <a  class=\"bbc_url\" href=\"http:\/\/www.mariesamsanchez.com\">www.mariesamsanchez.com<\/a><br>\nBLOG: <a  class=\"bbc_url\" href=\"http:\/\/www.mariesamsanchezblog.com\">www.mariesamsanchez.com<\/a><a data-ipb='nomediaparse' href='http:\/\/www.mariesamsanchez.com\/blog'>\/blog<\/a><br>\nCONTACT ME: <a  class=\"bbc_email\" href=\"mailto:mariesam.sanchez@gmail.com?subject=BDW%20Inquiry\" title=\"E-mail Link\">mariesam.sanchez@gmail.com<\/a><br><br><img src=\"http:\/\/i287.photobucket.com\/albums\/ll150\/msam007562\/063cb5c8-dbda-4822-87fe-ba3c0ebcdb7f.jpg\" alt=\"063cb5c8-dbda-4822-87fe-ba3c0ebcdb7f.jpg\">","Email":"mariesam.sanchez@gmail.com","IpAddress":"74.100.61.37","GroupId":38,"GroupName":"Moderators","JoinDate":1285939945,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232833.jpg?_r=1422091823","PhotoWidth":200,"PhotoHeight":220,"PhotoType":"custom"},"FormattedName":"MarieSamSanchezPhoto","Id":232833,"Name":"MarieSamSanchezPhoto","IsOnline":false}}],"Id":"78706","Title":"Which Do We Celebrate As Our Anniversary?!","LastPostDate":1423582681},"Pages":{"TotalItems":13,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
