le\/photo-283167.jpg?_r=1432133572","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"yycbride2016","Id":283167,"Name":"yycbride2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"209.183.255.180","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78724,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"c5ca178f80dd5418f68dddb117024c92","RawContent":"[quote name=\"yycbride2016\" post=\"1898363\" timestamp=\"1434032923\"]\n@[member=\"dobedare\"] Where did you originally get these?[\/quote]\nI made these.  Just bought Raffia and Starfish.","Attachments":[],"Id":1898371,"PostDate":1434020304,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>yycbride2016, on 11 June 2015 - 10:28 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"259268\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/259268-dobedare\/' title='Member profile'><span itemprop=\"name\">dobedare<\/span><\/a> Where did you originally get these?<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>I made these. \u00a0Just bought Raffia and Starfish. \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tripledobedare@yahoo.com","IpAddress":"96.231.156.71","GroupId":39,"GroupName":"Newbie","JoinDate":1345162376,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-259268.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"dobedare","Id":259268,"Name":"dobedare","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"142.56.86.35","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78724,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"18f659758d86b978c3582aea963d90bb","RawContent":"&lt;p&gt;@[member=\"dobedare\"] Amazing! well done. I&#039;m going to get my girls together and see If we can make them too!&lt;\/p&gt;","Attachments":[],"Id":1898372,"PostDate":1434020512,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"259268\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/259268-dobedare\/' title='Member profile'><span itemprop=\"name\">dobedare<\/span><\/a> Amazing! well done. I'm going to get my girls together and see If we can make them too!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>~*~YYCBRIDE2016~*~<\/p><p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79227-yycbride2016-grand-sirenis-planning-thread-february-2016\/'>My planning thread\u00a0<\/a><\/p><p>\u00a0<\/p><p><a class='bbc_url' href='http:\/\/www.TickerFactory.com\/'><br><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10730;484\/st\/20160223\/e\/Our+Wedding\/dt\/-1\/k\/4bd8\/event.png\" alt=\"event.png\"><br><\/a><br>\u00a0","Email":"janellepaquin@hotmail.com","IpAddress":"162.157.216.37","GroupId":40,"GroupName":"Jr. Member","JoinDate":1432086904,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283167.jpg?_r=1432133572","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"yycbride2016","Id":283167,"Name":"yycbride2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"209.183.255.180","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78724,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a45d54d1cf795c8a8babaed063a71024","RawContent":"[quote name=\"yycbride2016\" post=\"1898372\" timestamp=\"1434034912\"]\n@[member=\"dobedare\"] Amazing! well done. I&#039;m going to get my girls together and see If we can make them too![\/quote]\nThanks.  You can buy them off of Etsy as well, but they were priced around $15 each.  Much cheaper to make yourself and they were pretty easy to do.  \n\nThe Starfish I used were about 8 to 9 inches across.  And you can add a ribbon with your wedding colors as well.   Best part is they were light weight and traveled well.  \n\nGood luck!","Attachments":[],"Id":1898374,"PostDate":1434021624,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>yycbride2016, on 11 June 2015 - 11:01 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"259268\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/259268-dobedare\/' title='Member profile'><span itemprop=\"name\">dobedare<\/span><\/a> Amazing! well done. I'm going to get my girls together and see If we can make them too!<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>Thanks. \u00a0You can buy them off of Etsy as well, but they were priced around $15 each. \u00a0Much cheaper to make yourself and they were pretty easy to do. \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>The Starfish I used were about 8 to 9 inches across. \u00a0And you can add a ribbon with your wedding colors as well. \u00a0 Best part is they were light weight and traveled well. \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Good luck!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tripledobedare@yahoo.com","IpAddress":"96.231.156.71","GroupId":39,"GroupName":"Newbie","JoinDate":1345162376,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-259268.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"dobedare","Id":259268,"Name":"dobedare","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"142.56.86.35","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78724,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"508ae2ecc367f8bcf826f6cd50cbec82","RawContent":"&lt;p&gt;@[member=\"dobedare\"] Yeah I saw them on Etsy and thats what made me want them but I didn&#039;t like the price so much. My MOH is a crafty person and says we could make them really easily. I already ordered a bunch of starfish&amp;nbsp;as decorations for my wedding, so I&#039;ll take a few of those to make these!&amp;nbsp;Thanks for the tips!&lt;\/p&gt;","Attachments":[],"Id":1898379,"PostDate":1434022662,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"259268\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/259268-dobedare\/' title='Member profile'><span itemprop=\"name\">dobedare<\/span><\/a> Yeah I saw them on Etsy and thats what made me want them but I didn't like the price so much. My MOH is a crafty person and says we could make them really easily. I already ordered a bunch of starfish\u00a0as decorations for my wedding, so I'll take a few of those to make these!\u00a0Thanks for the tips!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>~*~YYCBRIDE2016~*~<\/p><p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79227-yycbride2016-grand-sirenis-planning-thread-february-2016\/'>My planning thread\u00a0<\/a><\/p><p>\u00a0<\/p><p><a class='bbc_url' href='http:\/\/www.TickerFactory.com\/'><br><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10730;484\/st\/20160223\/e\/Our+Wedding\/dt\/-1\/k\/4bd8\/event.png\" alt=\"event.png\"><br><\/a><br>\u00a0","Email":"janellepaquin@hotmail.com","IpAddress":"162.157.216.37","GroupId":40,"GroupName":"Jr. Member","JoinDate":1432086904,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/