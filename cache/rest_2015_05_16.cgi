 usersig-click\"><div class=\"reparse-sig-lineheight\"><p><span>Beaches Turks & Caicos - October 21, 2011<\/span><\/p><span><\/span><\/div><\/div>","Email":"michelle0200@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1274525914,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-228450.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":299,"PhotoType":"custom"},"FormattedName":"Michelle-2","Id":228450,"Name":"Michelle-2","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":3901,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b070fe5d5edd8e7f5d5deb7256d3d625","RawContent":"Awesome thread!! Thanks!","Attachments":[],"Id":1203698,"PostDate":1278129482,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Awesome thread!! Thanks!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>The Royal Playa del Carmen 12.11.10 \/ 46 people + bride & groom attended!!!!!<\/span><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f103\/our-key-card-holders-60637\/\">Our keycard holders w\/ template & pics<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/www.jadicaandraveyn.com\">www.jadicaandraveyn.com<\/a><\/div><\/div>","Email":"msglave@sbcglobal.net","IpAddress":"162.229.216.240","GroupId":3,"GroupName":"Member","JoinDate":1254156471,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-222084.jpg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"msglave","Id":222084,"Name":"msglave","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":3901,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9c124799deb65140b33aa7c84f149c20","RawContent":"&lt;p&gt; Was look for a specific one and found it but I love the other ones as well! Thanks!&lt;\/p&gt;","Attachments":[],"Id":1257295,"PostDate":1282086819,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Was look for a specific one and found it but I love the other ones as well! Thanks!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"themagicspork@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1273466486,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-228052.jpg?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"bizzyangel","Id":228052,"Name":"bizzyangel","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":3901,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e189c97b57e1964b5f519560533936ad","RawContent":"[quote]\nOriginally Posted by [b]ultimateme143[\/b] \/img\/forum\/go_quote.gif\n \n I kept the invitation traditional, but made the RSVP qwirky. &#039;will join you as you make your big splash&#039;, &#039;will join you for the bahamian welcome dinner&#039; and &#039;must wave the invitation, i&#039;m all tide up&#039;[\/quote] \n \n \n This is a really really cute idea.  i like it a lot!!!","Attachments":[],"Id":1257926,"PostDate":1282132672,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <br \/> <br \/> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>ultimateme143<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" style=\"border-right: 0px solid; border-top: 0px solid; border-left: 0px solid; border-bottom: 0px solid\" \/><\/span><br \/> <br \/> I kept the invitation traditional, but made the RSVP qwirky. 'will join you as you make your big splash', 'will join you for the bahamian welcome dinner' and 'must wave the invitation, i'm all tide up'<\/blockquote> <p> <br \/> <br \/> This is a really really cute idea.\u00a0 i like it a lot!!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"gersbja@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1265997584,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-225554.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"gersbja","Id":225554,"Name":"gersbja","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":3901,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9861008de273cbc49dcb870e524e8148","RawContent":"&lt;p align=\"center\"&gt; Our invitations were \"&lt;strong&gt;message in a bottle&lt;\/strong&gt;\" We printed them out on parchment paper them burned the edges...&amp;nbsp; folded them up and put them in glass bottles that had white sand and a few seashells at the bottom.. I bought a tropical scent from a crafts store and put a few drops in the bottle itself and and few drops on the cork. We soaked the cork in water so they would swell and&amp;nbsp; pop of during transport via ups. We put them in small boxes that was lined with raffia. Everyone loved loved loved the invitation. Each person that opened it was SOO obssesed with them scent! They said it smelled amazing!&lt;\/p&gt; &lt;p align=\"center\"&gt; &lt;span style=\"font-family: lucida handwriting;\"&gt;&lt;span style=\"font-size: 12pt;\"&gt;Our Journey To Find True Love Ends...\n Our Journey To Cherish True Love Begins&lt;\/span&gt;&lt;\/span&gt;&lt;span style=\"font-family: lucida handwriting;\"&gt;&lt;span style=\"font-size: 14pt;\"&gt;.&lt;\/span&gt;&lt;\/span&gt;\n \n &lt;strong&gt;&lt;span style=\"font-family: lucida handwriting;\"&gt;&lt;span style=\"font-size: 14pt;\"&gt;Bride \u00e2\u20ac\u02dcs name\n and&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/p&gt; &lt;p align=\"center\"&gt; &lt;strong&gt;&lt;span style=\"font-family: lucida handwriting;\"&gt;&lt;span style=\"font-size: 14pt;\"&gt;Groom\u00e2\u20ac\u2122s name\n look forward to sharing with you\n the sun, the sea and the memories\n of their wedding ceremony\n Saturday, the eighth of May\n Two thousand and ten\n at two o&#039;clock in the afternoon at\n Moon Palace Golf &amp;amp; Spa Resort\n Cancun, Mexico&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/p&gt; &lt;p align=\"center\"&gt; &lt;span style=\"font-family: lucida handwriting;\"&gt;&lt;span style=\"font-size: 10pt;\"&gt;Please RSVP at paguiawelch.mypalaceresortswedding.com&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1261233,"PostDate":1282319265,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p align=\"center\"> Our invitations were \"<strong>message in a bottle<\/strong>\" We printed them out on parchment paper them burned the edges...\u00a0 folded them up and put them in glass bottles that had white sand and a few seashells at the bottom.. I bought a tropical scent from a crafts store and put a few drops in the bottle itself and and few drops on the cork. We soaked the cork in water so they would swell and\u00a0 pop of during transport via ups. We put them in small boxes that was lined with raffia. Everyone loved loved loved the invitation. Each person that opened it was SOO obssesed with them scent! They said it smelled amazing!<\/p> <p align=\"center\"> <span  style=\"font-family: lucida handwriting\"><span  style=\"font-size: 12pt\">Our Journey To Find True Love Ends...<br \/> Our Journey To Cherish True Love Begins<\/span><\/span><span  style=\"font-family: lucida handwriting\"><span  style=\"font-size: 14pt\">.<\/span><\/span><br \/> <br \/> <strong><span  style=\"font-family: lucida handwriting\"><span  style=\"font-size: 14pt\">Bride \u00e2\u20ac\u02dcs name<br \/> and<\/span><\/span><\/strong><\/p> <p align=\"center\"> <strong><span  style=\"font-family: lucida handwriting\"><span  style=\"font-size: 14pt\">Groom\u00e2\u20ac\u2122s name<br \/> look forward to sharing with you<br \/> the sun, the sea and the memories<br \/> of their wedding ceremony<br \/> Saturday, the eighth of May<br \/> Two thousand and ten<br \/> at two o'clock in the afternoon at<br \/> Moon Palace Golf & Spa Resort<br \/> Cancun, Mexico<\/span><\/span><\/strong><\/p> <p align=\"center\"> <span  style=\"font-family: lucida handwriting\"><span  style=\"font-size: 10pt\">Please RSVP at paguiawelch.mypalaceresortswedding.com<\/span><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"candyce.welch@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1250815773,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-220779.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"cwelch","Id":220779,"Name":"cwelch","IsOnline":false}}],"Pages":{"TotalItems":150,"TotalPages":15,"CurrentPage":50,"NextPage":60,"PreviousPage":40,"LastPage":140},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
