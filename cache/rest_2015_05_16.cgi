{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":45,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":5338,"MovedTo":null,"MovedOn":0,"FirstPostId":1560137,"Rating":0,"RatingHits":0,"Starter":{"Id":248623,"Name":"starcamping","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-248623.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"StartDate":1324975595,"LastPoster":{"Id":279496,"Name":"lealea","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":34,"Preview":{"Id":1560137,"PostDate":1324975595,"PostContent":"I am starting to put together a website and would love it if anyone would be willing to share th...","Author":{"Signature":"","Email":"brooke.r.smith@gmail.com","IpAddress":"","GroupId":47,"GroupName":"Site Supporter","JoinDate":1323807820,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-248623.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"starcamping","Id":248623,"Name":"starcamping","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":64964,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"09f078d485b97ba021c8ee6f9006bbcf","RawContent":"&lt;p&gt; I am starting to put together a website and would love it if anyone would be willing to share theirs for ideas! &amp;nbsp;I saw one that I loved, but can&#039;t seem to find it again. &amp;nbsp;I am unsure of what wording and information to include.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp; Thanks!!&lt;\/p&gt; &lt;p&gt; &amp;nbsp; &amp;nbsp; -Brooke&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1560137,"PostDate":1324975595,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I am starting to put together a website and would love it if anyone would be willing to share theirs for ideas! \u00a0I saw one that I loved, but can't seem to find it again. \u00a0I am unsure of what wording and information to include.<\/p> <p> \u00a0<\/p> <p> \u00a0 Thanks!!<\/p> <p> \u00a0 \u00a0 -Brooke\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"brooke.r.smith@gmail.com","IpAddress":"","GroupId":47,"GroupName":"Site Supporter","JoinDate":1323807820,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-248623.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"starcamping","Id":248623,"Name":"starcamping","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":64964,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"5757609a89ae91ff60a8565f2e8bd1da","RawContent":"&lt;p&gt; My friend mad her website here:&amp;nbsp;&lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/besideyouforever.com\/nateandamy\/\"&gt;http:\/\/besideyouforever.com\/nateandamy\/&lt;\/a&gt;. I thought her&#039;s looked really good. Did you find any other sites that make good looking wedding websites?&lt;\/p&gt;","Attachments":[],"Id":1560660,"PostDate":1325076307,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> My friend mad her website here:\u00a0<a href='http:\/\/besideyouforever.com\/nateandamy\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/besideyoufore...com\/nateandamy\/<\/a>. I thought her's looked really good. Did you find any other sites that make good looking wedding websites?<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mattwsutherland@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1325076175,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-249000.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":112,"PhotoType":"custom"},"FormattedName":"mattsuth","Id":249000,"Name":"mattsuth","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":64964,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a75cd63d2f423eb50d490322c90ed363","RawContent":"&lt;p&gt; &lt;span style=\"font-size: 12pt\"&gt;&lt;span style=\"color: #1f497d\"&gt;&lt;span style=\"font-family: calibri\"&gt;Hi Brooke, &lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12pt\"&gt;&lt;span style=\"color: #1f497d\"&gt;&lt;span style=\"font-family: calibri\"&gt;Wedding websites are such a great way to share information with your guests! &lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;span style=\"font-size: 12pt\"&gt;&lt;span style=\"color: #1f497d\"&gt;&lt;span style=\"font-family: calibri\"&gt;Share your engagement story and photos then add on more information as you further your&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;span style=\"font-size: 12pt\"&gt;&lt;span style=\"color: #1f497d\"&gt;&lt;span style=\"font-family: calibri\"&gt; wedding plans! Add as much or as little as you like. Include write ups of how you met and how&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;span style=\"font-size: 12pt\"&gt;&lt;span style=\"color: #1f497d\"&gt;&lt;span style=\"font-family: calibri\"&gt; he proposed. Add photos and fun stories of you both and what&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;span style=\"font-size: 12pt\"&gt;&lt;span style=\"color: #1f497d\"&gt;&lt;span style=\"font-family: calibri\"&gt; activities you enjoy doing together ie) hiking, snow boarding.&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;span style=\"font-size: 12pt\"&gt;&lt;span style=\"color: #1f497d\"&gt;&lt;span style=\"font-family: calibri\"&gt; Your wedding website will be a great start getting your guests excited about your Destination&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;span style=\"font-size: 12pt\"&gt;&lt;span style=\"color: #1f497d\"&gt;&lt;span style=\"font-family: calibri\"&gt; Wedding.&amp;nbsp;Include the details of your chosen destination and the property, as well as the fun tours&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;span style=\"font-size: 12pt\"&gt;&lt;span style=\"color: #1f497d\"&gt;&lt;span style=\"font-family: calibri\"&gt; and excursions they can choose from or read further on the details of one you would like to&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;span style=\"font-size: 12pt\"&gt;&lt;span style=\"color: #1f497d\"&gt;&lt;span style=\"font-family: calibri\"&gt; arrange for your group. Post photos of your resort and some of the key features that will&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;span style=\"font-size: 12pt\"&gt;&lt;span style=\"color: #1f497d\"&gt;&lt;span style=\"font-family: calibri\"&gt; excite your guests and make them look forward to this momentous trip as much as you do.&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;span style=\"font-size: 12pt\"&gt;&lt;span style=\"color: #1f497d\"&gt;&lt;span style=\"font-family: calibri\"&gt; Post an itinerary for the week including any welcome or rehearsal dinners as well as your&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;span style=\"font-size: 12pt\"&gt;&lt;span style=\"color: #1f497d\"&gt;&lt;span style=\"font-family: calibri\"&gt; wedding day schedule as to where guests need to be and what time, even what they should&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;span style=\"font-size: 12pt\"&gt;&lt;span style=\"color: #1f497d\"&gt;&lt;span style=\"font-family: calibri\"&gt; wear (beach casual, barefoot, or formal). Of course include their travel information and&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;span style=\"font-size: 12pt\"&gt;&lt;span style=\"color: #1f497d\"&gt;&lt;span style=\"font-family: calibri\"&gt; pricing. And the best part, if you have a destination wedding designer, add their contact information so they can assist all of your guests with their travel arrangements and questions!&amp;nbsp; Sarah Blue Petal &lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1561256,"PostDate":1325178564,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <span  style=\"font-size: 12pt\"><span  style=\"color: #1f497d\"><span  style=\"font-family: calibri\">Hi Brooke, <\/span><\/span><\/span><\/p> <p> <span  style=\"font-size: 12pt\"><span  style=\"color: #1f497d\"><span  style=\"font-family: calibri\">Wedding websites are such a great way to share information with your guests! <\/span><\/span><\/span><span  style=\"font-size: 12pt\"><span  style=\"color: #1f497d\"><span  style=\"font-family: calibri\">Share your engagement story and photos then add on more information as you further your<\/span><\/span><\/span><span  style=\"font-size: 12pt\"><span  style=\"color: #1f497d\"><span  style=\"font-family: calibri\"> wedding plans! Add as much or as little as you like. Include write ups of how you met and how<\/span><\/span><\/span><span  style=\"font-size: 12pt\"><span  style=\"color: #1f497d\"><span  style=\"font-family: calibri\"> he proposed. Add photos and fun stories of you both and what<\/span><\/span><\/span><span  style=\"font-size: 12pt\"><span  style=\"color: #1f497d\"><span  style=\"font-family: calibri\"> activities you enjoy doing together ie) hiking, snow boarding.<\/span><\/span><\/span><span  style=\"font-size: 12pt\"><span  style=\"color: #1f497d\"><span  style=\"font-family: calibri\"> Your wedding website will be a great start getting your guests excited about your Destination<\/span><\/span><\/span><span  style=\"font-size: 12pt\"><span  style=\"color: #1f497d\"><span  style=\"font-family: calibri\"> Wedding.\u00a0Include the details of your chosen destination and the property, as well as the fun tours<\/span><\/span><\/span><span  style=\"font-size: 12pt\"><span  style=\"color: #1f497d\"><span  style=\"font-family: calibri\"> and excursions they can choose from or read further on the details of one you would like to<\/span><\/span><\/span><span  style=\"font-size: 12pt\"><span  style=\"color: #1f497d\"><span  style=\"font-family: calibri\"> arrange for your group. Post photos of your resort and some of the key features that will<\/span><\/span><\/span><span  style=\"font-size: 12pt\"><span  style=\"color: #1f497d\"><span  style=\"font-family: calibri\"> excite your guests and make them look forward to this momentous trip as much as you do.<\/span><\/span><\/span><span  style=\"font-size: 12pt\"><span  style=\"color: #1f497d\"><span  style=\"font-family: calibri\"> Post an itinerary for the week including any welcome or rehearsal dinners as well as your<\/span><\/span><\/span><span  style=\"font-size: 12pt\"><span  style=\"color: #1f497d\"><span  style=\"font-family: calibri\"> wedding day schedule as to where guests need to be and what time, even what they should<\/span><\/span><\/span><span  style=\"font-size: 12pt\"><span  style=\"color: #1f497d\"><span  style=\"font-family: calibri\"> wear (beach casual, barefoot, or formal). Of course include their travel information and<\/span><\/span><\/span><span  style=\"font-size: 12pt\"><span  style=\"color: #1f497d\"><span  style=\"font-family: calibri\"> pricing. And the best part, if you have a destination wedding designer, add their contact information so they can assist all of your guests with their travel arrangements and questions!\u00a0 Sarah Blue Petal <\/span><\/span><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"info@bluepetalweddings.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1318414975,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-246605.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"BluePetalWed","Id":246605,"Name":"BluePetalWed","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":64964,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"96366eef70e64c6919e40ff6bfdfb0bc","RawContent":"&lt;p&gt; I am making mine in Weebly. It&#039;s super easy and it&#039;s free. This way I make sure it&#039;s the way I want it and it&#039;s not super cheesy.\n What would you title the website?&lt;\/p&gt;","Attachments":[],"Id":1561703,"PostDate":1325284171,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I am making mine in Weebly. It's super easy and it's free. This way I make sure it's the way I want it and it's not super cheesy.<br \/> What would you title the website?<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"maria_euv@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1325251751,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-249091.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"CafeDelMar21","Id":249091,"Name":"CafeDelMar21","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":64964,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ce063b2dc4e4d9c88e4aa82753d6ff9a","RawContent":"&lt;p&gt; I&#039;m using mywedding.com. It has an easy template that you can set up and it gives you the option to blog and add on as many pages and pictures as you&#039;d like. I&#039;m not super tech-savvy so it was great for me to find something that I didn&#039;t have to do too much with. And it&#039;s absolutely FREE!!! &lt;span alt=\":woot:\" rel=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/woot.gif\"&gt;&lt;img height=\"27\" id=\"yui_3_4_1_7_1325313337958_283\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/woot.gif\" width=\"42\" \/&gt;&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1561715,"PostDate":1325291991,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I'm using mywedding.com. It has an easy template that you can set up and it gives you the option to blog and add on as many pages and pictures as you'd like. I'm not super tech-savvy so it was great for me to find something that I didn't have to do too much with. And it's absolutely FREE!!! <span alt=\":woot:\" rel=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/woot.gif\"><span rel='lightbox'><img class='bbc_img' height=\"27\" id=\"yui_3_4_1_7_1325313337958_283\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/woot.gif\" width=\"42\" \/><\/span><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"teamboyd2012@gmail.com","IpAddress":"","GroupId":47,"GroupName":"Site Supporter","JoinDate":1322863996,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-248282.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"teamboyd2012","Id":248282,"Name":"teamboyd2012","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":64964,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e02f056a4757c465717a9b8e429d0fb8","RawContent":"&lt;p&gt; Here is my website so far.. I am still working on it since I started two nights ago and haven&#039;t had much time. We got engaged two weeks ago so we don&#039;t have pro pictures yet. Anyways, let me know if it helps:&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; JHandMUwedding.weebly.com&lt;\/p&gt;","Attachments":[],"Id":1561915,"PostDate":1325403556,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Here is my website so far.. I am still working on it since I started two nights ago and haven't had much time. We got engaged two weeks ago so we don't have pro pictures yet. Anyways, let me know if it helps:<\/p> <p> \u00a0<\/p> <p> JHandMUwedding.weebly.com<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"maria_euv@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1325251751,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-249091.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"CafeDelMar21","Id":249091,"Name":"CafeDelMar21","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":64964,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c8574fcc527be623ec6b6fce57bdccec","RawContent":"&lt;p&gt; wedding websites are a great idea! my advice is find a site you like that is free for you, because its only temporary. And then just add as must or as little as you want to share with everyone. I did my wedding website with www.weddingwire.com and they give page suggestions that you can add to your website to give you ideas of what you should write about! mine is still a work in progress because we are constantly updating it, but take a look if you want&amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.weddingwire.com\/staceyandstephen\"&gt;http:\/\/www.weddingwire.com\/staceyandstephen&lt;\/a&gt;&lt;\/p&gt;","Attachments":[],"Id":1562015,"PostDate":1325431997,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> wedding websites are a great idea! my advice is find a site you like that is free for you, because its only temporary. And then just add as must or as little as you want to share with everyone. I did my wedding website with www.weddingwire.com and they give page suggestions that you can add to your website to give you ideas of what you should write about! mine is still a work in progress because we are constantly updating it, but take a look if you want\u00a0<\/p> <p> \u00a0<\/p> <p> <a href='http:\/\/www.weddingwire.com\/staceyandstephen' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.weddingwi...taceyandstephen<\/a><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"stace_price@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1307743140,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-241007.JPG?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"SS2012","Id":241007,"Name":"SS2012","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":64964,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"434c954b941090261057965b4dc217a3","RawContent":"&lt;p&gt; You are welcome to check out mine... We used wedsimple.com - I don&#039;t know how my fiance got our names as the actual website but I love that people don&#039;t have to remember anything too long or confusing!!! Good Luck!!!&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; www.pattiandkevin.com&lt;\/p&gt;","Attachments":[],"Id":1563272,"PostDate":1325627436,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> You are welcome to check out mine... We used wedsimple.com - I don't know how my fiance got our names as the actual website but I love that people don't have to remember anything too long or confusing!!! Good Luck!!!<\/p> <p> \u00a0<\/p> <p> www.pattiandkevin.com<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"pattiandkevin@gmail.com","IpAddress":"","GroupId":47,"GroupName":"Site Supporter","JoinDate":1305361183,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-239988.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"pinkinboca","Id":239988,"Name":"pinkinboca","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":64964,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6424f4d05fb5b2c033d9163d11d0ea02","RawContent":"&lt;p&gt; I am going mine too.. goo luck to all the brides here ~~~xx&lt;\/p&gt;","Attachments":[],"Id":1566186,"PostDate":1326160933,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I am going mine too.. goo luck to all the brides here ~~~xx<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"leungbobe@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1325064192,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-248991.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"leungbobe","Id":248991,"Name":"leungbobe","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEm