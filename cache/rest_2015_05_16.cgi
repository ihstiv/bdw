{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":3901,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"22e298120f65c0b181d0f15684de8a28","RawContent":"Thanks for posting all these. They are going to come in super handy.","Attachments":[],"Id":783523,"PostDate":1249060482,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks for posting all these. They are going to come in super handy.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"abillingsley28@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1246807740,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-219105.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Arcticpinkprincess","Id":219105,"Name":"Arcticpinkprincess","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":3901,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a89921b469d2e25fcd656f196eef7bae","RawContent":"WOW! What a great post!","Attachments":[],"Id":887386,"PostDate":1255658111,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                WOW! What a great post!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"reallysupercool@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1251155101,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-220905.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Scotch2120","Id":220905,"Name":"Scotch2120","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":3901,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"59ea008f19fb51d78750eb66b18a527a","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;CourtneyV&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;I couldn&#039;t find a thread like this when I was looking last week, so I thought I&#039;d get one started... feel free to add your unique wedding invitation wording as well!! &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif\" border=\"0\" alt=\"\" title=\"Cheesy\" class=\"inlineimg\" \/&gt;\n \n &lt;strong&gt;Beach Wedding Invitation Wording #1&lt;\/strong&gt;\n Ocean waves will do the clapping,\n as our vows we will say.\n The sky will be our canopy,\n on this our wedding day.\n \n Please join us\n as we exchange vows on\n DATE\n TIME\n LOCATION\n CITY, STATE\n \n BRIDE\n and\n GROOM\n \n \n &lt;strong&gt;Beach Wedding Invitation Wording #2&lt;\/strong&gt;\n As unique as a seashell\n as deep as the sea\n As eternal as the waves\n our love is meant to be\n \n It is with joy that we,\n BRIDE\n and\n GROOM\n invite you to share\n in our happiness\n on DATE\n YEAR\n at TIME\n LOCATION\n ADDRESS\n CITY, STATE\n \n \n &lt;strong&gt;Beach Wedding Invitation Wording #3&lt;\/strong&gt;\n Sea of Love . . .\n As precious as the ocean&#039;s treasures,\n too strong for anyone to measure.\n Please join us as we\n BRIDE\n and\n GROOM\n are united in marriage\n at an outdoor ceremony\n on DAY\n YEAR\n at TIME\n LOCATION\n ADDRESS\n CITY, STATE\n \n \n \n &lt;strong&gt;Beach Wedding Invitation Wording #4&lt;\/strong&gt;\n You are my blue sky, my wind\n and my rain;\n to you I pledge my love undaunted.\n BRIDE\n and\n GROOM\n invite you to share in the joy\n when they exchange marriage vows\n on DAY\n YEAR\n at TIME\n LOCATION\n ADDRESS\n CITY, STATE\n \n \n &lt;strong&gt;Beach Wedding Invitation Wording #5&lt;\/strong&gt;\n Love washes in like the tide\n soothing the parched sand . . .\n BRIDE\n and\n GROOM\n invite you to share in the happiness\n as they are united in marriage\n on DAY\n YEAR\n at TIME\n LOCATION\n ADDRESS\n CITY, STATE\n \n \n &lt;strong&gt;Beach Wedding Invitation Wording #6&lt;\/strong&gt;\n A perfect shell is a gift from the sea\n as beautiful and unique\n as our love is meant to be\n Please join us as we\n BRIDE\n and\n GROOM\n join our lives in marriage\n on DAY\n YEAR\n at TIME\n LOCATION\n ADDRESS\n CITY, STATE\n \n \n &lt;strong&gt;Beach Wedding Invitation Wording #7&lt;\/strong&gt;\n \n \n A beautiful beach\n A clear blue sky\n A love united\n With waves crashing nearby\n \n BRIDE\n and\n GROOM\n on DAY\n YEAR\n at TIME\n LOCATION\n ADDRESS\n CITY, STATE\n \n \n &lt;strong&gt;Beach Wedding Invitation Wording #8&lt;\/strong&gt;\n \n Each hour, each day, each year\n We grow as two, yet as one,\n We grow apart, yet together\n Forming an eternal love\n We, BRIDE\n and GROOM\n together with our parents\n invite you to share in\n our beach wedding\n on DAY\n YEAR\n at TIME\n LOCATION\n ADDRESS\n CITY, STATE \n \n \n \n &lt;strong&gt;Beach Wedding Invitation Wording #9&lt;\/strong&gt;\n \n Love fluttered into our hearts\n \n BRIDE\n and\n GROOM\n \n request the honour of your presence\n at their marriage under the sun\n on DAY\n YEAR\n at TIME\n LOCATION\n ADDRESS\n CITY, STATE \n \n \n &lt;strong&gt;Beach Wedding Invitation Wording #10&lt;\/strong&gt;\n \n His love is the beach sunshine\n that keeps me warm\n To me, she\u00e2\u20ac\u2122s the lighthouse\n during the storm\n His love gave me wings\n it has set me free\n And wherever she is\n that\u00e2\u20ac\u2122s where I want to be\n We invite you to be with us\n as we begin our new life together\n on DAY\n YEAR\n at TIME\n LOCATION\n ADDRESS\n CITY, STATE\n \n BRIDE and GROOM\n \n \n &lt;strong&gt;Beach Wedding Invitation Wording #11&lt;\/strong&gt;\n \n Our wedding will be a fairy tale . . .\n a dream without end.\n \n A beach with a beautiful sun . . .\n Please join us on the sand.\n BRIDE\n and\n GROOM\n invite you to share in the joy\n when they exchange marriage vows\n and begin their new life together\n on DAY\n YEAR\n at TIME\n LOCATION\n ADDRESS\n CITY, STATE\n \n \n \n Also, I found this short article while searching...\n \n &lt;strong&gt;Beach Weddings - 5 Musts for Beach Invitation Wording&lt;\/strong&gt;\n by Renae Judkins \n \n Destination weddings to Hawaii, the Bahamas, the Virgin Islands, Maui, Jamaica and more are becoming more and more popular as destination wedding planning online has become easier and easier. The beach is the most popular destination wedding theme these days and many brides want to start their wedding theme off right with a beautiful beach theme wedding invitation. \n \n Many beach wedding invitation sites like BeachWedlockInvitations.com exist to offer hundreds of beach wedding invitations, but beach brides aren\u00e2\u20ac\u2122t worried about finding the right beach invitation as much as they are worried about their beach wedding invitation wording. \n \n Every bride wants her wedding to be unique and her wedding invitation is no different. Finding the perfect beach wedding invitation wording is as important as finding the perfect beach wedding invitation itself, so here are 5 beach wedding invitation wording tips. \n \n 1. Know yourself and your spouse to be - Your beach invitation wording should reflect you and your future spouses personalities, love and quirkiness \u00e2\u20ac\u00a6 yes, quirkiness. Wedding invitations have been done for millions of years, if you want to be original, you are going to have to capture what makes you and your beach love different than other couples. \n \n 2. There is no wrong wording - Certain wedding invitation wording ethics exist, but most people don\u00e2\u20ac\u2122t know them and wouldn\u00e2\u20ac\u2122t notice if you went according to the rules or not. Besides, more and more brides and grooms are throwing the rules to the wind these days and just writing what they want. Don\u00e2\u20ac\u2122t worry about trying to follow all the rules. The reason you\u00e2\u20ac\u2122re probably having a beach wedding is because you didn\u00e2\u20ac\u2122t want the traditional wedding ceremony anyway, so have your beach wedding invitation reflect the same free flowing spirit that the beach has. \n \n 3. Know your audience - Even though we just mentioned that your beach wedding invitation wording should be about you and your future beach spouse by placing your quirkiness in your beach invitation wording, remember who your audience is. If you are sending this invitation to an 80-year-old grandma, you probably don\u00e2\u20ac\u2122t want to use profanity or other inappropriate language. \n \n 4. Beach phrases - Find a single beach phrase that fits you and your spouse but also suits the beach setting you will be married in. \u00e2\u20ac\u0153Once upon a time on a beach \u00e2\u20ac\u00a6\u00e2\u20ac\u009d or \u00e2\u20ac\u0153What happens on the beach \u00e2\u20ac\u00a6 stays in our hearts,\u00e2\u20ac\u009d are just some examples. More examples can be found at BeachWedlockInvitations.com. \n \n 5. Match your wording to your invitation - Simple beach weddings with simple beach themes should have simple beach wedding invitation themes as well. A beach wedding with 10 - 50 people is an intimate setting and the invitations should reflect that. Don\u00e2\u20ac\u2122t bi og down the wording with a 20 line poem to begin the invitation. A beach wedding with over 500 people can be reason for the 20 line poem.&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;\n \n thannk you for posting these!!! i like the 2nd to last one--ive seen another bride on here use that one!! :)","Attachments":[],"Id":889098,"PostDate":1255765565,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>CourtneyV<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">I couldn't find a thread like this when I was looking last week, so I thought I'd get one started... feel free to add your unique wedding invitation wording as well!! <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif\" border=\"0\" alt=\"\" title=\"Cheesy\" class=\"inlineimg\" \/><\/span><br \/> <br \/> <strong>Beach Wedding Invitation Wording #1<\/strong><br \/> Ocean waves will do the clapping,<br \/> as our vows we will say.<br \/> The sky will be our canopy,<br \/> on this our wedding day.<br \/> <br \/> Please join us<br \/> as we exchange vows on<br \/> DATE<br \/> TIME<br \/> LOCATION<br \/> CITY, STATE<br \/> <br \/> BRIDE<br \/> and<br \/> GROOM<br \/> <br \/> <br \/> <strong>Beach Wedding Invitation Wording #2<\/strong><br \/> As unique as a seashell<br \/> as deep as the sea<br \/> As eternal as the waves<br \/> our love is meant to be<br \/> <br \/> It is with joy that we,<br \/> BRIDE<br \/> and<br \/> GROOM<br \/> invite you to share<br \/> in our happiness<br \/> on DATE<br \/> YEAR<br \/> at TIME<br \/> LOCATION<br \/> ADDRESS<br \/> CITY, STATE<br \/> <br \/> <br \/> <strong>Beach Wedding Invitation Wording #3<\/strong><br \/> Sea of Love . . .<br \/> As precious as the ocean's treasures,<br \/> too strong for anyone to measure.<br \/> Please join us as we<br \/> BRIDE<br \/> and<br \/> GROOM<br \/> are united in marriage<br \/> at an outdoor ceremony<br \/> on DAY<br \/> YEAR<br \/> at TIME<br \/> LOCATION<br \/> ADDRESS<br \/> CITY, STATE<br \/> <br \/> <br \/> <br \/> <strong>Beach Wedding Invitation Wording #4<\/strong><br \/> You are my blue sky, my wind<br \/> and my rain;<br \/> to you I pledge my love undaunted.<br \/> BRIDE<br \/> and<br \/> GROOM<br \/> invite you to share in the joy<br \/> when they exchange marriage vows<br \/> on DAY<br \/> YEAR<br \/> at TIME<br \/> LOCATION<br \/> ADDRESS<br \/> CITY, STATE<br \/> <br \/> <br \/> <strong>Beach Wedding Invitation Wording #5<\/strong><br \/> Love washes in like the tide<br \/> soothing the parched sand . . .<br \/> BRIDE<br \/> and<br \/> GROOM<br \/> invite you to share in the happiness<br \/> as they are united in marriage<br \/> on DAY<br \/> YEAR<br \/> at TIME<br \/> LOCATION<br \/> ADDRESS<br \/> CITY, STATE<br \/> <br \/> <br \/> <strong>Beach Wedding Invitation Wording #6<\/strong><br \/> A perfect shell is a gift from the sea<br \/> as beautiful and unique<br \/> as our love is meant to be<br \/> Please join us as we<br \/> BRIDE<br \/> and<br \/> GROOM<br \/> join our lives in marriage<br \/> on DAY<br \/> YEAR<br \/> at TIME<br \/> LOCATION<br \/> ADDRESS<br \/> CITY, STATE<br \/> <br \/> <br \/> <strong>Beach Wedding Invitation Wording #7<\/strong><br \/> <br \/> <br \/> A beautiful beach<br \/> A clear blue sky<br \/> A love united<br \/> With waves crashing nearby<br \/> <br \/> BRIDE<br \/> and<br \/> GROOM<br \/> on DAY<br \/> YEAR<br \/> at TIME<br \/> LOCATION<br \/> ADDRESS<br \/> CITY, STATE<br \/> <br \/> <br \/> <strong>Beach Wedding Invitation Wording #8<\/strong><br \/> <br \/> Each hour, each day, each year<br \/> We grow as two, yet as one,<br \/> We grow apart, yet together<br \/> Forming an eternal love<br \/> We, BRIDE<br \/> and GROOM<br \/> together with our parents<br \/> invite you to share in<br \/> our beach wedding<br \/> on DAY<br \/> YEAR<br \/> at TIME<br \/> LOCATION<br \/> ADDRESS<br \/> CITY, STATE <br \/> <br \/> <br \/> <br \/> <strong>Beach Wedding Invitation Wording #9<\/strong><br \/> <br \/> Love fluttered into our hearts<br \/> <br \/> BRIDE<br \/> and<br \/> GROOM<br \/> <br \/> request the honour of your presence<br \/> at their marriage under the sun<br \/> on DAY<br \/> YEAR<br \/> at TIME<br \/> LOCATION<br \/> ADDRESS<br \/> CITY, STATE <br \/> <br \/> <br \/> <strong>Beach Wedding Invitation Wording #10<\/strong><br \/> <br \/> His love is the beach sunshine<br \/> that keeps me warm<br \/> To me, she\u00e2\u20ac\u2122s the lighthouse<br \/> during the storm<br \/> His love gave me wings<br \/> it has set me free<br \/> And wherever she is<br \/> that\u00e2\u20ac\u2122s where I want to be<br \/> We invite you to be with us<br \/> as we begin our new life together<br \/> on DAY<br \/> YEAR<br \/> at TIME<br \/> LOCATION<br \/> ADDRESS<br \/> CITY, STATE<br \/> <br \/> BRIDE and GROOM<br \/> <br \/> <br \/> <strong>Beach Wedding Invitation Wording #11<\/strong><br \/> <br \/> Our wedding will be a fairy tale . . .<br \/> a dream without end.<br \/> <br \/> A beach with a beautiful sun . . .<br \/> Please join us on the sand.<br \/> BRIDE<br \/> and<br \/> GROOM<br \/> invite you to share in the joy<br \/> when they exchange marriage vows<br \/> and begin their new life together<br \/> on DAY<br \/> YEAR<br \/> at TIME<br \/> LOCATION<br \/> ADDRESS<br \/> CITY, STATE<br \/> <br \/> <br \/> <br \/> Also, I found this short article while searching...<br \/> <br \/> <strong>Beach Weddings - 5 Musts for Beach Invitation Wording<\/strong><br \/> by Renae Judkins <br \/> <br \/> Destination weddings to Hawaii, the Bahamas, the Virgin Islands, Maui, Jamaica and more are becoming more and more popular as destination wedding planning online has become easier and easier. The beach is the most popular destination wedding theme these days and many brides want to start their wedding theme off right with a beautiful beach theme wedding invitation. <br \/> <br \/> Many beach wedding invitation sites like BeachWedlockInvitations.com exist to offer hundreds of beach wedding invitations, but beach brides aren\u00e2\u20ac\u2122t worried about finding the right beach invitation as much as they are worried about their beach wedding invitation wording. <br \/> <br \/> Every bride wants her wedding to be unique and her wedding invitation is no different. Finding the perfect beach wedding invitation wording is as important as finding the perfect beach wedding invitation itself, so here are 5 beach wedding invitation wording tips. <br \/> <br \/> 1. Know yourself and your spouse to be - Your beach invitation wording should reflect you and your future spouses personalities, love and quirkiness \u00e2\u20ac\u00a6 yes, quirkiness. Wedding invitations have been done for millions of years, if you want to be original, you are going to have to capture what makes you and your beach love different than other couples. <br \/> <br \/> 2. There is no wrong wording - Certain wedding invitation wording ethics exist, but most people don\u00e2\u20ac\u2122t know them and wouldn\u00e2\u20ac\u2122t notice if you went according to the rules or not. Besides, more and more brides and grooms are throwing the rules to the wind these days and just writing what they want. Don\u00e2\u20ac\u2122t worry about trying to follow all the rules. The reason you\u00e2\u20ac\u2122re probably having a beach wedding is because you didn\u00e2\u20ac\u2122t want the traditional wedding ceremony anyway, so have your beach wedding invitation reflect the same free flowing spirit that the beach has. <br \/> <br \/> 3. Know your audience - Even though we just mentioned that your beach wedding invitation wording should be about you and your future beach spouse by placing your quirkiness in your beach invitation wording, remember who your audience is. If you are sending this invitation to an 80-year-old grandma, you probably don\u00e2\u20ac\u2122t want to use profanity or other inappropriate language. <br \/> <br \/> 4. Beach phrases - Find a single beach phrase that fits you and your spouse but also suits the beach setting you will be married in. \u00e2\u20ac\u0153Once upon a time on a beach \u00e2\u20ac\u00a6\u00e2\u20ac\u009d or \u00e2\u20ac\u0153What happens on the beach \u00e2\u20ac\u00a6 stays in our hearts,\u00e2\u20ac\u009d are just some examples. More examples can be found at BeachWedlockInvitations.com. <br \/> <br \/> 5. Match your wording to your invitation - Simple beach weddings with simple beach themes should have simple beach wedding invitation themes as well. A beach wedding with 10 - 50 people is an intimate setting and the invitations should reflect that. Don\u00e2\u20ac\u2122t bi og down the wording with a 20 line poem to begin the invitation. A beach wedding with over 500 people can be reason for the 20 line poem.<\/div> <\/td> <\/tr> <\/table> <\/div><br \/> <br \/> thannk you for posting these!!! i like the 2nd to last one--ive seen another bride on here use that one!! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"wsarah2107@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1239665199,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-216700.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"wsarah2107","Id":216700,"Name":"wsarah2107","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":3901,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"29185582823a0cf54512041410486ef7","RawContent":"Found a few more in a wedding invite catalog that came in the mail yesterday:\n \n We&#039;re getting ready to depart\n on a romantic trip which is only the start\n BRIDE\n and\n GROOM\n will be married on\n DATE\n LOCATION\n Please join us for a reception \n when we return\n DATE, TIME\n LOCATION\n ADDRESS\n \n Friends forever we will be\n whether walking on the beach \n or sailing on the sea...\n Please be our guest as we,\n BRIDE\n and \n GROOM\n join together\n DATE, TIME\n RESORT NAME\n LOCATION","Attachments":[],"Id":896377,"PostDate":1256303630,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Found a few more in a wedding invite catalog that came in the mail yesterday:<br \/> <br \/> We're getting ready to depart<br \/> on a romantic trip which is only the start<br \/> BRIDE<br \/> and<br \/> GROOM<br \/> will be married on<br \/> DATE<br \/> LOCATION<br \/> Please join us for a reception <br \/> when we return<br \/> DATE, TIME<br \/> LOCATION<br \/> ADDRESS<br \/> <br \/> Friends forever we will be<br \/> whether walking on the beach <br \/> or sailing on the sea...<br \/> Please be our guest as we,<br \/> BRIDE<br \/> and <br \/> GROOM<br \/> join together<br \/> DATE, TIME<br \/> RESORT NAME<br \/> LOCATION\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sfrench0621@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1245193217,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-218517.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"sfrench0621","Id":218517,"Name":"sfrench0621","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":3901,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9245cef6c5c1f0e379a29098a524c425","RawContent":"I think I&#039;m going with something simple and cute like:\n \n _______ &amp;amp; _________\n invite you to dig your toes in the sand \n and take in the view as we join in marriage \n and say I DO!","Attachments":[],"Id":896467,"PostDate":1256306620,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I think I'm going with something simple and cute like:<br \/> <br \/> _______ & _________<br \/> invite you to dig your toes in the sand <br \/> and take in the view as we join in marriage <br \/> and say I DO!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bmfinley@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1250863181,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-220799.gif?_r=0","PhotoWidth":100,"PhotoHeight":67,"PhotoType":"custom"},"FormattedName":"OCMDBride05152010","Id":220799,"Name":"OCMDBride05152010","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":3901,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e7380b9928682b712ea2f4b5f5f8c1f0","RawContent":"I like that! Really cute :)\n \n &lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;OCMDBride05152010&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;I think I&#039;m going with something simple and cute like:\n \n _______ &amp;amp; _________\n invite you to dig your toes in the sand \n and take in the view as we join in marriage \n and say I DO!&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;","Attachments":[],"Id":896520,"PostDate":1256308392,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I like that! Really cute <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br \/> <br \/> <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>OCMDBride05152010<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">I think I'm going with something simple and cute like:<br \/> <br \/> _______ & _________<br \/> invite you to dig your toes in the sand <br \/> and take in the view as we join in marriage <br \/> and say I DO!<\/div> <\/td> <\/tr> <\/table> <\/div>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sfrench0621@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1245193217,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-218517.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"sfrench0621","Id":218517,"Name":"sfrench0621","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":3901,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"32bc4b4c4fdc846f55479f5271c257df","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;OCMDBride05152010&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;I think I&#039;m going with something simple and cute like:\n \n _______ &amp;amp; _________\n invite you to dig your toes in the sand \n and take in the view as we join in marriage \n and say I DO!&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;I really like this!! I think I may have to &amp;quot;borrow&amp;quot; it :) \n Thanks for sharing!","Attachments":[],"Id":897833,"PostDate":1256473489,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>OCMDBride05152010<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">I think I'm going with something simple and cute like:<br \/> <br \/> _______ & _________<br \/> invite you to dig your toes in the sand <br \/> and take in the view as we join in marriage <br \/> and say I DO!<\/div> <\/td> <\/tr> <\/table> <\/div>I really like this!! I think I may have to \"borrow\" it <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> <br \/> Thanks for sharing!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><em>Heather & Eric ~ May 5th, 2011 ~ Beaches Turks & Caicos<\/em><\/div><\/div>","Email":"HOCKEYMOM97@GMAIL.COM","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1246648344,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-219069.gif?_r=0","PhotoWidth":100,"PhotoHeight":67,"PhotoType":"custom"},"FormattedName":"hockeymom97","Id":219069,"Name":"hockeymom97","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":3901,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d43e4316c43b1a9aa52e86eaefeccfc2","RawContent":"Love these. WE are exchanging our vows on a fresh water lagoon which goes into the sea... any ideas on creative phrasing for my invites?? please help~! It&#039;s the Yal-ku lagoon in Akumal.","Attachments":[],"Id":926534,"PostDate":1258301601,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Love these. WE are exchanging our vows on a fresh water lagoon which goes into the sea... any ideas on creative phrasing for my invites?? please help~! It's the Yal-ku lagoon in Akumal.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><strong>Akumal, Mexico 05.29.10<\/strong><\/div><\/div>","Email":"jasinandnicole@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1253380382,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-221799.jpg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"nicitica","Id":221799,"Name":"nicitica","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":3901,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"49242a9ccccad461ec209bf7dcfcfb47","RawContent":"Great help !","Attachments":[],"Id":936023,"PostDate":1258924494,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Great help !\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/index.php?referrerid=15768\">http:\/\/bestdestinationwedding.com\/fo...ferrerid=15768<\/a><\/div><\/div>","Email":"indy_chic@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1240005993,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-216808.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"indy_chic","Id":216808,"Name":"indy_chic","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":3901,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"38def37a36e4bdbd80d2df6c43f367db","RawContent":"Great advice on the wording, any recommendations for where to get destination invites themselves?","Attachments":[],"Id":943359,"PostDate":1259527119,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Great advice on the wording, any recommendations for where to get destination invites themselves?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"k_atrisha@hotmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1259423062,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223579.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Boo","Id":223579,"Name":"Boo","IsOnline":false}}],"Pages":{"TotalItems":150,"TotalPages":15,"CurrentPage":30,"NextPage":40,"PreviousPage":20,"LastPage":140},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
