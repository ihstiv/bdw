{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":5,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":444,"MovedTo":null,"MovedOn":0,"FirstPostId":1841775,"Rating":0,"RatingHits":0,"Starter":{"Id":276272,"Name":"CurlyKristen","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276272.jpg?_r=1423510309","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"IsOnline":false},"StartDate":1396307271,"LastPoster":{"Id":279867,"Name":"cfinkenbine","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279867.jpg?_r=1411696267","PhotoWidth":200,"PhotoHeight":275,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":34,"Preview":{"Id":1841775,"PostDate":1396307271,"PostContent":"Hi everyone! I was wondering if anyone had their wedding website up and running and would be will...","Author":{"Signature":"","Email":"kristennicole20040@gmail.com","IpAddress":"72.197.155.252","GroupId":40,"GroupName":"Jr. Member","JoinDate":1390402143,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276272.jpg?_r=1423510309","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"CurlyKristen","Id":276272,"Name":"CurlyKristen","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.197.201.69","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76735,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3014900e2adb80d2e0701abd96094075","RawContent":"&lt;p&gt;Hi everyone! I was wondering if anyone had their wedding website up and running and would be willing to share them? Any advice on what is important to include in the wedding website? I would love to see some of the websites from the brides that have gotten married or are currently planning. Thanks!&lt;\/p&gt;","Attachments":[],"Id":1841775,"PostDate":1396307271,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi everyone! I was wondering if anyone had their wedding website up and running and would be willing to share them? Any advice on what is important to include in the wedding website? I would love to see some of the websites from the brides that have gotten married or are currently planning. Thanks!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kristennicole20040@gmail.com","IpAddress":"72.197.155.252","GroupId":40,"GroupName":"Jr. Member","JoinDate":1390402143,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276272.jpg?_r=1423510309","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"CurlyKristen","Id":276272,"Name":"CurlyKristen","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"41.218.253.49","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76735,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"176006811e45ce4a2f57a21577375e40","RawContent":"&lt;p&gt;This is a bit late but here is ours. Still working on it and have not yet sent anyone an invite yet but any input would be greatly appreciated.&lt;\/p&gt;\n&lt;p&gt;&lt;span&gt;&lt;a  class=\"\" href=\"http:\/\/keithnamanda.appycouple.com\"&gt;keithnamanda.appycouple.com&lt;\/a&gt;&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1876815,"PostDate":1414127394,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>This is a bit late but here is ours. Still working on it and have not yet sent anyone an invite yet but any input would be greatly appreciated.<\/p>\n<p><span><a href='http:\/\/keithnamanda.appycouple.com' class='bbc_url' title='External link' rel='nofollow external'>keithnamanda.appycouple.com<\/a><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p style=\"text-align:center;\"><img src=\"http:\/\/www.tickerclub.com\/tickers\/wedding\/preview\/idTicker\/206838\/rulerId\/\/sliderId\/\/\" alt=\"sliderId\"><\/p>\n<p style=\"text-align:center;\">\u00a0","Email":"amanda@roamcanada.com","IpAddress":"41.218.252.222","GroupId":39,"GroupName":"Newbie","JoinDate":1411386487,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279936.jpg?_r=1414239845","PhotoWidth":200,"PhotoHeight":246,"PhotoType":"custom"},"FormattedName":"amanda2016","Id":279936,"Name":"amanda2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.85.216.127","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76735,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"dfd6ef577a666d6bff8044b5af671fd0","RawContent":"&lt;p&gt;This is ours! Still always adding stuff, let me know what you think!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/rcstromberg.wix.com\/rosscelestewedding&#039;&gt;http:\/\/rcstromberg.wix.com\/rosscelestewedding&lt;\/a&gt;&lt;\/p&gt;","Attachments":[],"Id":1876861,"PostDate":1414163911,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>This is ours! Still always adding stuff, let me know what you think!<\/p>\n<p>\u00a0<\/p>\n<p><a href='http:\/\/rcstromberg.wix.com\/rosscelestewedding' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/rcstromberg.w...scelestewedding<\/a><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"hoopers2901@yahoo.com","IpAddress":"71.85.216.127","GroupId":40,"GroupName":"Jr. Member","JoinDate":1410901988,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279867.jpg?_r=1411696267","PhotoWidth":200,"PhotoHeight":275,"PhotoType":"custom"},"FormattedName":"cfinkenbine","Id":279867,"Name":"cfinkenbine","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"134.192.191.247","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76735,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ccb417d3679ad0babc945b81a0d11c64","RawContent":"I&#039;m still finishing making our website but trying to figure out how much travel info I should put on it. I have the link to the resort the wedding is at so figure people could check it out themselves. I also listed our travel agent for people to book thru. I don&#039;t want to put too much info that it seems overwhelming but I want everyone to get excited about the resort! Any help\/ideas are appreciated!","Attachments":[],"Id":1877328,"PostDate":1414633417,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm still finishing making our website but trying to figure out how much travel info I should put on it. I have the link to the resort the wedding is at so figure people could check it out themselves. I also listed our travel agent for people to book thru. I don't want to put too much info that it seems overwhelming but I want everyone to get excited about the resort! Any help\/ideas are appreciated! \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"colleentf09@yahoo.com","IpAddress":"68.48.23.35","GroupId":3,"GroupName":"Member","JoinDate":1414404714,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280885.jpg?_r=1414462566","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"colleentf09","Id":280885,"Name":"colleentf09","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.85.216.127","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76735,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fc2c3f025b7487b6a72bb7ec8ee4911a","RawContent":"&lt;p&gt;@[member=\"colleentf09\"] I have tried to put almost all the info on our website. (I have a lot of pages). I did this because a lot of guests won&#039;t go searching on the website to find out information.&lt;\/p&gt;","Attachments":[],"Id":1877370,"PostDate":1414664888,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"280885\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/280885-colleentf09\/' title='Member profile'><span itemprop=\"name\">colleentf09<\/span><\/a> I have tried to put almost all the info on our website. (I have a lot of pages). I did this because a lot of guests won't go searching on the website to find out information.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"hoopers2901@yahoo.com","IpAddress":"71.85.216.127","GroupId":40,"GroupName":"Jr. Member","JoinDate":1410901988,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279867.jpg?_r=1411696267","PhotoWidth":200,"PhotoHeight":275,"PhotoType":"custom"},"FormattedName":"cfinkenbine","Id":279867,"Name":"cfinkenbine","IsOnline":false}}],"Id":"76735","Title":"Share Your Wedding Website Here","LastPostDate":1414664888},"Pages":{"TotalItems":5,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
