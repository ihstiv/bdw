{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":27,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":900,"MovedTo":null,"MovedOn":0,"FirstPostId":1893886,"Rating":0,"RatingHits":0,"Starter":{"Id":276456,"Name":"Kerrierf","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276456.jpg?_r=1410147109","PhotoWidth":199,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":false},"StartDate":1429675968,"LastPoster":{"Id":281803,"Name":"Ruzanna","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281803.jpg?_r=1431571558","PhotoWidth":200,"PhotoHeight":160,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":33,"Preview":{"Id":1893886,"PostDate":1429675968,"PostContent":"Hi everyone! \u00a0 Just wondering if you have any advice or feedback for what would be best for manic...","Author":{"Signature":"","Email":"kerrierf@gmail.com","IpAddress":"69.165.209.118","GroupId":39,"GroupName":"Newbie","JoinDate":1391398823,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276456.jpg?_r=1410147109","PhotoWidth":199,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Kerrierf","Id":276456,"Name":"Kerrierf","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"135.23.201.16","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79094,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"dfedb8feac2b816237a2ea19992a8f9b","RawContent":"&lt;p&gt;Hi everyone!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Just wondering if you have any advice or feedback for what would be best for manicures before leaving for the wedding. &amp;nbsp;I had a regular manicure done 2 days before my engagement photos and had a giant chip on my left hand by the time we did the shoot!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thanks for your feedback!&lt;\/p&gt;","Attachments":[],"Id":1893886,"PostDate":1429675968,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi everyone!<\/p>\n<p>\u00a0<\/p>\n<p>Just wondering if you have any advice or feedback for what would be best for manicures before leaving for the wedding. \u00a0I had a regular manicure done 2 days before my engagement photos and had a giant chip on my left hand by the time we did the shoot!<\/p>\n<p>\u00a0<\/p>\n<p>Thanks for your feedback!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kerrierf@gmail.com","IpAddress":"69.165.209.118","GroupId":39,"GroupName":"Newbie","JoinDate":1391398823,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276456.jpg?_r=1410147109","PhotoWidth":199,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Kerrierf","Id":276456,"Name":"Kerrierf","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.41.59","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79094,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"f217bee8da4c18d2c75cefcd037609c5","RawContent":"Acrylic is somewhat archaic now a days so most places do gel or shellac mostly.  If you have short nails and are hoping for long nails you&#039;d probably go the gel route as they can use tips. If you already have long nails gel or shellac would work!! Even with shellac they can make you have the French manicure tipped look :) \n\nWhenever I travel to sand I get shellac on my toes too as the sand doesn&#039;t chip it off. \n\nAll will kill your original nails but that&#039;s par for the course. \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1893890,"PostDate":1429677013,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Acrylic is somewhat archaic now a days so most places do gel or shellac mostly.  If you have short nails and are hoping for long nails you'd probably go the gel route as they can use tips. If you already have long nails gel or shellac would work!! Even with shellac they can make you have the French manicure tipped look <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> <br>\nWhenever I travel to sand I get shellac on my toes too as the sand doesn't chip it off. <br>\nAll will kill your original nails but that's par for the course. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399432202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"64.53.250.35","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79094,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"98f5fa50a921743b43b13bc88d23d582","RawContent":"&lt;p&gt;I&#039;ve been debating this as well. &amp;nbsp;I ALWAYS have gel\/shellac on my nails and swear by it, and most of the time it lasts great for at least 2 weeks and sometimes even longer (and when you get it on your toes like @[member=\"calgarybride2015\"] it lasts FOREVER, practically until it grows completely out!), but I&#039;m worried about breaking a nail before my wedding, so I&#039;ve been debating acrylics even though I&#039;ve never had them before...but I also don&#039;t want to ruin my nails....anyway, I hope some other people can answer your question! :)&lt;\/p&gt;","Attachments":[],"Id":1893904,"PostDate":1429708886,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I've been debating this as well. \u00a0I ALWAYS have gel\/shellac on my nails and swear by it, and most of the time it lasts great for at least 2 weeks and sometimes even longer (and when you get it on your toes like @<a hovercard-ref=\"member\" hovercard-id=\"277873\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277873-calgarybride2015\/' title='Member profile'><span itemprop=\"name\">calgarybride2015<\/span><\/a> it lasts FOREVER, practically until it grows completely out!), but I'm worried about breaking a nail before my wedding, so I've been debating acrylics even though I've never had them before...but I also don't want to ruin my nails....anyway, I hope some other people can answer your question! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rachelia160@aim.com","IpAddress":"66.61.104.237","GroupId":40,"GroupName":"Jr. Member","JoinDate":1388735497,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275855.jpg?_r=1435853657","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"rachelia160","Id":275855,"Name":"rachelia160","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"216.84.102.233","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79094,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c032659a3d7993c0e2160eaa42bc7743","RawContent":"&lt;p&gt;@[member=\"Kerrierf\"] nails are very very important to me!! I get gel\/shellac every 2 weeks and am obsessed by it so definitely getting it for our wedding! it doesnt chip at all and doesnt ruin your nails like acryllic. I&#039;ve chosen OPI Mod about You Pastel. Perfect perfect bridal color!&lt;\/p&gt;","Attachments":[],"Id":1893907,"PostDate":1429710274,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"276456\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/276456-kerrierf\/' title='Member profile'><span itemprop=\"name\">Kerrierf<\/span><\/a> nails are very very important to me!! I get gel\/shellac every 2 weeks and am obsessed by it so definitely getting it for our wedding! it doesnt chip at all and doesnt ruin your nails like acryllic. I've chosen OPI Mod about You Pastel. Perfect perfect bridal color!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>58 guests plus bride and groom<br>\nCeremony: Gazebo<br>\nReception: Pool Deck","Email":"smileitseb@gmail.com","IpAddress":"50.90.104.129","GroupId":40,"GroupName":"Jr. Member","JoinDate":1394227469,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277044.jpg?_r=1432531828","PhotoWidth":200,"PhotoHeight":241,"PhotoType":"custom"},"FormattedName":"smileitseb","Id":277044,"Name":"smileitseb","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"201.140.181.201","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79094,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"141908c5791ddd77db6e287e61407d31","RawContent":"I love doing shellac! I did regular manicure the day before the wedding and the color already chipped by the next day. I swear by shellac though!","Attachments":[],"Id":1893908,"PostDate":1429710890,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I love doing shellac! I did regular manicure the day before the wedding and the color already chipped by the next day. I swear by shellac though!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><strong>N&C<\/strong><\/p>\n<p><em>April 17, 2015<\/em><\/p>\n<p>Gran Caribe Real (Cancun, Mexico)<\/p>\n<p>Including Bride & Groom: 22 guests (19 adults & 3 children)","Email":"nancysoup@att.net","IpAddress":"216.23.195.134","GroupId":39,"GroupName":"Newbie","JoinDate":1411664662,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280004.jpg?_r=1412891058","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"hellosassypants","Id":280004,"Name":"hellosassypants","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.41.59","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79094,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f02272d99756b3dffc16aee6fa1fe134","RawContent":"[quote name=\"rachelia160\" post=\"1893904\" timestamp=\"1429705286\"]\nI&#039;ve been debating this as well.  I ALWAYS have gel\/shellac on my nails and swear by it, and most of the time it lasts great for at least 2 weeks and sometimes even longer (and when you get it on your toes like @[member=\"calgarybride2015\"] it lasts FOREVER, practically until it grows completely out!), but I&#039;m worried about breaking a nail before my wedding, so I&#039;ve been debating acrylics even though I&#039;ve never had them before...but I also don&#039;t want to ruin my nails....anyway, I hope some other people can answer your question! :)[\/quote]From my experience acrylic doesn&#039;t last any better than gel!  Personally for me I had more issues with acrylic.    Do you usually break nails with gel on?  The only time I ever broke a nail was when I let them grow out to long but that&#039;s talking like 6 weeks not 2-3 before a regular fill. \n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1893909,"PostDate":1429711075,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>rachelia160, on 22 April 2015 - 05:21 AM, said:<\/p><div class='blockquote'><div class='quote'><p>I've been debating this as well.  I ALWAYS have gel\/shellac on my nails and swear by it, and most of the time it lasts great for at least 2 weeks and sometimes even longer (and when you get it on your toes like @<a hovercard-ref=\"member\" hovercard-id=\"277873\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277873-calgarybride2015\/' title='Member profile'><span itemprop=\"name\">calgarybride2015<\/span><\/a> it lasts FOREVER, practically until it grows completely out!), but I'm worried about breaking a nail before my wedding, so I've been debating acrylics even though I've never had them before...but I also don't want to ruin my nails....anyway, I hope some other people can answer your question! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p><\/div><\/div>\n<br>\nFrom my experience acrylic doesn't last any better than gel!  Personally for me I had more issues with acrylic.    Do you usually break nails with gel on?  The only time I ever broke a nail was when I let them grow out to long but that's talking like 6 weeks not 2-3 before a regular fill. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399432202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"64.53.250.35","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79094,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0e4e5a3431ac2479893bf0bba019880f","RawContent":"&lt;p&gt;@[member=\"calgarybride2015\"] They only really break when I get greedy and keep my nails too long&amp;nbsp; :blink: &amp;nbsp;I guess that&#039;s why I&#039;ve considered the acrylics, since I want length too and can&#039;t really go there with my natural nails...but I also hate when you can tell from a million miles away that someone is wearing acrylics, so it might be better to sacrifice a little length but still maintaining the natural nail look. AH I&#039;m so indecisive!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;If I DO get acrylics, I&#039;ll definitely be getting gel polish on them, I think pretty much everywhere that still does acrylics will do that.&lt;\/p&gt;","Attachments":[],"Id":1893912,"PostDate":1429711569,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"277873\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277873-calgarybride2015\/' title='Member profile'><span itemprop=\"name\">calgarybride2015<\/span><\/a> They only really break when I get greedy and keep my nails too long\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/blink.png' class='bbc_emoticon' alt=':blink:' \/> \u00a0I guess that's why I've considered the acrylics, since I want length too and can't really go there with my natural nails...but I also hate when you can tell from a million miles away that someone is wearing acrylics, so it might be better to sacrifice a little length but still maintaining the natural nail look. AH I'm so indecisive!<\/p>\n<p>\u00a0<\/p>\n<p>If I DO get acrylics, I'll definitely be getting gel polish on them, I think pretty much everywhere that still does acrylics will do that.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rachelia160@aim.com","IpAddress":"66.61.104.237","GroupId":40,"GroupName":"Jr. Member","JoinDate":1388735497,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275855.jpg?_r=1435853657","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"rachelia160","Id":275855,"Name":"rachelia160","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.41.59","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79094,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"086748c0101d6628b2e029e625f8982b","RawContent":"[quote name=\"rachelia160\" post=\"1893912\" timestamp=\"1429707969\"]\n@[member=\"calgarybride2015\"] They only really break when I get greedy and keep my nails too long  :blink:  I guess that&#039;s why I&#039;ve considered the acrylics, since I want length too and can&#039;t really go there with my natural nails...but I also hate when you can tell from a million miles away that someone is wearing acrylics, so it might be better to sacrifice a little length but still maintaining the natural nail look. AH I&#039;m so indecisive!\n\nIf I DO get acrylics, I&#039;ll definitely be getting gel polish on them, I think pretty much everywhere that still does acrylics will do that.[\/quote]Do you mean you can tell they are acrylics because of the white tip??  My salon will use the tip with gel too if your nails aren&#039;t long enough for the look you want.  You could also get a clear tip and have white gel put on to create the French manicured look.  Guess it depends if you want the white tip or a solid color.  To me acrylic and gel produce the same result it&#039;s just a different product and my salon ladies just highly recommend gel as it&#039;s better for the nails and won&#039;t discolor as much.  What do I know though hehe\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1893914,"PostDate":1429711837,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>rachelia160, on 22 April 2015 - 06:06 AM, said:<\/p><div class='blockquote'><div class='quote'><p>@<a hovercard-ref=\"member\" hovercard-id=\"277873\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277873-calgarybride2015\/' title='Member profile'><span itemprop=\"name\">calgarybride2015<\/span><\/a> They only really break when I get greedy and keep my nails too long  <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/blink.png' class='bbc_emoticon' alt=':blink:' \/>  I guess that's why I've considered the acrylics, since I want length too and can't really go there with my natural nails...but I also hate when you can tell from a million miles away that someone is wearing acrylics, so it might be better to sacrifice a little length but still maintaining the natural nail look. AH I'm so indecisive!<br><br>\nIf I DO get acrylics, I'll definitely be getting gel polish on them, I think pretty much everywhere that still does acrylics will do that.<\/p><\/div><\/div>\n<br>\nDo you mean you can tell they are acrylics because of the white tip??  My salon will use the tip with gel too if your nails aren't long enough for the look you want.  You could also get a clear tip and have white gel put on to create the French manicured look.  Guess it depends if you want the white tip or a solid color.  To me acrylic and gel produce the same result it's just a different product and my salon ladies just highly recommend gel as it's better for the nails and won't discolor as much.  What do I know though hehe<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399432202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"64.53.250.35","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79094,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"faa9dbf8c6538fed6f3ca2421dccadfc","RawContent":"&lt;p&gt;@[member=\"calgarybride2015\"] I more mean that SUPER square nail look, and being able to tell that it&#039;s kind or raised up highter than where your natural nail is.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/s-media-cache-ak0.pinimg.com\/736x\/ca\/a6\/2b\/caa62b724fb15ce49059857c1ab51cb3.jpg\" alt=\"caa62b724fb15ce49059857c1ab51cb3.jpg\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;To me the thumbnail just looks kind of goofy.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Can you get a \"tip\" without having your entire nail covered by the acrylic? I AM SO CLUELESS!&lt;\/p&gt;","Attachments":[],"Id":1893916,"PostDate":1429712034,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"277873\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277873-calgarybride2015\/' title='Member profile'><span itemprop=\"name\">calgarybride2015<\/span><\/a> I more mean that SUPER square nail look, and being able to tell that it's kind or raised up highter than where your natural nail is.<\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/s-media-cache-ak0.pinimg.com\/736x\/ca\/a6\/2b\/caa62b724fb15ce49059857c1ab51cb3.jpg\" alt=\"caa62b724fb15ce49059857c1ab51cb3.jpg\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>To me the thumbnail just looks kind of goofy.<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Can you get a \"tip\" without having your entire nail covered by the acrylic? I AM SO CLUELESS!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rachelia160@aim.com","IpAddress":"66.61.104.237","GroupId":40,"GroupName":"Jr. Member","JoinDate":1388735497,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275855.jpg?_r=1435853657","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"rachelia160","Id":275855,"Name":"rachelia160","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.41.59","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79094,"EditedBy":"<strong>Edited by calgarybride2015, 22 April 2015 - 07:08 AM.<\/strong>","EditDate":1429715290,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"49fe9a2eefe65de6952c3a9e1874913d","RawContent":"&lt;p&gt;A good nail tech should be able to file any type of nail shape you want -- square, rounded, etc. doesn&#039;t matter what is on your nail -- acrylic, gel, shellac, normal polish. To be honest the picture you posted, from my experience, could be one of many different products.\n\n\nAcrylic and gel is just the hardening product that sits on top - whether it be your real nail or lengthened by a tip they add on. Acrylic used to only come in white and clear, but over the years gel has come out with so many colors which is probably one of the large reasons why it has taken off in popularity! There are so many choices that can be done!\n\n\n\nNo your entire nail would have to be covered with either gel or acrylic whether you get a tip or not. To me, gel and acrylic produce the fairly same result, whereas shellac is just a step down. It&#039;s essentially nail polish that&#039;s cured differently.\n\n\nI could be wrong, but this is just my experience from getting my nails down for the last 10 or so years. Things could also be different the US and Canada.\n\nHere is a picture of shellac on my nails. I used black and she just formed it to look like that.\n\n\n\n\n\nThis is gel on my nails. I may have used one tip on my thumb. But otherwise it&#039;s just gel formed to look like a tip. I don&#039;t find either picture to be that different minus the length of my nails.\n\n\n\n\nHad to go back to the archives lol my son is now 9 years old. Here is acrylic using tips\n\n\n\n\n\nSent from my iPhone using Tapatalk&lt;\/p&gt;","Attachments":[],"Id":1893918,"PostDate":1429713753,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>A good nail tech should be able to file any type of nail shape you want -- square, rounded, etc. doesn't matter what is on your nail -- acrylic, gel, shellac, normal polish. To be honest the picture you posted, from my experience, could be one of many different products.<br><br>\nAcrylic and gel is just the hardening product that sits on top - whether it be your real nail or lengthened by a tip they add on. Acrylic used to only come in white and clear, but over the years gel has come out with so many colors which is probably one of the large reasons why it has taken off in popularity! There are so many choices that can be done!<br><br><br>\nNo your entire nail would have to be covered with either gel or acrylic whether you get a tip or not. To me, gel and acrylic produce the fairly same result, whereas shellac is just a step down. It's essentially nail polish that's cured differently.<br><br>\nI could be wrong, but this is just my experience from getting my nails down for the last 10 or so years. Things could also be different the US and Canada.<br>\nHere is a picture of shellac on my nails. I used black and she just formed it to look like that.<br>\n<a class='resized_img' rel='lightbox[1893918]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_04_2015\/post-277873-142971008835.jpg\" title=\"ImageUploadedByTapatalk1429710088.292811.jpg - Size: 231.48KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_04_2015\/post-277873-142971008835.jpg\" class='bbc_img linked-image' alt=\"ImageUploadedByTapatalk1429710088.292811.jpg\" \/><\/a>\n\n<br><br><br>\nThis is gel on my nails. I may have used one tip on my thumb. But otherwise it's just gel formed to look like a tip. I don't find either picture to be that different minus the length of my nails.<br>\n<a class='resized_img' rel='lightbox[1893918]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_04_2015\/post-277873-142971014927.jpg\" title=\"ImageUploadedByTapatalk1429710151.010800.jpg - Size: 131.43KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_04_2015\/post-277873-142971014927.jpg\" class='bbc_img linked-image' alt=\"ImageUploadedByTapatalk1429710151.010800.jpg\" \/><\/a>\n\n<br><br>\nHad to go back to the archives lol my son is now 9 years old. Here is acrylic using tips<br>\n<a class='resized_img' rel='lightbox[1893918]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_04_2015\/post-277873-142971157737.jpg\" title=\"ImageUploadedByTapatalk1429711579.479879.jpg - Size: 117.99KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_04_2015\/post-277873-142971157737.jpg\" class='bbc_img linked-image' alt=\"ImageUploadedByTapatalk1429711579.479879.jpg\" \/><\/a>\n\n<br><br><br>\nSent from my iPhone using Tapatalk<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399432202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":true}}],"Id":"79094","Title":"Nails: Shellac, Gel, Acryllic... Help!","LastPostDate":1431576525},"Pages":{"TotalItems":27,"TotalPages":3,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":20},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
