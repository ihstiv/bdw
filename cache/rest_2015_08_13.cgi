IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"094061a425f288322ed358399d0a055a","RawContent":"Great thread.....I think I am going yto order a 2nd dress too","Attachments":[],"Id":983438,"PostDate":1262665220,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Great thread.....I think I am going yto order a 2nd dress too\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"simply_devine82@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1251390802,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-221035.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"MsAmErika","Id":221035,"Name":"MsAmErika","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4af23c66c10f63ac1d6b4af4bc62c279","RawContent":"I posted in here a while back about getting my replica dress. I was torn once I received it, but ended up wearing it on my wedding day. LOVED IT! I just got my pro pictures back (one is in my siggie). Ill try and post a link tomorrow so you can see an up close picture of it :) \n \n It was a replica of a sottero &amp;amp; midgley dress :)","Attachm