e' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/t\/wukvjpB\/weight.png\">http:\/\/tickers.TickerFactory.com\/ezt...jpB\/weight.png<\/a><\/div><\/div>","Email":"s_katrese@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1229615565,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213251.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"s_katrese","Id":213251,"Name":"s_katrese","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f352767bd7e8e7afb49fa11740a6938b","RawContent":"Did you all just look at the dresses on landy or did you send them a picture and ask them if they could do it??","Attachments":[],"Id":976904,"PostDate":1262147820,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Did you all just look at the dresses on landy or did you send them a picture and ask them if they could do it??\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"katienicole@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1261366244,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-224023.gif?_r=0","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"FormattedName":"ktnicole","Id":224023,"Name":"ktnicole","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"361a33cc6c41a9bba3dc2a11a951651a","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;ktnicole&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Did you all just look at the dresses on landy or did you send them a picture and ask them if they could do it??&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;I went &amp;amp; tried dresses on, picked the one i love &amp;amp; sent them a picture of it because it wasn&#039;t on their website. They quoted me as $300 CAD including shipping &amp;amp; the dress is regular $2100 CAD.","Attachments":[],"Id":976961,"PostDate":1262153135,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>ktnicole<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Did you all just look at the dresses on landy or did you send them a picture and ask them if they could do it??<\/div> <\/td> <\/tr> <\/table> <\/div>I went & tried dresses on, picked the one i love & sent them a picture of it because it wasn't on their website. They quoted me as $300 CAD including shipping & the dress is regular $2100 CAD.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"melbc80@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1253391218,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-221800.jpg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"meldal101010","Id":221800,"Name":"meldal101010","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"96a83799f9404a2bffbf2eee0fe7fbe4","RawContent":"Super Excited ladies! I ordered my dress from Landy Bridal about 2 weeks ago. It was a long and hard process to get to the point of actually ordering. I talked with Lucy for about a month before making my purchase. She was so helpful, and very quick to reply. I would have to say that their customer service is amazing. :) I sent her pictures of the things I wanted and she helped me put it all together. Fingers crossed that it comes looking like what she promised it would look like! I have been counting down the days and it wont be here till closer to the end of Jan.. so when I receive it I will post feed back about the quality as well as a few photos (if I can figure it out) regardless of whether or not I love it. BUT I&#039;m pretty confident I will love it!! \n \n Good luck ladies, if you don&#039;t mind not wearing a designer label I think this maybe the best way to go.. at least so far!","Attachments":[],"Id":976980,"PostDate":1262154921,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Super Excited ladies! I ordered my dress from Landy Bridal about 2 weeks ago. It was a long and hard process to get to the point of actually ordering. I talked with Lucy for about a month before making my purchase. She was so helpful, and very quick to reply. I would have to say that their customer service is amazing. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> I sent her pictures of the things I wanted and she helped me put it all together. Fingers crossed that it comes looking like what she promised it would look like! I have been counting down the days and it wont be here till closer to the end of Jan.. so when I receive it I will post feed back about the quality as well as a few photos (if I can figure it out) regardless of whether or not I love it. BUT I'm pretty confident I will love it!! <br \/> <br \/> Good luck ladies, if you don't mind not wearing a designer label I think this maybe the best way to go.. at least so far!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"megkisslinger@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1242966480,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-217732.gif?_r=0","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"FormattedName":"Islandbride2b","Id":217732,"Name":"Islandbride2b","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"84faba9fa4ce5b4b2e67844a1ba10465","RawContent":"Glad to hear everyone is having success!\n My Duosheng dress is at the seamstress having some fitting alterations done and in the meantime I&#039;ve got my eye on a TTD... &amp;quot;Cabo&amp;quot; by Watters... anyone seen this at Landy&#039;s website? I have the hardest time finding things there!","Attachments":[],"Id":979996,"PostDate":1262412756,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Glad to hear everyone is having success!<br \/> My Duosheng dress is at the seamstress having some fitting alterations done and in the meantime I've got my eye on a TTD... \"Cabo\" by Watters... anyone seen this at Landy's website? I have the hardest time finding things there!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"geminigem615@aol.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1231200988,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213622.gif?_r=0","PhotoWidth":75,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"KimmyG","Id":213622,"Name":"KimmyG","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"47dc278be780c1a838076c23f5ae7f46","RawContent":"Has anyone had a dress done with lots of lace? I really love Maggie&#039;s Karena Royale but I am nervous that the lace they choose won&#039;t be something I like, also I want it in the light gold underlay with the ivory lace, so I am also worried about that. I think I will go and email them right now to see what they say. But I love all the dresses on their website I just REALLY love this dress.","Attachments":[],"Id":980736,"PostDate":1262495919,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Has anyone had a dress done with lots of lace? I really love Maggie's Karena Royale but I am nervous that the lace they choose won't be something I like, also I want it in the light gold underlay with the ivory lace, so I am also worried about that. I think I will go and email them right now to see what they say. But I love all the dresses on their website I just REALLY love this dress.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"robynbrumby@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1234841454,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-214984.gif?_r=0","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"FormattedName":"surprise4us","Id":214984,"Name":"surprise4us","IsOnline":false}}],"Pages":{"TotalItems":6402,"TotalPages":641,"CurrentPage":360,"NextPage":370,"PreviousPage":350,"LastPage":6400},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
