Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":13,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":657,"MovedTo":null,"MovedOn":0,"FirstPostId":1897822,"Rating":0,"RatingHits":0,"Starter":{"Id":281952,"Name":"racht33","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281952.jpg?_r=1424197509","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"StartDate":1433330569,"LastPoster":{"Id":265511,"Name":"TinkerSofi","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265511.jpg?_r=1427386564","PhotoWidth":200,"PhotoHeight":153,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":45,"Preview":{"Id":1898037,"PostDate":1433641955,"PostContent":"It should be that that one. It's called wedding dj. I bought the pack that comes with party mon...","Author":{"Signature":"<br><p><a data-ipb='nomediaparse' href='http:\/\/www.TickerFactory.com\/'><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;31;484\/st\/20150813\/e\/Wedding+time%21+\/dt\/-2\/k\/b92c\/event.png\" alt=\"event.png\"><\/a><\/p>\n<p style=\"text-align:center;\">\u00a0<\/p>\n<p style=\"text-align:center;\">\u00a0","Email":"sblopezb@gmail.com","IpAddress":"172.219.193.22","GroupId":42,"GroupName":"Sr. Member","JoinDate":1359748704,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265511.jpg?_r=1427386564","PhotoWidth":200,"PhotoHeight":153,"PhotoType":"custom"},"FormattedName":"TinkerSofi","Id":265511,"Name":"TinkerSofi","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"192.249.47.212","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79242,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"247f4b25d1a77011ae074eb3c34be92c","RawContent":"&lt;p&gt;I was informed about a wedding DJ App for I phone . and have been reading amazing reviews on it. unfortunately, my FI and I have droid devices. Would anyone know of a similar app for the droid phone? Or we possibly may just need to invest in an Ipod for the wedding,. It will be far less then the resort DJ @300 an hour.&amp;nbsp; Any feedback on the app would be helpful too. :) Thank you!!&lt;\/p&gt;","Attachments":[],"Id":1897822,"PostDate":1433330569,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I was informed about a wedding DJ App for I phone . and have been reading amazing reviews on it. unfortunately, my FI and I have droid devices. Would anyone know of a similar app for the droid phone? Or we possibly may just need to invest in an Ipod for the wedding,. It will be far less then the resort DJ @300 an hour.\u00a0 Any feedback on the app would be helpful too. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> Thank you!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>57 Guest","Email":"racht33@yahoo.com","IpAddress":"192.249.47.212","GroupId":3,"GroupName":"Member","JoinDate":1422618588,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281952.jpg?_r=1424197509","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"racht33","Id":281952,"Name":"racht33","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79242,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"d1d04ad74f8886a1f908c9a970790cac","RawContent":"&lt;p&gt;I have a droid too, but couldn&#039;t find anything comparable. I have an iPad so I think i&#039;m going to load it up with music and download the wedding DJ app on there. We also aren&#039;t investing in a DJ either so I think it&#039;s the best option for us.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1897823,"PostDate":1433330663,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I have a droid too, but couldn't find anything comparable. I have an iPad so I think i'm going to load it up with music and download the wedding DJ app on there. We also aren't investing in a DJ either so I think it's the best option for us.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419423414,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1436293677","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"192.249.47.212","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79242,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"4fe9347f87aecaebdaf9ea2d74956a69","RawContent":"&lt;p&gt;man.. we may need to just invest in an one. Or see if one of our friends can loan us one for the day. @perianjay&amp;nbsp; you;; have to tell me how it goes with the app :)!!&lt;\/p&gt;","Attachments":[],"Id":1897830,"PostDate":1433333230,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>man.. we may need to just invest in an one. Or see if one of our friends can loan us one for the day. @perianjay\u00a0 you;; have to tell me how it goes with the app <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>57 Guest","Email":"racht33@yahoo.com","IpAddress":"192.249.47.212","GroupId":3,"GroupName":"Member","JoinDate":1422618588,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281952.jpg?_r=1424197509","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"racht33","Id":281952,"Name":"racht33","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79242,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d4fce4fbb39d55a074a9986f96d32963","RawContent":"&lt;p&gt;@[member=\"racht33\"] Yea, maybe see if one of your friends have one! :) I will for sure let you know how it goes :)&lt;\/p&gt;","Attachments":[],"Id":1897841,"PostDate":1433338217,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"281952\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281952-racht33\/' title='Member profile'><span itemprop=\"name\">racht33<\/span><\/a> Yea, maybe see if one of your friends have one! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> I will for sure let you know how it goes <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419423414,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1436293677","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.98.196.2","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79242,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"07c0d90b61aa0ac0e34648cca174f9bc","RawContent":"&lt;p&gt;I got the app for iphone because that&#039;s what I have. Maybe try finding a used ipad or borrowing one from someone :). Another idea is trying to get an ipod. They&#039;re not as expensive and i&#039;m sure you can find used ones :).&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;ve got my playlists made but haven&#039;t had a chance to put them in my phone and trying the app out. I can let you know how it goes and whether it&#039;s worth going through the trouble of getting an ipad or an ipod.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1897847,"PostDate":1433340661,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I got the app for iphone because that's what I have. Maybe try finding a used ipad or borrowing one from someone <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>. Another idea is trying to get an ipod. They're not as expensive and i'm sure you can find used ones <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I've got my playlists made but haven't had a chance to put them in my phone and trying the app out. I can let you know how it goes and whether it's worth going through the trouble of getting an ipad or an ipod.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<br><p><a data-ipb='nomediaparse' href='http:\/\/www.TickerFactory.com\/'><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;31;484\/st\/20150813\/e\/Wedding+time%21+\/dt\/-2\/k\/b92c\/event.png\" alt=\"event.png\"><\/a><\/p>\n<p style=\"text-align:center;\">\u00a0<\/p>\n<p style=\"text-align:center;\">\u00a0","Email":"sblopezb@gmail.com","IpAddress":"172.219.193.22","GroupId":42,"GroupName":"Sr. Member","JoinDate":1359748704,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265511.jpg?_r=1427386564","PhotoWidth":200,"PhotoHeight":153,"PhotoType":"custom"},"FormattedName":"TinkerSofi","Id":265511,"Name":"TinkerSofi","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"192.249.47.212","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79242,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"56994f81c725f11192f25cbcca013742","RawContent":"&lt;p&gt;@[member=\"TinkerSofi\"] yes please do. I know we have an ipod somehwere in my house.. it may be an old model so i dont know how far ill get with that haha. But i can look online for one. :)&lt;\/p&gt;","Attachments":[],"Id":1897849,"PostDate":1433341319,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"265511\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/265511-tinkersofi\/' title='Member profile'><span itemprop=\"name\">TinkerSofi<\/span><\/a> yes please do. I know we have an ipod somehwere in my house.. it may be an old model so i dont know how far ill get with that haha. But i can look online for one. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>57 Guest","Email":"racht33@yahoo.com","IpAddress":"192.249.47.212","GroupId":3,"GroupName":"Member","JoinDate":1422618588,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281952.jpg?_r=1424197509","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"racht33","Id":281952,"Name":"racht33","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.15.187","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79242,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d07f373b5df0c7343a4f11387aa57a3c","RawContent":"&lt;p&gt;@[member=\"racht33\"] have you done a search on the site for the app info? I know my alzheimers is showing but I&#039;d swear I saw a post about it for an android device, not just iphone. Either that or someone mentioned something if not the same then comparable for the android devices.&lt;\/p&gt;","Attachments":[],"Id":1897947,"PostDate":1433465205,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"281952\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281952-racht33\/' title='Member profile'><span itemprop=\"name\">racht33<\/span><\/a> have you done a search on the site for the app info? I know my alzheimers is showing but I'd swear I saw a post about it for an android device, not just iphone. Either that or someone mentioned something if not the same then comparable for the android devices.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"199.126.252.6","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79242,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":5,"IsLiked":false,"PostKey":"d673333c287b3c077fbd4c1cc02fece0","RawContent":"&lt;p&gt;I finally got a chance to put all the music on my phone and set the app up. The verdict is:&amp;nbsp;&lt;strong&gt;I strongly recommend it&lt;\/strong&gt;. I had playlists done for the different parts of the wedding and it took me about 5min to choose on the app the playlists and songs that will get played for each part of the wedding (the ceremony, signing of the registry, reception dinner, party, etc) and it takes about 5 min to learn how to use it. All you have to do the day of the wedding is assign one person to control the app, and all they need to do is swipe to go from one section to the next. As long as they have a timeline and know what&#039;s coming next you should be ok :).&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Whenever you pause a song or go on to the next section of the wedding the song fades out, which is a nice touch, rather than a sharp stop to the music. You have a choice as to whether you want to shuffle the songs or play them in the order you arrange them. You can also allow the app to repeat the playlist (I guess not a big deal during the pre-ceremony and dinner, but that would be bad during the party because people will notice right away that the song has already been played). I just made sure I had more than enough songs for the time that we had. So if the ceremony is expected to be 30min I put 45-60min of music.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;You can organize the order of the events to fit your wedding, so for example, the default for the app is to have the first dance after the dinner music. However, we are going to be doing our first dance as soon as we walk in. I was able to move up the \"first dance\" section to right after the entrance song.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;You can also add sections that are not in the app, so you can customize it to your event.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Another thing I liked is that after certain songs, the app has the option to wait. This means that when you swipe to end a section, it won&#039;t move on to the next one automatically unless you swipe again. An example for this is, after the groom and bridal party make their entrance to the ceremony, you want to wait to play the song for the bride&#039;s entrance, because the bride might need to get settled or whatever. So you swipe once to finish the bridal party&#039;s entrance, and then swipe again to start the entrance of the bride song.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;The only downside to this app, and maybe there is an easy solution, I just haven&#039;t figured it out yet, is the fact that if you have the cake cutting or the bouquet toss in the middle of the party, when you go back to the party playlist, the playlist starts from the beginning. This means that it would repeat the same songs over again that were already played, rather than having an option to \"continue the party\" and pick up on the party playlist where it left off. My fix to that is dividing all of your party songs into different playlists and organizing it so that &amp;nbsp;on the app you would have the playlists in the following order \"party 1\", \"cake cutting\", \"party 2\", \"bouquet toss\", \"party 3\", etc. That way whenever you go back to the dancing, the songs will not be repeated :). I don&#039;t know if that makes any sense.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Overall, for $8 it&#039;s a really good and if you&#039;re not getting a DJ this is the next best thing. It really takes off the guessing game for whoever is MCing, as all they have to do is swipe to go to the next section. As long as they have a detailed timeline of the wedding and you keep communicating with them, anyone should be able to do the job :).&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I hope that helps some of you on the fence. If you can find something like this for android that would be great, but the apple one is really good!&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1897992,"PostDate":1433525855,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I finally got a chance to put all the music on my phone and set the app up. The verdict is:\u00a0<strong>I strongly recommend it<\/strong>. I had playlists done for the different parts of the wedding and it took me about 5min to choose on the app the playlists and songs that will get played for each part of the wedding (the ceremony, signing of the registry, reception dinner, party, etc) and it takes about 5 min to learn how to use it. All you have to do the day of the wedding is assign one person to control the app, and all they need to do is swipe to go from one section to the next. As long as they have a timeline and know what's coming next you should be ok <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Whenever you pause a song or go on to the next section of the wedding the song fades out, which is a nice touch, rather than a sharp stop to the music. You have a choice as to whether you want to shuffle the songs or play them in the order you arrange them. You can also allow the app to repeat the playlist (I guess not a big deal during the pre-ceremony and dinner, but that would be bad during the party because people will notice right away that the song has already been played). I just made sure I had more than enough songs for the time that we had. So if the ceremony is expected to be 30min I put 45-60min of music.<\/p>\n<p>\u00a0<\/p>\n<p>You can organize the order of the events to fit your wedding, so for example, the default for the app is to have the first dance after the dinner music. However, we are going to be doing our first dance as soon as we walk in. I was able to move up the \"first dance\" section to right after the entrance song.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>You can also add sections that are not in the app, so you can customize it to your event.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Another thing I liked is that after certain songs, the app has the option to wait. This means that when you swipe to end a section, it won't move on to the next one automatically unless you swipe again. An example for this is, after the groom and bridal party make their entrance to the ceremony, you want to wait to play the song for the bride's entrance, because the bride might need to get settled or whatever. So you swipe once to finish the bridal party's entrance, and then swipe again to start the entrance of the bride song.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>The only downside to this app, and maybe there is an easy solution, I just haven't figured it out yet, is the fact that if you have the cake cutting or the bouquet toss in the middle of the party, when you go back to the party playlist, the playlist starts from the beginning. This means that it would repeat the same songs over again that were already played, rather than having an option to \"continue the party\" and pick up on the party playlist where it left off. My fix to that is dividing all of your party songs into different playlists and organizing it so that \u00a0on the app you would have the playlists in the following order \"party 1\", \"cake cutting\", \"party 2\", \"bouquet toss\", \"party 3\", etc. That way whenever you go back to the dancing, the songs will not be repeated <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>. I don't know if that makes any sense.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Overall, for $8 it's a really good and if you're not getting a DJ this is the next best thing. It really takes off the guessing game for whoever is MCing, as all they have to do is swipe to go to the next section. As long as they have a detailed timeline of the wedding and you keep communicating with them, anyone should be able to do the job <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I hope that helps some of you on the fence. If you can find something like this for android that would be great, but the apple one is really good!\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<br><p><a data-ipb='nomediaparse' href='http:\/\/www.TickerFactory.com\/'><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;31;484\/st\/20150813\/e\/Wedding+time%21+\/dt\/-2\/k\/b92c\/event.png\" alt=\"event.png\"><\/a><\/p>\n<p style=\"text-align:center;\">\u00a0<\/p>\n<p style=\"text-align:center;\">\u00a0","Email":"sblopezb@gmail.com","IpAddress":"172.219.193.22","GroupId":42,"GroupName":"Sr. Member","JoinDate":1359748704,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265511.jpg?_r=1427386564","PhotoWidth":200,"PhotoHeight":153,"PhotoType":"custom"},"FormattedName":"TinkerSofi","Id":265511,"Name":"TinkerSofi","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.15.187","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79242,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bd4b05599aae1fd50e26e91a3f3f6d00","RawContent":"&lt;p&gt;@[member=\"TinkerSofi\"] Do you see any way that it would \"manage itself\"? We aren&#039;t having a dj - there&#039;s 6 of us but I do want the music and have an idea of what the songs are that I want. Does it absolutely have to be managed by someone or is there a way to set it up and let it go through each \"party\" on its own? I looked at the app but haven&#039;t paid for it yet so didn&#039;t get very far in terms of looking.&lt;\/p&gt;","Attachments":[],"Id":1897999,"PostDate":1433552638,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"265511\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/265511-tinkersofi\/' title='Member profile'><span itemprop=\"name\">TinkerSofi<\/span><\/a> Do you see any way that it would \"manage itself\"? We aren't having a dj - there's 6 of us but I do want the music and have an idea of what the songs are that I want. Does it absolutely have to be managed by someone or is there a way to set it up and let it go through each \"party\" on its own? I looked at the app but haven't paid for it yet so didn't get very far in terms of looking.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.0.198.224","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79242,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d313eac791d835b38b0094170897fb73","RawContent":"&lt;p&gt;@[member=\"TinkerSofi\"] thanx for the feedback !!! This sounds like such a good app. I have yet to find anything for android so we will have to get some type of apple device to make this work.&lt;\/p&gt;","Attachments":[],"Id":1898011,"PostDate":1433586981,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"265511\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/265511-tinkersofi\/' title='Member profile'><span itemprop=\"name\">TinkerSofi<\/span><\/a> thanx for the feedback !!! This sounds like such a good app. I have yet to find anything for android so we will have to get some type of apple device to make this work.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>57 Guest","Email":"racht33@yahoo.com","IpAddress":"192.249.47.212","GroupId":3,"GroupName":"Member","JoinDate":1422618588,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281952.jpg?_r=1424197509","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"racht33","Id":281952,"Name":"racht33","IsOnline":false}}],"Id":"79242","Title":"Dj App","LastPostDate":1433641955},"Pages":{"TotalItems":13,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
