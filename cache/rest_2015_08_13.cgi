{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":7,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":245,"MovedTo":null,"MovedOn":0,"FirstPostId":1901749,"Rating":0,"RatingHits":0,"Starter":{"Id":284257,"Name":"Crooks813","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1438620591,"LastPoster":{"Id":284350,"Name":"jaicolebe","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1902399,"PostDate":1439431300,"PostContent":"Hi Nicole! congratulations for wedding and of course you choose destination wedding. If you choos...","Author":{"Signature":"<p><a data-ipb='nomediaparse' href='http:\/\/www.hotfrog.ca\/Products\/Wedding-Planner'>Hotfrog Wedding Planner<\/a>","Email":"jaicolebe@gmail.com","IpAddress":"115.187.59.254","GroupId":39,"GroupName":"Newbie","JoinDate":1439203620,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"jaicolebe","Id":284350,"Name":"jaicolebe","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"96.58.28.74","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79463,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1597e515c1b1585ba70ae4ec3eaf8913","RawContent":"&lt;p&gt;Hi my name is Nicole Crooks am new here and looking for ideas for my destination wedding hope I will get some input in what I want on this site .&lt;\/p&gt;","Attachments":[],"Id":1901749,"PostDate":1438620591,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi my name is Nicole Crooks am new here and looking for ideas for my destination wedding hope I will get some input in what I want on this site .<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"crooks813@hotmail.com","IpAddress":"96.58.28.74","GroupId":39,"GroupName":"Newbie","JoinDate":1438618731,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Crooks813","Id":284257,"Name":"Crooks813","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.143.234.156","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79463,"EditedBy":"<strong>Edited by Moments That Matter, 04 August 2015 - 10:32 AM.<\/strong>","EditDate":1438684343,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2270e0e76a918a9cb2af05c3a71e67c7","RawContent":"&lt;p&gt;Hi Nicole, welcome to our forum community and Congrats on your upcoming destination wedding!!! You&#039;ve come to the right place for some great ideas, suggestions, advice and support from everyone here, so well done on starting off so well :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Here are some magical wedding \"moments that matter\" we captured in our magnificent Mayan Riviera to inspire you further......enjoy!!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;....from the&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10153497660869487.1073741944.18683524486&amp;amp;type=3&#039;&gt; Sandos Cancun Wedding Album: &lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-prn2\/t31.0-8\/11791917_10153497663149487_7195621612390855067_o.jpg\" alt=\"11791917_10153497663149487_7195621612390\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xft1\/t31.0-8\/11754795_10153497665659487_1869415054091666368_o.jpg\" alt=\"11754795_10153497665659487_1869415054091\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xtf1\/t31.0-8\/11754731_10153497667424487_2784750626809589132_o.jpg\" alt=\"11754731_10153497667424487_2784750626809\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;....or these from the&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xtf1\/t31.0-8\/11728769_10153477925994487_7191985534930908566_o.jpg&#039;&gt; Dreams Tulum Wedding Album: &lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xtf1\/t31.0-8\/11728769_10153477925994487_7191985534930908566_o.jpg\" alt=\"11728769_10153477925994487_7191985534930\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xtp1\/t31.0-8\/11705564_10153477926449487_356215201422263609_o.jpg\" alt=\"11705564_10153477926449487_3562152014222\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xpt1\/t31.0-8\/11700978_10153477931044487_353458285981038213_o.jpg\" alt=\"11700978_10153477931044487_3534582859810\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;.....from the &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10153455288424487.1073741940.18683524486&amp;amp;type=3&#039;&gt;NOW Jade Wedding Album: &lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xtp1\/t31.0-8\/11700726_10153455296239487_8193843878115225725_o.jpg\" alt=\"11700726_10153455296239487_8193843878115\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xap1\/t31.0-8\/11741091_10153455297229487_7090297919879045525_o.jpg\" alt=\"11741091_10153455297229487_7090297919879\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xft1\/t31.0-8\/11731973_10153455298929487_2401646924023664333_o.jpg\" alt=\"11731973_10153455298929487_2401646924023\"&gt;&lt;\/p&gt;\n&lt;p&gt;Wishing you happy research, and all the best with your journey ahead - Enjoy!!! team MTM :)&lt;\/p&gt;","Attachments":[],"Id":1901797,"PostDate":1438684151,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Nicole, welcome to our forum community and Congrats on your upcoming destination wedding!!! You've come to the right place for some great ideas, suggestions, advice and support from everyone here, so well done on starting off so well <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Here are some magical wedding \"moments that matter\" we captured in our magnificent Mayan Riviera to inspire you further......enjoy!!!<\/p>\n<p>\u00a0<\/p>\n<p>....from the<a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10153497660869487.1073741944.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'> Sandos Cancun Wedding Album: <\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-prn2\/t31.0-8\/11791917_10153497663149487_7195621612390855067_o.jpg\" alt=\"11791917_10153497663149487_7195621612390\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xft1\/t31.0-8\/11754795_10153497665659487_1869415054091666368_o.jpg\" alt=\"11754795_10153497665659487_1869415054091\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xtf1\/t31.0-8\/11754731_10153497667424487_2784750626809589132_o.jpg\" alt=\"11754731_10153497667424487_2784750626809\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>....or these from the<a href='https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xtf1\/t31.0-8\/11728769_10153477925994487_7191985534930908566_o.jpg' class='bbc_url' title='External link' rel='nofollow external'> Dreams Tulum Wedding Album: <\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xtf1\/t31.0-8\/11728769_10153477925994487_7191985534930908566_o.jpg\" alt=\"11728769_10153477925994487_7191985534930\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xtp1\/t31.0-8\/11705564_10153477926449487_356215201422263609_o.jpg\" alt=\"11705564_10153477926449487_3562152014222\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xpt1\/t31.0-8\/11700978_10153477931044487_353458285981038213_o.jpg\" alt=\"11700978_10153477931044487_3534582859810\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>.....from the <a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10153455288424487.1073741940.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>NOW Jade Wedding Album: <\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xtp1\/t31.0-8\/11700726_10153455296239487_8193843878115225725_o.jpg\" alt=\"11700726_10153455296239487_8193843878115\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xap1\/t31.0-8\/11741091_10153455297229487_7090297919879045525_o.jpg\" alt=\"11741091_10153455297229487_7090297919879\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-sea1-1.xx.fbcdn.net\/hphotos-xft1\/t31.0-8\/11731973_10153455298929487_2401646924023664333_o.jpg\" alt=\"11731973_10153455298929487_2401646924023\"><\/span><\/p>\n<p>Wishing you happy research, and all the best with your journey ahead - Enjoy!!! team MTM <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280196260,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"200.79.251.123","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79463,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"e92d5f3185559450cfdbcfc430a8457c","RawContent":"[quote name=\"Crooks813\" post=\"1901749\" timestamp=\"1438634991\"]\nHi my name is Nicole Crooks am new here and looking for ideas for my destination wedding hope I will get some input in what I want on this site .[\/quote]hey @[member=\"Crooks813\"],\n\nWelcome to the forum, you will find tons of information here.   Also have you considered the riviera maya as locations? we have tons of resort, villas and private locations.  \n\n\nFeel free to reach out and we will be happy to help.\n\nHappy Planning!\nJoyce","Attachments":[],"Id":1901808,"PostDate":1438691262,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Crooks813, on 03 August 2015 - 04:49 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hi my name is Nicole Crooks am new here and looking for ideas for my destination wedding hope I will get some input in what I want on this site .<\/p>\n<\/div>\n<\/div><\/div>\n<p>hey\u00a0@<a hovercard-ref=\"member\" hovercard-id=\"284257\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/284257-crooks813\/' title='Member profile'><span itemprop=\"name\">Crooks813<\/span><\/a>,<\/p>\n<p>\u00a0<\/p>\n<p>Welcome to the forum, you will find tons of information here. \u00a0 Also have you considered the riviera maya as locations? we have tons of resort, villas and private locations. \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Feel free to reach out and we will be happy to help.<\/p>\n<p>\u00a0<\/p>\n<p>Happy Planning!<\/p>\n<p>Joyce<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Dream Weddings Riviera Maya- We pay attention to your wishes and coordinate closely with you to ensure your wedding or event is planned to perfection!<\/p>\n<p>\u00a0<\/p>\n<p><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Dream Weddings Riviera Maya<\/span><\/span><\/span><br><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">weddingsinplayadelcarmen@gmail.com<\/span><\/span><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html'>http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html<\/a><\/p>\n<p>\u00a0<\/p>\n<p><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Happy Planning!<\/span><\/span><\/span><br><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Joyce<\/span><\/span><\/span><br>\n\u00a0","Email":"weddingsinplayadelcarmen@gmail.com","IpAddress":"187.252.44.28","GroupId":49,"GroupName":"Insiders","JoinDate":1326839987,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250090.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"dreamweddings","Id":250090,"Name":"dreamweddings","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"201.116.201.71","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79463,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"aa376328f6b38866971e9c7f70419fb6","RawContent":"&lt;p&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"font-family:georgia, serif;\"&gt;Hi Nicole, Congratulations!&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;div&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"font-family:georgia, serif;\"&gt;This is a very exciting moment in your life! Planning your wedding day would probabbly leave you with a lot of information and some questions will arise but you will find that girls here are really supportive and share great suggestions.&lt;\/span&gt;&lt;\/span&gt;&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"font-family:georgia, serif;\"&gt;Now that you are looking for ideas for your destination wedding, Mexico is a place many couples are going with because of the warm of the people, great weather and the fact that there are many beautiful beaches through many tourist spots in the country.&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/div&gt;\n&lt;div&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"font-family:georgia, serif;\"&gt;If you are looking for an amazing place to wow your guests; we offer a one of a kind wedding experience where guest board a boat on a trip to the south of Puerto Vallarta, arriving to a private beach cove where the ceremony is held surronded by a beautiful natural setting; enjoying a great dinner buffet with some mexican flavor and party during the night overlooking the sea.&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/div&gt;\n&lt;div&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"font-family:georgia, serif;\"&gt;Plus, getting full assistance of our wedding coordinator&#039;s staff. We&#039;ll basically take care of everything as you add your style and inspiration.&lt;\/span&gt;&lt;\/span&gt;&lt;\/div&gt;\n&lt;div&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"font-family:georgia, serif;\"&gt;You can see more about our wedding packages if you are interested at www.adventureweddingsvallarta.com or call our Toll Free number.&lt;\/span&gt;&lt;\/span&gt;&lt;\/div&gt;\n&lt;div&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"font-family:georgia, serif;\"&gt;Best of luck with the planning!!!&lt;\/span&gt;&lt;\/span&gt;&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:81813]&lt;\/div&gt;\n&lt;div&gt;[sharedmedia=gallery:images:81509]&lt;\/div&gt;\n&lt;\/div&gt;\n\n\t\t\t\t&lt;p&gt;&lt;span style=\"color:#000000;\"&gt;&lt;span style=\"font-family:&#039;times new roman&#039;, serif;\"&gt;&lt;span style=\"font-size:13.5pt;\"&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n\t\t\t\n\t\t\n\t\t\t\t&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.adventureweddingsvallarta.com\/&#039;&gt;www.adventureweddingsvallarta.com&lt;\/a&gt;\n\t\t\n\t\t\t\t&lt;p&gt;&lt;span style=\"color:rgb(97,165,185);font-family:arial, sans-serif;font-size:12px;\"&gt;Toll Free: 1 866.731.8152&lt;\/span&gt;&lt;\/p&gt;\n\t\t\t\n\t\t\n\t\t\t\t\n\t\t\t\t\t\t\t\t&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/AdventureWedding&#039;&gt;&lt;span style=\"font-family:&#039;times new roman&#039;, serif;\"&gt;&lt;span style=\"font-size:12pt;\"&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/a&gt;&lt;\/p&gt;\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t&lt;p&gt;&lt;span style=\"color:#FFFFFF;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;&lt;span style=\"font-size:1pt;\"&gt;VAD&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.pinterest.com\/adventurew\/&#039;&gt;&lt;span style=\"font-family:&#039;times new roman&#039;, serif;\"&gt;&lt;span style=\"font-size:12pt;\"&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/a&gt;&lt;\/p&gt;\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t&lt;p&gt;&lt;span style=\"color:#FFFFFF;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;&lt;span style=\"font-size:1pt;\"&gt;VAD&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21577-adventure-weddings-las-caletas\/&#039;&gt;&lt;span style=\"font-family:&#039;times new roman&#039;, serif;\"&gt;&lt;span style=\"font-size:12pt;\"&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/a&gt;&lt;\/p&gt;\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\n\t\t\t\t&lt;p&gt;&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1901811,"PostDate":1438692807,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span  style=\"font-size:14px\"><span  style=\"font-family:georgia, serif\">Hi Nicole, Congratulations!<\/span><\/span><\/p>\n<div><span  style=\"font-size:14px\"><span  style=\"font-family:georgia, serif\">This is a very exciting moment in your life! Planning your wedding day would probabbly leave you with a lot of information and some questions will arise but you will find that girls here are really supportive and share great suggestions.<\/span><\/span><\/div>\n<div>\u00a0<\/div>\n<div><span  style=\"font-size:14px\"><span  style=\"font-family:georgia, serif\">Now that you are looking for ideas for your destination wedding, Mexico is a place many couples are going with because of the warm of the people, great weather and the fact that there are many beautiful beaches through many tourist spots in the country.\u00a0<\/span><\/span><\/div>\n<div><span  style=\"font-size:14px\"><span  style=\"font-family:georgia, serif\">If you are looking for an amazing place to wow your guests; we offer a one of a kind wedding experience where guest board a boat on a trip to the south of Puerto Vallarta, arriving to a private beach cove where the ceremony is held surronded by a beautiful natural setting; enjoying a great dinner buffet with some mexican flavor and party during the night overlooking the sea.\u00a0<\/span><\/span><\/div>\n<div><span  style=\"font-size:14px\"><span  style=\"font-family:georgia, serif\">Plus, getting full assistance of our wedding coordinator's staff. We'll basically take care of everything as you add your style and inspiration.<\/span><\/span><\/div>\n<div><span  style=\"font-size:14px\"><span  style=\"font-family:georgia, serif\">You can see more about our wedding packages if you are interested at www.adventureweddingsvallarta.com or call our Toll Free number.<\/span><\/span><\/div>\n<div><span  style=\"font-size:14px\"><span  style=\"font-family:georgia, serif\">Best of luck with the planning!!!<\/span><\/span><\/div>\n<div>\u00a0<\/div>\n<div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/index.phpgallery\/image\/81813-ceremony-setup-with-wedding-favors-for-each-guest\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_18083\/sml_gallery_258213_18083_998626.jpg' class='galattach galimageview sharedmedia_screenshot' title='Ceremony Setup with Wedding Favors for each guest'  width='200' height='134'  alt='Ceremony Setup with Wedding Favors for each guest' id='sml_image_view_81813' \/><\/a>\n<br \/><\/div>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/index.phpgallery\/image\/81509-firedncers-adventureweddings-puertovallarta-destinationweddings\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_18066\/sml_gallery_258213_18066_1605376.jpg' class='galattach galimageview sharedmedia_screenshot' title='#FireDncers #AdventureWeddings #PuertoVallarta #DestinationWeddings'  width='200' height='134'  alt='#FireDncers #AdventureWeddings #PuertoVallarta #DestinationWeddings' id='sml_image_view_81509' \/><\/a>\n<br \/><\/div>\n<\/div>\n\n\t\t\t\t<p><span  style=\"color:#000000\"><span  style=\"font-family:'times new roman', serif;\"><span  style=\"font-size:13.5pt\"><\/span><\/span><\/span><\/p>\n\t\t\t\n\t\t\n\t\t\t\t<a href='https:\/\/www.adventureweddingsvallarta.com\/' class='bbc_url' title='External link' rel='nofollow external'>www.adventureweddingsvallarta.com<\/a>\n\t\t\n\t\t\t\t<p><span  style=\"color:rgb(97,165,185);font-family:arial, sans-serif;font-size:12px\">Toll Free: 1 866.731.8152<\/span><\/p>\n\t\t\t\n\t\t\n\t\t\t\t\n\t\t\t\t\t\t\t\t<p><a href='https:\/\/www.facebook.com\/AdventureWedding' class='bbc_url' title='External link' rel='nofollow external'><span  style=\"font-family:'times new roman', serif;\"><span  style=\"font-size:12pt\"><\/span><\/span><\/a><\/p>\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t<p><span  style=\"color:#FFFFFF\"><span  style=\"font-family:arial, sans-serif\"><span  style=\"font-size:1pt\">VAD<\/span><\/span><\/span><\/p>\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t<p><a href='https:\/\/www.pinterest.com\/adventurew\/' class='bbc_url' title='External link' rel='nofollow external'><span  style=\"font-family:'times new roman', serif;\"><span  style=\"font-size:12pt\"><\/span><\/span><\/a><\/p>\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t<p><span  style=\"color:#FFFFFF\"><span  style=\"font-family:arial, sans-serif\"><span  style=\"font-size:1pt\">VAD<\/span><\/span><\/span><\/p>\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t<p><a href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21577-adventure-weddings-las-caletas\/' class='bbc_url' title=''><span  style=\"font-family:'times new roman', serif;\"><span  style=\"font-size:12pt\"><\/span><\/span><\/a><\/p>\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\n\t\t\t\t<p>\u00a0<\/p>\n\t\t\t\n\t\t\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"dennise@adventureweddingsvallarta.com","IpAddress":"187.146.166.254","GroupId":49,"GroupName":"Insiders","JoinDate":1343044403,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-258213.jpeg?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"LasCaletas","Id":258213,"Name":"LasCaletas","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.87.237.201","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79463,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cdb6aec9c16ec5f74a31a7251bb9c855","RawContent":"&lt;p&gt;Congrats and welcome! You don&#039;t say what type of ideas and information you&#039;re looking for but a good starting point would be just to browse the forums and do some reading. Then I would highly recommend finding a good travel agent. They will be come your new best friend as you go through your planning journey. They should be able to help you with your must haves and don&#039;t wants, your budget and what you want your guests to spend to travel as well as field any questions that your guests might have to leave you free for your other planning details.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;The ladies here are great. Don&#039;t hesitate to ask question within the forums. We have a few brides getting married over the next couple of months so you should also get some good reviews once they&#039;re back that might help you out as well.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck and happy planning!&lt;\/p&gt;","Attachments":[],"Id":1901915,"PostDate":1438778660,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats and welcome! You don't say what type of ideas and information you're looking for but a good starting point would be just to browse the forums and do some reading. Then I would highly recommend finding a good travel agent. They will be come your new best friend as you go through your planning journey. They should be able to help you with your must haves and don't wants, your budget and what you want your guests to spend to travel as well as field any questions that your guests might have to leave you free for your other planning details.<\/p>\n<p>\u00a0<\/p>\n<p>The ladies here are great. Don't hesitate to ask question within the forums. We have a few brides getting married over the next couple of months so you should also get some good reviews once they're back that might help you out as well.<\/p>\n<p>\u00a0<\/p>\n<p>Good luck and happy planning!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"216.191.13.35","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79463,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a30052871b2554627cdbedfc673a7a88","RawContent":"&lt;p&gt;Hi Nicole! &amp;nbsp;Congrats and welcome! &amp;nbsp;This forum has been super helpful to me during my planning. &amp;nbsp;I&#039;ve been on here since February, 2013 and my wedding is coming up next month. &amp;nbsp;I found so many helpful tips and advice. &amp;nbsp;I also found a lot of support from a lot of the brides on here when I was going through tough or stressful situations. &amp;nbsp;The brides here are amazing! &amp;nbsp;Feel free to ask all the questions you want! &amp;nbsp; &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1901917,"PostDate":1438779194,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Nicole! \u00a0Congrats and welcome! \u00a0This forum has been super helpful to me during my planning. \u00a0I've been on here since February, 2013 and my wedding is coming up next month. \u00a0I found so many helpful tips and advice. \u00a0I also found a lot of support from a lot of the brides on here when I was going through tough or stressful situations. \u00a0The brides here are amazing! \u00a0Feel free to ask all the questions you want! \u00a0 \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div><br><div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;484\/st\/20150924\/e\/Our+Wedding\/k\/8745\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<\/div>\n<div>\u00a0<\/div>\n<div>My Planning Thread:<\/div>\n<div>\u00a0<\/div>\n<div><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79153-diadiamonds-planning-thread-iberostar-varadero-cuba-sept242015\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79153-diadiamonds-planning-thread-iberostar-varadero-cuba-sept242015\/<\/a><\/div>\n<div>\u00a0<\/div>\n<div>\u00a0<\/div>\n","Email":"fadia.daniel@gmail.com","IpAddress":"76.64.81.211","GroupId":40,"GroupName":"Jr. Member","JoinDate":1392649643,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276748.jpg?_r=1392867144","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"diadiamond","Id":276748,"Name":"diadiamond","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"115.187.49.162","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79463,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7aa49985ce53ffdc7acecec6aafced9d","RawContent":"&lt;p&gt;Hi Nicole! congratulations for wedding and of course you choose destination wedding. If you choose UK as your wedding destination i must tell you that &lt;span&gt;Nathan J Wyatt&lt;\/span&gt;, &lt;span&gt;Confetti Retail you can contact them or you can visit &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.hotfrog.co.uk\/Products\/Wedding-Destination&#039;&gt;Hotfrog Wedding Destination&lt;\/a&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span&gt;I hope that will be help you out&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1902399,"PostDate":1439431300,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Nicole! congratulations for wedding and of course you choose destination wedding. If you choose UK as your wedding destination i must tell you that <span>Nathan J Wyatt<\/span>, <span>Confetti Retail you can contact them or you can visit <a href='http:\/\/www.hotfrog.co.uk\/Products\/Wedding-Destination' class='bbc_url' title='External link' rel='nofollow external'>Hotfrog Wedding Destination<\/a><\/span><\/p>\n<p><span>I hope that will be help you out<\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><a data-ipb='nomediaparse' href='http:\/\/www.hotfrog.ca\/Products\/Wedding-Planner'>Hotfrog Wedding Planner<\/a>","Email":"jaicolebe@gmail.com","IpAddress":"115.187.59.254","GroupId":39,"GroupName":"Newbie","JoinDate":1439203620,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"jaicolebe","Id":284350,"Name":"jaicolebe","IsOnline":false}}],"Id":"79463","Title":"New Bride","LastPostDate":1439431300},"Pages":{"TotalItems":7,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
