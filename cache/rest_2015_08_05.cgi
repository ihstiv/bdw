cdn\/monthly_05_2015\/post-282430-143121738031.jpg\" class='bbc_img linked-image' alt=\"ImageUploadedByTapatalk1431217375.800328.jpg\" \/><\/a>\n\n<br><br>\nFor the ceremony.<br><br>\n<a class='resized_img' rel='lightbox[1895835]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2015\/post-282430-143121741876.jpg\" title=\"ImageUploadedByTapatalk1431217412.383287.jpg -  327.78KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2015\/post-282430-143121741876.jpg\" class='bbc_img linked-image' alt=\"ImageUploadedByTapatalk1431217412.383287.jpg\" \/><\/a>\n\n<a class='resized_img' rel='lightbox[1895835]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2015\/post-282430-143121745737.jpg\" title=\"ImageUploadedByTapatalk1431217450.385520.jpg -  262.21KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2015\/post-282430-143121745737.jpg\" class='bbc_img linked-image' alt=\"ImageUploadedByTapatalk1431217450.385520.jpg\" \/><\/a>\n\n<br><br>\nFor the reception. [emoji4]<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"izabella.david@gmail.com","IpAddress":"99.237.26.51","GroupId":40,"GroupName":"Jr. Member","JoinDate":1426447978,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282430.jpg?_r=1434377756","PhotoWidth":200,"PhotoHeight":287,"PhotoType":"custom"},"FormattedName":"IzzyDeee","Id":282430,"Name":"IzzyDeee","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.15.187","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78435,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"211e249a96316641e20f634a64e041da","RawContent":"&lt;p&gt;Wow! I could never even hope to walk in anything like that!!&lt;\/p&gt;","Attachments":[],"Id":1895883,"PostDate":1431295080,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Wow! I could never even hope to walk in anything like that!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.138.34.236","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78435,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"f910e2e7a8d3c90dbb2c16516fedc945","RawContent":"I wore them almost all night! Took them off and switched to sandals for the disco since the floors were very slippery [emoji5]\ufe0f\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1895918,"PostDate":1431346823,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I wore them almost all night! Took them off and switched to sandals for the disco since the floors were very slippery [emoji5]\ufe0f<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"izabella.david@gmail.com","IpAddress":"99.237.26.51","GroupId":40,"GroupName":"Jr. Member","JoinDate":1426447978,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282430.jpg?_r=1434377756","PhotoWidth":200,"PhotoHeight":287,"PhotoType":"custom"},"FormattedName":"IzzyDeee","Id":282430,"Name":"IzzyDeee","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.224.109.228","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78435,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":3,"IsLiked":false,"PostKey":"0a52a67be81a318de2c5c6128539bd1e","RawContent":"&lt;p&gt;I decided to go with some flat sandals. &amp;nbsp;This way I will be comfortable and not have to worry taking my shoes off when we are on the beach taking pictures and what not.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;","Attachments":[],"Id":1895951,"PostDate":1431375231,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I decided to go with some flat sandals. \u00a0This way I will be comfortable and not have to worry taking my shoes off when we are on the beach taking pictures and what not.<\/p>\n<p>\u00a0<\/p>\n<p><a class='resized_img' rel='lightbox[1895951]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2015\/post-279720-0-07739000-1431389529.jpg\" title=\"IMG_0144.jpg -  192.54KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2015\/post-279720-0-07739000-1431389529.jpg\" class='bbc_img linked-image' alt=\"IMG_0144.jpg\" \/><\/a>\n\n<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"stimaberry@hotmail.com","IpAddress":"24.212.163.15","GroupId":39,"GroupName":"Newbie","JoinDate":1410080121,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279720.jpg?_r=1412546963","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"GingerBride","Id":279720,"Name":"GingerBride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.41.59","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78435,"EditedBy":"","EditDate":1431378642,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"d85449ea6f414881bd8a9bf5240cdf63","RawContent":"[quote name=\"IzzyDeee\" post=\"1895918\" timestamp=\"1431361223\"]\nI wore them almost all night! Took them off and switched to sandals for the disco since the floors were very slippery [emoji5]\ufe0f\n\n\nSent from my iPhone using Tapatalk[\/quote]Omg off topic funny story. At the disco at our resort a guy had a squeegee essentially on a long stick. His job was to come around and just get the floors cleaned of whatever timely. He would honestly come in between groups who were dancing. But this drunk guy kept spilling his drink and slipping and falling. Honestly he couldn&#039;t get up cause he&#039;d do it again. I shouldn&#039;t laugh as he later was passed out in the chair but was comical to say the least. Poor fella. \n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1895955,"PostDate":1431378610,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>IzzyDeee, on 11 May 2015 - 12:20 PM, said:<\/p><div class='blockquote'><div class='quote'><p>\nI wore them almost all night! Took them off and switched to sandals for the disco since the floors were very slippery [emoji5]\ufe0f<br><br><br>\nSent from my iPhone using Tapatalk<\/p><\/div><\/div>\nOmg off topic funny story. At the disco at our resort a guy had a squeegee essentially on a long stick. His job was to come around and just get the floors cleaned of whatever timely. He would honestly come in between groups who were dancing. But this drunk guy kept spilling his drink and slipping and falling. Honestly he couldn't get up cause he'd do it again. I shouldn't laugh as he later was passed out in the chair but was comical to say the least. Poor fella. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.161.129.93","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78435,"EditedBy":"","EditDate":1431508124,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f2ab3e1de5696eb54278c88d2480f763","RawContent":"&lt;p&gt;These are the shoes I&#039;m going with. I really wanted a medium height wedge, which was hard to find, so ended up going with this one.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;","Attachments":[{"Id":32249,"Name":"Beach sandal.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2015\/post-281357-0-