\/dt\/15\/k\/ae98\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...ae98\/event.png<\/a><\/div><\/div>","Email":"christie_bielaczek@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1218889923,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211218.gif?_r=0","PhotoWidth":100,"PhotoHeight":67,"PhotoType":"custom"},"FormattedName":"Island Princess","Id":211218,"Name":"Island Princess","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d1e2629435be2247cebd707b71fe03c0","RawContent":"Hi Jacilynda,\n \n Did you ever see pics of Dee83 in her TTD from lightinthebox? I have been trying to search for pics.","Attachments":[],"Id":854490,"PostDate":1253574349,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi Jacilynda,<br \/> <br \/> Did you ever see pics of Dee83 in her TTD from lightinthebox? I have been trying to search for pics.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lisa_johnson313@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1253291481,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-221771.gif?_r=0","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"bahamianbride2010","Id":221771,"Name":"bahamianbride2010","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5f76d67768b0b766c07538dbeab5f82c","RawContent":"TY so much for this post! I browse through the forum more than what I get to actually post on it mainly because, well lol! I guess Im a bit shy still! xD.. Since my FI and I are having a formal wedding in PR and another reception in NY(parents just wanted to have the WHOLE family and their mother to celebrate the ocassion &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif\" border=\"0\" alt=\"\" title=\"Cheesy\" class=\"inlineimg\" \/&gt;) I&#039;ve been looking for a way to save on that second dress and have been overwhelmed with so many different contradicting reviews about all these websites.. \n It&#039;s awsome to have honest reviews and pictures to go along with it &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif\" border=\"0\" alt=\"\" title=\"Cheesy\" class=\"inlineimg\" \/&gt;...TY, Again!","Attachments":[],"Id":854728,"PostDate":1253581722,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                TY so much for this post! I browse through the forum more than what I get to actually post on it mainly because, well lol! I guess Im a bit shy still! xD.. Since my FI and I are having a formal wedding in PR and another reception in NY(parents just wanted to have the WHOLE family and their mother to celebrate the ocassion <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif\" border=\"0\" alt=\"\" title=\"Cheesy\" class=\"inlineimg\" \/><\/span>) I've been looking for a way to save on that second dress and have been overwhelmed with so many different contradicting reviews about all these websites.. <br \/> It's awsome to have honest reviews and pictures to go along with it <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif\" border=\"0\" alt=\"\" title=\"Cheesy\" class=\"inlineimg\" \/><\/span>...TY, Again!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kuteliya@gmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1240858098,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-217092.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"**~Linda~**","Id":217092,"Name":"**~Linda~**","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8709c4d2566536e91a3b7ad5dd673fcd","RawContent":"I think i&#039;ll order my TTD from Light in the box...i&#039;m going to get an inexpensive one, and see how that turns out. If it looks good, then i&#039;ll probably go ahead and order my wedding dress from there....you can&#039;t really beat the price....&lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile29.gif\" border=\"0\" alt=\"\" title=\"Smile29\" class=\"inlineimg\" \/&gt;\n \n \n If its not what i want and looks like a choppy job was done, I will DEFINITLEY be buying off the rack :)","Attachments":[],"Id":857573,"PostDate":1253736578,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I think i'll order my TTD from Light in the box...i'm going to get an inexpensive one, and see how that turns out. If it looks good, then i'll probably go ahead and order my wedding dress from there....you can't really beat the price....<span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile29.gif\" border=\"0\" alt=\"\" title=\"Smile29\" class=\"inlineimg\" \/><\/span><br \/> <br \/> <br \/> If its not what i want and looks like a choppy job was done, I will DEFINITLEY be buying off the rack <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"melbc80@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1253391218,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-221800.jpg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"meldal101010","Id":221800,"Name":"meldal101010","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKe