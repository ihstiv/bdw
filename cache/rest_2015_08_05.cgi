\/> <a href='http:\/\/i197.photobucket.com\/albums\/aa240\/carlymcmullen\/BDW%20Photos%20for%20Others\/weddingdress-fotini.jpg' class='bbc_url' title='External link' rel='nofollow external'><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i197.photobucket.com\/albums\/aa240\/carlymcmullen\/BDW%20Photos%20for%20Others\/weddingdress-fotini.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><\/a><br \/> <br \/> -Fo\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10730;105\/st\/20070831\/e\/wedding\/k\/d6df\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...d6df\/event.png<\/a><\/div><\/div>","Email":"fotini.m@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1166385181,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206976.gif?_r=0","PhotoWidth":75,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Fotini","Id":206976,"Name":"Fotini","IsOnline":false}}],"Pages":{"TotalItems":8278,"TotalPages":828,"CurrentPage":20,"NextPage":30,"PreviousPage":10,"LastPage":8270},"PushNotifications":[{"Key":"notifications","Value":5,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
