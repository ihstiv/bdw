attedName":"courtney_b00","Id":218418,"Name":"courtney_b00","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2feb9a9f1796c3d47668b342d3f454fc","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;courtney_b00&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Oh that is awesome! I&#039;m glad your dress worked out perfectly. Do you have their website? Or do I just go to ebay &amp;amp; type in their name?\n Can you post pics please! I woud love to see the final result!&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/stores.shop.ebay.com\/gianinarbridal__W0QQ_armrsZ1\"&gt;eBay Store - gianinarbridal: wedding dress bridalgown, party evening or bridalmaid, flower girl dresses&lt;\/a&gt; \n There you go!","Attachments":[],"Id":899782,"PostDate":1256608899,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>courtney_b00<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Oh that is awesome! I'm glad your dress worked out perfectly. Do you have their website? Or do I just go to ebay & type in their name?<br \/> Can you post pics please! I woud love to see the final result!<\/div> <\/td> <\/tr> <\/table> <\/div><a href='http:\/\/stores.shop.ebay.com\/gianinarbridal__W0QQ_armrsZ1' class='bbc_url' title='External link' rel='nofollow external'>eBay Store - gianinarbridal: wedding dress bridalgown, party evening or bridalmaid, flower girl dresses<\/a> <br \/> There you go!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10748;0\/st\/20100223\/e\/Our+Wedding\/dt\/-2\/k\/67d5\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...67d5\/event.png<\/a><\/div><\/div>","Email":"katie.torley@gmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1232061403,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213991.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"KJT1985","Id":213991,"Name":"KJT1985","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ff26af158f14d00cf71e4bff54c53916","RawContent":"YAY!!!!! My fiance gave me the go ahead to order my dress from Gianinarbridal!!! They quoted me $180 including shipping! AND They only required a $60 non-refundable deposit to start the dress. Once &amp;quot;finished&amp;quot; they send proof pictures so you can decide if you want to go ahead and buy it or want anything changed. I&#039;m ECSTATIC right now!!! This is the dress i&#039;m having them make, but with a corset back. \n &lt;img src=\"http:\/\/i650.photobucket.com\/albums\/uu226\/Beaujo85\/1.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n &lt;img src=\"http:\/\/i650.photobucket.com\/albums\/uu226\/Beaujo85\/2.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n &lt;img src=\"http:\/\/i650.photobucket.com\/albums\/uu226\/Beaujo85\/6.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;","Attachments":[],"Id":900169,"PostDate":1256655147,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                YAY!!!!! My fiance gave me the go ahead to order my dress from Gianinarbridal!!! They quoted me $180 including shipping! AND They only required a $60 non-refundable deposit to start the dress. Once \"finished\" they send proof pictures so you can decide if you want to go ahead and buy it or want anything changed. I'm ECSTATIC right now!!! This is the dress i'm having them make, but with a corset back. <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i650.photobucket.com\/albums\/uu226\/Beaujo85\/1.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i650.photobucket.com\/albums\/uu226\/Beaujo85\/2.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i650.photobucket.com\/albums\/uu226\/Beaujo85\/6.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10748;0\/st\/20100223\/e\/Our+Wedding\/dt\/-2\/k\/67d5\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...67d5\/event.png<\/a><\/div><\/div>","Email":"katie.torley@gmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1232061403,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213991.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"KJT1985","Id":213991,"Name":"KJT1985","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6eacfc42dd53b4a8d6c5ab8b0717c1b5","RawContent":"Congrats on getting to order your dress! That&#039;s awesome they don&#039;t require much to start it. Btw that dress is beautiful.\n How did you go about the whole thing...did you just email them and send pictures of what you wanted and then they quoted the price&lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/huh.gif\" border=\"0\" alt=\"\" title=\"Huh\" class=\"inlineimg\" \/&gt;","Attachments":[],"Id":900261,"PostDate":1256657861,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Congrats on getting to order your dress! That's awesome they don't require much to start it. Btw that dress is beautiful.<br \/> How did you go about the whole thing...did you just email them and send pictures of what you wanted and then they quoted the price<span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/huh.gif\" border=\"0\" alt=\"\" title=\"Huh\" class=\"inlineimg\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i45.photobucket.com\/albums\/f56\/courtney_543\/Untitled-1.gif\">http:\/\/i45.photobucket.com\/albums\/f5...Untitled-1.gif<\/a><\/div><\/div>","Email":"courtney_b00@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1244919266,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-218418.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"courtney_b00","Id":218418,"Name":"courtney_b00","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e1d4baedbd01793058270c83cb1860d1","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;courtney_b00&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Congrats on getting to order your dress! That&#039;s awesome they don&#039;t require much to start it. Btw that dress is beautiful.\n How did you go about the whole thing...did you just email them and send pictures of what you wanted and then they quoted the price&lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/huh.gif\" border=\"0\" alt=\"\" title=\"Huh\" class=\"inlineimg\" \/&gt;&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;Yeah, I had tried on the dress a year ago (where the pictures are from) but its $1200!! I had pretty much given up on it but hadn&#039;t found anything else I liked as much and had tried on about 200 dresses. THEN I found this thread! I contacted a few people to get quotes and got the ok from my fiance to order form them. I just sent them a link to the designers website and asked them what they would charge to make it, how much shipping would be and how long it would take. Here&#039;s the reply I got: \n \n &amp;quot;We can make this dress for you. The dress needs 30- 45 days to make and if you have a rush need, please let us know when you need the dress.\n \n The price for the dress is $120. You can first pay $60 unreturnable deposit. After finish the dress, we will send you several pictures of real item and you can make decision to buy it or not. We cannot promise to make a 100% exact copy, however, we will try our best to make it most similar.\n \n The shipping fee is $59 to usa for international express service (4-5 business days), if you are in other countries, please let us know\n \n If you want to make this dress, please tell us your email address, then we will send you an email to let you know how to pay and which your measurements and other information should provide.&amp;quot;\n \n So as soon as I get the email with how to pay the deposit and measurement information I&#039;ll send in my numbers and also the more detailed pictures. I&#039;m so excited that I actually get to see the real thing before it shows up on my doorstep!! They are awesome so far!","Attachments":[],"Id":900433,"PostDate":1256662827,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>courtney_b00<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Congrats on getting to order your dress! That's awesome they don't require much to start it. Btw that dress is beautiful.<br \/> How did you go about the whole thing...did you just email them and send pictures of what you wanted and then they quoted the price<span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/huh.gif\" border=\"0\" alt=\"\" title=\"Huh\" class=\"inlineimg\" \/><\/span><\/div> <\/td> <\/tr> <\/table> <\/div>Yeah, I had tried on the dress a year ago (where the pictures are from) but its $1200!! I had pretty much given up on it but hadn't found anything else I liked as much and had tried on about 200 dresses. THEN I found this thread! I contacted a few people to get quotes and got the ok from my fiance to order form them. I just sent them a link to the designers website and asked them what they would charge to make it, how much shipping would be and how long it would take. Here's the reply I got: <br \/> <br \/> \"We can make this dress for you. The dress needs 30- 45 days to make and if you have a rush need, please let us know when you need the dress.<br \/> <br \/> The price for the dress is $120. You can first pay $60 unreturnable deposit. After finish the dress, we will send you several pictures of real item and you can make decision to buy it or not. We cannot promise to make a 100% exact copy, however, we will try our best to make it most similar.<br \/> <br \/> The shipping fee is $59 to usa for international express service (4-5 business days), if you are in other countries, please let us know<br \/> <br \/> If you want to make this dress, please tell us your email address, then we will send you an email to let you know how to pay and which your measurements and other information should provide.\"<br \/> <br \/> So as soon as I get the email with how to pay the deposit and measurement information I'll send in my numbers and also the more detailed pictures. I'm so excited that I actually get to see the real thing before it shows up on my doorstep!! They are awesome so far!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10748;0\/st\/20100223\/e\/Our+Wedding\/dt\/-2\/k\/67d5\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...67d5\/event.png<\/a><\/div><\/div>","Email":"katie.torley@gmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1232061403,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213991.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"KJT1985","Id":213991,"Name":"KJT1985","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"01acaf2abb2700268bcf2cf97a3a2de7","RawContent":"You ladies are brave. I am such a control freak. I want to see and try dresses and know exactly what I&#039;m getting. I admire you all.","Attachments":[],"Id":901958,"PostDate":1256742830,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                You ladies are brave. I am such a control freak. I want to see and try dresses and know exactly what I'm getting. I admire you all.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"aobassey@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1248790756,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-219919.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"affiwin","Id":219919,"Name":"affiwin","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"16f9b3260ea912735c3e95189ae6631f","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;affiwin&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;You ladies are brave. I am such a control freak. I want to see and try dresses and know exactly what I&#039;m getting. I admire you all.&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;Agreed! I&#039;ve been looking for like 5 months so far with no follow through as of yet!\n \n Especially since what looks best on me is the last thing I imagined so now I&#039;m especially weary!","Attachments":[],"Id":901990,"PostDate":1256743684,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>affiwin<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">You ladies are brave. I am such a control freak. I want to see and try dresses and know exactly what I'm getting. I admire you all.<\/div> <\/td> <\/tr> <\/table> <\/div>Agreed! I've been looking for like 5 months so far with no follow through as of yet!<br \/> <br \/> Especially since what looks best on me is the last thing I imagined so now I'm especially weary!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>~ Mmm cupcakes ~<\/span><br \/>\n<span>[url=<\/span><a data-ipb='nomediaparse' href=\"http:\/\/www.TickerFactory.com\/%5D\">http:\/\/www.TickerFactory.com\/]<\/a><br \/>\n<a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;32;2\/st\/20100919\/e\/Our+Italian+Family+Recept\/dt\/-3\/k\/79dd\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...79dd\/event.png<\/a><\/div><\/div>","Email":"johnnygirl777@yahoo.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1219259160,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211300.jpg?_r=0","PhotoWidth":200,"PhotoHeight":278,"PhotoType":"custom"},"FormattedName":"KittenHeart","Id":211300,"Name":"KittenHeart","IsOnline":false}}],"Pages":{"TotalItems":6400,"TotalPages":640,"CurrentPage":240,"NextPage":250,"PreviousPage":230,"LastPage":6390},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
