Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":3,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":1188,"MovedTo":null,"MovedOn":0,"FirstPostId":1555217,"Rating":0,"RatingHits":0,"Starter":{"Id":229224,"Name":"mpeter81","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-229224.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":216,"PhotoType":"custom"},"IsOnline":false},"StartDate":1323384098,"LastPoster":{"Id":272798,"Name":"liz24","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272798.jpg?_r=1391090044","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":118,"Preview":{"Id":1830524,"PostDate":1391187186,"PostContent":"your dress is gorgeous  Congrats!!!","Author":{"Signature":"","Email":"liz_hund@hotmail.com","IpAddress":"108.246.64.107","GroupId":40,"GroupName":"Jr. Member","JoinDate":1377111906,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272798.jpg?_r=1391090044","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"liz24","Id":272798,"Name":"liz24","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":64790,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"38666aed972260391968b9766ee9f1ed","RawContent":"&lt;p&gt; Had our wedding at Dreams and it was amazing!!&amp;nbsp; One tip I especially want to put out there is about the Gazebo.&amp;nbsp; When you walk down the aisle and into the Gazebo, make sure you&#039;re standing in the Gazebo where you can see the guests over your soon-to-be-hubby&#039;s shoulder.&amp;nbsp; And make sure your hubby does the same.&amp;nbsp; If you can&#039;t see a good chunk of the people becuase&amp;nbsp;of a pillar, they can&#039;t see you.&amp;nbsp; I wasn&#039;t thinking clearly about that and it turned out my Mom couldn&#039;t see us at all during the ceremony b\/c of the pillar.&amp;nbsp; : \/  &lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; And the other thing, if you&#039;re planning to use a runner, the walkway distance is only&amp;nbsp;14 feet.&amp;nbsp; To get to the walkway you walk through El Patio restuarant, but the walkway up to the Gazebo itself where you&#039;d have your runner is only 14 feet long.&amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Happy planning ladies!!&amp;nbsp; : )&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1555217,"PostDate":1323384098,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Had our wedding at Dreams and it was amazing!!\u00a0 One tip I especially want to put out there is about the Gazebo.\u00a0 When you walk down the aisle and into the Gazebo, make sure you're standing in the Gazebo where you can see the guests over your soon-to-be-hubby's shoulder.\u00a0 And make sure your hubby does the same.\u00a0 If you can't see a good chunk of the people becuase\u00a0of a pillar, they can't see you.\u00a0 I wasn't thinking clearly about that and it turned out my Mom couldn't see us at all during the ceremony b\/c of the pillar.\u00a0 : \/\u00a0\u00a0<\/p> <p> \u00a0<\/p> <p> And the other thing, if you're planning to use a runner, the walkway distance is only\u00a014 feet.\u00a0 To get to the walkway you walk through El Patio restuarant, but the walkway up to the Gazebo itself where you'd have your runner is only 14 feet long.\u00a0<\/p> <p> \u00a0<\/p> <p> Happy planning ladies!!\u00a0 : )<\/p> <p> \u00a0<\/p> <p> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mpeterspm@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1276667966,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-229224.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":216,"PhotoType":"custom"},"FormattedName":"mpeter81","Id":229224,"Name":"mpeter81","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":64790,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a75edd99a56dce0a970830c15c797f37","RawContent":"&lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"gazebo.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/607615\/width\/525\/height\/700\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"Gazebo Walkway.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/607617\/width\/600\/height\/450\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"Groom in Gazebo.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/607619\/width\/600\/height\/450\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"WD100_0645.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/607621\/width\/600\/height\/450\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; If we had been more toward the center of the gazebo, closer to Rev. Marco, I would&#039;ve been able to see all of the guests on my groom&#039;s side and vice versa... but I didn&#039;t think about that at the time, lol.&amp;nbsp; ; )&lt;\/p&gt;","Attachments":[],"Id":1555228,"PostDate":1323386121,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"gazebo.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/607615\/width\/525\/height\/700\" \/><\/span><\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"Gazebo Walkway.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/607617\/width\/600\/height\/450\" \/><\/span><\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"Groom in Gazebo.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/607619\/width\/600\/height\/450\" \/><\/span><\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"WD100_0645.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/607621\/width\/600\/height\/450\" \/><\/span><\/p> <p> \u00a0<\/p> <p> If we had been more toward the center of the gazebo, closer to Rev. Marco, I would've been able to see all of the guests on my groom's side and vice versa... but I didn't think about that at the time, lol.\u00a0 ; )<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mpeterspm@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1276667966,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-229224.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":216,"PhotoType":"custom"},"FormattedName":"mpeter81","Id":229224,"Name":"mpeter81","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.246.64.107","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":64790,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"eb55a11544c6cdd27e971cb27d52f3cc","RawContent":"&lt;p&gt;your dress is gorgeous :)&lt;\/p&gt;\n&lt;p&gt;Congrats!!!&lt;\/p&gt;","Attachments":[],"Id":1830524,"PostDate":1391187186,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>your dress is gorgeous <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>Congrats!!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"liz_hund@hotmail.com","IpAddress":"108.246.64.107","GroupId":40,"GroupName":"Jr. Member","JoinDate":1377111906,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272798.jpg?_r=1391090044","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"liz24","Id":272798,"Name":"liz24","IsOnline":false}}],"Id":"64790","Title":"Helpful tips for ceremony in the Gazebo","LastPostDate":1391187186},"Pages":{"TotalItems":3,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","