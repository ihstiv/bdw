{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":69,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":8232,"MovedTo":null,"MovedOn":0,"FirstPostId":1540412,"Rating":0,"RatingHits":0,"Starter":{"Id":206696,"Name":"TammyWright","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"IsOnline":false},"StartDate":1319904738,"LastPoster":{"Id":262321,"Name":"andiegarcia","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-262321.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":118,"Preview":{"Id":1854570,"PostDate":1402420464,"PostContent":"Did anyone tip the servers\/staff other than the WC at Dreams?\u00a0 Just curious as to how much we sho...","Author":{"Signature":"","Email":"andiengarcia@gmail.com","IpAddress":"75.140.67.22","GroupId":39,"GroupName":"Newbie","JoinDate":1352780411,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-262321.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"andiegarcia","Id":262321,"Name":"andiegarcia","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":64254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"052919e1ccd5389dcbb873866b4bf19d","RawContent":"&lt;p&gt; Who&#039;s getting married at dreams los cabos?&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I am a past Dreams Los Cabos bride and have helped hundreds of other Dreams Los Cabos brides.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Hopefully I can help answer some of your questions.&lt;\/p&gt;","Attachments":[],"Id":1540412,"PostDate":1319904738,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Who's getting married at dreams los cabos?<\/p> <p> \u00a0<\/p> <p> I am a past Dreams Los Cabos bride and have helped hundreds of other Dreams Los Cabos brides.<\/p> <p> \u00a0<\/p> <p> Hopefully I can help answer some of your questions.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-family:arial, helvetica, sans-serif;\">Founder and Owner of BestDestinationWedding.com \u00a0\/ \u00a0<\/span><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/'><strong><span style=\"font-family:arial, helvetica, sans-serif;\">Bride & Groom Fly FREE Promotion<\/span><\/strong><\/a><\/p>\n<p>\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><strong><a data-ipb='nomediaparse' href='http:\/\/wrighttravelagency.com\/inquiry\/'><span style=\"color:#008080;\">Looking for a travel agency that specializes in Destination Weddings<\/span><\/a><\/strong><span style=\"color:#008080;\"><strong>?<\/strong> \u00a0We are an award winning travel agency and you can <\/span><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style=\"color:#008080;\">read our reviews\u00a0here.<\/span><\/a><\/strong><\/span><br>\n\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"color:#008080;\"><strong>Awards and recognition:\u00a0<\/strong><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Palace Resorts Winner \"Top Travel Agent\", \"Top Homebased Travel Agency\" PRO Platinum Agency (Top Award) \u00a0 \u00a0 | \u00a0 \u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">AMResorts Master Agent & Top Agency \u00a0<\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/68050-karisma-hotels-givc-and-gi-wedding-consultants-wright-travel-agency\/'><strong>Wright Travel & Karisma GIVC Benefits<\/strong><\/a><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Travel Impressions Best of the Best Globe Winner \u00a0 \u00a0| \u00a0 \u00a0\u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Apple Vacations Golden Apple Winner \u00a0<\/span><\/span><br><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"> \u00a0 \u00a0<img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"font-size:14px;\"><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010'>Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><\/span><\/span><strong><span style=\"color:#b22222;\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a data-ipb='nomediaparse' href='mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com'>ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"admin@bestdestinationwedding.com","IpAddress":"71.202.225.11","GroupId":4,"GroupName":"Administrators","JoinDate":1137224220,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"FormattedName":"TammyWright","Id":206696,"Name":"TammyWright","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":64254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"950bef1ee1831704b76c2cdb5f28c918","RawContent":"&lt;p&gt; I am interested!! I don&#039;t know where to possibly start.&lt;\/p&gt;","Attachments":[],"Id":1542352,"PostDate":1320288407,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I am interested!! I don't know where to possibly start.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mpipes01@shepherd.edu","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1320283001,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-247328.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":101,"PhotoType":"custom"},"FormattedName":"mpipes01","Id":247328,"Name":"mpipes01","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":64254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f0a0b9a3445d6243f12e97f903e1a8fc","RawContent":"&lt;p&gt; any questions? &amp;nbsp;if so start a thread and maybe we can help.&lt;\/p&gt;","Attachments":[],"Id":1542661,"PostDate":1320347399,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> any questions? \u00a0if so start a thread and maybe we can help.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-family:arial, helvetica, sans-serif;\">Founder and Owner of BestDestinationWedding.com \u00a0\/ \u00a0<\/span><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/'><strong><span style=\"font-family:arial, helvetica, sans-serif;\">Bride & Groom Fly FREE Promotion<\/span><\/strong><\/a><\/p>\n<p>\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><strong><a data-ipb='nomediaparse' href='http:\/\/wrighttravelagency.com\/inquiry\/'><span style=\"color:#008080;\">Looking for a travel agency that specializes in Destination Weddings<\/span><\/a><\/strong><span style=\"color:#008080;\"><strong>?<\/strong> \u00a0We are an award winning travel agency and you can <\/span><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style=\"color:#008080;\">read our reviews\u00a0here.<\/span><\/a><\/strong><\/span><br>\n\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"color:#008080;\"><strong>Awards and recognition:\u00a0<\/strong><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Palace Resorts Winner \"Top Travel Agent\", \"Top Homebased Travel Agency\" PRO Platinum Agency (Top Award) \u00a0 \u00a0 | \u00a0 \u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">AMResorts Master Agent & Top Agency \u00a0<\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/68050-karisma-hotels-givc-and-gi-wedding-consultants-wright-travel-agency\/'><strong>Wright Travel & Karisma GIVC Benefits<\/strong><\/a><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Travel Impressions Best of the Best Globe Winner \u00a0 \u00a0| \u00a0 \u00a0\u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Apple Vacations Golden Apple Winner \u00a0<\/span><\/span><br><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"> \u00a0 \u00a0<img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"font-size:14px;\"><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010'>Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><\/span><\/span><strong><span style=\"color:#b22222;\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a data-ipb='nomediaparse' href='mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com'>ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"admin@bestdestinationwedding.com","IpAddress":"71.202.225.11","GroupId":4,"GroupName":"Administrators","JoinDate":1137224220,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"FormattedName":"TammyWright","Id":206696,"Name":"TammyWright","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":64254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2d8303541093a9c1cfd8c271182b3a8c","RawContent":"&lt;p&gt; Hello,&lt;\/p&gt; &lt;p&gt; Im in the process of planning a wedding at dreams but dont know where to start...&lt;\/p&gt; &lt;p&gt; I am getting in touch with a travel agent to see what rates we can get for flights and hotel. Is this the best way to go?&lt;\/p&gt; &lt;p&gt; Also, I have emailed Dreams to get information about pricing\/packages offered etc, but no one is getting back to me. Is there someone in particular i should call or email.&lt;\/p&gt; &lt;p&gt; Please let me know.&lt;\/p&gt;","Attachments":[],"Id":1546187,"PostDate":1321241222,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hello,<\/p> <p> Im in the process of planning a wedding at dreams but dont know where to start...<\/p> <p> I am getting in touch with a travel agent to see what rates we can get for flights and hotel. Is this the best way to go?<\/p> <p> Also, I have emailed Dreams to get information about pricing\/packages offered etc, but no one is getting back to me. Is there someone in particular i should call or email.<\/p> <p> Please let me know.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lidija.dujmenovic@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1320978860,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-247559.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"MittensDW","Id":247559,"Name":"MittensDW","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":64254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3e8c3e8ae8c667a663659e80a39b72d4","RawContent":"&lt;p&gt; I&#039;m getting married in 2 months! January 14th, 2012! Any other January brides?&amp;nbsp; We have about 65-70 guests coming to our wedding.&amp;nbsp; We decided to get married at the gazebo and have our reception on the cascade terrace. I have finished most of the big details, but still need to work out some things regarding escort cards, music and the food.&amp;nbsp; I&#039;d be interested in hearing if anyone has had the buffet at their wedding before. We were thinking of doing the BBQ buffet so if anyone has a review on that I&#039;d love some feedback. Also has anyone used the The Mexican Trio (Los Mosquitos) before? One set came with our package and I plan on using them for our ceremony and possibly extending them for the cocktail hour. Lastly, if anyone has advice on the BEST excursions I&#039;d love to hear about it. I was considering doing a kayak\/snorkel tour, or whale watching.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Advice For Future Brides:&lt;\/p&gt; &lt;p&gt; I have had a lot of issues with the coordinator (Magda). She is really very sweet, and when she does respond she is very helpful, but her responses are very limited and far and few between.&amp;nbsp; I know she is super busy (I believe she does a wedding every day), so I have tried to give her some time, but now that I am only 2 months away from the big day it&#039;s been quite frustrating.&amp;nbsp; Any new brides, just be prepared for the slow communication.&amp;nbsp; I have learned to not stress over it, but I have also read that once you are in Cabo, she is super helpful.&amp;nbsp; Just prepared to figure out some things on your own!&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I chose to use a travel agent and get the group rate through the resort.&amp;nbsp; About half of my guests chose to use the travel agent (which they were very happy with) and the other half booked through the resort.&amp;nbsp; I believe using an agent will save you a lot of stress and money.&amp;nbsp; Most of the people who booked through Dreams did so because they have mileage for their flights.&amp;nbsp; If I could go back and just pick one way for guest booking I would def. say the travel agent is the way to go as it takes a lot of work off your hands!&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; The only other thing I can say added stress to me so far is a lot of the DIY projects I took on. But I like saving money and creating my own stuff, so it&#039;s my own fault! :)&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Good luck to the girls who are just beginning the process.... I know it can be confusing and stressful! I&#039;ll post my review in a few months when i get back!&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1546801,"PostDate":1321372013,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I'm getting married in 2 months! January 14th, 2012! Any other January brides?\u00a0 We have about 65-70 guests coming to our wedding.\u00a0 We decided to get married at the gazebo and have our reception on the cascade terrace. I have finished most of the big details, but still need to work out some things regarding escort cards, music and the food.\u00a0 I'd be interested in hearing if anyone has had the buffet at their wedding before. We were thinking of doing the BBQ buffet so if anyone has a review on that I'd love some feedback. Also has anyone used the The Mexican Trio (Los Mosquitos) before? One set came with our package and I plan on using them for our ceremony and possibly extending them for the cocktail hour. Lastly, if anyone has advice on the BEST excursions I'd love to hear about it. I was considering doing a kayak\/snorkel tour, or whale watching.<\/p> <p> \u00a0<\/p> <p> Advice For Future Brides:<\/p> <p> I have had a lot of issues with the coordinator (Magda). She is really very sweet, and when she does respond she is very helpful, but her responses are very limited and far and few between.\u00a0 I know she is super busy (I believe she does a wedding every day), so I have tried to give her some time, but now that I am only 2 months away from the big day it's been quite frustrating.\u00a0 Any new brides, just be prepared for the slow communication.\u00a0 I have learned to not stress over it, but I have also read that once you are in Cabo, she is super helpful.\u00a0 Just prepared to figure out some things on your own!<\/p> <p> \u00a0<\/p> <p> I chose to use a travel agent and get the group rate through the resort.\u00a0 About half of my guests chose to use the travel agent (which they were very happy with) and the other half booked through the resort.\u00a0 I believe using an agent will save you a lot of stress and money.\u00a0 Most of the people who booked through Dreams did so because they have mileage for their flights.\u00a0 If I could go back and just pick one way for guest booking I would def. say the travel agent is the way to go as it takes a lot of work off your hands!<\/p> <p> \u00a0<\/p> <p> The only other thing I can say added stress to me so far is a lot of the DIY projects I took on. But I like saving money and creating my own stuff, so it's my own fault! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p> <p> \u00a0<\/p> <p> Good luck to the girls who are just beginning the process.... I know it can be confusing and stressful! I'll post my review in a few months when i get back!<\/p> <p> \u00a0<\/p> <p> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"shawnaflorida@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1304367847,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-239559.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":146,"PhotoType":"custom"},"FormattedName":"shawnarochelle","Id":239559,"Name":"shawnarochelle","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":64254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a5f809692dd05c67778e528ff3c128c9","RawContent":"&lt;p&gt; Shawna,&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; For decor, are you doing that yourself or did you outsource for decor and flowers. Aside from the bouquet in the large package, what else are you getting? I am just starting to plan, ours is May 4 2012. :)&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Megan&lt;\/p&gt;","Attachments":[],"Id":1546998,"PostDate":1321391577,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Shawna,<\/p> <p> \u00a0<\/p> <p> For decor, are you doing that yourself or did you outsource for decor and flowers. Aside from the bouquet in the large package, what else are you getting? I am just starting to plan, ours is May 4 2012. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p> <p> \u00a0<\/p> <p> Megan<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"megansmall@mac.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1320721963,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-247473.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"megansmall","Id":247473,"Name":"megansmall","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":64254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0465cdb014321672ec9db114ef68f6d5","RawContent":"&lt;p&gt; Shawna,&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; For decor, are you doing that yourself or did you outsource for decor and flowers. Aside from the bouquet in the large package, what else are you getting? I am just starting to plan, ours is May 4 2012. :)&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Megan&lt;\/p&gt;","Attachments":[],"Id":1546999,"PostDate":1321391611,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Shawna,<\/p> <p> \u00a0<\/p> <p> For decor, are you doing that yourself or did you outsource for decor and flowers. Aside from the bouquet in the large package, what else are you getting? I am just starting to plan, ours is May 4 2012. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p> <p> \u00a0<\/p> <p> Megan<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"megansmall@mac.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1320721963,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-247473.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"megansmall","Id":247473,"Name":"megansmall","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":64254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"904c631cc6cd9bab7582cdbb450815a0","RawContent":"&lt;p&gt; Megan,&lt;\/p&gt; &lt;p&gt; For the centerpieces I am bringing my own table lanterns (with votives)&amp;nbsp;which I bought on a wholesale website (&lt;img alt=\"photo(1).JPG\" height=\"540\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/590886\/width\/525\/height\/700\" style=\"width: 167px; height: 224px\" width=\"377\" \/&gt;&lt;img alt=\"tablenumberJPG\" height=\"445\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/590884\/width\/600\/height\/600\" style=\"width: 179px; height: 223px\" width=\"364\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; For the rest of decor I am using the recommended floral vendor through dreams (Florenta i believe) - I am getting a few bags of rose petals and 4 kissing balls for the ceremony. (And of course the bridesmaid bouquets). I am paying the resort to set up the lighting- the hanging lanterns\/string lights. I decided to keep the decor pretty simple, mostly out of frutration with the price. :)&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Have you made any progress on your planning yet? I know the beginning is super crazy!&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1547042,"PostDate":1321394909,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Megan,<\/p> <p> For the centerpieces I am bringing my own table lanterns (with votives)\u00a0which I bought on a wholesale website (<span rel='lightbox'><img class='bbc_img' alt=\"photo(1).JPG\" height=\"540\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/590886\/width\/525\/height\/700\" style=\"width: 167px; height: 224px\" width=\"377\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\"tablenumberJPG\" height=\"445\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/590884\/width\/600\/height\/600\" style=\"width: 179px; height: 223px\" width=\"364\" \/><\/span><\/p> <p> \u00a0<\/p> <p> For the rest of decor I am using the recommended floral vendor through dreams (Florenta i believe) - I am getting a few bags of rose petals and 4 kissing balls for the ceremony. (And of course the bridesmaid bouquets). I am paying the resort to set up the lighting- the hanging lanterns\/string lights. I decided to keep the decor pretty simple, mostly out of frutration with the price. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p> <p> \u00a0<\/p> <p> Have you made any progress on your planning yet? I know the beginning is super crazy!<\/p> <p> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"shawnaflorida@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1304367847,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-239559.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":146,"PhotoType":"custom"},"FormattedName":"shawnarochelle","Id":239559,"Name":"shawnarochelle","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":64254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3013c65fa99b2e1091a53a622e9d8332","RawContent":"&lt;p&gt; &lt;span style=\"font-size: 14px\"&gt;Hello brides,&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 14px\"&gt;I would like to offer our band Cabomax is the best local entertainment choice. Our repertoire includes soft dinner music, Rock &amp;amp; Roll, 70s, Motown, Billboards Hit Music, Beach, Latin Music, Merenge, Salsa, County, and much more, every type of hotel setting and off- site venue in the Los Cabos area be it a ballroom, a beach or a restaurant.&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 14px\"&gt;Audio Visual Company&amp;nbsp;as well&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 14px\"&gt;&lt;img alt=\"twins BANNER 2.jpg\" height=\"508\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/597384\/width\/305\/height\/610\" style=\"width: 165px; height: 301px\" width=\"225\" \/&gt;&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1550208,"PostDate":1322107584,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <span  style=\"font-size: 14px\">Hello brides,<\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 14px\">I would like to offer our band Cabomax is the best local entertainment choice. Our repertoire includes soft dinner music, Rock & Roll, 70s, Motown, Billboards Hit Music, Beach, Latin Music, Merenge, Salsa, County, and much more, every type of hotel setting and off- site venue in the Los Cabos area be it a ballroom, a beach or a restaurant.<\/span><\/p> <p> <span  style=\"font-size: 14px\">Audio Visual Company\u00a0as well<\/span><\/p> <p> <span  style=\"font-size: 14px\"><span rel='lightbox'><img class='bbc_img' alt=\"twins BANNER 2.jpg\" height=\"508\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/597384\/width\/305\/height\/610\" style=\"width: 165px; height: 301px\" width=\"225\" \/><\/span><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"omar@cabomax.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1284317812,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Cabomax","Id":232264,"Name":"Cabomax","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":64254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7a654f0848904a1969ebe5f9e1a74bb0","RawContent":"&lt;p&gt; We are getting married at Dreams Los Cabos in late June, 2012. I&#039;m so excited. I don&#039;t have any questions just yet, but I love hearing all the great ideas everyone has. If I have any questions down the road I will definitely come back here and ask.&lt;\/p&gt;","Attachments":[],"Id":1556750,"PostDate":1323824212,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> We are getting married at Dreams Los Cabos in late June, 2012. I'm so excited. I don't have any questions just yet, but I love hearing all the great ideas everyone has. If I have any questions down the road I will definitely come back here and ask.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"casandrakc@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1318617098,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-246710.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":280,"PhotoType":"custom"},"FormattedName":"Casi","Id":246710,"Name":"Casi","IsOnline":false}}],"Id":"64254","Title":"Dreams Los Cabos bride Roll Call","LastPostDate":1402420464},"Pages":{"TotalItems":69,"TotalPages":7,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":60},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
