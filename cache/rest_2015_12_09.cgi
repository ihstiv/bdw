{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":8,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":1393,"MovedTo":null,"MovedOn":0,"FirstPostId":1815974,"Rating":0,"RatingHits":0,"Starter":{"Id":273900,"Name":"bergon","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-273900.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"StartDate":1384928835,"LastPoster":{"Id":271076,"Name":"hpreece","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-271076.jpg?_r=1420341074","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":38,"Preview":{"Id":1815974,"PostDate":1384928835,"PostContent":"Any suggestions and pricing quotes for rehearsal dinners?? We will have 50-100 people so nothing...","Author":{"Signature":"","Email":"bergon1329@gmail.com","IpAddress":"71.118.48.227","GroupId":39,"GroupName":"Newbie","JoinDate":1380577643,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-273900.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"bergon","Id":273900,"Name":"bergon","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75618,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"697931d8444fa04ca74a44b235c42dd1","RawContent":"Any suggestions and pricing quotes for rehearsal dinners?? We will have 50-100 people so nothing too outrageous! :). Thanks!!","Attachments":[],"Id":1815974,"PostDate":1384928835,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Any suggestions and pricing quotes for rehearsal dinners?? We will have 50-100 people so nothing too outrageous! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>. Thanks!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bergon1329@gmail.com","IpAddress":"71.118.48.227","GroupId":39,"GroupName":"Newbie","JoinDate":1380577643,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-273900.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"bergon","Id":273900,"Name":"bergon","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75618,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"33f25de613974fc2c1d006e2b96a3333","RawContent":"Wow that is a big party!! The price depends on whether you plan to host the dinner at your hotel or somewhere else. I did some research a few weeks ago and when we included the cost for transportation for all our guests invited to the dinner, it turned out to be the same $ (and less hassle) to host it at our hotel. We spent about $30 a person for a salad and entree (no dessert). Plus whatever they drink which in our case an additional $10-$15 pp. Hope the helps!","Attachments":[],"Id":1816009,"PostDate":1384959883,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Wow that is a big party!! The price depends on whether you plan to host the dinner at your hotel or somewhere else. I did some research a few weeks ago and when we included the cost for transportation for all our guests invited to the dinner, it turned out to be the same $ (and less hassle) to host it at our hotel. We spent about $30 a person for a salad and entree (no dessert). Plus whatever they drink which in our case an additional $10-$15 pp. Hope the helps!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Susie_d_gonzalez@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1382065143,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-274349.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Nov2013cabowed","Id":274349,"Name":"Nov2013cabowed","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75618,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"dc466cc4e6a1affd7f31f1c6b6b2f26e","RawContent":"Thanks!! Where did you have it?","Attachments":[],"Id":1816944,"PostDate":1385431267,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks!! Where did you have it?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bergon1329@gmail.com","IpAddress":"71.118.48.227","GroupId":39,"GroupName":"Newbie","JoinDate":1380577643,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-273900.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"bergon","Id":273900,"Name":"bergon","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75618,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"31d5fce9e0455d0d87077d813e3bc41e","RawContent":"We are checking out hacienda Cocina y cantina and Baja Cantina, but they are both in the heart of downtown cabo San Lucas. Where is your wedding going to be?","Attachments":[],"Id":1816990,"PostDate":1385450544,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We are checking out hacienda Cocina y cantina and Baja Cantina, but they are both in the heart of downtown cabo San Lucas. Where is your wedding going to be?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"flo628@yahoo.com","IpAddress":"64.125.69.170","GroupId":40,"GroupName":"Jr. Member","JoinDate":1365917751,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268552.jpg?_r=1404176317","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"flo628","Id":268552,"Name":"flo628","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"162.238.130.192","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75618,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b10a98ade5552c37e67ee31445556562","RawContent":"&lt;p&gt;We are having ours at Romeo y Julieta in downtown Cabo. &amp;nbsp;It is an Italian restaurant (I know...crazy to be having Italian food in Mexico), but the food is good, the inside of the restaurant is really cute, and the prices are reasonable. &amp;nbsp;We also thought that everyone is probably going to be eating Mexican food for every other meal so why not Italian one night? &amp;nbsp;We are also having everyone that is attending the wedding to attend the rehearsal so we wanted something rather cheap. &amp;nbsp;They have several different options on their group menu; we are&amp;nbsp;going to do Caesar salad, lasagna, and dessert for $19\/person. &amp;nbsp;Also, you will have a really cool fire show at your table if you order their Mexican hot chocolate. :)&lt;\/p&gt;","Attachments":[],"Id":1820068,"PostDate":1387671027,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>We are having ours at Romeo y Julieta in downtown Cabo. \u00a0It is an Italian restaurant (I know...crazy to be having Italian food in Mexico), but the food is good, the inside of the restaurant is really cute, and the prices are reasonable. \u00a0We also thought that everyone is probably going to be eating Mexican food for every other meal so why not Italian one night? \u00a0We are also having everyone that is attending the wedding to attend the rehearsal so we wanted something rather cheap. \u00a0They have several different options on their group menu; we are\u00a0going to do Caesar salad, lasagna, and dessert for $19\/person. \u00a0Also, you will have a really cool fire show at your table if you order their Mexican hot chocolate. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"h_preece@yahoo.com","IpAddress":"162.238.130.192","GroupId":39,"GroupName":"Newbie","JoinDate":1372645672,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-271076.jpg?_r=1420341074","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"hpreece","Id":271076,"Name":"hpreece","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.128.217.55","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75618,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"94a82620a97bd6bb9b995f8c4fc8e2cf","RawContent":"&lt;p&gt;We booked at the Baja Brewery on the rooftoop of Cabo Villas Beach Resort. &amp;nbsp;The majority of our guests are staying there (getting married at Casa Dorada next door, but I own a timeshare at CVBR so the rates were much better). &amp;nbsp;There is also a Baja Brewery restaurant in the marina downtown. &amp;nbsp;We are doing a taco fiesta buffet for $26\/person. &amp;nbsp;We are not paying for an open bar ($12\/person\/hr) but we may pay for one drink for everyone on a tab. &amp;nbsp;The dessert includes a root beer float (root beer from the brewery) so we may just let that be the drink :)&lt;\/p&gt;","Attachments":[],"Id":1820214,"PostDate":1387829244,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>We booked at the Baja Brewery on the rooftoop of Cabo Villas Beach Resort. \u00a0The majority of our guests are staying there (getting married at Casa Dorada next door, but I own a timeshare at CVBR so the rates were much better). \u00a0There is also a Baja Brewery restaurant in the marina downtown. \u00a0We are doing a taco fiesta buffet for $26\/person. \u00a0We are not paying for an open bar ($12\/person\/hr) but we may pay for one drink for everyone on a tab. \u00a0The dessert includes a root beer float (root beer from the brewery) so we may just let that be the drink <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"toribelle31@hotmail.com","IpAddress":"66.128.217.55","GroupId":39,"GroupName":"Newbie","JoinDate":1365695886,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268446.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"toribelle31","Id":268446,"Name":"toribelle31","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"162.235.222.34","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75618,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5cae6bb74aa2092006ebd7d1d96023bd","RawContent":"&lt;p&gt;@[member=\"hpreece\"] I am looking to get married at Casa Dorada and have my guests stay at Cabo Villas as well.&amp;nbsp;\n\n\nHow did your wedding turn out? Would you recommend Casa Dorada to someone? I understand that Cabo Villas does weddings too. Was that ever an option when you were doing your searching?&amp;nbsp;\n\n\nAny advice would be appreciated! :)&amp;nbsp;\n\n\nThank you,&lt;\/p&gt;\n&lt;p&gt;Ashleigh&lt;\/p&gt;","Attachments":[],"Id":1889299,"PostDate":1426436611,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"271076\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/271076-hpreece\/' title='Member profile'><span itemprop=\"name\">hpreece<\/span><\/a> I am looking to get married at Casa Dorada and have my guests stay at Cabo Villas as well.\u00a0<br><br>\nHow did your wedding turn out? Would you recommend Casa Dorada to someone? I understand that Cabo Villas does weddings too. Was that ever an option when you were doing your searching?\u00a0<br><br>\nAny advice would be appreciated! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0<br><br>\nThank you,<\/p>\n<p>Ashleigh<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ash.m.berry@gmail.com","IpAddress":"70.167.7.154","GroupId":39,"GroupName":"Newbie","JoinDate":1426023118,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282383.jpg?_r=1436828369","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"AshBerry","Id":282383,"Name":"AshBerry","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"76.93.129.28","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75618,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"45c37e3c35ec183ff5b9b59c87b97f70","RawContent":"&lt;p&gt;Hi @[member=\"AshBerry\"],&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Our wedding went wonderfully! I was very happy with how everything turned out. &amp;nbsp;I got married at Hacienda Cocina y Cantina at the Hacienda Beach Club and we stayed at Pueblo Bonito Blanco.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;ve stayed at Casa Dorada before and it was really pretty, but I&#039;m not quite sure how the weddings work. &amp;nbsp;One thing I liked about Hacienda over Casa Dorada when researching is that Hacienda has a private beach and Casa Dorada does not. &amp;nbsp;This keeps the vendors away and there is not as many people walking by. &amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I don&#039;t remember if I had emailed Cabo Villas or not. &amp;nbsp;I deleted all my emails. Sorry! :(&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Let me know if you need anything else.&amp;nbsp; :)&lt;\/p&gt;","Attachments":[],"Id":1891523,"PostDate":1427856677,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi @<a hovercard-ref=\"member\" hovercard-id=\"282383\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/282383-ashberry\/' title='Member profile'><span itemprop=\"name\">AshBerry<\/span><\/a>,<\/p>\n<p>\u00a0<\/p>\n<p>Our wedding went wonderfully! I was very happy with how everything turned out. \u00a0I got married at Hacienda Cocina y Cantina at the Hacienda Beach Club and we stayed at Pueblo Bonito Blanco.<\/p>\n<p>\u00a0<\/p>\n<p>I've stayed at Casa Dorada before and it was really pretty, but I'm not quite sure how the weddings work. \u00a0One thing I liked about Hacienda over Casa Dorada when researching is that Hacienda has a private beach and Casa Dorada does not. \u00a0This keeps the vendors away and there is not as many people walking by. \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I don't remember if I had emailed Cabo Villas or not. \u00a0I deleted all my emails. Sorry! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/sad.png' class='bbc_emoticon' alt=':(' \/><\/p>\n<p>\u00a0<\/p>\n<p>Let me know if you need anything else.\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"h_preece@yahoo.com","IpAddress":"162.238.130.192","GroupId":39,"GroupName":"Newbie","JoinDate":1372645672,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-271076.jpg?_r=1420341074","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"hpreece","Id":271076,"Name":"hpreece","IsOnline":false}}],"Id":"75618","Title":"Rehearsal dinner","LastPostDate":1427856677},"Pages":{"TotalItems":8,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
