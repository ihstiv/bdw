{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":4,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":720,"MovedTo":null,"MovedOn":0,"FirstPostId":1898947,"Rating":0,"RatingHits":0,"Starter":{"Id":283625,"Name":"rebecca2122","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1434839574,"LastPoster":{"Id":277037,"Name":"Dimps","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277037.jpg?_r=1435766133","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":38,"Preview":{"Id":1898947,"PostDate":1434839574,"PostContent":"Hi: \u00a0 My fiance and I got engaged in October and we are planning a July 2016 destination wedding....","Author":{"Signature":"","Email":"becky2285@aol.com","IpAddress":"104.162.221.122","GroupId":39,"GroupName":"Newbie","JoinDate":1434837981,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"rebecca2122","Id":283625,"Name":"rebecca2122","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"104.162.221.122","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79298,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"517122c9225d694c5b2546d480ff6d41","RawContent":"&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;Hi:&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;My fiance and I got engaged in October and we are planning a July 2016 destination wedding. &amp;nbsp;I am new to this and have no experience with event planning, let alone destination planning. &amp;nbsp;My primary concern is finding a venue. &amp;nbsp;We are planning on having approximately 30 guests and I would greatly appreciate any suggestions. &amp;nbsp;Below is what I&#039;m looking for:&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;- anywhere in Mexico or the Carribbean (in reasonable distance from both NY and CA)&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;- small, boutique resort with 100 rooms or less&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;- non-touristy location (I&#039;m not interested in hotels located among strips of other hotels)&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;- beach-front hotel&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;- preferably with villas for some guests (i.e., beachfront standalone villa with direct access to the beach from the room)&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;Any suggestions greatly appreciated.&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;My secondary concern is finding a travel agent. &amp;nbsp;I&#039;ve read that I should have all guests book through one travel agent. &amp;nbsp;But, I have no idea how to find one or where to even begin my search. &amp;nbsp;I am in NYC, if that matters. &amp;nbsp;Again, any suggestions or places to start are most welcome.&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;Thanks everyone.&lt;\/p&gt;","Attachments":[],"Id":1898947,"PostDate":1434839574,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">Hi:<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">My fiance and I got engaged in October and we are planning a July 2016 destination wedding. \u00a0I am new to this and have no experience with event planning, let alone destination planning. \u00a0My primary concern is finding a venue. \u00a0We are planning on having approximately 30 guests and I would greatly appreciate any suggestions. \u00a0Below is what I'm looking for:<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">- anywhere in Mexico or the Carribbean (in reasonable distance from both NY and CA)<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">- small, boutique resort with 100 rooms or less<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">- non-touristy location (I'm not interested in hotels located among strips of other hotels)<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">- beach-front hotel<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">- preferably with villas for some guests (i.e., beachfront standalone villa with direct access to the beach from the room)<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">Any suggestions greatly appreciated.<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">My secondary concern is finding a travel agent. \u00a0I've read that I should have all guests book through one travel agent. \u00a0But, I have no idea how to find one or where to even begin my search. \u00a0I am in NYC, if that matters. \u00a0Again, any suggestions or places to start are most welcome.<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">Thanks everyone.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"becky2285@aol.com","IpAddress":"104.162.221.122","GroupId":39,"GroupName":"Newbie","JoinDate":1434837981,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"rebecca2122","Id":283625,"Name":"rebecca2122","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.71.15.12","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79298,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"9e50cfeb803b80fdb81816d8a046ba29","RawContent":"Hi congrats and welcome to the forum!  \n\nYou will definitely find a lot of great info on this website, everyone is wonderful!  \n\n\nDefinitely best to start with by finding a travel agent and narrowing down a location.  Finding the resort is hard, for my finance and I took months and went through a couple of agents.  The owners of the site are also travel agents and everyone has said great things about them.  \n\n\nFor what your looking at for type of location\/ boutique type resort you should definitely look into Tulum, Mexico (near Riviera Maya).  There is All sorts of different smaller resorts, not chains and different price ranges.  We are going to a hotel called Nueva Vida de Ramiro in Tulum for our honeymoon and it has lots of different beach huts and villas spread out along the beach, very private and rates range from $105-350\/night depending on type of room.  If I hadn&#039;t already found my resort for my wedding I might&#039;ve chose that one! &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/tulumnv.com\/en\/weddings.html&#039;&gt;http:\/\/tulumnv.com\/en\/weddings.html&lt;\/a&gt;\n\n\n\nGood luck!","Attachments":[],"Id":1899074,"PostDate":1435015437,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi congrats and welcome to the forum!  <br>\nYou will definitely find a lot of great info on this website, everyone is wonderful!  <br><br>\nDefinitely best to start with by finding a travel agent and narrowing down a location.  Finding the resort is hard, for my finance and I took months and went through a couple of agents.  The owners of the site are also travel agents and everyone has said great things about them.  <br><br>\nFor what your looking at for type of location\/ boutique type resort you should definitely look into Tulum, Mexico (near Riviera Maya).  There is All sorts of different smaller resorts, not chains and different price ranges.  We are going to a hotel called Nueva Vida de Ramiro in Tulum for our honeymoon and it has lots of different beach huts and villas spread out along the beach, very private and rates range from $105-350\/night depending on type of room.  If I hadn't already found my resort for my wedding I might've chose that one! <a href='http:\/\/tulumnv.com\/en\/weddings.html' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/tulumnv.com\/en\/weddings.html<\/a><br><br><br>\nGood luck!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#cc6666;\"><span style=\"font-family:georgia, serif;\"><em>Forever can never be long enough for me, to feel like I've had long enough with you...19\/01\/2016<\/em><\/span><\/span>","Email":"kimberlydiana@hotmail.com","IpAddress":"24.76.172.36","GroupId":39,"GroupName":"Newbie","JoinDate":1412304687,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280238.png?_r=1412619945","PhotoWidth":80,"PhotoHeight":60,"PhotoType":"custom"},"FormattedName":"kimmyd2","Id":280238,"Name":"kimmyd2","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.15.187","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79298,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a0ea2086446b270d9666efed90bc31c0","RawContent":"[quote name=\"rebecca2122\" post=\"1898947\" timestamp=\"1434839574\"]\n[color=rgb(40,40,40)][font=arial]\nHi:[\/font][\/color]\n[color=rgb(40,40,40)][font=arial]\nMy fiance and I got engaged in October and we are planning a July 2016 destination wedding.  I am new to this and have no experience with event planning, let alone destination planning.  My primary concern is finding a venue.  We are planning on having approximately 30 guests and I would greatly appreciate any suggestions.  Below is what I&#039;m looking for:[\/font][\/color]\n[color=rgb(40,40,40)][font=arial]\n- anywhere in Mexico or the Carribbean (in reasonable distance from both NY and CA)[\/font][\/color][color=rgb(40,40,40)][font=arial]\n- small, boutique resort with 100 rooms or less[\/font][\/color][color=rgb(40,40,40)][font=arial]\n- non-touristy location (I&#039;m not interested in hotels located among strips of other hotels)[\/font][\/color][color=rgb(40,40,40)][font=arial]\n- beach-front hotel[\/font][\/color][color=rgb(40,40,40)][font=arial]\n- preferably with villas for some guests (i.e., beachfront standalone villa with direct access to the beach from the room)[\/font][\/color]\n[color=rgb(40,40,40)][font=arial]\nAny suggestions greatly appreciated.[\/font][\/color]\n[color=rgb(40,40,40)][font=arial]\nMy secondary concern is finding a travel agent.  I&#039;ve read that I should have all guests book through one travel agent.  But, I have no idea how to find one or where to even begin my search.  I am in NYC, if that matters.  Again, any suggestions or places to start are most welcome.[\/font][\/color]\n[color=rgb(40,40,40)][font=arial]\nThanks everyone.[\/font][\/color]\n[\/quote]\nCongrats and welcome to BDW! This is definitely a great site for details on planning a destination wedding and the brides both past and present are very happy to share their experiences.\n\nI can definitely help you with one of the things you&#039;re looking for. The administrators of this site are DW specialists and I&#039;m sure would be able to help you out with information. Here is the link to contact them:\n\n[url=\"https:\/\/www.wrighttravelagency.com\/go\/destination-wedding?lp-variation-id=0&amp;amp;title=Planning%20a%20Destination%20Wedding?&amp;amp;source=BDW&amp;amp;creative=WTA%20TB\"]https:\/\/www.wrighttravelagency.com\/go\/destination-wedding?lp-variation-id=0&amp;amp;title=Planning%20a%20Destination%20Wedding?&amp;amp;source=BDW&amp;amp;creative=WTA%20TB[\/url]\n\nI&#039;m afraid I can&#039;t help with resort info but I&#039;m sure one of the TAs at Wright will be able to get you started with information.\n\nGood luck and happy planning!","Attachments":[],"Id":1899078,"PostDate":1435025783,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>rebecca2122, on 20 June 2015 - 02:32 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">Hi:<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">My fiance and I got engaged in October and we are planning a July 2016 destination wedding. \u00a0I am new to this and have no experience with event planning, let alone destination planning. \u00a0My primary concern is finding a venue. \u00a0We are planning on having approximately 30 guests and I would greatly appreciate any suggestions. \u00a0Below is what I'm looking for:<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">- anywhere in Mexico or the Carribbean (in reasonable distance from both NY and CA)<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">- small, boutique resort with 100 rooms or less<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">- non-touristy location (I'm not interested in hotels located among strips of other hotels)<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">- beach-front hotel<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">- preferably with villas for some guests (i.e., beachfront standalone villa with direct access to the beach from the room)<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">Any suggestions greatly appreciated.<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">My secondary concern is finding a travel agent. \u00a0I've read that I should have all guests book through one travel agent. \u00a0But, I have no idea how to find one or where to even begin my search. \u00a0I am in NYC, if that matters. \u00a0Again, any suggestions or places to start are most welcome.<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">Thanks everyone.<\/p>\n<p>\u00a0<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>Congrats and welcome to BDW! This is definitely a great site for details on planning a destination wedding and the brides both past and present are very happy to share their experiences.<\/p>\n<p>\u00a0<\/p>\n<p>I can definitely help you with one of the things you're looking for. The administrators of this site are DW specialists and I'm sure would be able to help you out with information. Here is the link to contact them:<\/p>\n<p>\u00a0<\/p>\n<p><a href='https:\/\/www.wrighttravelagency.com\/go\/destination-wedding?lp-variation-id=0&title=Planning%20a%20Destination%20Wedding?&source=BDW&creative=WTA%20TB' class='bbc_url' title='External link' rel='nofollow external'>https:\/\/www.wrighttr...creative=WTA TB<\/a><\/p>\n<p>\u00a0<\/p>\n<p>I'm afraid I can't help with resort info but I'm sure one of the TAs at Wright will be able to get you started with information.<\/p>\n<p>\u00a0<\/p>\n<p>Good luck and happy planning!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283458999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.114.77.69","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79298,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1e0391418103f663901220d1e0d08dab","RawContent":"Hi Rebecca and congratulations!\n\nRoyalton White Sands is small, but has more than 100 rooms. Very nice resort.\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1899611,"PostDate":1435762187,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi Rebecca and congratulations!<br>\nRoyalton White Sands is small, but has more than 100 rooms. Very nice resort.<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>This dress is for sale by the way","Email":"dimps4dyz@hotmail.com","IpAddress":"174.112.4.167","GroupId":39,"GroupName":"Newbie","JoinDate":1394157595,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277037.jpg?_r=1435766133","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Dimps","Id":277037,"Name":"Dimps","IsOnline":false}}],"Id":"79298","Title":"Help With Location","LastPostDate":1435762187},"Pages":{"TotalItems":4,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
