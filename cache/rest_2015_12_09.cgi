{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":5,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":718,"MovedTo":null,"MovedOn":0,"FirstPostId":1883042,"Rating":0,"RatingHits":0,"Starter":{"Id":281741,"Name":"HilaryMWren","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281741.jpg?_r=1421368589","PhotoWidth":200,"PhotoHeight":113,"PhotoType":"custom"},"IsOnline":false},"StartDate":1421369708,"LastPoster":{"Id":281741,"Name":"HilaryMWren","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281741.jpg?_r=1421368589","PhotoWidth":200,"PhotoHeight":113,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":38,"Preview":{"Id":1883042,"PostDate":1421369708,"PostContent":"Hi \u00a0 Are there any recent Dreams Los Cabos brides out there? Or brides to be? \u00a0 I am seriously co...","Author":{"Signature":"","Email":"hilary.wren@mail.mcgill.ca","IpAddress":"24.202.6.92","GroupId":39,"GroupName":"Newbie","JoinDate":1421368114,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281741.jpg?_r=1421368589","PhotoWidth":200,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"HilaryMWren","Id":281741,"Name":"HilaryMWren","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.202.6.92","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78611,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c6ecc8a259b007fe47ce6da3cfa5bea3","RawContent":"&lt;p&gt;Hi&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Are there any recent Dreams Los Cabos brides out there? Or brides to be?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am seriously considering this location for my wedding ....&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thank you :)&lt;\/p&gt;","Attachments":[],"Id":1883042,"PostDate":1421369708,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi<\/p>\n<p>\u00a0<\/p>\n<p>Are there any recent Dreams Los Cabos brides out there? Or brides to be?<\/p>\n<p>\u00a0<\/p>\n<p>I am seriously considering this location for my wedding ....<\/p>\n<p>\u00a0<\/p>\n<p>Thank you <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"hilary.wren@mail.mcgill.ca","IpAddress":"24.202.6.92","GroupId":39,"GroupName":"Newbie","JoinDate":1421368114,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281741.jpg?_r=1421368589","PhotoWidth":200,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"HilaryMWren","Id":281741,"Name":"HilaryMWren","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.101.83.185","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78611,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b3bd9fb3673432b4145845338d897940","RawContent":"&lt;p&gt;You&#039;re definitely in the right place! The owner of this site is a Dreams Cabo bride! Cabo is gorgeous - my husband and I love it there. Here is the connection to several of the forums for this resort. Also take a look at the resort reviews and see what past brides have said.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/forum\/118-dreams-los-cabos-weddings\/&#039;&gt;http:\/\/www.bestdestinationwedding.com\/forum\/118-dreams-los-cabos-weddings\/&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck and happy planning!&lt;\/p&gt;","Attachments":[],"Id":1883054,"PostDate":1421373824,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>You're definitely in the right place! The owner of this site is a Dreams Cabo bride! Cabo is gorgeous - my husband and I love it there. Here is the connection to several of the forums for this resort. Also take a look at the resort reviews and see what past brides have said.<\/p>\n<p>\u00a0<\/p>\n<p><a href='http:\/\/www.bestdestinationwedding.com\/forum\/118-dreams-los-cabos-weddings\/' class='bbc_url' title=''>http:\/\/www.bestdesti...cabos-weddings\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Good luck and happy planning!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283458999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.79.210.220","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78611,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f306a8d8682c68d11e671cca1e09f585","RawContent":"&lt;p&gt;I got married at Dreams Cabo! I was very happy with my wedding and if you have specific questions, feel free to ask :)&lt;\/p&gt;","Attachments":[],"Id":1883076,"PostDate":1421389835,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I got married at Dreams Cabo! I was very happy with my wedding and if you have specific questions, feel free to ask <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"candicecwong@hotmail.com","IpAddress":"70.79.62.16","GroupId":39,"GroupName":"Newbie","JoinDate":1361853338,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-266600.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"misscuppycake","Id":266600,"Name":"misscuppycake","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.202.6.92","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78611,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"535f76a4e2efc817e5b467653867947c","RawContent":"&lt;p&gt;Thank you ladies!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I heard back from the WC in less than 24 hours (great start!)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Since I am likely to have the ceremony off site at a Catholic church, I will not likley buy a \"wedding package\" but instead, have to rent \/ plan each item.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;My goal is a wedding in January or February 2016. I am seeking a travel agent (Ontario Canada) who can help with the logisitics. Someone familar with this hotel would be great.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;To be continued....&lt;\/p&gt;","Attachments":[],"Id":1883105,"PostDate":1421453214,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thank you ladies!<\/p>\n<p>\u00a0<\/p>\n<p>I heard back from the WC in less than 24 hours (great start!)<\/p>\n<p>\u00a0<\/p>\n<p>Since I am likely to have the ceremony off site at a Catholic church, I will not likley buy a \"wedding package\" but instead, have to rent \/ plan each item.<\/p>\n<p>\u00a0<\/p>\n<p>My goal is a wedding in January or February 2016. I am seeking a travel agent (Ontario Canada) who can help with the logisitics. Someone familar with this hotel would be great.<\/p>\n<p>\u00a0<\/p>\n<p>To be continued....<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"hilary.wren@mail.mcgill.ca","IpAddress":"24.202.6.92","GroupId":39,"GroupName":"Newbie","JoinDate":1421368114,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281741.jpg?_r=1421368589","PhotoWidth":200,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"HilaryMWren","Id":281741,"Name":"HilaryMWren","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.202.6.92","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78611,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cf33cea28a1a5c3758111e434ce57588","RawContent":"&lt;p&gt;It seems that this hotel may be out of the price range for my guests. I cannot seem to find a reasonable all inclusive package for this luxury hotel.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Back to the search....&lt;\/p&gt;","Attachments":[],"Id":1883555,"PostDate":1421803523,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>It seems that this hotel may be out of the price range for my guests. I cannot seem to find a reasonable all inclusive package for this luxury hotel.<\/p>\n<p>\u00a0<\/p>\n<p>Back to the search....<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"hilary.wren@mail.mcgill.ca","IpAddress":"24.202.6.92","GroupId":39,"GroupName":"Newbie","JoinDate":1421368114,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281741.jpg?_r=1421368589","PhotoWidth":200,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"HilaryMWren","Id":281741,"Name":"HilaryMWren","IsOnline":false}}],"Id":"78611","Title":"Dreams Los Cabos Brides?","LastPostDate":1421803523},"Pages":{"TotalItems":5,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
