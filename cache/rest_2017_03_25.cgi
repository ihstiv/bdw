{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":1,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":221,"MovedTo":null,"MovedOn":0,"FirstPostId":1789792,"Rating":0,"RatingHits":0,"Starter":{"Id":272433,"Name":"AponteWedding","Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-272433.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"StartDate":1376146641,"LastPoster":{"Id":272433,"Name":"AponteWedding","Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-272433.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":25,"Preview":{"Id":1789792,"PostDate":1376146641,"PostContent":"Hi Ladies! I hope this tread isn't too out of date!  \u00a0  I'm so happy to also have found you all...","Author":{"Signature":"","Email":"xelarican03@aol.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1376146448,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-272433.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"AponteWedding","Id":272433,"Name":"AponteWedding","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":74821,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d1d3fb5854cbb73ef7f3653f7de6861e","RawContent":"&lt;p&gt; Hi Ladies! I hope this tread isn&#039;t too out of date!&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I&#039;m so happy to also have found you all on this forum bc I didnt know where to start!&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; We have been emailing different hotels\/restaurants to see what the rates are. Has anyone gone through the process with La Concha? We received a quote from them but I wasn&#039;t sure of many of the details and the wedding planner Jessica is very slooooow with her responses! What about the restaurant la Perla? We are planning for Nov 2014. Is there a substantial fee to get a planner?&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Any suggestions would be awesome!&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; thanks!&lt;\/p&gt;","Attachments":[],"Id":1789792,"PostDate":1376146641,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hi Ladies! I hope this tread isn't too out of date!<\/p> <p> \u00a0<\/p> <p> I'm so happy to also have found you all on this forum bc I didnt know where to start!<\/p> <p> \u00a0<\/p> <p> We have been emailing different hotels\/restaurants to see what the rates are. Has anyone gone through the process with La Concha? We received a quote from them but I wasn't sure of many of the details and the wedding planner Jessica is very slooooow with her responses! What about the restaurant la Perla? We are planning for Nov 2014. Is there a substantial fee to get a planner?<\/p> <p> \u00a0<\/p> <p> Any suggestions would be awesome!<\/p> <p> \u00a0<\/p> <p> thanks!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"xelarican03@aol.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1376146448,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-272433.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"AponteWedding","Id":272433,"Name":"AponteWedding","IsOnline":false}}],"Id":"74821","Title":"Hello Looking for a nice venue!","LastPostDate":1376146641},"Pages":{"TotalItems":1,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
