sOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"115fde6cea3d4a2d6b1867aa1618796c","RawContent":"[quote]\nOriginally Posted by [b]amberk90[\/b] \/img\/forum\/go_quote.gif\n \n \n Your photos are beautiful! Thank you so much for sharing them! I&#039;m interested in how much your rates are and if your available may 14th 2014.. Hope to hear from you soon![\/quote] \n Thank you, love! Sending you a PM with the details :)","Attachments":[],"Id":1781036,"PostDate":1374408175,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>amberk90<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <br \/> Your photos are beautiful! Thank you so much for sharing them! I'm interested in how much your rates are and if your available may 14th 2014.. Hope to hear from you soon!<\/blockquote> <p> Thank you, love! Sending you a PM with the details <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kzheleznova@yahoo.com","IpAddress":"61.19.236.122","GroupId":44,"GroupName":"Vendor","JoinDate":1261894145,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-224102.jpg?_r=0","PhotoWidth":180,"PhotoHeight":270,"PhotoType":"custom"},"FormattedName":"KatyaNova","Id":224102,"Name":"KatyaNova","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2a2917b2071f8235a984b0b790f60417","RawContent":"&lt;p&gt; Hey ladies, I am glad your getting your confirmations for your wedding dates!! i just got mine last week and it did take them just over 2 weeks to confirm. But I am now confirmed for April 28th at 5pm!! I am sooo excited!! I am trying to finish designing my wedding invites so I can send them out soon so people can put down their deposits!! It&#039;s all starting to feel so real!! I bought my wedding dress from David&#039;s Bridal on July 6th and they called me on July 18th because it was ready for pick up!! Talk about fast!!! I hope every ones planning is going great!!&lt;\/p&gt;","Attachments":[],"Id":1781886,"PostDate":1374567248,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hey ladies, I am glad your getting your confirmations for your wedding dates!! i just got mine last week and it did take them just over 2 weeks to confirm. But I am now confirmed for April 28th at 5pm!! I am sooo excited!! I am trying to finish designing my wedding invites so I can send them out soon so people can put down their deposits!! It's all starting to feel so real!! I bought my wedding dress from David's Bridal on July 6th and they called me on July 18th because it was ready for pick up!! Talk about fast!!! I hope every ones planning is going great!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mary_mac0203@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1368567681,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-269591.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Marbear0503","Id":269591,"Name":"Marbear0503","IsOnline":false}}],"Pages":{"TotalItems":465,"TotalPages":47,"CurrentPage":90,"NextPage":100,"PreviousPage":80,"LastPage":460},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
