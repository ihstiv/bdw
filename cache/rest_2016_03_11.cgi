Request Time: 0 seconds
{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"44f356ff8215a602ea49759ea29d13dd","RawContent":"&lt;p&gt; Thanks WBA, &amp;nbsp;I spoke with my wedding coordinator and she did share that with me.&lt;\/p&gt;","Attachments":[],"Id":1767896,"PostDate":1371125308,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Thanks WBA, \u00a0I spoke with my wedding coordinator and she did share that with me.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jlstockslager@gmail.com","IpAddress":"68.59.10.94","GroupId":39,"GroupName":"Newbie","JoinDate":1369168942,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-269825.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"jldinapoli","Id":269825,"Name":"jldinapoli","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2433bd3702509e5998ae3e8b1fc37dd4","RawContent":"&lt;p&gt; Hi Brides :) My wedding date is April 30th at Now Larimar.&amp;nbsp; I did a site inspection this past April and out of 4 properties this was by far my favorite!&lt;\/p&gt;","Attachments":[],"Id":1768457,"PostDate":1371218194,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hi Brides <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> My wedding date is April 30th at Now Larimar.\u00a0 I did a site inspection this past April and out of 4 properties this was by far my favorite!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"carolynbrown_83@hotmail.com","IpAddress":"204.50.151.53","GroupId":39,"GroupName":"Newbie","JoinDate":1371062314,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270532.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Carolyn B","Id":270532,"Name":"Carolyn B","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4ad4baadb76b3d7bdbdc0588fb7adcb9","RawContent":"Congrats Carolyn! So you actually went and saw the resort?","Attachments":[],"Id":1769608,"PostDate":1371498049,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Congrats Carolyn! So you actually went and saw the resort?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kristinasimms@hotmail.com","IpAddress":"68.150.70.86","GroupId":39,"GroupName":"Newbie","JoinDate":1357849978,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-264243.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Kristina Simms","Id":264243,"Name":"Kristina Simms","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0c4a39ad02a36532d2f120761d11af63","RawContent":"&lt;p&gt; Hey Kristina, congrats to you too!&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Yes we did get to visit the resort, it&#039;s breathtaking :):) Did you chose based on pictures you saw online? If so, you won&#039;t be disapointed.&amp;nbsp; It&#039;s far more beautiful in person.&amp;nbsp; We stayed at Ocean Blue and I thought for sure when we went to Punta Cana that Ocean would be the one we pick for our DW, but when I went to see Now Larimar I was absouletely sure this was the dream resort I imagined my perfect wedding taking place.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1769750,"PostDate":1371552180,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hey Kristina, congrats to you too!<\/p> <p> \u00a0<\/p> <p> Yes we did get to visit the resort, it's breathtaking <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> Did you chose based on pictures you saw online? If so, you won't be disapointed.\u00a0 It's far more beautiful in person.\u00a0 We stayed at Ocean Blue and I thought for sure when we went to Punta Cana that Ocean would be the one we pick for our DW, but when I went to see Now Larimar I was absouletely sure this was the dream resort I imagined my perfect wedding taking place.\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"carolynbrown_83@hotmail.com","IpAddress":"204.50.151.53","GroupId":39,"GroupName":"Newbie","JoinDate":1371062314,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270532.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Carolyn B","Id":270532,"Name":"Carolyn B","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"818244baea2e54b2e1a856fd40b83556","RawContent":"Thanks Carolyn!! That is so great to hear! I did just choose by viewing pics online. I really liked the Now\/Secrets\/Dreams for their wedding packages and prices and then narrowed it down with the pics. We are going for two weeks so are moving to the Secrets for our second week. So are you getting married on the beach?","Attachments":[],"Id":1769827,"PostDate":1371557517,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks Carolyn!! That is so great to hear! I did just choose by viewing pics online. I really liked the Now\/Secrets\/Dreams for their wedding packages and prices and then narrowed it down with the pics. We are going for two weeks so are moving to the Secrets for our second week. So are you getting married on the beach?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kristinasimms@hotmail.com","IpAddress":"68.150.70.86","GroupId":39,"GroupName":"Newbie","JoinDate":1357849978,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-264243.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Kristina Simms","Id":264243,"Name":"Kristina Simms","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1571694169f34e9d9b8fbb737aa452ae","RawContent":"&lt;p&gt; We are leaning towards the gazebo near the fountain :) it&#039;s very private and since I&#039;m not graceful I don&#039;t have to worry about walking in the sand :P&amp;nbsp; but the beach is beautiful !&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Good call on moving to secrets for your second week too btw.&amp;nbsp; We&#039;re also staying 2 weeks so we have a \"real\" honeymoon but we&#039;re looking at entirely different resorts for week 2 just because we like trying new places often :) Secrets is fantastic, you won&#039;t be disappointed in the least.&amp;nbsp; When you walk onto this property you just feel your shoulders drop and you are relaxed :)   Who is your wedding coordinator at Now?&amp;nbsp; We met Mercy and she was so sweet, we haven&#039;t been assigned our coordinater yet though.&amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Do you have a lot of guests booked so far?&lt;\/p&gt;","Attachments":[],"Id":1769927,"PostDate":1371568688,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> We are leaning towards the gazebo near the fountain <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> it's very private and since I'm not graceful I don't have to worry about walking in the sand <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/tongue.png' class='bbc_emoticon' alt=':P' \/>\u00a0 but the beach is beautiful !<\/p> <p> \u00a0<\/p> <p> Good call on moving to secrets for your second week too btw.\u00a0 We're also staying 2 weeks so we have a \"real\" honeymoon but we're looking at entirely different resorts for week 2 just because we like trying new places often <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> Secrets is fantastic, you won't be disappointed in the least.\u00a0 When you walk onto this property you just feel your shoulders drop and you are relaxed <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0\u00a0 Who is your wedding coordinator at Now?\u00a0 We met Mercy and she was so sweet, we haven't been assigned our coordinater yet though.\u00a0<\/p> <p> \u00a0<\/p> <p> Do you have a lot of guests booked so far?<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"carolynbrown_83@hotmail.com","IpAddress":"204.50.151.53","GroupId":39,"GroupName":"Newbie","JoinDate":1371062314,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270532.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Carolyn B","Id":270532,"Name":"Carolyn B","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cca258c45e8680eefe6e5952542d5076","RawContent":"&lt;p&gt; Carolyn,&lt;\/p&gt; &lt;p&gt; We also are getting married at the fountain and opted to have our reception on the beach. I also liked the privacy that the fountain offered as I saw too many ceremony photos with strangers in speedos in the background!&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; That is a great idea to move to another resort entirely! I do wish we would have looked into that a little more. Where are you thinking you will stay? Our wedding coordinator is Silvia. So far communication has been great, I have not had any issues and have gotten everything I have asked for! So far we have only 19 guests that have paid a deposit. We are hoping for a few more, to at least reach the 25 that are allowed for our chosen wedding package.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; How many do you have booked?&lt;\/p&gt;","Attachments":[],"Id":1769957,"PostDate":1371573113,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Carolyn,<\/p> <p> We also are getting married at the fountain and opted to have our reception on the beach. I also liked the privacy that the fountain offered as I saw too many ceremony photos with strangers in speedos in the background!<\/p> <p> \u00a0<\/p> <p> That is a great idea to move to another resort entirely! I do wish we would have looked into that a little more. Where are you thinking you will stay? Our wedding coordinator is Silvia. So far communication has been great, I have not had any issues and have gotten everything I have asked for! So far we have only 19 guests that have paid a deposit. We are hoping for a few more, to at least reach the 25 that are allowed for our chosen wedding package.<\/p> <p> \u00a0<\/p> <p> How many do you have booked?<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kristinasimms@hotmail.com","IpAddress":"68.150.70.86","GroupId":39,"GroupName":"Newbie","JoinDate":1357849978,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-264243.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Kristina Simms","Id":264243,"Name":"Kristina Simms","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"afb34c1eb00be18b4ce6533436271d88","RawContent":"&lt;p&gt; Has anyone asked their wedding coordinator how the outside vendor fee works? I am wondering specifically about an outside photographer that is a team of two ppl, is that still the straight $500 for the company or are we required to pay per person?&lt;\/p&gt;","Attachments":[],"Id":1770074,"PostDate":1371596327,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Has anyone asked their wedding coordinator how the outside vendor fee works? I am wondering specifically about an outside photographer that is a team of two ppl, is that still the straight $500 for the company or are we required to pay per person?<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kristinasimms@hotmail.com","IpAddress":"68.150.70.86","GroupId":39,"GroupName":"Newbie","JoinDate":1357849978,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-264243.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Kristina Simms","Id":264243,"Name":"Kristina Simms","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5cbb82b07a1ad00c79274dc1e817cd39","RawContent":"&lt;p&gt; 19 is good :) We have 18 so far.&amp;nbsp; Invites just went out in the mail today :)&amp;nbsp; I made a wed-site to announce it to everyone and to share booking deets so we did manage to get quite a few already, much more than I anticipated. I made my own wedding invitations through inspired by a thread I found on this website I believe - been looking at so much it&#039;s all getting mixed up LOL.&amp;nbsp; I&#039;m getting excited! Did you get a dress yet? I&#039;m interested in learning what other brides will be wearing :) Don&#039;t you love that you can wear heels at the fountain? I probably won&#039;t because my fiance isn&#039;t much taller than me :P&lt;\/p&gt;","Attachments":[],"Id":1770265,"PostDate":1371648888,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> 19 is good <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> We have 18 so far.\u00a0 Invites just went out in the mail today <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0 I made a wed-site to announce it to everyone and to share booking deets so we did manage to get quite a few already, much more than I anticipated. I made my own wedding invitations through inspired by a thread I found on this website I believe - been looking at so much it's all getting mixed up LOL.\u00a0 I'm getting excited! Did you get a dress yet? I'm interested in learning what other brides will be wearing <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> Don't you love that you can wear heels at the fountain? I probably won't because my fiance isn't much taller than me <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/tongue.png' class='bbc_emoticon' alt=':P' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"carolynbrown_83@hotmail.com","IpAddress":"204.50.151.53","GroupId":39,"GroupName":"Newbie","JoinDate":1371062314,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270532.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Carolyn B","Id":270532,"Name":"Carolyn B","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"60b5d09eb0acbbab96b9d8c26683e7f6","RawContent":"Carolyn, congrats on choosing your wedding location! That&#039;s awesome that you were able to get to visit. I was just curious as to what your other 3 properties were?! I&#039;m at the beginning of planning and I&#039;m stuck between NOW Larimar, Dreams and Iberostar. I want to make a decision soon, as I&#039;m planning an August wedding and love to hear personal experiences and reviews.","Attachments":[],"Id":1770273,"PostDate":1371650121,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Carolyn, congrats on choosing your wedding location! That's awesome that you were able to get to visit. I was just curious as to what your other 3 properties were?! I'm at the beginning of planning and I'm stuck between NOW Larimar, Dreams and Iberostar. I want to make a decision soon, as I'm planning an August wedding and love to hear personal experiences and reviews.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"drenna@gmail.com","IpAddress":"67.167.198.72","GroupId":47,"GroupName":"Site Supporter","JoinDate":1371505464,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270677.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":124,"PhotoType":"custom"},"FormattedName":"duchovny0901","Id":270677,"Name":"duchovny0901","IsOnline":false}}],"Pages":{"TotalItems":465,"TotalPages":47,"CurrentPage":50,"NextPage":60,"PreviousPage":40,"LastPage":460},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
