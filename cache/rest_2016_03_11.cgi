{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.60.151.9","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f2c45203b9b3905fa86ab590e26e3115","RawContent":"&lt;p&gt;Piggybacking off @[member=\"jldinapoli\"], What are u guys doing for decorations? Centerpieces? Tablecloths, etc? Are you just buying everything from the resort?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I got a quote from dj Mannia. Wasnt expecting him to be soooo expensive!!!!! Ill have to think on that! LOL!&lt;\/p&gt;","Attachments":[],"Id":1827093,"PostDate":1389991705,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Piggybacking off @<a hovercard-ref=\"member\" hovercard-id=\"269825\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/269825-jldinapoli\/' title='Member profile'><span itemprop=\"name\">jldinapoli<\/span><\/a>, What are u guys doing for decorations? Centerpieces? Tablecloths, etc? Are you just buying everything from the resort?<\/p>\n<p>\u00a0<\/p>\n<p>I got a quote from dj Mannia. Wasnt expecting him to be soooo expensive!!!!! Ill have to think on that! LOL!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sohoward82@gmail.com","IpAddress":"72.244.31.111","GroupId":39,"GroupName":"Newbie","JoinDate":1372588544,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-271063.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"MrsFountain2B","Id":271063,"Name":"MrsFountain2B","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"96.49.163.223","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":1390260858,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"25e55005f7db6c39969bd41af2d3247c","RawContent":"[quote name=\"Kristina Simms\" post=\"1826839\" timestamp=\"1389930139\"]\n@[member=\"deelirious\"] Congrats on your upcoming wedding! It took a little bit for us to hear back in the very beginning as well. The 2014 price list is the same as the 2013 (for now!). We haven&#039;t received any price changes yet.[\/quote]\nThanks Kristina! I heard back from the Yohannelly and got the pricing. The dates I inquired about are available so I think I&#039;ll be putting a deposit soon! :)","Attachments":[],"Id":1827658,"PostDate":1390260840,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Kristina Simms, on 16 January 2014 - 10:42 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"275995\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/275995-deelirious\/' title='Member profile'><span itemprop=\"name\">deelirious<\/span><\/a> Congrats on your upcoming wedding! It took a little bit for us to hear back in the very beginning as well. The 2014 price list is the same as the 2013 (for now!). We haven't received any price changes yet.\u00a0<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>Thanks Kristina! I heard back from the Yohannelly and got the pricing. The dates I inquired about are available so I think I'll be putting a deposit soon! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\n\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kerndenisewedding@gmail.com","IpAddress":"207.6.34.221","GroupId":39,"GroupName":"Newbie","JoinDate":1389374305,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"deelirious","Id":275995,"Name":"deelirious","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"142.162.72.82","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a504bd723d997e9bf18c95ca20717fbc","RawContent":"&lt;p&gt;HELLO 2014 Brides! My name is Angelina and our Wedding date is May 7, 2014 in Punta Cana :) I can&#039;t wait to chat and plan with you all the next 3 months!&lt;\/p&gt;","Attachments":[],"Id":1827904,"PostDate":1390333175,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>HELLO 2014 Brides! My name is Angelina and our Wedding date is May 7, 2014 in Punta Cana <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> I can't wait to chat and plan with you all the next 3 months!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"angelina_plichie_@hotmail.com","IpAddress":"142.162.72.82","GroupId":39,"GroupName":"Newbie","JoinDate":1390329994,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276248.jpg?_r=1395191656","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"PuntaCanaBride14","Id":276248,"Name":"PuntaCanaBride14","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.60.151.9","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"44634db1bcc03ee25e8d2ce1076f35c6","RawContent":"&lt;p&gt;@[member=\"deelirious\"] What date do you plan to book?&lt;\/p&gt;","Attachments":[],"Id":1828055,"PostDate":1390387314,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"275995\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/275995-deelirious\/' title='Member profile'><span itemprop=\"name\">deelirious<\/span><\/a> What date do you plan to book?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sohoward82@gmail.com","IpAddress":"72.244.31.111","GroupId":39,"GroupName":"Newbie","JoinDate":1372588544,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-271063.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"MrsFountain2B","Id":271063,"Name":"MrsFountain2B","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.91.162.106","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0d15a6abf602ad0e75a2069b0a01c629","RawContent":"&lt;p&gt;@[member=\"PuntaCanaBride14\"] Congrats! I&#039;m also a May bride -- May 31!&lt;\/p&gt;\n\n&lt;p&gt;@[member=\"MrsFountain2B\"] Does DJ Mannia work for the resort? Or is he considered an outside vendor?&lt;\/p&gt;\n&lt;p&gt;I&#039;m thinking we may just pay for the ipod hookup!&lt;\/p&gt;","Attachments":[],"Id":1828120,"PostDate":1390400310,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"276248\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/276248-puntacanabride14\/' title='Member profile'><span itemprop=\"name\">PuntaCanaBride14<\/span><\/a> Congrats! I'm also a May bride -- May 31!<\/p>\n<br \/><p>@<a hovercard-ref=\"member\" hovercard-id=\"271063\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/271063-mrsfountain2b\/' title='Member profile'><span itemprop=\"name\">MrsFountain2B<\/span><\/a> Does DJ Mannia work for the resort? Or is he considered an outside vendor?<\/p>\n<p>I'm thinking we may just pay for the ipod hookup!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"telli26@gmail.com","IpAddress":"207.91.162.106","GroupId":39,"GroupName":"Newbie","JoinDate":1373111270,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-271235.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":139,"PhotoType":"custom"},"FormattedName":"Tiffany Ellison","Id":271235,"Name":"Tiffany Ellison","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.87.110.226","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"466bf2dfc593678fda5614e5efe0df3d","RawContent":"Yes, we&#039;re going to take advantage of the iPod hookup. Our Wedding is June 20th.\n\n\nA lot of the add ons are pretty pricey. So, I&#039;m bringing a lot if stuff such as decor, gifts etc.\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1828403,"PostDate":1390483891,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Yes, we're going to take advantage of the iPod hookup. Our Wedding is June 20th.<br><br>\nA lot of the add ons are pretty pricey. So, I'm bringing a lot if stuff such as decor, gifts etc.<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"meiawalton@gmail.com","IpAddress":"66.87.108.11","GroupId":39,"GroupName":"Newbie","JoinDate":1358180175,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-264428.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Ms Meia","Id":264428,"Name":"Ms Meia","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.100.120.102","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":1390497155,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"beee069d97452860ed528b6fac2168e2","RawContent":"&lt;p&gt;Hello Ladies,&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;My name is Brenda, we are getting on September 12, 2014. I&#039;m am so excited to talk with all of you and share ideas! &amp;nbsp; :)&lt;\/p&gt;","Attachments":[],"Id":1828453,"PostDate":1390495548,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello Ladies,\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>My name is Brenda, we are getting on September 12, 2014. I'm am so excited to talk with all of you and share ideas! \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"roesslerwedding@gmail.com","IpAddress":"75.100.120.102","GroupId":40,"GroupName":"Jr. Member","JoinDate":1384945426,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275195.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"brendab1797","Id":275195,"Name":"brendab1797","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.244.31.111","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"10e9d48f612b0d3e01d05c9ab304a990","RawContent":"&lt;p&gt;@[member=\"Tiffany Ellison\"], I believe he is considered an outside vendor. I may just use the dj at Now Larimar.&lt;\/p&gt;","Attachments":[],"Id":1828619,"PostDate":1390578471,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"271235\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/271235-tiffany-ellison\/' title='Member profile'><span itemprop=\"name\">Tiffany Ellison<\/span><\/a>, I believe he is considered an outside vendor. I may just use the dj at Now Larimar.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sohoward82@gmail.com","IpAddress":"72.244.31.111","GroupId":39,"GroupName":"Newbie","JoinDate":1372588544,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-271063.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"MrsFountain2B","Id":271063,"Name":"MrsFountain2B","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"67.167.198.72","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"24f4001334ea62cd795d0f6b92f0f048","RawContent":"&lt;p&gt;@ &lt;a  class=\"\" href=\"http:\/\/www.bestdestinationwedding.com\/user\/271063-mrsfountain2b\/\"&gt;MrsFountain2B&lt;\/a&gt;&amp;nbsp;@ &lt;a  class=\"bbc_member\" href=\"http:\/\/www.bestdestinationwedding.com\/user\/271235-tiffany-ellison\/\" title=\"\"&gt;&lt;span&gt;Tiffany Ellison&lt;\/span&gt;&lt;\/a&gt;&amp;nbsp;DJ Mannia is an outside vendor, but my coordinator confirmed Now Larimar does not charge the $500 fee for DJ&#039;s. They charge a percentage of what the resort would charge for the same service (I think it&#039;s like 20 or 25%). Anywho I informed my WC that I&#039;m using DJ Mannia and she let me know the outside DJ charge is $190. Hope this helps!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span&gt;&lt;a  class=\"\" href=\"http:\/\/www.bestdestinationwedding.com\/user\/275195-brendab1797\/\" title=\"\"&gt;&lt;span&gt;@[member=\"brendab1797\"]&lt;\/span&gt;&lt;\/a&gt;&amp;nbsp;Welcome to the forums! Good luck in planning and I hope we can help answer some of the questions we&#039;ve already had!&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1828731,"PostDate":1390645808,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@ <a href='http:\/\/www.bestdestinationwedding.com\/user\/271063-mrsfountain2b\/' class='bbc_url' title=''>MrsFountain2B<\/a>\u00a0@ <a href='http:\/\/www.bestdestinationwedding.com\/user\/271235-tiffany-ellison\/' class='bbc_url' title=''><span>Tiffany Ellison<\/span><\/a>\u00a0DJ Mannia is an outside vendor, but my coordinator confirmed Now Larimar does not charge the $500 fee for DJ's. They charge a percentage of what the resort would charge for the same service (I think it's like 20 or 25%). Anywho I informed my WC that I'm using DJ Mannia and she let me know the outside DJ charge is $190. Hope this helps!<\/p>\n<p>\u00a0<\/p>\n<p><span><a  class=\"\" href=\"http:\/\/www.bestdestinationwedding.com\/user\/275195-brendab1797\/\" title=\"\"><span>@<a hovercard-ref=\"member\" hovercard-id=\"275195\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/275195-brendab1797\/' title='Member profile'><span itemprop=\"name\">brendab1797<\/span><\/a><\/span><\/a>\u00a0Welcome to the forums! Good luck in planning and I hope we can help answer some of the questions we've already had!<\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"drenna@gmail.com","IpAddress":"67.167.198.72","GroupId":47,"GroupName":"Site Supporter","JoinDate":1371505464,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270677.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":124,"PhotoType":"custom"},"FormattedName":"duchovny0901","Id":270677,"Name":"duchovny0901","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.159.22.146","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"48ea838388ad07e1d929667731209c79","RawContent":"Hi everyone:) my name is Adrieanne and I&#039;m getting married at Now Larimar November 18, 2014.  I cannot wait and am happy to hear everyone&#039;s ideas and share some if my own:)","Attachments":[],"Id":1828865,"PostDate":1390723900,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi everyone:) my name is Adrieanne and I'm getting married at Now Larimar November 18, 2014.  I cannot wait and am happy to hear everyone's ideas and share some if my own:)\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"adrieanneb@hotmail.com","IpAddress":"75.159.22.146","GroupId":39,"GroupName":"Newbie","JoinDate":1375733038,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272285.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Adrieanne","Id":272285,"Name":"Adrieanne","IsOnline":false}}],"Pages":{"TotalItems":465,"TotalPages":47,"CurrentPage":260,"NextPage":270,"PreviousPage":250,"LastPage":460},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
