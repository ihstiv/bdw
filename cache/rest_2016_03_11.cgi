{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"da50ad9a060ea9df455e72d887b99ab4","RawContent":"&lt;p&gt;Anyone want to have a blue wedding.... PM me if ur interested in my decorations 70 chair sahses, matching fabric for gazebo, fabric flowers &amp;amp;&amp;nbsp;votive candles... all easy to travel with and looks nice as decorations if i say so myself lol :)&amp;nbsp;&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;also feel free to ask any other questions, just got married at NOW last week!&lt;\/p&gt; &lt;p&gt;&lt;img alt=\" \" data-id=\"226562\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/226562\/width\/350\/height\/700\" \/&gt;&lt;\/p&gt; &lt;p&gt;&lt;img alt=\" \" data-id=\"226562\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/226562\/width\/350\/height\/700\" \/&gt;&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;&lt;img alt=\" \" data-id=\"226561\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/226561\/width\/350\/height\/700\" \/&gt;&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;&lt;img alt=\"* \" data-id=\"226558\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/226558\/width\/350\/height\/700\" \/&gt;&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;&lt;img alt=\"* \" data-id=\"226554\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/226554\/width\/350\/height\/700\" \/&gt;&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;&lt;img alt=\"* \" data-id=\"226555\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/226555\/width\/350\/height\/700\" \/&gt;&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;&lt;img alt=\"* \" data-id=\"226556\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/226556\/width\/350\/height\/700\" \/&gt;&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;&lt;img alt=\"* \" data-id=\"226557\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/226557\/width\/350\/height\/700\" \/&gt;&lt;\/p&gt;","Attachments":[],"Id":1814181,"PostDate":1384263458,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Anyone want to have a blue wedding.... PM me if ur interested in my decorations 70 chair sahses, matching fabric for gazebo, fabric flowers &\u00a0votive candles... all easy to travel with and looks nice as decorations if i say so myself lol <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0<\/p> <p>\u00a0<\/p> <p>also feel free to ask any other questions, just got married at NOW last week!<\/p> <p><span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"226562\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/226562\/width\/350\/height\/700\" \/><\/span><\/p> <p><span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"226562\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/226562\/width\/350\/height\/700\" \/><\/span><\/p> <p>\u00a0<\/p> <p><span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"226561\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/226561\/width\/350\/height\/700\" \/><\/span><\/p> <p>\u00a0<\/p> <p><span rel='lightbox'><img class='bbc_img' alt=\"* \" data-id=\"226558\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/226558\/width\/350\/height\/700\" \/><\/span><\/p> <p>\u00a0<\/p> <p><span rel='lightbox'><img class='bbc_img' alt=\"* \" data-id=\"226554\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/226554\/width\/350\/height\/700\" \/><\/span><\/p> <p>\u00a0<\/p> <p><span rel='lightbox'><img class='bbc_img' alt=\"* \" data-id=\"226555\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/226555\/width\/350\/height\/700\" \/><\/span><\/p> <p>\u00a0<\/p> <p><span rel='lightbox'><img class='bbc_img' alt=\"* \" data-id=\"226556\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/226556\/width\/350\/height\/700\" \/><\/span><\/p> <p>\u00a0<\/p> <p><span rel='lightbox'><img class='bbc_img' alt=\"* \" data-id=\"226557\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/226557\/width\/350\/height\/700\" \/><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rachchain@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1353418044,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-262550.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"rachel930","Id":262550,"Name":"rachel930","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ef91c005f98c17c8040ba60368061515","RawContent":"&lt;p style=\"background:#F4F3F2; margin-bottom:.0001pt; margin-left:7.5pt; margin-right:0in; margin-top:0in\"&gt;@ &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.bestdestinationwedding.com\/u\/72769\/duchovny0901\"&gt;&lt;span style=\"background-position:initial initial; background-repeat:initial initial\"&gt;duchovny0901&lt;\/span&gt;&lt;\/a&gt;, @ &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.bestdestinationwedding.com\/u\/69282\/jahanee-conner\"&gt;&lt;span style=\"background-position:initial initial; background-repeat:initial initial\"&gt;Jahanee Conner&lt;\/span&gt;&lt;\/a&gt;, @ &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.bestdestinationwedding.com\/u\/66280\/kristina-simms\"&gt;&lt;span style=\"background-position:initial initial; background-repeat:initial initial\"&gt;Kristina Simms&lt;\/span&gt;&lt;\/a&gt;, @ &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.bestdestinationwedding.com\/u\/60190\/EVKnowsitall\"&gt;&lt;span style=\"background-position:initial initial; background-repeat:initial initial\"&gt;EVKnowsitall&lt;\/span&gt;&lt;\/a&gt;, @ &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.bestdestinationwedding.com\/u\/71683\/marbear0503\"&gt;&lt;span style=\"background-position:initial initial; background-repeat:initial initial\"&gt;Marbear0503&lt;\/span&gt;&lt;\/a&gt;, @&lt;span style=\"color:#464646\"&gt; &lt;\/span&gt;&lt;span style=\"color:#464646\"&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.bestdestinationwedding.com\/u\/71917\/jldinapoli\"&gt;jldinapoli&lt;\/a&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-bottom:.0001pt\"&gt;&amp;nbsp;&lt;\/p&gt; &lt;p style=\"margin-bottom:.0001pt\"&gt;I FINALLLLLLLLLLLLLY got in touch with my WC Luisa Miranda!&amp;nbsp; She answered some of my questions, but of course, I have a million more, and you ladies have been my go-to\u00e2\u20ac\u2122s! Haha.&lt;\/p&gt; &lt;p style=\"margin-bottom:.0001pt\"&gt;&amp;nbsp;&lt;\/p&gt; &lt;p style=\"margin-bottom:.0001pt\"&gt;#1 - She told me that we can make reservations at the a la carte restaurants for up to 25 people.&amp;nbsp; Has anyone done this (or is thinking of doing this) for their &lt;strong&gt;Rehearsal Dinner&lt;\/strong&gt;, instead of buying and paying for the Rehearsal Dinner package?&lt;\/p&gt; &lt;p style=\"margin-bottom:.0001pt\"&gt;&amp;nbsp;&lt;\/p&gt; &lt;p style=\"margin-bottom:.0001pt\"&gt;#2 - We are planning on the Divine Wedding Package....&amp;nbsp; I know we won&#039;t be able to deduct the cost of the free Your Moments wedding from this, but she mentioned something about the &lt;strong&gt;Do Not Disturb Honeymoon Package&lt;\/strong&gt;.&amp;nbsp; Anyone have this or know what it is\/includes?&lt;\/p&gt; &lt;p style=\"margin-bottom:.0001pt\"&gt;&amp;nbsp;&lt;\/p&gt; &lt;p style=\"margin-bottom:.0001pt\"&gt;#3 - I&#039;m looking for some decent quality but inexpensive items for my &lt;strong&gt;Welcome Bags&lt;\/strong&gt;. Does anyone have any leads\/websites\/suggestions for the following items?&lt;\/p&gt; &lt;p style=\"margin-bottom:.0001pt\"&gt;1. Insulated tumbler cups&lt;\/p&gt; &lt;p style=\"margin-bottom:.0001pt\"&gt;2. Folding bamboo fans&lt;\/p&gt; &lt;p style=\"margin-bottom:.0001pt\"&gt;3. Custom coozies&lt;\/p&gt; &lt;p style=\"margin-bottom:.0001pt\"&gt;4. Waterproof room key\/money holders&lt;\/p&gt; &lt;p style=\"margin-bottom:.0001pt\"&gt;5. Kids snorkel sets&lt;\/p&gt; &lt;p style=\"margin-bottom:.0001pt\"&gt;&amp;nbsp;&lt;\/p&gt; &lt;p style=\"margin-bottom:.0001pt\"&gt;#4 \u00e2\u20ac\u201c Everything I read previously stated there was a &lt;strong&gt;Casino &lt;\/strong&gt;in the resort.&amp;nbsp; It seems they\u00e2\u20ac\u2122ve remodeled their website and now I don\u00e2\u20ac\u2122t see anything about it!&amp;nbsp; Can anyone shed some light on this, does it still exist? Lol.&amp;nbsp;My fiance\u00e2\u20ac\u2122s family is big on gambling and I\u00e2\u20ac\u2122d hate to tell them I was wrong!&lt;\/p&gt; &lt;p style=\"margin-bottom:.0001pt\"&gt;&amp;nbsp;&lt;\/p&gt; &lt;p style=\"margin-bottom:.0001pt\"&gt;#5 \u00e2\u20ac\u201c Has anyone thought of &lt;strong&gt;live-streaming&lt;\/strong&gt; their wedding online for family and friends who couldn\u00e2\u20ac\u2122t make it to the resort?&lt;\/p&gt; &lt;p style=\"margin-bottom:.0001pt\"&gt;&amp;nbsp;&lt;\/p&gt; &lt;p style=\"margin-bottom:.0001pt\"&gt;&lt;span style=\"color:#800080\"&gt;&lt;span style=\"font-size:18px\"&gt;&lt;em&gt;Thanks, everyone!&lt;\/em&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-bottom:.0001pt\"&gt;&lt;img alt=\":mswink:\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/msnwink.gif\" \/&gt;&lt;\/p&gt;","Attachments":[],"Id":1814700,"PostDate":1384420885,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p  style=\"margin-left:7.5pt\">@ <a href='http:\/\/www.bestdestinationwedding.com\/u\/72769\/duchovny0901' class='bbc_url' title=''><span>duchovny0901<\/span><\/a>, @ <a href='http:\/\/www.bestdestinationwedding.com\/u\/69282\/jahanee-conner' class='bbc_url' title=''><span>Jahanee Conner<\/span><\/a>, @ <a href='http:\/\/www.bestdestinationwedding.com\/u\/66280\/kristina-simms' class='bbc_url' title=''><span>Kristina Simms<\/span><\/a>, @ <a href='http:\/\/www.bestdestinationwedding.com\/u\/60190\/EVKnowsitall' class='bbc_url' title=''><span>EVKnowsitall<\/span><\/a>, @ <a href='http:\/\/www.bestdestinationwedding.com\/u\/71683\/marbear0503' class='bbc_url' title=''><span>Marbear0503<\/span><\/a>, @<span  style=\"color:#464646\"> <\/span><span  style=\"color:#464646\"><a href='http:\/\/www.bestdestinationwedding.com\/u\/71917\/jldinapoli' class='bbc_url' title=''>jldinapoli<\/a><\/span><\/p> <p>\u00a0<\/p> <p>I FINALLLLLLLLLLLLLY got in touch with my WC Luisa Miranda!\u00a0 She answered some of my questions, but of course, I have a million more, and you ladies have been my go-to\u00e2\u20ac\u2122s! Haha.<\/p> <p>\u00a0<\/p> <p>#1 - She told me that we can make reservations at the a la carte restaurants for up to 25 people.\u00a0 Has anyone done this (or is thinking of doing this) for their <strong>Rehearsal Dinner<\/strong>, instead of buying and paying for the Rehearsal Dinner package?<\/p> <p>\u00a0<\/p> <p>#2 - We are planning on the Divine Wedding Package....\u00a0 I know we won't be able to deduct the cost of the free Your Moments wedding from this, but she mentioned something about the <strong>Do Not Disturb Honeymoon Package<\/strong>.\u00a0 Anyone have this or know what it is\/includes?<\/p> <p>\u00a0<\/p> <p>#3 - I'm looking for some decent quality but inexpensive items for my <strong>Welcome Bags<\/strong>. Does anyone have any leads\/websites\/suggestions for the following items?<\/p> <p>1. Insulated tumbler cups<\/p> <p>2. Folding bamboo fans<\/p> <p>3. Custom coozies<\/p> <p>4. Waterproof room key\/money holders<\/p> <p>5. Kids snorkel sets<\/p> <p>\u00a0<\/p> <p>#4 \u00e2\u20ac\u201c Everything I read previously stated there was a <strong>Casino <\/strong>in the resort.\u00a0 It seems they\u00e2\u20ac\u2122ve remodeled their website and now I don\u00e2\u20ac\u2122t see anything about it!\u00a0 Can anyone shed some light on this, does it still exist? Lol.\u00a0My fiance\u00e2\u20ac\u2122s family is big on gambling and I\u00e2\u20ac\u2122d hate to tell them I was wrong!<\/p> <p>\u00a0<\/p> <p>#5 \u00e2\u20ac\u201c Has anyone thought of <strong>live-streaming<\/strong> their wedding online for family and friends who couldn\u00e2\u20ac\u2122t make it to the resort?<\/p> <p>\u00a0<\/p> <p><span  style=\"color:#800080\"><span  style=\"font-size:18px\"><em>Thanks, everyone!<\/em><\/span><\/span><\/p> <p><span rel='lightbox'><img class='bbc_img' alt=\":mswink:\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/msnwink.gif\" \/><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lisamarco413@aol.com","IpAddress":"174.107.97.51","GroupId":39,"GroupName":"Newbie","JoinDate":1379959023,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-273703.gif?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"lisamarco413","Id":273703,"Name":"lisamarco413","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3982874e23961573e0cecb68c7f02fcb","RawContent":"&lt;p&gt;&lt;a contenteditable=\"false\" data-huddler-embed=\"href\" href=\"\/u\/72769\/duchovny0901\" style=\"display: inline-block;\"&gt;@duchovny0901&lt;\/a&gt;&amp;nbsp;Thanks! I just sent him an email. Hopefully, he&#039;s available that date!!&lt;\/p&gt;","Attachments":[],"Id":1814711,"PostDate":1384424666,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><a href='\/u\/72769\/duchovny0901' class='bbc_url' title='External link' rel='nofollow external'>@duchovny0901<\/a>\u00a0Thanks! I just sent him an email. Hopefully, he's available that date!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jsconner1983@yahoo.com","IpAddress":"67.173.180.132","GroupId":40,"GroupName":"Jr. Member","JoinDate":1362996207,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-267190.jpeg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Jahanee Conner","Id":267190,"Name":"Jahanee Conner","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5f5156df69916f88c4e5eabec473b4aa","RawContent":"My fh and I did a site visit in sept and viewed the casino... It&#039;s nothing major but it&#039;s still there!! [quote name=\"lisamarco413\"]\n&lt;p style=\"background:#f4f3f2;margin-bottom:.0001pt;margin-left:7.5pt;margin-right:0in;margin-top:0in;\"&gt;@ [url=\"http:\/\/www.bestdestinationwedding.com\/u\/72769\/duchovny0901\"]duchovny0901[\/url], @ [url=\"http:\/\/www.bestdestinationwedding.com\/u\/69282\/jahanee-conner\"]Jahanee Conner[\/url], @ [url=\"http:\/\/www.bestdestinationwedding.com\/u\/66280\/kristina-simms\"]Kristina Simms[\/url], @ [url=\"http:\/\/www.bestdestinationwedding.com\/u\/60190\/EVKnowsitall\"]EVKnowsitall[\/url], @ [url=\"http:\/\/www.bestdestinationwedding.com\/u\/71683\/marbear0503\"]Marbear0503[\/url], @[color=464646][url=\"http:\/\/www.bestdestinationwedding.com\/u\/71917\/jldinapoli\"]jldinapoli[\/url][\/color]&lt;\/p&gt; &lt;p style=\"margin-bottom:.0001pt;\"&gt; &lt;\/p&gt; &lt;p style=\"margin-bottom:.0001pt;\"&gt;I FINALLLLLLLLLLLLLY got in touch with my WC Luisa Miranda!  She answered some of my questions, but of course, I have a million more, and you ladies have been my go-to\u00e2\u20ac\u2122s! Haha.&lt;\/p&gt; &lt;p style=\"margin-bottom:.0001pt;\"&gt; &lt;\/p&gt; &lt;p style=\"margin-bottom:.0001pt;\"&gt;#1 - She told me that we can make reservations at the a la carte restaurants for up to 25 people.  Has anyone done this (or is thinking of doing this) for their [b]Rehearsal Dinner[\/b], instead of buying and paying for the Rehearsal Dinner package?&lt;\/p&gt; &lt;p style=\"margin-bottom:.0001pt;\"&gt; &lt;\/p&gt; &lt;p style=\"margin-bottom:.0001pt;\"&gt;#2 - We are planning on the Divine Wedding Package....  I know we won&#039;t be able to deduct the cost of the free Your Moments wedding from this, but she mentioned something about the [b]Do Not Disturb Honeymoon Package[\/b].  Anyone have this or know what it is\/includes?&lt;\/p&gt; &lt;p style=\"margin-bottom:.0001pt;\"&gt; &lt;\/p&gt; &lt;p style=\"margin-bottom:.0001pt;\"&gt;#3 - I&#039;m looking for some decent quality but inexpensive items for my [b]Welcome Bags[\/b]. Does anyone have any leads\/websites\/suggestions for the following items?&lt;\/p&gt; &lt;p style=\"margin-bottom:.0001pt;\"&gt;1. Insulated tumbler cups&lt;\/p&gt; &lt;p style=\"margin-bottom:.0001pt;\"&gt;2. Folding bamboo fans&lt;\/p&gt; &lt;p style=\"margin-bottom:.0001pt;\"&gt;3. Custom coozies&lt;\/p&gt; &lt;p style=\"margin-bottom:.0001pt;\"&gt;4. Waterproof room key\/money holders&lt;\/p&gt; &lt;p style=\"margin-bottom:.0001pt;\"&gt;5. Kids snorkel sets&lt;\/p&gt; &lt;p style=\"margin-bottom:.0001pt;\"&gt; &lt;\/p&gt; &lt;p style=\"margin-bottom:.0001pt;\"&gt;#4 \u00e2\u20ac\u201c Everything I read previously stated there was a [b]Casino[\/b] in the resort.  It seems they\u00e2\u20ac\u2122ve remodeled their website and now I don\u00e2\u20ac\u2122t see anything about it!  Can anyone shed some light on this, does it still exist? Lol. My fiance\u00e2\u20ac\u2122s family is big on gambling and I\u00e2\u20ac\u2122d hate to tell them I was wrong!&lt;\/p&gt; &lt;p style=\"margin-bottom:.0001pt;\"&gt; &lt;\/p&gt; &lt;p style=\"margin-bottom:.0001pt;\"&gt;#5 \u00e2\u20ac\u201c Has anyone thought of [b]live-streaming[\/b] their wedding online for family and friends who couldn\u00e2\u20ac\u2122t make it to the resort?&lt;\/p&gt; &lt;p style=\"margin-bottom:.0001pt;\"&gt; &lt;\/p&gt; &lt;p style=\"margin-bottom:.0001pt;\"&gt;[color=800080][size=1][i]Thanks, everyone![\/i][\/size][\/color]&lt;\/p&gt; &lt;p style=\"margin-bottom:.0001pt;\"&gt;:mswink: &lt;\/p&gt;[\/quote]","Attachments":[],"Id":1814716,"PostDate":1384425509,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                My fh and I did a site visit in sept and viewed the casino... It's nothing major but it's still there!! <blockquote class='ipsBlockquote' data-author=\"lisamarco413\" url=\"\/t\/85114\/now&#045;larimar&#045;2014&#045;brides\/200#post_1962770\"><p><p  style=\"margin-left:7.5pt\">@ <a href='http:\/\/www.bestdestinationwedding.com\/u\/72769\/duchovny0901' class='bbc_url' title=''>duchovny0901<\/a>, @ <a href='http:\/\/www.bestdestinationwedding.com\/u\/69282\/jahanee-conner' class='bbc_url' title=''>Jahanee Conner<\/a>, @ <a href='http:\/\/www.bestdestinationwedding.com\/u\/66280\/kristina-simms' class='bbc_url' title=''>Kristina Simms<\/a>, @ <a href='http:\/\/www.bestdestinationwedding.com\/u\/60190\/EVKnowsitall' class='bbc_url' title=''>EVKnowsitall<\/a>, @ <a href='http:\/\/www.bestdestinationwedding.com\/u\/71683\/marbear0503' class='bbc_url' title=''>Marbear0503<\/a>, @<span  style='color: 464646'><a href='http:\/\/www.bestdestinationwedding.com\/u\/71917\/jldinapoli' class='bbc_url' title=''>jldinapoli<\/a><\/span><\/p> <p>\u00a0<\/p> <p>I FINALLLLLLLLLLLLLY got in touch with my WC Luisa Miranda!\u00a0 She answered some of my questions, but of course, I have a million more, and you ladies have been my go-to\u00e2\u20ac\u2122s! Haha.<\/p> <p>\u00a0<\/p> <p>#1 - She told me that we can make reservations at the a la carte restaurants for up to 25 people.\u00a0 Has anyone done this (or is thinking of doing this) for their <strong class='bbc'>Rehearsal Dinner<\/strong>, instead of buying and paying for the Rehearsal Dinner package?<\/p> <p>\u00a0<\/p> <p>#2 - We are planning on the Divine Wedding Package....\u00a0 I know we won't be able to deduct the cost of the free Your Moments wedding from this, but she mentioned something about the <strong class='bbc'>Do Not Disturb Honeymoon Package<\/strong>.\u00a0 Anyone have this or know what it is\/includes?<\/p> <p>\u00a0<\/p> <p>#3 - I'm looking for some decent quality but inexpensive items for my <strong class='bbc'>Welcome Bags<\/strong>. Does anyone have any leads\/websites\/suggestions for the following items?<\/p> <p>1. Insulated tumbler cups<\/p> <p>2. Folding bamboo fans<\/p> <p>3. Custom coozies<\/p> <p>4. Waterproof room key\/money holders<\/p> <p>5. Kids snorkel sets<\/p> <p>\u00a0<\/p> <p>#4 \u00e2\u20ac\u201c Everything I read previously stated there was a <strong class='bbc'>Casino<\/strong> in the resort.\u00a0 It seems they\u00e2\u20ac\u2122ve remodeled their website and now I don\u00e2\u20ac\u2122t see anything about it!\u00a0 Can anyone shed some light on this, does it still exist? Lol.\u00a0My fiance\u00e2\u20ac\u2122s family is big on gambling and I\u00e2\u20ac\u2122d hate to tell them I was wrong!<\/p> <p>\u00a0<\/p> <p>#5 \u00e2\u20ac\u201c Has anyone thought of <strong class='bbc'>live-streaming<\/strong> their wedding online for family and friends who couldn\u00e2\u20ac\u2122t make it to the resort?<\/p> <p>\u00a0<\/p> <p><span  style='color: 800080'><span  style='font-size: px'><em class='bbc'>Thanks, everyone!<\/em><\/span><\/span><\/p> <p>:mswink: <\/p><\/p><\/blockquote>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"May 01, 2015- complete!! 73 guests+bride & groom! Now Larimar Punta Cana! ","Email":"cooper.tyshelle@gmail.com","IpAddress":"108.50.56.179","GroupId":40,"GroupName":"Jr. Member","JoinDate":1375995069,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272393.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"DR2015","Id":272393,"Name":"DR2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bd9d217cba831e210dcdcf4d96650720","RawContent":"I&#039;m getting married at the Now Larimar on Feb. 15th less than 3months and so much to do!!!! I&#039;m so excited only having about 15 people so very small but it&#039;s what we wanted. I am using an outside planner because I just want to show up and not stress hopefully. Glad to see you all in here!!!","Attachments":[],"Id":1816027,"PostDate":1384949018,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm getting married at the Now Larimar on Feb. 15th less than 3months and so much to do!!!! I'm so excited only having about 15 people so very small but it's what we wanted. I am using an outside planner because I just want to show up and not stress hopefully. Glad to see you all in here!!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rachel5708@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1358765808,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-264800.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"rachelandjohnny","Id":264800,"Name":"rachelandjohnny","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"b93bcb57bfcd70e5368d4f6ff8907793","RawContent":"&lt;p&gt;Hey all,&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;We got married just over a month ago at Now and it was absolutely amazing. Please feel free to ask if you have any questions, I&#039;ve put the link to our photographers blog with her first round of our pictures.&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;Congratulations and best of luck to all of you!&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;http:\/\/www.kellyginnphotography.com\/megancody-a-punta-cana-dominican-republic-wedding\/&lt;\/p&gt;","Attachments":[],"Id":1817551,"PostDate":1385732583,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hey all,<\/p> <p>\u00a0<\/p> <p>We got married just over a month ago at Now and it was absolutely amazing. Please feel free to ask if you have any questions, I've put the link to our photographers blog with her first round of our pictures.<\/p> <p>\u00a0<\/p> <p>Congratulations and best of luck to all of you!<\/p> <p>\u00a0<\/p> <p>http:\/\/www.kellyginnphotography.com\/megancody-a-punta-cana-dominican-republic-wedding\/<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"greenhalgh.megan@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1367245232,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-269110.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"meganjune","Id":269110,"Name":"meganjune","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"374cd920a504cae25c50b9d1982f919d","RawContent":"&lt;p&gt;Gorgeous Pics!&lt;\/p&gt;","Attachments":[],"Id":1817559,"PostDate":1385736707,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Gorgeous Pics!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bisou504@comcast.net","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1385735661,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275394.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Bisou829","Id":275394,"Name":"Bisou829","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a62102842e2f010ab5c0a70bb77918ae","RawContent":"&lt;div class=\"quote-container\" data-huddler-embed=\"\/t\/85114\/now-larimar-2014-brides\/200#post_1965621\" data-huddler-embed-placeholder=\"false\"&gt;Quote: &lt;div class=\"quote-block\"&gt;Originally Posted by &lt;strong&gt;meganjune&lt;\/strong&gt;&amp;nbsp;&lt;img alt=\"View Post\" src=\"\/img\/forum\/go_quote.gif\" \/&gt;\n &amp;nbsp; &lt;p&gt;Hey all,&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;We got married just over a month ago at Now and it was absolutely amazing. Please feel free to ask if you have any questions, I&#039;ve put the link to our photographers blog with her first round of our pictures.&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;Congratulations and best of luck to all of you!&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;http:\/\/www.kellyginnphotography.com\/megancody-a-punta-cana-dominican-republic-wedding\/&lt;\/p&gt; &lt;\/div&gt; &lt;\/div&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;Megan- So much to love about your wedding. You guys are a handsome couple. I love:&lt;\/p&gt; &lt;p&gt;1) Your pop of something blue hydrangea bouquet and your bridesmaids calla lillies- my two favorite flowers.&lt;\/p&gt; &lt;p&gt;2) You playing volleyball in your dress- adorable&lt;\/p&gt; &lt;p&gt;3.) your flower girl dress soooo cute.&lt;\/p&gt; &lt;p&gt;4.) Your groomsmen gifts- awesome little box there&lt;\/p&gt; &lt;p&gt;5.) Your simple but casual laid back elegance style&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;That is all haha congrats your wedding looked like such a great time.&lt;\/p&gt;","Attachments":[],"Id":1817579,"PostDate":1385749981,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div class=\"quote-container\" data-huddler-embed=\"\/t\/85114\/now-larimar-2014-brides\/200#post_1965621\" data-huddler-embed-placeholder=\"false\">Quote: <div class=\"quote-block\">Originally Posted by <strong>meganjune<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> \u00a0 <p>Hey all,<\/p> <p>\u00a0<\/p> <p>We got married just over a month ago at Now and it was absolutely amazing. Please feel free to ask if you have any questions, I've put the link to our photographers blog with her first round of our pictures.<\/p> <p>\u00a0<\/p> <p>Congratulations and best of luck to all of you!<\/p> <p>\u00a0<\/p> <p>http:\/\/www.kellyginnphotography.com\/megancody-a-punta-cana-dominican-republic-wedding\/<\/p> <\/div> <\/div> <p>\u00a0<\/p> <p>Megan- So much to love about your wedding. You guys are a handsome couple. I love:<\/p> <p>1) Your pop of something blue hydrangea bouquet and your bridesmaids calla lillies- my two favorite flowers.<\/p> <p>2) You playing volleyball in your dress- adorable<\/p> <p>3.) your flower girl dress soooo cute.<\/p> <p>4.) Your groomsmen gifts- awesome little box there<\/p> <p>5.) Your simple but casual laid back elegance style<\/p> <p>\u00a0<\/p> <p>That is all haha congrats your wedding looked like such a great time.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Happily married to the love of my life- since July 5, 2013<\/span><\/div><\/div>","Email":"evelynlvazquez@gmail.com","IpAddress":"165.155.200.66","GroupId":3,"GroupName":"Member","JoinDate":1343665762,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-258580.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"EVKnowsitall","Id":258580,"Name":"EVKnowsitall","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4c43d90664ebc7ee2185f7801178d85f","RawContent":"Your photos are beautiful. I can&#039;t help but notice, is that another wedding going on at the same time as yours? On the beach you can see a whole other wedding set up. That makes me nervous, as I am getting married on the beach as well.","Attachments":[],"Id":1817953,"PostDate":1386018080,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Your photos are beautiful. I can't help but notice, is that another wedding going on at the same time as yours? On the beach you can see a whole other wedding set up. That makes me nervous, as I am getting married on the beach as well.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Ehartzke@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1386016939,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275450.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"EJB2014","Id":275450,"Name":"EJB2014","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"95d57bf3ef2dd6ce5a05b4822633cd85","RawContent":"We are getting married jan 16 on the beach, any of you ladies at the resort on this day?","Attachments":[],"Id":1817954,"PostDate":1386018341,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We are getting married jan 16 on the beach, any of you ladies at the resort on this day?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Ehartzke@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1386016939,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275450.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"EJB2014","Id":275450,"Name":"EJB2014","IsOnline":false}}],"Pages":{"TotalItems":465,"TotalPages":47,"CurrentPage":220,"NextPage":230,"PreviousPage":210,"LastPage":460},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
