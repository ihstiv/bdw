oWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.53.254.39","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79983,"EditedBy":"<strong>Edited by snswedding2016, 08 March 2016 - 11:01 AM.<\/strong>","EditDate":1457434882,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"d4190d455ad4af8b5b3a5dc6b11032e0","RawContent":"&lt;p&gt;@[member=\"perianjay\"] the rental through lomas was crazy expensive for lights and I found a good black friday deal. Actually they were the first things I purchased for the wedding! LOL! They worked out perfectly! I planned for 3 strands and had one extra just in case. :)&lt;\/p&gt;","Attachments":[],"Id":1911652,"PostDate":1457434862,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"281478\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281478-perianjay\/' title='Member profile'><span itemprop=\"name\">perianjay<\/span><\/a> the rental through lomas was crazy expensive for lights and I found a good black friday deal. Actually they were the first things I purchased for the wedding! LOL! They worked out perfectly! I planned for 3 strands and had one extra just in case. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>My planning thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78916-snswedding2016-planning-thread-jan-9-2016-azul-fives\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78916-snswedding2016-planning-thread-jan-9-2016-azul-fives\/<\/a><\/p>\n<p>\u00a0<\/p>\n<div><a class='bbc_url' href='http:\/\/www.TickerFactory.com\/'><\/div>\n<div><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10730;0\/st\/20160109\/e\/Our+Wedding\/k\/9fa9\/event.png\" alt=\"event.png\"><\/div>\n<div><\/a><\/div>\n","Email":"sean.n.steph2016@gmail.com","IpAddress":"74.12.52.42","GroupId":3,"GroupName":"Member","JoinDate":1415529511,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281055.jpg?_r=1455040720","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"snswedding2016","Id":281055,"Name":"snswedding2016","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.142.4.206","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79983,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"c2b4bebe88ca0be1417ac90cfb97d28e","RawContent":"&lt;p&gt;That&#039;s amazing. I wanted the draped string light style, but LatinAsia and Zuniga were crazy expensive too. My lighting still worked out but the extra lighting would have been great. What a great idea to bring them yourself!&lt;\/p&gt;","Attachments":[],"Id":1911653,"PostDate":1457435971,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>That's amazing. I wanted the draped string light style, but LatinAsia and Zuniga were crazy expensive too. My lighting still worked out but the extra lighting would have been great. What a great idea to bring them yourself!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419419814,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1453235488","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.53.254.39","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79983,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"b44cd291c14095b0b325237ee162023d","RawContent":"&lt;p&gt;@[member=\"perianjay\"] your lighting was gorgeous! If you ever renew your vows and need string lights...you know where to find me! ;)&amp;nbsp; We also thought they would be nice to have for our deck for summer BBQs or random parties. :)&lt;\/p&gt;","Attachments":[],"Id":1911654,"PostDate":1457437521,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"281478\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281478-perianjay\/' title='Member profile'><span itemprop=\"name\">perianjay<\/span><\/a> your lighting was gorgeous! If you ever renew your vows and need string lights...you know where to find me! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/>\u00a0 We also thought they would be nice to have for our deck for summer BBQs or random parties. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>My planning thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78916-snswedding2016-planning-thread-jan-9-2016-azul-fives\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78916-snswedding2016-planning-thread-jan-9-2016-azul-fives\/<\/a><\/p>\n<p>\u00a0<\/p>\n<div><a class='bbc_url' href='http:\/\/www.TickerFactory.com\/'><\/div>\n<div><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10730;0\/st\/20160109\/e\/Our+Wedding\/k\/9fa9\/event.png\" alt=\"event.png\"><\/div>\n<div><\/a><\/div>\n","Email":"sean.n.steph2016@gmail.com","IpAddress":"74.12.52.42","GroupId":3,"GroupName":"Member","JoinDate":1415529511,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281055.jpg?_r=1455040720","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"snswedding2016","Id":281055,"Name":"snswedding2016","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.5.52.216","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79983,"EditedBy":"<strong>Edited by nkavanaugh, 08 March 2016 - 03:02 PM.<\/strong>","EditDate":1457449333,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ca4c1a2e5fd06de0c2ecaefaf04ea48e","RawContent":"&lt;p&gt;@[member=\"snswedding2016\"] would you be willing to ship the alcohol sign? Its adorable! I would take the Mr &amp;amp; Mrs signs too!&lt;\/p&gt;","Attachments":[],"Id":1911658,"PostDate":1457449201,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"281055\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281055-snswedding2016\/' title='Member profile'><span itemprop=\"name\">snswedding2016<\/span><\/a> would you be willing to ship the alcohol sign? Its adorable! I would take the Mr & Mrs signs too!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><a class='bbc_url' href='http:\/\/www.TickerFactory.com\/'><br><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;116\/st\/20160503\/e\/Our+Wedding\/k\/03f6\/event.png\" alt=\"event.png\"><br><\/a><br>\u00a0","Email":"nkavanaugh@bayshore.ca","IpAddress":"174.