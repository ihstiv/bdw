ml>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hello All! Back from our site visit\/stay at NOW and were able to view Jellyfish and meet with Daniel from La Barcaza I will write a review hopefully in the next 2\/3 days. If you have any questions feel free to ask!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"May 01, 2015- complete!! 73 guests+bride & groom! Now Larimar Punta Cana! ","Email":"cooper.tyshelle@gmail.com","IpAddress":"108.50.56.179","GroupId":40,"GroupName":"Jr. Member","JoinDate":1375995069,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272393.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"DR2015","Id":272393,"Name":"DR2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d1c98ec87f9ec3d783b16cc12e783be8","RawContent":"&lt;p&gt;Hi, I am wondering if anyone knows the Diameter of the large round tables they use at the receptions? I&#039;m trying to have table runners made, Is anyone else thinking of doing this?&lt;\/p&gt;","Attachments":[],"Id":1799572,"PostDate":1378986529,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi, I am wondering if anyone knows the Diameter of the large round tables they use at the receptions? I'm trying to have table runners made, Is anyone else thinking of doing this?<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"amanda.kemp@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1365686804,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268451.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"amanda15012014","Id":268451,"Name":"amanda15012014","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ecb3b5633ae4740e648fe014bdf490e4","RawContent":"I bought my runners from ebay for about a dollar each and same for sashes! A girl i know got married at the now and had bought the same runners that i bought which are 9 feet long and they were the right lenght! Hopefully nothing has changed since!!!","Attachments":[],"Id":1799699,"PostDate":1379003619,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I bought my runners from ebay for about a dollar each and same for sashes! A girl i know got married at the now and had bought the same runners that i bought which are 9 feet long and they were the right lenght! Hopefully nothing has changed since!!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mjouellette0@hotmail.com","IpAddress":"174.118.194.63","GroupId":39,"GroupName":"Newbie","JoinDate":1361218226,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-266253.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"MJ Ouellette","Id":266253,"Name":"MJ Ouellette","IsOnline":false}}],"Pages":{"TotalItems":465,"TotalPages":47,"CurrentPage":160,"NextPage":170,"PreviousPage":150,"LastPage":460},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
