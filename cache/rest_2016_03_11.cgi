Request Time: 0 seconds
{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"31866c1d9752aa3ae984f094a6769e56","RawContent":"I have the Divine Package as well. MAC seems to be a good product for makeup so I&#039;m not worried there. I am worried about the stylist&#039;s experience with my hair texture though! LOL. My sister, who&#039;s also a hair stylist, is my Maid of Honor. I think I&#039;m going to assign this as one of her duties!","Attachments":[],"Id":1791250,"PostDate":1376471103,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I have the Divine Package as well. MAC seems to be a good product for makeup so I'm not worried there. I am worried about the stylist's experience with my hair texture though! LOL. My sister, who's also a hair stylist, is my Maid of Honor. I think I'm going to assign this as one of her duties!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"drenna@gmail.com","IpAddress":"67.167.198.72","GroupId":47,"GroupName":"Site Supporter","JoinDate":1371505464,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270677.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":124,"PhotoType":"custom"},"FormattedName":"duchovny0901","Id":270677,"Name":"duchovny0901","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2c0dcbebe79b04c6e87048e794caa2eb","RawContent":"&lt;p&gt; Hello Ladies!!!! I hope wedding planning is going well! I am confirmed for 12\/13\/14 at 3pm and my wedding coordinator is also Luisa Miranda. She took a while to send me paperwork but so far so good. I want to let you ladies know I will actually be taking a trip to Now Larimar end of September. I will take some pics and post them and also let you know what I thought about the resort.&lt;\/p&gt;","Attachments":[],"Id":1791294,"PostDate":1376476965,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hello Ladies!!!! I hope wedding planning is going well! I am confirmed for 12\/13\/14 at 3pm and my wedding coordinator is also Luisa Miranda. She took a while to send me paperwork but so far so good. I want to let you ladies know I will actually be taking a trip to Now Larimar end of September. I will take some pics and post them and also let you know what I thought about the resort.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"vgarcia0788@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1368986102,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-269745.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"bride473473","Id":269745,"Name":"bride473473","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bf860fd92ad6792fbe835de86260d826","RawContent":"[quote]\nOriginally Posted by [b]bethlorentz[\/b] \/img\/forum\/go_quote.gif\n \n \n @KatyaNova  Are you available 6\/6\/14?  If so, what are your rates to do \"get ready, ceremony, cocktail hour, 1 hour of reception\" (feel free to PM me those)  Thanks!!![\/quote] \n Hey Beth! Yes, we&#039;re still open on June 6 2014 and would be thrilled to document your Big Day! please email us at katya@katyanova.com with details and we&#039;ll send you more info! xoxoxo","Attachments":[],"Id":1791408,"PostDate":1376490899,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>bethlorentz<\/strong>\u00a0<a href='\/t\/85114\/now-larimar-2014-brides\/120#post_1935102' class='bbc_url' title='External link' rel='nofollow external'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/a><br \/> <br \/> <p> @KatyaNova \u00a0Are you available 6\/6\/14? \u00a0If so, what are your rates to do \"get ready, ceremony, cocktail hour, 1 hour of reception\" (feel free to PM me those) \u00a0Thanks!!!<\/p> <\/blockquote> <p> Hey Beth! Yes, we're still open on June 6 2014 and would be thrilled to document your Big Day! please email us at katya@katyanova.com with details and we'll send you more info! xoxoxo<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kzheleznova@yahoo.com","IpAddress":"61.19.236.122","GroupId":44,"GroupName":"Vendor","JoinDate":1261894145,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-224102.jpg?_r=0","PhotoWidth":180,"PhotoHeight":270,"PhotoType":"custom"},"FormattedName":"KatyaNova","Id":224102,"Name":"KatyaNova","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"eb43d6835866046c9d54a2a1c3a253f2","RawContent":"[quote]\nOriginally Posted by [b]KatyaNova[\/b] \/img\/forum\/go_quote.gif\n \n \n Hey Beth! Yes, we&#039;re still open on June 6 2014 and would be thrilled to document your Big Day! please email us at katya@katyanova.com with details and we&#039;ll send you more info! xoxoxo[\/quote] \n also - we offer to split the $500 fee with our couples :)","Attachments":[],"Id":1791410,"PostDate":1376491280,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>KatyaNova<\/strong>\u00a0<a href='\/t\/85114\/now-larimar-2014-brides\/130#post_1939478' class='bbc_url' title='External link' rel='nofollow external'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/a><br \/> <br \/> <p> Hey Beth! Yes, we're still open on June 6 2014 and would be thrilled to document your Big Day! please email us at katya@katyanova.com with details and we'll send you more info! xoxoxo<\/p> <\/blockquote> <p> also - we offer to split the $500 fee with our couples <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kzheleznova@yahoo.com","IpAddress":"61.19.236.122","GroupId":44,"GroupName":"Vendor","JoinDate":1261894145,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-224102.jpg?_r=0","PhotoWidth":180,"PhotoHeight":270,"PhotoType":"custom"},"FormattedName":"KatyaNova","Id":224102,"Name":"KatyaNova","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bb17a7372f6ce7052576a3d73a71866e","RawContent":"@futuredejesus that would be awesome. I am getting married at NOW July 12, 2014 and it makes me so nervous that I won&#039;t be able to see the resort beforehand.","Attachments":[],"Id":1791473,"PostDate":1376501504,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @futuredejesus that would be awesome. I am getting married at NOW July 12, 2014 and it makes me so nervous that I won't be able to see the resort beforehand.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"joneill85@gmail.com","IpAddress":"166.137.12.127","GroupId":39,"GroupName":"Newbie","JoinDate":1375040897,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-271994.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"foreverlove","Id":271994,"Name":"foreverlove","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"44d06b53ea55008821c1c315e5bf2a6e","RawContent":"Booked our site visit!!! Going the 2nd week in Sept, I will take LOTS of pics to post!!","Attachments":[],"Id":1792838,"PostDate":1376864258,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Booked our site visit!!! Going the 2nd week in Sept, I will take LOTS of pics to post!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"May 01, 2015- complete!! 73 guests+bride & groom! Now Larimar Punta Cana! ","Email":"cooper.tyshelle@gmail.com","IpAddress":"108.50.56.179","GroupId":40,"GroupName":"Jr. Member","JoinDate":1375995069,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272393.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"DR2015","Id":272393,"Name":"DR2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"203aceff6ac8adde66e8f819f314912d","RawContent":"&lt;p&gt; Thanks for the advice! &amp;nbsp;I am also torn on getting the wooden walkway, anyway you could send me that youtube video you saw???&lt;\/p&gt;","Attachments":[],"Id":1792885,"PostDate":1376897703,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Thanks for the advice! \u00a0I am also torn on getting the wooden walkway, anyway you could send me that youtube video you saw???<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bethlorentz@gmail.com","IpAddress":"97.88.29.129","GroupId":39,"GroupName":"Newbie","JoinDate":1375533315,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272212.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"bethlorentz","Id":272212,"Name":"bethlorentz","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"add4888ef4bafd5527570e97eda69235","RawContent":"&lt;p&gt; Congrats everyone!! It&#039;s so exciting to hear everyone&#039;s plans and get another opinion. Our wedding is Jan 28\/14. We are booked for a 3pm wedding at the fountain and a 6:30 pm reception on the beach. I am leaning towards getting the fountain setup ($1500), but it just seems so crazy for a 20 min ceremony. We are getting a dance floor for the beach reception, but just renting the sound system, so will play music off of an IPod instead of paying for a DJ. We are extending the ceremony for an hour, then heading to the Eclipse nightclub afterward!! We will have around 20 ppl there.&lt;\/p&gt; &lt;p&gt; For the day of the wedding I have rented the bridal suite, we have the Divine Package, so hair\/makeup is included. My bridesmaids and some family are going to get hair\/makeup done too! We are having an outside photographer, Karina Jensen, because photos are the most important part to me so I&#039;m willing to dish out the $500 vendor fee. Just have to work a little extra before the wedding!&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I&#039;ve been looking at wedding favours\/accessories and like so many things from The Knot.com, then I realized that they don&#039;t ship to Canada!!! Is anyone else using parasols for the bridal party\/pictures?? Or hand fans for the guests? I&#039;m wondering where to get them from now.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; My wedding planner was Silvia, and I just recently got an email saying it is now Yakayra. Before they switched I had been waiting for Silvia to check on availability of the judge for a legal ceremony. When they switched WC&#039;s I had to start all over again with this process and have not heard back from Yakayra. It&#039;s been over 2 months of waiting!! Any one else trying to arrange a legal ceremony???&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Thanks ladies!!&lt;\/p&gt;","Attachments":[],"Id":1793220,"PostDate":1376992595,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Congrats everyone!! It's so exciting to hear everyone's plans and get another opinion. Our wedding is Jan 28\/14. We are booked for a 3pm wedding at the fountain and a 6:30 pm reception on the beach. I am leaning towards getting the fountain setup ($1500), but it just seems so crazy for a 20 min ceremony. We are getting a dance floor for the beach reception, but just renting the sound system, so will play music off of an IPod instead of paying for a DJ. We are extending the ceremony for an hour, then heading to the Eclipse nightclub afterward!! We will have around 20 ppl there.<\/p> <p> For the day of the wedding I have rented the bridal suite, we have the Divine Package, so hair\/makeup is included. My bridesmaids and some family are going to get hair\/makeup done too! We are having an outside photographer, Karina Jensen, because photos are the most important part to me so I'm willing to dish out the $500 vendor fee. Just have to work a little extra before the wedding!<\/p> <p> \u00a0<\/p> <p> I've been looking at wedding favours\/accessories and like so many things from The Knot.com, then I realized that they don't ship to Canada!!! Is anyone else using parasols for the bridal party\/pictures?? Or hand fans for the guests? I'm wondering where to get them from now.<\/p> <p> \u00a0<\/p> <p> My wedding planner was Silvia, and I just recently got an email saying it is now Yakayra. Before they switched I had been waiting for Silvia to check on availability of the judge for a legal ceremony. When they switched WC's I had to start all over again with this process and have not heard back from Yakayra. It's been over 2 months of waiting!! Any one else trying to arrange a legal ceremony???<\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> Thanks ladies!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kristinasimms@hotmail.com","IpAddress":"68.150.70.86","GroupId":39,"GroupName":"Newbie","JoinDate":1357849978,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-264243.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Kristina Simms","Id":264243,"Name":"Kristina Simms","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"225b87d80c7f6cbd140e14669af778a6","RawContent":"I was reading on a general forum thread about site visits. Apparently this can be negotiated with the resorts. Has anyone done this or attempted to do this with Now? Did they offer you a free or reduced stay?","Attachments":[],"Id":1793544,"PostDate":1377085903,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I was reading on a general forum thread about site visits. Apparently this can be negotiated with the resorts. Has anyone done this or attempted to do this with Now? Did they offer you a free or reduced stay?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"drenna@gmail.com","IpAddress":"67.167.198.72","GroupId":47,"GroupName":"Site Supporter","JoinDate":1371505464,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270677.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":124,"PhotoType":"custom"},"FormattedName":"duchovny0901","Id":270677,"Name":"duchovny0901","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"393397e033834932581eb7a6b786ab12","RawContent":"&lt;p&gt; @Kristina Simms - Could you just have your items shipped directly to the resort???&lt;\/p&gt;","Attachments":[],"Id":1793663,"PostDate":1377116158,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> @Kristina Simms - Could you just have your items shipped directly to the resort???<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bethlorentz@gmail.com","IpAddress":"97.88.29.129","GroupId":39,"GroupName":"Newbie","JoinDate":1375533315,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272212.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"bethlorentz","Id":272212,"Name":"bethlorentz","IsOnline":false}}],"Pages":{"TotalItems":465,"TotalPages":47,"CurrentPage":150,"NextPage":160,"PreviousPage":140,"LastPage":460},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
