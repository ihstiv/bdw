=\"http:\/\/www.weddingcountdown.com\/\"><img src=\"http:\/\/img.weddingcountdown.com\/ticker\/30ag12yqu333h.png\" alt=\"30ag12yqu333h.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<\/div>\n<\/div>\n<p>\u00a0","Email":"shamicaglover@yahoo.com","IpAddress":"161.185.157.23","GroupId":40,"GroupName":"Jr. Member","JoinDate":1394115176,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277031.jpg?_r=1397251056","PhotoWidth":200,"PhotoHeight":203,"PhotoType":"custom"},"FormattedName":"MrandMrsBonitto2016","Id":277031,"Name":"MrandMrsBonitto2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"161.185.157.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7cac2eaef9f09cb64759116f8a085655","RawContent":"&lt;p&gt;Has any of the past brides used the salon services for hair and make-up?&lt;\/p&gt;","Attachments":[],"Id":1843637,"PostDate":1397124268,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Has any of the past brides used the salon services for hair and make-up?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p style=\"text-align:center;\">\u00a0 \u00a0 \u00a0 \u00a0 \u00a0 Future Mrs. Bonitto 12\/14\/16<\/p>\n<div><br><div style=\"text-align:center;\"><br><div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.weddingcountdown.com\/\"><img src=\"http:\/\/img.weddingcountdown.com\/ticker\/30ag12yqu333h.png\" alt=\"30ag12yqu333h.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<\/div>\n<\/div>\n<p>\u00a0","Email":"shamicaglover@yahoo.com","IpAddress":"161.185.157.23","GroupId":40,"GroupName":"Jr. Member","JoinDate":1394115176,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277031.jpg?_r=1397251056","PhotoWidth":200,"PhotoHeight":203,"PhotoType":"custom"},"FormattedName":"MrandMrsBonitto2016","Id":277031,"Name":"MrandMrsBonitto2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"152.216.3.5","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"77c7ba49ae5cdc4654471e5acf65ebb0","RawContent":"&lt;p&gt;@[member=\"Danamarielouise\"] After I found out who my coordinator was (which was listed in the date\/time confirmation email), I emailed her as soon as I received it just to introduce myself and ask some questions. She sent me a response the next day with answers to my questions and a spreadsheet detailing the cost for additional items.&lt;\/p&gt;","Attachments":[],"Id":1843662,"PostDate":1397127401,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"276863\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/276863-danamarielouise\/' title='Member profile'><span itemprop=\"name\">Danamarielouise<\/span><\/a> After I found out who my coordinator was (which was listed in the date\/time confirmation email), I emailed her as soon as I received it just to introduce myself and ask some questions. She sent me a response the next day with answers to my questions and a spreadsheet detailing the cost for additional items.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"drenna@gmail.com","IpAddress":"67.167.198.72","GroupId":47,"GroupName":"Site Supporter","JoinDate":1371505464,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270677.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":124,"PhotoType":"custom"},"FormattedName":"duchovny0901","Id":270677,"Name":"duchovny0901","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.231.234.250","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"aed88c0a4676e8d91950acbc6d85c63e","RawContent":"Thanks @[member=\"duchovny0901\"]!","Attachments":[],"Id":1843806,"PostDate":1397151495,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks @<a hovercard-ref=\"member\" hovercard-id=\"270677\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/270677-duchovny0901\/' title='Member profile'><span itemprop=\"name\">duchovny0901<\/span><\/a>!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"danamarielouise@hotmail.com","IpAddress":"24.89.226.42","GroupId":39,"GroupName":"Newbie","JoinDate":1393257767,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Danamarielouise","Id":276863,"Name":"Danamarielouise","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.150.10.92","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a65ac0ad5a04588ebfd3b8e7d556062c","RawContent":"Hello Ladies,\n\nI&#039;m a newbie on this forum. My wedding is on Oct. 28, 2014 at Now Larimar and i must say, what a great help it is to read your comments and suggestions!! Thank you to all the brides who posted their description and the pictures of their wedding day.\n\nI have a question, has anyone booked their reception at Carnival Terrace (its on the Secrets Resort side and can be used for reception)? Any reviews? \n\nIs anyone making the Welcome Bags or the Out of Town bags? What are you putting in there?\n\nThanks :)\n[quote name=\"Bellaezra\" post=\"1842376\" timestamp=\"1396577863\"]\nLooking for simple ideas for table decorations?   I think we have covered the decorations for the beach ceremony, but i am struggling with what to do for the beach reception.  Have any of you seen pictures for a beach reception?    BTW, for any bride getting married there after 7\/25\/14, i will have several decorations that I can leave behind with the wedding coordinator.  My mom is a florist and she is doing the silk flower \"balls\" that hang on the  shepherd hooks that go along the isle for the ceremony.   They are different shades of coral.[\/quote]\n\nI would love to see the decorations that your mother will make. My colors are coral and fuchsia, and i was thinking of getting flower balls\/pomanders. \nLooking forward to the pictures!","Attachments":[],"Id":1844218,"PostDate":1397442116,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello Ladies,<\/p>\n<p>\u00a0<\/p>\n<p>I'm a newbie on this forum. My wedding is on Oct. 28, 2014 at Now Larimar and i must say,\u00a0what a great help it is to read your comments and suggestions!! Thank you to all the brides who posted their description and the pictures of their wedding day.<\/p>\n<p>\u00a0<\/p>\n<p>I have a question, has anyone booked their reception at Carnival Terrace (its on the Secrets Resort side and can be used for reception)? Any reviews?\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Is anyone making the Welcome Bags or the Out of Town bags? What are you putting in there?<\/p>\n<p>\u00a0<\/p>\n<p>Thanks <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p><br \/><p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Bellaezra, on 03 April 2014 - 09:17 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Looking for simple ideas for table decorations? \u00a0 I think we have covered the decorations for the beach ceremony, but i am struggling with what to do for the beach reception. \u00a0Have any of you seen pictures for a beach reception? \u00a0 \u00a0BTW, for any bride getting married there after 7\/25\/14, i will have several decorations that I can leave behind with the wedding coordinator. \u00a0My mom is a florist and she is doing the silk flower \"balls\" that hang on the \u00a0shepherd hooks that go along the isle for the ceremony. \u00a0 They are different shades of coral.<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I would love to see the decorations that your mother will make. My colors are coral and fuchsia, and i was thinking of getting flower balls\/pomanders.\u00a0<\/p>\n<p>Looking forward to the pictures!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"polyrrhiza@gmail.com","IpAddress":"24.150.10.92","GroupId":39,"GroupName":"Newbie","JoinDate":1397440339,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"OctoberBride2014","Id":277586,"Name":"OctoberBride2014","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"152.216.3.5","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"01545e3fad62cdd30438b1ec0bfd1285","RawContent":"&lt;p&gt;@[member=\"OctoberBride2014\"] Congrats and welcome to the forum! I am making OOT bags for our guests. They&#039;ll be very simple: 1 bag per room and inside I&#039;ll have goodies for each guest in the room. This is including a 16oz tumbler, a room key holder w\/ bungie key ring, puzzle book, pens and hand sanitizer. I&#039;m also thinking about including a schedule of events for the wedding day, and putting a list of facts and things to do in Punta Cana. I think my TA is going to give the guests a welcome packet after all payments have been made in full for the rooms, so I&#039;m waiting to make sure&amp;nbsp;I don&#039;t duplicate anything she&#039;s sending out.&lt;\/p&gt;","Attachments":[],"Id":1844278,"PostDate":1397475948,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"277586\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/277586-octoberbride2014\/' title='Member profile'><span itemprop=\"name\">OctoberBride2014<\/span><\/a> Congrats and welcome to the forum! I am making OOT bags for our guests. They'll be very simple: 1 bag per room and inside I'll have goodies for each guest in the room. This is including a 16oz tumbler, a room key holder w\/ bungie key ring, puzzle book, pens and hand sanitizer. I'm also thinking about including a schedule of events for the wedding day, and putting a list of facts and things to do in Punta Cana. I think my TA is going to give the guests a welcome packet after all payments have been made in full for the rooms, so I'm waiting to make sure\u00a0I don't duplicate anything she's sending out.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"drenna@gmail.com","IpAddress":"67.167.198.72","GroupId":47,"GroupName":"Site Supporter","JoinDate":1371505464,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270677.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":124,"PhotoType":"custom"},"FormattedName":"duchovny0901","Id":270677,"Name":"duchovny0901","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.38.16.164","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"34e1c732c95970836c05990da6dd235b","RawContent":"&lt;p&gt;@[member=\"duchovny0901\"] &amp;nbsp;Thank you and thank you :)&lt;\/p&gt;\n&lt;p&gt;That welcome bag sounds very nice!! Thanks for the ideas!!&lt;\/p&gt;\n&lt;p&gt;What kind of room key holder is that? How different is it from a keychain? I assume that Now Larimar has a typical plastic card key, i didnt know there are key holders for them... I tired googling, and i&#039;m only getting keychains...&lt;\/p&gt;","Attachments":[],"Id":1845010,"PostDate":1397762109,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"270677\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/270677-duchovny0901\/' title='Member profile'><span itemprop=\"name\">duchovny0901<\/span><\/a> \u00a0Thank you and thank you <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>That welcome bag sounds very nice!! Thanks for the ideas!!<\/p>\n<p>What kind of room key holder is that? How different is it from a keychain? I assume that Now Larimar has a typical plastic card key, i didnt know there are key holders for them... I tired googling, and i'm only getting keychains...<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"polyrrhiza@gmail.com","IpAddress":"24.150.10.92","GroupId":39,"GroupName":"Newbie","JoinDate":1397440339,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"OctoberBride2014","Id":277586,"Name":"OctoberBride2014","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"67.167.198.72","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":1397993621,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3b098a07663f25ef8755461c934ec59d","RawContent":"&lt;p&gt;@[member=\"OctoberBride2014\"] No problem! They are actually clear ID Badge Holders that I got off of eBay. They have a&amp;nbsp;Ziploc top closure. &amp;nbsp;I got 100 for $15. Then I bought the bungie key ring cords to attach to them so the guests can keep them around their wrists as they&#039;re walking around. I&#039;ll try to figure out how to attach a picture!&lt;\/p&gt;","Attachments":[],"Id":1845273,"PostDate":1397993565,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"277586\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/277586-octoberbride2014\/' title='Member profile'><span itemprop=\"name\">OctoberBride2014<\/span><\/a> No problem! They are actually clear ID Badge Holders that I got off of eBay. They have a\u00a0Ziploc top closure. \u00a0I got 100 for $15. Then I bought the bungie key ring cords to attach to them so the guests can keep them around their wrists as they're walking around. I'll try to figure out how to attach a picture!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"drenna@gmail.com","IpAddress":"67.167.198.72","GroupId":47,"GroupName":"Site Supporter","JoinDate":1371505464,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270677.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":124,"PhotoType":"custom"},"FormattedName":"duchovny0901","Id":270677,"Name":"duchovny0901","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.50.56.179","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"29d1bac89aed32aa576a2741fbdfb403","RawContent":"[quote name=\"bethlorentz\" post=\"1836083\" timestamp=\"1393641792\"]\nHi ladies!!!  \n \nIt is so fun reading all of your posts.  Does anyone know how strict they are with their restaurant dress codes?  My guys are not too fond of wearing pants every night...\n \nAlso, did anyone have, or is anyone planning to have, a traditional long head table?  I want a long enough table for 14 people... is that unreasonable for a poolside reception?\n \nThank you!!!\n \nJune 6, 2014 wedding :)[\/quote]\n\nHello! And congrats!! Fianc\u00e9 and I went for a site visit in September and they were pretty flexible with the dress code at the carnival Buffett and seaside grille (cant remember the exact name).. However the steak house, Mexican, Asian, and French restaurants are\/were very adamant on men wearing long pants. Fianc\u00e9 was able to slide w\/ jeans at the Mexican restaurant but the French restaurant required your Sunday best!! \n[quote name=\"Kaiden1215\" post=\"1833916\" timestamp=\"1392568967\"]\nDid anyone receive the promo book 5 rooms get the 6th free? If so can you share how much your credit was?  (How many free rooms and for how many nights) Ex: 2 free rooms for 4 nights each. Total of 8 nights free.[\/quote]\nHello and congrats!!! \n\nWe did receive the promo, we actually booked 29 rooms and \"got 3 free\" and 3 \"upgrades\" we did not want to use the free because they were tropical view so we ended up being credited $1,866.","Attachments":[],"Id":1845289,"PostDate":1398015575,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>bethlorentz, on 28 February 2014 - 09:43 PM, said:<\/p><div class='blockquote'><div class='quote'><p>Hi ladies!!! \u00a0<br>\n\u00a0<br>\nIt is so fun reading all of your posts. \u00a0Does anyone know how strict they are with their restaurant dress codes? \u00a0My guys are not too fond of wearing pants every night...<br>\n\u00a0<br>\nAlso, did anyone have, or is anyone planning to have, a traditional long head table? \u00a0I want a long enough table for 14 people... is that unreasonable for a poolside reception?<br>\n\u00a0<br>\nThank you!!!<br>\n\u00a0<br>\nJune 6, 2014 wedding <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p><\/div><\/div>\n<br><br><br>\nHello! And congrats!! Fianc\u00e9 and I went for a site visit in September and they were pretty flexible with the dress code at the carnival Buffett and seaside grille (cant remember the exact name).. However the steak house, Mexican, Asian, and French restaurants are\/were very adamant on men wearing long pants. Fianc\u00e9 was able to slide w\/ jeans at the Mexican restaurant but the French restaurant required your Sunday best!! <br \/><p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Kaiden1215, on 16 February 2014 - 11:42 AM, said:<\/p><div class='blockquote'><div class='quote'><p>Did anyone receive the promo book 5 rooms get the 6th free? If so can you share how much your credit was?  (How many free rooms and for how many nights) Ex: 2 free rooms for 4 nights each. Total of 8 nights free.<\/p><\/div><\/div>\n<br><br>\nHello and congrats!!! <br><br>\nWe did receive the promo, we actually booked 29 rooms and \"got 3 free\" and 3 \"upgrades\" we did not want to use the free because they were tropical view so we ended up being credited $1,866.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"May 01, 2015- complete!! 73 guests+bride & groom! Now Larimar Punta Cana! ","Email":"cooper.tyshelle@gmail.com","IpAddress":"108.50.56.179","GroupId":40,"GroupName":"Jr. Member","JoinDate":1375995069,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272393.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"DR2015","Id":272393,"Name":"DR2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"152.216.3.5","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a56755ead0892904805dc4b8d33a9a61","RawContent":"&lt;p&gt;@[member=\"DR2015\"] I signed up for the same promo and have the same tropical view rooms for my guests! We don&#039;t want the free ones either; just the credit for the free ones.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;You received your credit already? I was told that they wait until you&#039;ve completed your stay and then credit your account. We already have 32 rooms reserved so far!&lt;\/p&gt;","Attachments":[],"Id":1845422,"PostDate":1398095012,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"272393\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/272393-dr2015\/' title='Member profile'><span itemprop=\"name\">DR2015<\/span><\/a> I signed up for the same promo and have the same tropical view rooms for my guests! We don't want the free ones either; just the credit for the free ones.<\/p>\n<p>\u00a0<\/p>\n<p>You received your credit already? I was told that they wait until you've completed your stay and then credit your account. We already have 32 rooms reserved so far!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"drenna@gmail.com","IpAddress":"67.167.198.72","GroupId":47,"GroupName":"Site Supporter","JoinDate":1371505464,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270677.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":124,"PhotoType":"custom"},"FormattedName":"duchovny0901","Id":270677,"Name":"duchovny0901","IsOnline":false}}],"Pages":{"TotalItems":465,"TotalPages":47,"CurrentPage":340,"NextPage":350,"PreviousPage":330,"LastPage":460},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
