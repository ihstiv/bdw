Request Time: 1 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":11,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":1567,"MovedTo":null,"MovedOn":0,"FirstPostId":1908147,"Rating":0,"RatingHits":0,"Starter":{"Id":285529,"Name":"mhogan","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1449423085,"LastPoster":{"Id":283685,"Name":"streelbride","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283685.jpg?_r=1437401496","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":43,"Preview":{"Id":1908147,"PostDate":1449423085,"PostContent":"Hello Ladies! \u00a0 My fiance and I have our wedding planned for April 2016 at the Grand Sunset Princ...","Author":{"Signature":"","Email":"hogan.marie@outlook.com","IpAddress":"205.206.78.135","GroupId":39,"GroupName":"Newbie","JoinDate":1449422672,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"mhogan","Id":285529,"Name":"mhogan","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"205.206.78.135","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79784,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"125b509aa81733ee4b1f3cf979484b2c","RawContent":"&lt;p&gt;Hello Ladies!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;My fiance and I have our wedding planned for April 2016 at the Grand Sunset Princess in the Mayan Riviera. We have the beach wedding organized along with the \"Chill Out Party\" for a more private post celebration.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;The package they sent me includes some floral arrangements for me to choose from but I am so unsure of what to expect on the day of the wedding! I want a white bouquet that looks classy.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I would love all the advice that I can get!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thank you!!&lt;\/p&gt;","Attachments":[],"Id":1908147,"PostDate":1449423085,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello Ladies!<\/p>\n<p>\u00a0<\/p>\n<p>My fiance and I have our wedding planned for April 2016 at the Grand Sunset Princess in the Mayan Riviera. We have the beach wedding organized along with the \"Chill Out Party\" for a more private post celebration.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>The package they sent me includes some floral arrangements for me to choose from but I am so unsure of what to expect on the day of the wedding! I want a white bouquet that looks classy.<\/p>\n<p>\u00a0<\/p>\n<p>I would love all the advice that I can get!<\/p>\n<p>\u00a0<\/p>\n<p>Thank you!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"hogan.marie@outlook.com","IpAddress":"205.206.78.135","GroupId":39,"GroupName":"Newbie","JoinDate":1449422672,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"mhogan","Id":285529,"Name":"mhogan","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.146.146.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79784,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"bbdb92bfcaf399f884b388c0ee95390e","RawContent":"&lt;p&gt;Welcome and congrats!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We had a recent bride from your resort -- her planning thread is here. You may find some useful info or even reach out to her with more questions!   &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/&#039;&gt;http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck!&lt;\/p&gt;","Attachments":[],"Id":1908154,"PostDate":1449447163,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome and congrats!<\/p>\n<p>\u00a0<\/p>\n<p>We had a recent bride from your resort -- her planning thread is here. You may find some useful info or even reach out to her with more questions! \u00a0\u00a0<a href='http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/' class='bbc_url' title=''>http:\/\/www.bestdesti...unset-princess\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Good luck!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399432202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.85.127.174","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79784,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5c7e24878cd9808c4d51b5830ea4d8c3","RawContent":"We&#039;ve been to that resort and looked at it for our wedding but ended up elsewhere. The chill out party area is a really cool set up (forgive the pun). It&#039;s been a few years since we were there but feel free to ask me any questions and I&#039;ll try to help. We had a great stay there!\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1908159,"PostDate":1449474893,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We've been to that resort and looked at it for our wedding but ended up elsewhere. The chill out party area is a really cool set up (forgive the pun). It's been a few years since we were there but feel free to ask me any questions and I'll try to help. We had a great stay there!<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>- Erin<\/p>\n<p>\u00a0<\/p>\n<p>My planning thread:\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268'>http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268<\/a>","Email":"ekjzwedding@gmail.com","IpAddress":"24.85.127.174","GroupId":3,"GroupName":"Member","JoinDate":1417453045,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281283.jpg?_r=1428779369","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"vancouverpetunia","Id":281283,"Name":"vancouverpetunia","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"114.121.160.7","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79784,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7c57a4b24eddc23a3c66420b9af35029","RawContent":"&lt;p&gt;cngratz.. ya,, white it&#039;s clasy but it will look pale in outdoor party&lt;\/p&gt;\n&lt;p&gt;i think you need another colorful flower&lt;\/p&gt;","Attachments":[],"Id":1908163,"PostDate":1449491667,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>cngratz.. ya,, white it's clasy but it will look pale in outdoor party<\/p>\n<p>i think you need another colorful flower<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"samwillow39@gmail.com","IpAddress":"114.121.164.128","GroupId":39,"GroupName":"Newbie","JoinDate":1430668422,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282964.jpg?_r=1431149209","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"samwillow","Id":282964,"Name":"samwillow","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.15.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79784,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"66ae516866a141e1fb3b854d3b31e5fa","RawContent":"&lt;p&gt;@mhogan&amp;nbsp; Congrats and welcome!&amp;nbsp; @[member=\"calgarybride2015\"] has given you a great thread to look through. Her details are great and she also did the chill out. You&#039;ll find great info there. You could also do a search up top for other threads. It&#039;s a popular resort with ladies here so you&#039;ll find other info as well.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck!&lt;\/p&gt;","Attachments":[],"Id":1908184,"PostDate":1449522766,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@mhogan\u00a0 Congrats and welcome!\u00a0 @<a hovercard-ref=\"member\" hovercard-id=\"277873\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277873-calgarybride2015\/' title='Member profile'><span itemprop=\"name\">calgarybride2015<\/span><\/a> has given you a great thread to look through. Her details are great and she also did the chill out. You'll find great info there. You could also do a search up top for other threads. It's a popular resort with ladies here so you'll find other info as well.<\/p>\n<p>\u00a0<\/p>\n<p>Good luck!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span><\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/ann.chadwick.5\/media_set?set=a.10153262834771016.1073741828.569791015&type=3'><span style=\"color:#ff0099;\"><em>https:\/\/www.facebook.com\/ann.chadwick.5\/media_set?set=a.10153262834771016.1073741828.569791015&type=3<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/'><span style=\"color:#ff0099;\"><em>http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283462599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"162.218.125.132","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79784,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"88781a54616440a7d6f12dbb7e949ce5","RawContent":"&lt;p&gt;Hey MHogan,&lt;\/p&gt;\n&lt;p&gt;I&#039;m getting married at GSP in April too!!&amp;nbsp; How&#039;s your planning going?&amp;nbsp; We are getting married at the Sunset Gazebo and then reception on the beach.&amp;nbsp; However now I&#039;m leaning towards the chill out area!!&amp;nbsp; It looks so nice!&amp;nbsp; and i don&#039;t think my parents were that impressed with being in the sand for dinner.&amp;nbsp; I think it&#039;ll be fun.&amp;nbsp; The beach is why we&#039;re going to mexcio right?&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I picked the most basic package and will add on from there.&amp;nbsp; I didn&#039;t really trust the spa to do my hair and make up so I didn&#039;t bother getting a package that included that.&amp;nbsp; I did just book my hair and make up with Rose by Dahena.&amp;nbsp; Their prices are in pesos!&amp;nbsp; All of the other make up\/stylists I contacted only had prices in USD.&amp;nbsp; So the pesos is a huge cost savings!&amp;nbsp; And their portfolio is amazing!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Did you decide on your flowers?&amp;nbsp; I&#039;m going to get real touch flowers and then use the flowers from my bouquet in my package to put in vases as the centrepieces at the reception.&amp;nbsp; My bridesmaids flowers will be white peonies and their dresses are pink.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Glad to chat with another April bride.&amp;nbsp; It&#039;s coming up quick!&lt;\/p&gt;","Attachments":[],"Id":1909907,"PostDate":1453497955,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hey MHogan,<\/p>\n<p>I'm getting married at GSP in April too!!\u00a0 How's your planning going?\u00a0 We are getting married at the Sunset Gazebo and then reception on the beach.\u00a0 However now I'm leaning towards the chill out area!!\u00a0 It looks so nice!\u00a0 and i don't think my parents were that impressed with being in the sand for dinner.\u00a0 I think it'll be fun.\u00a0 The beach is why we're going to mexcio right?\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I picked the most basic package and will add on from there.\u00a0 I didn't really trust the spa to do my hair and make up so I didn't bother getting a package that included that.\u00a0 I did just book my hair and make up with Rose by Dahena.\u00a0 Their prices are in pesos!\u00a0 All of the other make up\/stylists I contacted only had prices in USD.\u00a0 So the pesos is a huge cost savings!\u00a0 And their portfolio is amazing!<\/p>\n<p>\u00a0<\/p>\n<p>Did you decide on your flowers?\u00a0 I'm going to get real touch flowers and then use the flowers from my bouquet in my package to put in vases as the centrepieces at the reception.\u00a0 My bridesmaids flowers will be white peonies and their dresses are pink.<\/p>\n<p>\u00a0<\/p>\n<p>Glad to chat with another April bride.\u00a0 It's coming up quick!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"seamusplusliv@gmail.com","IpAddress":"204.50.133.128","GroupId":39,"GroupName":"Newbie","JoinDate":1440835196,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"livf","Id":284605,"Name":"livf","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"156.57.195.91","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79784,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"c8446129b710c05cc2c833ca67ec90bc","RawContent":"&lt;p&gt;@[member=\"livf\"]&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;m getting married at GSP March 31st :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I\"m in the process of deciding what to do about my hair and make up. How are you doing the outside stylists? I know the resort doesn&#039;t allow outside vendors other than photographers (with a fee). Are you going to them or are you sneaking them on as \"guests\" with day passes? I&#039;m looking at that option lol. What are the Rose by Dehena prices like? I&#039;m still comparing. The american dollar is killing my budget :P&lt;\/p&gt;","Attachments":[],"Id":1909957,"PostDate":1453652322,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"284605\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/284605-livf\/' title='Member profile'><span itemprop=\"name\">livf<\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>I'm getting married at GSP March 31st <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>I\"m in the process of deciding what to do about my hair and make up. How are you doing the outside stylists? I know the resort doesn't allow outside vendors other than photographers (with a fee). Are you going to them or are you sneaking them on as \"guests\" with day passes? I'm looking at that option lol. What are the Rose by Dehena prices like? I'm still comparing. The american dollar is killing my budget <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/tongue.png' class='bbc_emoticon' alt=':P' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sarah_e_collier@hotmail.com","IpAddress":"142.176.60.154","GroupId":39,"GroupName":"Newbie","JoinDate":1435244162,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283685.jpg?_r=1437401496","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"streelbride","Id":283685,"Name":"streelbride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"162.218.125.132","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79784,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"71d65d3d2e115b1f3195d480ea0e22a9","RawContent":"&lt;p&gt;@[member=\"streelbride\"] the prices at Rose by Dahena were by far the best!&amp;nbsp; I must&#039;ve emailed a dozen.&amp;nbsp; And esp since their prices are in pesos, you can&#039;t beat it.&amp;nbsp; I asked other make up\/hair stylists if they would provide prices in pesos.&amp;nbsp; Majority said no, only USD.&amp;nbsp; Their prices are a little more than the resort&#039;s spa...but they&#039;re professionals and prices include airbrushing.&amp;nbsp; AND they have a salon in PDC so they&#039;re a 10minute taxi ride away.&amp;nbsp; Just send them an email...let them know you talked to me (Livia).&amp;nbsp; They&#039;ll send you their price list but then just let them know your budget and they&#039;ll definitely work with you to stay in your budget.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;For a photog I&#039;m using Victor Herrera (&lt;a href=\"http:\/\/www.victorherrera.com.mx\/).%C2\"&gt;&lt;\/a&gt; I love his portfolio.&amp;nbsp; and he gave me the best price 8hrs that included a trash the dress session the next day in Playa Del Carmen, the beach there and a cenote.&amp;nbsp; I&#039;m paying the external vendor fee for him.&amp;nbsp; I think it&#039;d be obvious he wasn&#039;t a guest...a local w\/ a big camera.&amp;nbsp; Again I emailed soooo many photogs in Canada and in Mexico.&amp;nbsp; The Canadian photogs I liked didn&#039;t want to go for the whole 7 days (so I couldn&#039;t benefit from my group rate) or they wanted two of them to go....and then you have to pay for their rates.&amp;nbsp; I just couldn&#039;t make it work.&amp;nbsp; Again, email him and let him know you heard about him from me.&amp;nbsp; He was pretty responsive to all my requests and worked out a good price for me. &lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I agree the USD is brutal.&amp;nbsp; Anything that I can pay in CAD or pesos I&#039;m taking advantage of.&amp;nbsp; The resort won&#039;t budge though.&amp;nbsp; What gazebo\/reception did you book???&lt;\/p&gt;","Attachments":[],"Id":1910105,"PostDate":1453873239,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"283685\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/283685-streelbride\/' title='Member profile'><span itemprop=\"name\">streelbride<\/span><\/a> the prices at Rose by Dahena were by far the best!\u00a0 I must've emailed a dozen.\u00a0 And esp since their prices are in pesos, you can't beat it.\u00a0 I asked other make up\/hair stylists if they would provide prices in pesos.\u00a0 Majority said no, only USD.\u00a0 Their prices are a little more than the resort's spa...but they're professionals and prices include airbrushing.\u00a0 AND they have a salon in PDC so they're a 10minute taxi ride away.\u00a0 Just send them an email...let them know you talked to me (Livia).\u00a0 They'll send you their price list but then just let them know your budget and they'll definitely work with you to stay in your budget.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>For a photog I'm using Victor Herrera (<a href=\"http:\/\/www.victorherrera.com.mx\/).%C2\"><\/a> I love his portfolio.\u00a0 and he gave me the best price 8hrs that included a trash the dress session the next day in Playa Del Carmen, the beach there and a cenote.\u00a0 I'm paying the external vendor fee for him.\u00a0 I think it'd be obvious he wasn't a guest...a local w\/ a big camera.\u00a0 Again I emailed soooo many photogs in Canada and in Mexico.\u00a0 The Canadian photogs I liked didn't want to go for the whole 7 days (so I couldn't benefit from my group rate) or they wanted two of them to go....and then you have to pay for their rates.\u00a0 I just couldn't make it work.\u00a0 Again, email him and let him know you heard about him from me.\u00a0 He was pretty responsive to all my requests and worked out a good price for me. <\/p>\n<p>\u00a0<\/p>\n<p>I agree the USD is brutal.\u00a0 Anything that I can pay in CAD or pesos I'm taking advantage of.\u00a0 The resort won't budge though.\u00a0 What gazebo\/reception did you book???<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"seamusplusliv@gmail.com","IpAddress":"204.50.133.128","GroupId":39,"GroupName":"Newbie","JoinDate":1440835196,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"livf","Id":284605,"Name":"livf","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"156.57.195.91","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79784,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"dca2a7f90199e4945f162ed5f98965dd","RawContent":"&lt;p&gt;@[member=\"livf\"]&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I will email Rose by Dahena today to see if they have any availability for my date. I was looking for someone with a salon in PDC so I would have somewhere to go and not be stuck paying a day pass for someone on top of US rates.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;m using Dean Sanderson for my photographer. He is in US $ though which is killing me, every time the dollar goes down I want to cry. He does great work though and he was very easy to get in touch with and set everything up.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We&#039;re using the Riviera Gazebo and having a beach cocktail reception with the DJ. We are having our dinner in a reserved section of the buffet because a lot of my crowd including myself and my FI have food allergies and we also have 7 children going so a set menu wouldn&#039;t work for us. I figured it&#039;s going to be chaos anyway with that many kids so I&#039;m not doing anything special for the eating part of things lol. I even told the photographer he didn&#039;t need to photograph it, which he said he&#039;d add some extra time in for that on the end for me, which was really nice.&lt;\/p&gt;\n&lt;p&gt;We&#039;re using our dinner that comes with the package for a rehearsal dinner the night before. I&#039;m just going to have family and the bridal party at that.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I can&#039;t believe how quickly time is going. I still have so much I need to get done :P&lt;\/p&gt;","Attachments":[],"Id":1910109,"PostDate":1453903904,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"284605\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/284605-livf\/' title='Member profile'><span itemprop=\"name\">livf<\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>I will email Rose by Dahena today to see if they have any availability for my date. I was looking for someone with a salon in PDC so I would have somewhere to go and not be stuck paying a day pass for someone on top of US rates.<\/p>\n<p>\u00a0<\/p>\n<p>I'm using Dean Sanderson for my photographer. He is in US $ though which is killing me, every time the dollar goes down I want to cry. He does great work though and he was very easy to get in touch with and set everything up.<\/p>\n<p>\u00a0<\/p>\n<p>We're using the Riviera Gazebo and having a beach cocktail reception with the DJ. We are having our dinner in a reserved section of the buffet because a lot of my crowd including myself and my FI have food allergies and we also have 7 children going so a set menu wouldn't work for us. I figured it's going to be chaos anyway with that many kids so I'm not doing anything special for the eating part of things lol. I even told the photographer he didn't need to photograph it, which he said he'd add some extra time in for that on the end for me, which was really nice.<\/p>\n<p>We're using our dinner that comes with the package for a rehearsal dinner the night before. I'm just going to have family and the bridal party at that.<\/p>\n<p>\u00a0<\/p>\n<p>I can't believe how quickly time is going. I still have so much I need to get done <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/tongue.png' class='bbc_emoticon' alt=':P' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sarah_e_collier@hotmail.com","IpAddress":"142.176.60.154","GroupId":39,"GroupName":"Newbie","JoinDate":1435244162,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283685.jpg?_r=1437401496","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"streelbride","Id":283685,"Name":"streelbride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"187.147.233.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79784,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"452a4de1d8b47270b6de503565584950","RawContent":"[quote name=\"livf\" post=\"1909907\" timestamp=\"1453494355\"]\nHey MHogan,\nI&#039;m getting married at GSP in April too!!  How&#039;s your planning going?  We are getting married at the Sunset Gazebo and then reception on the beach.  However now I&#039;m leaning towards the chill out area!!  It looks so nice!  and i don&#039;t think my parents were that impressed with being in the sand for dinner.  I think it&#039;ll be fun.  The beach is why we&#039;re going to mexcio right? \n\nI picked the most basic package and will add on from there.  I didn&#039;t really trust the spa to do my hair and make up so I didn&#039;t bother getting a package that included that.  I did just book my hair and make up with Rose by Dahena.  Their prices are in pesos!  All of the other make up\/stylists I contacted only had prices in USD.  So the pesos is a huge cost savings!  And their portfolio is amazing!\n\nDid you decide on your flowers?  I&#039;m going to get real touch flowers and then use the flowers from my bouquet in my package to put in vases as the centrepieces at the reception.  My bridesmaids flowers will be white peonies and their dresses are pink.\n\nGlad to chat with another April bride.  It&#039;s coming up quick![\/quote]Hi :) I am getting married in Riviera Maya or Cancun (haven&#039;t decided the place or hotel) but I am looking for the best vendors! I think the work better then the ones inside the hotels, Who was your florist?? thanks a lot!!!\n[quote name=\"livf\" post=\"1909907\" timestamp=\"1453494355\"]\nHey MHogan,\nI&#039;m getting married at GSP in April too!!  How&#039;s your planning going?  We are getting married at the Sunset Gazebo and then reception on the beach.  However now I&#039;m leaning towards the chill out area!!  It looks so nice!  and i don&#039;t think my parents were that impressed with being in the sand for dinner.  I think it&#039;ll be fun.  The beach is why we&#039;re going to mexcio right? \n\nI picked the most basic package and will add on from there.  I didn&#039;t really trust the spa to do my hair and make up so I didn&#039;t bother getting a package that included that.  I did just book my hair and make up with Rose by Dahena.  Their prices are in pesos!  All of the other make up\/stylists I contacted only had prices in USD.  So the pesos is a huge cost savings!  And their portfolio is amazing!\n\nDid you decide on your flowers?  I&#039;m going to get real touch flowers and then use the flowers from my bouquet in my package to put in vases as the centrepieces at the reception.  My bridesmaids flowers will be white peonies and their dresses are pink.\n\nGlad to chat with another April bride.  It&#039;s coming up quick![\/quote]Hey! Im getting married in this area, haven&#039;t decide the hotel yet! But im looking for the best florist!! i am all about flowers! I want to work with a vendor from outside, since they charge less and I feel better to have direct contact with them! PLEASE HELP ME","Attachments":[],"Id":1910671,"PostDate":1455063942,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>livf, on 22 January 2016 - 01:25 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hey MHogan,<\/p>\n<p>I'm getting married at GSP in April too!!\u00a0 How's your planning going?\u00a0 We are getting married at the Sunset Gazebo and then reception on the beach.\u00a0 However now I'm leaning towards the chill out area!!\u00a0 It looks so nice!\u00a0 and i don't think my parents were that impressed with being in the sand for dinner.\u00a0 I think it'll be fun.\u00a0 The beach is why we're going to mexcio right?\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I picked the most basic package and will add on from there.\u00a0 I didn't really trust the spa to do my hair and make up so I didn't bother getting a package that included that.\u00a0 I did just book my hair and make up with Rose by Dahena.\u00a0 Their prices are in pesos!\u00a0 All of the other make up\/stylists I contacted only had prices in USD.\u00a0 So the pesos is a huge cost savings!\u00a0 And their portfolio is amazing!<\/p>\n<p>\u00a0<\/p>\n<p>Did you decide on your flowers?\u00a0 I'm going to get real touch flowers and then use the flowers from my bouquet in my package to put in vases as the centrepieces at the reception.\u00a0 My bridesmaids flowers will be white peonies and their dresses are pink.<\/p>\n<p>\u00a0<\/p>\n<p>Glad to chat with another April bride.\u00a0 It's coming up quick!<\/p>\n<\/div>\n<\/div><\/div>\n<p>Hi <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> I am getting married in Riviera Maya or Cancun (haven't decided the place or hotel) but I am looking for the best vendors! I think the work better then the ones inside the hotels, Who was your florist?? thanks a lot!!!<\/p><br \/><p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>livf, on 22 January 2016 - 01:25 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hey MHogan,<\/p>\n<p>I'm getting married at GSP in April too!!\u00a0 How's your planning going?\u00a0 We are getting married at the Sunset Gazebo and then reception on the beach.\u00a0 However now I'm leaning towards the chill out area!!\u00a0 It looks so nice!\u00a0 and i don't think my parents were that impressed with being in the sand for dinner.\u00a0 I think it'll be fun.\u00a0 The beach is why we're going to mexcio right?\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I picked the most basic package and will add on from there.\u00a0 I didn't really trust the spa to do my hair and make up so I didn't bother getting a package that included that.\u00a0 I did just book my hair and make up with Rose by Dahena.\u00a0 Their prices are in pesos!\u00a0 All of the other make up\/stylists I contacted only had prices in USD.\u00a0 So the pesos is a huge cost savings!\u00a0 And their portfolio is amazing!<\/p>\n<p>\u00a0<\/p>\n<p>Did you decide on your flowers?\u00a0 I'm going to get real touch flowers and then use the flowers from my bouquet in my package to put in vases as the centrepieces at the reception.\u00a0 My bridesmaids flowers will be white peonies and their dresses are pink.<\/p>\n<p>\u00a0<\/p>\n<p>Glad to chat with another April bride.\u00a0 It's coming up quick!<\/p>\n<\/div>\n<\/div><\/div>\n<p>Hey! Im getting married in this area, haven't decide the hotel yet! But im looking for the best florist!! i am all about flowers! I want to work with a vendor from outside, since they charge less and I feel better to have direct contact with them! PLEASE HELP ME<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"engellandrea@gmail.com","IpAddress":"187.147.233.0","GroupId":39,"GroupName":"Newbie","JoinDate":1455040089,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"AndreaEngell","Id":286182,"Name":"AndreaEngell","IsOnline":false}}],"Id":"79784","Title":"Grand Sunset Princess Wedding April 2016","LastPostDate":1457573851},"Pages":{"TotalItems":11,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":1,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
