{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":6277,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"209feee23e945a7404053da7b5ca91b5","RawContent":"&lt;p&gt; Here are ours. Simple but I liked them!&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\" \" data-id=\"207020\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/207020\/width\/500\/height\/1000\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"LEAD Technologies Inc. V1.01 \" data-id=\"207014\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/207014\/width\/500\/height\/1000\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"LEAD Technologies Inc. V1.01 \" data-id=\"207012\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/207012\/width\/500\/height\/1000\" \/&gt;&lt;\/p&gt;","Attachments":[],"Id":1769578,"PostDate":1371511888,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Here are ours. Simple but I liked them!<\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"207020\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/207020\/width\/500\/height\/1000\" \/><\/span><\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"LEAD Technologies Inc. V1.01 \" data-id=\"207014\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/207014\/width\/500\/height\/1000\" \/><\/span><\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"LEAD Technologies Inc. V1.01 \" data-id=\"207012\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/207012\/width\/500\/height\/1000\" \/><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"alexismmoore@gmail.com","IpAddress":"108.231.22.147","GroupId":38,"GroupName":"Moderators","JoinDate":1337137161,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-255437.jpeg?_r=0","PhotoWidth":667,"PhotoHeight":1000,"PhotoType":"custom"},"FormattedName":"alexisinjamaica","Id":255437,"Name":"alexisinjamaica","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":6277,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"01471757111d8128f1ad626cf287a7c3","RawContent":"[quote]\nOriginally Posted by [b]Liann03[\/b] \/img\/forum\/go_quote.gif\n \n \n Gorgeous... I just can&#039;t travel with this for 8 tankes;([\/quote] \n \n So true :(","Attachments":[],"Id":1769732,"PostDate":1371570309,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>Liann03<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <br \/> Gorgeous... I just can't travel with this for 8 tankes;(<\/blockquote> <p> \u00a0<\/p> <p> So true <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/sad.png' class='bbc_emoticon' alt=':(' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"dubhreubel@gmail.com","IpAddress":"24.52.246.240","GroupId":40,"GroupName":"Jr. Member","JoinDate":1369140651,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-269805.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"StephLB","Id":269805,"Name":"StephLB","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":6277,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c8e43a17d597ad36be435eaf8067e057","RawContent":"[quote]\nOriginally Posted by [b]shan0487[\/b] \/img\/forum\/go_quote.gif\n \n \n I found one- these are really easy to make- let me know if you are intersted in making them! \n \n [img]http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/191817\/width\/350\/height\/700[\/img][\/quote] \n Hi [url=\"http:\/\/www.bestdestinationwedding.com\/u\/34576\/shan0487\"]shan0487[\/url] \n I will like to know where you found one and how to make it.","Attachments":[],"Id":1769854,"PostDate":1371581523,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>shan0487<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <p> I found one- these are really easy to make- let me know if you are intersted in making them!<\/p> <p> \u00a0<\/p> <p id=\"yui_3_7_3_1_1362407635505_1105\"> <span rel='lightbox'><img class='bbc_img' alt=\"ProcGalleryTrueAspectServlet (params=[sc=0&pa=0.5&sa=0&ry=1066&rx=1600&cr=0.0,0.0,1.0,1.0&nocredit=1&py=1066&px=1600&r=0&q=0&cb=16777215&p=1&ps=23&dsbg=221&po=0&g=2.2&bw=0.2&f=0&b=1&ph=65535&si=00409390326720130122023624285.JPG&gc=1&vtype=g] actions=[CachedCanvas (RawOrProxyraw(com.shutterfly.imaging.rendering.imageref.ReferenceManager$Ref@6d91f5d8, 1600) | FitToSize(java.awt.Dimension[width=1600,height=1066], 2) | ScaleRGB(1.0, 1.0, 1.0) | Sharpen(1.2999999523162842) | ShowPrint(java.awt.Dimension[width=1600,height=1066], 221, 1.0, 1.0, 1.0, 0, 0.800000011920929, 0.800000011920929, 0.800000011920929, 0) -> NativeCanvas(2AAAD507D7B0))]) PixSense Recompression: PX_COMP_STD 172.16.17.68 2013\/01\/29 07:06:59.185 \" data-id=\"191817\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/191817\/width\/350\/height\/700\" \/><\/span><\/p> <\/blockquote> <p> Hi\u00a0<a href='http:\/\/www.bestdestinationwedding.com\/u\/34576\/shan0487' class='bbc_url' title=''>shan0487<\/a><\/p> <p> I will like to know where you found one and how to make it.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"carolina.78.m@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1365619474,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268408.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"CarolinaM","Id":268408,"Name":"CarolinaM","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":6277,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5517e6b3b7815579e839785441ac3629","RawContent":"&lt;p&gt; I gave up on trying to make them and cart them over to DR. I just purchased them from the resort- 5 tables plus our sweetheart so 6 pieces, $85 each- $510. Ouch, but I don&#039;t have time to assemble or be creative and my mother insisted on fresh flowers. We are having blue hydrangeas in a clear glass vase with blue ribbons and blue crystals atop a mirror and tealight on the sides. Sounds like something I could have made myself, plus tea-lights will not hold on the beach but whatever. I am thinking about getting those miniature white lanterns to protect the tealights, I&#039;ve seen them in the craft stores and would only need 12- two for each table.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p id=\"yui_3_10_0_1_1371578149160_1420\"&gt; &lt;img alt=\" \" data-id=\"208947\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/208947\/width\/350\/height\/700\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I&#039;m told it will look something like this but with hydrangeas and we went with a larger size. I&#039;m thinking of combining the hyrangeas and white roses. My mom made my bouquet for my civil courthouse wedding day- I bought hydrangeas and roses from a supermarket, fabric tape and a handle cover. It came out gorgeous!&amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; The Bouquet my mom made for me:&amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p id=\"yui_3_10_0_1_1371578149160_2319\"&gt; &lt;img alt=\" \" data-id=\"208948\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/208948\/width\/350\/height\/700\" \/&gt;&lt;img alt=\" \" data-id=\"208949\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/208949\/width\/350\/height\/700\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I like the blend, I hope they can accommodate.&lt;\/p&gt;","Attachments":[],"Id":1769890,"PostDate":1371585105,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I gave up on trying to make them and cart them over to DR. I just purchased them from the resort- 5 tables plus our sweetheart so 6 pieces, $85 each- $510. Ouch, but I don't have time to assemble or be creative and my mother insisted on fresh flowers. We are having blue hydrangeas in a clear glass vase with blue ribbons and blue crystals atop a mirror and tealight on the sides. Sounds like something I could have made myself, plus tea-lights will not hold on the beach but whatever. I am thinking about getting those miniature white lanterns to protect the tealights, I've seen them in the craft stores and would only need 12- two for each table.<\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p id=\"yui_3_10_0_1_1371578149160_1420\"> <span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"208947\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/208947\/width\/350\/height\/700\" \/><\/span><\/p> <p> \u00a0<\/p> <p> I'm told it will look something like this but with hydrangeas and we went with a larger size. I'm thinking of combining the hyrangeas and white roses. My mom made my bouquet for my civil courthouse wedding day- I bought hydrangeas and roses from a supermarket, fabric tape and a handle cover. It came out gorgeous!\u00a0<\/p> <p> \u00a0<\/p> <p> The Bouquet my mom made for me:\u00a0<\/p> <p> \u00a0<\/p> <p id=\"yui_3_10_0_1_1371578149160_2319\"> <span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"208948\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/208948\/width\/350\/height\/700\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"208949\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/208949\/width\/350\/height\/700\" \/><\/span><\/p> <p> \u00a0<\/p> <p> I like the blend, I hope they can accommodate.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Happily married to the love of my life- since July 5, 2013<\/span><\/div><\/div>","Email":"evelynlvazquez@gmail.com","IpAddress":"165.155.200.66","GroupId":3,"GroupName":"Member","JoinDate":1343687362,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-258580.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"EVKnowsitall","Id":258580,"Name":"EVKnowsitall","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":6277,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cafdb5951723d929cbadd4fad3069bb9","RawContent":"&lt;p&gt; There are some amazing centerpieces on here!!!&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1769964,"PostDate":1371596258,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> There are some amazing centerpieces on here!!!\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"un4gitabl@yahoo.com","IpAddress":"24.173.185.134","GroupId":39,"GroupName":"Newbie","JoinDate":1351884072,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-262012.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"FormattedName":"un4gitabl","Id":262012,"Name":"un4gitabl","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":6277,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"49019a28ed034a15438c936bf9812836","RawContent":"[quote]\nOriginally Posted by [b]StephLB[\/b] \/img\/forum\/go_quote.gif\n \n \n I like these: \n \n \n \n I found them on Pinterest[img]http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/206217\/width\/350\/height\/700[\/img][\/quote] \n Cute","Attachments":[],"Id":1770016,"PostDate":1371607775,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>StephLB<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <p> I like these:<\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> I found them on Pinterest<span rel='lightbox'><img class='bbc_img' alt=\"\" data-id=\"206217\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/206217\/width\/350\/height\/700\" \/><\/span><\/p> <\/blockquote> <p> Cute<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"onelovesteph@aol.com","IpAddress":"98.204.119.203","GroupId":40,"GroupName":"Jr. Member","JoinDate":1364578870,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-267943.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"MsFaszion","Id":267943,"Name":"MsFaszion","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":6277,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"62b80f512c0fa08b262323001862a43c","RawContent":"Hi Carolina.  Send me a PM and I&#039;ll send you my instructions on how to make the starfish aisle decorations! :) \n \n shanna [quote]\nOriginally Posted by [b]CarolinaM[\/b] \/img\/forum\/go_quote.gif\n \n \n Hi [url=\"http:\/\/www.bestdestinationwedding.com\/u\/34576\/shan0487\"]shan0487[\/url] \n I will like to know where you found one and how to make it.[\/quote]","Attachments":[],"Id":1770133,"PostDate":1371652236,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hi Carolina.\u00a0 Send me a PM and I'll send you my instructions on how to make the starfish aisle decorations! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p> <p> \u00a0<\/p> <p> shanna<\/p> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>CarolinaM<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <p> Hi\u00a0<a href='http:\/\/www.bestdestinationwedding.com\/u\/34576\/shan0487' class='bbc_url' title=''>shan0487<\/a><\/p> <p> I will like to know where you found one and how to make it.<\/p> <\/blockquote>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"shanna0487@hotmail.com","IpAddress":"63.122.89.3","GroupId":42,"GroupName":"Sr. Member","JoinDate":1294263874,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-235127.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"shan0487","Id":235127,"Name":"shan0487","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":6277,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9b70637b4acdd6f5ca8fb8cc97eba6e6","RawContent":"&lt;p&gt; I&#039;m getting married in 13 months but I really like these lime and flower centerpieces , looking for something similar to it&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"\" data-id=\"209369\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/209369\/width\/350\/height\/700\" \/&gt;&lt;\/p&gt;","Attachments":[],"Id":1770973,"PostDate":1371806637,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I'm getting married in 13 months but I really like these lime and flower centerpieces , looking for something similar to it<\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"\" data-id=\"209369\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/209369\/width\/350\/height\/700\" \/><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"f2652771@rmqkr.net","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1371805823,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270800.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"fionaW","Id":270800,"Name":"fionaW","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":6277,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"86de871fe62036615f8ea18156c51a81","RawContent":"&lt;p&gt; Hey I love how you did this and would love to do it for my wedding since I am having a beach wedding. can I ask how did you set this up? what kind of light did you use, etc?&amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Thank You,&lt;\/p&gt; &lt;p&gt; Kayla&lt;\/p&gt;","Attachments":[],"Id":1771277,"PostDate":1371867212,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hey I love how you did this and would love to do it for my wedding since I am having a beach wedding. can I ask how did you set this up? what kind of light did you use, etc?\u00a0<\/p> <p> \u00a0<\/p> <p> Thank You,<\/p> <p> Kayla<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"vampire_kiss_21@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1371867122,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270825.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Vampirekiss21","Id":270825,"Name":"Vampirekiss21","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":6277,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"40f2ca2439910615726073af669f8876","RawContent":"&lt;p&gt; Loving all of the different ideas on here ladies! So many beautiful options. :)&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; For our wedding in Tulum last month we went with a rustic vintage style. For our flowers we used mismatched bottles of various sizes with roses and baby&#039;s breath. We also used two types of lanterns, bombillos in brass buckets (similar to the tops of oil lamps) and lots of tea lights in glass candle holders. Our tables were long rectangles, and I arranged it in such a way that all the tables looked balanced and put together, while still keeping the rustic mismatched look.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I collected the bottles myself, made the burlap and lace runners, and purchased the lanterns, bombillos and tea light holders from various places.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; All the photos are by Luckygirl Photography based out of Winnipeg, Canada, aside from the second one and the last two, which were taken by friends. - www.luckygirl.ca&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"Optimized by JPEGmini 3.8.8.2L 0x28c83e2a \" data-id=\"210191\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/210191\/width\/350\/height\/700\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p id=\"yui_3_10_0_1_1372218258452_4071\"&gt; &lt;img alt=\" \" data-id=\"210192\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/210192\/width\/350\/height\/700\" \/&gt;&amp;nbsp; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\" \" data-id=\"210188\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/210188\/width\/350\/height\/700\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p id=\"yui_3_10_0_1_1372218258452_5964\"&gt; &lt;img alt=\"Optimized by JPEGmini 3.8.8.2L 0x146bafa7 \" data-id=\"210194\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/210194\/width\/350\/height\/700\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\" \" data-id=\"210193\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/210193\/width\/350\/height\/700\" \/&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"* \" data-id=\"205949\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/205949\/width\/350\/height\/700\" \/&gt;&amp;nbsp; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;img alt=\"* \" data-id=\"206060\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/206060\/width\/350\/height\/700\" \/&gt;&lt;\/p&gt;","Attachments":[],"Id":1772485,"PostDate":1372223356,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Loving all of the different ideas on here ladies! So many beautiful options. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p> <p> \u00a0<\/p> <p> For our wedding in Tulum last month we went with a rustic vintage style. For our flowers we used mismatched bottles of various sizes with roses and baby's breath. We also used two types of lanterns, bombillos in brass buckets (similar to the tops of oil lamps) and lots of tea lights in glass candle holders. Our tables were long rectangles, and I arranged it in such a way that all the tables looked balanced and put together, while still keeping the rustic mismatched look.<\/p> <p> \u00a0<\/p> <p> I collected the bottles myself, made the burlap and lace runners, and purchased the lanterns, bombillos and tea light holders from various places.<\/p> <p> \u00a0<\/p> <p> All the photos are by Luckygirl Photography based out of Winnipeg, Canada, aside from the second one and the last two, which were taken by friends. - www.luckygirl.ca<\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"Optimized by JPEGmini 3.8.8.2L 0x28c83e2a \" data-id=\"210191\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/210191\/width\/350\/height\/700\" \/><\/span><\/p> <p> \u00a0<\/p> <p id=\"yui_3_10_0_1_1372218258452_4071\"> <span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"210192\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/210192\/width\/350\/height\/700\" \/><\/span>\u00a0 \u00a0<\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"210188\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/210188\/width\/350\/height\/700\" \/><\/span><\/p> <p> \u00a0<\/p> <p id=\"yui_3_10_0_1_1372218258452_5964\"> <span rel='lightbox'><img class='bbc_img' alt=\"Optimized by JPEGmini 3.8.8.2L 0x146bafa7 \" data-id=\"210194\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/210194\/width\/350\/height\/700\" \/><\/span><\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"210193\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/210193\/width\/350\/height\/700\" \/><\/span><\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"* \" data-id=\"205949\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/205949\/width\/350\/height\/700\" \/><\/span>\u00a0 \u00a0<\/p> <p> \u00a0<\/p> <p> <span rel='lightbox'><img class='bbc_img' alt=\"* \" data-id=\"206060\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/206060\/width\/350\/height\/700\" \/><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<span style='font-family: georgia'><span style='font-size: 18px;'>Are you interested in an affordable decor rental in the Mayan Riviera, Mexico? Send me a message! Most of the items I have are a rustic, vintage style. <br \/>\n<br \/>\nAnd the Next Day, We Were Married: <a class='bbc_url' href='http:\/\/www.luckygirl.ca\/blog\/katy-mikee-e-session'>http:\/\/www.luckygirl.ca\/blog\/katy-mikee-e-session<\/a><br \/>\nOur Tulum Wedding - Parte Uno: <a class='bbc_url' href='http:\/\/www.luckygirl.ca\/blog\/hk-wedding-fiesta-parte-uno'>http:\/\/www.luckygirl.ca\/blog\/hk-wedding-fiesta-parte-uno<\/a><br \/>\nOur Tulum Wedding - Parte Dos: <a class='bbc_url' href='http:\/\/www.luckygirl.ca\/blog\/hk-wedding-fiesta-parte-dos'>http:\/\/www.luckygirl.ca\/blog\/hk-wedding-fiesta-parte-dos<\/a><\/span><\/span><br \/>\n<span style='font-family: georgia'><span style='font-size: 18px;'>Tulum Wedding Video: <a class='bbc_url' href='http:\/\/loveandrum.com\/blog\/2014\/1\/7\/marriage-now-on-video-katy-mikee-hk'>http:\/\/loveandrum.com\/blog\/2014\/1\/7\/marriage-now-on-video-katy-mikee-hk<\/a><\/span><\/span><br \/>\n<span style='font-family: georgia'><span style='font-size: 18px;'>Anniversary! One Year Later: <a class='bbc_url' href='http:\/\/www.luckygirl.ca\/blog\/2014\/5\/21\/katy-mikee-in-valladolid-mexico'>http:\/\/www.luckygirl.ca\/blog\/2014\/5\/21\/katy-mikee-in-valladolid-mexico<\/a><\/span><\/span>","Email":"katy@loveandrum.com","IpAddress":"189.221.248.185","GroupId":44,"GroupName":"Vendor","JoinDate":1294276373,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-235138.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"MrsHK","Id":235138,"Name":"MrsHK","IsOnline":false}}],"Pages":{"TotalItems":1355,"TotalPages":136,"CurrentPage":1280,"NextPage":1290,"PreviousPage":1270,"LastPage":1350},"PushNotifications":[{"Key":"notifications","Value":1,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
