 Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>check out www.mylushwedding.com\/ bridesmaids section <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nnalanbar@gmail.com","IpAddress":"41.34.30.23","GroupId":39,"GroupName":"Newbie","JoinDate":1416355821,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281202.jpg?_r=1416915382","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"mylushwedding","Id":281202,"Name":"mylushwedding","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.101.83.185","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78395,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"d9d6229007ef0515cb1c927c1ba1a06a","RawContent":"[quote name=\"TiffanyMC\" post=\"1878631\" timestamp=\"1416286521\"]\nWhat styles\/colors are your bm&#039;s wearing?\n\nMy MOH will wear: [url=\"http:\/\/www.weddingtonway.com\/products\/alfred-angelo-7243s-bridesmaid-dress?&amp;amp;sku=aa-7243s-pomegranate\"]http:\/\/www.weddingtonway.com\/products\/alfred-angelo-7243s-bridesmaid-dress?&amp;amp;sku=aa-7243s-pomegranate[\/url]\nin pomegrante\n\nBridesmaids:\n[url=\"http:\/\/www.weddingtonway.com\/products\/alfred-angelo-7172-bridesmaid-dress?&amp;amp;sku=aa-7172-pomegranate\"]http:\/\/www.weddingtonway.com\/products\/alfred-angelo-7172-bridesmaid-dress?&amp;amp;sku=aa-7172-pomegranate[\/url]\n[url=\"http:\/\/www.weddingtonway.com\/products\/alfred-angelo-7138-bridesmaid-dress?&amp;amp;sku=aa-7138-pomegranate\"]http:\/\/www.weddingtonway.com\/products\/alfred-angelo-7138-bridesmaid-dress?&amp;amp;sku=aa-7138-pomegranate[\/url]\n[url=\"http:\/\/www.weddingtonway.com\/products\/alfred-angelo-7176-bridesmaid-dress?&amp;amp;sku=aa-7176-pomegranate\"]http:\/\/www.weddingtonway.com\/products\/alfred-angelo-7176-bridesmaid-dress?&amp;amp;sku=aa-7176-pomegranate[\/url]\nall in pomegrante\nI love that the dresses are all a little different much like my girls themselves. \nThe girls all really liked the same shoe so I purchased these sandals for them...\n[url=\"http:\/\/www.dsw.com\/shoe\/chinese+laundry+glisten+flat+sandal?prodId=312092&amp;amp;productRef=SEARCH\"]http:\/\/www.dsw.com\/shoe\/chinese+laundry+glisten+flat+sandal?prodId=312092&amp;amp;productRef=SEARCH[\/url]\n\nStill working on accessories for them  :wub:[\/quote]\nI love the colour! I didn&#039;t even know pomegranate existed! lol but I really like it!","Attachments":[],"Id":1878681,"PostDate":1416362616,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>TiffanyMC, on 17 November 2014 - 09:55 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>What styles\/colors are your bm's wearing?<\/p>\n<p>\u00a0<\/p>\n<p>My MOH will wear:\u00a0<a href='http:\/\/www.weddingtonway.com\/products\/alfred-angelo-7243s-bridesmaid-dress?&sku=aa-7243s-pomegranate' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.weddingto...43s-pomegranate<\/a><\/p>\n<p>in pomegrante<\/p>\n<p>\u00a0<\/p>\n<p>Bridesmaids:<\/p>\n<p><a href='http:\/\/www.weddingtonway.com\/products\/alfred-angelo-7172-bridesmaid-dress?&sku=aa-7172-pomegranate' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.weddingto...172-pomegranate<\/a><\/p>\n<p><a href='http:\/\/www.weddingtonway.com\/products\/alfred-angelo-7138-bridesmaid-dress?&sku=aa-7138-pomegranate' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.weddingto...138-pomegranate<\/a><\/p>\n<p><a href='http:\/\/www.weddingtonway.com\/products\/alfred-angelo-7176-bridesmaid-dress?&sku=aa-7176-pomegranate' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.weddingto...176-pomegranate<\/a><\/p>\n<p>all in pomegrante<\/p>\n<p>I love that the dresses are all a little different much like my girls themselves.\u00a0<\/p>\n<p>The girls all really liked the same shoe so I purchased these sandals for them...<\/p>\n<p><a href='http:\/\/www.dsw.com\/shoe\/chinese+laundry+glisten+flat+sandal?prodId=312092&productRef=SEARCH' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.dsw.com\/s...oductRef=SEARCH<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Still working on accessories for them\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wub.png' class='bbc_emoticon' alt=':wub:' \/><\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>I love the colour! I didn't even know pomegranate existed! lol but I really like it!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span><\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/ann.chadwick.5\/media_set?set=a.10153262834771016.1073741828.569791015&type=3'><span style=\"color:#ff0099;\"><em>https:\/\/www.facebook.com\/ann.chadwick.5\/media_set?set=a.10153262834771016.1073741828.569791015&type=3<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/'><span style=\"color:#ff0099;\"><em>http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283462599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.194.237.54","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78395,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"96bcd14a744e3e46d6ff9b2a083bfd51","RawContent":"&lt;p&gt;@[member=\"LissaSou\"] My bridesmaids are wearing the same but in Rum Pink :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Two of my bridesmaids are coming from the UK and they were able to order them from there which is awesome.&lt;\/p&gt;","Attachments":[],"Id":1878735,"PostDate":1416437480,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\"