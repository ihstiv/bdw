ull size.\" class=\"tcattdimgresizer\" \/><\/span><\/a>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"Photo by <a class='bbc_url' href='http:\/\/www.monicamartinphotography.com\/blog'>www.monicamartinphotography.com\/blog<\/a><br \/>\n<a class='bbc_url' href='http:\/\/bestdestinationwedding.com\/forum\/f128\/amyhs-planning-galore-24132\/index10.html'>Planning Pics!<\/a> <a class='bbc_url' href='http:\/\/bestdestinationwedding.com\/forum\/f77\/amyhs-puerto-vallarta-wedding-more-review-works-25255\/index4.html'>PV and Wedding Review<\/a><strong class='bbc'><a class='bbc_url' href='http:\/\/picasaweb.google.com\/amyhmartin\/ProfessionalWeddingPictures?authkey=w0DgS3ao1sI#'>Pro Pics (1)<\/a>; <a class='bbc_url' href='http:\/\/picasaweb.google.com\/amyhmartin\/ProfessionalWeddingPictures2?authkey=vbG3xUMVk1s#'>Pro Pics (2)<\/a><\/strong> <strong class='bbc'>By Nataly Lemus Photography and Rodolfo Arpia Photography<\/strong> <a class='bbc_url' href='http:\/\/natalylemusphoto.blogspot.com\/2008\/07\/amy-hanssel-married.html'>Teaser Pro Pics from Nataly Lemus Photogaphy<\/a><a class='bbc_url' href='http:\/\/www.arpiaphotoblog.com\/2008\/07\/puerto-vallarta-destination-wedding_3102.html'>Teaser Pro Pics from Rodolfo Arpia Photography<\/a>","Email":"amyhmartin@gmail.com","IpAddress":"98.119.192.139","GroupId":46,"GroupName":"VIP Member","JoinDate":1162175640,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206875.jpg?_r=0","PhotoWidth":200,"PhotoHeight":285,"PhotoType":"custom"},"FormattedName":"amyh","Id":206875,"Name":"amyh","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"85b5239be896afe6f07013de6077b98f","RawContent":"&lt;font face=\"Times New Roman\"&gt;&lt;font face=\"Century Gothic\"&gt;All these gorgeous rings - agh...&lt;\/font&gt;&lt;\/font&gt;\n \n &lt;font face=\"Times New Roman\"&gt;&lt;font face=\"Century Gothic\"&gt;My ring is a cushion cut in a platinum diamond wire setting. The ring&#039;s shank is single not double wire with a Single Row of Pave Diamonds unlike in the attached picture. When i saw it, I knew I had to have it :)\n \n &lt;\/font&gt;&lt;\/font&gt;\n &lt;img src=\"http:\/\/i197.photobucket.com\/albums\/aa240\/carlymcmullen\/BDW%20Photos%20for%20Others\/loretuke1.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt; &lt;img src=\"http:\/\/i197.photobucket.com\/albums\/aa240\/carlymcmullen\/BDW%20Photos%20for%20Others\/loretuke2.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;&lt;p&gt;&amp;nbsp;&lt;\/p&gt;&lt;span huddler_attributes=\"{&amp;quot;plugin&amp;quot;:&amp;quot;attachment&amp;quot;,&amp;quot;params&amp;quot;:{&amp;quot;id&amp;quot;:&amp;quot;3800&amp;quot;,&amp;quot;name&amp;quot;:&amp;quot;my ring.doc&amp;quot;,&amp;quot;description&amp;quot;:&amp;quot;&amp;quot;,&amp;quot;size&amp;quot;:75.5,&amp;quot;type&amp;quot;:&amp;quot;doc&amp;quot;}}\" huddler_plugin=\"attachment\"&gt;&amp;nbsp;&lt;\/span&gt;","Attachments":[],"Id":11223,"PostDate":1165889816,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <font face=\"Times New Roman\"><font face=\"Century Gothic\">All these gorgeous rings - agh...<\/font><\/font><br \/> <br \/> <font face=\"Times New Roman\"><font 