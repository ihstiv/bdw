ternal link' rel='nofollow external'>http:\/\/s58.photobuck...eph's Ring.jpg]<\/a><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"wrathwitch@yahoo.com","IpAddress":"70.26.161.173","GroupId":39,"GroupName":"Newbie","JoinDate":1405681001,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Wrathwitch","Id":279071,"Name":"Wrathwitch","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"162.238.70.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"38299af5273714ea82974faa5a6b5156","RawContent":"Everyone&#039;s rings are gorgeous and I finally figured out how to post pics for all to see! Here is my engagement ring, we haven&#039;t bought the band yet. \n\n&lt;a  class=\"bbc_url\" href=\"http:\/\/s1074.photobucket.com\/user\/hkorkovilis\/media\/imagejpg1_zps3cb418a3.jpg.html\"&gt;&lt;img src=\"http:\/\/i1074.photobucket.com\/albums\/w407\/hkorkovilis\/imagejpg1_zps3cb418a3.jpg\" alt=\"imagejpg1_zps3cb418a3.jpg\"&gt;&lt;\/a&gt;","Attachments":[],"Id":1861173,"PostDate":1405923691,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Everyone's rings are gorgeous and I finally figured out how to post pics for all to see! Here is my engagement ring, we haven't bought the band yet. <br><br><a href='http:\/\/s1074.photobucket.com\/user\/hkorkovilis\/media\/imagejpg1_zps3cb418a3.jpg.html' class='bbc_url' title='External link' rel='nofollow external'><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i1074.photobucket.com\/albums\/w407\/hkorkovilis\/imagejpg1_zps3cb418a3.jpg\" alt=\"imagejpg1_zps3cb418a3.jpg\"><\/span><\/a>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"hkorkovilis@gmail.com","IpAddress":"162.238.70.23","GroupId":40,"GroupName":"Jr. Member","JoinDate":1401630892,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278186.jpg?_r=1417419505","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"helenk","Id":278186,"Name":"helenk","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.145.235.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":254,"EditedBy":"","EditDate":1406478962,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"82325d14c44ae5ed2faa8d63cade321d","RawContent":"&lt;p&gt;\n\n\nHere is my ring and my wedding band together.\n\n\nThat&#039;s my original diamond but my second mount. The original one was so unique I couldn&#039;t find a wedding band and the custom route made me nervous.\n\n\nLOVE this one!! Hate to be honest but it&#039;s more me :)\n\n\n&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;All you ladies have beautiful rings!&lt;\/p&gt;","Attachments":[],"Id":1862557,"PostDate":1406478949,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><a class='resized_img' rel='lightbox[1862557]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2014\/post-277873-140647524398.jpg\" title=\"ImageUploadedByTapatalk1406475243.067287.jpg -  228.51KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2014\/post-277873-140647524398.jpg\" class='bbc_img linked-image' alt=\"ImageUploadedByTapatalk1406475243.067287.jpg\" \/><\/a>\n\n<br><br>\nHere is my ring and my wedding band together.<br><br>\nThat's my original diamond but my second mount. The original one was so unique I couldn't find a wedding band and the custom route made me nervous.<br><br>\nLOVE this one!! Hate to be honest but it's more me <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br><br>\n\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>All you ladies have beautiful rings!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399432202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.145.235.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ef8bd28abe66c425e152bd7a45d7d7f7","RawContent":"[quote name=\"helenk\" post=\"1861173\" timestamp=\"1405920091\"]\nEveryone&#039;s rings are gorgeous and I finally figured out how to post pics for all to see! Here is my engagement ring, we haven&#039;t bought the band yet.\n\n[url=\"http:\/\/s1074.photobucket.com\/user\/hkorkovilis\/media\/imagejpg1_zps3cb418a3.jpg.html\"][img]http:\/\/i1074.photobucket.com\/albums\/w407\/hkorkovilis\/imagejpg1_zps3cb418a3.jpg[\/img][\/url][\/quote]I&#039;d love to know how you post one right to the thread!!!","Attachments":[],"Id":1862655,"PostDate":1406499387,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>helenk, on 20 July 2014 - 10:21 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Everyone's rings are gorgeous and I finally figured out how to post pics for all to see! Here is my engagement ring, we haven't bought the band yet.<br><br><a href='http:\/\/s1074.photobucket.com\/user\/hkorkovilis\/media\/imagejpg1_zps3cb418a3.jpg.html' class='bbc_url' title='External link' rel='nofollow external'><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i1074.photobucket.com\/albums\/w407\/hkorkovilis\/imagejpg1_zps3cb418a3.jpg\" alt=\"imagejpg1_zps3cb418a3.jpg\"><\/span><\/a><\/p>\n<\/div>\n<\/div><\/div>\n<p>I'd love to know how you post one right to the thread!!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399432202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.182.39.99","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":254,"EditedBy":"","EditDate":1406504761,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"24272bae119659eb8b5ae0bb17615684","RawContent":"Awesome rings. Here goes mine","Attachments":[{"Id":28808,"Name":"image.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2014\/post-278701-0-12407400-1406501159.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2014\/post-278701-0-12407400-1406501159_thumb.jpg","Width":1000,"Height":750}],"Id":1862673,"PostDate":1406504707,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Awesome rings. Here goes mine\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"Good Luck <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>","Email":"ms.tatiana.rivera@gmail.com","IpAddress":"50.182.39.99","GroupId":40,"GroupName":"Jr. Member","JoinDate":1403766281,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Tatimrivera","Id":278701,"Name":"Tatimrivera","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"162.238.70.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"571b823593a1610ea005b5a83366f72a","RawContent":"[quote name=\"calgarybride2015\" post=\"1862655\" timestamp=\"1406495787\"]\nI&#039;d love to know how you post one right to the thread!!![\/quote]\nGet a photobucket account and then upload the pics there and copy and paste the HTML link into your reply.","Attachments":[],"Id":1863147,"PostDate":1406675972,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>calgarybride2015, on 27 July 2014 - 02:16 PM, said:<\/p><div class='blockquote'><div class='quote'><p>I'd love to know how you post one right to the thread!!!<\/p><\/div><\/div>\n<br><br>\nGet a photobucket account and then upload the pics there and copy and paste the HTML link into your reply. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"hkorkovilis@gmail.com","IpAddress":"162.238.70.23","GroupId":40,"GroupName":"Jr. Member","JoinDate":1401630892,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278186.jpg?_r=1417419505","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"helenk","Id":278186,"Name":"helenk","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.157.233.83","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":254,"EditedBy":"","EditDate":1406685271,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"93de583a94e69894035a123f74e01411","RawContent":"[quote name=\"helenk\" post=\"1863147\" timestamp=\"1406672372\"]\nGet a photobucket account and then upload the pics there and copy and paste the HTML link into your reply.[\/quote]Oh thank you!!! I was trying to figure it out :)\n\nMy fiance lost his mother last November, and she had left a ring for him to give of woman he would choose to marry. He proposed using that ring saying that if I wanted i could get a diamond ring for our wedding. But this ring means so much to both of us, I am thinking of just having a custom made wedding band to fit with it.. still not sure about what to do. \n\n[url=\"http:\/\/i1032.photobucket.com\/albums\/a407\/lily_1202\/394_zps01c9a573.jpg\"]http:\/\/i1032.photobucket.com\/albums\/a407\/lily_1202\/394_zps01c9a573.jpg[\/url]\n\nOH well i almost got it! I think the link works, but it&#039;s still not the actual picture.","Attachments":[],"Id":1863169,"PostDate":1406685337,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>helenk, on 29 July 2014 - 03:19 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Get a photobucket account and then upload the pics there and copy and paste the HTML link into your reply.<\/p>\n<\/div>\n<\/div><\/div>\n<p>Oh thank you!!! I was trying to figure it out <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>My fiance lost his mother last November, and she had left a ring for him to give of woman he would choose to marry. He proposed using that ring saying that if I wanted i could get a diamond ring for our wedding. But this ring means so much to both of us, I am thinking of just having a custom made wedding band to fit with it.. still not sure about what to do.\u00a0<\/p>\n<br><p><a href='http:\/\/i1032.photobucket.com\/albums\/a407\/lily_1202\/394_zps01c9a573.jpg' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/i1032.photobu...zps01c9a573.jpg<\/a><\/p>\n<br \/><p>OH well i almost got it! I think the link works, but it's still not the actual picture.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><em><span style=\"font-family:arial, helvetica, sans-serif;\">I'm lucky I'm in love with my best friend<\/span><\/em>","Email":"lily_1202@hotmail.com","IpAddress":"24.157.233.83","GroupId":40,"GroupName":"Jr. Member","JoinDate":1406394249,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279175.jpg?_r=1406605860","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"Lilian84","Id":279175,"Name":"Lilian84","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"162.238.70.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"92284aecb186cdb64b3e99250d2767cc","RawContent":"[quote name=\"Lilian84\" post=\"1863169\" timestamp=\"1406681737\"]\nOh thank you!!! I was trying to figure it out :)\n \nMy fiance lost his mother last November, and she had left a ring for him to give of woman he would choose to marry. He proposed using that ring saying that if I wanted i could get a diamond ring for our wedding. But this ring means so much to both of us, I am thinking of just having a custom made wedding band to fit with it.. still not sure about what to do. \n[url=\"http:\/\/i1032.photobucket.com\/albums\/a407\/lily_1202\/394_zps01c9a573.jpg\"]http:\/\/i1032.photobucket.com\/albums\/a407\/lily_1202\/394_zps01c9a573.jpg[\/url]\nOH well i almost got it! I think the link works, but it&#039;s still not the actual picture.\n[\/quote]\nI forget which link I used to copy and paste, there&#039;s like 3 of them, lol.","Attachments":[],"Id":1863251,"PostDate":1406732534,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Lilian84, on 29 July 2014 - 05:55 PM, said:<\/p><div class='blockquote'><div class='quote'><p>Oh thank you!!! I was trying to figure it out <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br>\n\u00a0<br>\nMy fiance lost his mother last November, and she had left a ring for him to give of woman he would choose to marry. He proposed using that ring saying that if I wanted i could get a diamond ring for our wedding. But this ring means so much to both of us, I am thinking of just having a custom made wedding band to fit with it.. still not sure about what to do.\u00a0<br><a href='http:\/\/i1032.photobucket.com\/albums\/a407\/lily_1202\/394_zps01c9a573.jpg' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/i1032.photobu...zps01c9a573.jpg<\/a><br>\nOH well i almost got it! I think the link works, but it's still not the actual picture.<br><\/p><\/div><\/div>\n<br><br>\nI forget which link I used to copy and paste, there's like 3 of them, lol.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"hkorkovilis@gmail.com","IpAddress":"162.238.70.23","GroupId":40,"GroupName":"Jr. Member","JoinDate":1401630892,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278186.jpg?_r=1417419505","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"helenk","Id":278186,"Name":"helenk","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"184.69.200.21","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"03cbba0bdfd869d367445f9313b8f165","RawContent":"[quote name=\"helenk\" post=\"1863147\" timestamp=\"1406672372\"]\nGet a photobucket account and then upload the pics there and copy and paste the HTML link into your reply.[\/quote]\nOhhhh, I do this on &#039;my fitness pal&#039;  hate it, but I know it makes it easier for people to see. Thanks!","Attachments":[],"Id":1863308,"PostDate":1406740779,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>helenk, on 29 July 2014 - 03:19 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Get a photobucket account and then upload the pics there and copy and paste the HTML link into your reply.<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>Ohhhh, I do this on 'my fitness pal' \u00a0hate it, but I know it makes it easier for people to see. Thanks!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399432202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.239.125.187","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"0ddcbd89970bd334f3adb333c4dac891","RawContent":"&lt;p&gt;Here&#039;s my e-ring - just got engaged last week so I don&#039;t have any idea on the band yet.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;The first is the ring on my hand - the second is an &#039;artsy&#039; photo my brother did on the cork to our champagne at our celebratory dinner with my mum last week. &amp;nbsp;Its nice because you can see all the detail on the ring in that one - its too sparkly to see it well without lighting... that being said, it isn&#039;t as dingy as the second photo appears :)&lt;\/p&gt;","Attachments":[],"Id":1863343,"PostDate":1406743836,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Here's my e-ring - just got engaged last week so I don't have any idea on the band yet.<\/p>\n<p>\u00a0<\/p>\n<p>The first is the ring on my hand - the second is an 'artsy' photo my brother did on the cork to our champagne at our celebratory dinner with my mum last week. \u00a0Its nice because you can see all the detail on the ring in that one - its too sparkly to see it well without lighting... that being said, it isn't as dingy as the second photo appears <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><a class='resized_img' rel='lightbox[1863343]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2014\/post-279198-0-25008200-1406739603.jpg\" title=\"10534823_425881480885271_1201888610_n - Copy.jpg -  59.2KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2014\/post-279198-0-25008200-1406739603.jpg\" class='bbc_img linked-image' alt=\"10534823_425881480885271_1201888610_n - Copy.jpg\" \/><\/a>\n\n<a class='resized_img' rel='lightbox[1863343]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2014\/post-279198-0-69462500-1406740148.jpg\" title=\"photo 2.JPG -  78.05KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2014\/post-279198-0-69462500-1406740148.jpg\" class='bbc_img linked-image' alt=\"photo 2.JPG\" \/><\/a>\n\n<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kelann25@gmail.com","IpAddress":"173.239.125.187","GroupId":39,"GroupName":"Newbie","JoinDate":1406586944,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279198.jpg?_r=1415031085","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"KAT2015","Id":279198,"Name":"KAT2015","IsOnline":false}}],"Pages":{"TotalItems":2111,"TotalPages":212,"CurrentPage":2080,"NextPage":2090,"PreviousPage":2070,"LastPage":2110},"PushNotifications":[{"Key":"notifications","Value":1,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
