{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":5,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":true,"Views":146,"MovedTo":null,"MovedOn":0,"FirstPostId":1906865,"Rating":0,"RatingHits":0,"Starter":{"Id":281717,"Name":"Christie77","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281717.jpg?_r=1446345131","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"StartDate":1445973343,"LastPoster":{"Id":281717,"Name":"Christie77","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281717.jpg?_r=1446345131","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":33,"Preview":{"Id":1906865,"PostDate":1445973343,"PostContent":"Hello ladies!! I really want a pair of blue heels for the ceremony. If you have found some would...","Author":{"Signature":"","Email":"christierwayne@gmail.com","IpAddress":"70.211.64.103","GroupId":39,"GroupName":"Newbie","JoinDate":1421184200,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281717.jpg?_r=1446345131","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"Christie77","Id":281717,"Name":"Christie77","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.176.231.201","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79685,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c433582a5c4ac368b221d5aa2bd9477c","RawContent":"&lt;p&gt;Hello ladies!! I really want a pair of blue heels for the ceremony. If you have found some would you mind sharing info or pics? I need inspiration.&lt;\/p&gt;","Attachments":[],"Id":1906865,"PostDate":1445973343,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello ladies!! I really want a pair of blue heels for the ceremony. If you have found some would you mind sharing info or pics? I need inspiration.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"christierwayne@gmail.com","IpAddress":"70.211.64.103","GroupId":39,"GroupName":"Newbie","JoinDate":1421184200,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281717.jpg?_r=1446345131","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"Christie77","Id":281717,"Name":"Christie77","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.42.38","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79685,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"8cab7cefd383f0819360731c66670ae4","RawContent":"&lt;p&gt;Oh boy have you come to the right place! lol We just got back on Sunday and I have 2 pairs and wore both! I got the sky blue ones from Adriana Papell and the horizon blue ones as white and dyed from David&#039;s Bridal. They have some really nice satin heels that you can have dyed any colour you want.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1906867,"PostDate":1445979151,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Oh boy have you come to the right place! lol We just got back on Sunday and I have 2 pairs and wore both! I got the sky blue ones from Adriana Papell and the horizon blue ones as white and dyed from David's Bridal. They have some really nice satin heels that you can have dyed any colour you want.<\/p>\n<p>\u00a0<\/p>\n<p><a class='resized_img' rel='lightbox[1906867]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_10_2015\/post-232000-0-81082600-1445993536.jpg\" title=\"3149247-p-MULTIVIEW.jpg - Size: 37.53KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_10_2015\/post-232000-0-81082600-1445993536.jpg\" class='bbc_img linked-image' alt=\"3149247-p-MULTIVIEW.jpg\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n<p><a class='resized_img' rel='lightbox[1906867]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_10_2015\/post-232000-0-12603500-1445993538.jpg\" title=\"20150816_203606_resized.jpg - Size: 63.12KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_10_2015\/post-232000-0-12603500-1445993538.jpg\" class='bbc_img linked-image' alt=\"20150816_203606_resized.jpg\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><em><span style=\"color:rgb(51,153,255);\">I'm lucky enough to\u00a0tell my husband how much I love him and say yes again\u00a0on October 20, 2015 at Grand Coral Beach Club!\u00a0<\/span><\/em>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.176.231.201","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79685,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"115fbd243153c6250de0282fcce54401","RawContent":"&lt;p&gt;Congratulations!!! Hope your trip was amazing :D&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Those are both gorgeous! Adriana Papell I have never heard of. Just popped on the website. Such pretty shoes. Was one pair more comfortable than the other?&lt;\/p&gt;","Attachments":[],"Id":1906911,"PostDate":1446039052,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congratulations!!! Hope your trip was amazing <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/biggrin.png' class='bbc_emoticon' alt=':D' \/>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Those are both gorgeous! Adriana Papell I have never heard of. Just popped on the website. Such pretty shoes. Was one pair more comfortable than the other?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"christierwayne@gmail.com","IpAddress":"70.211.64.103","GroupId":39,"GroupName":"Newbie","JoinDate":1421184200,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281717.jpg?_r=1446345131","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"Christie77","Id":281717,"Name":"Christie77","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.42.38","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79685,"EditedBy":"","EditDate":1446146501,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"dba43ba90bd19f3cd08ebbda4bb4c111","RawContent":"&lt;p&gt;lol Yeah the David&#039;s bridal shoes were a whole ton more comfortable. Not sure why. I tried on the AP shoes in the store for the size. Got it and ordered the colour I wanted online since they didn&#039;t have it in store. Got them and they&#039;re snug. I tried to get the time to have them stretched before we left but it didn&#039;t work too well so I managed them for about 2 hours and then had to switch to the DB shoes lol I intend to get the AP ones stretched properly so I can wear them. I absolutely LOVE them! The colour is sooooooo pretty. I hate breaking in shoes though lol The DB ones were great from the start and I would definitely recommend them. They were a great price and the dyeing only cost $5 and you can pick any colour you want.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;The other site I would recommend is Nina Shoes. They have some beautiful blue ones with all different heel heights. Absolutely gorgeous. Good luck!&lt;\/p&gt;","Attachments":[],"Id":1906922,"PostDate":1446072915,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>lol Yeah the David's bridal shoes were a whole ton more comfortable. Not sure why. I tried on the AP shoes in the store for the size. Got it and ordered the colour I wanted online since they didn't have it in store. Got them and they're snug. I tried to get the time to have them stretched before we left but it didn't work too well so I managed them for about 2 hours and then had to switch to the DB shoes lol I intend to get the AP ones stretched properly so I can wear them. I absolutely LOVE them! The colour is sooooooo pretty. I hate breaking in shoes though lol The DB ones were great from the start and I would definitely recommend them. They were a great price and the dyeing only cost $5 and you can pick any colour you want.<\/p>\n<p>\u00a0<\/p>\n<p>The other site I would recommend is Nina Shoes. They have some beautiful blue ones with all different heel heights. Absolutely gorgeous. Good luck!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><em><span style=\"color:rgb(51,153,255);\">I'm lucky enough to\u00a0tell my husband how much I love him and say yes again\u00a0on October 20, 2015 at Grand Coral Beach Club!\u00a0<\/span><\/em>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.176.231.201","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79685,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"8bbef41fad5e7db52f38c09de3cda0e8","RawContent":"&lt;p&gt;THANKS FOR THE AWESOME INFO ACW271011!!&lt;\/p&gt;","Attachments":[],"Id":1906938,"PostDate":1446121204,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>THANKS FOR THE AWESOME INFO ACW271011!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"christierwayne@gmail.com","IpAddress":"70.211.64.103","GroupId":39,"GroupName":"Newbie","JoinDate":1421184200,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281717.jpg?_r=1446345131","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"Christie77","Id":281717,"Name":"Christie77","IsOnline":false}}],"Id":"79685","Title":"Blue Shoes...has Anyone Found Amazing Blue Heels?","LastPostDate":1446121204},"Pages":{"TotalItems":5,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":1,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
