Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":5,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":386,"MovedTo":null,"MovedOn":0,"FirstPostId":1880605,"Rating":0,"RatingHits":0,"Starter":{"Id":281425,"Name":"BreeShort","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281425.jpg?_r=1424365329","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":false},"StartDate":1418842645,"LastPoster":{"Id":230711,"Name":"Moments That Matter","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1880605,"PostDate":1418842645,"PostContent":"Hi my name is Bree \u00a0 We are getting married at Azul Sensatori November 26, 2015.\u00a0 I have booked t...","Author":{"Signature":"","Email":"bshort@uvic.ca","IpAddress":"207.194.133.9","GroupId":39,"GroupName":"Newbie","JoinDate":1418838701,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281425.jpg?_r=1424365329","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"BreeShort","Id":281425,"Name":"BreeShort","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.194.133.9","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78492,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d56d7f88ac003df49d4477fc40248f32","RawContent":"&lt;p&gt;Hi my name is Bree&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We are getting married at Azul Sensatori November 26, 2015.&amp;nbsp; I have booked the date, travel and have my dress but kinda just getting started on decor, recption, photography and music for our date.&amp;nbsp; There is so much to consider and choose. I have looked in some of the azul sensatori forum so far but am new to this site. Any direction or suggestions welcome.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We have 26 guests booked so far....5 bridesmaids and 5 groomsmen. I think we will end up with 30-35 guests but not sure yet.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thanks!&lt;\/p&gt;","Attachments":[],"Id":1880605,"PostDate":1418842645,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi my name is Bree<\/p>\n<p>\u00a0<\/p>\n<p>We are getting married at Azul Sensatori November 26, 2015.\u00a0 I have booked the date, travel and have my dress but kinda just getting started on decor, recption, photography and music for our date.\u00a0 There is so much to consider and choose. I have looked in some of the azul sensatori forum so far but am new to this site. Any direction or suggestions welcome.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>We have 26 guests booked so far....5 bridesmaids and 5 groomsmen. I think we will end up with 30-35 guests but not sure yet.<\/p>\n<p>\u00a0<\/p>\n<p>Thanks!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bshort@uvic.ca","IpAddress":"207.194.133.9","GroupId":39,"GroupName":"Newbie","JoinDate":1418838701,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281425.jpg?_r=1424365329","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"BreeShort","Id":281425,"Name":"BreeShort","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.208.82","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78492,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e390cc8d41ab74787b9e0595ed16f569","RawContent":"There are two very active Azul Sensatori threads (Sensatori brides and official Azul Sensatori).... There is a wealth of info in those threads... I read them from start to finish when first came to these boards and they were a God send. \n\n\nWelcome and looking forward to sharing with you on those threads!","Attachments":[],"Id":1880614,"PostDate":1418848244,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                There are two very active Azul Sensatori threads (Sensatori brides and official Azul Sensatori).... There is a wealth of info in those threads... I read them from start to finish when first came to these boards and they were a God send. <br><br>\nWelcome and looking forward to sharing with you on those threads! \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kmkwedding2016@gmail.com","IpAddress":"70.72.195.234","GroupId":38,"GroupName":"Moderators","JoinDate":1390256608,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kmk2016","Id":276231,"Name":"kmk2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"73.43.233.7","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78492,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ad4471368d383f02dca9f4d61bef7ca1","RawContent":"&lt;p&gt;welcome to BDW!!! as KMK said definitely check out the AS threads. there&#039;s tons of information on Lomas in there too. happy planning!!&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1880615,"PostDate":1418848363,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>welcome to BDW!!! as KMK said definitely check out the AS threads. there's tons of information on Lomas in there too. happy planning!!\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div>\u00a0<\/div>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/73076-official-el-dorado-royaleel-dorado-casitas-royale-thread\/'>Official El Dorado Royale\/El Dorado Casitas Royale Thread<\/a>\u00a0<---check here for all info about EDR\/EDCR<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'>Wright Travel Agency<\/a> <--for all your Destination Wedding needs! Contact the experts and reduce your stress.\u00a0<\/p>\n<p><a data-ipb='nomediapa