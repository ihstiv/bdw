Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":4,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":895,"MovedTo":null,"MovedOn":0,"FirstPostId":1800399,"Rating":0,"RatingHits":0,"Starter":{"Id":273515,"Name":"EZGZ081013","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-273515.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"StartDate":1379356071,"LastPoster":{"Id":279432,"Name":"ritchellrodd","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":16,"Preview":{"Id":1866312,"PostDate":1408006715,"PostContent":"Carribean is a best option. thouh they might be bit far from your place but one beautiful place....","Author":{"Signature":"","Email":"johnreynell@outlook.com","IpAddress":"123.63.162.50","GroupId":39,"GroupName":"Newbie","JoinDate":1408005874,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"ritchellrodd","Id":279432,"Name":"ritchellrodd","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75112,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"441c95754044fedd2da656c8ca3d6d64","RawContent":"&lt;p&gt;Hello All!&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;I am new to this site and am hoping to start my information-gathering process! My fiance and I have decided that we would like to have a small destination wedding -- mostly immediate family -- in Hawaii! Now, I have been there a few times in the past, but it&#039;s been several years, and I would love to get opinions on the best locations\/resorts for a small wedding! There will be no more than 30 guests, and we would like it as close to the beach as possible. I am aware that they do not allow chairs or tables actually ON the beaches in Hawaii, and we would like our guests to be able to sit, but still have the ocean view in the background. We are currently leaning more towards Maui, but we&#039;re open to any suggestions on other islands! &amp;nbsp;Does anyone have any tips\/suggestions\/info on locations\/venues\/specific island for a Hawaiian wedding?&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;Thank you in advance!&lt;\/p&gt;","Attachments":[],"Id":1800399,"PostDate":1379356071,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello All!<\/p> <p>\u00a0<\/p> <p>I am new to this site and am hoping to start my information-gathering process! My fiance and I have decided that we would like to have a small destination wedding -- mostly immediate family -- in Hawaii! Now, I have been there a few times in the past, but it's been several years, and I would love to get opinions on the best locations\/resorts for a small wedding! There will be no more than 30 guests, and we would like it as close to the beach as possible. I am aware that they do not allow chairs or tables actually ON the beaches in Hawaii, and we would like our guests to be able to sit, but still have the ocean view in the background. We are currently leaning more towards Maui, but we're open to any suggestions on other islands! \u00a0Does anyone have any tips\/suggestions\/info on locations\/venues\/specific island for a Hawaiian wedding?<\/p> <p>\u00a0<\/p> <p>Thank you in advance!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"erin.gross2@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1379355656,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-273515.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"EZGZ081013","Id":273515,"Name":"EZGZ081013","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.93.105.8","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75112,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"454dcfeef64ad494e980caffe59a4a9b","RawContent":"I also suggest Oahu because there is a lot more to do especially if you have single people attending. I originally wanted Maui because it is so beautiful but Oahu is more affordable and still very beautiful! I had my ceremony and reception at Paradise Cove in Oahu and went to Maui for our honeymoon. Please feel free to ask me any questions! You can PM me if you want.","Attachments":[],"Id":1827893,"PostDate":1390348235,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I also suggest Oahu because there is a lot more to do especially if you have single people attending. I originally wanted Maui because it is so beautiful but Oahu is more affordable and still very beautiful! I had my ceremony and reception at Paradise Cove in Oahu and went to Maui for our honeymoon. Please feel free to ask me any questions! You can PM me if you want.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cheryl_cruz327@yahoo.com","IpAddress":"71.93.105.8","GroupId":39,"GroupName":"Newbie","JoinDate":1328123158,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250835.jpg?_r=1390348588","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"cherbear327","Id":250835,"Name":"cherbear327","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.143.153.161","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75112,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"559c90ed0b929034793edf3aea61535b","RawContent":"&lt;p&gt;Maui has some beautiful locations and is not so crowded.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;There are several wonderful options with moderate pricing for beachfront weddings:&lt;\/p&gt;\n&lt;p&gt;take a look at the Royal Lahaina.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;They have a gorgeous lawn area overlooking the ocean&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;If you send me your email I will send a photo I took of a wedding happening there when I was visiting last year.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;There are other options but this property is very nice and moderately priced. &amp;nbsp;They do lots of weddings.&lt;\/p&gt;","Attachments":[],"Id":1830088,"PostDate":1391107562,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Maui has some beautiful locations and is not so crowded.<\/p>\n<p>\u00a0<\/p>\n<p>There are several wonderful options with moderate pricing for beachfront weddings:<\/p>\n<p>take a look at the Royal Lahaina.<\/p>\n<p>\u00a0<\/p>\n<p>They have a gorgeous lawn area overlooking the ocean\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>If you send me your email I will send a photo I took of a wedding happening there when I was visiting last year.<\/p>\n<p>\u00a0<\/p>\n<p>There are other options but this property is very nice and moderately priced. \u00a0They do lots of weddings.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><a class='bbc_url' href='http:\/\/wrighttravelagency.com\/inquiry\/'><span style='color: rgb(0,128,128)'>Looking for a travel agency that specializes in Destination Weddings<\/span><\/a><span style='color: rgb(0,128,128)'>? We are an award winning travel agency and you can read our reviews <\/span><a class='bbc_url' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style='color: rgb(0,128,128)'><strong class='bbc'>HERE.<\/strong><\/span><\/a><\/span><\/span><br \/>\n<br \/>\n<span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'><strong class='bbc'>Awards and recognition: <\/strong><\/span><\/span><\/span><\/span><br \/>\n<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'>Palace Resorts Top PRO Agency <\/span><\/span><\/span><\/span><br \/>\n<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'>Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator <\/span><\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>AMResorts Master Agent & Top Agency<\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>Travel Impressions Best of the Best Globe Winner<\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>Apple Vacations Golden Apple Winner<\/span><\/span><\/span>","Email":"kathy@wrighttravelagency.com","IpAddress":"50.143.153.161","GroupId":49,"GroupName":"Insiders","JoinDate":1391018664,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"TAkathy","Id":276390,"Name":"TAkathy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"123.63.162.50","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75112,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d8eff4346c3a8cbb64e4ff54c242fe79","RawContent":"&lt;p&gt;Carribean is a best option. thouh they might be bit far from your place but one beautiful place. You will surely love it.&lt;\/p&gt;","Attachments":[],"Id":1866312,"PostDate":1408006715,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Carribean is a best option. thouh they might be bit far from your place but one beautiful place. You will surely love it.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"johnreynell@outlook.com","IpAddress":"123.63.162.50","GroupId":39,"GroupName":"Newbie","JoinDate":1408005874,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"ritchellrodd","Id":279432,"Name":"ritchellrodd","IsOnline":false}}],"Id":"75112","Title":"Hawaiian Wedding!!","LastPostDate":1408006715},"Pages":{"TotalItems":4,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
