{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":1,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":707,"MovedTo":null,"MovedOn":0,"FirstPostId":1663078,"Rating":0,"RatingHits":0,"Starter":{"Id":260064,"Name":"wagnernurse16","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-260064.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"StartDate":1347622628,"LastPoster":{"Id":260064,"Name":"wagnernurse16","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-260064.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":118,"Preview":{"Id":1663078,"PostDate":1347622628,"PostContent":"Hello all!!! I am SO excited to announce I'm a newbie to the Dreams Resort & this forum - we jus...","Author":{"Signature":"","Email":"wagners.est2010@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1347003329,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-260064.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"wagnernurse16","Id":260064,"Name":"wagnernurse16","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":69443,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"95b08422201a3a19a96fb6d167417d3a","RawContent":"&lt;p&gt; &lt;span style=\"color: #800080\"&gt;Hello all!!! I am SO excited to announce I&#039;m a newbie to the Dreams Resort &amp;amp; this forum - we just set a date for April 11th, 2013 &amp;amp; I&#039;m already feeling overwhelmed. I&#039;m a&amp;nbsp;big DIY fan &amp;amp; we&#039;ve been going back &amp;amp; forth about what will be worth it to bring\/do versus not. For those of you who are going to have or already have had weddings there... do they let you bring in a lot of your own decor or do they want you to pay for the extras? Do you just use the chairs\/tables or is there a better, cheaper option? Have you used travel agents &amp;amp; who is a good one for this venue? We&#039;re expecting around 50 people &amp;amp; inviting a few more with the likelihood they won&#039;t be able to attend.&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"color: #800080\"&gt;Also, how did you all decide on the package you chose? We&#039;re planning on getting our own photographer &amp;amp; my girls are doing my hair &amp;amp; makeup... we&#039;re thinking&amp;nbsp;DJ &amp;amp; I&#039;m up in the air about which terrace to use &amp;amp; whether to do beach or gazebo? All in all - I just need experienced help!! Thank you guys so much in advance :]&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1663078,"PostDate":1347622628,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <span  style=\"color: #800080\">Hello all!!! I am SO excited to announce I'm a newbie to the Dreams Resort & this forum - we just set a date for April 11th, 2013 & I'm already feeling overwhelmed. I'm a\u00a0big DIY fan & we've been going back & forth about what will be worth it to bring\/do versus not. For those of you who are going to have or already have had weddings there... do they let you bring in a lot of your own decor or do they want you to pay for the extras? Do you just use the chairs\/tables or is there a better, cheaper option? Have you used travel agents & who is a good one for this venue? We're expecting around 50 people & inviting a few more with the likelihood they won't be able to attend.<\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"color: #800080\">Also, how did you all decide on the package you chose? We're planning on getting our own photographer & my girls are doing my hair & makeup... we're thinking\u00a0DJ & I'm up in the air about which terrace to use & whether to do beach or gazebo? All in all - I just need experienced help!! Thank you guys so much in advance :]<\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"wagners.est2010@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1347003329,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-260064.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"wagnernurse16","Id":260064,"Name":"wagnernurse16","IsOnline":false}}],"Id":"69443","Title":"Wedding packages & DIY - HELP!!! :)","LastPostDate":1347622628},"Pages":{"TotalItems":1,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
