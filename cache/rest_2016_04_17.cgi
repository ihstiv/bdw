{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.102.229.55","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77445,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1bad63c7b30d39849d5ba6adb01ca52f","RawContent":"&lt;p&gt;I am selling my Wally 66&#039; Garment Bag that I bought to transport my dress from NY to Mexico for my wedding. This bag has only been used once and is in excellent condition. My dress arrived in mexico without a wrinkle-- in fact I didn&#039;t even have my dress steamed before the wedding because it stayed perfectly in this bag.\n\n\nIf you search online for this bag you will find it between $125-$140. I bought it for $125 on amazon.com I am only asking $75 plus shipping for the bag.\n\nPlease email if you are interested Vanessa.vlahakis@[member=\"gmail\"].com&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1857691,"PostDate":1404203293,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I am selling my Wally 66' Garment Bag that I bought to transport my dress from NY to Mexico for my wedding. This bag has only been used once and is in excellent condition. My dress arrived in mexico without a wrinkle-- in fact I didn't even have my dress steamed before the wedding because it stayed perfectly in this bag.<br><br>\nIf you search online for this bag you will find it between $125-$140. I bought it for $125 on amazon.com I am only asking $75 plus shipping for the bag.<br>\nPlease email if you are interested Vanessa.vlahakis@<a hovercard-ref=\"member\" hovercard-id=\"219734\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/219734-gmail\/' title='Member profile'><span itemprop=\"name\">gmail<\/span><\/a>.com<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"vanessa.vlahakis@gmail.com","IpAddress":"134.43.0.1","GroupId":47,"GroupName":"Site Supporter","JoinDate":1384519231,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"none"},"FormattedName":"vanessav53","Id":275068,"Name":"vanessav53","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.176.144.27","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77445,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0cdac7a858b7af38ea203e77c6b05d45","RawContent":"&lt;p&gt;Hi - I sent you an email :)&lt;\/p&gt;","Attachments":[],"Id":1857824,"PostDate":1404249027,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi - I sent you an email <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"xoxoxoxoxoxoxoxoxoxoxoxoxoxoxoxoxoxoxoxoxoxoxoxoxoxoxoxoxoxoxoxoxoxoxoxoxoxoxoxoxoxoxoxoxoxoxoxoxoxoxoxoxoxoxo","Email":"berly12@hotmail.com","IpAddress":"209.6.118.164","GroupId":56,"GroupName":"Community Manager","JoinDate":1369347642,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-269909.jpeg?_r=0","PhotoWidth":180,"PhotoHeight":158,"PhotoType":"custom"},"FormattedName":"RaynDrop","Id":269909,"Name":"RaynDrop","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"98.110.21.125","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77445,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6bd778a5be5ab8bcc08023d42a3818b8","RawContent":"&lt;p&gt;do you still have the bag?&amp;gt;&lt;\/p&gt;","Attachments":[],"Id":1868696,"PostDate":1408959271,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>do you still have the bag?><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nicki7985@yahoo.com","IpAddress":"96.235.184.26","GroupId":40,"GroupName":"Jr. Member","JoinDate":1405886652,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279097.jpg?_r=1408764462","PhotoWidth":169,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"NickiLynn1116","Id":279097,"Name":"NickiLynn1116","IsOnline":false}}],"Pages":{"TotalItems":3,"TotalPages":1,"CurrentPage":0,"NextPag