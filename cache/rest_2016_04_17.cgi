ody>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"264077\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/264077-njbride2014\/' title='Member profile'><span itemprop=\"name\">NJBride2014<\/span><\/a> yes please let us know how it works out <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> OMG your wedding is in 5 days!!! So exciting!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"holly_youngquist@hotmail.com","IpAddress":"108.215.245.97","GroupId":40,"GroupName":"Jr. Member","JoinDate":1399555622,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"hyoungquist","Id":277896,"Name":"hyoungquist","IsOnline":false}}],"Pages":{"TotalItems":18,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
