{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":14,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":595,"MovedTo":null,"MovedOn":0,"FirstPostId":1902928,"Rating":0,"RatingHits":0,"Starter":{"Id":282132,"Name":"KatieMcBride","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282132.jpg?_r=1437519508","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"StartDate":1440008908,"LastPoster":{"Id":285142,"Name":"swatiahuja","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":33,"Preview":{"Id":1906670,"PostDate":1445395286,"PostContent":"Personally I don't have any experience on wearing\u00a0wedge shoes on sand, but I one of my friends to...","Author":{"Signature":"","Email":"ahujaswati1989@gmail.com","IpAddress":"103.253.175.158","GroupId":39,"GroupName":"Newbie","JoinDate":1445393826,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"swatiahuja","Id":285142,"Name":"swatiahuja","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"199.85.228.129","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79506,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a906ef4cb93419231e9690ecf7e0fb9f","RawContent":"&lt;p&gt;Thanks Kim! I&#039;ll have a look :)&lt;\/p&gt;","Attachments":[],"Id":1903261,"PostDate":1440428204,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thanks Kim! I'll have a look <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"katie_mcbride48@yahoo.ca","IpAddress":"199.85.228.129","GroupId":39,"GroupName":"Newbie","JoinDate":1424099850,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282132.jpg?_r=1437519508","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"KatieMcBride","Id":282132,"Name":"KatieMcBride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"114.121.164.182","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79506,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5a8c90c813c77e610a8b85de4b052d2c","RawContent":"&lt;p&gt;i think thats ok...&lt;\/p&gt;\n&lt;p&gt;choose the wedges but dont too high... maybe just 3 inch.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;it&#039;s danger if too high&lt;\/p&gt;","Attachments":[],"Id":1903722,"PostDate":1440815109,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>i think thats ok...<\/p>\n<p>choose the wedges but dont too high... maybe just 3 inch.\u00a0<\/p>\n<p>it's danger if too high<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"samwillow39@gmail.com","IpAddress":"114.121.164.128","GroupId":39,"GroupName":"Newbie","JoinDate":1430650422,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282964.jpg?_r=1431149209","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"samwillow","Id":282964,"Name":"samwillow","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"122.15.103.61","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79506,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0314fe9358bc4a1599171801e25182bb","RawContent":"&lt;p&gt;I love the shoes! They&#039;re so lovely! I assume they&#039;d be great to walk inside the sand however I do need to be honest and say i have in no way finished it. Have you ever looked at the barefoot sandals that many of the brides are wearing? A number of them are gorgeous!&lt;\/p&gt;","Attachments":[],"Id":1904902,"PostDate":1442455323,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I love the shoes! They're so lovely! I assume they'd be great to walk inside the sand however I do need to be honest and say i have in no way finished it. Have you ever looked at the barefoot sandals that many of the brides are wearing? A number of them are gorgeous!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rahulthakur01@hotmail.com","IpAddress":"122.15.103.61","GroupId":39,"GroupName":"Newbie","JoinDate":1438822568,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"rahulthakur01","Id":284300,"Name":"rahulthakur01","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"103.253.175.158","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79506,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8f8b7cdb5499da6502f778055aa5f02d","RawContent":"&lt;p&gt;Personally I don&#039;t have any experience on wearing&amp;nbsp;wedge shoes on sand, but I one of my friends told there is no difficulty is doing so. Problem arises when you wear pencil heels. Don&#039;t think too much just wear those and be positive everything will be perfectly fine. Hope this helps.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thanks,&lt;\/p&gt;\n&lt;p&gt;Swati&lt;\/p&gt;","Attachments":[],"Id":1906670,"PostDate":1445395286,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Personally I don't have any experience on wearing\u00a0wedge shoes on sand, but I one of my friends told there is no difficulty is doing so. Problem arises when you wear pencil heels. Don't think too much just wear those and be positive everything will be perfectly fine. Hope this helps.<\/p>\n<p>\u00a0<\/p>\n<p>Thanks,<\/p>\n<p>Swati<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ahujaswati1989@gmail.com","IpAddress":"103.253.175.158","GroupId":39,"GroupName":"Newbie","JoinDate":1445393826,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"swatiahuja","Id":285142,"Name":"swatiahuja","IsOnline":false}}],"Id":"79506","Title":"Wedge Shoes Okay For Sand?","LastPostDate":1445395286},"Pages":{"TotalItems":14,"TotalPages":2,"CurrentPage":10,"NextPage":-1,"PreviousPage":0,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
