{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":31,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":true,"Views":5101,"MovedTo":null,"MovedOn":0,"FirstPostId":1657884,"Rating":0,"RatingHits":0,"Starter":{"Id":259435,"Name":"somethingblue77","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-259435.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"IsOnline":false},"StartDate":1346238205,"LastPoster":{"Id":285131,"Name":"Sara88","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":33,"Preview":{"Id":1906575,"PostDate":1445269474,"PostContent":"I\u00a0ordered\u00a0a\u00a0knee\u00a0length\u00a0bridesmaid\u00a0from\u00a0dressilyme.\u00a0I\u00a0was\u00a0having\u00a0some\u00a0delivery\u00a0issues\u00a0and\u00a0the\u00a0pro...","Author":{"Signature":"","Email":"jonypopi121212@gmail.com","IpAddress":"203.110.243.22","GroupId":39,"GroupName":"Newbie","JoinDate":1445269181,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Sara88","Id":285131,"Name":"Sara88","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"203.110.243.22","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":69230,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4eb3099cecfabcbac0df88ed8618f2b8","RawContent":"&lt;p  class=\"\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;&lt;span style=\"font-size:12pt;\"&gt;I&amp;nbsp;ordered&amp;nbsp;a&amp;nbsp;knee&amp;nbsp;length&amp;nbsp;bridesmaid&amp;nbsp;from&amp;nbsp;dressilyme.&amp;nbsp;I&amp;nbsp;was&amp;nbsp;having&amp;nbsp;some&amp;nbsp;delivery&amp;nbsp;issues&amp;nbsp;and&amp;nbsp;the&amp;nbsp;product&amp;nbsp;was&amp;nbsp;getting&amp;nbsp;delayed&amp;nbsp;and&amp;nbsp;so&amp;nbsp;I&amp;nbsp;dropped&amp;nbsp;a&amp;nbsp;mail.&amp;nbsp;The&amp;nbsp;people&amp;nbsp;at&amp;nbsp;dressilyme&amp;nbsp;reverted&amp;nbsp;instantly&amp;nbsp;and&amp;nbsp;were&amp;nbsp;very&amp;nbsp;helpful&amp;nbsp;to&amp;nbsp;smooth-en&amp;nbsp;the&amp;nbsp;entire&amp;nbsp;process.&amp;nbsp;I&amp;nbsp;have&amp;nbsp;shopped&amp;nbsp;from&amp;nbsp;&lt;\/span&gt;&lt;span style=\"font-size:12pt;\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;span style=\"font-size:12pt;\"&gt;dressilyme&lt;\/span&gt;&lt;span style=\"font-size:12pt;\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;span style=\"font-size:12pt;\"&gt;before,&amp;nbsp;and&amp;nbsp;as&amp;nbsp;usual,&amp;nbsp;the&amp;nbsp;dress&amp;nbsp;was&amp;nbsp;awesome.&amp;nbsp;&lt;\/span&gt;&lt;span style=\"font-size:12pt;\"&gt;good&lt;\/span&gt;&lt;span style=\"font-size:12pt;\"&gt;&amp;nbsp;stitch,&amp;nbsp;&lt;\/span&gt;&lt;span style=\"font-size:12pt;\"&gt;good&lt;\/span&gt;&lt;span style=\"font-size:12pt;\"&gt;&amp;nbsp;design,&lt;\/span&gt;&lt;span style=\"font-size:12pt;\"&gt;&amp;nbsp;not&lt;\/span&gt;&lt;span style=\"font-size:12pt;\"&gt;&amp;nbsp;perfect&amp;nbsp;&lt;\/span&gt;&lt;span style=\"font-size:12pt;\"&gt;but&amp;nbsp;well&amp;nbsp;&lt;\/span&gt;&lt;span style=\"font-size:12pt;\"&gt;fit&lt;\/span&gt;&lt;span style=\"font-size:12pt;\"&gt;.&amp;nbsp;And&amp;nbsp;what&amp;nbsp;I&amp;nbsp;care&amp;nbsp;most.&amp;nbsp;It&lt;\/span&gt;&lt;span style=\"font-size:12pt;\"&gt;\u2019&lt;\/span&gt;&lt;span style=\"font-size:12pt;\"&gt;s&amp;nbsp;still&amp;nbsp;the&lt;\/span&gt;&lt;span style=\"font-size:12pt;\"&gt;&amp;nbsp;best&amp;nbsp;price.&amp;nbsp;&lt;\/span&gt;&lt;span style=\"font-size:12pt;\"&gt;Great&amp;nbsp;product&amp;nbsp;as&amp;nbsp;usual.&lt;\/span&gt;&lt;\/span&gt;&lt;span style=\"font-size:12pt;font-family:&#039;Times New Roman&#039;;\"&gt;&lt;\/span&gt;&lt;\/p&gt;&lt;p&gt;&lt;\/p&gt;","Attachments":[],"Id":1906575,"PostDate":1445269474,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p  class=\"\"><span  style=\"font-family:arial, helvetica, sans-serif\"><span  style=\"font-size:12pt\">I\u00a0ordered\u00a0a\u00a0knee\u00a0length\u00a0bridesmaid\u00a0from\u00a0dressilyme.\u00a0I\u00a0was\u00a0having\u00a0some\u00a0delivery\u00a0issues\u00a0and\u00a0the\u00a0product\u00a0was\u00a0getting\u00a0delayed\u00a0and\u00a0so\u00a0I\u00a0dropped\u00a0a\u00a0mail.\u00a0The\u00a0people\u00a0at\u00a0dressilyme\u00a0reverted\u00a0instantly\u00a0and\u00a0were\u00a0very\u00a0helpful\u00a0to\u00a0smooth-en\u00a0the\u00a0entire\u00a0process.\u00a0I\u00a0have\u00a0shopped\u00a0from\u00a0<\/span><span  style=\"font-size:12pt\">\u00a0<\/span><span  style=\"font-size:12pt\">dressilyme<\/span><span  style=\"font-size:12pt\">\u00a0<\/span><span  style=\"font-size:12pt\">before,\u00a0and\u00a0as\u00a0usual,\u00a0the\u00a0dress\u00a0was\u00a0awesome.\u00a0<\/span><span  style=\"font-size:12pt\">good<\/span><span  style=\"font-size:12pt\">\u00a0stitch,\u00a0<\/span><span  style=\"font-size:12pt\">good<\/span><span  style=\"font-size:12pt\">\u00a0design,<\/span><span  style=\"font-size:12pt\">\u00a0not<\/span><span  style=\"font-size:12pt\">\u00a0perfect\u00a0<\/span><span  style=\"font-size:12pt\">but\u00a0well\u00a0<\/span><span  style=\"font-size:12pt\">fit<\/span><span  style=\"font-size:12pt\">.\u00a0And\u00a0what\u00a0I\u00a0care\u00a0most.\u00a0It<\/span><span  style=\"font-size:12pt\">\u2019<\/span><span  style=\"font-size:12pt\">s\u00a0still\u00a0the<\/span><span  style=\"font-size:12pt\">\u00a0best\u00a0price.\u00a0<\/span><span  style=\"font-size:12pt\">Great\u00a0product\u00a0as\u00a0usual.<\/span><\/span><span  style=\"font-size:12pt;font-family:'Times New Roman';\"><\/span><\/p><p><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jonypopi121212@gmail.com","IpAddress":"203.110.243.22","GroupId":39,"GroupName":"Newbie","JoinDate":1445269181,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Sara88","Id":285131,"Name":"Sara88","IsOnline":false}}],"Id":"69230","Title":"Dresses from Dressilyme","LastPostDate":1445269474},"Pages":{"TotalItems":31,"TotalPages":4,"CurrentPage":30,"NextPage":-1,"PreviousPage":20,"LastPage":30},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
