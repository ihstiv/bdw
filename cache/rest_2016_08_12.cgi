{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":7,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":true,"Views":142,"MovedTo":null,"MovedOn":0,"FirstPostId":1915208,"Rating":0,"RatingHits":0,"Starter":{"Id":287525,"Name":"MichelleL","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-287525.jpg?_r=1470985983","PhotoWidth":200,"PhotoHeight":218,"PhotoType":"facebook"},"IsOnline":false},"StartDate":1470662679,"LastPoster":{"Id":250090,"Name":"dreamweddings","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250090.jpg?_r=1451923195","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1915208,"PostDate":1470662679,"PostContent":"My fianc\u00e9 and I have decided on a destination wedding and we are so excited!!! We have been looki...","Author":{"Signature":"","Email":"ugabulldog17@yahoo.com","IpAddress":"66.18.44.242","GroupId":39,"GroupName":"Newbie","JoinDate":1470661116,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-287525.jpg?_r=1470985983","PhotoWidth":200,"PhotoHeight":218,"PhotoType":"facebook"},"FormattedName":"MichelleL","Id":287525,"Name":"MichelleL","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.18.44.242","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80235,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"39e92f44cbe19db96b3407324ed190e8","RawContent":"&lt;p&gt;My fianc\u00e9 and I have decided on a destination wedding and we are so excited!!! We have been looking into various places (Punta Cana, Cancun, Costa Rica,etc.) and we really want to have everything at an adult-only all inclusive resort. Where I am having trouble is finding a place that is really nice, but also not outrageous pricing for my guests. We plan to have between 25-35 guests.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;All of that being said, does anyone know of great places we could go that are really nice but not to overpriced? And do most places give an overall discount for rooms when there are a lot of guests?&lt;\/p&gt;","Attachments":[],"Id":1915208,"PostDate":1470662679,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>My fianc\u00e9 and I have decided on a destination wedding and we are so excited!!! We have been looking into various places (Punta Cana, Cancun, Costa Rica,etc.) and we really want to have everything at an adult-only all inclusive resort. Where I am having trouble is finding a place that is really nice, but also not outrageous pricing for my guests. We plan to have between 25-35 guests.<\/p>\n<p>\u00a0<\/p>\n<p>All of that being said, does anyone know of great places we could go that are really nice but not to overpriced? And do most places give an overall discount for rooms when there are a lot of guests?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ugabulldog17@yahoo.com","IpAddress":"66.18.44.242","GroupId":39,"GroupName":"Newbie","JoinDate":1470661116,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-287525.jpg?_r=1470985983","PhotoWidth":200,"PhotoHeight":218,"PhotoType":"facebook"},"FormattedName":"MichelleL","Id":287525,"Name":"MichelleL","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"187.153.140.201","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80235,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"fb29c36254d1e44d43dd932c7b36d784","RawContent":"&lt;p&gt;@[member=\"MichelleL\"] congratulations on your upcoming wedding!!!!! and welcome to the amazing bestdestinationwedding community. There are so many wonderful resources here.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Can we ask what you consider \"not too overpriced\" If we know your budget we can certainly make some suggestions for beautiful adults only resorts\/hotels.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;In the meantime we&#039;ll leave you with some inspiration.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;","Attachments":[],"Id":1915210,"PostDate":1470672256,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"287525\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/287525-michellel\/' title='Member profile'><span itemprop=\"name\">MichelleL<\/span><\/a> congratulations on your upcoming wedding!!!!! and welcome to the amazing bestdestinationwedding community. There are so many wonderful resources here.<\/p>\n<p>\u00a0<\/p>\n<p>Can we ask what you consider \"not too overpriced\" If we know your budget we can certainly make some suggestions for beautiful adults only resorts\/hotels.<\/p>\n<p>\u00a0<\/p>\n<p>In the meantime we'll leave you with some inspiration.<\/p>\n<p>\u00a0<\/p>\n<p><a class='resized_img' rel='lightbox[1915210]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2016\/post-287055-0-01396700-1470686574.jpg\" title=\"Kayla_Aaron_Teaser_10.jpg - Size: 78.48KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2016\/post-287055-0-01396700-1470686574.jpg\" class='bbc_img linked-image' alt=\"Kayla_Aaron_Teaser_10.jpg\" \/><\/a>\n\n<a class='resized_img' rel='lightbox[1915210]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2016\/post-287055-0-78440000-1470686587.jpg\" title=\"Charlotte_Kristian_Teaser_05.jpg - Size: 89.2KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2016\/post-287055-0-78440000-1470686587.jpg\" class='bbc_img linked-image' alt=\"Charlotte_Kristian_Teaser_05.jpg\" \/><\/a>\n\n<a class='resized_img' rel='lightbox[1915210]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2016\/post-287055-0-35321600-1470686613.jpg\" title=\"Kristi_Gord_Teaser_01.jpg - Size: 97.42KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2016\/post-287055-0-35321600-1470686613.jpg\" class='bbc_img linked-image' alt=\"Kristi_Gord_Teaser_01.jpg\" \/><\/a>\n\n<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-family:tahoma, geneva, sans-serif;\"><strong><span style=\"font-size:18px;\">Jasmin & Matt - Breathtaking Destination Wedding & Lifestyle Photography<\/span><\/strong><\/span><\/p>\n<p><span style=\"font-family:tahoma, geneva, sans-serif;\"><span style=\"font-size:14px;\"><img src=\"http:\/\/www.jasminandmatt.com\/wp-content\/uploads\/2016\/07\/star.png\" alt=\"star.png\"><img src=\"http:\/\/www.jasminandmatt.com\/wp-content\/uploads\/2016\/07\/star.png\" alt=\"star.png\"><img src=\"http:\/\/www.jasminandmatt.com\/wp-content\/uploads\/2016\/07\/star.png\" alt=\"star.png\"><img src=\"http:\/\/www.jasminandmatt.com\/wp-content\/uploads\/2016\/07\/star.png\" alt=\"star.png\"><img src=\"http:\/\/www.jasminandmatt.com\/wp-content\/uploads\/2016\/07\/star.png\" alt=\"star.png\">\u00a0rating on <a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/jasminandmatt\/reviews'>Facebook<\/a> & <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21784-jasmin-matt-photography\/'>BestDestinationWedding.com<\/a><\/span><\/span><\/p>\n<p><span style=\"font-family:tahoma, geneva, sans-serif;\"><span style=\"font-size:14px;\">Still not convinced? Read our <a data-ipb='nomediaparse' href='http:\/\/www.jasminandmatt.com\/info\/testimonials\/'>testimonials of appreciation from previous couples <3<\/a><\/span><\/span><\/p>\n<p><span style=\"font-family:tahoma, geneva, sans-serif;\"><span style=\"font-size:14px;\"><strong>Website:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);\"><a data-ipb='nomediaparse' href='http:\/\/www.jasminandmatt.com\/'>http:\/\/www.jasminandmatt.com<\/a><\/span><br><strong>Email:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);\"><a data-ipb='nomediaparse' href='mailto:info@jasminandmatt.com'>info@jasminandmatt.com<\/a><\/span><br><strong>Phone:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);\">+52 984-114-3386<\/span><br><strong>Facebook:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);\"><a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/jasminandmatt\/'>Jasmin & Matt Photography<\/a><\/span><br><strong>Instagram:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);\"><a data-ipb='nomediaparse' href='https:\/\/www.instagram.com\/jasminandmattphotography\/'>@jasminandmattphotography<\/a><\/span><br><strong>Pinterest:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);\"><a data-ipb='nomediaparse' href='https:\/\/www.pinterest.com\/jasminandmatt'>Jasmin & Matt<\/a><\/span><\/span><\/span><\/p>\n<p><span style=\"font-family:tahoma, geneva, sans-serif;\"><span style=\"font-size:14px;\">Ask us how we can help you plan your perfect wedding day.<\/span><\/span>","Email":"forward@jasminandmatt.com","IpAddress":"187.153.21.84","GroupId":49,"GroupName":"Insiders","JoinDate":1464781539,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-287055.jpg?_r=1464796174","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"JasminMattPhoto","Id":287055,"Name":"JasminMattPhoto","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.18.44.214","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80235,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"3b0154f8894418437a77036230ec3b43","RawContent":"&lt;p&gt;Thank you!! I am thinking it will end up being a max of $2,500 for my guests... obviously getting it cheaper for them would be better.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1915214,"PostDate":1470683430,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thank you!! I am thinking it will end up being a max of $2,500 for my guests... obviously getting it cheaper for them would be better.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ugabulldog17@yahoo.com","IpAddress":"66.18.44.242","GroupId":39,"GroupName":"Newbie","JoinDate":1470661116,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-287525.jpg?_r=1470985983","PhotoWidth":200,"PhotoHeight":218,"PhotoType":"facebook"},"FormattedName":"MichelleL","Id":287525,"Name":"MichelleL","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"187.153.140.201","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80235,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ba18f5fdc2348c6f85e1157ff8e02392","RawContent":"&lt;p&gt;Morning&amp;nbsp;@[member=\"MichelleL\"] we are in the process of doing some research for you but in the meantime let me leave you with a few places we&#039;ve personally experienced that have been nice and you may want to look into.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;#1. Secrets Silversands - Resort located near Puerto Morelos between Cancun &amp;amp; Playa del Carmen. Family of ours stayed there and we spent a day with them on the resort. The resort is absolutely beautiful and completely adults only.&amp;nbsp;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.secretsresorts.com\/silversands-riviera-cancun&#039;&gt;http:\/\/www.secretsresorts.com\/silversands-riviera-cancun&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;#2.&amp;nbsp;The Royal Suites Yucatan by Palladium is also a beautiful resort. Grand Palladium overall isn&#039;t adults only but this beautiful section of the resort is and you and your guests would have private pools, bar, beach etc. We&#039;ve photographed many weddings at Grand Palladium and the experience has always been really wonderful. We highly suggest this resort.&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.palladiumhotelgroup.com\/en\/riviera-maya\/the-royal-suites-yucatan-by-palladium\/?&#039;&gt;http:\/\/www.palladiumhotelgroup.com\/en\/riviera-maya\/the-royal-suites-yucatan-by-palladium\/?&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;#3. Hideaway at Royalton Riviera Cancun. Again another resort that offers an adult only section. This resort is stunning with everything you would ever want from a destination wedding resort. &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.royaltonresorts.com\/en\/Hideaway-At-Royalton.aspx&#039;&gt;http:\/\/www.royaltonresorts.com\/en\/Hideaway-At-Royalton.aspx&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1915223,"PostDate":1470733743,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Morning\u00a0@<a hovercard-ref=\"member\" hovercard-id=\"287525\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/287525-michellel\/' title='Member profile'><span itemprop=\"name\">MichelleL<\/span><\/a> we are in the process of doing some research for you but in the meantime let me leave you with a few places we've personally experienced that have been nice and you may want to look into.<\/p>\n<p>\u00a0<\/p>\n<p>#1. Secrets Silversands - Resort located near Puerto Morelos between Cancun & Playa del Carmen. Family of ours stayed there and we spent a day with them on the resort. The resort is absolutely beautiful and completely adults only.\u00a0<a href='http:\/\/www.secretsresorts.com\/silversands-riviera-cancun' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.secretsre...-riviera-cancun<\/a><\/p>\n<p>\u00a0<\/p>\n<p>#2.\u00a0The Royal Suites Yucatan by Palladium is also a beautiful resort. Grand Palladium overall isn't adults only but this beautiful section of the resort is and you and your guests would have private pools, bar, beach etc. We've photographed many weddings at Grand Palladium and the experience has always been really wonderful. We highly suggest this resort.<\/p>\n<p><a href='http:\/\/www.palladiumhotelgroup.com\/en\/riviera-maya\/the-royal-suites-yucatan-by-palladium\/?' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.palladium...-by-palladium\/?<\/a><\/p>\n<p><a class='resized_img' rel='lightbox[1915223]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2016\/post-287055-0-93859600-1470748129.jpg\" title=\"Kristi_Gord_Teaser_03.jpg - Size: 101.24KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2016\/post-287055-0-93859600-1470748129.jpg\" class='bbc_img linked-image' alt=\"Kristi_Gord_Teaser_03.jpg\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>#3. Hideaway at Royalton Riviera Cancun. Again another resort that offers an adult only section. This resort is stunning with everything you would ever want from a destination wedding resort. <a href='http:\/\/www.royaltonresorts.com\/en\/Hideaway-At-Royalton.aspx' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.royaltonr...t-Royalton.aspx<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-family:tahoma, geneva, sans-serif;\"><strong><span style=\"font-size:18px;\">Jasmin & Matt - Breathtaking Destination Wedding & Lifestyle Photography<\/span><\/strong><\/span><\/p>\n<p><span style=\"font-family:tahoma, geneva, sans-serif;\"><span style=\"font-size:14px;\"><img src=\"http:\/\/www.jasminandmatt.com\/wp-content\/uploads\/2016\/07\/star.png\" alt=\"star.png\"><img src=\"http:\/\/www.jasminandmatt.com\/wp-content\/uploads\/2016\/07\/star.png\" alt=\"star.png\"><img src=\"http:\/\/www.jasminandmatt.com\/wp-content\/uploads\/2016\/07\/star.png\" alt=\"star.png\"><img src=\"http:\/\/www.jasminandmatt.com\/wp-content\/uploads\/2016\/07\/star.png\" alt=\"star.png\"><img src=\"http:\/\/www.jasminandmatt.com\/wp-content\/uploads\/2016\/07\/star.png\" alt=\"star.png\">\u00a0rating on <a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/jasminandmatt\/reviews'>Facebook<\/a> & <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21784-jasmin-matt-photography\/'>BestDestinationWedding.com<\/a><\/span><\/span><\/p>\n<p><span style=\"font-family:tahoma, geneva, sans-serif;\"><span style=\"font-size:14px;\">Still not convinced? Read our <a data-ipb='nomediaparse' href='http:\/\/www.jasminandmatt.com\/info\/testimonials\/'>testimonials of appreciation from previous couples <3<\/a><\/span><\/span><\/p>\n<p><span style=\"font-family:tahoma, geneva, sans-serif;\"><span style=\"font-size:14px;\"><strong>Website:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);\"><a data-ipb='nomediaparse' href='http:\/\/www.jasminandmatt.com\/'>http:\/\/www.jasminandmatt.com<\/a><\/span><br><strong>Email:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);\"><a data-ipb='nomediaparse' href='mailto:info@jasminandmatt.com'>info@jasminandmatt.com<\/a><\/span><br><strong>Phone:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);\">+52 984-114-3386<\/span><br><strong>Facebook:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);\"><a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/jasminandmatt\/'>Jasmin & Matt Photography<\/a><\/span><br><strong>Instagram:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);\"><a data-ipb='nomediaparse' href='https:\/\/www.instagram.com\/jasminandmattphotography\/'>@jasminandmattphotography<\/a><\/span><br><strong>Pinterest:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);\"><a data-ipb='nomediaparse' href='https:\/\/www.pinterest.com\/jasminandmatt'>Jasmin & Matt<\/a><\/span><\/span><\/span><\/p>\n<p><span style=\"font-family:tahoma, geneva, sans-serif;\"><span style=\"font-size:14px;\">Ask us how we can help you plan your perfect wedding day.<\/span><\/span>","Email":"forward@jasminandmatt.com","IpAddress":"187.153.21.84","GroupId":49,"GroupName":"Insiders","JoinDate":1464781539,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-287055.jpg?_r=1464796174","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"JasminMattPhoto","Id":287055,"Name":"JasminMattPhoto","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"189.221.46.28","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80235,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2fb9633f4f01081a7175cec6e5ae5634","RawContent":"&lt;p&gt;Welcome to the boards MichelleL and Congrats on your upcoming destination wedding!!! What an exciting time for you, no doubt :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;You&#039;ll find lots of great resources here, and everyone is so helpful, you&#039;re already off to a great start with your planning process - well done!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;The Blue Diamond Riviera Maya is a small intimate adults only resort in Playa del Carmen with wedding ceremony sites on their semi-private beach,&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"http:\/\/idomexico.com\/wedding-forum\/attachments\/blue-diamond-5-jpg.437\/\" alt=\"blue-diamond-5-jpg.437\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;in their gazebo or pier and foyer.&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"http:\/\/idomexico.com\/wedding-forum\/attachments\/blue-diamond-7-jpg.439\/\" alt=\"blue-diamond-7-jpg.439\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Here&#039;s a link to their website: &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bluebayresorts.com\/en\/hotel-blue-diamond-riviera-maya.html&#039;&gt;Blue Diamond Riviera Maya Hotel&lt;\/a&gt; with more info. Wishing you happy research, and that you find the Perfect place for YOU!!! cheers, Moments That Matter Photography team :)&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/static.wixstatic.com\/media\/e89d55_b276c3aebeba465d8a2a9cf77a89bcc9.jpg\/v1\/fill\/w_1200,h_800,al_c,q_90\/e89d55_b276c3aebeba465d8a2a9cf77a89bcc9.jpg\" alt=\"e89d55_b276c3aebeba465d8a2a9cf77a89bcc9.\"&gt;&lt;\/p&gt;","Attachments":[],"Id":1915236,"PostDate":1470752151,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome to the boards MichelleL and Congrats on your upcoming destination wedding!!! What an exciting time for you, no doubt <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>You'll find lots of great resources here, and everyone is so helpful, you're already off to a great start with your planning process - well done!<\/p>\n<p>\u00a0<\/p>\n<p>The Blue Diamond Riviera Maya is a small intimate adults only resort in Playa del Carmen with wedding ceremony sites on their semi-private beach,<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/idomexico.com\/wedding-forum\/attachments\/blue-diamond-5-jpg.437\/\" alt=\"blue-diamond-5-jpg.437\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>in their gazebo or pier and foyer.<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/idomexico.com\/wedding-forum\/attachments\/blue-diamond-7-jpg.439\/\" alt=\"blue-diamond-7-jpg.439\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>Here's a link to their website: <a href='http:\/\/www.bluebayresorts.com\/en\/hotel-blue-diamond-riviera-maya.html' class='bbc_url' title='External link' rel='nofollow external'>Blue Diamond Riviera Maya Hotel<\/a> with more info. Wishing you happy research, and that you find the Perfect place for YOU!!! cheers, Moments That Matter Photography team <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/static.wixstatic.com\/media\/e89d55_b276c3aebeba465d8a2a9cf77a89bcc9.jpg\/v1\/fill\/w_1200,h_800,al_c,q_90\/e89d55_b276c3aebeba465d8a2a9cf77a89bcc9.jpg\" alt=\"e89d55_b276c3aebeba465d8a2a9cf77a89bcc9.\"><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i1378.photobucket.com\/albums\/ah106\/ContactIDoMexico\/MTM%20Logo%202016_zps4tzm05my.png\" alt=\"MTM%20Logo%202016_zps4tzm05my.png\"><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography , Cancun, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving the Riviera Maya<\/p>\n<p>\u00a0<\/p>\n<p>Email: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p><span style=\"color:#0000cd;\"><strong>Why we're Ranked #1<\/strong><\/span> ~ Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21512-moments-that-matter-photography\/'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a><\/p>\n<p>\u00a0<\/p>\n<p><strong><span style=\"color:#0000cd;\"><span style=\"font-family:'comic sans ms', cursive;\">We Offer<\/span><\/span><\/strong>: <strong><em><u>100% Vendor Fee Discount<\/u><br>\n\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 <u>100% Deposit Guarantee<\/u><\/em><\/strong><\/p>\n<p><strong><em>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 \u00a0 <u>100% Satisfaction Guarantee<\/u><\/em><\/strong>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280196260,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.67.9.47","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80235,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"36b827dfb2a7958f66988b1ab048c70e","RawContent":"&lt;p&gt;Hi Michelle! Congrats on your engagement&amp;nbsp; ;)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I would totally suggest getting in contact with the&amp;nbsp;&lt;a  class=\"bbc_url\" href=\"http:\/\/www.wrighttravelagency.com\/leads\/inquiry\/\" title=\"External link\"&gt;BDW Travel Agents&lt;\/a&gt;, who can give you a plethora of options for you and your guests. They will be able to best guide you to resorts\/locations that will fit your needs.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"color:rgb(24,24,24);font-family:arial, helvetica, sans-serif;background-color:rgb(253,252,250);\"&gt;If you want to get some ideas of pricing, y&lt;\/span&gt;&lt;span style=\"color:rgb(24,24,24);font-family:arial, helvetica, sans-serif;background-color:rgb(253,252,250);\"&gt;ou can&amp;nbsp;&lt;\/span&gt;&lt;a  class=\"bbc_url\" href=\"http:\/\/www.wrighttravelagency.com\/leads\/inquiry\/\" title=\"External link\"&gt;contact them HERE!&lt;\/a&gt;&amp;nbsp;Best wishes!!!&amp;nbsp; :D&lt;\/p&gt;\n&lt;div style=\"margin:0px 0px 0px 10px;font-family:arial, helvetica, sans-serif;font-size:13.6364px;color:rgb(24,24,24);background-color:rgb(253,252,250);\"&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;\/div&gt;","Attachments":[],"Id":1915248,"PostDate":1470767521,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Michelle! Congrats on your engagement\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/><\/p>\n<p>\u00a0<\/p>\n<p>I would totally suggest getting in contact with the\u00a0<a href='http:\/\/www.wrighttravelagency.com\/leads\/inquiry\/' class='bbc_url' title='External link' rel='nofollow external'>BDW Travel Agents<\/a>, who can give you a plethora of options for you and your guests. They will be able to best guide you to resorts\/locations that will fit your needs.<\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"color:rgb(24,24,24);font-family:arial, helvetica, sans-serif;background-color:rgb(253,252,250)\">If you want to get some ideas of pricing, y<\/span><span  style=\"color:rgb(24,24,24);font-family:arial, helvetica, sans-serif;background-color:rgb(253,252,250)\">ou can\u00a0<\/span><a href='http:\/\/www.wrighttravelagency.com\/leads\/inquiry\/' class='bbc_url' title='External link' rel='nofollow external'>contact them HERE!<\/a>\u00a0Best wishes!!!\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/biggrin.png' class='bbc_emoticon' alt=':D' \/><\/p>\n<div  style=\"margin:0px 0px 0px 10px;font-family:arial, helvetica, sans-serif;font-size:13.6364px;color:rgb(24,24,24);background-color:rgb(253,252,250)\">\n<div>\u00a0<\/div>\n<\/div>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-size:18px;\"><span style=\"font-family:georgia;\"><strong>MARIESAM SANCHEZ PHOTOGRAPHY<\/strong><\/span><\/span><br>\nWEBSITE: <a  class=\"bbc_url\" href=\"http:\/\/www.mariesamsanchez.com\">www.mariesamsanchez.com<\/a><br>\nBLOG: <a  class=\"bbc_url\" href=\"http:\/\/www.mariesamsanchezblog.com\">www.mariesamsanchez.com<\/a><a data-ipb='nomediaparse' href='http:\/\/www.mariesamsanchez.com\/blog'>\/blog<\/a><br>\nCONTACT ME: <a  class=\"bbc_email\" href=\"mailto:mariesam.sanchez@gmail.com?subject=BDW%20Inquiry\" title=\"E-mail Link\">mariesam.sanchez@gmail.com<\/a><br><br><img src=\"http:\/\/i287.photobucket.com\/albums\/ll150\/msam007562\/063cb5c8-dbda-4822-87fe-ba3c0ebcdb7f.jpg\" alt=\"063cb5c8-dbda-4822-87fe-ba3c0ebcdb7f.jpg\">","Email":"mariesam.sanchez@gmail.com","IpAddress":"74.100.61.37","GroupId":38,"GroupName":"Moderators","JoinDate":1285939945,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232833.jpg?_r=1422091823","PhotoWidth":200,"PhotoHeight":220,"PhotoType":"custom"},"FormattedName":"MarieSamSanchezPhoto","Id":232833,"Name":"MarieSamSanchezPhoto","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"189.221.34.247","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80235,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f32c9a947a1fd48e724b4c7e6b21697c","RawContent":"&lt;p&gt;@[member=\"MichelleL\"] Congrats on your up coming Destination Wedding.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Are you working with a Travel agent? as they can help make this process supper easy for you. &amp;nbsp; I love that you already have 2 &amp;nbsp;major things decided on which is budget and a type of resort. Now the next step get a TA involved. &amp;nbsp;Because just with this information the can get you a great deal of options to choose from.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Have you looked at the secret maroma beach in the Riviera Maya?&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Le blanc in Cancun.&lt;\/p&gt;\n&lt;p&gt;Paradisus la Perla in the riviera maya .&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Keep us posted on what you end up deciding on.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Happy Planning!&lt;\/p&gt;","Attachments":[],"Id":1915253,"PostDate":1470787721,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"287525\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/287525-michellel\/' title='Member profile'><span itemprop=\"name\">MichelleL<\/span><\/a> Congrats on your up coming Destination Wedding.<\/p>\n<p>\u00a0<\/p>\n<p>Are you working with a Travel agent? as they can help make this process supper easy for you. \u00a0 I love that you already have 2 \u00a0major things decided on which is budget and a type of resort. Now the next step get a TA involved. \u00a0Because just with this information the can get you a great deal of options to choose from.<\/p>\n<p>\u00a0<\/p>\n<p>Have you looked at the secret maroma beach in the Riviera Maya?\u00a0<\/p>\n<p>Le blanc in Cancun.<\/p>\n<p>Paradisus la Perla in the riviera maya .<\/p>\n<p>\u00a0<\/p>\n<p>Keep us posted on what you end up deciding on.<\/p>\n<p>\u00a0<\/p>\n<p>Happy Planning!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Dream Weddings Riviera Maya- We pay attention to your wishes and coordinate closely with you to ensure your wedding or event is planned to perfection! Supporting you brides and help you feel less overwhelmed during the wedding planning process.<\/p>\n<p>Have fun the best is yet to come!<\/p>\n<p>\u00a0<\/p>\n<p>This is where I will be posting all videos about most common question about Destination wedding<\/p>\n<p> <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0\u00a0<a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/groups\/1664036763874450\/'>https:\/\/www.facebook.com\/groups\/1664036763874450\/<\/a><br><br><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Dream Weddings Riviera Maya<\/span><\/span><\/span><br><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">weddingsinplayadelcarmen@gmail.com<\/span><\/span><br><a  class=\"bbc_url\" href=\"http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html\">http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html<\/a><br><br><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Happy Planning!<\/span><\/span><\/span><br><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Joyce<\/span><\/span><\/span>","Email":"weddingsinplayadelcarmen@gmail.com","IpAddress":"187.252.44.28","GroupId":84,"GroupName":"Insiders w\/ Articles","JoinDate":1326839987,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250090.jpg?_r=1451923195","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"dreamweddings","Id":250090,"Name":"dreamweddings","IsOnline":false}}],"Id":"80235","Title":"Thinking About Guest Budgets... Help!","LastPostDate":1470787721},"Pages":{"TotalItems":7,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
