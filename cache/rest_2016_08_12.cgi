{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":5,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":true,"Views":224,"MovedTo":null,"MovedOn":0,"FirstPostId":1915199,"Rating":0,"RatingHits":0,"Starter":{"Id":286562,"Name":"Jessicaallie","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1470599517,"LastPoster":{"Id":287545,"Name":"CoolSmile","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1915199,"PostDate":1470599517,"PostContent":"My fianc\u00e9 and I are planning a destination wedding in Cancun. We would like the ceremony to be a...","Author":{"Signature":"","Email":"jessicapeters87@yahoo.com","IpAddress":"104.32.38.229","GroupId":39,"GroupName":"Newbie","JoinDate":1458842944,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Jessicaallie","Id":286562,"Name":"Jessicaallie","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"104.32.38.229","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80232,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"39124bda30a36aea2e6937fa650479c9","RawContent":"My fianc\u00e9 and I are planning a destination wedding in Cancun. We would like the ceremony to be a little more private by having it on a rooftop balcony\/ terrace. We would like to have it in the hotel zone since we both fell in love with the turquoise blue water. I know the Beach palace has a private rooftop but I was wondering if there were any other resorts that have another option. TIA!","Attachments":[],"Id":1915199,"PostDate":1470599517,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                My fianc\u00e9 and I are planning a destination wedding in Cancun. We would like the ceremony to be a little more private by having it on a rooftop balcony\/ terrace. We would like to have it in the hotel zone since we both fell in love with the turquoise blue water. I know the Beach palace has a private rooftop but I was wondering if there were any other resorts that have another option. TIA! \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jessicapeters87@yahoo.com","IpAddress":"104.32.38.229","GroupId":39,"GroupName":"Newbie","JoinDate":1458842944,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Jessicaallie","Id":286562,"Name":"Jessicaallie","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.155.180.80","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80232,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bbd53a161fe176182d2c884ee8188767","RawContent":"We are getting married in April 2017 at the Sandos Caracol Eco Resort in Riviera Maya. They have a rooftop terrace you can have your ceremony and reception at. We have chosen to have a beach ceremony but we would like a private reception so we are going to have our reception on the private rooftop terrace :)\n\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1915200,"PostDate":1470613599,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We are getting married in April 2017 at the Sandos Caracol Eco Resort in Riviera Maya. They have a rooftop terrace you can have your ceremony and reception at. We have chosen to have a beach ceremony but we would like a private reception so we are going to have our reception on the private rooftop terrace <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br><br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"xoliciaxo@hotmail.com","IpAddress":"108.180.31.5","GroupId":39,"GroupName":"Newbie","JoinDate":1422471685,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281922.jpg?_r=1471004380","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"AliciaW","Id":281922,"Name":"AliciaW","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"189.221.46.28","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80232,"EditedBy":"<strong>Edited by Moments That Matter, 08 August 2016 - 09:59 AM.<\/strong>","EditDate":1470650349,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"74fb1024811fc6f42285016c200174b6","RawContent":"&lt;p&gt;Welcome to our forum community, Jessicaallie, and Congrats on your upcoming dw in Cancun! There&#039;s lots of great info here to help answer your planning questions, as you can already see, so well done on joining us :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Here are a few romantic Cancun reception areas we captured ~ to ramp up your creativity - Enjoy!!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Taken from our &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.momentsthatmatterphotography.com\/single-post\/2016\/1\/31\/Sandos-Cancun&#039;&gt;Sandos Caracol Wedding Story Album:&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/static.wixstatic.com\/media\/e89d55_f6bcb1310a5a4ffcabe0814c21d3d5fb.jpg\/v1\/fill\/w_1200,h_800,al_c,q_90\/e89d55_f6bcb1310a5a4ffcabe0814c21d3d5fb.jpg\" alt=\"e89d55_f6bcb1310a5a4ffcabe0814c21d3d5fb.\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;This video captured at the &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.momentsthatmatterphotography.com\/riviera-maya-resorts\/tag\/Beach-Palace-Cancun&#039;&gt;Beach Palace Cancun Wedding Story&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;.....and this from the &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.momentsthatmatterphotography.com\/single-post\/2016\/02\/03\/Dreams-Riviera-Cancun-Margo-Eric&#039;&gt;Dreams Riviera Cancun Wedding Story Album: &lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/static.wixstatic.com\/media\/e89d55_21fc7500b78e4fec81a7a9014ace1e38.jpg\/v1\/fill\/w_1200,h_800,al_c,q_90\/e89d55_21fc7500b78e4fec81a7a9014ace1e38.jpg\" alt=\"e89d55_21fc7500b78e4fec81a7a9014ace1e38.\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Wishing you happy research, and all the best with your plans - cheers!!! Moments That Matter Photography team :)&lt;\/p&gt;","Attachments":[],"Id":1915205,"PostDate":1470650298,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome to our forum community, Jessicaallie, and Congrats on your upcoming dw in Cancun! There's lots of great info here to help answer your planning questions, as you can already see, so well done on joining us <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Here are a few romantic Cancun reception areas we captured ~ to ramp up your creativity - Enjoy!!!<\/p>\n<p>\u00a0<\/p>\n<p>Taken from our <a href='http:\/\/www.momentsthatmatterphotography.com\/single-post\/2016\/1\/31\/Sandos-Cancun' class='bbc_url' title='External link' rel='nofollow external'>Sandos Caracol Wedding Story Album:<\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/static.wixstatic.com\/media\/e89d55_f6bcb1310a5a4ffcabe0814c21d3d5fb.jpg\/v1\/fill\/w_1200,h_800,al_c,q_90\/e89d55_f6bcb1310a5a4ffcabe0814c21d3d5fb.jpg\" alt=\"e89d55_f6bcb1310a5a4ffcabe0814c21d3d5fb.\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>This video captured at the <a href='http:\/\/www.momentsthatmatterphotography.com\/riviera-maya-resorts\/tag\/Beach-Palace-Cancun' class='bbc_url' title='External link' rel='nofollow external'>Beach Palace Cancun Wedding Story<\/a><\/p>\n<p>\u00a0<\/p>\n<p>.....and this from the <a href='http:\/\/www.momentsthatmatterphotography.com\/single-post\/2016\/02\/03\/Dreams-Riviera-Cancun-Margo-Eric' class='bbc_url' title='External link' rel='nofollow external'>Dreams Riviera Cancun Wedding Story Album: <\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/static.wixstatic.com\/media\/e89d55_21fc7500b78e4fec81a7a9014ace1e38.jpg\/v1\/fill\/w_1200,h_800,al_c,q_90\/e89d55_21fc7500b78e4fec81a7a9014ace1e38.jpg\" alt=\"e89d55_21fc7500b78e4fec81a7a9014ace1e38.\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>Wishing you happy research, and all the best with your plans - cheers!!! Moments That Matter Photography team <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i1378.photobucket.com\/albums\/ah106\/ContactIDoMexico\/MTM%20Logo%202016_zps4tzm05my.png\" alt=\"MTM%20Logo%202016_zps4tzm05my.png\"><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography , Cancun, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving the Riviera Maya<\/p>\n<p>\u00a0<\/p>\n<p>Email: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p><span style=\"color:#0000cd;\"><strong>Why we're Ranked #1<\/strong><\/span> ~ Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21512-moments-that-matter-photography\/'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a><\/p>\n<p>\u00a0<\/p>\n<p><strong><span style=\"color:#0000cd;\"><span style=\"font-family:'comic sans ms', cursive;\">We Offer<\/span><\/span><\/strong>: <strong><em><u>100% Vendor Fee Discount<\/u><br>\n\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 <u>100% Deposit Guarantee<\/u><\/em><\/strong><\/p>\n<p><strong><em>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 \u00a0 <u>100% Satisfaction Guarantee<\/u><\/em><\/strong>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280196260,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"187.153.140.201","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80232,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"12cd280dd198e566332961514fb90909","RawContent":"&lt;p&gt;@[member=\"Jessicaallie\"] Congrats on your upcoming wedding, and welcome to the BDW forums. You&#039;ll find these forums and this site to be a vital tool while planning for your dream destination wedding. I know there was already a suggestion by&amp;nbsp;@[member=\"AliciaW\"] (congrats with your April 2017 wedding, btw!) regarding the private rooftop at Sandos Caracol, along the Riviera Maya strip (closer to Playa del Carmen than Cancun). We have had the pleasure of photographing at that resort several times, once even with the ceremony and the reception all private on the rooftop, which are the photo examples that follow. You&#039;ll notice there&#039;s a decorative pool on the rooftop, plenty of seating available, and you have your own private serviced bar too.&amp;nbsp;\n\n\n\n\n\n\n\n\n\nAnother GREAT option would be Azul Fives. Again, this is not along the hotel strip in Cancun, but in the Riviera Maya. The resort is wonderful, great staff, grounds well maintained, a pier to use for photos, and the option to have the ceremony and\/or reception on the rooftop terrace, which is again completely private. The turquoise waters are still visible from the rooftop, and make for a great backdrop with the photos. I&#039;m including a few examples from a recent wedding we photographed there that really highlight how lovely the water looks, how nice the setup with the resort is, and an evening entrance photo so you can see the other portion of the space (the stairs &amp;amp; elevator used to\/from the rooftop).&amp;nbsp;\n\n\n\n\n\n\n\n\n\n\n\nIf you have any other questions, don&#039;t be shy to ask. Happy planning!&amp;nbsp;\n\n\n&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1915209,"PostDate":1470664670,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"286562\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/286562-jessicaallie\/' title='Member profile'><span itemprop=\"name\">Jessicaallie<\/span><\/a> Congrats on your upcoming wedding, and welcome to the BDW forums. You'll find these forums and this site to be a vital tool while planning for your dream destination wedding. I know there was already a suggestion by\u00a0@<a hovercard-ref=\"member\" hovercard-id=\"281922\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281922-aliciaw\/' title='Member profile'><span itemprop=\"name\">AliciaW<\/span><\/a> (congrats with your April 2017 wedding, btw!) regarding the private rooftop at Sandos Caracol, along the Riviera Maya strip (closer to Playa del Carmen than Cancun). We have had the pleasure of photographing at that resort several times, once even with the ceremony and the reception all private on the rooftop, which are the photo examples that follow. You'll notice there's a decorative pool on the rooftop, plenty of seating available, and you have your own private serviced bar too.\u00a0<br><br>\n<a class='resized_img' rel='lightbox[1915209]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2016\/post-287055-0-54307400-1470678009.jpg\" title=\"Tiffany_Sean_Web_025.jpg - Size: 189.42KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2016\/post-287055-0-54307400-1470678009.jpg\" class='bbc_img linked-image' alt=\"Tiffany_Sean_Web_025.jpg\" \/><\/a>\n\n<br>\n<a class='resized_img' rel='lightbox[1915209]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2016\/post-287055-0-42824400-1470678093.jpg\" title=\"Tiffany_Sean_Web_046.jpg - Size: 92.19KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2016\/post-287055-0-42824400-1470678093.jpg\" class='bbc_img linked-image' alt=\"Tiffany_Sean_Web_046.jpg\" \/><\/a>\n\n<br>\n<a class='resized_img' rel='lightbox[1915209]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2016\/post-287055-0-89718000-1470678170.jpg\" title=\"Tiffany_Sean_Web_048.jpg - Size: 113.71KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2016\/post-287055-0-89718000-1470678170.jpg\" class='bbc_img linked-image' alt=\"Tiffany_Sean_Web_048.jpg\" \/><\/a>\n\n<br><br>\nAnother GREAT option would be Azul Fives. Again, this is not along the hotel strip in Cancun, but in the Riviera Maya. The resort is wonderful, great staff, grounds well maintained, a pier to use for photos, and the option to have the ceremony and\/or reception on the rooftop terrace, which is again completely private. The turquoise waters are still visible from the rooftop, and make for a great backdrop with the photos. I'm including a few examples from a recent wedding we photographed there that really highlight how lovely the water looks, how nice the setup with the resort is, and an evening entrance photo so you can see the other portion of the space (the stairs & elevator used to\/from the rooftop).\u00a0<br><br>\n<a class='resized_img' rel='lightbox[1915209]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2016\/post-287055-0-93324800-1470678258.jpg\" title=\"Kristen_Michael_Teaser_12.jpg - Size: 82.08KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2016\/post-287055-0-93324800-1470678258.jpg\" class='bbc_img linked-image' alt=\"Kristen_Michael_Teaser_12.jpg\" \/><\/a>\n\n<br>\n<a class='resized_img' rel='lightbox[1915209]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2016\/post-287055-0-49771400-1470678373.jpg\" title=\"Kristen_Michael_Teaser_21.jpg - Size: 111.62KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2016\/post-287055-0-49771400-1470678373.jpg\" class='bbc_img linked-image' alt=\"Kristen_Michael_Teaser_21.jpg\" \/><\/a>\n\n<br>\n<a class='resized_img' rel='lightbox[1915209]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2016\/post-287055-0-10060000-1470678847.jpg\" title=\"Kristen_Michael_Teaser_22.jpg - Size: 74.67KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2016\/post-287055-0-10060000-1470678847.jpg\" class='bbc_img linked-image' alt=\"Kristen_Michael_Teaser_22.jpg\" \/><\/a>\n\n<br>\n<a class='resized_img' rel='lightbox[1915209]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2016\/post-287055-0-99356900-1470678472.jpg\" title=\"Kristen_Michael_Teaser_08.jpg - Size: 65.96KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2016\/post-287055-0-99356900-1470678472.jpg\" class='bbc_img linked-image' alt=\"Kristen_Michael_Teaser_08.jpg\" \/><\/a>\n\n<br><br>\nIf you have any other questions, don't be shy to ask. Happy planning!\u00a0<br><br>\n\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-family:tahoma, geneva, sans-serif;\"><strong><span style=\"font-size:18px;\">Jasmin & Matt - Breathtaking Destination Wedding & Lifestyle Photography<\/span><\/strong><\/span><\/p>\n<p><span style=\"font-family:tahoma, geneva, sans-serif;\"><span style=\"font-size:14px;\"><img src=\"http:\/\/www.jasminandmatt.com\/wp-content\/uploads\/2016\/07\/star.png\" alt=\"star.png\"><img src=\"http:\/\/www.jasminandmatt.com\/wp-content\/uploads\/2016\/07\/star.png\" alt=\"star.png\"><img src=\"http:\/\/www.jasminandmatt.com\/wp-content\/uploads\/2016\/07\/star.png\" alt=\"star.png\"><img src=\"http:\/\/www.jasminandmatt.com\/wp-content\/uploads\/2016\/07\/star.png\" alt=\"star.png\"><img src=\"http:\/\/www.jasminandmatt.com\/wp-content\/uploads\/2016\/07\/star.png\" alt=\"star.png\">\u00a0rating on <a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/jasminandmatt\/reviews'>Facebook<\/a> & <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21784-jasmin-matt-photography\/'>BestDestinationWedding.com<\/a><\/span><\/span><\/p>\n<p><span style=\"font-family:tahoma, geneva, sans-serif;\"><span style=\"font-size:14px;\">Still not convinced? Read our <a data-ipb='nomediaparse' href='http:\/\/www.jasminandmatt.com\/info\/testimonials\/'>testimonials of appreciation from previous couples <3<\/a><\/span><\/span><\/p>\n<p><span style=\"font-family:tahoma, geneva, sans-serif;\"><span style=\"font-size:14px;\"><strong>Website:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);\"><a data-ipb='nomediaparse' href='http:\/\/www.jasminandmatt.com\/'>http:\/\/www.jasminandmatt.com<\/a><\/span><br><strong>Email:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);\"><a data-ipb='nomediaparse' href='mailto:info@jasminandmatt.com'>info@jasminandmatt.com<\/a><\/span><br><strong>Phone:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);\">+52 984-114-3386<\/span><br><strong>Facebook:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);\"><a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/jasminandmatt\/'>Jasmin & Matt Photography<\/a><\/span><br><strong>Instagram:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);\"><a data-ipb='nomediaparse' href='https:\/\/www.instagram.com\/jasminandmattphotography\/'>@jasminandmattphotography<\/a><\/span><br><strong>Pinterest:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);\"><a data-ipb='nomediaparse' href='https:\/\/www.pinterest.com\/jasminandmatt'>Jasmin & Matt<\/a><\/span><\/span><\/span><\/p>\n<p><span style=\"font-family:tahoma, geneva, sans-serif;\"><span style=\"font-size:14px;\">Ask us how we can help you plan your perfect wedding day.<\/span><\/span>","Email":"forward@jasminandmatt.com","IpAddress":"187.153.21.84","GroupId":49,"GroupName":"Insiders","JoinDate":1464781539,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-287055.jpg?_r=1464796174","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"JasminMattPhoto","Id":287055,"Name":"JasminMattPhoto","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"109.103.137.60","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80232,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fb01550b29b69135ded7639e51cb9de3","RawContent":"[quote name=\"Jessicaallie\" post=\"1915199\" timestamp=\"1470613917\"]\nMy fianc\u00e9 and I are planning a destination wedding in Cancun. We would like the ceremony to be a little more private by having it on a rooftop balcony\/ terrace. We would like to have it in the hotel zone since we both fell in love with the turquoise blue water. I know the Beach palace has a private rooftop but I was wondering if there were any other resorts that have another option. TIA![\/quote]Hey :)\nMe and my fiance visited Cancun and we loved it. The hotel where we stayed was incredible. I recommend it with confidence and I think it fits what you want. Here it is on google maps : \n\n[url=\"https:\/\/www.google.com\/maps\/place\/Hotel+Riu+Cancun\/@21.133109,-86.7483977,16.54z\/data=!4m5!3m4!1s0x0:0xd67c09561b4e626d!8m2!3d21.1374802!4d-86.7481568\"]https:\/\/www.google.com\/maps\/place\/Hotel+Riu+Cancun\/@21.133109,-86.7483977,16.54z\/data=!4m5!3m4!1s0x0:0xd67c09561b4e626d!8m2!3d21.1374802!4d-86.7481568[\/url]","Attachments":[],"Id":1915283,"PostDate":1470984739,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Jessicaallie, on 07 August 2016 - 07:51 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>My fianc\u00e9 and I are planning a destination wedding in Cancun. We would like the ceremony to be a little more private by having it on a rooftop balcony\/ terrace. We would like to have it in the hotel zone since we both fell in love with the turquoise blue water. I know the Beach palace has a private rooftop but I was wondering if there were any other resorts that have another option. TIA!<\/p>\n<\/div>\n<\/div><\/div>\n<p>Hey <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>Me and my fiance visited Cancun and we loved it. The hotel where we stayed was incredible. I recommend it with confidence and I think it fits what you want. Here it is on google maps :\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><a href='https:\/\/www.google.com\/maps\/place\/Hotel+Riu+Cancun\/@21.133109,-86.7483977,16.54z\/data=!4m5!3m4!1s0x0:0xd67c09561b4e626d!8m2!3d21.1374802!4d-86.7481568' class='bbc_url' title='External link' rel='nofollow external'>https:\/\/www.google.c...2!4d-86.7481568<\/a><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"vstn@mail.com","IpAddress":"95.76.207.178","GroupId":39,"GroupName":"Newbie","JoinDate":1470888342,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"CoolSmile","Id":287545,"Name":"CoolSmile","IsOnline":false}}],"Id":"80232","Title":"Cancun Resorts With Private Rooftop Terrace\/balcony?","LastPostDate":1470984739},"Pages":{"TotalItems":5,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
