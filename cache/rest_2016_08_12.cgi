{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":4,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":true,"Views":274,"MovedTo":null,"MovedOn":0,"FirstPostId":1914990,"Rating":0,"RatingHits":0,"Starter":{"Id":287366,"Name":"Latashaingram","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1469216225,"LastPoster":{"Id":285479,"Name":"TAPreety","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-285479.jpg?_r=1450836897","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1915079,"PostDate":1469744385,"PostContent":"@Latashaingram\u00a0Congratulations on your destination wedding in Punta Cana!! \u00a0I would strongly reco...","Author":{"Signature":"<p><b>Preety Jaswal - Canadian Wedding Specialist<\/b><\/p>\n<div style=\"font-family:arial, sans-serif;font-size:12.8px;\"><a data-ipb='nomediaparse' href='https:\/\/www.wrighttravelagency.com\/go\/destination-wedding\/?source=EMLSIG' title=\"External link\"><strong><span style=\"color:rgb(0,128,128);\">Looking for a travel agency that specializes in Destination Weddings-CLICK HERE<\/span><\/strong><\/a><span style=\"font-family:arial, helvetica, sans-serif;font-size:14px;color:rgb(0,128,128);\"><strong>?<\/strong>\u00a0\u00a0We are an award winning travel agency and you can\u00a0<\/span><strong><span style=\"color:rgb(0,128,128);\"><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/' title=\"\">read our reviews\u00a0here.<\/a><\/span><\/strong><\/div>\n","Email":"preety@travelbyplatinum.com","IpAddress":"69.50.165.200","GroupId":49,"GroupName":"Insiders","JoinDate":1448903039,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-285479.jpg?_r=1450836897","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"TAPreety","Id":285479,"Name":"TAPreety","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.193.135.206","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80208,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"293415e678cef8f490fa27c33f96fadd","RawContent":"I plan to have a destination wedding, ceremony and reception at the jellyfish restaurant in punta cana in June. I would like some advice from anyone thst has had experience with this venue, what hotel did you and guest stay at and most importantly any cost saving tips. Planning to have 20-30 people","Attachments":[],"Id":1914990,"PostDate":1469216225,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I plan to have a destination wedding, ceremony and reception at the jellyfish restaurant in punta cana in June. I would like some advice from anyone thst has had experience with this venue, what hotel did you and guest stay at and most importantly any cost saving tips. Planning to have 20-30 people\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"latasha.ingram@yahoo.com","IpAddress":"70.193.164.155","GroupId":39,"GroupName":"Newbie","JoinDate":1468711613,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Latashaingram","Id":287366,"Name":"Latashaingram","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"187.153.103.208","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80208,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c31436b6d3209c29af1b5ddac3a6df2c","RawContent":"&lt;p&gt;Hola @[member=\"Latashaingram\"] and welcome to the amazing bestdestinationwedding.com community. &amp;nbsp;The venue you are planning to have your wedding at looks absolutely incredible!!!! You are going to have such an amazing time.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;If you have any questions in terms of wedding photography or scheduling your wedding day please let us know and we&#039;d be happy to help and lend our experience &amp;lt;3&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;","Attachments":[],"Id":1914999,"PostDate":1469275037,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hola @<a hovercard-ref=\"member\" hovercard-id=\"287366\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/287366-latashaingram\/' title='Member profile'><span itemprop=\"name\">Latashaingram<\/span><\/a> and welcome to the amazing bestdestinationwedding.com community. \u00a0The venue you are planning to have your wedding at looks absolutely incredible!!!! You are going to have such an amazing time.<\/p>\n<p>\u00a0<\/p>\n<p>If you have any questions in terms of wedding photography or scheduling your wedding day please let us know and we'd be happy to help and lend our experience <3<\/p>\n<p>\u00a0<\/p>\n<p><a class='resized_img' rel='lightbox[1914999]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2016\/post-287055-0-19358600-1469289166.jpg\" title=\"Jannet_Evan_Teaser_06.jpg - Size: 175.38KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2016\/post-287055-0-19358600-1469289166.jpg\" class='bbc_img linked-image' alt=\"Jannet_Evan_Teaser_06.jpg\" \/><\/a>\n\n<a class='resized_img' rel='lightbox[1914999]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2016\/post-287055-0-26386200-1469289184.jpg\" title=\"Kayla_Jason_Teaser_15.jpg - Size: 106.44KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2016\/post-287055-0-26386200-1469289184.jpg\" class='bbc_img linked-image' alt=\"Kayla_Jason_Teaser_15.jpg\" \/><\/a>\n\n<a class='resized_img' rel='lightbox[1914999]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2016\/post-287055-0-91922500-1469289193.jpg\" title=\"Jessica_Brennan_Teaser_14.jpg - Size: 532.45KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2016\/post-287055-0-91922500-1469289193.jpg\" class='bbc_img linked-image' alt=\"Jessica_Brennan_Teaser_14.jpg\" \/><\/a>\n\n<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-family:tahoma, geneva, sans-serif;\"><strong><span style=\"font-size:18px;\">Jasmin & Matt - Breathtaking Destination Wedding & Lifestyle Photography<\/span><\/strong><\/span><\/p>\n<p><span style=\"font-family:tahoma, geneva, sans-serif;\"><span style=\"font-size:14px;\"><img src=\"http:\/\/www.jasminandmatt.com\/wp-content\/uploads\/2016\/07\/star.png\" alt=\"star.png\"><img src=\"http:\/\/www.jasminandmatt.com\/wp-content\/uploads\/2016\/07\/star.png\" alt=\"star.png\"><img src=\"http:\/\/www.jasminandmatt.com\/wp-content\/uploads\/2016\/07\/star.png\" alt=\"star.png\"><img src=\"http:\/\/www.jasminandmatt.com\/wp-content\/uploads\/2016\/07\/star.png\" alt=\"star.png\"><img src=\"http:\/\/www.jasminandmatt.com\/wp-content\/uploads\/2016\/07\/star.png\" alt=\"star.png\">\u00a0rating on <a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/jasminandmatt\/reviews'>Facebook<\/a> & <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21784-jasmin-matt-photography\/'>BestDestinationWedding.com<\/a><\/span><\/span><\/p>\n<p><span style=\"font-family:tahoma, geneva, sans-serif;\"><span style=\"font-size:14px;\">Still not convinced? Read our <a data-ipb='nomediaparse' href='http:\/\/www.jasminandmatt.com\/info\/testimonials\/'>testimonials of appreciation from previous couples <3<\/a><\/span><\/span><\/p>\n<p><span style=\"font-family:tahoma, geneva, sans-serif;\"><span style=\"font-size:14px;\"><strong>Website:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);\"><a data-ipb='nomediaparse' href='http:\/\/www.jasminandmatt.com\/'>http:\/\/www.jasminandmatt.com<\/a><\/span><br><strong>Email:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);\"><a data-ipb='nomediaparse' href='mailto:info@jasminandmatt.com'>info@jasminandmatt.com<\/a><\/span><br><strong>Phone:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);\">+52 984-114-3386<\/span><br><strong>Facebook:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);\"><a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/jasminandmatt\/'>Jasmin & Matt Photography<\/a><\/span><br><strong>Instagram:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);\"><a data-ipb='nomediaparse' href='https:\/\/www.instagram.com\/jasminandmattphotography\/'>@jasminandmattphotography<\/a><\/span><br><strong>Pinterest:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);\"><a data-ipb='nomediaparse' href='https:\/\/www.pinterest.com\/jasminandmatt'>Jasmin & Matt<\/a><\/span><\/span><\/span><\/p>\n<p><span style=\"font-family:tahoma, geneva, sans-serif;\"><span style=\"font-size:14px;\">Ask us how we can help you plan your perfect wedding day.<\/span><\/span>","Email":"forward@jasminandmatt.com","IpAddress":"187.153.21.84","GroupId":49,"GroupName":"Insiders","JoinDate":1464781539,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-287055.jpg?_r=1464796174","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"JasminMattPhoto","Id":287055,"Name":"JasminMattPhoto","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"189.221.46.28","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80208,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"dc15c7cff4bbb26b1cb458c0f3210721","RawContent":"&lt;p&gt;Welcome to the forum community Latashaingram, and Congrats on your DR wedding next June!!! You&#039;re sure to find lots of helpful resources here to answer your planning questions, so well done on getting a good start on your process.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We&#039;re based in the Mayan Riviera, so can&#039;t really advise you on the Jellyfish, however here&#039;s a link to some threads talking about it.....&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/index.php?s=088fcdc93c2f5e49fcf74be6a2ab10b2&amp;amp;app=googlecse#gsc.tab=0&amp;amp;gsc.q=Jellyfish&#039;&gt;Jellyfish Restaurant threads&lt;\/a&gt; hope that helps :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;For some added inspiration, here are a few magical beach wedding moments we captured in Mexico, taken from our &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.momentsthatmatterphotography.com\/riviera-maya-resorts&#039;&gt;Riviera Maya Wedding Story Albums&lt;\/a&gt;.....enjoy!!!&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/static.wixstatic.com\/media\/e89d55_f83fc0a2087f49f287ef9da5704b1405~mv2.jpg\/v1\/fill\/w_1200,h_800,al_c,q_90\/e89d55_f83fc0a2087f49f287ef9da5704b1405~mv2.jpg\" alt=\"e89d55_f83fc0a2087f49f287ef9da5704b1405~\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/static.wixstatic.com\/media\/e89d55_49b175513da246878994045d97334701~mv2.jpg\/v1\/fill\/w_1200,h_800,al_c,q_90\/e89d55_49b175513da246878994045d97334701~mv2.jpg\" alt=\"e89d55_49b175513da246878994045d97334701~\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/static.wixstatic.com\/media\/e89d55_dadce00eb9e84a089344330a08f0e2e1~mv2.jpg\/v1\/fill\/w_1200,h_800,al_c,q_90\/e89d55_dadce00eb9e84a089344330a08f0e2e1~mv2.jpg\" alt=\"e89d55_dadce00eb9e84a089344330a08f0e2e1~\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Wishing you happy research, and all the best with your plans! Enjoy your amazing journey ahead - cheers!!!&lt;\/p&gt;\n&lt;p&gt;Moments That Matter Photography team :)&lt;\/p&gt;","Attachments":[],"Id":1915041,"PostDate":1469542028,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome to the forum community Latashaingram, and Congrats on your DR wedding next June!!! You're sure to find lots of helpful resources here to answer your planning questions, so well done on getting a good start on your process.<\/p>\n<p>\u00a0<\/p>\n<p>We're based in the Mayan Riviera, so can't really advise you on the Jellyfish, however here's a link to some threads talking about it.....<a href='http:\/\/www.bestdestinationwedding.com\/index.php?s=088fcdc93c2f5e49fcf74be6a2ab10b2&app=googlecse#gsc.tab=0&gsc.q=Jellyfish' class='bbc_url' title=''>Jellyfish Restaurant threads<\/a> hope that helps <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>For some added inspiration, here are a few magical beach wedding moments we captured in Mexico, taken from our <a href='http:\/\/www.momentsthatmatterphotography.com\/riviera-maya-resorts' class='bbc_url' title='External link' rel='nofollow external'>Riviera Maya Wedding Story Albums<\/a>.....enjoy!!!<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/static.wixstatic.com\/media\/e89d55_f83fc0a2087f49f287ef9da5704b1405~mv2.jpg\/v1\/fill\/w_1200,h_800,al_c,q_90\/e89d55_f83fc0a2087f49f287ef9da5704b1405~mv2.jpg\" alt=\"e89d55_f83fc0a2087f49f287ef9da5704b1405~\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/static.wixstatic.com\/media\/e89d55_49b175513da246878994045d97334701~mv2.jpg\/v1\/fill\/w_1200,h_800,al_c,q_90\/e89d55_49b175513da246878994045d97334701~mv2.jpg\" alt=\"e89d55_49b175513da246878994045d97334701~\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/static.wixstatic.com\/media\/e89d55_dadce00eb9e84a089344330a08f0e2e1~mv2.jpg\/v1\/fill\/w_1200,h_800,al_c,q_90\/e89d55_dadce00eb9e84a089344330a08f0e2e1~mv2.jpg\" alt=\"e89d55_dadce00eb9e84a089344330a08f0e2e1~\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>Wishing you happy research, and all the best with your plans! Enjoy your amazing journey ahead - cheers!!!<\/p>\n<p>Moments That Matter Photography team <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i1378.photobucket.com\/albums\/ah106\/ContactIDoMexico\/MTM%20Logo%202016_zps4tzm05my.png\" alt=\"MTM%20Logo%202016_zps4tzm05my.png\"><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography , Cancun, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving the Riviera Maya<\/p>\n<p>\u00a0<\/p>\n<p>Email: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p><span style=\"color:#0000cd;\"><strong>Why we're Ranked #1<\/strong><\/span> ~ Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21512-moments-that-matter-photography\/'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a><\/p>\n<p>\u00a0<\/p>\n<p><strong><span style=\"color:#0000cd;\"><span style=\"font-family:'comic sans ms', cursive;\">We Offer<\/span><\/span><\/strong>: <strong><em><u>100% Vendor Fee Discount<\/u><br>\n\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 <u>100% Deposit Guarantee<\/u><\/em><\/strong><\/p>\n<p><strong><em>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 \u00a0 <u>100% Satisfaction Guarantee<\/u><\/em><\/strong>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280196260,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"69.50.165.212","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80208,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"dde0bed4ee1d02205debaf08e5a25ae3","RawContent":"&lt;p&gt;@Latashaingram&amp;nbsp;&lt;span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\"&gt;Congratulations on your destination wedding in Punta Cana!! &amp;nbsp;I would strongly recommend you both work with a TA as we seem to get answers a lot quicker back for our clients. &amp;nbsp;Also when looking at group pricing we look at all options available and quote you the best price with all details explained. &amp;nbsp;There is a lot of work involved when planning a destination wedding so why not work with a professional as there is no extra cost to you for our services. &amp;nbsp;&lt;\/span&gt;&lt;span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\"&gt;You can contact us through this form&amp;nbsp;&lt;\/span&gt;&lt;a  class=\"bbc_url\" href=\"http:\/\/www.wrighttravelagency.com\/leads\/inquiry\/\" title=\"External link\"&gt;here&lt;\/a&gt;&lt;span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\"&gt;&amp;nbsp;as I am one of the TA&#039;s for BDW. &amp;nbsp;&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1915079,"PostDate":1469744385,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@Latashaingram\u00a0<span  style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif\">Congratulations on your destination wedding in Punta Cana!! \u00a0I would strongly recommend you both work with a TA as we seem to get answers a lot quicker back for our clients. \u00a0Also when looking at group pricing we look at all options available and quote you the best price with all details explained. \u00a0There is a lot of work involved when planning a destination wedding so why not work with a professional as there is no extra cost to you for our services. \u00a0<\/span><span  style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif\">You can contact us through this form\u00a0<\/span><a href='http:\/\/www.wrighttravelagency.com\/leads\/inquiry\/' class='bbc_url' title='External link' rel='nofollow external'>here<\/a><span  style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif\">\u00a0as I am one of the TA's for BDW. \u00a0<\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><b>Preety Jaswal - Canadian Wedding Specialist<\/b><\/p>\n<div style=\"font-family:arial, sans-serif;font-size:12.8px;\"><a data-ipb='nomediaparse' href='https:\/\/www.wrighttravelagency.com\/go\/destination-wedding\/?source=EMLSIG' title=\"External link\"><strong><span style=\"color:rgb(0,128,128);\">Looking for a travel agency that specializes in Destination Weddings-CLICK HERE<\/span><\/strong><\/a><span style=\"font-family:arial, helvetica, sans-serif;font-size:14px;color:rgb(0,128,128);\"><strong>?<\/strong>\u00a0\u00a0We are an award winning travel agency and you can\u00a0<\/span><strong><span style=\"color:rgb(0,128,128);\"><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/' title=\"\">read our reviews\u00a0here.<\/a><\/span><\/strong><\/div>\n","Email":"preety@travelbyplatinum.com","IpAddress":"69.50.165.200","GroupId":49,"GroupName":"Insiders","JoinDate":1448903039,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-285479.jpg?_r=1450836897","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"TAPreety","Id":285479,"Name":"TAPreety","IsOnline":false}}],"Id":"80208","Title":"Newbie Punta Cana Destination Wedding","LastPostDate":1469744385},"Pages":{"TotalItems":4,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
