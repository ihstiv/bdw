{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.14.13.91","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79819,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"09783686d27cefdc6b61ab0aa2289f80","RawContent":"&lt;p&gt;&lt;span style=\"color:rgb(31,31,31);font-family:Arial, sans-serif;\"&gt;I am looking into a destination wedding in Jamaica for May 2017 most likely in Montego Bay. Has anyone attended or had a wedding in Jamaica? Or stayed at a great resort that is affordable? I would like to get recommendations for all inclusive resorts in the area. If anyone could tell me both good and bad things about different resorts, it would be very helpful! Thanks!&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1908730,"PostDate":1451319816,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span  style=\"color:rgb(31,31,31);font-family:Arial, sans-serif\">I am looking into a destination wedding in Jamaica for May 2017 most likely in Montego Bay. Has anyone attended or had a wedding in Jamaica? Or stayed at a great resort that is affordable? I would like to get recommendations for all inclusive resorts in the area. If anyone could tell me both good and bad things about different resorts, it would be very helpful! Thanks!<\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kristendelpin@gmail.com","IpAddress":"108.14.13.91","GroupId":39,"GroupName":"Newbie","JoinDate":1451319675,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kristendelpin","Id":285703,"Name":"kristendelpin","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"172.73.7.39","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79819,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"b8c278d3adb54debe34d4b95fc77f722","RawContent":"&lt;p&gt;Hi kristendelpin!!&amp;nbsp; Just written a review for Secrets Wild Orchid.&amp;nbsp; My guests and I had a FABULOUS time there!! You will not be disappointed!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Happy planning!!&lt;\/p&gt;","Attachments":[],"Id":1908736,"PostDate":1451355785,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi kristendelpin!!\u00a0 Just written a review for Secrets Wild Orchid.\u00a0 My guests and I had a FABULOUS time there!! You will not be disappointed!!<\/p>\n<p>\u00a0<\/p>\n<p>Happy planning!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"pinkiesup08@gmail.com","IpAddress":"75.181.5.152","GroupId":47,"GroupName":"Site Supporter","JoinDate":1374617724,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-271841.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"RandL2015","Id":271841,"Name":"RandL2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.202.225.11","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79819,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"cbf3adf0361c9e0add58509734dfc4a1","RawContent":"&lt;p&gt;@TA Babs,&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;can you help?&lt;\/p&gt;","Attachments":[],"Id":1908791,"PostDate":1451524882,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@TA Babs,<\/p>\n<p>\u00a0<\/p>\n<p>can you help?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-family:arial, helvetica, sans-serif;\">Founder and Owner of BestDestinationWedding.com \u00a0\/ \u00a0<\/span><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/'><strong><span style=\"font-family:arial, helvetica, sans-serif;\">Bride & Groom Fly FREE Promotion<\/span><\/strong><\/a><\/p>\n<p>\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><a data-ipb='nomediaparse' href='https:\/\/www.wrighttravelagency.com\/go\/destination-wedding\/?source=EMLSIG'><strong><span style=\"color:#008080;\">Looking for a travel agency that specializes in Destination Weddings-CLICK HERE<\/span><\/strong><\/a><span style=\"color:#008080;\"><strong>?<\/strong> \u00a0We are an award winning travel agency and you can <\/span><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style=\"color:#008080;\">read our reviews\u00a0here.<\/span><\/a><\/strong><\/span><br>\n\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"color:#008080;\"><strong>Awards and recognition:\u00a0<\/strong><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Palace Resorts Winner \"Top Travel Agent\", \"Top Homebased Travel Agency\" PRO Platinum Agency (Top Award) \u00a0 \u00a0 | \u00a0 \u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">AMResorts Master Agent & Top Agency \u00a0<\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/68050-karisma-hotels-givc-and-gi-wedding-consultants-wright-travel-agency\/'><strong>Wright Travel & Karisma GIVC Benefits<\/strong><\/a><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Travel Impressions Best of the Best Globe Winner \u00a0 \u00a0| \u00a0 \u00a0\u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Apple Vacations Golden Apple Winner \u00a0<\/span><\/span><br><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17612\/sml_gallery_206696_17612_13451.png\" alt=\"sml_gallery_206696_17612_13451.png\"><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"> \u00a0 \u00a0<img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"font-size:14px;\"><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010'>Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><\/span><\/span><strong><span style=\"color:#b22222;\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a data-ipb='nomediaparse' href='mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com'>ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"admin@bestdestinationwedding.com","IpAddress":"71.202.225.11","GroupId":4,"GroupName":"Administrators","JoinDate":1137227820,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"FormattedName":"TammyWright","Id":206696,"Name":"TammyWright","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"98.210.33.53","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79819,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":4,"IsLiked":false,"PostKey":"aaeef15a764133ac7b23c5d101f643d0","RawContent":"[quote name=\"kristendelpin\" post=\"1908730\" timestamp=\"1451316216\"]\n[color=rgb(31,31,31)][font=Arial]I am looking into a destination wedding in Jamaica for May 2017 most likely in Montego Bay. Has anyone attended or had a wedding in Jamaica? Or stayed at a great resort that is affordable? I would like to get recommendations for all inclusive resorts in the area. If anyone could tell me both good and bad things about different resorts, it would be very helpful! Thanks![\/font][\/color][\/quote]Hi Kristen,\n\nI am a Top 50 booking agent for Jamaica and would be happy to assist you with any questions you have about resorts.  Feel free to PM me.\nThanks!\nBabs","Attachments":[],"Id":1908792,"PostDate":1451530414,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>kristendelpin, on 28 December 2015 - 08:23 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p><span  style=\"color:rgb(31,31,31);font-family:Arial, sans-serif\">I am looking into a destination wedding in Jamaica for May 2017 most likely in Montego Bay. Has anyone attended or had a wedding in Jamaica? Or stayed at a great resort that is affordable? I would like to get recommendations for all inclusive resorts in the area. If anyone could tell me both good and bad things about different resorts, it would be very helpful! Thanks!<\/span><\/p>\n<\/div>\n<\/div><\/div>\n<p>Hi Kristen,<\/p>\n<p>\u00a0<\/p>\n<p>I am a Top 50 booking agent for Jamaica and would be happy to assist you with any questions you have about resorts. \u00a0Feel free to PM me.<\/p>\n<p>\nThanks!<\/p>\n<p>Babs<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><a data-ipb='nomediaparse' href='https:\/\/www.wrighttravelagency.com\/go\/destination-wedding\/?source=EMLSIG' title=\"External link\"><strong><span style=\"color:rgb(0,128,128);\">Looking for a travel agency that specializes in Destination Weddings-CLICK HERE<\/span><\/strong><\/a><span style=\"font-family:arial, helvetica, sans-serif;color:rgb(0,128,128);\"><strong>?<\/strong>\u00a0\u00a0We are an award winning travel agency and you can\u00a0<\/span><strong><span style=\"color:rgb(0,128,128);\"><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/' title=\"\">read our reviews\u00a0here.<\/a><\/span><\/strong><\/p>\n<p><span style=\"font-size:14px;\"><span style=\"color:rgb(164,164,164);\"><span style=\"font-family:arial;\"><span style=\"color:rgb(0,128,128);\"><strong>Awards and recognition: <\/strong><\/span><\/span><\/span><\/span><br><span style=\"font-size:14px;\"><span style=\"color:rgb(164,164,164);\"><span style=\"font-family:arial;\"><span style=\"color:rgb(0,128,128);\">Palace Resorts Top PRO Agency <\/span><\/span><\/span><\/span><br><span style=\"font-size:14px;\"><span style=\"color:rgb(164,164,164);\"><span style=\"font-family:arial;\"><span style=\"color:rgb(0,128,128);\">Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator <\/span><\/span><\/span><\/span><br><span style=\"color:rgb(0,128,128);\"><span style=\"font-family:arial;\"><span style=\"font-size:14px;\">AMResorts Master Agent & Top Agency<\/span><\/span><\/span><br><span style=\"color:rgb(0,128,128);\"><span style=\"font-family:arial;\"><span style=\"font-size:14px;\">Travel Impressions Best of the Best Globe Winner<\/span><\/span><\/span><br><span style=\"color:rgb(0,128,128);\"><span style=\"font-family:arial;\"><span style=\"font-size:14px;\">Apple Vacations Golden Apple Winner<\/span><\/span><\/span>","Email":"barbara@wrighttravelagency.com","IpAddress":"69.57.225.114","GroupId":49,"GroupName":"Insiders","JoinDate":1325620305,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-249263.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"TA Babs","Id":249263,"Name":"TA Babs","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.14.13.91","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79819,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"3e9e5efcd20af935d6c3c3ccd29a9439","RawContent":"Hi TA Babs\n\n\nSo far I have narrowed down to these resorts:\n\n\nRoyalton white sands \n\nIberostar rose hall\n\nSunscape resort\n\nGrand palladium\n\nSea garden beach resort\n\n\nAny good or bad feedback about any of these? Thanks!","Attachments":[],"Id":1908803,"PostDate":1451577780,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi TA Babs<br><br>\nSo far I have narrowed down to these resorts:<br><br>\nRoyalton white sands <br>\nIberostar rose hall<br>\nSunscape resort<br>\nGrand palladium<br>\nSea garden beach resort<br><br>\nAny good or bad feedback about any of these? Thanks!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kristendelpin@gmail.com","IpAddress":"108.14.13.91","GroupId":39,"GroupName":"Newbie","JoinDate":1451319675,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kristendelpin","Id":285703,"Name":"kristendelpin","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.15.166.172","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79819,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"541fae2291eb0416c223c54ed1357c78","RawContent":"&lt;p&gt;@[member=\"kristendelpin\"] - we are getting married May 2016 at the Royalton White Sands.&lt;\/p&gt;","Attachments":[],"Id":1909073,"PostDate":1452114481,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"285703\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/285703-kristendelpin\/' title='Member profile'><span itemprop=\"name\">kristendelpin<\/span><\/a> - we are getting married May 2016 at the Royalton White Sands.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>The Future Mrs. Rodrigues","Email":"lisapereira11@hotmail.com","IpAddress":"74.15.166.172","GroupId":39,"GroupName":"Newbie","JoinDate":1426176386,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282406.jpg?_r=1426179017","PhotoWidth":177,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Lisa35","Id":282406,"Name":"Lisa35","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.15.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79819,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6c4a4e69e2cb8420f88cfffb0b7408fa","RawContent":"&lt;p&gt;@kristendelpin&amp;nbsp; Congrats and welcome! I&#039;m a Jamaica bride from 4 years ago. We got married at Gran Bahia Principe Jamaica in Runaway Bay, which is about an hour from Montego Bay. We loved the resort and found it very affordable. The WCs were great, the food was wonderful and the resort has this perfect beach gazebo for their weddings. It keeps it more private for you and your guests and there is an area beside it where your pictures can be taken that won&#039;t have the gawkers in your photos!&amp;nbsp; There is a full thread here for the resort - just do a search up top and it will give you some reading if you want.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;TA Babs will definitely be a great help for making your decision. Wright Travel are destination wedding specialists so you&#039;ll be in good hands for sure!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck and happy planning!&lt;\/p&gt;","Attachments":[],"Id":1909093,"PostDate":1452151324,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@kristendelpin\u00a0 Congrats and welcome! I'm a Jamaica bride from 4 years ago. We got married at Gran Bahia Principe Jamaica in Runaway Bay, which is about an hour from Montego Bay. We loved the resort and found it very affordable. The WCs were great, the food was wonderful and the resort has this perfect beach gazebo for their weddings. It keeps it more private for you and your guests and there is an area beside it where your pictures can be taken that won't have the gawkers in your photos!\u00a0 There is a full thread here for the resort - just do a search up top and it will give you some reading if you want.<\/p>\n<p>\u00a0<\/p>\n<p>TA Babs will definitely be a great help for making your decision. Wright Travel are destination wedding specialists so you'll be in good hands for sure!<\/p>\n<p>\u00a0<\/p>\n<p>Good luck and happy planning!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/'><span style=\"color:#ff0099;\"><em>http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283462599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"159.53.110.143","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79819,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"293c94ddc2b3d037ffc00f8e2249873f","RawContent":"Congratulations! I got married this past June in Montego Bay at Iberostar Rose Hall Suites and would definitely recommend it. They have a less expensive resort adjacent called Iberostar Rose Hall Beach that also gets rave reviews from brides. My husband is also from Jamaica so happy to answer any questions about either!\n[quote name=\"kristendelpin\" post=\"1908730\" timestamp=\"1451316216\"]\n[color=rgb(31,31,31)][font=Arial]I am looking into a destination wedding in Jamaica for May 2017 most likely in Montego Bay. Has anyone attended or had a wedding in Jamaica? Or stayed at a great resort that is affordable? I would like to get recommendations for all inclusive resorts in the area. If anyone could tell me both good and bad things about different resorts, it would be very helpful! Thanks![\/font][\/color][\/quote]","Attachments":[],"Id":1909119,"PostDate":1452196750,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congratulations! I got married this past June in Montego Bay at Iberostar Rose Hall Suites and would definitely recommend it. They have a less expensive resort adjacent called Iberostar Rose Hall Beach that also gets rave reviews from brides. My husband is also from Jamaica so happy to answer any questions about either!<\/p>\n<p>\u00a0<\/p>\n<p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>kristendelpin, on 28 December 2015 - 08:23 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p><span  style=\"color:rgb(31,31,31);font-family:Arial, sans-serif\">I am looking into a destination wedding in Jamaica for May 2017 most likely in Montego Bay. Has anyone attended or had a wedding in Jamaica? Or stayed at a great resort that is affordable? I would like to get recommendations for all inclusive resorts in the area. If anyone could tell me both good and bad things about different resorts, it would be very helpful! Thanks!<\/span><\/p>\n<\/div>\n<\/div><\/div>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rebecca.shaffer@gmail.com","IpAddress":"159.53.174.144","GroupId":3,"GroupName":"Member","JoinDate":1403119687,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"beckys98","Id":278581,"Name":"beckys98","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"98.164.23.197","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79819,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"6bbe94466403f3132d86787ae7a4438e","RawContent":"Love to see all the resort recommendations because I am also looking into getting married in Jamaica in Oct 2016. Right now leaning towards The Jewel Resort at dunns river. Any thoughts would be appriciated! \n\n\nAlso, was wondering about the legalities. A lot of the resorts there only do \"symbolic ceremonies\" and I want it to be 100% legal. What documents do I need to bring?","Attachments":[],"Id":1909162,"PostDate":1452285674,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Love to see all the resort recommendations because I am also looking into getting married in Jamaica in Oct 2016. Right now leaning towards The Jewel Resort at dunns river. Any thoughts would be appriciated! <br><br>\nAlso, was wondering about the legalities. A lot of the resorts there only do \"symbolic ceremonies\" and I want it to be 100% legal. What documents do I need to bring? \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lindsayhoward74@gmail.com","IpAddress":"98.164.23.197","GroupId":39,"GroupName":"Newbie","JoinDate":1452114740,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-285798.jpg?_r=1453167847","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"LindsayHoward","Id":285798,"Name":"LindsayHoward","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"172.73.7.39","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79819,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"85e6cdaafb173f647d456396b48eda24","RawContent":"TA Babs was my TA. She is THE BEST!! You can&#039;t go wrong with her help and recommendations.","Attachments":[],"Id":1909596,"PostDate":1452953281,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                TA Babs was my TA. She is THE BEST!! You can't go wrong with her help and recommendations. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"pinkiesup08@gmail.com","IpAddress":"75.181.5.152","GroupId":47,"GroupName":"Site Supporter","JoinDate":1374617724,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-271841.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"RandL2015","Id":271841,"Name":"RandL2015","IsOnline":false}}],"Pages":{"TotalItems":15,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
