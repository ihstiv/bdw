{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":28118,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ee758f4c9fa7c126c6db4db74a80bac4","RawContent":"&lt;p&gt; I did NOT read all 44 pages of post, but I wanted to add my 2 cents in on this one.....Coupons can lower the cost of the items for the OOT bags significantly.&lt;\/p&gt;","Attachments":[],"Id":1737405,"PostDate":1364017832,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I did NOT read all 44 pages of post, but I wanted to add my 2 cents in on this one.....Coupons can lower the cost of the items for the OOT bags significantly.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mscheryl10@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1361015849,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-266139.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"mscheryl10","Id":266139,"Name":"mscheryl10","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":28118,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"14022a1e111f0940f7a30b96276c9fb5","RawContent":"&lt;p&gt; I&#039;m loving this post. Lots of useful tips on here!!&amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; mscheryl10, I totally agree about coupons for anything and everything but especially OOT bags!&lt;\/p&gt;","Attachments":[],"Id":1737413,"PostDate":1364027353,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I'm loving this post. Lots of useful tips on here!!\u00a0<\/p> <p> \u00a0<\/p> <p> mscheryl10, I totally agree about coupons for anything and everything but especially OOT bags!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cmandkw2014@gmail.com","IpAddress":"71.61.12.40","GroupId":40,"GroupName":"Jr. Member","JoinDate":1359577506,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265407.png?_r=0","PhotoWidth":200,"PhotoHeight":244,"PhotoType":"custom"},"FormattedName":"KWandCM","Id":265407,"Name":"KWandCM","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":28118,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b3980dcc465eb54486f7f53204d0206c","RawContent":"This is a really great post!","Attachments":[],"Id":1739913,"PostDate":1364516750,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                This is a really great post!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"joeyandnadine@gmail.com","IpAddress":"99.245.25.159","GroupId":40,"GroupName":"Jr. Member","JoinDate":1338760582,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-256215.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"MrsWWhite","Id":256215,"Name":"MrsWWhite","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":false,"TopicId":28118,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7073657581fdfa1c23e008639e5f8f1e","RawContent":"Great ideas!!! I&#039;m thankful I found this site. I need to get to the dollar store","Attachments":[],"Id":1739972,"PostDate":1364554395,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Great ideas!!! I'm thankful I found this site. I need to get to the dollar store\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kefritz21@gmail.com","IpAddress":"","GroupId":5,"GroupName":"Banned","JoinDate":1364506581,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kefritz","Id":267926,"Name":"kefritz","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":28118,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"faddf1747e6b8f0b599a509645cb01b6","RawContent":"&lt;p&gt; Hello ladies!&lt;\/p&gt; &lt;p&gt; This is such a fantastic post...It&#039;s awesome that it is still going after all of these years!!! There are so many amazing tips on here that I can&#039;t even pinpoint the best ones! There are too many to choose from!&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Here are some tips that I have utilized that have saved me tons of money already:&lt;\/p&gt; &lt;ul&gt; &lt;li&gt; When shopping at Michaels\/JoAnn&#039;s, remember that you can use coupons for that specific store as well as the competitor&#039;s store.&amp;nbsp;&lt;\/li&gt; &lt;\/ul&gt; &lt;p&gt; For example, JoAnn&#039;s had a 50% coupon off of any one regular priced item!!! I used it at Michaels to buy several items that I needed for my DIY boarding pass invitations!&amp;nbsp;&lt;img id=\"yui_3_7_3_1_1366652642753_1454\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheer2.gif\" style=\"line-height: 1.231;\" \/&gt;&amp;nbsp;So be on the lookout for those 50% coupons, they are the extra cherry on top seeing as how Michaels as 40% off almost every week.&amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;ul&gt; &lt;li&gt; Depending on the cashier working that day, I will use multiple coupons at Michaels during the same visit. Sometimes you can use a Michaels coupon AND a competitor&#039;s coupon in the same transaction!!! If I need to buy several items because I have a really awesome coupon (ie JoAnn&#039;s 50% off coupon), then I will do separate transactions!&amp;nbsp;&lt;\/li&gt; &lt;li&gt; When using coupons at Michaels\/JoAnn&#039;s, try to use the mobile coupons! Why? When you redeem a paper coupon, you have to give up the coupon to the cashier. They will accept a coupon off of a smartphone, tablet, etc. and you can still use the coupon later that week. This allows you to go to multiple Michaels\/JoAnn&#039;s to buy everything you need quicker instead of just buying one item\/week!&lt;\/li&gt; &lt;li&gt; Dollar tree now accepts manufacturer&#039;s coupons! You can buy toothbrushes, toothpaste, soap, candy, granola bars, etc! Perfect and (MORE) inexpensive items for OOT bags! Just be warned that most cashier will have problems figuring out how to take a coupon off because it&#039;s still a relatively new policy! But, you should be able to get your discount! :)&lt;\/li&gt; &lt;\/ul&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; For the purposes of my budget, if I go to a store to buy a couple of things for the invitations and some items for the OOT bags, I will do separate transactions. It might be a bit excessive, but it is a lot easier to keep track of my finances in each category!&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Hope this helps all of you other DW brides out there!&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1749443,"PostDate":1366640070,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hello ladies!<\/p> <p> This is such a fantastic post...It's awesome that it is still going after all of these years!!! There are so many amazing tips on here that I can't even pinpoint the best ones! There are too many to choose from!<\/p> <p> \u00a0<\/p> <p> Here are some tips that I have utilized that have saved me tons of money already:<\/p> <ul> <li> When shopping at Michaels\/JoAnn's, remember that you can use coupons for that specific store as well as the competitor's store.\u00a0<\/li> <\/ul> <p> For example, JoAnn's had a 50% coupon off of any one regular priced item!!! I used it at Michaels to buy several items that I needed for my DIY boarding pass invitations!\u00a0<span rel='lightbox'><img class='bbc_img' id=\"yui_3_7_3_1_1366652642753_1454\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheer2.gif\" style=\"line-height: 1.231;\" \/><\/span>\u00a0So be on the lookout for those 50% coupons, they are the extra cherry on top seeing as how Michaels as 40% off almost every week.\u00a0<\/p> <p> \u00a0<\/p> <ul> <li> Depending on the cashier working that day, I will use multiple coupons at Michaels during the same visit. Sometimes you can use a Michaels coupon AND a competitor's coupon in the same transaction!!! If I need to buy several items because I have a really awesome coupon (ie JoAnn's 50% off coupon), then I will do separate transactions!\u00a0<\/li> <li> When using coupons at Michaels\/JoAnn's, try to use the mobile coupons! Why? When you redeem a paper coupon, you have to give up the coupon to the cashier. They will accept a coupon off of a smartphone, tablet, etc. and you can still use the coupon later that week. This allows you to go to multiple Michaels\/JoAnn's to buy everything you need quicker instead of just buying one item\/week!<\/li> <li> Dollar tree now accepts manufacturer's coupons! You can buy toothbrushes, toothpaste, soap, candy, granola bars, etc! Perfect and (MORE) inexpensive items for OOT bags! Just be warned that most cashier will have problems figuring out how to take a coupon off because it's still a relatively new policy! But, you should be able to get your discount! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/li> <\/ul> <p> \u00a0<\/p> <p> For the purposes of my budget, if I go to a store to buy a couple of things for the invitations and some items for the OOT bags, I will do separate transactions. It might be a bit excessive, but it is a lot easier to keep track of my finances in each category!<\/p> <p> \u00a0<\/p> <p> Hope this helps all of you other DW brides out there!\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Bride2be4414@gmail.com","IpAddress":"96.58.36.78","GroupId":40,"GroupName":"Jr. Member","JoinDate":1366299232,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268722.png?_r=0","PhotoWidth":200,"PhotoHeight":164,"PhotoType":"custom"},"FormattedName":"CAKnight","Id":268722,"Name":"CAKnight","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":28118,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"050b03b33bbc867cec2ec7c2e1b02013","RawContent":"&lt;p&gt; Great ideas!!&lt;\/p&gt;","Attachments":[],"Id":1752855,"PostDate":1367369104,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Great ideas!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"atlaeludlow@gmail.com","IpAddress":"98.234.104.236","GroupId":40,"GroupName":"Jr. Member","JoinDate":1367252786,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-269116.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"gresley","Id":269116,"Name":"gresley","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":28118,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5727691ff47e1af481c39777a381e679","RawContent":"&lt;p&gt; Fantastic ideas!&lt;\/p&gt;","Attachments":[],"Id":1754501,"PostDate":1367737154,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Fantastic ideas!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"deanneandjohnswedding@gmail.com","IpAddress":"27.122.13.38","GroupId":39,"GroupName":"Newbie","JoinDate":1365306908,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268271.jpg?_r=1392839479","PhotoWidth":180,"PhotoHeight":270,"PhotoType":"facebook"},"FormattedName":"Canadagoose","Id":268271,"Name":"Canadagoose","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":28118,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"19c65eced98a6c578413291e5c6151c1","RawContent":"&lt;p&gt;This is a very Helpful thread!! Now I&amp;nbsp;can start my budget&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1810120,"PostDate":1382990757,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>This is a very Helpful thread!! Now I\u00a0can start my budget\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div>\u00a0<\/div>\n<div><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78914-meandhim-grand-palladium-bavaro-nov-2015\/'>My Planning Thread<\/a>\u00a0- MeandHim - Grand Palladium Bavaro - Nov 25 2015<\/div>\n<div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10765;116\/st\/20151125\/e\/Our+Wedding\/k\/461e\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"markandshavonne@live.com","IpAddress":"70.30.85.211","GroupId":3,"GroupName":"Member","JoinDate":1365777659,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268499.jpg?_r=1448996983","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"Meandhim","Id":268499,"Name":"Meandhim","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":28118,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9609ee0b60844f48f98266678b081446","RawContent":"Great advice!","Attachments":[],"Id":1811341,"PostDate":1383419900,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Great advice!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mishtb96@aol.com","IpAddress":"162.231.9.34","GroupId":40,"GroupName":"Jr. Member","JoinDate":1383038867,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-274657.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"misbosox","Id":274657,"Name":"misbosox","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":28118,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6c7e1bfb916bf25187f8808b8ea06742","RawContent":"&lt;p&gt;I&#039;m early on in the process and things are adding up so quickly!&amp;nbsp;threads like this are invaluable! I will definitely be taking some of this advice to heart&lt;\/p&gt;","Attachments":[],"Id":1815458,"PostDate":1384723682,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I'm early on in the process and things are adding up so quickly!\u00a0threads like this are invaluable! I will definitely be taking some of this advice to heart<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mckiever.whetsel@gmail.com","IpAddress":"68.53.109.189","GroupId":40,"GroupName":"Jr. Member","JoinDate":1377357614,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272881.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"mckievme","Id":272881,"Name":"mckievme","IsOnline":false}}],"Pages":{"TotalItems":482,"TotalPages":49,"CurrentPage":450,"NextPage":460,"PreviousPage":440,"LastPage":480},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
