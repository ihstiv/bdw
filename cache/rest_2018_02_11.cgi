 inset\">  Originally Posted by <strong>*Heather*<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">This is a great thread! Thanks for starting this Kelly - I'm definitely going to take these posts into consideration...<\/div> <\/td> <\/tr> <\/table> <\/div>I'm glad I could contribute something useful! And Heather, I LOVE those shoes!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><strong>~Kelly<\/strong><br><br><strong>Our Awesome Wedding Pics:<\/strong><span> <\/span><a data-ipb='nomediaparse' href=\"http:\/\/www.delsolphotography.com\/weddings\/kelly&ron\/\">http:\/\/www.delsolphotography.com\/weddings\/kelly&ron\/<\/a><\/div><\/div>","Email":"kcoby@hotmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1211247595,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-209491.jpg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"KLC77","Id":209491,"Name":"KLC77","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":29980,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a11fcba891dea9392068fe99fd328dd1","RawContent":"Thanks for the ideas. It helps.","Attachments":[],"Id":572639,"PostDate":1232985187,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n          