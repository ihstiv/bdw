","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Cindy&London","Id":212016,"Name":"Cindy&London","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":29980,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"211cc3b2f70e1723ba86334d8c4d5ce8","RawContent":"Loving this thread. Now I know what ideas to turf and what would be good for our bags. And I&#039;m definitely doing travel mugs now as they were an iffy for me. Thanks everyone!","Attachments":[],"Id":576463,"PostDate":1233256706,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Loving this thread. Now I know what ideas to turf and what would be good for our bags. And I'm definitely doing travel mugs now as they were an iffy for me. Thanks everyone!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Two lives, two hearts joined together in friendship united forever in love<\/span><\/div><\/div>","Email":"taras@shaw.ca","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1231525735,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-213782.JPG?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"punkie569","Id":213782,"Name":"punkie569","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":29980,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"afefc4c2596a56a64522d63acab74bdb","RawContent":"I don&#039;t know if I should get cups or travel cups with lids. Thoughts? How do guests use the cups? Sorry, if this is a really silly question! Do they use it at the pool, like go to the bar for refills? I can see how travel cups can be useful for excursions! Thanks!","Attachments":[],"Id":576556,"PostDate":1233261769,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I don't know if I should get cups or travel cups with lids. Thoughts? How do guests use the cups? Sorry, if this is a really silly question! Do they use it at the pool, like go to the bar for refills? I can see how travel cups can be useful for excursions! Thanks!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;0;116\/st\/20090518\/e\/Our+Wedding\/dt\/1\/k\/72c4\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...72c4\/event.png<\/a><\/div><\/div>","Email":"tang.fanny@gmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1217251699,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-210829.gif?_r=0","PhotoWidth":100,"PhotoHeight":67,"PhotoType":"custom"},"FormattedName":"bumbles","Id":210829,"Name":"bumbles","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":29980,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"10b6f53f4f97bd6122f53f5c3558ac1b","RawContent":"Thanks for the useful tips, it will def help me curb my desire to just buy, buy buy.","Attachments":[],"Id":576558,"PostDate":1233262061,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks for the useful tips, it will def help me curb my desire to just buy, buy buy.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/www.weddingcountdown.com\/ticker\/6qscsou.png\">http:\/\/www.weddingcountdown.com\/ticker\/6qscsou.png<\/a><br><span>[\/CENTER]<\/span><\/div><\/div>","Email":"reeveswedding@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1219349184,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-211327.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"reevesbride","Id":211327,"Name":"reevesbride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":29980,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f8c3c7153d89294b51a25dc3f946bf49","RawContent":"very helpful thread!\n \n i second the question about travel mugs. not sure if i should spend the money on insulated travel mugs with lids and handles or just get stadium cups. \n \n my other questionable items are hand fans and travel candles. yay or nay?","Attachments":[],"Id":576571,"PostDate":1233262926,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                very helpful thread!<br \/> <br \/> i second the question about travel mugs. not sure if i should spend the money on insulated travel mugs with lids and handles or just get stadium cups. <br \/> <br \/> my other questionable items are hand fans and travel candles. yay or nay?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>nyssa & joel<\/span><br><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f77\/calchiks-punta-cana-gran-bahia-prinicipe-bavaro-wedding-review-long-pics-45227\/\"><strong>Our Punta Cana wedding review<\/strong><\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/s384.photobucket.com\/albums\/oo290\/njadem\/wedding\/photo%20book\/?albumview=slideshow\"><strong>Our photo book<\/strong><\/a><\/div><\/div>","Email":"joelnyssa@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1214492111,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-210179.gif?_r=0","PhotoWidth":77,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"calchik","Id":210179,"Name":"calchik","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":29980,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d9dbd23f95775ae027903601485f4678","RawContent":"I have only been looking for the insulated travel mugs thinking it would keep drinks cold in he summer and give them 16 oz to fill. I hadn&#039;t considered cups so I will also be interested in the cup vs mug answer.\n \n My answer to the fan vs candle question is fans! I don&#039;t know how to link to a post but look at a review of a weddin last year from OneLove. She got married in Jan, I think, and she said the fans were great to keep sun off faces and just to fan themselves. It sounded like they were one of the hits at her wedding.","Attachments":[],"Id":576639,"PostDate":1233266521,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I have only been looking for the insulated travel mugs thinking it would keep drinks cold in he summer and give them 16 oz to fill. I hadn't considered cups so I will also be interested in the cup vs mug answer.<br \/> <br \/> My answer to the fan vs candle question is fans! I don't know how to link to a post but look at a review of a weddin last year from OneLove. She got married in Jan, I think, and she said the fans were great to keep sun off faces and just to fan themselves. It sounded like they were one of the hits at her wedding.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/good-times.webshots.com\/album\/573617153iUHYaT\"><strong>Our Wedding Day Slideshow<\/strong><\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t46627\"><strong>Moon Palace Resort \/ Wedding Review<\/strong><\/a><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t37779\">OOT Bags<\/a><span> - - <\/span><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t40584\">Beach Towels<\/a><span> - - <\/span><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t43663#post825781\">Wedding Tanks\/Tees<\/a><\/div><\/div>","Email":"hatla@arlut.utexas.edu","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1231935573,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-213940.gif?_r=0","PhotoWidth":96,"PhotoHeight":63,"PhotoType":"custom"},"FormattedName":"TinaM2b","Id":213940,"Name":"TinaM2b","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":29980,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c715f77b5f7fcbe42d44f9d68bf42d73","RawContent":"I am lovin&amp;quot; this thread right now!!! Thanks!","Attachments":[],"Id":576666,"PostDate":1233269071,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body 