bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-255973.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"DestinationGirl","Id":255973,"Name":"DestinationGirl","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":67731,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b0d24f8c536c49c5a0a692e9b5c25a28","RawContent":"&lt;p&gt; I think I&#039;m doing the coral &amp;amp; grey. I love the way they pair, might also throw some aqua in there :)&lt;\/p&gt;","Attachments":[],"Id":1664051,"PostDate":1347923145,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I think I'm doing the coral & grey. I love the way they pair, might also throw some aqua in there <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sometimeinoctober@gmail.com","IpAddress":"63.73.199.69","GroupId":39,"GroupName":"Newbie","JoinDate":1334677037,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-254151.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":260,"PhotoType":"custom"},"FormattedName":"shes2013","Id":254151,"Name":"shes2013","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":67731,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"9293ea414c5141da1c5d3fbe79ec541a","RawContent":"&lt;p id=\"user_yui_3_10_0_1_1374170187542_678\" style=\"margin: 0cm 0cm 0.0001pt; color: rgb(24, 24, 24); font-family: arial, helvetica, sans-serif; background-color: rgb(253, 252, 250); line-height: 13.5pt;\"&gt; &lt;span id=\"user_yui_3_10_0_1_1374170187542_763\" style=\"line-height: normal; font-size: 9pt; color: rgb(51, 51, 51);\"&gt;We are doing something a bit different then what I\u00e2\u20ac\u2122ve seen for a beach wedding.&amp;nbsp; We are doing PINK TONES AND GOLD.&amp;nbsp; We will also have some white accents.\n \n I absolutely love the palette and think it exudes luxury.&amp;nbsp; My FI is Indian so gold is very traditional they usually pair it with red but to give it a twist and also add my favorite colour we have decided to do pink.&amp;nbsp; But not just one colour of pink, a variety of pinks!&lt;\/span&gt;&lt;\/p&gt; &lt;p id=\"user_yui_3_10_0_1_1374170187542_765\" style=\"margin: 0cm 0cm 0.0001pt; color: rgb(24, 24, 24); font-family: arial, helvetica, sans-serif; background-color: rgb(253, 252, 250); line-height: 13.5pt;\"&gt; &lt;span style=\"line-height: normal; font-size: 9pt; color: rgb(51, 51, 51);\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;\/p&gt; &lt;p id=\"user_yui_3_10_0_1_1374170187542_681\" style=\"margin: 0cm 0cm 0.0001pt; color: rgb(24, 24, 24); font-family: arial, helvetica, sans-serif; background-color: rgb(253, 252, 250); line-height: 13.5pt;\"&gt; &lt;span id=\"user_yui_3_10_0_1_1374170187542_680\" style=\"line-height: normal; font-size: 9pt; color: rgb(51, 51, 51);\"&gt;I\u00e2\u20ac\u2122ve found a pink (blush) dress for my wedding dress so my bridesmaids are going to wear white or gold dresses (they are choosing their own dress)&lt;\/span&gt;&lt;\/p&gt; &lt;p id=\"user_yui_3_10_0_1_1374170187542_651\" style=\"margin: 0cm 0cm 0.0001pt; color: rgb(24, 24, 24); font-family: arial, helvetica, sans-serif; background-color: rgb(253, 252, 250); line-height: 13.5pt;\"&gt; &lt;span style=\"line-height: normal; font-size: 9pt; color: rgb(51, 51, 51);\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;\/p&gt; &lt;p id=\"user_yui_3_10_0_1_1374170187542_599\" style=\"margin: 0cm 0cm 0.0001pt; color: rgb(24, 24, 24); font-family: arial, helvetica, sans-serif; background-color: rgb(253, 252, 250); line-height: 13.5pt;\"&gt; &lt;span id=\"user_yui_3_10_0_1_1374170187542_649\" style=\"line-height: normal; font-size: 9pt; color: rgb(51, 51, 51);\"&gt;I just love that nothing about our wedding is going to be predictable!&amp;nbsp; What do you guys think?&amp;nbsp; I\u00e2\u20ac\u2122ve attached photos of my inspiration!&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p style=\"margin: 0cm 0cm 0.0001pt; color: rgb(24, 24, 24); font-family: arial, helvetica, sans-serif; background-color: rgb(253, 252, 250); line-height: 13.5pt;\"&gt; &amp;nbsp;&lt;\/p&gt; &lt;span huddler_attributes=\"{&amp;quot;plugin&amp;quot;:&amp;quot;attachment&amp;quot;,&amp;quot;params&amp;quot;:{&amp;quot;id&amp;quot;:&amp;quot;14160&amp;quot;,&amp;quot;name&amp;quot;:&amp;quot;Pink1.jpg&amp;quot;,&amp;quot;description&amp;quot;:&amp;quot;&amp;quot;,&amp;quot;size&amp;quot;:&amp;quot;68&amp;quot;,&amp;quot;type&amp;quot;:&amp;quot;jpg&amp;quot;}}\" huddler_plugin=\"attachment\"&gt;&amp;nbsp;&lt;\/span&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;span huddler_attributes=\"{&amp;quot;plugin&amp;quot;:&amp;quot;attachment&amp;quot;,&amp;quot;params&amp;quot;:{&amp;quot;id&amp;quot;:&amp;quot;14161&amp;quot;,&amp;quot;name&amp;quot;:&amp;quot;Pink2.jpg&amp;quot;,&amp;quot;description&amp;quot;:&amp;quot;&amp;quot;,&amp;quot;size&amp;quot;:&amp;quot;84&amp;quot;,&amp;quot;type&amp;quot;:&amp;quot;jpg&amp;quot;}}\" huddler_plugin=\"attachment\"&gt;&amp;nbsp;&lt;\/span&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;span huddler_attributes=\"{&amp;quot;plugin&amp;quot;:&amp;quot;attachment&amp;quot;,&amp;quot;params&amp;quot;:{&amp;quot;id&amp;quot;:&amp;quot;14162&amp;quot;,&amp;quot;name&amp;quot;:&amp;quot;Pink3.jpg&amp;quot;,&amp;quot;description&amp;quot;:&amp;quot;&amp;quot;,&amp;quot;size&amp;quot;:&amp;quot;62&amp;quot;,&amp;quot;type&amp;quot;:&amp;quot;jpg&amp;quot;}}\" huddler_plugin=\"attachment\"&gt;&amp;nbsp;&lt;\/span&gt;","Attachments":[{"Id":24875,"Name":"Pink1.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2013\/post-45026-13862252036.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2013\/post-45026-13862252036_thumb.jpg","Width":582,"Height":890},{"Id":24876,"Name":"Pink2.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2013\/post-45026-138622520367.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2013\/post-45026-138622520367_thumb.jpg","Width":736,"Height":694},{"Id":24877,"Name":"Pink3.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2013\/post-45026-138622520373.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2013\/post-45026-138622520373_thumb.jpg","Width":510,"Height":480}],"Id":1780137,"PostDate":1374161295,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p id=\"user_yui_3_10_0_1_1374170187542_678\"  style=\"margin: 0cm 0cm 0.0001pt;color: rgb(24, 24, 24);font-family: arial, helvetica, sans-serif;background-color: rgb(253, 252, 250)\"> <span id=\"user_yui_3_10_0_1_1374170187542_763\"  style=\"font-size: 9pt;color: rgb(51, 51, 51)\">We are doing something a bit different then what I\u00e2\u20ac\u2122ve seen for a beach wedding.\u00a0 We are doing PINK TONES AND GOLD.\u00a0 We will also have some white accents.<br \/> <br \/> I absolutely love the palette and think it exudes luxury.\u00a0 My FI is Indian so gold is very traditional they usually pair it with red but to give it a twist and also add my favorite colour we have decided to do pink.\u00a0 But not just one colour of pink, a variety of pinks!<\/span><\/p> <p id=\"user_yui_3_10_0_1_1374170187542_765\"  style=\"margin: 0cm 0cm 0.0001pt;color: rgb(24, 24, 24);font-family: arial, helvetica, sans-serif;background-color: rgb(253, 252, 250)\"> <span  style=\"font-size: 9pt;color: rgb(51, 51, 51)\">\u00a0<\/span><\/p> <p id=\"user_yui_3_10_0_1_1374170187542_681\"  style=\"margin: 0cm 0cm 0.0001pt;color: rgb(24, 24, 24);font-family: arial, helvetica, sans-serif;background-color: rgb(253, 252, 250)\"> <span id=\"user_yui_3_10_0_1_1374170187542_680\"  style=\"font-size: 9pt;color: rgb(51, 51, 51)\">I\u00e2\u20ac\u2122ve found a pink (blush) dress for my wedding dress so my bridesmaids are going to wear white or gold dresses (they are choosing their own dress)<\/span><\/p> <p id=\"user_yui_3_10_0_1_1374170187542_651\"  style=\"margin: 0cm 0cm 0.0001pt;color: rgb(24, 24, 24);font-family: arial, helvetica, sans-serif;background-color: rgb(253, 252, 250)\"> <span  style=\"font-size: 9pt;color: rgb(51, 51, 51)\">\u00a0<\/span><\/p> <p id=\"user_yui_3_10_0_1_1374170187542_599\"  style=\"margin: 0cm 0cm 0.0001pt;color: rgb(24, 24, 24);font-family: arial, helvetica, sans-serif;background-color: rgb(253, 252, 250)\"> <span id=\"user_yui_3_10_0_1_1374170187542_649\"  style=\"font-size: 9pt;color: rgb(51, 51, 51)\">I just love that nothing about our wedding is going to be predictable!\u00a0 What do you guys think?\u00a0 I\u00e2\u20ac\u2122ve attached photos of my inspiration!<\/span><\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p  style=\"margin: 0cm 0cm 0.0001pt;color: rgb(24, 24, 24);font-family: arial, helvetica, sans-serif;background-color: rgb(253, 252, 250)\"> \u00a0<\/p> <span huddler_attributes=\"{\"plugin\":\"attachment\",\"params\":{\"id\":\"14160\",\"name\":\"Pink1.jpg\",\"description\":\"\",\"size\":\"68\",\"type\":\"jpg\"}}\" huddler_plugin=\"attachment\">\u00a0<\/span> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <span huddler_attributes=\"{\"plugin\":\"attachment\",\"params\":{\"id\":\"14161\",\"name\":\"Pink2.jpg\",\"description\":\"\",\"size\":\"84\",\"type\":\"jpg\"}}\" huddler_plugin=\"attachment\">\u00a0<\/span> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <span huddler_attributes=\"{\"plugin\":\"attachment\",\"params\":{\"id\":\"14162\",\"name\":\"Pink3.jpg\",\"description\":\"\",\"size\":\"62\",\"type\":\"jpg\"}}\" huddler_plugin=\"attachment\">\u00a0<\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jennneedham@hotmail.com","IpAddress":"66.46.14.132","GroupId":39,"GroupName":"Newbie","JoinDate":1315737787,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-245163.jpg?_r=1395159041","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Jenn Needham","Id":245163,"Name":"Jenn Needham","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":67731,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4f141dabc08ce490a3a67a654119ee79","RawContent":"&lt;p&gt; I like coral and nude palette - simple and elegant.\n &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1782971,"PostDate":1374755502,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I like coral and nude palette - simple and elegant.<br \/> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Sehausle@gmail.com","IpAddress":"69.132.176.52","GroupId":40,"GroupName":"Jr. Member","JoinDate":1360660676,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265973.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":186,"PhotoType":"custom"},"FormattedName":"Sehausle","Id":265973,"Name":"Sehausle","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":false,"TopicId":67731,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e397d05b5dede3e8cea90ae471c8bcb3","RawContent":"&lt;p&gt; I think &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.bellasdress.com\/coral-dresses-li66102\/\"&gt;coral dresses&lt;\/a&gt; are amazing. I love that color. What&#039;s &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.bellasdress.com\/\"&gt;more&lt;\/a&gt;, it&#039;s not like red so shining, it&#039;s a simple warm color.&lt;img id=\"yui_3_10_0_1_1375839932274_1218\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif\" \/&gt;&lt;\/p&gt;","Attachments":[],"Id":1788016,"PostDate":1375825669,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I think <a href='http:\/\/www.bellasdress.com\/coral-dresses-li66102\/' class='bbc_url' title='External link' rel='nofollow external'>coral dresses<\/a> are amazing. I love that color. What's <a href='http:\/\/www.bellasdress.com\/' class='bbc_url' title='External link' rel='nofollow external'>more<\/a>, it's not like red so shining, it's a simple warm color.<span rel='lightbox'><img class='bbc_img' id=\"yui_3_10_0_1_1375839932274_1218\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif\" \/><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"higraceoreo@inbox.com","IpAddress":"","GroupId":5,"GroupName":"Banned","JoinDate":1374554313,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"graceellex","Id":271822,"Name":"graceellex","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":67731,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bf52267609d43cc748ef082982178418","RawContent":"&lt;p&gt; We are doing coral, turquoise, and lime green. I wanted super bright, cheery colors, although I hope it doesn&#039;t end up looking like a rainbow threw up on my wedding&amp;nbsp;&lt;img id=\"yui_3_10_0_1_1375978322846_1192\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif\" style=\"line-height: 1.231;\" \/&gt;&lt;\/p&gt;","Attachments":[],"Id":1788863,"PostDate":1375964006,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> We are doing coral, turquoise, and lime green. I wanted super bright, cheery colors, although I hope it doesn't end up looking like a rainbow threw up on my wedding\u00a0<span rel='lightbox'><img class='bbc_img' id=\"yui_3_10_0_1_1375978322846_1192\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif\" style=\"line-height: 1.231;\" \/><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kasey_98@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1335127077,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-254373.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Kasey04","Id":254373,"Name":"Kasey04","IsOnline":false}}],"Pages":{"TotalItems":28,"TotalPages":3,"CurrentPage":10,"NextPage":20,"PreviousPage":0,"LastPage":20},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
