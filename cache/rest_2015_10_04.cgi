h: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Okay, i got my dress today. And its beautiful. But it is way to big...they were really good when I called gave me a return number and are shipping me a new one out. so far so good. <a href='http:\/\/www.BridalOnlineStore.com' class='bbc_url' title='External link' rel='nofollow external'>Bridal Online Store - Affordable Wedding Dresses, Discount Bridal Gowns & Wedding Accessories<\/a>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Kerrington Danielle was born 6\/23\/09 12:31 pm 7lbs 14oz.<\/span><br><br><a data-ipb='nomediaparse' href=\"http:\/\/i295.photobucket.com\/albums\/mm125\/2008bride\/IMG_9487.jpg\">http:\/\/i295.photobucket.com\/albums\/m...e\/IMG_9487.jpg<\/a><\/div><\/div>","Email":"klhanx@aol.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1198094123,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208049.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Kelly C","Id":208049,"Name":"Kelly C","IsOnline":false}}],"Id":"16523","Title":"Discount wedding dress websites ~ compiled list & reviews","LastPostDate":1443936274},"Pages":{"TotalItems":61,"TotalPages":7,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":60},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
