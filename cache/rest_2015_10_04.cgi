{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.17.41.18","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79556,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":4,"IsLiked":false,"PostKey":"e9c57299d71925a81956f06cf7315ef0","RawContent":"So excited!  We finally figured out where and when a couple weeks ago.  We are getting married July 11, 2016 at Dreams La Romana in the Dominican Republic.    We&#039;ve never been to the DR and are looking forward to traveling somewhere new.   \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1903896,"PostDate":1441109714,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                So excited!  We finally figured out where and when a couple weeks ago.  We are getting married July 11, 2016 at Dreams La Romana in the Dominican Republic.    We've never been to the DR and are looking forward to traveling somewhere new.   <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"megewy@yahoo.com","IpAddress":"99.17.41.18","GroupId":39,"GroupName":"Newbie","JoinDate":1437848879,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"MegLeLy","Id":284131,"Name":"MegLeLy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.87.42.110","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79556,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"15dc3974fb1fbcca76d32fb20199f674","RawContent":"&lt;p&gt;Congratulations!!! We have stayed with that line (Dreams\/Secrets) a few times now and have been nothing but impressed with everything. We stayed at the other Dreams in Punta Cana but that was facing the Atlantic not the the Caribbean so we were a little bummed, but yours faces the Caribbean so good choice!!!&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1903904,"PostDate":1441111071,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congratulations!!! We have stayed with that line (Dreams\/Secrets) a few times now and have been nothing but impressed with everything. We stayed at the other Dreams in Punta Cana but that was facing the Atlantic not the the Caribbean so we were a little bummed, but yours faces the Caribbean so good choice!!!\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nicolechin4@yahoo.com","IpAddress":"68.87.42.110","GroupId":39,"GroupName":"Newbie","JoinDate":1407422509,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"JamaicaNicole","Id":279353,"Name":"JamaicaNicole","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"199.85.228.129","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79556,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"3969d025700c95497f8f863be10c3fa3","RawContent":"&lt;p&gt;Congratulations!! That&#039;s so exciting!! It&#039;s a nice weight to be lifted, to have a final date :)&lt;\/p&gt;","Attachments":[],"Id":1903931,"PostDate":1441118641,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congratulations!! That's so exciting!! It's a nice weight to be lifted, to have a final date <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"katie_mcbride48@yahoo.ca","IpAddress":"199.85.228.129","GroupId":39,"GroupName":"Newbie","JoinDate":1424099850,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282132.jpg?_r=1437519508","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"KatieMcBride","Id":282132,"Name":"KatieMcBride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.228.47.25","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79556,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"865d7a2a26acb6d76509d205227d651f","RawContent":"&lt;p&gt;Nice! You&#039;ll love Dreams La Romana! The wedding will be beautiful. Just make sure you get in touch with them well in advance with any questions or requests you have. Happy planning.&lt;\/p&gt;","Attachments":[],"Id":1904077,"PostDate":1441235378,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Nice! You'll love Dreams La Romana! The wedding will be beautiful. Just make sure you get in touch with them well in advance with any questions or requests you have. Happy planning.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"theniylife@gmail.com","IpAddress":"99.228.60.204","GroupId":39,"GroupName":"Newbie","JoinDate":1430519880,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"1weddingirl","Id":282948,"Name":"1weddingirl","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.85.127.174","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79556,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"e15a281892b60ed58114a5173560a612","RawContent":"&lt;p&gt;My TA went to Dreams La Romana earlier this year and raved about it! Congrats!&lt;\/p&gt;","Attachments":[],"Id":1904092,"PostDate":1441237824,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>My TA went to Dreams La Romana earlier this year and raved about it! Congrats!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>- Erin<\/p>\n<p>\u00a0<\/p>\n<p>My planning thread:\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268'>http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268<\/a>","Email":"ekjzwedding@gmail.com","IpAddress":"24.85.127.174","GroupId":40,"GroupName":"Jr. Member","JoinDate":1417435045,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281283.jpg?_r=1428779369","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"vancouverpetunia","Id":281283,"Name":"vancouverpetunia","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.51.43.112","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79556,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"52ce5874c6a1685638291d6f92846fcb","RawContent":"&lt;p&gt;Congrats on getting your plans set!! DR is a beautiful place -- romantic and beautiful and the perfect setting for a destination wedding ;)&lt;\/p&gt;","Attachments":[],"Id":1904096,"PostDate":1441250177,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats on getting your plans set!! DR is a beautiful place -- romantic and beautiful and the perfect setting for a destination wedding <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-size:18px;\"><span style=\"font-family:georgia;\"><strong>MARIESAM SANCHEZ PHOTOGRAPHY<\/strong><\/span><\/span><br>\nWEBSITE: <a  class=\"bbc_url\" href=\"http:\/\/www.mariesamsanchez.com\">www.mariesamsanchez.com<\/a><br>\nBLOG: <a  class=\"bbc_url\" href=\"http:\/\/www.mariesamsanchezblog.com\">www.mariesamsanchez.com<\/a><a data-ipb='nomediaparse' href='http:\/\/www.mariesamsanchez.com\/blog'>\/blog<\/a><br>\nCONTACT ME: <a  class=\"bbc_email\" href=\"mailto:mariesam.sanchez@gmail.com?subject=BDW%20Inquiry\" title=\"E-mail Link\">mariesam.sanchez@gmail.com<\/a><br><br><img src=\"http:\/\/i287.photobucket.com\/albums\/ll150\/msam007562\/063cb5c8-dbda-4822-87fe-ba3c0ebcdb7f.jpg\" alt=\"063cb5c8-dbda-4822-87fe-ba3c0ebcdb7f.jpg\">","Email":"mariesam.sanchez@gmail.com","IpAddress":"74.100.61.37","GroupId":38,"GroupName":"Moderators","JoinDate":1285939945,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232833.jpg?_r=1422091823","PhotoWidth":200,"PhotoHeight":220,"PhotoType":"custom"},"FormattedName":"MarieSamSanchezPhoto","Id":232833,"Name":"MarieSamSanchezPhoto","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"67.17.215.182","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79556,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"29bd6e423cd8c10de94f31f58e52fbf3","RawContent":"&lt;p&gt;@[member=\"MegLeLy\"] congratulations! Having your resort selected and book is half the battle. You will love the Dominica Republic. As @[member=\"JamaicaNicole\"] mentioned the Caribbean site is lovely. The food is delicious with Tostones in almost every dish :lol:.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Now it&#039;s all about confirming your guests, choosing your dress, suits, bridesmaid dresses, figuring out the d\u00e9cor, the&amp;nbsp;little details,&amp;nbsp;hair and make up, selecting a fantastic videographer and experienced&amp;nbsp;destination photographer.\n\n\nLove Emma&amp;nbsp; :)&lt;\/p&gt;","Attachments":[],"Id":1904127,"PostDate":1441279827,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"284131\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/284131-meglely\/' title='Member profile'><span itemprop=\"name\">MegLeLy<\/span><\/a> congratulations! Having your resort selected and book is half the battle. You will love the Dominica Republic. As @<a hovercard-ref=\"member\" hovercard-id=\"279353\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/279353-jamaicanicole\/' title='Member profile'><span itemprop=\"name\">JamaicaNicole<\/span><\/a> mentioned the Caribbean site is lovely. The food is delicious with Tostones in almost every dish <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/laugh.png' class='bbc_emoticon' alt=':lol:' \/>.<\/p>\n<p>\u00a0<\/p>\n<p>Now it's all about confirming your guests, choosing your dress, suits, bridesmaid dresses, figuring out the d\u00e9cor, the\u00a0little details,\u00a0hair and make up, selecting a fantastic videographer and experienced\u00a0destination photographer.<br><br>\nLove Emma\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Our\u00a0perfect wedding in the Riviera Maya.<\/p>\n<p>\u00a0<\/p>\n<p>Date:\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 01\/15\/2015<\/p>\n<p>Resort:\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 Occidental Grand Xcaret - Riviera Maya, Mexico<br>\nGuests:\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 \u00a070-80<br>\nPackage:\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0Custom<\/p>\n<p>Dress:\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 David's Bridal<br>\nMinister:\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0Family Friend<\/p>\n<p>Photographer:\u00a0\u00a0 \u00a0Decordova Photography ( <a data-ipb='nomediaparse' href='http:\/\/www.decordova.ca'>www.decordova.ca<\/a> )<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"emma.palmer@rogers.com","IpAddress":"67.17.215.182","GroupId":39,"GroupName":"Newbie","JoinDate":1419930757,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"emmapalmer","Id":281523,"Name":"emmapalmer","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"177.237.80.72","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79556,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"e0704ae4e7f4c7444d1e79beed7fbb4c","RawContent":"&lt;p&gt;Congrats on choosing your date and wedding venue, MegLeLy - that&#039;s a BIG check-mark in the win column :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Wishing you all the best with the rest of your plans, and that you can take the time to Enjoy your journey - cheers!!! team mtm :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-mia1-1.xx.fbcdn.net\/hphotos-ash2\/t31.0-8\/1237233_10151786900719487_1764055204_o.jpg\" alt=\"1237233_10151786900719487_1764055204_o.j\"&gt;&lt;\/p&gt;","Attachments":[],"Id":1904197,"PostDate":1441457413,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats on choosing your date and wedding venue, MegLeLy - that's a BIG check-mark in the win column <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Wishing you all the best with the rest of your plans, and that you can take the time to Enjoy your journey - cheers!!! team mtm <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-mia1-1.xx.fbcdn.net\/hphotos-ash2\/t31.0-8\/1237233_10151786900719487_1764055204_o.jpg\" alt=\"1237233_10151786900719487_1764055204_o.j\"><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280196260,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.17.41.18","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79556,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2fd085c70ae967054efe3aeec4ebefa4","RawContent":"&lt;p&gt;Thanks!&amp;nbsp; My TA has been there multiple times and highly suggested it.   I&#039;m getting excited!   but still have a long time to go.&lt;\/p&gt;","Attachments":[],"Id":1905561,"PostDate":1443460964,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thanks!\u00a0 My TA has been there multiple times and highly suggested it.\u00a0\u00a0 I'm getting excited!\u00a0\u00a0 but still have a long time to go.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"megewy@yahoo.com","IpAddress":"99.17.41.18","GroupId":39,"GroupName":"Newbie","JoinDate":1437848879,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"MegLeLy","Id":284131,"Name":"MegLeLy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79556,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"141d774af96fa5e38f0d24c51d76c363","RawContent":"&lt;p&gt;Congrats! Exciting times ahead :)&lt;\/p&gt;","Attachments":[],"Id":1905600,"PostDate":1443521557,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats! Exciting times ahead <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419423414,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1436293677","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}}],"Pages":{"TotalItems":12,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
