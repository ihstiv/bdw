{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72614,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"89312be04dea70deaa776d7de37830a0","RawContent":"I&#039;m gonna wear it all day, after the ship sails I would like 2 have a cocktail hr for our sailing guests 2 continue our celebration n then we have dinner at 6pm dinner n after that I may be exhausted n ready for bed! Haha haven&#039;t yet decided on a gown, I still have quiet some time. But I plan on making our wedding an all day affair :)","Attachments":[],"Id":1737994,"PostDate":1364211214,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm gonna wear it all day, after the ship sails I would like 2 have a cocktail hr for our sailing guests 2 continue our celebration n then we have dinner at 6pm dinner n after that I may be exhausted n ready for bed! Haha haven't yet decided on a gown, I still have quiet some time. But I plan on making our wedding an all day affair <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"July2014bride@verizon.net","IpAddress":"","GroupId":47,"GroupName":"Site Supporter","JoinDate":1358981135,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-264966.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"MK71809","Id":264966,"Name":"MK71809","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"69.117.93.162","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72614,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ecd9a7f5322c6ec3adc195608446b63c","RawContent":"Still deciding on a gown","Attachments":[],"Id":1861370,"PostDate":1405996676,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Still deciding on a gown\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bseasebey@yahoo.com","IpAddress":"69.117.93.162","GroupId":40,"GroupName":"Jr. Member","JoinDate":1402061968,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"SuchALady777","Id":278273,"Name":"SuchALady777","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.182.39.99","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72614,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cb1126b46fe12fbbe8d988a2cb9e0057","RawContent":"I bought my dress from Davids bridal. It was the only one I truly fell in love with (I almost left without purchasing one).","Attachments":[],"Id":1861380,"PostDate":1406003426,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I bought my dress from Davids bridal. It was the only one I truly fell in love with (I almost left without purchasing one). \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"Good Luck <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>","Email":"ms.tatiana.rivera@gmail.com","IpAddress":"50.182.39.99","GroupId":40,"GroupName":"Jr. Member","JoinDate":1403762681,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Tatimrivera","Id":278701,"Name":"Tatimrivera","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.155.94.124","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72614,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8ec8ac2e2569ad742203f3b0c3f28f91","RawContent":"I&#039;m so hoping we can head over to the lounge area at the hotel and I&#039;ll be able to keep wearing my dress. I just don&#039;t want to take it off after a few hours. I love it that much and I want to enjoy every minute of the day with it haha. I&#039;m also having another reception in Argentina so I&#039;ll wear it yet again! \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1861389,"PostDate":1406004630,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm so hoping we can head over to the lounge area at the hotel and I'll be able to keep wearing my dress. I just don't want to take it off after a few hours. I love it that much and I want to enjoy every minute of the day with it haha. I'm also having another reception in Argentina so I'll wear it yet again! <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<br><p><a data-ipb='nomediaparse' href='http:\/\/www.TickerFactory.com\/'><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;31;484\/st\/20150813\/e\/Wedding+time%21+\/dt\/-2\/k\/b92c\/event.png\" alt=\"event.png\"><\/a><\/p>\n<p style=\"text-align:center;\">\u00a0<\/p>\n<p style=\"text-align:center;\">\u00a0","Email":"sblopezb@gmail.com","IpAddress":"172.219.193.22","GroupId":42,"GroupName":"Sr. Member","JoinDate":1359763104,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265511.jpg?_r=1442890536","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"TinkerSofi","Id":265511,"Name":"TinkerSofi","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"69.117.93.162","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72614,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"19da2da76b56c0d3e87f0179ead20654","RawContent":"&lt;p&gt;Yes...me too. I need to find a dress still&lt;\/p&gt;","Attachments":[],"Id":1861923,"PostDate":1406170375,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Yes...me too. I need to find a dress still<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bseasebey@yahoo.com","IpAddress":"69.117.93.162","GroupId":40,"GroupName":"Jr. Member","JoinDate":1402061968,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"SuchALady777","Id":278273,"Name":"SuchALady777","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.247.221.156","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72614,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6d73ad6ac6dd0720ed615bd61828e8bb","RawContent":"&lt;p&gt;I havent even looked in stores. I have looked online, and have tagged a few that I like, but when people ask what style I am looking for all I can think is &#039;romantic&#039;. Im not even sure if I know what that means. Haha&lt;\/p&gt;","Attachments":[],"Id":1861942,"PostDate":1406172570,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I havent even looked in stores. I have looked online, and have tagged a few that I like, but when people ask what style I am looking for all I can think is 'romantic'. Im not even sure if I know what that means. Haha<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jen.tipler@gmail.com","IpAddress":"99.247.221.156","GroupId":40,"GroupName":"Jr. Member","JoinDate":1404873744,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278914.jpg?_r=1427504777","PhotoWidth":200,"PhotoHeight":146,"PhotoType":"custom"},"FormattedName":"MissJen3","Id":278914,"Name":"MissJen3","IsOnline":false}}],"Pages":{"TotalItems":16,"TotalPages":2,"CurrentPage":10,"NextPage":-1,"PreviousPage":0,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
