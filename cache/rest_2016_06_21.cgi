omediaparse&#039; href=&#039;http:\/\/client.jasminandmatt.com\/guestlogin\/testgallery\/&#039;&gt;http:\/\/client.jasminandmatt.com\/guestlogin\/testgallery\/&lt;\/a&gt; &lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Cheers!!!&lt;\/p&gt;","Attachments":[],"Id":1914112,"PostDate":1464782109,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Everyone!!<\/p>\n<p>\u00a0<\/p>\n<p>We are Jasmin & Matt, destination wedding and lifestyle photographers.<\/p>\n<p>\u00a0<\/p>\n<p>We are so excited to be part of this amazing community and hope to work with many of you in the future.<\/p>\n<p>\u00a0<\/p>\n<p>If you have any questions for us, about our company or even about the Mayan Riviera we are more than happy to help.<\/p>\n<p>\u00a0<\/p>\n<p>Check out our work on our website <a href='http:\/\/www.jasminandmatt.com' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.jasminandmatt.com<\/a>and all of our latest teasers here: <a href='http:\/\/client.jasminandmatt.com\/guestlogin\/testgallery\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/client.jasmin...in\/testgallery\/<\/a> <\/p>\n<p>\u00a0<\/p>\n<p>Cheers!!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/www.jasminandmatt.com\/wp-content\/uploads\/2016\/05\/jasminandmattidomexicosignature.png\" alt=\"jasminandmattidomexicosignature.png\"><\/p>\n<p><strong>Website:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);font-size:14px;\"><a data-ipb='nomediaparse' href='http:\/\/www.jasminandmatt.com\/'>http:\/\/www.jasminandmatt.com<\/a><\/span><br><strong>Email:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);font-size:14px;\"><a data-ipb='nomediaparse' href='mailto:info@jasminandmatt.com'>info@jasminandmatt.com<\/a><\/span><br><strong>Phone:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);font-size:14px;\">+52 984-114-3386<\/span><br><strong>Facebook:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);font-size:14px;\"><a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/jasminandmatt\/'>Jasmin & Matt Photography<\/a><\/span><br><strong>Instagram:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);font-size:14px;\"><a data-ipb='nomediaparse' href='https:\/\/www.instagram.com\/jasminandmattphotography\/'>@jasminandmattphotography<\/a><\/span><br><strong>Pinterest:<\/strong>\u00a0<span style=\"color:rgb(240,128,128);font-size:14px;\"><a data-ipb='nomediaparse' href='https:\/\/www.pinterest.com\/jasminandmatt'>Jasmin & Matt<\/a><\/span><\/p>\n<p>\u00a0","Email":"forward@jasminandmatt.com","IpAddress":"187.153.21.84","GroupId":49,"GroupName":"Insiders","JoinDate":1464781539,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-287055.jpg?_r=1464796174","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"JasminMattPhoto","Id":287055,"Name":"JasminMattPhoto","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.202.225.11","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80112,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"0df76708233abb3ea4019d61a19a8649","RawContent":"&lt;p&gt;welcome to BDW!!&lt;\/p&gt;","Attachments":[],"Id":1914113,"PostDate":1464782957,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>welcome to BDW!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-family:arial, helvetica, sans-serif;\">Founder and Owner of BestDestinationWedding.com \u00a0\/ \u00a0<\/span><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/'><strong><span style=\"font-family:arial, helvetica, sans-serif;\">Bride & Groom Fly FREE Promotion<\/span><\/strong><\/a><\/p>\n<p>\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><a data-ipb='nomediaparse' href='https:\/\/www.wrighttravelagency.com\/go\/destination-wedding\/?source=EMLSIG'><strong><span style=\"color:#008080;\">Looking for a travel agency that specializes in Destination Weddings-CLICK HERE<\/span><\/strong><\/a><span style=\"color:#008080;\"><strong>?<\/strong> \u00a0We are an award winning travel agency and you can <\/span><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style=\"color:#008080;\">read our reviews\u00a0here.<\/span><\/a><\/strong><\/span><br>\n\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"color:#008080;\"><strong>Awards and recognition:\u00a0<\/strong><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Palace Resorts Winner \"Top Travel Agent\", \"Top Homebased Travel Agency\" PRO Platinum Agency (Top Award) \u00a0 \u00a0 | \u00a0 \u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">AMResorts Master Agent & Top Agency \u00a0<