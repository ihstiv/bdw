{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":2,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":659,"MovedTo":null,"MovedOn":0,"FirstPostId":1813727,"Rating":0,"RatingHits":0,"Starter":{"Id":269116,"Name":"gresley","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-269116.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"IsOnline":false},"StartDate":1384147193,"LastPoster":{"Id":273099,"Name":"Brit11","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-273099.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":113,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":88,"Preview":{"Id":1816114,"PostDate":1384984447,"PostContent":"Are you using a wedding coordinator? I am getting married on another island in May, but my weddin...","Author":{"Signature":"","Email":"vervechick11@gmail.com","IpAddress":"68.90.42.191","GroupId":39,"GroupName":"Newbie","JoinDate":1378050658,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-273099.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"Brit11","Id":273099,"Name":"Brit11","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75560,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"149bd2ee1d0abfec3fae76150e8e75d4","RawContent":"&lt;p&gt;Hi all,&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;I&#039;m getting married on the RCCL Adventure of the Seas in April. The complication is that the actual ceremony is&amp;nbsp;&lt;em&gt;in Nassau&lt;\/em&gt;, not on the boat.&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;One thing I&#039;ve been curious about -- how did you guys figure out hair and makeup? Did you do it on the island, or on the boat?&amp;nbsp;&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;I&#039;m hoping that we can use the salon\/spa on the ship, but my one concern is that our ceremony is at 10am. This means that makeup and everything would have to happen at like 6 or 7, and I&#039;m not sure what time they even open :(&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;How did you ladies make this work?&lt;\/p&gt;","Attachments":[],"Id":1813727,"PostDate":1384147193,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi all,<\/p> <p>\u00a0<\/p> <p>I'm getting married on the RCCL Adventure of the Seas in April. The complication is that the actual ceremony is\u00a0<em>in Nassau<\/em>, not on the boat.<\/p> <p>\u00a0<\/p> <p>One thing I've been curious about -- how did you guys figure out hair and makeup? Did you do it on the island, or on the boat?\u00a0<\/p> <p>\u00a0<\/p> <p>I'm hoping that we can use the salon\/spa on the ship, but my one concern is that our ceremony is at 10am. This means that makeup and everything would have to happen at like 6 or 7, and I'm not sure what time they even open <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/sad.png' class='bbc_emoticon' alt=':(' \/><\/p> <p>\u00a0<\/p> <p>How did you ladies make this work?<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"atlaeludlow@gmail.com","IpAddress":"98.234.104.236","GroupId":40,"GroupName":"Jr. Member","JoinDate":1367267186,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-269116.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"gresley","Id":269116,"Name":"gresley","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75560,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ac8bba3f24437db4c22039ef075ccdd2","RawContent":"&lt;p&gt;Are you using a wedding coordinator? I am getting married on another island in May, but my wedding coordinator put me in contact with stylists on the island to discuss hair and makeup and they will meet me in my suite the morning of the wedding.&amp;nbsp;&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;Hope this helps!&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1816114,"PostDate":1384984447,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Are you using a wedding coordinator? I am getting married on another island in May, but my wedding coordinator put me in contact with stylists on the island to discuss hair and makeup and they will meet me in my suite the morning of the wedding.\u00a0<\/p> <p>\u00a0<\/p> <p>Hope this helps!\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"vervechick11@gmail.com","IpAddress":"68.90.42.191","GroupId":39,"GroupName":"Newbie","JoinDate":1378050658,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-273099.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"Brit11","Id":273099,"Name":"Brit11","IsOnline":false}}],"Id":"75560","Title":"Hair \/ Makeup \/ Prep?","LastPostDate":1384984447},"Pages":{"TotalItems":2,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
