{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":28,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":4079,"MovedTo":null,"MovedOn":0,"FirstPostId":1886019,"Rating":0,"RatingHits":0,"Starter":{"Id":282063,"Name":"Cablelove11","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1423661919,"LastPoster":{"Id":283657,"Name":"bkelly8","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":22,"Preview":{"Id":1886019,"PostDate":1423661919,"PostContent":"Hey ladies (and gents \ud83d\ude09) I thought that I would start a new thread because it seems as if the oth...","Author":{"Signature":"","Email":"lmf0408@gmail.com","IpAddress":"208.54.64.217","GroupId":39,"GroupName":"Newbie","JoinDate":1423576366,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Cablelove11","Id":282063,"Name":"Cablelove11","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"172.56.5.149","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78772,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a53048b22e142ca6aac891149be26200","RawContent":"Hey ladies (and gents \ud83d\ude09) I thought that I would start a new thread because it seems as if the other older ones keep trying to get revied with little success. I am not offically a HRPC bride, however it is strongly my #1 favorite!!!! I&#039;m trying to decide when to go to get the best rate... I&#039;m thinking near the end of May but am pretty much open! What about you ladies? What made you decide to choose HRPC or past ladies how did everything go?","Attachments":[],"Id":1886019,"PostDate":1423661919,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hey ladies (and gents \ud83d\ude09) I thought that I would start a new thread because it seems as if the other older ones keep trying to get revied with little success. I am not offically a HRPC bride, however it is strongly my #1 favorite!!!! I'm trying to decide when to go to get the best rate... I'm thinking near the end of May but am pretty much open! What about you ladies? What made you decide to choose HRPC or past ladies how did everything go?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lmf0408@gmail.com","IpAddress":"208.54.64.217","GroupId":39,"GroupName":"Newbie","JoinDate":1423576366,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Cablelove11","Id":282063,"Name":"Cablelove11","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.101.123.54","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78772,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0bdf61bd7d713ccbb937abd7ab89e166","RawContent":"&lt;p&gt;Hey everyone! I am in the process of securing my 2016 date for HRH Punta Cana! I would LOVE any information on pricing from anyone who has gotten married here with a large group, we are expecting about 125 guest!! Looking into April of next year.. What are everyones plans?? Has anyone gotten quotes for group rates yet? My TA quoted it at a little over 400\/room a night, its pretty expensive but with the resort credits you get back + the qualifying for \"free private events\" does help tremendously! Thank you @Cablelove11for starting this thread and Good Luck to you!!!&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1886117,"PostDate":1423706664,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hey everyone! I am in the process of securing my 2016 date for HRH Punta Cana! I would LOVE any information on pricing from anyone who has gotten married here with a large group, we are expecting about 125 guest!! Looking into April of next year.. What are everyones plans?? Has anyone gotten quotes for group rates yet? My TA quoted it at a little over 400\/room a night, its pretty expensive but with the resort credits you get back + the qualifying for \"free private events\" does help tremendously! Thank you @Cablelove11for starting this thread and Good Luck to you!!!\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"melissanmedina@gmail.com","IpAddress":"71.183.123.61","GroupId":39,"GroupName":"Newbie","JoinDate":1402945459,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278540.jpg?_r=1423707937","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"MelissaNicole","Id":278540,"Name":"MelissaNicole","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"73.54.197.228","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78772,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2ec5187f6f1d30e3b47bf36396a506a2","RawContent":"@[member=\"MelissaNicole\"] wow that is a lot of guests!!!!! I hope your planning goes smoothly!!!!","Attachments":[],"Id":1886119,"PostDate":1423710939,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"278540\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/278540-melissanicole\/' title='Member profile'><span itemprop=\"name\">MelissaNicole<\/span><\/a> wow that is a lot of guests!!!!! I hope your planning goes smoothly!!!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lmf0408@gmail.com","IpAddress":"208.54.64.217","GroupId":39,"GroupName":"Newbie","JoinDate":1423576366,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Cablelove11","Id":282063,"Name":"Cablelove11","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.234.116.105","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78772,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"de95a7ca23fb79e7688980824dc96c47","RawContent":"I would love to book either this Hard Rock, or the one in Riveira Maya.  My SO wants to keep it under $1300 for our guests.  Guesstimating we&#039;ll have about 40.   We&#039;re in Toronto.  I was planning on April but I&#039;d move the date if it makes either resort viable.","Attachments":[],"Id":1886474,"PostDate":1424110141,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I would love to book either this Hard Rock, or the one in Riveira Maya.  My SO wants to keep it under $1300 for our guests.  Guesstimating we'll have about 40.   We're in Toronto.  I was planning on April but I'd move the date if it makes either resort viable.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>My Planning Thread (Grand Sirenis 05.12.16)<a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/79418-joannabananas-planning-thread-may-12th-2016-grand-sirenis\/\">http:\/\/www.bestdestinationwedding.com\/topic\/79418-joannabananas-planning-thread-may-12th-2016-grand-sirenis\/<\/a><p><br><br><br><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/t\/wSWQNi0\/weight.png\" alt=\"weight.png\"><br><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;484\/st\/20160512\/e\/Our+Wedding\/k\/f153\/event.png\" alt=\"event.png\">","Email":"joanne.aguiar@gmail.com","IpAddress":"99.234.116.105","GroupId":40,"GroupName":"Jr. Member","JoinDate":1424056909,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282128.jpg?_r=1441196917","PhotoWidth":200,"PhotoHeight":203,"PhotoType":"custom"},"FormattedName":"JoannaBanana","Id":282128,"Name":"JoannaBanana","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.41.59","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78772,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"43e62a988e0d958c4c1bade70ca1854a","RawContent":"[quote name=\"Neako\" post=\"1886474\" timestamp=\"1424110141\"]\nI would love to book either this Hard Rock, or the one in Riveira Maya.  My SO wants to keep it under $1300 for our guests.  Guesstimating we&#039;ll have about 40.   We&#039;re in Toronto.  I was planning on April but I&#039;d move the date if it makes either resort viable.[\/quote]I&#039;d suggest talking to a TA. I could be way off but the Hard Rock for under $1300 may be hard to get.  I just married in January in the Mayan... Our guests from TO paid $1465. The cheapest I could find was in Puerto Vallarta and that was around $1250.   I also priced early May and late April and the prices were higher. \n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1886484,"PostDate":1424118705,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Neako, on 16 February 2015 - 10:09 AM, said:<\/p><div class='blockquote'><div class='quote'><p>I would love to book either this Hard Rock, or the one in Riveira Maya.  My SO wants to keep it under $1300 for our guests.  Guesstimating we'll have about 40.   We're in Toronto.  I was planning on April but I'd move the date if it makes either resort viable.<\/p><\/div><\/div>\n<br>\nI'd suggest talking to a TA. I could be way off but the Hard Rock for under $1300 may be hard to get.  I just married in January in the Mayan... Our guests from TO paid $1465. The cheapest I could find was in Puerto Vallarta and that was around $1250.   I also priced early May and late April and the prices were higher. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399428602,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.234.116.105","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78772,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e9ad2186a6d1e977bca7090cf29d3fb1","RawContent":"I think you&#039;re right.  I&#039;ve been thinking Riu Palace and I think I need to bring myself back down to that level.  Man.  Hard Rock is nice...","Attachments":[],"Id":1886485,"PostDate":1424118807,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I think you're right.  I've been thinking Riu Palace and I think I need to bring myself back down to that level.  Man.  Hard Rock is nice...\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>My Planning Thread (Grand Sirenis 05.12.16)<a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/79418-joannabananas-planning-thread-may-12th-2016-grand-sirenis\/\">http:\/\/www.bestdestinationwedding.com\/topic\/79418-joannabananas-planning-thread-may-12th-2016-grand-sirenis\/<\/a><p><br><br><br><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/t\/wSWQNi0\/weight.png\" alt=\"weight.png\"><br><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;484\/st\/20160512\/e\/Our+Wedding\/k\/f153\/event.png\" alt=\"event.png\">","Email":"joanne.aguiar@gmail.com","IpAddress":"99.234.116.105","GroupId":40,"GroupName":"Jr. Member","JoinDate":1424056909,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282128.jpg?_r=1441196917","PhotoWidth":200,"PhotoHeight":203,"PhotoType":"custom"},"FormattedName":"JoannaBanana","Id":282128,"Name":"JoannaBanana","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.41.59","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78772,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1296929b103147f9355f61ee68060630","RawContent":"[quote name=\"Neako\" post=\"1886485\" timestamp=\"1424118807\"]\nI think you&#039;re right.  I&#039;ve been thinking Riu Palace and I think I need to bring myself back down to that level.  Man.  Hard Rock is nice...[\/quote]Yes I bet it is. Love the brand :)\nChoosing a resort is tough as there is soooo much to consider.  Also you need to ensure a resort you do have on your short list has a good wedding department and packages!!!  I looked at some that I loved but couldn&#039;t have afforded their weddings  to save my life :\/ \n\nIf you need a good TA I can recommend mine and send you her info. The one we ultimately chose was on her recommendation and was never on our radar.   She will get an idea of what you want to spend, the types if resorts you desire and be able to tell you - from her experience - what may come back in your price point. \n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1886486,"PostDate":1424119067,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Neako, on 16 February 2015 - 12:33 PM, said:<\/p><div class='blockquote'><div class='quote'><p>I think you're right.  I've been thinking Riu Palace and I think I need to bring myself back down to that level.  Man.  Hard Rock is nice...<\/p><\/div><\/div>\n<br>\nYes I bet it is. Love the brand <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br>\nChoosing a resort is tough as there is soooo much to consider.  Also you need to ensure a resort you do have on your short list has a good wedding department and packages!!!  I looked at some that I loved but couldn't have afforded their weddings  to save my life :\/ <br><br>\nIf you need a good TA I can recommend mine and send you her info. The one we ultimately chose was on her recommendation and was never on our radar.   She will get an idea of what you want to spend, the types if resorts you desire and be able to tell you - from her experience - what may come back in your price point. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399428602,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.234.116.105","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78772,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"41a1088c3919919f0b364fc49cf2d5fc","RawContent":"Sure, send me a PM!","Attachments":[],"Id":1886487,"PostDate":1424119201,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Sure, send me a PM! \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>My Planning Thread (Grand Sirenis 05.12.16)<a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/79418-joannabananas-planning-thread-may-12th-2016-grand-sirenis\/\">http:\/\/www.bestdestinationwedding.com\/topic\/79418-joannabananas-planning-thread-may-12th-2016-grand-sirenis\/<\/a><p><br><br><br><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/t\/wSWQNi0\/weight.png\" alt=\"weight.png\"><br><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;484\/st\/20160512\/e\/Our+Wedding\/k\/f153\/event.png\" alt=\"event.png\">","Email":"joanne.aguiar@gmail.com","IpAddress":"99.234.116.105","GroupId":40,"GroupName":"Jr. Member","JoinDate":1424056909,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282128.jpg?_r=1441196917","PhotoWidth":200,"PhotoHeight":203,"PhotoType":"custom"},"FormattedName":"JoannaBanana","Id":282128,"Name":"JoannaBanana","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"206.186.135.100","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78772,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4b8e3dfde22eded4ce4dd142ce79a201","RawContent":"&lt;p&gt;Turns out that Hard Rock Riveira Maya and Riu Palace Mexico are about the same price - $1800.&amp;nbsp; Going to have to talk to the man about lower expectations and raising the budgets and finding somewhere in the middle of that where we&#039;re comfortable.&lt;\/p&gt;","Attachments":[],"Id":1886598,"PostDate":1424195357,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Turns out that Hard Rock Riveira Maya and Riu Palace Mexico are about the same price - $1800.\u00a0 Going to have to talk to the man about lower expectations and raising the budgets and finding somewhere in the middle of that where we're comfortable.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>My Planning Thread (Grand Sirenis 05.12.16)<a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/79418-joannabananas-planning-thread-may-12th-2016-grand-sirenis\/\">http:\/\/www.bestdestinationwedding.com\/topic\/79418-joannabananas-planning-thread-may-12th-2016-grand-sirenis\/<\/a><p><br><br><br><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/t\/wSWQNi0\/weight.png\" alt=\"weight.png\"><br><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;484\/st\/20160512\/e\/Our+Wedding\/k\/f153\/event.png\" alt=\"event.png\">","Email":"joanne.aguiar@gmail.com","IpAddress":"99.234.116.105","GroupId":40,"GroupName":"Jr. Member","JoinDate":1424056909,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282128.jpg?_r=1441196917","PhotoWidth":200,"PhotoHeight":203,"PhotoType":"custom"},"FormattedName":"JoannaBanana","Id":282128,"Name":"JoannaBanana","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"184.151.222.197","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78772,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"68b5be14cea5fb599a5985acf5bd7d7b","RawContent":"[quote name=\"Neako\" post=\"1886598\" timestamp=\"1424195357\"]\nTurns out that Hard Rock Riveira Maya and Riu Palace Mexico are about the same price - $1800.  Going to have to talk to the man about lower expectations and raising the budgets and finding somewhere in the middle of that where we&#039;re comfortable.[\/quote]I&#039;m actually surprised. I thought it would be more!!! \n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1886613,"PostDate":1424202257,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Neako, on 17 February 2015 - 09:49 AM, said:<\/p><div class='blockquote'><div class='quote'><p>Turns out that Hard Rock Riveira Maya and Riu Palace Mexico are about the same price - $1800.  Going to have to talk to the man about lower expectations and raising the budgets and finding somewhere in the middle of that where we're comfortable.<\/p><\/div><\/div>\n<br>\nI'm actually surprised. I thought it would be more!!! <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399428602,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}}],"Id":"78772","Title":"Hard Rock Punta Cana 2015\/2016 Brides","LastPostDate":1451323048},"Pages":{"TotalItems":28,"TotalPages":3,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":20},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
