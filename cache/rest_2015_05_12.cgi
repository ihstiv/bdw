{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.50.56.179","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78326,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f7bdd7b483adb5ca908ebd2b64d9ded1","RawContent":"We sent save the dates with our website information and travel agents info in October of 2013 for our May 2015 wedding. ((We had payment plan option which required a initial per person deposit by Dec 2013)). Invitations went out July 15th of this year with a Dec 1 RSVP\/final booking date..\n\n\nLooking back I think sending the invitations in July was the dumbest decision ever, as we only recieved 30% of the RSVP&#039;s back... \n\n\nInvites and save the dates attached!","Attachments":[],"Id":1879517,"PostDate":1417546643,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We sent save the dates with our website information and travel agents info in October of 2013 for our May 2015 wedding. ((We had payment plan option which required a initial per person deposit by Dec 2013)). Invitations went out July 15th of this year with a Dec 1 RSVP\/final booking date..<br><br>\nLooking back I think sending the invitations in July was the dumbest decision ever, as we only recieved 30% of the RSVP's back... <br><br>\nInvites and save the dates attached![attachment=30172:image.jpg][attachment=30172:image.jpg][attachment=30172:image.jpg][attachment=30172:image.jpg][attachment=30172:image.jpg][attachment=30172:image.jpg][attachment=30173:image.jpg][attachment=30173:image.jpg][attachment=30173:image.jpg][attachment=30173:image.jpg][attachment=30173:image.jpg][attachment=30173:image.jpg][attachment=30174:image.jpg]<a class='resized_img' rel='lightbox[1879517]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_12_2014\/post-272393-0-43673800-1417568212.jpg\" title=\"image.jpg -  98.38KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_12_2014\/post-272393-0-43673800-1417568212.jpg\" class='bbc_img linked-image' alt=\"image.jpg\" \/><\/a>\n\n<a class='resized_img' rel='lightbox[1879517]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_12_2014\/post-272393-0-67411800-1417568228.jpg\" title=\"image.jpg -  67.12KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_12_2014\/post-272393-0-67411800-1417568228.jpg\" class='bbc_img linked-image' alt=\"image.jpg\" \/><\/a>\n\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"May 01, 2015- complete!! ","Email":"cooper.tyshelle@gmail.com","IpAddress":"108.50.56.179","GroupId":39,"GroupName":"Newbie","JoinDate":1375991469,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272393.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"DR2015","Id":272393,"Name":"DR2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.211.78.71","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78326,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"43d8e6482f646fcba77d855231e6fa67","RawContent":"At this point I&#039;m almost finished with our e card save the dates for our September 2015 wedding.  I&#039;ll be doing invites early next year.  I really appreciate all of your feedback.  It&#039;s been very helpful.  :)","Attachments":[],"Id":1879534,"PostDate":1417563954,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                At this point I'm almost finished with our e card save the dates for our September 2015 wedding.  I'll be doing invites early next year.  I really appreciate all of your feedback.  It's been very helpful.  <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nateerinwedding@gmail.com","IpAddress":"69.62.134.155","GroupId":39,"GroupName":"Newbie","JoinDate":1412195489,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280198.jpg?_r=1412219510","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"FormattedName":"eirbear0915","Id":280198,"Name":"eirbear0915","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"64.53.250.35","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78326,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"77d1ee82d8c74ec453538d7b5119349f","RawContent":"&lt;p&gt;I sent out my save the dates in early November for our June 2015 wedding, which seems a lot later than most these brides, but virtually all the people who I knew would actually go already had our website and everything, and many were already booked before I sent them out (we also don&#039;t have a very strict booking deadline according to our travel agent, but now I&#039;m starting to wonder if that&#039;s strange). &amp;nbsp;I also used Magnets from Magnetstreet.com so people who haven&#039;t booked yet would stick it on their fridge and have a constant reminder that they need to get booked!&lt;\/p&gt;","Attachments":[],"Id":1879756,"PostDate":1417766078,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I sent out my save the dates in early November for our June 2015 wedding, which seems a lot later than most these brides, but virtually all the people who I knew would actually go already had our website and everything, and many were already booked before I sent them out (we also don't have a very strict booking deadline according to our travel agent, but now I'm starting to wonder if that's strange). \u00a0I also used Magnets from Magnetstreet.com so people who haven't booked yet would stick it on their fridge and have a constant reminder that they need to get booked!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rachelia160@aim.com","IpAddress":"66.61.104.237","GroupId":40,"GroupName":"Jr. Member","JoinDate":1388710297,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275855.jpg?_r=1414697242","PhotoWidth":185,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"rachelia160","Id":275855,"Name":"rachelia160","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"38.124.40.102","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78326,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2f3f719ab72940b5e966234ffe04840c","RawContent":"&lt;p&gt;I found this blog post about destination wedding hacks which I thought were very useful. I hope it&#039;s helpful for you as well :).&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.storymixmedia.com\/weddingmix\/blog\/?s=hacks&#039;&gt;http:\/\/www.storymixmedia.com\/weddingmix\/blog\/?s=hacks&lt;\/a&gt;&lt;\/p&gt;","Attachments":[],"Id":1879852,"PostDate":1417874566,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I found this blog post about destination wedding hacks which I thought were very useful. I hope it's helpful for you as well <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>.<\/p>\n<p>\u00a0<\/p>\n<p><a href='http:\/\/www.storymixmedia.com\/weddingmix\/blog\/?s=hacks' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.storymixm...x\/blog\/?s=hacks<\/a><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"blushingbride1988@gmail.com","IpAddress":"38.124.40.102","GroupId":39,"GroupName":"Newbie","JoinDate":1416229493,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"blushingbride19","Id":281186,"Name":"blushingbride19","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"100.38.25.198","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78326,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"997a452dcd18fcebecf1ec84aa551a13","RawContent":"We sent out STD in September for our July 2015 wedding. Our invitations are going out the first week of January. We picked that time because our room block expires at the end of March.","Attachments":[],"Id":1879876,"PostDate":1417960439,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We sent out STD in September for our July 2015 wedding. Our invitations are going out the first week of January. We picked that time because our room block expires at the end of March. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"robynbrooke81@gmail.com","IpAddress":"75.99.18.219","GroupId":40,"GroupName":"Jr. Member","JoinDate":1403525789,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278661.jpg?_r=1404161707","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"jeffandrobyn","Id":278661,"Name":"jeffandrobyn","IsOnline":false}}],"Pages":{"TotalItems":25,"TotalPages":3,"CurrentPage":20,"NextPage":-1,"PreviousPage":10,"LastPage":20},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"m