Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":18703,"QueuedPosts":0,"DeletedPosts":6,"HasUnreadPosts":true,"HasAttachments":true,"Views":962109,"MovedTo":null,"MovedOn":0,"FirstPostId":347143,"Rating":0,"RatingHits":0,"Starter":{"Id":208250,"Name":"JHarwood2Be","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208250.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"IsOnline":false},"StartDate":1213821096,"LastPoster":{"Id":280407,"Name":"carrieandsam","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280407.jpg?_r=1425426307","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":2,"Preview":{"Id":356360,"PostDate":1214422909,"PostContent":"Congratulations!!!!","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Photography by Tamm's Photos<\/span><br><a data-ipb='nomediaparse' href=\"http:\/\/www.ezticker.com\/ticker\/466\/192\/20090425\/Our+Wedding+in+Riviera+Maya\/ticker.png\">http:\/\/www.ezticker.com\/ticker\/466\/1...aya\/ticker.png<\/a><\/div><\/div>","Email":"behm.11@osu.edu","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1200463558,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208250.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"JHarwood2Be","Id":208250,"Name":"JHarwood2Be","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.87.66.102","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":18414,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":true,"PostKey":"85e0bef73a5222116778bc62ead21b32","RawContent":"@[member=\"StacyPaul\"] the beach was something my mom and I really worried about but in the end when Sam and I went on our BdR it didn&#039;t really bother me just because we hung out by the swim up bars since the pool is more relaxing then being in the ocean regardless of where you are. \n\n\nMost guest will venture to the pools and swim up bars and that was the case when we were down there for the BdR. However there were people laying out on the beds more than I would think but the area was groomed and the seaweed is picked up everyday. I had a family reunion in destin Florida where the beaches are beautiful and all the family hung out in the pool area. So that seems to be the case everywhere you go.\n\nIf you have snorkelers in your group the  tour guide up front has snorkel tours that take groups out past all the seaweed to coral and it&#039;s beautiful.\n\n\nJust like all the others have said, the service and the resort is absolutely breathtaking. Before going to the BdR I was a mess and meeting the staff there  completely calmed and reassured me that everything would be good. \n\n\nPlus Karisma is one of the better hotels for weddings in that area and that&#039;s saying something since the area is the number one destination wedding spot in the world.","Attachments":[],"Id":1895870,"PostDate":1431271666,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"283027\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/283027-stacypaul\/' title='Member profile'><span itemprop=\"name\">StacyPaul<\/span><\/a> the beach was something my mom and I really worried about but in the end when Sam and I went on our BdR it didn't really bother me just because we hung out by the swim up bars since the pool is more relaxing then being in the ocean regardless of where you are. <br><br>\nMost guest will venture to the pools and swim up bars and that was the case when we were down there for the BdR. However there were people laying out on the beds more than I would think but the area was groomed and the seaweed is picked up everyday. I had a family reunion in destin Florida where the beaches are beautiful and all the family hung out in the pool area. So that seems to be the case everywhere you go.<br>\nIf you have snorkelers in your group the  tour guide up front has snorkel tours that take groups out past all the seaweed to coral and it's beautiful.<br><br>\nJust like all the others have said, the service and the resort is absolutely breathtaking. Before going to the BdR I was a mess and meeting the staff there  completely calmed and reassured me that everything would be good. <br><br>\nPlus Karisma is one of the better hotels for weddings in that area and that's saying something since the area is the number one destination wedding spot in the world.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"carrieandsamswedding15@gmail.com","IpAddress":"76.169.253.92","GroupId":39,"GroupName":"Newbie","JoinDate":1412813196,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280407.jpg?_r=1425426307","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"carrieandsam","Id":280407,"Name":"carrieandsam","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.159.217.151","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":false,"TopicId":18414,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"befd89455d10b8ab12225ffdd596b39d","RawContent":"&lt;p&gt;Thank you all for your responses!!&amp;nbsp; Just when I decided to definitely go with the Sensatori my travel agent received news that the flight&amp;nbsp;was&amp;nbsp;booking up fast and now she isn&#039;t sure what will be left for room anymore :(  I may have wasted time being undecided and missed our originally date that I reserved!! if it isn&#039;t one stress it&#039;s another apparently lol.. But thanks again everyone.&amp;nbsp; My fingers are crossed that it will all work out and I can start on invitations...||||||||||||||&lt;\/p&gt;","Attachments":[],"Id":1895949,"PostDate":1431365955,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thank you all for your responses!!\u00a0 Just when I decided to definitely go with the Sensatori my travel agent received news that the flight\u00a0was\u00a0booking up fast and now she isn't sure what will be left for room anymore <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/sad.png' class='bbc_emoticon' alt=':(' \/>\u00a0\u00a0I may have wasted time being undecided and missed our originally date that I reserved!! if it isn't one stress it's another apparently lol.. But thanks again everyone.\u00a0 My fingers are crossed that it will all work out and I can start on invitations...||||||||||||||<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"paul_stacy@hotmail.com","IpAddress":"75.159.217.151","GroupId":39,"GroupName":"Newbie","JoinDate":1431077321,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"StacyPaul","Id":283027,"Name":"StacyPaul","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.87.131.56","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":18414,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5f87aa4c046d2e4513b2b52315cb9aaa","RawContent":"What was your date","Attachments":[],"Id":1895950,"PostDate":1431366163,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                What was your date \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"carrieandsamswedding15@gmail.com","IpAddress":"76.169.253.92","GroupId":39,"GroupName":"Newbie","JoinDate":1412813196,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280407.jpg?_r=1425426307","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"carrieandsam","Id":280407,"Name":"carrieandsam","IsOnline":false}}],"Id":"18414","Title":"Azul Sensatori Brides - POST HERE!","LastPostDate":1431366163},"Pages":{"TotalItems":18703,"TotalPages":1871,"CurrentPage":18700,"NextPage":-1,"PreviousPag