Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":8,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":177,"MovedTo":null,"MovedOn":0,"FirstPostId":1902835,"Rating":0,"RatingHits":0,"Starter":{"Id":284480,"Name":"littlemiss782","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1439971680,"LastPoster":{"Id":284480,"Name":"littlemiss782","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1903097,"PostDate":1440217131,"PostContent":"I'm from the UK and we've always wanted to go to the Caribbean. I have had a look at some hotels...","Author":{"Signature":"","Email":"ecushion@hotmail.co.uk","IpAddress":"176.249.218.33","GroupId":39,"GroupName":"Newbie","JoinDate":1439970724,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"littlemiss782","Id":284480,"Name":"littlemiss782","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"176.249.218.33","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79501,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3901cc59f8f84cfc8b30eba5ca5e1c59","RawContent":"Hi! \n\n\nJust came across this app and I&#039;m hoping all of you wonderful people can help me out? \n\n\nWe&#039;ve been engaged for a few years but never got round to getting married due to having children etc However, we have now decided on a destination wedding. We are looking to get married in 2017 which I know seems a long time off but we&#039;ll be able to book up in May 2016. \n\n\nIt&#039;s always been a dream of ours to go to the Caribbean so we are looking at Dominican Republic as a possibility. I really like the look of Dreams La Romana. After looking into the cost of the paper work etc it&#039;s looking like it&#039;s going to be a bit too expensive. Especially as we will only be able to go during the summer school holidays. \n\n\nI am now considering other destinations such as Greece, Mexico, Italy etc\n\n\nOur ideal destination would be:\n\n\u2022 All inclusive\n\n\u2022 Cater for children of all ages\n\n\u2022 4 or 5 star hotel\n\n\u2022 Opportunity to explore local area\n\n\u2022 Scuba diving, paragliding\n\n\u2022 Beach wedding location\n\n\u2022 soft sand beach\n\n\u2022 Family rooms that sleep upto 5\n\n\nReasonable price, Beaches is far too expensive! \n\n\nAll information, suggestions and ideas greatly appreciated. \n\n\nKind regards\n\nMrsM2be :-)","Attachments":[],"Id":1902835,"PostDate":1439971680,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi! <br><br>\nJust came across this app and I'm hoping all of you wonderful people can help me out? <br><br>\nWe've been engaged for a few years but never got round to getting married due to having children etc However, we have now decided on a destination wedding. We are looking to get married in 2017 which I know seems a long time off but we'll be able to book up in May 2016. <br><br>\nIt's always been a dream of ours to go to the Caribbean so we are looking at Dominican Republic as a possibility. I really like the look of Dreams La Romana. After looking into the cost of the paper work etc it's looking like it's going to be a bit too expensive. Especially as we will only be able to go during the summer school holidays. <br><br>\nI am now considering other destinations such as Greece, Mexico, Italy etc<br><br>\nOur ideal destination would be:<br>\n\u2022 All inclusive<br>\n\u2022 Cater for children of all ages<br>\n\u2022 4 or 5 star hotel<br>\n\u2022 Opportunity to explore local area<br>\n\u2022 Scuba diving, paragliding<br>\n\u2022 Beach wedding location<br>\n\u2022 soft sand beach<br>\n\u2022 Family rooms that sleep upto 5<br><br>\nReasonable price, Beaches is far too expensive! <br><br>\nAll information, suggestions and ideas greatly appreciated. <br><br>\nKind regards<br>\nMrsM2be :-)\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ecushion@hotmail.co.uk","IpAddress":"176.249.218.33","GroupId":39,"GroupName":"Newbie","JoinDate":1439970724,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"littlemiss782","Id":284480,"Name":"littlemiss782","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.17.41.18","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79501,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b6098d30afbdc70919910efd1157562d","RawContent":"First of all congrats!!!  I&#039;m actually getting married at Dreams La Romana July 2016.  Still waiting on a confirmation of date.   I found the price to be not much more than other all inclusive resorts we&#039;ve stayed at.  Depending on where you are coming from will determine airfare price a lot.   However I would suggest Cozumel or the Riveria Maya (playa del Carmen).  I&#039;ve been to both for scuba diving.  - Cozumel is a bit cheaper \n\nGood Luck!! \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1902837,"PostDate":1439972479,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                First of all congrats!!!  I'm actually getting married at Dreams La Romana July 2016.  Still waiting on a confirmation of date.   I found the price to be not much more than other all inclusive resorts we've stayed at.  Depending on where you are coming from will determine airfare price a lot.   However I would suggest Cozumel or the Riveria Maya (playa del Carmen).  I've been to both for scuba diving.  - Cozumel is a bit cheaper <br>\nGood Luck!! <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"megewy@yahoo.com","IpAddress":"99.17.41.18","GroupId":39,"GroupName":"Newbie","JoinDate":1437848879,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"MegLeLy","Id":284131,"Name":"MegLeLy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"176.249.218.33","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79501,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"02d0591daeafc8ca4a12d5ed2c793c4e","RawContent":"Thanks! \n\n\nWe&#039;re from the UK so it&#039;s quite pricey!\n\n\nHow are you finding your planning with the wedding coordinator at Dreams? I&#039;ve read quite a lot of good reviews about Dreams. \n\n\nI&#039;ll have a look at those hotels thanks.","Attachments":[],"Id":1902839,"PostDate":1439978262,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks! <br><br>\nWe're from the UK so it's quite pricey!<br><br>\nHow are you finding your planning with the wedding coordinator at Dreams? I've read quite a lot of good reviews about Dreams. <br><br>\nI'll have a look at those hotels thanks. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ecushion@hotmail.co.uk","IpAddress":"176.249.218.33","GroupId":39,"GroupName":"Newbie","JoinDate":1439970724,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"littlemiss782","Id":284480,"Name":"littlemiss782","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.106.199.181","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79501,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d711ccf43c87402a8fa38ae64439f134","RawContent":"&lt;p&gt;I realize this suggestion isn&#039;t in your dream locations, but Riveria Maya offers everything you&#039;re looking for. &amp;nbsp;Email Elizabeth \"Cookie\" Randall, she will take great care of you:&amp;nbsp;erandall@destinationweddings.com. &amp;nbsp;We chose El Karisma Resorts, visited in Nov 2014 and were blown away.&lt;\/p&gt;","Attachments":[],"Id":1902885,"PostDate":1439993197,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I realize this suggestion isn't in your dream locations, but Riveria Maya offers everything you're looking for. \u00a0Email Elizabeth \"Cookie\" Randall, she will take great care of you:\u00a0erandall@destinationweddings.com. \u00a0We chose El Karisma Resorts, visited in Nov 2014 and were blown away.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#000080;\"><span style=\"font-size:14px;\"><span style=\"font-family:'lucida sans unicode', 'lucida grande', sans-serif;\">Cheers ~<\/span><\/span><\/span><\/p>\n<p><span style=\"color:#000080;\"><span style=\"font-size:14px;\"><span style=\"font-family:'lucida sans unicode', 'lucida grande', sans-serif;\">Erica Bazow-To-Be<\/span><\/span><\/span> <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wub.png' class='bbc_emoticon' alt=':wub:' \/>","Email":"eselek@gmail.com","IpAddress":"71.114.107.100","GroupId":39,"GroupName":"Newbie","JoinDate":1424981922,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282263.jpg?_r=1424997199","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"ericalbazow1023","Id":282263,"Name":"ericalbazow1023","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"142.161.170.48","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79501,"EditedBy":"<strong>Edited by Moments That Matter, 19 August 2015 - 02:09 PM.<\/strong>","EditDate":1439993379,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"4b2f10656fd5d58b1c3797182812e71b","RawContent":"&lt;p&gt;Welcome to our forum community littlemiss782 and Congrats on your upcoming destination wedding and growing family!!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Here are some magnificent Mayan RIviera backdrops to some beautiful beach weddings here, to show you what that looks like......taken from our &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10150695320839487.414941.18683524486&amp;amp;type=3&#039;&gt;Cover Photos Album: &lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xfp1\/t31.0-8\/10264266_10152377393459487_387743739374526349_o.jpg\" alt=\"10264266_10152377393459487_3877437393745\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xpf1\/t31.0-8\/1618120_10152265848279487_1607472971_o.jpg\" alt=\"1618120_10152265848279487_1607472971_o.j\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xpa1\/t31.0-8\/615088_10151024856649487_30798431_o.jpg\" alt=\"615088_10151024856649487_30798431_o.jpg\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Wishing you happy research, and all the best with your plans - cheers!!! team mtm :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xfp1\/t31.0-8\/10011771_10153394820954487_6084692057556613630_o.jpg\" alt=\"10011771_10153394820954487_6084692057556\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xpa1\/t31.0-8\/1421132_10151930924629487_63256858_o.jpg\" alt=\"1421132_10151930924629487_63256858_o.jpg\"&gt;&lt;\/p&gt;","Attachments":[],"Id":1902886,"PostDate":1439993290,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome to our forum community littlemiss782 and Congrats on your upcoming destination wedding and growing family!!!<\/p>\n<p>\u00a0<\/p>\n<p>Here are some magnificent Mayan RIviera backdrops to some beautiful beach weddings here, to show you what that looks like......taken from our <a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10150695320839487.414941.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>Cover Photos Album: <\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xfp1\/t31.0-8\/10264266_10152377393459487_387743739374526349_o.jpg\" alt=\"10264266_10152377393459487_3877437393745\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xpf1\/t31.0-8\/1618120_10152265848279487_1607472971_o.jpg\" alt=\"1618120_10152265848279487_1607472971_o.j\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xpa1\/t31.0-8\/615088_10151024856649487_30798431_o.jpg\" alt=\"615088_10151024856649487_30798431_o.jpg\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>Wishing you happy research, and all the best with your plans - cheers!!! team mtm <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xfp1\/t31.0-8\/10011771_10153394820954487_6084692057556613630_o.jpg\" alt=\"10011771_10153394820954487_6084692057556\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-ord1-1.xx.fbcdn.net\/hphotos-xpa1\/t31.0-8\/1421132_10151930924629487_63256858_o.jpg\" alt=\"1421132_10151930924629487_63256858_o.jpg\"><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280196260,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.17.41.18","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79501,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b2f8fe7ef415689f6d1cfd987bdf46e5","RawContent":"@[member=\"littlemiss782\"] \n\nJust starting out so not sure yet.  My travel agent has been sort of the middle man so far on getting group rate prices and dates (still waiting - been a week).  \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1902934,"PostDate":1440015211,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"284480\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/284480-littlemiss782\/' title='Member profile'><span itemprop=\"name\">littlemiss782<\/span><\/a> <br>\nJust starting out so not sure yet.  My travel agent has been sort of the middle man so far on getting group rate prices and dates (still waiting - been a week).  <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"megewy@yahoo.com","IpAddress":"99.17.41.18","GroupId":39,"GroupName":"Newbie","JoinDate":1437848879,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"MegLeLy","Id":284131,"Name":"MegLeLy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.85.127.174","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79501,"EditedBy":"<strong>Edited by vancouverpetunia, 20 August 2015 - 01:56 AM.<\/strong>","EditDate":1440035786,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"39e85b1c9a589b2024fbebd10c02d56e","RawContent":"&lt;p&gt;My dream would be to get married in Italy or Greece! But just not feasible from the West Coast of Canada&amp;nbsp; :( A lot of people say that Cancun\/Riviera Maya is more reasonably priced than other Caribbean destinations, but I&#039;m afraid I have not compared. Have you looked at Cuba? It tends to be a lot cheaper from Canada, and if you have no American guests, it&#039;s not an issue \"politically\". But I haven&#039;t been to Cuba myself, so can&#039;t comment. I&#039;m sure you will find something that suits you perfectly, but it can take time and perseverance! (Note that it seems like people find Jamaica to be more expensive.)&lt;\/p&gt;","Attachments":[],"Id":1902949,"PostDate":1440035740,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>My dream would be to get married in Italy or Greece! But just not feasible from the West Coast of Canada\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/sad.png' class='bbc_emoticon' alt=':(' \/> A lot of people say that Cancun\/Riviera Maya is more reasonably priced than other Caribbean destinations, but I'm afraid I have not compared. Have you looked at Cuba? It tends to be a lot cheaper from Canada, and if you have no American guests, it's not an issue \"politically\". But I haven't been to Cuba myself, so can't comment. I'm sure you will find something that suits you perfectly, but it can take time and perseverance! (Note that it seems like people find Jamaica to be more expensive.)<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>- Erin<\/p>\n<p>\u00a0<\/p>\n<p>My planning thread:\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268'>http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268<\/a>","Email":"ekjzwedding@gmail.com","IpAddress":"24.85.127.174","GroupId":40,"GroupName":"Jr. Member","JoinDate":1417435045,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281283.jpg?_r=1428779369","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"vancouverpetunia","Id":281283,"Name":"vancouverpetunia","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"176.249.218.33","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79501,"EditedBy":"<strong>Edited by littlemiss782, Today, 04:20 AM.<\/strong>","EditDate":1440217209,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"54fa58164039662c03d4aac23b52433c","RawContent":"I&#039;m from the UK and we&#039;ve always wanted to go to the Caribbean. I have had a look at some hotels in Cancun and I&#039;m impressed. All of  our guests will be from the UK.","Attachments":[],"Id":1903097,"PostDate":1440217131,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm from the UK and we've always wanted to go to the Caribbean. I have had a look at some hotels in Cancun and I'm impressed. All of  our guests will be from the UK.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ecushion@hotmail.co.uk","IpAddress":"176.249.218.33","GroupId":39,"GroupName":"Newbie","JoinDate":1439970724,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"littlemiss782","Id":284480,"Name":"littlemiss782","IsOnline":false}}],"Id":"79501","Title":"Planning My Dw And Need Some Destination Suggestions!","LastPostDate":1440217131},"Pages":{"TotalItems":8,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
