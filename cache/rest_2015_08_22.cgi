{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e925b01dce802f32c3f32f156018bc1f","RawContent":"Here&#039;s my engagement ring, it&#039;s a 3.5 carat princess cut in platinum, I love it!\n \n &lt;img src=\"http:\/\/im1.shutterfly.com\/procserv\/47b6ce23b3127cce8d364092dde900000016100Abs3LRi1as2KA\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;","Attachments":[],"Id":11490,"PostDate":1165996147,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Here's my engagement ring, it's a 3.5 carat princess cut in platinum, I love it!<br \/> <br \/> <a href='http:\/\/im1.shutterfly.com\/procserv\/47b6ce23b3127cce8d364092dde900000016100Abs3LRi1as2KA' class='bbc_url' title='External link' rel='nofollow external'><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/im1.shutterfly.com\/procserv\/47b6ce23b3127cce8d364092dde900000016100Abs3LRi1as2KA\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><\/a>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"doyouloveit12@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1165992742,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206966.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"DoYouLoveIt?","Id":206966,"Name":"DoYouLoveIt?","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"487495587d9208632052674fa11dc0ce","RawContent":"Here is mine!!\n \n &lt;img src=\"http:\/\/bestdestinationwedding.com\/forum\/imagehosting\/thum_3034580263095cfe.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;&lt;\/a&gt;","Attachments":[],"Id":11513,"PostDate":1166029915,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Here is mine!!<br \/> <br \/> <a href='http:\/\/bestdestinationwedding.com\/forum\/vbimghost.php?do=displayimg&imgid=440' class='bbc_url' title='External link' rel='nofollow external'><a href=\"http:\/\/bestdestinationwedding.com\/forum\/imagehosting\/thum_3034580263095cfe.jpg\" rel=\"lytebox[posts]\"><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bestdestinationwedding.com\/forum\/imagehosting\/thum_3034580263095cfe.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><\/a><\/a>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"valerieveen@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1155319920,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206781.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"VALERIE","Id":206781,"Name":"VALERIE","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7f8e2a80c6a96b4c705940b43c9992db","RawContent":"&lt;img src=\"http:\/\/bestdestinationwedding.com\/forum\/imagehosting\/79745b0fd1705815.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;&lt;\/a&gt;\n \n That&#039;s mine I think. \n \n As you may have seen on another thread, I wasn&#039;t that excited about it. My FI picked it with his mum&#039;s input rather than mine!\n \n But it&#039;s growing on me, sentimental value and all that. \n \n I just thought it was too busy, pave stones, and side stones, and a center stone, you know?\n My band matches the pave stones, and only goes half way around...","Attachments":[],"Id":18463,"PostDate":1169230710,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <a href='http:\/\/bestdestinationwedding.com\/forum\/vbimghost.php?do=displayimg&imgid=645' class='bbc_url' title='External link' rel='nofollow external'><a href=\"http:\/\/bestdestinationwedding.com\/forum\/imagehosting\/79745b0fd1705815.jpg\" rel=\"lytebox[posts]\"><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bestdestinationwedding.com\/forum\/imagehosting\/79745b0fd1705815.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><\/a><\/a><br \/> <br \/> That's mine I think. <br \/> <br \/> As you may have seen on another thread, I wasn't that excited about it. My FI picked it with his mum's input rather than mine!<br \/> <br \/> But it's growing on me, sentimental value and all that. <br \/> <br \/> I just thought it was too busy, pave stones, and side stones, and a center stone, you know?<br \/> My band matches the pave stones, and only goes half way around...\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Margaret & Eric<\/span><\/div><\/div>","Email":"mhollendoner@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1167243660,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206993.gif?_r=0","PhotoWidth":100,"PhotoHeight":67,"PhotoType":"custom"},"FormattedName":"MagsieMexico","Id":206993,"Name":"MagsieMexico","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a77e0644cecdccd75a046fa0b941cbef","RawContent":"Okay, it&#039;s true, I&#039;m no that into bling, but look at this, with the wedding band, you&#039;ve gotta admit it&#039;s a lot!!! \n \n By the way, Rebecca, your&#039;s is beautiful! More elegant and simple because it&#039;s not as fat and you don&#039;t have the bigger sidestones. You win. :)\n &lt;img src=\"http:\/\/bestdestinationwedding.com\/forum\/imagehosting\/79745b221b82745e.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n &lt;\/a&gt;&lt;img src=\"http:\/\/bestdestinationwedding.com\/forum\/imagehosting\/79745b221c234b81.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;&lt;\/a&gt;\n &lt;img src=\"http:\/\/bestdestinationwedding.com\/forum\/imagehosting\/79745b221d0dbe8f.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;&lt;\/a&gt;","Attachments":[],"Id":18790,"PostDate":1169305574,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Okay, it's true, I'm no that into bling, but look at this, with the wedding band, you've gotta admit it's a lot!!! <br \/> <br \/> By the way, Rebecca, your's is beautiful! More elegant and simple because it's not as fat and you don't have the bigger sidestones. You win. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br \/> <a href='http:\/\/bestdestinationwedding.com\/forum\/vbimghost.php?do=displayimg&imgid=652' class='bbc_url' title='External link' rel='nofollow external'><a href=\"http:\/\/bestdestinationwedding.com\/forum\/imagehosting\/79745b221b82745e.jpg\" rel=\"lytebox[posts]\"><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bestdestinationwedding.com\/forum\/imagehosting\/79745b221b82745e.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><\/a><br \/> <\/a><a href='http:\/\/bestdestinationwedding.com\/forum\/vbimghost.php?do=displayimg&imgid=653' class='bbc_url' title='External link' rel='nofollow external'><a href=\"http:\/\/bestdestinationwedding.com\/forum\/imagehosting\/79745b221c234b81.jpg\" rel=\"lytebox[posts]\"><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bestdestinationwedding.com\/forum\/imagehosting\/79745b221c234b81.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><\/a><\/a><br \/> <a href='http:\/\/bestdestinationwedding.com\/forum\/vbimghost.php?do=displayimg&imgid=654' class='bbc_url' title='External link' rel='nofollow external'><a href=\"http:\/\/bestdestinationwedding.com\/forum\/imagehosting\/79745b221d0dbe8f.jpg\" rel=\"lytebox[posts]\"><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bestdestinationwedding.com\/forum\/imagehosting\/79745b221d0dbe8f.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><\/a><\/a>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Margaret & Eric<\/span><\/div><\/div>","Email":"mhollendoner@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1167243660,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206993.gif?_r=0","PhotoWidth":100,"PhotoHeight":67,"PhotoType":"custom"},"FormattedName":"MagsieMexico","Id":206993,"Name":"MagsieMexico","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d0ba7ccad4e345dbdaf8026e6779ec96","RawContent":"I am stupid! I searched for rings on this site and didn&#039;t find anything, which I thought was weird. So I posted a new thread. Tammy, you can delete that one. Here is my ring.\n &lt;img src=\"http:\/\/i197.photobucket.com\/albums\/aa240\/carlymcmullen\/BDW%20Photos%20for%20Others\/lrushring.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n Lauren&lt;p&gt;&amp;nbsp;&lt;\/p&gt;&lt;span huddler_attributes=\"{&amp;quot;plugin&amp;quot;:&amp;quot;attachment&amp;quot;,&amp;quot;params&amp;quot;:{&amp;quot;id&amp;quot;:&amp;quot;3849&amp;quot;,&amp;quot;name&amp;quot;:&amp;quot;Oh La La!!!!.ppt&amp;quot;,&amp;quot;description&amp;quot;:&amp;quot;&amp;quot;,&amp;quot;size&amp;quot;:51.5,&amp;quot;type&amp;quot;:&amp;quot;ppt&amp;quot;}}\" huddler_plugin=\"attachment\"&gt;&amp;nbsp;&lt;\/span&gt;","Attachments":[],"Id":20137,"PostDate":1169673801,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I am stupid! I searched for rings on this site and didn't find anything, which I thought was weird. So I posted a new thread. Tammy, you can delete that one. Here is my ring.<br \/> <a href='http:\/\/i197.photobucket.com\/albums\/aa240\/carlymcmullen\/BDW%20Photos%20for%20Others\/lrushring.jpg' class='bbc_url' title='External link' rel='nofollow external'><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i197.photobucket.com\/albums\/aa240\/carlymcmullen\/BDW%20Photos%20for%20Others\/lrushring.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><\/a><br \/> Lauren<p>\u00a0<\/p><span huddler_attributes=\"{\"plugin\":\"attachment\",\"params\":{\"id\":\"3849\",\"name\":\"Oh La La!!!!.ppt\",\"description\":\"\",\"size\":51.5,\"type\":\"ppt\"}}\" huddler_plugin=\"attachment\">\u00a0<\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lauren.c.rush@nasa.gov","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1157121693,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206790.gif?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"LRUSH","Id":206790,"Name":"LRUSH","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"907aa1cbc01b833844e5541691f572e6","RawContent":"&lt;img src=\"http:\/\/bestdestinationwedding.com\/forum\/imagehosting\/58445c2a4ad3b6a0.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;&lt;\/a&gt;&lt;img src=\"http:\/\/bestdestinationwedding.com\/forum\/imagehosting\/58445c2a468a98d8.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;&lt;\/a&gt;\n \n I still really love the asscher cut but we couldnt really find two side stones (other than two small asscher&#039;s) that went well with the diamond. And although the cut is beautiful, it doesnt sparkle as much as the cushion.","Attachments":[],"Id":22945,"PostDate":1170387750,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <a href='http:\/\/bestdestinationwedding.com\/forum\/vbimghost.php?do=displayimg&imgid=736' class='bbc_url' title='External link' rel='nofollow external'><a href=\"http:\/\/bestdestinationwedding.com\/forum\/imagehosting\/58445c2a4ad3b6a0.jpg\" rel=\"lytebox[posts]\"><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bestdestinationwedding.com\/forum\/imagehosting\/58445c2a4ad3b6a0.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><\/a><\/a><a href='http:\/\/bestdestinationwedding.com\/forum\/vbimghost.php?do=displayimg&imgid=735' class='bbc_url' title='External link' rel='nofollow external'><a href=\"http:\/\/bestdestinationwedding.com\/forum\/imagehosting\/58445c2a468a98d8.jpg\" rel=\"lytebox[posts]\"><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bestdestinationwedding.com\/forum\/imagehosting\/58445c2a468a98d8.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><\/a><\/a><br \/> <br \/> I still really love the asscher cut but we couldnt really find two side stones (other than two small asscher's) that went well with the diamond. And although the cut is beautiful, it doesnt sparkle as much as the cushion.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"Photo by <a class='bbc_url' href='http:\/\/www.monicamartinphotography.com\/blog'>www.monicamartinphotography.com\/blog<\/a><br \/>\n<a class='bbc_url' href='http:\/\/bestdestinationwedding.com\/forum\/f128\/amyhs-planning-galore-24132\/index10.html'>Planning Pics!<\/a> <a class='bbc_url' href='http:\/\/bestdestinationwedding.com\/forum\/f77\/amyhs-puerto-vallarta-wedding-more-review-works-25255\/index4.html'>PV and Wedding Review<\/a><strong class='bbc'><a class='bbc_url' href='http:\/\/picasaweb.google.com\/amyhmartin\/ProfessionalWeddingPictures?authkey=w0DgS3ao1sI#'>Pro Pics (1)<\/a>; <a class='bbc_url' href='http:\/\/picasaweb.google.com\/amyhmartin\/ProfessionalWeddingPictures2?authkey=vbG3xUMVk1s#'>Pro Pics (2)<\/a><\/strong> <strong class='bbc'>By Nataly Lemus Photography and Rodolfo Arpia Photography<\/strong> <a class='bbc_url' href='http:\/\/natalylemusphoto.blogspot.com\/2008\/07\/amy-hanssel-married.html'>Teaser Pro Pics from Nataly Lemus Photogaphy<\/a><a class='bbc_url' href='http:\/\/www.arpiaphotoblog.com\/2008\/07\/puerto-vallarta-destination-wedding_3102.html'>Teaser Pro Pics from Rodolfo Arpia Photography<\/a>","Email":"amyhmartin@gmail.com","IpAddress":"98.119.192.139","GroupId":46,"GroupName":"VIP Member","JoinDate":1162157640,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206875.jpg?_r=0","PhotoWidth":200,"PhotoHeight":285,"PhotoType":"custom"},"FormattedName":"amyh","Id":206875,"Name":"amyh","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"53a9dbbaba76bf9d1cae65074d60178c","RawContent":"Mine!\n \n &lt;img src=\"http:\/\/i10.photobucket.com\/albums\/a113\/KELDY22\/DSC00981.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;&lt;img src=\"http:\/\/i10.photobucket.com\/albums\/a113\/KELDY22\/DSC00982.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n Attempt at being artsy:\n &lt;img src=\"http:\/\/i10.photobucket.com\/albums\/a113\/KELDY22\/ring.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;","Attachments":[],"Id":23773,"PostDate":1170716973,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Mine!<br \/> <br \/> <a href='http:\/\/i10.photobucket.com\/albums\/a113\/KELDY22\/DSC00981.jpg' class='bbc_url' title='External link' rel='nofollow external'><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i10.photobucket.com\/albums\/a113\/KELDY22\/DSC00981.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><\/a><a href='http:\/\/i10.photobucket.com\/albums\/a113\/KELDY22\/DSC00982.jpg' class='bbc_url' title='External link' rel='nofollow external'><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i10.photobucket.com\/albums\/a113\/KELDY22\/DSC00982.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><\/a><br \/> <br \/> Attempt at being artsy:<br \/> <a href='http:\/\/i10.photobucket.com\/albums\/a113\/KELDY22\/ring.jpg' class='bbc_url' title='External link' rel='nofollow external'><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i10.photobucket.com\/albums\/a113\/KELDY22\/ring.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><\/a>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i10.photobucket.com\/albums\/a113\/KELDY22\/656.jpg\">http:\/\/i10.photobucket.com\/albums\/a113\/KELDY22\/656.jpg<\/a><\/div><\/div>","Email":"Keldy22@comcast.net","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1168522342,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207052.gif?_r=0","PhotoWidth":100,"PhotoHeight":67,"PhotoType":"custom"},"FormattedName":"KellyandMatt08","Id":207052,"Name":"KellyandMatt08","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3e9ae1990b0dcbdeff20419ed8a2d96c","RawContent":"LondonSam! Another person from London, yay! This forum really is expanding, although I&#039;m very american too, and most of my guests are from the US, I will have about 20 guests from the UK too! :)\n \n As for rings, you can get rings like that in the UK!! I&#039;ve been looking because as many of you know, I don&#039;t like my rings very much, I posted them here earlier... this is the ring that I want though. &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/sad.gif\" border=\"0\" alt=\"\" title=\"Sad\" class=\"inlineimg\" \/&gt;\n \n Maybe, like someone else was saying earlier, I should just suck it up and get the ring I want... For those of you that haven&#039;t seen, this is the ring I have:\n &lt;img src=\"http:\/\/bestdestinationwedding.com\/forum\/imagehosting\/79745c855aceb1bb.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;&lt;\/a&gt;","Attachments":[],"Id":23843,"PostDate":1170760649,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                LondonSam! Another person from London, yay! This forum really is expanding, although I'm very american too, and most of my guests are from the US, I will have about 20 guests from the UK too! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br \/> <br \/> As for rings, you can get rings like that in the UK!! I've been looking because as many of you know, I don't like my rings very much, I posted them here earlier... this is the ring that I want though. <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/sad.gif\" border=\"0\" alt=\"\" title=\"Sad\" class=\"inlineimg\" \/><\/span><br \/> <br \/> Maybe, like someone else was saying earlier, I should just suck it up and get the ring I want... For those of you that haven't seen, this is the ring I have:<br \/> <a href='http:\/\/bestdestinationwedding.com\/forum\/vbimghost.php?do=displayimg&imgid=759' class='bbc_url' title='External link' rel='nofollow external'><a href=\"http:\/\/bestdestinationwedding.com\/forum\/imagehosting\/79745c855aceb1bb.jpg\" rel=\"lytebox[posts]\"><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bestdestinationwedding.com\/forum\/imagehosting\/79745c855aceb1bb.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><\/a><\/a>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Margaret & Eric<\/span><\/div><\/div>","Email":"mhollendoner@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1167243660,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206993.gif?_r=0","PhotoWidth":100,"PhotoHeight":67,"PhotoType":"custom"},"FormattedName":"MagsieMexico","Id":206993,"Name":"MagsieMexico","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"27e8d1277d97bd34072ba9187b8e1822","RawContent":"Sam - OK, wow $30K budget for a ring?? Can I go shopping with you?? Hahaha.\n \n FI &amp;amp; I finally went to get his finger sized &amp;amp; look at bands yesterday. Yes, I know, we are laggers! We went to the same jeweler that made my e-ring. He &amp;amp; his wife are from Poland and have the greatest little shop in a strip mall - weird. Anyway, my FI of course just wants a very simple comfort fit white gold band - easy. \n \n As for me, I&#039;ve been up in the air over whether I want a simple band or an eternity band, or what. I actually was thinking of a pave set eternity band. Our jeweler is awesome - so honest. He told me the pave was a big no with my e-ring, that it wouldn&#039;t do it justice. He was right - I tried one on &amp;amp; it was blah. He had just made a ring similar to this: &lt;img src=\"http:\/\/www.diamonddoctor.com\/diamond-ring\/TR8022_T.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n I tried it on w\/my ering &amp;amp; suprisingly it looks amazing! Here&#039;s what my ering is like:&lt;img src=\"http:\/\/www.bluenile.com\/assets\/product_images\/rings\/DM49400100_PR_100_200zoom.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n THoughts? I wish I could show you with them right next to eachother....","Attachments":[],"Id":25248,"PostDate":1171221057,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Sam - OK, wow $30K budget for a ring?? Can I go shopping with you?? Hahaha.<br \/> <br \/> FI & I finally went to get his finger sized & look at bands yesterday. Yes, I know, we are laggers! We went to the same jeweler that made my e-ring. He & his wife are from Poland and have the greatest little shop in a strip mall - weird. Anyway, my FI of course just wants a very simple comfort fit white gold band - easy. <br \/> <br \/> As for me, I've been up in the air over whether I want a simple band or an eternity band, or what. I actually was thinking of a pave set eternity band. Our jeweler is awesome - so honest. He told me the pave was a big no with my e-ring, that it wouldn't do it justice. He was right - I tried one on & it was blah. He had just made a ring similar to this: <a href='http:\/\/www.diamonddoctor.com\/diamond-ring\/TR8022_T.jpg' class='bbc_url' title='External link' rel='nofollow external'><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/www.diamonddoctor.com\/diamond-ring\/TR8022_T.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><\/a><br \/> I tried it on w\/my ering & suprisingly it looks amazing! Here's what my ering is like:<a href='http:\/\/www.bluenile.com\/assets\/product_images\/rings\/DM49400100_PR_100_200zoom.jpg' class='bbc_url' title='External link' rel='nofollow external'><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/www.bluenile.com\/assets\/product_images\/rings\/DM49400100_PR_100_200zoom.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><\/a><br \/> <br \/> THoughts? I wish I could show you with them right next to eachother....\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"clb26@yahoo.com","IpAddress":"67.182.138.230","GroupId":46,"GroupName":"VIP Member","JoinDate":1148498640,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"none"},"FormattedName":"A10CalGal","Id":206736,"Name":"A10CalGal","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":254,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4f2c3765fc2c384cbfd11c30025c2fc8","RawContent":"OK, here&#039;s a similar look, only my ering has sidestones and the band has 7 or 9 (can&#039;t remember) stones.\n \n &lt;img src=\"http:\/\/www.bluenile.com\/ap\/rings\/DM15400200_AB15400100_PR_100_100.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;","Attachments":[],"Id":25296,"PostDate":1171238993,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                OK, here's a similar look, only my ering has sidestones and the band has 7 or 9 (can't remember) stones.<br \/> <br \/> <a href='http:\/\/www.bluenile.com\/ap\/rings\/DM15400200_AB15400100_PR_100_100.jpg' class='bbc_url' title='External link' rel='nofollow external'><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/www.bluenile.com\/ap\/rings\/DM15400200_AB15400100_PR_100_100.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><\/a>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"clb26@yahoo.com","IpAddress":"67.182.138.230","GroupId":46,"GroupName":"VIP Member","JoinDate":1148498640,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"none"},"FormattedName":"A10CalGal","Id":206736,"Name":"A10CalGal","IsOnline":false}}],"Pages":{"TotalItems":2108,"TotalPages":211,"CurrentPage":20,"NextPage":30,"PreviousPage":10,"LastPage":2100},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
