ost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75627,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":4,"IsLiked":false,"PostKey":"7b816ee2eb84b5223fe635158c0b0afd","RawContent":"&lt;p&gt;I&#039;m a 2016 bride too! &amp;nbsp;Glad I&#039;m not alone :)&lt;\/p&gt;","Attachments":[],"Id":1816972,"PostDate":1385419881,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I'm a 2016 bride too! \u00a0Glad I'm not alone <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><strong>Melissa McClure Photography<\/strong><br><br><span>Website: <\/span><a data-ipb='nomediaparse' href=\"http:\/\/www.melissamcclure.com\">www.melissamcclure.com<br><\/a><span>Blog: <\/span><a data-ipb='nomediaparse' href=\"http:\/\/www.melissamcclure.net\">www.melissamcclure.net<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/i299.photobucket.com\/albums\/mm313\/melissamcclure\/squareadsmall.jpg\">http:\/\/i299.photobucket.com\/albums\/m...areadsmall.jpg<\/a><\/div><\/div>","Email":"meldell@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1218031225,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211014.jpeg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"MelissaMcClure","Id":211014,"Name":"MelissaMcClure","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75627,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"ca2deecdd6fb41e11cbbc68a3400a29e","RawContent":"&lt;p&gt;You&#039;re in Great company here, Melissa! wishing you all the best with your wedding planning for your Special Day in 2016!!! you have lots of time to research and choose the best plans to fit your dreams.......Enjoy your journey!&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;&lt;img alt=\" \" data-id=\"228185\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/228185\/width\/500\/height\/1000\" \/&gt;&lt;\/p&gt; &lt;p&gt;&lt;img alt=\" \" data-id=\"228186\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/228186\/width\/500\/height\/1000\" \/&gt;&lt;\/p&gt; &lt;p&gt;&lt;img alt=\" \" data-id=\"228187\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/228187\/width\/500\/height\/1000\" \/&gt;&lt;\/p&gt; &lt;p&gt;&lt;img alt=\" \" data-id=\"228188\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/228188\/width\/500\/height\/1000\" \/&gt;&lt;\/p&gt; &lt;p&gt;&lt;img alt=\" \" data-id=\"228189\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/228189\/width\/500\/height\/1000\" \/&gt;&lt;\/p&gt; &lt;p&gt;&lt;img alt=\" \" data-id=\"228190\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/228190\/width\/500\/height\/1000\" \/&gt;&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;Photography Is Forever Studios&amp;nbsp; &lt;img alt=\" \" data-id=\"228191\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/228191\/width\/200\/height\/400\" \/&gt;&lt;\/p&gt;","Attachments":[],"Id":1817141,"PostDate":1385478096,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>You're in Great company here, Melissa! wishing you all the best with your wedding planning for your Special Day in 2016!!! you have lots of time to research and choose the best plans to fit your dreams.......Enjoy your journey!<\/p> <p>\u00a0<\/p> <p><span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"228185\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/228185\/width\/500\/height\/1000\" \/><\/span><\/p> <p><span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"228186\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/228186\/width\/500\/height\/1000\" \/><\/span><\/p> <p><span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"228187\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/228187\/width\/500\/height\/1000\" \/><\/span><\/p> <p><span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"228188\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/228188\/width\/500\/height\/1000\" \/><\/span><\/p> <p><span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"228189\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/228189\/width\/500\/height\/1000\" \/><\/span><\/p> <p><span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"228190\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/228190\/width\/500\/height\/1000\" \/><\/span><\/p> <p>\u00a0<\/p> <p>\u00a0<\/p> <p>Photography Is Forever Studios\u00a0 <span rel='lightbox'><img class='bbc_img' alt=\" \" data-id=\"228191\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/228191\/width\/200\/height\/400\" \/><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"contact@photographyisforever.com","IpAddress":"204.112.154.75","GroupId":44,"GroupName":"Vendor","JoinDate":1372789957,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-271141.png?_r=1386613206","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"photoisforever","Id":271141,"Name":"photoisforever","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.161.201.33","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75627,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"87f66fc6b540405520054efd66176325","RawContent":"&lt;p&gt;Hi everyone :) I&#039;m also a bride of 2016. August 2016 we think :) I&#039;m thinking we will get married at the Moon Palace. I&#039;ve never been there but my fiancee has and LOVED it. I don&#039;t really know where to start... Does anyone know&amp;nbsp;how soon should I reserve my date? Has anyone been there recently?&lt;\/p&gt;","Attachments":[],"Id":1827568,"PostDate":1390229316,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi everyone <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> I'm also a bride of 2016. August 2016 we think <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> I'm thinking we will get married at the Moon Palace. I've never been there but my fiancee has and LOVED it. I don't really know where to start... Does anyone know\u00a0how soon should I reserve my date? Has anyone been there recently?<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"dnyomba@gmail.com","IpAddress":"207.161.66.184","GroupId":40,"GroupName":"Jr. Member","JoinDate":1390094258,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"FutureMrsSam","Id":276191,"Name":"FutureMrsSam","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.231.102.226","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75627,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e757facac9efad64bd7eec65be6b625c","RawContent":"&lt;p&gt;@[member=\"27dress\"] Congratulations! I am not getting married 2016 but rather 2015. We started to rough plan in July 2013 and we just set out our budget and started ordering this. We decided that if we bought things early enough then we wouldn&#039;t be over whelmed with large bills near the end. I find it helps a lot! We officially picked out colors out at the start of January after a few months playing around and looking around. We just ordered our chair sashes and table rubbers.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1827571,"PostDate":1390229697,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@\n\t27dress\n Congratulations! I am not getting married 2016 but rather 2015. We started to rough plan in July 2013 and we just set out our budget and started ordering this. We decided that if we bought things early enough then we wouldn't be over whelmed with large bills near the end. I find it helps a lot! We officially picked out colors out at the start of January after a few months playing around and looking around. We just ordered our chair sashes and table rubbers.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"krisdaversa@yahoo.ca","IpAddress":"70.29.31.208","GroupId":40,"GroupName":"Jr. Member","JoinDate":1382017486,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-274333.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"krisdaversa","Id":274333,"Name":"krisdaversa","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.246.2.51","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75627,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f1cabc4c9bc367f992f6ba45033f462e","RawContent":"Starting early has pros and cons. For me it gave me more opportunities to change my mind...\n\n\nHowever it does give u a lot of time to space out ur costs. Things like bridal party gifts can add up. I knew I wanted to do the personalized hangers n robes for the girls. All things that could b ordered early and set aside for later. \n\n\nBook as soon as u are sure where u wanna be. If budget allows do site visits! \n\n\nGood luck n congrats!","Attachments":[],"Id":1827715,"PostDate":1390291489,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Starting early has pros and cons. For me it gave me more opportunities to change my mind...<br><br>\nHowever it does give u a lot of time to space out ur costs. Things like bridal party gifts can add up. I knew I wanted to do the personalized hangers n robes for the girls. All things that could b ordered early and set aside for later. <br><br>\nBook as soon as u are sure where u wanna be. If budget allows do site visits! <br><br>\nGood luck n congrats!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"talicea7812@gmail.com","IpAddress":"98.114.237.105","GroupId":40,"GroupName":"Jr. Member","JoinDate":1387552954,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275695.jpg?_r=1398892094","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"talicea7812","Id":275695,"Name":"talicea7812","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"69.126.218.189","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75627,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"3f16b5c495acb9a3ef10d00ea034effa","RawContent":"2016 bride here ~ well renewal of vows 10yrs anniversary!! When my husband and I got married we had a civil ceremony and nothing else. In 2016 we will be 10yrs of marriage and I&#039;m finally planning now to have something special for us and the family!! So no your not alone.. Have you picked your place.. I&#039;m undecided with punta cana or another country!! Still searching","Attachments":[],"Id":1830796,"PostDate":1391197661,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                2016 bride here ~ well renewal of vows 10yrs anniversary!! When my husband and I got married we had a civil ceremony and nothing else. In 2016 we will be 10yrs of marriage and I'm finally planning now to have something special for us and the family!! So no your not alone.. Have you picked your place.. I'm undecided with punta cana or another country!! Still searching \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"christine.osoria@gmail.com","IpAddress":"70.208.77.172","GroupId":39,"GroupName":"Newbie","JoinDate":1373905702,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-271565.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"christy531","Id":271565,"Name":"christy531","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"67.175.107.83","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75627,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fe0a5bf343d60a90c32857e41474cabf","RawContent":"&lt;p&gt;Congrats!!!&lt;\/p&gt;","Attachments":[],"Id":1831046,"PostDate":1391266304,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats!!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"a.baio330@gmail.com","IpAddress":"38.104.228.158","GroupId":40,"GroupName":"Jr. Member","JoinDate":1369641857,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-269996.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"amy330","Id":269996,"Name":"amy330","IsOnline":false}}],"Id":"75627","Title":"Any other brides of 2016? Do we need to prepare now? ","LastPostDate":1448895198},"Pages":{"TotalItems":90,"TotalPages":9,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":80},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
