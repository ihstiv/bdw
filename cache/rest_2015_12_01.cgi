{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":12,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":584,"MovedTo":null,"MovedOn":0,"FirstPostId":1907766,"Rating":0,"RatingHits":0,"Starter":{"Id":285359,"Name":"Jessim9","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-285359.jpg?_r=1448235964","PhotoWidth":169,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":false},"StartDate":1448122536,"LastPoster":{"Id":285328,"Name":"rebeccarpeck","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1907979,"PostDate":1448942570,"PostContent":"Congrats on your engagement! I've been doing tons of looking around...have you considered any of...","Author":{"Signature":"","Email":"rebeccarpeck@yahoo.com","IpAddress":"70.194.211.78","GroupId":3,"GroupName":"Member","JoinDate":1447401012,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"rebeccarpeck","Id":285328,"Name":"rebeccarpeck","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.146.146.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79757,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"86e5a463bc66980e7236cb8452ef7181","RawContent":"[quote name=\"perianjay\" post=\"1907840\" timestamp=\"1448379520\"]\n@[member=\"vancouverpetunia\"] Did that resort happen to be in Mayan Riviera? When I was a TA I used to warn anyone going to that area as MR seems to be situated in a cove and I find a lot of resorts in that area have a large seaweed issue.\nWe stayed at Moon Palace and our biggest complaint was the beach. We are huge beach people and we were not able to swim in the water because it was pure seaweed the entire time and so much so that the water was brown.[\/quote]It is. It&#039;s on the airport side of Playa. \nI didn&#039;t find sandos bad. It had a nice long beach and at the time no seaweed. Can&#039;t speak for this year though, that was 2013.     My wedding resort was in a cove forsure but it offered snorkeling like noones business. So depends what you like. I prefer the Cuba beaches hehe\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1907845,"PostDate":1448361859,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>perianjay, on 24 November 2015 - 09:38 AM, said:<\/p><div class='blockquote'><div class='quote'><p>@<a hovercard-ref=\"member\" hovercard-id=\"281283\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281283-vancouverpetunia\/' title='Member profile'><span itemprop=\"name\">vancouverpetunia<\/span><\/a> Did that resort happen to be in Mayan Riviera? When I was a TA I used to warn anyone going to that area as MR seems to be situated in a cove and I find a lot of resorts in that area have a large seaweed issue.<br>\nWe stayed at Moon Palace and our biggest complaint was the beach. We are huge beach people and we were not able to swim in the water because it was pure seaweed the entire time and so much so that the water was brown.<\/p><\/div><\/div>\n<br>\nIt is. It's on the airport side of Playa. <br>\nI didn't find sandos bad. It had a nice long beach and at the time no seaweed. Can't speak for this year though, that was 2013.     My wedding resort was in a cove forsure but it offered snorkeling like noones business. So depends what you like. I prefer the Cuba beaches hehe<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399407002,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.194.250.155","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79757,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"97866530bd370207e0e48c067476ecba","RawContent":"Congrats on your engagement! I&#039;ve been doing tons of looking around...have you considered any of the Riu resorts? There are a couple price points and seem to have some pretty good amentities.  I think I&#039;m sold on Beach Palace, now I&#039;m questioning it, but at least I still have a lot of time! \n\n\nSent from my SM-G900V using Tapatalk","Attachments":[],"Id":1907979,"PostDate":1448942570,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Congrats on your engagement! I've been doing tons of looking around...have you considered any of the Riu resorts? There are a couple price points and seem to have some pretty good amentities.  I think I'm sold on Beach Palace, now I'm questioning it, but at least I still have a lot of time! <br><br>\nSent from my SM-G900V using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rebeccarpeck@yahoo.com","IpAddress":"70.194.211.78","GroupId":3,"GroupName":"Member","JoinDate":1447401012,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"rebeccarpeck","Id":285328,"Name":"rebeccarpeck","IsOnline":false}}],"Id":"79757","Title":"Newbie - Trying To Pick A Resort In Riviera Maya! Help?!","LastPostDate":1448942570},"Pages":{"TotalItems":12,"TotalPages":2,"CurrentPage":10,"NextPage":-1,"PreviousPage":0,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
