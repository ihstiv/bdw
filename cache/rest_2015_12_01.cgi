 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I like coral and nude palette - simple and elegant.<br \/> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Sehausle@gmail.com","IpAddress":"69.132.176.52","GroupId":40,"GroupName":"Jr. Member","JoinDate":1360675076,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265973.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":186,"PhotoType":"custom"},"FormattedName":"Sehausle","Id":265973,"Name":"Sehausle","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":false,"TopicId":67731,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e397d05b5dede3e8cea90ae471c8bcb3","RawContent":"&lt;p&gt; I think &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.bellasdress.com\/coral-dresses-li66102\/\"&gt;coral dresses&lt;\/a&gt; are amazing. I love that color. What&#039;s &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.bellasdress.com\/\"&gt;more&lt;\/a&gt;, it&#039;s not like red so shining, it&#039;s a simple warm color.&lt;img id=\"yui_3_10_0_1_1375839932274_1218\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif\" \/&gt;&lt;\/p&gt;","Attachments":[],"Id":1788016,"PostDate":1375840069,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I think <a href='http:\/\/www.bellasdress.com\/coral-dresses-li66102\/' class='bbc_url' title='External link' rel='nofollow external'>coral dresses<\/a> are amazing. I love that color. What's <a href='http:\/\/www.bellasdress.com\/' class='bbc_url' title='External link' rel='nofollow external'>more<\/a>, it's not like red so shining, it's a simple warm color.<span rel='lightbox'><img class='bbc_img' id=\"yui_3_10_0_1_1375839932274_1218\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif\" \/><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"higraceoreo@inbox.com","IpAddress":"","GroupId":5,"GroupName":"Banned","JoinDate":1374568713,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"graceellex","Id":271822,"Name":"graceellex","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":67731,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bf52267609d43cc748ef082982178418","RawContent":"&lt;p&gt; We are doing coral, turquoise, and lime green. I wanted super bright, cheery colors, although I hope it doesn&#039;t end up looking like a rainbow threw up on my wedding&amp;nbsp;&lt;img id=\"yui_3_10_0_1_1375978322846_1192\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif\" style=\"line-height: 1.231;\" \/&gt;&lt;\/p&gt;","Attachments":[],"Id":1788863,"PostDate":1375978406,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> We are doing coral, turquoise, and lime green. I wanted super bright, cheery colors, although I hope it doesn't end up looking like a rainbow threw up on my wedding\u00a0<span rel='lightbox'><img class='bbc_img' id=\"yui_3_10_0_1_1375978322846_1192\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheesy.gif\" style=\"line-height: 1.231;\" \/><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kasey_98@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1335141477,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-254373.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Kasey04","Id":254373,"Name":"Kasey04","IsOnline":false}}],"Pages":{"TotalItems":27,"TotalPages":3,"CurrentPage":10,"NextPage":20,"PreviousPage":0,"LastPage":20},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
