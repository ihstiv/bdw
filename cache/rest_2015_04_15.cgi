/www.bestdestinationwedding.com\/image\/id\/762702\/width\/600\/height\/514\" \/&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left: 2.25pt\"&gt; &amp;nbsp;&lt;\/p&gt; &lt;p style=\"margin-left: 2.25pt\"&gt; &lt;span style=\"font-size: 12px\"&gt;Premium Dinner Centerpieces $230&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left: 2.25pt\"&gt; &lt;span style=\"font-size: 12px\"&gt;&lt;img alt=\"Now Jade Premium Centerpiece Options.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762704\/width\/600\/height\/419\" \/&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left: 2.25pt\"&gt; &amp;nbsp;&lt;\/p&gt; &lt;p style=\"margin-left: 2.25pt\"&gt; &lt;span style=\"font-size: 12px\"&gt;Ceremony Centerpiece $50&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left: 2.25pt\"&gt; &lt;span style=\"font-size: 12px\"&gt;Columns and Arrangements (2) $180&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left: 2.25pt\"&gt; &lt;span style=\"font-size: 12px\"&gt;Canopy $350&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left: 2.25pt\"&gt; &lt;span style=\"font-size: 12px\"&gt;Flower Wedding Arch $450&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left: 2.25pt\"&gt; &lt;span style=\"font-size: 12px\"&gt;Single Flower $12&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left: 2.25pt\"&gt; &lt;span style=\"font-size: 12px\"&gt;Bag with Petals $15&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left: 2.25pt\"&gt; &lt;span style=\"font-size: 12px\"&gt;Basket with Petals $35&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left: 2.25pt\"&gt; &amp;nbsp;&lt;\/p&gt; &lt;p style=\"margin-left: 2.25pt\"&gt; &lt;span style=\"font-size: 12px\"&gt;&lt;img alt=\"NOW Jade Additional Flower Options.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762707\/width\/600\/height\/640\" \/&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left: 2.25pt\"&gt; &amp;nbsp;&lt;\/p&gt; &lt;p style=\"margin-left: 2.25pt\"&gt; &lt;u&gt;&lt;strong&gt;&lt;span style=\"font-size: 12px\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"color: black\"&gt;&lt;span style=\"font-family: verdana, sans-serif\"&gt;&lt;span style=\"font-family: verdana\"&gt;Optional Outside&amp;nbsp;Florists:&amp;nbsp; &lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;span style=\"font-size: 12px\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"color: black\"&gt;&lt;span style=\"font-family: verdana, sans-serif\"&gt;&lt;span style=\"font-family: verdana\"&gt;$350 vendor fee &lt;strong&gt;IF&lt;\/strong&gt; the florist comes onto the property.&amp;nbsp; You can have someone meet them at the gate for no cost.&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/u&gt;&lt;\/p&gt; &lt;p style=\"margin-left: 2.25pt\"&gt; &lt;span style=\"font-size: 12px\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"color: black\"&gt;&lt;span style=\"font-family: verdana, sans-serif\"&gt;&lt;span style=\"font-family: verdana\"&gt;&lt;strong&gt;Vanessa Jaimes&lt;\/strong&gt; (www.vanessajaimes.com)&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left: 2.25pt\"&gt; &amp;nbsp;&lt;\/p&gt; &lt;p style=\"margin-left: 2.25pt\"&gt; &lt;span style=\"font-size: 12px\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"color: black\"&gt;&lt;span style=\"font-family: verdana, sans-serif\"&gt;&lt;span style=\"font-family: verdana\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span face=\"\"&gt;Juliana - Cancun Florist&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left: 2.25pt\"&gt; &lt;span style=\"font-size: 12px\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"color: black\"&gt;&lt;span style=\"font-family: verdana, sans-serif\"&gt;&lt;span style=\"font-family: verdana\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;span face=\"\"&gt;(998) 884 11 04, 887 17 00&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p style=\"margin-left: 2.25pt\"&gt; &lt;span style=\"font-size: 12px\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"color: black\"&gt;&lt;span style=\"font-family: verdana, sans-serif\"&gt;&lt;span style=\"font-family: verdana\"&gt;&lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"color: blue\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;img alt=\"Bridesmaid Flowers.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762718\/width\/295\/height\/301\" \/&gt;  &amp;nbsp; &lt;img alt=\"Flowers Bridal Included v2.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762720\/width\/333\/height\/500\" \/&gt;  &amp;nbsp; &lt;img alt=\"Flowers Bridal Included.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762722\/width\/335\/height\/480\" \/&gt;&lt;\/p&gt; &lt;p style=\"margin-left: 2.25pt\"&gt; &amp;nbsp;&lt;\/p&gt; &lt;p style=\"margin-left: 2.25pt\"&gt; &lt;strong&gt;Maya Floral&lt;\/strong&gt; - &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.mayafloral.com\/\"&gt;http:\/\/www.mayafloral.com\/&lt;\/a&gt;&lt;\/p&gt; &lt;p style=\"margin-left: 2.25pt\"&gt; &lt;span style=\"font-size: 10pt\"&gt;&lt;span style=\"color: #181818\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Centerpieces with local flowers start at $65.00 usd. The flowers we consider as local flowers because they are very easy to get in Mexico are: Roses, Alstroemerias, Snapdragon, Lisianthus, Asian Lilies, Mums, Gerbera daisy, Chrysantemun and some others. We do not have centerpieces (unless they are cocktail centerpieces) under this price, our average priced centerpieces are $75.00 \/ $80.00 usd, centerpieces that include fine flowers like Orchids, Tulips, etc, start at $85.00 usd&amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1595160,"PostDate":1331759397,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <strong>FLOWERS<\/strong><\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"color: blue\"><span  style=\"font-family: arial, sans-serif\"><span rel='lightbox'><img class='bbc_img' alt=\"NOW Jade Your Moments Bouquet Options.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762676\/width\/600\/height\/506\" \/><\/span><\/span><\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"color: blue\"><span  style=\"font-family: arial, sans-serif\"><span rel='lightbox'><img class='bbc_img' alt=\"NOW Jade Now to Eternity Bouquet Options.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762680\/width\/600\/height\/523\" \/><\/span><\/span><\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"color: blue\"><span  style=\"font-family: arial, sans-serif\"><span rel='lightbox'><img class='bbc_img' alt=\"Now Jade Divine Bouquet Options.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762682\/width\/600\/height\/516\" \/><\/span><\/span><\/span><\/span><\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> <span  style=\"color: #000000\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span face=\"\">Bridesmaid flowers are not part of the package and cost $65 a piece<\/span><\/span><\/span><\/span><\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span face=\"\">Canopy Arrangement above the Pergola $400<\/span><\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 12px\">\u00a0<\/span><\/p> <p  style=\"margin-left: 2.25pt\"> <span  style=\"font-size: 12px\"><strong>FLOWERS <\/strong>(prices plus 11% tax)<\/span><\/p> <p  style=\"margin-left: 2.25pt\"> <span  style=\"font-size: 12px\">Tropical Bride\u00e2\u20ac\u2122s Bouquet Selection $80<\/span><\/p> <p  style=\"margin-left: 2.25pt\"> <span  style=\"font-size: 12px\">Luxury Bride\u00e2\u20ac\u2122s Bouquet $125<\/span><\/p> <p  style=\"margin-left: 2.25pt\"> <span  style=\"font-size: 12px\">Premium Bouquet Selection $350<\/span><\/p> <p  style=\"margin-left: 2.25pt\"> <span  style=\"font-size: 12px\"><span  style=\"font-size: 10pt\"><span  style=\"color: blue\"><span  style=\"font-family: arial, sans-serif\"><span rel='lightbox'><img class='bbc_img' alt=\"Now Jade Premium Bouquet Options.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762684\/width\/600\/height\/529\" \/><\/span><\/span><\/span><\/span><\/span><\/p> <p  style=\"margin-left: 2.25pt\"> \u00a0<\/p> <p  style=\"margin-left: 2.25pt\"> <span  style=\"font-size: 12px\">Bridesmaid\u00e2\u20ac\u2122s Bouquet $65<\/span><\/p> <p  style=\"margin-left: 2.25pt\"> \u00a0<\/p> <p  style=\"margin-left: 2.25pt\"> <span  style=\"font-size: 12px\">Corsages (wrist or shoulder) $35<\/span><\/p> <p  style=\"margin-left: 2.25pt\"> <span  style=\"font-size: 12px\"><span rel='lightbox'><img class='bbc_img' alt=\"Now Jade Corsage Options.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762696\/width\/600\/height\/523\" \/><\/span><\/span><\/p> <p  style=\"margin-left: 2.25pt\"> \u00a0<\/p> <p  style=\"margin-left: 2.25pt\"> <span  style=\"font-size: 12px\">Premium Corsages $55<\/span><\/p> <p  style=\"margin-left: 2.25pt\"> <span  style=\"font-size: 12px\">Boutonniere $20<\/span><\/p> <p  style=\"margin-left: 2.25pt\"> <span  style=\"font-size: 12px\"><span  style=\"font-size: 10pt\"><span  style=\"color: blue\"><span  style=\"font-family: arial, sans-serif\"><span rel='lightbox'><img class='bbc_img' alt=\"Now Jade Boutonnier Options.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762686\/width\/600\/height\/520\" \/><\/span><\/span><\/span><\/span><\/span><\/p> <p  style=\"margin-left: 2.25pt\"> <span  style=\"font-size: 12px\">Premium Boutonniere $45<\/span><\/p> <p  style=\"margin-left: 2.25pt\"> <span  style=\"font-size: 12px\"><span  style=\"font-size: 10pt\"><span  style=\"color: blue\"><span  style=\"font-family: arial, sans-serif\"><span rel='lightbox'><img class='bbc_img' alt=\"Now Jade Premium Boutonnier Options.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762688\/width\/600\/height\/522\" \/><\/span><\/span><\/span><\/span><\/span><\/p> <p  style=\"margin-left: 2.25pt\"> \u00a0<\/p> <p  style=\"margin-left: 2.25pt\"> <span  style=\"font-size: 12px\">Tropical Dinner Centerpieces $65<\/span><\/p> <p  style=\"margin-left: 2.25pt\"> <span  style=\"font-size: 12px\"><span rel='lightbox'><img class='bbc_img' alt=\"Now Jade Eternity Centerpiece Options.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762700\/width\/600\/height\/509\" \/><\/span><\/span><\/p> <p  style=\"margin-left: 2.25pt\"> \u00a0<\/p> <p  style=\"margin-left: 2.25pt\"> \u00a0<\/p> <p  style=\"margin-left: 2.25pt\"> <span  style=\"font-size: 12px\">Luxury Dinner Centerpieces $85<\/span><\/p> <p  style=\"margin-left: 2.25pt\"> <span  style=\"font-size: 12px\"><span rel='lightbox'><img class='bbc_img' alt=\"Now Jade Divine Centerpiece Options.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762702\/width\/600\/height\/514\" \/><\/span><\/span><\/p> <p  style=\"margin-left: 2.25pt\"> \u00a0<\/p> <p  style=\"margin-left: 2.25pt\"> <span  style=\"font-size: 12px\">Premium Dinner Centerpieces $230<\/span><\/p> <p  style=\"margin-left: 2.25pt\"> <span  style=\"font-size: 12px\"><span rel='lightbox'><img class='bbc_img' alt=\"Now Jade Premium Centerpiece Options.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762704\/width\/600\/height\/419\" \/><\/span><\/span><\/p> <p  style=\"margin-left: 2.25pt\"> \u00a0<\/p> <p  style=\"margin-left: 2.25pt\"> <span  style=\"font-size: 12px\">Ceremony Centerpiece $50<\/span><\/p> <p  style=\"margin-left: 2.25pt\"> <span  style=\"font-size: 12px\">Columns and Arrangements (2) $180<\/span><\/p> <p  style=\"margin-left: 2.25pt\"> <span  style=\"font-size: 12px\">Canopy $350<\/span><\/p> <p  style=\"margin-left: 2.25pt\"> <span  style=\"font-size: 12px\">Flower Wedding Arch $450<\/span><\/p> <p  style=\"margin-left: 2.25pt\"> <span  style=\"font-size: 12px\">Single Flower $12<\/span><\/p> <p  style=\"margin-left: 2.25pt\"> <span  style=\"font-size: 12px\">Bag with Petals $15<\/span><\/p> <p  style=\"margin-left: 2.25pt\"> <span  style=\"font-size: 12px\">Basket with Petals $35<\/span><\/p> <p  style=\"margin-left: 2.25pt\"> \u00a0<\/p> <p  style=\"margin-left: 2.25pt\"> <span  style=\"font-size: 12px\"><span rel='lightbox'><img class='bbc_img' alt=\"NOW Jade Additional Flower Options.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762707\/width\/600\/height\/640\" \/><\/span><\/span><\/p> <p  style=\"margin-left: 2.25pt\"> \u00a0<\/p> <p  style=\"margin-left: 2.25pt\"> <u><strong><span  style=\"font-size: 12px\"><span  style=\"font-size: 10pt\"><span  style=\"color: black\"><span  style=\"font-family: verdana, sans-serif\"><span  style=\"font-family: verdana\">Optional Outside\u00a0Florists:\u00a0 <\/span><\/span><\/span><\/span><\/span><\/strong><span  style=\"font-size: 12px\"><span  style=\"font-size: 10pt\"><span  style=\"color: black\"><span  style=\"font-family: verdana, sans-serif\"><span  style=\"font-family: verdana\">$350 vendor fee <strong>IF<\/strong> the florist comes onto the property.\u00a0 You can have someone meet them at the gate for no cost.<\/span><\/span><\/span><\/span><\/span><\/u><\/p> <p  style=\"margin-left: 2.25pt\"> <span  style=\"font-size: 12px\"><span  style=\"font-size: 10pt\"><span  style=\"color: black\"><span  style=\"font-family: verdana, sans-serif\"><span  style=\"font-family: verdana\"><strong>Vanessa Jaimes<\/strong> (www.vanessajaimes.com)<\/span><\/span><\/span><\/span><\/span><\/p> <p  style=\"margin-left: 2.25pt\"> \u00a0<\/p> <p  style=\"margin-left: 2.25pt\"> <span  style=\"font-size: 12px\"><span  style=\"font-size: 10pt\"><span  style=\"color: black\"><span  style=\"font-family: verdana, sans-serif\"><span  style=\"font-family: verdana\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span face=\"\">Juliana - Cancun Florist<\/span><\/span><\/span><\/span><\/span><\/span><\/span><\/span><\/p> <p  style=\"margin-left: 2.25pt\"> <span  style=\"font-size: 12px\"><span  style=\"font-size: 10pt\"><span  style=\"color: black\"><span  style=\"font-family: verdana, sans-serif\"><span  style=\"font-family: verdana\"><span  style=\"font-size: 10pt\"><span  style=\"font-family: arial, sans-serif\"><span face=\"\">(998) 884 11 04, 887 17 00<\/span><\/span><\/span><\/span><\/span><\/span><\/span><\/span><\/p> <p  style=\"margin-left: 2.25pt\"> <span  style=\"font-size: 12px\"><span  style=\"font-size: 10pt\"><span  style=\"color: black\"><span  style=\"font-family: verdana, sans-serif\"><span  style=\"font-family: verdana\"><span  style=\"font-size: 10pt\"><span  style=\"color: blue\"><span  style=\"font-family: arial, sans-serif\"><span rel='lightbox'><img class='bbc_img' alt=\"Bridesmaid Flowers.JPG\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762718\/width\/295\/height\/301\" \/><\/span>\u00a0\u00a0\u00a0 <span rel='lightbox'><img class='bbc_img' alt=\"Flowers Bridal Included v2.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762720\/width\/333\/height\/500\" \/><\/span>\u00a0\u00a0\u00a0 <span rel='lightbox'><img class='bbc_img' alt=\"Flowers Bridal Included.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762722\/width\/335\/height\/480\" \/><\/span><\/p> <p  style=\"margin-left: 2.25pt\"> \u00a0<\/p> <p  style=\"margin-left: 2.25pt\"> <strong>Maya Floral<\/strong> - <a href='http:\/\/www.mayafloral.com\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.mayafloral.com\/<\/a><\/p> <p  style=\"margin-left: 2.25pt\"> <span  style=\"font-size: 10pt\"><span  style=\"color: #181818\"><span  style=\"font-family: arial, sans-serif\">Centerpieces with local flowers start at $65.00 usd. The flowers we consider as local flowers because they are very easy to get in Mexico are: Roses, Alstroemerias, Snapdragon, Lisianthus, Asian Lilies, Mums, Gerbera daisy, Chrysantemun and some others. We do not have centerpieces (unless they are cocktail centerpieces) under this price, our average priced centerpieces are $75.00 \/ $80.00 usd, centerpieces that include fine flowers like Orchids, Tulips, etc, start at $85.00 usd\u00a0<\/span><\/span><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"~Trisha~<br \/>\n<a class='bbc_url' href='http:\/\/www.faberphotography.com'>www.faberphotography.com<\/a><br \/>\n<br \/>\nMy latest destination wedding photos can be found <a class='bbc_url' href='http:\/\/faberphotography.com\/destination-wedding\/'>HERE<\/a>","Email":"tfaber@wbmi.com","IpAddress":"12.24.226.126","GroupId":46,"GroupName":"VIP Member","JoinDate":1171995300,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207201.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"Tlseege","Id":207201,"Name":"Tlseege","IsOnline":false}}],"Pages":{"TotalItems":5178,"TotalPages":518,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":5170},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
