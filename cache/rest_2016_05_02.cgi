div>\u00a0<\/div>\n<p>My planning thread:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/<\/a><\/p>\n<p>My review thread: \u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/<\/a>","Email":"rebecca.valero@gmail.com","IpAddress":"38.112.94.76","GroupId":3,"GroupName":"Member","JoinDate":1396968452,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277519.jpg?_r=1439827749","PhotoWidth":200,"PhotoHeight":132,"PhotoType":"custom"},"FormattedName":"veryvalentine","Id":277519,"Name":"veryvalentine","IsOnline":false}},"Posts":[],"Id":"78801","Title":"Veryvalero's Wedding Planning Thread - Grand Sunset Princess","LastPostDate":1453224661},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":15,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":1447,"MovedTo":null,"MovedOn":0,"FirstPostId":1894241,"Rating":0,"RatingHits":0,"Starter":{"Id":277519,"Name":"veryvalentine","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277519.jpg?_r=1439827749","PhotoWidth":200,"PhotoHeight":132,"PhotoType":"custom"},"IsOnline":false},"StartDate":1429881925,"LastPoster":{"Id":281055,"Name":"snswedding2016","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281055.jpg?_r=1455040720","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":60,"Preview":{"Id":1895558,"PostDate":1430928927,"PostContent":"@veryvalentine not that my fiance and I were planning on doing it after but I'm so glad you poste...","Author":{"Signature":"<p>My planning thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78916-snswedding2016-planning-thread-jan-9-2016-azul-fives\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78916-snswedding2016-planning-thread-jan-9-2016-azul-fives\/<\/a><\/p>\n<p>\u00a0<\/p>\n<div><a class='bbc_url' href='http:\/\/www.TickerFactory.com\/'><\/div>\n<div><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10730;0\/st\/20160109\/e\/Our+Wedding\/k\/9fa9\/event.png\" alt=\"event.png\"><\/div>\n<div><\/a><\/div>\n","Email":"sean.n.steph2016@gmail.com","IpAddress":"74.12.52.42","GroupId":3,"GroupName":"Member","JoinDate":1415533111,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281055.jpg?_r=1455040720","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"snswedding2016","Id":281055,"Name":"snswedding2016","IsOnline":false}},"Posts":[],"Id":"79110","Title":"Civil Ceremony City Hall (Ontario Brides)","LastPostDate":1430928927},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":387,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":170370,"MovedTo":null,"MovedOn":0,"FirstPostId":313067,"Rating":0,"RatingHits":0,"Starter":{"Id":208310,"Name":"aeroo","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208310.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"IsOnline":false},"StartDate":1211487471,"LastPoster":{"Id":281613,"Name":"SchroederWedding2015","Photo":{"HasPhoto":t