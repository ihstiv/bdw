{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":18,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":true,"Views":1992,"MovedTo":null,"MovedOn":0,"FirstPostId":1910389,"Rating":0,"RatingHits":0,"Starter":{"Id":281478,"Name":"perianjay","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1453235488","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"StartDate":1454361345,"LastPoster":{"Id":281478,"Name":"perianjay","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1453235488","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":98,"Preview":{"Id":1910389,"PostDate":1454361345,"PostContent":"Hello brides! \u00a0 It's been almost two months now and i've finally had a chance to sort through all...","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419419814,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1453235488","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.112.190.39","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79914,"EditedBy":"<strong>Edited by perianjay, 01 February 2016 - 09:19 PM.<\/strong>","EditDate":1454361580,"EditReason":"","DeleteDate":0,"TotalLikes":3,"IsLiked":false,"PostKey":"8081dc0e73da75eca1087ee57c691b10","RawContent":"&lt;p&gt;Hello brides!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;It&#039;s been almost two months now and i&#039;ve finally had a chance to sort through all of my wedding items.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;ve got quite a bit that i&#039;m looking to sell and was hoping to sell some of the more breakable items locally (GTA area) if possible.&lt;\/p&gt;\n&lt;p&gt;I am willing to ship at the cost of the buyer.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I may have some leftover items for OOT bags as well, but I haven&#039;t unpacked those just yet.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;12 gold mercury glass votive holders $15&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;Three large mason jars - Painted and distressed $10 (gray and mint)&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;&#039;hob nob&#039; textured vases - One white mason and two clear glass. $15 for all three&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;Mint\/gold mercury large votive holders $8 for both&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;very light blue (almost clear) textured votive holders $8 for all three&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;Three silver glass textured votives $10 for all three&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;FRAMES $20 for the lot of 5 (or $15 for the white and teal and $6 for the three in the second photo)&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;Table numbers (spray painted gold with custom number print outs) $8 for all 4&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;Paper LED lanterns unopened 4 for $4 (these were great to use for rehearsal\/welcome dinners)&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;Wooden Chalkboard $10&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;Chalkboard Mr &amp;amp; Mrs chair signs $20&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;Black men&#039;s suspenders (ordered from Grunion Run - opened, but never worn) $10&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;38 tea lights - $20 (most of them weren&#039;t used at all. The one&#039;s that were used were only used for 6 hours)&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;1 blush taffeta table drape (rectangle) 90\" x 156\" - Professionally dry cleaned &amp;nbsp;$15&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;3 blush taffeta tabe cloths (circular) 132\" - Professionally dry cleaned &amp;nbsp;$50 for all 3&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;1 black and white striped table runner (used for head table) - professionally dry cleaned 16\" wide x 156\" long $15&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;Bride robe - Size M\/L - Never worn (tags still attached) $15&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;Gold Sequins bridal hanger - $10&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;Card box (Paris) $10 - around 20 &#039;advice for the bride and groom&#039; cards included&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;7 packs of straws (each has 20 straws in it) -$15&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;One layer tulle Ivory veil with a satin edge finish - Never worn $15 &lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;&lt;span style=\"margin:0px;\"&gt;White Single Tier 54\" Width 38\" Length Satin Ribbon Edge&lt;\/span&gt;&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"margin:0px;\"&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;Flower crown - Custom made with silk florals off of Etsy (worn once for bachelorette)- $20&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;","Attachments":[{"Id":35011,"Name":"20160201_194909.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-54676600-1454377245.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-54676600-1454377245_thumb.jpg","Width":675,"Height":1200}],"Id":1910389,"PostDate":1454361345,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello brides!<\/p>\n<p>\u00a0<\/p>\n<p>It's been almost two months now and i've finally had a chance to sort through all of my wedding items.<\/p>\n<p>\u00a0<\/p>\n<p>I've got quite a bit that i'm looking to sell and was hoping to sell some of the more breakable items locally (GTA area) if possible.<\/p>\n<p>I am willing to ship at the cost of the buyer.<\/p>\n<p>\u00a0<\/p>\n<p>I may have some leftover items for OOT bags as well, but I haven't unpacked those just yet.<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><strong>12 gold mercury glass votive holders $15<\/strong><\/p>\n<p><a class='resized_img' rel='lightbox[1910389]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-77487300-1454376915.jpg\" title=\"Facetune-201502081035077640.jpg - Size: 84.74KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-77487300-1454376915.jpg\" class='bbc_img linked-image' alt=\"Facetune-201502081035077640.jpg\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><strong>Three large mason jars - Painted and distressed $10 (gray and mint)<\/strong><\/p>\n<p><a class='resized_img' rel='lightbox[1910389]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-43009400-1454376953.jpg\" title=\"20160201_193105.jpg - Size: 109.74KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-43009400-1454376953.jpg\" class='bbc_img linked-image' alt=\"20160201_193105.jpg\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><strong>'hob nob' textured vases - One white mason and two clear glass. $15 for all three<\/strong><\/p>\n<p><a class='resized_img' rel='lightbox[1910389]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-43434800-1454376980.jpg\" title=\"20160201_194048.jpg - Size: 173.46KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-43434800-1454376980.jpg\" class='bbc_img linked-image' alt=\"20160201_194048.jpg\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><strong>Mint\/gold mercury large votive holders $8 for both<\/strong><\/p>\n<p><a class='resized_img' rel='lightbox[1910389]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-20107700-1454377031.jpg\" title=\"20160201_194134.jpg - Size: 178.46KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-20107700-1454377031.jpg\" class='bbc_img linked-image' alt=\"20160201_194134.jpg\" \/><\/a>\n\n<a class='resized_img' rel='lightbox[1910389]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-75596400-1454377080.jpg\" title=\"20160201_194139.jpg - Size: 161.16KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-75596400-1454377080.jpg\" class='bbc_img linked-image' alt=\"20160201_194139.jpg\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n<p><strong>very light blue (almost clear) textured votive holders $8 for all three<\/strong><\/p>\n<p><a class='resized_img' rel='lightbox[1910389]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-66595700-1454377106.jpg\" title=\"20160201_194207.jpg - Size: 170.89KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-66595700-1454377106.jpg\" class='bbc_img linked-image' alt=\"20160201_194207.jpg\" \/><\/a>\n\n<a class='resized_img' rel='lightbox[1910389]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-37169800-1454377161.jpg\" title=\"20160201_194217.jpg - Size: 51.36KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-37169800-1454377161.jpg\" class='bbc_img linked-image' alt=\"20160201_194217.jpg\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><strong>Three silver glass textured votives $10 for all three<\/strong><\/p>\n<p><a class='resized_img' rel='lightbox[1910389]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-84914900-1454377193.jpg\" title=\"20160201_194819.jpg - Size: 142.23KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-84914900-1454377193.jpg\" class='bbc_img linked-image' alt=\"20160201_194819.jpg\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><strong>FRAMES $20 for the lot of 5 (or $15 for the white and teal and $6 for the three in the second photo)<\/strong><\/p>\n<p><a class='resized_img' rel='lightbox[1910389]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-43060100-1454377300.jpg\" title=\"20160201_193015.jpg - Size: 108.33KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-43060100-1454377300.jpg\" class='bbc_img linked-image' alt=\"20160201_193015.jpg\" \/><\/a>\n\n<a class='resized_img' rel='lightbox[1910389]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-63812500-1454377311.jpg\" title=\"20160201_194909.jpg - Size: 129.56KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-63812500-1454377311.jpg\" class='bbc_img linked-image' alt=\"20160201_194909.jpg\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n<p><strong>Table numbers (spray painted gold with custom number print outs) $8 for all 4<\/strong><\/p>\n<p><a class='resized_img' rel='lightbox[1910389]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-71573500-1454377365.jpg\" title=\"20160201_193525.jpg - Size: 123.79KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-71573500-1454377365.jpg\" class='bbc_img linked-image' alt=\"20160201_193525.jpg\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n<p><strong>Paper LED lanterns unopened 4 for $4 (these were great to use for rehearsal\/welcome dinners)<\/strong><\/p>\n<p><a class='resized_img' rel='lightbox[1910389]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-99175000-1454377402.jpg\" title=\"20160201_193233.jpg - Size: 104.95KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-99175000-1454377402.jpg\" class='bbc_img linked-image' alt=\"20160201_193233.jpg\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n<p><strong>Wooden Chalkboard $10<\/strong><\/p>\n<p><a class='resized_img' rel='lightbox[1910389]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-64881600-1454377444.jpg\" title=\"20160201_192955.jpg - Size: 69.18KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-64881600-1454377444.jpg\" class='bbc_img linked-image' alt=\"20160201_192955.jpg\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n<p><strong>Chalkboard Mr & Mrs chair signs $20<\/strong><\/p>\n<p><a class='resized_img' rel='lightbox[1910389]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-44068800-1454377503.jpg\" title=\"20160201_193127.jpg - Size: 106.36KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-44068800-1454377503.jpg\" class='bbc_img linked-image' alt=\"20160201_193127.jpg\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><strong>Black men's suspenders (ordered from Grunion Run - opened, but never worn) $10<\/strong><\/p>\n<p><a class='resized_img' rel='lightbox[1910389]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-14692500-1454377528.jpg\" title=\"20160201_193343.jpg - Size: 93.37KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-14692500-1454377528.jpg\" class='bbc_img linked-image' alt=\"20160201_193343.jpg\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n<p><strong>38 tea lights - $20 (most of them weren't used at all. The one's that were used were only used for 6 hours)<\/strong><\/p>\n<p><a class='resized_img' rel='lightbox[1910389]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-26854300-1454377564.jpg\" title=\"20160201_193739.jpg - Size: 127KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-26854300-1454377564.jpg\" class='bbc_img linked-image' alt=\"20160201_193739.jpg\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><strong>1 blush taffeta table drape (rectangle) 90\" x 156\" - Professionally dry cleaned \u00a0$15<\/strong><\/p>\n<p><a class='resized_img' rel='lightbox[1910389]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-80814500-1454377623.jpg\" title=\"A86A4465.jpg - Size: 69.6KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-80814500-1454377623.jpg\" class='bbc_img linked-image' alt=\"A86A4465.jpg\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n<p><strong>3 blush taffeta tabe cloths (circular) 132\" - Professionally dry cleaned \u00a0$50 for all 3<\/strong><\/p>\n<p><a class='resized_img' rel='lightbox[1910389]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-23877000-1454377763.jpg\" title=\"20160201_192939.jpg - Size: 83.46KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-23877000-1454377763.jpg\" class='bbc_img linked-image' alt=\"20160201_192939.jpg\" \/><\/a>\n\n<a class='resized_img' rel='lightbox[1910389]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-91435700-1454377984.jpg\" title=\"A86A4469.jpg - Size: 70.64KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-91435700-1454377984.jpg\" class='bbc_img linked-image' alt=\"A86A4469.jpg\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n<p><strong>1 black and white striped table runner (used for head table) - professionally dry cleaned 16\" wide x 156\" long $15<\/strong><\/p>\n<p><a class='resized_img' rel='lightbox[1910389]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-75807400-1454378099.jpg\" title=\"HT8A4898.jpg - Size: 94.85KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-75807400-1454378099.jpg\" class='bbc_img linked-image' alt=\"HT8A4898.jpg\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><strong>Bride robe - Size M\/L - Never worn (tags still attached) $15<\/strong><\/p>\n<p><a class='resized_img' rel='lightbox[1910389]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-42666000-1454378118.jpg\" title=\"20150314_220120.jpg - Size: 50.09KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-42666000-1454378118.jpg\" class='bbc_img linked-image' alt=\"20150314_220120.jpg\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><strong>Gold Sequins bridal hanger - $10<\/strong><\/p>\n<p><a class='resized_img' rel='lightbox[1910389]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-25673400-1454378165.jpg\" title=\"20150602_155853.jpg - Size: 190.45KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-25673400-1454378165.jpg\" class='bbc_img linked-image' alt=\"20150602_155853.jpg\" \/><\/a>\n\n<a class='resized_img' rel='lightbox[1910389]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-11307700-1454378188.jpg\" title=\"20150602_155907.jpg - Size: 195.43KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-11307700-1454378188.jpg\" class='bbc_img linked-image' alt=\"20150602_155907.jpg\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n<p><strong>Card box (Paris) $10 - around 20 'advice for the bride and groom' cards included<\/strong><\/p>\n<p><a class='resized_img' rel='lightbox[1910389]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-61415600-1454378214.jpg\" title=\"20160201_194623.jpg - Size: 100.67KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-61415600-1454378214.jpg\" class='bbc_img linked-image' alt=\"20160201_194623.jpg\" \/><\/a>\n\n<a class='resized_img' rel='lightbox[1910389]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-94814400-1454378255.jpg\" title=\"20160201_194645.jpg - Size: 66.59KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-94814400-1454378255.jpg\" class='bbc_img linked-image' alt=\"20160201_194645.jpg\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n<p><strong>7 packs of straws (each has 20 straws in it) -$15<\/strong><\/p>\n<p><a class='resized_img' rel='lightbox[1910389]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-15376600-1454378282.jpg\" title=\"20160201_193452.jpg - Size: 147.66KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-15376600-1454378282.jpg\" class='bbc_img linked-image' alt=\"20160201_193452.jpg\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><strong>One layer tulle Ivory veil with a satin edge finish - Never worn $15 <\/strong><\/p>\n<p><strong><span  style=\"margin:0px\">White Single Tier 54\" Width 38\" Length Satin Ribbon Edge<\/span><\/strong><\/p>\n<p><span  style=\"margin:0px\"><a class='resized_img' rel='lightbox[1910389]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-34127000-1454379156.jpg\" title=\"il_570xN.384238344_b2wv.jpg - Size: 82.21KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-34127000-1454379156.jpg\" class='bbc_img linked-image' alt=\"il_570xN.384238344_b2wv.jpg\" \/><\/a>\n\n<\/span><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><strong>Flower crown - Custom made with silk florals off of Etsy (worn once for bachelorette)- $20<\/strong><\/p>\n<p><a class='resized_img' rel='lightbox[1910389]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-92613000-1454378420.jpg\" title=\"20160201_193045.jpg - Size: 132.4KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-92613000-1454378420.jpg\" class='bbc_img linked-image' alt=\"20160201_193045.jpg\" \/><\/a>\n\n<a class='resized_img' rel='lightbox[1910389]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-30754400-1454378939.jpg\" title=\"flower crown.jpg - Size: 46.28KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_02_2016\/post-281478-0-30754400-1454378939.jpg\" class='bbc_img linked-image' alt=\"flower crown.jpg\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419419814,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1453235488","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.118.50.250","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79914,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":4,"IsLiked":false,"PostKey":"bd179a8142b766003fab8b5fc176fd78","RawContent":"I need gold table numbers \/ frames, gold mercury glass votive holders, Mr &amp;amp; Mrs signs, and tea lights!\n\n\n\nSent from my iPhone using Tapatalk\nAlso, I just got home from work after putting in a 15 hour day... I may be delirious... However I&#039;m very excited at the prospect of not having to find \/ make those items myself [emoji4]\n\n\n\nSent from my iPhone using Tapatalk","Attachm