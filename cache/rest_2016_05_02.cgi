ure":"","Email":"info@delsolphotography.com","IpAddress":"189.221.144.61","GroupId":49,"GroupName":"Insiders","JoinDate":1175004840,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207303.gif?_r=0","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"custom"},"FormattedName":"Matt Adcock","Id":207303,"Name":"Matt Adcock","IsOnline":false}},"Posts":[],"Id":"79620","Title":"Del Sol Visiting Dominican Republic Jan 2015","LastPostDate":1443195909},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":1,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":691,"MovedTo":null,"MovedOn":0,"FirstPostId":1905286,"Rating":0,"RatingHits":0,"Starter":{"Id":282841,"Name":"leslieortizluis","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1443026530,"LastPoster":{"Id":282841,"Name":"leslieortizluis","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":22,"Preview":{"Id":1905286,"PostDate":1443026530,"PostContent":"My husband and I have been civilly married already but we want to renew our vows under the Cathol...","Author":{"Signature":"","Email":"lesliediane.ortizluis@gmail.com","IpAddress":"24.114.57.90","GroupId":39,"GroupName":"Newbie","JoinDate":1429817491,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"leslieortizluis",