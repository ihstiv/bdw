{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"192.83.103.9","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79438,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b83b1c2a6cf659b00a79e95d3cb1a853","RawContent":"&lt;p&gt;&lt;span style=\"color:rgb(68,112,140);font-family:arial, helvetica, sans-serif;\"&gt;@&lt;a  class=\"bbc_member\" href=\"http:\/\/www.bestdestinationwedding.com\/user\/286583-apbride2be\/\" title=\"\"&gt;apbride2be&lt;\/a&gt;&amp;nbsp;Congrats!! Our wedding was amazing I am so happy with how everything turned out. I would definitely say its cheaper than here (Chicago) compared to all of my friends weddings. However the wedding meals are not always included. Depends how you want to do things, I&#039;m sure you can tell from the pricing AmorDeMiVida sent! If you do a private event (like beach reception or Baja Norte) you pay per plate, however you can negotiate your way to open bar the whole time. I think if you do a semi private event at a restaurant, the meals may be included but I&#039;m not 100% sure. We had 55 guests and everyone had the best time, they want us to go back annually for our anniversary hahaha&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"color:rgb(68,112,140);font-family:arial, helvetica, sans-serif;\"&gt;If you have any other questions, I would be happy to answer them!&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1912881,"PostDate":1460719766,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span  style=\"color:rgb(68,112,140);font-family:arial, helvetica, sans-serif\">@<a href='http:\/\/www.bestdestinationwedding.com\/user\/286583-apbride2be\/' class='bbc_url' title=''>apbride2be<\/a>\u00a0Congrats!! Our wedding was amazing I am so happy with how everything turned out. I would definitely say its cheaper than here (Chicago) compared to all of my friends weddings. However the wedding meals are not always included. Depends how you want to do things, I'm sure you can tell from the pricing AmorDeMiVida sent! If you do a private event (like beach reception or Baja Norte) you pay per plate, however you can negotiate your way to open bar the whole time. I think if you do a semi private event at a restaurant, the meals may be included but I'm not 100% sure. We had 55 guests and everyone had the best time, they want us to go back annually for our anniversary hahaha<\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"color:rgb(68,112,140);font-family:arial, helvetica, sans-serif\">If you have any other questions, I would be happy to answer them!<\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"smchambers06@yahoo.com","IpAddress":"70.182.103.222","GroupId":39,"GroupName":"Newbie","JoinDate":1419333208,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281467.jpeg?_r=1457907391","PhotoWidth":200,"PhotoHeight":275,"PhotoType":"custom"},"FormattedName":"samFEB2016","Id":281467,"Name":"samFEB2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"96.49.200.33","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79438,"EditedBy":"","EditDate":1461966458,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d42976e4efa74cc83505201bf75ee96b","RawContent":"&lt;p&gt;@[member=\"samFEB2016\"] I am getting married at the Riu Palace January 2017 and also have about 55 guests. &amp;nbsp;Did you do a private dinner at baja norte? &amp;nbsp;or did you go for the beach reception? &amp;nbsp;what did you do for music? &amp;nbsp;did you have any advice? &amp;nbsp;Thank you so much for your thoughts!&lt;\/p&gt;","Attachments":[],"Id":1913197,"PostDate":1461966437,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"281467\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281467-samfeb2016\/' title='Member profile'><span itemprop=\"name\">samFEB2016<\/span><\/a> I am getting married at the Riu Palace January 2017 and also have about 55 guests. \u00a0Did you do a private dinner at baja norte? \u00a0or did you go for the beach reception? \u00a0what did you do for music? \u00a0did you have any advice? \u00a0Thank you so much for your thoughts!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"christalepik@gmail.com","IpAddress":"96.49.200.33","GroupId":39,"GroupName":"Newbie","JoinDate":1452140752,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"MrsMakasa","Id":285807,"Name":"MrsMakasa","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.87.79.229","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79438,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bb9931218a6a1dfe7fb4f01d068b37d4","RawContent":"Hi everyone! I am Chicago bride looking for tips about Riu and Cabo. Looking to have wedding March 2017. If anyone would be kind to email me price lists you received. I have read that prices have changed but its still worth knowing. Heathermlarkin@[member=\"gmail\"].com","Attachments":[],"Id":1913429,"PostDate":1462784062,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi everyone! I am Chicago bride looking for tips about Riu and Cabo. Looking to have wedding March 2017. If anyone would be kind to email me price lists you received. I have read that prices have changed but its still worth knowing. Heathermlarkin@<a hovercard-ref=\"member\" hovercard-id=\"219734\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/219734-gmail\/' title='Member profile'><span itemprop=\"name\">gmail<\/span><\/a>.com\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"heathermlarkin@gmail.com","IpAddress":"66.87.78.137","GroupId":39,"GroupName":"Newbie","JoinDate":1462536948,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"hstuck","Id":286891,"Name":"hstuck","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"192.83.103.9","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79438,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"eb8bc25cdce8a5d9eb0eae0bdce937e4","RawContent":"&lt;p&gt;@[member=\"MrsMakasa\"] Hi! Yes i did the private dinner at Baja Norte, it was perfect! We did the VIP DJ package. He was good, had everyone dancing the whole time, announced the wedding party and the parents and all of that. I did print him out an excel sheet of people names to announce and the songs i wanted played for each event (cake cutting, first dance, garter toss etc) I also met with him before hand to go over everything because i was very nervous about it! I made sure i had back ups of the important songs on my iphone for emergencies. I did end up needing to use my phone for our first dance because the song wasn&#039;t very popular, and he didn&#039;t find a good version to download. so PHEW! I would def recommend that.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I also mentioned to some others, it seems if you wait until last minute to add extras they may give you a better price. I added the lights above the &amp;nbsp;reception area it was about $500. I had also mentioned upgrading the chairs. At our pre-wedding meeting, the WC magically could offer me the chairs for 50% off! I wonder if i waited on the lights, i could have gotten a discount too... but I didn&#039;t want to risk not having it at all. I upgraded the hoopah thing too for the ceremony, very pretty and sturdy I was happy with that.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;LOVED my photographer\/videographer- EmWeddings. Our video was amazing everyone that watches it cries haha he even had a drone to video over the ceremony and the ocean and everything so cool. It was expensive, but after all is said and done all you have left are the photos! He discounted his rate $300 to make up for the &#039;vendor fee&#039; RIU will charge you. Now that I think of it I am not sure if they remembered to charge me for that...&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I have attached a few pics of the ceremony and reception area :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;and congrats @[member=\"hstuck\"] I am from Chicago too!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1913647,"PostDate":1462966205,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"285807\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/285807-mrsmakasa\/' title='Member profile'><span itemprop=\"name\">MrsMakasa<\/span><\/a> Hi! Yes i did the private dinner at Baja Norte, it was perfect! We did the VIP DJ package. He was good, had everyone dancing the whole time, announced the wedding party and the parents and all of that. I did print him out an excel sheet of people names to announce and the songs i wanted played for each event (cake cutting, first dance, garter toss etc) I also met with him before hand to go over everything because i was very nervous about it! I made sure i had back ups of the important songs on my iphone for emergencies. I did end up needing to use my phone for our first dance because the song wasn't very popular, and he didn't find a good version to download. so PHEW! I would def recommend that.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I also mentioned to some others, it seems if you wait until last minute to add extras they may give you a better price. I added the lights above the \u00a0reception area it was about $500. I had also mentioned upgrading the chairs. At our pre-wedding meeting, the WC magically could offer me the chairs for 50% off! I wonder if i waited on the lights, i could have gotten a discount too... but I didn't want to risk not having it at all. I upgraded the hoopah thing too for the ceremony, very pretty and sturdy I was happy with that.<\/p>\n<p>\u00a0<\/p>\n<p>LOVED my photographer\/videographer- EmWeddings. Our video was amazing everyone that watches it cries haha he even had a drone to video over the ceremony and the ocean and everything so cool. It was expensive, but after all is said and done all you have left are the photos! He discounted his rate $300 to make up for the 'vendor fee' RIU will charge you. Now that I think of it I am not sure if they remembered to charge me for that...<\/p>\n<p>\u00a0<\/p>\n<p>I have attached a few pics of the ceremony and reception area <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>and congrats @<a hovercard-ref=\"member\" hovercard-id=\"286891\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/286891-hstuck\/' title='Member profile'><span itemprop=\"name\">hstuck<\/span><\/a> I am from Chicago too!<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><a class='resized_img' rel='lightbox[1913647]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2016\/post-281467-0-64159700-1462980569.jpg\" title=\"DJP_1258.jpg -  174.43KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2016\/post-281467-0-64159700-1462980569.jpg\" class='bbc_img linked-image' alt=\"DJP_1258.jpg\" \/><\/a>\n\n<a class='resized_img' rel='lightbox[1913647]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2016\/post-281467-0-30188900-1462980571.jpg\" title=\"DJP_1262.jpg -  247.51KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2016\/post-281467-0-30188900-1462980571.jpg\" class='bbc_img linked-image' alt=\"DJP_1262.jpg\" \/><\/a>\n\n<a class='resized_img' rel='lightbox[1913647]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2016\/post-281467-0-46967200-1462980572.jpg\" title=\"DJP_1284.jpg -  169.3KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2016\/post-281467-0-46967200-1462980572.jpg\" class='bbc_img linked-image' alt=\"DJP_1284.jpg\" \/><\/a>\n\n<a class='resized_img' rel='lightbox[1913647]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2016\/post-281467-0-75118600-1462980573.jpg\" title=\"DJP_1297.jpg -  202.61KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2016\/post-281467-0-75118600-1462980573.jpg\" class='bbc_img linked-image' alt=\"DJP_1297.jpg\" \/><\/a>\n\n<a class='resized_img' rel='lightbox[1913647]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2016\/post-281467-0-79464100-1462980574.jpg\" title=\"pnt26.jpg -  60.21KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_05_2016\/post-281467-0-79464100-1462980574.jpg\" class='bbc_img linked-image' alt=\"pnt26.jpg\" \/><\/a>\n\n<\/p>\n<div>\u00a0<\/div>\n<p>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"smchambers06@yahoo.com","IpAddress":"70.182.103.222","GroupId":39,"GroupName":"Newbie","JoinDate":1419333208,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281467.jpeg?_r=1457907391","PhotoWidth":200,"PhotoHeight":275,"PhotoType":"custom"},"FormattedName":"samFEB2016","Id":281467,"Name":"samFEB2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"64.85.229.119","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79438,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"292544c12265a218d3d5bb82d4887c00","RawContent":"&lt;p&gt;@[member=\"hstuck\"] I just sent you an email.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;@[member=\"samFEB2016\"] thank you so much for sharing your pictures.&amp;nbsp; Whenever I see them, I always get so excited.&amp;nbsp; We are almost at our 1 month mark and there are 59 of us confirmed :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Do you by any chance have a panoramic view of the entire set up?&amp;nbsp; I wanted to get an idea on how the tables were arranged.&amp;nbsp; We have 6 guests tables plus our sweetheart table.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Also how did you pick your cake flavors? Were you able to pick different varieties for the tiers?&amp;nbsp; Which flavor did you end up having? Awhile ago when I asked if there would be a cake tasting, the WC stated no.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1913650,"PostDate":1462972177,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"286891\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/286891-hstuck\/' title='Member profile'><span itemprop=\"name\">hstuck<\/span><\/a> I just sent you an email.<\/p>\n<p>\u00a0<\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"281467\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281467-samfeb2016\/' title='Member profile'><span itemprop=\"name\">samFEB2016<\/span><\/a> thank you so much for sharing your pictures.\u00a0 Whenever I see them, I always get so excited.\u00a0 We are almost at our 1 month mark and there are 59 of us confirmed <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Do you by any chance have a panoramic view of the entire set up?\u00a0 I wanted to get an idea on how the tables were arranged.\u00a0 We have 6 guests tables plus our sweetheart table.<\/p>\n<p>\u00a0<\/p>\n<p>Also how did you pick your cake flavors? Were you able to pick different varieties for the tiers?\u00a0 Which flavor did you end up having? Awhile ago when I asked if there would be a cake tasting, the WC stated no.\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jrcorrales@gmail.com","IpAddress":"69.42.28.220","GroupId":39,"GroupName":"Newbie","JoinDate":1413941646,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280778.jpg?_r=1421562169","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"AmorDeMiVida","Id":280778,"Name":"AmorDeMiVida","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"192.83.103.9","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79438,"EditedBy":"","EditDate":1464885798,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"6b7f7c16ad2f2cdae622ebddedd5e0a9","RawContent":"&lt;p&gt;@[member=\"AmorDeMiVida\"] You&#039;re almost there! I wish I coudl go back and do it all again! So beautiful there :)\n\n&amp;nbsp;\n\nSorry I am just reading the post. Attached is the biggest picture I have but the WC should be able to send you a layout, she sent me one and gave me a copy at our meeting. Also i picked out cake at the meeting but didn&#039;t taste it. I think i did each layer a different flavor? Honestly i didn&#039;t eat any of it! Just the chocolate when we cut the cake. I was told it was good though! I bought the flowers form the florist for the cake! Glad i did, would have been plain without them!&amp;nbsp;Cant wait to see your photos, congrats!&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"http:\/\/emweddings.com\/webgallery\/sam-glenn-2016\/sam-glenn1\/content\/images\/large\/DJP_1299.jpg\" alt=\"DJP_1299.jpg\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"http:\/\/emweddings.com\/webgallery\/sam-glenn-2016\/sam-glenn1\/content\/images\/large\/DJP_1281.jpg\" alt=\"DJP_1281.jpg\"&gt;&lt;\/p&gt;","Attachments":[],"Id":1914153,"PostDate":1464885741,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"280778\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/280778-amordemivida\/' title='Member profile'><span itemprop=\"name\">AmorDeMiVida<\/span><\/a> You're almost there! I wish I coudl go back and do it all again! So beautiful there <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br>\n\u00a0<br>\nSorry I am just reading the post. Attached is the biggest picture I have but the WC should be able to send you a layout, she sent me one and gave me a copy at our meeting. Also i picked out cake at the meeting but didn't taste it. I think i did each layer a different flavor? Honestly i didn't eat any of it! Just the chocolate when we cut the cake. I was told it was good though! I bought the flowers form the florist for the cake! Glad i did, would have been plain without them!\u00a0Cant wait to see your photos, congrats!<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/emweddings.com\/webgallery\/sam-glenn-2016\/sam-glenn1\/content\/images\/large\/DJP_1299.jpg\" alt=\"DJP_1299.jpg\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/emweddings.com\/webgallery\/sam-glenn-2016\/sam-glenn1\/content\/images\/large\/DJP_1281.jpg\" alt=\"DJP_1281.jpg\"><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"smchambers06@yahoo.com","IpAddress":"70.182.103.222","GroupId":39,"GroupName":"Newbie","JoinDate":1419333208,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281467.jpeg?_r=1457907391","PhotoWidth":200,"PhotoHeight":275,"PhotoType":"custom"},"FormattedName":"samFEB2016","Id":281467,"Name":"samFEB2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.35.67.10","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79438,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"cc7ee2dea781c0282202215bc55b43e4","RawContent":"&lt;p&gt;@[member=\"samFEB2016\"] Your wedding was gorgeous!!! I am 2 weeks out and so excited and nervous hoping everything goes as planned! I absolutely love seeing other brides awesome pics!!!&lt;\/p&gt;","Attachments":[],"Id":1914260,"PostDate":1465384776,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"281467\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281467-samfeb2016\/' title='Member profile'><span itemprop=\"name\">samFEB2016<\/span><\/a> Your wedding was gorgeous!!! I am 2 weeks out and so excited and nervous hoping everything goes as planned! I absolutely love seeing other brides awesome pics!!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ana.avant87@gmail.com","IpAddress":"72.35.67.10","GroupId":39,"GroupName":"Newbie","JoinDate":1437723737,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284112.jpg?_r=1437784941","PhotoWidth":200,"PhotoHeight":258,"PhotoType":"custom"},"FormattedName":"CaboBride6252016","Id":284112,"Name":"CaboBride6252016","IsOnline":false}}],"Pages":{"TotalItems":47,"TotalPages":5,"CurrentPage":40,"NextPage":-1,"PreviousPage":30,"LastPage":40},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
