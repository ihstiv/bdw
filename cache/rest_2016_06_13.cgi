{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":11,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":1436,"MovedTo":null,"MovedOn":0,"FirstPostId":1908728,"Rating":0,"RatingHits":0,"Starter":{"Id":285337,"Name":"bridecdb","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1451295794,"LastPoster":{"Id":280844,"Name":"syr87","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":38,"Preview":{"Id":1913331,"PostDate":1462388022,"PostContent":"@bridecdb as far as tips, just keep every single email and anything that was promised in a folder...","Author":{"Signature":"","Email":"ramiresy@elac.edu","IpAddress":"198.188.146.185","GroupId":39,"GroupName":"Newbie","JoinDate":1414150977,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"syr87","Id":280844,"Name":"syr87","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"73.7.198.45","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79818,"EditedBy":"<strong>Edited by bridecdb, 28 December 2015 - 09:44 AM.<\/strong>","EditDate":1451295859,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"04bb501a58d9d4c425d83b1c3769f074","RawContent":"&lt;p&gt;Hello BDW - I am planning to get married in Cabo Aug 2016 and am in the process of contracting with the Fiesta Grand Americana. I just came back from a site visit trip to Cabo and saw several hotels. I am happy to share pics with other brides. Is there anyone out there that has gotten married at the Fiesta Cabo? I had a really nice site visit at the Fiesta and the hotel really went above and beyond for me during the site. There are still a few items of concern so I would love to chat with someone with experience before I sign this contract. Thanks &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1908728,"PostDate":1451295794,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello BDW - I am planning to get married in Cabo Aug 2016 and am in the process of contracting with the Fiesta Grand Americana. I just came back from a site visit trip to Cabo and saw several hotels. I am happy to share pics with other brides. Is there anyone out there that has gotten married at the Fiesta Cabo? I had a really nice site visit at the Fiesta and the hotel really went above and beyond for me during the site. There are still a few items of concern so I would love to chat with someone with experience before I sign this contract. Thanks \u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#b22222;\"><span style=\"font-family:'comic sans ms', cursive;\">CDB<\/span><\/span>","Email":"washwedding2016@yahoo.com","IpAddress":"66.194.122.2","GroupId":39,"GroupName":"Newbie","JoinDate":1447554000,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"bridecdb","Id":285337,"Name":"bridecdb","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.105.98.82","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79818,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"1414ec86420f09d93b4f7683f18e297f","RawContent":"&lt;p&gt;@bridecdb&amp;nbsp; Hello and congratulations!&amp;nbsp; I am in the process of trying to narrow down the top two resorts to stay in for our site visits in March.&amp;nbsp; I have been speaking to a wedding coordinator and she suggested Fiesta.&amp;nbsp; I would love your insight and any pictures that you may have taken.&amp;nbsp; What other resorts did you check out?&amp;nbsp; I will pm you my email address.&amp;nbsp; I really appreciate any info you could share.&amp;nbsp; Thank you!! :)&lt;\/p&gt;","Attachments":[],"Id":1909327,"PostDate":1452598991,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@bridecdb\u00a0 Hello and congratulations!\u00a0 I am in the process of trying to narrow down the top two resorts to stay in for our site visits in March.\u00a0 I have been speaking to a wedding coordinator and she suggested Fiesta.\u00a0 I would love your insight and any pictures that you may have taken.\u00a0 What other resorts did you check out?\u00a0 I will pm you my email address.\u00a0 I really appreciate any info you could share.\u00a0 Thank you!! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jasminearceo@gmail.com","IpAddress":"74.105.98.82","GroupId":39,"GroupName":"Newbie","JoinDate":1398959405,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277804.jpg?_r=1416936614","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"jazzzy23","Id":277804,"Name":"jazzzy23","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"73.7.198.45","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79818,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"37fb57a18f155935b70fbd5c79e16e92","RawContent":"&lt;p&gt;ok ladies - hear is the breakdown.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I visited the Fiesta Americana, The Sheraton Hacienda Del Mar, Hyatt Ziva and Hacienda Encantada.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Fiesta Americana: nice size resort (not too big not too small) at the top of a cliff. 5 restaurant options and three pools (1 adult only) and several bars. The beach is small but clean with cabanas you can rent. There is a kids club and an Amazing spa. There are about to reno their guest rooms which will be a definite plus since they are slightly outdated but still doable. It will take you about an hour -1.5 to get to the hotel. The hotel is located in the corridor area which is in the middle between Jose Del Cabo (closer to the airport) and Cabo San Lucas (tourist\/bar area). The hotel is connected to the Cabo Del Sol Golf course. Their wedding coordinator Amber is so friendly and a joy to work with. I will caution you that contracting a guest rooms block at this hotel is not fun. The event part is easy. Their deposit requirements are crazy so ask up front so you know what to expect. Don&#039;t expect to get any deals when scheduling a site visit like other hotels. They don&#039;t have a free site visit fee and will not allow you to apply the visit revenue to your final event bill.&amp;nbsp;They have several nice ceremony\/event locations to include a private 2 BR villa you can rent that includes a lawn big enough for the ceremony and reception. They have garden and ocean view guest rooms and some superior rooms with a kitchenettes. &amp;nbsp;Staff was really nice and accommodating. This is an all inclusive hotel&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Hyatt Ziva: I booked the site visit through my travel planner. The wedding coordinator was last and stated that didnt have any of my event info which was annoying. She got much more pleasant as we continued on the tour. This is a newly renovated hotel and new to the Hyatt grand. It definitely have the \"wow\" factor when you first walk in with a large open air lobby leading right into the pool area. The have several restaurant options to include a live show theater and piano bar. This hotel is located in San Jose del Cabo which is about 30-45 from the airport and is new the \"artsy\" area of Cabo. The beach area was a nice size and clean. There only down side to this hotel for me was the event locations. They have a pretty gazebo area for weddings buts it&#039;s right near one of their restaurants and the pool area which is not very private. Their reception options are right smack in the middle of the common area below the lobby or in the pool area in the adult section of the hotel which is surrounded by guest room towers so guest can just look down at your wedding (weird). It&#039;s pretty if you can get past that. This hotel was previously the Barcelo FYI. This is an all inclusive hotel.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Sheraton Hacienda Del Mar is also in the Corridor area so it will take about an hour - 1.5 to travel from the airport. It&#039;s also located near the Cabo Del Sol gold course right down the street from the Fiesta. This is a non inclusive hotel with fewer restaurant options then the other all inclusive hotel. This hotel does however have a FABULOUS ceremony chapel that is amazing. Old Mexico with original doors from an 100+year old church. The beach is small but nice. Beware of the people selling items to you on the beach and the aggressive timeshare sales people in the lobby. &amp;nbsp;It&#039;s a really pretty hotel with lots of color and charm. They have a kids park area and a shuttle that runs every 30min that will take you to the golden zone which is where the mall and \"tourist\" area is. I was not impressed with the golden zone area so I wont be going back other than to purchase small bottled of tequila for my guests. It was actually kind of depressing with all the constructions still taking place from the hurricane. This is an a la carte hotel so guests will have to pay for their own F&amp;amp;B however I do know that they will occasionally offer an all inclusive option for social blocks.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Hacienda Encanta will truly give you the \"Mexico\" experience. Their rooms are amazing and several great event locations. They are building a new guest room tower so there is some conduction taking place onsite. There are three phases to this property with phase one being mainly for timeshare owners. The only downside to this hotel is their F&amp;amp;B offerings and pool area. there is not much to do. I would have booked this hotel in a heart beat if they had just a few more restaurants onsite. They offer a \"offsite inclusive plan\" where you can take their shuttle to the \"golden zone\" but like I said, I was not impressed with the golden zone and frankly would not travel to the area by myself at night. &amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Notes: Cabo is still under construction from the hurricane so be prepared. I might have my guests take part in a community service project while there because the people of Cabo need it. There is a Costco in the coordinator area and I hear there is a Walmart but I didn&#039;t see it for myself. My Costco member says its valid for any location around the world so I am planning to visit to get some items for gift bags upon arrival.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I have attached some photos from the Fiesta. I&#039;ll include photos from the other hotels in another post..&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am still in the contracting phase with the Fiesta so I will keep you all posted one all this madness has come to an end. I am open to helping any other brides because lord knows I needed it. I am paying it forward :) Try to Enjoy the process! &amp;nbsp;&lt;\/p&gt;","Attachments":[{"Id":34710,"Name":"IMG_7322.JPG","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_01_2016\/post-285337-0-86100600-1452797652.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_01_2016\/post-285337-0-86100600-1452797652_thumb.jpg","Width":1000,"Height":750},{"Id":34711,"Name":"IMG_7325.JPG","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_01_2016\/post-285337-0-84342600-1452797656.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_01_2016\/post-285337-0-84342600-1452797656_thumb.jpg","Width":1000,"Height":750},{"Id":34712,"Name":"IMG_7337.JPG","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_01_2016\/post-285337-0-88257100-1452797722.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_01_2016\/post-285337-0-88257100-1452797722_thumb.jpg","Width":1000,"Height":750},{"Id":34713,"Name":"IMG_7338.JPG","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_01_2016\/post-285337-0-23188400-1452797727.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_01_2016\/post-285337-0-23188400-1452797727_thumb.jpg","Width":1000,"Height":750},{"Id":34715,"Name":"IMG_7348.JPG","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_01_2016\/post-285337-0-84121700-1452797790.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_01_2016\/post-285337-0-84121700-1452797790_thumb.jpg","Width":1000,"Height":750},{"Id":34716,"Name":"IMG_7349.JPG","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_01_2016\/post-285337-0-11093900-1452797804.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_01_2016\/post-285337-0-11093900-1452797804_thumb.jpg","Width":1000,"Height":750},{"Id":34718,"Name":"IMG_7370.JPG","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_01_2016\/post-285337-0-85544400-1452797835.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_01_2016\/post-285337-0-85544400-1452797835_thumb.jpg","Width":1000,"Height":750}],"Id":1909491,"PostDate":1452786018,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>ok ladies - hear is the breakdown.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I visited the Fiesta Americana, The Sheraton Hacienda Del Mar, Hyatt Ziva and Hacienda Encantada.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Fiesta Americana: nice size resort (not too big not too small) at the top of a cliff. 5 restaurant options and three pools (1 adult only) and several bars. The beach is small but clean with cabanas you can rent. There is a kids club and an Amazing spa. There are about to reno their guest rooms which will be a definite plus since they are slightly outdated but still doable. It will take you about an hour -1.5 to get to the hotel. The hotel is located in the corridor area which is in the middle between Jose Del Cabo (closer to the airport) and Cabo San Lucas (tourist\/bar area). The hotel is connected to the Cabo Del Sol Golf course. Their wedding coordinator Amber is so friendly and a joy to work with. I will caution you that contracting a guest rooms block at this hotel is not fun. The event part is easy. Their deposit requirements are crazy so ask up front so you know what to expect. Don't expect to get any deals when scheduling a site visit like other hotels. They don't have a free site visit fee and will not allow you to apply the visit revenue to your final event bill.\u00a0They have several nice ceremony\/event locations to include a private 2 BR villa you can rent that includes a lawn big enough for the ceremony and reception. They have garden and ocean view guest rooms and some superior rooms with a kitchenettes. \u00a0Staff was really nice and accommodating. This is an all inclusive hotel<\/p>\n<p>\u00a0<\/p>\n<p>Hyatt Ziva: I booked the site visit through my travel planner. The wedding coordinator was last and stated that didnt have any of my event info which was annoying. She got much more pleasant as we continued on the tour. This is a newly renovated hotel and new to the Hyatt grand. It definitely have the \"wow\" factor when you first walk in with a large open air lobby leading right into the pool area. The have several restaurant options to include a live show theater and piano bar. This hotel is located in San Jose del Cabo which is about 30-45 from the airport and is new the \"artsy\" area of Cabo. The beach area was a nice size and clean. There only down side to this hotel for me was the event locations. They have a pretty gazebo area for weddings buts it's right near one of their restaurants and the pool area which is not very private. Their reception options are right smack in the middle of the common area below the lobby or in the pool area in the adult section of the hotel which is surrounded by guest room towers so guest can just look down at your wedding (weird). It's pretty if you can get past that. This hotel was previously the Barcelo FYI. This is an all inclusive hotel.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Sheraton Hacienda Del Mar is also in the Corridor area so it will take about an hour - 1.5 to travel from the airport. It's also located near the Cabo Del Sol gold course right down the street from the Fiesta. This is a non inclusive hotel with fewer restaurant options then the other all inclusive hotel. This hotel does however have a FABULOUS ceremony chapel that is amazing. Old Mexico with original doors from an 100+year old church. The beach is small but nice. Beware of the people selling items to you on the beach and the aggressive timeshare sales people in the lobby. \u00a0It's a really pretty hotel with lots of color and charm. They have a kids park area and a shuttle that runs every 30min that will take you to the golden zone which is where the mall and \"tourist\" area is. I was not impressed with the golden zone area so I wont be going back other than to purchase small bottled of tequila for my guests. It was actually kind of depressing with all the constructions still taking place from the hurricane. This is an a la carte hotel so guests will have to pay for their own F&B however I do know that they will occasionally offer an all inclusive option for social blocks.<\/p>\n<p>\u00a0<\/p>\n<p>Hacienda Encanta will truly give you the \"Mexico\" experience. Their rooms are amazing and several great event locations. They are building a new guest room tower so there is some conduction taking place onsite. There are three phases to this property with phase one being mainly for timeshare owners. The only downside to this hotel is their F&B offerings and pool area. there is not much to do. I would have booked this hotel in a heart beat if they had just a few more restaurants onsite. They offer a \"offsite inclusive plan\" where you can take their shuttle to the \"golden zone\" but like I said, I was not impressed with the golden zone and frankly would not travel to the area by myself at night. \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Notes: Cabo is still under construction from the hurricane so be prepared. I might have my guests take part in a community service project while there because the people of Cabo need it. There is a Costco in the coordinator area and I hear there is a Walmart but I didn't see it for myself. My Costco member says its valid for any location around the world so I am planning to visit to get some items for gift bags upon arrival.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I have attached some photos from the Fiesta. I'll include photos from the other hotels in another post..\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I am still in the contracting phase with the Fiesta so I will keep you all posted one all this madness has come to an end. I am open to helping any other brides because lord knows I needed it. I am paying it forward <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> Try to Enjoy the process! \u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#b22222;\"><span style=\"font-family:'comic sans ms', cursive;\">CDB<\/span><\/span>","Email":"washwedding2016@yahoo.com","IpAddress":"66.194.122.2","GroupId":39,"GroupName":"Newbie","JoinDate":1447554000,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"bridecdb","Id":285337,"Name":"bridecdb","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"209.33.154.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79818,"EditedBy":"<strong>Edited by bridecdb, 17 January 2016 - 06:24 PM.<\/strong>","EditDate":1453055077,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"b89314731c7d0ce8ea85848738a5c60a","RawContent":"&lt;p&gt;Pics provided by the hotel&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"margin-left:0cm;font-size:12pt;color:rgb(0,0,0);font-family:&#039;Helvetica Neue&#039;, &#039;Segoe UI&#039;, Helvetica, Arial, &#039;Lucida Grande&#039;, sans-serif;\"&gt;&lt;span style=\"font-size:11pt;\"&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.1121023337927153.1073741837.823080057721484&amp;amp;type=3&#039;&gt;&lt;span&gt;https:\/\/www.facebook.com\/media\/set\/?set=a.1121023337927153.1073741837.823080057721484&amp;amp;type=3&lt;\/span&gt;&lt;\/a&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"margin-left:0cm;font-size:12pt;color:rgb(0,0,0);font-family:&#039;Helvetica Neue&#039;, &#039;Segoe UI&#039;, Helvetica, Arial, &#039;Lucida Grande&#039;, sans-serif;\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"margin-left:0cm;font-size:12pt;color:rgb(0,0,0);font-family:&#039;Helvetica Neue&#039;, &#039;Segoe UI&#039;, Helvetica, Arial, &#039;Lucida Grande&#039;, sans-serif;\"&gt;&lt;span style=\"font-size:11pt;\"&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.1141175409245279.1073741839.823080057721484&amp;amp;type=3&#039;&gt;https:\/\/www.facebook.com\/media\/set\/?set=a.1141175409245279.1073741839.823080057721484&amp;amp;type=3&lt;\/a&gt;&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1909638,"PostDate":1453054948,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Pics provided by the hotel<\/p>\n<p>\u00a0<\/p>\n<p  style=\"margin-left:0cm;font-size:12pt;color:rgb(0,0,0);font-family:'Helvetica Neue', 'Segoe UI', Helvetica, Arial, 'Lucida Grande', sans-serif;\"><span  style=\"font-size:11pt\"><a href='https:\/\/www.facebook.com\/media\/set\/?set=a.1121023337927153.1073741837.823080057721484&type=3' class='bbc_url' title='External link' rel='nofollow external'><span>https:\/\/www.facebook.com\/media\/set\/?set=a.1121023337927153.1073741837.823080057721484&type=3<\/span><\/a><\/span><\/p>\n<p  style=\"margin-left:0cm;font-size:12pt;color:rgb(0,0,0);font-family:'Helvetica Neue', 'Segoe UI', Helvetica, Arial, 'Lucida Grande', sans-serif;\">\u00a0<\/p>\n<p  style=\"margin-left:0cm;font-size:12pt;color:rgb(0,0,0);font-family:'Helvetica Neue', 'Segoe UI', Helvetica, Arial, 'Lucida Grande', sans-serif;\"><span  style=\"font-size:11pt\"><a href='https:\/\/www.facebook.com\/media\/set\/?set=a.1141175409245279.1073741839.823080057721484&type=3' class='bbc_url' title='External link' rel='nofollow external'>https:\/\/www.facebook...57721484&type=3<\/a><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#b22222;\"><span style=\"font-family:'comic sans ms', cursive;\">CDB<\/span><\/span>","Email":"washwedding2016@yahoo.com","IpAddress":"66.194.122.2","GroupId":39,"GroupName":"Newbie","JoinDate":1447554000,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"bridecdb","Id":285337,"Name":"bridecdb","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.105.98.82","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79818,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f9f085b2ba0b59b8d36084832ebd7edb","RawContent":"&lt;p&gt;@bridecdb&amp;nbsp; Thanks so much for all of the info!&amp;nbsp; This was soooo helpful!! :)&lt;\/p&gt;","Attachments":[],"Id":1909837,"PostDate":1453379274,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@bridecdb\u00a0 Thanks so much for all of the info!\u00a0 This was soooo helpful!! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jasminearceo@gmail.com","IpAddress":"74.105.98.82","GroupId":39,"GroupName":"Newbie","JoinDate":1398959405,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277804.jpg?_r=1416936614","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"jazzzy23","Id":277804,"Name":"jazzzy23","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.62.73.244","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79818,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"f22d9c0b6a94d2368a9e8def71b9ece5","RawContent":"&lt;p&gt;how funny, some of those pictures on that facebook are of my wedding. I got married here late last year and I loved it! the hotel coordinator was so nice and helpful, the food we picked was amazinggggg and the accommodations were great! I would definitely recommend this hotel, all of our guests loved it! some are even going back soon in a few months.&lt;\/p&gt;","Attachments":[],"Id":1909842,"PostDate":1453382660,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>how funny, some of those pictures on that facebook are of my wedding. I got married here late last year and I loved it! the hotel coordinator was so nice and helpful, the food we picked was amazinggggg and the accommodations were great! I would definitely recommend this hotel, all of our guests loved it! some are even going back soon in a few months.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ramiresy@elac.edu","IpAddress":"198.188.146.185","GroupId":39,"GroupName":"Newbie","JoinDate":1414150977,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"syr87","Id":280844,"Name":"syr87","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"209.33.154.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79818,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5fff40b16df86df9c99169dcf90be7b9","RawContent":"Thanks for the comment @[member=\"syr87\"]. It&#039;s good to hear you had a positive experience. Any tips for future Fiesta brides? What menu item(s) did you love the most? I&#039;m hosting my wedding Aug 2015.","Attachments":[],"Id":1909845,"PostDate":1453383020,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks for the comment @<a hovercard-ref=\"member\" hovercard-id=\"280844\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/280844-syr87\/' title='Member profile'><span itemprop=\"name\">syr87<\/span><\/a>. It's good to hear you had a positive experience. Any tips for future Fiesta brides? What menu item(s) did you love the most? I'm hosting my wedding Aug 2015. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#b22222;\"><span style=\"font-family:'comic sans ms', cursive;\">CDB<\/span><\/span>","Email":"washwedding2016@yahoo.com","IpAddress":"66.194.122.2","GroupId":39,"GroupName":"Newbie","JoinDate":1447554000,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"bridecdb","Id":285337,"Name":"bridecdb","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"189.172.236.211","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79818,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e373e5da634bb65448f027517c7a3b12","RawContent":"&lt;p&gt;This is a wedding I had a couple of monts ago at Fiesta Americana, every turn out great. I hope you like the pictures:&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.gvphotographer.com\/blog\/fiesta-americana-los-cabos-wedding-jenni-and-mike&#039;&gt;www.gvphotographer.com\/blog\/fiesta-americana-los-cabos-wedding-jenni-and-mike&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Happy planning!!&lt;\/p&gt;\n&lt;p&gt;Gonzalo Verdeja&lt;\/p&gt;","Attachments":[],"Id":1910780,"PostDate":1455217368,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>This is a wedding I had a couple of monts ago at Fiesta Americana, every turn out great. I hope you like the pictures:<\/p>\n<p>\u00a0<\/p>\n<p><a href='http:\/\/www.gvphotographer.com\/blog\/fiesta-americana-los-cabos-wedding-jenni-and-mike' class='bbc_url' title='External link' rel='nofollow external'>www.gvphotographer.com\/blog\/fiesta-americana-los-cabos-wedding-jenni-and-mike<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Happy planning!!<\/p>\n<p>Gonzalo Verdeja<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"info@artncolors.com","IpAddress":"189.176.187.29","GroupId":42,"GroupName":"Sr. Member","JoinDate":1258572501,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223381.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"GVphotographer","Id":223381,"Name":"GVphotographer","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"166.216.157.28","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79818,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"39f29263a467970325a46716e6b093d4","RawContent":"What is the outside vendor fee? I&#039;m planning to use a videographer based out of Puerto Vallarta. Also, has anyone used TravelZap for group TA with Fiesta Grand Americana Los Cabos ?","Attachments":[],"Id":1912378,"PostDate":1459436078,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                What is the outside vendor fee? I'm planning to use a videographer based out of Puerto Vallarta. Also, has anyone used TravelZap for group TA with Fiesta Grand Americana Los Cabos ?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"amtaag@yahoo.com","IpAddress":"166.216.157.28","GroupId":39,"GroupName":"Newbie","JoinDate":1459435056,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286617.jpg?_r=1460651572","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"AnaMarie","Id":286617,"Name":"AnaMarie","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"98.232.102.14","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79818,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f527fcc9b81974cf25615b84ba5c95c3","RawContent":"&lt;p&gt;I am new to this and also looking at this resort. Any tips or information would be greatly appreciated.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1912555,"PostDate":1459854861,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I am new to this and also looking at this resort. Any tips or information would be greatly appreciated.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lill.tiffany123@gmail.com","IpAddress":"98.232.102.14","GroupId":39,"GroupName":"Newbie","JoinDate":1459853202,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"tlill123","Id":286652,"Name":"tlill123","IsOnline":false}}],"Id":"79818","Title":"Fiesta Grand Americana Cabo Brides 2016","LastPostDate":1462388022},"Pages":{"TotalItems":11,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
