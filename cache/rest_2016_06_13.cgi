Request Time: 1 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":5,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":1621,"MovedTo":null,"MovedOn":0,"FirstPostId":1877372,"Rating":0,"RatingHits":0,"Starter":{"Id":280923,"Name":"Kar8503","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280923.jpg?_r=1415102735","PhotoWidth":200,"PhotoHeight":206,"PhotoType":"facebook"},"IsOnline":false},"StartDate":1414672945,"LastPoster":{"Id":223381,"Name":"GVphotographer","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223381.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":38,"Preview":{"Id":1910783,"PostDate":1455218451,"PostContent":"Hello, I am a local and I am in the wedding industry and I would say just tip bartenders and the...","Author":{"Signature":"","Email":"info@artncolors.com","IpAddress":"189.176.187.29","GroupId":42,"GroupName":"Sr. Member","JoinDate":1258572501,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223381.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"GVphotographer","Id":223381,"Name":"GVphotographer","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.47.150.114","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78316,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"152c52f4f7ea40f6997e2d55feac5c8e","RawContent":"&lt;p&gt;Hi Brides!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am getting married NEXT WEEK at Pueblo Bonito Sunset Beach in Cabo San Lucas, and am in a bit of a panic over who to tip &amp;amp; how much! The resort is all-inclusive, and the wedding was booked as a package deal, so I&#039;m not really sure what the protocol is. I assume I&#039;ll need to tip the bartender\/waitstaff\/DJ\/coordinator - but have no clue how much! I regret not thinking about this earlier, or budgeting for it... What have other brides done in all-inclusive situations?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;-Kari&lt;\/p&gt;","Attachments":[],"Id":1877372,"PostDate":1414672945,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Brides!<\/p>\n<p>\u00a0<\/p>\n<p>I am getting married NEXT WEEK at Pueblo Bonito Sunset Beach in Cabo San Lucas, and am in a bit of a panic over who to tip & how much! The resort is all-inclusive, and the wedding was booked as a package deal, so I'm not really sure what the protocol is. I assume I'll need to tip the bartender\/waitstaff\/DJ\/coordinator - but have no clue how much! I regret not thinking about this earlier, or budgeting for it... What have other brides done in all-inclusive situations?<\/p>\n<p>\u00a0<\/p>\n<p>-Kari<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kari.moorman@yahoo.com","IpAddress":"108.47.150.114","GroupId":39,"GroupName":"Newbie","JoinDate":1414672255,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280923.jpg?_r=1415102735","PhotoWidth":200,"PhotoHeight":206,"PhotoType":"facebook"},"FormattedName":"Kar8503","Id":280923,"Name":"Kar8503","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.18.213.150","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78316,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c358ba8c82614b54dfb4900e946b7b73","RawContent":"There is a tipping thread on here, I&#039;ll try to find it - it really helped me with tipping!","Attachments":[],"Id":1877384,"PostDate":1414680620,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                There is a tipping thread on here, I'll try to find it - it really helped me with tipping!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lcboyko@ualberta.ca","IpAddress":"23.17.180.191","GroupId":47,"GroupName":"Site Supporter","JoinDate":1304957891,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-239790.jpg?_r=1434572414","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Mrsktobe","Id":239790,"Name":"Mrsktobe","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"189.172.253.76","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78316,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9caae7e719e94346d3dcd2c6165536c3","RawContent":"[quote name=\"Kar8503\" post=\"1877372\" timestamp=\"1414687345\"]\nHi Brides!\n\nI am getting married NEXT WEEK at Pueblo Bonito Sunset Beach in Cabo San Lucas, and am in a bit of a panic over who to tip &amp;amp; how much! The resort is all-inclusive, and the wedding was booked as a package deal, so I&#039;m not really sure what the protocol is. I assume I&#039;ll need to tip the bartender\/waitstaff\/DJ\/coordinator - but have no clue how much! I regret not thinking about this earlier, or budgeting for it... What have other brides done in all-inclusive situations?\n\n-Kari[\/quote]\nHi Kari - What did you end up doing in terms of tips at PBSB? It&#039;d be great if you could share. Thanks!","Attachments":[],"Id":1879388,"PostDate":1417406104,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Kar8503, on 30 October 2014 - 12:42 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hi Brides!<\/p>\n<p>\u00a0<\/p>\n<p>I am getting married NEXT WEEK at Pueblo Bonito Sunset Beach in Cabo San Lucas, and am in a bit of a panic over who to tip & how much! The resort is all-inclusive, and the wedding was booked as a package deal, so I'm not really sure what the protocol is. I assume I'll need to tip the bartender\/waitstaff\/DJ\/coordinator - but have no clue how much! I regret not thinking about this earlier, or budgeting for it... What have other brides done in all-inclusive situations?<\/p>\n<p>\u00a0<\/p>\n<p>-Kari<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>Hi Kari - What did you end up doing in terms of tips at PBSB? It'd be great if you could share. Thanks!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"allen.liou@gmail.com","IpAddress":"189.172.253.76","GroupId":39,"GroupName":"Newbie","JoinDate":1417405796,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"randomtask","Id":281278,"Name":"randomtask","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"107.137.241.202","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78316,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"70244dd0220def9593c2961d428413ee","RawContent":"&lt;p&gt;What did you end up doing in terms of tips? Would love your advice. Thanks!&lt;\/p&gt;","Attachments":[],"Id":1904416,"PostDate":1441802427,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>What did you end up doing in terms of tips? Would love your advice. Thanks!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"deanna.e.wozniak@gmail.com","IpAddress":"107.137.241.202","GroupId":39,"GroupName":"Newbie","JoinDate":1438110626,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284179.jpg?_r=1443022447","PhotoWidth":200,"PhotoHeight":199,"PhotoType":"facebook"},"FormattedName":"deannawozniak","Id":284179,"Name":"deannawozniak","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"189.172.236.211","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78316,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f1636302af99f0696898402535d443b2","RawContent":"&lt;p&gt;Hello, I am a local and I am in the wedding industry and I would say just tip bartenders and the vendors that are outstanding, dont tip everybody&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Gonzalo Verdeja&lt;\/p&gt;","Attachments":[],"Id":1910783,"PostDate":1455218451,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello, I am a local and I am in the wedding industry and I would say just tip bartenders and the vendors that are outstanding, dont tip everybody<\/p>\n<p>\u00a0<\/p>\n<p>Gonzalo Verdeja<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"info@artncolors.com","IpAddress":"189.176.187.29","GroupId":42,"GroupName":"Sr. Member","JoinDate":1258572501,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223381.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"GVphotographer","Id":223381,"Name":"GVphotographer","IsOnline":false}}],"Id":"78316","Title":"Tipping At An All-Inclusive?","LastPostDate":1455218451},"Pages":{"TotalItems":5,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
