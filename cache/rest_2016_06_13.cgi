{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":87,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":34101,"MovedTo":null,"MovedOn":0,"FirstPostId":84734,"Rating":0,"RatingHits":0,"Starter":{"Id":207401,"Name":"jajajaja","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207401.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"StartDate":1185869662,"LastPoster":{"Id":286840,"Name":"ucanwin","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":32,"Preview":{"Id":84734,"PostDate":1185869662,"PostContent":"Does anyone know what specific airlines will allow a wedding dress to be a carry on? I have a cou...","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Happily married since 2008<\/span><\/div><\/div>","Email":"rachie021@yahoo.com","IpAddress":"70.173.241.167","GroupId":46,"GroupName":"VIP Member","JoinDate":1179209760,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207401.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"jajajaja","Id":207401,"Name":"jajajaja","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":5164,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ed3d798147c95863857ce7fca2c6764e","RawContent":"Does anyone know what specific airlines will allow a wedding dress to be a carry on? I have a couple of emails into a few, but I didn&#039;t know if others have any feedback on this subject or any experiences to re-tell.\n \n When buying my dress, the consultant told me about a bride cleared her wedding dress with the airline at the time of purchase, but at the ticket counter they took it back and made her check her dress.\n \n I swear if it were me, I would put that thing on and wear it on the plane. I have the WORST traveling luck...and just for saying that I&#039;m sure I jinxed myself again.","Attachments":[],"Id":84734,"PostDate":1185869662,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Does anyone know what specific airlines will allow a wedding dress to be a carry on? I have a couple of emails into a few, but I didn't know if others have any feedback on this subject or any experiences to re-tell.<br \/> <br \/> When buying my dress, the consultant told me about a bride cleared her wedding dress with the airline at the time of purchase, but at the ticket counter they took it back and made her check her dress.<br \/> <br \/> I swear if it were me, I would put that thing on and wear it on the plane. I have the WORST traveling luck...and just for saying that I'm sure I jinxed myself again.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Happily married since 2008<\/span><\/div><\/div>","Email":"rachie021@yahoo.com","IpAddress":"70.173.241.167","GroupId":46,"GroupName":"VIP Member","JoinDate":1179209760,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207401.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"jajajaja","Id":207401,"Name":"jajajaja","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":5164,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"2d799d7580ade14a1f3351bc071d6408","RawContent":"I walked right onto an American Airlines flight with no problem at all. I called ahead of time and they told me just to carry it on and ask to hang it in the front coat closet.\n \n In fact by doing this we also brought it to the stewardess&#039; attention and later they moved us to first class... I swear I&#039;m carrying a large white garment bag whenever I travel - even if it&#039;s empty! &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/wink.gif\" border=\"0\" alt=\"\" title=\"Wink\" class=\"inlineimg\" \/&gt;","Attachments":[],"Id":84736,"PostDate":1185869796,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I walked right onto an American Airlines flight with no problem at all. I called ahead of time and they told me just to carry it on and ask to hang it in the front coat closet.<br \/> <br \/> In fact by doing this we also brought it to the stewardess' attention and later they moved us to first class... I swear I'm carrying a large white garment bag whenever I travel - even if it's empty! <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/wink.gif\" border=\"0\" alt=\"\" title=\"Wink\" class=\"inlineimg\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Kashmira & Dan<\/span><br><span>Happily married since June 16, 2007<\/span><br><a data-ipb='nomediaparse' href=\"http:\/\/i95.photobucket.com\/albums\/l139\/gkashmira\/IMG_0769.jpg\">http:\/\/i95.photobucket.com\/albums\/l1...a\/IMG_0769.jpg<\/a><br><span>Our mini-video: <\/span><a data-ipb='nomediaparse' href=\"http:\/\/www.bajavideoproductions.com\/Kash_Dan.html\">http:\/\/www.bajavideoproductions.com\/Kash_Dan.html<\/a><br><span>Photo slideshow: <\/span><a data-ipb='nomediaparse' href=\"http:\/\/www.tomasbarron.com\/recent.php\">http:\/\/www.tomasbarron.com\/recent.php<\/a><\/div><\/div>","Email":"gkashmira@hotmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1156811160,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206698.gif?_r=0","PhotoWidth":100,"PhotoHeight":81,"PhotoType":"custom"},"FormattedName":"gkashmira","Id":206698,"Name":"gkashmira","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":5164,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"b82061a7bb26c8c32f51398c8dc11e08","RawContent":"not only did the airline let me carry on my dress, but they treated me like a VIP and let me board the airplane first and put my dress in the locker for the stewardesses\/pilots.\n \n i dont think there is a list of airlines that will have something this specific but you may want to ask when you book your airfare if they will allow you to carry on your dress and\/or give you special considerations.","Attachments":[],"Id":84737,"PostDate":1185869878,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                not only did the airline let me carry on my dress, but they treated me like a VIP and let me board the airplane first and put my dress in the locker for the stewardesses\/pilots.<br \/> <br \/> i dont think there is a list of airlines that will have something this specific but you may want to ask when you book your airfare if they will allow you to carry on your dress and\/or give you special considerations.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-family:arial, helvetica, sans-serif;\">Founder and Owner of BestDestinationWedding.com \u00a0\/ \u00a0<\/span><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/'><strong><span style=\"font-family:arial, helvetica, sans-serif;\">Bride & Groom Fly FREE Promotion<\/span><\/strong><\/a><\/p>\n<p>\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><a data-ipb='nomediaparse' href='https:\/\/www.wrighttravelagency.com\/go\/destination-wedding\/?source=EMLSIG'><strong><span style=\"color:#008080;\">Looking for a travel agency that specializes in Destination Weddings-CLICK HERE<\/span><\/strong><\/a><span style=\"color:#008080;\"><strong>?<\/strong> \u00a0We are an award winning travel agency and you can <\/span><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style=\"color:#008080;\">read our reviews\u00a0here.<\/span><\/a><\/strong><\/span><br>\n\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"color:#008080;\"><strong>Awards and recognition:\u00a0<\/strong><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Palace Resorts Winner \"Top Travel Agent\", \"Top Homebased Travel Agency\" PRO Platinum Agency (Top Award) \u00a0 \u00a0 | \u00a0 \u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">AMResorts Master Agent & Top Agency \u00a0<\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/68050-karisma-hotels-givc-and-gi-wedding-consultants-wright-travel-agency\/'><strong>Wright Travel & Karisma GIVC Benefits<\/strong><\/a><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Travel Impressions Best of the Best Globe Winner \u00a0 \u00a0| \u00a0 \u00a0\u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Apple Vacations Golden Apple Winner \u00a0<\/span><\/span><br><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17612\/sml_gallery_206696_17612_13451.png\" alt=\"sml_gallery_206696_17612_13451.png\"><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"> \u00a0 \u00a0<img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"font-size:14px;\"><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010'>Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><\/span><\/span><strong><span style=\"color:#b22222;\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a data-ipb='nomediaparse' href='mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com'>ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"admin@bestdestinationwedding.com","IpAddress":"71.202.225.11","GroupId":4,"GroupName":"Administrators","JoinDate":1137227820,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"FormattedName":"TammyWright","Id":206696,"Name":"TammyWright","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":5164,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e1248af672fcfd012a2fee3f9c2e70f7","RawContent":"We flew Frontier. I called ahead and they told me it had to be in a bag that was only so many linear inches (obviously smaller than a dress bag) but I decided to be brave (or stupid!) and carry it on anyway.\n \n On the first flight, it was a small plane and there was no where to hang it. They made me stow it in the overhead bin. I was kinda pissed, but oh well. On our second half of our trip, they were soooo much nicer; they took it from me as I entered the plane and found an empty bin and carefully laid it out...still nowhere to hang it, but they at least tried to be nice about it. They also gave us a complimentary alcoholic beverage of our choice.","Attachments":[],"Id":84782,"PostDate":1185877151,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We flew Frontier. I called ahead and they told me it had to be in a bag that was only so many linear inches (obviously smaller than a dress bag) but I decided to be brave (or stupid!) and carry it on anyway.<br \/> <br \/> On the first flight, it was a small plane and there was no where to hang it. They made me stow it in the overhead bin. I was kinda pissed, but oh well. On our second half of our trip, they were soooo much nicer; they took it from me as I entered the plane and found an empty bin and carefully laid it out...still nowhere to hang it, but they at least tried to be nice about it. They also gave us a complimentary alcoholic beverage of our choice.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"aqharider@hotmail.com","IpAddress":"76.20.179.61","GroupId":46,"GroupName":"VIP Member","JoinDate":1154391780,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/9\/9f\/9fd8e240_user-274-avatar?_r=0","PhotoWidth":180,"PhotoHeight":120,"PhotoType":"custom"},"FormattedName":"Sarah","Id":206770,"Name":"Sarah","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":5164,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b871585277c5b890e2de18f91460f819","RawContent":"Alaska Airlines was the best! They put my dress in the empty first class closet, announced us to the whole plane, gave us free champagne, and went around and got advice from married couples then announced it on the PA.....it was above what we expected for sure!!\n \n If you call they&#039;ll say it&#039;s on a space available basis, but if the closets are full you can still carry it on, you&#039;ll just have to lay it flat in the overhead which isn&#039;t a big problem.","Attachments":[],"Id":84783,"PostDate":1185877467,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Alaska Airlines was the best! They put my dress in the empty first class closet, announced us to the whole plane, gave us free champagne, and went around and got advice from married couples then announced it on the PA.....it was above what we expected for sure!!<br \/> <br \/> If you call they'll say it's on a space available basis, but if the closets are full you can still carry it on, you'll just have to lay it flat in the overhead which isn't a big problem.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mrsjamyjones@gmail.com","IpAddress":"162.201.254.135","GroupId":38,"GroupName":"Moderators","JoinDate":1168274640,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207039.jpeg?_r=0","PhotoWidth":1000,"PhotoHeight":667,"PhotoType":"custom"},"FormattedName":"starchild","Id":207039,"Name":"starchild","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":5164,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3d6fc870727d784023ca56ef209b320a","RawContent":"OMG, I didn&#039;t even think about this. We&#039;re flying Frontier and are already having a devil of a time with flights that are being cancelled. I&#039;m hoping the dress won&#039;t be an issue as well.","Attachments":[],"Id":84801,"PostDate":1185885921,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                OMG, I didn't even think about this. We're flying Frontier and are already having a devil of a time with flights that are being cancelled. I'm hoping the dress won't be an issue as well.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lavalos@adobe.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1174992836,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207302.gif?_r=0","PhotoWidth":100,"PhotoHeight":67,"PhotoType":"custom"},"FormattedName":"lavalos","Id":207302,"Name":"lavalos","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":5164,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"975a5105547c61edbc971f766549a5cf","RawContent":"I am a little stresses about this as well.... when I was just dress shopping recently, the girl told me not to let them put the dress in the coat closet... but to buy an extra ticket and put it in the seat next to me. Is this a little extreme? I was just going to call the airline to see what they suggest....","Attachments":[],"Id":84811,"PostDate":1185896567,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I am a little stresses about this as well.... when I was just dress shopping recently, the girl told me not to let them put the dress in the coat closet... but to buy an extra ticket and put it in the seat next to me. Is this a little extreme? I was just going to call the airline to see what they suggest....\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<a class='bbc_url' href='http:\/\/i641.photobucket.com\/albums\/uu135\/dieselpug\/AdamMay2010226-1.jpg'>http:\/\/i641.photobucket.com\/albums\/u...y2010226-1.jpg<\/a>","Email":"shelleyringrose@hotmail.com","IpAddress":"96.234.167.104","GroupId":46,"GroupName":"VIP Member","JoinDate":1181270160,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207447.jpg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"MsShelley","Id":207447,"Name":"MsShelley","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":5164,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"28a066df833e0ceb27356b0ae76cb260","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;beachbride&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;I am a little stresses about this as well.... when I was just dress shopping recently, the girl told me not to let them put the dress in the coat closet... but to buy an extra ticket and put it in the seat next to me. Is this a little extreme? I was just going to call the airline to see what they suggest....&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;Not speaking from experience...but I can&#039;t imagine that a closet can be a bad place for a dress!!! An overhead, not the best option, but it worked for others. I would think that&#039;s a little extreme to buy an extra ticket for your dress...those plane tickets are expensive. I mean most people don&#039;t even buy a ticket for their child under 2 who is more delicate than a wedding dress. \n \n Did this girl secretly work for an airline making commission?? &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/wink.gif\" border=\"0\" alt=\"\" title=\"Wink\" class=\"inlineimg\" \/&gt;","Attachments":[],"Id":84903,"PostDate":1185904735,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>beachbride<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">I am a little stresses about this as well.... when I was just dress shopping recently, the girl told me not to let them put the dress in the coat closet... but to buy an extra ticket and put it in the seat next to me. Is this a little extreme? I was just going to call the airline to see what they suggest....<\/div> <\/td> <\/tr> <\/table> <\/div>Not speaking from experience...but I can't imagine that a closet can be a bad place for a dress!!! An overhead, not the best option, but it worked for others. I would think that's a little extreme to buy an extra ticket for your dress...those plane tickets are expensive. I mean most people don't even buy a ticket for their child under 2 who is more delicate than a wedding dress. <br \/> <br \/> Did this girl secretly work for an airline making commission?? <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/wink.gif\" border=\"0\" alt=\"\" title=\"Wink\" class=\"inlineimg\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mmc7997@yahoo.com","IpAddress":"","GroupId":46,"GroupName":"VIP Member","JoinDate":1180433160,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207426.png?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"michelle08","Id":207426,"Name":"michelle08","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":5164,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f8f107d803a0e2960a9d3abfc3b22115","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;michelle08&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Not speaking from experience...but I can&#039;t imagine that a closet can be a bad place for a dress!!! An overhead, not the best option, but it worked for others. I would think that&#039;s a little extreme to buy an extra ticket for your dress...those plane tickets are expensive. I mean most people don&#039;t even buy a ticket for their child under 2 who is more delicate than a wedding dress. \n \n Did this girl secretly work for an airline making commission?? &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/wink.gif\" border=\"0\" alt=\"\" title=\"Wink\" class=\"inlineimg\" \/&gt;&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;lol that is what I thought!!! She said that she used to be a wedding planner and she has had girls &amp;quot;lose their dresses&amp;quot; after putting them in an airline closet!! I personally thought that it was a little extreme!!","Attachments":[],"Id":84914,"PostDate":1185905926,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>michelle08<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Not speaking from experience...but I can't imagine that a closet can be a bad place for a dress!!! An overhead, not the best option, but it worked for others. I would think that's a little extreme to buy an extra ticket for your dress...those plane tickets are expensive. I mean most people don't even buy a ticket for their child under 2 who is more delicate than a wedding dress. <br \/> <br \/> Did this girl secretly work for an airline making commission?? <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/wink.gif\" border=\"0\" alt=\"\" title=\"Wink\" class=\"inlineimg\" \/><\/span><\/div> <\/td> <\/tr> <\/table> <\/div>lol that is what I thought!!! She said that she used to be a wedding planner and she has had girls \"lose their dresses\" after putting them in an airline closet!! I personally thought that it was a little extreme!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<a class='bbc_url' href='http:\/\/i641.photobucket.com\/albums\/uu135\/dieselpug\/AdamMay2010226-1.jpg'>http:\/\/i641.photobucket.com\/albums\/u...y2010226-1.jpg<\/a>","Email":"shelleyringrose@hotmail.com","IpAddress":"96.234.167.104","GroupId":46,"GroupName":"VIP Member","JoinDate":1181270160,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207447.jpg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"MsShelley","Id":207447,"Name":"MsShelley","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":5164,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cd0c7cafa622d6d45d8e948d99d762a9","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;beachbride&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;lol that is what I thought!!! She said that she used to be a wedding planner and she has had girls &amp;quot;lose their dresses&amp;quot; after putting them in an airline closet!! I personally thought that it was a little extreme!!&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;Hmmm....again it seems hard to think that someone would steal your wedding dress from the closet...BUT in todays world anything is possible! :) \n \n Maybe if you do put it in the closet you sit in the front so that you can get to it before any one else!!!! :)","Attachments":[],"Id":84920,"PostDate":1185906609,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>beachbride<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">lol that is what I thought!!! She said that she used to be a wedding planner and she has had girls \"lose their dresses\" after putting them in an airline closet!! I personally thought that it was a little extreme!!<\/div> <\/td> <\/tr> <\/table> <\/div>Hmmm....again it seems hard to think that someone would steal your wedding dress from the closet...BUT in todays world anything is possible! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> <br \/> <br \/> Maybe if you do put it in the closet you sit in the front so that you can get to it before any one else!!!! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mmc7997@yahoo.com","IpAddress":"","GroupId":46,"GroupName":"VIP Member","JoinDate":1180433160,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207426.png?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"michelle08","Id":207426,"Name":"michelle08","IsOnline":false}}],"Id":"5164","Title":"Airlines that allow wedding dress as carry-ons","LastPostDate":1461906354},"Pages":{"TotalItems":87,"TotalPages":9,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":80},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
