{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":5,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":937,"MovedTo":null,"MovedOn":0,"FirstPostId":1898601,"Rating":0,"RatingHits":0,"Starter":{"Id":283549,"Name":"jhap123","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1434370777,"LastPoster":{"Id":223381,"Name":"GVphotographer","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223381.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":38,"Preview":{"Id":1898601,"PostDate":1434370777,"PostContent":"Hi! Can anyone lend any information regarding pricing\/vendors\/coordination for a wedding at\u00a0Fiest...","Author":{"Signature":"","Email":"alvarez.perla@gmail.com","IpAddress":"70.39.176.100","GroupId":39,"GroupName":"Newbie","JoinDate":1434370150,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"jhap123","Id":283549,"Name":"jhap123","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.39.176.100","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79278,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"77dae73bb1c4ab90ebfff194cc89fab7","RawContent":"&lt;p&gt;Hi! Can anyone lend any information regarding pricing\/vendors\/coordination for a wedding at&amp;nbsp;Fiesta Americana Grand Los Cabos Golf and Spa Resort? From online research, I really like their Casa del Mar Imperial Suite, but I have found very little information on same. Any information would be appreciated. Thank you!&lt;\/p&gt;","Attachments":[],"Id":1898601,"PostDate":1434370777,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi! Can anyone lend any information regarding pricing\/vendors\/coordination for a wedding at\u00a0Fiesta Americana Grand Los Cabos Golf and Spa Resort? From online research, I really like their Casa del Mar Imperial Suite, but I have found very little information on same. Any information would be appreciated. Thank you!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"alvarez.perla@gmail.com","IpAddress":"70.39.176.100","GroupId":39,"GroupName":"Newbie","JoinDate":1434370150,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"jhap123","Id":283549,"Name":"jhap123","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.87.237.201","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79278,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9b280393f1861ae8a79f86e05ef9be98","RawContent":"&lt;p&gt;Welcome to BDW! Have you tried the search bar at the top typing in the resort name to see what comes up? I typed it in and got several threads that came up so give it a try and see what works for you.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Congrats and happy planning!&lt;\/p&gt;","Attachments":[],"Id":1898606,"PostDate":1434373671,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome to BDW! Have you tried the search bar at the top typing in the resort name to see what comes up? I typed it in and got several threads that came up so give it a try and see what works for you.<\/p>\n<p>\u00a0<\/p>\n<p>Congrats and happy planning!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/'><span style=\"color:#ff0099;\"><em>http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.19.167.70","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79278,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3c285cf6481e86e87439a2d26408fb72","RawContent":"&lt;p&gt;Hi, we just had our wedding moved to FALC (we were supposed to have it at Dreams, but they are STILL closed after the hurricane!). I&#039;m attaching a document with their wedding package info. Also, if you want to have outside vendors it&#039;s a $100 fee. I&#039;m going with an outside photographer, Gonzalo Verdeja, even with the fee it was cheaper to go with him. I&#039;m using their DJ (Teevan, $1300 for 3 hours) and florist (Nancy &amp;amp; Sergio). I&#039;m working with the WC Ambar Molina, she&#039;s ok. Nice, but very hard to get a hold of (she doesn&#039;t answer emails), and not extremely knowledgeable. Let me know if you have any other specific questions, hope that helps!   &lt;\/p&gt;","Attachments":[],"Id":1899516,"PostDate":1435604746,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi, we just had our wedding moved to FALC (we were supposed to have it at Dreams, but they are STILL closed after the hurricane!). I'm attaching a document with their wedding package info. Also, if you want to have outside vendors it's a $100 fee. I'm going with an outside photographer, Gonzalo Verdeja, even with the fee it was cheaper to go with him. I'm using their DJ (Teevan, $1300 for 3 hours) and florist (Nancy & Sergio). I'm working with the WC Ambar Molina, she's ok. Nice, but very hard to get a hold of (she doesn't answer emails), and not extremely knowledgeable. Let me know if you have any other specific questions, hope that helps! \u00a0\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jsdeveau@gmail.com","IpAddress":"24.19.167.70","GroupId":39,"GroupName":"Newbie","JoinDate":1435604023,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"jsdeveau","Id":283751,"Name":"jsdeveau","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"209.33.154.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79278,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"dd122f643e5e63cd0405aab1d3fc2a85","RawContent":"&lt;p&gt;I was told there is a 2 night minimum to reserve the 2br 2ba Imperial Suite. Est Cost = $1,000-1,500 per night. Guests would have access to all the inclusive amenities and there is a nice patio in front with room for your ceremony and reception. Good luck!&lt;\/p&gt;","Attachments":[],"Id":1909637,"PostDate":1453054767,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I was told there is a 2 night minimum to reserve the 2br 2ba Imperial Suite. Est Cost = $1,000-1,500 per night. Guests would have access to all the inclusive amenities and there is a nice patio in front with room for your ceremony and reception. Good luck!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#b22222;\"><span style=\"font-family:'comic sans ms', cursive;\">CDB<\/span><\/span>","Email":"washwedding2016@yahoo.com","IpAddress":"66.194.122.2","GroupId":39,"GroupName":"Newbie","JoinDate":1447554000,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"bridecdb","Id":285337,"Name":"bridecdb","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"189.172.236.211","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79278,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f2419ca8d4a23eac016e16e15fc3d775","RawContent":"&lt;p&gt;This wedding it was a few months ago at the Fiesta American. I hope you like the pictures and you can get any idea from their wedding&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.gvphotographer.com\/blog\/fiesta-americana-los-cabos-wedding-jenni-and-mike&#039;&gt;www.gvphotographer.com\/blog\/fiesta-americana-los-cabos-wedding-jenni-and-mike&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;Happy planning!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Gonzalo Verdeja&lt;\/p&gt;","Attachments":[],"Id":1910781,"PostDate":1455217498,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>This wedding it was a few months ago at the Fiesta American. I hope you like the pictures and you can get any idea from their wedding<\/p>\n<p><a href='http:\/\/www.gvphotographer.com\/blog\/fiesta-americana-los-cabos-wedding-jenni-and-mike' class='bbc_url' title='External link' rel='nofollow external'>www.gvphotographer.com\/blog\/fiesta-americana-los-cabos-wedding-jenni-and-mike<\/a><\/p>\n<p>Happy planning!!<\/p>\n<p>\u00a0<\/p>\n<p>Gonzalo Verdeja<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"info@artncolors.com","IpAddress":"189.176.187.29","GroupId":42,"GroupName":"Sr. Member","JoinDate":1258572501,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223381.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"GVphotographer","Id":223381,"Name":"GVphotographer","IsOnline":false}}],"Id":"79278","Title":"Fiesta Americana Grand Los Cabos Golf And Spa Resort Information?","LastPostDate":1455217498},"Pages":{"TotalItems":5,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
