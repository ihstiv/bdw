{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":127,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":23904,"MovedTo":null,"MovedOn":0,"FirstPostId":67110,"Rating":0,"RatingHits":0,"Starter":{"Id":206887,"Name":"PDCwedding","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206887.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"IsOnline":false},"StartDate":1182721232,"LastPoster":{"Id":277216,"Name":"forevertogether","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277216.jpg?_r=1395766815","PhotoWidth":200,"PhotoHeight":218,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":32,"Preview":{"Id":67110,"PostDate":1182721232,"PostContent":"Hi all,  For all that past brides who married in Mexico...did you declare all of your wedding stu...","Author":{"Signature":"","Email":"mreynado@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1162896712,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206887.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"PDCwedding","Id":206887,"Name":"PDCwedding","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":4239,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5102a39ef5a72db8743b279aeabd910a","RawContent":"Hi all,\n \n For all that past brides who married in Mexico...did you declare all of your wedding stuff that you brought down there such as your OOT bags and contents; reception and ceremony decor (candles, vases, etc.), your make up, etc??\n \n I guess, i&#039;m kind of confused on what you should declare and not. I know there&#039;s a 300 dollar limit, i believe (please correct me if I&#039;m wrong...)\n \n So, what are you suppose to declare? I&#039;m leaving in 4 days and want to gather all the reciepts together just in case!\n \n Any info or help would be appreciated!!!!!\n \n THank you!!","Attachments":[],"Id":67110,"PostDate":1182721232,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi all,<br \/> <br \/> For all that past brides who married in Mexico...did you declare all of your wedding stuff that you brought down there such as your OOT bags and contents; reception and ceremony decor (candles, vases, etc.), your make up, etc??<br \/> <br \/> I guess, i'm kind of confused on what you should declare and not. I know there's a 300 dollar limit, i believe (please correct me if I'm wrong...)<br \/> <br \/> So, what are you suppose to declare? I'm leaving in 4 days and want to gather all the reciepts together just in case!<br \/> <br \/> Any info or help would be appreciated!!!!!<br \/> <br \/> THank you!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mreynado@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1162896712,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206887.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"PDCwedding","Id":206887,"Name":"PDCwedding","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":4239,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3b10297dcdff4a5840cff151d7c7c980","RawContent":"Good question! I thought you had to declare when you came back to the U.S.? I&#039;ve only crossed the border a few times in my life, and most of them when I was a child, so I don&#039;t know for sure.\n \n If that&#039;s the case, then you wouldn&#039;t have to declare anything, right? You won&#039;t have it with you anyways.\n \n Actually, would you have to declare it in the first place since its purchased before you leave? Ok, I don&#039;t know. :-| Sorry","Attachments":[],"Id":67226,"PostDate":1182742539,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Good question! I thought you had to declare when you came back to the U.S.? I've only crossed the border a few times in my life, and most of them when I was a child, so I don't know for sure.<br \/> <br \/> If that's the case, then you wouldn't have to declare anything, right? You won't have it with you anyways.<br \/> <br \/> Actually, would you have to declare it in the first place since its purchased before you leave? Ok, I don't know. :-| Sorry\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><strong>Happily Married since May 9, 2008<\/strong><br><strong>Proud Mama to Evelyn Eileen since June 8, 2010<\/strong><\/div><\/div>","Email":"aaron_courtney@hotmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1171957980,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207196.JPG?_r=0","PhotoWidth":200,"PhotoHeight":266,"PhotoType":"custom"},"FormattedName":"CourtneyV","Id":207196,"Name":"CourtneyV","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":4239,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"35b9c0f94a7f95acd810182abbcf6b2a","RawContent":"You only have to declare items you purchased in Mexico when you return. \n \n But....if you have all your OOT bag items or decorations in one suitcase, it may raise a flag. They may assume you are taking all of that stuff in to Mexico to sell. Maybe separate all those multiple items?","Attachments":[],"Id":67228,"PostDate":1182743519,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                You only have to declare items you purchased in Mexico when you return. <br \/> <br \/> But....if you have all your OOT bag items or decorations in one suitcase, it may raise a flag. They may assume you are taking all of that stuff in to Mexico to sell. Maybe separate all those multiple items?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mlongoria08@yahoo.com","IpAddress":"76.248.213.32","GroupId":46,"GroupName":"VIP Member","JoinDate":1177099320,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207360.JPG?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Martha","Id":207360,"Name":"Martha","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":4239,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0d2732cf87c1f2146296cdf057acb1c4","RawContent":"I got a red light going into PV which means they got to open my bags and search through them. One entire bag was full of all favors, OOT stuff, etc. \n The girl searching through my bag was on her cell phone and barely paying attention so maybe I lucked out, but she searched through boxes of stuff that was obviously not for personal use and she waived me on.\n \n Maybe they&#039;re only looking for dangerous stuff? Not sure but it wasn&#039;t a problem for me.","Attachments":[],"Id":67319,"PostDate":1182758880,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I got a red light going into PV which means they got to open my bags and search through them. One entire bag was full of all favors, OOT stuff, etc. <br \/> The girl searching through my bag was on her cell phone and barely paying attention so maybe I lucked out, but she searched through boxes of stuff that was obviously not for personal use and she waived me on.<br \/> <br \/> Maybe they're only looking for dangerous stuff? Not sure but it wasn't a problem for me.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mrsjamyjones@gmail.com","IpAddress":"162.201.254.135","GroupId":38,"GroupName":"Moderators","JoinDate":1168274640,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207039.jpeg?_r=0","PhotoWidth":1000,"PhotoHeight":667,"PhotoType":"custom"},"FormattedName":"starchild","Id":207039,"Name":"starchild","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":4239,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ac6093ef97227e255fb0cb387cc44a5c","RawContent":"We brought two totes full of items (that were majorly damaged by the airline) we had a green light but we were still stopped and asked what was in them. They opened to inspect briefly but I explained they were items for our wedding.. no problems. \n \n The declaring of items is for the way back. They also want to make sure you aren&#039;t bringing in items to sell.. so make sure you say they aren&#039;t for resale. If you ship, packages should also be marked as such. I wouldn&#039;t risk shipping.","Attachments":[],"Id":67341,"PostDate":1182762869,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We brought two totes full of items (that were majorly damaged by the airline) we had a green light but we were still stopped and asked what was in them. They opened to inspect briefly but I explained they were items for our wedding.. no problems. <br \/> <br \/> The declaring of items is for the way back. They also want to make sure you aren't bringing in items to sell.. so make sure you say they aren't for resale. If you ship, packages should also be marked as such. I wouldn't risk shipping.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i148.photobucket.com\/albums\/s22\/cheese_diva\/Maddie%20cake%20smash\/032.jpg\">http:\/\/i148.photobucket.com\/albums\/s...0smash\/032.jpg<\/a><br><span>faberphotography.com<\/span><br><span><a href=\"<\/span><a data-ipb='nomediaparse' href=\"http:\/\/lilypie.com\/\">http:\/\/lilypie.com\/<\/a><span>\"><img src=\"<\/span><a data-ipb='nomediaparse' href=\"http:\/\/lb2f.lilypie.com\/Yg4Cm8.png\">http:\/\/lb2f.lilypie.com\/Yg4Cm8.png<\/a><span>\" width=\"400\" height=\"80\" border=\"0\" alt=\"Lilypie Second Birthday tickers\" \/><\/a><\/span><\/div><\/div>","Email":"cheese_diva@yahoo.com","IpAddress":"","GroupId":46,"GroupName":"VIP Member","JoinDate":1159955880,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206995.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"cheese_diva","Id":206995,"Name":"cheese_diva","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":4239,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"dd6d7da1edeafd1175559c53e263b27d","RawContent":"Thanks, Ladies!\n \n I guess I&#039;m a bit confused with the whole customs, etc...Anyway, i&#039;ll find out soon!\n \n I just hope I don&#039;t get stopped!!!","Attachments":[],"Id":67349,"PostDate":1182765801,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks, Ladies!<br \/> <br \/> I guess I'm a bit confused with the whole customs, etc...Anyway, i'll find out soon!<br \/> <br \/> I just hope I don't get stopped!!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mreynado@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1162896712,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206887.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"PDCwedding","Id":206887,"Name":"PDCwedding","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":4239,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7fc80ee2591b8cb50a584058d28fa32d","RawContent":"Even if you get stopped you should be fine. It&#039;s funny, the weekend of my wedding the President of Mexico and every Mexican governer were in PV for a Navy anniversary or some big celebration, so going into the PV marina was strenuous. The security checkpoint was more intense than the airport&#039;s with the President being there and all. \n \n They gave us a hard time about everything because most people entering the marina aren&#039;t bringing luggage, but we were on the way to the wedding so I had my dress, suitcase, etc. They let us in but we held up the line for like 10 minutes while they called in superiors to approve us. The airport was a breeze!","Attachments":[],"Id":67352,"PostDate":1182767817,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Even if you get stopped you should be fine. It's funny, the weekend of my wedding the President of Mexico and every Mexican governer were in PV for a Navy anniversary or some big celebration, so going into the PV marina was strenuous. The security checkpoint was more intense than the airport's with the President being there and all. <br \/> <br \/> They gave us a hard time about everything because most people entering the marina aren't bringing luggage, but we were on the way to the wedding so I had my dress, suitcase, etc. They let us in but we held up the line for like 10 minutes while they called in superiors to approve us. The airport was a breeze!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mrsjamyjones@gmail.com","IpAddress":"162.201.254.135","GroupId":38,"GroupName":"Moderators","JoinDate":1168274640,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207039.jpeg?_r=0","PhotoWidth":1000,"PhotoHeight":667,"PhotoType":"custom"},"FormattedName":"starchild","Id":207039,"Name":"starchild","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":4239,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7cbfefb85cb787256e15462c54c11a53","RawContent":"i haven&#039;t heard of anyone having a problem bringing stuff in...","Attachments":[],"Id":67983,"PostDate":1182893694,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                i haven't heard of anyone having a problem bringing stuff in...\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-family:arial, helvetica, sans-serif;\">Founder and Owner of BestDestinationWedding.com \u00a0\/ \u00a0<\/span><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/'><strong><span style=\"font-family:arial, helvetica, sans-serif;\">Bride & Groom Fly FREE Promotion<\/span><\/strong><\/a><\/p>\n<p>\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><a data-ipb='nomediaparse' href='https:\/\/www.wrighttravelagency.com\/go\/destination-wedding\/?source=EMLSIG'><strong><span style=\"color:#008080;\">Looking for a travel agency that specializes in Destination Weddings-CLICK HERE<\/span><\/strong><\/a><span style=\"color:#008080;\"><strong>?<\/strong> \u00a0We are an award winning travel agency and you can <\/span><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style=\"color:#008080;\">read our reviews\u00a0here.<\/span><\/a><\/strong><\/span>