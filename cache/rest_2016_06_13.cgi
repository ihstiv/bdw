{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":4,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":878,"MovedTo":null,"MovedOn":0,"FirstPostId":1876839,"Rating":0,"RatingHits":0,"Starter":{"Id":280844,"Name":"syr87","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1414151934,"LastPoster":{"Id":223381,"Name":"GVphotographer","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223381.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":38,"Preview":{"Id":1876839,"PostDate":1414151934,"PostContent":"Hi ladies, and gents, we want to get married at cabo del sol and looked at their options. they ar...","Author":{"Signature":"","Email":"ramiresy@elac.edu","IpAddress":"198.188.146.185","GroupId":39,"GroupName":"Newbie","JoinDate":1414150977,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"syr87","Id":280844,"Name":"syr87","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"198.188.146.185","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78285,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"332c022d2f3e65eb9bdb0c94a81358e1","RawContent":"&lt;p&gt;Hi ladies, and gents, we want to get married at cabo del sol and looked at their options. they are a little pricier but we loved not having any restrictions that a lot of the resorts have or any outside vendors fee. my question is to any previous cabo del sol brides, did you try to negotiate with the venue as far as drinks? or free cocktail hour? I feel like that is what&#039;s most expensive. we want to try and not let our guests pay for their own drinks since they will be flying out for our wedding but we also need to save where we can. any&amp;nbsp;past experiences with this venue&amp;nbsp;would help. thanks ladies!!! :D&lt;\/p&gt;","Attachments":[],"Id":1876839,"PostDate":1414151934,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi ladies, and gents, we want to get married at cabo del sol and looked at their options. they are a little pricier but we loved not having any restrictions that a lot of the resorts have or any outside vendors fee. my question is to any previous cabo del sol brides, did you try to negotiate with the venue as far as drinks? or free cocktail hour? I feel like that is what's most expensive. we want to try and not let our guests pay for their own drinks since they will be flying out for our wedding but we also need to save where we can. any\u00a0past experiences with this venue\u00a0would help. thanks ladies!!! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/biggrin.png' class='bbc_emoticon' alt=':D' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ramiresy@elac.edu","IpAddress":"198.188.146.185","GroupId":39,"GroupName":"Newbie","JoinDate":1414150977,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"syr87","Id":280844,"Name":"syr87","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"41.218.230.57","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78285,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"14182343c01796357803a65a366c1ed4","RawContent":"&lt;p&gt;I searched in this forum and found quite a few threads about cabo del sol.. Here is one&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.bestdestinationwedding.com\/topic\/43800-our-cabo-del-sol-site-visit-long-with-pics\/&#039;&gt;http:\/\/www.bestdestinationwedding.com\/topic\/43800-our-cabo-del-sol-site-visit-long-with-pics\/&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Hope it helps&lt;\/p&gt;","Attachments":[],"Id":1876840,"PostDate":1414152403,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I searched in this forum and found quite a few threads about cabo del sol.. Here is one<\/p>\n<p>\u00a0<\/p>\n<p><a href='http:\/\/www.bestdestinationwedding.com\/topic\/43800-our-cabo-del-sol-site-visit-long-with-pics\/' class='bbc_url' title=''>http:\/\/www.bestdesti...long-with-pics\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Hope it helps<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p style=\"text-align:center;\"><img src=\"http:\/\/www.tickerclub.com\/tickers\/wedding\/preview\/idTicker\/206838\/rulerId\/\/sliderId\/\/\" alt=\"sliderId\"><\/p>\n<p style=\"text-align:center;\">\u00a0","Email":"amanda@roamcanada.com","IpAddress":"41.218.252.222","GroupId":39,"GroupName":"Newbie","JoinDate":1411393687,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279936.jpg?_r=1414239845","PhotoWidth":200,"PhotoHeight":246,"PhotoType":"custom"},"FormattedName":"amanda2016","Id":279936,"Name":"amanda2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"198.188.146.185","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78285,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e9900b4b99b9028e2bd9170e81df9da3","RawContent":"&lt;p&gt;thanks Amanda! just read through the thread. helpful and the food looked amazing!!!!&amp;nbsp;but I wanted to know if any brides negotiated and got any additional things for free or reduced prices?&lt;\/p&gt;","Attachments":[],"Id":1876864,"PostDate":1414174024,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>thanks Amanda! just read through the thread. helpful and the food looked amazing!!!!\u00a0but I wanted to know if any brides negotiated and got any additional things for free or reduced prices?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ramiresy@elac.edu","IpAddress":"198.188.146.185","GroupId":39,"GroupName":"Newbie","JoinDate":1414150977,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"syr87","Id":280844,"Name":"syr87","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"189.172.236.211","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78285,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"85a629af5f52ccbcb22d52f7d7ab3ab6","RawContent":"&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;Hi!!&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;Cabo del Sol is one of the prettiest places in Cabo for weddings. Here you can see a wedding I shoot there a couple of months ago, everything turn out perfect. Wedding planner Paola and Christina from Cabo Beach weddings&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;&lt;a  class=\"bbc_url\" href=\"http:\/\/www.gvphotographer.com\/blog\/loscabosweddings\" title=\"External link\"&gt;www.gvphotographer.com\/blog\/loscabosweddings&lt;\/a&gt;&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;I hope you can get any better idea of the location.&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;Happy planning!!&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;Gonzalo Verdeja&lt;\/p&gt;","Attachments":[],"Id":1912010,"PostDate":1458246676,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">Hi!!<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">Cabo del Sol is one of the prettiest places in Cabo for weddings. Here you can see a wedding I shoot there a couple of months ago, everything turn out perfect. Wedding planner Paola and Christina from Cabo Beach weddings<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\"><a href='http:\/\/www.gvphotographer.com\/blog\/loscabosweddings' class='bbc_url' title='External link' rel='nofollow external'>www.gvphotographer.com\/blog\/loscabosweddings<\/a><\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">I hope you can get any better idea of the location.<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">Happy planning!!<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">Gonzalo Verdeja<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"info@artncolors.com","IpAddress":"189.176.187.29","GroupId":42,"GroupName":"Sr. Member","JoinDate":1258572501,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223381.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"GVphotographer","Id":223381,"Name":"GVphotographer","IsOnline":false}}],"Id":"78285","Title":"Cabo Del Sol Help!","LastPostDate":1458246676},"Pages":{"TotalItems":4,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
