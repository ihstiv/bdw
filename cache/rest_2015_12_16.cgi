{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":12,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":1057,"MovedTo":null,"MovedOn":0,"FirstPostId":1903550,"Rating":0,"RatingHits":0,"Starter":{"Id":284587,"Name":"hswerdy","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1440697409,"LastPoster":{"Id":285543,"Name":"Mrsloiseau","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1903550,"PostDate":1440697409,"PostContent":"I just got engaged to the man I love after dating 5 years and shooting for a June 2016 wedding!\u00a0I...","Author":{"Signature":"","Email":"heather_swerdlik@hotmail.com","IpAddress":"152.131.10.2","GroupId":39,"GroupName":"Newbie","JoinDate":1440696408,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"hswerdy","Id":284587,"Name":"hswerdy","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"152.131.10.2","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79540,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"b4037db605f5d0202ac50d5c0c80b83f","RawContent":"&lt;p&gt;I just got engaged to the man I love after dating 5 years and shooting for a June 2016 wedding!&amp;nbsp;I&#039;m finding the wedding planning process to be a&amp;nbsp;bit stressful! I guess I was expecting something different. lol...&amp;nbsp;All of the decisions...I am just completely overwhelmed. I don&#039;t even know where to start...Does anyone have any good advice? We really want to keep it simple and small...like 20 people, destination wedding.&amp;nbsp; We&amp;nbsp;were finding&amp;nbsp;all the venues near us have minimums that we will not be able to reach with such a small party. There are so many choices--trying to take into account budget for guests to attend, including his 3 kids (family friendly) in the wedding, and his side of the family is LDS and mine isn&#039;t...which mostly just effects alcohol...I don&#039;t want to offend anyone but at the same time I definitely want to have a few drinks! lol. I feel like I am back to square one after contacting many venues near me and finding that our wedding is just too small which is why a destination would be perfect for us. I have tried looking for wedding checklists anything too helpful yet.&amp;nbsp;I would appreciate any advice . Thanks all!&lt;\/p&gt;","Attachments":[],"Id":1903550,"PostDate":1440697409,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I just got engaged to the man I love after dating 5 years and shooting for a June 2016 wedding!\u00a0I'm finding the wedding planning process to be a\u00a0bit stressful! I guess I was expecting something different. lol...\u00a0All of the decisions...I am just completely overwhelmed. I don't even know where to start...Does anyone have any good advice? We really want to keep it simple and small...like 20 people, destination wedding.\u00a0 We\u00a0were finding\u00a0all the venues near us have minimums that we will not be able to reach with such a small party. There are so many choices--trying to take into account budget for guests to attend, including his 3 kids (family friendly) in the wedding, and his side of the family is LDS and mine isn't...which mostly just effects alcohol...I don't want to offend anyone but at the same time I definitely want to have a few drinks! lol. I feel like I am back to square one after contacting many venues near me and finding that our wedding is just too small which is why a destination would be perfect for us. I have tried looking for wedding checklists anything too helpful yet.\u00a0I would appreciate any advice . Thanks all!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"heather_swerdlik@hotmail.com","IpAddress":"152.131.10.2","GroupId":39,"GroupName":"Newbie","JoinDate":1440696408,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"hswerdy","Id":284587,"Name":"hswerdy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"177.237.80.72","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79540,"EditedBy":"<strong>Edited by Moments That Matter, 27 August 2015 - 12:22 PM.<\/strong>","EditDate":1440706947,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"0b109c45ebc2655b75e3e7e117f9376e","RawContent":"&lt;p&gt;Welcome to our forum community hswerdy and Congrats on your upcoming dw!!! you&#039;ve come to the right place for lots of info, advice, suggestions and support from everyone here, so well done on getting off to a great start already :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Wishing you best of luck in finding the answers you&#039;re looking for and creating the most wonderful wedding day celebration - Ever!!! cheers, team mtm :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-mia1-1.xx.fbcdn.net\/hphotos-xpf1\/t31.0-8\/10014050_10152285892509487_156542042_o.jpg\" alt=\"10014050_10152285892509487_156542042_o.j\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;....oh yes and ......no, wedding planning doesn&#039;t suck - it&#039;s EXCITING!!! and so FUN :)&lt;\/p&gt;","Attachments":[],"Id":1903578,"PostDate":1440706896,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome to our forum community hswerdy and Congrats on your upcoming dw!!! you've come to the right place for lots of info, advice, suggestions and support from everyone here, so well done on getting off to a great start already <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Wishing you best of luck in finding the answers you're looking for and creating the most wonderful wedding day celebration - Ever!!! cheers, team mtm <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-mia1-1.xx.fbcdn.net\/hphotos-xpf1\/t31.0-8\/10014050_10152285892509487_156542042_o.jpg\" alt=\"10014050_10152285892509487_156542042_o.j\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>....oh yes and ......no, wedding planning doesn't suck - it's EXCITING!!! and so FUN <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280210660,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.113.222.142","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79540,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"d97457078464921b3b5b15e3a4ae174e","RawContent":"&lt;p&gt;I feel the same way . We want to have our wedding in St Thomas but I want the best hotel and not for sure which one&lt;\/p&gt;\n&lt;p&gt;to choose. I am so over all this that i dont know where to go next. &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1903600,"PostDate":1440720490,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I feel the same way . We want to have our wedding in St Thomas but I want the best hotel and not for sure which one<\/p>\n<p>to choose. I am so over all this that i dont know where to go next. \u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lori.yepez@aa.com","IpAddress":"173.74.136.107","GroupId":39,"GroupName":"Newbie","JoinDate":1440294410,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"lorishultz2016","Id":284536,"Name":"lorishultz2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.146.146.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79540,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":5,"IsLiked":false,"PostKey":"c328a9811e8af83ad985f755b808fb24","RawContent":"Welcome and congrats. \n\nI can assure you almost all brides on here will agree - picking a resort is the hardest part. It&#039;s stressful. \n\n\nI recommend you make a must have list and a price point you are comfortable to pay and\/or are comfortable for your guests to pay. If you are firm on a location that helps too. \n\n\nThen I suggest you get yourself a good travel agent. They will be your best friend.  They will be able to help you find resorts that meet your wish list and then help you narrow down so you can pick one!! They can also help get you wedding package info if you struggle on your own (some resorts are better than others) then of course they can do all your bookings for flight\/hotel etc.  \n\n\nI think finding a travel agent is your first step!!!\n\n\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1903602,"PostDate":1440721555,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Welcome and congrats. <br>\nI can assure you almost all brides on here will agree - picking a resort is the hardest part. It's stressful. <br><br>\nI recommend you make a must have list and a price point you are comfortable to pay and\/or are comfortable for your guests to pay. If you are firm on a location that helps too. <br><br>\nThen I suggest you get yourself a good travel agent. They will be your best friend.  They will be able to help you find resorts that meet your wish list and then help you narrow down so you can pick one!! They can also help get you wedding package info if you struggle on your own (some resorts are better than others) then of course they can do all your bookings for flight\/hotel etc.  <br><br>\nI think finding a travel agent is your first step!!!<br><br><br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399428602,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"199.126.252.6","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79540,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"aa5bbf4a3a0f62b76519613ccd2e7354","RawContent":"&lt;p&gt;Congrats! I agree that a good TA is your first step, he\/she will be able to steer you in the right direction. I&#039;d say that with a small wedding, your biggest stress factor will come from finding a resort, but trust me, it gets easier after that ;). If you want a simple wedding, DW is the way to go! You can go as simple or as complicated as you want :D&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Best of luck!!&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1903604,"PostDate":1440724102,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats! I agree that a good TA is your first step, he\/she will be able to steer you in the right direction. I'd say that with a small wedding, your biggest stress factor will come from finding a resort, but trust me, it gets easier after that <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/>. If you want a simple wedding, DW is the way to go! You can go as simple or as complicated as you want <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/biggrin.png' class='bbc_emoticon' alt=':D' \/>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Best of luck!!\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<br><p><a data-ipb='nomediaparse' href='http:\/\/www.TickerFactory.com\/'><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;31;484\/st\/20150813\/e\/Wedding+time%21+\/dt\/-2\/k\/b92c\/event.png\" alt=\"event.png\"><\/a><\/p>\n<p style=\"text-align:center;\">\u00a0<\/p>\n<p style=\"text-align:center;\">\u00a0","Email":"sblopezb@gmail.com","IpAddress":"172.219.193.22","GroupId":42,"GroupName":"Sr. Member","JoinDate":1359763104,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265511.jpg?_r=1442890536","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"TinkerSofi","Id":265511,"Name":"TinkerSofi","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.101.80.79","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79540,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"50a7c19fb65b8495f557907568b06769","RawContent":"&lt;p&gt;I will chime in with the other two brides on the travel agent. I see you&#039;re both in the US. We have both canadian and US brides to be here, but travel packages for the most part are structured a bit differently in both countries. The owners of this site - Wright Travel - are destination wedding experts! A great TA will allow you to focus on your wedding planning while they assist your guests with their hotel bookings and flights. The other thing too, some resorts offer perks for groups. A travel agent will be able to identify whether or not you might qualify for little extras or not so absolutely worth looking into it. You can contact Wright Travel through this link:\t &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/wrighttravelagency.com\/inquiry\/&#039;&gt;http:\/\/wrighttravelagency.com\/inquiry\/&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck!&lt;\/p&gt;","Attachments":[],"Id":1903612,"PostDate":1440732225,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I will chime in with the other two brides on the travel agent. I see you're both in the US. We have both canadian and US brides to be here, but travel packages for the most part are structured a bit differently in both countries. The owners of this site - Wright Travel - are destination wedding experts! A great TA will allow you to focus on your wedding planning while they assist your guests with their hotel bookings and flights. The other thing too, some resorts offer perks for groups. A travel agent will be able to identify whether or not you might qualify for little extras or not so absolutely worth looking into it. You can contact Wright Travel through this link:\u00a0\u00a0\u00a0\u00a0 <a href='http:\/\/wrighttravelagency.com\/inquiry\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/wrighttravelagency.com\/inquiry\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Good luck!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283458999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"200.79.251.123","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79540,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"2f93977da336f6af6317f00871b71a99","RawContent":"[quote name=\"hswerdy\" post=\"1903550\" timestamp=\"1440697409\"]\nI just got engaged to the man I love after dating 5 years and shooting for a June 2016 wedding! I&#039;m finding the wedding planning process to be a bit stressful! I guess I was expecting something different. lol... All of the decisions...I am just completely overwhelmed. I don&#039;t even know where to start...Does anyone have any good advice? We really want to keep it simple and small...like 20 people, destination wedding.  We were finding all the venues near us have minimums that we will not be able to reach with such a small party. There are so many choices--trying to take into account budget for guests to attend, including his 3 kids (family friendly) in the wedding, and his side of the family is LDS and mine isn&#039;t...which mostly just effects alcohol...I don&#039;t want to offend anyone but at the same time I definitely want to have a few drinks! lol. I feel like I am back to square one after contacting many venues near me and finding that our wedding is just too small which is why a destination would be perfect for us. I have tried looking for wedding checklists anything too helpful yet. I would appreciate any advice . Thanks all![\/quote]@[member=\"hswerdy\"] I am telling you wedding planning does not suck, in fact with the right people such TA , wedding planners you can kick overwhelmed in the bud :)   I get this question from tons of brides here you will be surprise how many locations can work with what you are looking for.  Pick a destination, then move from there. \n\none step at the time\n\nHappy Planning\nJoyce","Attachments":[],"Id":1903628,"PostDate":1440738598,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>hswerdy, on 27 August 2015 - 09:43 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>I just got engaged to the man I love after dating 5 years and shooting for a June 2016 wedding!\u00a0I'm finding the wedding planning process to be a\u00a0bit stressful! I guess I was expecting something different. lol...\u00a0All of the decisions...I am just completely overwhelmed. I don't even know where to start...Does anyone have any good advice? We really want to keep it simple and small...like 20 people, destination wedding.\u00a0 We\u00a0were finding\u00a0all the venues near us have minimums that we will not be able to reach with such a small party. There are so many choices--trying to take into account budget for guests to attend, including his 3 kids (family friendly) in the wedding, and his side of the family is LDS and mine isn't...which mostly just effects alcohol...I don't want to offend anyone but at the same time I definitely want to have a few drinks! lol. I feel like I am back to square one after contacting many venues near me and finding that our wedding is just too small which is why a destination would be perfect for us. I have tried looking for wedding checklists anything too helpful yet.\u00a0I would appreciate any advice . Thanks all!<\/p>\n<\/div>\n<\/div><\/div>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"284587\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/284587-hswerdy\/' title='Member profile'><span itemprop=\"name\">hswerdy<\/span><\/a> I am telling you wedding planning does not suck, in fact with the right people such TA , wedding planners you can kick overwhelmed in the bud <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> \u00a0 I get this question from tons of brides here you will be surprise how many locations can work with what you are looking for. \u00a0Pick a destination, then move from there.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>one step at the time<\/p>\n<p>\u00a0<\/p>\n<p>Happy Planning<\/p>\n<p>Joyce<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"Dream Weddings Riviera Maya- We pay attention to your wishes and coordinate closely with you to ensure your wedding or event is planned to perfection!<br \/>\n<br \/>\n<span style='color: rgb(40,40,40)'><span style='font-family: arial'><span style='font-size: 12px;'>Dream Weddings Riviera Maya<\/span><\/span><\/span><br \/>\n<span style='font-family: arial'><span style='font-size: 12px;'>weddingsinplayadelcarmen@gmail.com<\/span><\/span><br \/>\n<a class='bbc_url' href='http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html'>http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html<\/a><br \/>\n<br \/>\n<span style='color: rgb(40,40,40)'><span style='font-family: arial'><span style='font-size: 12px;'>Happy Planning!<\/span><\/span><\/span><br \/>\n<span style='color: rgb(40,40,40)'><span style='font-family: arial'><span style='font-size: 12px;'>Joyce<\/span><\/span><\/span>","Email":"weddingsinplayadelcarmen@gmail.com","IpAddress":"187.252.44.28","GroupId":84,"GroupName":"Insiders w\/ Articles","JoinDate":1326854387,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250090.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"dreamweddings","Id":250090,"Name":"dreamweddings","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.118.235.207","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79540,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"42dbf0852d717017980d6c13d8b0fe85","RawContent":"@[member=\"hswerdy\"] I&#039;m new at planning, too. For me, I&#039;m too excited to think that it will suck. I think it will be fun to plan most of the time, and it&#039;ll take off the stress of every detail of a local wedding. I know that there will be some stress with picking the perfect venue and resort (I&#039;m a little picky) and handling my group, and budget. I&#039;m planning a really small wedding too, like maybe 20 people. I started planning a local wedding and the little details, then I thought, screw it; we can&#039;t afford it and I&#039;ll get overwhelmed, and probably obsessive, haha (though I&#039;m definitely not a bridezilla). Now planning a DW is so much easier. All I have to do is communicate and drink a sit back and drink a cocktail, lol. Well, good luck with your planning, and feel free to ask around for questions and advice. I&#039;m in early stages planning too :)","Attachments":[],"Id":1903721,"PostDate":1440823675,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"284587\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/284587-hswerdy\/' title='Member profile'><span itemprop=\"name\">hswerdy<\/span><\/a> I'm new at planning, too. For me, I'm too excited to think that it will suck. I think it will be fun to plan most of the time, and it'll take off the stress of every detail of a local wedding. I know that there will be some stress with picking the perfect venue and resort (I'm a little picky) and handling my group, and budget. I'm planning a really small wedding too, like maybe 20 people. I started planning a local wedding and the little details, then I thought, screw it; we can't afford it and I'll get overwhelmed, and probably obsessive, haha (though I'm definitely not a bridezilla). Now planning a DW is so much easier. All I have to do is communicate and drink a sit back and drink a cocktail, lol. Well, good luck with your planning, and feel free to ask around for questions and advice. I'm in early stages planning too <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jrae2958@yahoo.com","IpAddress":"104.59.137.216","GroupId":39,"GroupName":"Newbie","JoinDate":1440021820,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284488.jpg?_r=1440023025","PhotoWidth":200,"PhotoHeight":170,"PhotoType":"custom"},"FormattedName":"jackyrae","Id":284488,"Name":"jackyrae","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.179.187.201","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79540,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"242cc2216f3a26f180de1c3fb1e7c5a6","RawContent":"&lt;p&gt;I will tell you that planning events is part of my job - but even being an experienced event planner I sure did not love any part of the planning process! It felt like a series of chores to me and I resented it a little bit because most of my spare time went to wedding planning instead of doing some of the other things I enjoy in life (and we really kept it relatively simple)! I was really ready for the planning to be done when it came time. I would give anything to do the wedding week again, but I would not want to go through the planning part again!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;So don&#039;t feel bad if you feel that way! It is worth it to have the event you and your fianc\u00e9 want - and as long as you keep focused on what is important to the two of you, you&#039;ll be fine! And this forum can help keep you sane along the way.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Cheers!&lt;\/p&gt;","Attachments":[],"Id":1903746,"PostDate":1440956285,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I will tell you that planning events is part of my job - but even being an experienced event planner I sure did not love any part of the planning process! It felt like a series of chores to me and I resented it a little bit because most of my spare time went to wedding planning instead of doing some of the other things I enjoy in life (and we really kept it relatively simple)! I was really ready for the planning to be done when it came time. I would give anything to do the wedding week again, but I would not want to go through the planning part again!<\/p>\n<p>\u00a0<\/p>\n<p>So don't feel bad if you feel that way! It is worth it to have the event you and your fianc\u00e9 want - and as long as you keep focused on what is important to the two of you, you'll be fine! And this forum can help keep you sane along the way.<\/p>\n<p>\u00a0<\/p>\n<p>Cheers!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rebecca.shaffer@gmail.com","IpAddress":"159.53.174.144","GroupId":3,"GroupName":"Member","JoinDate":1403116087,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"beckys98","Id":278581,"Name":"beckys98","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"123.236.125.107","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79540,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9b3c6cda539bc6e73559374169b6d136","RawContent":"Hi, I was in the same situation a year ago and was recommended to a great wedding planner who really helped me out and was not too expensive either. If you want you can reach out for them at events at proudlypresents dot ca  i.e events@proudlypresents.ca or let me know and I can refer them to you. She will do initial  consultations without obligations, and if you guys like her ideas and suggestions, then you can move forward from there.  \n\n\nSent from my Nexus 5 using Tapatalk","Attachments":[],"Id":1903814,"PostDate":1441069756,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi, I was in the same situation a year ago and was recommended to a great wedding planner who really helped me out and was not too expensive either. If you want you can reach out for them at events at proudlypresents dot ca  i.e events@proudlypresents.ca or let me know and I can refer them to you. She will do initial  consultations without obligations, and if you guys like her ideas and suggestions, then you can move forward from there.  <br><br>\nSent from my Nexus 5 using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"harleyball@gmail.com","IpAddress":"123.236.125.107","GroupId":3,"GroupName":"Member","JoinDate":1441069217,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"harleyball","Id":284633,"Name":"harleyball","IsOnline":false}}],"Id":"79540","Title":"Tell Me Wedding Planning Doesn't Suck....","LastPostDate":1449899125},"Pages":{"TotalItems":12,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
