{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":1,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":0,"MovedTo":null,"MovedOn":0,"FirstPostId":1908398,"Rating":0,"RatingHits":0,"Starter":{"Id":285602,"Name":"MissWest","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1450245778,"LastPoster":{"Id":285602,"Name":"MissWest","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1908398,"PostDate":1450245778,"PostContent":"Hello everyone my name is Shaneque and I recently got engaged in August of this year. I was plann...","Author":{"Signature":"","Email":"annalee2913@gmail.com","IpAddress":"104.229.187.230","GroupId":39,"GroupName":"Newbie","JoinDate":1450245462,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"MissWest","Id":285602,"Name":"MissWest","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"104.229.187.230","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79797,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6b8976a3dc8009135ed6503c68d01946","RawContent":"Hello everyone my name is Shaneque and I recently got engaged in August of this year. I was planning a traditional wedding but then a coworker told me about his destination wedding and the price of it was half the reception fee. I went researching and tried a lady who does the planning but got discouraged today once she sent me pricing options for hotels for my guest. I mean is 600-700 the normal range for 3 night stays? I thought that was ridiculous. Also ladies if you have any tips or recommendations please let me know. If you planned your destination wedding on your own please fill me in. \n\n\n\nSincerely, \n\n\nA Newbie","Attachments":[],"Id":1908398,"PostDate":1450245778,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hello everyone my name is Shaneque and I recently got engaged in August of this year. I was planning a traditional wedding but then a coworker told me about his destination wedding and the price of it was half the reception fee. I went researching and tried a lady who does the planning but got discouraged today once she sent me pricing options for hotels for my guest. I mean is 600-700 the normal range for 3 night stays? I thought that was ridiculous. Also ladies if you have any tips or recommendations please let me know. If you planned your destination wedding on your own please fill me in. <br><br><br>\nSincerely, <br><br>\nA Newbie \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"annalee2913@gmail.com","IpAddress":"104.229.187.230","GroupId":39,"GroupName":"Newbie","JoinDate":1450245462,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"MissWest","Id":285602,"Name":"MissWest","IsOnline":false}}],"Id":"79797","Title":"Discouraged And Confused","LastPostDate":1450245778},"Pages":{"TotalItems":1,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
