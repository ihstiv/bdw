Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":6,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":863,"MovedTo":null,"MovedOn":0,"FirstPostId":1873916,"Rating":0,"RatingHits":0,"Starter":{"Id":279855,"Name":"gatortot","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279855.jpg?_r=1410976115","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"IsOnline":false},"StartDate":1412171152,"LastPoster":{"Id":279411,"Name":"Mangosong","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279411.jpg?_r=1408152053","PhotoWidth":200,"PhotoHeight":180,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":60,"Preview":{"Id":1873916,"PostDate":1412171152,"PostContent":"Hi Ladies! \u00a0 This is my first post.\u00a0 I just wanted to share how I will be asking my bridesmaids,...","Author":{"Signature":"","Email":"ajjanicek@gmail.com","IpAddress":"98.103.250.164","GroupId":39,"GroupName":"Newbie","JoinDate":1410875899,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279855.jpg?_r=1410976115","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"gatortot","Id":279855,"Name":"gatortot","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"98.103.250.164","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78128,"EditedBy":"<strong>Edited by gatortot, 01 October 2014 - 05:46 AM.<\/strong>","EditDate":1412171213,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"7931a39e3220a6e4557af3212fe3582b","RawContent":"&lt;p&gt;Hi Ladies!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;This is my first post.&amp;nbsp; I just wanted to share how I will be asking my bridesmaids, since I am pleased with how it turned out!&amp;nbsp; I wanted to give them something special for the money they will be spending to attend.&amp;nbsp; Most of their husbands\/bfs are groomsmen too, and my fiance isn&#039;t doing anything special to ask them.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I ended up assembling a box containing a funny luggage tag that says \"be my senorita?\", a 2 year pocket calendar with the dates marked along with special dates in their lives - birthdays, anniversaries, upcoming weddings etc. and phone numbers of the travel agent and the bridal party in a little note section the calendar has,&amp;nbsp; a mini bottle of champagne and a starfish!&amp;nbsp; It cost me about $20 per bridesmaid.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;For the calendar I used a template on Microsoft Publisher but i followed the directions from this website: &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/diyfrugalbride.blogspot.com\/2013\/10\/how-to-make-your-bridesmaids-planner_24.html&#039;&gt;http:\/\/diyfrugalbride.blogspot.com\/2013\/10\/how-to-make-your-bridesmaids-planner_24.html&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;I will attach my template as well.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;Supplies&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;Blank Calendar -- &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.amazon.com\/gp\/product\/B00D3XH716\/ref=oh_aui_detailpage_o00_s00?ie=UTF8&amp;amp;psc=1&#039;&gt;http:\/\/www.amazon.com\/gp\/product\/B00D3XH716\/ref=oh_aui_detailpage_o00_s00?ie=UTF8&amp;amp;psc=1&lt;\/a&gt; ($35)&lt;\/p&gt;\n&lt;p&gt;Funny luggage tags -- &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.amazon.com\/s\/ref=nb_sb_noss_1?url=search-alias%3Daps&amp;amp;field-keywords=anne%20taintor%20luggage&#039;&gt;http:\/\/www.amazon.com\/s\/ref=nb_sb_noss_1?url=search-alias%3Daps&amp;amp;field-keywords=anne%20taintor%20luggage&lt;\/a&gt; ($63)&lt;\/p&gt;\n&lt;p&gt;Mini Champagne ($20)&lt;\/p&gt;\n&lt;p&gt;Pack of 6 starfish - ($9.99 @ Michael&#039;s - I used a 40% off = $6.00 total)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I can email pictures if anyone needs, since I know I can never open attachments.&amp;nbsp;&lt;\/p&gt;","Attachments":[{"Id":29610,"Name":"photo2.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_10_2014\/post-279855-0-30441700-1412171079.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_10_2014\/post-279855-0-30441700-1412171079_thumb.jpg","Width":900,"Height":1200},{"Id":29609,"Name":"photo6.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_10_2014\/post-279855-0-45162400-1412171071.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_10_2014\/post-279855-0-45162400-1412171071_thumb.jpg","Width":900,"Height":1200},{"Id":29608,"Name":"photo5.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_10_2014\/post-279855-0-22691700-1412171061.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_10_2014\/post-279855-0-22691700-1412171061_thumb.jpg","Width":900,"Height":1200},{"Id":29607,"Name":"photo4.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_10_2014\/post-279855-0-29426500-1412171046.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_10_2014\/post-279855-0-29426500-1412171046_thumb.jpg","Width":900,"Height":1200},{"Id":29606,"Name":"photo3.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_10_2014\/post-279855-0-87108100-1412171025.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_10_2014\/post-279855-0-87108100-1412171025_thumb.jpg","Width":900,"Height":1200},{"Id":29605,"Name":"photo1(1).jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_10_2014\/post-279855-0-92122400-1412170941.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_10_2014\/post-279855-0-92122400-1412170941_thumb.jpg","Width":1000,"Height":750}],"Id":1873916,"PostDate":1412171152,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Ladies!<\/p>\n<p>\u00a0<\/p>\n<p>This is my first post.\u00a0 I just wanted to share how I will be asking my bridesmaids, since I am pleased with how it turned out!\u00a0 I wanted to give them something special for the money they will be spending to attend.\u00a0 Most of their husbands\/bfs are groomsmen too, and my fiance isn't doing anything special to ask them.<\/p>\n<p>\u00a0<\/p>\n<p>I ended up assembling a box containing a funny luggage tag that says \"be my senorita?\", a 2 year pocket calendar with the dates marked along with special dates in their lives - birthdays, anniversaries, upcoming weddings etc. and phone numbers of the travel agent and the bridal party in a little note section the calendar has,\u00a0 a mini bottle of champagne and a starfish!\u00a0 It cost me about $20 per bridesmaid.<\/p>\n<p>\u00a0<\/p>\n<p>For the calendar I used a template on Microsoft Publisher but i followed the directions from this website: <a href='http:\/\/diyfrugalbride.blogspot.com\/2013\/10\/how-to-make-your-bridesmaids-planner_24.html' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/diyfrugalbrid...planner_24.html<\/a><\/p>\n<p>I will attach my template as well.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><strong>Supplies<\/strong><\/p>\n<p>Blank Calendar -- <a href='http:\/\/www.amazon.com\/gp\/product\/B00D3XH716\/ref=oh_aui_detailpage_o00_s00?ie=UTF8&psc=1' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.amazon.co...0?ie=UTF8&psc=1<\/a> ($35)<\/p>\n<p>Funny luggage tags -- <a href='http:\/\/www.amazon.com\/s\/ref=nb_sb_noss_1?url=search-alias%3Daps&field-keywords=anne%20taintor%20luggage' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.amazon.co...taintor luggage<\/a> ($63)<\/p>\n<p>Mini Champagne ($20)<\/p>\n<p>Pack of 6 starfish - ($9.99 @ Michael's - I used a 40% off = $6.00 total)<\/p>\n<p>\u00a0<\/p>\n<p>I can email pictures if anyone needs, since I know I can never open attachments.\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ajjanicek@gmail.com","IpAddress":"98.103.250.164","GroupId":39,"GroupName":"Newbie","JoinDate":1410875899,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279855.jpg?_r=1410976115","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"gatortot","Id":279855,"Name":"gatortot","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"192.35.35.35","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78128,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6d66f5342053d9f29203c00ffcad3bf4","RawContent":"&lt;p&gt;Really cute!!! I just sent mine a text message to ask them!!! I&#039;m horrible!!! LOL I should probably figure out at least one DIY project.&lt;\/p&gt;","Attachments":[],"Id":1873933,"PostDate":1412179961,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Really cute!!! I just sent mine a text message to ask them!!! I'm horrible!!! LOL I should probably figure out at least one DIY project.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"keishaandjimmy@gmail.com","IpAddress":"192.31.106.34","GroupId":40,"GroupName":"Jr. Member","JoinDate":1409091107,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"puravida2015","Id":279580,"Name":"puravida2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.41.59","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78128,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"197d4e3e26ef1a7dffdc7f7366ad2cf4","RawContent":"Love it! great job!\n[quote name=\"puravida2015\" post=\"1873933\" timestamp=\"1412179961\"]\nReally cute!!! I just sent mine a text message to ask them!!! I&#039;m horrible!!! LOL I should probably figure out at least one DIY project.[\/quote]\nDon&#039;t feel bad, a lot of us did!","Attachments":[],"Id":1873987,"PostDate":1412205135,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Love it! great job!<\/p>\n<br \/><p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>puravida2015, on 01 October 2014 - 08:12 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Really cute!!! I just sent mine a text message to ask them!!! I'm horrible!!! LOL I should probably figure out at least one DIY project.<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>Don't feel bad, a lot of us did!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399428602,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"96.227.239.208","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78128,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"fc2f84733cdd8815f649ba27f06be77a","RawContent":"@[member=\"calgarybride2015\"] and the worst part is I didn&#039;t really ask. I just said your going to be my MOH, right?  Lol I&#039;ll at least make sure they get nice gifts. :)","Attachments":[],"Id":1873989,"PostDate":1412208312,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"277873\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277873-calgarybride2015\/' title='Member profile'><span itemprop=\"name\">calgarybride2015<\/span><\/a> and the worst part is I didn't really ask. I just said your going to be my MOH, right?  Lol I'll at least make sure they get nice gifts. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"keishaandjimmy@gmail.com","IpAddress":"192.31.106.34","GroupId":40,"GroupName":"Jr. Member","JoinDate":1409091107,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"puravida2015","Id":279580,"Name":"puravida2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.76.172.36","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78128,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7817d7d78a852317515c8225ed57bc99","RawContent":"@[member=\"gatortot\"] that is awesome! Thanks for sharing!\n\nI&#039;ve been engaged only a week so haven&#039;t even asked my bridesmaids or moh yet! Lol but was thinking of making a cute diy label to put over a wine bottle to try to surprise them in a cute way saying \"will you be my bridesmaid!\" ?? But not decided yet..\n\nOne if my to be bridesmaids is overseas so we can only chat on Skype or face time so I&#039;ve been trying to think of a fun way to ask her..?","Attachments":[],"Id":1874636,"PostDate":1412718377,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"279855\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/279855-gatortot\/' title='Member profile'><span itemprop=\"name\">gatortot<\/span><\/a> that is awesome! Thanks for sharing!<br>\nI've been engaged only a week so haven't even asked my bridesmaids or moh yet! Lol but was thinking of making a cute diy label to put over a wine bottle to try to surprise them in a cute way saying \"will you be my bridesmaid!\" ?? But not decided yet..<br>\nOne if my to be bridesmaids is overseas so we can only chat on Skype or face time so I've been trying to think of a fun way to ask her..?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#cc6666;\"><span style=\"font-family:georgia, serif;\"><em>Forever can never be long enough for me, to feel like I've had long enough with you...19\/01\/2016<\/em><\/span><\/span>","Email":"kimberlydiana@hotmail.com","IpAddress":"24.76.172.36","GroupId":39,"GroupName":"Newbie","JoinDate":1412304687,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280238.png?_r=1412619945","PhotoWidth":80,"PhotoHeight":60,"PhotoType":"custom"},"FormattedName":"kimmyd2","Id":280238,"Name":"kimmyd2","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.35.40.254","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78128,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ba91a4275164f8e8ac78d156264de335","RawContent":"&lt;p&gt;@[member=\"gatortot\"] That is so cute! Especially love the luggage tags!&lt;\/p&gt;","Attachments":[],"Id":1876912,"PostDate":1414280294,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"279855\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/279855-gatortot\/' title='Member profile'><span itemprop=\"name\">gatortot<\/span><\/a> That is so cute! Especially love the luggage tags!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"wonderlandgrl3@yahoo.com","IpAddress":"75.99.50.82","GroupId":39,"GroupName":"Newbie","JoinDate":1407874186,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279411.jpg?_r=1408152053","PhotoWidth":200,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Mangosong","Id":279411,"Name":"Mangosong","IsOnline":false}}],"Id":"78128","Title":"Asking Bridesmaids - Diy!","LastPostDate":1414280294},"Pages":{"TotalItems":6,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
