{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":7,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":389,"MovedTo":null,"MovedOn":0,"FirstPostId":1825060,"Rating":0,"RatingHits":0,"Starter":{"Id":275665,"Name":"Make2dayAmazing","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275665.jpg?_r=1388951007","PhotoWidth":200,"PhotoHeight":257,"PhotoType":"custom"},"IsOnline":false},"StartDate":1389460068,"LastPoster":{"Id":279411,"Name":"Mangosong","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279411.jpg?_r=1408152053","PhotoWidth":200,"PhotoHeight":180,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":60,"Preview":{"Id":1825060,"PostDate":1389460068,"PostContent":"This may sound silly but if we want a friend to perform our symbolic ceremony instead of having s...","Author":{"Signature":"","Email":"ca.berryhill2737@gmail.com","IpAddress":"108.178.247.22","GroupId":40,"GroupName":"Jr. Member","JoinDate":1387302414,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275665.jpg?_r=1388951007","PhotoWidth":200,"PhotoHeight":257,"PhotoType":"custom"},"FormattedName":"Make2dayAmazing","Id":275665,"Name":"Make2dayAmazing","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.194.65.65","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75951,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"57bf4a25618df6bb1f2a91a267442af1","RawContent":"This may sound silly but if we want a friend to perform our symbolic ceremony instead of having someone at the resort do it (Punta Cana), do they have to do anything special before then? Thanks :)","Attachments":[],"Id":1825060,"PostDate":1389460068,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                This may sound silly but if we want a friend to perform our symbolic ceremony instead of having someone at the resort do it (Punta Cana), do they have to do anything special before then? Thanks <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ca.berryhill2737@gmail.com","IpAddress":"108.178.247.22","GroupId":40,"GroupName":"Jr. Member","JoinDate":1387302414,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275665.jpg?_r=1388951007","PhotoWidth":200,"PhotoHeight":257,"PhotoType":"custom"},"FormattedName":"Make2dayAmazing","Id":275665,"Name":"Make2dayAmazing","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.103.56.157","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75951,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"3c0694a937ac3379f01a1c256d12911f","RawContent":"&lt;p&gt;At my resort they do not, I just have to let her know so they don&#039;t worry about having someone there do it. That&#039;s in Mexico.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1825160,"PostDate":1389490524,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>At my resort they do not, I just have to let her know so they don't worry about having someone there do it. That's in Mexico.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Now Jade Bride on November 21, 2014<\/p>\n<p>Planning Thread: <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78208-amarie4713-now-jade-planning-thread\/?p=1875447'>http:\/\/www.bestdestinationwedding.com\/topic\/78208-amarie4713-now-jade-planning-thread\/?p=1875447<\/a>","Email":"amarie.harder@gmail.com","IpAddress":"68.103.56.157","GroupId":40,"GroupName":"Jr. Member","JoinDate":1378932518,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"none"},"FormattedName":"amarie4713","Id":273400,"Name":"amarie4713","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.35.40.254","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75951,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"20bcaccad995598ec915c5769c02cff5","RawContent":"&lt;p&gt;I was wondering the same thing, but we are still not sure where we are doing it.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;m not sure if you figured out the answer by now, but when I was looking into DR, it didn&#039;t seem like you could have a friend do it, even for a symbolic ceremony. Everything had to be in spanish, but could be translated. You could only have a legal ceremony on Saturdays, and Sundays were symbolic only - but still had to be in spanish.&lt;\/p&gt;","Attachments":[],"Id":1866979,"PostDate":1408163602,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I was wondering the same thing, but we are still not sure where we are doing it.<\/p>\n<p>\u00a0<\/p>\n<p>I'm not sure if you figured out the answer by now, but when I was looking into DR, it didn't seem like you could have a friend do it, even for a symbolic ceremony. Everything had to be in spanish, but could be translated. You could only have a legal ceremony on Saturdays, and Sundays were symbolic only - but still had to be in spanish.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"wonderlandgrl3@yahoo.com","IpAddress":"75.99.50.82","GroupId":39,"GroupName":"Newbie","JoinDate":1407874186,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279411.jpg?_r=1408152053","PhotoWidth":200,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Mangosong","Id":279411,"Name":"Mangosong","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.114.44.144","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75951,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e0c251043c1d289d0c942f23c9cc45ec","RawContent":"[quote name=\"Mangosong\" post=\"1866979\" timestamp=\"1408163602\"]\nI was wondering the same thing, but we are still not sure where we are doing it.\n\nI&#039;m not sure if you figured out the answer by now, but when I was looking into DR, it didn&#039;t seem like you could have a friend do it, even for a symbolic ceremony. Everything had to be in spanish, but could be translated. You could only have a legal ceremony on Saturdays, and Sundays were symbolic only - but still had to be in spanish.[\/quote]\nThat&#039;s so odd about the Spanish thing in DR since many of their local people do not speak Spanish at all- but rather Haitian (basically French). I didn&#039;t realize that they were strict about their symbolic ceremonies!","Attachments":[],"Id":1866981,"PostDate":1408164787,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Mangosong, on 15 August 2014 - 08:33 PM, said:<\/p><div class='blockquote'><div class='quote'><p>I was wondering the same thing, but we are still not sure where we are doing it.<br><br>\nI'm not sure if you figured out the answer by now, but when I was looking into DR, it didn't seem like you could have a friend do it, even for a symbolic ceremony. Everything had to be in spanish, but could be translated. You could only have a legal ceremony on Saturdays, and Sundays were symbolic only - but still had to be in spanish.<\/p><\/div><\/div>\n<br><br>\nThat's so odd about the Spanish thing in DR since many of their local people do not speak Spanish at all- but rather Haitian (basically French). I didn't realize that they were strict about their symbolic ceremonies! \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kmkwedding2016@gmail.com","IpAddress":"70.72.195.234","GroupId":38,"GroupName":"Moderators","JoinDate":1390256608,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kmk2016","Id":276231,"Name":"kmk2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.35.40.254","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75951,"EditedBy":"<strong>Edited by Mangosong, 16 August 2014 - 03:23 PM.<\/strong>","EditDate":1408231395,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"816051f8d4316d63673bf735b373665e","RawContent":"&lt;p&gt;@[member=\"kmk2016\"] the DR side is Spanish. The Haitian side is French. I didn&#039;t look into getting married in Haiti, but I assume it will be different because they are different countries.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;But even some of the Islands are split with different requirements. St. Marrten for instance, is split French and Dutch and it appears the laws and rules are different for the French vs Dutch. I don&#039;t remember why we nixed St. Marrten, but I remember being super confused by everything I looked up because some of it was geared toward Dutch and some French.&lt;\/p&gt;","Attachments":[],"Id":1867074,"PostDate":1408231369,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"276231\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/276231-kmk2016\/' title='Member profile'><span itemprop=\"name\">kmk2016<\/span><\/a> the DR side is Spanish. The Haitian side is French. I didn't look into getting married in Haiti, but I assume it will be different because they are different countries.<\/p>\n<p>\u00a0<\/p>\n<p>But even some of the Islands are split with different requirements. St. Marrten for instance, is split French and Dutch and it appears the laws and rules are different for the French vs Dutch. I don't remember why we nixed St. Marrten, but I remember being super confused by everything I looked up because some of it was geared toward Dutch and some French.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"wonderlandgrl3@yahoo.com","IpAddress":"75.99.50.82","GroupId":39,"GroupName":"Newbie","JoinDate":1407874186,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279411.jpg?_r=1408152053","PhotoWidth":200,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Mangosong","Id":279411,"Name":"Mangosong","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.114.44.144","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75951,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6449f9533473bc65a13d8eff86e3b24b","RawContent":"I realize that DR has many Spanish speaking people and it is considered their National language... I also realize Haiti is on the other side... I have travelled to DR many times.... But I was just surprised that they are strict with Spanish required for legal ceremony since every time we have travelled there many \"locals\" spoke fluent French and it was explained to us that many flee Haiti and have ultimately had generations keep the French heritage\/language while being several generations in DR.","Attachments":[],"Id":1867075,"PostDate":1408231760,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I realize that DR has many Spanish speaking people and it is considered their National language... I also realize Haiti is on the other side... I have travelled to DR many times.... But I was just surprised that they are strict with Spanish required for legal ceremony since every time we have travelled there many \"locals\" spoke fluent French and it was explained to us that many flee Haiti and have ultimately had generations keep the French heritage\/language while being several generations in DR. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kmkwedding2016@gmail.com","IpAddress":"70.72.195.234","GroupId":38,"GroupName":"Moderators","JoinDate":1390256608,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kmk2016","Id":276231,"Name":"kmk2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.35.40.254","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75951,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"826ffaf214c7bc6b56e17871f68576d3","RawContent":"&lt;p&gt;@[member=\"kmk2016\"] I looked it up on the US Embassy to DR web site, but I thought MAYBE I didn&#039;t have to have the ceremony translated into Spanish, nope. Everything has to be translated. My birth certificate has to be an translated, certified copy. Embassy no. is 809-567-7775.&lt;\/p&gt;","Attachments":[],"Id":1867547,"PostDate":1408404664,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"276231\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/276231-kmk2016\/' title='Member profile'><span itemprop=\"name\">kmk2016<\/span><\/a> I looked it up on the US Embassy to DR web site, but I thought MAYBE I didn't have to have the ceremony translated into Spanish, nope. Everything has to be translated. My birth certificate has to be an translated, certified copy. Embassy no. is 809-567-7775.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"wonderlandgrl3@yahoo.com","IpAddress":"75.99.50.82","GroupId":39,"GroupName":"Newbie","JoinDate":1407874186,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279411.jpg?_r=1408152053","PhotoWidth":200,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Mangosong","Id":279411,"Name":"Mangosong","IsOnline":false}}],"Id":"75951","Title":"Symbolic Wedding","LastPostDate":1408404664},"Pages":{"TotalItems":7,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}