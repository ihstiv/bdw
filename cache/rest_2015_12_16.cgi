{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":14,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":642,"MovedTo":null,"MovedOn":0,"FirstPostId":1862614,"Rating":0,"RatingHits":0,"Starter":{"Id":277499,"Name":"linaco80","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277499.jpg?_r=1444491199","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"StartDate":1406485001,"LastPoster":{"Id":279182,"Name":"Lia33","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279182.jpg?_r=1406769983","PhotoWidth":200,"PhotoHeight":168,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":60,"Preview":{"Id":1862614,"PostDate":1406485001,"PostContent":"Hello Girls, I keep reading a lot (covering lots of topics going on in a wedding) and want to lea...","Author":{"Signature":"<div>\u00a0<\/div>\n<div>Check my planning thread:\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79170-azul-sensatori-april-2015-wedding-many-pics-and-planning-tips\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79170-azul-sensatori-april-2015-wedding-many-pics-and-planning-tips\/<\/a><\/div>\n<div><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10765;484\/st\/20150410\/e\/Our+Wedding+\/k\/3e00\/event.png\" alt=\"event.png\"><\/div>\n<div>[\/url]<\/div>\n","Email":"tkandlina@gmail.com","IpAddress":"162.134.72.5","GroupId":40,"GroupName":"Jr. Member","JoinDate":1396881557,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277499.jpg?_r=1444491199","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"linaco80","Id":277499,"Name":"linaco80","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"76.117.93.252","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77637,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"463a64e9851685e766f2c163756f72dc","RawContent":"&lt;p&gt;Hello Girls,&lt;\/p&gt;\n&lt;p&gt;I keep reading a lot (covering lots of topics going on in a wedding) and want to learn how does the letter to my fiance and gift work prior to our ceremony or after or when? I was watching videos &amp;nbsp;and I see that the bride writes a letter and sends a gift to the groom and he does the same while they get ready for the ceremomy. I am not American and I have less knowledge as of how the tradition goes here, my fiancee is American and pretty sure he knows more than me. We are getting married in Mexico, still the tradition or some will be followed. Also if this topic has been discussed before please send me the link of the thread (i dont meant to create more and more if this is under discussion already) thanks so much!&lt;\/p&gt;","Attachments":[],"Id":1862614,"PostDate":1406485001,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello Girls,<\/p>\n<p>I keep reading a lot (covering lots of topics going on in a wedding) and want to learn how does the letter to my fiance and gift work prior to our ceremony or after or when? I was watching videos \u00a0and I see that the bride writes a letter and sends a gift to the groom and he does the same while they get ready for the ceremomy. I am not American and I have less knowledge as of how the tradition goes here, my fiancee is American and pretty sure he knows more than me. We are getting married in Mexico, still the tradition or some will be followed. Also if this topic has been discussed before please send me the link of the thread (i dont meant to create more and more if this is under discussion already) thanks so much!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div>\u00a0<\/div>\n<div>Check my planning thread:\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79170-azul-sensatori-april-2015-wedding-many-pics-and-planning-tips\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79170-azul-sensatori-april-2015-wedding-many-pics-and-planning-tips\/<\/a><\/div>\n<div><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10765;484\/st\/20150410\/e\/Our+Wedding+\/k\/3e00\/event.png\" alt=\"event.png\"><\/div>\n<div>[\/url]<\/div>\n","Email":"tkandlina@gmail.com","IpAddress":"162.134.72.5","GroupId":40,"GroupName":"Jr. Member","JoinDate":1396881557,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277499.jpg?_r=1444491199","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"linaco80","Id":277499,"Name":"linaco80","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.119.162.30","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77637,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"be1d08bda01fce1dc8fbc4e5fcf9d3d6","RawContent":"&lt;p&gt;The bride and groom often exchange gifts to be opened while getting ready. It&#039;s nice for the photographer\/videographer to capture that moment. Often, the groom gets the bride jewelry of some sort, and the bride gets the groom a watch or boudoir shots or something along those lines. And usually, there&#039;s a card where the bride and groom will write a nice letter for the other to read before the ceremony while opening the gifts&lt;\/p&gt;","Attachments":[],"Id":1862685,"PostDate":1406503808,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>The bride and groom often exchange gifts to be opened while getting ready. It's nice for the photographer\/videographer to capture that moment. Often, the groom gets the bride jewelry of some sort, and the bride gets the groom a watch or boudoir shots or something along those lines. And usually, there's a card where the bride and groom will write a nice letter for the other to read before the ceremony while opening the gifts<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Married December 19, 2014 at Beach Palace Resort in Cancun, Mexico<\/p>\n<p>\u00a0<\/p>\n<p>My Planning Thread - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/'>http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>My Wedding Review<\/p>\n<p>Part 1 - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881197'>http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881197<\/a><\/p>\n<p>Part 2 - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881590'>http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881590<\/a><\/p>\n<p>Part 3 - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881861'>http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881861<\/a><\/p>\n<p>\u00a0","Email":"lilyluu83@gmail.com","IpAddress":"174.119.162.30","GroupId":3,"GroupName":"Member","JoinDate":1395609348,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277296.jpg?_r=1421643766","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"tygrrlily","Id":277296,"Name":"tygrrlily","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"162.134.72.5","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77637,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"43c4e5729f6a502929eb1759fbb608f8","RawContent":"&lt;p&gt;@[member=\"tygrrlily\"] thank you! ALL new to me :) besides the entire planning... lots going on for a DW&lt;\/p&gt;","Attachments":[],"Id":1862749,"PostDate":1406557808,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"277296\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/277296-tygrrlily\/' title='Member profile'><span itemprop=\"name\">tygrrlily<\/span><\/a> thank you! ALL new to me <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> besides the entire planning... lots going on for a DW<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div>\u00a0<\/div>\n<div>Check my planning thread:\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79170-azul-sensatori-april-2015-wedding-many-pics-and-planning-tips\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79170-azul-sensatori-april-2015-wedding-many-pics-and-planning-tips\/<\/a><\/div>\n<div><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10765;484\/st\/20150410\/e\/Our+Wedding+\/k\/3e00\/event.png\" alt=\"event.png\"><\/div>\n<div>[\/url]<\/div>\n","Email":"tkandlina@gmail.com","IpAddress":"162.134.72.5","GroupId":40,"GroupName":"Jr. Member","JoinDate":1396881557,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277499.jpg?_r=1444491199","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"linaco80","Id":277499,"Name":"linaco80","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.114.27.189","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77637,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"161e7c4bde09692ab799366f4d38aa96","RawContent":"[quote name=\"linaco80\" post=\"1862749\" timestamp=\"1406557808\"]\n@[member=\"tygrrlily\"] thank you! ALL new to me :) besides the entire planning... lots going on for a DW[\/quote]Keep in mind, many of these ideas are things that are considered traditional for a wedding of any sort- but are not necessary if you and your FI feel they aren&#039;t \"you\". Do what seems right. My first wedding- he bought be a living room set I had my eye on that was in my home as a surprise when we got home from our honeymoon- and I got him a watch.... But this time around, my FI has expensive \"watch\" taste, and since we are paying for the wedding ourselves, we decided that we would make our gifts to one another more sentimental\/hand done... A letter that is from my FI that I read in a quiet moment before the chaos of the day starts (and before I put on my mascara haha) would mean more to me than anything... So don&#039;t worry about doing anything big! A little note, or a small gift is nice- but don&#039;t let it add to your stress! I have heard of brides just writing a simple note and adding a pair of cool socks \"in case he has cold feet\"... Which I thought was cute. \n\nI think it&#039;s just a nice way to take a quiet moment and remember why you are doing this... Cause a wedding day can be crazy busy... And it forces you to stop for a moment and be thankful for the man you are about to marry! \n\nHave fun with it and do as little or as much as feels right for you as a couple!","Attachments":[],"Id":1862751,"PostDate":1406558310,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>linaco80, on 28 July 2014 - 06:30 AM, said:<\/p><div class='blockquote'><div class='quote'><p>@<a hovercard-ref=\"member\" hovercard-id=\"277296\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/277296-tygrrlily\/' title='Member profile'><span itemprop=\"name\">tygrrlily<\/span><\/a> thank you! ALL new to me <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> besides the entire planning... lots going on for a DW<\/p><\/div><\/div>\n<br>\nKeep in mind, many of these ideas are things that are considered traditional for a wedding of any sort- but are not necessary if you and your FI feel they aren't \"you\". Do what seems right. My first wedding- he bought be a living room set I had my eye on that was in my home as a surprise when we got home from our honeymoon- and I got him a watch.... But this time around, my FI has expensive \"watch\" taste, and since we are paying for the wedding ourselves, we decided that we would make our gifts to one another more sentimental\/hand done... A letter that is from my FI that I read in a quiet moment before the chaos of the day starts (and before I put on my mascara haha) would mean more to me than anything... So don't worry about doing anything big! A little note, or a small gift is nice- but don't let it add to your stress! I have heard of brides just writing a simple note and adding a pair of cool socks \"in case he has cold feet\"... Which I thought was cute. <br><br>\nI think it's just a nice way to take a quiet moment and remember why you are doing this... Cause a wedding day can be crazy busy... And it forces you to stop for a moment and be thankful for the man you are about to marry! <br><br>\nHave fun with it and do as little or as much as feels right for you as a couple! \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kmkwedding2016@gmail.com","IpAddress":"70.72.195.234","GroupId":38,"GroupName":"Moderators","JoinDate":1390256608,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kmk2016","Id":276231,"Name":"kmk2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"142.165.85.61","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77637,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1b83f6e8aaf2f4dbad55016f3437ed28","RawContent":"I&#039;m not sure my FI would be up for this but it sounds cool...This is obviously something you would discuss with the other person cause if I do it and he doesn&#039;t he would feel bad he didn&#039;t. .","Attachments":[],"Id":1863212,"PostDate":1406695953,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm not sure my FI would be up for this but it sounds cool...This is obviously something you would discuss with the other person cause if I do it and he doesn't he would feel bad he didn't. . \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"crazycdngirl26@yahoo.ca","IpAddress":"71.17.139.242","GroupId":40,"GroupName":"Jr. Member","JoinDate":1344502838,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-258970.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":112,"PhotoType":"custom"},"FormattedName":"MJTK","Id":258970,"Name":"MJTK","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"206.223.185.220","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77637,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d8184d2ee76292791c40dc5f0e04cdd5","RawContent":"&lt;p&gt;There are no hard and fast traditions anymore. You can definitely make your own! Giving gifts to each other isn&#039;t mandatory. If it&#039;s something you&#039;ll be comfortable with, go for it. But don&#039;t think you have to do it!&lt;\/p&gt;","Attachments":[],"Id":1863247,"PostDate":1406728081,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>There are no hard and fast traditions anymore. You can definitely make your own! Giving gifts to each other isn't mandatory. If it's something you'll be comfortable with, go for it. But don't think you have to do it!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283458999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.182.39.99","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77637,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"28bd3385e0a01d7b7ef518fc2dca1b07","RawContent":"I am definitely writing a heartfelt letter to my groom before the ceremony. I have not decided on a gift (because he&#039;s super picky), but I figured with the letter he will be grateful.","Attachments":[],"Id":1863575,"PostDate":1406793481,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I am definitely writing a heartfelt letter to my groom before the ceremony. I have not decided on a gift (because he's super picky), but I figured with the letter he will be grateful. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"Good Luck <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>","Email":"ms.tatiana.rivera@gmail.com","IpAddress":"50.182.39.99","GroupId":40,"GroupName":"Jr. Member","JoinDate":1403762681,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Tatimrivera","Id":278701,"Name":"Tatimrivera","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.8.177.213","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77637,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"538ce042a1fa10cfe88b686fcb556bcc","RawContent":"&lt;p&gt;My man is the worst gift giver! Engagement ring included! So, this is one thing we will not be doing. I am down for a cute little note to be read prior to the ceremony. That sounds very touching, before make-up of course!&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1863867,"PostDate":1406907304,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>My man is the worst gift giver! Engagement ring included! So, this is one thing we will not be doing. I am down for a cute little note to be read prior to the ceremony. That sounds very touching, before make-up of course!\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Love over 50 is still LOVE!!!<\/p>\n<p>Invitations out! RSVPs in<\/p>\n<p>Us, them (bridal party), + 48 guests!!\u00a0<\/p>\n<p>\u00a0","Email":"dldincali@yahoo.com","IpAddress":"173.8.177.213","GroupId":40,"GroupName":"Jr. Member","JoinDate":1399064137,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277818.jpg?_r=1408642386","PhotoWidth":200,"PhotoHeight":143,"PhotoType":"custom"},"FormattedName":"VegasBride121314","Id":277818,"Name":"VegasBride121314","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.67.117.232","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77637,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8a8c28068d8efab7a3906cd07a4dcee5","RawContent":"Our 4 year old delivers both our gifts to each other!! He got gifts from daddy to mommy and then took daddy&#039;s to him!!\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1864365,"PostDate":1407114569,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Our 4 year old delivers both our gifts to each other!! He got gifts from daddy to mommy and then took daddy's to him!!<a class='resized_img' rel='lightbox[1864365]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2014\/post-277904-140711456624.jpg\" title=\"ImageUploadedByTapatalk1407114567.524075.jpg - Size: 87.36KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_08_2014\/post-277904-140711456624.jpg\" class='bbc_img linked-image' alt=\"ImageUploadedByTapatalk1407114567.524075.jpg\" \/><\/a>\n\n<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"amandambeals@yahoo.com","IpAddress":"99.67.117.232","GroupId":39,"GroupName":"Newbie","JoinDate":1399602155,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277904.jpg?_r=1399604134","PhotoWidth":200,"PhotoHeight":250,"PhotoType":"custom"},"FormattedName":"abeals11388","Id":277904,"Name":"abeals11388","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.157.233.83","IsFirstPost":false,"IsQueued":false,"IsVisi