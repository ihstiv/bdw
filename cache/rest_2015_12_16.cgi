Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":14,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":1494,"MovedTo":null,"MovedOn":0,"FirstPostId":1899440,"Rating":0,"RatingHits":0,"Starter":{"Id":276833,"Name":"peachykeen159","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1435451376,"LastPoster":{"Id":284905,"Name":"IggyPop","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":60,"Preview":{"Id":1899440,"PostDate":1435451376,"PostContent":"How much are you guys planning on spending on your bridesmaids? I feel like because we're having...","Author":{"Signature":"","Email":"penjani@hotmail.com","IpAddress":"71.17.38.13","GroupId":39,"GroupName":"Newbie","JoinDate":1393175102,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"peachykeen159","Id":276833,"Name":"peachykeen159","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.17.38.13","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79328,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"d1e4ae8729e0a73f0b61e092ae3d9565","RawContent":"&lt;p&gt;How much are you guys planning on spending on your bridesmaids? I feel like because we&#039;re having a destination wedding and the wedding party is spending money to join us, we need to spending a little more.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1899440,"PostDate":1435451376,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>How much are you guys planning on spending on your bridesmaids? I feel like because we're having a destination wedding and the wedding party is spending money to join us, we need to spending a little more.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"penjani@hotmail.com","IpAddress":"71.17.38.13","GroupId":39,"GroupName":"Newbie","JoinDate":1393175102,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"peachykeen159","Id":276833,"Name":"peachykeen159","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.146.146.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79328,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"70acef16df98ac85dd18fbcb8c774cd0","RawContent":"I spent about $80 per girl on their gifts and I also paid $40&#039;of each of their dresses.  I wish I could have done more but the girls were shocked and super happy with it.  Do what you can :) \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1899441,"PostDate":1435461307,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I spent about $80 per girl on their gifts and I also paid $40'of each of their dresses.  I wish I could have done more but the girls were shocked and super happy with it.  Do what you can <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399428602,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"64.53.250.35","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79328,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"f0306f17750d41ad511e43ef3a3a2d49","RawContent":"&lt;p&gt;I bought my girls their jewelry, getting ready robes, a beach bag, a wet bikini bag, tank tops, and an Alex and Ani bracelet as their actual \"gift\" (I might be forgetting some things), but it probably added up to about $130 per bridesmaid (I had 5). I wish I could have done more, but they were all overwhelmed that I even did that much and were so grateful and appreciative. I would do what you can, but don&#039;t feel like you have to break the bank for them - I&#039;m sure they wouldn&#039;t want you to stress over money for stuff for them with all the other wedding expenses.&lt;\/p&gt;","Attachments":[],"Id":1899473,"PostDate":1435588874,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I bought my girls their jewelry, getting ready robes, a beach bag, a wet bikini bag, tank tops, and an Alex and Ani bracelet as their actual \"gift\" (I might be forgetting some things), but it probably added up to about $130 per bridesmaid (I had 5). I wish I could have done more, but they were all overwhelmed that I even did that much and were so grateful and appreciative. I would do what you can, but don't feel like you have to break the bank for them - I'm sure they wouldn't want you to stress over money for stuff for them with all the other wedding expenses.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rachelia160@aim.com","IpAddress":"66.61.104.237","GroupId":40,"GroupName":"Jr. Member","JoinDate":1388731897,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275855.jpg?_r=1435853657","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"rachelia160","Id":275855,"Name":"rachelia160","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.161.70.215","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79328,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"7f6b8387e3a6aef16eff70a8cf03c53d","RawContent":"I agree with the ladies. Just do what you can. I think any bridesmaid would be thrilled that you thought enough of them to go that little bit extra for them but I wouldn&#039;t break your budget.","Attachments":[],"Id":1899511,"PostDate":1435608800,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I agree with the ladies. Just do what you can. I think any bridesmaid would be thrilled that you thought enough of them to go that little bit extra for them but I wouldn't break your budget.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283458999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.17.38.13","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79328,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"709b6d00a73e4336502e8eff9adf77df","RawContent":"&lt;p&gt;Thanks ladies, this is really helpful! I think that&#039;s right around what I was planning on spending on them. I just want them to know how much we appreciate them coming out to support us.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1899537,"PostDate":1435670282,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thanks ladies, this is really helpful! I think that's right around what I was planning on spending on them. I just want them to know how much we appreciate them coming out to support us.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"penjani@hotmail.com","IpAddress":"71.17.38.13","GroupId":39,"GroupName":"Newbie","JoinDate":1393175102,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"peachykeen159","Id":276833,"Name":"peachykeen159","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"199.126.252.6","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79328,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"cd48b6294291f4a67570888847a0378e","RawContent":"&lt;p&gt;I think your bridesmaids will be happy with whatever! I spent $160 on their dresses and bought some necklaces for them for $20. I only have two bridesmaids though so that&#039;s what allowed me to spend a little more on them :)&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1899540,"PostDate":1435672734,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I think your bridesmaids will be happy with whatever! I spent $160 on their dresses and bought some necklaces for them for $20. I only have two bridesmaids though so that's what allowed me to spend a little more on them <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<br><p><a data-ipb='nomediaparse' href='http:\/\/www.TickerFactory.com\/'><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;31;484\/st\/20150813\/e\/Wedding+time%21+\/dt\/-2\/k\/b92c\/event.png\" alt=\"event.png\"><\/a><\/p>\n<p style=\"text-align:center;\">\u00a0<\/p>\n<p style=\"text-align:center;\">\u00a0","Email":"sblopezb@gmail.com","IpAddress":"172.219.193.22","GroupId":42,"GroupName":"Sr. Member","JoinDate":1359763104,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265511.jpg?_r=1442890536","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"TinkerSofi","Id":265511,"Name":"TinkerSofi","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79328,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"0754e23cdd0bc66832f16948cab5cf0b","RawContent":"&lt;p&gt;I spent around $180 per bridesmaid. I don&#039;t think there is a general price point. I was originally planning to spend a little less, but got a bit carried away.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1899550,"PostDate":1435686668,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I spent around $180 per bridesmaid. I don't think there is a general price point. I was originally planning to spend a little less, but got a bit carried away.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419437814,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1436293677","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.226.143.164","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79328,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"5f37d9045e2a0496bfa8861a7f3a42f0","RawContent":"I&#039;m not sure how much I spent all together per BM (I had 3) but I too got a little carried away lol. Mostly because I had such a long time to plan, or so it seems,  and every time I came across something, or came up with an idea that I thought was \"perfect\", I had a hard time telling myself no. I ended up with a collection of things...jewelry set (necklace,  bracelet,  earrings), pearl barefoot sandals, monogrammed getting ready shirt, personalized dress hangers, beach bag with coordinating wet bikini bag and sarong, beach towel chair clips, personalized beach drink holder, and a few other little things. But altogether I would say around 200 at the most. Which they were definitely not expecting all of that and were very surprised and thankful for everything. I 100% agree with the other posts about how you shouldn&#039;t feel like you have to spend a certain dollar amount, or feel like you need to spend more because they are spending more to be a part of your wedding with travel expenses...after all, they are also getting a vacation in paradise in addition to being a part of your wedding :) And I always believe that it&#039;s the thought that counts the most, and I&#039;m sure your BM&#039;s will love whatever it is that you decide to get them.","Attachments":[],"Id":1899590,"PostDate":1435741921,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm not sure how much I spent all together per BM (I had 3) but I too got a little carried away lol. Mostly because I had such a long time to plan, or so it seems,  and every time I came across something, or came up with an idea that I thought was \"perfect\", I had a hard time telling myself no. I ended up with a collection of things...jewelry set (necklace,  bracelet,  earrings), pearl barefoot sandals, monogrammed getting ready shirt, personalized dress hangers, beach bag with coordinating wet bikini bag and sarong, beach towel chair clips, personalized beach drink holder, and a few other little things. But altogether I would say around 200 at the most. Which they were definitely not expecting all of that and were very surprised and thankful for everything. I 100% agree with the other posts about how you shouldn't feel like you have to spend a certain dollar amount, or feel like you need to spend more because they are spending more to be a part of your wedding with travel expenses...after all, they are also getting a vacation in paradise in addition to being a part of your wedding <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> And I always believe that it's the thought that counts the most, and I'm sure your BM's will love whatever it is that you decide to get them.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kayla.brubaker@gmail.com","IpAddress":"68.226.143.164","GroupId":39,"GroupName":"Newbie","JoinDate":1379719476,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-273635.jpg?_r=1430276419","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"KayRae","Id":273635,"Name":"KayRae","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"64.53.250.35","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79328,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":3,"IsLiked":false,"PostKey":"0d246177bc27ccb13ede52d0186e3ed6","RawContent":"&lt;p&gt;@[member=\"KayRae\"] is exactly right - the longer you have the plan, the more stuff you buy without realizing it! I honestly didn&#039;t realize how much I had spent until I was writing out my response to this post, since I would just but one thing at a time, and then it ends up really adding up!&lt;\/p&gt;","Attachments":[],"Id":1899592,"PostDate":1435752309,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"273635\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/273635-kayrae\/' title='Member profile'><span itemprop=\"name\">KayRae<\/span><\/a> is exactly right - the longer you have the plan, the more stuff you buy without realizing it! I honestly didn't realize how much I had spent until I was writing out my response to this post, since I would just but one thing at a time, and then it ends up really adding up!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rachelia160@aim.com","IpAddress":"66.61.104.237","GroupId":40,"GroupName":"Jr. Member","JoinDate":1388731897,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275855.jpg?_r=1435853657","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"rachelia160","Id":275855,"Name":"rachelia160","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"122.15.103.61","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79328,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2374677548484024b7795aa64e893161","RawContent":"&lt;p&gt;i have spend about 80K only on the gifts which are given to about 20 bridesmaids at the day of weeding. so it totally depends upon the budget u take in. so do what even u feel good.&lt;\/p&gt;","Attachments":[],"Id":1901878,"PostDate":1438760766,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>i have spend about 80K only on the gifts which are given to about 20 bridesmaids at the day of weeding. so it totally depends upon the budget u take in. so do what even u feel good.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"katherineriverace@gmail.com","IpAddress":"122.15.103.61","GroupId":39,"GroupName":"Newbie","JoinDate":1425100717,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282278.png?_r=1425103909","PhotoWidth":200,"PhotoHeight":242,"PhotoType":"custom"},"FormattedName":"RitvikSehgal","Id":282278,"Name":"RitvikSehgal","IsOnline":false}}],"Id":"79328","Title":"How Much To Spend On Bridesmaids?","LastPostDate":1443169257},"Pages":{"TotalItems":14,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
