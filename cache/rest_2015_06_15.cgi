{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":18414,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3ac28e15ad0e383a380b910b64fc034f","RawContent":"Do any of you have any other contact than Fabio at Azul? I&#039;ve asked Fabio several times if it is possible to bring in my own florist and DJ and he doesn&#039;t respond to my emails. I don&#039;t want to pay my $200 deposit without knowing this info first. &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/undecided.gif\" border=\"0\" alt=\"\" title=\"Undecided\" class=\"inlineimg\" \/&gt;","Attachments":[],"Id":365937,"PostDate":1215044170,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Do any of you have any other contact than Fabio at Azul? I've asked Fabio several times if it is possible to bring in my own florist and DJ and he doesn't respond to my emails. I don't want to pay my $200 deposit without knowing this info first. <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/undecided.gif\" border=\"0\" alt=\"\" title=\"Undecided\" class=\"inlineimg\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i485.photobucket.com\/albums\/rr213\/lenka144\/i6A4434A9-3306-4049-B196-5E7D486-1.jpg\">http:\/\/i485.photobucket.com\/albums\/r...-5E7D486-1.jpg<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10716;405\/st\/20091114\/e\/Our+Wedding+Day\/k\/4a07\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...4a07\/event.png<\/a><\/div><\/div>","Email":"lenka14@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1208995373,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209168.gif?_r=0","PhotoWidth":91,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"lenka14","Id":209168,"Name":"lenka14","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":18414,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9e8dce737f50f880bc5ccfa539bdbf9b","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;scrappinsensation&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Is this resort all-inclusive?&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;\n Yes it is :)","Attachments":[],"Id":366020,"PostDate":1215046458,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>scrappinsensation<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Is this resort all-inclusive?<\/div> <\/td> <\/tr> <\/table> <\/div><br \/> Yes it is <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i485.photobucket.com\/albums\/rr213\/lenka144\/i6A4434A9-3306-4049-B196-5E7D486-1.jpg\">http:\/\/i485.photobucket.com\/albums\/r...-5E7D486-1.jpg<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10716;405\/st\/20091114\/e\/Our+Wedding+Day\/k\/4a07\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...4a07\/event.png<\/a><\/div><\/div>","Email":"lenka14@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1208995373,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209168.gif?_r=0","PhotoWidth":91,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"lenka14","Id":209168,"Name":"lenka14","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":18414,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"46c4536378e7369b981a7854f9db8dc3","RawContent":"now that i&#039;m booked i&#039;m dying to get all the fun stuff started but it just seems like they don&#039;t have it all together yet.... yes, it&#039;s very frustrating but i&#039;d rather wait until they have all their information straight instead of them giving me false information or information they have to take back later. i&#039;m trying really hard to be patient, but it&#039;s not easy &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/frown.gif\" border=\"0\" alt=\"\" title=\"Frown\" class=\"inlineimg\" \/&gt; we&#039;ll just get through this together &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/hug2.gif\" border=\"0\" alt=\"\" title=\"Hug2\" class=\"inlineimg\" \/&gt;","Attachments":[],"Id":366200,"PostDate":1215054071,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                now that i'm booked i'm dying to get all the fun stuff started but it just seems like they don't have it all together yet.... yes, it's very frustrating but i'd rather wait until they have all their information straight instead of them giving me false information or information they have to take back later. i'm trying really hard to be patient, but it's not easy <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/frown.gif\" border=\"0\" alt=\"\" title=\"Frown\" class=\"inlineimg\" \/><\/span> we'll just get through this together <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/hug2.gif\" border=\"0\" alt=\"\" title=\"Hug2\" class=\"inlineimg\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i142.photobucket.com\/albums\/r86\/ednamilena\/wedding\/Picture30-1.jpg\">http:\/\/i142.photobucket.com\/albums\/r...icture30-1.jpg<\/a><br><strong><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f128\/cant-believe-its-my-turn-52439\/\">My Planning Thread<\/a><\/strong><br><br><strong><a data-ipb='nomediaparse' href=\"http:\/\/www.bestdestinationwedding.com\/forum\/thread\/54135\/milejilo-s-wedding-and-ttd-by-the-fabulous-elizabeth-medina\/\">My Pro Wedding Slideshow by Elizabeth Medina<\/a><\/strong><\/div><\/div>","Email":"milejilo@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1207252546,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209006.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"milejilo","Id":209006,"Name":"milejilo","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":18414,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"864960ad37af9c6be4c689efeb33cc57","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;pepper55&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;I got my confirmation yesterday!! Yay! Now, I&#039;m officially in this thread.\n \n Just a question - when do you actually speak to the WC to discuss location, menu option (private event) and any other private events (welcome cocktails)? Did you guys schedule a call or did you do everything over email?&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;&lt;div align=\"center\"&gt;&lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheer2.gif\" border=\"0\" alt=\"\" title=\"Cheer2\" class=\"inlineimg\" \/&gt; yaaaaaaaay &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheer2.gif\" border=\"0\" alt=\"\" title=\"Cheer2\" class=\"inlineimg\" \/&gt;&lt;\/div&gt; that makes three of us from NJ...","Attachments":[],"Id":366238,"PostDate":1215055185,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>pepper55<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">I got my confirmation yesterday!! Yay! Now, I'm officially in this thread.<br \/> <br \/> Just a question - when do you actually speak to the WC to discuss location, menu option (private event) and any other private events (welcome cocktails)? Did you guys schedule a call or did you do everything over email?<\/div> <\/td> <\/tr> <\/table> <\/div><div align=\"center\"><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheer2.gif\" border=\"0\" alt=\"\" title=\"Cheer2\" class=\"inlineimg\" \/><\/span> yaaaaaaaay <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/cheer2.gif\" border=\"0\" alt=\"\" title=\"Cheer2\" class=\"inlineimg\" \/><\/span><\/div> that makes three of us from NJ...\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i142.photobucket.com\/albums\/r86\/ednamilena\/wedding\/Picture30-1.jpg\">http:\/\/i142.photobucket.com\/albums\/r...icture30-1.jpg<\/a><br><strong><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f128\/cant-believe-its-my-turn-52439\/\">My Planning Thread<\/a><\/strong><br><br><strong><a data-ipb='nomediaparse' href=\"http:\/\/www.bestdestinationwedding.com\/forum\/thread\/54135\/milejilo-s-wedding-and-ttd-by-the-fabulous-elizabeth-medina\/\">My Pro Wedding Slideshow by Elizabeth Medina<\/a><\/strong><\/div><\/div>","Email":"milejilo@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1207252546,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209006.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"milejilo","Id":209006,"Name":"milejilo","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":18414,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3c1b2f9396bad8f1e767f096051304c8","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;lenka14&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;I am also waiting for my confirmation from Azul Sensatori. &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/popcorn.gif\" border=\"0\" alt=\"\" title=\"Popcorn\" class=\"inlineimg\" \/&gt; Do any of you know which photographer you&#039;ll be using? I really love the work of Sol Tamargo and Matt Adcock but they&#039;re banned from Karisma hotels &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/crybaby2.gif\" border=\"0\" alt=\"\" title=\"Crybaby2\" class=\"inlineimg\" \/&gt;&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;i knoooooooow, makes me want to cry too... i&#039;m on a hunt for a photog...definitely not using theirs.","Attachments":[],"Id":366255,"PostDate":1215055572,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>lenka14<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">I am also waiting for my confirmation from Azul Sensatori. <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/popcorn.gif\" border=\"0\" alt=\"\" title=\"Popcorn\" class=\"inlineimg\" \/><\/span> Do any of you know which photographer you'll be using? I really love the work of Sol Tamargo and Matt Adcock but they're banned from Karisma hotels <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/crybaby2.gif\" border=\"0\" alt=\"\" title=\"Crybaby2\" class=\"inlineimg\" \/><\/span><\/div> <\/td> <\/tr> <\/table> <\/div>i knoooooooow, makes me want to cry too... i'm on a hunt for a photog...definitely not using theirs.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i142.photobucket.com\/albums\/r86\/ednamilena\/wedding\/Picture30-1.jpg\">http:\/\/i142.photobucket.com\/albums\/r...icture30-1.jpg<\/a><br><strong><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f128\/cant-believe-its-my-turn-52439\/\">My Planning Thread<\/a><\/strong><br><br><strong><a data-ipb='nomediaparse' href=\"http:\/\/www.bestdestinationwedding.com\/forum\/thread\/54135\/milejilo-s-wedding-and-ttd-by-the-fabulous-elizabeth-medina\/\">My Pro Wedding Slideshow by Elizabeth Medina<\/a><\/strong><\/div><\/div>","Email":"milejilo@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1207252546,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209006.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"milejilo","Id":209006,"Name":"milejilo","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":18414,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"414bb813dbea5552a6012a7694fe062a","RawContent":"Hi there! I am in search of a resort for my wedding and am seriously considering Azul Sensatori. I sent an email off requesting information but am wondering if you girls might have some of the answers to my questions.\n \n First...what date does it officially open? I heard Fall 2008 but then I saw on another site May of 2009 so I was confused. I want to have my wedding in April or May and figured that if they open this fall that will give them time to work out any issues associated with a new property.\n \n Do you have any idea what the wedding site options are? I know they have a roof top one that sounds really cool. I really want to get married on the beach but I kinda want it to be somewhat secluded and not have beach chairs 3 feet away. \n \n Also, do you know what the rain\/backup locations will be? I am drawn to resorts that have a chapel because if it rains I still want to get married somewhere nice and not in an ugly ballroom or something.\n \n Last question...I really want to do a private reception. Do you know what the options are and the cost? \n \n Okay, one more...I promise...what made you decide to go with this resort over all the others? For me it&#039;s the food and the gourmet inclusive concept. Since I&#039;ll be eating like a bird the next few months so I look good in both my wedding dress and bikini I figure I&#039;ll want a really yummy meal after the wedding! :)\n \n \n Thanks for any input you can offer!","Attachments":[],"Id":370115,"PostDate":1215412588,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi there! I am in search of a resort for my wedding and am seriously considering Azul Sensatori. I sent an email off requesting information but am wondering if you girls might have some of the answers to my questions.<br \/> <br \/> First...what date does it officially open? I heard Fall 2008 but then I saw on another site May of 2009 so I was confused. I want to have my wedding in April or May and figured that if they open this fall that will give them time to work out any issues associated with a new property.<br \/> <br \/> Do you have any idea what the wedding site options are? I know they have a roof top one that sounds really cool. I really want to get married on the beach but I kinda want it to be somewhat secluded and not have beach chairs 3 feet away. <br \/> <br \/> Also, do you know what the rain\/backup locations will be? I am drawn to resorts that have a chapel because if it rains I still want to get married somewhere nice and not in an ugly ballroom or something.<br \/> <br \/> Last question...I really want to do a private reception. Do you know what the options are and the cost? <br \/> <br \/> Okay, one more...I promise...what made you decide to go with this resort over all the others? For me it's the food and the gourmet inclusive concept. Since I'll be eating like a bird the next few months so I look good in both my wedding dress and bikini I figure I'll want a really yummy meal after the wedding! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br \/> <br \/> <br \/> Thanks for any input you can offer!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achandler@att.net","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1215226339,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-210324.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"amyc","Id":210324,"Name":"amyc","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":18414,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ad392fb20198bd9edf08665c5d6949b2","RawContent":"Hi Amy! &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/welcome1.gif\" border=\"0\" alt=\"\" title=\"Welcome1\" class=\"inlineimg\" \/&gt;\n I live in Dallas too. \n Hopefully I can answer some of your questions. Azul Sensatori opens in October of this year. We are getting married there in April of 09, hoping that will be enough time to work out the kinks!\n I&#039;m for sure they will have a beach ceremony location, the rooftop location, then maybe a garden or gazebo not in the sand? \n I&#039;m not sure of back-up locations and I have not heard anything about a chapel. But maybe a lobby or covered space? I&#039;m sure they will have something. \n We are going to go after they open to pick out our locations. I&#039;ll be sure to post lots of pics. \n The event kit on the Karisma webpage has the menus for dinner and open bar. &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.karismahotels.com\/wedding\/event_kit\/event_kit_2009.pdf\"&gt;http:\/\/www.karismahotels.com\/wedding...t_kit_2009.pdf&lt;\/a&gt;\n 2 hours of open bar are included with cocktail hour and 4 hours of open bar with private dinner.\n Also check out the optional amenities page, &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.karismahotels.com\/wedding\/event_kit\/optional_amenities.pdf\"&gt;http:\/\/www.karismahotels.com\/wedding..._amenities.pdf&lt;\/a&gt;\n Here are some examples of floral decorations, &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/weddings.lomas-travel.com\/planning\/details.php?category=Decorations-and-Set-Ups&amp;amp;idc=16\"&gt;Category Decorations &amp;amp; Set Ups - List of products - Welcome, Guest Weddings in Cancun &amp;amp; Riviera Maya&lt;\/a&gt;\n &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/weddings.lomas-travel.com\/planning\/details.php?category=Bouquets&amp;amp;idc=19\"&gt;Category Bouquets - List of products - Welcome, Guest Weddings in Cancun &amp;amp; Riviera Maya&lt;\/a&gt;\n Music choices, &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/weddings.lomas-travel.com\/planning\/details.php?category=Music&amp;amp;idc=18\"&gt;Category Music - List of products - Welcome, Guest Weddings in Cancun &amp;amp; Riviera Maya&lt;\/a&gt;\n Karisma works alongside of Lomas to plan your wedding, so spend some time on that site.\n \n We chose Azul Sensatori for a few reasons, \n We wanted a place that allowed kids.\n We liked Azul Beach, but the rooms are small and just ok.\n Azul Beach is small (less than 100 rooms)\n Pools weren&#039;t spectacular like you would imagine for a resort like Azul Beach.\n We like the style and look of the weddings that Karisma offers (but not necessarily all of their policies and B.S.)\n We liked the food, no buffets, no reservations required.\n The drinks are good and come in a decent size glass. &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/shots.gif\" border=\"0\" alt=\"\" title=\"Shots\" class=\"inlineimg\" \/&gt;\n Beach butlers!!!!\n \n Hope that helps some, let us know if you have any other questions~","Attachments":[],"Id":370293,"PostDate":1215431900,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi Amy! <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/welcome1.gif\" border=\"0\" alt=\"\" title=\"Welcome1\" class=\"inlineimg\" \/><\/span><br \/> I live in Dallas too. <br \/> Hopefully I can answer some of your questions. Azul Sensatori opens in October of this year. We are getting married there in April of 09, hoping that will be enough time to work out the kinks!<br \/> I'm for sure they will have a beach ceremony location, the rooftop location, then maybe a garden or gazebo not in the sand? <br \/> I'm not sure of back-up locations and I have not heard anything about a chapel. But maybe a lobby or covered space? I'm sure they will have something. <br \/> We are going to go after they open to pick out our locations. I'll be sure to post lots of pics. <br \/> The event kit on the Karisma webpage has the menus for dinner and open bar. <a href='http:\/\/www.karismahotels.com\/wedding\/event_kit\/event_kit_2009.pdf' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.karismaho....t_kit_2009.pdf<\/a><br \/> 2 hours of open bar are included with cocktail hour and 4 hours of open bar with private dinner.<br \/> Also check out the optional amenities page, <a href='http:\/\/www.karismahotels.com\/wedding\/event_kit\/optional_amenities.pdf' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.karismaho...._amenities.pdf<\/a><br \/> Here are some examples of floral decorations, <a href='http:\/\/weddings.lomas-travel.com\/planning\/details.php?category=Decorations-and-Set-Ups&idc=16' class='bbc_url' title='External link' rel='nofollow external'>Category Decorations & Set Ups - List of products - Welcome, Guest Weddings in Cancun & Riviera Maya<\/a><br \/> <a href='http:\/\/weddings.lomas-travel.com\/planning\/details.php?category=Bouquets&idc=19' class='bbc_url' title='External link' rel='nofollow external'>Category Bouquets - List of products - Welcome, Guest Weddings in Cancun & Riviera Maya<\/a><br \/> Music choices, <a href='http:\/\/weddings.lomas-travel.com\/planning\/details.php?category=Music&idc=18' class='bbc_url' title='External link' rel='nofollow external'>Category Music - List of products - Welcome, Guest Weddings in Cancun & Riviera Maya<\/a><br \/> Karisma works alongside of Lomas to plan your wedding, so spend some time on that site.<br \/> <br \/> We chose Azul Sensatori for a few reasons, <br \/> We wanted a place that allowed kids.<br \/> We liked Azul Beach, but the rooms are small and just ok.<br \/> Azul Beach is small (less than 100 rooms)<br \/> Pools weren't spectacular like you would imagine for a resort like Azul Beach.<br \/> We like the style and look of the weddings that Karisma offers (but not necessarily all of their policies and B.S.)<br \/> We liked the food, no buffets, no reservations required.<br \/> The drinks are good and come in a decent size glass. <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/shots.gif\" border=\"0\" alt=\"\" title=\"Shots\" class=\"inlineimg\" \/><\/span><br \/> Beach butlers!!!!<br \/> <br \/> Hope that helps some, let us know if you have any other questions~\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Photography by Tamm's Photos<\/span><br><a data-ipb='nomediaparse' href=\"http:\/\/www.ezticker.com\/ticker\/466\/192\/20090425\/Our+Wedding+in+Riviera+Maya\/ticker.png\">http:\/\/www.ezticker.com\/ticker\/466\/1...aya\/ticker.png<\/a><\/div><\/div>","Email":"behm.11@osu.edu","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1200485158,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208250.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"JHarwood2Be","Id":208250,"Name":"JHarwood2Be","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":18414,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"29a8830281a25e51dee2817b47d1676b","RawContent":"Thank you so much...this is great info! It&#039;s good to know there&#039;s a fellow Dallas girl on the board. It sounds like we have similar requirements for our destination...allows kids, bigger than Azul Beach, service, etc. Everything I&#039;ve read about this place sounds wonderful...I can&#039;t wait! \n \n One concern I have is keeping the cost down for the guests. Are you using Lomas Travel to book all your guests? I&#039;d like to get everyone a group rate if possible and have one contact that handles the booking for everyone. How are you handling the booking for your guests?","Attachments":[],"Id":370893,"PostDate":1215466776,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thank you so much...this is great info! It's good to know there's a fellow Dallas girl on the board. It sounds like we have similar requirements for our destination...allows kids, bigger than Azul Beach, service, etc. Everything I've read about this place sounds wonderful...I can't wait! <br \/> <br \/> One concern I have is keeping the cost down for the guests. Are you using Lomas Travel to book all your guests? I'd like to get everyone a group rate if possible and have one contact that handles the booking for everyone. How are you handling the booking for your guests?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achandler@att.net","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1215226339,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-210324.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"amyc","Id":210324,"Name":"amyc","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":18414,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ffad13848770df5f441940f66f382355","RawContent":"We did not get a group rate. My guests can book however they want and I have provided a contact for a travel agent they can use. I did not want to worry about deposits for group rates or fulfilling room blocks. Maybe someone else can chime in on getting a group rate.","Attachments":[],"Id":371412,"PostDate":1215485724,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We did not get a group rate. My guests can book however they want and I have provided a contact for a travel agent they can use. I did not want to worry about deposits for group rates or fulfilling room blocks. Maybe someone else can chime in on getting a group rate.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Photography by Tamm's Photos<\/span><br><a data-ipb='nomediaparse' href=\"http:\/\/www.ezticker.com\/ticker\/466\/192\/20090425\/Our+Wedding+in+Riviera+Maya\/ticker.png\">http:\/\/www.ezticker.com\/ticker\/466\/1...aya\/ticker.png<\/a><\/div><\/div>","Email":"behm.11@osu.edu","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1200485158,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208250.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"JHarwood2Be","Id":208250,"Name":"JHarwood2Be","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":18414,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"299832e6dbaf1a9a99baea9c8eeb9e5a","RawContent":"Hi - We didn&#039;t go for the group rate either. We heard from our TA and some friends that sometimes it can be more of a pain to do that. You have to pre-pay for the rooms for a specific room category and know exactly for how many nights they&#039;ll stay.\n \n If you call the hotel directly, they can provide you with the group rate discount. You do have to block a minimum of 15 rooms. Our TA has been able to get us rates that are lower than the 15% discount on line.\n \n Hope that helps some, good luck with planning! \n \n Does anyone have feedback on Nancy from Lomas? How is she to work with? I&#039;ve sent her a list of questions (there were alot!) and just wanted to know how quickly I can expect to hear back from her...","Attachments":[],"Id":371580,"PostDate":1215493067,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi - We didn't go for the group rate either. We heard from our TA and some friends that sometimes it can be more of a pain to do that. You have to pre-pay for the rooms for a specific room category and know exactly for how many nights they'll stay.<br \/> <br \/> If you call the hotel directly, they can provide you with the group rate discount. You do have to block a minimum of 15 rooms. Our TA has been able to get us rates that are lower than the 15% discount on line.<br \/> <br \/> Hope that helps some, good luck with planning! <br \/> <br \/> Does anyone have feedback on Nancy from Lomas? How is she to work with? I've sent her a list of questions (there were alot!) and just wanted to know how quickly I can expect to hear back from her...\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"p_amarose@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1213493787,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209956.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"pepper55","Id":209956,"Name":"pepper55","IsOnline":false}}],"Pages":{"TotalItems":18755,"TotalPages":1876,"CurrentPage":30,"NextPage":40,"PreviousPage":20,"LastPage":18750},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
