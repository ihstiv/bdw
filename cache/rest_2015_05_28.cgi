{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":true,"CanReply":true,"CanFollow":true,"TotalPosts":26,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":2572,"MovedTo":null,"MovedOn":0,"FirstPostId":1842180,"Rating":0,"RatingHits":0,"Starter":{"Id":276610,"Name":"Feath07","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1396478147,"LastPoster":{"Id":280707,"Name":"BrideChillaDR","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1842180,"PostDate":1396478147,"PostContent":"Hello Ladies!! \u00a0 I'm recently engaged and planning my wedding in the DR, Punta Cana. \u00a0The beaches...","Author":{"Signature":"","Email":"erskinetoczkowedding@gmail.com","IpAddress":"184.178.26.150","GroupId":39,"GroupName":"Newbie","JoinDate":1392039927,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Feath07","Id":276610,"Name":"Feath07","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.90.86.132","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":false,"CanLike":true,"TopicId":76752,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"34501bf3678308a47ef91ac89e83c150","RawContent":"&lt;p&gt;Hello Ladies!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;m recently engaged and planning my wedding in the DR, Punta Cana. &amp;nbsp;The beaches look incredible and my fiance and I are all about the Tropical Paradise feel for our wedding!&amp;nbsp; :) &amp;nbsp; I&#039;ve doing quite a bit of research on the all-inclusive resorts (crazy how many there are, but love the options) and would love to receive recommendations for recent weddings in Punta Cana. &amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I was in contact with Stephany at the Sanctuary Cap Cana, yet have just been informed that she is no longer with them and the resort is not available for weddings in April 2015, which was very disappointing since this resort was top on my list. &amp;nbsp;I loved the fact that it was more private and less of a \"wedding factory\" feel per se. &amp;nbsp;The new coordinator, Hector, did however recommend the other two sister properties of the resort (ALSO Luxury Village and ALSO Del Mar). &amp;nbsp;Has anyone gotten married or stayed at either of these two resorts?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Any feedback would be extremely helpful!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thanks so much!!&lt;\/p&gt;","Attachments":[],"Id":1842180,"PostDate":1396478147,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello Ladies!!<\/p>\n<p>\u00a0<\/p>\n<p>I'm recently engaged and planning my wedding in the DR, Punta Cana. \u00a0The beaches look incredible and my fiance and I are all about the Tropical Paradise feel for our wedding!\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> \u00a0 I've doing quite a bit of research on the all-inclusive resorts (crazy how many there are, but love the options) and would love to receive recommendations for recent weddings in Punta Cana. \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I was in contact with Stephany at the Sanctuary Cap Cana, yet have just been informed that she is no longer with them and the resort is not available for weddings in April 2015, which was very disappointing since this resort was top on my list. \u00a0I loved the fact that it was more private and less of a \"wedding factory\" feel per se. \u00a0The new coordinator, Hector, did however recommend the other two sister properties of the resort (ALSO Luxury Village and ALSO Del Mar). \u00a0Has anyone gotten married or stayed at either of these two resorts?<\/p>\n<p>\u00a0<\/p>\n<p>Any feedback would be extremely helpful!!<\/p>\n<p>\u00a0<\/p>\n<p>Thanks so much!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"erskinetoczkowedding@gmail.com","IpAddress":"184.178.26.150","GroupId":39,"GroupName":"Newbie","JoinDate":1392039927,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Feath07","Id":276610,"Name":"Feath07","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.202.225.11","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":true,"CanDelete":true,"CanLike":true,"TopicId":76752,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c7a2a6d0fe195024cb6237a27ff8baa1","RawContent":"&lt;p&gt;welcome to BDW! &amp;nbsp;DR does have some amazing beaches.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;you might want to try one of our DR specialists. &amp;nbsp;They can recommend some places for you.&lt;\/p&gt;","Attachments":[],"Id":1843035,"PostDate":1396858735,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>welcome to BDW! \u00a0DR does have some amazing beaches.<\/p>\n<p>\u00a0<\/p>\n<p>you might want to try one of our DR specialists. \u00a0They can recommend some places for you.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-family:arial, helvetica, sans-serif;\">Founder and Owner of BestDestinationWedding.com \u00a0\/ \u00a0<\/span><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/'><strong><span style=\"font-family:arial, helvetica, sans-serif;\">Bride & Groom Fly FREE Promotion<\/span><\/strong><\/a><\/p>\n<p>\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><strong><a data-ipb='nomediaparse' href='http:\/\/wrighttravelagency.com\/inquiry\/'><span style=\"color:#008080;\">Looking for a travel agency that specializes in Destination Weddings<\/span><\/a><\/strong><span style=\"color:#008080;\"><strong>?<\/strong> \u00a0We are an award winning travel agency and you can <\/span><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style=\"color:#008080;\">read our reviews\u00a0here.<\/span><\/a><\/strong><\/span><br>\n\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"color:#008080;\"><strong>Awards and recogn