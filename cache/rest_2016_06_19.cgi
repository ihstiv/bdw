tdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><\/span><br><span style=\"color:rgb(0,128,128);\"><strong><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010\" title=\"\">Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><strong><span style=\"color:rgb(178,34,34);\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a  class=\"bbc_url\" href=\"mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com\" title=\"External link\">ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"trisha@wrighttravelagency.com","IpAddress":"12.24.226.126","GroupId":46,"GroupName":"VIP Member","JoinDate":1171995300,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207201.jpg?_r=1452788764","PhotoWidth":200,"PhotoHeight":296,"PhotoType":"custom"},"FormattedName":"TATrisha","Id":207201,"Name":"TATrisha","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":66415,"EditedBy":"","EditDate":1392116614,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b00044eae223f10f375558ec8c9658c1","RawContent":"&lt;p style=\"text-align:center;\"&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;strong&gt;&lt;span style=\"color:#181818;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;Overall Coordinator is Pilar Gonzalez \/ Groups &amp;amp; Convention Manager&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"text-align:center;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;&lt;span style=\"color:#181818;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;Pilar - &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;mailto:weddings.nojrc@nowresorts.com&#039;&gt;weddings.nojrc@nowresorts.com&lt;\/a&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"text-align:center;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;&lt;span style=\"color:#181818;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;01152-998-872-8888 ext 4006&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.nowresorts.com\/jade&#039;&gt;&lt;span style=\"color:#008080;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;Resort Website&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:10pt;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.amresorts.com\/wedding_guides\/nojrc-wedding-guide.pdf&#039;&gt;&lt;span style=\"color:#008080;\"&gt;Wedding Guide&lt;\/span&gt;&lt;\/a&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:10pt;\"&gt;&lt;span style=\"color:#181818;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.facebook.com\/#!\/NowJade&#039;&gt;&lt;span style=\"color:#008080;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;Facebook Page&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.travelbybob.com\/517\/resort\/\/Now-Jade-Riviera-Cancun-Resort-&amp;amp;-Spa.html?t=1#map-tab&#039;&gt;&lt;span style=\"color:#008080;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;Resort Map&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/a&gt;\n&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.nowresorts.com\/jade\/photos-videos#light_box_video_2&#039;&gt;&lt;span style=\"color:#008080;\"&gt;&lt;span style=\"font-size:10pt;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;Virtual Tour&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:10pt;\"&gt;&lt;span style=\"color:#181818;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;555 rooms, 7 different restaurants&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;&lt;span style=\"font-size:10pt;\"&gt;&lt;span style=\"color:#181818;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;Symbolic or Non-Denominational Wedding&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:10pt;\"&gt;&lt;span style=\"color:#181818;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;This ceremony focuses on love, marriage, family and society. Mexican law does not consider this ceremony legally valid. No documentation or blood tests are required.&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;&lt;span style=\"font-size:10pt;\"&gt;&lt;span style=\"color:#181818;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;Civil or Legal Ceremony&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:10pt;\"&gt;&lt;span style=\"color:#181818;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;This ceremony is performed by a judge and focuses on family and respect for the couple. A list of requirements must be met in order to be legally married under Mexican law.&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;&lt;span style=\"font-size:10pt;\"&gt;&lt;span style=\"color:#181818;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;Legal Requirements:&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/p&gt;\n&lt;ul&gt;&lt;li&gt;&lt;span style=\"font-size:10pt;\"&gt;&lt;span style=\"color:#181818;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;Bride, Groom &amp;amp; Witnesses must arrive in Canc\u00ban 4 working days prior to the wedding day (Saturdays, Sundays &amp;amp; Holidays do not count). Symbolic and non-legal ceremonies allow flexibility for arrival date. Please speak with the wedding coordinator to discuss requirements.&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt;\n&lt;li&gt;&lt;span style=\"font-size:10pt;\"&gt;&lt;span style=\"color:#181818;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;The wedding coordinator must receive the following documents in order to start the corresponding application for a Wedding in the Civil Registry Office.&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt;\n&lt;li&gt;&lt;span style=\"font-size:10pt;\"&gt;&lt;span style=\"color:#181818;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;Tourist Card (you will get one upon arrival to the Canc\u00ban airport). Make sure your name is written as it appears on your passport.&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt;\n&lt;li&gt;&lt;span style=\"font-size:10pt;\"&gt;&lt;span style=\"color:#181818;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;If either the bride or groom is divorced, original Birth Certificates are required with the originating country\u00e2\u20ac\u2122s Registry Stamp (Le Apostille). This document should be translated into Spanish. The cost is $50 USD + 11% tax per birth certificate. Translation must be done in Mexico to be considered valid.&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt;\n&lt;li&gt;&lt;span style=\"font-size:10pt;\"&gt;&lt;span style=\"color:#181818;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;If bride is divorced, a copy of the Final Divorce Decree is required with your country\u00e2\u20ac\u2122s Registry Stamp (Le Apostille). This document should be translated into Spanish. The cost is $50 USD + 11% tax per page. Translation must be done in Mexico to be considered valid.&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt;\n&lt;li&gt;&lt;span style=\"font-size:10pt;\"&gt;&lt;span style=\"color:#181818;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;Valid Passports.&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt;\n&lt;li&gt;&lt;span style=\"font-size:10pt;\"&gt;&lt;span style=\"color:#181818;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;Blood tests, performed in M\u00a9xico. Test are not valid if performed elsewhere and should not be performed more than 14 days prior to the ceremony. The blood will be tested for HIV, RPR (sexually transmitted diseases) and blood type. The results will be ready in 24 hours and will be provided with a certificate of the blood test. The charge is $250 USD + 11% tax per couple, to be paid directly to the doctor in cash the day the test is performed.&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt;\n&lt;li&gt;&lt;span style=\"font-size:10pt;\"&gt;&lt;span style=\"color:#181818;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;Witness Information. The names, addresses, nationalities, ages, occupation, relationship, copies of tourist cards and valid identification of the four witnesses. The Wedding Coordinator will provide the legal form to fill out.&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt;\n&lt;li&gt;&lt;span style=\"font-size:10pt;\"&gt;&lt;span style=\"color:#181818;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;Consider the fee for the Judge\u00e2\u20ac\u2122s transportation. The Judge usually performs the civil ceremony at their office, but will oblige to come to the resort if the transportation is provided. The round trip fare from the city is $70 USD. This should be paid directly to the Judge on the wedding day or can be arranged in advance through the wedding coordinator.&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt;\n&lt;li&gt;&lt;span style=\"font-size:10pt;\"&gt;&lt;span style=\"color:#181818;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;The Marriage Certificate is only valid in Mexico. In order to make it legal internationally, the Wedding Coordinator will send a copy of your License to the Validation Process. The fee will be $165 USD +11% tax. The process will take up to 2-3 months. Once the document is apostilled, the resort will send all documentation to couples home address.&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/li&gt;\n&lt;\/ul&gt;","Attachments":[],"Id":1595152,"PostDate":1331759369,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p  style=\"text-align:center\"><span  style=\"font-size:14px\"><strong><span  style=\"color:#181818\"><span  style=\"font-family:arial, sans-serif\">Overall Coordinator is Pilar Gonzalez \/ Groups & Convention Manager<\/span><\/span><\/strong><\/span><\/p>\n<p  style=\"text-align:center\"><span  style=\"font-size:10pt\"><span  style=\"color:#181818\"><span  style=\"font-family:arial, sans-serif\">Pilar - <a href='mailto:weddings.nojrc@nowresorts.com' class='bbc_url' title='External link' rel='nofollow external'>weddings.nojrc@nowresorts.com<\/a><\/span><\/span><\/span><\/p>\n<p  style=\"text-align:center\"><span  style=\"font-size:10pt\"><span  style=\"color:#181818\"><span  style=\"font-family:arial, sans-serif\">01152-998-872-8888 ext 4006<\/span><\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p><a href='http:\/\/www.nowresorts.com\/jade' class='bbc_url' title='External link' rel='nofollow external'><span  style=\"color:#008080\"><span  style=\"font-size:10pt\"><span  style=\"font-family:arial, sans-serif\">Resort Website<\/span><\/span><\/span><\/a><\/p>\n<p><span  style=\"font-size:10pt\"><span  style=\"font-family:arial, sans-serif\"><a href='http:\/\/www.amresorts.com\/wedding_guides\/nojrc-wedding-guide.pdf' class='bbc_url' title='External link' rel='nofollow external'><span  style=\"color:#008080\">Wedding Guide<\/span><\/a><\/span><\/span><\/p>\n<p><span  style=\"font-size:10pt\"><span  style=\"color:#181818\"><span  style=\"font-family:arial, sans-serif\"><a href=\"http:\/\/www.bestdestinationwedding.com\/index.phpapp=core&amp;module=attach&amp;section=attach&amp;attach_id=26292\" title=\"\"><img src=\"http:\/\/www.bestdestinationwedding.com\/public\/style_extra\/mime_types\/doc.gif\" alt=\"\" \/><\/a>\n&nbsp;<a href=\"http:\/\/www.bestdestinationwedding.com\/index.phpapp=core&amp;module=attach&amp;section=attach&amp;attach_id=26292\" title=\"\"><strong>NOW WEDDING PLANNING  FORM.doc<\/strong><\/a> &nbsp;&nbsp;<span class='desc'><strong>141.5KB<\/strong><\/span>\n&nbsp;&nbsp;<span class=\"desc lighter\">15 <\/span><\/span><\/span><\/span><\/p>\n<p><a href='http:\/\/www.facebook.com\/#!\/NowJade' class='bbc_url' title='External link' rel='nofollow external'><span  style=\"color:#008080\"><span  style=\"font-size:10pt\"><span  style=\"font-family:arial, sans-serif\">Facebook Page<\/span><\/span><\/span><\/a><\/p>\n<p><a href='http:\/\/www.travelbybob.com\/517\/resort\/\/Now-Jade-Riviera-Cancun-Resort-&-Spa.html?t=1#map-tab' class='bbc_url' title='External link' rel='nofollow external'><span  style=\"color:#008080\"><span  style=\"font-size:10pt\"><span  style=\"font-family:arial, sans-serif\">Resort Map<\/span><\/span><\/span><\/a><br><a href='http:\/\/www.nowresorts.com\/jade\/photos-videos#light_box_video_2' class='bbc_url' title='External link' rel='nofollow external'><span  style=\"color:#008080\"><span  style=\"font-size:10pt\"><span  style=\"font-family:arial, sans-serif\">Virtual Tour<\/span><\/span><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-size:10pt\"><span  style=\"color:#181818\"><span  style=\"font-family:arial, sans-serif\">555 rooms, 7 different restaurants<\/span><\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p><strong><span  style=\"font-size:10pt\"><span  style=\"color:#181818\"><span  style=\"font-family:arial, sans-serif\">Symbolic or Non-Denominational Wedding<\/span><\/span><\/span><\/strong><\/p>\n<p><span  style=\"font-size:10pt\"><span  style=\"color:#181818\"><span  style=\"font-family:arial, sans-serif\">This ceremony focuses on love, marriage, family and society. Mexican law does not consider this ceremony legally valid. No documentation or blood tests are required.<\/span><\/span><\/span><\/p>\n<p><strong><span  style=\"font-size:10pt\"><span  style=\"color:#181818\"><span  style=\"font-family:arial, sans-serif\">Civil or Legal Ceremony<\/span><\/span><\/span><\/strong><\/p>\n<p><span  style=\"font-size:10pt\"><span  style=\"color:#181818\"><span  style=\"font-family:arial, sans-serif\">This ceremony is performed by a judge and focuses on family and respect for the couple. A list of requirements must be met in order to be legally married under Mexican law.<\/span><\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p><strong><span  style=\"font-size:10pt\"><span  style=\"color:#181818\"><span  style=\"font-family:arial, sans-serif\">Legal Requirements:<\/span><\/span><\/span><\/strong><\/p>\n<ul><li><span  style=\"font-size:10pt\"><span  style=\"color:#181818\"><span  style=\"font-family:arial, sans-serif\">Bride, Groom & Witnesses must arrive in Canc\u00ban 4 working days prior to the wedding day (Saturdays, Sundays & Holidays do not count). Symbolic and non-legal ceremonies allow flexibility for arrival date. Please speak with the wedding coordinator to discuss requirements.<\/span><\/span><\/span><\/li>\n<li><span  style=\"font-size:10pt\"><span  style=\"color:#181818\"><span  style=\"font-family:arial, sans-serif\">The wedding coordinator must receive the following documents in order to start the corresponding application for a Wedding in the Civil Registry Office.<\/span><\/span><\/span><\/li>\n<li><span  style=\"font-size:10pt\"><span  style=\"color:#181818\"><span  style=\"font-family:arial, sans-serif\">Tourist Card (you will get one upon arrival to the Canc\u00ban airport). Make sure your name is written as it appears on your passport.<\/span><\/span><\/span><\/li>\n<li><span  style=\"font-size:10pt\"><span  style=\"color:#181818\"><span  style=\"font-family:arial, sans-serif\">If either the bride or groom is divorced, original Birth Certificates are required with the originating country\u00e2\u20ac\u2122s Registry Stamp (Le Apostille). This document should be translated into Spanish. The cost is $50 USD + 11% tax per birth certificate. Translation must be done in Mexico to be considered valid.<\/span><\/span><\/span><\/li>\n<li><span  style=\"font-size:10pt\"><span  style=\"color:#181818\"><span  style=\"font-family:arial, sans-serif\">If bride is divorced, a copy of the Final Divorce Decree is required with your country\u00e2\u20ac\u2122s Registry Stamp (Le Apostille). This document should be translated into Spanish. The cost is $50 USD + 11% tax per page. Translation must be done in Mexico to be considered valid.<\/span><\/span><\/span><\/li>\n<li><span  style=\"font-size:10pt\"><span  style=\"color:#181818\"><span  style=\"font-family:arial, sans-serif\">Valid Passports.<\/span><\/span><\/span><\/li>\n<li><span  style=\"font-size:10pt\"><span  style=\"color:#181818\"><span  style=\"font-family:arial, sans-serif\">Blood tests, performed in M\u00a9xico. Test are not valid if performed elsewhere and should not be performed more than 14 days prior to the ceremony. The blood will be tested for HIV, RPR (sexually transmitted diseases) and blood type. The results will be ready in 24 hours and will be provided with a certificate of the blood test. The charge is $250 USD + 11% tax per couple, to be paid directly to the doctor in cash the day the test is performed.<\/span><\/span><\/span><\/li>\n<li><span  style=\"font-size:10pt\"><span  style=\"color:#181818\"><span  style=\"font-family:arial, sans-serif\">Witness Information. The names, addresses, nationalities, ages, occupation, relationship, copies of tourist cards and valid identification of the four witnesses. The Wedding Coordinator will provide the legal form to fill out.<\/span><\/span><\/span><\/li>\n<li><span  style=\"font-size:10pt\"><span  style=\"color:#181818\"><span  style=\"font-family:arial, sans-serif\">Consider the fee for the Judge\u00e2\u20ac\u2122s transportation. The Judge usually performs the civil ceremony at their office, but will oblige to come to the resort if the transportation is provided. The round trip fare from the city is $70 USD. This should be paid directly to the Judge on the wedding day or can be arranged in advance through the wedding coordinator.<\/span><\/span><\/span><\/li>\n<li><span  style=\"font-size:10pt\"><span  style=\"color:#181818\"><span  style=\"font-family:arial, sans-serif\">The Marriage Certificate is only valid in Mexico. In order to make it legal internationally, the Wedding Coordinator will send a copy of your License to the Validation Process. The fee will be $165 USD +11% tax. The process will take up to 2-3 months. Once the document is apostilled, the resort will send all documentation to couples home address.<\/span><\/span><\/span><\/li>\n<\/ul>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>~Trisha~<\/p>\n<p>Destination Wedding Photographer & Travel Agent<br><a  class=\"bbc_url\" href=\"http:\/\/www.faberphotography.com\">www.faberphotography.com<\/a>\u00a0-\u00a0My latest destination wedding photos can be found\u00a0<a  class=\"bbc_url\" href=\"http:\/\/faberphotography.com\/destination-wedding\/\">HERE<\/a><br><br><span style=\"font-family:arial, helvetica, sans-serif;color:rgb(0,128,128);\"><strong>Disney Specialist\u00a0<\/strong><\/span><span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\">\u00a0\/ \u00a0<\/span><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/\" title=\"\"><strong>Bride & Groom Fly FREE Promotion<\/strong><\/a><\/p>\n<p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\">\u00a0<br><strong><span style=\"color:rgb(0,128,128);\"><a  class=\"bbc_url\" href=\"http:\/\/wrighttravelagency.com\/inquiry\/\" title=\"External link\">Looking for a travel agent that KNOWS DISNEY?<\/a><\/span><\/strong><span style=\"color:rgb(0,128,128);\">\u00a0 We are an award winning travel agency and you can\u00a0<\/span><strong><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/\" title=\"\"><span style=\"color:rgb(0,128,128);\">read our reviews\u00a0here.<\/span><\/a><\/strong><br>\n\u00a0<br><span style=\"color:rgb(0,128,128);\"><strong>Awards and recognition:\u00a0<\/strong><\/span><br><span style=\"color:rgb(0,128,128);\">Palace Resorts Winner \"Top Travel Agent\", \"Top Homebased Travel Agency\" PRO Platinum Agency (Top Award) \u00a0 | \u00a0<\/span><span style=\"color:rgb(0,128,128);\">AMResorts Master Agent & Top Agency \u00a0| \u00a0<\/span><span style=\"color:rgb(0,128,128);\">Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator |\u00a0<strong><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/68050-karisma-hotels-givc-and-gi-wedding-consultants-wright-travel-agency\/\" title=\"\">Wright Travel & Karisma GIVC Benefits<\/a>\u00a0|\u00a0<\/strong><\/span><span style=\"color:rgb(0,128,128);\">Travel Impressions Best of the Best Globe Winner \u00a0 | \u00a0 <\/span><span style=\"color:rgb(0,128,128);\">Apple Vacations Golden Apple Winner \u00a0<\/span><br><span><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17612\/sml_gallery_206696_17612_13451.png\" alt=\"sml_gallery_206696_17612_13451.png\"><\/span><span><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"><\/span>\u00a0\u00a0 \u00a0<span><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><\/span><br><span style=\"color:rgb(0,128,128);\"><strong><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010\" title=\"\">Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><strong><span style=\"color:rgb(178,34,34);\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a  class=\"bbc_url\" href=\"mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com\" title=\"External link\">ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"trisha@wrighttravelagency.com","IpAddress":"12.24.226.126","GroupId":46,"GroupName":"VIP Member","JoinDate":1171995300,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207201.jpg?_r=1452788764","PhotoWidth":200,"PhotoHeight":296,"PhotoType":"custom"},"FormattedName":"TATrisha","Id":207201,"Name":"TATrisha","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":66415,"EditedBy":"","EditDate":1392117004,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3d95dba50a40d3daeeeb69d26f68e934","RawContent":"&lt;p&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;strong&gt;Wedding Packages&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;&lt;span style=\"font-size:10pt;\"&gt;&lt;span style=\"color:#181818;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;Your Moments Wedding Package &lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;&lt;span style=\"font-size:10pt;\"&gt;&lt;span style=\"color:#181818;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;2013\/2014 SELLING PRICE $999 USD OR COMPLIMENTARY &lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;span style=\"font-size:10pt;\"&gt;&lt;span style=\"color:#181818;\"&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;(This package is complimentary when booking a minimum of 7 nights in the Preferred Club Ocean View or higher, or if 5 rooms are reserved for a minimum of 3 nights at any room category.)&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;\u2022 Dedicated wedding coordinator\n\n\u2022 Symbolic Ceremony*\n\n\u2022 Bouquet for the bride\n\n\u2022 Boutonniere for the groom\n\n\u2022 Preparation of the couple\u2019s wedding day attire\n\n\u2022 Wedding cake (for up to 10 guests)&lt;\/p&gt;\n&lt;p&gt;\u2022 Sparkling wine toast (for up to 10 guests)\n\n\u2022 Romantic turndown service that evening: rose petal drawn Jacuzzi bath, bottle of sparkling wine and chocolate covered strawberries\n\n\u2022 Late check-out for the bride and groom (upon request)\n\n\u2022 20% off spa treatments&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:medium;\"&gt;&lt;span style=\"font-family:calibri;\"&gt;&lt;strong&gt;&lt;span style=\"font-size:medium;\"&gt;&lt;span style=\"font-family:calibri;\"&gt;Now to Eternity Wedding Package&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:medium;\"&gt;&lt;span style=\"font-family:calibri;\"&gt;&lt;strong&gt;&lt;span style=\"font-size:medium;\"&gt;&lt;span style=\"font-family:calibri;\"&gt;2013 SELLING PRICE $2,399 USD \/\/ 2014 SELLING PRICE $2,499 USD&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;\u2022 Dedicated wedding coordinator\n\n\u2022 Service of a Judge or Minister\n\n\u2022 Bouquet for the bride\n\n\u2022 Boutonniere for the groom\n\n\u2022 Preparation of the couple\u2019s wedding day attire\n\n\u2022 Wedding cake (for up to 25 guests)\n\n\u2022 Sparkling wine toast (for up to 25 guests)\n\n\u2022 Complimentary room upgrade (based on availability)\n\n\u2022 Make-up and hair styling for the bride\n\n\u2022 Private Cocktail Hour with hors d\u2019oeuvres (for up to 25 guests)(silver menu)\n\n\u2022 Private dinner reception (for up to 25 guests)(silver menu)&lt;\/p&gt;\n&lt;p&gt;\u2022 Swedish couples massage treatment (50 minutes)\n\n\u2022 Photo Package (24 full color photographs)\n\n\u2022 Breakfast in bed morning after ceremony with Mimosas\n\n\u2022 1 corsage and 1 boutonniere for the bridesmaid and best man\n\n\u2022 1 floral centerpiece arrangement for the reception table\n\n\u2022 Romantic turndown service that evening: rose petal drawn Jacuzzi bath, bottle of sparkling wine and chocolate covered strawberries\n\n\u2022 Late check-out for the bride and groom (upon request and availability)\n\n\u2022 20% off spa treatments (boutique purchases not included)\n\n\u2022 Free anniversary nights (see pg. 9 for details)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;&lt;span style=\"font-size:medium;\"&gt;&lt;span style=\"font-family:calibri;\"&gt;Diving Wedding Package&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;&lt;span style=\"font-size:medium;\"&gt;&lt;span style=\"font-family:calibri;\"&gt;2013\/2014 SELLING PRICE $2,999 USD&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;\u2022 Dedicated wedding coordinator\n\n\u2022 Service of a Judge or Minister\n\n\u2022 Bouquet for the bride\n\n\u2022 Boutonniere for the groom\n\n\u2022 Preparation of the couple\u2019s wedding day attire\n\n\u2022 Wedding cake for up to 25 guests\n\n\u2022 Sparkling wine toast for up to 25 guests\n\n\u2022 Complimentary room upgrade (based on availability)\n\n\u2022 Makeup and hair styling for the bride on wedding day\n\n\u2022 Swedish couples massage treatment (50 minutes)\n\n\u2022 Breakfast in bed morning after ceremony with Mimosas\n\n\u2022 2 corsages and 2 boutonnieres for the wedding party\n\n\u2022 1 floral centerpiece arrangement for the reception table\n\n\u2022 Gazebo d\u00e9cor \u2014 25 chairs with white covers, ceremonial table and aisle runner\n\n\u2022 Private Cocktail Hour with hors d\u2019oeuvres for up to 25 guests (Platinum menu)&lt;\/p&gt;\n&lt;p&gt;\u2022 Private Dinner Reception for up to 25 guests (Platinum menu)\n\n\u2022 Video of the ceremony (30-minute edited DVD)\n\n\u2022 Choice of guitarist or saxophonist at the ceremony (1 set, 45 minutes)\n\n\u2022 Photo package (24 color photographs taken during the ceremony) and wedding album\n\n\u2022 Romantic turndown service night of the ceremony with rose petal-drawn Jacuzzi bath, bottle of sparkling wine\n\nand chocolate-covered strawberries\n\n\u2022 Romantic dinner on the beach (one evening during stay)\n\n\u2022 Late checkout for the couple (upon request and availability)\n\n\u2022 20% off spa treatments (boutique purchases not included)\n\n\u2022 Free Anniversary Nights (see pg. 9 for details)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:medium;\"&gt;&lt;span style=\"font-family:calibri;\"&gt;If you have over 25 guests the following charges will apply:&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:medium;\"&gt;&lt;span style=\"font-family:calibri;\"&gt;Eternity Dinner: $48 per person&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:medium;\"&gt;&lt;span style=\"font-family:calibri;\"&gt;Diving Dinner: $53 per person&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:medium;\"&gt;&lt;span style=\"font-family:calibri;\"&gt;Cake: $7 per person&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:medium;\"&gt;&lt;span style=\"font-family:calibri;\"&gt;Champagne: $4 per person&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:medium;\"&gt;&lt;span style=\"font-family:calibri;\"&gt;Cocktail hour: $15 per person&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:medium;\"&gt;&lt;span style=\"font-family:calibri;\"&gt;Up can upgrade to the Devine dinner menu for $5 per guest.&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:11pt;\"&gt;&lt;span style=\"font-family:calibri, sans-serif;\"&gt;The wedding packages include white chair covers, white table linens, and white decorations at the ceremony site.&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1595153,"PostDate":1331759374,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span  style=\"font-size:14px\"><strong>Wedding Packages<\/strong><\/span><\/p>\n<p>\u00a0<\/p>\n<p><strong><span  style=\"font-size:10pt\"><span  style=\"color:#181818\"><span  style=\"font-family:arial, sans-serif\">Your Moments Wedding Package <\/span><\/span><\/span><\/strong><\/p>\n<p><strong><span  style=\"font-size:10pt\"><span  style=\"color:#181818\"><span  style=\