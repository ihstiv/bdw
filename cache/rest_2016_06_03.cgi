{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":33,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":5139,"MovedTo":null,"MovedOn":0,"FirstPostId":265864,"Rating":0,"RatingHits":0,"Starter":{"Id":209046,"Name":"enabella","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209046.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"IsOnline":false},"StartDate":1208109256,"LastPoster":{"Id":286788,"Name":"Bnatal80","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286788.jpg?_r=1462549671","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":22,"Preview":{"Id":265864,"PostDate":1208109256,"PostContent":"hello everyone,  so i was planning a wedding in mexico the past few weeks and then we found that...","Author":{"Signature":"","Email":"enabella@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1207682912,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209046.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"enabella","Id":209046,"Name":"enabella","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":14580,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5b45d3505c8e6318086c792dfb60101c","RawContent":"hello everyone,\n \n so i was planning a wedding in mexico the past few weeks and then we found that the prices were a little too much, so now we are planning a wedding in punta cana and i need some help pls.\n \n has anyone been to Riu Palace Punta Cana? pls let me know what you think i really value everyones opinion on this site. pls let me know if you have any pics as well i have read the reviews and they seem good but i just want to confirm and see if anyone had a wedding there and what they did.\n \n thanks to everyone in advance :)","Attachments":[],"Id":265864,"PostDate":1208109256,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                hello everyone,<br \/> <br \/> so i was planning a wedding in mexico the past few weeks and then we found that the prices were a little too much, so now we are planning a wedding in punta cana and i need some help pls.<br \/> <br \/> has anyone been to Riu Palace Punta Cana? pls let me know what you think i really value everyones opinion on this site. pls let me know if you have any pics as well i have read the reviews and they seem good but i just want to confirm and see if anyone had a wedding there and what they did.<br \/> <br \/> thanks to everyone in advance <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"enabella@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1207682912,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209046.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"enabella","Id":209046,"Name":"enabella","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":14580,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fe4bd313f7caa3b392803148bf2d90ca","RawContent":"Here are a few threads I found that may help...\n \n \n &lt;img src=\"http:\/\/media-cdn.tripadvisor.com\/media\/photo-s\/01\/0c\/af\/ee\/vue-de-la-piscine.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n Lobby:\n &lt;img src=\"http:\/\/media-cdn.tripadvisor.com\/media\/photo-s\/01\/0c\/86\/b2\/punta-cana.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n Gazebo:\n &lt;img src=\"http:\/\/media-cdn.tripadvisor.com\/media\/photo-s\/01\/07\/68\/42\/wedding-altar.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n In this shot you can see the Gazebo at the top of the picture. Not sure how private that is, given that the main pool is right there:\n &lt;img src=\"http:\/\/media-cdn.tripadvisor.com\/media\/photo-s\/01\/04\/61\/e0\/balcony-view-of-pool.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n &lt;img src=\"http:\/\/media-cdn.tripadvisor.com\/media\/photo-s\/01\/03\/9c\/88\/hotel-from-the-helicopter.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n This traveler called this the &amp;quot;chapel&amp;quot;:\n &lt;img src=\"http:\/\/media-cdn.tripadvisor.com\/media\/photo-s\/01\/03\/81\/c0\/chapel.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n &lt;img src=\"http:\/\/media-cdn.tripadvisor.com\/media\/photo-s\/01\/03\/81\/c1\/chapel.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n &lt;img src=\"http:\/\/media-cdn.tripadvisor.com\/media\/photo-s\/01\/02\/3d\/48\/hochzeitspavillon.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;\n \n The architecture looks amazing here. Not sure where you&#039;re thinking of having your reception, but there are some really beautiful locations inside that would drop anyone&#039;s jaw!","Attachments":[],"Id":265978,"PostDate":1208115528,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Here are a few threads I found that may help...<br \/> <br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/media-cdn.tripadvisor.com\/media\/photo-s\/01\/0c\/af\/ee\/vue-de-la-piscine.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> Lobby:<br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/media-cdn.tripadvisor.com\/media\/photo-s\/01\/0c\/86\/b2\/punta-cana.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> Gazebo:<br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/media-cdn.tripadvisor.com\/media\/photo-s\/01\/07\/68\/42\/wedding-altar.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> In this shot you can see the Gazebo at the top of the picture. Not sure how private that is, given that the main pool is right there:<br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/media-cdn.tripadvisor.com\/media\/photo-s\/01\/04\/61\/e0\/balcony-view-of-pool.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/media-cdn.tripadvisor.com\/media\/photo-s\/01\/03\/9c\/88\/hotel-from-the-helicopter.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> This traveler called this the \"chapel\":<br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/media-cdn.tripadvisor.com\/media\/photo-s\/01\/03\/81\/c0\/chapel.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/media-cdn.tripadvisor.com\/media\/photo-s\/01\/03\/81\/c1\/chapel.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/media-cdn.tripadvisor.com\/media\/photo-s\/01\/02\/3d\/48\/hochzeitspavillon.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> The architecture looks amazing here. Not sure where you're thinking of having your reception, but there are some really beautiful locations inside that would drop anyone's jaw!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><strong>Happily Married since May 9, 2008<\/strong><br><strong>Proud Mama to Evelyn Eileen since June 8, 2010<\/strong><\/div><\/div>","Email":"aaron_courtney@hotmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1171939980,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207196.JPG?_r=0","PhotoWidth":200,"PhotoHeight":266,"PhotoType":"custom"},"FormattedName":"CourtneyV","Id":207196,"Name":"CourtneyV","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":14580,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9283f4a7fed9c8ee88a4950ad6b95826","RawContent":"We are planning our wedding for next May at the Riu Palace Punta Cana. The resort looks beautiful and they have a great set up for the wedding ceremony. I was in Punta Cana in March and we went and looked at this resort and it is just amazing...and you cannot go wrong with Punta Cana beaches.\n \n The only thing that I have found with this resort is that it is difficult to get answers from the wedding people. And the other thing is that it is getting pricey if you want to have a private reception. We want to have a DJ play at our reception so we are forced to have a private reception...which is either at the steak house for an extra $500 or on the beach for $80\/person with at least 50 adults attending (so at least an extra $4000).\n \n As far as the resort trip advisor has some great info on it...most people like the resort. There are a few complaints about a mildew smell in the rooms, which I am trying to get info from the resort about this as it was said by at least 5 people. Apparently the beds are firm...for some people this is uncomfortable (according to the complaints). But from what we have seen at other resorts and comments from some travel agents, this is one of the best resorts for the money.\n \n I have been doing a ton of research on this property as I cannot find many people who have had their weddings here so if you have any questions let me know.","Attachments":[],"Id":266031,"PostDate":1208119914,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We are planning our wedding for next May at the Riu Palace Punta Cana. The resort looks beautiful and they have a great set up for the wedding ceremony. I was in Punta Cana in March and we went and looked at this resort and it is just amazing...and you cannot go wrong with Punta Cana beaches.<br \/> <br \/> The only thing that I have found with this resort is that it is difficult to get answers from the wedding people. And the other thing is that it is getting pricey if you want to have a private reception. We want to have a DJ play at our reception so we are forced to have a private reception...which is either at the steak house for an extra $500 or on the beach for $80\/person with at least 50 adults attending (so at least an extra $4000).<br \/> <br \/> As far as the resort trip advisor has some great info on it...most people like the resort. There are a few complaints about a mildew smell in the rooms, which I am trying to get info from the resort about this as it was said by at least 5 people. Apparently the beds are firm...for some people this is uncomfortable (according to the complaints). But from what we have seen at other resorts and comments from some travel agents, this is one of the best resorts for the money.<br \/> <br \/> I have been doing a ton of research on this property as I cannot find many people who have had their weddings here so if you have any questions let me know.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/dw.daisypath.com\/RiXkm4\/.png\">http:\/\/dw.daisypath.com\/RiXkm4\/.png<\/a><\/div><\/div>","Email":"lisalay6@cogeco.ca","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1207256058,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209008.gif?_r=0","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"FormattedName":"MrsPetti2Be","Id":209008,"Name":"MrsPetti2Be","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":14580,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8b38e0eb55c0efbca09c099cc2b2ec52","RawContent":"hey ladies thank you so much for the reply i really appreciated the pictures are amazing thanks.\n \n and im so happy i found someone who&#039;s getting married there too :).\n MrsPetti2Be: i hope you find a solution to your reception issue i might have the same problem but i just started planning so i have no idea how many people are gonna show up. but good luck. I actually have a question for you we&#039;re you able to find a site that gave you prices for next year or did you call a travel agent? im trying to find prices and im having a really hard time.","Attachments":[],"Id":267522,"PostDate":1208209343,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                hey ladies thank you so much for the reply i really appreciated the pictures are amazing thanks.<br \/> <br \/> and im so happy i found someone who's getting married there too <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>.<br \/> MrsPetti2Be: i hope you find a solution to your reception issue i might have the same problem but i just started planning so i have no idea how many people are gonna show up. but good luck. I actually have a question for you we're you able to find a site that gave you prices for next year or did you call a travel agent? im trying to find prices and im having a really hard time.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"enabella@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1207682912,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209046.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"enabella","Id":209046,"Name":"enabella","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":14580,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"47736c0e3c416809d94c74fea3965bd6","RawContent":"I called Sunquest and they gave me a quote for my group. I have about 40 adults and 6 children so far so I did get a discounted rate but if you have a general number of guests they can quote you so that you have an idea of the costs.\n \n I tried looking online but no one has pricing for May 2009 yet...we are also looking at leaving out of the United States as it is soo much cheaper (just taxes alone you save $200\/person). We live like 5 minutes from Detroit, Michigan...but the pricing from the states for May doesn&#039;t come out until May or June 2008.\n \n If you are waiting to find pricing online for 2009 you will probably have to wait until July or August as that is when the travel companies publish their rates in their books. If you would like to call sunquest directly their number is 1-877-485-6060. Just so you can compare for us to leave out of Toronto we were quoted from them $1380\/adult +$339 in taxes and $1060\/child +$339 in taxes...and then depending on how many people were coming 1 in every 16 goes for free, only pays taxes. For us to leave out of Detroit this year would cost un $1055\/adult + about $100 in taxes and 1 in every 21 goes for free (only taxes) and they were offering in May every 22nd person also goes free...so you can see how much cheaper it is.","Attachments":[],"Id":267541,"PostDate":1208210092,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I called Sunquest and they gave me a quote for my group. I have about 40 adults and 6 children so far so I did get a discounted rate but if you have a general number of guests they can quote you so that you have an idea of the costs.<br \/> <br \/> I tried looking online but no one has pricing for May 2009 yet...we are also looking at leaving out of the United States as it is soo much cheaper (just taxes alone you save $200\/person). We live like 5 minutes from Detroit, Michigan...but the pricing from the states for May doesn't come out until May or June 2008.<br \/> <br \/> If you are waiting to find pricing online for 2009 you will probably have to wait until July or August as that is when the travel companies publish their rates in their books. If you would like to call sunquest directly their number is 1-877-485-6060. Just so you can compare for us to leave out of Toronto we were quoted from them $1380\/adult +$339 in taxes and $1060\/child +$339 in taxes...and then depending on how many people were coming 1 in every 16 goes for free, only pays taxes. For us to leave out of Detroit this year would cost un $1055\/adult + about $100 in taxes and 1 in every 21 goes for free (only taxes) and they were offering in May every 22nd person also goes free...so you can see how much cheaper it is.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/dw.daisypath.com\/RiXkm4\/.png\">http:\/\/dw.daisypath.com\/RiXkm4\/.png<\/a><\/div><\/div>","Email":"lisalay6@cogeco.ca","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1207256058,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209008.gif?_r=0","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"FormattedName":"MrsPetti2Be","Id":209008,"Name":"MrsPetti2Be","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":14580,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"79c85a7c0d4dc7f202510c92ed1bacdd","RawContent":"This resort is one of my absolute favorites on the island. It&#039;s gorgeous. I&#039;ve got a bunch of pics that I&#039;ll see if I can figure out how to post &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/wink.gif\" border=\"0\" alt=\"\" title=\"Wink\" class=\"inlineimg\" \/&gt;\n \n The beds are hard (to be blunt). Didn&#039;t cause me to lose sleep, but they are definately a &amp;quot;firm&amp;quot; firm. Seems to be a &amp;quot;riu thing&amp;quot; actually, regardless of where the resort is. And the kings are actually 2 queens pushed together. Not that they&#039;ll seperate as you sleep, but it&#039;s just something I always mention to my clients so they&#039;re aware. \n \n One nice thing with this resort is by staying here you have exchange priviledges at the other RIU&#039;s within the complex. You can have meals during the day at other resorts, but dinner only at your own. They have a little street where their &amp;quot;nightlife&amp;quot; is located. The club there is REALLY crazy when it gets late. Very fun. \n \n I didn&#039;t smell anything when I was there. But it&#039;s the caribbean, it&#039;s hot, its humid. So a bit of mustiness is to be expected I guess. Like I said tho, I didn&#039;t notice it. \n \n And remember, when they say &amp;quot;men must wear long pants for dinner&amp;quot;, down there, they mean it. :)","Attachments":[],"Id":267887,"PostDate":1208232228,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                This resort is one of my absolute favorites on the island. It's gorgeous. I've got a bunch of pics that I'll see if I can figure out how to post <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/wink.gif\" border=\"0\" alt=\"\" title=\"Wink\" class=\"inlineimg\" \/><\/span><br \/> <br \/> The beds are hard (to be blunt). Didn't cause me to lose sleep, but they are definately a \"firm\" firm. Seems to be a \"riu thing\" actually, regardless of where the resort is. And the kings are actually 2 queens pushed together. Not that they'll seperate as you sleep, but it's just something I always mention to my clients so they're aware. <br \/> <br \/> One nice thing with this resort is by staying here you have exchange priviledges at the other RIU's within the complex. You can have meals during the day at other resorts, but dinner only at your own. They have a little street where their \"nightlife\" is located. The club there is REALLY crazy when it gets late. Very fun. <br \/> <br \/> I didn't smell anything when I was there. But it's the caribbean, it's hot, its humid. So a bit of mustiness is to be expected I guess. Like I said tho, I didn't notice it. <br \/> <br \/> And remember, when they say \"men must wear long pants for dinner\", down there, they mean it. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"dina@unkissedvacations.net","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1193103300,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207875.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"TA Dina","Id":207875,"Name":"TA Dina","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":14580,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d3534cf9b74100529de38d7f628aef17","RawContent":"One thing I found when researching the Riu&#039;s is that there is some 80% rule, where you have to get married at the hotel in the complex where 80% of you guests are staying. \n \n &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.weddingsbyriu.com\/\"&gt;Wedding Packages by Destination. Honeymoon Holidays. Weddings by Riu&lt;\/a&gt;\n \n If all your guests are at the Palace PC then it shouldn&#039;t cause any headaches. The place is absolutely gorgeous.","Attachments":[],"Id":267949,"PostDate":1208254726,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                One thing I found when researching the Riu's is that there is some 80% rule, where you have to get married at the hotel in the complex where 80% of you guests are staying. <br \/> <br \/> <a href='http:\/\/www.weddingsbyriu.com\/' class='bbc_url' title='External link' rel='nofollow external'>Wedding Packages by Destination. Honeymoon Holidays. Weddings by Riu<\/a><br \/> <br \/> If all your guests are at the Palace PC then it shouldn't cause any headaches. The place is absolutely gorgeous.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;130\/st\/20090424\/e\/Our+Wedding+in+Paradise\/dt\/1\/k\/4d17\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...4d17\/event.png<\/a><\/div><\/div>","Email":"breen_michelle@hotmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1197813306,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208036.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"shellb","Id":208036,"Name":"shellb","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":14580,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1fa2463414434e569bfe74e60830da60","RawContent":"hey ladies thanks for all the info and tips. im having such a hard time with my Fiance&#039;s family i called sunquest to get a quote and its going to be around 1700$ in may or 1900$ in april and the price is crazy and he doesn&#039;t think that hes family is going to pay that much to come to the wedding. so im so confused and i really dont know what to do anymore.\n \n do you guys think its a good idea to wait till sept. and book then or see how the prices are? i really love this hotel and i dont mind looking at another hotel but all the prices are crazy i really need your advice i have no idea what to do anymore.","Attachments":[],"Id":268556,"PostDate":1208286270,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                hey ladies thanks for all the info and tips. im having such a hard time with my Fiance's family i called sunquest to get a quote and its going to be around 1700$ in may or 1900$ in april and the price is crazy and he doesn't think that hes family is going to pay that much to come to the wedding. so im so confused and i really dont know what to do anymore.<br \/> <br \/> do you guys think its a good idea to wait till sept. and book then or see how the prices are? i really love this hotel and i dont mind looking at another hotel but all the prices are crazy i really need your advice i have no idea what to do anymore.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"enabella@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1207682912,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209046.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"enabella","Id":209046,"Name":"enabella","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":14580,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"416fe4cf2ea4696f0723b5fe3dc4f741","RawContent":"The other option is that you guys could stay at the palace and all your family can stay at another riu that is cheap like the Bambu (i think this is a 4 star). The only issue with that is you have to get married at the resort where 80% of the guests are staying...or you can get married at the palace punta cana and the guests not staying there have to pay like $100 each to attend the wedding and reception. Or you can check out the Riu Palace Macao...it is also very nice and a little cheaper but not as much as the bambu.","Attachments":[],"Id":268752,"PostDate":1208292681,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                The other option is that you guys could stay at the palace and all your family can stay at another riu that is cheap like the Bambu (i think this is a 4 star). The only issue with that is you have to get married at the resort where 80% of the guests are staying...or you can get married at the palace punta cana and the guests not staying there have to pay like $100 each to attend the wedding and reception. Or you can check out the Riu Palace Macao...it is also very nice and a little cheaper but not as much as the bambu.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/dw.daisypath.com\/RiXkm4\/.png\">http:\/\/dw.daisypath.com\/RiXkm4\/.png<\/a><\/div><\/div>","Email":"lisalay6@cogeco.ca","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1207256058,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209008.gif?_r=0","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"FormattedName":"MrsPetti2Be","Id":209008,"Name":"MrsPetti2Be","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":14580,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9c50abbb79a326c7c0b2ab62a5776165","RawContent":"yea thank you thats actually a really good idea :) im going to talk to FH tonight and see what he thinks i just feel so stressed out and confused lol i just wish everyone had prices out and not make it so complicated lol. but thanks for your help i guess ill find out tonight.","Attachments":[],"Id":268801,"PostDate":1208294541,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                yea thank you thats actually a really good idea <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> im going to talk to FH tonight and see what he thinks i just feel so stressed out and confused lol i just wish everyone had prices out and not make it so complicated lol. but thanks for your help i guess ill find out tonight.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"enabella@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1207682912,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209046.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"enabella","Id":209046,"Name":"enabella","IsOnline":false}}],"Id":"14580","Title":"riu palace punta cana","LastPostDate":1461333661},"Pages":{"TotalItems":33,"TotalPages":4,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":30},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
