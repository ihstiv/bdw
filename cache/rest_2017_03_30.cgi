{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"67.191.92.116","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80279,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"42342276a007a7ed856dba68d83edb48","RawContent":"@[member=\"phoenixbride\"] of course I do not mind. My friend was married at the excellence in cancun, so I reached out to him and his wife they told me everything and then mentioned that the wedding coordinator decided to start her own company. It&#039;s amazing since she loves there she can actually go to the resorts me and negotiate in person. Etc. I can send you her info if you&#039;d like.\n@[member=\"amberjay00\"] Thailand. That is going to be gorgeous!!!!! \u2764\ufe0f\u2764\ufe0f\u2764\ufe0f Congrats","Attachments":[],"Id":1915700,"PostDate":1474366049,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"287765\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='https:\/\/www.bestdestinationwedding.com\/user\/287765-phoenixbride\/' title='Member profile'><span itemprop=\"name\">phoenixbride<\/span><\/a> of course I do not mind. My friend was married at the excellence in cancun, so I reached out to him and his wife they told me everything and then mentioned that the wedding coordinator decided to start her own company. It's amazing since she loves there she can actually go to the resorts me and negotiate in person. Etc. I can send you her info if you'd like.<br \/>@<a hovercard-ref=\"member\" hovercard-id=\"287668\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='https:\/\/www.bestdestinationwedding.com\/user\/287668-amberjay00\/' title='Member profile'><span itemprop=\"name\">amberjay00<\/span><\/a> Thailand. That is going to be gorgeous!!!!! \u2764\ufe0f\u2764\ufe0f\u2764\ufe0f Congrats \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sambrefe67@gmail.com","IpAddress":"67.191.92.116","GroupId":39,"GroupName":"Newbie","JoinDate":1472047560,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-287613.jpg?_r=1476350829","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"Stacsoontobeegan","Id":287613,"Name":"Stacsoontobeegan","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"167.94.2.14","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80279,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a96d6d07b56cbf09925dcfac077b1ca1","RawContent":"&lt;p&gt;@[member=\"Stacsoontobeegan\"] that would be wonderful!! thank you thank you!&lt;\/p&gt;","Attachments":[],"Id":1915702,"PostDate":1474387499,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"287613\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='https:\/\/www.bestdestinationwedding.com\/user\/287613-stacsoontobeegan\/' title='Member profile'><span itemprop=\"name\">Stacsoontobeegan<\/span><\/a> that would be wonderful!! thank you thank you!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"yazil1304@gmail.com","IpAddress":"75.171.71.115","GroupId":39,"GroupName":"Newbie","JoinDate":1474227573,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-287765.jpg?_r=1474333958","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"phoenixbride","Id":287765,"Name":"phoenixbride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"69.27.229.128","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80279,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c4eba81aa512a0fd2b12d785a5c4dcb2","RawContent":"&lt;p&gt;Hi, I&#039;m also planning to get married in August 2018. I haven&#039;t decided on a location yet because I keep changing my mind. I&#039;m stuck between Saint Lucia and Dreams (Cancun). I really need to make up my mind. I want a beautiful location with decent packages and to customize will not break the bank. HELP!! lol&amp;nbsp; :)&lt;\/p&gt;","Attachments":[],"Id":1915806,"PostDate":1475174706,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi, I'm also planning to get married in August 2018. I haven't decided on a location yet because I keep changing my mind. I'm stuck between Saint Lucia and Dreams (Cancun). I really need to make up my mind. I want a beautiful location with decent packages and to customize will not break the bank. HELP!! lol\u00a0 <img src='https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tonishabenfield@gmail.com","IpAddress":"69.27.229.128","GroupId":39,"GroupName":"Newbie","JoinDate":1475174161,"Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"MrsDickerson2016","Id":287828,"Name":"MrsDickerson2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"187.189.63.164","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80279,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f9fa101fb0da38a3c8652c31153d1b6a","RawContent":"&lt;p&gt;Hi @[member=\"Stacsoontobeegan\"] !\n\n2018 bride, exciting!\n\nYou are at the best community to find everything you need, even if it\u00b4s a simple opinion :)\n\nGenerations Riviera Maya is a warranty of full exclusive service for your BIG DAY, the food is really amazing and their wedding parties are a dream come true, they take care of every single detail, they are fantastic, i bet your Wedding Coordinator is doing a great job for you two :)\n\nLet me show you some of my photography job taken in some beaches near there at Puerto Morelos; ceremony, getting ready, the reception, everything is cover, even if you want to trash the dress, i got it, i bet you are going to love them!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Enjoy!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;this one was taken under the buldings of the Generation. these are pillars that support it, and looks great for pictures:&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"http:\/\/www.gonzalonunez.com\/fotosparablogs\/post9.jpg\" alt=\"post9.jpg\"&gt;&lt;\/p&gt;","Attachments":[],"Id":1915933,"PostDate":1476220963,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi @<a hovercard-ref=\"member\" hovercard-id=\"287613\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='https:\/\/www.bestdestinationwedding.com\/user\/287613-stacsoontobeegan\/' title='Member profile'><span itemprop=\"name\">Stacsoontobeegan<\/span><\/a> !<br>\n2018 bride, exciting!<br>\nYou are at the best community to find everything you need, even if it\u00b4s a simple opinion <img src='https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br>\nGenerations Riviera Maya is a warranty of full exclusive service for your BIG DAY, the food is really amazing and their wedding parties are a dream come true, they take care of every single detail, they are fantastic, i bet your Wedding Coordinator is doing a great job for you two <img src='https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br>\nLet me show you some of my photography job taken in some beaches near there at Puerto Morelos; ceremony, getting ready, the reception, everything is cover, even if you want to trash the dress, i got it, i bet you are going to love them!<\/p>\n<p>\u00a0<\/p>\n<p>Enjoy!<\/p>\n<p>\u00a0<\/p>\n<p>this one was taken under the buldings of the Generation. these are pillars that support it, and looks great for pictures:<\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/www.gonzalonunez.com\/fotosparablogs\/post9.jpg\" alt=\"post9.jpg\"><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<img src='http:\/\/www.gonzalonunez.com\/BDW\/firma.jpg' alt='Posted Image' class='bbc_img' \/><br \/>\n<br \/>\nGonzalo Nunez - WEDDING PHOTOGRAPHER - <a class='bbc_url' href='http:\/\/www.gonzalonunez.com'>www.gonzalonunez.com<\/a> - <a class='bbc_url' href='http:\/\/www.facebook.com\/GonzaloNunezWeddingPhotographer'>Facebook Fanpage<\/a><br \/>\nCancun, Playa del Carmen, Tulum, Riviera Maya, Mexico, rest of the world.","Email":"info@gonzalonunez.com","IpAddress":"187.179.168.180","GroupId":49,"GroupName":"Insiders","JoinDate":1282081879,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-231467.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"gonzaloNunez","Id":231467,"Name":"gonzaloNunez","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.156.255.151","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80279,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"82d837a2df510464c0532273bf80779f","RawContent":"Hi there fellow 2018 brides\ud83d\ude00\n\nI am in the begining stages of planing a destination wedding for Jan 2018.\n\nWe will have a small group of 10 attending and adulta only resort. \n\nI am having a hard time picking a resort and location grr. So far in my research in punta cana DR i like the majestic collonial and ellegance and the sensorati. \n\nAnd cuba i like the Royalton Hicacos in Varadero.\n\nIt is so hard to decide what reaort to pick as i have never been to cuba or DR.\n\nAny suggestions ?\n\n\nThanks in advance\n\n\nIsabelle","Attachments":[],"Id":1917074,"PostDate":1484742797,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi there fellow 2018 brides\ud83d\ude00<br>\nI am in the begining stages of planing a destination wedding for Jan 2018.<br>\nWe will have a small group of 10 attending and adulta only resort. <br>\nI am having a hard time picking a resort and location grr. So far in my research in punta cana DR i like the majestic collonial and ellegance and the sensorati. <br>\nAnd cuba i like the Royalton Hicacos in Varadero.<br>\nIt is so hard to decide what reaort to pick as i have never been to cuba or DR.<br>\nAny suggestions ?<br><br>\nThanks in advance<br><br>\nIsabelle\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"isaseb9912@yahoo.ca","IpAddress":"24.156.255.151","GroupId":39,"GroupName":"Newbie","JoinDate":1484704108,"Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"isamarc18","Id":288323,"Name":"isamarc18","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"73.50.40.227","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80279,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b6117a22b5dc0acdc6f644343ecc5338","RawContent":"&lt;p&gt;I&#039;m nearly finalized on securing Azul Sensatori.   I almost did Now Sapphire but the reviews on the smaller forums like this were better for Sensatori and the resort seemed nicer.   I&#039;m going through Shelli with Romance Travel Group.&amp;nbsp; So far so good.   If anyone has worked with her or that resort I&#039;d love to know more!&lt;\/p&gt;","Attachments":[],"Id":1917373,"PostDate":1489120436,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I'm nearly finalized on securing Azul Sensatori.\u00a0\u00a0 I almost did Now Sapphire but the reviews on the smaller forums like this were better for Sensatori and the resort seemed nicer.\u00a0\u00a0 I'm going through Shelli with Romance Travel Group.\u00a0 So far so good.\u00a0\u00a0 If anyone has worked with her or that resort I'd love to know more!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jamieandalvis@gmail.com","IpAddress":"73.50.40.227","GroupId":39,"GroupName":"Newbie","JoinDate":1489118779,"Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"jkauther","Id":288584,"Name":"jkauther","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"92.237.184.116","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80279,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"07de4edf2aa36ac452ea70c80a1f27d0","RawContent":"&lt;p&gt;I&#039;m April, 2018 bride - we just selected azul fives by karisma as our location - i read tons of great things about the resort and helps that my mom is a travel agent as well! anyone else doing azul fives?&lt;\/p&gt;","Attachments":[],"Id":1917457,"PostDate":1490205984,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I'm April, 2018 bride - we just selected azul fives by karisma as our location - i read tons of great things about the resort and helps that my mom is a travel agent as well! anyone else doing azul fives?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kaleylevene@hotmail.com","IpAddress":"92.237.184.116","GroupId":39,"GroupName":"Newbie","JoinDate":1490195510,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-288651.jpg?_r=1490205768","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"kaleykapri","Id":288651,"Name":"kaleykapri","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.187.229.252","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80279,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f1a379c53cefd3f052ce756c85a63d45","RawContent":"&lt;p&gt;Hi 2018 Brides! It may SEEM to be far away but 2018 is really just around the corner, and you are all very wise to make your resort selections, get the wedding date booked, and hold your rooms at your selected resort now, so that you know you can have the date and space you will need!&lt;\/p&gt;\n&lt;p&gt;We here at Wright Travel Agency are in the US, but work with all of the resorts, and are very familiar with all of the promotions offered for groups.&lt;\/p&gt;\n&lt;p&gt;We all travel to visit new properties, and are here and ready to be your TA resource!&lt;\/p&gt;\n&lt;p&gt;Please let one of the agents at Wright Travel Agency help you to find and confirm your resort and date for you!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;TA Wendy&lt;\/p&gt;\n&lt;p&gt;Wright Travel Agency&lt;\/p&gt;\n\n&lt;p&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;&lt;a  class=\"bbc_url\" href=\"https:\/\/www.wrighttravelagency.com\/go\/destination-wedding\/?source=EMLSIG\" title=\"External link\"&gt;&lt;strong&gt;&lt;span style=\"color:#008080;\"&gt;Looking for a travel agency that specializes in Destination Weddings-CLICK HERE&lt;\/span&gt;&lt;\/strong&gt;&lt;\/a&gt;&lt;span style=\"color:#008080;\"&gt;&lt;strong&gt;?&lt;\/strong&gt; &amp;nbsp;We are an award winning travel agency and you can &lt;\/span&gt;&lt;strong&gt;&lt;a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/\" title=\"\"&gt;&lt;span style=\"color:#008080;\"&gt;read our reviews&amp;nbsp;here.&lt;\/span&gt;&lt;\/a&gt;&lt;\/strong&gt;&lt;\/span&gt;\n\n&amp;nbsp;\n&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;&lt;span style=\"color:#008080;\"&gt;&lt;strong&gt;Awards and recognition:&amp;nbsp;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/span&gt;\n&lt;span style=\"color:#008080;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;Palace Resorts Winner \"Top Travel Agent\", \"Top Homebased Travel Agency\" PRO Platinum Agency (Top Award) &amp;nbsp; &amp;nbsp; | &amp;nbsp; &amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;span style=\"color:#008080;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;AMResorts Master Agent &amp;amp; Top Agency &amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;\n&lt;span style=\"color:#008080;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | &lt;a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/68050-karisma-hotels-givc-and-gi-wedding-consultants-wright-travel-agency\/\" title=\"\"&gt;&lt;strong&gt;Wright Travel &amp;amp; Karisma GIVC Benefits&lt;\/strong&gt;&lt;\/a&gt;&lt;\/span&gt;&lt;\/span&gt;\n&lt;span style=\"color:#008080;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;Travel Impressions Best of the Best Globe Winner &amp;nbsp; &amp;nbsp;| &amp;nbsp;   &lt;\/span&gt;&lt;\/span&gt;&lt;span style=\"color:#008080;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;Apple Vacations Golden Apple Winner &amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;\n&lt;span&gt;&lt;img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17612\/sml_gallery_206696_17612_13451.png\" alt=\"sml_gallery_206696_17612_13451.png\"&gt;&lt;\/span&gt;&lt;span&gt;&lt;img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"&gt;&lt;\/span&gt; &amp;nbsp; &amp;nbsp;&lt;span&gt;&lt;img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"&gt;&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1917464,"PostDate":1490290046,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi 2018 Brides! It may SEEM to be far away but 2018 is really just around the corner, and you are all very wise to make your resort selections, get the wedding date booked, and hold your rooms at your selected resort now, so that you know you can have the date and space you will need!<\/p>\n<p>We here at Wright Travel Agency are in the US, but work with all of the resorts, and are very familiar with all of the promotions offered for groups.<\/p>\n<p>We all travel to visit new properties, and are here and ready to be your TA resource!<\/p>\n<p>Please let one of the agents at Wright Travel Agency help you to find and confirm your resort and date for you!<\/p>\n<p>\u00a0<\/p>\n<p>TA Wendy<\/p>\n<p>Wright Travel Agency<\/p>\n<br \/><p><span  style=\"font-family:arial, helvetica, sans-serif\"><a href='https:\/\/www.wrighttravelagency.com\/go\/destination-wedding\/?source=EMLSIG' class='bbc_url' title='External link' rel='nofollow external'><strong><span  style=\"color:#008080\">Looking for a travel agency that specializes in Destination Weddings-CLICK HERE<\/span><\/strong><\/a><span  style=\"color:#008080\"><strong>?<\/strong> \u00a0We are an award winning travel agency and you can <\/span><strong><a href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/' class='bbc_url' title=''><span  style=\"color:#008080\">read our reviews\u00a0here.<\/span><\/a><\/strong><\/span><br>\n\u00a0<br><span  style=\"font-family:arial, helvetica, sans-serif\"><span  style=\"color:#008080\"><strong>Awards and recognition:\u00a0<\/strong><\/span><\/span><br><span  style=\"color:#008080\"><span  style=\"font-family:arial, helvetica, sans-serif\">Palace Resorts Winner \"Top Travel Agent\", \"Top Homebased Travel Agency\" PRO Platinum Agency (Top Award) \u00a0 \u00a0 | \u00a0 \u00a0<\/span><\/span><span  style=\"color:#008080\"><span  style=\"font-family:arial, helvetica, sans-serif\">AMResorts Master Agent & Top Agency \u00a0<\/span><\/span><br><span  style=\"color:#008080\"><span  style=\"font-family:arial, helvetica, sans-serif\">Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | <a href='http:\/\/www.bestdestinationwedding.com\/topic\/68050-karisma-hotels-givc-and-gi-wedding-consultants-wright-travel-agency\/' class='bbc_url' title=''><strong>Wright Travel & Karisma GIVC Benefits<\/strong><\/a><\/span><\/span><br><span  style=\"color:#008080\"><span  style=\"font-family:arial, helvetica, sans-serif\">Travel Impressions Best of the Best Globe Winner \u00a0 \u00a0| \u00a0 \u00a0\u00a0<\/span><\/span><span  style=\"color:#008080\"><span  style=\"font-family:arial, helvetica, sans-serif\">Apple Vacations Golden Apple Winner \u00a0<\/span><\/span><br><span><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17612\/sml_gallery_206696_17612_13451.png\" alt=\"sml_gallery_206696_17612_13451.png\"><\/span><\/span><span><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"><\/span><\/span> \u00a0 \u00a0<span><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><\/span><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><a class='bbc_url' href='http:\/\/wrighttravelagency.com\/inquiry\/'><span style='color: rgb(0,128,128)'>Looking for a travel agency that specializes in Destination Weddings<\/span><\/a><span style='color: rgb(0,128,128)'>? We are an award winning travel agency and you can read our reviews <\/span><a class='bbc_url' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style='color: rgb(0,128,128)'><strong class='bbc'>HERE.<\/strong><\/span><\/a><\/span><\/span><br \/>\n<br \/>\n<span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'><strong class='bbc'>Awards and recognition: <\/strong><\/span><\/span><\/span><\/span><br \/>\n<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'>Palace Resorts Top PRO Agency <\/span><\/span><\/span><\/span><br \/>\n<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'>Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator <\/span><\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>AMResorts Master Agent & Top Agency<\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>Travel Impressions Best of the Best Globe Winner<\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>Apple Vacations Golden Apple Winner<\/span><\/span><\/span>","Email":"wendyhicks1@sbcglobal.net","IpAddress":"99.187.229.252","GroupId":49,"GroupName":"Insiders","JoinDate":1238034240,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-216154.jpg?_r=1419958783","PhotoWidth":200,"PhotoHeight":250,"PhotoType":"custom"},"FormattedName":"TA Wendy","Id":216154,"Name":"TA Wendy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"76.95.180.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80279,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"de52dd61099912caab7e34f3187f56dc","RawContent":"&lt;p&gt;Congratulations to all of the 2018 brides!! Now is definitely the time to begin the planning process if you haven&#039;t already so. My name is Patty and I am one of the TA&#039;s with Wright Travel Agency and the BDW forum. All of the WTA travel agents are destination wedding specialists with years of experience and we have visited many properties in the Caribbean and Mexico.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We do not charge any fees for our services and our job is to help make your planning process go as smoothly as possible to help you create the destination wedding of your dreams!! Just click the link below if you&#039;d like a WTA travel agent to contact you! &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1917469,"PostDate":1490293431,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congratulations to all of the 2018 brides!! Now is definitely the time to begin the planning process if you haven't already so. My name is Patty and I am one of the TA's with Wright Travel Agency and the BDW forum. All of the WTA travel agents are destination wedding specialists with years of experience and we have visited many properties in the Caribbean and Mexico.<\/p>\n<p>\u00a0<\/p>\n<p>We do not charge any fees for our services and our job is to help make your planning process go as smoothly as possible to help you create the destination wedding of your dreams!! Just click the link below if you'd like a WTA travel agent to contact you! \u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><a class='bbc_url' href='http:\/\/wrighttravelagency.com\/inquiry\/'><span style='color: rgb(0,128,128)'>Looking for a travel agency that specializes in Destination Weddings<\/span><\/a><span style='color: rgb(0,128,128)'>? We are an award winning travel agency and you can read our reviews <\/span><a class='bbc_url' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style='color: rgb(0,128,128)'><strong class='bbc'>HERE.<\/strong><\/span><\/a><\/span><\/span><br \/>\n<br \/>\n<span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'><strong class='bbc'>Awards and recognition: <\/strong><\/span><\/span><\/span><\/span><br \/>\n<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'>Palace Resorts Top PRO Agency <\/span><\/span><\/span><\/span><br \/>\n<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'>Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator <\/span><\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>AMResorts Master Agent & Top Agency<\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>Travel Impressions Best of the Best Globe Winner<\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>Apple Vacations Golden Apple Winner<\/span><\/span><\/span><span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='font-size: 12px;'><span style='color: rgb(0,128,128)'>5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | AMResorts Master Agent & Top Agency | <\/span><span style='color: rgb(0,128,128)'>Travel Impressions Best of the Best Globe Winner | Apple Vacations Golden Apple Winner <\/span><\/span><\/span><\/span>","Email":"patty@wrighttravelagency.com","IpAddress":"76.95.92.213","GroupId":49,"GroupName":"Insiders","JoinDate":1278657480,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-230028.jpg?_r=1398727965","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"TA Patty","Id":230028,"Name":"TA Patty","IsOnline":false}}],"Pages":{"TotalItems":19,"TotalPages":2,"CurrentPage":10,"NextPage":-1,"PreviousPage":0,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
