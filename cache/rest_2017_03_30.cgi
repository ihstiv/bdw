{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":1,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":152,"MovedTo":null,"MovedOn":0,"FirstPostId":1917374,"Rating":0,"RatingHits":0,"Starter":{"Id":288583,"Name":"TempleOwl84","Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1489120878,"LastPoster":{"Id":288583,"Name":"TempleOwl84","Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":23,"Preview":{"Id":1917374,"PostDate":1489120878,"PostContent":"Hi guys, \u00a0 My fiance and I are deciding on which resort we would like to have our destination wed...","Author":{"Signature":"","Email":"ccmcavinue@yahoo.com","IpAddress":"174.57.171.67","GroupId":39,"GroupName":"Newbie","JoinDate":1489117273,"Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"TempleOwl84","Id":288583,"Name":"TempleOwl84","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.57.171.67","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80973,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"859faaab00d1ca57bf95eb4ffe4891b6","RawContent":"&lt;p&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"font-family:georgia, serif;\"&gt;Hi guys,&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"font-family:georgia, serif;\"&gt;My fiance and I are deciding on which resort we would like to have our destination wedding at. &amp;nbsp;Our wedding is August 4, 2018. &amp;nbsp;We plan on having a \"weddingmoon.\" &amp;nbsp;We are from the United States.&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"font-family:georgia, serif;\"&gt;We cannot decide between Sandals Negril Beach &amp;amp; Spa or&amp;nbsp;&lt;span style=\"color:rgb(51,51,51);\"&gt;Hideaway at Royalton Negril. &amp;nbsp;We definitely want an Adults-Only resort. &amp;nbsp;Hideaway Royalton Negril is not open yet. &amp;nbsp;They were supposed to open in January of this year, but its been pushed back a few times to March 31, 2017. &amp;nbsp;I am hoping to speak to a wedding representative in the first week of April to see if my date is available. &amp;nbsp;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Does anybody here know of someone having a wedding at a Royalton Resort? &amp;nbsp;That would be my first choice. &amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Anybody here have their wedding at Sandals Negril Beach &amp;amp; Spa? &amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I have invited 40 people, but I doubt most will come. &amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;My fiance and I stayed at Luxury Grand Bahia Principe in Runaway Bay in September 2016. &amp;nbsp;We loved it there, but want to try some place new!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Any information is appreciated!&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1917374,"PostDate":1489120878,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span  style=\"font-size:14px\"><span  style=\"font-family:georgia, serif\">Hi guys,<\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-size:14px\"><span  style=\"font-family:georgia, serif\">My fiance and I are deciding on which resort we would like to have our destination wedding at. \u00a0Our wedding is August 4, 2018. \u00a0We plan on having a \"weddingmoon.\" \u00a0We are from the United States.<\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-size:14px\"><span  style=\"font-family:georgia, serif\">We cannot decide between Sandals Negril Beach & Spa or\u00a0<span  style=\"color:rgb(51,51,51)\">Hideaway at Royalton Negril. \u00a0We definitely want an Adults-Only resort. \u00a0Hideaway Royalton Negril is not open yet. \u00a0They were supposed to open in January of this year, but its been pushed back a few times to March 31, 2017. \u00a0I am hoping to speak to a wedding representative in the first week of April to see if my date is available. \u00a0<\/span><\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p>Does anybody here know of someone having a wedding at a Royalton Resort? \u00a0That would be my first choice. \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Anybody here have their wedding at Sandals Negril Beach & Spa? \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I have invited 40 people, but I doubt most will come. \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>My fiance and I stayed at Luxury Grand Bahia Principe in Runaway Bay in September 2016. \u00a0We loved it there, but want to try some place new!<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Any information is appreciated!\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ccmcavinue@yahoo.com","IpAddress":"174.57.171.67","GroupId":39,"GroupName":"Newbie","JoinDate":1489117273,"Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"TempleOwl84","Id":288583,"Name":"TempleOwl84","IsOnline":false}}],"Id":"80973","Title":"Deciding On Which Resort","LastPostDate":1489120878},"Pages":{"TotalItems":1,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
