{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":3,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":251,"MovedTo":null,"MovedOn":0,"FirstPostId":1916470,"Rating":0,"RatingHits":0,"Starter":{"Id":287891,"Name":"Mzzash","Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1476702213,"LastPoster":{"Id":288499,"Name":"kevanstewart","Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":23,"Preview":{"Id":1916470,"PostDate":1476702213,"PostContent":"I recently came across the WC Almaire from Tropical weddings Jamaica. I have read great things ab...","Author":{"Signature":"","Email":"ashleyclarke1988@me.com","IpAddress":"174.112.113.250","GroupId":39,"GroupName":"Newbie","JoinDate":1476336240,"Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Mzzash","Id":287891,"Name":"Mzzash","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"158.106.84.137","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80812,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d0d4a0f96b57947d58bb04bd4fb4b0f1","RawContent":"&lt;p&gt;I recently came across the WC Almaire from Tropical weddings Jamaica. I have read great things about her through is website as well as weddingwire.com&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am wondering if anyone is currently working with her now for their upcoming wedding? or if anyone has worked with her for their wedding in the past (within the last 2years) Her response times are great within 24hrs. I am just a little nervous.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;thanks&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1916470,"PostDate":1476702213,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I recently came across the WC Almaire from Tropical weddings Jamaica. I have read great things about her through is website as well as weddingwire.com\u00a0<\/p>\n<p>I am wondering if anyone is currently working with her now for their upcoming wedding? or if anyone has worked with her for their wedding in the past (within the last 2years) Her response times are great within 24hrs. I am just a little nervous.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>thanks\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ashleyclarke1988@me.com","IpAddress":"174.112.113.250","GroupId":39,"GroupName":"Newbie","JoinDate":1476336240,"Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Mzzash","Id":287891,"Name":"Mzzash","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.26.160.180","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80812,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4573ddcb1b36743d8e4434df3a154b1f","RawContent":"I worked with her for my wedding in April 2016. Everything turned out how I expected. What specific questions do you have?","Attachments":[],"Id":1916550,"PostDate":1477135723,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I worked with her for my wedding in April 2016. Everything turned out how I expected. What specific questions do you have?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10743;484\/st\/20160413\/e\/Wedding+Day\/k\/c760\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n","Email":"lm_sprowl@hotmail.com","IpAddress":"75.26.164.62","GroupId":39,"GroupName":"Newbie","JoinDate":1418275431,"Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"cruisebride2016","Id":281378,"Name":"cruisebride2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.252.215.178","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80812,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e6aa5956647f8c9cc9a7c73096c741a0","RawContent":"&lt;p&gt;I am a DJ and I&#039;ve worked with Almarie on several weddings over the years and I think she&#039;s great,her clients love her and I&#039;m positive that you&#039;re going to get exactly what you&#039;re looking for.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1917338,"PostDate":1488989008,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I am a DJ and I've worked with Almarie on several weddings over the years and I think she's great,her clients love her and I'm positive that you're going to get exactly what you're looking for.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"marketing@reggaetech.com","IpAddress":"184.170.22.110","GroupId":39,"GroupName":"Newbie","JoinDate":1487604353,"Photo":{"HasPhoto":false,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kevanstewart","Id":288499,"Name":"kevanstewart","IsOnline":false}}],"Id":"80812","Title":"Tropical Weddings Jamaica (Almarie)","LastPostDate":1488989008},"Pages":{"TotalItems":3,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
