174","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"JasminMattPhoto","Id":287055,"Name":"JasminMattPhoto","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.28.97.157","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80279,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c66d4702c61476b82a0642775e9ded55","RawContent":"&lt;p&gt;Hi @[member=\"Stacsoontobeegan\"] !&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;My SO and I are planning a 2018 destination wedding also and are looking in the same areas! We are planning a site visit to the Cancun\/Playa Del Carmen area in November and will be visiting Generations Riviera Maya as that is on our list as well. Keep in touch and I&#039;ll share pictures\/reviews when I go.. we are also looking at Hyatt Ziva Cancun, Beach Palace, Azul Beach, and Secrets Maroma.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Best of Luck!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;M&lt;\/p&gt;","Attachments":[],"Id":1915528,"PostDate":1472740924,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi @<a hovercard-ref=\"member\" hovercard-id=\"287613\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='https:\/\/www.bestdestinationwedding.com\/user\/287613-stacsoontobeegan\/' title='Member profile'><span itemprop=\"name\">Stacsoontobeegan<\/span><\/a> !<\/p>\n<p>\u00a0<\/p>\n<p>My SO and I are planning a 2018 destination wedding also and are looking in the same areas! We are planning a site visit to the Cancun\/Playa Del Carmen area in November and will be visiting Generations Riviera Maya as that is on our list as well. Keep in touch and I'll share pictures\/reviews when I go.. we are also looking at Hyatt Ziva Cancun, Beach Palace, Azul Beach, and Secrets Maroma.<\/p>\n<p>\u00a0<\/p>\n<p>Best of Luck!<\/p>\n<p>\u00a0<\/p>\n<p>M<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"megan.higgins512@gmail.com","IpAddress":"108.171.135.170","GroupId":39,"GroupName":"Newbie","JoinDate":1472008917,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-287610.jpg?_r=1472011295","PhotoWidth":169,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"motevoli","Id":287610,"Name":"motevoli","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"120.16.206.161","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80279,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"a6bdf156adfacef8e6106a55f1656980","RawContent":"2018 seems so far away but when you have to plan a wedding.. It&#039;s not too far away!\n\n\nI&#039;m planning on a July wedding in Thailand in 2018! So excited. struggling to find some information on wedding planners though.","Attachments":[],"Id":1915536,"PostDate":1472795470,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                2018 seems so far away but when you have to plan a wedding.. It's not too far away!<br><br>\nI'm planning on a July wedding in Thailand in 2018! So excited. struggling to find some information on wedding planners though.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"amberjay__@hotmail.com","IpAddress":"120.16.15.8","GroupId":39,"GroupName":"Newbie","JoinDate":1472769721,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-287668.jpg?_r=1474349921","PhotoWidth":200,"PhotoHeight":199,"PhotoType":"facebook"},"FormattedName":"amberjay00","Id":287668,"Name":"amberjay00","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"187.153.92.74","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80279,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7aa90ad2554ee3c84f3f2b2c2d0d2b76","RawContent":"&lt;p&gt;@[member=\"amberjay00\"] wow Thailand, that sounds so amazing &amp;lt;3&lt;\/p&gt;","Attachments":[],"Id":1915545,"PostDate":1472926067,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"287668\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='https:\/\/www.bestdestinationwedding.com\/user\/287668-amberjay00\/' title='Member profile'><span itemprop=\"name\">amberjay00<\/span><\/a> wow Thailand, that sounds so amazing <3<\/p>\n\r\n              <\/body>\r\n            <\/html>","Auth