{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":24,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":true,"Views":853,"MovedTo":null,"MovedOn":0,"FirstPostId":1897864,"Rating":0,"RatingHits":0,"Starter":{"Id":276860,"Name":"Maggietron","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1433383818,"LastPoster":{"Id":282132,"Name":"KatieMcBride","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282132.jpg?_r=1435126196","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"facebook"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":33,"Preview":{"Id":1897864,"PostDate":1433383818,"PostContent":"We have groomsmen across Canada (and 1 in New York) and we are trying to find a nationwide (or in...","Author":{"Signature":"","Email":"magscharron@gmail.com","IpAddress":"64.141.11.150","GroupId":40,"GroupName":"Jr. Member","JoinDate":1393267130,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Maggietron","Id":276860,"Name":"Maggietron","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"96.125.245.37","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79243,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0a4900066ff4110d1bdefb4f189c123d","RawContent":"&lt;p&gt;We have groomsmen across Canada (and 1 in New York) and we are trying to find a nationwide (or international) chain that carries linen pants for a beach wedding. Linen shirts as well, although we can pick up plain white collared shirts anywhere if need be.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Where did you get yours?&lt;\/p&gt;","Attachments":[],"Id":1897864,"PostDate":1433383818,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>We have groomsmen across Canada (and 1 in New York) and we are trying to find a nationwide (or international) chain that carries linen pants for a beach wedding. Linen shirts as well, although we can pick up plain white collared shirts anywhere if need be.<\/p>\n<p>\u00a0<\/p>\n<p>Where did you get yours?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"magscharron@gmail.com","IpAddress":"64.141.11.150","GroupId":40,"GroupName":"Jr. Member","JoinDate":1393267130,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Maggietron","Id":276860,"Name":"Maggietron","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"209.52.88.188","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79243,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"522e09506a90fceecc18e89e8bb38243","RawContent":"We haven&#039;t crossed this bridge yet, but have heard that others have gone to: Moore&#039;s, the Bay, Tommy Bahama, Old Navy, RW. \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1897916,"PostDate":1433437716,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We haven't crossed this bridge yet, but have heard that others have gone to: Moore's, the Bay, Tommy Bahama, Old Navy, RW. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>- Erin<\/p>\n<p>\u00a0<\/p>\n<p>My planning thread:\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268'>http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268<\/a>","Email":"ekjzwedding@gmail.com","IpAddress":"24.85.127.174","GroupId":40,"GroupName":"Jr. Member","JoinDate":1417449445,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281283.jpg?_r=1428779369","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"vancouverpetunia","Id":281283,"Name":"vancouverpetunia","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"184.151.222.153","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79243,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8a3438c38dbcc611457496ac99aff222","RawContent":"I&#039;m no help. Shorts came from Bootlegger and tops from Tip Top Tailers.  Also recommend trying Le Chateau in addition to the great suggestions above. \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1897924,"PostDate":1433443206,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm no help. Shorts came from Bootlegger and tops from Tip Top Tailers.  Also recommend trying Le Chateau in addition to the great suggestions above. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399428602,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.32.84.229","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79243,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e668dc49935c1eb7666a26bacd962891","RawContent":"Hello! My groomsmen bought their outfits from old navy! \n\n\nI&#039;ll be posting pics of them from the actual wedding soon! Just waiting to get the pictures back haha; our photographer had over 1400 photos of just the wedding day to go through so may be a little bit coming in lol!!\n\n\n\nSent from my iPhone using Tapatalk\nIf you&#039;re looking for linen it would be Le chateau you need to go to. That&#039;s where my husband bought his linen suit as well as my uncle who walked me down the aisle! \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1897931,"PostDate":1433451099,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hello! My groomsmen bought their outfits from old navy! <a class='resized_img' rel='lightbox[1897931]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_06_2015\/post-282430-143345093251.jpg\" title=\"ImageUploadedByTapatalk1433450932.031049.jpg - Size: 188.85KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_06_2015\/post-282430-143345093251.jpg\" class='bbc_img linked-image' alt=\"ImageUploadedByTapatalk1433450932.031049.jpg\" \/><\/a>\n\n<br><br>\nI'll be posting pics of them from the actual wedding soon! Just waiting to get the pictures back haha; our photographer had over 1400 photos of just the wedding day to go through so may be a little bit coming in lol!!<br><br><br>\nSent from my iPhone using Tapatalk<br \/>If you're looking for linen it would be Le chateau you need to go to. That's where my husband bought his linen suit as well as my uncle who walked me down the aisle! <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"izabella.david@gmail.com","IpAddress":"99.237.26.51","GroupId":40,"GroupName":"Jr. Member","JoinDate":1426462378,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282430.jpg?_r=1434377756","PhotoWidth":200,"PhotoHeight":287,"PhotoType":"custom"},"FormattedName":"IzzyDeee","Id":282430,"Name":"IzzyDeee","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.250.6.92","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79243,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"11ca7822cd594634b0ba7a0e7ee9e18c","RawContent":"&lt;p&gt;We found some Tommy Bahama linen pants at The Bay. &amp;nbsp;I&#039;ve seen linen pants &amp;nbsp;at Old Navy and Macy&#039;s online as well. &amp;nbsp;Good Luck!&lt;\/p&gt;","Attachments":[],"Id":1897935,"PostDate":1433454317,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>We found some Tommy Bahama linen pants at The Bay. \u00a0I've seen linen pants \u00a0at Old Navy and Macy's online as well. \u00a0Good Luck!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"hayjules2003@yahoo.ca","IpAddress":"99.249.17.65","GroupId":39,"GroupName":"Newbie","JoinDate":1428102341,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282622.jpg?_r=1428106440","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"hayjules","Id":282622,"Name":"hayjules","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.15.187","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79243,"EditedBy":"","EditDate":1433650760,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ac237c389f1e217eb131de5104f71c44","RawContent":"&lt;p&gt;If you&#039;re able to get sizing, Tommy Bahama ships to Canada for a flat rate if you can&#039;t find them at the Bay across canada. Generally though, if you gt them at one Bay store, they can arrange for other stores to get the same thing.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;My husband got his shirt at a Tommy Bahama outlet in Niagara Falls NY and his pants at Kohls. For our renewal he&#039;s doing the DW suit from Tuxedo Royale. They have a good rate to keep the rental for a week.&lt;\/p&gt;","Attachments":[],"Id":1897949,"PostDate":1433479864,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>If you're able to get sizing, Tommy Bahama ships to Canada for a flat rate if you can't find them at the Bay across canada. Generally though, if you gt them at one Bay store, they can arrange for other stores to get the same thing.<\/p>\n<p>\u00a0<\/p>\n<p>My husband got his shirt at a Tommy Bahama outlet in Niagara Falls NY and his pants at Kohls. For our renewal he's doing the DW suit from Tuxedo Royale. They have a good rate to keep the rental for a week.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283458999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.228.78.191","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79243,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"63fb262be613c0beacaa923b1f12764b","RawContent":"We got ours at Le Chateau!","Attachments":[],"Id":1898016,"PostDate":1433605728,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We got ours at Le Chateau! \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"andreacorsi2012@gmail.com","IpAddress":"174.0.176.157","GroupId":39,"GroupName":"Newbie","JoinDate":1409190369,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"custom"},"FormattedName":"Andrea2015","Id":279604,"Name":"Andrea2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"64.141.11.150","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79243,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"dd13307b1ae78363626d3462bd11045d","RawContent":"&lt;p&gt;It looks like Le Chateau is the place to go! They had three different options for khaki coloured linen.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;If anyone is planning to wait to get the groomsmen outfits, the sales person said they usually only carry them in store until August when the fall stuff arrives, so if you want to try them on, now is the time!&lt;\/p&gt;","Attachments":[],"Id":1898113,"PostDate":1433802726,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>It looks like Le Chateau is the place to go! They had three different options for khaki coloured linen.<\/p>\n<p>\u00a0<\/p>\n<p>If anyone is planning to wait to get the groomsmen outfits, the sales person said they usually only carry them in store until August when the fall stuff arrives, so if you want to try them on, now is the time!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"magscharron@gmail.com","IpAddress":"64.141.11.150","GroupId":40,"GroupName":"Jr. Member","JoinDate":1393267130,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Maggietron","Id":276860,"Name":"Maggietron","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.183.193.17","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79243,"EditedBy":"<strong>Edited by breezie, 09 June 2015 - 10:17 AM.<\/strong>","EditDate":1433873844,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3558a5a31bf13131c216c78e2c7e0f1b","RawContent":"&lt;p&gt;We got ours at Le Chateau as well :)&lt;\/p&gt;\n&lt;p&gt;Tried posting a pic, but there is no attachment option :(&lt;\/p&gt;","Attachments":[],"Id":1898236,"PostDate":1433873338,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>We got ours at Le Chateau as well <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>Tried posting a pic, but there is no attachment option <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/sad.png' class='bbc_emoticon' alt=':(' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"briannehillier@gmail.com","IpAddress":"173.183.193.17","GroupId":39,"GroupName":"Newbie","JoinDate":1422375722,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281895.jpg?_r=1432318131","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"breezie","Id":281895,"Name":"breezie","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"199.85.228.129","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79243,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"4456c414b5596d952c100d3c0bd1a6bc","RawContent":"&lt;p&gt;I got a great suggestion to order from islandimporter.com.&amp;nbsp; Great options for linen, cotton and silk.&amp;nbsp; Ordered the guys outfits from here yesterday, will post pics of how they look when they arrive!&lt;\/p&gt;","Attachments":[],"Id":1898626,"PostDate":1434405802,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I got a great suggestion to order from islandimporter.com.\u00a0 Great options for linen, cotton and silk.\u00a0 Ordered the guys outfits from here yesterday, will post pics of how they look when they arrive!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"katie_mcbride48@yahoo.ca","IpAddress":"199.85.228.129","GroupId":39,"GroupName":"Newbie","JoinDate":1424114250,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282132.jpg?_r=1435126196","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"facebook"},"FormattedName":"KatieMcBride","Id":282132,"Name":"KatieMcBride","IsOnline":false}}],"Id":"79243","Title":"Canadian Brides! Where Did You Get Groomsmen Attire?","LastPostDate":1435082576},"Pages":{"TotalItems":24,"TotalPages":3,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":20},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
