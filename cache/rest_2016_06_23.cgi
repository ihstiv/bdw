{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":21,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":2346,"MovedTo":null,"MovedOn":0,"FirstPostId":270765,"Rating":0,"RatingHits":0,"Starter":{"Id":208514,"Name":"Myda77","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208514.gif?_r=0","PhotoWidth":80,"PhotoHeight":100,"PhotoType":"custom"},"IsOnline":false},"StartDate":1208417343,"LastPoster":{"Id":285438,"Name":"jonesharry","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-285438.png?_r=1456302282","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":34,"Preview":{"Id":270765,"PostDate":1208417343,"PostContent":"I am sure some of you ladies may have encountered this problem, and I could use some advice. I wi...","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Maida & Tomas<\/span><br><span>Circa 2004 - Our first picture together!<\/span><\/div><\/div>","Email":"msharpe77@yahoo.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1202556325,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208514.gif?_r=0","PhotoWidth":80,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Myda77","Id":208514,"Name":"Myda77","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":14821,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b60356d5198dc5cb2149e28a7eb61235","RawContent":"I am sure some of you ladies may have encountered this problem, and I could use some advice. I will be sending out my STD&#039;s soon, and I wanted to use chocolate envelopes, but what should I do about getting the guest addresses on the front? I was thinking of making a label, but I would have to make one for each guest and that is so time consuming. I could also right the names in cursive with a gel pen in silver or gold. I have no clue what to do! I could switch to an aqua color envelope, but I love the way the chocolate looks. A sample of my wedding colors are below - chocolate brown, spring green and an aqua blue. Any suggestions?\n \n \n &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/feedback.gif\" border=\"0\" alt=\"\" title=\"Feedback\" class=\"inlineimg\" \/&gt;\n \n &lt;img src=\"http:\/\/i261.photobucket.com\/albums\/ii65\/Myda77\/weddingcolors.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;","Attachments":[],"Id":270765,"PostDate":1208417343,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I am sure some of you ladies may have encountered this problem, and I could use some advice. I will be sending out my STD's soon, and I wanted to use chocolate envelopes, but what should I do about getting the guest addresses on the front? I was thinking of making a label, but I would have to make one for each guest and that is so time consuming. I could also right the names in cursive with a gel pen in silver or gold. I have no clue what to do! I could switch to an aqua color envelope, but I love the way the chocolate looks. A sample of my wedding colors are below - chocolate brown, spring green and an aqua blue. Any suggestions?<br \/> <br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/feedback.gif\" border=\"0\" alt=\"\" title=\"Feedback\" class=\"inlineimg\" \/><\/span><br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i261.photobucket.com\/albums\/ii65\/Myda77\/weddingcolors.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Maida & Tomas<\/span><br><span>Circa 2004 - Our first picture together!<\/span><\/div><\/div>","Email":"msharpe77@yahoo.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1202556325,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208514.gif?_r=0","PhotoWidth":80,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Myda77","Id":208514,"Name":"Myda77","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":14821,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3d51fca64a4d3d8346af48e1bf5e41e2","RawContent":"what about using a clear label with white text? you can just print them at home.","Attachments":[],"Id":270766,"PostDate":1208417415,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                what about using a clear label with white text? you can just print them at home.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mwall.hernandez@gmail.com","IpAddress":"208.179.124.226","GroupId":46,"GroupName":"VIP Member","JoinDate":1192214100,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207843.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Maura","Id":207843,"Name":"Maura","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":14821,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"adf73e52779ca549c2da3025d3df809f","RawContent":"I like the idea of the silver gel pen- I think it would show up really well. Have you tested it out on the paper color?","Attachments":[],"Id":270789,"PostDate":1208418255,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I like the idea of the silver gel pen- I think it would show up really well. Have you tested it out on the paper color?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"petinadixon@hotmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1205373761,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208796.gif?_r=0","PhotoWidth":75,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"~*petals*~","Id":208796,"Name":"~*petals*~","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":14821,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ebf97c46bd6049e14066e8f1a7e7f5b4","RawContent":"I had not thought of that. I was thinking of white text but didn&#039;t know how to get it on the envelope. Great suggestion!","Attachments":[],"Id":270790,"PostDate":1208418264,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I had not thought of that. I was thinking of white text but didn't know how to get it on the envelope. Great suggestion!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Maida & Tomas<\/span><br><span>Circa 2004 - Our first picture together!<\/span><\/div><\/div>","Email":"msharpe77@yahoo.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1202556325,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208514.gif?_r=0","PhotoWidth":80,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Myda77","Id":208514,"Name":"Myda77","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":14821,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d40cd17fecd48a39613c41d4f0a56307","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;~*petals*~&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;I like the idea of the silver gel pen- I think it would show up really well. Have you tested it out on the paper color?&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;I have not tried it yet, but I had a friend who did it on her envelopes which were black and it didn&#039;t look horrible. If worse comes to worse I can go with the gel pen.","Attachments":[],"Id":270791,"PostDate":1208418420,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>~*petals*~<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">I like the idea of the silver gel pen- I think it would show up really well. Have you tested it out on the paper color?<\/div> <\/td> <\/tr> <\/table> <\/div>I have not tried it yet, but I had a friend who did it on her envelopes which were black and it didn't look horrible. If worse comes to worse I can go with the gel pen.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Maida & Tomas<\/span><br><span>Circa 2004 - Our first picture together!<\/span><\/div><\/div>","Email":"msharpe77@yahoo.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1202556325,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208514.gif?_r=0","PhotoWidth":80,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Myda77","Id":208514,"Name":"Myda77","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":14821,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"92c5b55494abf1f54b7527f627e280ac","RawContent":"I think gold writing (or silver) on those chocolate metallic envelopes looks lovely...\n \n I&#039;m not sure if you can actually print something in white- I always thought (at least for at-home printing) that white isn&#039;t actually something you print... it&#039;s the absence of color.","Attachments":[],"Id":270813,"PostDate":1208420185,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I think gold writing (or silver) on those chocolate metallic envelopes looks lovely...<br \/> <br \/> I'm not sure if you can actually print something in white- I always thought (at least for at-home printing) that white isn't actually something you print... it's the absence of color.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"aqharider@hotmail.com","IpAddress":"76.20.179.61","GroupId":46,"GroupName":"VIP Member","JoinDate":1154388180,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/9\/9f\/9fd8e240_user-274-avatar?_r=0","PhotoWidth":180,"PhotoHeight":120,"PhotoType":"custom"},"FormattedName":"Sarah","Id":206770,"Name":"Sarah","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":14821,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9e3da2055efd98e3f7e1b462a790fb46","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;Sarah&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;I think gold writing (or silver) on those chocolate metallic envelopes looks lovely...\n \n I&#039;m not sure if you can actually print something in white- I always thought (at least for at-home printing) that white isn&#039;t actually something you print... it&#039;s the absence of color.&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;i did it on my laser printer at work today for something that was going on a dark color, which is what made me think of suggesting it &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile78.gif\" border=\"0\" alt=\"\" title=\"Smile78\" class=\"inlineimg\" \/&gt;","Attachments":[],"Id":270815,"PostDate":1208420281,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>Sarah<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">I think gold writing (or silver) on those chocolate metallic envelopes looks lovely...<br \/> <br \/> I'm not sure if you can actually print something in white- I always thought (at least for at-home printing) that white isn't actually something you print... it's the absence of color.<\/div> <\/td> <\/tr> <\/table> <\/div>i did it on my laser printer at work today for something that was going on a dark color, which is what made me think of suggesting it <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile78.gif\" border=\"0\" alt=\"\" title=\"Smile78\" class=\"inlineimg\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mwall.hernandez@gmail.com","IpAddress":"208.179.124.226","GroupId":46,"GroupName":"VIP Member","JoinDate":1192214100,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207843.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Maura","Id":207843,"Name":"Maura","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":14821,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8fde36e0caf0c9d91a79b6aeb1ec0071","RawContent":"Very cool! I know you can&#039;t do it on all printers though. What kind of laser printer do you have?","Attachments":[],"Id":270820,"PostDate":1208420432,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Very cool! I know you can't do it on all printers though. What kind of laser printer do you have?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"aqharider@hotmail.com","IpAddress":"76.20.179.61","GroupId":46,"GroupName":"VIP Member","JoinDate":1154388180,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/9\/9f\/9fd8e240_user-274-avatar?_r=0","PhotoWidth":180,"PhotoHeight":120,"PhotoType":"custom"},"FormattedName":"Sarah","Id":206770,"Name":"Sarah","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":14821,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"383c1319a971674646acded25ab0fe9f","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;Sarah&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Very cool! I know you can&#039;t do it on all printers though. What kind of laser printer do you have?&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;xerox phaser ....i forget the model number... 7700 maybe? i will have to look when i get to the office in the morning and get back to you. i was using avery clear address labels, which sometimes jam the printer because the paper\/stickys are slick, but i found if i feed them from the side tray, it jams less often. my department of 4 people is the only dept on our floor that has our own color laser printer because we ship pages directly from our chicago office instead of going through NY and then to the printer, so i often use it for my own personal projects haha.","Attachments":[],"Id":270829,"PostDate":1208420672,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>Sarah<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Very cool! I know you can't do it on all printers though. What kind of laser printer do you have?<\/div> <\/td> <\/tr> <\/table> <\/div>xerox phaser ....i forget the model number... 7700 maybe? i will have to look when i get to the office in the morning and get back to you. i was using avery clear address labels, which sometimes jam the printer because the paper\/stickys are slick, but i found if i feed them from the side tray, it jams less often. my department of 4 people is the only dept on our floor that has our own color laser printer because we ship pages directly from our chicago office instead of going through NY and then to the printer, so i often use it for my own personal projects haha.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mwall.hernandez@gmail.com","IpAddress":"208.179.124.226","GroupId":46,"GroupName":"VIP Member","JoinDate":1192214100,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207843.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Maura","Id":207843,"Name":"Maura","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":14821,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bc0bb18bed11d5b6dc3f4132524b239c","RawContent":"Good to know... I need and am in the market for a new laser printer. \n Lucky girl!","Attachments":[],"Id":270830,"PostDate":1208420736,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Good to know... I need and am in the market for a new laser printer. <br \/> Lucky girl!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"aqharider@hotmail.com","IpAddress":"76.20.179.61","GroupId":46,"GroupName":"VIP Member","JoinDate":1154388180,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/9\/9f\/9fd8e240_user-274-avatar?_r=0","PhotoWidth":180,"PhotoHeight":120,"PhotoType":"custom"},"FormattedName":"Sarah","Id":206770,"Name":"Sarah","IsOnline":false}}],"Id":"14821","Title":"Address on Dark envelopes","LastPostDate":1454042888},"Pages":{"TotalItems":21,"TotalPages":3,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":20},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
