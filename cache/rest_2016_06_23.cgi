{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":4,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":268,"MovedTo":null,"MovedOn":0,"FirstPostId":1913969,"Rating":0,"RatingHits":0,"Starter":{"Id":286706,"Name":"Kcusack89","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286706.jpg?_r=1463087234","PhotoWidth":200,"PhotoHeight":198,"PhotoType":"facebook"},"IsOnline":false},"StartDate":1464029890,"LastPoster":{"Id":206696,"Name":"TammyWright","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":34,"Preview":{"Id":1913969,"PostDate":1464029890,"PostContent":"Hi ladies! My wedding is May 13 2017. I was planning on sending my save the dates out soon (atlea...","Author":{"Signature":"","Email":"kcusack89@gmail.com","IpAddress":"96.245.61.215","GroupId":39,"GroupName":"Newbie","JoinDate":1460408913,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286706.jpg?_r=1463087234","PhotoWidth":200,"PhotoHeight":198,"PhotoType":"facebook"},"FormattedName":"Kcusack89","Id":286706,"Name":"Kcusack89","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"96.245.61.215","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80104,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"80925cd1c8028f541593d531f59863b3","RawContent":"Hi ladies! My wedding is May 13 2017. I was planning on sending my save the dates out soon (atleast by June) but having alot of mixed reactions from friends and family saying it&#039;s too early. Literally everything I read on line says the earliest the better.\n\nThe wedding will be in Jamaica and I have a wedding website that will be on the save the date. The only thing keeping me from sending them yet is my guest can&#039;t book their flights until July for next may.\n\n\nAny thoughts ladies?","Attachments":[],"Id":1913969,"PostDate":1464029890,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi ladies! My wedding is May 13 2017. I was planning on sending my save the dates out soon (atleast by June) but having alot of mixed reactions from friends and family saying it's too early. Literally everything I read on line says the earliest the better.<br>\nThe wedding will be in Jamaica and I have a wedding website that will be on the save the date. The only thing keeping me from sending them yet is my guest can't book their flights until July for next may.<br><br>\nAny thoughts ladies?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kcusack89@gmail.com","IpAddress":"96.245.61.215","GroupId":39,"GroupName":"Newbie","JoinDate":1460408913,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286706.jpg?_r=1463087234","PhotoWidth":200,"PhotoHeight":198,"PhotoType":"facebook"},"FormattedName":"Kcusack89","Id":286706,"Name":"Kcusack89","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"96.231.40.58","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80104,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"60a766eb0b2520944a42d020dd978c29","RawContent":"I think the sooner you send them out the better. Are you working with a travel agent? If so then I feel like sending them out earlier can give your guests time to plan and save for the trip and can work out payment arrangements if necessary.","Attachments":[],"Id":1913976,"PostDate":1464039377,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I think the sooner you send them out the better. Are you working with a travel agent? If so then I feel like sending them out earlier can give your guests time to plan and save for the trip and can work out payment arrangements if necessary.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"townsendsmithwed@gmail.com","IpAddress":"173.66.3.166","GroupId":39,"GroupName":"Newbie","JoinDate":1427042404,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282503.jpeg?_r=1462490971","PhotoWidth":200,"PhotoHeight":199,"PhotoType":"custom"},"FormattedName":"tiffanyt","Id":282503,"Name":"tiffanyt","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.127.211.91","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80104,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"922fa8bdb91dbe2c14a98098ac4af151","RawContent":"&lt;p&gt;@[member=\"Kcusack89\"] I agree with&amp;nbsp;@[member=\"tiffanyt\"], the sooner the better. The further out people know it&#039;s a destination wedding, the more time they have to prepare. While we sent ours out about 11 months out (and I wish we could have sent them sooner), FI had told a lot of our friends and family that we were planning on a DW, so they were prepared.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1913980,"PostDate":1464050172,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"286706\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/286706-kcusack89\/' title='Member profile'><span itemprop=\"name\">Kcusack89<\/span><\/a> I agree with\u00a0@<a hovercard-ref=\"member\" hovercard-id=\"282503\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282503-tiffanyt\/' title='Member profile'><span itemprop=\"name\">tiffanyt<\/span><\/a>, the sooner the better. The further out people know it's a destination wedding, the more time they have to prepare. While we sent ours out about 11 months out (and I wish we could have sent them sooner), FI had told a lot of our friends and family that we were planning on a DW, so they were prepared.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"wonderlandgrl3@yahoo.com","IpAddress":"75.99.50.82","GroupId":40,"GroupName":"Jr. Member","JoinDate":1407874186,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279411.jpg?_r=1408152053","PhotoWidth":200,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Mangosong","Id":279411,"Name":"Mangosong","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.202.225.11","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80104,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e425623ed483f7885a178baa4cde7777","RawContent":"&lt;p&gt;I say, send it out as soon as you have most of the information in place...ie location, date, even travel agent to contact...&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;the sooner the better for a dw.&lt;\/p&gt;","Attachments":[],"Id":1914028,"PostDate":1464278070,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I say, send it out as soon as you have most of the information in place...ie location, date, even travel agent to contact...<\/p>\n<p>\u00a0<\/p>\n<p>the sooner the better for a dw.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-family:arial, helvetica, sans-serif;\">Founder and Owner of BestDestinationWedding.com \u00a0\/ \u00a0<\/span><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/'><strong><span style=\"font-family:arial, helvetica, sans-serif;\">Bride & Groom Fly FREE Promotion<\/span><\/strong><\/a><\/p>\n<p>\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><a data-ipb='nomediaparse' href='https:\/\/www.wrighttravelagency.com\/go\/destination-wedding\/?source=EMLSIG'><strong><span style=\"color:#008080;\">Looking for a travel agency that specializes in Destination Weddings-CLICK HERE<\/span><\/strong><\/a><span style=\"color:#008080;\"><strong>?<\/strong> \u00a0We are an award winning travel agency and you can <\/span><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style=\"color:#008080;\">read our reviews\u00a0here.<\/span><\/a><\/strong><\/span><br>\n\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"color:#008080;\"><strong>Awards and recognition:\u00a0<\/strong><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Palace Resorts Winner \"Top Travel Agent\", \"Top Homebased Travel Agency\" PRO Platinum Agency (Top Award) \u00a0 \u00a0 | \u00a0 \u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">AMResorts Master Agent & Top Agency \u00a0<\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/68050-karisma-hotels-givc-and-gi-wedding-consultants-wright-travel-agency\/'><strong>Wright Travel & Karisma GIVC Benefits<\/strong><\/a><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Travel Impressions Best of the Best Globe Winner \u00a0 \u00a0| \u00a0 \u00a0\u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Apple Vacations Golden Apple Winner \u00a0<\/span><\/span><br><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17612\/sml_gallery_206696_17612_13451.png\" alt=\"sml_gallery_206696_17612_13451.png\"><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"> \u00a0 \u00a0<img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"font-size:14px;\"><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010'>Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><\/span><\/span><strong><span style=\"color:#b22222;\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a data-ipb='nomediaparse' href='mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com'>ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"admin@bestdestinationwedding.com","IpAddress":"71.202.225.11","GroupId":4,"GroupName":"Administrators","JoinDate":1137224220,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"FormattedName":"TammyWright","Id":206696,"Name":"TammyWright","IsOnline":false}}],"Id":"80104","Title":"When To Send Out My Save The Sates","LastPostDate":1464278070},"Pages":{"TotalItems":4,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
