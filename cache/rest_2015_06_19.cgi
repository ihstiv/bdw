Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":6,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":443,"MovedTo":null,"MovedOn":0,"FirstPostId":1896336,"Rating":0,"RatingHits":0,"Starter":{"Id":282732,"Name":"Lau11888","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1431643447,"LastPoster":{"Id":282732,"Name":"Lau11888","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":23,"Preview":{"Id":1896336,"PostDate":1431643447,"PostContent":"Hello everyone! I'm planning September 2016 wedding and have narrowed it down to these two resort...","Author":{"Signature":"","Email":"lau11888@hotmail.com","IpAddress":"71.167.187.147","GroupId":39,"GroupName":"Newbie","JoinDate":1428981301,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Lau11888","Id":282732,"Name":"Lau11888","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"166.137.252.51","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79187,"EditedBy":"<strong>Edited by Lau11888, 14 May 2015 - 02:54 PM.<\/strong>","EditDate":1431644048,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4aa726545dde0fbabd9bc8058d34faba","RawContent":"Hello everyone! I&#039;m planning September 2016 wedding and have narrowed it down to these two resorts. I&#039;ve been talking with the wedding coordinators from both places and I looks like at either place I&#039;m going to do the semi private dinner then the bonfire after.\n\n\nHas anyone explored these options? Any opinions on it? Also the house photographers from both places... Anyone have prices for them?\n\n\nSome of the packages have things in them I&#039;m\n\nNot interested in. For example I think I&#039;m going to bring a bouquet. Anyone have an answer to the resorts flexibility on that? Will they give you a credit or something?","Attachments":[],"Id":1896336,"PostDate":1431643447,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hello everyone! I'm planning September 2016 wedding and have narrowed it down to these two resorts. I've been talking with the wedding coordinators from both places and I looks like at either place I'm going to do the semi private dinner then the bonfire after.<br><br>\nHas anyone explored these options? Any opinions on it? Also the house photographers from both places... Anyone have prices for them?<br><br>\nSome of the packages have things in them I'm<br>\nNot interested in. For example I think I'm going to bring a bouquet. Anyone have an answer to the resorts flexibility on that? Will they give you a credit or something?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lau11888@hotmail.com","IpAddress":"71.167.187.147","GroupId":39,"GroupName":"Newbie","JoinDate":1428981301,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Lau11888","Id":282732,"Name":"Lau11888","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.138.34.236","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79187,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"602f80b367a5983b6c9f0134381a5167","RawContent":"I got married at the Riu Montego Bay Jamaica last week Wednesday and it was fabulous! Once I get home I will be posting a review on my wedding thread [emoji4] I&#039;m at the Iberostar grand rose hall (not the beach)atm for our honeymoon and I&#039;d say the Rose hall beach isn&#039;t as nice. Now the grand is fantastic lol but pricey! I&#039;ve seen the beach version though and I&#039;m happy I chose the Riu myself!! \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1896340,"PostDate":1431647208,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I got married at the Riu Montego Bay Jamaica last week Wednesday and it was fabulous! Once I get home I will be posting a review on my wedding thread [emoji4] I'm at the Iberostar grand rose hall (not the beach)atm for our honeymoon and I'd say the Rose hall beach isn't as nice. Now the grand is fantastic lol but pricey! I've seen the beach version though and I'm happy I chose the Riu myself!! <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"izabella.david@gmail.com","IpAddress":"99.237.26.51","GroupId":40,"GroupName":"Jr. Member","JoinDate":1426465978,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282430.jpg?_r=1434377756","PhotoWidth":200,"PhotoHeight":287,"PhotoType":"custom"},"FormattedName":"IzzyDeee","Id":282430,"Name":"IzzyDeee","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.161.72.56","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79187,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e72269f962639580d482f7524591d826","RawContent":"Welcome to the site! I think you&#039;re looking at two very popular Jamaican resorts! I was married in Jamaica almost 4 years ago but at a different resort. We loved Jamaica and fell in love with this island.\n\n\nHave you looked up the resorts at all here for the reviews? It will give you an idea of what past brides have done and what they have to say about their experience. Do you have a travel agent yet? If not I would highly recommend getting one. They will become your newe best friend as you go through your planning journey and will help field guest questions as well as provide you with I formation to give you the best experience possible.\n\n\nGood luck and happy planning!","Attachments":[],"Id":1896490,"PostDate":1431886689,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Welcome to the site! I think you're looking at two very popular Jamaican resorts! I was married in Jamaica almost 4 years ago but at a different resort. We loved Jamaica and fell in love with this island.<br><br>\nHave you looked up the resorts at all here for the reviews? It will give you an idea of what past brides have done and what they have to say about their experience. Do you have a travel agent yet? If not I would highly recommend getting one. They will become your newe best friend as you go through your planning journey and will help field guest questions as well as provide you with I formation to give you the best experience possible.<br><br>\nGood luck and happy planning!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283462599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.165.141.121","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79187,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"871b4e45bd949f560f7a799e64274d91","RawContent":"&lt;p&gt;We did not consider RIU Montego Bay, though I honestly cannot remember why?! We&#039;re getting married in 3 short weeks at Iberostar Rose Hall Suites. I&#039;ve seen a ton of brides who had a fabulous time at Iberostar Rose Hall Beach and have seen zero complaints about the wedding coordinators and the wedding itself. We chose the adjacent \"Suites\" over the \"Beach\" resort because it was generally just nicer. Looked like the rooms at Iberostar Rose Hall Beach are a little older and there aren&#039;t quite as many amenities there like fewer restaurants. For us, it was worth the incremental increase in cost to go with Suites, which also gives your guests full access to the Beach resort.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;The Iberostars only do 1 wedding per day, which is a little bit of a plus. Not that I need to be the only bride - it is just that I got stressed out thinking about competing with other weddings for ceremony times, reception venues and spa appointments. I&#039;m sure it&#039;s generally fine, but that would have been really bad for my anxiety. I know myself :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;If you have any questions on Iberostar Rose Hall Suites, let me know!&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1896507,"PostDate":1431906921,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>We did not consider RIU Montego Bay, though I honestly cannot remember why?! We're getting married in 3 short weeks at Iberostar Rose Hall Suites. I've seen a ton of brides who had a fabulous time at Iberostar Rose Hall Beach and have seen zero complaints about the wedding coordinators and the wedding itself. We chose the adjacent \"Suites\" over the \"Beach\" resort because it was generally just nicer. Looked like the rooms at Iberostar Rose Hall Beach are a little older and there aren't quite as many amenities there like fewer restaurants. For us, it was worth the incremental increase in cost to go with Suites, which also gives your guests full access to the Beach resort.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>The Iberostars only do 1 wedding per day, which is a little bit of a plus. Not that I need to be the only bride - it is just that I got stressed out thinking about competing with other weddings for ceremony times, reception venues and spa appointments. I'm sure it's generally fine, but that would have been really bad for my anxiety. I know myself <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>If you have any questions on Iberostar Rose Hall Suites, let me know!\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rebecca.shaffer@gmail.com","IpAddress":"159.53.174.144","GroupId":40,"GroupName":"Jr. Member","JoinDate":1403119687,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"beckys98","Id":278581,"Name":"beckys98","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.82.4.242","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79187,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"694d3ae97047f2107414b4460e5b3569","RawContent":"Just got back from our Riu Mo Bay wedding\/honeymoon Sandals Mo Bay and it was perfect. I&#039;ll be posting a review soon. No info on the photographer. We hired an outside one. But he said he doesn&#039;t do a lot of business at the Riu Mo Bay because the photographer is better than most resort ones.","Attachments":[],"Id":1896531,"PostDate":1431971267,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Just got back from our Riu Mo Bay wedding\/honeymoon Sandals Mo Bay and it was perfect. I'll be posting a review soon. No info on the photographer. We hired an outside one. But he said he doesn't do a lot of business at the Riu Mo Bay because the photographer is better than most resort ones. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Meggan.Kole@gmail.com","IpAddress":"68.82.4.242","GroupId":39,"GroupName":"Newbie","JoinDate":1385156577,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275259.jpg?_r=1421618186","PhotoWidth":200,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"Megg","Id":275259,"Name":"Megg","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"166.137.252.108","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79187,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cd919b4181cbe928111d33dfa4cd985f","RawContent":"Thanks in the input! They sent me the info for the house photographers. They seems pretty reasonable.","Attachments":[],"Id":1896555,"PostDate":1431993311,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks in the input! They sent me the info for the house photographers. They seems pretty reasonable.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lau11888@hotmail.com","IpAddress":"71.167.187.147","GroupId":39,"GroupName":"Newbie","JoinDate":1428981301,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Lau11888","Id":282732,"Name":"Lau11888","IsOnline":false}}],"Id":"79187","Title":"Riu Montego Bay & Iberostar  Rose Hall Beach","LastPostDate":1431993311},"Pages":{"TotalItems":6,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
