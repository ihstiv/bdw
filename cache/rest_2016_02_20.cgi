{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73934,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a3d7b47513f9f719e3f0095f5b7dcb22","RawContent":"Hello! We are interested in a catholic destination wedding. After reading some of these posts, it seems like it pretty difficult in Mexico to have a legal and symbolic wedding. Has anyone done this and can you shed any light on how difficult it is? Also, maybe Mexico isn&#039;t the place for us. Any thoughts on other places? We want it to be as simple as possible. Thank you for the help!!!","Attachments":[],"Id":1757666,"PostDate":1368559031,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hello! We are interested in a catholic destination wedding. After reading some of these posts, it seems like it pretty difficult in Mexico to have a legal and symbolic wedding. Has anyone done this and can you shed any light on how difficult it is? Also, maybe Mexico isn't the place for us. Any thoughts on other places? We want it to be as simple as possible. Thank you for the help!!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mcl.wiegand@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1368458956,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-269536.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"clw108","Id":269536,"Name":"clw108","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.51.108.71","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":73934,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6b13929acd298853dbb28c9325d5b1c6","RawContent":"I&#039;m looking to do a catholic wedding too!  Actually a catholic renewal of vows since my husband and I have been civilly married. \n\n\nI&#039;ve looked into The Royalton in Montego Bay! They help you with everything! Even finding the church and transportation. Let me know how it goes!","Attachments":[],"Id":1905287,"PostDate":1443041821,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm looking to do a catholic wedding too!  Actually a catholic renewal of vows since my husband and I have been civilly married. <br><br>\nI've looked into The Royalton in Montego Bay! They help you with everything! Even finding the church and transportation. Let me know how it goes! \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lesliediane.ortizluis@gmail.com","IpAddress":"24.114.57.90","GroupId":39,"GroupName":"Newbie","JoinDate":1429831891,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"leslieortizluis","Id":282841,"Name":"leslieortizluis","IsOnline":false}}],"Pages":{"TotalItems":2,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
