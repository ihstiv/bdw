ht":125,"PhotoType":""},"FormattedName":"Jamaica2016","Id":281097,"Name":"Jamaica2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"161.185.161.117","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78276,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"6030aabcde4f1cef651f4d06cc7d3de5","RawContent":"&lt;p&gt;10\/14\/16 Very excited to see other 2016 brides. Happy Planning Ladies:)&lt;\/p&gt;","Attachments":[],"Id":1879122,"PostDate":1416926786,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>10\/14\/16 Very excited to see other 2016 brides. Happy Planning Ladies:)<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p style=\"text-align:center;\">\u00a0 \u00a0 \u00a0 \u00a0 \u00a0 Future Mrs. Bonitto 12\/14\/16<\/p>\n<div><br><div style=\"text-align:center;\"><br><div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.weddingcountdown.com\/\"><img src=\"http:\/\/img.weddingcountdown.com\/ticker\/30ag12yqu333h.png\" alt=\"30ag12yqu333h.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<\/div>\n<\/div>\n<p>\u00a0","Email":"shamicaglover@yahoo.com","IpAddress":"161.185.157.23","GroupId":40,"GroupName":"Jr. Member","JoinDate":1394133176,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277031.jpg?_r=1397251056","PhotoWidth":200,"PhotoHeight":203,"PhotoType":"custom"},"FormattedName":"MrandMrsBonitto2016","Id":277031,"Name":"MrandMrsBonitto2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.12.52.42","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78276,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"863ec888fe8f7716c406872f933ff71a","RawContent":"&lt;p&gt;Jan 9 2016 - Azul Fives!! :)&lt;\/p&gt;","Attachments":[],"Id":1879860,"PostDate":1417927705,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Jan 9 2016 - Azul Fives!! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>My planning thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78916-snswedding2016-planning-thread-jan-9-2016-azul-fives\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78916-snswedding2016-planning-thread-jan-9-2016-azul-fives\/<\/a><\/p>\n<p>\u00a0<\/p>\n<div><a class='bbc_url' href='http:\/\/www.TickerFactory.com\/'><\/div>\n<div><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10730;0\/st\/20160109\/e\/Our+Wedding\/k\/9fa9\/event.png\" alt=\"event.png\"><\/div>\n<div><\/a><\/div>\n","Email":"sean.n.steph2016@gmail.com","IpAddress":"74.12.52.42","GroupId":3,"GroupName":"Member","JoinDate":1415547511,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281055.jpg?_r=1455040720","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"snswedding2016","Id":281055,"Name":"snswedding2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"96.48.159.21","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78276,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"224091177aef0cfef01f494b80da4aba","RawContent":"January 23, 2016 at Moon Palace  hello to all the 2016 brides!","Attachments":[],"Id":1879862,"PostDate":1417932861,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                January 23, 2016 at Moon Palace  hello to all the 2016 brides!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"My planning thread: <a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/79425-wafflesmom-moon-palace-planning-thread-january-23-2016\/\">http:\/\/www.bestdestinationwedding.com\/topic\/79425-wafflesmom-moon-palace-planning-thread-january-23-2016\/<\/a><br><br>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;4;484\/st\/20160123\/e\/Our+Wedding\/dt\/-2\/k\/44c5\/event.png\" alt=\"event.png\"><\/a>","Email":"jerilee.valenzuela@shaw.ca","IpAddress":"24.114.26.77","GroupId":3,"GroupName":"Member","JoinDate":1410098585,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279721.jpg?_r=1454805895","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"Wafflesmom","Id":279721,"Name":"Wafflesmom","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.106.6.122","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78276,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"9e1d899c4d65126a6147bf21ff65adbc","RawContent":"June 4th, 2016, Excellence Playa Mujeres, Mexico!!! (Well I have to wait until February\/ March 2015 for the Resort to open up their 2016 calendar to confirm my date)\n[quote name=\"Jamaica2016\" post=\"1878654\" timestamp=\"1416337863\"]\nJune 14th, 2016![\/quote]Hi! @[member=\"Jamaica2016\"] , How is planning going?Looks like we are planning for about the same time. I&#039;m looking at June 4th 2016 with a back up date of June 18th 2016. I&#039;m trying to figure out how much I should have done by what point. I just finished our wedding website this week. I don&#039;t know if it&#039;s too soon so send a link out to our guest or not? Some people are already asking for pricing details and what not, but of course I don&#039;t have this information yet.\n\nIt&#039;s nice to see other 2016 brides already planning!","Attachments":[],"Id":1881217,"PostDate":1419865042,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>June 4th, 2016, Excellence Playa Mujeres, Mexico!!! (Well I have to wait until February\/ March 2015 for the Resort to open up their 2016 calendar to confirm my date)<\/p>\n<br \/><p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Jamaica2016, on 18 November 2014 - 11:11 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>June 14th, 2016!<\/p>\n<\/div>\n<\/div><\/div>\n<p>Hi! @<a hovercard-ref=\"member\" hovercard-id=\"281097\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281097-jamaica2016\/' title='Member profile'><span itemprop=\"name\">Jamaica2016<\/span><\/a> , How is planning going?Looks like we are planning for about the same time. I'm looking at June 4th 2016 with a back up date of June 18th 2016. I'm trying to figure out how much I should have done by what point. I just finished our wedding website this week. I don't know if it's too soon so send a link out to our guest or not? Some people are already asking for pricing details and what not, but of course I don't have this information yet.<\/p>\n<p>\u00a0<\/p>\n<p>It's nice to see other 2016 brides already planning!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sarajenkins@bellsouth.net","IpAddress":"174.106.6.122","GroupId":39,"GroupName":"Newbie","JoinDate":1408622600,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Surfingsara","Id":279511,"Name":"Surfingsara","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"69.42.28.220","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78276,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f8c45d1254018d174b77a79e0944df5f","RawContent":"&lt;p&gt;Our date is confirmed for June 16, 2016 at the Riu Palace, Cabo San Lucas :D&lt;\/p&gt;","Attachments":[],"Id":1881707,"PostDate":1420362741,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Our date is confirmed for June 16, 2016 at the Riu Palace, Cabo San Lucas <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/biggrin.png' class='bbc_emoticon' alt=':D' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jrcorrales@gmail.com","IpAddress":"69.42.28.220","GroupId":39,"GroupName":"Newbie","JoinDate":1413956046,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280778.jpg?_r=1421562169","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"AmorDeMiVida","Id":280778,"Name":"AmorDeMiVida","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.202.225.11","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78276,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"1e3789e7c5ede0677b58611c51a328b7","RawContent":"[quote name=\"Surfingsara\" post=\"1881217\" timestamp=\"1419865042\"]\nJune 4th, 2016, Excellence Playa Mujeres, Mexico!!! (Well I have to wait until February\/ March 2015 for the Resort to open up their 2016 calendar to confirm my date)\n\nHi! @[member=\"Jamaica2016\"] , How is planning going?Looks like we are planning for about the same time. I&#039;m looking at June 4th 2016 with a back up date of June 18th 2016. I&#039;m trying to figure out how much I should have done by what point. I just finished our wedding website this week. I don&#039;t know if it&#039;s too soon so send a link out to our guest or not? Some people are already asking for pricing details and what not, but of course I don&#039;t have this information yet.\n\nIt&#039;s nice to see other 2016 brides already planning![\/quote]Excellence is a great resort and TA Wendy has a great relationship with them.  If you contact her, she may be able to get your date confirmed earlier.","Attachments":[],"Id":1881771,"PostDate":1420414350,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Surfingsara, on 29 December 2014 - 06:57 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>June 4th, 2016, Excellence Playa Mujeres, Mexico!!! (Well I have to wait until February\/ March 2015 for the Resort to open up their 2016 calendar to confirm my date)<\/p>\n<br><p>Hi! @<a hovercard-ref=\"member\" hovercard-id=\"281097\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281097-jamaica2016\/' title='Member profile'><span itemprop=\"name\">Jamaica2016<\/span><\/a> , How is planning going?Looks like we are planning for about the same time. I'm looking at June 4th 2016 with a back up date of June 18th 2016. I'm trying to figure out how much I should have done by what point. I just finished our wedding website this week. I don't know if it's too soon so send a link out to our guest or not? Some people are already asking for pricing details and what not, but of course I don't have this information yet.<\/p>\n<p>\u00a0<\/p>\n<p>It's nice to see other 2016 brides already planning!<\/p>\n<\/div>\n<\/div><\/div>\n<p>Excellence is a great resort and TA Wendy has a great relationship with them. \u00a0If you contact her, she may be able to get your date confirmed earlier.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-family:arial, helvetica, sans-serif;\">Founder and Owner of BestDestinationWedding.com \u00a0\/ \u00a0<\/span><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/'><strong><span style=\"font-family:arial, helvetica, sans-serif;\">Bride & Groom Fly FREE Promotion<\/span><\/strong><\/a><\/p>\n<p>\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><a data-ipb='nomediaparse' href='https:\/\/www.wrighttravelagency.com\/go\/destination-wedding\/?source=EMLSIG'><strong><span style=\"color:#008080;\">Looking for a travel agency that specializes in Destination Weddings-CLICK HERE<\/span><\/strong><\/a><span style=\"color:#008080;\"><strong>?<\/strong> \u00a0We are an award winning travel agency and you can <\/span><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style=\"color:#008080;\">read our reviews\u00a0here.<\/span><\/a><\/strong><\/span><br>\n\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"color:#008080;\"><strong>Awards and recognition:\u00a0<\/strong><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Palace Resorts Winner \"Top Travel Agent\", \"Top Homebased Travel Agency\" PRO Platinum Agency (Top Award) \u00a0 \u00a0 | \u00a0 \u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">AMResorts Master Agent & Top Agency \u00a0<\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/68050-karisma-hotels-givc-and-gi-wedding-consultants-wright-travel-agency\/'><strong>Wright Travel & Karisma GIVC Benefits<\/strong><\/a><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Travel Impressions Best of the Best Globe Winner \u00a0 \u00a0| \u00a0 \u00a0\u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Apple Vacations Golden Apple Winner \u00a0<\/span><\/span><br><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17612\/sml_gallery_206696_17612_13451.png\" alt=\"sml_gallery_206696_17612_13451.png\"><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"> \u00a0 \u00a0<img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"font-size:14px;\"><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010'>Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><\/span><\/span><strong><span style=\"color:#b22222;\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a data-ipb='nomediaparse' href='mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com'>ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"admin@bestdestinationwedding.com","IpAddress"