renis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399428602,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.88.49.88","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79826,"EditedBy":"<strong>Edited by ashhtayy, 01 January 2016 - 06:54 PM.<\/strong>","EditDate":1451703261,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0198be9ee52141034277c0d9e2c9193a","RawContent":"&lt;p&gt;@[member=\"dandi76\"] cute! where did you get the bottles with the cork tops? will you fill them with booze once you get there? i like this idea a lot!&lt;\/p&gt;","Attachments":[],"Id":1908829,"PostDate":1451703244,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"282697\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282697-dandi76\/' title='Member profile'><span itemprop=\"name\">dandi76<\/span><\/a> cute! where did you get the bottles with the cork tops? will you fill them with booze once you get there? i like this idea a lot!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Ashley<br><br>My Planning Thread: <a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/79377-ashhtayys-planning-thread-azul-fives-june-7-2016\/\">http:\/\/www.bestdestinationwedding.com\/topic\/79377-ashhtayys-planning-thread-azul-fives-june-7-2016\/<\/a><br>\u00a0<\/p><div><a class='bbc_url' href='http:\/\/www.TickerFactory.com\/'><\/div><div><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;4;484\/st\/20160607\/e\/Our+Wedding\/k\/ecf1\/event.png\" alt=\"event.png\"><\/div><div><\/a><\/div>","Email":"ashley.taylor@live.ca","IpAddress":"184.147.135.4","GroupId":40,"GroupName":"Jr. Member","JoinDate":1423105061,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282006.jpg?_r=1451447049","PhotoWidth":200,"PhotoHeight":210,"PhotoType":"custom"},"FormattedName":"ashhtayy","Id":282006,"Name":"ashhtayy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"204.124.239.6","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79826,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"24cd265018e7f82b5a56bbab25ba68f1","RawContent":"&lt;p&gt;Thanks!! @[member=\"calgarybride2015\"] I&#039;m in love with them. Just thinking about how I want to display them at the reception.... maybe a decrative plate?&amp;nbsp; idk&lt;\/p&gt;\n\n&lt;p&gt;Hi Ashley,&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I bought them off of Walmart.com. I ordered them and had them shipped to my local store to cut down on shipping costs! The box of 18 was around $15. And i measured them...they will hold exactly 1 shot!&lt;\/p&gt;\n&lt;p&gt;Im going to buy a bottle of tequila here at home and bring it down with me in my suitcase.&lt;\/p&gt;","Attachments":[],"Id":1908830,"PostDate":1451703405,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thanks!! @<a hovercard-ref=\"member\" hovercard-id=\"277873\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277873-calgarybride2015\/' title='Member profile'><span itemprop=\"name\">calgarybride2015<\/span><\/a> I'm in love with them. Just thinking about how I want to display them at the reception.... maybe a decrative plate?\u00a0 idk<\/p>\n<br \/><p>Hi Ashley,<\/p>\n<p>\u00a0<\/p>\n<p>I bought them off of Walmart.com. I ordered them and had them shipped to my local store to cut down on shipping costs! The box of 18 was around $15. And i measured them...they will hold exactly 1 shot!<\/p>\n<p>Im going to buy a bottle of tequila here at home and bring it down with me in my suitcase.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rhomes.jones@gmail.com","IpAddress":"174.21.125.83","GroupId":39,"GroupName":"Newbie","JoinDate":1428717291,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282697.jpg?_r=1436371862","PhotoWidth":75,"PhotoHeight":75,"PhotoType":"cus