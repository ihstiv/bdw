{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":1,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":652,"MovedTo":null,"MovedOn":0,"FirstPostId":1897980,"Rating":0,"RatingHits":0,"Starter":{"Id":283397,"Name":"LauraLeigh77","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1433523451,"LastPoster":{"Id":283397,"Name":"LauraLeigh77","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":22,"Preview":{"Id":1897980,"PostDate":1433523451,"PostContent":"Hi! I am planning an April 2016 wedding at The Royalton... There's gonna be a group of 50 or more...","Author":{"Signature":"","Email":"lauraleighgillingham@yahoo.ca","IpAddress":"142.162.98.206","GroupId":39,"GroupName":"Newbie","JoinDate":1433522531,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"LauraLeigh77","Id":283397,"Name":"LauraLeigh77","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"142.162.98.206","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79249,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a5f55e0208c1e2a89e4a77d6ec58e647","RawContent":"Hi! I am planning an April 2016 wedding at The Royalton... There&#039;s gonna be a group of 50 or more people traveling with us! Just wondering if anyone has any tips or advice? I am leaning towards the garden gazebo (just for more privacy), just looking for any suggestions, tips or advice from anyone who have already gotten married or is also planning a wedding there! Also looking for ways to cut any costs (the quotes I got for decorations and bouquets were outrageous!!!) idk if there is anyone else I can rent decorations from in the DR or if it would be ok for us to bring some things from home? I am not going to bother with the private reception because we are having a reception when we return home so I don&#039;t want that extra costs, has anyone had the semi private dinner? And how did it go? Should I go with the \"free\" wedding package and just add on anything extra I want? Sorry for all the questions, looking for the most feasible way to have my dream wedding :) thanks in advance!!","Attachments":[],"Id":1897980,"PostDate":1433523451,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi! I am planning an April 2016 wedding at The Royalton... There's gonna be a group of 50 or more people traveling with us! Just wondering if anyone has any tips or advice? I am leaning towards the garden gazebo (just for more privacy), just looking for any suggestions, tips or advice from anyone who have already gotten married or is also planning a wedding there! Also looking for ways to cut any costs (the quotes I got for decorations and bouquets were outrageous!!!) idk if there is anyone else I can rent decorations from in the DR or if it would be ok for us to bring some things from home? I am not going to bother with the private reception because we are having a reception when we return home so I don't want that extra costs, has anyone had the semi private dinner? And how did it go? Should I go with the \"free\" wedding package and just add on anything extra I want? Sorry for all the questions, looking for the most feasible way to have my dream wedding <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> thanks in advance!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lauraleighgillingham@yahoo.ca","IpAddress":"142.162.98.206","GroupId":39,"GroupName":"Newbie","JoinDate":1433522531,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"LauraLeigh77","Id":283397,"Name":"LauraLeigh77","IsOnline":false}}],"Id":"79249","Title":"Any Advice About Getting Married At The Royalton Punta Cana?","LastPostDate":1433523451},"Pages":{"TotalItems":1,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
