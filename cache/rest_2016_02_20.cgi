        width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>April 9, 2016 at the Grand Sirenis Riviera Maya<\/p>\n<p>\u00a0<\/p>\n<p>Just sent out the invites so people can put down deposits and bought my wedding dress on the weekend. I feel like I did all the important stuff super early and now I have over a year of waiting - and I'm not a very patient person!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div>\u00a0<\/div>\n<div>\u00a0<\/div>\n<div><a class='bbc_url' href='http:\/\/www.TickerFactory.com\/'><\/div>\n<div><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;6\/st\/20160409\/e\/our+Wedding+Day\/k\/a16a\/event.png\" alt=\"event.png\"><\/div>\n<div><\/a><\/div>\n<div>\u00a0<\/div>\n","Email":"krystalball@gmail.com","IpAddress":"158.82.202.5","GroupId":40,"GroupName":"Jr. Member","JoinDate":1421864163,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281820.jpg?_r=1440261411","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"krystalball","Id":281820,"Name":"krystalball","IsOnline":false}}],"Pages":{"TotalItems":78,"TotalPages":8,"CurrentPage":10,"NextPage":20,"PreviousPage":0,"LastPage":70},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
