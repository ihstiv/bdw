a0<span><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><\/span><br><span style=\"color:rgb(0,128,128);\"><strong><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010\" title=\"\">Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><strong><span style=\"color:rgb(178,34,34);\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a  class=\"bbc_url\" href=\"mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com\" title=\"External link\">ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"trisha@wrighttravelagency.com","IpAddress":"12.24.226.126","GroupId":46,"GroupName":"VIP Member","JoinDate":1171995300,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-207201.jpg?_r=1452788764","PhotoWidth":200,"PhotoHeight":296,"PhotoType":"custom"},"FormattedName":"TATrisha","Id":207201,"Name":"TATrisha","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":66415,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3581572cbb38dab4a9d6f8045ca23799","RawContent":"&lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;DJ&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;The resort uses a few different DJ\u00e2\u20ac\u2122s.&amp;nbsp; AV Solutions, DJ Dorremix, and Luis De Alba&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;Alex Martinez&lt;\/span&gt; - AV Solutions&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;&lt;span style=\"color: blue\"&gt;&lt;span style=\"font-family: arial, sans-serif\"&gt;&lt;img alt=\"Mariachi Band.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762937\/width\/600\/height\/450\" \/&gt;&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1595157,"PostDate":1331759386,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <span  style=\"font-size: 12px\">DJ<\/span><\/p> <p> <span  style=\"font-size: 12px\">The resort uses a few different DJ\u00e2\u20ac\u2122s.\u00a0 AV Solutions, DJ Dorremix, and Luis De Alba<\/span><\/p> <p> <span  style=\"font-size: 12px\">\u00a0<\/span><\/p> <p> <span  style=\"font-size: 12px\"><span  style=\"font-family: arial, sans-serif\">Alex Martinez<\/span> - AV Solutions<\/span><\/p> <p> <span  style=\"font-size: 12px\"><span  style=\"color: blue\"><span  style=\"font-family: arial, sans-serif\"><span rel='lightbox'><img class='bbc_img' alt=\"Mariachi Band.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762937\/width\/600\/height\/450\" \/><\/span><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>~Trisha~<\/p>\n<p>Destination Wedding Photographer & Travel Agent<br><a  class=\"bbc_url\" href=\"http:\/\/www.faberphotography.com\">www.faberphotography.com<\/a>\u00a0-\u00a0My latest destination wedding photos can be found\u00a0<a  class=\"bbc_url\" href=\"http:\/\/faberphotography.com\/destination-wedding\/\">HERE<\/a><br><br><span style=\"font-family:arial, helvetica, sans-serif;color:rgb(0