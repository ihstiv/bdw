<span><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17612\/sml_gallery_206696_17612_13451.png\" alt=\"sml_gallery_206696_17612_13451.png\"><\/span><span><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"><\/span>\u00a0\u00a0 \u00a0<span><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><\/span><br><span style=\"color:rgb(0,128,128);\"><strong><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010\" title=\"\">Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><strong><span style=\"color:rgb(178,34,34);\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a  class=\"bbc_url\" href=\"mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com\" title=\"External link\">ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"trisha@wrighttravelagency.com","IpAddress":"12.24.226.126","GroupId":46,"GroupName":"VIP Member","JoinDate":1171995300,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-207201.jpg?_r=1452788764","PhotoWidth":200,"PhotoHeight":296,"PhotoType":"custom"},"FormattedName":"TATrisha","Id":207201,"Name":"TATrisha","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":66415,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4946a30cbeeeb387039480c6c54ac7ba","RawContent":"&lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Cake&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;&lt;strong&gt;Eternity Cakes (included in the Eternity Package)&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;ul&gt; &lt;li&gt; &lt;span style=\"font-size: 12px\"&gt;Serves up to 25 people&lt;\/span&gt;&lt;\/li&gt; &lt;li&gt; &lt;span style=\"font-size: 12px\"&gt;$7 per additional person&lt;\/span&gt;&lt;\/li&gt; &lt;\/ul&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Flavors:&lt;\/span&gt;&lt;\/p&gt; &lt;ul&gt; &lt;li&gt; &lt;span style=\"font-size: 12px\"&gt;White Cream Cake: A silky smooth cake made with rich cream for a moist, tender finish. Great with our classic butter cream or a fruit filling.&lt;\/span&gt;&lt;\/li&gt; &lt;li&gt; &lt;span style=\"font-size: 12px\"&gt;Golden Yellow Cake: Delicate, tender cake with a hint of pure vanilla. Excellent with a fruit filling or loaded with a dark fudge filling.&lt;\/span&gt;&lt;\/li&gt; &lt;li&gt; &lt;span style=\"font-size: 12px\"&gt;Chocolate Fudge Cake: Rich, deep dark chocolate cake made with pure dark chocolate. Generously covered with butter cream and filled with chocolate fudge.&lt;\/span&gt;&lt;\/li&gt; &lt;li&gt; &lt;span style=\"font-size: 12px\"&gt;Chocolate Kahlua Symphony: An unforgettable combination of rich chocolate layers and coffee liqueur. Excellent with a mocha filling.&lt;\/span&gt;&lt;\/li&gt; &lt;\/ul&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;&lt;img alt=\"Eternity Cake Options.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762922\/width\/600\/height\/508\" \/&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;&lt;strong&gt;Divine Cakes (included in the Devine Package)&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;ul&gt; &lt;li&gt; &lt;span style=\"font-size: 12px\"&gt;Serves up to 20 people&lt;\/span&gt;&lt;\/li&gt; &lt;li&gt; &lt;span style=\"font-size: 12px\"&gt;$8 per additional person&lt;\/span&gt;&lt;\/li&gt; &lt;\/ul&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Flavors:&amp;nbsp; You select the cake flavor and then select the filing to go inside it&lt;\/span&gt;&lt;\/p&gt; &lt;ul&gt; &lt;li&gt; &lt;span style=\"font-size: 12px\"&gt;Marble Fudge Cake: A moist marriage of white cake with dark chocolate to create rivers of fudge, all wrapped up in our elegant butter cream.&lt;\/span&gt;&lt;\/li&gt; &lt;li&gt; &lt;span style=\"font-size: 12px\"&gt;Almond Delight Cake: White moist layers with a delicate, fresh roasted, ground almond filling. A truly elegant cake for an elegant occasion.&lt;\/span&gt;&lt;\/li&gt; &lt;li&gt; &lt;span style=\"font-size: 12px\"&gt;Lemon Twist Mellow: A hint of lemon and a divine creamy lemon filling. Wonderful with a raspberry filling.&lt;\/span&gt;&lt;\/li&gt; &lt;li&gt; &lt;span style=\"font-size: 12px\"&gt;Bella Matrimoniale Classic: Three moist layers of white cake with two fillings, almond and raspberry. Your Guests will say \u00e2\u20ac\u0153Wow\u00e2\u20ac\u009d and ask for seconds.&lt;\/span&gt;&lt;\/li&gt; &lt;li&gt; &lt;span style=\"font-size: 12px\"&gt;Cheese Cake Showstopper: Creamy New York cheesecake baked to perfection and frosted with our special butter cream or whipped cream.&lt;\/span&gt;&lt;\/li&gt; &lt;li&gt; &lt;span style=\"font-size: 12px\"&gt;Chocolate Passion Black Tie: Cake made with the finest imported dark chocolate filled with variety of berries.&lt;\/span&gt;&lt;\/li&gt; &lt;\/ul&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Fillings: Vanilla, Chocolate, Raspberry, Strawberry, Fresh Sliced Strawberries, Peaches, Pineapples Roasted Almond&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;&lt;img alt=\"Divine Cake Options.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762924\/width\/600\/height\/514\" \/&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Here are some BDW Bride&#039;s Cake Photos:&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;&lt;img alt=\"Wedding Cake v2.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762926\/width\/600\/height\/450\" \/&gt;&lt;img alt=\"Wedding Cake v3.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762928\/width\/340\/height\/510\" \/&gt;&lt;img alt=\"Wedding Cake.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762930\/width\/600\/height\/450\" \/&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1595158,"PostDate":1331759390,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <span  style=\"font-size: 12px\">Cake<\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 12px\"><strong>Eternity Cakes (included in the Eternity Package)<\/strong><\/span><\/p> <ul> <li> <span  style=\"font-size: 12px\">Serves up to 25 people<\/span><\/li> <li> <span  style=\"font-size: 12px\">$7 per additional person<\/span><\/li> <\/ul> <p> <span  style=\"font-size: 12px\">Flavors:<\/span><\/p> <ul> <li> <span  style=\"font-size: 12px\">White Cream Cake: A silky smooth cake made with rich cream for a moist, tender finish. Great with our classic butter cream or a fruit filling.<\/span><\/li> <li> <span  style=\"font-size: 12px\">Golden Yellow Cake: Delicate, tender cake with a hint of pure vanilla. Excellent with a fruit filling or loaded with a dark fudge filling.<\/span><\/li> <li> <span  style=\"font-size: 12px\">Chocolate Fudge Cake: Rich, deep dark chocolate cake made with pure dark chocolate. Generously covered with butter cream and filled with chocolate fudge.<\/span><\/li> <li> <span  style=\"font-size: 12px\">Chocolate Kahlua Symphony: An unforgettable combination of rich chocolate layers and coffee liqueur. Excellent with a mocha filling.<\/span><\/li> <\/ul> <p> \u00a0<\/p> <p> <span  style=\"font-size: 12px\"><span rel='lightbox'><img class='bbc_img' alt=\"Eternity Cake Options.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762922\/width\/600\/height\/508\" \/><\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 12px\"><strong>Divine Cakes (included in the Devine Package)<\/strong><\/span><\/p> <ul> <li> <span  style=\"font-size: 12px\">Serves up to 20 people<\/span><\/li> <li> <span  style=\"font-size: 12px\">$8 per additional person<\/span><\/li> <\/ul> <p> \u00a0<\/p> <p> <span  style=\"font-size: 12px\">Flavors:\u00a0 You select the cake flavor and then select the filing to go inside it<\/span><\/p> <ul> <li> <span  style=\"font-size: 12px\">Marble Fudge Cake: A moist marriage of white cake with dark chocolate to create rivers of fudge, all wrapped up in our elegant butter cream.<\/span><\/li> <li> <span  style=\"font-size: 12px\">Almond Delight Cake: White moist layers with a delicate, fresh roasted, ground almond filling. A truly elegant cake for an elegant occasion.<\/span><\/li> <li> <span  style=\"font-size: 12px\">Lemon Twist Mellow: A hint of lemon and a divine creamy lemon filling. Wonderful with a raspberry filling.<\/span><\/li> <li> <span  style=\"font-size: 12px\">Bella Matrimoniale Classic: Three moist layers of white cake with two fillings, almond and raspberry. Your Guests will say \u00e2\u20ac\u0153Wow\u00e2\u20ac\u009d and ask for seconds.<\/span><\/li> <li> <span  style=\"font-size: 12px\">Cheese Cake Showstopper: Creamy New York cheesecake baked to perfection and frosted with our special butter cream or whipped cream.<\/span><\/li> <li> <span  style=\"font-size: 12px\">Chocolate Passion Black Tie: Cake made with the finest imported dark chocolate filled with variety of berries.<\/span><\/li> <\/ul> <p> \u00a0<\/p> <p> <span  style=\"font-size: 12px\">Fillings: Vanilla, Chocolate, Raspberry, Strawberry, Fresh Sliced Strawberries, Peaches, Pineapples Roasted Almond<\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 12px\"><span rel='lightbox'><img class='bbc_img' alt=\"Divine Cake Options.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762924\/width\/600\/height\/514\" \/><\/span><\/span><\/p> <p> \u00a0<\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 12px\">Here are some BDW Bride's Cake Photos:<\/span><\/p> <p> <span  style=\"font-size: 12px\"><span rel='lightbox'><img class='bbc_img' alt=\"Wedding Cake v2.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762926\/width\/600\/height\/450\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\"Wedding Cake v3.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762928\/width\/340\/height\/510\" \/><\/span><span rel='lightbox'><img class='bbc_img' alt=\"Wedding Cake.jpg\" src=\"http:\/\/www.bestdestinationwedding.com\/image\/id\/762930\/width\/600\/height\/450\" \/><\/span><\/span><\/p> <p> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>~Trisha~<\/p>\n<p>Destination Wedding Photographer & Travel Agent<br><a  class=\"bbc_url\" href=\"http:\/\/www.faberphotography.com\">www.faberphotography.com<\/a>\u00a0-\u00a0My latest destination wedding photos can be found\u00a0<a  class=\"bbc_url\" href=\"http:\/\/faberphotography.com\/destination-wedding\/\">HERE<\/a><br><br><span style=\"font-family:arial, helvetica, sans-serif;color:rgb(0,128,128);\"><strong>Disney Specialist\u00a0<\/strong><\/span><span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\">\u00a0\/ \u00a0<\/span><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/\" title=\"\"><strong>Bride & Groom Fly FREE Promotion<\/strong><\/a><\/p>\n<p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\">\u00a0<br><strong><span style=\"color:rgb(0,128,128);\"><a  class=\"bbc_url\" href=\"http:\/\/wrighttravelagency.com\/inquiry\/\" title=\"External link\">Looking for a travel agent that KNOWS DISNEY?<\/a><\/span><\/strong><span style=\"color:rgb(0,128,128);\">\u00a0 We are an award winning travel agency and you can\u00a0<\/span><strong><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/\" title=\"\"><span style=\"color:rgb(0,128,128);\">read our reviews\u00a0here.<\/span><\/a><\/strong><br>\n\u00a0<br><span style=\"color:rgb(0,128,128);\"><strong>Awards and recognition:\u00a0<\/strong><\/span><br><span style=\"color:rgb(0,128,128);\">Palace Resorts Winner \"Top Travel Agent\", \"Top Homebased Travel Agency\" PRO Platinum Agency (Top Award) \u00a0 | \u00a0<\/span><span style=\"color:rgb(0,128,128);\">AMResorts Master Agent & Top Agency \u00a0| \u00a0<\/span><span style=\"color:rgb(0,128,128);\">Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator |\u00a0<strong><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/68050-karisma-hotels-givc-and-gi-wedding-consultants-wright-travel-agency\/\" title=\"\">Wright Travel & Karisma GIVC Benefits<\/a>\u00a0|\u00a0<\/strong><\/span><span style=\"color:rgb(0,128,128);\">Travel Impressions Best of the Best Globe Winner \u00a0 | \u00a0 <\/span><span style=\"color:rgb(0,128,128);\">Apple Vacations Golden Apple Winner \u00a0<\/span><br><span><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17612\/sml_gallery_206696_17612_13451.png\" alt=\"sml_gallery_206696_17612_13451.png\"><\/span><span><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"><\/span>\u00a0\u00a0 \u00a0<span><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><\/span><br><span style=\"color:rgb(0,128,128);\"><strong><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010\" title=\"\">Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><strong><span style=\"color:rgb(178,34,34);\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a  class=\"bbc_url\" href=\"mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com\" title=\"External link\">ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"trisha@wrighttravelagency.com","IpAddress":"12.24.226.126","GroupId":46,"GroupName":"VIP Member","JoinDate":1171995300,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-207201.jpg?_r=1452788764","PhotoWidth":200,"PhotoHeight":296,"PhotoType":"custom"},"FormattedName":"TATrisha","Id":207201,"Name":"TATrisha","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":66415,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9b4a00727e8747e56e44dbf593ce81a8","RawContent":"&lt;p&gt; &lt;strong&gt;&lt;span style=\"font-size: 12px\"&gt;Details - &lt;\/span&gt;&lt;\/strong&gt;&lt;span style=\"font-size: 12px\"&gt;if you uncover some other random expenses or options, please PM or email me!&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;The wedding canopy is 2 meters per side (approximately 6 ft x 6 ft)&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Walkway can be red or white to Pergola&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;3 foot long sparklers $5 per sparkler.&amp;nbsp; Small metal ones $3\/6&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Projector for slideshow $300&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Welcome bag distribution $2-3 a bag&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;$40 for dress cleaning (after TTD session!)&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;20 minutes from Playa Del Carmen, 15 minutes from Cancun&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Daily van from the resort takes you into town for $1 a person&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Chair bows $5 each, if you bring your own there is a $1 iron fee&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;White tiffany chairs $9&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Brown tiffany chairs $7&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Fire dancers $1,000 a performance&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Excursion contact alex.orozco@yourcancundmc.com , her name is Alejandra&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size: 12px\"&gt;Day Pass $55 per persona&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1595159,"PostDate":1331759394,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <strong><span  style=\"font-size: 12px\">Details - <\/span><\/strong><span  style=\"font-size: 12px\">if you uncover some other random expenses or options, please PM or email me!<\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"font-size: 12px\">The wedding canopy is 2 meters per side (approximately 6 ft x 6 ft)<\/span><\/p> <p> <span  style=\"font-size: 12px\">Walkway can be red or white to Pergola<\/span><\/p> <p> <span  style=\"font-size: 12px\">3 foot long sparklers $5 per sparkler.\u00a0 Small metal ones $3\/6<\/span><\/p> <p> <span  style=\"font-size: 12px\">Projector for slideshow $300<\/span><\/p> <p> <span  style=\"font-size: 12px\">Welcome bag distribution $2-3 a bag<\/span><\/p> <p> <span  style=\"font-size: 12px\">$40 for dress cleaning (after TTD session!)<\/span><\/p> <p> <span  style=\"font-size: 12px\">20 minutes from Playa Del Carmen, 15 minutes from Cancun<\/span><\/p> <p> <span  style=\"font-size: 12px\">Daily van from the resort takes you into town for $1 a person<\/span><\/p> <p> <span  style=\"font-size: 12px\">Chair bows $5 each, if you bring your own there is a $1 iron fee<\/span><\/p> <p> <span  style=\"font-size: 12px\">White tiffany chairs $9<\/span><\/p> <p> <span  style=\"font-size: 12px\">Brown tiffany chairs $7<\/span><\/p> <p> <span  style=\"font-size: 12px\">Fire dancers $1,000 a performance<\/span><\/p> <p> <span  style=\"font-size: 12px\">Excursion contact alex.orozco@yourcancundmc.com , her name is Alejandra<\/span><\/p> <p> <span  style=\"font-size: 12px\">Day Pass $55 per persona<\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>~Trisha~<\/p>\n<p>Destination Wedding Photographer & Travel Agent<br><a  class=\"bbc_url\" href=\"http:\/\/www.faberphotography.com\">www.faberphotography.com<\/a>\u00a0-\u00a0My latest destination wedding photos can be found\u00a0<a  class=\"bbc_url\" href=\"http:\/\/faberphotography.com\/destination-wedding\/\">HERE<\/a><br><br><span style=\"font-family:arial, helvetica, sans-serif;color:rgb(0,128,128);\"><strong>Disney Specialist\u00a0<\/strong><\/span><span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\">\u00a0\/ \u00a0<\/span><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/\" title=\"\"><strong>Bride & Groom Fly FREE Promotion<\/strong><\/a><\/p>\n<p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\">\u00a0<br><strong><span style=\"color:rgb(0,128,128);\"><a  class=\"bbc_url\" href=\"http:\/\/wrighttravelagency.com\/inquiry\/\" title=\"External link\">Looking for a travel agent that KNOWS DISNEY?<\/a><\/span><\/strong><span style=\"color:rgb(0,128,128);\">\u00a0 We are an award winning travel agency and you can\u00a0<\/span><strong><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/\" title=\"\"><span style=\"color:rgb(0,128,128);\">read our reviews\u00a0here.<\/span><\/a><\/strong><br>\n\u00a0<br><span style=\"color:rgb(0,128,128);\"><strong>Awards and recognition:\u00a0<\/strong><\/span><br><span style=\"color:rgb(0,128,128);\">Palace Resorts Winner \"Top Travel Agent\", \"Top Homebased Travel Agency\" PRO Platinum Agency (Top Award) \u00a0 | \u00a0<\/span><span style=\"color:rgb(0,128,128);\">AMResorts Master Agent & Top Agency \u00a0| \u00a0<\/span><span style=\"color:rgb(0,128,128);\">Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator |\u00a0<strong><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/topic\/68050-karisma-hotels-givc-and-gi-wedding-consultants-wright-travel-agency\/\" title=\"\">Wright Travel & Karisma GIVC Benefits<\/a>\u00a0|\u00a0<\/strong><\/span><span style=\"color:rgb(0,128,128);\">Travel Impressions Best of the Best Globe Winner \u00a0 | \u00a0 <\/span><span style=\"color:rgb(0,128,128);\">Apple Vacations Golden Apple Winner \u00a0<\/span><br><span><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17612\/sml_gallery_206696_17612_13451.png\" alt=\"sml_gallery_206696_17612_13451.png\"><\/span><span><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"><\/span>\u00a0\u00a0 \u00a0<span><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><\/span><br><span style=\"color:rgb(0,128,128);\"><strong><a  class=\"bbc_url\" href=\"http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010\" title=\"\">Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><strong><span style=\"color:rgb(178,34,34);\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a  class=\"bbc_url\" href=\"mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com\" title=\"External link\">ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"trisha@wrighttravelagency.com","IpAddress":"12.24.226.126","GroupId":46,"GroupName":"VIP Member","JoinDate":1171995300,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-207201.jpg?_r=1452788764","PhotoWidth":200,"PhotoHeight":296,"PhotoType":"custom"},"FormattedName":"TATrisha","Id":207201,"Name":"TATrisha","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":66415,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5ff4fba865a28b00fdfa5772e8cb671e","RawContent":"&lt;p&gt; &lt;st