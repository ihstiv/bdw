ena Resort.....Anyone here anything about it, or have...","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><p><span>monica wasser<\/span><\/p><span><\/span><\/div><\/div>","Email":"daizey128@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1297123055,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-236509.JPG?_r=0","PhotoWidth":200,"PhotoHeight":253,"PhotoType":"custom"},"FormattedName":"moniwoni","Id":236509,"Name":"moniwoni","IsOnline":false}},"Posts":[],"Id":"60331","Title":" \"New Resort Opening May 1 2011\"  NOW LARIMAR ~ PUNTA CANA   ","LastPostDate":1437597842},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":2537,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":true,"Views":217707,"MovedTo":null,"MovedOn":0,"FirstPostId":1326855,"Rating":0,"RatingHits":0,"Starter":{"Id":231734,"Name":"KitCat77","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-231734.bmp?_r=0","PhotoWidth":0,"PhotoHeight":0,"PhotoType":"custom"},"IsOnline":false},"StartDate":1288612163,"LastPoster":{"Id":283889,"Name":"kmateo2015","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283889.jpg?_r=1439237514","PhotoWidth":200,"PhotoHeight":199,"PhotoType":"facebook"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":22,"Preview":{"Id":1326855,"PostDate":1288612163,"PostContent":"We visited the resort last week and booked our July 2011 Catholic wedding.\u00a0 If anyone has any qu...","Author":{"Signature":"","Email":"catloch@aol.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1282747788,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netd