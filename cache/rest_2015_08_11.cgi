guess they don&#039;t need any help getting more weddings in there! lol&lt;\/p&gt;","Attachments":[],"Id":1887116,"PostDate":1424601128,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>This is awesome! Thanks for sharing! I just wish we were ready to book! Although after checking the NOW Larimar is not included. I guess they don't need any help getting more weddings in there! lol<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"seriouslyamber@gmail.com","IpAddress":"99.237.87.24","GroupId":39,"GroupName":"Newbie","JoinDate":1420758542,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281649.jpg?_r=1421027393","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"Everly","Id":281649,"Name":"Everly","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.137.211.49","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78827,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2d084b80359183910745598daf4c679e","RawContent":"&lt;p&gt;Darn my wedding is less than a year away.&amp;nbsp; That would have been great though!&lt;\/p&gt;","Attachments":[],"Id":1890250,"PostDate":1426894884,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Darn my wedding is less than a year away.\u00a0 That would have been great though!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"phimoez@yahoo.com","IpAddress":"50.137.211.49","GroupId":39,"GroupName":"Newbie","JoinDate":1425862236,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"MNsunseeker","Id":282367,"Name":"MNsunseeker","IsOnline":false}}],"Pages":{"TotalItems":4,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
