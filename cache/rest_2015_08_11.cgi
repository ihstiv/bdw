hotoType":"custom"},"IsOnline":false},"StartDate":1381327374,"LastPoster":{"Id":277780,"Name":"Kayla88","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":93,"Preview":{"Id":1877322,"PostDate":1414631349,"PostContent":"I'm struggling with picking a date for our AHRs, My family lives across the country from my Fianc...","Author":{"Signature":"","Email":"kcrosby86@msn.com","IpAddress":"142.179.243.111","GroupId":40,"GroupName":"Jr. Member","JoinDate":1398815231,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Kayla88","Id":277780,"Name":"Kayla88","IsOnline":false}},"Posts":[],"Id":"75312","Title":"How long to wait for the AHR","LastPostDate":1414631349},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":10,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":738,"MovedTo":null,"MovedOn":0,"FirstPostId":1857289,"Rating":0,"RatingHits":0,"Starter":{"Id":277449,"Name":"NixSpade","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"none"},"IsOnline":false},"StartDate":1403978584,"LastPoster":{"Id":277896,"Name":"hyoungquist","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":93,"Preview":{"Id":1869817,"PostDate":1409332302,"PostContent":"I like the idea of having it before! What an awesome way to kick off all of the celebrations!","Author":{"Signature":"","Email":"holly_youngquist@hotmail.com","IpAddress":"108.215.245.97","GroupId":40,"GroupName":"Jr. Member","JoinDate":1399555622,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"hyoungquist","Id":277896,"Name":"hyoungquist","IsOnline":false}},"Posts":[],"Id":"77421","Title":"Ahr Before Dw?","LastPostDate":1409332302}],"Pages":{"TotalItems":276,"TotalPages":19,"CurrentPage":0,"NextPage":15,"PreviousPage":-1,"LastPage":270},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
