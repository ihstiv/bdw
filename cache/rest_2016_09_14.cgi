vewright.netdna-cdn.com\/cdn\/profile\/photo-274523.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"cindyd","Id":274523,"Name":"cindyd","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"79.160.23.45","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":70637,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"79464f71b7c982839372f42289787a26","RawContent":"My husband-to-be (wow, that&#039;s still weird to say) will be wearing almost all black despite the heat and tropical feel (he&#039;s a really cool type, and would look really weird in flip flops and linen pants). He&#039;ll be wearing black shoes with blue socks, superdark tight blue jeans (almost black), a black shirt with the sleeves rolled up, a blue tie, and a black vest. Out wedding colors are different shades of blue, green and ivory :) His boutonni\u00e8re is going to be two green orchids with a blue ribbon.","Attachments":[],"Id":1836843,"PostDate":1394037014,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                My husband-to-be (wow, that's still weird to say) will be wearing almost all black despite the heat and tropical feel (he's a really cool type, and would look really weird in flip flops and linen pants). He'll be wearing black shoes with blue socks, superdark tight blue jeans (almost black), a black shirt with the sleeves rolled up, a blue tie, and a black vest. Out wedding colors are different shades of blue, gree