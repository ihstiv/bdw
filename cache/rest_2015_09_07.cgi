:39,"GroupName":"Newbie","JoinDate":1410255450,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279746.jpg?_r=1410435597","PhotoWidth":50,"PhotoHeight":50,"PhotoType":"custom"},"FormattedName":"Sarah835","Id":279746,"Name":"Sarah835","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"100.0.3.213","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78000,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"59250cc759ea5162ecd58f92f5ed9cae","RawContent":"&lt;p&gt;Sarah Congrats&lt;\/p&gt;\n&lt;p&gt;I am planning Aug of 2016. I am planning the beach also. I think i am going to have a non private dinner then a private reception party after.&lt;\/p&gt;","Attachments":[],"Id":1889795,"PostDate":1426634588,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Sarah Congrats<\/p>\n<p>I am planning Aug of 2016. I am planning the beach also. I think i am going to have a non private dinner then a private reception party after.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"laurenp1528@aol.com","IpAddress":"100.0.3.213","GroupId":39,"GroupName":"Newbie","JoinDate":1425943118,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"laurenstru","Id":282374,"Name":"laurenstru","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.185.147.98","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78000,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3297553f44a87cc46664252b9b1fc9aa","RawContent":"&lt;p&gt;Hi Ladies!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am getting married at the Majestic Elegance on March 31st,2016. We looked into having a private reception, but it was too much money. We were thinking of having a semi-private dinner then a private party at one of the bars after. Is anyone else doing this? Thanks!&lt;\/p&gt;","Attachments":[],"Id":1903502,"PostDate":1440611714,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Ladies!<\/p>\n<p>\u00a0<\/p>\n<p>I am getting married at the Majestic Elegance on March 31st,2016. We looked into having a private reception, but it was too much money. We were thinking of having a semi-private dinner then a private party at one of the bars after. Is anyone else doing this? Thanks!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"dpasqualetti123@gmail.com","IpAddress":"24.185.147.98","GroupId":39,"GroupName":"Newbie","JoinDate":1440611517,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"MrsSanches30","Id":284579,"Name":"MrsSanches30","IsOnli