HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-231467.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1726639,"PostDate":1361994308,"PostContent":"I am open to any destination, but I am looking for an indoor or semi-indoor ceremony venue. \u00a0I h...","Author":{"Signature":"","Email":"natalie.nataliethompson@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1361984947,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-266665.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Charlie","Id":266665,"Name":"Charlie","IsOnline":false}},"Posts":[],"Id":"72874","Title":"Indoor Ceremony Venues","LastPostDate":1476283417},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":529,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":true,"Views":26501,"MovedTo":null,"MovedOn":0,"FirstPostId":1896780,"Rating":0,"RatingHits":0,"Starter":{"Id":281803,"Name":"Ruzanna","Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-281803.jpg?_r=1431571558","PhotoWidth":200,"PhotoHeight":160,"PhotoType":"custom"},"IsOnline":false},"StartDate":1432216355,"LastPoster":{"Id":286776,"Name":"scadeau","Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-286776.jpg?_r=1461191272","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1896780,"PostDate":1432216355,"PostContent":"Hi Ladies! I was chatting with some amazing brides here and i thought, why not meet up? We are al...","Author":{"Signature":"","Email":"rmaranjyan@gmail.com","IpAddress":"24.114.56.222","GroupId":39,"GroupName":"Newbie","JoinDate":1421753212,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-281803.jpg?_r=1431571558","PhotoWidth":200,"PhotoHeight":160,"PhotoType":"custom"},"FormattedName":"Ruzanna","Id":281803,"Name":"Ruzanna","IsOnline":false}},"Posts":[],"Id":"79202","Title":"Toronto (Gta) Brides Meet Up?!","LastPostDate":1476275079}],"Pages":{"TotalItems":14173,"TotalPages":945,"CurrentPage":0,"NextPage":15,"PreviousPage":-1,"LastPage":14160},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
