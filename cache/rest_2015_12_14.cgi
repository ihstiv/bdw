: 12px;'>Joyce<\/span><\/span><\/span>","Email":"weddingsinplayadelcarmen@gmail.com","IpAddress":"187.252.44.28","GroupId":84,"GroupName":"Insiders w\/ Articles","JoinDate":1326854387,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250090.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"dreamweddings","Id":250090,"Name":"dreamweddings","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"200.79.251.123","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79786,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"63dd48d3470ef6efca383272765fd5ef","RawContent":"&lt;p&gt;Hey Brides!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Since this is a month of giving, I am&lt;span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\"&gt;&amp;nbsp;planning on &amp;nbsp;hosting a webinar for you \"Brides\", who are looking to get married in a resort and are just looking for support not a wedding planner.&amp;nbsp;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\"&gt;In this webinar, you will learn the following:&lt;\/span&gt;\n&lt;span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\"&gt;How to know which resort to book?&lt;\/span&gt;\n&lt;span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\"&gt;Where are you in your planning?&lt;\/span&gt;\n&lt;span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\"&gt;Is there anything such as the \u201cperfect\u201d wedding package?&lt;\/span&gt;\n&lt;span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\"&gt;\u201cHelp! I\u00b4ve just gotten started and I\u00b4m already going crazy!\u201d&lt;\/span&gt;\n&lt;span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\"&gt;How to have a beautiful destination wedding&lt;\/span&gt;&lt;span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\"&gt;(while keeping the travel costs under control)&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span&gt;If this is something you would want to join, please leave a comment&amp;nbsp;below. Also let me know the best time to host it for you.&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Happy Planning!&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\"&gt;Joyce&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1908224,"PostDate":1449588277,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hey Brides!<\/p>\n<p>\u00a0<\/p>\n<p>Since this is a month of giving, I am<span  style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif\">\u00a0planning on \u00a0hosting a webinar for you \"Brides\", who are looking to get married in a resort and are just looking for support not a wedding planner.\u00a0<\/span><\/p>\n<p><span  style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif\">In this webinar, you will learn the following:<\/span><br><span  style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif\">How to know which resort to book?<\/span><br><span  style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif\">Where are you in your planning?<\/span><br><span  style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif\">Is there anything such as the \u201cperfect\u201d wedding package?<\/span><br><span  style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif\">\u201cHelp! I\u00b4ve just gotten started and I\u00b4m already going crazy!\u201d<\/span><br><span  style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif\">How to have a beautiful destination wedding<\/span><span  style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif\">(while keeping the travel costs under control)<\/span><\/p>\n<p><span>If this is something you would want to join, please leave a comment\u00a0below. Also let me know the best time to host it for you.<\/span><\/p>\n<p>\u00a0<\/p>\n<p>Happy Planning!<\/p>\n<p><span  style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif\">Joyce<\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"Dream Weddings Riviera Maya- We pay attention to your wishes and coordinate closely with you to ensure your wedding or event is planned to perfection!<br \/>\n<br \/>\n<span style='color: rgb(40,40,40)'><span style='font-family: arial'><span style='font-size: 12px;'>Dream Weddings Riviera Maya<\/span><\/span><\/span><br \/>\n<span style='font-family: arial'><span style='font-size: 12px;'>weddingsinplayadelcarmen@gmail.com<\/span><\/span><br \/>\n<a class='bbc_url' href='http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html'>http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html<\/a><br \/>\n<br \/>\n<span style='color: rgb(40,40,40)'><span style='font-family: arial'><span style='font-size: 12px;'>Happy Planning!<\/span><\/span><\/span><br \/>\n<span style='color: rgb(40,40,40)'><span style='font-family: arial'><span style='font-size: 12px;'>Joyce<\/span><\/span><\/span>","Email":"weddingsinplayadelcarmen@gmail.com","IpAddress":"187.252.44.28","GroupId":84,"GroupName":"Insiders w\/ Articles","JoinDate":1326854387,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250090.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"dreamweddings","Id":250090,"Name":"dreamweddings","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.15.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79786,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"75ac1bd0161ac7ba7759fcc4d373708e","RawContent":"&lt;p&gt;To all you brides to be: I&#039;m really behind in my reviews, one of which is Joyce of Dream Weddings. Joyce was absolutely wonderful during my planning for our vow renewal, even when I got a little nervous nutsy!!&amp;nbsp; She was a calming voice of reason when things were going wrong for us.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;You can definitely count on her webinar to be of value to all of you that are in the early stages of your planning!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck and happy planning!! Go Joyce!!&lt;\/p&gt;","Attachments":[],"Id":1908246,"PostDate":1449638647,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>To all you brides to be: I'm really behind in my reviews, one of which is Joyce of Dream Weddings. Joyce was absolutely wonderful during my planning for our vow renewal, even when I got a little nervous nutsy!!\u00a0 She was a calming voice of reason when things were going wrong for us.<\/p>\n<p>\u00a0<\/p>\n<p>You can definitely count on her webinar to be of value to all of you that are in the early stages of your planning!<\/p>\n<p>\u00a0<\/p>\n<p>Good luck and happy planning!! Go Joyce!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283458999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"190.167.178.190","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79786,"EditedBy":"<strong>Edited by Moments That Matter, 11 December 2015 - 09:13 AM.<\/strong>","EditDate":1449854039,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"b1d837e44cffdc25a782494d4edbdbbb","RawContent":"&lt;p&gt;Great endorsement, acw271011, and we certainly concur - Joyce Rocks!!! Hope all you busy brides are able to let her help you out and take some of your workload off your shoulders......cheers!!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;....here&#039;s a wee gem to inspire you on your way....taken from our &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10150695320839487.414941.18683524486&amp;amp;type=3&#039;&gt;Cover Photos Album &lt;\/a&gt;- enjoy :)&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-mia1-1.xx.fbcdn.net\/hphotos-xlt1\/t31.0-8\/12304126_10153785339774487_6948717609887949276_o.jpg\" alt=\"12304126_10153785339774487_6948717609887\"&gt;&lt;\/p&gt;","Attachments":[],"Id":1908308,"PostDate":1449853978,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Great endorsement, acw271011, and we certainly concur - Joyce Rocks!!! Hope all you busy brides are able to let her help you out and take some of your workload off your shoulders......cheers!!!<\/p>\n<p>\u00a0<\/p>\n<p>....here's a wee gem to inspire you on your way....taken from our <a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10150695320839487.414941.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>Cover Photos Album <\/a>- enjoy <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-mia1-1.xx.fbcdn.net\/hphotos-xlt1\/t31.0-8\/12304126_10153785339774487_6948717609887949276_o.jpg\" alt=\"12304126_10153785339774487_6948717609887\"><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i711.photobucket.com\/albums\/ww116\/momentsthatmatter\/MTMLogo08-1.png\" alt=\"MTMLogo08-1.png\"><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography Studios, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving Mayan Riviera<br>\nEmail: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p>Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/4212-beautiful-november-wedding\/#review'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280210660,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"200.79.251.123","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79786,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"ad1ec2b4e18711314e36d47ca2f6738b","RawContent":"&lt;p&gt;It is always a pleasure to support brides, who need the help .)&lt;\/p&gt;","Attachments":[],"Id":1908318,"PostDate":1449895320,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>It is always a pleasure to support brides, who need the help .)<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"Dream Weddings Riviera Maya- We pay attention to your wishes and coordinate closely with you to ensure your wedding or event is planned to perfection!<br \/>\n<br \/>\n<span style='color: rgb(40,40,40)'><span style='font-family: arial'><span styl