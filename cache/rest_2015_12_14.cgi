{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":18,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":1808,"MovedTo":null,"MovedOn":0,"FirstPostId":1858005,"Rating":0,"RatingHits":0,"Starter":{"Id":278603,"Name":"Sabes44","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278603.jpg?_r=1405559586","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"StartDate":1404343568,"LastPoster":{"Id":285382,"Name":"MarMig","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":7,"Preview":{"Id":1858005,"PostDate":1404343568,"PostContent":"Hello ladies- \u00a0 Anyone else out there using destinationweddings.com? \u00a0In my search for a TA prior...","Author":{"Signature":"","Email":"sabrabenes@gmail.com","IpAddress":"64.147.11.58","GroupId":40,"GroupName":"Jr. Member","JoinDate":1403208876,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278603.jpg?_r=1405559586","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"Sabes44","Id":278603,"Name":"Sabes44","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"64.147.11.58","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77461,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1ae94b453b399c6a7fe54c7e11bfdfbb","RawContent":"&lt;p&gt;Hello ladies-&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Anyone else out there using destinationweddings.com? &amp;nbsp;In my search for a TA prior to finding them, I kept getting no where and had little to no response to anyone I reached out to. &amp;nbsp;I signed up for their \"free\" service and am just concerned about the contract for the room block I need to sign. &amp;nbsp;Is it typical to have to sign a room block for all inclusive resorts?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Any information would be very helpful!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thank you in advance :)&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1858005,"PostDate":1404343568,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello ladies-<\/p>\n<p>\u00a0<\/p>\n<p>Anyone else out there using destinationweddings.com? \u00a0In my search for a TA prior to finding them, I kept getting no where and had little to no response to anyone I reached out to. \u00a0I signed up for their \"free\" service and am just concerned about the contract for the room block I need to sign. \u00a0Is it typical to have to sign a room block for all inclusive resorts?<\/p>\n<p>\u00a0<\/p>\n<p>Any information would be very helpful!<\/p>\n<p>\u00a0<\/p>\n<p>Thank you in advance <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sabrabenes@gmail.com","IpAddress":"64.147.11.58","GroupId":40,"GroupName":"Jr. Member","JoinDate":1403208876,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278603.jpg?_r=1405559586","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"Sabes44","Id":278603,"Name":"Sabes44","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.226.199.68","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77461,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f75120befb6e4f605483eae265a6bafd","RawContent":"&lt;p&gt;I am using them and I don&#039;t have to sign a room block contract. I did pay something though, I believe it was $50.00. My TA is searching for rates for me, when she does get them I will have to put a deposit down and it will hold our reservation and a bunch of rooms so that my guests can book.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1858013,"PostDate":1404351060,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I am using them and I don't have to sign a room block contract. I did pay something though, I believe it was $50.00. My TA is searching for rates for me, when she does get them I will have to put a deposit down and it will hold our reservation and a bunch of rooms so that my guests can book.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"spadeincwedding@yahoo.com","IpAddress":"99.226.206.246","GroupId":40,"GroupName":"Jr. Member","JoinDate":1396402180,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"none"},"FormattedName":"NixSpade","Id":277449,"Name":"NixSpade","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.182.39.99","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77461,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ffc101fddf32414e093a7e40581f5595","RawContent":"I am using them as well. I paid $50 as well (which goes toward the final balance). I did not do the room block because it does not give guest enough time to decide and I had to put a deposit. My TA name is Joanne and she is fabulous :)","Attachments":[],"Id":1858014,"PostDate":1404351567,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I am using them as well. I paid $50 as well (which goes toward the final balance). I did not do the room block because it does not give guest enough time to decide and I had to put a deposit. My TA name is Joanne and she is fabulous <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"Good Luck <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>","Email":"ms.tatiana.rivera@gmail.com","IpAddress":"50.182.39.99","GroupId":40,"GroupName":"Jr. Member","JoinDate":1403762681,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Tatimrivera","Id":278701,"Name":"Tatimrivera","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.119.162.30","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77461,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c33610d2ac61ed41dcf316bae8c03249","RawContent":"&lt;p&gt;I was using them but I ended up going with another TA. We were disappointed with the response time and rates we were getting.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We would have had to put down deposits for my FI and myself which would hold a block of 10 rooms&lt;\/p&gt;","Attachments":[],"Id":1858017,"PostDate":1404353370,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I was using them but I ended up going with another TA. We were disappointed with the response time and rates we were getting.<\/p>\n<p>\u00a0<\/p>\n<p>We would have had to put down deposits for my FI and myself which would hold a block of 10 rooms<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Married December 19, 2014 at Beach Palace Resort in Cancun, Mexico<\/p>\n<p>\u00a0<\/p>\n<p>My Planning Thread - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/'>http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>My Wedding Review<\/p>\n<p>Part 1 - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881197'>http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881197<\/a><\/p>\n<p>Part 2 - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881590'>http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881590<\/a><\/p>\n<p>Part 3 - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881861'>http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881861<\/a><\/p>\n<p>\u00a0","Email":"lilyluu83@gmail.com","IpAddress":"174.119.162.30","GroupId":3,"GroupName":"Member","JoinDate":1395609348,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277296.jpg?_r=1421643766","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"tygrrlily","Id":277296,"Name":"tygrrlily","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"206.223.185.220","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77461,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"752312d80fef8f5a1911c488bf455f2c","RawContent":"&lt;p&gt;I reached out to them more than 3 years ago and got nowhere, and wasn&#039;t impressed at all with their service.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;For the ladies from the US - @Sabes44&amp;nbsp; @[member=\"Tatimrivera\"] - can I ask why you haven&#039;t reached out to the owners of this site? Wright Travel are DW specialists and have tons of experience with resorts and weddings as well as having won awards for their service. They also can help you with group booking rewards that could be available through the resort that you choose. I know there is a resort chain that was offering a $1500 credit that you could use towards private events like a welcome dinner.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I would highly recommend at least talking to them before you commit to someplace or someone else, just to see what they can do for you. Oh yes, and you don&#039;t have to pay anything to them up front for their service!!&lt;\/p&gt;","Attachments":[],"Id":1858083,"PostDate":1404399642,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I reached out to them more than 3 years ago and got nowhere, and wasn't impressed at all with their service.<\/p>\n<p>\u00a0<\/p>\n<p>For the ladies from the US - @Sabes44\u00a0 @<a hovercard-ref=\"member\" hovercard-id=\"278701\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/278701-tatimrivera\/' title='Member profile'><span itemprop=\"name\">Tatimrivera<\/span><\/a> - can I ask why you haven't reached out to the owners of this site? Wright Travel are DW specialists and have tons of experience with resorts and weddings as well as having won awards for their service. They also can help you with group booking rewards that could be available through the resort that you choose. I know there is a resort chain that was offering a $1500 credit that you could use towards private events like a welcome dinner.<\/p>\n<p>\u00a0<\/p>\n<p>I would highly recommend at least talking to them before you commit to someplace or someone else, just to see what they can do for you. Oh yes, and you don't have to pay anything to them up front for their service!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283458999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.202.225.11","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77461,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a834e2018000ac04931b50dde074bd82","RawContent":"&lt;p&gt;Thanks @[member=\"acw271011\"]&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We also specialize in destination weddings. &amp;nbsp;You can see our reviews in my link below.&lt;\/p&gt;","Attachments":[],"Id":1858088,"PostDate":1404400751,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thanks @<a hovercard-ref=\"member\" hovercard-id=\"232000\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/232000-acw271011\/' title='Member profile'><span itemprop=\"name\">acw271011<\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>We also specialize in destination weddings. \u00a0You can see our reviews in my link below.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-family:arial, helvetica, sans-serif;\">Founder and Owner of BestDestinationWedding.com \u00a0\/ \u00a0<\/span><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/'><strong><span style=\"font-family:arial, helvetica, sans-serif;\">Bride & Groom Fly FREE Promotion<\/span><\/strong><\/a><\/p>\n<p>\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><strong><a data-ipb='nomediaparse' href='http:\/\/wrighttravelagency.com\/inquiry\/'><span style=\"color:#008080;\">Looking for a travel agency that specializes in Destination Weddings<\/span><\/a><\/strong><span style=\"color:#008080;\"><strong>?<\/strong> \u00a0We are an award winning travel agency and you can <\/span><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style=\"color:#008080;\">read our reviews\u00a0here.<\/span><\/a><\/strong><\/span><br>\n\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"color:#008080;\"><strong>Awards and recognition:\u00a0<\/strong><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Palace Resorts Winner \"Top Travel Agent\", \"Top Homebased Travel Agency\" PRO Platinum Agency (Top Award) \u00a0 \u00a0 | \u00a0 \u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">AMResorts Master Agent & Top Agency \u00a0<\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/68050-karisma-hotels-givc-and-gi-wedding-consultants-wright-travel-agency\/'><strong>Wright Travel & Karisma GIVC Benefits<\/strong><\/a><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Travel Impressions Best of the Best Globe Winner \u00a0 \u00a0| \u00a0 \u00a0\u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Apple Vacations Golden Apple Winner \u00a0<\/span><\/span><br><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"> \u00a0 \u00a0<img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"font-size:14px;\"><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010'>Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><\/span><\/span><strong><span style=\"color:#b22222;\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a data-ipb='nomediaparse' href='mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com'>ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"admin@bestdestinationwedding.com","IpAddress":"71.202.225.11","GroupId":4,"GroupName":"Administrators","JoinDate":1137224220,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"FormattedName":"TammyWright","Id":206696,"Name":"TammyWright","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"64.147.11.58","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77461,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3a8c2717bd05b41092c07b58dec48d9f","RawContent":"&lt;span&gt;&lt;a  class=\"\" href=\"http:\/\/www.bestdestinationwedding.com\/user\/232000-acw271011\/\" title=\"\"&gt;acw271011&lt;\/a&gt;&amp;nbsp;I had reached out to a few TA&#039;s prior to reaching out to destinationweddings.com and unfortunately I did not have good luck with any of them at all. &amp;nbsp;So that was my original decision to go with destinationweddings.com, however I did reach out to Wright Travel yesterday and just waiting for a response. &amp;nbsp;I just don&#039;t think giving guests 30 days to book their rooms with a room block is good, especially since we haven&#039;t even sent the STD since our date is on hold, but not yet booked. &amp;nbsp;Hoping to hear back from Wright Travel today so I can get another opinion and make sure I am making the best decision for my guests.&lt;\/span&gt;\n&lt;p&gt;Unfortunately I didn&#039;t find this site till after I started talking to destinationweddings.com and at that point I had gotten super frustrated with the TA&#039;s I had talked to who said they could help me yet never got back to me.&lt;\/p&gt;\n\n&lt;p&gt;@&lt;\/p&gt;\n\n\t&lt;span&gt;&lt;a  class=\"\" href=\"http:\/\/www.bestdestinationwedding.com\/user\/278701-tatimrivera\/\" title=\"\"&gt;Tatimrivera&lt;\/a&gt;&amp;nbsp;if you didn&#039;t do the room block, was the rate still the same for your guests or how does that work out? &amp;nbsp;I just don&#039;t feel that the rates are really that good for a room block.&lt;\/span&gt;","Attachments":[],"Id":1858092,"PostDate":1404403875,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                \n\t<span><a href='http:\/\/www.bestdestinationwedding.com\/user\/232000-acw271011\/' class='bbc_url' title=''>acw271011<\/a>\u00a0I had reached out to a few TA's prior to reaching out to destinationweddings.com and unfortunately I did not have good luck with any of them at all. \u00a0So that was my original decision to go with destinationweddings.com, however I did reach out to Wright Travel yesterday and just waiting for a response. \u00a0I just don't think giving guests 30 days to book their rooms with a room block is good, especially since we haven't even sent the STD since our date is on hold, but not yet booked. \u00a0Hoping to hear back from Wright Travel today so I can get another opinion and make sure I am making the best decision for my guests.<\/span><br \/><p>Unfortunately I didn't find this site till after I started talking to destinationweddings.com and at that point I had gotten super frustrated with the TA's I had talked to who said they could help me yet never got back to me.<\/p>\n<br \/><p>@<\/p>\n\n\t<span><a href='http:\/\/www.bestdestinationwedding.com\/user\/278701-tatimrivera\/' class='bbc_url' title=''>Tatimrivera<\/a>\u00a0if you didn't do the room block, was the rate still the same for your guests or how does that work out? \u00a0I just don't feel that the rates are really that good for a room block.<\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sabrabenes@gmail.com","IpAddress":"64.147.11.58","GroupId":40,"GroupName":"Jr. Member","JoinDate":1403208876,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278603.jpg?_r=1405559586","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"Sabes44","Id":278603,"Name":"Sabes44","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"206.223.185.220","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77461,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6b2222c5fb76307fbb2fd8a91703c7c7","RawContent":"[quote name=\"Sabes44\" post=\"1858092\" timestamp=\"1404403875\"]\n[url=\"http:\/\/www.bestdestinationwedding.com\/user\/232000-acw271011\/\"]acw271011[\/url] I had reached out to a few TA&#039;s prior to reaching out to destinationweddings.com and unfortunately I did not have good luck with any of them at all.  So that was my original decision to go with destinationweddings.com, however I did reach out to Wright Travel yesterday and just waiting for a response.  I just don&#039;t think giving guests 30 days to book their rooms with a room block is good, especially since we haven&#039;t even sent the STD since our date is on hold, but not yet booked.  Hoping to hear back from Wright Travel today so I can get another opinion and make sure I am making the best decision for my guests.\nUnfortunately I didn&#039;t find this site till after I started talking to destinationweddings.com and at that point I had gotten super frustrated with the TA&#039;s I had talked to who said they could help me yet never got back to me.\n\n@[url=\"http:\/\/www.bestdestinationwedding.com\/user\/278701-tatimrivera\/\"]Tatimrivera[\/url] if you didn&#039;t do the room block, was the rate still the same for your guests or how does that work out?  I just don&#039;t feel that the rates are really that good for a room block.\n[\/quote]\nI&#039;m sure Wright will be able to help you out! I&#039;ve never heard of any ladies here in the 4+ odd years that I&#039;ve been here say that they only had 30 days for their guests to book their rooms. But I&#039;m not the TA so there may be some other detail that&#039;s relevant. I would absolutely not make any decisions until you hear from Wright! TA Wendy stops by here with comments all the time and she is just a fountain of great information!!!\n\nGood luck!!","Attachments":[],"Id":1858098,"PostDate":1404407998,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Sabes44, on 03 July 2014 - 08:11 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p><span><a href='http:\/\/www.bestdestinationwedding.com\/user\/232000-acw271011\/' class='bbc_url' title=''>acw271011<\/a>\u00a0I had reached out to a few TA's prior to reaching out to destinationweddings.com and unfortunately I did not have good luck with any of them at all. \u00a0So that was my original decision to go with destinationweddings.com, however I did reach out to Wright Travel yesterday and just waiting for a response. \u00a0I just don't think giving guests 30 days to book their rooms with a room block is good, especially since we haven't even sent the STD since our date is on hold, but not yet booked. \u00a0Hoping to hear back from Wright Travel today so I can get another opinion and make sure I am making the best decision for my guests.<\/span><\/p>\n<p>Unfortunately I didn't find this site till after I started talking to destinationweddings.com and at that point I had gotten super frustrated with the TA's I had talked to who said they could help me yet never got back to me.<\/p>\n<br><p>@<\/p>\n<span><a href='http:\/\/www.bestdestinationwedding.com\/user\/278701-tatimrivera\/' class='bbc_url' title=''>Tatimrivera<\/a>\u00a0if you didn't do the room block, was the rate still the same for your guests or how does that work out? \u00a0I just don't feel that the rates are really that good for a room block.<\/span>\n<p>\u00a0<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>I'm sure Wright will be able to help you out! I've never heard of any ladies here in the 4+ odd years that I've been here say that they only had 30 days for their guests to book their rooms. But I'm not the TA so there may be some other detail that's relevant. I would absolutely not make any decisions until you hear from Wright! TA Wendy stops by here with comments all the time and she is just a fountain of great information!!!<\/p>\n<p>\u00a0<\/p>\n<p>Good luck!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283458999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"64.147.11.58","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77461,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ea96fdd4713f55f2d1bf2993c677b1e8","RawContent":"&lt;p&gt;thank you everyone, I talked to Wendy this morning and although the rates look good, I am just not sure about the group contract. &amp;nbsp;Basically if guests don&#039;t book within 30 days (which I doubt they will). &amp;nbsp;My card gets charged the full deposit, and gets refunded after the wedding when guests book, which is the part I don&#039;t like.&lt;\/p&gt;","Attachments":[],"Id":1858103,"PostDate":1404410828,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>thank you everyone, I talked to Wendy this morning and although the rates look good, I am just not sure about the group contract. \u00a0Basically if guests don't book within 30 days (which I doubt they will). \u00a0My card gets charged the full deposit, and gets refunded after the wedding when guests book, which is the part I don't like.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sabrabenes@gmail.com","IpAddress":"64.147.11.58","GroupId":40,"GroupName":"Jr. Member","JoinDate":1403208876,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278603.jpg?_r=1405559586","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"Sabes44","Id":278603,"Name":"Sabes44","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"64.147.11.58","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77461,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f347701186a990fcec59cfc865929bc7","RawContent":"&lt;p&gt;Was anyone else able to get their guests to book within 30 days? &amp;nbsp;I don&#039;t mind fronting the deposit but don&#039;t want to be out 1-2K &amp;nbsp;for a year.&lt;\/p&gt;","Attachments":[],"Id":1858114,"PostDate":1404414299,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Was anyone else able to get their guests to book within 30 days? \u00a0I don't mind fronting the deposit but don't want to be out 1-2K \u00a0for a year.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sabrabenes@gmail.com","IpAddress":"64.147.11.58","GroupId":40,"GroupName":"Jr. Member","JoinDate":1403208876,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278603.jpg?_r=1405559586","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"Sabes44","Id":278603,"Name":"Sabes44","IsOnline":false}}],"Id":"77461","Title":"Destinationweddings.com And Room Block Contracts","LastPostDate":1449101402},"Pages":{"TotalItems":18,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
