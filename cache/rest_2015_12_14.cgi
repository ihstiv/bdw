284747.jpg?_r=1441995158","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":7,"Preview":{"Id":1886526,"PostDate":1424146728,"PostContent":"Well, I guess it is my turn to start my own planning thread! \u00a0I had read so many helpful planning...","Author":{"Signature":"<div><br><div>\u00a0<\/div>\n<div>\u00a0<\/div>\n<div>Married on June 20th, 2015 at the Grand Sunset Princess Riviera Gazebo & Reception at the Chill Out with 60 guests<\/div>\n<div>\u00a0<\/div>\n<\/div>\n<div>\u00a0<\/div>\n<p>My planning thread:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/<\/a><\/p>\n<p>My review thread: \u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/<\/a>","Email":"rebecca.valero@gmail.com","IpAddress":"38.112.94.76","GroupId":3,"GroupName":"Member","JoinDate":1396982852,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277519.jpg?_r=1439827749","PhotoWidth":200,"PhotoHeight":132,"PhotoType":"custom"},"FormattedName":"veryvalentine","Id":277519,"Name":"veryvalentine","IsOnline":false}},"Posts":[],"Id":"78801","Title":"Veryvalero's Wedding Planning Thread - Grand Sunset Princess","LastPostDate":1441995416}],"Pages":{"TotalItems":1663,"TotalPages":111,"CurrentPage":0,"NextPage":15,"PreviousPage":-1,"LastPage":1650},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
