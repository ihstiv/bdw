{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":19,"QueuedPosts":0,"DeletedPosts":1,"HasUnreadPosts":true,"HasAttachments":false,"Views":3799,"MovedTo":null,"MovedOn":0,"FirstPostId":1825506,"Rating":0,"RatingHits":0,"Starter":{"Id":274657,"Name":"misbosox","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-274657.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"StartDate":1389631141,"LastPoster":{"Id":285528,"Name":"clmattie","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":2,"Preview":{"Id":1825506,"PostDate":1389631141,"PostContent":"We are getting married at Moon Palace  in  June 2015 Just looking for input\/ suggestions from pas...","Author":{"Signature":"","Email":"mishtb96@aol.com","IpAddress":"162.231.9.34","GroupId":40,"GroupName":"Jr. Member","JoinDate":1383053267,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-274657.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"misbosox","Id":274657,"Name":"misbosox","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"166.147.72.148","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75976,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"87776f6ba2eda3da42dfa40759ad72e1","RawContent":"We are getting married at Moon Palace  in  June 2015\n\n\nJust looking for input\/ suggestions from past brides\n\n\n 1.  In June, what would be the best time to have ceremony?   How long for pictures? \n\n    Also, how many hours in advance before wedding should we get our hair\/makeup done?\n\n\n 2.    With the complimentary wedding do the give you an iPod Dock\/speaker setup to play music during ceremony ?\n\n\n3.    We are looking at 40-67 guests... any suggestions on  cocktail hour and reception locations?\n\nI know some locations charge an extra $12 per person for setup fee.  Is there any that would fit us that does not charge the fee?\n\n\n4.   For that many guests how much cake do we need?  What&#039;s your favorite flavor?\n\n\n5.   Also any recommendations on which cocktail food choices and buffets would you suggest ?  \n\nAlso, do they let you have your own signature drinks?\n\n\n6.   Any reviews on Moon&#039;s DJ?    Dancing is a must!!   Or is it better to rent iPod Dock\/speakers?\n\n\n7.   We  are planning on having a welcome dinner or welcome cocktail party?   Any suggestions on where and what time?  \n\n\n8.    Do we need a rehearsal?\n\n\n10.    For the reception we might buy one of the collections, but if we don&#039;t  can we rent one or two pieces from a collection?   I seen the Zuniga catalog and even their prices are high. \n\n\n\nWe might use the resort photographer for wedding.    We would like to do a TTD session.   Would that take place on site at the resort or off site?  Trying to avoid outside vendor fees.   Any suggestions of local photographers and pricing\/packages for TTD","Attachments":[],"Id":1825506,"PostDate":1389631141,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We are getting married at Moon Palace  in  June 2015<br><br>\nJust looking for input\/ suggestions from past brides<br><br>\n 1.  In June, what would be the best time to have ceremony?   How long for pictures? <br>\n    Also, how many hours in advance before wedding should we get our hair\/makeup done?<br><br>\n 2.    With the complimentary wedding do the give you an iPod Dock\/speaker setup to play music during ceremony ?<br><br>\n3.    We are looking at 40-67 guests... any suggestions on  cocktail hour and reception locations?<br>\nI know some locations charge an extra $12 per person for setup fee.  Is there any that would fit us that does not charge the fee?<br><br>\n4.   For that many guests how much cake do we need?  What's your favorite flavor?<br><br>\n5.   Also any recommendations on which cocktail food choices and buffets would you suggest ?  <br>\nAlso, do they let you have your own signature drinks?<br><br>\n6.   Any reviews on Moon's DJ?    Dancing is a must!!   Or is it better to rent iPod Dock\/speakers?<br><br>\n7.   We  are planning on having a welcome dinner or welcome cocktail party?   Any suggestions on where and what time?  <br><br>\n8.    Do we need a rehearsal?<br><br>\n10.    For the reception we might buy one of the collections, but if we don't  can we rent one or two pieces from a collection?   I seen the Zuniga catalog and even their prices are high. <br><br><br>\nWe might use the resort photographer for wedding.    We would like to do a TTD session.   Would that take place on site at the resort or off site?  Trying to avoid outside vendor fees.   Any suggestions of local photographers and pricing\/packages for TTD\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mishtb96@aol.com","IpAddress":"162.231.9.34","GroupId":40,"GroupName":"Jr. Member","JoinDate":1383053267,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-274657.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"misbosox","Id":274657,"Name":"misbosox","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.47.130.57","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75976,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e1f3e944ff0ad43327199d014902565b","RawContent":"These are great questions!! I&#039;m interested in the answers, too.","Attachments":[],"Id":1826329,"PostDate":1389819719,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                These are great questions!! I'm interested in the answers, too. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"courtneyhowat@hotmail.com","IpAddress":"207.47.130.57","GroupId":39,"GroupName":"Newbie","JoinDate":1389538698,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276030.jpg?_r=1392155643","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"facebook"},"FormattedName":"bk1112","Id":276030,"Name":"bk1112","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"151.228.109.2","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75976,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"7e3d2daff8a25c96451b5c280c186b34","RawContent":"1. In June, what would be the best time to have ceremony? How long for pictures? \n\nAlso, how many hours in advance before wedding should we get our hair\/makeup done?\n\nA) I got married in October which I know is a different time of year. I got married at 3pm which was a fab time for me as I had all morning to get ready and relax. Plus if using the resort hair dresser they work on Mexican time so get an early appt if poss. \n\n\n2. With the complimentary wedding do the give you an iPod Dock\/speaker setup to play music during ceremony ?\n\nYes, I provided them with my songs. Ideally they suggest you have for songs\n\n-bridesmaid entrance\n\n-bride entrance\n\n- signing the register\n\n-kiss \n\n\n3. We are looking at 40-67 guests... any suggestions on cocktail hour and reception locations?\n\nI know some locations charge an extra $12 per person for setup fee. Is there any that would fit us that does not charge the fee?\n\n\nThe set up fee is only for difficult locations like the beach and the Caribbean terrace which is upstairs. We had our reception on the Venardo terrace which didn&#039;t incur an extra charge and is right on the beach. It was a great location. If you look at my profile you should be able to see some pics. Also I&#039;ve done a review on the newbie moon palace brides section there is more info on the reception there. \n\n\n4. For that many guests how much cake do we need? What&#039;s your favorite flavor?\n\nWe had Cheese cake which everyone loved. Was something different. Ours was for up to 30 people but the slices were huge!\n\n\n5. Also any recommendations on which cocktail food choices and buffets would you suggest ? \n\nAlso, do they let you have your own signature drinks?\n\nWe had 2 champagne toasts at no extra charge. We had the Mexican for the cocktail hour which everybody loved and then the Italian for the main buffet which was really nice.  \n\n\n6. Any reviews on Moon&#039;s DJ? Dancing is a must!! Or is it better to rent iPod Dock\/speakers?\n\nI wanted my own playlist and DJs were looking expensive considering all they would of done was played the playlist I wanted. We hired speakers and lights and I did my playlist on spotify which worked brilliantly.\n\n\n7. We are planning on having a welcome dinner or welcome cocktail party? Any suggestions on where and what time? \n\n\nWe had ours on the grand terrace and did it Hawaiian themed. We opted for the BBQ buffet which everyone seemed to love. Again more details on this are on my review. \n\n\n8. Do we need a rehearsal?\n\nWe didn&#039;t have one or were offered one. It&#039;s all pretty straight forward. I&#039;m guessing it&#039;s possible just as your WC\n\n\n10. For the reception we might buy one of the collections, but if we don&#039;t can we rent one or two pieces from a collection? I seen the Zuniga catalog and even their prices are high. \n\n\nThe collections are expensive and don&#039;t really include much for the reception. We did all ours through Zuniga who were fab! they did a great job and easy to deal with. Plus you can negotiate with them. \n\n\nHope that helped. Sorry if I babbled on a bit x","Attachments":[],"Id":1826755,"PostDate":1389907774,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                1. In June, what would be the best time to have ceremony? How long for pictures? <br>\nAlso, how many hours in advance before wedding should we get our hair\/makeup done?<br>\nA) I got married in October which I know is a different time of year. I got married at 3pm which was a fab time for me as I had all morning to get ready and relax. Plus if using the resort hair dresser they work on Mexican time so get an early appt if poss. <br><br>\n2. With the complimentary wedding do the give you an iPod Dock\/speaker setup to play music during ceremony ?<br>\nYes, I provided them with my songs. Ideally they suggest you have for songs<br>\n-bridesmaid entrance<br>\n-bride entrance<br>\n- signing the register<br>\n-kiss <br><br>\n3. We are looking at 40-67 guests... any suggestions on cocktail hour and reception locations?<br>\nI know some locations charge an extra $12 per person for setup fee. Is there any that would fit us that does not charge the fee?<br><br>\nThe set up fee is only for difficult locations like the beach and the Caribbean terrace which is upstairs. We had our reception on the Venardo terrace which didn't incur an extra charge and is right on the beach. It was a great location. If you look at my profile you should be able to see some pics. Also I've done a review on the newbie moon palace brides section there is more info on the reception there. <br><br>\n4. For that many guests how much cake do we need? What's your favorite flavor?<br>\nWe had Cheese cake which everyone loved. Was something different. Ours was for up to 30 people but the slices were huge!<br><br>\n5. Also any recommendations on which cocktail food choices and buffets would you suggest ? <br>\nAlso, do they let you have your own signature drinks?<br>\nWe had 2 champagne toasts at no extra charge. We had the Mexican for the cocktail hour which everybody loved and then the Italian for the main buffet which was really nice.  <br><br>\n6. Any reviews on Moon's DJ? Dancing is a must!! Or is it better to rent iPod Dock\/speakers?<br>\nI wanted my own playlist and DJs were looking expensive considering all they would of done was played the playlist I wanted. We hired speakers and lights and I did my playlist on spotify which worked brilliantly.<br><br>\n7. We are planning on having a welcome dinner or welcome cocktail party? Any suggestions on where and what time? <br><br>\nWe had ours on the grand terrace and did it Hawaiian themed. We opted for the BBQ buffet which everyone seemed to love. Again more details on this are on my review. <br><br>\n8. Do we need a rehearsal?<br>\nWe didn't have one or were offered one. It's all pretty straight forward. I'm guessing it's possible just as your WC<br><br>\n10. For the reception we might buy one of the collections, but if we don't can we rent one or two pieces from a collection? I seen the Zuniga catalog and even their prices are high. <br><br>\nThe collections are expensive and don't really include much for the reception. We did all ours through Zuniga who were fab! they did a great job and easy to deal with. Plus you can negotiate with them. <br><br>\nHope that helped. Sorry if I babbled on a bit x \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"emilykate.field@hotmail.co.uk","IpAddress":"151.228.109.2","GroupId":39,"GroupName":"Newbie","JoinDate":1358108379,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-264357.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Ems85","Id":264357,"Name":"Ems85","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"162.231.9.34","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75976,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"acaaab11f88706ce321609a4d978c52f","RawContent":"&lt;p&gt;Thank You @[member=\"Ems85\"]!   this is very helpful!&lt;\/p&gt;","Attachments":[],"Id":1826890,"PostDate":1389966495,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thank You @<a hovercard-ref=\"member\" hovercard-id=\"264357\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/264357-ems85\/' title='Member profile'><span itemprop=\"name\">Ems85<\/span><\/a>!\u00a0\u00a0 this is very helpful!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mishtb96@aol.com","IpAddress":"162.231.9.34","GroupId":40,"GroupName":"Jr. Member","JoinDate":1383053267,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-274657.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"misbosox","Id":274657,"Name":"misbosox","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"151.228.109.2","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75976,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"583bce17993234d4d247080408f62d06","RawContent":"No probs :-) if you want any more help or would like to see photos let me know x","Attachments":[],"Id":1827191,"PostDate":1390082373,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                No probs :-) if you want any more help or would like to see photos let me know x \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"emilykate.field@hotmail.co.uk","IpAddress":"151.228.109.2","GroupId":39,"GroupName":"Newbie","JoinDate":1358108379,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-264357.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Ems85","Id":264357,"Name":"Ems85","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.254.111.22","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75976,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c403bf8d3b7e7c911e9812adee2f4539","RawContent":"&lt;p&gt;I&#039;m getting married at Moon Palace in July 2014. I&#039;m wondering about the salon services on the resort. Were past brides happy with hair\/makeup? I&#039;m having an Indian wedding with vibrant clothing so I&#039;m nervous about makeup!&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Advice and photos would be much appreciated!&lt;\/p&gt;","Attachments":[],"Id":1828785,"PostDate":1390690147,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I'm getting married at Moon Palace in July 2014. I'm wondering about the salon services on the resort. Were past brides happy with hair\/makeup? I'm having an Indian wedding with vibrant clothing so I'm nervous about makeup!\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Advice and photos would be much appreciated!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nchatha@gmail.com","IpAddress":"99.254.111.22","GroupId":39,"GroupName":"Newbie","JoinDate":1384552146,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275085.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"SikhBride","Id":275085,"Name":"SikhBride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.108.35.133","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75976,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"34fd8c7736ec8a2bcbb4f3635cdf106e","RawContent":"[quote name=\"SikhBride\" post=\"1828785\" timestamp=\"1390690147\"]\nI&#039;m getting married at Moon Palace in July 2014. I&#039;m wondering about the salon services on the resort. Were past brides happy with hair\/makeup? I&#039;m having an Indian wedding with vibrant clothing so I&#039;m nervous about makeup! \n\nAdvice and photos would be much appreciated![\/quote]I would like to know this too! I am concerned that if our group just shows up without having a practice run that it might not turn out the way we expected.... I hope someone responds with their experiences!","Attachments":[],"Id":1839136,"PostDate":1395195292,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>SikhBride, on 25 January 2014 - 02:49 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>I'm getting married at Moon Palace in July 2014. I'm wondering about the salon services on the resort. Were past brides happy with hair\/makeup? I'm having an Indian wedding with vibrant clothing so I'm nervous about makeup!\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Advice and photos would be much appreciated!<\/p>\n<\/div>\n<\/div><\/div>\n<p>I would like to know this too! I am concerned that if our group just shows up without having a practice run that it might not turn out the way we expected.... I hope someone responds with their experiences!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jackielemman86@comcast.net","IpAddress":"70.123.142.233","GroupId":40,"GroupName":"Jr. Member","JoinDate":1379799598,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-273651.jpg?_r=1388803183","PhotoWidth":200,"PhotoHeight":268,"PhotoType":"custom"},"FormattedName":"jackielemman","Id":273651,"Name":"jackielemman","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"143.43.138.115","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75976,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"35786e0edcd8ca422695f7e59d96c250","RawContent":"[quote name=\"Ems85\" post=\"1826755\" timestamp=\"1389907774\"]\n1. In June, what would be the best time to have ceremony? How long for pictures?\nAlso, how many hours in advance before wedding should we get our hair\/makeup done?\nA) I got married in October which I know is a different time of year. I got married at 3pm which was a fab time for me as I had all morning to get ready and relax. Plus if using the resort hair dresser they work on Mexican time so get an early appt if poss.\n\n2. With the complimentary wedding do the give you an iPod Dock\/speaker setup to play music during ceremony ?\nYes, I provided them with my songs. Ideally they suggest you have for songs\n-bridesmaid entrance\n-bride entrance\n- signing the register\n-kiss\n\n3. We are looking at 40-67 guests... any suggestions on cocktail hour and reception locations?\nI know some locations charge an extra $12 per person for setup fee. Is there any that would fit us that does not charge the fee?\n\nThe set up fee is only for difficult locations like the beach and the Caribbean terrace which is upstairs. We had our reception on the Venardo terrace which didn&#039;t incur an extra charge and is right on the beach. It was a great location. If you look at my profile you should be able to see some pics. Also I&#039;ve done a review on the newbie moon palace brides section there is more info on the reception there.\n\n4. For that many guests how much cake do we need? What&#039;s your favorite flavor?\nWe had Cheese cake which everyone loved. Was something different. Ours was for up to 30 people but the slices were huge!\n\n5. Also any recommendations on which cocktail food choices and buffets would you suggest ?\nAlso, do they let you have your own signature drinks?\nWe had 2 champagne toasts at no extra charge. We had the Mexican for the cocktail hour which everybody loved and then the Italian for the main buffet which was really nice.\n\n6. Any reviews on Moon&#039;s DJ? Dancing is a must!! Or is it better to rent iPod Dock\/speakers?\nI wanted my own playlist and DJs were looking expensive considering all they would of done was played the playlist I wanted. We hired speakers and lights and I did my playlist on spotify which worked brilliantly.\n\n7. We are planning on having a welcome dinner or welcome cocktail party? Any suggestions on where and what time?\n\nWe had ours on the grand terrace and did it Hawaiian themed. We opted for the BBQ buffet which everyone seemed to love. Again more details on this are on my review.\n\n8. Do we need a rehearsal?\nWe didn&#039;t have one or were offered one. It&#039;s all pretty straight forward. I&#039;m guessing it&#039;s possible just as your WC\n\n10. For the reception we might buy one of the collections, but if we don&#039;t can we rent one or two pieces from a collection? I seen the Zuniga catalog and even their prices are high.\n\nThe collections are expensive and don&#039;t really include much for the reception. We did all ours through Zuniga who were fab! they did a great job and easy to deal with. Plus you can negotiate with them.\n\nHope that helped. Sorry if I babbled on a bit x[\/quote]\nThank you!  Nice to see the answers to these questions!!","Attachments":[],"Id":1840100,"PostDate":1395686613,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Ems85, on 16 January 2014 - 01:29 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>1. In June, what would be the best time to have ceremony? How long for pictures?<br>\nAlso, how many hours in advance before wedding should we get our hair\/makeup done?<br>\nA) I got married in October which I know is a different time of year. I got married at 3pm which was a fab time for me as I had all morning to get ready and relax. Plus if using the resort hair dresser they work on Mexican time so get an early appt if poss.<br><br>\n2. With the complimentary wedding do the give you an iPod Dock\/speaker setup to play music during ceremony ?<br>\nYes, I provided them with my songs. Ideally they suggest you have for songs<br>\n-bridesmaid entrance<br>\n-bride entrance<br>\n- signing the register<br>\n-kiss<br><br>\n3. We are looking at 40-67 guests... any suggestions on cocktail hour and reception locations?<br>\nI know some locations charge an extra $12 per person for setup fee. Is there any that would fit us that does not charge the fee?<br><br>\nThe set up fee is only for difficult locations like the beach and the Caribbean terrace which is upstairs. We had our reception on the Venardo terrace which didn't incur an extra charge and is right on the beach. It was a great location. If you look at my profile you should be able to see some pics. Also I've done a review on the newbie moon palace brides section there is more info on the reception there.<br><br>\n4. For that many guests how much cake do we need? What's your favorite flavor?<br>\nWe had Cheese cake which everyone loved. Was something different. Ours was for up to 30 people but the slices were huge!<br><br>\n5. Also any recommendations on which cocktail food choices and buffets would you suggest ?<br>\nAlso, do they let you have your own signature drinks?<br>\nWe had 2 champagne toasts at no extra charge. We had the Mexican for the cocktail hour which everybody loved and then the Italian for the main buffet which was really nice.<br><br>\n6. Any reviews on Moon's DJ? Dancing is a must!! Or is it better to rent iPod Dock\/speakers?<br>\nI wanted my own playlist and DJs were looking expensive considering all they would of done was played the playlist I wanted. We hired speakers and lights and I did my playlist on spotify which worked brilliantly.<br><br>\n7. We are planning on having a welcome dinner or welcome cocktail party? Any suggestions on where and what time?<br><br>\nWe had ours on the grand terrace and did it Hawaiian themed. We opted for the BBQ buffet which everyone seemed to love. Again more details on this are on my review.<br><br>\n8. Do we need a rehearsal?<br>\nWe didn't have one or were offered one. It's all pretty straight forward. I'm guessing it's possible just as your WC<br><br>\n10. For the reception we might buy one of the collections, but if we don't can we rent one or two pieces from a collection? I seen the Zuniga catalog and even their prices are high.<br><br>\nThe collections are expensive and don't really include much for the reception. We did all ours through Zuniga who were fab! they did a great job and easy to deal with. Plus you can negotiate with them.<br><br>\nHope that helped. Sorry if I babbled on a bit x<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>Thank you! \u00a0Nice to see the answers to these questions!!\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ctlind7@gmail.com","IpAddress":"143.43.138.103","GroupId":39,"GroupName":"Newbie","JoinDate":1375472413,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272185.jpg?_r=1407873310","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"ctlind7","Id":272185,"Name":"ctlind7","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.108.35.133","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75976,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"69f0a9236bfe893c805f1971c0dc73fc","RawContent":"&lt;p&gt;Thanks for answering all those questions! Tons of help!!&lt;\/p&gt;","Attachments":[],"Id":1840506,"PostDate":1395793161,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thanks for answering all those questions! Tons of help!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jackielemman86@comcast.net","IpAddress":"70.123.142.233","GroupId":40,"GroupName":"Jr. Member","JoinDate":1379799598,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-273651.jpg?_r=1388803183","PhotoWidth":200,"PhotoHeight":268,"PhotoType":"custom"},"FormattedName":"jackielemman","Id":273651,"Name":"jackielemman","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"189.221.96.179","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75976,"EditedBy":"<strong>Edited by omontes, 26 March 2014 - 10:26 AM.<\/strong>","EditDate":1395858379,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"51392b83a479aef0e5dcd546d24e3251","RawContent":"&lt;p&gt;Hi ladies!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Congrats future brides!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;A photographer for a wedding is important because we will capture those unforgettable moments on that special day!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Take a look at the wedding of Jesse and Breanna that took place at Moon Palace,&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.OctavioMontes.com&#039;&gt;http:\/\/www.OctavioMontes.com&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;div&gt;[sharedmedia=gallery:images:74464]&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;\n&lt;div&gt;[sharedmedia=core:attachments:27153]&lt;\/div&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;\/div&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;but if that&#039;s not enough, I invite you to visit our website&lt;\/p&gt;","Attachments":[],"Id":1840681,"PostDate":1395858349,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi ladies!<\/p>\n<p>\u00a0<\/p>\n<p>Congrats future brides!<\/p>\n<p>\u00a0<\/p>\n<p>A photographer for a wedding is important because we will capture those unforgettable moments on that special day!<\/p>\n<p>\u00a0<\/p>\n<p>Take a look at the wedding of Jesse and Breanna that took place at Moon Palace,<\/p>\n<p><a href='http:\/\/www.OctavioMontes.com' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.OctavioMontes.com<\/a><\/p>\n<p>\u00a0<\/p>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/gallery\/image\/74464-moon-palace-chappel\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17608\/sml_gallery_238129_17608_320788.jpg' class='galattach galimageview sharedmedia_screenshot' title='Moon Palace Chappel'  width='200' height='134'  alt='Moon Palace Chappel' id='sml_image_view_74464' \/><\/a>\n<br \/><\/div>\n<div>\u00a0<\/div>\n<div>\n<div><a class='resized_img' rel='lightbox[1839722]' id='ipb-attach-url-27153-0-72981700-1449547706' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_03_2014\/post-238129-0-26838500-1395428890.jpg\" title=\"_A5A0869 copia.JPG - Size: 432.45KB\"><span rel='lightbox'><img class='bbc_img' itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_03_2014\/post-238129-0-26838500-1395428890_thumb.jpg\" id='ipb-attach-img-27153-0-72981700-1449547706' style='width:300;height:200' class='attach' width=\"300\" height=\"200\" alt=\"_A5A0869 copia.JPG\" \/><\/span><\/a>\n<\/div>\n<p>\u00a0<\/p>\n<\/div>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>but if that's not enough, I invite you to visit our website<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"octavio@momocode.com","IpAddress":"189.221.96.179","GroupId":44,"GroupName":"Vendor","JoinDate":1300997247,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-238129.png?_r=1394907225","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"omontes","Id":238129,"Name":"omontes","IsOnline":false}}],"Id":"75976","Title":"Questions For Past Moon Palace Brides","LastPostDate":1450061431},"Pages":{"TotalItems":19,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
