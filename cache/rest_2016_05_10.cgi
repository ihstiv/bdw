Request Time: 1 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":11,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":1247,"MovedTo":null,"MovedOn":0,"FirstPostId":1908728,"Rating":0,"RatingHits":0,"Starter":{"Id":285337,"Name":"bridecdb","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1451313794,"LastPoster":{"Id":280844,"Name":"syr87","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":38,"Preview":{"Id":1913331,"PostDate":1462406022,"PostContent":"@bridecdb as far as tips, just keep every single email and anything that was promised in a folder...","Author":{"Signature":"","Email":"ramiresy@elac.edu","IpAddress":"198.188.146.185","GroupId":39,"GroupName":"Newbie","JoinDate":1414168977,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"syr87","Id":280844,"Name":"syr87","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.62.73.244","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79818,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"48194c3f476d520c7d8b0e8ac6e81893","RawContent":"&lt;p&gt;@[member=\"bridecdb\"] as far as tips, just keep every single email and anything that was promised in a folder just in case. definitely ask questions and not sure if you are hiring an outside coordinator or a day of but I got everything completely different than what&amp;nbsp;the packages F.A offers, everything from chairs, table covers, centerpieces, everything, I went with another company because I wanted a certain look, however, if you go that route, try to use some of the stuff the packages offer. for example, I loved my bouquet and we incorporated my bridesmaids bouquets in the centerpieces so I asked to still get the bouquet their package comes with so I can throw that one when we did the bouquet toss. I used their non floral centerpieces for the cocktail hour so I wouldn&#039;t spend more money, things like that. for our food, we had a shrimp and&amp;nbsp;pineapple salad, delicious, and for our main course we had a steak in red wine and tamarind sauce, everyoneeee raved about how good it was! all their food is pretty good so I wouldn&#039;t worry too much there. if you are planning to have people get ready in your room, definitely upgrade to a suite, we had one and it still seemed crowded. don&#039;t forget august is hot so the room will get hot with so many people in there. also, not sure if you are getting there a few days before the wedding but we got there two days before and I didn&#039;t feel like I had enough time to do my hair and makeup trial and approve everything, i was out doing all that so I missed out on time with my guests. let me know if you have any other questions.&lt;\/p&gt;","Attachments":[],"Id":1913331,"PostDate":1462406022,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"285337\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/285337-bridecdb\/' title='Member profile'><span itemprop=\"name\">bridecdb<\/span><\/a> as far as tips, just keep every single email and anything that was promised in a folder just in case. definitely ask questions and not sure if you are hiring an outside coordinator or a day of but I got everything completely different than what\u00a0the packages F.A offers, everything from chairs, table covers, centerpieces, everything, I went with another company because I wanted a certain look, however, if you go that route, try to use some of the stuff the packages offer. for example, I loved my bouquet and we incorporated my bridesmaids bouquets in the centerpieces so I asked to still get the bouquet their package comes with so I can throw that one when we did the bouquet toss. I used their non floral centerpieces for the cocktail hour so I wouldn't spend more money, things like that. for our food, we had a shrimp and\u00a0pineapple salad, delicious, and for our main course we had a steak in red wine and tamarind sauce, everyoneeee raved about how good it was! all their food is pretty good so I wouldn't worry too much there. if you are planning to have people get ready in your room, definitely upgrade to a suite, we had one and it still seemed crowded. don't forget august is hot so the room will get hot with so many people in there. also, not sure if you are getting there a few days before the wedding but we got there two days before and I didn't feel like I had enough time to do my hair and makeup trial and approve everything, i was out doing all that so I missed out on time with my guests. let me know if you have any other questions.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ramiresy@elac.edu","IpAddress":"198.188.146.185","GroupId":39,"GroupName":"Newbie","JoinDate":1414168977,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"syr87","Id":280844,"Name":"syr87","IsOnline":false}}],"Id":"79818","Title":"Fiesta Grand Americana Cabo Brides 2016","LastPostDate":1462406022},"Pages":{"TotalItems":11,"TotalPages":2,"CurrentPage":10,"NextPage":-1,"PreviousPage":0,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
