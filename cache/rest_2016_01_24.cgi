{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":10,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":1326,"MovedTo":null,"MovedOn":0,"FirstPostId":1643700,"Rating":0,"RatingHits":0,"Starter":{"Id":248883,"Name":"wedding92012","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-248883.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"StartDate":1342822554,"LastPoster":{"Id":267159,"Name":"SCchickie","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-267159.jpg?_r=1404881843","PhotoWidth":200,"PhotoHeight":146,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":118,"Preview":{"Id":1837799,"PostDate":1394648391,"PostContent":"Hi Wedding 92012! \u00a0 My wedding at Dreams is coming up on May 31, 2014. I too have the Ultimate Dr...","Author":{"Signature":"","Email":"marisol.salguero@gmail.com","IpAddress":"161.149.63.168","GroupId":39,"GroupName":"Newbie","JoinDate":1362945137,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-267159.jpg?_r=1404881843","PhotoWidth":200,"PhotoHeight":146,"PhotoType":"custom"},"FormattedName":"SCchickie","Id":267159,"Name":"SCchickie","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":68577,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b738a14592d4d2fa35b48a2a76c07b92","RawContent":"&lt;p&gt; Hey fellow Dreams Brides!&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; It&#039;s time for me to make some food choices for our wedding in September. I have read some of the reviews from former Dreams Brides (thank goodness for you gals!), but I was curious if anyone had additional feedback on reception dinner choices, including the capapes.We have the silver menu within our package.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Also, choosing a pre-selected menu for our rehearsal dinner at the Portofino Restaurant. Any recommendations?&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Thank you in advance for your help!&lt;\/p&gt;","Attachments":[],"Id":1643700,"PostDate":1342822554,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hey fellow Dreams Brides!<\/p> <p> \u00a0<\/p> <p> It's time for me to make some food choices for our wedding in September. I have read some of the reviews from former Dreams Brides (thank goodness for you gals!), but I was curious if anyone had additional feedback on reception dinner choices, including the capapes.We have the silver menu within our package.<\/p> <p> \u00a0<\/p> <p> Also, choosing a pre-selected menu for our rehearsal dinner at the Portofino Restaurant. Any recommendations?<\/p> <p> \u00a0<\/p> <p> Thank you in advance for your help!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"BukkyLanskiWedding@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1324708381,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-248883.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"wedding92012","Id":248883,"Name":"wedding92012","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":68577,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"83bff70f03b05c4a836807b19d213c5e","RawContent":"&lt;p&gt; In case anyone else is making menu choices, here are the suggestions from Magda when I asked...&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-family:Symbol;color:#1f497d\"&gt;&lt;span&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;\t\t &lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;strong&gt;&lt;u&gt;&lt;span style=\"color:#1f497d\"&gt;Sacmpi alla fiorentina&lt;\/span&gt;&lt;\/u&gt;&lt;\/strong&gt;&lt;\/p&gt; &lt;p style=\"margin-bottom:12.0pt\"&gt; &lt;span style=\"font-family:Symbol;color:#1f497d\"&gt;&lt;span&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;\t\t &lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;strong&gt;&lt;u&gt;&lt;span style=\"color:#1f497d\"&gt;Minestrone&lt;\/span&gt;&lt;\/u&gt;&lt;\/strong&gt;&lt;\/p&gt; &lt;p style=\"margin-bottom:12.0pt\"&gt; &lt;span style=\"font-family:Symbol;color:#1f497d\"&gt;&lt;span&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;\t\t &lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;strong&gt;&lt;u&gt;&lt;span style=\"color:#1f497d\"&gt;Filetto di manzo&lt;\/span&gt;&lt;\/u&gt;&lt;\/strong&gt;&lt;\/p&gt; &lt;p style=\"margin-bottom:12.0pt\"&gt; &lt;span style=\"font-family:Symbol;color:#1f497d\"&gt;&lt;span&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;\t\t &lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;strong&gt;&lt;u&gt;&lt;span style=\"color:#1f497d\"&gt;Cannoli siciliani &lt;\/span&gt;&lt;\/u&gt;&lt;\/strong&gt;&lt;\/p&gt; &lt;p style=\"margin-bottom:12.0pt\"&gt; &lt;span style=\"font-family:Symbol;color:#1f497d\"&gt;&lt;span&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;\t\t &lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;strong&gt;&lt;u&gt;&lt;span style=\"color:#1f497d\"&gt;Jumbo shrimp breaded&lt;\/span&gt;&lt;\/u&gt;&lt;\/strong&gt;&lt;\/p&gt; &lt;p style=\"margin-bottom:12.0pt\"&gt; &lt;span style=\"font-family:Symbol;color:#1f497d\"&gt;&lt;span&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;\t\t &lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;strong&gt;&lt;u&gt;&lt;span style=\"color:#1f497d\"&gt;Caesar salad&lt;\/span&gt;&lt;\/u&gt;&lt;\/strong&gt;&lt;\/p&gt; &lt;p style=\"margin-bottom:12.0pt\"&gt; &lt;span lang=\"EN-US\" style=\"font-family:Symbol;color:#1f497d\"&gt;&lt;span&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;\t\t &lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;strong&gt;&lt;u&gt;&lt;span lang=\"EN-US\" style=\"color:#1f497d\"&gt;Chicken breast filled with cheese and \u00e2\u20ac\u0153tiger\u00e2\u20ac\u009d shrimp served with a red bell pepper sauce&lt;\/span&gt;&lt;\/u&gt;&lt;\/strong&gt;&lt;\/p&gt; &lt;p style=\"margin-bottom:12.0pt\"&gt; &lt;span lang=\"EN-US\" style=\"font-family:Symbol;color:#1f497d\"&gt;&lt;span&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;\t\t &lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;strong&gt;&lt;u&gt;&lt;span lang=\"EN-US\" style=\"color:#1f497d\"&gt;Beef fillet filled with mozzarella cheese, fresh tomato and fresh basil&lt;\/span&gt;&lt;\/u&gt;&lt;\/strong&gt;&lt;\/p&gt; &lt;p&gt; &lt;span lang=\"EN-US\" style=\"font-family:Symbol;color:#1f497d\"&gt;&lt;span&gt;\u00b7&lt;span style=\"font:7.0pt &amp;quot;Times New Roman&amp;quot;\"&gt;\t\t &lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;strong&gt;&lt;u&gt;&lt;span lang=\"EN-US\" style=\"color:#1f497d\"&gt;Brownie with ice cream&lt;\/span&gt;&lt;\/u&gt;&lt;\/strong&gt;&lt;\/p&gt;","Attachments":[],"Id":1648625,"PostDate":1343948261,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> In case anyone else is making menu choices, here are the suggestions from Magda when I asked...<\/p> <p> \u00a0<\/p> <p> <span  style=\"font-family:Symbol;color:#1f497d\"><span>\u00b7<span>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 <\/span><\/span><\/span><strong><u><span  style=\"color:#1f497d\">Sacmpi alla fiorentina<\/span><\/u><\/strong><\/p> <p> <span  style=\"font-family:Symbol;color:#1f497d\"><span>\u00b7<span>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 <\/span><\/span><\/span><strong><u><span  style=\"color:#1f497d\">Minestrone<\/span><\/u><\/strong><\/p> <p> <span  style=\"font-family:Symbol;color:#1f497d\"><span>\u00b7<span>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 <\/span><\/span><\/span><strong><u><span  style=\"color:#1f497d\">Filetto di manzo<\/span><\/u><\/strong><\/p> <p> <span  style=\"font-family:Symbol;color:#1f497d\"><span>\u00b7<span>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 <\/span><\/span><\/span><strong><u><span  style=\"color:#1f497d\">Cannoli siciliani <\/span><\/u><\/strong><\/p> <p> <span  style=\"font-family:Symbol;color:#1f497d\"><span>\u00b7<span>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 <\/span><\/span><\/span><strong><u><span  style=\"color:#1f497d\">Jumbo shrimp breaded<\/span><\/u><\/strong><\/p> <p> <span  style=\"font-family:Symbol;color:#1f497d\"><span>\u00b7<span>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 <\/span><\/span><\/span><strong><u><span  style=\"color:#1f497d\">Caesar salad<\/span><\/u><\/strong><\/p> <p> <span lang=\"EN-US\"  style=\"font-family:Symbol;color:#1f497d\"><span>\u00b7<span>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 <\/span><\/span><\/span><strong><u><span lang=\"EN-US\"  style=\"color:#1f497d\">Chicken breast filled with cheese and \u00e2\u20ac\u0153tiger\u00e2\u20ac\u009d shrimp served with a red bell pepper sauce<\/span><\/u><\/strong><\/p> <p> <span lang=\"EN-US\"  style=\"font-family:Symbol;color:#1f497d\"><span>\u00b7<span>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 <\/span><\/span><\/span><strong><u><span lang=\"EN-US\"  style=\"color:#1f497d\">Beef fillet filled with mozzarella cheese, fresh tomato and fresh basil<\/span><\/u><\/strong><\/p> <p> <span lang=\"EN-US\"  style=\"font-family:Symbol;color:#1f497d\"><span>\u00b7<span>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 <\/span><\/span><\/span><strong><u><span lang=\"EN-US\"  style=\"color:#1f497d\">Brownie with ice cream<\/span><\/u><\/strong><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"BukkyLanskiWedding@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1324708381,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-248883.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"wedding92012","Id":248883,"Name":"wedding92012","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":68577,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a556b2d66f80d2af4361a2b7d404a3cd","RawContent":"&lt;p&gt; Is this for your rehearsal dinner or wedding reception?&lt;\/p&gt;","Attachments":[],"Id":1648682,"PostDate":1343960091,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Is this for your rehearsal dinner or wedding reception?<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mbecker@bclc.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1319736074,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-247145.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"McLecker","Id":247145,"Name":"McLecker","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":68577,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"064c8f9fd689f7adb646f56cf27569b7","RawContent":"&lt;p&gt; I was looking for feedback on the wedding reception menu and Magda shared suggestions from Portofino for our rehearsal dinner and the wedding reception menu.\n &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1648716,"PostDate":1343967394,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I was looking for feedback on the wedding reception menu and Magda shared suggestions from Portofino for our rehearsal dinner and the wedding reception menu.<br \/> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"BukkyLanskiWedding@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1324708381,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-248883.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"wedding92012","Id":248883,"Name":"wedding92012","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":68577,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ed355c2acf14c01c290349b12aeb17b3","RawContent":"&lt;p&gt; Ah gotcha. Helpful, thanks for posting!&lt;\/p&gt;","Attachments":[],"Id":1648720,"PostDate":1343969514,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Ah gotcha. Helpful, thanks for posting!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mbecker@bclc.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1319736074,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-247145.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"McLecker","Id":247145,"Name":"McLecker","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":68577,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3cd1b05ae5778e722f6c5ff7bfbb5d07","RawContent":"&lt;p&gt; For the reception everyone LOVED the food and some even asked for seconds of some of the items.&amp;nbsp; We had the cream corn soup, puff pastry filled with shrimp and either the chicken breast stuffed with tiger shrimp or the beef tenderloin.&amp;nbsp; It was all amazing.&lt;\/p&gt;","Attachments":[],"Id":1658637,"PostDate":1346377955,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> For the reception everyone LOVED the food and some even asked for seconds of some of the items.\u00a0 We had the cream corn soup, puff pastry filled with shrimp and either the chicken breast stuffed with tiger shrimp or the beef tenderloin.\u00a0 It was all amazing.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"anichols8@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1307045229,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-240704.JPG?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"anichols8","Id":240704,"Name":"anichols8","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":68577,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d17523aa581559ce768fed5c6a060c49","RawContent":"[quote]\nOriginally Posted by [b]wedding92012[\/b] \/img\/forum\/go_quote.gif\n \n \n Hey fellow Dreams Brides! \n \n It&#039;s time for me to make some food choices for our wedding in September. I have read some of the reviews from former Dreams Brides (thank goodness for you gals!), but I was curious if anyone had additional feedback on reception dinner choices, including the capapes.We have the silver menu within our package. \n \n Also, choosing a pre-selected menu for our rehearsal dinner at the Portofino Restaurant. Any recommendations? \n \n Thank you in advance for your help![\/quote] \n Hey Wedding 92012. What did you end up deciding on for your menu? Hope your planning is going well!","Attachments":[],"Id":1658779,"PostDate":1346430412,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>wedding92012<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <p> Hey fellow Dreams Brides!<\/p> <p> \u00a0<\/p> <p> It's time for me to make some food choices for our wedding in September. I have read some of the reviews from former Dreams Brides (thank goodness for you gals!), but I was curious if anyone had additional feedback on reception dinner choices, including the capapes.We have the silver menu within our package.<\/p> <p> \u00a0<\/p> <p> Also, choosing a pre-selected menu for our rehearsal dinner at the Portofino Restaurant. Any recommendations?<\/p> <p> \u00a0<\/p> <p> Thank you in advance for your help!<\/p> <\/blockquote> <p> Hey Wedding 92012. What did you end up deciding on for your menu? Hope your planning is going well!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mbecker@bclc.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1319736074,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-247145.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"McLecker","Id":247145,"Name":"McLecker","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":68577,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5cf02be7ad87b0c90b7cd8649bc63988","RawContent":"&lt;p&gt; &lt;span style=\"font-size:12px;\"&gt;For the rehearsal dinner, we have chosen...&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size:12px;\"&gt;&lt;span style=\"font-family: copperplate gothic light,sans-serif;\"&gt;&lt;strong&gt;First course:&lt;\/strong&gt; &lt;\/span&gt;&lt;span style=\"color: black;\"&gt;&lt;span style=\"font-family: corbel,sans-serif;\"&gt;PAVAROTTI: Pesto shrimps, prosciutto with grissini, goat cheese, pear, kalamata olives, in Parmesan cheese crust accompanied with baby spinach salad and red berries vinaigrette&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size:12px;\"&gt;&lt;strong&gt;Second Course:&lt;\/strong&gt; &lt;span style=\"color: black;\"&gt;&lt;span style=\"font-family: corbel,sans-serif;\"&gt;MINESTRONE&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size:12px;\"&gt;&lt;span style=\"font-family: copperplate gothic light,sans-serif;\"&gt;&lt;strong&gt;Main Course:&lt;\/strong&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size:12px;\"&gt;&lt;span style=\"color: black;\"&gt;&lt;span style=\"font-family: corbel,sans-serif;\"&gt;ENVOLTINI: Beef tenderloin stuffed with asparagus, provolone cheese and prosciutto ham served with a balsamic sauce&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size:12px;\"&gt;&lt;span style=\"font-family: copperplate gothic light,sans-serif;\"&gt;&lt;strong&gt;Dessert:&lt;\/strong&gt;&lt;\/span&gt; &lt;span style=\"color: black;\"&gt;&lt;span style=\"font-family: corbel,sans-serif;\"&gt;Cannoli Sicilian: Cannoli Stuffed with Mascarpone, Pistachio Cream &amp;amp; Chocolate&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; For our wedding reception we have chosen...&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size:12px;\"&gt;&lt;span style=\"font-family: copperplate gothic light,sans-serif;\"&gt;&lt;strong&gt;First course:&lt;\/strong&gt; Puff pastry filled with shrimp in a saffron and basil sauce&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;strong&gt;Second Course: &lt;\/strong&gt;&lt;span style=\"font-size:12px;\"&gt;&lt;span style=\"font-family: copperplate gothic light,sans-serif;\"&gt;Caprese Salad with fresh mozzarella, basil, balsamic vinegar, and extra virgin olive oil&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size:12px;\"&gt;&lt;span style=\"font-family: copperplate gothic light,sans-serif;\"&gt;&lt;strong&gt;Main Course: &lt;\/strong&gt;Beef fillet filled with mozzarella cheese, fresh tomato, and basil&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-size:12px;\"&gt;&lt;span style=\"font-family: copperplate gothic light,sans-serif;\"&gt;&lt;strong&gt;Dessert: &lt;\/strong&gt;Wedding Cake&lt;\/span&gt;&lt;\/span&gt; (vanilla cake with chocolate filling) &amp;amp; &lt;span style=\"font-size:12px;\"&gt;&lt;span style=\"font-family: copperplate gothic light,sans-serif;\"&gt;Tiramisu &lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I will let you know how the food is! I am hoping my mom remembers to take pictures for my wedding review as well!&lt;\/p&gt;","Attachments":[],"Id":1662698,"PostDate":1347514588,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <span  style=\"font-size:12px\">For the rehearsal dinner, we have chosen...<\/span><\/p> <p> <span  style=\"font-size:12px\"><span  style=\"font-family: copperplate gothic light,sans-serif\"><strong>First course:<\/strong> <\/span><span  style=\"color: black\"><span  style=\"font-family: corbel,sans-serif\">PAVAROTTI: Pesto shrimps, prosciutto with grissini, goat cheese, pear, kalamata olives, in Parmesan cheese crust accompanied with baby spinach salad and red berries vinaigrette<\/span><\/span><\/span><\/p> <p> <span  style=\"font-size:12px\"><strong>Second Course:<\/strong> <span  style=\"color: black\"><span  style=\"font-family: corbel,sans-serif\">MINESTRONE<\/span><\/span><\/span><\/p> <p> <span  style=\"font-size:12px\"><span  style=\"font-family: copperplate gothic light,sans-serif\"><strong>Main Course:<\/strong><\/span><\/span><\/p> <p> <span  style=\"font-size:12px\"><span  style=\"color: black\"><span  style=\"font-family: corbel,sans-serif\">ENVOLTINI: Beef tenderloin stuffed with asparagus, provolone cheese and prosciutto ham served with a balsamic sauce<\/span><\/span><\/span><\/p> <p> <span  style=\"font-size:12px\"><span  style=\"font-family: copperplate gothic light,sans-serif\"><strong>Dessert:<\/strong><\/span> <span  style=\"color: black\"><span  style=\"font-family: corbel,sans-serif\">Cannoli Sicilian: Cannoli Stuffed with Mascarpone, Pistachio Cream & Chocolate<\/span><\/span><\/span><\/p> <p> \u00a0<\/p> <p> For our wedding reception we have chosen...<\/p> <p> <span  style=\"font-size:12px\"><span  style=\"font-family: copperplate gothic light,sans-serif\"><strong>First course:<\/strong> Puff pastry filled with shrimp in a saffron and basil sauce<\/span><\/span><\/p> <p> <strong>Second Course: <\/strong><span  style=\"font-size:12px\"><span  style=\"font-family: copperplate gothic light,sans-serif\">Caprese Salad with fresh mozzarella, basil, balsamic vinegar, and extra virgin olive oil<\/span><\/span><\/p> <p> <span  style=\"font-size:12px\"><span  style=\"font-family: copperplate gothic light,sans-serif\"><strong>Main Course: <\/strong>Beef fillet filled with mozzarella cheese, fresh tomato, and basil<\/span><\/span><\/p> <p> <span  style=\"font-size:12px\"><span  style=\"font-family: copperplate gothic light,sans-serif\"><strong>Dessert: <\/strong>Wedding Cake<\/span><\/span> (vanilla cake with chocolate filling) & <span  style=\"font-size:12px\"><span  style=\"font-family: copperplate gothic light,sans-serif\">Tiramisu <\/span><\/span><\/p> <p> \u00a0<\/p> <p> I will let you know how the food is! I am hoping my mom remembers to take pictures for my wedding review as well!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"BukkyLanskiWedding@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1324708381,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-248883.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"wedding92012","Id":248883,"Name":"wedding92012","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":68577,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"26f85fed1a588ccc7cfff36e135975a7","RawContent":"&lt;p&gt; Forgot to mention, these are the appetizers we chose for the wedding cocktail hour...&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-family:corbel,sans-serif;\"&gt;&lt;span style=\"font-size:12.0pt;\"&gt;Choux with chicken salad\n Tostadas of beef salpicon\n Grissini with prosciutto ham&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-family:corbel,sans-serif;\"&gt;&lt;span style=\"font-size:12.0pt;\"&gt;Chile popper\n Mini vol au vent with sea food\n Beef brochette with blue cheese sauce&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1662699,"PostDate":1347514660,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Forgot to mention, these are the appetizers we chose for the wedding cocktail hour...<\/p> <p> <span  style=\"font-family:corbel,sans-serif\"><span  style=\"font-size:12.0pt\">Choux with chicken salad<br \/> Tostadas of beef salpicon<br \/> Grissini with prosciutto ham<\/span><\/span><\/p> <p> <span  style=\"font-family:corbel,sans-serif\"><span  style=\"font-size:12.0pt\">Chile popper<br \/> Mini vol au vent with sea food<br \/> Beef brochette with blue cheese sauce<\/span><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"BukkyLanskiWedding@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1324708381,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-248883.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"wedding92012","Id":248883,"Name":"wedding92012","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"161.149.102.169","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":68577,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b5ac279a320c31dfe844b840120b0135","RawContent":"&lt;p&gt;Hi Wedding 92012!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;My wedding at Dreams is coming up on May 31, 2014. I too have the Ultimate Dreams wedding menu and I was wondering what you liked from your selection and what you didn&#039;t like. I&#039;m having a hard time with the choices.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thanks!&lt;\/p&gt;","Attachments":[],"Id":1837799,"PostDate":1394648391,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Wedding 92012!<\/p>\n<p>\u00a0<\/p>\n<p>My wedding at Dreams is coming up on May 31, 2014. I too have the Ultimate Dreams wedding menu and I was wondering what you liked from your selection and what you didn't like. I'm having a hard time with the choices.<\/p>\n<p>\u00a0<\/p>\n<p>Thanks!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"marisol.salguero@gmail.com","IpAddress":"161.149.63.168","GroupId":39,"GroupName":"Newbie","JoinDate":1362945137,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-267159.jpg?_r=1404881843","PhotoWidth":200,"PhotoHeight":146,"PhotoType":"custom"},"FormattedName":"SCchickie","Id":267159,"Name":"SCchickie","IsOnline":false}}],"Id":"68577","Title":"Dreams Reception Food Feedback","LastPostDate":1394648391},"Pages":{"TotalItems":10,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
