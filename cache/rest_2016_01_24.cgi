{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":13,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":4416,"MovedTo":null,"MovedOn":0,"FirstPostId":1627142,"Rating":0,"RatingHits":0,"Starter":{"Id":240704,"Name":"anichols8","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-240704.JPG?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"StartDate":1338693852,"LastPoster":{"Id":257115,"Name":"Melissa14","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-257115.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":118,"Preview":{"Id":1742534,"PostDate":1365189119,"PostContent":"Thanks for the review.","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><p><em><span style=\"font-size:12px;\"><span>Marrying My 5th Grade \"Boyfriend\"...Life has a funny way of working itself out <span><\/span><\/span><\/span><\/em><\/p><span><\/span><\/div><\/div>","Email":"trina2103@yahoo.com","IpAddress":"98.154.15.214","GroupId":40,"GroupName":"Jr. Member","JoinDate":1340649030,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-257115.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Melissa14","Id":257115,"Name":"Melissa14","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":67887,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cf11252b9fa8f7e443738e938438c5ca","RawContent":"[quote]\nOriginally Posted by [b]wedding92012[\/b] \/img\/forum\/go_quote.gif\n \n \n McLecker: My bridesmaids, my mom, and MIL are getting their hair done at the Dreams Salon for our 9-22-2012 wedding. I will be sure to include a review of the salon. I am having Neysa Berman do my hair and make up, as well as make up for my mom and MIL.[\/quote] \n  Oooh that would be awesome. I&#039;m considering Neysa again too .If you could let me know what you think of both - that would be awesome!! And congrats on getting married yesterday!!! :)","Attachments":[],"Id":1666051,"PostDate":1348458257,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>wedding92012<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <p> McLecker: My bridesmaids, my mom, and MIL are getting their hair done at the Dreams Salon for our 9-22-2012 wedding. I will be sure to include a review of the salon. I am having Neysa Berman do my hair and make up, as well as make up for my mom and MIL.<\/p> <\/blockquote> <p> \u00a0Oooh that would be awesome. I'm considering Neysa again too .If you could let me know what you think\u00a0of both - that would be awesome!! And\u00a0congrats on getting married yesterday!!! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mbecker@bclc.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1319736074,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-247145.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"McLecker","Id":247145,"Name":"McLecker","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":67887,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5f7232837f43d4512b1b28f75b023175","RawContent":"McLecker: wanted to send a quick reply prior to my full review to share that Neysa is worth every dollar. Also, its pronounced Nee-sa. Not only is she professional and friendly, but her work is incredible. My make up and hair looked amazing after 10:30pm, especially after the heat and humidity. I touched my make up only once. I couldn&#039;t imagine getting married without her taking care of my hair and make up. The Dreams Salon did a great job on my bridesmaids hair. They chose a simple side bun and it came out great. I did love that they added a flower to complete the look. They were pretty quick and easy to work with. Most of the stylists don&#039;t speak English so have pictures or use their picture book to communicate your look. My mom and MIL&#039;s hair looked great as well. From my experience, the Dreams Salon is great for simple updo&#039;s for bridal party and guests. As a Bride, I wanted to feel confident in my hair and makeup. I do believe professional hair and make up photographs much better. Neysa made that happen and I couldn&#039;t be happier. So my advice: hire Neysa. You won&#039;t regret feeling amazing on your special day!","Attachments":[],"Id":1666754,"PostDate":1348598195,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                McLecker: wanted to send a quick reply prior to my full review to share that Neysa is worth every dollar. Also, its pronounced Nee-sa. Not only is she professional and friendly, but her work is incredible. My make up and hair looked amazing after 10:30pm, especially after the heat and humidity. I touched my make up only once. I couldn't imagine getting married without her taking care of my hair and make up. The Dreams Salon did a great job on my bridesmaids hair. They chose a simple side bun and it came out great. I did love that they added a flower to complete the look. They were pretty quick and easy to work with. Most of the stylists don't speak English so have pictures or use their picture book to communicate your look. My mom and MIL's hair looked great as well. From my experience, the Dreams Salon is great for simple updo's for bridal party and guests. As a Bride, I wanted to feel confident in my hair and makeup. I do believe professional hair and make up photographs much better. Neysa made that happen and I couldn't be happier. So my advice: hire Neysa. You won't regret feeling amazing on your special day!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"BukkyLanskiWedding@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1324708381,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-248883.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"wedding92012","Id":248883,"Name":"wedding92012","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":67887,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fc29993cde2578154c7713dd4b379983","RawContent":"&lt;p&gt; Thanks for the review.&lt;\/p&gt;","Attachments":[],"Id":1742534,"PostDate":1365189119,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Thanks for the review.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><p><em><span style=\"font-size:12px;\"><span>Marrying My 5th Grade \"Boyfriend\"...Life has a funny way of working itself out <span><\/span><\/span><\/span><\/em><\/p><span><\/span><\/div><\/div>","Email":"trina2103@yahoo.com","IpAddress":"98.154.15.214","GroupId":40,"GroupName":"Jr. Member","JoinDate":1340649030,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-257115.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Melissa14","Id":257115,"Name":"Melissa14","IsOnline":false}}],"Id":"67887","Title":"MAY 25, 2012 DREAMS LOS CABOS WEDDING REVIEW...KIND OF LENGTHY WITH PICS","LastPostDate":1365189119},"Pages":{"TotalItems":13,"TotalPages":2,"CurrentPage":10,"NextPage":-1,"PreviousPage":0,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
