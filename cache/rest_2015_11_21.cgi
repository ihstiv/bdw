nline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"67.175.107.83","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":74896,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f275d5a07d38d567aa1e5c832465baf8","RawContent":"&lt;p&gt;Thanks for sharing.&lt;\/p&gt;","Attachments":[],"Id":1831016,"PostDate":1391285199,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thanks for sharing.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"a.baio330@gmail.com","IpAddress":"38.104.228.158","GroupId":40,"GroupName":"Jr. Member","JoinDate":1369663457,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-269996.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"amy330","Id":269996,"Name":"amy330","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"64.42.197.65","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":74896,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2bdb0d6b6c68e7db97db244b3e35cfc7","RawContent":"&lt;p&gt;Thank you for sharing!&lt;\/p&gt;\n&lt;p&gt;PS you did my cousin in law&#039;s wedding this past January - The Kozey\/Madsen wedding ;)&lt;\/p&gt;","Attachments":[],"Id":1836552,"PostDate":1393944063,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thank you for sharing!<\/p>\n<p>PS you did my cousin in law's wedding this past January - The Kozey\/Madsen wedding <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lcboyko@ualberta.ca","IpAddress":"23.17.180.191","GroupId":47,"GroupName":"Site Supporter","JoinDate":1304972291,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-239790.jpg?_r=1434572414","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Mrsktobe","Id":239790,"Name":"Mrsktobe","IsOnline":false}}],"Pages":{"TotalItems":30,"TotalPages":3,"CurrentPage":10,"NextPage":20,"PreviousPage":0,"LastPage":20},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
