Request Time: 1 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":10,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":1403,"MovedTo":null,"MovedOn":0,"FirstPostId":1845239,"Rating":0,"RatingHits":0,"Starter":{"Id":277627,"Name":"amyn","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1397954209,"LastPoster":{"Id":282808,"Name":"mia256","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":3,"Preview":{"Id":1845239,"PostDate":1397954209,"PostContent":"Hi Ladies! \u00a0I have been engaged now for a year and we finally have decided on a destination weddi...","Author":{"Signature":"","Email":"attn99.an@gmail.com","IpAddress":"174.7.110.160","GroupId":39,"GroupName":"Newbie","JoinDate":1397708810,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"amyn","Id":277627,"Name":"amyn","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.7.110.160","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76891,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b585c06d996f904d188282ccc999efd2","RawContent":"&lt;p&gt;Hi Ladies! &amp;nbsp;I have been engaged now for a year and we finally have decided on a destination wedding in mexico! I&#039;ve read many great reviews on the dazzling details ladies and are thinking about using them for our wedding. &amp;nbsp;Wondering if any newbie brides to be out there thinking about doing the same? And any one out there used them before? do they help with the STD&#039;s and Invitations? or things like that you would need to do on your own? &amp;nbsp;thanks, ladies!!&lt;\/p&gt;","Attachments":[],"Id":1845239,"PostDate":1397954209,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Ladies! \u00a0I have been engaged now for a year and we finally have decided on a destination wedding in mexico! I've read many great reviews on the dazzling details ladies and are thinking about using them for our wedding. \u00a0Wondering if any newbie brides to be out there thinking about doing the same? And any one out there used them before? do they help with the STD's and Invitations? or things like that you would need to do on your own? \u00a0thanks, ladies!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"attn99.an@gmail.com","IpAddress":"174.7.110.160","GroupId":39,"GroupName":"Newbie","JoinDate":1397708810,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"amyn","Id":277627,"Name":"amyn","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"177.237.115.25","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76891,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d0e173084c9461e2c3199f81ab21702c","RawContent":"[quote name=\"amyn\" post=\"1845239\" timestamp=\"1397954209\"]\nHi Ladies!  I have been engaged now for a year and we finally have decided on a destination wedding in mexico! I&#039;ve read many great reviews on the dazzling details ladies and are thinking about using them for our wedding.  Wondering if any newbie brides to be out there thinking about doing the same? And any one out there used them before? do they help with the STD&#039;s and Invitations? or things like that you would need to do on your own?  thanks, ladies!![\/quote]Congrats and welcome to the forum!","Attachments":[],"Id":1845352,"PostDate":1398092437,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>amyn, on 19 April 2014 - 04:36 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hi Ladies! \u00a0I have been engaged now for a year and we finally have decided on a destination wedding in mexico! I've read many great reviews on the dazzling details ladies and are thinking about using them for our wedding. \u00a0Wondering if any newbie brides to be out there thinking about doing the same? And any one out there used them before? do they help with the STD's and Invitations? or things like that you would need to do on your own? \u00a0thanks, ladies!!<\/p>\n<\/div>\n<\/div><\/div>\n<p>Congrats and welcome to the forum!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Dream Weddings Riviera Maya- We pay attention to your wishes and coordinate closely with you to ensure your wedding or event is planned to perfection!<\/p>\n<p>\u00a0<\/p>\n<p><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Dream Weddings Riviera Maya<\/span><\/span><\/span><br><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">weddingsinplayadelcarmen@gmail.com<\/span><\/span><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html'>http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html<\/a><\/p>\n<p>\u00a0<\/p>\n<p><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Happy Planning!<\/span><\/span><\/span><br><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Joyce<\/span><\/span><\/span><br>\n\u00a0","Email":"weddingsinplayadelcarmen@gmail.com","IpAddress":"187.252.44.28","GroupId":49,"GroupName":"Insiders","JoinDate":1326854387,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250090.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"dreamweddings","Id":250090,"Name":"dreamweddings","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"189.205.182.223","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76891,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4ba3bfd21a57e4d88e5c10505e62d9a7","RawContent":"&lt;p&gt;The only thing I kind of figured out is the photographer, I&#039;m still deciding between booking www.photoshootsVallarta.com or www.EstefaniaFloresPhotography.com . I saw a couple other ones, like Tom Moks, but not sure he does what I&#039;m looking for. Overall, I&#039;m a mess!&lt;\/p&gt;","Attachments":[],"Id":1857237,"PostDate":1403930504,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>The only thing I kind of figured out is the photographer, I'm still deciding between booking www.photoshootsVallarta.com or www.EstefaniaFloresPhotography.com . I saw a couple other ones, like Tom Moks, but not sure he does what I'm looking for. Overall, I'm a mess!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"wcdspa@gmail.com","IpAddress":"189.205.182.223","GroupId":39,"GroupName":"Newbie","JoinDate":1403929185,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278725.jpg?_r=1404024792","PhotoWidth":200,"PhotoHeight":223,"PhotoType":"custom"},"FormattedName":"Kayla2015","Id":278725,"Name":"Kayla2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"64.201.208.7","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76891,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0728f7f570af35b0741987da94571d37","RawContent":"&lt;p&gt;Are you doing a resort wedding, or an off-site wedding? I&#039;m planning a resort wedding in Maya Riviera for Nov 2015 and planning to just use the resort planner on that end and a travel agent on this end, but I&#039;m pretty easygoing and not going to worry about a lot of things like choosing a specific colour scheme or choosing specific flower arrangements or anything, so I may not be the person to ask!&lt;\/p&gt;","Attachments":[],"Id":1859271,"PostDate":1405272664,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Are you doing a resort wedding, or an off-site wedding? I'm planning a resort wedding in Maya Riviera for Nov 2015 and planning to just use the resort planner on that end and a travel agent on this end, but I'm pretty easygoing and not going to worry about a lot of things like choosing a specific colour scheme or choosing specific flower arrangements or anything, so I may not be the person to ask!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"magscharron@gmail.com","IpAddress":"64.141.11.150","GroupId":40,"GroupName":"Jr. Member","JoinDate":1393267130,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Maggietron","Id":276860,"Name":"Maggietron","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"118.168.6.38","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76891,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fc4ccfbd842ef0c2e608e7adc33577b2","RawContent":"&lt;p&gt;I used DD for my wedding this past May. We designed our own Invitations and Save the Dates, but Dazzling Details made our table cards, escort cards, etc for the wedding ceremony &amp;amp; reception.&lt;\/p&gt;","Attachments":[],"Id":1872589,"PostDate":1411370690,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I used DD for my wedding this past May. We designed our own Invitations and Save the Dates, but Dazzling Details made our table cards, escort cards, etc for the wedding ceremony & reception.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tychang13@yahoo.com","IpAddress":"118.168.6.38","GroupId":39,"GroupName":"Newbie","JoinDate":1411369667,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"tychang","Id":279930,"Name":"tychang","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"187.146.165.141","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76891,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6903c598d57967cece32708b1f4d3829","RawContent":"&lt;p&gt;Hi @[member=\"amyn\"]\n\n\nCongratulations on your engagement!!\n\n\nI would like to welcome you to the best destination wedding site, where you will find lots of information regarding wedding venue locations, details,etc...\n\n\nIf you&#039;d like to you can visit our website www.adventureweddingsvallarta.com and check out our wedding packages, we have a beautiful private beach called Las Caletas in Puerto Vallarta, Mexico, where we make the magic happen with an amazing view and an awesome setting for your ceremony.\n\n\nIf you want to speak with a sales agent for further assistance feel free to contact us at toll free 1.866.731.8152 or e-mail us to info@adventureweddingsvallarta.com\n\n\n\nBest regards,&lt;\/p&gt;","Attachments":[],"Id":1878410,"PostDate":1415991253,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi @<a hovercard-ref=\"member\" hovercard-id=\"277627\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277627-amyn\/' title='Member profile'><span itemprop=\"name\">amyn<\/span><\/a><br><br>\nCongratulations on your engagement!!<br><br>\nI would like to welcome you to the best destination wedding site, where you will find lots of information regarding wedding venue locations, details,etc...<br><br>\nIf you'd like to you can visit our website www.adventureweddingsvallarta.com and check out our wedding packages, we have a beautiful private beach called Las Caletas in Puerto Vallarta, Mexico, where we make the magic happen with an amazing view and an awesome setting for your ceremony.<br><br>\nIf you want to speak with a sales agent for further assistance feel free to contact us at toll free 1.866.731.8152 or e-mail us to info@adventureweddingsvallarta.com<br><br><br>\nBest regards,<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"dennise@adventureweddingsvallarta.com","IpAddress":"187.146.166.254","GroupId":49,"GroupName":"Insiders","JoinDate":1343058803,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-258213.jpeg?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"LasCaletas","Id":258213,"Name":"LasCaletas","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.201.222.5","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76891,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"8f0444c8386d1754f9a1a759227b4fc7","RawContent":"&lt;p&gt;Hello ladies,&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;My fianc\u00e9 and I just booked our wedding for November 2015 in Las Caletas and we are pretty excited.&amp;nbsp; We are not going to look for resorts near one of the main marinas - any suggestions? We are having kids and adults in our party.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Also, I am curious about photography as well.&amp;nbsp; I would appreciate any feed back... thanks!&lt;\/p&gt;\n\n&lt;p&gt;Hi, what are dazzling details ladies??&lt;\/p&gt;","Attachments":[],"Id":1878971,"PostDate":1416771643,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello ladies,<\/p>\n<p>\u00a0<\/p>\n<p>My fianc\u00e9 and I just booked our wedding for November 2015 in Las Caletas and we are pretty excited.\u00a0 We are not going to look for resorts near one of the main marinas - any suggestions? We are having kids and adults in our party.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Also, I am curious about photography as well.\u00a0 I would appreciate any feed back... thanks!<\/p>\n<br \/><p>Hi, what are dazzling details ladies??<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"saguero415@gmail.com","IpAddress":"71.201.222.5","GroupId":39,"GroupName":"Newbie","JoinDate":1398919393,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277795.jpg?_r=1416768428","PhotoWidth":170,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"samantha22","Id":277795,"Name":"samantha22","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.181.176.134","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76891,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ea46f0cfe48168b1eb0519362e2fb568","RawContent":"&lt;p&gt;Got married in MEX about 5 months ago.&amp;nbsp; Would not work with Tom Moks again. Would not recommend to others.&lt;\/p&gt;","Attachments":[],"Id":1886666,"PostDate":1424229470,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Got married in MEX about 5 months ago.\u00a0 Would not work with Tom Moks again. Would not recommend to others.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lizmagiz4@gmail.com","IpAddress":"70.181.176.134","GroupId":39,"GroupName":"Newbie","JoinDate":1424228311,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"chaveladelmundo","Id":282151,"Name":"chaveladelmundo","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"166.137.246.95","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76891,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7866998b5998a9986cc177035cf2a2e0","RawContent":"&lt;p&gt;Here is my last email to Tom which pretty much explains the overall experience:&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;div&gt;\n&lt;div&gt;\n&lt;div&gt;\n&lt;div&gt;\n&lt;div&gt;\n&lt;div&gt;\n&lt;div&gt;\n\n\t\t\t\t\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t&lt;span&gt;&lt;span&gt;&amp;lt;&lt;\/span&gt;@[member=\"gmail\"].com&lt;span&gt;&amp;gt;&lt;\/span&gt;&lt;\/span&gt;\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\n\t\t\t\t&lt;div&gt;&lt;span&gt;Feb 13&lt;\/span&gt;\n\t\t\t\t&lt;div&gt;&lt;span&gt;&lt;img src=\"https:\/\/mail.google.com\/mail\/u\/0\/images\/cleardot.gif\" alt=\"cleardot.gif\"&gt;&lt;\/span&gt;&lt;\/div&gt;\n\t\t\t\t&lt;\/div&gt;\n\t\t\t\n\t\t\t\n\t\t\t\t&amp;nbsp;\n\t\t\t\n\t\t\t\t&lt;div&gt;&lt;img src=\"https:\/\/mail.google.com\/mail\/u\/0\/images\/cleardot.gif\" alt=\"cleardot.gif\"&gt;&lt;\/div&gt;\n\t\t\t\t&lt;div&gt;&lt;img src=\"https:\/\/mail.google.com\/mail\/u\/0\/images\/cleardot.gif\" alt=\"cleardot.gif\"&gt;&lt;\/div&gt;\n\t\t\t\n\t\t\n\t\t\t\t\n\t\t\t\t\t\t\t\t&lt;div&gt;&lt;span&gt;to &lt;span&gt;Tom&lt;\/span&gt;, &lt;span&gt;TomMoks&lt;\/span&gt;, &lt;\/span&gt;&lt;\/div&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;&lt;img src=\"https:\/\/mail.google.com\/mail\/u\/0\/images\/cleardot.gif\" alt=\"cleardot.gif\"&gt;&lt;\/div&gt;\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;\n&lt;div&gt;\n&lt;div&gt;\n&lt;div&gt;&lt;span&gt;Tom&lt;\/span&gt; -&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;I am disappointed with the way you have been dealing with my wedding photos.&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;I purchased your most expensive package and it has been exhausting trying to get you to hold up your end of the deal.&amp;nbsp; I did everything you asked of me and you have already spent the money I paid you. You have not been able to deliver on ONE SINGLE promise you have made to me.&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;You were late to the wedding ceremony so I have no pictures of me getting ready or Shaun getting ready.&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;You were late on getting my photos out to me. You never told me they would be late - I had to email you for weeks multiple times before you would reply.&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;You asked me to pick out my favorite photos for my album.&amp;nbsp; It took me hours to go through each one and pick out my favorites.&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;The book was sent out very late. You never told me it would be late - I had to email you for weeks multiple times before you would reply.&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;The book finally comes and you never even put in the photos I asked you to. None of the photos with my wedding party walking down the isle, none of the pictures of Shaun and my kissing in the ocean.&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;You never even sent the DVD with the edited photos that was included in the package I have already paid for with money you have already spent.&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;What is the deal?&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;You are a great photographer but a horrible business professional.&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;This is not fair.&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;Will you please respond? This is EXHAUSTING!&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;\/div&gt;\n&lt;\/div&gt;\n&lt;div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;\/div&gt;\n&lt;div&gt;\n&lt;div&gt;\n\n\t\t\t\t&lt;div&gt;&lt;img src=\"https:\/\/mail.google.com\/mail\/u\/0\/images\/cleardot.gif\" alt=\"cleardot.gif\"&gt;&lt;span&gt;Reply&lt;\/span&gt;&lt;\/div&gt;\n\t\t\t\n\t\t\t\n\t\t\t\t&lt;div&gt;&lt;img src=\"https:\/\/mail.google.com\/mail\/u\/0\/images\/cleardot.gif\" alt=\"cleardot.gif\"&gt;&lt;span&gt;Reply to all&lt;\/span&gt;&lt;\/div&gt;\n\t\t\t\n\t\t\t\n\t\t\t\t&lt;div&gt;&lt;img src=\"https:\/\/mail.google.com\/mail\/u\/0\/images\/cleardot.gif\" alt=\"cleardot.gif\"&gt;&lt;span&gt;Forward&lt;\/span&gt;&lt;\/div&gt;\n\t\t\t\n\t\t\t\n\t\t\t\t&amp;nbsp;\n\t\t\t\n\t\t\t\t&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n\t\t\t\n\t\t&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;\/div&gt;\n&lt;\/div&gt;\n&lt;\/div&gt;\n&lt;\/div&gt;\n&lt;\/div&gt;\n&lt;\/div&gt;\n&lt;div&gt;\n&lt;div&gt;\n&lt;div&gt;\n&lt;div&gt;\n&lt;div&gt;\n&lt;div&gt;\n&lt;div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;img src=\"https:\/\/ssl.gstatic.com\/ui\/v1\/icons\/mail\/profile_mask2.png\" alt=\"profile_mask2.png\"&gt;&lt;\/div&gt;\n&lt;\/div&gt;\n&lt;div&gt;\n&lt;div&gt;\n\n\t\t\t\t\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t&lt;span&gt;Tom Moks Photography&lt;\/span&gt;\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\n\t\t\t\t&lt;div&gt;&lt;span&gt;Feb 13&lt;\/span&gt;\n\t\t\t\t&lt;div&gt;&lt;span&gt;&lt;img src=\"https:\/\/mail.google.com\/mail\/u\/0\/images\/cleardot.gif\" alt=\"cleardot.gif\"&gt;&lt;\/span&gt;&lt;\/div&gt;\n\t\t\t\t&lt;\/div&gt;\n\t\t\t\n\t\t\t\n\t\t\t\t&amp;nbsp;\n\t\t\t\n\t\t\t\t&lt;div&gt;&lt;img src=\"https:\/\/mail.google.com\/mail\/u\/0\/images\/cleardot.gif\" alt=\"cleardot.gif\"&gt;&lt;\/div&gt;\n\t\t\t\t&lt;div&gt;&lt;img src=\"https:\/\/mail.google.com\/mail\/u\/0\/images\/cleardot.gif\" alt=\"cleardot.gif\"&gt;&lt;\/div&gt;\n\t\t\t\n\t\t\n\t\t\t\t\n\t\t\t\t\t\t\t\t&lt;div&gt;&lt;span&gt;to &lt;span&gt;me&lt;\/span&gt; &lt;\/span&gt;&lt;\/div&gt;\n\t\t\t\t\t\t\t\t&lt;div&gt;&lt;img src=\"https:\/\/mail.google.com\/mail\/u\/0\/images\/cleardot.gif\" alt=\"cleardot.gif\"&gt;&lt;\/div&gt;\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;div&gt;\n&lt;div&gt;\n&lt;p&gt;Hi&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Sorry to hear that .&lt;\/p&gt;\n&lt;p&gt;Best regards &lt;span&gt;Tom&lt;\/span&gt;&lt;\/p&gt;\n&lt;\/div&gt;\n&lt;\/div&gt;\n&lt;\/div&gt;\n&lt;\/div&gt;\n&lt;\/div&gt;\n&lt;\/div&gt;\n&lt;\/div&gt;\n&lt;\/div&gt;","Attachments":[],"Id":1888514,"PostDate":1425587469,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Here is my last email to Tom which pretty much explains the overall experience:<\/p>\n<p>\u00a0<\/p>\n<div>\n<div>\n<div>\n<div>\n<div>\n<div>\n<div>\n\n\t\t\t\t\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t<span><span><<\/span>@<a hovercard-ref=\"member\" hovercard-id=\"219734\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/219734-gmail\/' title='Member profile'><span itemprop=\"name\">gmail<\/span><\/a>.com<span>><\/span><\/span>\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\n\t\t\t\t<div><span>Feb 13<\/span>\n\t\t\t\t<div><span><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/mail.google.com\/mail\/u\/0\/images\/cleardot.gif\" alt=\"cleardot.gif\"><\/span><\/span><\/div>\n\t\t\t\t<\/div>\n\t\t\t\n\t\t\t\n\t\t\t\t\u00a0\n\t\t\t\n\t\t\t\t<div><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/mail.google.com\/mail\/u\/0\/images\/cleardot.gif\" alt=\"cleardot.gif\"><\/span><\/div>\n\t\t\t\t<div><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/mail.google.com\/mail\/u\/0\/images\/cleardot.gif\" alt=\"cleardot.gif\"><\/span><\/div>\n\t\t\t\n\t\t\n\t\t\t\t\n\t\t\t\t\t\t\t\t<div><span>to <span>Tom<\/span>, <span>TomMoks<\/span>, <\/span><\/div>\n\t\t\t\t\t\t\t\t<div><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/mail.google.com\/mail\/u\/0\/images\/cleardot.gif\" alt=\"cleardot.gif\"><\/span><\/div>\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t<\/div>\n<div>\u00a0<\/div>\n<div>\u00a0<\/div>\n<div>\u00a0<\/div>\n<div>\u00a0<\/div>\n<div>\n<div>\n<div>\n<div><span>Tom<\/span> -<\/div>\n<div>\u00a0<\/div>\n<div>I am disappointed with the way you have been dealing with my wedding photos.\u00a0<\/div>\n<div>\u00a0<\/div>\n<div>I purchased your most expensive package and it has been exhausting trying to get you to hold up your end of the deal.\u00a0 I did everything you asked of me and you have already spent the money I paid you. You have not been able to deliver on ONE SINGLE promise you have made to me.<\/div>\n<div>\u00a0<\/div>\n<div>You were late to the wedding ceremony so I have no pictures of me getting ready or Shaun getting ready.<\/div>\n<div>\u00a0<\/div>\n<div>You were late on getting my photos out to me. You never told me they would be late - I had to email you for weeks multiple times before you would reply.<\/div>\n<div>\u00a0<\/div>\n<div>You asked me to pick out my favorite photos for my album.\u00a0 It took me hours to go through each one and pick out my favorites.<\/div>\n<div>\u00a0<\/div>\n<div>The book was sent out very late. You never told me it would be late - I had to email you for weeks multiple times before you would reply.<\/div>\n<div>\u00a0<\/div>\n<div>The book finally comes and you never even put in the photos I asked you to. None of the photos with my wedding party walking down the isle, none of the pictures of Shaun and my kissing in the ocean.<\/div>\n<div>\u00a0<\/div>\n<div>You never even sent the DVD with the edited photos that was included in the package I have already paid for with money you have already spent.<\/div>\n<div>\u00a0<\/div>\n<div>What is the deal?<\/div>\n<div>\u00a0<\/div>\n<div>You are a great photographer but a horrible business professional.<\/div>\n<div>\u00a0<\/div>\n<div>This is not fair.<\/div>\n<div>\u00a0<\/div>\n<div>Will you please respond? This is EXHAUSTING!<\/div>\n<div>\u00a0<\/div>\n<div>\u00a0<\/div>\n<div>\u00a0<\/div>\n<\/div>\n<div>\u00a0<\/div>\n<\/div>\n<\/div>\n<div>\n<div>\u00a0<\/div>\n<\/div>\n<div>\u00a0<\/div>\n<\/div>\n<div>\u00a0<\/div>\n<\/div>\n<div>\n<div>\n\n\t\t\t\t<div><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/mail.google.com\/mail\/u\/0\/images\/cleardot.gif\" alt=\"cleardot.gif\"><\/span><span>Reply<\/span><\/div>\n\t\t\t\n\t\t\t\n\t\t\t\t<div><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/mail.google.com\/mail\/u\/0\/images\/cleardot.gif\" alt=\"cleardot.gif\"><\/span><span>Reply to all<\/span><\/div>\n\t\t\t\n\t\t\t\n\t\t\t\t<div><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/mail.google.com\/mail\/u\/0\/images\/cleardot.gif\" alt=\"cleardot.gif\"><\/span><span>Forward<\/span><\/div>\n\t\t\t\n\t\t\t\n\t\t\t\t\u00a0\n\t\t\t\n\t\t\t\t<div>\u00a0<\/div>\n\t\t\t\n\t\t<div>\u00a0<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<div>\n<div>\n<div>\n<div>\n<div>\n<div>\n<div>\n<div>\u00a0<\/div>\n<span rel='lightbox'><img class='bbc_img' src=\"https:\/\/ssl.gstatic.com\/ui\/v1\/icons\/mail\/profile_mask2.png\" alt=\"profile_mask2.png\"><\/span><\/div>\n<\/div>\n<div>\n<div>\n\n\t\t\t\t\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t<span>Tom Moks Photography<\/span>\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\n\t\t\t\t<div><span>Feb 13<\/span>\n\t\t\t\t<div><span><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/mail.google.com\/mail\/u\/0\/images\/cleardot.gif\" alt=\"cleardot.gif\"><\/span><\/span><\/div>\n\t\t\t\t<\/div>\n\t\t\t\n\t\t\t\n\t\t\t\t\u00a0\n\t\t\t\n\t\t\t\t<div><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/mail.google.com\/mail\/u\/0\/images\/cleardot.gif\" alt=\"cleardot.gif\"><\/span><\/div>\n\t\t\t\t<div><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/mail.google.com\/mail\/u\/0\/images\/cleardot.gif\" alt=\"cleardot.gif\"><\/span><\/div>\n\t\t\t\n\t\t\n\t\t\t\t\n\t\t\t\t\t\t\t\t<div><span>to <span>me<\/span> <\/span><\/div>\n\t\t\t\t\t\t\t\t<div><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/mail.google.com\/mail\/u\/0\/images\/cleardot.gif\" alt=\"cleardot.gif\"><\/span><\/div>\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t<\/div>\n<div>\u00a0<\/div>\n<div>\u00a0<\/div>\n<div>\u00a0<\/div>\n<div>\u00a0<\/div>\n<div>\n<div>\n<p>Hi\u00a0<\/p>\n<p>Sorry to hear that .<\/p>\n<p>Best regards <span>Tom<\/span><\/p>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lizmagiz4@gmail.com","IpAddress":"70.181.176.134","GroupId":39,"GroupName":"Newbie","JoinDate":1424228311,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"chaveladelmundo","Id":282151,"Name":"chaveladelmundo","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"189.212.178.170","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":76891,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"012b0d4115303a34f420b93cd7d0ee7e","RawContent":"[quote name=\"Kayla2015\" post=\"1857237\" timestamp=\"1403930504\"]\nThe only thing I kind of figured out is the photographer, I&#039;m still deciding between booking www.photoshootsVallarta.com or www.EstefaniaFloresPhotography.com . I saw a couple other ones, like Tom Moks, but not sure he does what I&#039;m looking for. Overall, I&#039;m a mess![\/quote]\n\nHi Kayla, check Evgenia at [url=\"http:\/\/vallarta.photo\"]vallarta.photo[\/url]  She&#039;s a great photographer, I recommend her 100%.","Attachments":[],"Id":1893784,"PostDate":1429592038,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Kayla2015, on 27 June 2014 - 08:41 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>The only thing I kind of figured out is the photographer, I'm still deciding between booking www.photoshootsVallarta.com or www.EstefaniaFloresPhotography.com . I saw a couple other ones, like Tom Moks, but not sure he does what I'm looking for. Overall, I'm a mess!<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Hi Kayla, check Evgenia at <a href='http:\/\/vallarta.photo' class='bbc_url' title='External link' rel='nofollow external'>vallarta.photo<\/a>\u00a0 She's a great photographer, I recommend her 100%.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mercedes.guzman.savalza@gmail.com","IpAddress":"189.212.178.170","GroupId":39,"GroupName":"Newbie","JoinDate":1429591501,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"mia256","Id":282808,"Name":"mia256","IsOnline":false}}],"Id":"76891","Title":"Newbie - Wedding In November 2015","LastPostDate":1429592038},"Pages":{"TotalItems":10,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
