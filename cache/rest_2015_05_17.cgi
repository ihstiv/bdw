{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":17,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":6487,"MovedTo":null,"MovedOn":0,"FirstPostId":90846,"Rating":0,"RatingHits":0,"Starter":{"Id":207396,"Name":"coming together","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207396.gif?_r=0","PhotoWidth":92,"PhotoHeight":100,"PhotoType":"custom"},"IsOnline":false},"StartDate":1186623395,"LastPoster":{"Id":278188,"Name":"MommyDePoopster","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":3,"Preview":{"Id":90846,"PostDate":1186623395,"PostContent":"Hi Fellow PV Brides!  I am trying to brainstorm for my welcome bags. I have a general idea of wha...","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/dw.daisypath.com\/LIHsm8\/.png\">http:\/\/dw.daisypath.com\/LIHsm8\/.png<\/a><\/div><\/div>","Email":"busybeehid@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1178761875,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207396.gif?_r=0","PhotoWidth":92,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"coming together","Id":207396,"Name":"coming together","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":5478,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ac5528abfeae398ef2f816875c99c214","RawContent":"Hi Fellow PV Brides!\n \n I am trying to brainstorm for my welcome bags. I have a general idea of what I am going to put in them, but I am stuck on &amp;quot;cultural stuff&amp;quot;. I know it&#039;s &amp;quot;Mexico&amp;quot;, but does anyone know if there&#039;s something particular that sets PV apart from the other places? In addition, what did you all do about traveling with the bags? Did you do welcome bags? what are somethings you added? &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/feedback.gif\" border=\"0\" alt=\"\" title=\"Feedback\" class=\"inlineimg\" \/&gt;","Attachments":[],"Id":90846,"PostDate":1186623395,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi Fellow PV Brides!<br \/> <br \/> I am trying to brainstorm for my welcome bags. I have a general idea of what I am going to put in them, but I am stuck on \"cultural stuff\". I know it's \"Mexico\", but does anyone know if there's something particular that sets PV apart from the other places? In addition, what did you all do about traveling with the bags? Did you do welcome bags? what are somethings you added? <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/feedback.gif\" border=\"0\" alt=\"\" title=\"Feedback\" class=\"inlineimg\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/dw.daisypath.com\/LIHsm8\/.png\">http:\/\/dw.daisypath.com\/LIHsm8\/.png<\/a><\/div><\/div>","Email":"busybeehid@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1178761875,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207396.gif?_r=0","PhotoWidth":92,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"coming together","Id":207396,"Name":"coming together","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":5478,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4e4f1951d7258fe0bddcfc6ff1200dc3","RawContent":"Heidi, there&#039;s a bunch of info on this very topic of Welcome bags (better known as OOT bags) on this area of the forum - &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/bestdestinationwedding.com\/forum\/registry-gifts-oot-bags\/\"&gt;http:\/\/bestdestinationwedding.com\/fo...ifts-oot-bags\/&lt;\/a&gt; or try a search on OOT bags and you&#039;ll get some other results to sort through.\n \n There&#039;s a bunch of great ideas from some bride&#039;s experiences and some bride-to-be&#039;s planning efforts including lip balm, general meds for headache and stomach, water bottles, snacks, pashminas for the ladies, fans, disposable cameras, etc... The OOT bags in themselves are such a fun project. I don&#039;t know anything about PV specific stuff though I&#039;m also hoping to find some more specific Mexican themed goodies (aside from candy hearts in Spanish that we&#039;re throwing in)","Attachments":[],"Id":90852,"PostDate":1186624133,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Heidi, there's a bunch of info on this very topic of Welcome bags (better known as OOT bags) on this area of the forum - <a href='http:\/\/bestdestinationwedding.com\/forum\/registry-gifts-oot-bags\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/bestdestinati....ifts-oot-bags\/<\/a> or try a search on OOT bags and you'll get some other results to sort through.<br \/> <br \/> There's a bunch of great ideas from some bride's experiences and some bride-to-be's planning efforts including lip balm, general meds for headache and stomach, water bottles, snacks, pashminas for the ladies, fans, disposable cameras, etc... The OOT bags in themselves are such a fun project. I don't know anything about PV specific stuff though I'm also hoping to find some more specific Mexican themed goodies (aside from candy hearts in Spanish that we're throwing in)\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Claudia & Sean<\/span><br><span>11\/11\/07<\/span><\/div><\/div>","Email":"ctorres@hrworx.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1177452628,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207371.gif?_r=0","PhotoWidth":77,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Clussy75","Id":207371,"Name":"Clussy75","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":5478,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c5caef30606776e06645ea1ce2c9706b","RawContent":"We&#039;re doing a &#039;relax, it&#039;s a beach vacation&#039; thing with ours--- We bought totes for the ladies and backpacks for the single guys (both in wedding colors). Inside, we have a beach towel, a margarita glass with an individual packet of margarita mix with our name\/date on it, we&#039;ll probably get travel size tequila to include with that also if it&#039;s cheap enough when we get to MX. Then I created some crossword puzzles about Mexico, find a words that are related to the two of us, a maraca pen, a beach themed notebook, wedding colored candles, bath salts,... a bottle of sunscreen, a can of after-sun care, then we&#039;ll include some regional information in each of them too.\n \n The single men are getting &amp;quot;man-whore bags&amp;quot;---- beach towel, margarita stuff, a sheet of pick-up lines in Spanish, condoms, and we&#039;re thinking we might include a little fake syringe with a note that says something like &amp;quot;pickup cure for Mexico&amp;quot;... granted, the handful of guys who would get these bags happen to be the best friends of the groom--- but I still think it&#039;s funny...","Attachments":[],"Id":90875,"PostDate":1186625950,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We're doing a 'relax, it's a beach vacation' thing with ours--- We bought totes for the ladies and backpacks for the single guys (both in wedding colors). Inside, we have a beach towel, a margarita glass with an individual packet of margarita mix with our name\/date on it, we'll probably get travel size tequila to include with that also if it's cheap enough when we get to MX. Then I created some crossword puzzles about Mexico, find a words that are related to the two of us, a maraca pen, a beach themed notebook, wedding colored candles, bath salts,... a bottle of sunscreen, a can of after-sun care, then we'll include some regional information in each of them too.<br \/> <br \/> The single men are getting \"man-whore bags\"---- beach towel, margarita stuff, a sheet of pick-up lines in Spanish, condoms, and we're thinking we might include a little fake syringe with a note that says something like \"pickup cure for Mexico\"... granted, the handful of guys who would get these bags happen to be the best friends of the groom--- but I still think it's funny...\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mcl@marialeinen.com","IpAddress":"96.226.115.75","GroupId":46,"GroupName":"VIP Member","JoinDate":1170115980,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207113.gif?_r=0","PhotoWidth":100,"PhotoHeight":79,"PhotoType":"custom"},"FormattedName":"MikkiStreak","Id":207113,"Name":"MikkiStreak","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":5478,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ff49190c5354b05a579e66433f17412d","RawContent":"we&#039;re just doing general OOT things too: first aid kit, head\/tummy meds, spanish phrases, tees for the guys w\/ our logo on it (figure since the ladies will use the bags), etc.. not really anything cultural.","Attachments":[],"Id":90890,"PostDate":1186626965,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                we're just doing general OOT things too: first aid kit, head\/tummy meds, spanish phrases, tees for the guys w\/ our logo on it (figure since the ladies will use the bags), etc.. not really anything cultural.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lmabramson@gmail.com","IpAddress":"108.35.229.201","GroupId":46,"GroupName":"VIP Member","JoinDate":1183021140,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207500.png?_r=1429371730","PhotoWidth":200,"PhotoHeight":146,"PhotoType":"custom"},"FormattedName":"1elephant","Id":207500,"Name":"1elephant","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":5478,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bcdec53890dba77e5d14a89a3e246d9b","RawContent":"Our were pretty simple - welcome brochure, meds, playing cards, dominoes, personalized pens, notepads, neck safes, handi-wipes, can&#039;t think what else....if you&#039;re going to be in PV a day or two before the wedding go to the flea market. You&#039;ll get some nice, inexpensive local things there.","Attachments":[],"Id":91074,"PostDate":1186637732,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Our were pretty simple - welcome brochure, meds, playing cards, dominoes, personalized pens, notepads, neck safes, handi-wipes, can't think what else....if you're going to be in PV a day or two before the wedding go to the flea market. You'll get some nice, inexpensive local things there.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mrsjamyjones@gmail.com","IpAddress":"162.201.254.135","GroupId":38,"GroupName":"Moderators","JoinDate":1168271040,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207039.jpeg?_r=0","PhotoWidth":1000,"PhotoHeight":667,"PhotoType":"custom"},"FormattedName":"starchild","Id":207039,"Name":"starchild","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":5478,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5ffbbd8fca597573bcd4637d64ec1010","RawContent":"You probably know this but in PV you can buy cool shot glasses with mexican people made out of clay stuck on them!! They are really cute and inexpensive. You can get them at the flea markets here. There is also a great ceramics\/glass store just off of Basillo Badillo that sells really nice glass drink stirrers with iguanas etc on the top of them...","Attachments":[],"Id":91770,"PostDate":1186712221,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                You probably know this but in PV you can buy cool shot glasses with mexican people made out of clay stuck on them!! They are really cute and inexpensive. You can get them at the flea markets here. There is also a great ceramics\/glass store just off of Basillo Badillo that sells really nice glass drink stirrers with iguanas etc on the top of them...\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bbdq_21@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1171253333,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207155.gif?_r=0","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"bbdq_21","Id":207155,"Name":"bbdq_21","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":5478,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7f16eef4ba485a980bc553d4ee0882b5","RawContent":"This website has tons of travel size goodies:\n minimus.biz\n They have &amp;quot;aromatherapy hangover cure&amp;quot; - I&#039;m definitely going to need those for my guests!","Attachments":[],"Id":93625,"PostDate":1187045762,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                This website has tons of travel size goodies:<br \/> minimus.biz<br \/> They have \"aromatherapy hangover cure\" - I'm definitely going to need those for my guests!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"irism0413@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1179691884,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207412.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Irism0413","Id":207412,"Name":"Irism0413","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":5478,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"971d8451e3e9452f14605c8148ae2e45","RawContent":"Did everyone have success with getting your welcome bags into Mexico? We have about 100 + guest coming?","Attachments":[],"Id":102559,"PostDate":1188427195,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Did everyone have success with getting your welcome bags into Mexico? We have about 100 + guest coming?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Our first year married. We had our marriage blessed at our Catholic Church.<\/span><\/div><\/div>","Email":"cctexas1@aol.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1182197374,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207476.gif?_r=0","PhotoWidth":100,"PhotoHeight":81,"PhotoType":"custom"},"FormattedName":"chrisnessa","Id":207476,"Name":"chrisnessa","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":5478,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6f1ea3c5e929645906ad26b905fd611d","RawContent":"Be careful if you buy clay shot glasses in Mexico. A lot of them are painted with led paint.","Attachments":[],"Id":102573,"PostDate":1188428913,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Be careful if you buy clay shot glasses in Mexico. A lot of them are painted with led paint.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Brittney & Peter<\/span><br><span>July 12, 2008<\/span><br><span>Riu Ocho Rios<\/span><br><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10747;130\/st\/20080712\/e\/our+wedding+\/k\/2452\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...2452\/event.png<\/a><\/div><\/div>","Email":"BDBoynton@yahoo.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1187156541,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207618.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"BrittneyD","Id":207618,"Name":"BrittneyD","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":5478,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2ffcf08a1140f2934f003af83a1d819b","RawContent":"I put mini bottles of Patron in the welcome bags. They all made it to Mexico just fine. I was a big dumb dumb and bought them here. Although honestly I don&#039;t know if they are available in a small town like PV. \n \n If you want something specific to PV you can get little dolls dressed in traditional Jalisco dresses. That is the only thing I can think of. \n \n Some other things I put in:\n \n stainless steel flasks engraved with\n &amp;quot;Christine &amp;amp; Jeff \n May 27, 2007&amp;quot;\n \n silver wine stoppers in a heart shape\n pepto bismol\n advil\n water bottles\n chips ahoy cookies\n maps\n itinerary\n PV magnets\n toys for the kids\n \n All of the above I got at Walmart except for the Patron, flasks, wine stoppers and maps.","Attachments":[],"Id":106121,"PostDate":1189143861,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I put mini bottles of Patron in the welcome bags. They all made it to Mexico just fine. I was a big dumb dumb and bought them here. Although honestly I don't know if they are available in a small town like PV. <br \/> <br \/> If you want something specific to PV you can get little dolls dressed in traditional Jalisco dresses. That is the only thing I can think of. <br \/> <br \/> Some other things I put in:<br \/> <br \/> stainless steel flasks engraved with<br \/> \"Christine & Jeff <br \/> May 27, 2007\"<br \/> <br \/> silver wine stoppers in a heart shape<br \/> pepto bismol<br \/> advil<br \/> water bottles<br \/> chips ahoy cookies<br \/> maps<br \/> itinerary<br \/> PV magnets<br \/> toys for the kids<br \/> <br \/> All of the above I got at Walmart except for the Patron, flasks, wine stoppers and maps.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Christine & Jeff<\/span><br><span>May 27, 2007<\/span><\/div><\/div>","Email":"christine4979@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1188983112,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207703.gif?_r=0","PhotoWidth":100,"PhotoHeight":67,"PhotoType":"custom"},"FormattedName":"christinepg","Id":207703,"Name":"christinepg","IsOnline":false}}],"Id":"5478","Title":"Welcome bags.","LastPostDate":1422850877},"Pages":{"TotalItems":17,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
