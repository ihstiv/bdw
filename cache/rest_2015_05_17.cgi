{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":4,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":517,"MovedTo":null,"MovedOn":0,"FirstPostId":1883834,"Rating":0,"RatingHits":0,"Starter":{"Id":276110,"Name":"bridebrittany1185","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1422025692,"LastPoster":{"Id":282808,"Name":"mia256","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":3,"Preview":{"Id":1883834,"PostDate":1422025692,"PostContent":"I am getting married in PV (Bucerias) late May and am worried guests might be too warm? If anyone...","Author":{"Signature":"","Email":"brittanybickford@gmail.com","IpAddress":"50.74.128.82","GroupId":39,"GroupName":"Newbie","JoinDate":1389813212,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"bridebrittany1185","Id":276110,"Name":"bridebrittany1185","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"64.115.93.98","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78664,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"927f7553fce0b705e352bb8b89371883","RawContent":"&lt;p&gt;I am getting married in PV (Bucerias) late May and am worried guests might be too warm? If anyone has gotten married in May or June, can you share feedback on your experience? &amp;nbsp;Were there any fun day activities you suggest that weren&#039;t too hot?&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thanks!&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1883834,"PostDate":1422025692,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I am getting married in PV (Bucerias) late May and am worried guests might be too warm? If anyone has gotten married in May or June, can you share feedback on your experience? \u00a0Were there any fun day activities you suggest that weren't too hot?\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Thanks!\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"brittanybickford@gmail.com","IpAddress":"50.74.128.82","GroupId":39,"GroupName":"Newbie","JoinDate":1389813212,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"bridebrittany1185","Id":276110,"Name":"bridebrittany1185","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.215.90.85","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78664,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6b6bbe26ed9fc7dd65e35ba0521c363a","RawContent":"I&#039;m getting married there in May too .... I would love the same info","Attachments":[],"Id":1885612,"PostDate":1423374405,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm getting married there in May too .... I would love the same info\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>My Planning Thread:<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78846-steelethespotlights-planning-thread-may-152015-hard-rock-vallara\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78846-steelethespotlights-planning-thread-may-152015-hard-rock-vallara\/<\/a><\/p>\n<p>\n\u00a0","Email":"keegan.steele@gmail.com","IpAddress":"50.134.151.211","GroupId":39,"GroupName":"Newbie","JoinDate":1423289759,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282025.jpg?_r=1423455490","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"SteeleTheSpotlight","Id":282025,"Name":"SteeleTheSpotlight","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"187.146.164.106","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78664,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"24922e27146f2692c8bcee9a7da5de17","RawContent":"In late May it&#039;s definitely pretty warm but not too unbearable yet. The real heat and humidity usually start mid- to late June. Where in Bucerias will your wedding be?","Attachments":[],"Id":1886244,"PostDate":1423794963,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                In late May it's definitely pretty warm but not too unbearable yet. The real heat and humidity usually start mid- to late June. Where in Bucerias will your wedding be? \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"emilyjmccarthy83@gmail.com","IpAddress":"187.146.164.106","GroupId":39,"GroupName":"Newbie","JoinDate":1423790663,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"missemilym","Id":282100,"Name":"missemilym","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"189.212.178.170","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78664,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"febe9711a9bab2487c56b3eeb5768faf","RawContent":"&lt;p&gt;Late may can be warm, but not too bad, it&#039;s much warmer in August and &amp;nbsp;September. You should be fine in May the raining season usually starts on late June.&lt;\/p&gt;","Attachments":[],"Id":1893786,"PostDate":1429592346,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Late may can be warm, but not too bad, it's much warmer in August and \u00a0September. You should be fine in May the raining season usually starts on late June.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mercedes.guzman.savalza@gmail.com","IpAddress":"189.212.178.170","GroupId":39,"GroupName":"Newbie","JoinDate":1429591501,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"mia256","Id":282808,"Name":"mia256","IsOnline":false}}],"Id":"78664","Title":"Weather For Weddings In Late May In Puerto Vallarta?","LastPostDate":1429592346},"Pages":{"TotalItems":4,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
