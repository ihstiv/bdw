Request Time: 1 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":2,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":433,"MovedTo":null,"MovedOn":0,"FirstPostId":1882046,"Rating":0,"RatingHits":0,"Starter":{"Id":281560,"Name":"pykx82","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1420582905,"LastPoster":{"Id":258213,"Name":"LasCaletas","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-258213.jpeg?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":3,"Preview":{"Id":1882046,"PostDate":1420582905,"PostContent":"Hey everyone, \u00a0 I'm brand new to the forums, but so far have not found much in the way of Riu Jal...","Author":{"Signature":"","Email":"slfehr@outlook.com","IpAddress":"24.114.26.10","GroupId":39,"GroupName":"Newbie","JoinDate":1420222977,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"pykx82","Id":281560,"Name":"pykx82","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"198.163.47.9","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78555,"EditedBy":"<strong>Edited by pykx82, 06 January 2015 - 02:22 PM.<\/strong>","EditDate":1420582921,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"66654da0217dad9207741071b0354b12","RawContent":"&lt;p&gt;Hey everyone,&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;m brand new to the forums, but so far have not found much in the way of Riu Jalisco reviews post-renovations.&lt;\/p&gt;\n&lt;p&gt;My fiance and I are in the early stages of planning our Jan, 2016 wedding in Mexico, and I was wondering if anyone has had a wedding at the Riu in the past year?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;ve read the resort reviews for both the Riu Jalisco and Dreams Villamagna, but has anyone been to both and can maybe offer some advice? &amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thanks in advance!&lt;\/p&gt;","Attachments":[],"Id":1882046,"PostDate":1420582905,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hey everyone,<\/p>\n<p>\u00a0<\/p>\n<p>I'm brand new to the forums, but so far have not found much in the way of Riu Jalisco reviews post-renovations.<\/p>\n<p>My fiance and I are in the early stages of planning our Jan, 2016 wedding in Mexico, and I was wondering if anyone has had a wedding at the Riu in the past year?<\/p>\n<p>\u00a0<\/p>\n<p>I've read the resort reviews for both the Riu Jalisco and Dreams Villamagna, but has anyone been to both and can maybe offer some advice? \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Thanks in advance!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"slfehr@outlook.com","IpAddress":"24.114.26.10","GroupId":39,"GroupName":"Newbie","JoinDate":1420222977,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"pykx82","Id":281560,"Name":"pykx82","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"187.146.166.147","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78555,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ab9805fe75c716e02a8a9464ac4b3ecf","RawContent":"[quote name=\"pykx82\" post=\"1882046\" timestamp=\"1420582905\"]\nHey everyone,\n\nI&#039;m brand new to the forums, but so far have not found much in the way of Riu Jalisco reviews post-renovations.\nMy fiance and I are in the early stages of planning our Jan, 2016 wedding in Mexico, and I was wondering if anyone has had a wedding at the Riu in the past year?\n\nI&#039;ve read the resort reviews for both the Riu Jalisco and Dreams Villamagna, but has anyone been to both and can maybe offer some advice?  \n\nThanks in advance![\/quote]\nHi @[member=\"pykx82\"]\n\nCongratulations on your engagement!!\n\nI would like to welcome you to the best destination wedding site, where you will find lots of information regarding wedding venue locations, details,etc...\n\nIf you&#039;d like to you can visit our website [url=\"http:\/\/www.adventureweddingsvallarta.com\/\"]www.adventureweddingsvallarta.com[\/url] and check out our wedding packages, we have a beautiful private beach called Las Caletas in Puerto Vallarta, Mexico, where we make the magic happen with an amazing view and an awesome setting for your ceremony.\n\nIf you want to speak with a sales agent for further assistance feel free to contact us at toll free 1.866.731.8152 or e-mail us to [email=\"info@adventureweddingsvallarta.com\"]info@adventureweddingsvallarta.com[\/email]\n\n\nBest regards,\n\n\nAdventure Weddings.@[member=\"pykx82\"]","Attachments":[],"Id":1882159,"PostDate":1420667047,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>pykx82, on 06 January 2015 - 02:21 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hey everyone,<\/p>\n<p>\u00a0<\/p>\n<p>I'm brand new to the forums, but so far have not found much in the way of Riu Jalisco reviews post-renovations.<\/p>\n<p>My fiance and I are in the early stages of planning our Jan, 2016 wedding in Mexico, and I was wondering if anyone has had a wedding at the Riu in the past year?<\/p>\n<p>\u00a0<\/p>\n<p>I've read the resort reviews for both the Riu Jalisco and Dreams Villamagna, but has anyone been to both and can maybe offer some advice? \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Thanks in advance!<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>Hi @<a hovercard-ref=\"member\" hovercard-id=\"281560\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281560-pykx82\/' title='Member profile'><span itemprop=\"name\">pykx82<\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>Congratulations on your engagement!!<\/p>\n<p>\u00a0<\/p>\n<p>I would like to welcome you to the best destination wedding site, where you will find lots of information regarding wedding venue locations, details,etc...<\/p>\n<p>\u00a0<\/p>\n<p>If you'd like to\u00a0you\u00a0can\u00a0visit our website <a href='http:\/\/www.adventureweddingsvallarta.com\/' class='bbc_url' title='External link' rel='nofollow external'>www.adventureweddingsvallarta.com<\/a> and check out our wedding packages, we have a beautiful private beach called Las Caletas in Puerto Vallarta, Mexico, where we make the magic happen with an amazing view and an\u00a0awesome setting for your ceremony.<\/p>\n<p>\u00a0<\/p>\n<p>If you want to speak with a sales agent for further assistance feel free to contact us at toll free 1.866.731.8152 or e-mail us to <a href='mailto:info@adventureweddingsvallarta.com' class='bbc_url' title='External link' rel='nofollow external'>info@adventureweddingsvallarta.com<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Best regards,<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Adventure Weddings.@<a hovercard-ref=\"member\" hovercard-id=\"281560\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281560-pykx82\/' title='Member profile'><span itemprop=\"name\">pykx82<\/span><\/a><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"dennise@adventureweddingsvallarta.com","IpAddress":"187.146.166.254","GroupId":49,"GroupName":"Insiders","JoinDate":1343058803,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-258213.jpeg?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"LasCaletas","Id":258213,"Name":"LasCaletas","IsOnline":false}}],"Id":"78555","Title":"Riu Jalisco Vs. Dreams Villamagna?","LastPostDate":1420667047},"Pages":{"TotalItems":2,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
