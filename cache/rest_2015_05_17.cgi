{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":4,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":876,"MovedTo":null,"MovedOn":0,"FirstPostId":1857238,"Rating":0,"RatingHits":0,"Starter":{"Id":278725,"Name":"Kayla2015","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278725.jpg?_r=1404024792","PhotoWidth":200,"PhotoHeight":223,"PhotoType":"custom"},"IsOnline":false},"StartDate":1403932082,"LastPoster":{"Id":281560,"Name":"pykx82","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":3,"Preview":{"Id":1857238,"PostDate":1403932082,"PostContent":"Hi! I'm still undecided about my photographer, I'm deciding between Estefania Flores and Photosho...","Author":{"Signature":"","Email":"wcdspa@gmail.com","IpAddress":"189.205.182.223","GroupId":39,"GroupName":"Newbie","JoinDate":1403929185,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278725.jpg?_r=1404024792","PhotoWidth":200,"PhotoHeight":223,"PhotoType":"custom"},"FormattedName":"Kayla2015","Id":278725,"Name":"Kayla2015","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"189.205.182.223","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77418,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"10f76bacd16a846a516fc7e72c17ec50","RawContent":"&lt;p&gt;Hi! I&#039;m still undecided about my photographer, I&#039;m deciding between Estefania Flores and Photoshoots Vallarta. The reason is because photoshoots exceeds completely my budget and I like Estefania&#039;s work it&#039;s more in my price sheet area. I was wondering if anyone has actually booked her and what was their experience?&lt;\/p&gt;","Attachments":[],"Id":1857238,"PostDate":1403932082,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi! I'm still undecided about my photographer, I'm deciding between Estefania Flores and Photoshoots Vallarta. The reason is because photoshoots exceeds completely my budget and I like Estefania's work it's more in my price sheet area. I was wondering if anyone has actually booked her and what was their experience?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"wcdspa@gmail.com","IpAddress":"189.205.182.223","GroupId":39,"GroupName":"Newbie","JoinDate":1403929185,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278725.jpg?_r=1404024792","PhotoWidth":200,"PhotoHeight":223,"PhotoType":"custom"},"FormattedName":"Kayla2015","Id":278725,"Name":"Kayla2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"128.135.47.41","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77418,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"950ab24390fe8fdbd2adc20fd8036c31","RawContent":"&lt;p&gt;HI @[member=\"Kayla2015\"]&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am also looking at Estefania. &amp;nbsp;I would love to know more about her as well as Daniel Diez, Car &amp;amp; Mel, and Erik Zaveda if anyone has any helpful advice. &amp;nbsp;Thanks!&lt;\/p&gt;","Attachments":[],"Id":1863359,"PostDate":1406742776,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>HI @<a hovercard-ref=\"member\" hovercard-id=\"278725\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/278725-kayla2015\/' title='Member profile'><span itemprop=\"name\">Kayla2015<\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>I am also looking at Estefania. \u00a0I would love to know more about her as well as Daniel Diez, Car & Mel, and Erik Zaveda if anyone has any helpful advice. \u00a0Thanks!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"shjanowitz@gmail.com","IpAddress":"128.135.47.41","GroupId":39,"GroupName":"Newbie","JoinDate":1406727352,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"shjanowitz","Id":279228,"Name":"shjanowitz","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"64.201.193.105","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77418,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b3f980f7e2746cf28f61b437678ab5d9","RawContent":"&lt;p&gt;I booked with her for an engagement shoot in October, but it&#039;s not going to be with her it&#039;ll be with her assistant I believe.&lt;\/p&gt;","Attachments":[],"Id":1865872,"PostDate":1407871812,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I booked with her for an engagement shoot in October, but it's not going to be with her it'll be with her assistant I believe.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"carly.morrison@sasktel.net","IpAddress":"64.201.193.105","GroupId":39,"GroupName":"Newbie","JoinDate":1394211699,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"none"},"FormattedName":"carmor2","Id":277041,"Name":"carmor2","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"198.163.47.9","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77418,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"deb8c9fa94c37cce8cfcfc23cec5ec85","RawContent":"&lt;p&gt;@[member=\"Kayla2015\"] Do you know if Estafania has an online portfolio? &amp;nbsp;I couldn&#039;t seem to find a website for her.&lt;\/p&gt;","Attachments":[],"Id":1882124,"PostDate":1420654255,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"278725\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/278725-kayla2015\/' title='Member profile'><span itemprop=\"name\">Kayla2015<\/span><\/a> Do you know if Estafania has an online portfolio? \u00a0I couldn't seem to find a website for her.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"slfehr@outlook.com","IpAddress":"24.114.26.10","GroupId":39,"GroupName":"Newbie","JoinDate":1420222977,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"pykx82","Id":281560,"Name":"pykx82","IsOnline":false}}],"Id":"77418","Title":"Has Anyone Book Estefania Flores Photography?","LastPostDate":1420654255},"Pages":{"TotalItems":4,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
