> User Ivydulce2015 (282919)
Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":5,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":511,"MovedTo":null,"MovedOn":0,"FirstPostId":1891783,"Rating":0,"RatingHits":0,"Starter":{"Id":280946,"Name":"SusanMarie813","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280946.jpg?_r=1430402870","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"StartDate":1428086236,"LastPoster":{"Id":280946,"Name":"SusanMarie813","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280946.jpg?_r=1430402870","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":2,"Preview":{"Id":1891783,"PostDate":1428086236,"PostContent":"Hi all, I am attending a wedding next week in the bahamas.\u00a0 Yesterday I got an email saying that...","Author":{"Signature":"<p>Gian-Luigi & Susan September 13, 2015 Finest Resort <a data-ipb='nomediaparse' href='http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A'>http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A<\/a>","Email":"susanlaurelli@yahoo.com","IpAddress":"47.17.228.244","GroupId":39,"GroupName":"Newbie","JoinDate":1414861804,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280946.jpg?_r=1430402870","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"SusanMarie813","Id":280946,"Name":"SusanMarie813","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"170.200.168.13","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79019,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"62656ccf0f3ca261342c7a09e8cf3b88","RawContent":"&lt;p&gt;Hi all,&lt;\/p&gt;\n&lt;p&gt;I am attending a wedding next week in the bahamas.&amp;nbsp; Yesterday I got an email saying that I got moved out of my hotel to someother hotel.&lt;\/p&gt;\n&lt;p&gt;I spent the last 24 hours fighting and complaining even asking for refund which will not even cover the costs.&amp;nbsp; I booked through Orbitz and my friend is booked through Expedia and the same thing.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Buyer beware, you are NOT guarnteed with these sites.&amp;nbsp; Your guests may save a few bucks but in the long run it is not worth it.&amp;nbsp; Use a Travel Agent or the hotel to secure a room block for your guests.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thank god I did this for my wedding.&amp;nbsp; I have two couples that did this for my wedding and I hope they don&#039;t get booted but I warned them ahead of time.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Save yourself and your guests alot of time and do not book outside internet places.&amp;nbsp; I can tell you I will never use any of these sites again.&amp;nbsp; Now that I know they do not gaurntee your stay.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1891783,"PostDate":1428086236,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi all,<\/p>\n<p>I am attending a wedding next week in the bahamas.\u00a0 Yesterday I got an email saying that I got moved out of my hotel to someother hotel.<\/p>\n<p>I spent the last 24 hours fighting and complaining even asking for refund which will not even cover the costs.\u00a0 I booked through Orbitz and my friend is booked through Expedia and the same thing.<\/p>\n<p>\u00a0<\/p>\n<p>Buyer beware, you are NOT guarnteed with these sites.\u00a0 Your guests may save a few bucks but in the long run it is not worth it.\u00a0 Use a Travel Agent or the hotel to secure a room block for your guests.<\/p>\n<p>\u00a0<\/p>\n<p>Thank god I did this for my wedding.\u00a0 I have two couples that did this for my wedding and I hope they don't get booted but I warned them ahead of time.<\/p>\n<p>\u00a0<\/p>\n<p>Save yourself and your guests alot of time and do not book outside internet places.\u00a0 I can tell you I will never use any of these sites again.\u00a0 Now that I know they do not gaurntee your stay.<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Gian-Luigi & Susan September 13, 2015 Finest Resort <a data-ipb='nomediaparse' href='http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A'>http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A<\/a>","Email":"susanlaurelli@yahoo.com","IpAddress":"47.17.228.244","GroupId":39,"GroupName":"Newbie","JoinDate":1414861804,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280946.jpg?_r=1430402870","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"SusanMarie813","Id":280946,"Name":"SusanMarie813","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.41.59","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79019,"EditedBy":"<strong>Edited by calgarybride2015, 03 April 2015 - 10:44 AM.<\/strong>","EditDate":1428086675,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"292006f80bc7602d2e7434d10b3f8cda","RawContent":"Oh no!!!  Did you sort it out?\n\n\nUnfortunately it happens with airlines too - in Canada we have package deals and I have heard of it happening with major carriers too.  \n\n\nThe resorts are over selling. It isn&#039;t always the airlines fault as they have access to what&#039;s &#039;apparently&#039; available and some get bumped. Unsure who they decide to bump but it does happen even when booking thru TAs, actual airlines and the resort themselves. \n\n\nI booked my wedding thru Air Canada and my TA told me the resort wasn&#039;t available anymore not even to book separately (my guests would find their own flight) but then West Jet was still selling our package.  It runs a little deeper than we appreciate I think. \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1891785,"PostDate":1428086518,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Oh no!!!  Did you sort it out?<br><br>\nUnfortunately it happens with airlines too - in Canada we have package deals and I have heard of it happening with major carriers too.  <br><br>\nThe resorts are over selling. It isn't always the airlines fault as they have access to what's 'apparently' available and some get bumped. Unsure who they decide to bump but it does happen even when booking thru TAs, actual airlines and the resort themselves. <br><br>\nI booked my wedding thru Air Canada and my TA told me the resort wasn't available anymore not even to book separately (my guests would find their own flight) but then West Jet was still selling our package.  It runs a little deeper than we appreciate I think. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399432202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"143.58.161.6","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79019,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c94968c0517d3b04160c080983a306dd","RawContent":"&lt;p&gt;@&lt;span&gt;&lt;a  class=\"\" href=\"http:\/\/www.bestdestinationwedding.com\/user\/280946-susanmarie813\/\" title=\"\"&gt;&lt;span&gt;SusanMarie813&lt;\/span&gt;&lt;\/a&gt;&lt;\/span&gt;&amp;nbsp;- It&#039;s not Expedia or Orbitz, per se, it&#039;s the resorts. The websites are just being forced to move their bookings. They aren&#039;t doing that \"just because.\" We did use a TA for our wedding, but, otherwise,&amp;nbsp;we always book through Travelocity (because the prices can&#039;t be beaten) and - knock on wood - we have never had an issue.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;That being said, it doesn&#039;t make the situation any less of a nightmare to deal with. I&#039;m sorry to hear that it happened and I hope you are able to get it resolved.&lt;\/p&gt;","Attachments":[],"Id":1891786,"PostDate":1428087882,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<span><a href='http:\/\/www.bestdestinationwedding.com\/user\/280946-susanmarie813\/' class='bbc_url' title=''><span>SusanMarie813<\/span><\/a><\/span>\u00a0- It's not Expedia or Orbitz, per se, it's the resorts. The websites are just being forced to move their bookings. They aren't doing that \"just because.\" We did use a TA for our wedding, but, otherwise,\u00a0we always book through Travelocity (because the prices can't be beaten) and - knock on wood - we have never had an issue.<\/p>\n<p>\u00a0<\/p>\n<p>That being said, it doesn't make the situation any less of a nightmare to deal with. I'm sorry to hear that it happened and I hope you are able to get it resolved.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jhowe114@gmail.com","IpAddress":"38.98.131.98","GroupId":40,"GroupName":"Jr. Member","JoinDate":1402429989,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278395.jpg?_r=1421871115","PhotoWidth":200,"PhotoHeight":285,"PhotoType":"custom"},"FormattedName":"JenniferH114","Id":278395,"Name":"JenniferH114","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.143.153.161","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79019,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8019095f10e7d11d838da2afc4b6574c","RawContent":"&lt;p&gt;Yes, it is the hotels - however, there is a priority list for properties for which guests to \"walk\" (the term used to decide which patrons with reservations will be \"walked\" to another property due to over-booking). &amp;nbsp;Online sites (OTA&#039;s) are at the top of this list ALWAYS.&lt;\/p&gt;\n&lt;p&gt;Properties do not want to have clients who have booked directly with them unhappy and unlikely to return so it is always better to book directly with the property - and through a TA who works with Tour Operators with direct relationships with the hotels.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Unfortunately, over-booking occurs frequently in the travel industry. &amp;nbsp;You decrease your chances of being a victim by avoiding the temptation of an \"incredible deal\" on a property through an cheap online wholesaler.&lt;\/p&gt;","Attachments":[],"Id":1891805,"PostDate":1428114621,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Yes, it is the hotels - however, there is a priority list for properties for which guests to \"walk\" (the term used to decide which patrons with reservations will be \"walked\" to another property due to over-booking). \u00a0Online sites (OTA's) are at the top of this list ALWAYS.<\/p>\n<p>Properties do not want to have clients who have booked directly with them unhappy and unlikely to return so it is always better to book directly with the property - and through a TA who works with Tour Operators with direct relationships with the hotels.<\/p>\n<p>\u00a0<\/p>\n<p>Unfortunately, over-booking occurs frequently in the travel industry. \u00a0You decrease your chances of being a victim by avoiding the temptation of an \"incredible deal\" on a property through an cheap online wholesaler.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><a class='bbc_url' href='http:\/\/wrighttravelagency.com\/inquiry\/'><span style='color: rgb(0,128,128)'>Looking for a travel agency that specializes in Destination Weddings<\/span><\/a><span style='color: rgb(0,128,128)'>? We are an award winning travel agency and you can read our reviews <\/span><a class='bbc_url' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style='color: rgb(0,128,128)'><strong class='bbc'>HERE.<\/strong><\/span><\/a><\/span><\/span><br \/>\n<br \/>\n<span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'><strong class='bbc'>Awards and recognition: <\/strong><\/span><\/span><\/span><\/span><br \/>\n<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'>Palace Resorts Top PRO Agency <\/span><\/span><\/span><\/span><br \/>\n<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'>Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator <\/span><\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>AMResorts Master Agent & Top Agency<\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>Travel Impressions Best of the Best Globe Winner<\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>Apple Vacations Golden Apple Winner<\/span><\/span><\/span>","Email":"kathy@wrighttravelagency.com","IpAddress":"50.143.153.161","GroupId":49,"GroupName":"Insiders","JoinDate":1391022264,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"TAkathy","Id":276390,"Name":"TAkathy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.3.185.205","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79019,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c41a82c356f9ca4de96dfce9b0f37a9e","RawContent":"So we went to the hotel Orbitz put us in and we had no reservation.  Suffice it to say I was very upset.  After hours of calls in the Bahamas we finally got into a hotel.  I&#039;ll never do it again.","Attachments":[],"Id":1893215,"PostDate":1429123250,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                So we went to the hotel Orbitz put us in and we had no reservation.  Suffice it to say I was very upset.  After hours of calls in the Bahamas we finally got into a hotel.  I'll never do it again. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Gian-Luigi & Susan September 13, 2015 Finest Resort <a data-ipb='nomediaparse' href='http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A'>http:\/\/www.finestresorts.com\/special-offers\/?gclid=COnnlrKb_sMCFQeUfgodpEAA-A<\/a>","Email":"susanlaurelli@yahoo.com","IpAddress":"47.17.228.244","GroupId":39,"GroupName":"Newbie","JoinDate":1414861804,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280946.jpg?_r=1430402870","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"SusanMarie813","Id":280946,"Name":"SusanMarie813","IsOnline":false}}],"Id":"79019","Title":"Buyer Beware Expedia And Orbitz","LastPostDate":1429123250},"Pages":{"TotalItems":5,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
