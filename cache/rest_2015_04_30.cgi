decor'>https:\/\/www.facebook.com\/loveandlacedecor<\/a><\/p>\n<div>Wedding Photo Album: <a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/media\/set\/?set=a.10100809953124424.1073741834.18310150&type=1&l=581de87d2f'>https:\/\/www.facebook.com\/media\/set\/?set=a.10100809953124424.1073741834.18310150&type=1&l=581de87d2f<\/a><\/div>\n","Email":"khmciver@gmail.com","IpAddress":"108.223.176.224","GroupId":47,"GroupName":"Site Supporter","JoinDate":1386811154,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275598.jpg?_r=1426649427","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"kellymenning","Id":275598,"Name":"kellymenning","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.139.53.63","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78374,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"38173a9c265772cbab7821404437d759","RawContent":"Now I don&#039;t feel so bad spending the $300 I have in buying my decor lol!","Attachments":[],"Id":1888100,"PostDate":1425358317,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Now I don't feel so bad spending the $300 I have in buying my decor lol! \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lisananth@yahoo.com","IpAddress":"166.137.101.169","GroupId":40,"GroupName":"Jr. Member","JoinDate":1401140033,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278120.jpg?_r=1421810202","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"LisaAnthonyPoppy","Id":278120,"Name":"LisaAnthonyPoppy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.41.59","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78374,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c3568005dbae15feba4e9231344788c2","RawContent":"[quote name=\"LisaAnthonyPoppy\" post=\"1888100\" timestamp=\"1425354717\"]\nNow I don&#039;t feel so bad spending the $300 I have in buying my decor lol![\/quote]Don&#039;t!! I spent far less than that on decor :) \n\nFavors not so much! \n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1888110,"PostDate":1425362333,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>LisaAnthonyPoppy, on 02 March 2015 - 08:51 PM, said:<\/p><div class='blockquote'><div class='quote'><p>Now I don't feel so bad spending the $300 I have in buying my decor lol!<\/p><\/div><\/div>\n<br>\nDon't!! I spent far less than that on decor <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> <br><br>\nFavors not so much! <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399432202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.139.53.63","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78374,"EditedBy":"","EditDate":1425388833,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1fe6884cac87a4534a48891c0a7c20cf","RawContent":"@[member=\"calgarybride2015\"] thank you :)\n\n!! I made this yesterday to match my bouquet. It is Poppy&#039;s flower girl basket.\n\nTrying to make things pretty without spending a bunch! So far so good!","Attachments":[{"Id":30793,"Name":"image.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_03_2015\/post-278120-0-82366400-1425385223.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_03_2015\/post-278120-0-82366400-1425385223_thumb.jpg","Width":1000,"Height":750}],"Id":1888117,"PostDate":1425388777,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"277873\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277873-calgarybride2015\/' title='Member profile'><span itemprop=\"name\">calgarybride2015<\/span><\/a> thank you <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br>\n!! I made this yesterday to match my bouquet. It is Poppy's flower girl basket.<br>\nTrying to make things pretty without spending a bunch! So far so good!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lisananth@yahoo.com","IpAddress":"166.137.101.169","GroupId":40,"GroupName":"Jr. Member","JoinDate":1401140033,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278120.jpg?_r=1421810202","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"LisaAnthonyPoppy","Id":278120,"Name":"LisaAnthonyPoppy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.223.176.224","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78374,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":3,"IsLiked":false,"PostKey":"2335ecd3a1b87b5d38810c88971dea6a","RawContent":"@LisaAnthonyPoppy@calgarybride2015\n\nI love the flower girl basket! So pretty! \n\n\nYep, I spent a lot on decorations because I really wanted it to look a certain way. The hotel was going to charge me $2000 just for 10 strands of bulbs for lighting, so I feel like I came out ahead. Plus, having 120 people at a wedding just makes everything cost more. It was worth every penny!","Attachments":[],"Id":1888120,"PostDate":1425393818,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @LisaAnthonyPoppy@calgarybride2015<br>\nI love the flower girl basket! So pretty! <br><br>\nYep, I spent a lot on decorations because I really wanted it to look a certain way. The hotel was going to charge me $2000 just for 10 strands of bulbs for lighting, so I feel like I came out ahead. Plus, having 120 people at a wedding just makes everything cost more. It was worth every penny! \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Wedding Date: November 1, 2015<br>\nWedding Location: Azul Fives Hotel in Playa del Carmen<\/p>\n<p>Photographer: Photos in Cancun - Derek Campbell<br>\n<a data-ipb='nomediaparse' href='http:\/\/www.photosincancun.com'>http:\/\/www.photosincancun.com<\/a><\/p>\n<p>Decoration Rentals: Love & Lace Wedding Decor<br>\n<a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/loveandlacedecor'>https:\/\/www.facebook.com\/loveandlacedecor<\/a><\/p>\n<div>Wedding Photo Album: <a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/media\/set\/?set=a.10100809953124424.1073741834.18310150&type=1&l=581de87d2f'>https:\/\/www.facebook.com\/media\/set\/?set=a.10100809953124424.1073741834.18310150&type=1&l=581de87d2f<\/a><\/div>\n","Email":"khmciver@gmail.com","IpAddress":"108.223.176.224","GroupId":47,"GroupName":"Site Supporter","JoinDate":1386811154,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275598.jpg?_r=1426649427","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"kellymenning","Id":275598,"Name":"kellymenning","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.139.53.63","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78374,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fb394520a0930fe17d114ed9035f5dc9","RawContent":"@[member=\"khmciver\"] thank you!\n\nWowzers 120 ppl girl Idk how you pulled that off! For sure I can totally understand the 2500 for anyone let alone you with that many guests, hope I didn&#039;t come across cross. Ive been feeling guilty about spending anything that isn&#039;t \"essential\" I guess it comes from internal childhood stressors but I need to keep telling myself that it is a wedding and that it&#039;s all justified and should be allowed.... If that makes sense!","Attachments":[],"Id":1888184,"PostDate":1425416443,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @khmciver thank you!<br>\nWowzers 120 ppl girl Idk how you pulled that off! For sure I can totally understand the 2500 for anyone let alone you with that many guests, hope I didn't come across cross. Ive been feeling guilty about spending anything that isn't \"essential\" I guess it comes from internal childhood stressors but I need to keep telling myself that it is a wedding and that it's all justified and should be allowed.... If that makes sense! \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lisananth@yahoo.com","IpAddress":"166.137.101.169","GroupId":40,"GroupName":"Jr. Member","JoinDate":1401140033,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278120.jpg?_r=1421810202","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"LisaAnthonyPoppy","Id":278120,"Name":"LisaAnthonyPoppy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.148.255.86","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78374,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"aa2ebd6b24245571635bd6a021b595dd","RawContent":"&lt;p&gt;@[member=\"LisaAnthonyPoppy\"] - You didn&#039;t come across cross at all!! I spent WAY more money on our wedding than I should have, but like you said...I just remembered it&#039;s our wedding and (hopefully) I&#039;ll only have one. Haha! It was a lot of guests so it added up for sure. I miss it though! It was so fun planning! Good luck with your wedding! I&#039;m sure it will be beautiful!!&lt;\/p&gt;","Attachments":[],"Id":1888188,"PostDate":1425416948,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"278120\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/278120-lisaanthonypoppy\/' title='Member profile'><span itemprop=\"name\">LisaAnthonyPoppy<\/span><\/a> - You didn't come across cross at all!! I spent WAY more money on our wedding than I should have, but like you said...I just remembered it's our wedding and (hopefully) I'll only have one. Haha! It was a lot of guests so it added up for sure. I miss it though! It was so fun planning! Good luck with your wedding! I'm sure it will be beautiful!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Wedding Date: November 1, 2015<br>\nWedding Location: Azul Fives Hotel in Playa del Carmen<\/p>\n<p>Photographer: Photos in Cancun - Derek Campbell<br>\n<a data-ipb='nomediaparse' href='http:\/\/www.photosincancun.com'>http:\/\/www.photosincancun.com<\/a><\/p>\n<p>Decoration Rentals: Love & Lace Wedding Decor<br>\n<a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/loveandlacedecor'>https:\/\/www.facebook.com\/loveandlacedecor<\/a><\/p>\n<div>Wedding Photo Album: <a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/media\/set\/?set=a.10100809953124424.1073741834.18310150&type=1&l=581de87d2f'>https:\/\/www.facebook.com\/media\/set\/?set=a.10100809953124424.1073741834.18310150&type=1&l=581de87d2f<\/a><\/div>\n","Email":"khmciver@gmail.com","IpAddress":"108.223.176.224","GroupId":47,"GroupName":"Site Supporter","JoinDate":1386811154,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275598.jpg?_r=1426649427","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"kellymenning","Id":275598,"Name":"kellymenning","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.139.53.63","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78374,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5e63f9c64967cfa2f9d0511c1044fd81","RawContent":"Thank you! Guess you might just have to have a vowel renewal at the one year mark! Maybe in Vegas;)","Attachments":[],"Id":1888193,"PostDate":1425419009,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thank you! Guess you might just have to have a vowel renewal at the one year mark! Maybe in Vegas;) \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lisananth@yahoo.com","IpAddress":"166.137.101.169","GroupId":40,"GroupName":"Jr. Member","JoinDate":1401140033,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278120.jpg?_r=1421810202","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"LisaAnthonyPoppy","Id":278120,"Name":"LisaAnthonyPoppy","IsOnline":false}}],"Pages":{"TotalItems":26,"TotalPages":3,"CurrentPage":10,"NextPage":20,"PreviousPage":0,"LastPage":20},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}