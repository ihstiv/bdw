{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":8,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":670,"MovedTo":null,"MovedOn":0,"FirstPostId":1911792,"Rating":0,"RatingHits":0,"Starter":{"Id":282063,"Name":"Cablelove11","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1457731569,"LastPoster":{"Id":286918,"Name":"AdamnJenn17","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286918.jpg?_r=1462901352","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":60,"Preview":{"Id":1911792,"PostDate":1457731569,"PostContent":"Any ladies taking\/have taken your children with you to your DW? Did you have them stay with a fam...","Author":{"Signature":"","Email":"lmf0408@gmail.com","IpAddress":"208.54.64.217","GroupId":39,"GroupName":"Newbie","JoinDate":1423561966,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Cablelove11","Id":282063,"Name":"Cablelove11","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.180.52.177","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79990,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"9e2b66b41f358667739adee6ee751d0d","RawContent":"Any ladies taking\/have taken your children with you to your DW? Did you have them stay with a family member the whole time? Did you get (or do you plan to) enough QT with your husband?","Attachments":[],"Id":1911792,"PostDate":1457731569,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Any ladies taking\/have taken your children with you to your DW? Did you have them stay with a family member the whole time? Did you get (or do you plan to) enough QT with your husband?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lmf0408@gmail.com","IpAddress":"208.54.64.217","GroupId":39,"GroupName":"Newbie","JoinDate":1423561966,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Cablelove11","Id":282063,"Name":"Cablelove11","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.66.68.111","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79990,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"2f68bca5d7d28a6e7ec9ea07671acfb7","RawContent":"I brought mine. Couldn&#039;t imagine them not being with us when we married.  We kept them the whole time and had to alternate nights we went out. On our wedding night my MIL took them and the next day everyone took turns so we had some private time. Is def a different trip with kids (sometimes wish we could have partied more) but I wouldn&#039;t change it for the world.  We felt bad to ask for lots of extra help\n\nAs everyone paid for their own vacation not to babysit. My kids were 9 though so didn&#039;t need much but an eye on them. \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1911807,"PostDate":1457781267,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I brought mine. Couldn't imagine them not being with us when we married.  We kept them the whole time and had to alternate nights we went out. On our wedding night my MIL took them and the next day everyone took turns so we had some private time. Is def a different trip with kids (sometimes wish we could have partied more) but I wouldn't change it for the world.  We felt bad to ask for lots of extra help<br>\nAs everyone paid for their own vacation not to babysit. My kids were 9 though so didn't need much but an eye on them. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.165.101.145","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79990,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":3,"IsLiked":false,"PostKey":"e84289737c251488db6a7f10bb058ea5","RawContent":"&lt;p&gt;Having my daughter be a part of our celebration was really important to us. She stayed with us during our entire two weeks -- but on certain nights\/days she spent them with her cousins or my parents. Of course on the Wedding night she was with my parents :) Weddings are about celebrating love and family -- I don&#039;t think you&#039;d regret having your children be a part of your event, but I do think you might regret not having them there and end up missing them. And definitely be open to asking family to help with the kids on special nights or days you&#039;d like to have some alone time.&lt;\/p&gt;","Attachments":[],"Id":1911848,"PostDate":1457894637,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Having my daughter be a part of our celebration was really important to us. She stayed with us during our entire two weeks -- but on certain nights\/days she spent them with her cousins or my parents. Of course on the Wedding night she was with my parents <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> Weddings are about celebrating love and family -- I don't think you'd regret having your children be a part of your event, but I do think you might regret not having them there and end up missing them. And definitely be open to asking family to help with the kids on special nights or days you'd like to have some alone time.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-size:18px;\"><span style=\"font-family:georgia;\"><strong>MARIESAM SANCHEZ PHOTOGRAPHY<\/strong><\/span><\/span><br>\nWEBSITE: <a  class=\"bbc_url\" href=\"http:\/\/www.mariesamsanchez.com\">www.mariesamsanchez.com<\/a><br>\nBLOG: <a  class=\"bbc_url\" href=\"http:\/\/www.mariesamsanchezblog.com\">www.mariesamsanchez.com<\/a><a data-ipb='nomediaparse' href='http:\/\/www.mariesamsanchez.com\/blog'>\/blog<\/a><br>\nCONTACT ME: <a  class=\"bbc_email\" href=\"mailto:mariesam.sanchez@gmail.com?subject=BDW%20Inquiry\" title=\"E-mail Link\">mariesam.sanchez@gmail.com<\/a><br><br><img src=\"http:\/\/i287.photobucket.com\/albums\/ll150\/msam007562\/063cb5c8-dbda-4822-87fe-ba3c0ebcdb7f.jpg\" alt=\"063cb5c8-dbda-4822-87fe-ba3c0ebcdb7f.jpg\">","Email":"mariesam.sanchez@gmail.com","IpAddress":"74.100.61.37","GroupId":38,"GroupName":"Moderators","JoinDate":1285939945,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232833.jpg?_r=1422091823","PhotoWidth":200,"PhotoHeight":220,"PhotoType":"custom"},"FormattedName":"MarieSamSanchezPhoto","Id":232833,"Name":"MarieSamSanchezPhoto","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.218.16.79","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79990,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"be26592749f12d8fda681d80a28a319a","RawContent":"&lt;p&gt;My 2 step kids are coming (ages 6 and 8). They&#039;re traveling with my hubby&#039;s parents and staying in room with them the entire 5 days. We will spend time with them during day and they&#039;re in our wedding. We are going 2 days before them and staying 4 days longer. It just makes sense for us and his mom volunteered so that they won&#039;t have to miss too much school.&lt;\/p&gt;","Attachments":[],"Id":1911957,"PostDate":1458088261,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>My 2 step kids are coming (ages 6 and 8). They're traveling with my hubby's parents and staying in room with them the entire 5 days. We will spend time with them during day and they're in our wedding. We are going 2 days before them and staying 4 days longer. It just makes sense for us and his mom volunteered so that they won't have to miss too much school.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Amaqt03@hotmail.com","IpAddress":"98.169.122.6","GroupId":39,"GroupName":"Newbie","JoinDate":1352496105,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-262240.jpg?_r=1421980656","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"MissAmber26","Id":262240,"Name":"MissAmber26","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"189.221.32.119","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79990,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"b93eeb8919d9d9a36f44a8b474f55224","RawContent":"[quote name=\"Cablelove11\" post=\"1911792\" timestamp=\"1457745969\"]\nAny ladies taking\/have taken your children with you to your DW? Did you have them stay with a family member the whole time? Did you get (or do you plan to) enough QT with your husband?[\/quote][quote name=\"Cablelove11\" post=\"1911792\" timestamp=\"1457745969\"]\nAny ladies taking\/have taken your children with you to your DW? Did you have them stay with a family member the whole time? Did you get (or do you plan to) enough QT with your husband?[\/quote]@[member=\"Cablelove11\"] the best part about taking them is also that everyone is willing to help take care of the kids , I took my child to my DW wedding and everyone helped. of-coarse on the wedding night she did a sleepover with her cousins.  \n\nHappy Planning!","Attachments":[],"Id":1912045,"PostDate":1458391461,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Cablelove11, on 11 March 2016 - 09:26 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Any ladies taking\/have taken your children with you to your DW? Did you have them stay with a family member the whole time? Did you get (or do you plan to) enough QT with your husband?<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Cablelove11, on 11 March 2016 - 09:26 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Any ladies taking\/have taken your children with you to your DW? Did you have them stay with a family member the whole time? Did you get (or do you plan to) enough QT with your husband?<\/p>\n<\/div>\n<\/div><\/div>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"282063\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282063-cablelove11\/' title='Member profile'><span itemprop=\"name\">Cablelove11<\/span><\/a> the best part about taking them is also that everyone is willing to help take care of the kids , I took my child to my DW wedding and everyone helped. of-coarse on the wedding night she did a sleepover with her cousins. \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Happy Planning!\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Dream Weddings Riviera Maya- We pay attention to your wishes and coordinate closely with you to ensure your wedding or event is planned to perfection! Supporting you brides and help you feel less overwhelmed during the wedding planning process.<\/p>\n<p>Have fun the best is yet to come!<\/p>\n<p>\u00a0<\/p>\n<p>This is where I will be posting all videos about most common question about Destination wedding<\/p>\n<p> <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0\u00a0<a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/groups\/1664036763874450\/'>https:\/\/www.facebook.com\/groups\/1664036763874450\/<\/a><br><br><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Dream Weddings Riviera Maya<\/span><\/span><\/span><br><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">weddingsinplayadelcarmen@gmail.com<\/span><\/span><br><a  class=\"bbc_url\" href=\"http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html\">http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html<\/a><br><br><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Happy Planning!<\/span><\/span><\/span><br><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Joyce<\/span><\/span><\/span>","Email":"weddingsinplayadelcarmen@gmail.com","IpAddress":"187.252.44.28","GroupId":84,"GroupName":"Insiders w\/ Articles","JoinDate":1326839987,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250090.jpg?_r=1451923195","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"dreamweddings","Id":250090,"Name":"dreamweddings","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.119.15.44","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79990,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"8299ab5984839f447a86d3a2f59369d2","RawContent":"&lt;p&gt;We are planning on taking our son who will be 4 by the wedding date. &amp;nbsp;We are staying at the resort from Monday to Sunday and our guests are staying Monday to Thursday. &amp;nbsp;He will leave with my future MIL on Thursday so that we have a few \"honeymoon\" days. &amp;nbsp;He will be in the room with us every night except for Wednesday (wedding night).&lt;\/p&gt;","Attachments":[],"Id":1912818,"PostDate":1460473153,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>We are planning on taking our son who will be 4 by the wedding date. \u00a0We are staying at the resort from Monday to Sunday and our guests are staying Monday to Thursday. \u00a0He will leave with my future MIL on Thursday so that we have a few \"honeymoon\" days. \u00a0He will be in the room with us every night except for Wednesday (wedding night).<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cadesha.benson@gmail.com","IpAddress":"67.61.107.139","GroupId":39,"GroupName":"Newbie","JoinDate":1453547902,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286018.jpg?_r=1459635518","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"Endreece","Id":286018,"Name":"Endreece","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.192.76.178","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79990,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5f19298fed7e7014497eef18a7744267","RawContent":"&lt;p&gt;My son will be almost 2 for our wedding! We&#039;re getting married on a Friday and staying Tuesday - Sunday so we plan on having him with us the whole stay except for the wedding night :) Then on Sunday we plan on flying to the other side of the country to another hotel for a 3-4 day \"mini-moon\" and my parents will be taking him and flying home with him! Figured this would be best since we were sure most of our family and friends will be turning our DW into their vacation and extending their stay haha&lt;\/p&gt;","Attachments":[],"Id":1913306,"PostDate":1462347674,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>My son will be almost 2 for our wedding! We're getting married on a Friday and staying Tuesday - Sunday so we plan on having him with us the whole stay except for the wedding night <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> Then on Sunday we plan on flying to the other side of the country to another hotel for a 3-4 day \"mini-moon\" and my parents will be taking him and flying home with him! Figured this would be best since we were sure most of our family and friends will be turning our DW into their vacation and extending their stay haha<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sashlozada@gmail.com","IpAddress":"68.192.76.178","GroupId":39,"GroupName":"Newbie","JoinDate":1462346009,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286871.jpg?_r=1462360488","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"sashloz","Id":286871,"Name":"sashloz","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"131.137.245.208","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79990,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ca396552233c4e8621631a3b7d6279c5","RawContent":"&lt;p&gt;Kids are part of the magic of your family&amp;nbsp; - yes they can spend some time with grandma and grandpa but they most definitely be by my side at the wedding in his little outfit&lt;\/p&gt;","Attachments":[],"Id":1913622,"PostDate":1462907355,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Kids are part of the magic of your family\u00a0 - yes they can spend some time with grandma and grandpa but they most definitely be by my side at the wedding in his little outfit<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"adamphall@ymail.com","IpAddress":"131.137.245.206","GroupId":40,"GroupName":"Jr. Member","JoinDate":1462868136,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286918.jpg?_r=1462901352","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"AdamnJenn17","Id":286918,"Name":"AdamnJenn17","IsOnline":false}}],"Id":"79990","Title":"Taking Children To Your Dw","LastPostDate":1462907355},"Pages":{"TotalItems":8,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
