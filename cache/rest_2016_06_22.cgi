{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.26.164.62","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78687,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e89e437cb745aeed55b5a79c7176e107","RawContent":"Are there any other cruise brides out there? We just put the deposit down for our group booking on the cruise. Woohoo! We will be on Royal&#039;s Navigator of the Seas and getting married in Jamaica. Any words of wisdoms?","Attachments":[],"Id":1884264,"PostDate":1422332782,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Are there any other cruise brides out there? We just put the deposit down for our group booking on the cruise. Woohoo! We will be on Royal's Navigator of the Seas and getting married in Jamaica. Any words of wisdoms?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10743;484\/st\/20160413\/e\/Wedding+Day\/k\/c760\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n","Email":"lm_sprowl@hotmail.com","IpAddress":"75.26.164.62","GroupId":39,"GroupName":"Newbie","JoinDate":1418275431,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"cruisebride2016","Id":281378,"Name":"cruisebride2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.89.236.44","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78687,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"aea5b1ea24da7e31d0b15693c725286c","RawContent":"&lt;p&gt;What a magical way to get married, congratulations.&lt;\/p&gt;","Attachments":[],"Id":1885002,"PostDate":1422924040,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>What a magical way to get married, congratulations.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"njwood000@gmail.com","IpAddress":"71.7.173.185","GroupId":40,"GroupName":"Jr. Member","JoinDate":1405824791,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Msmimi","Id":279087,"Name":"Msmimi","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.26.164.62","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78687,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"657b28835c0e21763bd29c515dae183a","RawContent":"Thank you! We are very excited :)","Attachments":[],"Id":1885022,"PostDate":1422938816,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thank you! We are very excited <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10743;484\/st\/20160413\/e\/Wedding+Day\/k\/c760\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n","Email":"lm_sprowl@hotmail.com","IpAddress":"75.26.164.62","GroupId":39,"GroupName":"Newbie","JoinDate":1418275431,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"cruisebride2016","Id":281378,"Name":"cruisebride2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.100.237.180","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78687,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1f0f887b42ff12b4382466ffc49ae594","RawContent":"@[member=\"cruisebride2016\"].... how was your Day? I&#039;m planning a cruise wedding on Royal Caribbean Freedom of the Seas sailing June 19-26 2016. .","Attachments":[],"Id":1900724,"PostDate":1437321720,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"281378\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281378-cruisebride2016\/' title='Member profile'><span itemprop=\"name\">cruisebride2016<\/span><\/a>.... how was your Day? I'm planning a cruise wedding on Royal Caribbean Freedom of the Seas sailing June 19-26 2016. .\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"atwater7@yahoo.com","IpAddress":"98.240.19.233","GroupId":39,"GroupName":"Newbie","JoinDate":1389481919,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276017.jpg?_r=1452312783","PhotoWidth":200,"PhotoHeight":139,"PhotoType":"custom"},"FormattedName":"LADYJUSTICE","Id":276017,"Name":"LADYJUSTICE","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.26.161.246","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78687,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"8b8c01ea6bd3287a9e82a194de95a93a","RawContent":"@LADYJUSTICE- congratulations! We haven&#039;t gotten married yet. Our date is in April 2016. What are your plans so far?","Attachments":[],"Id":1900725,"PostDate":1437322796,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @LADYJUSTICE- congratulations! We haven't gotten married yet. Our date is in April 2016. What are your plans so far?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10743;484\/st\/20160413\/e\/Wedding+Day\/k\/c760\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n","Email":"lm_sprowl@hotmail.com","IpAddress":"75.26.164.62","GroupId":39,"GroupName":"Newbie","JoinDate":1418275431,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"cruisebride2016","Id":281378,"Name":"cruisebride2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.100.237.180","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78687,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"eaf2021ad6d7ba29d997928a3a1f1288","RawContent":"@[member=\"cruisebride2016\"]....... We are getting married at a port. I have hired a planner in St Thomas. \n\nI&#039;m planning something immediately after the wedding while on the beach. .\n\nRight now I&#039;m trying to figure out what to do after the ceremony on the ship because I still want to dance party etc....\n\nWhat are your plans?","Attachments":[],"Id":1902175,"PostDate":1439091737,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"281378\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281378-cruisebride2016\/' title='Member profile'><span itemprop=\"name\">cruisebride2016<\/span><\/a>....... We are getting married at a port. I have hired a planner in St Thomas. <br>\nI'm planning something immediately after the wedding while on the beach. .<br>\nRight now I'm trying to figure out what to do after the ceremony on the ship because I still want to dance party etc....<br>\nWhat are your plans? \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"atwater7@yahoo.com","IpAddress":"98.240.19.233","GroupId":39,"GroupName":"Newbie","JoinDate":1389481919,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276017.jpg?_r=1452312783","PhotoWidth":200,"PhotoHeight":139,"PhotoType":"custom"},"FormattedName":"LADYJUSTICE","Id":276017,"Name":"LADYJUSTICE","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"104.129.194.128","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78687,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"12e8f0ff9eaccace02405431fbd0f654","RawContent":"@LADYJUSTICE1 We are also using our own planner in Jamaica, instead of going through the cruise line.  We splurged by getting the Royal Suite during the cruise, so we are planning to have our \"reception\" in our room once we get back on the ship. We will have toasts\/speeches, cake, first dance, etc. at that time. Only negative for this is that it would be very expensive to have a bar in the room because it would be private. We will probably have everyone bring 2 bottles of champagne\/wine (allowed by the cruise) and have them bring the bottles to the room for the group to share.\n\n\nOur final reservation date is not until November,  so we have to wait until then to find out what group points we have earned. I&#039;m hoping to get a free specialty dinner, but not sure if that will be possible. We might be able to earn a free cocktail hour, but we will wait and see. \n\n\nWe will get credit for at least 1 \"free\" guest and possibly 2 based on the one free per 16. Are you using a travel agent to book the cruise? How many guests are you expecting?","Attachments":[],"Id":1902192,"PostDate":1439163811,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @LADYJUSTICE1 We are also using our own planner in Jamaica, instead of going through the cruise line.  We splurged by getting the Royal Suite during the cruise, so we are planning to have our \"reception\" in our room once we get back on the ship. We will have toasts\/speeches, cake, first dance, etc. at that time. Only negative for this is that it would be very expensive to have a bar in the room because it would be private. We will probably have everyone bring 2 bottles of champagne\/wine (allowed by the cruise) and have them bring the bottles to the room for the group to share.<br><br>\nOur final reservation date is not until November,  so we have to wait until then to find out what group points we have earned. I'm hoping to get a free specialty dinner, but not sure if that will be possible. We might be able to earn a free cocktail hour, but we will wait and see. <br><br>\nWe will get credit for at least 1 \"free\" guest and possibly 2 based on the one free per 16. Are you using a travel agent to book the cruise? How many guests are you expecting?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10743;484\/st\/20160413\/e\/Wedding+Day\/k\/c760\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n","Email":"lm_sprowl@hotmail.com","IpAddress":"75.26.164.62","GroupId":39,"GroupName":"Newbie","JoinDate":1418275431,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"cruisebride2016","Id":281378,"Name":"cruisebride2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.99.4.53","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78687,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"34528d65063abf939031421c8d517a63","RawContent":"&lt;p&gt;Hi ladies,&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am getting married on board the Freedom of the Seas this May. &amp;nbsp;We opted to get married during the first at sea day so we don&#039;t take away from our guests be able to explore the dock locations. &amp;nbsp;Several mentioned they have been really wanting to visit St. Thomas for a long time, which is where we would have wanted our wedding to be. &amp;nbsp;We have about 42 people cruising with us so far. &amp;nbsp;We will hire a photographer on St. Thomas and have a private photo session in our wedding attire, then go see the sights afterwards. &amp;nbsp;We are having a reception after the wedding alone with first dance, and cake. &amp;nbsp;The planning for me has been super easy so far, I&#039;m happy I decided to do it this way.   &lt;\/p&gt;","Attachments":[],"Id":1909165,"PostDate":1452285984,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi ladies,<\/p>\n<p>\u00a0<\/p>\n<p>I am getting married on board the Freedom of the Seas this May. \u00a0We opted to get married during the first at sea day so we don't take away from our guests be able to explore the dock locations. \u00a0Several mentioned they have been really wanting to visit St. Thomas for a long time, which is where we would have wanted our wedding to be. \u00a0We have about 42 people cruising with us so far. \u00a0We will hire a photographer on St. Thomas and have a private photo session in our wedding attire, then go see the sights afterwards. \u00a0We are having a reception after the wedding alone with first dance, and cake. \u00a0The planning for me has been super easy so far, I'm happy I decided to do it this way. \u00a0\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sfavors2@me.com","IpAddress":"24.99.4.53","GroupId":39,"GroupName":"Newbie","JoinDate":1452284914,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"slfavors","Id":285823,"Name":"slfavors","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.26.160.128","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78687,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9515a21ffac72ce3fd0b1048b36cb15c","RawContent":"@slfavor Congratulations!! You have a great number of guests. We are getting married in April and we have 23 guests. We are bringing a photographer (and her husband is paying his own way) along with us to take pictures the entire week. If you are taking pictures in St. Thomas, you are going to get dressed up in your wedding dress on two different days? Where does your cruise go? Did you book through a travel agent or on your own? Since you are getting married on the ship, you are probably working with the cruise wedding coordinators, right? We are not working with them at all. We are getting married in Jamaica, so we are using a wedding coordinator there. I hope we can be there to support each other through this process!!","Attachments":[],"Id":1909184,"PostDate":1452316180,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @slfavor Congratulations!! You have a great number of guests. We are getting married in April and we have 23 guests. We are bringing a photographer (and her husband is paying his own way) along with us to take pictures the entire week. If you are taking pictures in St. Thomas, you are going to get dressed up in your wedding dress on two different days? Where does your cruise go? Did you book through a travel agent or on your own? Since you are getting married on the ship, you are probably working with the cruise wedding coordinators, right? We are not working with them at all. We are getting married in Jamaica, so we are using a wedding coordinator there. I hope we can be there to support each other through this process!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10743;484\/st\/20160413\/e\/Wedding+Day\/k\/c760\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n","Email":"lm_sprowl@hotmail.com","IpAddress":"75.26.164.62","GroupId":39,"GroupName":"Newbie","JoinDate":1418275431,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"cruisebride2016","Id":281378,"Name":"cruisebride2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.99.4.53","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78687,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a2633380ecd2943bb0e317ed5ffd5bdd","RawContent":"Congratulations to you as well.  I was looking for a photographer to bring along without breaking the bank.  I got tired of looking and gave up. It&#039;s too time consuming and I&#039;m in school.  How did you find your photogher? And is she expensive?  Yes I am planning to just dress up two days. I really want some nice pics around the island.  the cruise goes to cococay, st Thomas, and st. Maarten.  We booked through a travel agent less work for me to add to my list.  I have been working with the cruise planner so far so good.  I&#039;ve read stories about how they can be, so I just prayed and not stressing.  I know everything will be great and most details can be handled on the ship.  We are doing an all white cocktail party.  We may have enough cruise points for it to be free.  Are you doing oot bags.  I am!! It&#039;s so much fun shopping for it all. Oh I created personalized luggage tags and sent to each booked guest along with passport requirements and how to sign in on the web.","Attachments":[],"Id":1909193,"PostDate":1452331095,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Congratulations to you as well.  I was looking for a photographer to bring along without breaking the bank.  I got tired of looking and gave up. It's too time consuming and I'm in school.  How did you find your photogher? And is she expensive?  Yes I am planning to just dress up two days. I really want some nice pics around the island.  the cruise goes to cococay, st Thomas, and st. Maarten.  We booked through a travel agent less work for me to add to my list.  I have been working with the cruise planner so far so good.  I've read stories about how they can be, so I just prayed and not stressing.  I know everything will be great and most details can be handled on the ship.  We are doing an all white cocktail party.  We may have enough cruise points for it to be free.  Are you doing oot bags.  I am!! It's so much fun shopping for it all. Oh I created personalized luggage tags and sent to each booked guest along with passport requirements and how to sign in on the web. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sfavors2@me.com","IpAddress":"24.99.4.53","GroupId":39,"GroupName":"Newbie","JoinDate":1452284914,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"slfavors","Id":285823,"Name":"slfavors","IsOnline":false}}],"Pages":{"TotalItems":16,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
