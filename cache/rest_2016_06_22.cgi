4-meandhim-grand-palladium-bavaro-nov-2015\/'>My Planning Thread<\/a>\u00a0- MeandHim - Grand Palladium Bavaro - Nov 25 2015<\/div>\n<div>\u00a0<\/div>\n<div><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10765;116\/st\/20151125\/e\/Our+Wedding\/k\/461e\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"markandshavonne@live.com","IpAddress":"70.30.85.211","GroupId":3,"GroupName":"Member","JoinDate":1365777659,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268499.jpg?_r=1448996983","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"Meandhim","Id":268499,"Name":"Meandhim","IsOnline":false}},"Posts":[],"Id":"76758","Title":"Budgeting For Tips... How Much?","LastPostDate":1429819125},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":9,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":889,"MovedTo":null,"MovedOn":0,"FirstPostId":1893695,"Rating":0,"RatingHits":0,"Starter":{"Id":277519,"Name":"veryvalentine","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277519.jpg?_r=1439827749","PhotoWidth":200,"PhotoHeight":132,"PhotoType":"custom"},"IsOnline":false},"StartDate":1429527321,"LastPoster":{"Id":265511,"Name":"TinkerSofi","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265511.jpg?_r=1442890536","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":60,"Preview":{"Id":1893695,"PostDate":1429527321,"PostContent":"Pinata at the reception? \u00a0 \u00a0 Is anyone considering doing a pinata for the wedding reception? \u00a0I s...","Author":{"Signature":"<div><br><div>\u00a0<\/div>\n<div>\u00a0<\/div>\n<div>Married on June 20th, 2015 at the Grand Sunset Princess Riviera Gazebo & Reception at the Chill Out with 60 guests<\/div>\n<div>\u00a0<\/div>\n<\/div>\n<div>\u00a0<\/div>\n<p>My planning thread:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/<\/a><\/p>\n<p>My review thread: \u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/<\/a>","Email":"rebecca.valero@gmail.com","IpAddress":"38.112.94.76","GroupId":3,"GroupName":"Member","JoinDate":1396968452,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277519.jpg?_r=1439827749","PhotoWidth":200,"PhotoHeight":132,"PhotoType":"custom"},"FormattedName":"veryvalentine","Id":277519,"Name":"veryvalentine","IsOnline":false}},"Posts":[],"Id":"79089","Title":"Pinata At The Reception?","LastPostDate":1429669122}],"Pages":{"TotalItems":2348,"TotalPages":157,"CurrentPage":30,"NextPage":45,"PreviousPage":15,"LastPage":2340},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
