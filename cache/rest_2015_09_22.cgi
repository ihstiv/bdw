dn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1904485,"PostDate":1441905187,"PostContent":"@Canadorecc Congrats and welcome! That's a lot of information you're asking for! My first questio...","Author":{"Signature":"<p><em><span style=\"color:rgb(51,153,255);\">I'm lucky enough to say yes again....October 20, 2015\u00a0<\/span><\/em>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},"Posts":[],"Id":"79573","Title":"2017 Wedding Planning","LastPostDate":1441905187},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":8,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":389,"MovedTo":null,"MovedOn":0,"FirstPostId":1903789,"Rating":0,"RatingHits":0,"Starter":{"Id":284629,"Name":"MartaPlauszta","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284629.jpg?_r=1441046545","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"StartDate":1441032089,"LastPoster":{"Id":278581,"Name":"beckys98","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1903789,"PostDate":1441032089,"PostContent":"Hello everyone , \u00a0 My fianc\u00e9 and I have been engaged