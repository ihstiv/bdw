width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Kind of funny how some people don't read the first post:D\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Tanyalovesroses@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1330378215,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-252008.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":233,"PhotoType":"custom"},"FormattedName":"Aynat","Id":252008,"Name":"Aynat","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":41818,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a13f3caa8933b7e42b10924d6bc4d967","RawContent":"[quote name=\"Aynat\"]\nKind of funny how some people don&#039;t read the first post:D[\/quote]No Aynat I just wanted to add to my posts...lol","Attachments":[],"Id":1707605,"PostDate":1358497451,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <blockquote class='ipsBlockquote' data-author=\"Aynat\" url=\"\/t\/48545\/how&#045;to&#045;download&#045;attachments&#045;updated&#045;1&#045;18&#045;2010\/60#post_1823410\"><p>Kind of funny how some people don't read the first post:D<\/p><\/blockquote>No Aynat I just wanted to add to my posts...lol\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"gladis.m@aol.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1349387018,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-261027.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Gladis","Id":261027,"Name":"Gladis","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":41818,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"16509358713fdb5cf491bbb758ce0710","RawContent":"[quote name=\"Tulumbride2013\"]\nGladis Once you have 150 posts you&#039;ll be a junior member[\/quote] Thank you sweetie....","Attachments":[],"Id":1707606,"PostDate":1358497481,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <blockquote class='ipsBlockquote' data-author=\"Tulumbride2013\" url=\"\/t\/48545\/how&#045;to&#045;download&#045;attachments&#045;updated&#045;1&#045;18&#045;2010\/60#post_1823388\"><p>Gladis Once you have 150 posts you'll be a junior member<\/p><\/blockquote> Thank you sweetie....\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"gladis.m@aol.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1349387018,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-261027.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Gladis","Id":261027,"Name":"Gladis","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":41818,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f2878d9a4e37e2fa46c882b1add22d94","RawContent":"&lt;p&gt; This thread is helpful thanks!&lt;\/p&gt;","Attachments":[],"Id":1712668,"PostDate":1359415626,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> This thread is helpful thanks!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nothanks@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1354997378,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-263070.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"kmmathes","Id":263070,"Name":"kmmathes","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":41818,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4f43661dfef5e189a1f341d44aeeaa9b","RawContent":"&lt;p&gt; I&#039;ve just donated to be a supporter! This site is so great and has helped probably millions of brides plan their tropical weddings, mine included! The frustrating part is the forum post count thing. 150 is unreasonable. Could take me years!! I became a supporter so I could respond to posts quicker and be able to share files, but it still says \"Because you&#039;re new....\" whenever I post something! I&#039;m not new!! Can we relax the forum post count number a bit, or at least for us supporters please?? The 150 requirement almost encourages spamming doesn&#039;t it?? And the quote below is misleading...&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;b id=\"yui_3_7_3_1_1363907550662_828\"&gt;\"To reach \"junior member\" status you need to have a minimum of 150 posts.&lt;\/b&gt;\n \n &lt;b id=\"yui_3_7_3_1_1363907550662_658\"&gt;- or -\n \n You can by-pass the post count by purchasing a Site Supporter membership.&lt;\/b&gt;\n \n &lt;b id=\"yui_3_7_3_1_1363907550662_656\"&gt;To Purchase a Supporter Membership to download attachment in lieu of the post count requirement please follow these instructions.&lt;\/b&gt;\"&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I thought by becoming a supporter I would also become a junior member. If you read the above quote, it is easy to understand why I might have come to this conclusion! Please let me know if there is anything you can do about letting me finally attain junior member status, so I can be more active in the boards.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Thank you,&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Vanessa&lt;\/p&gt;","Attachments":[],"Id":1736871,"PostDate":1363911788,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I've just donated to be a supporter! This site is so great and has helped probably millions of brides plan their tropical weddings, mine included! The frustrating part is the forum post count thing. 150 is unreasonable. Could take me years!! I became a supporter so I could respond to posts quicker and be able to share files, but it still says \"Because you're new....\" whenever I post something! I'm not new!! Can we relax the forum post count number a bit, or at least for us supporters please?? The 150 requirement almost encourages spamming doesn't it?? And the quote below is misleading...<\/p> <p> \u00a0<\/p> <p> <b id=\"yui_3_7_3_1_1363907550662_828\">\"To reach \"junior member\" status you need to have a minimum of 150 posts.<\/b><br \/> <br \/> <b id=\"yui_3_7_3_1_1363907550662_658\">- or -<br \/> <br \/> You can by-pass the post count by purchasing a Site Supporter membership.<\/b><br \/> <br \/> <b id=\"yui_3_7_3_1_1363907550662_656\">To Purchase a Supporter Membership to download attachment in lieu of the post count requirement please follow these instructions.<\/b>\"<\/p> <p> \u00a0<\/p> <p> I thought by becoming a supporter I would also become a junior member. If you read the above quote, it is easy to understand why I might have come to this conclusion! Please let me know if there is anything you can do about letting me finally attain junior member status, so I can be more active in the boards.<\/p> <p> \u00a0<\/p> <p> Thank you,<\/p> <p> \u00a0<\/p> <p> Vanessa<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"vanessarosemills@gmail.com","IpAddress":"","GroupId":47,"GroupName":"Site Supporter","JoinDate":1353263113,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-262471.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"Happy2BMrsMills","Id":262471,"Name":"Happy2BMrsMills","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":41818,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"54df1d4fad929bb7af35cda094b0d28d","RawContent":"Hi, \n \n As a supporter, you actually have junior member as a usergroup BUT since only one usergroup can show (like I have junior member, moderator, senior member, etc. but only only \"administrator\" shows) and supporter is a higher usergroup. \n \n Since you are now a \"supporter\" you no longer need to reach the 150 post count to download attachments.  Sometimes this change in usergroup does not happen immediately so there may be a delay of a day to download the attachments. \n \n If you would like, I can manually remove the supporter badge and just have it show junior member but not sure why you would want that since you should be proud to show that you are a supporter of the site. [quote]\nOriginally Posted by [b]Happy2BMrsMills[\/b] \/img\/forum\/go_quote.gif\n \n \n I&#039;ve just donated to be a supporter! This site is so great and has helped probably millions of brides plan their tropical weddings, mine included! The frustrating part is the forum post count thing. 150 is unreasonable. Could take me years!! I became a supporter so I could respond to posts quicker and be able to share files, but it still says \"Because you&#039;re new....\" whenever I post something! I&#039;m not new!! Can we relax the forum post count number a bit, or at least for us supporters please?? The 150 requirement almost encourages spamming doesn&#039;t it?? And the quote below is misleading... \n \n [b]\"To reach \"junior member\" status you need to have a minimum of 150 posts.[\/b]\n \n [b]- or -\n \n You can by-pass the post count by purchasing a Site Supporter membership.[\/b]\n \n [b]To Purchase a Supporter Membership to download attachment in lieu of the post count requirement please follow these instructions.[\/b]\" \n \n I thought by becoming a supporter I would also become a junior member. If you read the above quote, it is easy to understand why I might have come to this conclusion! Please let me know if there is anything you can do about letting me finally attain junior member status, so I can be more active in the boards. \n \n Thank you, \n \n Vanessa[\/quote]","Attachments":[],"Id":1736954,"PostDate":1363924331,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hi,<\/p> <p> \u00a0<\/p> <p> As a supporter, you actually have junior member as a usergroup BUT since only one usergroup can show (like I have junior member, moderator, senior member, etc. but only only \"administrator\" shows) and supporter is a higher usergroup.<\/p> <p> \u00a0<\/p> <p> Since you are now a \"supporter\" you no longer need to reach the 150 post count to download attachments. \u00a0Sometimes this change in usergroup does not happen immediately so there may be a delay of a day to download the attachments.<\/p> <p> \u00a0<\/p> <p> If you would like, I can manually remove the supporter badge and just have it show junior member but not sure why you would want that since you should be proud to show that you are a supporter of the site.<\/p> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>Happy2BMrsMills<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <p> I've just donated to be a supporter! This site is so great and has helped probably millions of brides plan their tropical weddings, mine included! The frustrating part is the forum post count thing. 150 is unreasonable. Could take me years!! I became a supporter so I could respond to posts quicker and be able to share files, but it still says \"Because you're new....\" whenever I post something! I'm not new!! Can we relax the forum post count number a bit, or at least for us supporters please?? The 150 requirement almost encourages spamming doesn't it?? And the quote below is misleading...<\/p> <p> \u00a0<\/p> <p> <b id=\"yui_3_7_3_1_1363907550662_828\">\"To reach \"junior member\" status you need to have a minimum of 150 posts.<\/b><br \/> <br \/> <b id=\"yui_3_7_3_1_1363907550662_658\">- or -<br \/> <br \/> You can by-pass the post count by purchasing a Site Supporter membership.<\/b><br \/> <br \/> <b id=\"yui_3_7_3_1_1363907550662_656\">To Purchase a Supporter Membership to download attachment in lieu of the post count requirement please follow these instructions.<\/b>\"<\/p> <p> \u00a0<\/p> <p> I thought by becoming a supporter I would also become a junior member. If you read the above quote, it is easy to understand why I might have come to this conclusion! Please let me know if there is anything you can do about letting me finally attain junior member status, so I can be more active in the boards.<\/p> <p> \u00a0<\/p> <p> Thank you,<\/p> <p> \u00a0<\/p> <p> Vanessa<\/p> <\/blockquote>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-family:arial, helvetica, sans-serif;\">Founder and Owner of BestDestinationWedding.com \u00a0\/ \u00a0<\/span><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/'><strong><span style=\"font-family:arial, helvetica, sans-serif;\">Bride & Groom Fly FREE Promotion<\/span><\/strong><\/a><\/p>\n<p>\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><strong><a data-ipb='nomediaparse' href='http:\/\/wrighttravelagency.com\/inquiry\/'><span style=\"color:#008080;\">Looking for a travel agency that specializes in Destination Weddings<\/span><\/a><\/strong><span style=\"color:#008080;\"><strong>?<\/strong> \u00a0We are an award winning travel agency and you can <\/span><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style=\"color:#008080;\">read our reviews\u00a0here.<\/span><\/a><\/strong><\/span><br>\n\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"color:#008080;\"><strong>Awards and recognition:\u00a0<\/strong><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Palace Resorts PRO Platinum Agency (Top Award) \u00a0 \u00a0 | \u00a0 \u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">AMResorts Master Agent & Top Agency \u00a0<\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/68050-karisma-hotels-givc-and-gi-wedding-consultants-wright-travel-agency\/'><strong>Wright Travel & Karisma GIVC Benefits<\/strong><\/a><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Travel Impressions Best of the Best Globe Winner \u00a0 \u00a0| \u00a0 \u00a0\u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Apple Vacations Golden Apple Winner \u00a0<\/span><\/span><br><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"> \u00a0 \u00a0<img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/alb