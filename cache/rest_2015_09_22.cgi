:{"Signature":"","Email":"mimirdh1@aol.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1221277713,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211702.gif?_r=0","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"rdhbride","Id":211702,"Name":"rdhbride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":38437,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"073e505862c0887454941429858dcc0d","RawContent":"Your review was definately helpful. Thank you so much!","Attachments":[],"Id":784342,"PostDate":1249105406,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Your review was definately helpful. Thank you so much!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nolanss@hotmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1245773460,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-218714.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"SSNM","Id":218714,"Name":"SSNM","IsOnline":false}}],"Pages":{"TotalItems":32,"TotalPages":4,"CurrentPage":10,"NextPage":20,"PreviousPage":0,"LastPage":30},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
