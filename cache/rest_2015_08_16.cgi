{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":18,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":4199,"MovedTo":null,"MovedOn":0,"FirstPostId":1143404,"Rating":0,"RatingHits":0,"Starter":{"Id":228002,"Name":"elopingbride11","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-228002.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"IsOnline":false},"StartDate":1273384871,"LastPoster":{"Id":275369,"Name":"zumbaguy","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275369.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":31,"Preview":{"Id":1817407,"PostDate":1385630268,"PostContent":"Elopingbride11, \u00a0 Looks like some difficulty with the DVDs. I'm very interested in the last propo...","Author":{"Signature":"","Email":"adam.clark@jhu.edu","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1385629545,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275369.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"zumbaguy","Id":275369,"Name":"zumbaguy","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":51698,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3ae84638c18d09669a5d8299ed053df0","RawContent":"My Fiance &amp;amp; I are planning a trip to Vegas in July &amp;amp; also thinking about going back to get married. were gonna do a lil touring to see if it&#039;s our idea place. any info that i bring back i will sure to let you know :)","Attachments":[],"Id":1174430,"PostDate":1275848517,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                My Fiance & I are planning a trip to Vegas in July & also thinking about going back to get married. were gonna do a lil touring to see if it's our idea place. any info that i bring back i will sure to let you know <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tinavardy@live.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1275795540,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-228905.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"newfiegal75","Id":228905,"Name":"newfiegal75","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":51698,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"141dced1aff87d3469e8a5ee96eac158","RawContent":"We stayed at Mandalay Bay twice and loved it.\n I know someone who got married at Mandalay and they had a small group of people with them. For their reception. they rented a large suite and brought in their own food and had their reception up there. \n I did notice though that on a Saturday at Mandalay Bay, it was back to back weddings\u00e2\u20ac\u00a6 multiple couples standing around outside waiting for their turn so another day might be better if you don\u00e2\u20ac\u2122t want to be rushed like that. Mandalay Bay Chapel was very nice.\n The only other chapel that I&#039;ve seen is person was at the Luxor and in person it looked like a funeral home. The lighting is set up so the focus is behind where the priest would stand and not on the couple. It was just weird.\n \n We&#039;ve used Priceline many times when going to Vegas and have always got a great deal and never regretted it.","Attachments":[],"Id":1184203,"PostDate":1276570870,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We stayed at Mandalay Bay twice and loved it.<br \/> I know someone who got married at Mandalay and they had a small group of people with them. For their reception. they rented a large suite and brought in their own food and had their reception up there. <br \/> I did notice though that on a Saturday at Mandalay Bay, it was back to back weddings\u00e2\u20ac\u00a6 multiple couples standing around outside waiting for their turn so another day might be better if you don\u00e2\u20ac\u2122t want to be rushed like that. Mandalay Bay Chapel was very nice.<br \/> The only other chapel that I've seen is person was at the Luxor and in person it looked like a funeral home. The lighting is set up so the focus is behind where the priest would stand and not on the couple. It was just weird.<br \/> <br \/> We've used Priceline many times when going to Vegas and have always got a great deal and never regretted it.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;131\/st\/20091018\/e\/Our+Wedding\/dt\/-1\/k\/b25c\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...b25c\/event.png<\/a><\/div><\/div>","Email":"patriciaspiegel@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1225354320,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-212466.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"mspattemac","Id":212466,"Name":"mspattemac","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":51698,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f3c3d164ebf2656e3d4845919943db82","RawContent":"I have a friend who lives in vegas.. She just got married at the GROVE.. it&#039;s a beautiful location off of the strip. about a 30 minute drive!!!! \n \n It usually stays warmer there longer than it does here in PA. She sends texts of the temperature : ) \n \n I just stayed at excalibur and didn&#039;t really care for it.. The casino is very smoky. ... not well ventilated. I know that some of the more expensive casinos have better ventilation.","Attachments":[],"Id":1184260,"PostDate":1276573870,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I have a friend who lives in vegas.. She just got married at the GROVE.. it's a beautiful location off of the strip. about a 30 minute drive!!!! <br \/> <br \/> It usually stays warmer there longer than it does here in PA. She sends texts of the temperature : ) <br \/> <br \/> I just stayed at excalibur and didn't really care for it.. The casino is very smoky. ... not well ventilated. I know that some of the more expensive casinos have better ventilation.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mdurkin1@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1271617064,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-227433.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"mdb","Id":227433,"Name":"mdb","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":51698,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f435943871855bf6f61535a20cf4c10d","RawContent":"&lt;p&gt; Went to a destination wedding in Vegas in February 2008 @ Treasure Island!&amp;nbsp; The wedding was beautiful in the Chapel.&amp;nbsp; There was about 30 of us and an added bonus was the wedding was done via satelite so everyone back home in Canada who couldnt make it got to see the wedding ceremony!! And I agree&amp;nbsp;$4000 is more than enough!!&lt;\/p&gt;","Attachments":[],"Id":1234299,"PostDate":1280293714,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Went to a destination wedding in Vegas in February 2008 @ Treasure Island!\u00a0 The wedding was beautiful in the Chapel.\u00a0 There was about 30 of us and an added bonus was the wedding was done via satelite so everyone back home in Canada who couldnt make it got to see the wedding ceremony!! And I agree\u00a0$4000 is more than enough!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>\"It's ok to throw rocks at girls...as long as they sparkle!!\"<\/span><br><br><span>PrInCeSs-JoY<\/span><\/div><\/div>","Email":"princessjoy_204@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1266123588,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-225578.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"radiant_princess","Id":225578,"Name":"radiant_princess","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":51698,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"994169c5c82316611eed866727dba2d9","RawContent":"&lt;p&gt; I am getting married in October of this year and we&#039;re doing it at a chapel and staying at the Vdara. I too have never been to Vegas but have found that so far the Vdara has been nothing but extremely helpful. The concierge has been an incredible help and the hotel is still new so from the pictures it looks amazing. (I will let you know more upon my return).&lt;\/p&gt; &lt;p&gt; However, I have already experienced the overpricing on the wedding photos from the chapel and will say if I could have another option I wouldn&#039;t be using their services. But we&#039;re going to take our camera and have fun.&lt;\/p&gt; &lt;p&gt; Our budget is 2k and we&#039;re finding it very easy to stay within that and still have something memorable and nice.&lt;\/p&gt; &lt;p&gt; Good Luck&lt;\/p&gt;","Attachments":[],"Id":1247843,"PostDate":1281392072,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I am getting married in October of this year and we're doing it at a chapel and staying at the Vdara. I too have never been to Vegas but have found that so far the Vdara has been nothing but extremely helpful. The concierge has been an incredible help and the hotel is still new so from the pictures it looks amazing. (I will let you know more upon my return).<\/p> <p> However, I have already experienced the overpricing on the wedding photos from the chapel and will say if I could have another option I wouldn't be using their services. But we're going to take our camera and have fun.<\/p> <p> Our budget is 2k and we're finding it very easy to stay within that and still have something memorable and nice.<\/p> <p> Good Luck<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"danielle.ayers@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1281030025,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-231049.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"futuremrsjrj","Id":231049,"Name":"futuremrsjrj","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":51698,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"76fea7e146c0a04e2eb775f97a9236f4","RawContent":"&lt;p&gt; I live in Vegas so if you have any questions just let me know!&amp;nbsp; Vegas is warm May-Sept.&amp;nbsp; It is beautiful sunny and 70 degree weather October, Novemeber, March and April but can still have some cold days here and there.&amp;nbsp; Red Rock and Green Valley Ranch are two&amp;nbsp;a beautiful hotels that are off the strip but have casinos, buffets and are more economical sometimes.&amp;nbsp;A friend of mine got their Red Rock room on Priceline for under $75 but they put 89135 as the zip with a five star hotel. The pool is amazing and mountain view all around.&amp;nbsp; &amp;nbsp; It is the only one in the zipcode so&amp;nbsp;your really not taking a chance of getting a hotel that you dont want.&amp;nbsp; &amp;nbsp;They run lots of specials.&amp;nbsp; I can tell you about great restraunts too if your intersted.&amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Cheers&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1247856,"PostDate":1281392571,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I live in Vegas so if you have any questions just let me know!\u00a0 Vegas is warm May-Sept.\u00a0 It is beautiful sunny and 70 degree weather October, Novemeber, March and April but can still have some cold days here and there.\u00a0 Red Rock and Green Valley Ranch are two\u00a0a beautiful hotels that are off the strip but have casinos, buffets and are more economical sometimes.\u00a0A friend of mine got their Red Rock room on Priceline for under $75 but they put 89135 as the zip with a five star hotel. The pool is amazing and mountain view all around.\u00a0 \u00a0 It is the only one in the zipcode so\u00a0your really not taking a chance of getting a hotel that you dont want.\u00a0 \u00a0They run lots of specials.\u00a0 I can tell you about great restraunts too if your intersted.\u00a0<\/p> <p> \u00a0<\/p> <p> Cheers<\/p> <p> \u00a0<\/p> <p> \u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Steph and Kel Mayan Riveria - February 2011<\/span><a data-ipb='nomediaparse' href=\"http:\/\/www.stephnkelwedding.com\"><strong>http:\/\/www.stephnkelwedding.com<\/strong><\/a><\/div><\/div>","Email":"sspiris@gmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1245125403,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-218478.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"SDSteph","Id":218478,"Name":"SDSteph","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":51698,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0a92479ae55a1cc8bc0d1735ec4fda36","RawContent":"&lt;p&gt;ElopingBride11,&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;I see there&#039;s some trouble with the DVD postings.&lt;\/p&gt; &lt;p&gt;I am still very interested in your last proposal.&lt;\/p&gt; &lt;p&gt;Can you share the details of the continuing ed DVDs?&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;In the first msg I sent in the bottom was my email address.&lt;\/p&gt; &lt;p&gt;until then !&lt;\/p&gt;","Attachments":[],"Id":1817406,"PostDate":1385629677,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>ElopingBride11,<\/p> <p>\u00a0<\/p> <p>I see there's some trouble with the DVD postings.<\/p> <p>I am still very interested in your last proposal.<\/p> <p>Can you share the details of the continuing ed DVDs?<\/p> <p>\u00a0<\/p> <p>In the first msg I sent in the bottom was my email address.<\/p> <p>until then !<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"adam.clark@jhu.edu","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1385629545,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275369.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"zumbaguy","Id":275369,"Name":"zumbaguy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":51698,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"49349dae27ad0b0ac4ffa76d5e19dc48","RawContent":"&lt;p&gt;Elopingbride11,&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;Looks like some difficulty with the DVDs.&lt;\/p&gt; &lt;p&gt;I&#039;m very interested in the last proposal, and would love more details.&lt;\/p&gt; &lt;p&gt;In the first msg I sent, my email was included at the bottom!&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;let me know - until then&lt;\/p&gt;","Attachments":[],"Id":1817407,"PostDate":1385630268,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Elopingbride11,<\/p> <p>\u00a0<\/p> <p>Looks like some difficulty with the DVDs.<\/p> <p>I'm very interested in the last proposal, and would love more details.<\/p> <p>In the first msg I sent, my email was included at the bottom!<\/p> <p>\u00a0<\/p> <p>let me know - until then<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"adam.clark@jhu.edu","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1385629545,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275369.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"zumbaguy","Id":275369,"Name":"zumbaguy","IsOnline":false}}],"Id":"51698","Title":"Need Advise for Vegas Elopement","LastPostDate":1385630268},"Pages":{"TotalItems":18,"TotalPages":2,"CurrentPage":10,"NextPage":-1,"PreviousPage":0,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
