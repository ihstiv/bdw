{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26001,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1dc8652d74ff820c964b3f80017e6f3f","RawContent":"We are planning on getting married in the Venetian Chapel on 1st April 2010 and having our meal at Maggianos - anybody had any dealings with either?\n All views\/suggestions welcome - thanks.","Attachments":[],"Id":756410,"PostDate":1247436964,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We are planning on getting married in the Venetian Chapel on 1st April 2010 and having our meal at Maggianos - anybody had any dealings with either?<br \/> All views\/suggestions welcome - thanks.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"clargill@supanet.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1247340588,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-219322.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"April2010","Id":219322,"Name":"April2010","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26001,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f358cd25a8c9dc4adfee41f3e78f286b","RawContent":"Hi April 2010, I am having my reception at Maggianos on Sept 5th! Cassy was great to deal with there. How many people do you have going down? I can repond here again after my wedding and let you know how everything went at Maggianos!!","Attachments":[],"Id":801120,"PostDate":1250288434,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi April 2010, I am having my reception at Maggianos on Sept 5th! Cassy was great to deal with there. How many people do you have going down? I can repond here again after my wedding and let you know how everything went at Maggianos!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cmbeck@shaw.ca","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1228951507,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213108.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"myturn","Id":213108,"Name":"myturn","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26001,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d926e1ad5883a50105e50adf71ac33f4","RawContent":"Hi Myturn so far we have 35 going how many do you have? - It&#039;s Cassy I&#039;ve dealt with so far and she&#039;s been good - yes please let me know how it goes - good luck and hope all goes well.","Attachments":[],"Id":801928,"PostDate":1250339142,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi Myturn so far we have 35 going how many do you have? - It's Cassy I've dealt with so far and she's been good - yes please let me know how it goes - good luck and hope all goes well.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"clargill@supanet.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1247340588,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-219322.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"April2010","Id":219322,"Name":"April2010","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26001,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"df4e4f754fe8eda6f10351f9542a5c1e","RawContent":"We have 50 people going down with us. We are in the Callabria (or something like that) room at Maggianos. Cassy was very accomodating and great with answering all my questions!! I did bug her with a lot of questions and she was great. I will post in a few weeks and let you know how the food and service was!","Attachments":[],"Id":804834,"PostDate":1250577230,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We have 50 people going down with us. We are in the Callabria (or something like that) room at Maggianos. Cassy was very accomodating and great with answering all my questions!! I did bug her with a lot of questions and she was great. I will post in a few weeks and let you know how the food and service was!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cmbeck@shaw.ca","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1228951507,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213108.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"myturn","Id":213108,"Name":"myturn","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26001,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cd0e9944ebd4045886b83853d5c983a2","RawContent":"just curious is anyone providing OOT bags for their vegas weddings and if so what are you putting in them?","Attachments":[],"Id":807044,"PostDate":1250712806,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                just curious is anyone providing OOT bags for their vegas weddings and if so what are you putting in them?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"dglthibodeau@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1250235210,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-220520.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Puzzled-Bride","Id":220520,"Name":"Puzzled-Bride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26001,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"112cb3398eae2bb0a16debaff6c32a75","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;Puzzled-Bride&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;just curious is anyone providing OOT bags for their vegas weddings and if so what are you putting in them?&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;My plan was to do them but as it&#039;s getting closer I just may not have the time! We are doing a welcome party the Thursday before the wedding (when most people are flying in) so I was going to hand them out then.","Attachments":[],"Id":807429,"PostDate":1250726877,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>Puzzled-Bride<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">just curious is anyone providing OOT bags for their vegas weddings and if so what are you putting in them?<\/div> <\/td> <\/tr> <\/table> <\/div>My plan was to do them but as it's getting closer I just may not have the time! We are doing a welcome party the Thursday before the wedding (when most people are flying in) so I was going to hand them out then.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i35.tinypic.com\/1076iaf.jpg\">http:\/\/i35.tinypic.com\/1076iaf.jpg<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/www.ezticker.com\/ticker\/1202\/1007\/20090919\/Our+Wedding%21\/ticker.png\">http:\/\/www.ezticker.com\/ticker\/1202\/...%21\/ticker.png<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f77\/foxybrides-extremely-detailed-las-vegas-wedding-review-49821\/\">FoxyBride's Las Vegas Wedding Review Thread<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f128\/foxybrides-past-due-planning-thread-49781\/\">FoxyBride's Las Vegas Planning Thread<\/a><\/div><\/div>","Email":"alfox@umich.edu","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1221389100,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211713.gif?_r=0","PhotoWidth":100,"PhotoHeight":81,"PhotoType":"custom"},"FormattedName":"FoxyBride","Id":211713,"Name":"FoxyBride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26001,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"117810602fb5b81c15380a42fb4a3eab","RawContent":"I am getting married at Viva Las Vegas weddings on September 5th, 2009.\n &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile29.gif\" border=\"0\" alt=\"\" title=\"Smile29\" class=\"inlineimg\" \/&gt;","Attachments":[],"Id":810303,"PostDate":1250899238,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I am getting married at Viva Las Vegas weddings on September 5th, 2009.<br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile29.gif\" border=\"0\" alt=\"\" title=\"Smile29\" class=\"inlineimg\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mjennings@wesleyan.edu","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1250885762,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-220798.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"gigglesoup","Id":220798,"Name":"gigglesoup","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26001,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f243f86a8b8093691e05b7898303be40","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;Puzzled-Bride&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;just curious is anyone providing OOT bags for their vegas weddings and if so what are you putting in them?&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;I am...mine will include...monogrammed tumblers, hangover kits, snacks, shot glass, toiletries for men\/women, welcome letter, itinerary, and whatever free stuff I can pick up as I am arriving before my guests....\n \n I am renting a cabana at the hotel we are staying at so maybe I will hand them out then or as guest arrive since everyone is not staying at the same hotel....","Attachments":[],"Id":814328,"PostDate":1251230285,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>Puzzled-Bride<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">just curious is anyone providing OOT bags for their vegas weddings and if so what are you putting in them?<\/div> <\/td> <\/tr> <\/table> <\/div>I am...mine will include...monogrammed tumblers, hangover kits, snacks, shot glass, toiletries for men\/women, welcome letter, itinerary, and whatever free stuff I can pick up as I am arriving before my guests....<br \/> <br \/> I am renting a cabana at the hotel we are staying at so maybe I will hand them out then or as guest arrive since everyone is not staying at the same hotel....\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/www.mywedding.com\/shannonbrian\/\">http:\/\/www.mywedding.com\/shannonbrian\/<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/img.weddingcountdown.com\/ticker\/7sezqwmt8.png\">http:\/\/img.weddingcountdown.com\/ticker\/7sezqwmt8.png<\/a><\/div><\/div>","Email":"shyste1s@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1239742449,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-216716.gif?_r=0","PhotoWidth":75,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"shan13","Id":216716,"Name":"shan13","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26001,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c26ec0b7409d4a63f8e348bf3d543daf","RawContent":"I was also thinking about doing OOT bags! I was gonna include snacks, water, welcome letter, itinerary, koozies and a hangover kit. We have spoke to our wedding coordinator and will be leaving the bags with the front desk to place in our guests rooms upon arrival\n Just not sure what to put inside the hangover kit. I see you were gonna include one as well Shannon....any ideas??","Attachments":[],"Id":815918,"PostDate":1251318313,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I was also thinking about doing OOT bags! I was gonna include snacks, water, welcome letter, itinerary, koozies and a hangover kit. We have spoke to our wedding coordinator and will be leaving the bags with the front desk to place in our guests rooms upon arrival<br \/> Just not sure what to put inside the hangover kit. I see you were gonna include one as well Shannon....any ideas??\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"canadianheather@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1226355365,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-212620.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"canadianheather","Id":212620,"Name":"canadianheather","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26001,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1da68df2d91a76d960332864cad3c42c","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;canadianheather&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;I was also thinking about doing OOT bags! I was gonna include snacks, water, welcome letter, itinerary, koozies and a hangover kit. We have spoke to our wedding coordinator and will be leaving the bags with the front desk to place in our guests rooms upon arrival\n Just not sure what to put inside the hangover kit. I see you were gonna include one as well Shannon....any ideas??&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;Mine are gonna include..\n \n ibuprofen\n propel water pack (singles, to go)\n alka seltzer\n gum\/mints\n colgate wisps\n \n \n My water bottles will be in the oot box\/bag....I also plan to put the kits in the oot box\/bag as well...if a couple I will do 2 hangover kits in 1 box\/bag!..hth!","Attachments":[],"Id":818052,"PostDate":1251424698,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>canadianheather<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">I was also thinking about doing OOT bags! I was gonna include snacks, water, welcome letter, itinerary, koozies and a hangover kit. We have spoke to our wedding coordinator and will be leaving the bags with the front desk to place in our guests rooms upon arrival<br \/> Just not sure what to put inside the hangover kit. I see you were gonna include one as well Shannon....any ideas??<\/div> <\/td> <\/tr> <\/table> <\/div>Mine are gonna include..<br \/> <br \/> ibuprofen<br \/> propel water pack (singles, to go)<br \/> alka seltzer<br \/> gum\/mints<br \/> colgate wisps<br \/> <br \/> <br \/> My water bottles will be in the oot box\/bag....I also plan to put the kits in the oot box\/bag as well...if a couple I will do 2 hangover kits in 1 box\/bag!..hth!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/www.mywedding.com\/shannonbrian\/\">http:\/\/www.mywedding.com\/shannonbrian\/<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/img.weddingcountdown.com\/ticker\/7sezqwmt8.png\">http:\/\/img.weddingcountdown.com\/ticker\/7sezqwmt8.png<\/a><\/div><\/div>","Email":"shyste1s@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1239742449,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-216716.gif?_r=0","PhotoWidth":75,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"shan13","Id":216716,"Name":"shan13","IsOnline":false}}],"Pages":{"TotalItems":146,"TotalPages":15,"CurrentPage":60,"NextPage":70,"PreviousPage":50,"LastPage":140},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
