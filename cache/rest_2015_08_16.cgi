{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26001,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b9b053f1e8dff139fd674a1d4318c587","RawContent":"I&#039;m getting married in the Valley of Fire in September - want to know if anyone has used or heard from anyone about using 702weddings to book their wedding - they only have testimonials on their page about their chapel, not the outdoor weddings. any reviews would be really helpful, I&#039;m thinking of using them because their photography looks better than others. thanks!","Attachments":[],"Id":588570,"PostDate":1234325174,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm getting married in the Valley of Fire in September - want to know if anyone has used or heard from anyone about using 702weddings to book their wedding - they only have testimonials on their page about their chapel, not the outdoor weddings. any reviews would be really helpful, I'm thinking of using them because their photography looks better than others. thanks!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"leisajjames@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1233735179,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-214605.gif?_r=0","PhotoWidth":150,"PhotoHeight":131,"PhotoType":"custom"},"FormattedName":"AussieGal","Id":214605,"Name":"AussieGal","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26001,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4fd1f5e9490e96c74d80a161bb6881bc","RawContent":"HI, and thanks it does help alot. there only going to be about ten of us or so.","Attachments":[],"Id":589053,"PostDate":1234359882,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                HI, and thanks it does help alot. there only going to be about ten of us or so.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"germeseh@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1231134772,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/7\/7a\/7a4a19d5_user-12438-avatar?_r=0","PhotoWidth":0,"PhotoHeight":0,"PhotoType":"custom"},"FormattedName":"meseh","Id":213585,"Name":"meseh","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26001,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"222bc65d2294f572eb2bfd64c3995190","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;AussieGal&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;I&#039;m getting married in the Valley of Fire in September - want to know if anyone has used or heard from anyone about using 702weddings to book their wedding - they only have testimonials on their page about their chapel, not the outdoor weddings. any reviews would be really helpful, I&#039;m thinking of using them because their photography looks better than others. thanks!&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;I don&#039;t know what company they used, but PM starchild a very good friend of hers got married in the valley of fire and it was beautiful. They had a great time. \n \n I was engaged there and just to warn you its almost always windy there, but its absolutely stunning!","Attachments":[],"Id":592970,"PostDate":1234723526,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>AussieGal<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">I'm getting married in the Valley of Fire in September - want to know if anyone has used or heard from anyone about using 702weddings to book their wedding - they only have testimonials on their page about their chapel, not the outdoor weddings. any reviews would be really helpful, I'm thinking of using them because their photography looks better than others. thanks!<\/div> <\/td> <\/tr> <\/table> <\/div>I don't know what company they used, but PM starchild a very good friend of hers got married in the valley of fire and it was beautiful. They had a great time. <br \/> <br \/> I was engaged there and just to warn you its almost always windy there, but its absolutely stunning!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<strong>Christine + Will (married 7\/20\/07) + Ainsleigh (born 6\/25\/08) + Nolan (born 11\/9\/10) + Delaney (born 12\/31\/13) = One Very Happy Family!<\/strong>","Email":"christine@dc-hulls.com","IpAddress":"167.154.70.240","GroupId":46,"GroupName":"VIP Member","JoinDate":1165989180,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206965.gif?_r=0","PhotoWidth":100,"PhotoHeight":67,"PhotoType":"custom"},"FormattedName":"Christine","Id":206965,"Name":"Christine","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26001,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"986eea0f2f9839deebfa4f66c2d03f72","RawContent":"Hello All:\n \n We are also getting married in Vegas on September 9, 2009. We are expecting around 40 guests (33 have already booked). I thought planning a Vegas wedding would be a breeze, but it was a harder than I thought. Mainly, because we needed to know the number of guest in order to properly book a venue. We didn&#039;t want to pay for guest we weren&#039;t expecting. A lot of places who do package weddings have a minimum and you pay the same price whether you have that number of guest or not. So, I sent out a save the date and told everyone that they needed to tell me by tomorrow. We will now work on sending invites. I feel a huge burden has been lifted, now I can properly plan!\n \n Good luck to all my fellow Vegas Brides....","Attachments":[],"Id":599222,"PostDate":1235199603,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hello All:<br \/> <br \/> We are also getting married in Vegas on September 9, 2009. We are expecting around 40 guests (33 have already booked). I thought planning a Vegas wedding would be a breeze, but it was a harder than I thought. Mainly, because we needed to know the number of guest in order to properly book a venue. We didn't want to pay for guest we weren't expecting. A lot of places who do package weddings have a minimum and you pay the same price whether you have that number of guest or not. So, I sent out a save the date and told everyone that they needed to tell me by tomorrow. We will now work on sending invites. I feel a huge burden has been lifted, now I can properly plan!<br \/> <br \/> Good luck to all my fellow Vegas Brides....\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sweetnessazj@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1231758914,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213871.gif?_r=0","PhotoWidth":73,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"wededbliss2010","Id":213871,"Name":"wededbliss2010","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26001,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a48d195c36ff227ac3d8e5719625bd0c","RawContent":"I&#039;m getting married in June in Las Vegas. We will be having a small ceremony in one of the suites in MGM. Almost everything is booked and paid for. Very, very excited but a little worried that not everything will be set up as I had planned.","Attachments":[],"Id":661092,"PostDate":1240266016,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm getting married in June in Las Vegas. We will be having a small ceremony in one of the suites in MGM. Almost everything is booked and paid for. Very, very excited but a little worried that not everything will be set up as I had planned.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/www.ezticker.com\/ticker\/1175\/710\/20090601\/Our+Vegas+Wedding\/ticker.png\">http:\/\/www.ezticker.com\/ticker\/1175\/...ing\/ticker.png<\/a><\/div><\/div>","Email":"frmh@msn.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1240027311,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-216807.gif?_r=0","PhotoWidth":83,"PhotoHeight":77,"PhotoType":"custom"},"FormattedName":"frmh","Id":216807,"Name":"frmh","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26001,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c7b9b7f9ebe7f8e175996023fab1bf23","RawContent":"Fellow Vegas bride checking in!!!!!! \n \n Brian &amp;amp; Shannon\n \n June 19, 2010","Attachments":[],"Id":700443,"PostDate":1243108987,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Fellow Vegas bride checking in!!!!!! <br \/> <br \/> Brian & Shannon<br \/> <br \/> June 19, 2010\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/www.mywedding.com\/shannonbrian\/\">http:\/\/www.mywedding.com\/shannonbrian\/<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/img.weddingcountdown.com\/ticker\/7sezqwmt8.png\">http:\/\/img.weddingcountdown.com\/ticker\/7sezqwmt8.png<\/a><\/div><\/div>","Email":"shyste1s@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1239742449,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-216716.gif?_r=0","PhotoWidth":75,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"shan13","Id":216716,"Name":"shan13","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26001,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6835fcde675b24b15cd9c195d2cc0ea6","RawContent":"welcome to our newest Vegas brides. Sorry I haven&#039;t been checking this area a lot lately. please PM me if you ever need help or have any issues. I promise to check back a little more often.","Attachments":[],"Id":705313,"PostDate":1243553275,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                welcome to our newest Vegas brides. Sorry I haven't been checking this area a lot lately. please PM me if you ever need help or have any issues. I promise to check back a little more often.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<strong>Christine + Will (married 7\/20\/07) + Ainsleigh (born 6\/25\/08) + Nolan (born 11\/9\/10) + Delaney (born 12\/31\/13) = One Very Happy Family!<\/strong>","Email":"christine@dc-hulls.com","IpAddress":"167.154.70.240","GroupId":46,"GroupName":"VIP Member","JoinDate":1165989180,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206965.gif?_r=0","PhotoWidth":100,"PhotoHeight":67,"PhotoType":"custom"},"FormattedName":"Christine","Id":206965,"Name":"Christine","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26001,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"16cdc621caf2a33b2b3305f9d281f2f4","RawContent":"I should put a little update since I actually have some things booked since the last time I posted! We are having are ceremony at the West Lawn at the Flamingo. We are then going to be at rumjungle at Mandalay Bay in a private space for a hor&#039;devours &amp;amp; cocktails reception. We will then head to the Panorama Suite at Planet Hollywood for the after party. If you have questions about my venues, I&#039;d be happy to share my experiences!","Attachments":[],"Id":705550,"PostDate":1243565793,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I should put a little update since I actually have some things booked since the last time I posted! We are having are ceremony at the West Lawn at the Flamingo. We are then going to be at rumjungle at Mandalay Bay in a private space for a hor'devours & cocktails reception. We will then head to the Panorama Suite at Planet Hollywood for the after party. If you have questions about my venues, I'd be happy to share my experiences!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i35.tinypic.com\/1076iaf.jpg\">http:\/\/i35.tinypic.com\/1076iaf.jpg<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/www.ezticker.com\/ticker\/1202\/1007\/20090919\/Our+Wedding%21\/ticker.png\">http:\/\/www.ezticker.com\/ticker\/1202\/...%21\/ticker.png<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f77\/foxybrides-extremely-detailed-las-vegas-wedding-review-49821\/\">FoxyBride's Las Vegas Wedding Review Thread<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f128\/foxybrides-past-due-planning-thread-49781\/\">FoxyBride's Las Vegas Planning Thread<\/a><\/div><\/div>","Email":"alfox@umich.edu","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1221389100,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211713.gif?_r=0","PhotoWidth":100,"PhotoHeight":81,"PhotoType":"custom"},"FormattedName":"FoxyBride","Id":211713,"Name":"FoxyBride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26001,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5d0f119606cc3580d6de6d6b479168eb","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;FoxyBride&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;I should put a little update since I actually have some things booked since the last time I posted! We are having are ceremony at the West Lawn at the Flamingo. We are then going to be at rumjungle at Mandalay Bay in a private space for a hor&#039;devours &amp;amp; cocktails reception. We will then head to the Panorama Suite at Planet Hollywood for the after party. If you have questions about my venues, I&#039;d be happy to share my experiences!&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;\n Congrats on getting things done! How did u plan for your reception &amp;amp; afterparty...I don&#039;t really wanna feel obligated to do a reception (cost) but I would like to do something after the ceremony w\/my guests..any help is appreciated. TIA\n \n oh I love your ticker..hope u don&#039;t mind if I borrow it...","Attachments":[],"Id":706051,"PostDate":1243617252,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>FoxyBride<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">I should put a little update since I actually have some things booked since the last time I posted! We are having are ceremony at the West Lawn at the Flamingo. We are then going to be at rumjungle at Mandalay Bay in a private space for a hor'devours & cocktails reception. We will then head to the Panorama Suite at Planet Hollywood for the after party. If you have questions about my venues, I'd be happy to share my experiences!<\/div> <\/td> <\/tr> <\/table> <\/div><br \/> Congrats on getting things done! How did u plan for your reception & afterparty...I don't really wanna feel obligated to do a reception (cost) but I would like to do something after the ceremony w\/my guests..any help is appreciated. TIA<br \/> <br \/> oh I love your ticker..hope u don't mind if I borrow it...\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/www.mywedding.com\/shannonbrian\/\">http:\/\/www.mywedding.com\/shannonbrian\/<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/img.weddingcountdown.com\/ticker\/7sezqwmt8.png\">http:\/\/img.weddingcountdown.com\/ticker\/7sezqwmt8.png<\/a><\/div><\/div>","Email":"shyste1s@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1239742449,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-216716.gif?_r=0","PhotoWidth":75,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"shan13","Id":216716,"Name":"shan13","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26001,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"afde1fb149a343dbb66cd36e9c26b465","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;shan13&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Congrats on getting things done! How did u plan for your reception &amp;amp; afterparty...I don&#039;t really wanna feel obligated to do a reception (cost) but I would like to do something after the ceremony w\/my guests..any help is appreciated. TIA\n \n oh I love your ticker..hope u don&#039;t mind if I borrow it...&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;I&#039;m a total cheapskate BUT me &amp;amp; FI are kind of known to do it up on the party side since he owns a nightclub so we didn&#039;t want to go broke but we definitely wanted to have a good time. I got the idea from The Knot to have a reception in a hotel suite since a lot of times you can bring in your own food so that cuts down on catering costs. However, we are having a lot of guests and they wouldn&#039;t all be as comfortable as I&#039;d like them to in the Panorama suite. We were going to use the Apex suite at PH instead but they won&#039;t let you do just Saturday night and 2 nights is way over budget, so we stuck with one and decided to look for a place that would work with us on doing something with just hor&#039;devours and drinks in between. I didn&#039;t want to some hotel ballroom because you can do that anywhere and it costs a ton to decorate. I basically emailed every club, bar, lounge I could think of in and around the strip and told them I wanted to keep it under $1500 for drinks &amp;amp; enough hor&#039;devours for 2 hours and Katie at Mandalay Bay was the most accommodating. She isn&#039;t charging us a fee for the room and she is letting us pay for drinks on consumption. We are hoping people will wait until the after party to get really trashed so we don&#039;t think that will cost too much more. Our only compromise is that rumjungle doesn&#039;t have a private room, we will just have an area so we can&#039;t do our own music. She was going to let us use a private room at China Grill in MB instead but I like the atmosphere at rumjungle better so we went with that. \n \n For the after party we will probably just grab drinks from Lee&#039;s Liquor (local spot) or Costco and do some party trays from Jason&#039;s Deli. There&#039;s a couple of hours in between the reception and after party so I figure if people are &amp;quot;starving&amp;quot; or something still, they&#039;ll just go grab something. Let me know if you have any other questions about it. I have months of research under my belt!\n \n I actually made this ticker myself but I&#039;ve seen tons of people using it around The Knot! It&#039;s so funny! I do a little graphic design work on the side though so I don&#039;t mind it. It&#039;s more a compliment. :)","Attachments":[],"Id":706795,"PostDate":1243659087,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>shan13<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Congrats on getting things done! How did u plan for your reception & afterparty...I don't really wanna feel obligated to do a reception (cost) but I would like to do something after the ceremony w\/my guests..any help is appreciated. TIA<br \/> <br \/> oh I love your ticker..hope u don't mind if I borrow it...<\/div> <\/td> <\/tr> <\/table> <\/div>I'm a total cheapskate BUT me & FI are kind of known to do it up on the party side since he owns a nightclub so we didn't want to go broke but we definitely wanted to have a good time. I got the idea from The Knot to have a reception in a hotel suite since a lot of times you can bring in your own food so that cuts down on catering costs. However, we are having a lot of guests and they wouldn't all be as comfortable as I'd like them to in the Panorama suite. We were going to use the Apex suite at PH instead but they won't let you do just Saturday night and 2 nights is way over budget, so we stuck with one and decided to look for a place that would work with us on doing something with just hor'devours and drinks in between. I didn't want to some hotel ballroom because you can do that anywhere and it costs a ton to decorate. I basically emailed every club, bar, lounge I could think of in and around the strip and told them I wanted to keep it under $1500 for drinks & enough hor'devours for 2 hours and Katie at Mandalay Bay was the most accommodating. She isn't charging us a fee for the room and she is letting us pay for drinks on consumption. We are hoping people will wait until the after party to get really trashed so we don't think that will cost too much more. Our only compromise is that rumjungle doesn't have a private room, we will just have an area so we can't do our own music. She was going to let us use a private room at China Grill in MB instead but I like the atmosphere at rumjungle better so we went with that. <br \/> <br \/> For the after party we will probably just grab drinks from Lee's Liquor (local spot) or Costco and do some party trays from Jason's Deli. There's a couple of hours in between the reception and after party so I figure if people are \"starving\" or something still, they'll just go grab something. Let me know if you have any other questions about it. I have months of research under my belt!<br \/> <br \/> I actually made this ticker myself but I've seen tons of people using it around The Knot! It's so funny! I do a little graphic design work on the side though so I don't mind it. It's more a compliment. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i35.tinypic.com\/1076iaf.jpg\">http:\/\/i35.tinypic.com\/1076iaf.jpg<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/www.ezticker.com\/ticker\/1202\/1007\/20090919\/Our+Wedding%21\/ticker.png\">http:\/\/www.ezticker.com\/ticker\/1202\/...%21\/ticker.png<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f77\/foxybrides-extremely-detailed-las-vegas-wedding-review-49821\/\">FoxyBride's Las Vegas Wedding Review Thread<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f128\/foxybrides-past-due-planning-thread-49781\/\">FoxyBride's Las Vegas Planning Thread<\/a><\/div><\/div>","Email":"alfox@umich.edu","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1221389100,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211713.gif?_r=0","PhotoWidth":100,"PhotoHeight":81,"PhotoType":"custom"},"FormattedName":"FoxyBride","Id":211713,"Name":"FoxyBride","IsOnline":false}}],"Pages":{"TotalItems":146,"TotalPages":15,"CurrentPage":20,"NextPage":30,"PreviousPage":10,"LastPage":140},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
