{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26001,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0ae4119a8c2ee2a0a0c252a53bc26305","RawContent":"Hi, where do you plan to marry in Vegas? Do you know how many people will be joing you?","Attachments":[],"Id":553354,"PostDate":1231419135,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi, where do you plan to marry in Vegas? Do you know how many people will be joing you?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"germeseh@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1231134772,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/7\/7a\/7a4a19d5_user-12438-avatar?_r=0","PhotoWidth":0,"PhotoHeight":0,"PhotoType":"custom"},"FormattedName":"meseh","Id":213585,"Name":"meseh","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26001,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6b09fa322a7b832739870454dddda929","RawContent":"Hello, my name is Meseh. Have you ever dined at Agustus Cafe, and if so how was it?","Attachments":[],"Id":553356,"PostDate":1231419212,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hello, my name is Meseh. Have you ever dined at Agustus Cafe, and if so how was it?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"germeseh@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1231134772,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/7\/7a\/7a4a19d5_user-12438-avatar?_r=0","PhotoWidth":0,"PhotoHeight":0,"PhotoType":"custom"},"FormattedName":"meseh","Id":213585,"Name":"meseh","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26001,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e6b7d4f7e18a035c2d388aa1d4321408","RawContent":"Have you found a place to have your reception yet?","Attachments":[],"Id":553357,"PostDate":1231419278,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Have you found a place to have your reception yet?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"germeseh@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1231134772,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/7\/7a\/7a4a19d5_user-12438-avatar?_r=0","PhotoWidth":0,"PhotoHeight":0,"PhotoType":"custom"},"FormattedName":"meseh","Id":213585,"Name":"meseh","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26001,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f081a705e3c4bb57b8ac8169eb1c2804","RawContent":"I just realized I haven&#039;t added myself to this list! FH and I are getting married at the Wynn on August 19, 2009 and having our reception at Boa in the Forum Shops @ Caesars. Our guest list is around 76 but we&#039;re expecting about 65 to come party with us!\n \n Looking forward to chatting with the other Vegas brides soon!","Attachments":[],"Id":553388,"PostDate":1231438374,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I just realized I haven't added myself to this list! FH and I are getting married at the Wynn on August 19, 2009 and having our reception at Boa in the Forum Shops @ Caesars. Our guest list is around 76 but we're expecting about 65 to come party with us!<br \/> <br \/> Looking forward to chatting with the other Vegas brides soon!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/ticker.7910.org\/as1cE-302CB0400MjAwOTdzfDI2NHN8Q291bnRkb3duIHRvIFZlZ2Fz.gif\">http:\/\/ticker.7910.org\/as1cE-302CB04...RvIFZlZ2Fz.gif<\/a><\/div><\/div>","Email":"michellececi@rogers.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1218132277,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211036.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"michellepicksbrent","Id":211036,"Name":"michellepicksbrent","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26001,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4a325e0e1bd6f7b9322e5ca471920d27","RawContent":"Hello all! My name is Amy and my FH and I will be getting married at Mandalay Bay at the Valley of the Falls on October 17, 2009. Still trying to decide on a reception location but I&#039;m thinking it will be at one of the restaurants in the hotel.\n \n Good luck and happy planning to all of you!\n \n Amy","Attachments":[],"Id":554067,"PostDate":1231468844,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hello all! My name is Amy and my FH and I will be getting married at Mandalay Bay at the Valley of the Falls on October 17, 2009. Still trying to decide on a reception location but I'm thinking it will be at one of the restaurants in the hotel.<br \/> <br \/> Good luck and happy planning to all of you!<br \/> <br \/> Amy\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"soontobeadams@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1230946755,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213510.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"soontobemrsadams","Id":213510,"Name":"soontobemrsadams","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26001,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"07a4450d79d7f47bbfe3c14a515b9769","RawContent":"welcome to all our newbies. So happy to have more Vegas brides. Please post any info you get as well as pictures so we can bulk up our section.","Attachments":[],"Id":554266,"PostDate":1231475802,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                welcome to all our newbies. So happy to have more Vegas brides. Please post any info you get as well as pictures so we can bulk up our section.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<strong>Christine + Will (married 7\/20\/07) + Ainsleigh (born 6\/25\/08) + Nolan (born 11\/9\/10) + Delaney (born 12\/31\/13) = One Very Happy Family!<\/strong>","Email":"christine@dc-hulls.com","IpAddress":"167.154.70.240","GroupId":46,"GroupName":"VIP Member","JoinDate":1165989180,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206965.gif?_r=0","PhotoWidth":100,"PhotoHeight":67,"PhotoType":"custom"},"FormattedName":"Christine","Id":206965,"Name":"Christine","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26001,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0250a18cb88d1b88852634b318c6091e","RawContent":"Hi y&#039;all! I&#039;m planning a May 09 wedding in Vegas! Picking that as a destination because we want it to be quick, nice, small, but FUN. We expect about 30 people and will marry at the Wynn, followed by a reception at Daniel Boulud, and an informal party. I don&#039;t have as much time to plan as a lot of other gals here, but am finding it to be pretty easy with the wealth of information here and on the internet in general, plus the magic of outsourcing (one of the reasons for picking Vegas) a lot of the basic stuff to the hotel. I and my guests are looking for a good time this spring in Vegas, Baby!","Attachments":[],"Id":576887,"PostDate":1233323893,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi y'all! I'm planning a May 09 wedding in Vegas! Picking that as a destination because we want it to be quick, nice, small, but FUN. We expect about 30 people and will marry at the Wynn, followed by a reception at Daniel Boulud, and an informal party. I don't have as much time to plan as a lot of other gals here, but am finding it to be pretty easy with the wealth of information here and on the internet in general, plus the magic of outsourcing (one of the reasons for picking Vegas) a lot of the basic stuff to the hotel. I and my guests are looking for a good time this spring in Vegas, Baby!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kuroicat@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1232577873,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-214166.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"lolkitteh","Id":214166,"Name":"lolkitteh","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26001,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"035195d8aa6b3e3bd444dac195199cfe","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;meseh&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Hello, my name is Meseh. Have you ever dined at Agustus Cafe, and if so how was it?&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;\n Meseh,\n I have and it was ok but we only had breakfast there. We went there twice for breakfast during out stay at casear&#039;s. The first time we got great service, the second time we waited 20 minutes before our waitress even came over to take our drink order. Its not fancy at all but i know caesar&#039;s doesn&#039;t have much for mid-price restaurant options. That is why we have choosen to go to Joe&#039;s in the Forum shops for our reception. They also have a beautiful private room which may work for you depending on the amount of guests your expecting. If you don&#039;t mind walking I know Paris has a beautiful steak house that is reasonably priced ($arnd 50\/per plate) and Bally&#039;s has a nice italian restaurant that i think is closer to $40 per plate. Hope this helps\n \n Heather","Attachments":[],"Id":582858,"PostDate":1233813011,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>meseh<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Hello, my name is Meseh. Have you ever dined at Agustus Cafe, and if so how was it?<\/div> <\/td> <\/tr> <\/table> <\/div><br \/> Meseh,<br \/> I have and it was ok but we only had breakfast there. We went there twice for breakfast during out stay at casear's. The first time we got great service, the second time we waited 20 minutes before our waitress even came over to take our drink order. Its not fancy at all but i know caesar's doesn't have much for mid-price restaurant options. That is why we have choosen to go to Joe's in the Forum shops for our reception. They also have a beautiful private room which may work for you depending on the amount of guests your expecting. If you don't mind walking I know Paris has a beautiful steak house that is reasonably priced ($arnd 50\/per plate) and Bally's has a nice italian restaurant that i think is closer to $40 per plate. Hope this helps<br \/> <br \/> Heather\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"canadianheather@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1226355365,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-212620.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"canadianheather","Id":212620,"Name":"canadianheather","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26001,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"83701cbb3eab04c22fc742c4c75de064","RawContent":"I am getting married in September and want the ceremony at the Valley of Fire - I like the photos used on 702wedding.com but they don&#039;t have any testimonials from the Valley of Fire weddings, only their chapel. has anyone used this company, the name of the company is also Vegas Weddings I believe? They seem to be on the more expensive side but their photos look fantastic - I would love to hear from anyone who can let me know about their experience! thanks!","Attachments":[],"Id":587675,"PostDate":1234251671,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I am getting married in September and want the ceremony at the Valley of Fire - I like the photos used on 702wedding.com but they don't have any testimonials from the Valley of Fire weddings, only their chapel. has anyone used this company, the name of the company is also Vegas Weddings I believe? They seem to be on the more expensive side but their photos look fantastic - I would love to hear from anyone who can let me know about their experience! thanks!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"leisajjames@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1233735179,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-214605.gif?_r=0","PhotoWidth":150,"PhotoHeight":131,"PhotoType":"custom"},"FormattedName":"AussieGal","Id":214605,"Name":"AussieGal","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26001,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"06e994178d7b7b81c2c073aa50078538","RawContent":"Hi everyone. I live in Vegas and at one point we were planning on having our wedding here, but changed our minds after a few months, because we wanted a change of scenery. \n Also, please feel free to ask me questions, as we had already done lots of research in the area during our planning process. \n \n We try to make down to the strip every so often, so if you need pics of a location I always have my phone on me, so let me know!\n \n Best of luck with all your planning.\n \n ~Susan","Attachments":[],"Id":587888,"PostDate":1234268080,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi everyone. I live in Vegas and at one point we were planning on having our wedding here, but changed our minds after a few months, because we wanted a change of scenery. <br \/> Also, please feel free to ask me questions, as we had already done lots of research in the area during our planning process. <br \/> <br \/> We try to make down to the strip every so often, so if you need pics of a location I always have my phone on me, so let me know!<br \/> <br \/> Best of luck with all your planning.<br \/> <br \/> ~Susan\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>...<\/span><\/div><\/div>","Email":"susana.beaumont@gmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1224840544,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-212384.gif?_r=0","PhotoWidth":100,"PhotoHeight":67,"PhotoType":"custom"},"FormattedName":"Susanandmo","Id":212384,"Name":"Susanandmo","IsOnline":false}}],"Pages":{"TotalItems":146,"TotalPages":15,"CurrentPage":10,"NextPage":20,"PreviousPage":0,"LastPage":140},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
