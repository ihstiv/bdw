{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":7,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":3198,"MovedTo":null,"MovedOn":0,"FirstPostId":585846,"Rating":0,"RatingHits":0,"Starter":{"Id":213871,"Name":"wededbliss2010","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213871.gif?_r=0","PhotoWidth":73,"PhotoHeight":100,"PhotoType":"custom"},"IsOnline":false},"StartDate":1234063046,"LastPoster":{"Id":276876,"Name":"tfaulkner14","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":31,"Preview":{"Id":1835524,"PostDate":1393344395,"PostContent":"Try www.hotelweddingblocks.com, this is what I am using. They negotiate for you then contact you...","Author":{"Signature":"","Email":"tfaulkner14@yahoo.com","IpAddress":"24.121.135.128","GroupId":39,"GroupName":"Newbie","JoinDate":1393343973,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"tfaulkner14","Id":276876,"Name":"tfaulkner14","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30899,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"34f51f3d8475a85d5a49d0054d15f9d3","RawContent":"Hello:\n \n Has anyone having a LV wedding blocked rooms for the guest? I wanted to block a number of rooms with the Harrah&#039;s Hotel Chain. Imagine my surprise Harrah&#039;s will only block rooms if you are planning to set aside 50 rooms or more? &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/censored.gif\" border=\"0\" alt=\"\" title=\"Censored\" class=\"inlineimg\" \/&gt;, so I am curious as to what other LV&#039;s brides choose.\n \n Thanks","Attachments":[],"Id":585846,"PostDate":1234063046,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hello:<br \/> <br \/> Has anyone having a LV wedding blocked rooms for the guest? I wanted to block a number of rooms with the Harrah's Hotel Chain. Imagine my surprise Harrah's will only block rooms if you are planning to set aside 50 rooms or more? <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/censored.gif\" border=\"0\" alt=\"\" title=\"Censored\" class=\"inlineimg\" \/><\/span>, so I am curious as to what other LV's brides choose.<br \/> <br \/> Thanks\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sweetnessazj@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1231758914,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213871.gif?_r=0","PhotoWidth":73,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"wededbliss2010","Id":213871,"Name":"wededbliss2010","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30899,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9dfc2a7af4138eaa632441a8ee4dd27f","RawContent":"We got a block for our guests at the Wynn - didn&#039;t bother to try elsewhere. There was no minimum count, but that&#039;s probably because we are also having our wedding there. How it worked is that it was a rate lock on a certain date + a small discount. \n \n IMO, it&#039;s not really necessary to provide blocks at various hotels for guests - the Vegas hotel market is very fluid, and your guests could very well get a better deal on their own without a block. This is basically what we said on our website. Since Wynn is a pretty expensive hotel, we also suggested nearby places that I&#039;m sure my guests will be able to get reasonable rates at without a block.","Attachments":[],"Id":586148,"PostDate":1234113207,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We got a block for our guests at the Wynn - didn't bother to try elsewhere. There was no minimum count, but that's probably because we are also having our wedding there. How it worked is that it was a rate lock on a certain date + a small discount. <br \/> <br \/> IMO, it's not really necessary to provide blocks at various hotels for guests - the Vegas hotel market is very fluid, and your guests could very well get a better deal on their own without a block. This is basically what we said on our website. Since Wynn is a pretty expensive hotel, we also suggested nearby places that I'm sure my guests will be able to get reasonable rates at without a block.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kuroicat@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1232577873,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-214166.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"lolkitteh","Id":214166,"Name":"lolkitteh","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30899,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6219f9343cd557af5098b0a563f9cc10","RawContent":"I am getting married in Las Vegas and we didn&#039;t try to hold a block of rooms. Most of the people coming expressed interest to stay in several different places so we didn&#039;t bother trying.","Attachments":[],"Id":586394,"PostDate":1234147944,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I am getting married in Las Vegas and we didn't try to hold a block of rooms. Most of the people coming expressed interest to stay in several different places so we didn't bother trying.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10743;133\/st\/20090721\/e\/Our+Vegas+Wedding\/dt\/-1\/k\/021c\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...021c\/event.png<\/a><br><br><br><br><a data-ipb='nomediaparse' href=\"http:\/\/www.weddingwire.com\/michaelandnicole\">http:\/\/www.weddingwire.com\/michaelandnicole<\/a><\/div><\/div>","Email":"nicmicj@aol.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1222505295,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211973.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"nicmicj","Id":211973,"Name":"nicmicj","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30899,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1060ceb5f5e962e08a4cfa83c22d9258","RawContent":"Since my guest count is up in the air, no one has pressured me about a minimum number of rooms. When the number did come up, I believe it was between 10 to 20 tops. But the issue I have found is that not many are willing to talk about a discount over 10%. Has anyone found a place offering nice discounts for booking multiple rooms. It would seem if you have a large enough party this would be seen as an incentive to the hotel. Just curious.","Attachments":[],"Id":587378,"PostDate":1234233803,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Since my guest count is up in the air, no one has pressured me about a minimum number of rooms. When the number did come up, I believe it was between 10 to 20 tops. But the issue I have found is that not many are willing to talk about a discount over 10%. Has anyone found a place offering nice discounts for booking multiple rooms. It would seem if you have a large enough party this would be seen as an incentive to the hotel. Just curious.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/www.weddingcountdown.com\/ticker\/yacxp17tj.png\">http:\/\/www.weddingcountdown.com\/ticker\/yacxp17tj.png<\/a><\/div><\/div>","Email":"kd93063@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1223330875,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-212146.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"BajaBride2010","Id":212146,"Name":"BajaBride2010","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30899,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"136bb3938f286b5992667267d7d30aab","RawContent":"The MGM Group (MGM, New York New York, Mirage...plus a couple of others) will hold rooms at no cost to you and give you a confirmation code for your guests to quote when booking. \n The bonuses to blocking rooms are: \n \n 1. You get to be close to your guests...less confusion about where everyone is and more face time. \n \n 2. The rates are locked... If the rates for those dates increase your rate at time of blocking is locked in. If the rates decrease the hotel will adjust the rate accordingly.\n \n 3. The hotel will hold your blocked rooms until up to a month prior to your date, rooms that are not spoken for by your guests and held with a credit card will then be re-released to the public...at no cost to you. \n \n When blocking rooms most of the other hotels in Vegas want you to secure a certain number of rooms with a credit card. With the MGM group they are simply more flexible and willing to work with you. Plus Kids under 12 stay free &amp;amp; Any guests can add an extra guest to their room for an additional $35 (which works for singles coming alone).\n \n Also MGM has an airport check-in desk located between baggage carousels 1 and 2 when you get off the airplane. They give you your room key on the spot and there is no line-up.","Attachments":[],"Id":590659,"PostDate":1234483024,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                The MGM Group (MGM, New York New York, Mirage...plus a couple of others) will hold rooms at no cost to you and give you a confirmation code for your guests to quote when booking. <br \/> The bonuses to blocking rooms are: <br \/> <br \/> 1. You get to be close to your guests...less confusion about where everyone is and more face time. <br \/> <br \/> 2. The rates are locked... If the rates for those dates increase your rate at time of blocking is locked in. If the rates decrease the hotel will adjust the rate accordingly.<br \/> <br \/> 3. The hotel will hold your blocked rooms until up to a month prior to your date, rooms that are not spoken for by your guests and held with a credit card will then be re-released to the public...at no cost to you. <br \/> <br \/> When blocking rooms most of the other hotels in Vegas want you to secure a certain number of rooms with a credit card. With the MGM group they are simply more flexible and willing to work with you. Plus Kids under 12 stay free & Any guests can add an extra guest to their room for an additional $35 (which works for singles coming alone).<br \/> <br \/> Also MGM has an airport check-in desk located between baggage carousels 1 and 2 when you get off the airplane. They give you your room key on the spot and there is no line-up.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tonightweride007style@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1216268055,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-210593.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"twistedannie","Id":210593,"Name":"twistedannie","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30899,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"500414986acce9352f31c1747a25ebae","RawContent":"I found you information very helpful. I have a player club card with MGM, but could not remember my PW so I called to see if someone could help me. After being on hold for 15 minutes, I just hung up and decided to just stay at the RIO which I&#039;ve stayed at 3 times already and love the fact that they are an All Suite hotel! My FI stayed at MGM and totally loved it! He said their beds were the most comfortable of any other hotels he&#039;s every stayed at, so I was a little disappointed with the customer service.\n \n \n &lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;twistedannie&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;The MGM Group (MGM, New York New York, Mirage...plus a couple of others) will hold rooms at no cost to you and give you a confirmation code for your guests to quote when booking. \n The bonuses to blocking rooms are: \n \n 1. You get to be close to your guests...less confusion about where everyone is and more face time. \n \n 2. The rates are locked... If the rates for those dates increase your rate at time of blocking is locked in. If the rates decrease the hotel will adjust the rate accordingly.\n \n 3. The hotel will hold your blocked rooms until up to a month prior to your date, rooms that are not spoken for by your guests and held with a credit card will then be re-released to the public...at no cost to you. \n \n When blocking rooms most of the other hotels in Vegas want you to secure a certain number of rooms with a credit card. With the MGM group they are simply more flexible and willing to work with you. Plus Kids under 12 stay free &amp;amp; Any guests can add an extra guest to their room for an additional $35 (which works for singles coming alone).\n \n Also MGM has an airport check-in desk located between baggage carousels 1 and 2 when you get off the airplane. They give you your room key on the spot and there is no line-up.&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;","Attachments":[],"Id":599233,"PostDate":1235200438,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I found you information very helpful. I have a player club card with MGM, but could not remember my PW so I called to see if someone could help me. After being on hold for 15 minutes, I just hung up and decided to just stay at the RIO which I've stayed at 3 times already and love the fact that they are an All Suite hotel! My FI stayed at MGM and totally loved it! He said their beds were the most comfortable of any other hotels he's every stayed at, so I was a little disappointed with the customer service.<br \/> <br \/> <br \/> <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>twistedannie<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">The MGM Group (MGM, New York New York, Mirage...plus a couple of others) will hold rooms at no cost to you and give you a confirmation code for your guests to quote when booking. <br \/> The bonuses to blocking rooms are: <br \/> <br \/> 1. You get to be close to your guests...less confusion about where everyone is and more face time. <br \/> <br \/> 2. The rates are locked... If the rates for those dates increase your rate at time of blocking is locked in. If the rates decrease the hotel will adjust the rate accordingly.<br \/> <br \/> 3. The hotel will hold your blocked rooms until up to a month prior to your date, rooms that are not spoken for by your guests and held with a credit card will then be re-released to the public...at no cost to you. <br \/> <br \/> When blocking rooms most of the other hotels in Vegas want you to secure a certain number of rooms with a credit card. With the MGM group they are simply more flexible and willing to work with you. Plus Kids under 12 stay free & Any guests can add an extra guest to their room for an additional $35 (which works for singles coming alone).<br \/> <br \/> Also MGM has an airport check-in desk located between baggage carousels 1 and 2 when you get off the airplane. They give you your room key on the spot and there is no line-up.<\/div> <\/td> <\/tr> <\/table> <\/div>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sweetnessazj@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1231758914,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213871.gif?_r=0","PhotoWidth":73,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"wededbliss2010","Id":213871,"Name":"wededbliss2010","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.121.135.128","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30899,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6ad131de45cb7671b28872623cd5ebfa","RawContent":"&lt;p&gt;Try &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.hotelweddingblocks.com&#039;&gt;www.hotelweddingblocks.com&lt;\/a&gt;, this is what I am using. They negotiate for you then contact you with results within 24 hours.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1835524,"PostDate":1393344395,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Try <a href='http:\/\/www.hotelweddingblocks.com' class='bbc_url' title='External link' rel='nofollow external'>www.hotelweddingblocks.com<\/a>, this is what I am using. They negotiate for you then contact you with results within 24 hours.<\/p>\n<p>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tfaulkner14@yahoo.com","IpAddress":"24.121.135.128","GroupId":39,"GroupName":"Newbie","JoinDate":1393343973,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"tfaulkner14","Id":276876,"Name":"tfaulkner14","IsOnline":false}}],"Id":"30899","Title":"Hotel Room Blocks in Las Vegas?","LastPostDate":1393344395},"Pages":{"TotalItems":7,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
