{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":35,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":1714,"MovedTo":null,"MovedOn":0,"FirstPostId":1898197,"Rating":0,"RatingHits":0,"Starter":{"Id":275855,"Name":"rachelia160","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275855.jpg?_r=1435853657","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"StartDate":1433849282,"LastPoster":{"Id":284300,"Name":"rahulthakur01","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":60,"Preview":{"Id":1901976,"PostDate":1438829337,"PostContent":"Getting legal ceremony doesn't take away from DW \u00a0even its very interesting that you go for legal...","Author":{"Signature":"","Email":"rahulthakur01@hotmail.com","IpAddress":"122.15.103.61","GroupId":39,"GroupName":"Newbie","JoinDate":1438822568,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"rahulthakur01","Id":284300,"Name":"rahulthakur01","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"184.151.222.178","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79260,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"e61d592892b734da7befbc6e5546f02a","RawContent":"[quote name=\"Sabes44\" post=\"1899037\" timestamp=\"1434990879\"]\n@[member=\"racht33\"] good question, I think it depends on your resort.  Our resort didn&#039;t require anything to show we were already married, I would just ask, but I doubt they would require that.[\/quote]Ditto.  Generally if you do the symbolic there it includes the honeymoon items.  Maybe if you just booked the resort for your honeymoon they may want proof because they give you tonnes of upgrades for free. \n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1899065,"PostDate":1434996788,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Sabes44, on 22 June 2015 - 12:34 PM, said:<\/p><div class='blockquote'><div class='quote'><p>@<a hovercard-ref=\"member\" hovercard-id=\"281952\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281952-racht33\/' title='Member profile'><span itemprop=\"name\">racht33<\/span><\/a> good question, I think it depends on your resort.  Our resort didn't require anything to show we were already married, I would just ask, but I doubt they would require that.<\/p><\/div><\/div>\n<br>\nDitto.  Generally if you do the symbolic there it includes the honeymoon items.  Maybe if you just booked the resort for your honeymoon they may want proof because they give you tonnes of upgrades for free. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"159.53.78.143","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79260,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"ad01ad70d549e83ca984abdc05d47799","RawContent":"&lt;p&gt;I was very against getting legally married before we went to Jamaica and, in retrospect, I was wrong. I can admit it! Of course I LOVED our wedding day, but there was something very strange for us having 65 people staring at us while we took our vows. We had a first look before the ceremony so we were together and had about 15 minutes in our room together before the ceremony. We both joked that we wanted the minister to just come up to our room and marry us instead of going down! We don&#039;t love the attention.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;But mostly it just felt like such a personal experience for us that I almost would have preferred that we did it more privately at home and kept it a secret. I think we would have been more relaxed as it would have taken the pressure off - and been kind of fun that we had a little secret between the two of us. I did not at all expect to feel that way!&lt;\/p&gt;","Attachments":[],"Id":1899128,"PostDate":1435065856,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I was very against getting legally married before we went to Jamaica and, in retrospect, I was wrong. I can admit it! Of course I LOVED our wedding day, but there was something very strange for us having 65 people staring at us while we took our vows. We had a first look before the ceremony so we were together and had about 15 minutes in our room together before the ceremony. We both joked that we wanted the minister to just come up to our room and marry us instead of going down! We don't love the attention.<\/p>\n<p>\u00a0<\/p>\n<p>But mostly it just felt like such a personal experience for us that I almost would have preferred that we did it more privately at home and kept it a secret. I think we would have been more relaxed as it would have taken the pressure off - and been kind of fun that we had a little secret between the two of us. I did not at all expect to feel that way!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rebecca.shaffer@gmail.com","IpAddress":"159.53.174.144","GroupId":3,"GroupName":"Member","JoinDate":1403101687,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"beckys98","Id":278581,"Name":"beckys98","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"64.53.250.35","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79260,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":4,"IsLiked":false,"PostKey":"92b645def448788821b25f4aa14e1658","RawContent":"&lt;p&gt;Okay, now that I&#039;m back from my destination wedding, I can say with certainty that having a legal ceremony beforehand did NOT take away anything at all from our wedding day whatsoever!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;They were two totally and completely separate experiences for us, and felt just the same as if that had been our actual legal ceremony. &amp;nbsp;It was beautiful, perfect, personal, and emotional. There wasn&#039;t a dry eye in the house when we each read our personal vows.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"http:\/\/i15.photobucket.com\/albums\/a359\/rachelia160\/Photos%20In%20Cancun_739.jpg\" alt=\"Photos%20In%20Cancun_739.jpg\"&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"http:\/\/i15.photobucket.com\/albums\/a359\/rachelia160\/Photos%20In%20Cancun_736.jpg\" alt=\"Photos%20In%20Cancun_736.jpg\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Having done the small church ceremony at home definitely took away a lot of the big scary pressure, and just left us with giddy nervous excitement that allowed us to enjoy the ceremony SO much.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"http:\/\/i15.photobucket.com\/albums\/a359\/rachelia160\/Photos%20In%20Cancun_1184.jpg\" alt=\"Photos%20In%20Cancun_1184.jpg\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;So I can&#039;t speak for everyone, but from my experience, having a legal ceremony at home before your DW does not take away from your wedding day even in the slightest!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1899471,"PostDate":1435571984,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Okay, now that I'm back from my destination wedding, I can say with certainty that having a legal ceremony beforehand did NOT take away anything at all from our wedding day whatsoever!<\/p>\n<p>\u00a0<\/p>\n<p>They were two totally and completely separate experiences for us, and felt just the same as if that had been our actual legal ceremony. \u00a0It was beautiful, perfect, personal, and emotional. There wasn't a dry eye in the house when we each read our personal vows.<\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i15.photobucket.com\/albums\/a359\/rachelia160\/Photos%20In%20Cancun_739.jpg\" alt=\"Photos%20In%20Cancun_739.jpg\"><\/span><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i15.photobucket.com\/albums\/a359\/rachelia160\/Photos%20In%20Cancun_736.jpg\" alt=\"Photos%20In%20Cancun_736.jpg\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>Having done the small church ceremony at home definitely took away a lot of the big scary pressure, and just left us with giddy nervous excitement that allowed us to enjoy the ceremony SO much.<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i15.photobucket.com\/albums\/a359\/rachelia160\/Photos%20In%20Cancun_1184.jpg\" alt=\"Photos%20In%20Cancun_1184.jpg\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>So I can't speak for everyone, but from my experience, having a legal ceremony at home before your DW does not take away from your wedding day even in the slightest!<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rachelia160@aim.com","IpAddress":"66.61.104.237","GroupId":40,"GroupName":"Jr. Member","JoinDate":1388717497,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275855.jpg?_r=1435853657","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"rachelia160","Id":275855,"Name":"rachelia160","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"122.15.103.61","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79260,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"32f74f8b897dea837555ab0fd275e4bb","RawContent":"&lt;p&gt;getting legal ceremony doesn&#039;t take away from DW &amp;nbsp;even its very interesting that you go for legal ceremony. mostly very few prefer this.&lt;\/p&gt;\n\n\t&amp;nbsp;","Attachments":[],"Id":1901879,"PostDate":1438746613,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>getting legal ceremony doesn't take away from DW \u00a0even its very interesting that you go for legal ceremony. mostly very few prefer this.<\/p>\n\n\t\u00a0\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"katherineriverace@gmail.com","IpAddress":"122.15.103.61","GroupId":39,"GroupName":"Newbie","JoinDate":1425086317,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282278.png?_r=1425103909","PhotoWidth":200,"PhotoHeight":242,"PhotoType":"custom"},"FormattedName":"RitvikSehgal","Id":282278,"Name":"RitvikSehgal","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"122.15.103.61","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79260,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6fab8e81b59c6433ce2ee21150e050ac","RawContent":"&lt;p&gt;&lt;span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\"&gt;Getting legal ceremony doesn&#039;t take away from DW &amp;nbsp;even its very interesting that you go for legal ceremony. mostly very few prefer this.&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1901976,"PostDate":1438829337,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span  style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif\">Getting legal ceremony doesn't take away from DW \u00a0even its very interesting that you go for legal ceremony. mostly very few prefer this.<\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rahulthakur01@hotmail.com","IpAddress":"122.15.103.61","GroupId":39,"GroupName":"Newbie","JoinDate":1438822568,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"rahulthakur01","Id":284300,"Name":"rahulthakur01","IsOnline":false}}],"Id":"79260","Title":"Does Having A Legal Ceremony Take Away From The Dw?","LastPostDate":1438829337},"Pages":{"TotalItems":35,"TotalPages":4,"CurrentPage":30,"NextPage":-1,"PreviousPage":20,"LastPage":30},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
