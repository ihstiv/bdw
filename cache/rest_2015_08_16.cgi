{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":3,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":649,"MovedTo":null,"MovedOn":0,"FirstPostId":1793614,"Rating":0,"RatingHits":0,"Starter":{"Id":251499,"Name":"MissBubbles205","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-251499.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":false},"StartDate":1377122891,"LastPoster":{"Id":272893,"Name":"missmo","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272893.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":31,"Preview":{"Id":1794500,"PostDate":1377411771,"PostContent":"Hey Miss Bubbles  CONGRATULATIONS! We are getting married at the Garden Gazebo at the Flamingo h...","Author":{"Signature":"","Email":"momulenga@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1377411540,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272893.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"missmo","Id":272893,"Name":"missmo","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":74916,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bfdbd9e02ed7a570dd67c18c4938b766","RawContent":"Good Afternoon Ladies! My future hubs and I have always dreamed of a cute and fun wedding in Vegas... So now it&#039;s time to pick a location for the ceremony.. Thinking 10-20 people, and preferrably seated rather than standing.. Any recommendations?","Attachments":[],"Id":1793614,"PostDate":1377122891,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Good Afternoon Ladies! My future hubs and I have always dreamed of a cute and fun wedding in Vegas... So now it's time to pick a location for the ceremony.. Thinking 10-20 people, and preferrably seated rather than standing.. Any recommendations?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"britneyrasco@hotmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1329434272,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-251499.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"MissBubbles205","Id":251499,"Name":"MissBubbles205","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":74916,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fae7d7bb1b5cea5a29d80624746f99f4","RawContent":"Hey there! We are in the midst of planning also. And most likely will be having an outdoor ceremony. Maybe you can check out Caesars( the gardens are nice) and Mirage looks very nice. And Mandalay bay has good reviews. There are others I&#039;m sure, it just depends on your budget and your style.","Attachments":[],"Id":1794342,"PostDate":1377355993,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hey there! We are in the midst of planning also. And most likely will be having an outdoor ceremony. Maybe you can check out Caesars( the gardens are nice) and Mirage looks very nice. And Mandalay bay has good reviews. There are others I'm sure, it just depends on your budget and your style.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tnaomis@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1377354401,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272873.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"FutureMrsH21","Id":272873,"Name":"FutureMrsH21","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":74916,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e607ed994d65c39993123ce9ef45e674","RawContent":"&lt;p&gt; Hey Miss Bubbles&lt;\/p&gt; &lt;p&gt; CONGRATULATIONS! We are getting married at the Garden Gazebo at the Flamingo hotel. Other beautiful non cheesy garden\/pool options that we considered are the Tropicana and the Wynn. Chapel of the Flowers was out for us because they do not allow guests to take photos. We went with the Flamingo at the end because they allowed us to bring in our own photographer, videographer, officiant and flowers - ofcourse we had to pay outside vendor fees but it was important for us to pick our own vendors. I hope this helps.&lt;\/p&gt; &lt;p&gt; Mo&lt;\/p&gt;","Attachments":[],"Id":1794500,"PostDate":1377411771,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hey Miss Bubbles<\/p> <p> CONGRATULATIONS! We are getting married at the Garden Gazebo at the Flamingo hotel. Other beautiful non cheesy garden\/pool options that we considered are the Tropicana and the Wynn. Chapel of the Flowers was out for us because they do not allow guests to take photos. We went with the Flamingo at the end because they allowed us to bring in our own photographer, videographer, officiant and flowers - ofcourse we had to pay outside vendor fees but it was important for us to pick our own vendors. I hope this helps.<\/p> <p> Mo<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"momulenga@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1377411540,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272893.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"missmo","Id":272893,"Name":"missmo","IsOnline":false}}],"Id":"74916","Title":"Garden \/ Pool locations in Vegas for a non-cheesy wedding?... ","LastPostDate":1377411771},"Pages":{"TotalItems":3,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
