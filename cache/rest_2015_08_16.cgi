Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":15,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":884,"MovedTo":null,"MovedOn":0,"FirstPostId":1894241,"Rating":0,"RatingHits":0,"Starter":{"Id":277519,"Name":"veryvalentine","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277519.jpg?_r=1435850174","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"StartDate":1429881925,"LastPoster":{"Id":281055,"Name":"snswedding2016","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281055.jpg?_r=1415590512","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":60,"Preview":{"Id":1895558,"PostDate":1430928927,"PostContent":"@veryvalentine not that my fiance and I were planning on doing it after but I'm so glad you poste...","Author":{"Signature":"<p>My planning thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78916-snswedding2016-planning-thread-jan-9-2016-azul-fives\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78916-snswedding2016-planning-thread-jan-9-2016-azul-fives\/<\/a><\/p>\n<p>\u00a0<\/p>\n<div><a class='bbc_url' href='http:\/\/www.TickerFactory.com\/'><\/div>\n<div><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10730;0\/st\/20160109\/e\/Our+Wedding\/k\/9fa9\/event.png\" alt=\"event.png\"><\/div>\n<div><\/a><\/div>\n","Email":"sean.n.steph2016@gmail.com","IpAddress":"74.12.52.42","GroupId":40,"GroupName":"Jr. Member","JoinDate":1415533111,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281055.jpg?_r=1415590512","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"snswedding2016","Id":281055,"Name":"snswedding2016","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.250.6.92","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79110,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"0ce0f2e723dae42e8187d6bd441939b1","RawContent":"&lt;p&gt;We live in London,ON and just booked our civil ceremony at City Hall. It was $135 for the license and $250 for the ceremony. We are going &amp;nbsp;to bring two friends as witnesses &amp;nbsp;that are not attending the wedding but &amp;nbsp;they also provide witnesses for an extra $25 each. We get &amp;nbsp;to choose between 5 vows &amp;nbsp;and are going &amp;nbsp;with the shortest no rings ceremony because we want to do that in Mexico. Were going to City &amp;nbsp;Hall on the Monday and &amp;nbsp;fly out on Wednesday,can&#039;t wait!!!&lt;\/p&gt;","Attachments":[],"Id":1894360,"PostDate":1429950557,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>We live in London,ON and just booked our civil ceremony at City Hall. It was $135 for the license and $250 for the ceremony. We are going \u00a0to bring two friends as witnesses \u00a0that are not attending the wedding but \u00a0they also provide witnesses for an extra $25 each. We get \u00a0to choose between 5 vows \u00a0and are going \u00a0with the shortest no rings ceremony because we want to do that in Mexico. Were going to City \u00a0Hall on the Monday and \u00a0fly out on Wednesday,can't wait!!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"hayjules2003@yahoo.ca","IpAddress":"99.249.17.65","GroupId":39,"GroupName":"Newbie","JoinDate":1428087941,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282622.jpg?_r=1428106440","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"hayjules","Id":282622,"Name":"hayjules","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"65.93.220.147","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79110,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"9cca82f53809d61e2a763a7c63cd5aa0","RawContent":"&lt;p&gt;We did the same as hayjules - we were actually married at City Hall in London ON also!  &lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Though I was surprised about the $250 charge, I had budgeted this fee into our wedding costs.&amp;nbsp; If you know someone that is ordained in Ontario it will save you some money (there is a huge list on the governments website).&amp;nbsp; For City Hall, we picked the vows out of a list and decided to not exchange rings and save it for our DW.&amp;nbsp; We had two friends come and they took pictures and signed our license.&amp;nbsp; It was a very sweet ceremony and took only about 15-20 minutes.&amp;nbsp; If I was to do it again, I wouldn&#039;t change a thing.&amp;nbsp; Afterwards we took our friends out for dinner.&lt;\/p&gt;","Attachments":[],"Id":1894369,"PostDate":1429960206,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>We did the same as hayjules - we were actually married at City Hall in London ON also!\u00a0\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Though I was surprised about the $250 charge, I had budgeted this fee into our wedding costs.\u00a0 If you know someone that is ordained in Ontario it will save you some money (there is a huge list on the governments website).\u00a0 For City Hall, we picked the vows out of a list and decided to not exchange rings and save it for our DW.\u00a0 We had two friends come and they took pictures and signed our license.\u00a0 It was a very sweet ceremony and took only about 15-20 minutes.\u00a0 If I was to do it again, I wouldn't change a thing.\u00a0 Afterwards we took our friends out for dinner.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"dinaskates84@hotmail.com","IpAddress":"74.12.203.194","GroupId":40,"GroupName":"Jr. Member","JoinDate":1341063820,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-257303.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"DinaQtobe","Id":257303,"Name":"DinaQtobe","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"184.149.182.226","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79110,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":3,"IsLiked":false,"PostKey":"0d285d528afb2af4a9cf87d12d571220","RawContent":"&lt;p&gt;@[member=\"veryvalentine\"] I thought of you today - I was talking to a friend who just got engaged this week and we were talking DW. She told me her friend (who is also from Ontario) had a DW and did the symbolic ceremony first, she and her husband are now fighting to make it legal as Ontario is refusing to recognize it.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Better play it safe ladies and do the legal wedding here first!! Wouldn&#039;t want to chance it and have to try and fight it after the fact!&lt;\/p&gt;","Attachments":[],"Id":1895552,"PostDate":1430926293,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"277519\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277519-veryvalentine\/' title='Member profile'><span itemprop=\"name\">veryvalentine<\/span><\/a> I thought of you today - I was talking to a friend who just got engaged this week and we were talking DW. She told me her friend (who is also from Ontario) had a DW and did the symbolic ceremony first, she and her husband are now fighting to make it legal as Ontario is refusing to recognize it.<\/p>\n<p>\u00a0<\/p>\n<p>Better play it safe ladies and do the legal wedding here first!! Wouldn't want to chance it and have to try and fight it after the fact!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>My planning thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78916-snswedding2016-planning-thread-jan-9-2016-azul-fives\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78916-snswedding2016-planning-thread-jan-9-2016-azul-fives\/<\/a><\/p>\n<p>\u00a0<\/p>\n<div><a class='bbc_url' href='http:\/\/www.TickerFactory.com\/'><\/div>\n<div><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10730;0\/st\/20160109\/e\/Our+Wedding\/k\/9fa9\/event.png\" alt=\"event.png\"><\/div>\n<div><\/a><\/div>\n","Email":"sean.n.steph2016@gmail.com","IpAddress":"74.12.52.42","GroupId":40,"GroupName":"Jr. Member","JoinDate":1415533111,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281055.jpg?_r=1415590512","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"snswedding2016","Id":281055,"Name":"snswedding2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"38.112.94.76","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79110,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a5205828b3aca9c83147875f6af710f0","RawContent":"&lt;p&gt;@snswedding2016  &lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Oh no, how sad to hear.&amp;nbsp; Yes, that&#039;s exactly what would happen if you proceed to do the legal wedding after doing symbolic.&amp;nbsp; It&#039;s seen as not in good faith.&amp;nbsp; They would have to apply for a &#039;validity order&#039; from the provincial court&amp;nbsp;which from what I was told at the Clerk&#039;s office, it can be quite&amp;nbsp;expense and take some time.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I have searched through the Marriage Act and I can&#039;t find it written in black and white.&amp;nbsp;I should call the Clerk&#039;s office and ask where one would find it in writing.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;:)&lt;\/p&gt;","Attachments":[],"Id":1895556,"PostDate":1430927493,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@snswedding2016\u00a0\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Oh no, how sad to hear.\u00a0 Yes, that's exactly what would happen if you proceed to do the legal wedding after doing symbolic.\u00a0 It's seen as not in good faith.\u00a0 They would have to apply for a 'validity order' from the provincial court\u00a0which from what I was told at the Clerk's office, it can be quite\u00a0expense and take some time.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I have searched through the Marriage Act and I can't find it written in black and white.\u00a0I should call the Clerk's office and ask where one would find it in writing.<\/p>\n<p>\u00a0<img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div><br><div>\u00a0<\/div>\n<div>\u00a0<\/div>\n<div>Married on June 20th, 2015 at the Grand Sunset Princess Riviera Gazebo & Reception at the Chill Out with 60 guests<\/div>\n<div>\u00a0<\/div>\n<\/div>\n<div>\u00a0<\/div>\n<p>My planning thread:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78801-veryvaleros-wedding-planning-thread-grand-sunset-princess\/<\/a><\/p>\n<p>My review thread: \u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/<\/a>","Email":"rebecca.valero@gmail.com","IpAddress":"38.112.94.76","GroupId":3,"GroupName":"Member","JoinDate":1396968452,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277519.jpg?_r=1435850174","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"veryvalentine","Id":277519,"Name":"veryvalentine","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"184.149.182.226","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79110,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"0e73ad684a8cf2de90f86a0992a65bf3","RawContent":"&lt;p&gt;@[member=\"veryvalentine\"] not that my fiance and I were planning on doing it after but I&#039;m so glad you posted about it on this forum...I never would have known otherwise.&amp;nbsp; :)&lt;\/p&gt;","Attachments":[],"Id":1895558,"PostDate":1430928927,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"277519\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277519-veryvalentine\/' title='Member profile'><span itemprop=\"name\">veryvalentine<\/span><\/a> not that my fiance and I were planning on doing it after but I'm so glad you posted about it on this forum...I never would have known otherwise.\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>My planning thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78916-snswedding2016-planning-thread-jan-9-2016-azul-fives\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78916-snswedding2016-planning-thread-jan-9-2016-azul-fives\/<\/a><\/p>\n<p>\u00a0<\/p>\n<div><a class='bbc_url' href='http:\/\/www.TickerFactory.com\/'><\/div>\n<div><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10730;0\/st\/20160109\/e\/Our+Wedding\/k\/9fa9\/event.png\" alt=\"event.png\"><\/div>\n<div><\/a><\/div>\n","Email":"sean.n.steph2016@gmail.com","IpAddress":"74.12.52.42","GroupId":40,"GroupName":"Jr. Member","JoinDate":1415533111,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281055.jpg?_r=1415590512","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"snswedding2016","Id":281055,"Name":"snswedding2016","IsOnline":false}}],"Id":"79110","Title":"Civil Ceremony City Hall (Ontario Brides)","LastPostDate":1430928927},"Pages":{"TotalItems":15,"TotalPages":2,"CurrentPage":10,"NextPage":-1,"PreviousPage":0,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
