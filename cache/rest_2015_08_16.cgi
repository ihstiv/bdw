Request Time: 0 seconds
{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26001,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"443e5c98daf7e40da4ce8db77c1f6abe","RawContent":"I&#039;m getting married on May 22, 2010 at Caesar&#039;s Palace Venus Garden. Our reception will be at Maggiano&#039;s and we&#039;ll have approx. 50 guests. We&#039;ve booked our photographer as well and I&#039;m just working on booking makeup and the florist. I&#039;ve just started looking for dresses and think I found the one - Maggie Sottero &amp;quot;Melissa Brooch&amp;quot;! Dress shopping has definitely made the whole wedding planning experience more &amp;quot;real&amp;quot;!","Attachments":[],"Id":819701,"PostDate":1251525037,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm getting married on May 22, 2010 at Caesar's Palace Venus Garden. Our reception will be at Maggiano's and we'll have approx. 50 guests. We've booked our photographer as well and I'm just working on booking makeup and the florist. I've just started looking for dresses and think I found the one - Maggie Sottero \"Melissa Brooch\"! Dress shopping has definitely made the whole wedding planning experience more \"real\"!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tigress91@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1248761809,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-219904.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"SunnyCanadian","Id":219904,"Name":"SunnyCanadian","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26001,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9f08d44b15173fcefe3f5b15cd9ec3eb","RawContent":"Hi\n I am getting married in Vegas May 2010 and am torn between Caesars Venus Gardens and MGM Terazza! Does anyone have advice for me?\n Also we are trying to decide on a reception area but haven&#039;t a clue where to start...is the insuite reception more cost effective for 75 people?\n Thanks for all of the advice","Attachments":[],"Id":829541,"PostDate":1252094334,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi<br \/> I am getting married in Vegas May 2010 and am torn between Caesars Venus Gardens and MGM Terazza! Does anyone have advice for me?<br \/> Also we are trying to decide on a reception area but haven't a clue where to start...is the insuite reception more cost effective for 75 people?<br \/> Thanks for all of the advice\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sthornqu@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1250745144,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-220745.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"sthornqu","Id":220745,"Name":"sthornqu","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26001,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"434ca220e9b7491b963952dbf12f0ce1","RawContent":"I am putting a hangover kit in mine as well.\n I also found a website that said you could roll coins and tell the guests good luck in the casino...just an idea","Attachments":[],"Id":829554,"PostDate":1252094771,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I am putting a hangover kit in mine as well.<br \/> I also found a website that said you could roll coins and tell the guests good luck in the casino...just an idea\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sthornqu@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1250745144,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-220745.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"sthornqu","Id":220745,"Name":"sthornqu","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26001,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"68afcfe9fa4e8ed1b92c88641c60db8e","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;sthornqu&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Hi\n I am getting married in Vegas May 2010 and am torn between Caesars Venus Gardens and MGM Terazza! Does anyone have advice for me?\n Also we are trying to decide on a reception area but haven&#039;t a clue where to start...is the insuite reception more cost effective for 75 people?\n Thanks for all of the advice&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;I&#039;d say Caesars hands down. IMO the MGM is starting to show it&#039;s age. There are very few suites that are large enough to fit 75 people. You could try the Stardust Suite at the Orleans, Absolut Suite at Caesars, or the Apex at Planet Hollywood.","Attachments":[],"Id":829760,"PostDate":1252100659,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>sthornqu<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Hi<br \/> I am getting married in Vegas May 2010 and am torn between Caesars Venus Gardens and MGM Terazza! Does anyone have advice for me?<br \/> Also we are trying to decide on a reception area but haven't a clue where to start...is the insuite reception more cost effective for 75 people?<br \/> Thanks for all of the advice<\/div> <\/td> <\/tr> <\/table> <\/div>I'd say Caesars hands down. IMO the MGM is starting to show it's age. There are very few suites that are large enough to fit 75 people. You could try the Stardust Suite at the Orleans, Absolut Suite at Caesars, or the Apex at Planet Hollywood.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i35.tinypic.com\/1076iaf.jpg\">http:\/\/i35.tinypic.com\/1076iaf.jpg<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/www.ezticker.com\/ticker\/1202\/1007\/20090919\/Our+Wedding%21\/ticker.png\">http:\/\/www.ezticker.com\/ticker\/1202\/...%21\/ticker.png<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f77\/foxybrides-extremely-detailed-las-vegas-wedding-review-49821\/\">FoxyBride's Las Vegas Wedding Review Thread<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f128\/foxybrides-past-due-planning-thread-49781\/\">FoxyBride's Las Vegas Planning Thread<\/a><\/div><\/div>","Email":"alfox@umich.edu","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1221389100,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211713.gif?_r=0","PhotoWidth":100,"PhotoHeight":81,"PhotoType":"custom"},"FormattedName":"FoxyBride","Id":211713,"Name":"FoxyBride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26001,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a12a619d0da5864d98ecb92e62d5b97f","RawContent":"I have no experience with MGM but I can tell you that everyone has been absolutely fabulous at Caesar&#039;s Palace. The rooms are gorgeous and the bed is so comfortable. I know your not supposed to sleep in Vegas but it was impossible not to! The customer service during your stay is incredible and my wedding coordinator was always available to answer any questions or help with any of the selection processes. \n For 75 people I would recommend Joe&#039;s at the Forum shops. You want the GIGI room! There is a pic of it on the internet but it doesn&#039;t do it justice. The room is stunning and the food is FABULOUS!!! Check out trip advisor - the restaurant is ranked 10 out of over a 1000 restaurants. You can check out their website to see the catering menus so you can decide on whether the food and prices are what your looking for.","Attachments":[],"Id":830837,"PostDate":1252176140,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I have no experience with MGM but I can tell you that everyone has been absolutely fabulous at Caesar's Palace. The rooms are gorgeous and the bed is so comfortable. I know your not supposed to sleep in Vegas but it was impossible not to! The customer service during your stay is incredible and my wedding coordinator was always available to answer any questions or help with any of the selection processes. <br \/> For 75 people I would recommend Joe's at the Forum shops. You want the GIGI room! There is a pic of it on the internet but it doesn't do it justice. The room is stunning and the food is FABULOUS!!! Check out trip advisor - the restaurant is ranked 10 out of over a 1000 restaurants. You can check out their website to see the catering menus so you can decide on whether the food and prices are what your looking for.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"canadianheather@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1226355365,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-212620.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"canadianheather","Id":212620,"Name":"canadianheather","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26001,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8a0e9935ba6dca4335860eaff65c27d5","RawContent":"Hi everyone...\n \n Getting married in Dec 2009...which is just around the corner with planning etc..\n \n Really small wedding (me and groom)...booking at LV Hilton (??) for Dec 26 2009.","Attachments":[],"Id":831784,"PostDate":1252280622,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi everyone...<br \/> <br \/> Getting married in Dec 2009...which is just around the corner with planning etc..<br \/> <br \/> Really small wedding (me and groom)...booking at LV Hilton (??) for Dec 26 2009.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Future: Desiree S-Hayes<\/span><\/div><\/div>","Email":"desiree_smith@comcast.net","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1252203472,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-221342.gif?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"DSHayes","Id":221342,"Name":"DSHayes","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26001,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"056d0f05dc4dc045b02ad0499029d624","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;DSHayes&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Hi everyone...\n \n Getting married in Dec 2009...which is just around the corner with planning etc..\n \n Really small wedding (me and groom)...booking at LV Hilton (??) for Dec 26 2009.&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;Congrats...that is where we are staying when we go so please come back and share your experience w\/the hotel..\n \n Are you using one of the chapels on the strip or off?","Attachments":[],"Id":831917,"PostDate":1252288259,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>DSHayes<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Hi everyone...<br \/> <br \/> Getting married in Dec 2009...which is just around the corner with planning etc..<br \/> <br \/> Really small wedding (me and groom)...booking at LV Hilton (??) for Dec 26 2009.<\/div> <\/td> <\/tr> <\/table> <\/div>Congrats...that is where we are staying when we go so please come back and share your experience w\/the hotel..<br \/> <br \/> Are you using one of the chapels on the strip or off?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/www.mywedding.com\/shannonbrian\/\">http:\/\/www.mywedding.com\/shannonbrian\/<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/img.weddingcountdown.com\/ticker\/7sezqwmt8.png\">http:\/\/img.weddingcountdown.com\/ticker\/7sezqwmt8.png<\/a><\/div><\/div>","Email":"shyste1s@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1239742449,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-216716.gif?_r=0","PhotoWidth":75,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"shan13","Id":216716,"Name":"shan13","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26001,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ae18e4efcdf495e6cc99e7eb99caea5e","RawContent":"Shan 13....Looking into the LV Hilton Wedding Chapel...going to either stay at LV Hilton or one of the Harrahs properties..","Attachments":[],"Id":831926,"PostDate":1252288488,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Shan 13....Looking into the LV Hilton Wedding Chapel...going to either stay at LV Hilton or one of the Harrahs properties..\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Future: Desiree S-Hayes<\/span><\/div><\/div>","Email":"desiree_smith@comcast.net","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1252203472,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-221342.gif?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"DSHayes","Id":221342,"Name":"DSHayes","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26001,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"84283badc46879826cb4bccf6d23920a","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;canadianheather&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;I have no experience with MGM but I can tell you that everyone has been absolutely fabulous at Caesar&#039;s Palace. The rooms are gorgeous and the bed is so comfortable. I know your not supposed to sleep in Vegas but it was impossible not to! The customer service during your stay is incredible and my wedding coordinator was always available to answer any questions or help with any of the selection processes. \n For 75 people I would recommend Joe&#039;s at the Forum shops. You want the GIGI room! There is a pic of it on the internet but it doesn&#039;t do it justice. The room is stunning and the food is FABULOUS!!! Check out trip advisor - the restaurant is ranked 10 out of over a 1000 restaurants. You can check out their website to see the catering menus so you can decide on whether the food and prices are what your looking for.&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;Thank you so much for your advice! WE are looking at MaggianoI&#039;s for our recpetion. Do you know if the coordinators at Caesar&#039;s will let you not put the greenery around the Gazebo? For some reason I like with better!\n Thanks for all of your advice!\n My mom made my bridesmaids bouquets out of fake flowers and they are gorgeous! You can&#039;t even tell they are fake.","Attachments":[],"Id":831988,"PostDate":1252291957,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>canadianheather<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">I have no experience with MGM but I can tell you that everyone has been absolutely fabulous at Caesar's Palace. The rooms are gorgeous and the bed is so comfortable. I know your not supposed to sleep in Vegas but it was impossible not to! The customer service during your stay is incredible and my wedding coordinator was always available to answer any questions or help with any of the selection processes. <br \/> For 75 people I would recommend Joe's at the Forum shops. You want the GIGI room! There is a pic of it on the internet but it doesn't do it justice. The room is stunning and the food is FABULOUS!!! Check out trip advisor - the restaurant is ranked 10 out of over a 1000 restaurants. You can check out their website to see the catering menus so you can decide on whether the food and prices are what your looking for.<\/div> <\/td> <\/tr> <\/table> <\/div>Thank you so much for your advice! WE are looking at MaggianoI's for our recpetion. Do you know if the coordinators at Caesar's will let you not put the greenery around the Gazebo? For some reason I like with better!<br \/> Thanks for all of your advice!<br \/> My mom made my bridesmaids bouquets out of fake flowers and they are gorgeous! You can't even tell they are fake.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sthornqu@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1250745144,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-220745.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"sthornqu","Id":220745,"Name":"sthornqu","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":26001,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6fac884ba5edf81799dd1a5a2f83cfa6","RawContent":"Does anyone know what the cost of an open bar is at Joe&#039;s for your reception?","Attachments":[],"Id":831991,"PostDate":1252292003,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Does anyone know what the cost of an open bar is at Joe's for your reception?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sthornqu@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1250745144,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-220745.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"sthornqu","Id":220745,"Name":"sthornqu","IsOnline":false}}],"Pages":{"TotalItems":146,"TotalPages":15,"CurrentPage":70,"NextPage":80,"PreviousPage":60,"LastPage":140},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
