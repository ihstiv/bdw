http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/'>http:\/\/www.bestdestinationwedding.com\/topic\/79344-grand-sunset-princess-platinum-yucatan-princess-wedding\/<\/a>","Email":"rebecca.valero@gmail.com","IpAddress":"38.112.94.76","GroupId":3,"GroupName":"Member","JoinDate":1396968452,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277519.jpg?_r=1435850174","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"veryvalentine","Id":277519,"Name":"veryvalentine","IsOnline":false}},"Posts":[],"Id":"79089","Title":"Pinata At The Reception?","LastPostDate":1429669122},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":15,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":667,"MovedTo":null,"MovedOn":0,"FirstPostId":1893025,"Rating":0,"RatingHits":0,"Starter":{"Id":236302,"Name":"jaspbri0317","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-236302.jpg?_r=1429022808","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"StartDate":1429006391,"LastPoster":{"Id":282006,"Name":"ashhtayy","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282006.png?_r=1423373502","PhotoWidth":200,"PhotoHeight":138,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":60,"Preview":{"Id":1893025,"PostDate":1429006391,"PostContent":"We would like to make our wedding No Kids Allowed but we have a few exceptions.  Our younger sibl...","Author":{"Signature":"","Email":"jaspbri0317@aol.com","IpAddress":"71.58.144.195","GroupId":39,"GroupName":"Newbie","JoinDate":1296673627,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.n