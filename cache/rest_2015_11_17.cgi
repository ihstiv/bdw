jpg?_r=1431174019","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"Mandiesue","Id":275879,"Name":"Mandiesue","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.89.64.141","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75899,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"931b42e60160b87b37b124b096d4d24a","RawContent":"[quote name=\"Mandiesue\" post=\"1831732\" timestamp=\"1391526345\"]\nOh great, Thank you.[\/quote]no prob anytime, \n\nWill you guys be sending out save the dates? I was thinking sending them out a year in advance not sure just yet.","Attachments":[],"Id":1832313,"PostDate":1391718445,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Mandiesue, on 04 February 2014 - 07:05 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Oh great, Thank you.\u00a0<\/p>\n<\/div>\n<\/div><\/div>\n<p>no prob anytime,\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Will you guys be sending out save the dates? I was thinking sending them out a year in advance not sure just yet.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rizolyaguiar@gmail.com","IpAddress":"74.89.64.141","GroupId":40,"GroupName":"Jr. Member","JoinDate":1375975231,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272367.jpg?_r=1403193511","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"strwbsprkl","Id":272367,"Name":"strwbsprkl","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.197.53.90","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75899,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"78f15ca797f4c092515bc7f0cf615642","RawContent":"&lt;p&gt;Yes. We are sending them out at the 1 year mark, which for us is in April. I think we are going to send to the people we really want to attend and then we will see how many can actually make it.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1832432,"PostDate":1391793164,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Yes. We are sending them out at the 1 year mark, which for us is in April. I think we are going to send to the people we really want to attend and then we will see how many can actually make it.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mandiesueb@yahoo.com","IpAddress":"38.99.122.168","GroupId":40,"GroupName":"Jr. Member","JoinDate":1388883717,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275879.jpg?_r=1431174019","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"Mandiesue","Id":275879,"Name":"Mandiesue","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.128.226.32","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75899,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3098db0bf3ba1d69861be127a2ef9d04","RawContent":"&lt;p&gt;You are such an inspiration !!! Can we bounce ideas off of each other. I have never been to the DR BUT IT IS VERY BEAUTIFUL !!!!!&lt;\/p&gt;\n&lt;p&gt;Do any of you ladies have children? My family keeps asking if we are taking the kids and reply is \"They are our kids so why wouldn&#039;t we take them plus they are in the wedding?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I have two girls from a prior marriage and two boys with my fianc\u00e9.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I don&#039;t think people think before they speak :huh:&lt;\/p&gt;\n\n&lt;p&gt;Have you ladies found pretty good travel\/accommodation packages?&lt;\/p&gt;","Attachments":[],"Id":1839492,"PostDate":1395337443,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>You are such an inspiration !!! Can we bounce ideas off of each other. I have never been to the DR BUT IT IS VERY BEAUTIFUL !!!!!<\/p><br \/><p>Do any of you ladies have children? My family keeps asking if we are taking the kids and reply is \"They are our kids so why wouldn't we take them plus they are in the wedding?<\/p>\n<p>\u00a0<\/p>\n<p>I have two girls from a prior marriage and two boys with my fianc\u00e9.<\/p>\n<p>\u00a0<\/p>\n<p>I don't think people think before they speak <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/huh.png' class='bbc_emoticon' alt=':huh:' \/><\/p>\n<br \/><p>Have you ladies found pretty good travel\/accommodation packages?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"flemonsc@yahoo.com","IpAddress":"108.128.192.217","GroupId":40,"GroupName":"Jr. Member","JoinDate":1394834602,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"ChristienEarnest","Id":277145,"Name":"ChristienEarnest","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"187.153.77.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75899,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a8ccbeadca55bb9dac02032b143e9fb7","RawContent":"&lt;p&gt;It&#039;s one of the most beautiful resorts in Dominican Republic!&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;It has a nice beach, some snorkelling, gorgeous resort grounds and beautiful ceremony spots, you will love it!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;If you are still looking for a wedding photographer, you can e-mail us at julia@juliaeskin.com. &amp;nbsp;We&#039;ve photographed couple of weddings at Dreams La Romana and really love this resort.&lt;\/p&gt;","Attachments":[],"Id":1839493,"PostDate":1395338020,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>It's one of the most beautiful resorts in Dominican Republic!\u00a0<\/p>\n<p>It has a nice beach, some snorkelling, gorgeous resort grounds and beautiful ceremony spots, you will love it!<\/p>\n<p>\u00a0<\/p>\n<p>If you are still looking for a wedding photographer, you can e-mail us at julia@juliaeskin.com. \u00a0We've photographed couple of weddings at Dreams La Romana and really love this resort.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><strong><span style=\"color:#000080;\"><span style=\"font-size:18px;\"><em><span style=\"font-family:'times new roman', times, serif;\">Creative documentary wedding photographer in Punta Cana!<\/span><\/em><\/span><\/span><\/strong><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.juliaeskin.com'>www.juliaeskin.com<\/a><\/p>\n<p>\u00a0","Email":"julia@juliaeskin.com","IpAddress":"187.153.56.51","GroupId":49,"GroupName":"Insiders","JoinDate":1270582442,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-227096.jpg?_r=1392861573","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Julia Eskin","Id":227096,"Name":"Julia Eskin","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"47.20.113.122","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75899,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"db90211b329513c43e922de8199c8500","RawContent":"[quote name=\"ChristienEarnest\" post=\"1839492\" timestamp=\"1395337443\"]\nYou are such an inspiration !!! Can we bounce ideas off of each other. I have never been to the DR BUT IT IS VERY BEAUTIFUL !!!!!\n\nDo any of you ladies have children? My family keeps asking if we are taking the kids and reply is \"They are our kids so why wouldn&#039;t we take them plus they are in the wedding?\n\nI have two girls from a prior marriage and two boys with my fianc\u00e9.\n\nI don&#039;t think people think before they speak :huh:\n\nHave you ladies found pretty good travel\/accommodation packages?\n\n\nyes definitely, I have family living in dominican republic so this resort is closest to them, plus it&#039;s different since my fiance&#039;s family just went to a wedding in punta cana. lol\n\n OMG, totally understand the whole family thing. we don&#039;t have children just yet lol, hopefully soon. The resort has an awesome kids area. where they can play indoors or out. it&#039;s totally a kid friendly resort. why wouldn&#039;t you want you babies in your wedding people i tell you! lol. I am making my grandmother my flower girl or flower woman lol and my family thinks im being ridiculous. it&#039;s our wedding who cares lol.\n\nare you having bridesmaids? I made a wedding site for my wedding party. www.weddingwire.com\/mjwed15     im  working on one for the guest. When is your wedding?[\/quote]","Attachments":[],"Id":1839513,"PostDate":1395340089,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>ChristienEarnest, on 20 March 2014 - 09:44 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>You are such an inspiration !!! Can we bounce ideas off of each other. I have never been to the DR BUT IT IS VERY BEAUTIFUL !!!!!<\/p>\n<br><p>Do any of you ladies have children? My family keeps asking if we are taking the kids and reply is \"They are our kids so why wouldn't we take them plus they are in the wedding?<\/p>\n<p>\u00a0<\/p>\n<p>I have two girls from a prior marriage and two boys with my fianc\u00e9.<\/p>\n<p>\u00a0<\/p>\n<p>I don't think people think before they speak <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/huh.png' class='bbc_emoticon' alt=':huh:' \/><\/p>\n<br><p>Have you ladies found pretty good travel\/accommodation packages?<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>yes definitely, I have family living in dominican republic so this resort is closest to them, plus it's different since my fiance's family just went to a wedding in punta cana. lol<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0OMG, totally understand the whole family thing. we don't have children just yet lol, hopefully soon. The resort has an awesome kids area. where they can play indoors or out. it's totally a kid friendly resort. why wouldn't you want you babies in your wedding people i tell you! lol. I am making my grandmother my flower girl or flower woman lol and my family thinks im being ridiculous. it's our wedding who cares lol.<\/p>\n<p>\u00a0<\/p>\n<p>are you having bridesmaids? I made a wedding site for my wedding party. www.weddingwire.com\/mjwed15 \u00a0 \u00a0 im \u00a0working on one for the guest. When is your wedding? \u00a0<\/p>\n<\/div>\n<\/div><\/div>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rizolyaguiar@gmail.com","IpAddress":"74.89.64.141","GroupId":40,"GroupName":"Jr. Member","JoinDate":1375975231,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272367.jpg?_r=1403193511","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"strwbsprkl","Id":272367,"Name":"strwbsprkl","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"47.20.113.122","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75899,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"05e6083a717514875dece503e725bdac","RawContent":".  What do you guys think? \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1839620,"PostDate":1395368532,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <a class='resized_img' rel='lightbox[1839620]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_03_2014\/post-272367-139536850906.jpg\" title=\"ImageUploadedByTapatalk1395368511.011352.jpg - Size: 120.11KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_03_2014\/post-272367-139536850906.jpg\" class='bbc_img linked-image' alt=\"ImageUploadedByTapatalk1395368511.011352.jpg\" \/><\/a>\n\n.  What do you guys think? <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rizolyaguiar@gmail.com","IpAddress":"74.89.64.141","GroupId":40,"GroupName":"Jr. Member","JoinDate":1375975231,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272367.jpg?_r=1403193511","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"strwbsprkl","Id":272367,"Name":"strwbsprkl","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.41.252.93","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":75899,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0c7dc39dd52cf1bdc6a92ef49caefd24","RawContent":"Hi girls! I just sent Jenny my deposit &amp;amp; agreement for 3\/28\/2015! Her automated voicemail responded &amp;amp; she won&#039;t be in her office until April 3rd :(\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1840576,"PostDate":1395802182,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi girls! I just sent Jenny my deposit & agreement for 3\/28\/2015! Her automated voicemail responded & she won't be in her office until April 3rd <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/sad.png' class='bbc_emoticon' alt=':(' \/><br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"aripena1@gmail.com","IpAddress":"24.191.4.97","GroupId":39,"GroupName":"Newbie","JoinDate":1383849407,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-274887.png?_r=1406163114","PhotoWidth":80,"PhotoHeight":80,"PhotoType":"custom"},"FormattedName":"Ariana2015","Id":274887,"Name":"Ariana2015","IsOnline":false}}],"Id":"75899","Title":"Dreams La Romana 2015","LastPostDate":1447218984},"Pages":{"TotalItems":36,"TotalPages":4,"CurrentPage":10,"NextPage":20,"PreviousPage":0,"LastPage":30},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
