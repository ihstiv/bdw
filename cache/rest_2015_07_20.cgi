king about ordering a second dress and you are making me feel much more confidant about ordering it from Landy. Thank you!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"handf1009@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1235967155,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-215372.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"H&F","Id":215372,"Name":"H&F","IsOnline":false}}],"Pages":{"TotalItems":6398,"TotalPages":640,"CurrentPage":80,"NextPage":90,"PreviousPage":70,"LastPage":6390},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
