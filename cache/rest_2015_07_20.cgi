ody>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/dw.daisypath.com\/PpH3m5\/.png\">http:\/\/dw.daisypath.com\/PpH3m5\/.png<\/a><\/div><\/div>","Email":"violets@neb.rr.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1238941162,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-216481.gif?_r=0","PhotoWidth":96,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"sugaredviolets","Id":216481,"Name":"sugaredviolets","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e06a5adbe6795054ea25d76ae956e118","RawContent":"She didn&#039;t send me a pic before so I was pretty nervous but there are a few different girls who have ordered very different dresses and I think all of them have turned out great.","Attachments":[],"Id":685606,"PostDate":1241905055,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                She didn't send me a pic before so I was pretty nervous but there are a few different girls who have ordered very different dresses and I think all of them have turned out great.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Photo by <\/span><a data-ipb='nomediaparse' href=\"http:\/\/www.dlweddings.com\">www.dlweddings.com<\/a><br><br><span>My Planning Thread<\/span><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t46588\">http:\/\/bestdestinationwedding.com\/forum\/t46588<\/a><span>My Wedding Review w\/ Lots of Pics<\/span><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t48352\">http:\/\/bestdestinationwedding.com\/forum\/t48352<\/a><span>Our TTD pics<\/span><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t48445\">http:\/\/bestdestinationwedding.com\/forum\/t48445<\/a><\/div><\/div>","Email":"jacilyn.m.gannon@gmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1212460200,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209727.jpg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Jacilynda","Id":209727,"Name":"Jacilynda","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fd0a45df34b6f664f7e1645ed8f9f698","RawContent":"I have changed my mind about Zero love and I am going with &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.duosheng.cn\/fen\/index1.html\"&gt;Duosheng&lt;\/a&gt; apparently they can use the real pictures of dresses and name the designers as they manufacture them. I have a formal event for work in July so I will be ordering a dress from them first before I order my wedding dress. They have shoes, veils and accessories too. It is just a matter of what to order!!","Attachments":[],"Id":685612,"PostDate":1241906492,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I have changed my mind about Zero love and I am going with <a href='http:\/\/www.duosheng.cn\/fen\/index1.html' class='bbc_url' title='External link' rel='nofollow external'>Duosheng<\/a> apparently they can use the real pictures of dresses and name the designers as they manufacture them. I have a formal event for work in July so I will be ordering a dress from them first before I order my wedding dress. They have shoes, veils and accessories too. It is just a matter of what to order!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/www.ezticker.com\/ticker\/2142\/150\/20100227\/We+Get+Married\/ticker.png\">http:\/\/www.ezticker.com\/ticker\/2142\/...ied\/ticker.png<\/a><\/div><\/div>","Email":"joeymosis@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1233646244,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-214576.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"*tanga*","Id":214576,"Name":"*tanga*","IsOnline":false}}],"Pages":{"TotalItems":6398,"TotalPages":640,"CurrentPage":30,"NextPage":40,"PreviousPage":20,"LastPage":6390},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
