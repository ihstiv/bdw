v>\n<div><\/a><\/div>\n","Email":"tiffmedeiros@gmail.com","IpAddress":"50.177.38.169","GroupId":40,"GroupName":"Jr. Member","JoinDate":1361723426,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-266526.jpg?_r=1427840086","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"MrsCtoB","Id":266526,"Name":"MrsCtoB","IsOnline":true}}],"Pages":{"TotalItems":67,"TotalPages":7,"CurrentPage":10,"NextPage":20,"PreviousPage":0,"LastPage":60},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
