5\">http:\/\/bestdestinationwedding.com\/forum\/t48445<\/a><\/div><\/div>","Email":"jacilyn.m.gannon@gmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1212460200,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209727.jpg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Jacilynda","Id":209727,"Name":"Jacilynda","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"032fda37f3376e88badb3da791e29dae","RawContent":"has anyone ordered replicated bridesmaids dresses?!?","Attachments":[],"Id":745468,"PostDate":1246514170,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                has anyone ordered replicated bridesmaids dresses?!?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/www.bestdestinationwedding.com\/t\/55142\/future-mrs2010-tucks-beaches-t-c-review-long-with-pictures\">My Beaches T&C review<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f128\/meag-tucks-future_mrs2010-super-long-planning-thread-pic-heavy-53999\/\">My planning thread<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f77\/tropical-imaging-review-pictures-future_mrs2010-tucks-55570\/\">Tropical Imaging Review w\/pics<\/a><span><\/span><\/div><\/div>","Email":"future_mrs2010@yahoo.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1244221179,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-218156.gif?_r=0","PhotoWidth":100,"PhotoHeight":68,"PhotoType":"custom"},"FormattedName":"*Meagan*","Id":218156,"Name":"*Meagan*","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"dd6029e2ac28cf1618bc3c9541a75541","RawContent":"Thought I would bump this up to see if anyone else has ordered and recieved their wedding dress yet?\n \n The pictures are soooo helpful - you girls almost have me convinced! :)\n \n I am in love with about 7 dresses at the moment - which makes me think that i&#039;m probably not that fussy and will be happy with whatever they send me! :)\n \n I had my first dress shopping experience last weekend - and I thought I was going to be all about the flowy dress - turns out I much prefer the ones that my fitter MADE me try on, just for comparison! Now I love the corset dresses with the empire and A-line skirts. \n \n Island bride - I was nervous about ordering one with lace until I saw yours - I think they did an amazing job! :)","Attachments":[],"Id":847867,"PostDate":1253145527,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thought I would bump this up to see if anyone else has ordered and recieved their wedding dress yet?<br \/> <br \/> The pictures are soooo helpful - you girls almost have me convinced! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br \/> <br \/> I am in love with about 7 dresses at the moment - which makes me think that i'm probably not that fussy and will be happy with whatever they send me! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br \/> <br \/> I had my first dress shopping experience last weekend - and I thought I was going to be all about the flowy dress - turns out I much prefer the ones that my fitter MADE me try on, just for comparison! Now I love the corset dresses with the empire and A-line skirts. <br \/> <br \/> Island bride - I was nervous about ordering one with lace until I saw yours - I think they did an amazing job! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"joanne.olma@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1249340110,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-220135.JPG?_r=0","PhotoWidth":200,"PhotoHeight":172,"PhotoType":"custom"},"FormattedName":"Jo 2010","Id":220135,"Name":"Jo 2010","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"61ff828abd7333078bd8452145b95036","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;future_mrs2010&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;has anyone ordered replicated bridesmaids dresses?!?&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;I am ordering a replicated bridesmaid dress tonight....It will take 5-6 weeks to get here...I&#039;ll let you know how it comes out!","Attachments":[],"Id":847899,"PostDate":1253146841,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>future_mrs2010<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">has anyone ordered replicated bridesmaids dresses?!?<\/div> <\/td> <\/tr> <\/table> <\/div>I am ordering a replicated bridesmaid dress tonight....It will take 5-6 weeks to get here...I'll let you know how it comes out!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Loving married life! <3<\/span><\/div><\/div>","Email":"ldhearne@gmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1249413540,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-220176.jpg?_r=0","PhotoWidth":199,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"*Linds*","Id":220176,"Name":"*Linds*","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f5a5fdb36bde2503726efeed66fadeb5","RawContent":"Has anyone ever heard of the ebay user gianiarbridal, seems like the majority of the reviews are quite good. and very decent prices.\n \n &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/shop.ebay.com\/gianinarbridal\/m.html?_nkw=&amp;amp;_armrs=1&amp;amp;_from=&amp;amp;_ipg=25\"&gt;eBay Seller: gianinarbridal: Clothing, Shoes Accessories items on eBay.com&lt;\/a&gt;\n \n apparently Duosheng has a page where they show the dresses that they have made. They seem pretty decent as well. I actually ordered from them a few days ago. \n here&#039;s the page if you want to see their work\n \n &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.duosheng.cn\/fen\/Dresses%20photos-Actual%20work1.html\"&gt;\u0160\u00b1\u008f\u2014\u00ae\u02c6\u00a8\u008d\u00be\u00b5\u201e\u0160\u00b1\u2030\u0090\u2020\u00b7\u2026\u2020\u00b7\u00be\u0160\u017d&lt;\/a&gt;","Attachments":[],"Id":847902,"PostDate":1253146895,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Has anyone ever heard of the ebay user gianiarbridal, seems like the majority of the reviews are quite good. and very decent prices.<br \/> <br \/> <a href='http:\/\/shop.ebay.com\/gianinarbridal\/m.html?_nkw=&_armrs=1&_from=&_ipg=25' class='bbc_url' title='External link' rel='nofollow external'>eBay Seller: gianinarbridal: Clothing, Shoes Accessories items on eBay.com<\/a><br \/> <br \/> apparently Duosheng has a page where they show the dresses that they have made. They seem pretty decent as well. I actually ordered from them a few days ago. <br \/> here's the page if you want to see their work<br \/> <br \/> <a href='http:\/\/www.duosheng.cn\/fen\/Dresses%20photos-Actual%20work1.html' class='bbc_url' title='External link' rel='nofollow external'>\u0160\u00b1\u008f\u2014\u00ae\u02c6\u00a8\u008d\u00be\u00b5\u201e\u0160\u00b1\u2030\u0090\u2020\u00b7\u2026\u2020\u00b7\u00be\u0160\u017d<\/a>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;130\/st\/20091202\/e\/Our+Mexican+Wedding\/k\/03bb\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...03bb\/event.png<\/a><\/div><\/div>","Email":"ryanginawedding@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1218354141,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211093.gif?_r=0","PhotoWidth":70,"PhotoHeight":70,"PhotoType":"custom"},"FormattedName":"destinationbridegina","Id":211093,"Name":"destinationbridegina","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible"