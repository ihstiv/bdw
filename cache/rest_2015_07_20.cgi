{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":46,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":true,"Views":2605,"MovedTo":null,"MovedOn":0,"FirstPostId":1879445,"Rating":0,"RatingHits":0,"Starter":{"Id":277264,"Name":"kcole123","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277264.jpg?_r=1429937323","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"StartDate":1417516427,"LastPoster":{"Id":282132,"Name":"KatieMcBride","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282132.jpg?_r=1437356652","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":33,"Preview":{"Id":1879445,"PostDate":1417516427,"PostContent":"Hey Girls, I just ordered these shoes yesterday. I didn't want heels but I wanted something to gi...","Author":{"Signature":"<p style=\"text-align:center;\"><strong>Kristy and Nathan<\/strong><\/p>\n<p style=\"text-align:center;\"><strong>Melia Caribe Tropical <\/strong><\/p>\n<p style=\"text-align:center;\"><strong>April 17, 2015<\/strong>","Email":"colek_64@hotmail.com","IpAddress":"199.180.174.8","GroupId":3,"GroupName":"Member","JoinDate":1395332214,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277264.jpg?_r=1429937323","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"kcole123","Id":277264,"Name":"kcole123","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"206.75.95.238","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78435,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":5,"IsLiked":false,"PostKey":"0e15544f305c762b134457237b207c8b","RawContent":"&lt;p&gt;Hey Girls,&lt;\/p&gt;\n&lt;p&gt;I just ordered these shoes yesterday. I didn&#039;t want heels but I wanted something to give me a bit of height. I figured wedge shoes were the way to go. So here they are. Post pictures of what shoes you will be wearing?&lt;\/p&gt;","Attachments":[{"Id":30121,"Name":"Shoe1.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_12_2014\/post-277264-0-86257400-1417530686.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_12_2014\/post-277264-0-86257400-1417530686_thumb.jpg","Width":570,"Height":490},{"Id":30122,"Name":"Shoe2.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_12_2014\/post-277264-0-96727300-1417530722.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_12_2014\/post-277264-0-96727300-1417530722_thumb.jpg","Width":570,"Height":577},{"Id":30123,"Name":"Shoe3.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_12_2014\/post-277264-0-55600700-1417530747.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_12_2014\/post-277264-0-55600700-1417530747_thumb.jpg","Width":570,"Height":491},{"Id":30124,"Name":"Shoe4.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_12_2014\/post-277264-0-13639300-1417530792.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_12_2014\/post-277264-0-13639300-1417530792_thumb.jpg","Width":570,"Height":444},{"Id":30125,"Name":"Shoe5.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_12_2014\/post-277264-0-06090400-1417530815.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_12_2014\/post-277264-0-06090400-1417530815_thumb.jpg","Width":570,"Height":493}],"Id":1879445,"PostDate":1417516427,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hey Girls,<\/p>\n<p>I just ordered these shoes yesterday. I didn't want heels but I wanted something to give me a bit of height. I figured wedge shoes were the way to go. So here they are. Post pictures of what shoes you will be wearing?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p style=\"text-align:center;\"><strong>Kristy and Nathan<\/strong><\/p>\n<p style=\"text-align:center;\"><strong>Melia Caribe Tropical <\/strong><\/p>\n<p style=\"text-align:center;\"><strong>April 17, 2015<\/strong>","Email":"colek_64@hotmail.com","IpAddress":"199.180.174.8","GroupId":3,"GroupName":"Member","JoinDate":1395332214,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277264.jpg?_r=1429937323","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"kcole123","Id":277264,"Name":"kcole123","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.41.59","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78435,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"c16c44343f60c35d350778a8562ffc97","RawContent":"Love the lace look! I&#039;d totally do that if I wasn&#039;t wearing sandals!  \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1879446,"PostDate":1417516957,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Love the lace look! I'd totally do that if I wasn't wearing sandals!  <a class='resized_img' rel='lightbox[1879446]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_12_2014\/post-277873-141753135356.jpg\" title=\"ImageUploadedByTapatalk1417531349.754834.jpg - Size: 342.32KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_12_2014\/post-277873-141753135356.jpg\" class='bbc_img linked-image' alt=\"ImageUploadedByTapatalk1417531349.754834.jpg\" \/><\/a>\n\n<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"206.75.95.238","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78435,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"3e531031d8ba7a45b9ae5807d528503d","RawContent":"&lt;p&gt;Nice Sandels and I wish I was tall enough to just wear flats. lol&lt;\/p&gt;","Attachments":[],"Id":1879473,"PostDate":1417531928,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Nice Sandels and I wish I was tall enough to just wear flats. lol<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p style=\"text-align:center;\"><strong>Kristy and Nathan<\/strong><\/p>\n<p style=\"text-align:center;\"><strong>Melia Caribe Tropical <\/strong><\/p>\n<p style=\"text-align:center;\"><strong>April 17, 2015<\/strong>","Email":"colek_64@hotmail.com","IpAddress":"199.180.174.8","GroupId":3,"GroupName":"Member","JoinDate":1395332214,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277264.jpg?_r=1429937323","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"kcole123","Id":277264,"Name":"kcole123","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"192.31.106.35","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78435,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":3,"IsLiked":false,"PostKey":"f1708099d33c5531f83b0a48197ceb50","RawContent":"&lt;p&gt;I&#039;m only 4&#039;11\" so I&#039;m going to need some height assistance from my shoes.&amp;nbsp; Right now, I&#039;m looking at both of these but I&#039;m still deciding.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1879477,"PostDate":1417532362,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I'm only 4'11\" so I'm going to need some height assistance from my shoes.\u00a0 Right now, I'm looking at both of these but I'm still deciding.<\/p>\n<p>\u00a0<\/p>\n<p><a class='resized_img' rel='lightbox[1879477]' id='ipb-attach-url-' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_12_2014\/post-279580-0-05801800-1417546652.jpg\" title=\"shoes.jpg - Size: 52.49KB\"><img itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_12_2014\/post-279580-0-05801800-1417546652.jpg\" class='bbc_img linked-image' alt=\"shoes.jpg\" \/><\/a>\n\n<\/p>\n<p>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"keishaandjimmy@gmail.com","IpAddress":"192.31.106.34","GroupId":40,"GroupName":"Jr. Member","JoinDate":1409076707,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"puravida2015","Id":279580,"Name":"puravida2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"206.75.95.238","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78435,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"f1be09649da3f5862a2bc39dbc960a9b","RawContent":"&lt;p&gt;@[member=\"puravida2015\"]&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Wow they are both gorgeous, I like the ones on the right just because of the amount of bling on them but you can&#039;t go wrong with either one.&lt;\/p&gt;","Attachments":[],"Id":1879479,"PostDate":1417532542,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"279580\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/279580-puravida2015\/' title='Member profile'><span itemprop=\"name\">puravida2015<\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wow they are both gorgeous, I like the ones on the right just because of the amount of bling on them but you can't go wrong with either one.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p style=\"text-align:center;\"><strong>Kristy and Nathan<\/strong><\/p>\n<p style=\"text-align:center;\"><strong>Melia Caribe Tropical <\/strong><\/p>\n<p style=\"text-align:center;\"><strong>April 17, 2015<\/strong>","Email":"colek_64@hotmail.com","IpAddress":"199.180.174.8","GroupId":3,"GroupName":"Member","JoinDate":1395332214,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277264.jpg?_r=1429937323","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"kcole123","Id":277264,"Name":"kcole123","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"192.31.106.35","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78435,"EditedBy":"<strong>Edited by puravida2015, 02 December 2014 - 03:40 PM.<\/strong>","EditDate":1417534818,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"8aed157c8bc610a7151a58bb057b43fd","RawContent":"&lt;p&gt;Thanks! I love the idea of wedge heels or flats but I would be such a klutz. I&#039;m the weird girl that walks better in heels than flats! LOL&amp;nbsp; I think the Giovanna&#039;s would like nice as well. My dress doesn&#039;t have any bling on it and those would give me a nice little sparkle. I ordered both so I&#039;m just waiting for them to come in and will try them on with my dress.&lt;\/p&gt;","Attachments":[],"Id":1879483,"PostDate":1417533652,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thanks! I love the idea of wedge heels or flats but I would be such a klutz. I'm the weird girl that walks better in heels than flats! LOL\u00a0 I think the Giovanna's would like nice as well. My dress doesn't have any bling on it and those would give me a nice little sparkle. I ordered both so I'm just waiting for them to come in and will try them on with my dress.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"keishaandjimmy@gmail.com","IpAddress":"192.31.106.34","GroupId":40,"GroupName":"Jr. Member","JoinDate":1409076707,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"puravida2015","Id":279580,"Name":"puravida2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"23.17.81.153","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78435,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8643c6aceca1bdb3262da2db220e49a2","RawContent":"I&#039;d love to do heels but I&#039;m pretty sure I&#039;d land on my face in the sand! I&#039;ll be wearing flat sandals. I am surprisingly having a hard time find ones that I love.","Attachments":[],"Id":1879808,"PostDate":1417812789,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'd love to do heels but I'm pretty sure I'd land on my face in the sand! I'll be wearing flat sandals. I am surprisingly having a hard time find ones that I love. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kcrosby86@msn.com","IpAddress":"142.179.243.111","GroupId":40,"GroupName":"Jr. Member","JoinDate":1398815231,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Kayla88","Id":277780,"Name":"Kayla88","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.119.162.30","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78435,"EditedBy":"<strong>Edited by tygrrlily, 05 December 2014 - 11:49 PM.<\/strong>","EditDate":1417823369,"EditReason":"","DeleteDate":0,"TotalLikes":4,"IsLiked":false,"PostKey":"2c9db0b81ed4a3c56fcc5f13dc2ab151","RawContent":"&lt;p&gt;Pretty Kristy!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;@[member=\"puravida2015\"] - I actually ordered the Badgley Mishka Landmark ones on the left! Thought they&#039;d be my wedding shoes but I had to return them because they were SO uncomfortable, and I can rock heels pretty well.&amp;nbsp; Just a warning to try them on if you go for them.&amp;nbsp; They were very pretty though and blingy - I had the same idea as you because my dress is fairly simple :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I ended up buying these Kate Spade ones after.&amp;nbsp; Decided to go for a mid heel to stay comfy :)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"http:\/\/s15.postimg.org\/7jblm9hyz\/shoes.png\" alt=\"shoes.png\"&gt;&lt;\/p&gt;","Attachments":[],"Id":1879819,"PostDate":1417823325,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Pretty Kristy!<\/p>\n<p>\u00a0<\/p>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"279580\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/279580-puravida2015\/' title='Member profile'><span itemprop=\"name\">puravida2015<\/span><\/a> - I actually ordered the Badgley Mishka Landmark ones on the left! Thought they'd be my wedding shoes but I had to return them because they were SO uncomfortable, and I can rock heels pretty well.\u00a0 Just a warning to try them on if you go for them.\u00a0 They were very pretty though and blingy - I had the same idea as you because my dress is fairly simple <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>I ended up buying these Kate Spade ones after.\u00a0 Decided to go for a mid heel to stay comfy <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/s15.postimg.org\/7jblm9hyz\/shoes.png\" alt=\"shoes.png\"><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Married December 19, 2014 at Beach Palace Resort in Cancun, Mexico<\/p>\n<p>\u00a0<\/p>\n<p>My Planning Thread - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/'>http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>My Wedding Review<\/p>\n<p>Part 1 - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881197'>http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881197<\/a><\/p>\n<p>Part 2 - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881590'>http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881590<\/a><\/p>\n<p>Part 3 - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881861'>http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881861<\/a><\/p>\n<p>\u00a0","Email":"lilyluu83@gmail.com","IpAddress":"174.119.162.30","GroupId":3,"GroupName":"Member","JoinDate":1395594948,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277296.jpg?_r=1421643766","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"tygrrlily","Id":277296,"Name":"tygrrlily","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.41.59","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78435,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1706d07c1a60c3bb3a5f1e4f22730e62","RawContent":"[quote name=\"Kayla88\" post=\"1879808\" timestamp=\"1417827189\"]\nI&#039;d love to do heels but I&#039;m pretty sure I&#039;d land on my face in the sand! I&#039;ll be wearing flat sandals. I am surprisingly having a hard time find ones that I love.[\/quote]The ones I loved were from Aldo. Canadian store was out and USA store wouldn&#039;t ship to a USA address for me because of a Canadian credit card... Sigh! \n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1879823,"PostDate":1417829368,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Kayla88, on 05 December 2014 - 08:53 PM, said:<\/p><div class='blockquote'><div class='quote'><p>I'd love to do heels but I'm pretty sure I'd land on my face in the sand! I'll be wearing flat sandals. I am surprisingly having a hard time find ones that I love.<\/p><\/div><\/div>\n<br>\nThe ones I loved were from Aldo. Canadian store was out and USA store wouldn't ship to a USA address for me because of a Canadian credit card... Sigh! <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"96.227.239.208","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78435,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"322661518ad93184d21dc52eb7d96769","RawContent":"&lt;p&gt;Love your shoes&amp;nbsp;@[member=\"tygrrlily\"]!!!! Super Cute!!! I think it was your post that reminded me to try on the Landmark. Thanks!!! ;)&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I purchased both and had them shipped to my house so I could walk around in them for a bit to see how they feel. I didn&#039;t find the Landmarks uncomfortable as I wear similar heels pretty much everyday but I did find the strap a little loose though. And the heel actually seemed short to me, I&#039;ll want them a smidgen taller (I guess I like hooker shoes). LOL But I think the Giovanna ones are going to will work better with my dress. Still debating and on the lookout for shoes.&lt;\/p&gt;","Attachments":[],"Id":1879829,"PostDate":1417830967,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Love your shoes\u00a0@<a hovercard-ref=\"member\" hovercard-id=\"277296\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277296-tygrrlily\/' title='Member profile'><span itemprop=\"name\">tygrrlily<\/span><\/a>!!!! Super Cute!!! I think it was your post that reminded me to try on the Landmark. Thanks!!! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I purchased both and had them shipped to my house so I could walk around in them for a bit to see how they feel. I didn't find the Landmarks uncomfortable as I wear similar heels pretty much everyday but I did find the strap a little loose though. And the heel actually seemed short to me, I'll want them a smidgen taller (I guess I like hooker shoes). LOL But I think the Giovanna ones are going to will work better with my dress. Still debating and on the lookout for shoes.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"keishaandjimmy@gmail.com","IpAddress":"192.31.106.34","GroupId":40,"GroupName":"Jr. Member","JoinDate":1409076707,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"puravida2015","Id":279580,"Name":"puravida2015","IsOnline":false}}],"Id":"78435","Title":"My Wedding Shoes. Show Us Yours...","LastPostDate":1436877067},"Pages":{"TotalItems":46,"TotalPages":5,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":40},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
