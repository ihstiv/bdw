Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":3,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":339,"MovedTo":null,"MovedOn":0,"FirstPostId":1885055,"Rating":0,"RatingHits":0,"Starter":{"Id":279071,"Name":"Wrathwitch","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1422969607,"LastPoster":{"Id":270119,"Name":"shugapop1","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270119.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":33,"Preview":{"Id":1885055,"PostDate":1422969607,"PostContent":"Yes you read correct LOL!! \u00a0 I always knew I wanted to get married and after coming close once, I...","Author":{"Signature":"","Email":"wrathwitch@yahoo.com","IpAddress":"70.26.161.173","GroupId":39,"GroupName":"Newbie","JoinDate":1405663001,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Wrathwitch","Id":279071,"Name":"Wrathwitch","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"131.137.245.206","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78726,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"0e898754f2a09251d91badbe03539bb3","RawContent":"&lt;p&gt;Yes you read correct LOL!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I always knew I wanted to get married and after coming close once, I realized that if I had to plan a wedding I would likely have an anxiety attack. So I came to the conclusion that this should be a fun time, a celebration of US, not me (and yes I did buy a dress), so I went out one spring\/summer and bought a light tan sun dress with lace over top of it and decided that would be it! I have an amazing LARGE flat freshwater pearl and hammered silver necklace (which cost aprx 550.00) which will compliment the simplicity.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am not wearing any make up other than nice rosy lip gloss (I should have a bit of a glow from tan and heat), nor am I doing my hair, preferring clean, shiny hair that tousels in the wind. When I walk down that aisle, I want him to see ME, not the made up me, but who I truly am. The blessing is that he loves me regardless of most anything and prefers a simple ceremony. Which is the Bronze Wedding Plan at the Excellence Riviera Cancun..&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;It will be nice to start off our marriage in the black!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck to the rest of the ladies and much happiness to you!&lt;\/p&gt;","Attachments":[],"Id":1885055,"PostDate":1422969607,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Yes you read correct LOL!!<\/p>\n<p>\u00a0<\/p>\n<p>I always knew I wanted to get married and after coming close once, I realized that if I had to plan a wedding I would likely have an anxiety attack. So I came to the conclusion that this should be a fun time, a celebration of US, not me (and yes I did buy a dress), so I went out one spring\/summer and bought a light tan sun dress with lace over top of it and decided that would be it! I have an amazing LARGE flat freshwater pearl and hammered silver necklace (which cost aprx 550.00) which will compliment the simplicity.<\/p>\n<p>\u00a0<\/p>\n<p>I am not wearing any make up other than nice rosy lip gloss (I should have a bit of a glow from tan and heat), nor am I doing my hair, preferring clean, shiny hair that tousels in the wind. When I walk down that aisle, I want him to see ME, not the made up me, but who I truly am. The blessing is that he loves me regardless of most anything and prefers a simple ceremony. Which is the Bronze Wedding Plan at the Excellence Riviera Cancun..<\/p>\n<p>\u00a0<\/p>\n<p>It will be nice to start off our marriage in the black!<\/p>\n<p>\u00a0<\/p>\n<p>Good luck to the rest of the ladies and much happiness to you!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"wrathwitch@yahoo.com","IpAddress":"70.26.161.173","GroupId":39,"GroupName":"Newbie","JoinDate":1405663001,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Wrathwitch","Id":279071,"Name":"Wrathwitch","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.89.236.44","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78726,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"b1fcd7c4e762252342935d940483a7cc","RawContent":"&lt;p&gt;Way to go, congratulations.&lt;\/p&gt;","Attachments":[],"Id":1885091,"PostDate":1422985372,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Way to go, congratulations.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"njwood000@gmail.com","IpAddress":"71.7.173.185","GroupId":40,"GroupName":"Jr. Member","JoinDate":1405810391,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Msmimi","Id":279087,"Name":"Msmimi","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.87.101.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78726,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4ccf9f97ee95425158c6cb66b62dc29a","RawContent":"Congrats","Attachments":[],"Id":1885140,"PostDate":1423012936,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Congrats \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"shugapop12@aol.com","IpAddress":"66.87.100.226","GroupId":3,"GroupName":"Member","JoinDate":1369902425,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270119.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"shugapop1","Id":270119,"Name":"shugapop1","IsOnline":false}}],"Id":"78726","Title":"My 25.00 Wedding Dress","LastPostDate":1423012936},"Pages":{"TotalItems":3,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
