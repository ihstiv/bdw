bums\/aa240\/carlymcmullen\/BDW%20Photos%20for%20Others\/weddingdress-loretuke.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;","Attachments":[],"Id":27454,"PostDate":1171773154,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                So I finally got a picture of my dress with me in it and i am REALLY having my doubts. It's a pretty dress but just seems too formal for the beach wedding. Ugh...I don't know what to do <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/sad.gif\" border=\"0\" alt=\"\" title=\"Sad\" class=\"inlineimg\" \/><\/span>. It's driving me crazy.<br \/> <br \/> <img src=\"<span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i197.photobucket.com\/albums\/aa240\/carlymcmullen\/BDW%20Photos%20for%20Others\/weddingdress-loretuke.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Loreta<\/span><br><br><a data-ipb='nomediaparse' href=\"http:\/\/www.studiocontempo.com\/trashthedress\/\">http:\/\/www.studiocontempo.com\/trashthedress\/<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/ourwedding.studiocontempo.com\">http:\/\/ourwedding.studiocontempo.com<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/studiocontempo.blogspot.com\">http:\/\/studiocontempo.blogspot.com<\/a><\/div><\/div>","Email":"lray@spt.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1163542740,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206901.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"loretuke","Id":206901,"Name":"loretuke","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d130e34d60f24fd8ff7cedf706c44b3a","RawContent":"Hi everyone,\n \n Here is the dress that I bought..\n \n &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.davidsbridal.com\/bridal_gowns_detail.jsp?stid=2340&amp;amp;prodgroup=10\"&gt;David&#039;s Bridal - Bridal Gowns T8792 Strapless organza A-line gown with ribbon details on waist and skirt trim.&lt;\/a&gt;\n \n \n Glad to hear that I am not the only one that had a panic about their choice after buying...","Attachments":[],"Id":27513,"PostDate":1171825826,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi everyone,<br \/> <br \/> Here is the dress that I bought..<br \/> <br \/> <a href='http:\/\/www.davidsbridal.com\/bridal_gowns_detail.jsp?stid=2340&prodgroup=10' class='bbc_url' title='External link' rel='nofollow external'>David's Bridal - Bridal Gowns T8792 Strapless organza A-line gown with ribbon details on waist and skirt trim.<\/a><br \/> <br \/> <br \/> Glad to hear that I am not the only one that had a panic about their choice after buying...\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"paddlegurl@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1171601811,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207171.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"paddlegurl","Id":207171,"Name":"paddlegurl","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"be5f90cb0eb71ce9762a3283d4a050c3","RawContent":"My mom was in town this weekend and I showed her my top 2 dresses....and I decided on this one!!! \n \n &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.alvinavalenta.com\/alv\/display_dress.php?imageno=2669&amp;amp;multimatch=x\"&gt;Alvina Valenta&lt;\/a&gt;\n \n Sorry there is no pic of me in it. I go back to get measured next weekend.","Attachments":[],"Id":29967,"PostDate":1172451028,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                My mom was in town this weekend and I showed her my top 2 dresses....and I decided on this one!!! <br \/> <br \/> <a href='http:\/\/www.alvinavalenta.com\/alv\/display_dress.php?imageno=2669&multimatch=x' class='bbc_url' title='External link' rel='nofollow external'>Alvina Valenta<\/a><br \/> <br \/> Sorry there is no pic of me in it. I go back to get measured next weekend.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"katesig@yahoo.com","IpAddress":"98.247.242.206","GroupId":46,"GroupName":"VIP Member","JoinDate":1154919300,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206773.gif?_r=0","PhotoWidth":85,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"-Kate-","Id":206773,"Name":"-Kate-","IsOnline":false}}],"Pages":{"TotalItems":8274,"TotalPages":828,"CurrentPage":30,"NextPage":40,"PreviousPage":20,"LastPage":8270},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
