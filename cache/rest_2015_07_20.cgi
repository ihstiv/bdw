dana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                thats what i did was standard sizing, her measurements on her table are RIGHt on! But now that i've seen and felt her work i highly recommend her and would encourage custom measurements, unless you're really close in measurements to one of her standard sizes\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Photo by <\/span><a data-ipb='nomediaparse' href=\"http:\/\/www.dlweddings.com\">www.dlweddings.com<\/a><br><br><span>My Planning Thread<\/span><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t46588\">http:\/\/bestdestinationwedding.com\/forum\/t46588<\/a><span>My Wedding Review w\/ Lots of Pics<\/span><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t48352\">http:\/\/bestdestinationwedding.com\/forum\/t48352<\/a><span>Our TTD pics<\/span><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t48445\">http:\/\/bestdestinationwedding.com\/forum\/t48445<\/a><\/div><\/div>","Email":"jacilyn.m.gannon@gmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1212460200,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209727.jpg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Jacilynda","Id":209727,"Name":"Jacilynda","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":30824,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a59d31d20b78d7c24adf11a6916aaae5","RawContent":"For those of you who ordered online, did you try the dress on in a store first to determine what style you liked, or did you just &amp;quot;go with your gut&amp;quot;?","Attachments":[],"Id":730333,"PostDate":1245440320,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                For those of you who ordered online, did you try the dress on in a store first to determine what style you liked, or did you just \"go with your gut\"?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10716;24\/st\/20100109\/e\/Our+Wedding\/k\/af33\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...af33\/event.png<\/a><br><br><br><a data-ipb='nomediaparse' href=\"http:\/\/i27.photobucket.com\/albums\/c171\/vandygurl06\/IMG_1116-2.jpg\">http:\/\/i27.photobucket.com\/albums\/c1...IMG_1116-2.jpg<\/a><\/div><\/div>","Email":"lbrewer2@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1243017085,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-217747.gif?_r=0","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"FormattedName":"NYCBridetoBe1909","Id":217747,"Name":"NYCBridetoBe1909","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":t