iew":{"Id":1900389,"PostDate":1436837098,"PostContent":"\u00a0 Im getting hitched in the Caribbean this October third. It will be a nontraditional wedding an...","Author":{"Signature":"","Email":"jazzman2112@gmail.com","IpAddress":"117.217.246.108","GroupId":39,"GroupName":"Newbie","JoinDate":1436836801,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"TheodoreGJasso","Id":283953,"Name":"TheodoreGJasso","IsOnline":false}},"Posts":[],"Id":"79383","Title":"Wedding Dress Quandary?","LastPostDate":1436837098},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":29,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":1512,"MovedTo":null,"MovedOn":0,"FirstPostId":1895585,"Rating":0,"RatingHits":0,"Starter":{"Id":282027,"Name":"Victoriabride","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282027.jpg?_r=1429713632","PhotoWidth":169,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":false},"StartDate":1430951420,"LastPoster":{"Id":282964,"Name":"samwillow","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282964.jpg?_r=1431149209","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":33,"Preview":{"Id":1900310,"PostDate":1436766728,"PostContent":"i love the second one.. on the right. it's simple.. no ruffle","Author":{"Signature":"","Email":"samwillow39@gmail.com","IpAddress":"114.121.164.128","GroupId":39,"GroupName":"Newbie","JoinDate":1430650422,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282964.jpg?_r=1431149209","