{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"198.53.60.140","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79879,"EditedBy":"","EditDate":1453312177,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"4c75dcbf10e356af1ad7cbea2bfb6048","RawContent":"&lt;p&gt;Hello All,&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;I joined this site after stumbling across it and creeping on any post about NOW Sapphire. It has helped me a lot in a few decisions so far. After a week at NOW we are heading next door to&amp;nbsp;Excellence for a bit of a honeymoon. Cant Wait! &amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;Cheers !&lt;\/p&gt;","Attachments":[],"Id":1909794,"PostDate":1453312041,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello All,<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0I joined this site after stumbling across it and creeping on any post about NOW Sapphire. It has helped me a lot in a few decisions so far. After a week at NOW we are heading next door to\u00a0Excellence for a bit of a honeymoon. Cant Wait! \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0Cheers !<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"roo_84@hotmail.com","IpAddress":"198.53.60.140","GroupId":39,"GroupName":"Newbie","JoinDate":1453311887,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-285973.jpg?_r=1465353084","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"AmandaU","Id":285973,"Name":"AmandaU","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.202.225.11","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79879,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"da81f70e4b2aed6116a02d9214657aff","RawContent":"&lt;p&gt;welcome to BDW! &amp;nbsp;NOW Sapphire is a great choice. Please let us know if we can help with any questions.&lt;\/p&gt;","Attachments":[],"Id":1909796,"PostDate":1453313217,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>welcome to BDW! \u00a0NOW Sapphire is a great choice. Please let us know if we can help with any questions.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"font-family:arial, helvetica, sans-serif;\">Founder and Owner of BestDestinationWedding.com \u00a0\/ \u00a0<\/span><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78931-bride-and-groom-fly-free-20152016\/'><strong><span style=\"font-family:arial, helvetica, sans-serif;\">Bride & Groom Fly FREE Promotion<\/span><\/strong><\/a><\/p>\n<p>\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><a data-ipb='nomediaparse' href='https:\/\/www.wrighttravelagency.com\/go\/destination-wedding\/?source=EMLSIG'><strong><span style=\"color:#008080;\">Looking for a travel agency that specializes in Destination Weddings-CLICK HERE<\/span><\/strong><\/a><span style=\"color:#008080;\"><strong>?<\/strong> \u00a0We are an award winning travel agency and you can <\/span><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style=\"color:#008080;\">read our reviews\u00a0here.<\/span><\/a><\/strong><\/span><br>\n\u00a0<br><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"color:#008080;\"><strong>Awards and recognition:\u00a0<\/strong><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Palace Resorts Winner \"Top Travel Agent\", \"Top Homebased Travel Agency\" PRO Platinum Agency (Top Award) \u00a0 \u00a0 | \u00a0 \u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">AMResorts Master Agent & Top Agency \u00a0<\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/68050-karisma-hotels-givc-and-gi-wedding-consultants-wright-travel-agency\/'><strong>Wright Travel & Karisma GIVC Benefits<\/strong><\/a><\/span><\/span><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Travel Impressions Best of the Best Globe Winner \u00a0 \u00a0| \u00a0 \u00a0\u00a0<\/span><\/span><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\">Apple Vacations Golden Apple Winner \u00a0<\/span><\/span><br><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17612\/sml_gallery_206696_17612_13451.png\" alt=\"sml_gallery_206696_17612_13451.png\"><img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/gallery_206696_17572_8409.jpg\" alt=\"gallery_206696_17572_8409.jpg\"> \u00a0 \u00a0<img src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17572\/sml_gallery_206696_17572_1003.jpg\" alt=\"sml_gallery_206696_17572_1003.jpg\"><br><span style=\"color:#008080;\"><span style=\"font-family:arial, helvetica, sans-serif;\"><span style=\"font-size:14px;\"><strong><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/t\/921\/vendor-business-membership-fees-rules-updated-6-18-2010'>Vendor rules are HERE! Please read!<\/a>\u00a0\u00a0<\/strong><\/span><\/span><\/span><strong><span style=\"color:#b22222;\">If you are a vendor and looking to advertise your business,<\/span>\u00a0please email\u00a0<a data-ipb='nomediaparse' href='mailto:ads@bestdestinationwedding.com?subject=Advertising%20on%20BestDestinationWedding.com'>ads@bestdestinationwedding.com<\/a>.<\/strong>","Email":"admin@bestdestinationwedding.com","IpAddress":"71.202.225.11","GroupId":4,"GroupName":"Administrators","JoinDate":1137209820,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206696.jpg?_r=1386394555","PhotoWidth":200,"PhotoHeight":135,"PhotoType":"custom"},"FormattedName":"TammyWright","Id":206696,"Name":"TammyWright","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"142.161.170.48","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79879,"EditedBy":"","EditDate":1453559399,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"e619826c330fea062e90af0258a1e810","RawContent":"&lt;p&gt;Welcome to the boards AmandaU and congrats on your dw!!! Both venues you&#039;re considering have lots of picturesque spots for backdrops to your wedding photos.....as you can see here in the magical wedding moments that matter we captured there....enjoy!!!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;....from the &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10152285887359487.1073741881.18683524486&amp;amp;type=3&#039;&gt;NOW Sapphire Wedding Story Album:&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-yyz1-1.xx.fbcdn.net\/hphotos-xtp1\/t31.0-8\/1836812_10152285889209487_294479734_o.jpg\" alt=\"1836812_10152285889209487_294479734_o.jp\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-yyz1-1.xx.fbcdn.net\/hphotos-prn2\/t31.0-8\/10010300_10152285889709487_764706269_o.jpg\" alt=\"10010300_10152285889709487_764706269_o.j\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-yyz1-1.xx.fbcdn.net\/hphotos-ash2\/t31.0-8\/1658491_10152285891094487_621077093_o.jpg\" alt=\"1658491_10152285891094487_621077093_o.jp\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-yyz1-1.xx.fbcdn.net\/hphotos-ash2\/t31.0-8\/1798918_10152285894759487_1160561147_o.jpg\" alt=\"1798918_10152285894759487_1160561147_o.j\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;...from the &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.facebook.com\/media\/set\/?set=a.10152498670514487.1073741900.18683524486&amp;amp;type=3&#039;&gt;Excellence Riviera Cancun&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-yyz1-1.xx.fbcdn.net\/hphotos-xfa1\/t31.0-8\/10494940_10152498672349487_7678961110157199349_o.jpg\" alt=\"10494940_10152498672349487_7678961110157\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-yyz1-1.xx.fbcdn.net\/hphotos-frc3\/t31.0-8\/10481558_10152498675414487_3399070410916644449_o.jpg\" alt=\"10481558_10152498675414487_3399070410916\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-yyz1-1.xx.fbcdn.net\/hphotos-frc3\/t31.0-8\/10382052_10152498675634487_6244806697421953761_o.jpg\" alt=\"10382052_10152498675634487_6244806697421\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/scontent-yyz1-1.xx.fbcdn.net\/hphotos-xfp1\/t31.0-8\/10453012_10152498677914487_2192352328609361964_o.jpg\" alt=\"10453012_10152498677914487_2192352328609\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Wishing you happy research, and that you find the best answers for your plans - cheers!!! team MTM :)&lt;\/p&gt;","Attachments":[],"Id":1909932,"PostDate":1453559228,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome to the boards AmandaU and congrats on your dw!!! Both venues you're considering have lots of picturesque spots for backdrops to your wedding photos.....as you can see here in the magical wedding moments that matter we captured there....enjoy!!!<\/p>\n<p>\u00a0<\/p>\n<p>....from the <a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10152285887359487.1073741881.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>NOW Sapphire Wedding Story Album:<\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-yyz1-1.xx.fbcdn.net\/hphotos-xtp1\/t31.0-8\/1836812_10152285889209487_294479734_o.jpg\" alt=\"1836812_10152285889209487_294479734_o.jp\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-yyz1-1.xx.fbcdn.net\/hphotos-prn2\/t31.0-8\/10010300_10152285889709487_764706269_o.jpg\" alt=\"10010300_10152285889709487_764706269_o.j\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-yyz1-1.xx.fbcdn.net\/hphotos-ash2\/t31.0-8\/1658491_10152285891094487_621077093_o.jpg\" alt=\"1658491_10152285891094487_621077093_o.jp\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-yyz1-1.xx.fbcdn.net\/hphotos-ash2\/t31.0-8\/1798918_10152285894759487_1160561147_o.jpg\" alt=\"1798918_10152285894759487_1160561147_o.j\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>...from the <a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10152498670514487.1073741900.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>Excellence Riviera Cancun<\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-yyz1-1.xx.fbcdn.net\/hphotos-xfa1\/t31.0-8\/10494940_10152498672349487_7678961110157199349_o.jpg\" alt=\"10494940_10152498672349487_7678961110157\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-yyz1-1.xx.fbcdn.net\/hphotos-frc3\/t31.0-8\/10481558_10152498675414487_3399070410916644449_o.jpg\" alt=\"10481558_10152498675414487_3399070410916\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-yyz1-1.xx.fbcdn.net\/hphotos-frc3\/t31.0-8\/10382052_10152498675634487_6244806697421953761_o.jpg\" alt=\"10382052_10152498675634487_6244806697421\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-yyz1-1.xx.fbcdn.net\/hphotos-xfp1\/t31.0-8\/10453012_10152498677914487_2192352328609361964_o.jpg\" alt=\"10453012_10152498677914487_2192352328609\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>Wishing you happy research, and that you find the best answers for your plans - cheers!!! team MTM <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i1378.photobucket.com\/albums\/ah106\/ContactIDoMexico\/MTM%20Logo%202016_zps4tzm05my.png\" alt=\"MTM%20Logo%202016_zps4tzm05my.png\"><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography , Cancun, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving the Riviera Maya<\/p>\n<p>\u00a0<\/p>\n<p>Email: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p><span style=\"color:#0000cd;\"><strong>Why we're Ranked #1<\/strong><\/span> ~ Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21512-moments-that-matter-photography\/'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a><\/p>\n<p>\u00a0<\/p>\n<p><strong><span style=\"color:#0000cd;\"><span style=\"font-family:'comic sans ms', cursive;\">We Offer<\/span><\/span><\/strong>: <strong><em><u>100% Vendor Fee Discount<\/u><br>\n\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 <u>100% Deposit Guarantee<\/u><\/em><\/strong><\/p>\n<p><strong><em>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 \u00a0 <u>100% Satisfaction Guarantee<\/u><\/em><\/strong>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280196260,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.41.78","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79879,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"10a77e169fba4a9afb65304934361ff2","RawContent":"&lt;p&gt;@AmandaU&amp;nbsp; Congrats and welcome! You&#039;ve picked two beautiful resorts! Both are fairly popular here so if you&#039;re looking for info, it should be easy to find by searching in the search bar up top.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck and happy planning!!&lt;\/p&gt;","Attachments":[],"Id":1909979,"PostDate":1453662286,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@AmandaU\u00a0 Congrats and welcome! You've picked two beautiful resorts! Both are fairly popular here so if you're looking for info, it should be easy to find by searching in the search bar up top.<\/p>\n<p>\u00a0<\/p>\n<p>Good luck and happy planning!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/'><span style=\"color:#ff0099;\"><em>http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.16.209.54","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79879,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e257f7c97b5e5ba21e44561d1bf56880","RawContent":"&lt;p&gt;Congrats Amanda! I&#039;m getting married at Now Sapphire in Jan 2017 and I can&#039;t wait! Have you booked everything yet?&lt;\/p&gt;\n&lt;p&gt;If you are looking for a good photography\/videography service check out&amp;nbsp;&lt;span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\"&gt;Octavio Montes. I&#039;ve only had positive things to say about them so far! I stumbled upon his reviews on this website and saw they were highly rated and had better pricing than the resort photography\/videopgraphy including the outside vendor fee. He has been very responsive and easy to work with so far and asking for details such as what time frame I want, certain looks and shots I&#039;m looking for etc... We are also using his videoography service which also appears to be better priced than others in the area. His website is&amp;nbsp;&lt;\/span&gt;&lt;span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\"&gt;&amp;nbsp;&lt;\/span&gt;&lt;a  class=\"bbc_url\" href=\"http:\/\/www.octaviomontes.com\/\" title=\"External link\"&gt;http:\/\/www.octaviomontes.com\/&lt;\/a&gt;&lt;span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\"&gt;.&lt;\/span&gt;&lt;span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\"&gt;&amp;nbsp;Good luck on planning!&amp;nbsp;&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1912467,"PostDate":1459695074,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congrats Amanda! I'm getting married at Now Sapphire in Jan 2017 and I can't wait! Have you booked everything yet?<\/p>\n<p>If you are looking for a good photography\/videography service check out\u00a0<span  style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif\">Octavio Montes. I've only had positive things to say about them so far! I stumbled upon his reviews on this website and saw they were highly rated and had better pricing than the resort photography\/videopgraphy including the outside vendor fee. He has been very responsive and easy to work with so far and asking for details such as what time frame I want, certain looks and shots I'm looking for etc... We are also using his videoography service which also appears to be better priced than others in the area. His website is\u00a0<\/span><span  style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif\">\u00a0<\/span><a href='http:\/\/www.octaviomontes.com\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.octaviomontes.com\/<\/a><span  style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif\">.<\/span><span  style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif\">\u00a0Good luck on planning!\u00a0<\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"micayla.roth@gmail.com","IpAddress":"24.16.209.54","GroupId":39,"GroupName":"Newbie","JoinDate":1448822565,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-285469.jpg?_r=1459710228","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"cayls55","Id":285469,"Name":"cayls55","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.41.28","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79879,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"756773e14af2223c06db3027b94c41b7","RawContent":"[quote name=\"Moments That Matter\" post=\"1909932\" timestamp=\"1453573628\"]\nWelcome to the boards AmandaU and congrats on your dw!!! Both venues you&#039;re considering have lots of picturesque spots for backdrops to your wedding photos.....as you can see here in the magical wedding moments that matter we captured there....enjoy!!!\n\n....from the [url=\"https:\/\/www.facebook.com\/media\/set\/?set=a.10152285887359487.1073741881.18683524486&amp;amp;type=3\"]NOW Sapphire Wedding Story Album:[\/url]\n[img]https:\/\/scontent-yyz1-1.xx.fbcdn.net\/hphotos-xtp1\/t31.0-8\/1836812_10152285889209487_294479734_o.jpg[\/img]\n\n[img]https:\/\/scontent-yyz1-1.xx.fbcdn.net\/hphotos-prn2\/t31.0-8\/10010300_10152285889709487_764706269_o.jpg[\/img]\n\n[img]https:\/\/scontent-yyz1-1.xx.fbcdn.net\/hphotos-ash2\/t31.0-8\/1658491_10152285891094487_621077093_o.jpg[\/img]\n\n[img]https:\/\/scontent-yyz1-1.xx.fbcdn.net\/hphotos-ash2\/t31.0-8\/1798918_10152285894759487_1160561147_o.jpg[\/img]\n\n...from the [url=\"https:\/\/www.facebook.com\/media\/set\/?set=a.10152498670514487.1073741900.18683524486&amp;amp;type=3\"]Excellence Riviera Cancun[\/url]\n[img]https:\/\/scontent-yyz1-1.xx.fbcdn.net\/hphotos-xfa1\/t31.0-8\/10494940_10152498672349487_7678961110157199349_o.jpg[\/img]\n\n[img]https:\/\/scontent-yyz1-1.xx.fbcdn.net\/hphotos-frc3\/t31.0-8\/10481558_10152498675414487_3399070410916644449_o.jpg[\/img]\n\n[img]https:\/\/scontent-yyz1-1.xx.fbcdn.net\/hphotos-frc3\/t31.0-8\/10382052_10152498675634487_6244806697421953761_o.jpg[\/img]\n\n[img]https:\/\/scontent-yyz1-1.xx.fbcdn.net\/hphotos-xfp1\/t31.0-8\/10453012_10152498677914487_2192352328609361964_o.jpg[\/img]\n\nWishing you happy research, and that you find the best answers for your plans - cheers!!! team MTM :)[\/quote]\nYour photos are always stunning!","Attachments":[],"Id":1912475,"PostDate":1459704057,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Moments That Matter, on 23 January 2016 - 02:27 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Welcome to the boards AmandaU and congrats on your dw!!! Both venues you're considering have lots of picturesque spots for backdrops to your wedding photos.....as you can see here in the magical wedding moments that matter we captured there....enjoy!!!<\/p>\n<p>\u00a0<\/p>\n<p>....from the <a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10152285887359487.1073741881.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>NOW Sapphire Wedding Story Album:<\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-yyz1-1.xx.fbcdn.net\/hphotos-xtp1\/t31.0-8\/1836812_10152285889209487_294479734_o.jpg\" alt=\"1836812_10152285889209487_294479734_o.jp\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-yyz1-1.xx.fbcdn.net\/hphotos-prn2\/t31.0-8\/10010300_10152285889709487_764706269_o.jpg\" alt=\"10010300_10152285889709487_764706269_o.j\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-yyz1-1.xx.fbcdn.net\/hphotos-ash2\/t31.0-8\/1658491_10152285891094487_621077093_o.jpg\" alt=\"1658491_10152285891094487_621077093_o.jp\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-yyz1-1.xx.fbcdn.net\/hphotos-ash2\/t31.0-8\/1798918_10152285894759487_1160561147_o.jpg\" alt=\"1798918_10152285894759487_1160561147_o.j\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>...from the <a href='https:\/\/www.facebook.com\/media\/set\/?set=a.10152498670514487.1073741900.18683524486&type=3' class='bbc_url' title='External link' rel='nofollow external'>Excellence Riviera Cancun<\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-yyz1-1.xx.fbcdn.net\/hphotos-xfa1\/t31.0-8\/10494940_10152498672349487_7678961110157199349_o.jpg\" alt=\"10494940_10152498672349487_7678961110157\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-yyz1-1.xx.fbcdn.net\/hphotos-frc3\/t31.0-8\/10481558_10152498675414487_3399070410916644449_o.jpg\" alt=\"10481558_10152498675414487_3399070410916\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-yyz1-1.xx.fbcdn.net\/hphotos-frc3\/t31.0-8\/10382052_10152498675634487_6244806697421953761_o.jpg\" alt=\"10382052_10152498675634487_6244806697421\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/scontent-yyz1-1.xx.fbcdn.net\/hphotos-xfp1\/t31.0-8\/10453012_10152498677914487_2192352328609361964_o.jpg\" alt=\"10453012_10152498677914487_2192352328609\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>Wishing you happy research, and that you find the best answers for your plans - cheers!!! team MTM <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>Your photos are always stunning!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/'><span style=\"color:#ff0099;\"><em>http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"118.69.78.37","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79879,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e634ac6385de7c1c89076e561c5d7a04","RawContent":"&lt;p&gt;&lt;span style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif;\"&gt;welcome to BDW! nice to meet you... :3&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1912500,"PostDate":1459744989,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span  style=\"color:rgb(40,40,40);font-family:arial, helvetica, sans-serif\">welcome to BDW! nice to meet you... :3<\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><a data-ipb='nomediaparse' href='http:\/\/u99bet.info\/keo-nha-cai\/'>ty le ma cao<\/a>","Email":"kelbiiztd@gmail.com","IpAddress":"116.100.184.13","GroupId":39,"GroupName":"Newbie","JoinDate":1442291617,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kelbiiztd","Id":284817,"Name":"kelbiiztd","IsOnline":false}}],"Pages":{"TotalItems":7,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
