wedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268<\/a><\/p>\n<p>\u00a0<\/p>\n<p>My Now Sapphire review:\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/r\/5487-now-sapphire-riviera-cancun\/'>http:\/\/www.bestdestinationwedding.com\/reviews\/r\/5487-now-sapphire-riviera-cancun\/<\/a>","Email":"ekjzwedding@gmail.com","IpAddress":"24.85.127.174","GroupId":3,"GroupName":"Member","JoinDate":1417435045,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281283.jpg?_r=1428779369","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"vancouverpetunia","Id":281283,"Name":"vancouverpetunia","IsOnline":false}},"Posts":[],"Id":"79068","Title":"Vancouverpetunia - Now Sapphire - April 7, 2016","LastPostDate":1463220505},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":1094,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":87349,"MovedTo":null,"MovedOn":0,"FirstPostId":502421,"Rating":0,"RatingHits":0,"Starter":{"Id":211773,"Name":"SBertling","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211773.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"IsOnline":false},"StartDate":1226008662,"LastPoster":{"Id":286087,"Name":"Nadia2016","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286087.jpg?_r=1456330540","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":2,"Preview":{"Id":502421,"PostDate":1226008662,"PostContent":"Gather here   Getting married Feb. 19\/2009 at 4:30 p.m. on the Sandos private beach!","Author":{"Signature":"","Email":"cuteglutes@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1221593284,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211773.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"SBertling","Id":211773,"Name":"SBertling","IsOnline":false}},"Posts":[],"Id":"26274","Title":"Sandos Playacar Brides!","LastPostDate":1454167928},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":2753,"QueuedPosts":0,"DeletedPosts":7,"HasUnreadPosts":false,"HasAttachments":true,"Views":264036,"MovedTo":null,"MovedOn":0,"FirstPostId":1482069,"Rating":0,"RatingHits":0,"Starter":{"Id":241083,"Name":"RFinger","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-241083.jpg?_r=1388290366","PhotoWidth":200,"PhotoHeight":255,"PhotoType":"custom"},"IsOnline":false},"StartDate":1309970975,"LastPoster":{"Id":281283,"Name":"vancouverpetunia","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281283.jpg?_r=1428779369","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":2,"Preview":{"Id":1482069,"PostDate":1309970975,"PostContent":"Figured since the Paradisus tread isn't getting much action I would created a new one that is cal...","Author":{"Signature":"","Email":"ryan@panthersgrad.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1307972680,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-241083.jpg?_r=1388290366","PhotoWidth":200,"PhotoHeight":255,"PhotoType":"custom"},"FormattedName":"RFinger","Id":241083,"Name":"RFinger","IsOnline":false}},"Posts":[],"Id":"62152","Title":"Now Sapphire Weddings Formerly Paradisus Riviera","LastPostDate":1465086492}],"Filters":{