{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":31705,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8d1b58023f8f4681e28b1458764525d8","RawContent":"Hi PM Wedding,\n \n Where is your wedding taking place? \n \n We have seen a lot of really cute and memorable favors that incorporated the location and the Bride and Groom.\n \n Example: Mexico Wedding they had Mexican Chocolate and Coffee and set up at an exit table for each guest to grab momentos of their visit to Mexico.\n \n The other suggestion is something that is uniquely you. If you love wine, you could make wine charms.\n \n Best of Luck! Can&#039;t wait to hear what you go with.","Attachments":[],"Id":618266,"PostDate":1236833293,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi PM Wedding,<br \/> <br \/> Where is your wedding taking place? <br \/> <br \/> We have seen a lot of really cute and memorable favors that incorporated the location and the Bride and Groom.<br \/> <br \/> Example: Mexico Wedding they had Mexican Chocolate and Coffee and set up at an exit table for each guest to grab momentos of their visit to Mexico.<br \/> <br \/> The other suggestion is something that is uniquely you. If you love wine, you could make wine charms.<br \/> <br \/> Best of Luck! Can't wait to hear what you go with.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"weddings@storybyphoto.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1190743440,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207788.gif?_r=0","PhotoWidth":75,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"www.storybyphoto.com","Id":207788,"Name":"www.storybyphoto.com","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":31705,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8ccab38688e4a36ea4ba04f4d4b06597","RawContent":"we are doing maracas and putting them on the table and getting sombreros to hang on the back of the chairs....totally keeping in with the mexican theme.","Attachments":[],"Id":618363,"PostDate":1236854353,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                we are doing maracas and putting them on the table and getting sombreros to hang on the back of the chairs....totally keeping in with the mexican theme.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;116\/st\/20090630\/e\/Our+Wedding\/dt\/4\/k\/f5fa\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...f5fa\/event.png<\/a><\/div><\/div>","Email":"laura_brown@orange.net","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1212822378,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209794.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"ltbscotland","Id":209794,"Name":"ltbscotland","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":31705,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b4f83058d8aa0ba472a7d54105cc8be0","RawContent":"This is what I am thinking of doing for favors, I think they are so cute!\n Check this thread out&amp;gt;\n \n &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/bestdestinationwedding.com\/forum\/t36092\"&gt;http:\/\/bestdestinationwedding.com\/forum\/t36092&lt;\/a&gt;","Attachments":[],"Id":619185,"PostDate":1236902742,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                This is what I am thinking of doing for favors, I think they are so cute!<br \/> Check this thread out><br \/> <br \/> <a href='http:\/\/bestdestinationwedding.com\/forum\/t36092' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/bestdestinati...om\/forum\/t36092<\/a>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"natr@shaw.ca","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1227933402,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-212920.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"bcbride","Id":212920,"Name":"bcbride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":31705,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"deeede47ad0de7f573b9d73d9ec49303","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;Ayita&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;I am doing plantable wildflowers seeds favors from Botanical Paperworks :\n \n &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.botanicalpaperworks.com\/category\/Plantable+Seed+Wedding+Favors\/3\/\"&gt;Plantable Seed Wedding Favors from Botanical PaperWorks&lt;\/a&gt;\n \n We chose the flip-flops : &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.botanicalpaperworks.com\/product\/Plantable+Flip+Flop+Favors\/346\/\"&gt;Plantable Flip Flop Favors - Plantable Seed Wedding Favors from Botanical PaperWorks&lt;\/a&gt;\n \n They were shortlisted with the bookmarks :\n \n &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.botanicalpaperworks.com\/product\/Plantable+Seeded+Bookmarks\/202\/\"&gt;Plantable Seeded Bookmarks - Plantable Seed Wedding Favors from Botanical PaperWorks&lt;\/a&gt;&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;Hi,\n \n Thanks for the links. I like the idea and have thought about it too. But I wasn wondering, how would you bring seeds across the border? I&#039;m from Calgary..so, I&#039;d have to bring he seeds to Mexico, and then my guest would have to bring them back to Canada. Any suggestions for me?","Attachments":[],"Id":619372,"PostDate":1236916142,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>Ayita<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">I am doing plantable wildflowers seeds favors from Botanical Paperworks :<br \/> <br \/> <a href='http:\/\/www.botanicalpaperworks.com\/category\/Plantable+Seed+Wedding+Favors\/3\/' class='bbc_url' title='External link' rel='nofollow external'>Plantable Seed Wedding Favors from Botanical PaperWorks<\/a><br \/> <br \/> We chose the flip-flops : <a href='http:\/\/www.botanicalpaperworks.com\/product\/Plantable+Flip+Flop+Favors\/346\/' class='bbc_url' title='External link' rel='nofollow external'>Plantable Flip Flop Favors - Plantable Seed Wedding Favors from Botanical PaperWorks<\/a><br \/> <br \/> They were shortlisted with the bookmarks :<br \/> <br \/> <a href='http:\/\/www.botanicalpaperworks.com\/product\/Plantable+Seeded+Bookmarks\/202\/' class='bbc_url' title='External link' rel='nofollow external'>Plantable Seeded Bookmarks - Plantable Seed Wedding Favors from Botanical PaperWorks<\/a><\/div> <\/td> <\/tr> <\/table> <\/div>Hi,<br \/> <br \/> Thanks for the links. I like the idea and have thought about it too. But I wasn wondering, how would you bring seeds across the border? I'm from Calgary..so, I'd have to bring he seeds to Mexico, and then my guest would have to bring them back to Canada. Any suggestions for me?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;53;6\/st\/20091109\/e\/Our+Wedding\/dt\/-2\/k\/73b1\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...73b1\/event.png<\/a><\/div><\/div>","Email":"jon.joann@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1227581884,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-212862.gif?_r=0","PhotoWidth":75,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Jojo","Id":212862,"Name":"Jojo","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":31705,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"dc751ef147fef6bb9f0e33febd4746e9","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;heidi_lk&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;We are doing hot sauce with our own label, and personalized paper fans. We figured the fans will be useful during the ceremony, and that hot sauce fits with the Mexican theme.&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;Where did you get your hot sauce","Attachments":[],"Id":619375,"PostDate":1236916473,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>heidi_lk<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">We are doing hot sauce with our own label, and personalized paper fans. We figured the fans will be useful during the ceremony, and that hot sauce fits with the Mexican theme.<\/div> <\/td> <\/tr> <\/table> <\/div>Where did you get your hot sauce\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>WE ARE MARRIED!!<\/span><\/div><\/div>","Email":"MurSip1775@comcast.net","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1203401259,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208585.gif?_r=0","PhotoWidth":96,"PhotoHeight":72,"PhotoType":"custom"},"FormattedName":"MaryS","Id":208585,"Name":"MaryS","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":31705,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2b7be4439caa47f969c1183ce3752dc2","RawContent":"Great ideas!","Attachments":[],"Id":619937,"PostDate":1236972222,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Great ideas!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/bryonandkiuana.com\">http:\/\/bryonandkiuana.com<\/a><\/div><\/div>","Email":"bryonandkiuana@comcast.net","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1235674671,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-215289.gif?_r=0","PhotoWidth":200,"PhotoHeight":184,"PhotoType":"custom"},"FormattedName":"bryonandkiuana","Id":215289,"Name":"bryonandkiuana","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":31705,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"38d43ee7df4bf8deed2ba64dfc60c4b6","RawContent":"We are getting personalized shotglasses and having them at all the place settings with those mini personal salt bags. When my groomt thanks everyone for coming, he is going to go through the steps for a real tequila shot, while the rest of the bridal party pours the tequila in glasses on the tables.","Attachments":[],"Id":620003,"PostDate":1236976134,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We are getting personalized shotglasses and having them at all the place settings with those mini personal salt bags. When my groomt thanks everyone for coming, he is going to go through the steps for a real tequila shot, while the rest of the bridal party pours the tequila in glasses on the tables.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/ticker.7910.org\/as1cE_U0g410000MDAwODk1b3wwMTU2c3xPdXIgQmVhY2ggV2VkZGluZw.gif\">http:\/\/ticker.7910.org\/as1cE_U0g4100...V2VkZGluZw.gif<\/a><\/div><\/div>","Email":"costabride2009@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1220366614,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211515.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Costabride2009","Id":211515,"Name":"Costabride2009","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":31705,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"0498a0d3ff21bc68e10130cb7ed5b771","RawContent":"We are getting personalized shotglasses and having them at all the place settings with those mini personal salt bags. When my groomt thanks everyone for coming, he is going to go through the steps for a real tequila shot, while the rest of the bridal party pours the tequila in glasses on the tables.","Attachments":[],"Id":620004,"PostDate":1236976149,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We are getting personalized shotglasses and having them at all the place settings with those mini personal salt bags. When my groomt thanks everyone for coming, he is going to go through the steps for a real tequila shot, while the rest of the bridal party pours the tequila in glasses on the tables.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/ticker.7910.org\/as1cE_U0g410000MDAwODk1b3wwMTU2c3xPdXIgQmVhY2ggV2VkZGluZw.gif\">http:\/\/ticker.7910.org\/as1cE_U0g4100...V2VkZGluZw.gif<\/a><\/div><\/div>","Email":"costabride2009@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1220366614,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211515.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Costabride2009","Id":211515,"Name":"Costabride2009","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":31705,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8380936f81c398f6071010f698df7ea7","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;Jojo&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Hi,\n \n Thanks for the links. I like the idea and have thought about it too. But I wasn wondering, how would you bring seeds across the border? I&#039;m from Calgary..so, I&#039;d have to bring he seeds to Mexico, and then my guest would have to bring them back to Canada. Any suggestions for me?&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;I didn&#039;t even think about it. Technically, this is &amp;quot;paper&amp;quot;. I will put mine in an enveloppe (so that they don&#039;t get all torn in the OOT bag). So really, I don&#039;t plan to declare anything to anybody.","Attachments":[],"Id":620151,"PostDate":1236982794,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>Jojo<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Hi,<br \/> <br \/> Thanks for the links. I like the idea and have thought about it too. But I wasn wondering, how would you bring seeds across the border? I'm from Calgary..so, I'd have to bring he seeds to Mexico, and then my guest would have to bring them back to Canada. Any suggestions for me?<\/div> <\/td> <\/tr> <\/table> <\/div>I didn't even think about it. Technically, this is \"paper\". I will put mine in an enveloppe (so that they don't get all torn in the OOT bag). So really, I don't plan to declare anything to anybody.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"muriel.brisson@gmail.com","IpAddress":"99.65.25.31","GroupId":3,"GroupName":"Member","JoinDate":1224520299,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-212340.gif?_r=0","PhotoWidth":98,"PhotoHeight":98,"PhotoType":"custom"},"FormattedName":"Ayita","Id":212340,"Name":"Ayita","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":31705,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0d4e9627d787cb577691823f33459056","RawContent":"we are doing a few different ones\n life savers with out names on them with flip flop picture\n candle shaped like a beach chair\n personalized mini sunscreen.they are pink with our names and flip flops\n sugar cookies with our names and dates shaped like sandels\n also lemonade packets personalized..\n we will put everything in a little gift bag","Attachments":[],"Id":620218,"PostDate":1236986771,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                we are doing a few different ones<br \/> life savers with out names on them with flip flop picture<br \/> candle shaped like a beach chair<br \/> personalized mini sunscreen.they are pink with our names and flip flops<br \/> sugar cookies with our names and dates shaped like sandels<br \/> also lemonade packets personalized..<br \/> we will put everything in a little gift bag\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/www.ezticker.com\/ticker\/107\/224\/20090720\/We+get+Married%21%21\/ticker.png\">http:\/\/www.ezticker.com\/ticker\/107\/2...%21\/ticker.png<\/a><\/div><\/div>","Email":"smilesnj17@aol.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1234058597,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-214720.gif?_r=0","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"FormattedName":"LAURENANDBILL","Id":214720,"Name":"LAURENANDBILL","IsOnline":false}}],"Pages":{"TotalItems":158,"TotalPages":16,"CurrentPage":10,"NextPage":20,"PreviousPage":0,"LastPage":150},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
