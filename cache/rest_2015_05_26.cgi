alse},"PollState":"0","LastVote":0,"ForumId":91,"Preview":{"Id":1885910,"PostDate":1423600413,"PostContent":"I hesitated so much about posting this planning thread, but reading other people's has helped me...","Author":{"Signature":"<br><p><a data-ipb='nomediaparse' href='http:\/\/www.TickerFactory.com\/'><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;31;484\/st\/20150813\/e\/Wedding+time%21+\/dt\/-2\/k\/b92c\/event.png\" alt=\"event.png\"><\/a><\/p>\n<p style=\"text-align:center;\">\u00a0<\/p>\n<p style=\"text-align:center;\">\u00a0","Email":"sblopezb@gmail.com","IpAddress":"172.219.193.22","GroupId":42,"GroupName":"Sr. Member","JoinDate":1359766704,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265511.jpg?_r=1427386564","PhotoWidth":200,"PhotoHeight":153,"PhotoType":"custom"},"FormattedName":"TinkerSofi","Id":265511,"Name":"TinkerSofi","IsOnline":false}},"Posts":[],"Id":"78768","Title":"Tinkersofi's Planning Thread - Azul Fives August 13, 2015","LastPostDate":1432571222},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":461,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":true,"Views":13028,"MovedTo":null,"MovedOn":0,"FirstPostId":1885622,"Rating":0,"RatingHits":0,"Starter":{"Id":281478,"Name":"perianjay","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1428347017","PhotoWidth":169,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":false},"StartDate":1423414005,"LastPoster":{"Id":277264,"Name":"kcole123","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277264.jpg?_r=1429937323","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":91,"Preview":{"Id":1