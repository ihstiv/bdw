595959\">\u00b7\u00a0\u00a0\u00a0\u00a0 <\/span><span  style=\"color:#595959\">Azul Hotels<\/span><\/span><\/span><\/p>\n<p  style=\"margin-left:.25in;text-align:center\"><span  style=\"font-family:arial, helvetica, sans-serif\"><span  style=\"font-size:14px\"><span  style=\"color:#595959\">\u00b7\u00a0\u00a0\u00a0\u00a0 <\/span><span  style=\"color:#595959\">Casa Velas<\/span><\/span><\/span><\/p>\n<p  style=\"margin-left:.25in;text-align:center\"><span  style=\"font-family:arial, helvetica, sans-serif\"><span  style=\"font-size:14px\"><span  style=\"color:#595959\">\u00b7\u00a0\u00a0\u00a0\u00a0 <\/span><span  style=\"color:#595959\">Dreams Resorts<\/span><\/span><\/span><\/p>\n<p  style=\"margin-left:.25in;text-align:center\"><span  style=\"font-family:arial, helvetica, sans-serif\"><span  style=\"font-size:14px\"><span  style=\"color:#595959\">\u00b7\u00a0\u00a0\u00a0\u00a0 <\/span><span  style=\"color:#595959\">El Dorado Resorts<\/span><\/span><\/span><\/p>\n<p  style=\"margin-left:.25in;text-align:center\"><span  style=\"font-family:arial, helvetica, sans-serif\"><span  style=\"font-size:14px\"><span  style=\"color:#595959\">\u00b7\u00a0\u00a0\u00a0\u00a0 <\/span><span  style=\"color:#595959\">Garza Blanca Resorts<\/span><\/span><\/span><\/p>\n<p  style=\"margin-left:.25in;text-align:center\"><span  style=\"font-family:arial, helvetica, sans-serif\"><span  style=\"font-size:14px\"><span  style=\"color:#595959\">\u00b7\u00a0\u00a0\u00a0\u00a0 <\/span><span  style=\"color:#595959\">Generation Resorts<\/span><\/span><\/span><\/p>\n<p  style=\"margin-left:.25in;text-align:center\"><span  style=\"font-family:arial, helvetica, sans-serif\"><span  style=\"font-size:14px\"><span  style=\"color:#595959\">\u00b7\u00a0\u00a0\u00a0\u00a0 <\/span><span  style=\"color:#595959\">Grand Velas Resorts<\/span><\/span><\/span><\/p>\n<p  style=\"margin-left:.25in;text-align:center\"><span  style=\"font-family:arial, helvetica, sans-serif\"><span  style=\"font-size:14px\"><span  st