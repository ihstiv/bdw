959;\"&gt;Or Call:&lt;strong&gt; 1-415-839-7511&lt;\/strong&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"text-align:center;\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"text-align:center;\"&gt;&lt;strong&gt;&lt;span style=\"color:#595959;\"&gt;&lt;span style=\"font-family:&#039;calibri light&#039;, sans-serif;\"&gt;&lt;span style=\"font-size:14pt;\"&gt;Featured Resort Brands:&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p style=\"text-align:center;\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"margin-left:.25in;text-align:center;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"color:#595959;\"&gt;\u00b7\t &lt;\/span&gt;&lt;span style=\"color:#595959;\"&gt;All-Inclusive Collection - Hard Rock Hotels&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"margin-left:.25in;text-align:center;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"color:#595959;\"&gt;\u00b7\t &lt;\/span&gt;&lt;span style=\"color:#595959;\"&gt;Azul Hotels&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"margin-left:.25in;text-align:center;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"color:#595959;\"&gt;\u00b7\t &lt;\/span&gt;&lt;span style=\"color:#595959;\"&gt;Casa Velas&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"margin-left:.25in;text-align:center;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;&lt;span style=\"font-size:14px;\"&gt;&lt;span style=\"color:#595959;\"&gt;\u00b7\t &lt;\/span&gt;&lt;span style=\"color:#595959;\"&gt;Dreams Resorts&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p style=\"margin-left:.25in;text-align:center;\"&gt;&lt;span style=\"font-family:arial, helvetica, sans-serif;\"&gt;&lt;span style=\"font-size:1