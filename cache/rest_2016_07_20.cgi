Liked":false,"PostKey":"a8856f5ed5aadaf57fa5d7015bc73baf","RawContent":"&lt;p&gt; what an amazing job, congrats!&lt;\/p&gt;","Attachments":[],"Id":1641223,"PostDate":1342210261,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> what an amazing job, congrats!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Ddmaust@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1341329633,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-257411.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"safety75","Id":257411,"Name":"safety75","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":68170,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0ee858d292cfb8107291d8347fbe6fae","RawContent":"&lt;p&gt; Congrats, they look great.&lt;\/p&gt;","Attachments":[],"Id":1705747,"PostDate":1358209397,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Congrats, they look great.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"orlabree@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1358206628,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-264435.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"breeo","Id":264435,"Name":"breeo","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":68170,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b63a23248d1724614952cba9e0dbe596","RawContent":"&lt;p&gt; I love the insert paper on the envelopes.&amp;nbsp; Nice touch!&lt;\/p&gt;","Attachments":[],"Id":1708142,"PostDate":1358592597,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I love the insert paper on the envelopes.\u00a0 Nice touch!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"blacklightning02@netscape.net","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1358124863,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-264370.jpeg?_r=0","PhotoWidth":180,"PhotoHeight":135,"PhotoType":"custom"},"FormattedName":"llincks","Id":264370,"Name":"llincks","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":68170,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8838315be675527bb882f16fce351950","RawContent":"&lt;p&gt; Very nice !&lt;\/p&gt;","Attachments":[],"Id":1717934,"PostDate":1360335700,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Very nice !<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"morgane.bellot@free.fr","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1360333086,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265823.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"morgane31","Id":265823,"Name":"morgane31","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":68170,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4982a4d7b0736dc1fb6ee72ca3e335e4","RawContent":"[color=#ff0099]YES, YES AND YES!!! [\/color] \n [color=#ff0099]I look when people include pictures in their posts! Using the wrapping paper instead of scrapbook paper is INGENIOUS!!! Now, I just have to find some paper that will compliment my wedding colors! Off to Dollar Tree! Hopefully, I will get lucky! :) [\/color] [quote]\nOriginally Posted by [b]MissBubbles205[\/b] \/img\/forum\/go_quote.gif\n \n \n Picture directions.. Now your speaking my language, Love it!!!.. :o)  Thanks for sharing!!.. I&#039;m going to haft to try this for our Invites!.. You are soo creative with the wrapping paper decision![\/quote]","Attachments":[],"Id":1750822,"PostDate":1366918733,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <span  style=\"color:#ff0099\">YES, YES AND YES!!!\u00a0<\/span><\/p> <p> <span  style=\"color:#ff0099\">I look when people include pictures in their posts! Using the wrapping paper instead of scrapbook paper is INGENIOUS!!! Now, I just have to find some paper that will compliment my wedding colors! Off to Dollar Tree! Hopefully, I will get lucky! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0<\/span><\/p> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>MissBubbles205<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <p> Picture directions.. Now your speaking my language, Love it!!!.. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/ohmy.png' class='bbc_emoticon' alt=':o' \/>)\u00a0 Thanks for sharing!!.. I'm going to haft to try this for our Invites!.. You are soo creative with the wrapping paper decision!<\/p> <\/blockquote>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Bride2be4414@gmail.com","IpAddress":"96.58.36.78","GroupId":40,"GroupName":"Jr. Member","JoinDate":1366313632,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-268722.png?_r=0","PhotoWidth":200,"PhotoHeight":164,"PhotoType":"custom"},"FormattedName":"CAKnight","Id":268722,"Name":"CAKnight","IsOnline":false}}],"Pages":{"TotalItems":25,"TotalPages":3,"CurrentPage":10,"NextPage":20,"PreviousPage":0,"LastPage":20},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
