{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":225,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":true,"Views":32394,"MovedTo":null,"MovedOn":0,"FirstPostId":1855399,"Rating":0,"RatingHits":0,"Starter":{"Id":258172,"Name":"BrandyMarie1023","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-258172.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"StartDate":1402876819,"LastPoster":{"Id":280700,"Name":"Jariana2010","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":22,"Preview":{"Id":1884756,"PostDate":1422642095,"PostContent":"@TinaBanita19 hello our wedding is May 1st, we are flying in our photographer from \"home\" and usi...","Author":{"Signature":"May 01, 2015- complete!! 73 guests+bride & groom! Now Larimar Punta Cana! ","Email":"cooper.tyshelle@gmail.com","IpAddress":"108.50.56.179","GroupId":40,"GroupName":"Jr. Member","JoinDate":1375998669,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272393.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"DR2015","Id":272393,"Name":"DR2015","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"206.174.246.100","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77311,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"dec987091883b1563a07858a175b343b","RawContent":"[quote name=\"rmg428\" post=\"1884495\" timestamp=\"1422479149\"]\nMy wedding is July 24th.  I&#039;ll be there from July 21st through July 31st![\/quote]Exciting :)\n\nWe will have to chats more.... I&#039;m still trying to finalize my dress. Until that&#039;s complete, I don&#039;t think I can think about anything else....","Attachments":[],"Id":1884500,"PostDate":1422465716,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>rmg428, on 28 January 2015 - 05:05 PM, said:<\/p><div class='blockquote'><div class='quote'><p>My wedding is July 24th.\u00a0 I'll be there from July 21st through July 31st!<\/p><\/div><\/div>\n<br>\nExciting <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br><br>\nWe will have to chats more.... I'm still trying to finalize my dress. Until that's complete, I don't think I can think about anything else....\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"feliciajones411@me.com","IpAddress":"170.218.219.21","GroupId":39,"GroupName":"Newbie","JoinDate":1418912679,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281438.jpg?_r=1418928163","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Dominican2015","Id":281438,"Name":"Dominican2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"199.173.224.30","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77311,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b53ba1c2397c91e6fe09267cdfd09010","RawContent":"[quote name=\"abrinton8811\" post=\"1884498\" timestamp=\"1422479944\"]\nMy wedding is July 18th so we will be there from the 14th-21st! I&#039;m starting to feel stressed with decorations and everything![\/quote]I&#039;m starting to feel stressed too girl!  Everyone keeps asking me how I&#039;m going to get all this stuff down there... I suppose I&#039;ll wing it.  Are you pretty much planned?  I have my centerpieces planned... my welcome bags are being designed now... but I don&#039;t want to go too crazy until I have a final count.  We thought we&#039;d only have about 35 attending and we are already over 40... so the panic is setting in.  I dream about this stuff in my sleep, haha.\n[quote name=\"Dominican2015\" post=\"1884500\" timestamp=\"1422480116\"]\nExciting :)\n\nWe will have to chats more.... I&#039;m still trying to finalize my dress. Until that&#039;s complete, I don&#039;t think I can think about anything else....[\/quote]The dress is the only thing I&#039;ve got completely taken care of.  Get that done, and hopefully we can trade ideas.","Attachments":[],"Id":1884502,"PostDate":1422467129,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>abrinton8811, on 28 January 2015 - 05:19 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>My wedding is July 18th so we will be there from the 14th-21st! I'm starting to feel stressed with decorations and everything!<\/p>\n<\/div>\n<\/div><\/div>\n<p>I'm starting to feel stressed too girl!\u00a0 Everyone keeps asking me how I'm going to get all this stuff down there... I suppose I'll wing it.\u00a0 Are you pretty much planned?\u00a0 I have my centerpieces planned... my welcome bags are being designed now... but I don't want to go too crazy until I have a final count.\u00a0 We thought we'd only have about 35 attending and we are already over 40... so the panic is setting in.\u00a0 I dream about this stuff in my sleep, haha.<\/p><br \/><p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Dominican2015, on 28 January 2015 - 05:21 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Exciting <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br><br>\nWe will have to chats more.... I'm still trying to finalize my dress. Until that's complete, I don't think I can think about anything else....<\/p>\n<\/div>\n<\/div><\/div>\n<p>The dress is the only thing I've got completely taken care of.\u00a0 Get that done, and hopefully we can trade ideas.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ritagardner@earthlink.net","IpAddress":"199.173.225.33","GroupId":39,"GroupName":"Newbie","JoinDate":1407422015,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279351.jpg?_r=1422475580","PhotoWidth":198,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"rmg428","Id":279351,"Name":"rmg428","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.196.199.250","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77311,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c2696208e89106de7386471d6fa314e8","RawContent":"[quote name=\"Dominican2015\" post=\"1884500\" timestamp=\"1422480116\"]\nExciting :)\nWe will have to chats more.... I&#039;m still trying to finalize my dress. Until that&#039;s complete, I don&#039;t think I can think about anything else....[\/quote]  \nI would love to chat more! It&#039;s so nice to talk to people who understand this process and what we are going through! \n[quote name=\"rmg428\" post=\"1884502\" timestamp=\"1422481529\"]\nI&#039;m starting to feel stressed too girl!  Everyone keeps asking me how I&#039;m going to get all this stuff down there... I suppose I&#039;ll wing it.  Are you pretty much planned?  I have my centerpieces planned... my welcome bags are being designed now... but I don&#039;t want to go too crazy until I have a final count.  We thought we&#039;d only have about 35 attending and we are already over 40... so the panic is setting in.  I dream about this stuff in my sleep, haha.\nThe dress is the only thing I&#039;ve got completely taken care of.  Get that done, and hopefully we can trade ideas.[\/quote]Lol I have still have so much planning to do!! I keep waiting for a count to order stuff since I don&#039;t want to over or under order anything! What are you doing for your center pieces? Are you having a company do your bags and what are you putting in them? Bags were going to be my next project to work on! :)","Attachments":[],"Id":1884503,"PostDate":1422467481,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Dominican2015, on 28 January 2015 - 05:21 PM, said:<\/p><div class='blockquote'><div class='quote'><p>Exciting <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br>\nWe will have to chats more.... I'm still trying to finalize my dress. Until that's complete, I don't think I can think about anything else....<\/p><\/div><\/div>\u00a0\u00a0<br>\nI would love to chat more! It's so nice to talk to people who understand this process and what we are going through! <br><p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>rmg428, on 28 January 2015 - 05:45 PM, said:<\/p><div class='blockquote'><div class='quote'><p>I'm starting to feel stressed too girl!\u00a0 Everyone keeps asking me how I'm going to get all this stuff down there... I suppose I'll wing it.\u00a0 Are you pretty much planned?\u00a0 I have my centerpieces planned... my welcome bags are being designed now... but I don't want to go too crazy until I have a final count.\u00a0 We thought we'd only have about 35 attending and we are already over 40... so the panic is setting in.\u00a0 I dream about this stuff in my sleep, haha.<br>\nThe dress is the only thing I've got completely taken care of.\u00a0 Get that done, and hopefully we can trade ideas.<\/p><\/div><\/div>\nLol I have still have so much planning to do!! I keep waiting for a count to order stuff since I don't want to over or under order anything! What are you doing for your center pieces? Are you having a company do your bags and what are you putting in them? Bags were going to be my next project to work on! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"abrinton8811@gmail.com","IpAddress":"70.196.206.150","GroupId":39,"GroupName":"Newbie","JoinDate":1419021825,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"abrinton8811","Id":281451,"Name":"abrinton8811","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"199.173.224.30","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77311,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8dbca9c5f0c08f54d004ea08003cb366","RawContent":"[quote name=\"abrinton8811\" post=\"1884503\" timestamp=\"1422481881\"]\n  \nI would love to chat more! It&#039;s so nice to talk to people who understand this process and what we are going through!\nLol I have still have so much planning to do!! I keep waiting for a count to order stuff since I don&#039;t want to over or under order anything! What are you doing for your center pieces? Are you having a company do your bags and what are you putting in them? Bags were going to be my next project to work on! :)[\/quote]I got aqua colored square paper lanterns for my centerpiece with light gold votives and seaglass sprinked on the table.  The lanterns are nice b\/c they fold up so they are easy to transport and my wedding coordinator at Now, Luisa told me that there isn&#039;t a charge for using them which is awesome! \n\nAs for my bags... I found canvas bags on etsy that are reasonable and customizable.  When I get the proof back, I will post it.  I&#039;m putting the following in the bags:\nKoozies (etsy)\nPlastic Tumblers (etsy)\nResort key\/money holder (waterproof and super cheap) \nWelcome Letter\nItinerary\nIn sickness and in health bag - pepto, advil, tylenol, shout wipe, band aids, mints, tums\nHand Sanitizer (bath and body on sale)\nCoconut body lotion (bath and body on sale)\nSun screen\nWord search book\nGum\nTissues\nChapstick SPF\nSewing Kit\nGatoraide packets\/kids get koolaid packets\nBeach balls\n\nI think thats it!  I&#039;ve just got to get it all together... and down there :blink:","Attachments":[],"Id":1884506,"PostDate":1422468085,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>abrinton8811, on 28 January 2015 - 05:51 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>\u00a0\u00a0<br>\nI would love to chat more! It's so nice to talk to people who understand this process and what we are going through!<br>\nLol I have still have so much planning to do!! I keep waiting for a count to order stuff since I don't want to over or under order anything! What are you doing for your center pieces? Are you having a company do your bags and what are you putting in them? Bags were going to be my next project to work on! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<\/div>\n<\/div><\/div>\n<p>I got aqua colored square paper lanterns for my centerpiece with light gold votives and seaglass sprinked on the table.\u00a0 The lanterns are nice b\/c they fold up so they are easy to transport and my wedding coordinator at Now, Luisa told me that there isn't a charge for using them which is awesome!\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>As for my bags... I found canvas bags on etsy that are reasonable and customizable.\u00a0 When I get the proof back, I will post it.\u00a0 I'm putting the following in the bags:<\/p>\n<p>Koozies (etsy)<\/p>\n<p>Plastic Tumblers (etsy)<\/p>\n<p>Resort key\/money holder (waterproof and super cheap)\u00a0<\/p>\n<p>Welcome Letter<\/p>\n<p>Itinerary<\/p>\n<p>In sickness and in health bag - pepto, advil, tylenol, shout wipe, band aids, mints, tums<\/p>\n<p>Hand Sanitizer (bath and body on sale)<\/p>\n<p>Coconut body lotion (bath and body on sale)<\/p>\n<p>Sun screen<\/p>\n<p>Word search book<\/p>\n<p>Gum<\/p>\n<p>Tissues<\/p>\n<p>Chapstick SPF<\/p>\n<p>Sewing Kit<\/p>\n<p>Gatoraide packets\/kids get koolaid packets<\/p>\n<p>Beach balls<\/p>\n<p>\u00a0<\/p>\n<p>I think thats it!\u00a0 I've just got to get it all together... and down there <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/blink.png' class='bbc_emoticon' alt=':blink:' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ritagardner@earthlink.net","IpAddress":"199.173.225.33","GroupId":39,"GroupName":"Newbie","JoinDate":1407422015,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279351.jpg?_r=1422475580","PhotoWidth":198,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"rmg428","Id":279351,"Name":"rmg428","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"96.27.188.207","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77311,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8b6b6778e90dd37ce8344081a1d8621b","RawContent":"[quote name=\"rmg428\" post=\"1884472\" timestamp=\"1422475477\"]\n@[url=\"http:\/\/www.bestdestinationwedding.com\/user\/281044-kosrae89\/\"]kosrae89[\/url]  Thank you so much for sharing your wedding photos.  I have Claudia booked as well for our July 24th wedding at Now.  I don&#039;t have her booked for the 1st hour of our reception, and I was wondering if you would recommend that I add that?  Was it worth the extra $500?  Also, how long did it take for pictures between the end of the ceremony and the reception.  I too booked the minister for my symbolic wedding which is at 5:30... the cocktail hour immediately follows at 6:00 and reception at the pool at 7pm.  Not sure if I should push the wedding back to 5:00.  Did you feel rushed?  Also, do you know what the difference is between the quiet pool and the relaxing pool?  I can&#039;t tell which is which.  I would love to have your full review emailed to me when you complete it.  Thank you again!\n\nRita\n[email=\"ritagardner@earthlink.net\"]ritagardner@earthlink.net[\/email][\/quote]I just emailed you the full review and the answers to your questions! Please let me know if you have any more questions. Happy planning!","Attachments":[],"Id":1884521,"PostDate":1422475646,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>rmg428, on 28 January 2015 - 04:04 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>@<a href='http:\/\/www.bestdestinationwedding.com\/user\/281044-kosrae89\/' class='bbc_url' title=''>kosrae89<\/a>\u00a0 Thank you so much for sharing your wedding photos.\u00a0 I have Claudia booked as well for our July 24th wedding at Now.\u00a0 I don't have her booked for the 1st hour of our reception, and I was wondering if you would recommend that I add that?\u00a0 Was it worth the extra $500?\u00a0 Also, how long did it take for pictures between the end of the ceremony and the reception.\u00a0 I too booked the minister for my symbolic wedding which is at 5:30... the cocktail hour immediately follows at 6:00 and reception at the pool at 7pm.\u00a0 Not sure if I should push the wedding back to 5:00.\u00a0 Did you feel rushed?\u00a0 Also, do you know what the difference is between the quiet pool and the relaxing pool?\u00a0 I can't tell which is which.\u00a0 I would love to have your full review emailed to me when you complete it.\u00a0 Thank you again!<\/p>\n<p>\u00a0<\/p>\n<p>Rita<\/p>\n<p><a href='mailto:ritagardner@earthlink.net' class='bbc_url' title='External link' rel='nofollow external'>ritagardner@earthlink.net<\/a><\/p>\n<\/div>\n<\/div><\/div>\n<p>I just emailed you the full review and the answers to your questions! Please let me know if you have any more questions. Happy planning!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cneumann1289@gmail.com","IpAddress":"107.77.68.94","GroupId":39,"GroupName":"Newbie","JoinDate":1415455102,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kosrae89","Id":281044,"Name":"kosrae89","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.179.35.182","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77311,"EditedBy":"<strong>Edited by DR2015, 30 January 2015 - 06:21 PM.<\/strong>","EditDate":1422642113,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f8a2c9e572f84a73181180118ff2d1a7","RawContent":"@[member=\"TinaBanita19\"] hello our wedding is May 1st, we are flying in our photographer from \"home\" and using DJ Mannia. I found flying in a photographer and using a outside DJ to be cheaper than using the resort. \n\n\n\n\nDoes any one have Francina for their coordinator?!","Attachments":[],"Id":1884756,"PostDate":1422642095,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"268231\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/268231-tinabanita19\/' title='Member profile'><span itemprop=\"name\">TinaBanita19<\/span><\/a> hello our wedding is May 1st, we are flying in our photographer from \"home\" and using DJ Mannia. I found flying in a photographer and using a outside DJ to be cheaper than using the resort. <br><br><br><br>\nDoes any one have Francina for their coordinator?!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"May 01, 2015- complete!! 73 guests+bride & groom! Now Larimar Punta Cana! ","Email":"cooper.tyshelle@gmail.com","IpAddress":"108.50.56.179","GroupId":40,"GroupName":"Jr. Member","JoinDate":1375998669,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272393.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"DR2015","Id":272393,"Name":"DR2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"104.162.168.61","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77311,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f1e45a7059a2e698f6dcc45f51098138","RawContent":"[quote name=\"DR2015\" post=\"1884756\" timestamp=\"1422656495\"]\n@[member=\"TinaBanita19\"] hello our wedding is May 1st, we are flying in our photographer from \"home\" and using DJ Mannia. I found flying in a photographer and using a outside DJ to be cheaper than using the resort. \n\n\n\nDoes any one have Francina for their coordinator?![\/quote] \n\nHi DR2015! My wedding is in August and Francina is my coordinator. She has been really helpful until now. How has it been for you?","Attachments":[],"Id":1884766,"PostDate":1422650344,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>DR2015, on 30 January 2015 - 06:21 PM, said:<\/p><div class='blockquote'><div class='quote'><p>@<a hovercard-ref=\"member\" hovercard-id=\"268231\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/268231-tinabanita19\/' title='Member profile'><span itemprop=\"name\">TinaBanita19<\/span><\/a> hello our wedding is May 1st, we are flying in our photographer from \"home\" and using DJ Mannia. I found flying in a photographer and using a outside DJ to be cheaper than using the resort. <br><br><br><br>\nDoes any one have Francina for their coordinator?!<\/p><\/div><\/div> <br><br>\nHi DR2015! My wedding is in August and Francina is my coordinator. She has been really helpful until now. How has it been for you?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ariadna.diaz89@hotmail.com","IpAddress":"104.162.168.61","GroupId":39,"GroupName":"Newbie","JoinDate":1413583874,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Jariana2010","Id":280700,"Name":"Jariana2010","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.179.35.182","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77311,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"86d93950a205b91b1be52976b533a180","RawContent":"@[member=\"Jariana2010\"] same here- I would say since around thanksgiving she has been slacking, at one point I emailed her supervisor Mercy to ask if Francina still worked there and of course Francina responded to my month old email at that point. I know we aren&#039;t the only wedding but for the amount of people we are traveling with I would like to think this is going to be well worth the travel and expense..","Attachments":[],"Id":1884767,"PostDate":1422652327,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"280700\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/280700-jariana2010\/' title='Member profile'><span itemprop=\"name\">Jariana2010<\/span><\/a> same here- I would say since around thanksgiving she has been slacking, at one point I emailed her supervisor Mercy to ask if Francina still worked there and of course Francina responded to my month old email at that point. I know we aren't the only wedding but for the amount of people we are traveling with I would like to think this is going to be well worth the travel and expense..\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"May 01, 2015- complete!! 73 guests+bride & groom! Now Larimar Punta Cana! ","Email":"cooper.tyshelle@gmail.com","IpAddress":"108.50.56.179","GroupId":40,"GroupName":"Jr. Member","JoinDate":1375998669,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272393.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"DR2015","Id":272393,"Name":"DR2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"104.162.168.61","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77311,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"53c52cd4fb29a2878851a5de4af168d7","RawContent":"@[member=\"DR2015\"] I have called her directly and that seems to work best. Same here! I plan on having about 85 guests. How big is your party?","Attachments":[],"Id":1884768,"PostDate":1422652524,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"272393\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/272393-dr2015\/' title='Member profile'><span itemprop=\"name\">DR2015<\/span><\/a> I have called her directly and that seems to work best. Same here! I plan on having about 85 guests. How big is your party?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ariadna.diaz89@hotmail.com","IpAddress":"104.162.168.61","GroupId":39,"GroupName":"Newbie","JoinDate":1413583874,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Jariana2010","Id":280700,"Name":"Jariana2010","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.179.35.182","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77311,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"67252853efbf626547dc422c16275515","RawContent":"@[member=\"Jariana2010\"] 73 confirmed- 2 unconfirmed!! 85 wow- I complained about 50 lol","Attachments":[],"Id":1884769,"PostDate":1422652866,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"280700\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/280700-jariana2010\/' title='Member profile'><span itemprop=\"name\">Jariana2010<\/span><\/a> 73 confirmed- 2 unconfirmed!! 85 wow- I complained about 50 lol\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"May 01, 2015- complete!! 73 guests+bride & groom! Now Larimar Punta Cana! ","Email":"cooper.tyshelle@gmail.com","IpAddress":"108.50.56.179","GroupId":40,"GroupName":"Jr. Member","JoinDate":1375998669,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272393.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"DR2015","Id":272393,"Name":"DR2015","IsOnline":false}}],"Id":"77311","Title":"Now Larimar - 2015","LastPostDate":1459576238},"Pages":{"TotalItems":225,"TotalPages":23,"CurrentPage":130,"NextPage":140,"PreviousPage":120,"LastPage":220},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
