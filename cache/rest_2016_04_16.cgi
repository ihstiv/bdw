{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":10,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":853,"MovedTo":null,"MovedOn":0,"FirstPostId":24678,"Rating":0,"RatingHits":0,"Starter":{"Id":207142,"Name":"Jaims","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207142.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"StartDate":1171003443,"LastPoster":{"Id":223381,"Name":"GVphotographer","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223381.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":38,"Preview":{"Id":24678,"PostDate":1171003443,"PostContent":"Hey girls, We are leaning towards renting a big villa (Clara Vista) and having our family stay th...","Author":{"Signature":"","Email":"jaimee4431@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1171002190,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207142.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Jaims","Id":207142,"Name":"Jaims","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":1816,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"323fefa8dc2a802e5336fa310c65737e","RawContent":"Hey girls,\n We are leaning towards renting a big villa (Clara Vista) and having our family stay there. The house is gorgeous and we&#039;re thinking about getting married in the dome by the pool and then having a dinner inside the house. (i ready about Lazy Gourmet on here - putting up another post!)\n Has anyone done this? I&#039;d love to hear your thoughts. We want things to be very casual. We&#039;ll have our friends rent houses or stay at a close hotel. I was going to rent through cabovillas.com\n \n Let me know what you think!","Attachments":[],"Id":24678,"PostDate":1171003443,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hey girls,<br \/> We are leaning towards renting a big villa (Clara Vista) and having our family stay there. The house is gorgeous and we're thinking about getting married in the dome by the pool and then having a dinner inside the house. (i ready about Lazy Gourmet on here - putting up another post!)<br \/> Has anyone done this? I'd love to hear your thoughts. We want things to be very casual. We'll have our friends rent houses or stay at a close hotel. I was going to rent through cabovillas.com<br \/> <br \/> Let me know what you think!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jaimee4431@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1171002190,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207142.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Jaims","Id":207142,"Name":"Jaims","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":1816,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"af10f31fd73223c081ef5e8b1a6e4de8","RawContent":"Have you talked to cabovillas about the cost? I think they told me to hold a private event they would add on an extra night&#039;s charge.\n \n On the Yahoo Cabo Brides group there is a bride from 2005 who got married at a villa in Pedregal. I don&#039;t remember details but I know she wrote a review about it somewhere in the files. Not that I am advocating you to spend time on that board instead, but see what you can find: &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/groups.yahoo.com\/group\/CaboWeddings\/\"&gt;CaboWeddings : Cabo Weddings&lt;\/a&gt;\n \n Also, welcome to the board!","Attachments":[],"Id":24727,"PostDate":1171012120,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Have you talked to cabovillas about the cost? I think they told me to hold a private event they would add on an extra night's charge.<br \/> <br \/> On the Yahoo Cabo Brides group there is a bride from 2005 who got married at a villa in Pedregal. I don't remember details but I know she wrote a review about it somewhere in the files. Not that I am advocating you to spend time on that board instead, but see what you can find: <a href='http:\/\/groups.yahoo.com\/group\/CaboWeddings\/' class='bbc_url' title='External link' rel='nofollow external'>CaboWeddings : Cabo Weddings<\/a><br \/> <br \/> Also, welcome to the board!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"janet.daly@gmail.com","IpAddress":"71.33.145.106","GroupId":46,"GroupName":"VIP Member","JoinDate":1138267740,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206713.jpg?_r=0","PhotoWidth":200,"PhotoHeight":288,"PhotoType":"custom"},"FormattedName":"Janet","Id":206713,"Name":"Janet","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":1816,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"36dcd628f4ec07ea41e482914ed8c059","RawContent":"This is the one thing I always wanted to do. I fell in love with so many villas on cabovillas.com that all I wanted to do was rent one and hold my wedding there. I wanted a casual and private event. My FI wanted a tremendous wedding with every friend and acquaintance that he has so we compromised and we are having it at the Dreams in cabo. I don&#039;t know anything about having a wedding in a villa b\/c I never got far enough in the research process to inquire about price and other info. But I think it&#039;s such a wonderful idea, but I am biased b\/c this is what I always wanted. Let me know what you find out I am def curious and would love to hear all of the details!!\n \n -Glenda","Attachments":[],"Id":24794,"PostDate":1171054850,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                This is the one thing I always wanted to do. I fell in love with so many villas on cabovillas.com that all I wanted to do was rent one and hold my wedding there. I wanted a casual and private event. My FI wanted a tremendous wedding with every friend and acquaintance that he has so we compromised and we are having it at the Dreams in cabo. I don't know anything about having a wedding in a villa b\/c I never got far enough in the research process to inquire about price and other info. But I think it's such a wonderful idea, but I am biased b\/c this is what I always wanted. Let me know what you find out I am def curious and would love to hear all of the details!!<br \/> <br \/> -Glenda\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"vanitysmuf@aol.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1166589060,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206982.gif?_r=0","PhotoWidth":66,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Nrvsbride","Id":206982,"Name":"Nrvsbride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":1816,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"594feff1d64b1a9b0ef23dbc2c8c1cbc","RawContent":"I was actually looking for more info from people that have done weddings at villas, but it doesn&#039;t seem that common. We&#039;ve been doing a lot of research. We&#039;re planning for our wedding in July &#039;07. Here&#039;s what I found out. \n \n &lt;strong&gt;&lt;u&gt;Pedregal&lt;\/u&gt;&lt;\/strong&gt;\n \n In Pedregal, the owners charge a &lt;i&gt;Permit Fee&lt;\/i&gt; of $550 and an &lt;i&gt;Event Fee &lt;\/i&gt;equal to one night&#039;s stay. Supposedly, the permit fee is because the community is gated and they have to bring in extra guards, and they may have to escort photographers, etc to the villa. \n \n &lt;strong&gt;&lt;u&gt;Corridor&lt;\/u&gt;&lt;\/strong&gt;\n \n Villas in the corridor don&#039;t charge a &lt;i&gt;Permit Fee&lt;\/i&gt;. They just charge an &lt;i&gt;Event Fee&lt;\/i&gt;.\n \n Keep in mind that there is a 3 night minimum at the villas, and not all owners allow events at there villa. Also, some of the owners may be willing to waive the event fee. Clara Vista was one of my favorite but is out of my price range. My hunt continues &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile72.gif\" border=\"0\" alt=\"\" title=\"Smile72\" class=\"inlineimg\" \/&gt;","Attachments":[],"Id":24831,"PostDate":1171064964,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I was actually looking for more info from people that have done weddings at villas, but it doesn't seem that common. We've been doing a lot of research. We're planning for our wedding in July '07. Here's what I found out. <br \/> <br \/> <strong><u>Pedregal<\/u><\/strong><br \/> <br \/> In Pedregal, the owners charge a <i>Permit Fee<\/i> of $550 and an <i>Event Fee <\/i>equal to one night's stay. Supposedly, the permit fee is because the community is gated and they have to bring in extra guards, and they may have to escort photographers, etc to the villa. <br \/> <br \/> <strong><u>Corridor<\/u><\/strong><br \/> <br \/> Villas in the corridor don't charge a <i>Permit Fee<\/i>. They just charge an <i>Event Fee<\/i>.<br \/> <br \/> Keep in mind that there is a 3 night minimum at the villas, and not all owners allow events at there villa. Also, some of the owners may be willing to waive the event fee. Clara Vista was one of my favorite but is out of my price range. My hunt continues <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/smile72.gif\" border=\"0\" alt=\"\" title=\"Smile72\" class=\"inlineimg\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"aathr06@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1171047627,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207144.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"browneyed4","Id":207144,"Name":"browneyed4","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":1816,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e9cf081f0c731cf780266f159c57dfb5","RawContent":"We did this, but in Riviera Maya instead. :) We loved it. We are actually going for our honeymoon this May to Cabo, and renting a villa there. If you want any info, my email is cutiecupid15 at aol dot com. Good luck. I highly suggest doing a villa wedding, so much more private and intimate.","Attachments":[],"Id":40311,"PostDate":1175754529,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We did this, but in Riviera Maya instead. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> We loved it. We are actually going for our honeymoon this May to Cabo, and renting a villa there. If you want any info, my email is cutiecupid15 at aol dot com. Good luck. I highly suggest doing a villa wedding, so much more private and intimate.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Married May 24, 2006<\/span><br><span>Villa Sol y Luna<\/span><br><span>Riviera Maya, Mexico<\/span><\/div><\/div>","Email":"cutiecupid15@aol.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1175658588,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207323.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"cutiecupid15","Id":207323,"Name":"cutiecupid15","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":1816,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"703f8389e0c7b1c09fb0fb3478213b90","RawContent":"congrats on your engagement! \n \n i actually shot a wedding at a villa in pedregal. villa maria. heres a link to the post on my blog - \n &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.leighmillerphotography.com\/blog\/2006\/11\/07\/sanny-oli-pedregal-cabo-san-lucas\/\"&gt;Sanny and Oli blog post&lt;\/a&gt;\n \n and then their slideshow - \n &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.leighmillerphotography.com\/blog\/2007\/01\/09\/yippee-i-have-a-new-slideshow-program\/\"&gt;Sanny and Olis Slideshow&lt;\/a&gt;\n \n and heres the link on cabo villas - &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.cabovillas.com\/properties.asp?PID=193\"&gt;Villa Maria-Cabo San Lucas Mexico Luxury Villas&lt;\/a&gt;\n \n your villa looks amazing too!!! how fun!\n \n i know initially sanny and oli were going to get married at las ventanas but decided on the villa instead. this wedding is going to be feature on the knots online desination weddings soon :)\n \n edited to add - i can check with sanny and see if shed mind me giving you her email if youd like.","Attachments":[],"Id":40380,"PostDate":1175798160,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                congrats on your engagement! <br \/> <br \/> i actually shot a wedding at a villa in pedregal. villa maria. heres a link to the post on my blog - <br \/> <a href='http:\/\/www.leighmillerphotography.com\/blog\/2006\/11\/07\/sanny-oli-pedregal-cabo-san-lucas\/' class='bbc_url' title='External link' rel='nofollow external'>Sanny and Oli blog post<\/a><br \/> <br \/> and then their slideshow - <br \/> <a href='http:\/\/www.leighmillerphotography.com\/blog\/2007\/01\/09\/yippee-i-have-a-new-slideshow-program\/' class='bbc_url' title='External link' rel='nofollow external'>Sanny and Olis Slideshow<\/a><br \/> <br \/> and heres the link on cabo villas - <a href='http:\/\/www.cabovillas.com\/properties.asp?PID=193' class='bbc_url' title='External link' rel='nofollow external'>Villa Maria-Cabo San Lucas Mexico Luxury Villas<\/a><br \/> <br \/> your villa looks amazing too!!! how fun!<br \/> <br \/> i know initially sanny and oli were going to get married at las ventanas but decided on the villa instead. this wedding is going to be feature on the knots online desination weddings soon <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br \/> <br \/> edited to add - i can check with sanny and see if shed mind me giving you her email if youd like.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"leigh@leighmillerphotography.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1167472980,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207003.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"leigh miller","Id":207003,"Name":"leigh miller","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":1816,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a42423656f690377df8392238bc745f6","RawContent":"Jaims,\n \n I did a LOT of research into having our wedding at a villa. I LOVED LOVED LOVED the idea, but we decided against it for financial reasons and logistics. Each villa in Pedegral costs about $6500 more to have your wedding there (on top of the nightly rental fee)... That&#039;s a high location fee, but you can save costs on catering and decor because it&#039;s already so beautiful. My guests are all staying in the La Jolla area- which is close to San Jose del Cabo, and Pedegral is on the furthest side of Cabo San Lucas- about 35 minutes from where our guests will be. Another thing to consider is transportation to the villas- the roads within Pedegral are very windy, up and down a hill, depending on which side the villa is on (Pacific or Sea of Cortez). The guests would not be able to all drive to the wedding- they do not allow all those cars in there- and you would NOT want anyone to drive in this area who&#039;d had even a sip of alcohol!\n \n I visited 2 villas there, and looked at Clara Vista online... feel free to write me with any questions. If you can afford it, and can transport your guests to and from there- go for it- it is breathtaking!!! VERY European!","Attachments":[],"Id":40420,"PostDate":1175805627,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Jaims,<br \/> <br \/> I did a LOT of research into having our wedding at a villa. I LOVED LOVED LOVED the idea, but we decided against it for financial reasons and logistics. Each villa in Pedegral costs about $6500 more to have your wedding there (on top of the nightly rental fee)... That's a high location fee, but you can save costs on catering and decor because it's already so beautiful. My guests are all staying in the La Jolla area- which is close to San Jose del Cabo, and Pedegral is on the furthest side of Cabo San Lucas- about 35 minutes from where our guests will be. Another thing to consider is transportation to the villas- the roads within Pedegral are very windy, up and down a hill, depending on which side the villa is on (Pacific or Sea of Cortez). The guests would not be able to all drive to the wedding- they do not allow all those cars in there- and you would NOT want anyone to drive in this area who'd had even a sip of alcohol!<br \/> <br \/> I visited 2 villas there, and looked at Clara Vista online... feel free to write me with any questions. If you can afford it, and can transport your guests to and from there- go for it- it is breathtaking!!! VERY European!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"staffordwedding@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1166589672,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206983.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"ilovetj","Id":206983,"Name":"ilovetj","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":1816,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e2b1310cfc19e3cfc105438ae40c95b5","RawContent":"I had also very much want\/wanted to have a wedding in one of the many beautiful Pedregal villas. I emailed back and forth with a rep from cabovillas.com, I found the same info as the rest of you... some villas allow weddings and others do not, it is obviously very expensive, but also so dramatic and beautiful. We were also having a hard time figuring out who would stay in the villa, and who would be at a nearby hotel. I don&#039;t know if I necessarily want THAT much togetherness with my family. Anyways, I went down to cabo in November but the only way to go to see the villas was to put down a large deposit that is only refundable if you end up renting a villa. Does any one know of any other way to see the villas without having to pay this charge? I am going down to Cabo in May and I would love to be able to see the vilas, and try to determine if have a wedding there is even a poossibility for us.","Attachments":[],"Id":40438,"PostDate":1175806932,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I had also very much want\/wanted to have a wedding in one of the many beautiful Pedregal villas. I emailed back and forth with a rep from cabovillas.com, I found the same info as the rest of you... some villas allow weddings and others do not, it is obviously very expensive, but also so dramatic and beautiful. We were also having a hard time figuring out who would stay in the villa, and who would be at a nearby hotel. I don't know if I necessarily want THAT much togetherness with my family. Anyways, I went down to cabo in November but the only way to go to see the villas was to put down a large deposit that is only refundable if you end up renting a villa. Does any one know of any other way to see the villas without having to pay this charge? I am going down to Cabo in May and I would love to be able to see the vilas, and try to determine if have a wedding there is even a poossibility for us.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Brian and MeaghanCabo San LucasMay 2008<\/span><\/div><\/div>","Email":"mburk@bcfinancial.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1156206711,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206786.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"MLBURK","Id":206786,"Name":"MLBURK","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":1816,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"89f6f1be74c6c6cbdf985a5ab90c1c4b","RawContent":"[Does any one know of any other way to see the villas without having to pay this charge? I am going down to Cabo in May and I would love to be able to see the vilas, and try to determine if have a wedding there is even a poossibility for us.[\/QUOTE]\n \n Do you have a wedding coordinator? I am working with Adriana at Terramar, and she had a man let us into 3 houses there...","Attachments":[],"Id":40797,"PostDate":1175890536,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                [Does any one know of any other way to see the villas without having to pay this charge? I am going down to Cabo in May and I would love to be able to see the vilas, and try to determine if have a wedding there is even a poossibility for us.[\/QUOTE]<br \/> <br \/> Do you have a wedding coordinator? I am working with Adriana at Terramar, and she had a man let us into 3 houses there...\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"staffordwedding@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1166589672,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206983.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"ilovetj","Id":206983,"Name":"ilovetj","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"189.172.236.211","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":1816,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2afb1236670491b70bb81a4d0675aceb","RawContent":"&lt;p&gt;Hi!!&lt;\/p&gt;\n&lt;p&gt;Clara Vista is an amazing Villa, Located in Cabo San Lucas at the pedregal. This place remind me Santorini in Greece :)&lt;\/p&gt;\n&lt;p&gt;Here you can see a few weddings I shoot over there&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.gvphotographer.com\/blog\/el-pedregal-los-cabos-wedding-jennifer-and-dan&#039;&gt;http:\/\/www.gvphotographer.com\/blog\/el-pedregal-los-cabos-wedding-jennifer-and-dan&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.gvphotographer.com\/blog\/destination-wedding-in-cabo-san-lucas&#039;&gt;http:\/\/www.gvphotographer.com\/blog\/destination-wedding-in-cabo-san-lucas&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I would recommend everybody to have Villa wedding, I don\u2019t like resorts full of people. I get married 6 weeks ago and I rent a Villa at Puerto Los Cabos, everything turn out amazing.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Happy planning!!&lt;\/p&gt;","Attachments":[],"Id":1912011,"PostDate":1458262039,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi!!<\/p>\n<p>Clara Vista is an amazing Villa, Located in Cabo San Lucas at the pedregal. This place remind me Santorini in Greece <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>Here you can see a few weddings I shoot over there<\/p>\n<p><a href='http:\/\/www.gvphotographer.com\/blog\/el-pedregal-los-cabos-wedding-jennifer-and-dan' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.gvphotogr...ennifer-and-dan<\/a><\/p>\n<p><a href='http:\/\/www.gvphotographer.com\/blog\/destination-wedding-in-cabo-san-lucas' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.gvphotogr...-cabo-san-lucas<\/a><\/p>\n<p>\u00a0<\/p>\n<p>I would recommend everybody to have Villa wedding, I don\u2019t like resorts full of people. I get married 6 weeks ago and I rent a Villa at Puerto Los Cabos, everything turn out amazing.<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Happy planning!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"info@artncolors.com","IpAddress":"189.176.187.29","GroupId":42,"GroupName":"Sr. Member","JoinDate":1258586901,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223381.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"GVphotographer","Id":223381,"Name":"GVphotographer","IsOnline":false}}],"Id":"1816","Title":"Staying\/Getting Married in a Cabo Villa?","LastPostDate":1458262039},"Pages":{"TotalItems":10,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
