{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":4,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":647,"MovedTo":null,"MovedOn":0,"FirstPostId":1911074,"Rating":0,"RatingHits":0,"Starter":{"Id":286273,"Name":"sharpbecca","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1455841600,"LastPoster":{"Id":286470,"Name":"amberguesa","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286470.jpg?_r=1457927739","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":22,"Preview":{"Id":1911074,"PostDate":1455841600,"PostContent":"Hello fellow brides! \u00a0 I am getting married at Dreams Punta Cana Resort & Spa in April 2016! Time...","Author":{"Signature":"","Email":"beccamouland@gmail.com","IpAddress":"162.157.245.56","GroupId":39,"GroupName":"Newbie","JoinDate":1455840794,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"sharpbecca","Id":286273,"Name":"sharpbecca","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"162.157.245.56","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79949,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b2f5d0c49065d961530613b1d12f7c0c","RawContent":"&lt;p&gt;Hello fellow brides!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am getting married at Dreams Punta Cana Resort &amp;amp; Spa in April 2016! Time is getting close now. I was looking to see if there are any other brides getting married there during that time, or any time this year! Interested in what you fellow ladies think about the resort and the packages offered. We are having a beautiful beach ceremony&amp;nbsp; :lol:&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1911074,"PostDate":1455841600,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello fellow brides!<\/p>\n<p>\u00a0<\/p>\n<p>I am getting married at Dreams Punta Cana Resort & Spa in April 2016! Time is getting close now. I was looking to see if there are any other brides getting married there during that time, or any time this year! Interested in what you fellow ladies think about the resort and the packages offered. We are having a beautiful beach ceremony\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/laugh.png' class='bbc_emoticon' alt=':lol:' \/><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"beccamouland@gmail.com","IpAddress":"162.157.245.56","GroupId":39,"GroupName":"Newbie","JoinDate":1455840794,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"sharpbecca","Id":286273,"Name":"sharpbecca","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"107.77.97.47","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79949,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"cd32bfbb539a5f16a27ae15245701dca","RawContent":"I just booked with dreams for April  2017.  I would love to hear any pointers you have and how the whole process has been. I wish I had some advice for you\n\n\nSent from my SAMSUNG-SM-G900A using Tapatalk","Attachments":[],"Id":1911856,"PostDate":1457913465,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I just booked with dreams for April  2017.  I would love to hear any pointers you have and how the whole process has been. I wish I had some advice for you<br><br>\nSent from my SAMSUNG-SM-G900A using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"abyrnes319@gmail.com","IpAddress":"107.77.97.47","GroupId":3,"GroupName":"Member","JoinDate":1457913336,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286470.jpg?_r=1457927739","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"amberguesa","Id":286470,"Name":"amberguesa","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"173.33.157.174","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79949,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bbb54e94b909d7f2c03faff46b647bf8","RawContent":"&lt;p&gt;Anyone who is booking here for 2017, can you comment on whether they are charging you to have your reception in a private restaurant?&lt;\/p&gt;","Attachments":[],"Id":1912636,"PostDate":1459968158,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Anyone who is booking here for 2017, can you comment on whether they are charging you to have your reception in a private restaurant?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kijijicoins@hotmail.com","IpAddress":"99.247.128.186","GroupId":39,"GroupName":"Newbie","JoinDate":1455555156,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"KJCoins","Id":286227,"Name":"KJCoins","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"199.38.210.51","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79949,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"01efa35f13670e4e1afc1affc583f54d","RawContent":"[quote name=\"KJCoins\" post=\"1912636\" timestamp=\"1459982558\"]\nAnyone who is booking here for 2017, can you comment on whether they are charging you to have your reception in a private restaurant?[\/quote]They aren&#039;t charging for the space exactly. They have package deals that include the space. They include the wedding and reception and other extras.  However, they do charge like 200 to have your reception on the beach. It is a set up fee.\n\nSent from my SAMSUNG-SM-G900A using Tapatalk","Attachments":[],"Id":1912637,"PostDate":1459968697,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>KJCoins, on 06 April 2016 - 06:42 PM, said:<\/p><div class='blockquote'><div class='quote'><p>Anyone who is booking here for 2017, can you comment on whether they are charging you to have your reception in a private restaurant?<\/p><\/div><\/div>\nThey aren't charging for the space exactly. They have package deals that include the space. They include the wedding and reception and other extras.  However, they do charge like 200 to have your reception on the beach. It is a set up fee.<br><br>\nSent from my SAMSUNG-SM-G900A using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"abyrnes319@gmail.com","IpAddress":"107.77.97.47","GroupId":3,"GroupName":"Member","JoinDate":1457913336,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286470.jpg?_r=1457927739","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"amberguesa","Id":286470,"Name":"amberguesa","IsOnline":false}}],"Id":"79949","Title":"Dreams Punta Cana 2016 Brides","LastPostDate":1459968697},"Pages":{"TotalItems":4,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
