oticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":390,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e52f3e2fdc75c81b6fe430454d71a4d6","RawContent":"Thanks for the post","Attachments":[],"Id":838799,"PostDate":1252636042,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks for the post\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/t\/w18LMZT\/weight.png\">http:\/\/tickers.TickerFactory.com\/ezt...MZT\/weight.png<\/a><\/div><\/div>","Email":"jennybell1@hotmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1250891804,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-220805.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Jennybell1","Id":220805,"Name":"Jennybell1","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":390,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"06db65ab2cba08177364923f06579b34","RawContent":"[SIZE=&amp;quot;1&amp;quot;]&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;jadamar&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;&lt;strong&gt;Quote&lt;\/strong&gt;:&lt;font size=\"1\"&gt;Make it a lovely &lt;a data-ipb=&#039;nomediaparse&#039; href=\"[url=\"http:\/\/sandiego.nyctourist.com\/sandiego-weddings.php%22&gt;Wedding\"]http:\/\/sandiego.nyctourist.com\/sandiego-weddings.php\"&gt;Wedding[\/url] San Diego&lt;\/a&gt; or &lt;a data-ipb=&#039;nomediaparse&#039; href=\"[url=\"http:\/\/lasvegas.nyctourist.com\/las-vegas-weddings.php%22&gt;Wedding\"]http:\/\/lasvegas.nyctourist.com\/las-vegas-weddings.php\"&gt;Wedding[\/url] Vegas&lt;\/a&gt;\n Every bride wants her wedding to be unique and her wedding invitation is no different. Finding the perfect beach wedding invitation wording is as important as finding the perfect beach wedding invitation itself...&lt;\/font&gt;\n \n This is so very true! I do believe that the wording is just as important as the actual invitation. It is a package deal... \n I have always wanted a &amp;quot;destination wedding&amp;quot; and hope that one day, my dream will come true. I am 24 and feel that time is ticking and I don&#039;t have any solid commitment from my boyfriend of 2 years. My family tells me to be patient but I am having a really hard time with it. All of my close friends are or already have planned their weddings. I want my turn!!!!!!!&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;&lt;font face=\"Comic Sans MS\"&gt;&lt;font color=\"DarkOrchid\"&gt;Amen Sister!!!&lt;\/font&gt;&lt;\/font&gt;","Attachments":[],"Id":852992,"PostDate":1253518502,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                [SIZE=\"1\"]<div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>jadamar<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\"><strong>Quote<\/strong>:<font size=\"1\">Make it a lovely <a href='http:\/\/sandiego.nyctourist.com\/sandiego-weddings.php' class='bbc_url' title='External link' rel='nofollow external'>Wedding San Diego<\/a> or <a href='http:\/\/lasvegas.nyctourist.com\/las-vegas-weddings.php' class='bbc_url' title='External link' rel='nofollow external'>Wedding Vegas<\/a><br \/> Every bride wants her wedding to be unique and her wedding invitation is no different. Finding the perfect beach wedding invitation wording is as important as finding the perfect beach wedding invitation itself...<\/font><br \/> <br \/> This is so very true! I do believe that the wording is just as important as the actual invitation. It is a package deal... <br \/> I have always wanted a \"destination wedding\" and hope that one day, my dream will come true. I am 24 and feel that time is ticking and I don't have any solid commitment from my boyfriend of 2 years. My family tells me to be patient but I am having a really hard time with it. All of my close friends are or already have planned their weddings. I want my turn!!!!!!!<\/div> <\/td> <\/tr> <\/table> <\/div><font face=\"Comic Sans MS\"><font color=\"DarkOrchid\">Amen Sister!!!<\/font><\/font>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"marejada@live.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1244492554,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-218233.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"jadamar","Id":218233,"Name":"jadamar","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":390,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8365313525192337941cbd96f799631e","RawContent":"Thanks for the post tammy! I completely agree, your weddings should reflect you and your FI with your audience in mind. Make sure to post pics of your invitations once they&#039;re done, ladies!! It&#039;s a huge accomplishment and who deserves more credit than you for all your hard labor - plus us girls love to see those pics!","Attachments":[],"Id":852994,"PostDate":1253518713,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks for the post tammy! I completely agree, your weddings should reflect you and your FI with your audience in mind. Make sure to post pics of your invitations once they're done, ladies!! It's a huge accomplishment and who deserves more credit than you for all your hard labor - plus us girls love to see those pics!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"chelseapope@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1242181114,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-217486.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"ChelseaRose","Id":217486,"Name":"ChelseaRose","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":390,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ce87672cd4e5b9072d8a2c9953b37f19","RawContent":"Thanks for the words of wisdom!","Attachments":[],"Id":855322,"PostDate":1253643432,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks for the words of wisdom!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tlogan00@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1239768566,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-216735.jpg?_r=0","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"tlogan00","Id":216735,"Name":"tlogan00","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":390,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":