    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Your dress looks amazing; fits you like a glove. Love it!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"katie_mcbride48@yahoo.ca","IpAddress":"199.85.228.129","GroupId":39,"GroupName":"Newbie","JoinDate":1424114250,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282132.jpg?_r=1429230530","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"KatieMcBride","Id":282132,"Name":"KatieMcBride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.236.130.168","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79057,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c764aaa42203a00f670b14d4203475fe","RawContent":"[quote name=\"KatieMcBride\" post=\"1893224\" timestamp=\"1429122398\"]\nYour dress looks amazing; fits you like a glove. Love it![\/quote]I actually just got a call to say it is done! I was able to buy it off the rack so got the almost 250$ veil for free [emoji4] Can&#039;t wait for my last fitting! @[member=\"KatieMcBride\"]\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1893228,"PostDate":1429122714,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>KatieMcBride, on Yesterday, 10:26 AM, said:<\/p><div class='blockquote'><div class='quote'><p>Your dress looks amazing; fits you like a glove. Love it!<\/p><\/div><\/div>\n<br>\nI actually just got a call to say it is done! I was able to buy it off the rack so got the almost 250$ veil for free [emoji4] Can't wait for my last fitting! @<a hovercard-ref=\"member\" hovercard-id=\"282132\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/282132-katiemcbride\/' title='Member profile'><span itemprop=\"name\">KatieMcBride<\/span><\/a><br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"izabella.david@gmail.com","IpAddress":"99.237.26.51","GroupId":40,"GroupName":"Jr. Member","JoinDate":1426462378,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282430.jpg?_r=1426462827","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"IzzyDeee","Id":282430,"Name":"IzzyDeee","IsOnline":false}}],"Pages":{"TotalItems":16,"TotalPages":2,"CurrentPage":10,"NextPage":-1,"PreviousPage":0,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
