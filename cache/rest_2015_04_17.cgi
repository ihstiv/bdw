otoHeight":180,"PhotoType":"custom"},"FormattedName":"J2K","Id":211137,"Name":"J2K","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":43752,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bd8ef75f3c8bbfa14eb41f3cfd2e8ba8","RawContent":"Patti - I like the hat and ball.","Attachments":[],"Id":882651,"PostDate":1255466510,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Patti - I like the hat and ball.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><i><strong>Shannon<\/strong><\/i><br><br><span>YEAH---We Did It! **<\/span><strong>May 1st, 2010**<\/strong><br><span>Our Wedding SlideShowMy Wedding Review - Iberostar Paraiso Del Mar <\/span><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f77\/finleys7-shannon-s-iberostar-paraiso-del-mar-review-5-1-2010-a-58966\/\">http:\/\/bestdestinationwedding.com\/fo...-2010-a-58966\/<\/a><span>My Planning Thread<\/span><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f128\/shannons-finleys7-planning-thread-finally-59544\/#post1307567\">http:\/\/bestdestinationwedding.com\/fo....<\/a><\/div><\/div>","Email":"shannon.finley@moodys.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1243027899,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-217745.jpg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"finleys7","Id":217745,"Name":"finleys7","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":43752,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"429dd1cf3e6ca490cedec6984e5fe168","RawContent":"Patti those are way cute! I like the sign one becuase you could come up with something clever about the wedding to write on it. \n \n We aren&#039;t doing a grooms cake, but I think the cutest one I ever saw was a fishing cake. It had a &amp;quot;pond&amp;quot; with real water and gummy fish in the middle. Then the little guy and gal were fishing into it.","Attachments":[],"Id":882658,"PostDate":1255466805,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Patti those are way cute! I like the sign one becuase you could come up with something clever about the wedding to write on it. <br \/> <br \/> We aren't doing a grooms cake, but I think the cutest one I ever saw was a fishing cake. It had a \"pond\" with real water and gummy fish in the middle. Then the little guy and gal were fishing into it.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"afischbeck@gmail.com","IpAddress":"70.112.22.70","GroupId":42,"GroupName":"Sr. Member","JoinDate":1239932966,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-216783.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"autjo","Id":216783,"Name":"autjo","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":43752,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f3ee92a6b8f7a6e7e416827139f80e7d","RawContent":"Thanks, Ladies. It&#039;s not like we need anymore cake. There&#039;s only 11 of us and we&#039;re having a 2-tier wedding cake that feeds up to 25. I just thought those cakes were too cute. FI&#039;s b-day is the day after we arrive in Cabo, but there will only be 4 of us (I hate to spend that much $$$ for just 4). Another option is maybe presenting it at the Welcome dinner the night before the wedding. Oh, decisions, decisions.\n \n Autjo, where can I read (and see) about your drive-through Vegas wedding?","Attachments":[],"Id":882699,"PostDate":1255468066,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thanks, Ladies. It's not like we need anymore cake. There's only 11 of us and we're having a 2-tier wedding cake that feeds up to 25. I just thought those cakes were too cute. FI's b-day is the day after we arrive in Cabo, but there will only be 4 of us (I hate to spend that much $$$ for just 4). Another option is maybe presenting it at the Welcome dinner the night before the wedding. Oh, decisions, decisions.<br \/> <br \/> Autjo, where can I read (and see) about your drive-through Vegas wedding?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/davf.daisypath.com\/kTmbm6.png\">http:\/\/davf.daisypath.com\/kTmbm6.png<\/a><\/div><\/div>","Email":"pattiwood5@yahoo.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1251791795,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-221196.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Patti","Id":221196,"Name":"Patti","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":43752,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a064c53d9562b23c73934ffac80ac9b6","RawContent":"We are doing a celebration cake at our happy hour the night before the wedding. We have several people celebrating birthdays and honeymoons and we thought it would be fun to share some of the spotlight. \n \n \n Vegas Dirve Thru :o)\n &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/bestdestinationwedding.com\/forum\/f58\/legally-not-single-50555\/\"&gt;http:\/\/bestdestinationwedding.com\/fo...-single-50555\/&lt;\/a&gt;","Attachments":[],"Id":882733,"PostDate":1255468900,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We are doing a celebration cake at our happy hour the night before the wedding. We have several people celebrating birthdays and honeymoons and we thought it would be fun to share some of the spotlight. <br \/> <br \/> <br \/> Vegas Dirve Thru <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/ohmy.png' class='bbc_emoticon' alt=':o' \/>)<br \/> <a href='http:\/\/bestdestinationwedding.com\/forum\/f58\/legally-not-single-50555\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/bestdestinati....-single-50555\/<\/a>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"afischbeck@gmail.com","IpAddress":"70.112.22.70","GroupId":42,"GroupName":"Sr. Member","JoinDate":1239932966,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-216783.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"autjo","Id":216783,"Name":"autjo","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":43752,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"88577ceebcc7b678713c5077dc5bbafb","RawContent":"That&#039;s a good idea. I should do something like that. FI&#039;s b-day is 2 days before the wedding and my daughter&#039;s is the day after the wedding.\n \n ps. looked at your review and pics. Thanks for sharing. You looked beautiful and sounded like a blast.","Attachments":[],"Id":882801,"PostDate":1255470625,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                That's a good idea. I should do something like that. FI's b-day is 2 days before the wedding and my daughter's is the day after the wedding.<br \/> <br \/> ps. looked at your review and pics. Thanks for sharing. You looked beautiful and sounded like a blast.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/davf.daisypath.com\/kTmbm6.png\">http:\/\/davf.daisypath.com\/kTmbm6.png<\/a><\/div><\/div>","Email":"pattiwood5@yahoo.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1251791795,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-221196.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Patti","Id":221196,"Name":"Patti","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":43752,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"42c15027ab4208ce2a4f90076ae06195","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;J2K&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Here&#039;s a pic of our grooms cake from our AHR. It turned out pretty good... except for the misspelling, haha. Oh, and it was delicious!\n \n &lt;img src=\"http:\/\/i678.photobucket.com\/albums\/vv150\/jkempka66\/IMG_2578.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;this is pretty cool!","Attachments":[],"Id":883534,"PostDate":1255489225,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>J2K<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Here's a pic of our grooms cake from our AHR. It turned out pretty good... except for the misspelling, haha. Oh, and it was delicious!<br \/> <br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i678.photobucket.com\/albums\/vv150\/jkempka66\/IMG_2578.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><\/div> <\/td> <\/tr> <\/table> <\/div>this is pretty cool!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Loving married life! <3<\/span><\/div><\/div>","Email":"ldhearne@gmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1249427940,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-220176.jpg?_r=0","PhotoWidth":199,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"*Linds*","Id":220176,"Name":"*Linds*","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":43752,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7b6427dc28e376fae7a7fcc31290ce8d","RawContent":"Here&#039;s mine! He is a huge Nightmare Before Christmas fan,and I actually got the idea from on this forum. Someone posted a pic of a cake topper and it got me thinking about doing this as a groom&#039;s cake. It was a total surprise and he had no idea until he walked in the room and saw it! It was def the hit of our wedding...\n &lt;img src=\"http:\/\/i28.photobucket.com\/albums\/c204\/christirae\/8325_1125742823000_1210023482_30317.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;","Attachments":[],"Id":883696,"PostDate":1255495217,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Here's mine! He is a huge Nightmare Before Christmas fan,and I actually got the idea from on this forum. Someone posted a pic of a cake topper and it got me thinking about doing this as a groom's cake. It was a total surprise and he had no idea until he walked in the room and saw it! It was def the hit of our wedding...<br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i28.photobucket.com\/albums\/c204\/christirae\/8325_1125742823000_1210023482_30317.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/t\/wsG9M2a\/weight.png\">http:\/\/tickers.TickerFactory.com\/ezt...M2a\/weight.png<\/a><br><br><br><br><a data-ipb='nomediaparse' href=\"http:\/\/weddings.bellapictures.com\/gallery\/do\/wed\/home?wid=200908-877778\">http:\/\/weddings.bellapictures.com\/ga...=200908-877778<\/a><\/div><\/div>","Email":"estella1007@netzero.net","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1233138098,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-214386.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"estella1007","Id":214386,"Name":"estella1007","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":43752,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6e78900a5ef595984f447915b6261e9d","RawContent":"I saw this in your pics and it is so cute. What a great surprise!\n \n \n &lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;estella1007&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Here&#039;s mine! He is a huge Nightmare Before Christmas fan,and I actually got the idea from on this forum. Someone posted a pic of a cake topper and it got me thinking about doing this as a groom&#039;s cake. It was a total surprise and he had no idea until he walked in the room and saw it! It was def the hit of our wedding...\n &lt;img src=\"http:\/\/i28.photobucket.com\/albums\/c204\/christirae\/8325_1125742823000_1210023482_30317.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;","Attachments":[],"Id":883707,"PostDate":1255495588,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I saw this in your pics and it is so cute. What a great surprise!<br \/> <br \/> <br \/> <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>estella1007<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Here's mine! He is a huge Nightmare Before Christmas fan,and I actually got the idea from on this forum. Someone posted a pic of a cake topper and it got me thinking about doing this as a groom's cake. It was a total surprise and he had no idea until he walked in the room and saw it! It was def the hit of our wedding...<br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i28.photobucket.com\/albums\/c204\/christirae\/8325_1125742823000_1210023482_30317.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><\/div> <\/td> <\/tr> <\/table> <\/div>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"afischbeck@gmail.com","IpAddress":"70.112.22.70","GroupId":42,"GroupName":"Sr. Member","JoinDate":1239932966,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-216783.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"autjo","Id":216783,"Name":"autjo","IsOnline":false}}],"Id":"43752","Title":"Post pics of Groom's Cakes","LastPostDate":1428733115},"Pages":{"TotalItems":50,"TotalPages":5,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":40},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
