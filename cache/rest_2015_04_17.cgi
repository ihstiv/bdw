":734415,"Rating":0,"RatingHits":0,"Starter":{"Id":217967,"Name":"VioletVol","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-217967.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"IsOnline":false},"StartDate":1245795607,"LastPoster":{"Id":276764,"Name":"becassidy","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":93,"Preview":{"Id":734415,"PostDate":1245795607,"PostContent":"Okay I read every post in this thread and I have only found a few invitation wording samples. So...","Author":{"Signature":"","Email":"pennycarter@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1243796882,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-217967.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"VioletVol","Id":217967,"Name":"VioletVol","IsOnline":false}},"Posts":[],"Id":"38244","Title":"AHR Invitation Wording","LastPostDate":1406057713}],"Pages":{"TotalItems":272,"TotalPages":19,"CurrentPage":0,"NextPage":15,"PreviousPage":-1,"LastPage":270},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
