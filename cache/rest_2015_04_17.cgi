{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":11,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":529,"MovedTo":null,"MovedOn":0,"FirstPostId":1890765,"Rating":0,"RatingHits":0,"Starter":{"Id":277296,"Name":"tygrrlily","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277296.jpg?_r=1421643766","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"StartDate":1427314050,"LastPoster":{"Id":282610,"Name":"KatJamila","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282610.jpg?_r=1428852811","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":98,"Preview":{"Id":1890765,"PostDate":1427314050,"PostContent":"Hello ladies, \u00a0 I bought this Space 46 Blush Pink 25\" length tulle skirt a few months ago to wear...","Author":{"Signature":"<p>Married December 19, 2014 at Beach Palace Resort in Cancun, Mexico<\/p>\n<p>\u00a0<\/p>\n<p>My Planning Thread - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/'>http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>My Wedding Review<\/p>\n<p>Part 1 - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881197'>http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881197<\/a><\/p>\n<p>Part 2 - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881590'>http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881590<\/a><\/p>\n<p>Part 3 - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881861'>http:\/\/www.bestdestinationwedding.com\/topic\/77763-tygrrlilys-planning-thread-beach-palace-resort-121914\/?p=1881861<\/a><\/p>\n<p>\u00a0","Email":"lilyluu83@gmail.com","IpAddress":"174.119.162.30","GroupId":3,"GroupName":"Member","JoinDate":1395609348,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277296.jpg?_r=1421643766","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"tygrrlily","Id":277296,"Name":"tygrrlily","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"74.12.176.52","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78982,"EditedBy":"<strong>Edited by tygrrlily, 25 March 2015 - 12:15 PM.<\/strong>","EditDate":1427314538,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"5944964eb17ba3c961b6efcf541a0df4","RawContent":"&lt;p&gt;Hello ladies,&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I bought this Space 46 Blush Pink 25\" length tulle skirt a few months ago to wear for my bridal shower, but I miscalculated the shipping time and it came too late :(.&amp;nbsp; So now I&#039;m married and have no occasion to wear this tulle skirt without looking like a ballerina haha :P.&amp;nbsp; It&#039;s just sitting in my closet now so thought I&#039;d post it and see if anyone wants one for engagement pics, bridal shower, etc.&amp;nbsp; It&#039;s completely brand new - I&#039;ve only tried it on.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;It&#039;s the Space 46 one bought online from Adorn Calgary.&amp;nbsp; I paid $132 CDN after taxes + shipping and it&#039;s just hanging in my closet right now.&amp;nbsp; I&#039;d like to get $75 for it plus the actual cost of shipping to you or pick up in Toronto.&amp;nbsp; Length is 25\" (falls right below the knee) and is size XL in their sizing but about an M to a small L in regular sizing - This is from their website about the measurement:&lt;i&gt; Size XL - Waist 30.5\"&amp;nbsp;(15.25\" across laying flat), equivalent to US 6-8&lt;\/i&gt;.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;This is the exact skirt w\/ more details:&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/space46boutique.com\/collections\/womens\/products\/the-wendy-blush-25-length&#039;&gt;http:\/\/space46boutique.com\/collections\/womens\/products\/the-wendy-blush-25-length&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Or:&lt;\/p&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/adornboutique.ca\/products\/tulle-skirt&#039;&gt;http:\/\/adornboutique.ca\/products\/tulle-skirt&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"http:\/\/s29.postimg.org\/tge7mmizr\/tulle_skirt.png\" alt=\"tulle_skirt.png\"&gt;&lt;\/p&gt;","Attachments":[],"Id":1890765,"PostDate":1427314050,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello ladies,<\/p>\n<p>\u00a0<\/p>\n<p>I bought this Space 46 Blush Pink 25\" length tulle skirt a few months ago to wear for my bridal shower, but I miscalculated the shipping time and it came too late <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/sad.png' class='bbc_emoticon' alt=':(' \/>.\u00a0 So now I'm married and have no occasion to wear this tulle skirt without looking like a ballerina haha <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/tongue.png' class='bbc_emoticon' alt=':P' \/>.\u00a0 It's just sitting in my closet now so thought I'd post it and see if anyone wants one for engagement pics, bridal shower, etc.\u00a0 It's completely brand new - I've only tried it on.<\/p>\n<p>\u00a0<\/p>\n<p>It's the Space 46 one bought online from Adorn Calgary.\u00a0 I paid $132 CDN after taxes + shipping and it's just hanging in my closet right now.\u00a0 I'd like to get $75 for it plus the actual cost of shipping to you or pick up in Toronto.\u00a0 Length is 25\" (falls right below the knee) and is size XL in their sizing but about an M to a small L in regular sizing - This is from their website about the measurement:<i> Size XL - Waist 30.5\"\u00a0(15.25\" across laying flat), equivalent to US 6-8<\/i>.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>This is the exact skirt w\/ more details:<\/p>\n<p><a href='http:\/\/space46boutique.com\/collections\/womens\/products\/the-wendy-blush-25-length' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/space46boutiq...blush-25-length<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Or:<\/p>\n<p><a href='http:\/\/adornboutique.ca\/products\/tulle-skirt' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/adornboutique...cts\/tulle-skirt<\/a><\/p>\n<p>\u00a0<\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"http:\/\/s29.postimg.org\/tge7mmizr\/tulle_skirt.png\" alt=\"tulle_skirt.png\"><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Married December 19, 2014 at Beach Palace Resort in Cancun, Mexico<\/p>\n<p>\u00a0<\/p>\n<p>My Planning Thread - <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/