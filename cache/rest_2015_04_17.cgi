{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":8266,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":true,"Views":1105332,"MovedTo":null,"MovedOn":0,"FirstPostId":126,"Rating":0,"RatingHits":0,"Starter":{"Id":206701,"Name":"Jennifer","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206701.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"IsOnline":false},"StartDate":1158010732,"LastPoster":{"Id":278682,"Name":"BecomingaRiggio","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278682.jpg?_r=1414954781","PhotoWidth":187,"PhotoHeight":300,"PhotoType":"custom"},"IsOnline":true},"PollState":"0","LastVote":0,"ForumId":33,"Preview":{"Id":126,"PostDate":1158010732,"PostContent":"Attention girls! This is Sarah hijacking this first thread to update...  I'm in the process of go...","Author":{"Signature":"","Email":"bruceandjenniferpage@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1157841660,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206701.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Jennifer","Id":206701,"Name":"Jennifer","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5e10db14c1aa818939d007d5340b03c8","RawContent":"Attention girls! This is Sarah hijacking this first thread to update...\n \n I&#039;m in the process of going through and deleting all the miscellaneous &amp;quot;chit chat&amp;quot; in this thread. Some of this is really old, and the older members will remember the 30 pages of Kash getting her Scarlet, me agonizing over my second dress, etc. Well, it&#039;s time to let go of the past! I&#039;m trying to make this thread have just one pic of our dresses- not the 45 comments that follow telling us how wonderful we look. Hopefully this will make this thread a little more fun to go through!\n \n &lt;strong&gt;Update 12\/18\/08 by Carly&lt;\/strong&gt;\n Please see this link for help in posting pictures, posting your photos IN the thread is much better then posting a link or attachment...\n &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/bestdestinationwedding.com\/forum\/t32313\"&gt;***Click here for FAQ&#039;s and to learn how to work this forum*** &lt;\/a&gt;\n \n Also, keep in mind that if you delete the photos from your photobucket account, the links in the threads will no longer work.\n \n I am have cleaned up most of the chit-chat on this thread, and will work on adding photos where there are currently links or attachments. If you notice your dress is gone, it is probably b\/c the link\/photo was no longer valid. Feel free to add it back!\n \n &lt;font color=\"Magenta\"&gt;&lt;strong&gt;&lt;u&gt;Update 12\/18\/09 by Carly&lt;\/u&gt;\n Hey ladies, I&#039;m cleaing up this thread again. Please be sure to post the actual photos in here and not the link! Some of the newbies can&#039;t open links, so it&#039;s really helpful to upload the photos!!\n \n All comments (posts w\/o pictures or links) were deleted up thru November 2009. Start here to delete comments on next clean up - &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/bestdestinationwedding.com\/forum\/f54\/show-us-your-wedding-dress-85\/index13.html#post1087853\"&gt;http:\/\/bestdestinationwedding.com\/fo...ml#post1087853&lt;\/a&gt; (page 13, post 501)\n \n Adding pictures to links still needs to be completed.&lt;\/strong&gt;&lt;\/font&gt;","Attachments":[],"Id":126,"PostDate":1158010732,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Attention girls! This is Sarah hijacking this first thread to update...<br \/> <br \/> I'm in the process of going through and deleting all the miscellaneous \"chit chat\" in this thread. Some of this is really old, and the older members will remember the 30 pages of Kash getting her Scarlet, me agonizing over my second dress, etc. Well, it's time to let go of the past! I'm trying to make this thread have just one pic of our dresses- not the 45 comments that follow telling us how wonderful we look. Hopefully this will make this thread a little more fun to go through!<br \/> <br \/> <strong>Update 12\/18\/08 by Carly<\/strong><br \/> Please see this link for help in posting pictures, posting your photos IN the thread is much better then posting a link or attachment...<br \/> <a href='http:\/\/bestdestinationwedding.com\/forum\/t32313' class='bbc_url' title='External link' rel='nofollow external'>***Click here for FAQ's and to learn how to work this forum*** <\/a><br \/> <br \/> Also, keep in mind that if you delete the photos from your photobucket account, the links in the threads will no longer work.<br \/> <br \/> I am have cleaned up most of the chit-chat on this thread, and will work on adding photos where there are currently links or attachments. If you notice your dress is gone, it is probably b\/c the link\/photo was no longer valid. Feel free to add it back!<br \/> <br \/> <font color=\"Magenta\"><strong><u>Update 12\/18\/09 by Carly<\/u><br \/> Hey ladies, I'm cleaing up this thread again. Please be sure to post the actual photos in here and not the link! Some of the newbies can't open links, so it's really helpful to upload the photos!!<br \/> <br \/> All comments (posts w\/o pictures or links) were deleted up thru November 2009. Start here to delete comments on next clean up - <a href='http:\/\/bestdestinationwedding.com\/forum\/f54\/show-us-your-wedding-dress-85\/index13.html#post1087853' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/bestdestinati....ml#post1087853<\/a> (page 13, post 501)<br \/> <br \/> Adding pictures to links still needs to be completed.<\/strong><\/font>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bruceandjenniferpage@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1157841660,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206701.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Jennifer","Id":206701,"Name":"Jennifer","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":71,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"d62a9f32254b1e75ac883eff7fe1d5ef","RawContent":"This is what I wore. I bought it in a very pale blue but apprently it is not in that color anymore. I got it at David&#039;s Bridal for $150.\n \n \n &lt;img src=\"http:\/\/www.davidsbridal.com\/images\/fashions\/full\/s06_F1286_bluevelvettanzanite.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/&gt;","Attachments":[],"Id":127,"PostDate":1158011111,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n 