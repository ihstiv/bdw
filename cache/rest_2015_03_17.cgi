e":"AliciaW","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281922.jpg?_r=1424557167","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"StartDate":1424109124,"LastPoster":{"Id":282367,"Name":"MNsunseeker","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1886505,"PostDate":1424109124,"PostContent":"I recently got engaged and we've decided we're having a Mexico wedding in November 2016. I'm told...","Author":{"Signature":"","Email":"xoliciaxo@hotmail.com","IpAddress":"108.180.31.5","GroupId":39,"GroupName":"Newbie","JoinDate":1422460885,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281922.jpg?_r=1424557167","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"AliciaW","Id":281922,"Name":"AliciaW","IsOnline":false}},"Posts":[],"Id":"78799","Title":"Finding Out Who's Coming","LastPostDate":1426191653},{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":true,"CanReply":true,"CanFollow":true,"TotalPosts":26,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":1036,"MovedTo":null,"MovedOn":0,"FirstPostId":1884463,"Rating":0,"RatingHits":0,"Starter":{"Id":281804,"Name":"lilumpkin","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1422445186,"LastPoster":{"Id":282367,"Name":"MNsunseeker","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1887903,"PostDate":1425222948,"PostContent":"I'm not completely opposed to shorts (as long as they are dressy shorts). To be honest, i'd prefe...","Author":{"Signature":"<div><br><div>\u00a0<\/div>\n<div>\u00a0<\/div>\n<\/div>\n<p><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a>","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":40,"GroupName":"Jr. Member","JoinDate":1419412614,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1425000950","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}},"Posts":[],"Id":"78696","Title":"Beach Wedding Guest Attire","LastPostDate":1426191542}],"Pages":{"TotalItems":13909,"TotalPages":928,"CurrentPage":0,"NextPage":15,"PreviousPage":-1,"LastPage":13905},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
