Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":6,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":420,"MovedTo":null,"MovedOn":0,"FirstPostId":1721769,"Rating":0,"RatingHits":0,"Starter":{"Id":265461,"Name":"michelleosokin","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265461.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"IsOnline":false},"StartDate":1361077167,"LastPoster":{"Id":278018,"Name":"Rheannarudy","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278018.jpg?_r=1410892817","PhotoWidth":200,"PhotoHeight":131,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":45,"Preview":{"Id":1721769,"PostDate":1361077167,"PostContent":"Hi everyone!\u00a0 What\u00a0 a great find this site is for info!\u00a0 Just wondering if anyone could recommen...","Author":{"Signature":"","Email":"bella_osokin@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1359664196,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265461.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"michelleosokin","Id":265461,"Name":"michelleosokin","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72613,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"996bcdf78832288c64aaefb9a6e4d0e2","RawContent":"&lt;p&gt; Hi everyone!&amp;nbsp; What&amp;nbsp; a great find this site is for info!&amp;nbsp; Just wondering if anyone could recommend what excursions to do in the Mayan Riviera.&amp;nbsp; Our wedding is at the Now Jade April 23, 2013 and I am trying to decide what things to do while we are there.&amp;nbsp; Besides our wedding of course!&amp;nbsp; There is soooo much to do its a little overwhelming!&amp;nbsp; I have reserved a spot to go to the \"Jungle Place\" to hang out with the rescued spider monkeys already.&amp;nbsp; And of course the ruins will be on our list.&amp;nbsp; But if anyone could definitely recommend a tour or place thats a must see and do I would appreciate it!&amp;nbsp; And should one book these things prior to arriving at your resort or can you just book while you are there?&amp;nbsp; We have a daughter who will be 4 at the time of travel so kid friendly recommendations would be helpful!&amp;nbsp;&lt;\/p&gt; &lt;p&gt; Thanks!&lt;\/p&gt; &lt;p&gt; Michelle&lt;\/p&gt;","Attachments":[],"Id":1721769,"PostDate":1361077167,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hi everyone!\u00a0 What\u00a0 a great find this site is for info!\u00a0 Just wondering if anyone could recommend what excursions to do in the Mayan Riviera.\u00a0 Our wedding is at the Now Jade April 23, 2013 and I am trying to decide what things to do while we are there.\u00a0 Besides our wedding of course!\u00a0 There is soooo much to do its a little overwhelming!\u00a0 I have reserved a spot to go to the \"Jungle Place\" to hang out with the rescued spider monkeys already.\u00a0 And of course the ruins will be on our list.\u00a0 But if anyone could definitely recommend a tour or place thats a must see and do I would appreciate it!\u00a0 And should one book these things prior to arriving at your resort or can you just book while you are there?\u00a0 We have a daughter who will be 4 at the time of travel so kid friendly recommendations would be helpful!\u00a0<\/p> <p> Thanks!<\/p> <p> Michelle<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bella_osokin@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1359664196,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-265461.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"michelleosokin","Id":265461,"Name":"michelleosokin","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72613,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8d19dcf9a922feed0f80d52b7ee9899f","RawContent":"[quote]\nOriginally Posted by [b]michelleosokin[\/b] \/img\/forum\/go_quote.gif\n \n \n Hi everyone!  What  a great find this site is for info!  Just wondering if anyone could recommend what excursions to do in the Mayan Riviera.  Our wedding is at the Now Jade April 23, 2013 and I am trying to decide what things to do while we are there.  Besides our wedding of course!  There is soooo much to do its a little overwhelming!  I have reserved a spot to go to the \"Jungle Place\" to hang out with the rescued spider monkeys already.  And of course the ruins will be on our list.  But if anyone could definitely recommend a tour or place thats a must see and do I would appreciate it!  And should one book these things prior to arriving at your resort or can you just book while you are there?  We have a daughter who will be 4 at the time of travel so kid friendly recommendations would be helpful!  \n Thanks! \n Michelle[\/quote] \n Hi Michelle, \n We get married at the Now Sapphire in May 2013!  I just posted some ideas to our wedding website for our guests. From what I&#039;ve been told through my TA is that there are known and trusted tour companies that have reps at the hotels. They may not be \"rock bottom price\" but at the end of the day at least I know that I&#039;m not going to be strained by some no name just cuz we got a good price. I would get a good sense of what others want to do and then make those plans down there with the tour companies. Also, you may be able to escape for an adult outing since the Now offers child care. Good luck and you&#039;ll have to share lots of pics for me!! \n Best, \n Melissa","Attachments":[],"Id":1722066,"PostDate":1361154165,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>michelleosokin<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <p> Hi everyone!\u00a0 What\u00a0 a great find this site is for info!\u00a0 Just wondering if anyone could recommend what excursions to do in the Mayan Riviera.\u00a0 Our wedding is at the Now Jade April 23, 2013 and I am trying to decide what things to do while we are there.\u00a0 Besides our wedding of course!\u00a0 There is soooo much to do its a little overwhelming!\u00a0 I have reserved a spot to go to the \"Jungle Place\" to hang out with the rescued spider monkeys already.\u00a0 And of course the ruins will be on our list.\u00a0 But if anyone could definitely recommend a tour or place thats a must see and do I would appreciate it!\u00a0 And should one book these things prior to arriving at your resort or can you just book while you are there?\u00a0 We have a daughter who will be 4 at the time of travel so kid friendly recommendations would be helpful!\u00a0<\/p> <p> Thanks!<\/p> <p> Michelle<\/p> <\/blockquote> <p> Hi Michelle,<\/p> <p> We get married at the Now Sapphire in May 2013!\u00a0 I just posted some ideas to our wedding website for our guests. From what I've been told through my TA is that there are known and trusted tour companies that have reps at the hotels. They may not be \"rock bottom price\" but at the end of the day at least I know that I'm not going to be strained by some no name just cuz we got a good price. I would get a good sense of what others want to do and then make those plans down there with the tour companies. Also, you may be able to escape for an adult outing since the Now offers child care. Good luck and you'll have to share lots of pics for me!!<\/p> <p> Best,<\/p> <p> Melissa<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ma.palmerII@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1345508237,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-259415.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"melnryluvco","Id":259415,"Name":"melnryluvco","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72613,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"508e0c29e6b05228f92d38624ceb38a4","RawContent":"&lt;p&gt; The Ruins at Chichen Itza and Eco-Arqueological Park (Cenote):&lt;\/p&gt; &lt;p&gt; &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.cancunvista.com\/travel\/chichen_itza.htm\"&gt;&lt;font color=\"#0066cc\"&gt;http:\/\/www.cancunvista.com\/travel\/chichen_itza.htm&lt;\/font&gt;&lt;\/a&gt;&lt;\/p&gt; &lt;p&gt; Underwater Sculpture Museum of Cancun:&lt;\/p&gt; &lt;p&gt; &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.aquaworld.com.mx\/cancun-snorkeling.html\"&gt;&lt;font color=\"#0066cc\"&gt;http:\/\/www.aquaworld.com.mx\/cancun-snorkeling.html&lt;\/font&gt;&lt;\/a&gt;&lt;\/p&gt; &lt;p&gt; Snorkeling and Scuba:&lt;\/p&gt; &lt;p&gt; &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.ecotourism-cancun.com\/english\/snorkeling-and-diving-tours-cancun-mexico.html\"&gt;&lt;font color=\"#0066cc\"&gt;http:\/\/www.ecotourism-cancun.com\/english\/snorkeling-and-diving-tours-cancun-mexico.html&lt;\/font&gt;&lt;\/a&gt;&lt;\/p&gt; &lt;p&gt; Deep Sea Fishing:&lt;\/p&gt; &lt;p&gt; &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.ecotourism-cancun.com\/english\/fishing-tours-cancun-mexico.html\"&gt;&lt;font color=\"#0066cc\"&gt;http:\/\/www.ecotourism-cancun.com\/english\/fishing-tours-cancun-mexico.html&lt;\/font&gt;&lt;\/a&gt;&lt;\/p&gt; &lt;p&gt; Romantic Dinner Cruise:&lt;\/p&gt; &lt;p&gt; &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.ecotourism-cancun.com\/english\/fishing-tours-cancun-mexico.html\"&gt;&lt;font color=\"#0066cc\"&gt;http:\/\/www.ecotourism-cancun.com\/english\/fishing-tours-cancun-mexico.html&lt;\/font&gt;&lt;\/a&gt;&lt;\/p&gt; &lt;p&gt; Evening Pirate Dinner Cruise:&lt;\/p&gt; &lt;p&gt; &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.ecotourism-cancun.com\/english\/fishing-tours-cancun-mexico.html\"&gt;&lt;font color=\"#0066cc\"&gt;http:\/\/www.ecotourism-cancun.com\/english\/fishing-tours-cancun-mexico.html&lt;\/font&gt;&lt;\/a&gt;&lt;\/p&gt; &lt;p&gt; Zip Lining:&lt;\/p&gt; &lt;p&gt; &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.ecotourism-cancun.com\/english\/adventure-tours-and-ecotourism-cancun-mexico.html\"&gt;&lt;font color=\"#0066cc\"&gt;http:\/\/www.ecotourism-cancun.com\/english\/adventure-tours-and-ecotourism-cancun-mexico.html&lt;\/font&gt;&lt;\/a&gt;&lt;\/p&gt;","Attachments":[],"Id":1722067,"PostDate":1361154175,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> The Ruins at Chichen Itza and Eco-Arqueological Park (Cenote):<\/p> <p> <a href='http:\/\/www.cancunvista.com\/travel\/chichen_itza.htm' class='bbc_url' title='External link' rel='nofollow external'><font color=\"#0066cc\">http:\/\/www.cancunvista.com\/travel\/chichen_itza.htm<\/font><\/a><\/p> <p> Underwater Sculpture Museum of Cancun:<\/p> <p> <a href='http:\/\/www.aquaworld.com.mx\/cancun-snorkeling.html' class='bbc_url' title='External link' rel='nofollow external'><font color=\"#0066cc\">http:\/\/www.aquaworld.com.mx\/cancun-snorkeling.html<\/font><\/a><\/p> <p> Snorkeling and Scuba:<\/p> <p> <a href='http:\/\/www.ecotourism-cancun.com\/english\/snorkeling-and-diving-tours-cancun-mexico.html' class='bbc_url' title='External link' rel='nofollow external'><font color=\"#0066cc\">http:\/\/www.ecotourism-cancun.com\/english\/snorkeling-and-diving-tours-cancun-mexico.html<\/font><\/a><\/p> <p> Deep Sea Fishing:<\/p> <p> <a href='http:\/\/www.ecotourism-cancun.com\/english\/fishing-tours-cancun-mexico.html' class='bbc_url' title='External link' rel='nofollow external'><font color=\"#0066cc\">http:\/\/www.ecotourism-cancun.com\/english\/fishing-tours-cancun-mexico.html<\/font><\/a><\/p> <p> Romantic Dinner Cruise:<\/p> <p> <a href='http:\/\/www.ecotourism-cancun.com\/english\/fishing-tours-cancun-mexico.html' class='bbc_url' title='External link' rel='nofollow external'><font color=\"#0066cc\">http:\/\/www.ecotourism-cancun.com\/english\/fishing-tours-cancun-mexico.html<\/font><\/a><\/p> <p> Evening Pirate Dinner Cruise:<\/p> <p> <a href='http:\/\/www.ecotourism-cancun.com\/english\/fishing-tours-cancun-mexico.html' class='bbc_url' title='External link' rel='nofollow external'><font color=\"#0066cc\">http:\/\/www.ecotourism-cancun.com\/english\/fishing-tours-cancun-mexico.html<\/font><\/a><\/p> <p> Zip Lining:<\/p> <p> <a href='http:\/\/www.ecotourism-cancun.com\/english\/adventure-tours-and-ecotourism-cancun-mexico.html' class='bbc_url' title='External link' rel='nofollow external'><font color=\"#0066cc\">http:\/\/www.ecotourism-cancun.com\/english\/adventure-tours-and-ecotourism-cancun-mexico.html<\/font><\/a><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ma.palmerII@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1345508237,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-259415.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"melnryluvco","Id":259415,"Name":"melnryluvco","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72613,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b2a17a7d06ee32601e2baea830ee9556","RawContent":"&lt;p&gt; **These were just ideas and no necessarily the tour companies at the Now resorts&lt;\/p&gt;","Attachments":[],"Id":1722068,"PostDate":1361154226,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> **These were just ideas and no necessarily the tour companies at the Now resorts<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ma.palmerII@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1345508237,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-259415.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"melnryluvco","Id":259415,"Name":"melnryluvco","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":72613,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c174e2453252880ca93b7575bc6bd8b2","RawContent":"&lt;p&gt; Thanks! &amp;nbsp;Food for thought! &amp;nbsp;Just can&#039;t wait for April!!&lt;\/p&gt;","Attachments":[],"Id":1722182,"PostDate":1361189114,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Thanks! \u00a0Food for thought! \u00a0Just can't wait for April!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bella_osokin@hotmail.com","IpAddress"