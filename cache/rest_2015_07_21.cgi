mail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1236061177,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-215437.gif?_r=0","PhotoWidth":75,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"midnight24","Id":215437,"Name":"midnight24","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":48251,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5e781af804e518d085c7178c969f0024","RawContent":"I do have a plan to get them down there. I am taking them on the plane with me because they are glass. I am fortunately traveling with several family members who do not need their alotted 2 checked bags. I am packing all the vases in a carry on suitcase (the small wheeled ones) and I can pack other small OOT bag contents within the vases. I bought cheap bubble wrap at the dollar store, so I think they will make it their unharmed! I would definitely NOT check these under the plane!","Attachments":[],"Id":1032379,"PostDate":1265951001,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I do have a plan to get them down there. I am taking them on the plane with me because they are glass. I am fortunately traveling with several family members who do not need their alotted 2 checked bags. I am packing all the vases in a carry on suitcase (the small wheeled ones) and I can pack other small OOT bag contents within the vases. I bought cheap bubble wrap at the dollar store, so I think they will make it their unharmed! I would definitely NOT check these under the plane!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10748;116\/st\/20100619\/e\/Our+Wedding%21%21%21%21%21\/dt\/-1\/k\/1b1c\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...1b1c\/event.png<\/a><\/div><\/div>","Email":"Ebernard4985@aol.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1247807786,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-219530.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"ebernard4985","Id":219530,"Name":"ebernard4985","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":48251,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7cda4010be61b14178ae082fca2e1e44","RawContent":"And thanks ladies, I am VERY happy with them!","Attachments":[],"Id":1032380,"PostDate":1265951032,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                And thanks ladies, I am VERY happy with them!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post