ily: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Thank you! I will definitely check Creative Montage out!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mskenyaf@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1261633666,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-224078.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"MsKenyaF","Id":224078,"Name":"MsKenyaF","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":67667,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c7b79abcccb2c5d231b6860f0c3a9f5f","RawContent":"Wonderful job and thank you for sharing.  I plan to check out your vendors and sites.  Congrats!! [quote]\nOriginally Posted by [b]ellie0717[\/b] \/img\/forum\/go_quote.gif\n \n \n Thank you so much! To answer your questions I did print everything myself on just a regular printer.  The palm tree on the cover of our passports is actually our wedding monogram.  I ordered it from Creative Montage on Etsy for around $20 for the digital files of 5 monograms.  I&#039;ve attached it below :)  \n [img]http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/163645\/width\/350\/height\/700[\/img][\/quote]","Attachments":[],"Id":1666282,"PostDate":1348497976,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Wonderful job and thank you for sharing.\u00a0 I plan to check out your vendors and sites.\u00a0 Congrats!!<\/p> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>ellie0717<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" \/><\/span><br \/> <br \/> <p> Thank you so much! To answer your questions I did print everything myself on just a regular printer.\u00a0 The palm tree on the cover of our passports is\u00a0actually our wedding\u00a0monogram.\u00a0 I ordered it from Creative Montage on Etsy for around $20 for the digital files of 5 monograms.\u00a0\u00a0I've attached it below <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0<\/p> <p id=\"yui_3_5_1_1_1348156708466_1191\"> <span rel='lightbox'><img class='bbc_img' alt=\"\" data-id=\"163645\" data-type=\"61\" src=\"http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/163645\/width\/350\/height\/700\" \/><\/span><\/p> <\/blockquote>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tproane16@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1344972479,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Ty Roane","Id":259170,"Name":"Ty Roane","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":67667,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e482366819abc225ef9cca7b00825e93","RawContent":"&lt;p&gt; I love your wedding invitations they are amazing. can you tell me how you did the wedding envelope with the map inside? Also the map paper you wrap the invites with? &amp;nbsp;can you list all the materials for the wedding invitation? Thank you&lt;\/p&gt;","Attachments":[],"Id":1713385,"PostDate":1359539216,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I love your wedding invitations they are amazing. can you tell me how you did the wedding envelope with the map inside? Also the map paper you wrap the invites with? \u00a0can you list all the materials for the wedding invitation? Thank you<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"clarylaracuente@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1358990039,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-264992.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":105,"PhotoType":"custom"},"FormattedName":"cldra","Id":264992,"Name":"cldra","IsOnline":false}}],"Pages":{"TotalItems":37,"TotalPages":4,"CurrentPage":10,"NextPage":20,"PreviousPage":0,"LastPage":30},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
