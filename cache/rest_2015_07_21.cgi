{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":6,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":614,"MovedTo":null,"MovedOn":0,"FirstPostId":1023455,"Rating":0,"RatingHits":0,"Starter":{"Id":224289,"Name":"Massagegirl","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-224289.jpg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"IsOnline":false},"StartDate":1265338753,"LastPoster":{"Id":279087,"Name":"Msmimi","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":45,"Preview":{"Id":1023455,"PostDate":1265338753,"PostContent":"We are looking to just use our ipod for the wedding and cocktail hour...Anyone have ideas about h...","Author":{"Signature":"","Email":"m3opil@aol.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1262568427,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-224289.jpg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Massagegirl","Id":224289,"Name":"Massagegirl","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":47989,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e2375bead01e24219b0e35fb7b62543c","RawContent":"We are looking to just use our ipod for the wedding and cocktail hour...Anyone have ideas about hooking up my ipod to a karaoke machine that has a microphone? Has anyone else used their ipod with a microphone without renting speakers&lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/huh.gif\" border=\"0\" alt=\"\" title=\"Huh\" class=\"inlineimg\" \/&gt;? I just cant see spending more $$$$$ =)","Attachments":[],"Id":1023455,"PostDate":1265338753,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We are looking to just use our ipod for the wedding and cocktail hour...Anyone have ideas about hooking up my ipod to a karaoke machine that has a microphone? Has anyone else used their ipod with a microphone without renting speakers<span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/huh.gif\" border=\"0\" alt=\"\" title=\"Huh\" class=\"inlineimg\" \/><\/span>? I just cant see spending more $$$$$ =)\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"m3opil@aol.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1262568427,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-224289.jpg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Massagegirl","Id":224289,"Name":"Massagegirl","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":47989,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"347ac899a9601e7e4d4ef31cdeac560c","RawContent":"I am having the same issue, so hopefully someone can help us out. I thought the whole issue was settled and now my WC is telling me I need to rent the DJ in order to use the microphone. I do not understand why I cannot just use the one the resort has around the pools?\n \n Good luck....hope someone can help us out!","Attachments":[],"Id":1023767,"PostDate":1265398036,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I am having the same issue, so hopefully someone can help us out. I thought the whole issue was settled and now my WC is telling me I need to rent the DJ in order to use the microphone. I do not understand why I cannot just use the one the resort has around the pools?<br \/> <br \/> Good luck....hope someone can help us out!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10716;130\/st\/20100225\/e\/Our+Wedding%21\/dt\/-2\/k\/4d0e\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...4d0e\/event.png<\/a><\/div><\/div>","Email":"rayaisme@telus.net","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1254581021,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-222262.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Raykel","Id":222262,"Name":"Raykel","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":47989,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5e25ab39f50fdbb7a41b84431ca35e9e","RawContent":"Thought I would let you know...I heard from one of the bride&#039;s from my resort. They did the ipod and speakers only and she just sent me an email sugggesting we use the DJ if the music and dance are really important to us. Aparently it was really windy and with the resort show going on not far away it covered a lot of their music and made it fairly faint.\n \n So I thought I would pass the info along for you. Not sure what resort you are at, but I would imagine similar set ups are at all of them.","Attachments":[],"Id":1024903,"PostDate":1265485670,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thought I would let you know...I heard from one of the bride's from my resort. They did the ipod and speakers only and she just sent me an email sugggesting we use the DJ if the music and dance are really important to us. Aparently it was really windy and with the resort show going on not far away it covered a lot of their music and made it fairly faint.<br \/> <br \/> So I thought I would pass the info along for you. Not sure what resort you are at, but I would imagine similar set ups are at all of them.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10716;130\/st\/20100225\/e\/Our+Wedding%21\/dt\/-2\/k\/4d0e\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...4d0e\/event.png<\/a><\/div><\/div>","Email":"rayaisme@telus.net","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1254581021,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-222262.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Raykel","Id":222262,"Name":"Raykel","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":47989,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3dc12f20551cc6ae9824b5a87dfcb083","RawContent":"Thank you!! Yep, I think we&#039;re going to just pay the $$ to make sure it&#039;s done right &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/wink.gif\" border=\"0\" alt=\"\" title=\"Wink\" class=\"inlineimg\" \/&gt;\n Good luck to you!","Attachments":[],"Id":1036476,"PostDate":1266289395,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thank you!! Yep, I think we're going to just pay the $$ to make sure it's done right <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/wink.gif\" border=\"0\" alt=\"\" title=\"Wink\" class=\"inlineimg\" \/><\/span><br \/> Good luck to you!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"m3opil@aol.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1262568427,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-224289.jpg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Massagegirl","Id":224289,"Name":"Massagegirl","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"146.235.0.9","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":47989,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"38cc125061620ccb10dafe9ec2989169","RawContent":"&lt;p&gt;I found some apps that turn your phone into a microphone. I think they work best when your use a bluetooth connection and keep some distance from your phone and speaker. Try &lt;em&gt;Pocket MIC, DaMIC, PaMic, and Microphone Amplifier.&lt;\/em&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good Luck&lt;\/p&gt;","Attachments":[],"Id":1885159,"PostDate":1423056566,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I found some apps that turn your phone into a microphone. I think they work best when your use a bluetooth connection and keep some distance from your phone and speaker. Try <em>Pocket MIC, DaMIC, PaMic, and Microphone Amplifier.<\/em><\/p>\n<p>\u00a0<\/p>\n<p>Good Luck<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"erobin2@gmail.com","IpAddress":"146.235.0.9","GroupId":39,"GroupName":"Newbie","JoinDate":1401289524,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278147.jpg?_r=1417725779","PhotoWidth":200,"PhotoHeight":220,"PhotoType":"custom"},"FormattedName":"erobin223","Id":278147,"Name":"erobin223","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.89.236.44","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":47989,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7cb2ac1732bf74a8f6d0c0828f0d16eb","RawContent":"&lt;p&gt;Something to look into, thanks.&lt;\/p&gt;","Attachments":[],"Id":1885202,"PostDate":1423077696,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Something to look into, thanks.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"njwood000@gmail.com","IpAddress":"71.7.173.185","GroupId":40,"GroupName":"Jr. Member","JoinDate":1405810391,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Msmimi","Id":279087,"Name":"Msmimi","IsOnline":false}}],"Id":"47989","Title":"Microphone hookup?","LastPostDate":1423077696},"Pages":{"TotalItems":6,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},