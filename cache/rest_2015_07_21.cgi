thurs-wedding-rprm-20141208\/?p=1852686'>DIY - Giant Crepe Roses<\/a>,\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/76802-elsas-arthurs-wedding-rprm-20141208\/?p=1867378'>DIY - Hangers & Boutonnieres<\/a>,\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/76802-elsas-arthurs-wedding-rprm-20141208\/?p=1867696'>DIY - Kissing Menu\/I Spy & Guestbook<\/a><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/76802-elsas-arthurs-wedding-rprm-20141208\/page-6#entry1878023'>More DIYs - Passport to Riviera Maya, Bookmarks, Tumbler Inserts, Luggage Tags, Keycard Holder Inserts, Something Special for You Inserts<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"elsa_jam@yahoo.com","IpAddress":"23.16.109.98","GroupId":40,"GroupName":"Jr. Member","JoinDate":1372273518,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270962.png?_r=1397000926","PhotoWidth":200,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Icis","Id":270962,"Name":"Icis","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.41.59","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78364,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c70c5a95b2629080e3a4bb1803c7302d","RawContent":"[quote name=\"Icis\" post=\"1878080\" timestamp=\"1415586835\"]\nWow...that&#039;s pricey. :o[\/quote]I know! And I didn&#039;t get pricing on the big names either!  I&#039;m not doing videography. \n\nMy resort photographer is $1200 ish for 3 hours. \n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1878084,"PostDate":1415575546,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Icis, on 09 November 2014 - 10:33 PM, said:<\/p><div class='blockquote'><div class='quote'><p>Wow...that's pricey. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/ohmy.png' class='bbc_emoticon' alt=':o' \/><\/p><\/div><\/div>\n<br>\nI know! And I didn't get pricing on the big names either!  I'm not doing videography. <br><br>\nMy resort photographer is $1200 ish for 3 hours. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.194.255.163","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78364,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9987c06c5d2f9ee0012bbc865ad9f17e","RawContent":"[quote name=\"calgarybride2015\" post=\"1878084\" timestamp=\"1415589946\"]\nI know! And I didn&#039;t get pricing on the big names either! I&#039;m not doing videography.\n\nMy resort photographer is $1200 ish for 3 hours.\n\n\nSent from my iPhone using Tapatalk[\/quote]\nI thought about videography. I asked all my friends who had it done how many times they rewatched it, and the general consensus was: 3 times in the past 5 years. \n\nI purchased videos from our scuba diving experience before and I have only watched it once after I bought it (2 years ago).\n\nSo....yah....maybe I&#039;ll just ask one of my guests to hold my camera and video it. Lol. Good enough.","Attachments":[],"Id":1878086,"PostDate":1415575973,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>calgarybride2015, on 09 November 2014 - 11:25 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>I know! And I didn't get pricing on the big names either! I'm not doing videography.<br><br>\nMy resort photographer is $1200 ish for 3 hours.<br><br><br>\nSent from my iPhone using Tapatalk<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>I thought about videography. I asked all my friends who had it done how many times they rewatched it, and the general consensus was: 3 times in the past 5 years.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I purchased videos from our scuba diving experience before and I have only watched it once after I bought it (2 years ago).<\/p>\n<p>\u00a0<\/p>\n<p>So....yah....maybe I'll just ask one of my guests to hold my camera and video it. Lol. Good enough.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Our Awesome <a data-ipb='nomediaparse' href='https:\/\/www.wevideo.com\/hub\/#media\/ci\/113639543'>Video<\/a><\/p>\n<p>Our <a data-ipb='nomediaparse' href='http:\/\/itslegendary2014.wix.com\/fasa'>Website<\/a><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/76802-elsas-arthurs-wedding-rprm-20141208\/'>Riu Palace Riviera Maya Planning Thread<\/a><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/76802-elsas-arthurs-wedding-rprm-20141208\/?p=1864158'>Pre-wedding photos<\/a>,\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/76802-elsas-arthurs-wedding-rprm-20141208\/?p=1878020'>OOT Baskets<\/a>, <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/76802-elsas-arthurs-wedding-rprm-20141208\/?p=1878578'>Centrepieces<\/a><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/76802-elsas-arthurs-wedding-rprm-20141208\/?p=1852686'>DIY - Giant Crepe Roses<\/a>,\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/76802-elsas-arthurs-wedding-rprm-20141208\/?p=1867378'>DIY - Hangers & Boutonnieres<\/a>,\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/76802-elsas-arthurs-wedding-rprm-20141208\/?p=1867696'>DIY - Kissing Menu\/I Spy & Guestbook<\/a><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/76802-elsas-arthurs-wedding-rprm-20141208\/page-6#entry1878023'>More DIYs - Passport to Riviera Maya, Bookmarks, Tumbler Inserts, Luggage Tags, Keycard Holder Inserts, Something Special for You Inserts<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"elsa_jam@yahoo.com","IpAddress":"23.16.109.98","GroupId":40,"GroupName":"Jr. Member","JoinDate":1372273518,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-270962.png?_r=1397000926","PhotoWidth":200,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Icis","Id":270962,"Name":"Icis","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.72.41.59","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78364,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"13f3b52100aea3abf394817b98e3f666","RawContent":"[quote name=\"Icis\" post=\"1878086\" timestamp=\"1415590373\"]\nI thought about videography. I asked all my friends who had it done how many times they rewatched it, and the general consensus was: 3 times in the past 5 years. \n\nI purchased videos from our scuba diving experience before and I have only watched it once after I bought it (2 years ago).\n\nSo....yah....maybe I&#039;ll just ask one of my guests to hold my camera and video it. Lol. Good enough.[\/quote]\nAgree!\n\nWe have a nice camera and tripod, so we may set it up and have a guest aim it at the front of the isle hehe!","Attachments":[],"Id":1878087,"PostDate":1415576030,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Icis, on 09 November 2014 - 11:32 PM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>I thought about videography. I asked all my friends who had it done how many times they rewatched it, and the general consensus was: 3 times in the past 5 years.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I purchased videos from our scuba diving experience before and I have only watched it once after I bought it (2 years ago).<\/p>\n<p>\u00a0<\/p>\n<p>So....yah....maybe I'll just ask one of my guests to hold my camera and video it. Lol. Good enough.<\/p>\n<\/div>\n<\/div><\/div>\n<p>\u00a0<\/p>\n<p>Agree!<\/p>\n<p>\u00a0<\/p>\n<p>We have a nice camera and tripod, so we may set it up and have a guest aim it at the front of the isle hehe!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"65.28.175.252","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78364,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ea64c0ce5488aa1b15470a29570f5fb0","RawContent":"I recently got married near Cancun, and originally wasn&#039;t going to spend the money on a videographer because I didn&#039;t think it would be worth it, but I am SO SO SO glad we ended up getting one!  I chose Dreams Gate Cinema, and I can&#039;t  say enough good things about them. I was incredibly happy with the short film video (8 min long-- great for sharing with friends and family on facebook) he posted online for us. We haven&#039;t  seen the full version (about an hour), but I trust it will be great. Luis is so creative, and amazing at his job. I read a comment saying people don&#039;t  watch their wedding videos, but we will definitely watch ours over the years because of the way it is edited. It&#039;s  short, adorable, and a great way to remember an incredible day with our friends and family. No regrets spending the money. Here is our short video if you want to check it out: &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/dreamsgatefilms.com\/high-lights-jamie-tim-by-luis-paredes-hotel-maroma\/&#039;&gt;http:\/\/dreamsgatefilms.com\/high-lights-jamie-tim-by-luis-paredes-hotel-maroma\/&lt;\/a&gt;","Attachments":[],"Id":1878105,"PostDate":1415584903,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I recently got married near Cancun, and originally wasn't going to spend the money on a videographer because I didn't think it would be worth it, but I am SO SO SO glad we ended up getting one!  I chose Dreams Gate Cinema, and I can't  say enough good things about them. I was incredibly happy with the short film video (8 min long-- great for sharing with friends and family on facebook) he posted online for us. We haven't  seen the full version (about an hour), but I trust it will be great. Luis is so creative, and amazing at his job. I read a comment saying people don't  watch their wedding videos, but we will definitely watch ours over the years because of the way it is edited. It's  short, adorable, and a great way to remember an incredible day with our friends and family. No regrets spending the money. Here is our short video if you want to check it out: <a href='http:\/\/dreamsgatefilms.com\/high-lights-jamie-tim-by-luis-paredes-hotel-maroma\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/dreamsgatefil...s-hotel-maroma\/<\/a>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jamielynn0712@msn.com","IpAddress":"65.28.175.252","GroupId":39,"GroupName":"Newbie","JoinDate":1377632889,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-272978.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"jamielynn0712","Id":272978,"Name":"jamielynn0712","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.195.6.67","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78364,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6d76536e3cd07c685fd94bee7f426f6f","RawContent":"How long was everyone&#039;s video that they got back from the videographer? Mine says that for 5hrs of videography I get a 20-25 minute video.  Most of my friends in the states got a 10 min video and then a longer version as well.  I am not sure what is typical in Mexico.","Attachments":[],"Id":1879280,"PostDate":1417197284,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                How long was everyone's video that they got back from the videographer? Mine says that for 5hrs of videography I get a 20-25 minute video.  Most of my friends in the states got a 10 min video and then a longer version as well.  I am not sure what is typical in Mexico.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ltrawlsrn@aol.com","IpAddress":"216.80.25.163","GroupId":39,"GroupName":"Newbie","JoinDate":1411143926,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"LTR","Id":279912,"Name":"LTR","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"170.115.248.21","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78364,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"462a2169f48bfb88ed2d9a7b6f153212","RawContent":"&lt;p&gt;I actually dont think I want a very long video. But, I do really want a highlight video. I may splurge more on the photographs, because that is something I will always love. And then use a more affordable videographer for like 4 hours.&lt;\/p&gt;","Attachments":[],"Id":1879578,"PostDate":1417627243,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I actually dont think I want a very long video. But, I do really want a highlight video. I may splurge more on the photographs, because that is something I will always love. And then use a more affordable videographer for like 4 hours.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"So far 41 guests + bride and groom + 10 kids = 95 room nights.    Focused on planning without stressing.","Email":"bush.chanel@gmail.com","IpAddress":"170.115.248.23","GroupId":40,"GroupName":"Jr. Member","JoinDate":1401288470,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"TheBHolders","Id":278146,"Name":"TheBHolders","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"67.184.85.100","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78364,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ce7024e6a8a7b72bc1969c498c611d7e","RawContent":"&lt;p&gt;Videography is included in my wedding package (just a short film of the ceremony), so we were going to upgrade to the full day, but after seeing examples of their videographer, I decided to go with an external vendor. I get a 5 min highlight film and a 60 min wedding vid for $1750 for 8 hours. Can&#039;t wait!&lt;\/p&gt;","Attachments":[],"Id":1880125,"PostDate":1418294810,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Videography is included in my wedding package (just a short film of the ceremony), so we were going to upgrade to the full day, but after seeing examples of their videographer, I decided to go with an external vendor. I get a 5 min highlight film and a 60 min wedding vid for $1750 for 8 hours. Can't wait!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"natalie.zaval@gmail.com","IpAddress":"67.184.87.109","GroupId":40,"GroupName":"Jr. Member","JoinDate":1389117352,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-275926.jpg?_r=1418313578","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"nattiegams325","Id":275926,"Name":"nattiegams325","IsOnline":false}}],"Id":"78364","Title":"Videographer","LastPostDate":1418294810},"Pages":{"TotalItems":10,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
