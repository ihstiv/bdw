{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":2,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":394,"MovedTo":null,"MovedOn":0,"FirstPostId":1424462,"Rating":0,"RatingHits":0,"Starter":{"Id":211048,"Name":"Simistar","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211048.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"IsOnline":false},"StartDate":1301232238,"LastPoster":{"Id":279711,"Name":"Bride2b15","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279711.jpg?_r=1410256327","PhotoWidth":200,"PhotoHeight":125,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":45,"Preview":{"Id":1424462,"PostDate":1301232238,"PostContent":"Hey ladies,  \u00a0  This question is actually for a friend of mine getting married in England.  She'...","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f77\/simistars-secrets-maroma-wedding-review-dec-7-08-a-34046\/\">My Secrets Maroma Beach Wedding Review<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f89\/review-photographer-michael-maurus-cancun-wedding-photography-43467\/\">My Photographer Review<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f55\/my-diy-flushmount-album-finally-review-pics-55062\/\">My DIY Flushmount Wedding Album<\/a><\/div><\/div>","Email":"msimick@hotmail.com","IpAddress":"174.6.82.216","GroupId":3,"GroupName":"Member","JoinDate":1218144047,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211048.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Simistar","Id":211048,"Name":"Simistar","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60413,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3f0de075c48746a25423ef40d87be54a","RawContent":"&lt;p&gt; Hey ladies,&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; This question is actually for a friend of mine getting married in England.&lt;\/p&gt; &lt;p&gt; She&#039;s only have one bridesmaid and is wondering what to do about music.&lt;\/p&gt; &lt;p&gt; (We had NO wedding party at our wedding, so we played one song for everyone being seated etc and then another for me walking down the aisle...)&lt;\/p&gt; &lt;p&gt; She&#039;s having a string quartet play and I think ideally she&#039;d like to walk down the aisle to something different than the bridesmaid, but she&#039;s wondering what other people have done in this situation, since it will only take like 30 seconds for the bridesmaid to make it down the aisle:-)&lt;\/p&gt; &lt;p&gt; Do they cut one song REALLY short for the bridesmaid walk and then go to a song for her...? That may sound weird...?&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I&#039;m thinking she uses the same song she&#039;s walking down the aisle to for the bridesmaid walk, BUT have the string quartet do an \"intro\" or the beginning of the song quite different for the bridesmaid, then go into the main part of the song for her...?&lt;\/p&gt; &lt;p&gt; Not sure...&lt;\/p&gt; &lt;p&gt; What have you girls done or are doing??;-)&lt;\/p&gt; &lt;p&gt; Advice\/suggestions appreciated:-)&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Thanks!&lt;\/p&gt;","Attachments":[],"Id":1424462,"PostDate":1301232238,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hey ladies,<\/p> <p> \u00a0<\/p> <p> This question is actually for a friend of mine getting married in England.<\/p> <p> She's only have one bridesmaid and is wondering what to do about music.<\/p> <p> (We had NO wedding party at our wedding, so we played one song for everyone being seated etc and then another for me walking down the aisle...)<\/p> <p> She's having a string quartet play and I think ideally she'd like to walk down the aisle to something different than the bridesmaid, but she's wondering what other people have done in this situation, since it will only take like 30 seconds for the bridesmaid to make it down the aisle:-)<\/p> <p> Do they cut one song REALLY short for the bridesmaid walk and then go to a song for her...? That may sound weird...?<\/p> <p> \u00a0<\/p> <p> I'm thinking she uses the same song she's walking down the aisle to for the bridesmaid walk, BUT have the string quartet do an \"intro\" or the beginning of the song quite different for the bridesmaid, then go into the main part of the song for her...?<\/p> <p> Not sure...<\/p> <p> What have you girls done or are doing??;-)<\/p> <p> Advice\/suggestions appreciated:-)<\/p> <p> \u00a0<\/p> <p> Thanks!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f77\/simistars-secrets-maroma-wedding-review-dec-7-08-a-34046\/\">My Secrets Maroma Beach Wedding Review<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f89\/review-photographer-michael-maurus-cancun-wedding-photography-43467\/\">My Photographer Review<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/f55\/my-diy-flushmount-album-finally-review-pics-55062\/\">My DIY Flushmount Wedding Album<\/a><\/div><\/div>","Email":"msimick@hotmail.com","IpAddress":"174.6.82.216","GroupId":3,"GroupName":"Member","JoinDate":1218144047,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211048.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Simistar","Id":211048,"Name":"Simistar","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"188.29.166.79","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":60413,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d35a6a2e575aa4db8e617bd9c72041ba","RawContent":"&lt;p&gt;I think thats a really good idea!&lt;\/p&gt;","Attachments":[],"Id":1872967,"PostDate":1411553332,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I think thats a really good idea!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"justineatack@gmail.com","IpAddress":"31.54.1.116","GroupId":40,"GroupName":"Jr. Member","JoinDate":1409997456,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.