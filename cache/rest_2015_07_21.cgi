{"Success":true,"Data":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50551,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"edbaca09168b5682f19940efbbe3a4b3","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;barbiegirl_27&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;Awesome! Your feedback would be greatly appreciated! \n My brother has a dock, plus we both have the travel speakers.....they both get quite large but hard to judge when you don&#039;t know what it&#039;s going to be like around.\n \n I was thinking of getting the sound system for the ceremony b\/c it comes with a mic, and i&#039;ve read that people aren&#039;t able to hear your vows without the mic when the ceremony is on the beach!&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;I&#039;ve heard this too, which makes me think if they can&#039;t hear the vows, then they probably can&#039;t hear the music.","Attachments":[],"Id":1114953,"PostDate":1271358777,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>barbiegirl_27<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">Awesome! Your feedback would be greatly appreciated! <br \/> My brother has a dock, plus we both have the travel speakers.....they both get quite large but hard to judge when you don't know what it's going to be like around.<br \/> <br \/> I was thinking of getting the sound system for the ceremony b\/c it comes with a mic, and i've read that people aren't able to hear your vows without the mic when the ceremony is on the beach!<\/div> <\/td> <\/tr> <\/table> <\/div>I've heard this too, which makes me think if they can't hear the vows, then they probably can't hear the music.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"maddog1991@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1254096844,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-222063.jpg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"md2002","Id":222063,"Name":"md2002","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50551,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4fdc4a16d12e52b029e2ff729bc5ec80","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;dolfinluck&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;I plan on buying it for my wedding next month so I&#039;ll let you know when we get back. Going to be using it at the Gazebo for the ceremony and for the reception on the beach.&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;please let us know.. I can&#039;t believe noone has used this.","Attachments":[],"Id":1115612,"PostDate":1271381913,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>dolfinluck<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">I plan on buying it for my wedding next month so I'll let you know when we get back. Going to be using it at the Gazebo for the ceremony and for the reception on the beach.<\/div> <\/td> <\/tr> <\/table> <\/div>please let us know.. I can't believe noone has used this.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tiffani@josephinsurancegroup.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1246294039,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-218912.jpg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"lovelytlc","Id":218912,"Name":"lovelytlc","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50551,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"30fe4ec60098ef3411345830cb4836a9","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;lovelytlc&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;please let us know.. I can&#039;t believe noone has used this.&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;I believe others have, think i remember it from this thread. &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/bestdestinationwedding.com\/forum\/f9\/what-i-would-wouldnt-do-again-6691\/\"&gt;what-i-would-wouldnt-do-again&lt;\/a&gt;, when i first read thru all the posts.","Attachments":[],"Id":1115998,"PostDate":1271425435,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>lovelytlc<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">please let us know.. I can't believe noone has used this.<\/div> <\/td> <\/tr> <\/table> <\/div>I believe others have, think i remember it from this thread. <a href='http:\/\/bestdestinationwedding.com\/forum\/f9\/what-i-would-wouldnt-do-again-6691\/' class='bbc_url' title='External link' rel='nofollow external'>what-i-would-wouldnt-do-again<\/a>, when i first read thru all the posts.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"hahawryluk@hotmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1221055369,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211661.JPG?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"dolfinluck","Id":211661,"Name":"dolfinluck","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50551,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"95f748e46a21891be6a99ebc0c13e72c","RawContent":"We used the portable bose sound dock for the reception. we were on the beach and it worked perfectly. It was very loud, still could hear the music 50 ft away and could still make it louder. we didnt use it for the ceremony as the resort had a mic and speakers for us to use free of charge.","Attachments":[],"Id":1158231,"PostDate":1274447648,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We used the portable bose sound dock for the reception. we were on the beach and it worked perfectly. It was very loud, still could hear the music 50 ft away and could still make it louder. we didnt use it for the ceremony as the resort had a mic and speakers for us to use free of charge.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"hahawryluk@hotmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1221055369,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211661.JPG?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"dolfinluck","Id":211661,"Name":"dolfinluck","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50551,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"85fab35235c64eb3ec99c33d44a15b53","RawContent":"I plan on using it for my wedding or something close. We used it for my brother in law&#039;s 50th last year and it was amazing. Everyone couldn&#039;t believe all that sound was coming from that little device. I have used Bose products for years. Their sound is clear and crisp and of course LOUD!","Attachments":[],"Id":1158242,"PostDate":1274448128,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I plan on using it for my wedding or something close. We used it for my brother in law's 50th last year and it was amazing. Everyone couldn't believe all that sound was coming from that little device. I have used Bose products for years. Their sound is clear and crisp and of course LOUD!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>BDW the best place for my TYPE A personality!<\/span><\/div><\/div>","Email":"aishaandricardo@gmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1264348805,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-224999.jpg?_r=0","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"AishaB","Id":224999,"Name":"AishaB","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50551,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f54f9e2a8ea17b1e4ab40343b0e1d374","RawContent":"We bought a portable Logitech that has a 3 hour battery life (also can be plugged in) and the sound was awesome &amp;amp; we actually turned it down over dinner so we could talk more. Knowing Bose I am sure it works much better but we paid $30 for ours at Best Buy and it worked great for our small wedding\/reception.","Attachments":[],"Id":1158533,"PostDate":1274459557,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We bought a portable Logitech that has a 3 hour battery life (also can be plugged in) and the sound was awesome & we actually turned it down over dinner so we could talk more. Knowing Bose I am sure it works much better but we paid $30 for ours at Best Buy and it worked great for our small wedding\/reception.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Chrissy & Jeremiah's Blog with Pictures...<\/span><br><br><a data-ipb='nomediaparse' href=\"http:\/\/www.brilliant.tc\/2010\/05\/chrissy-jeremiah-island-escape\/\">http:\/\/www.brilliant.tc\/2010\/05\/chri...island-escape\/<\/a><\/div><\/div>","Email":"christinambucko@aol.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1258050538,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-223252.gif?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"Girasole","Id":223252,"Name":"Girasole","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50551,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6280342a423b9873abeae79e57b8954b","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;Girasole&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;We bought a portable Logitech that has a 3 hour battery life (also can be plugged in) and the sound was awesome &amp;amp; we actually turned it down over dinner so we could talk more. Knowing Bose I am sure it works much better but we paid $30 for ours at Best Buy and it worked great for our small wedding\/reception.&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;This is good to know! Thanks. I actually have the legitech portable speakers, but my brother has the bose sound dock. I had considered asking him to bring it, although I think it would be somewhat of an inconvenience for him! The portable speakers are really easy to travel with!","Attachments":[],"Id":1158577,"PostDate":1274461159,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>Girasole<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">We bought a portable Logitech that has a 3 hour battery life (also can be plugged in) and the sound was awesome & we actually turned it down over dinner so we could talk more. Knowing Bose I am sure it works much better but we paid $30 for ours at Best Buy and it worked great for our small wedding\/reception.<\/div> <\/td> <\/tr> <\/table> <\/div>This is good to know! Thanks. I actually have the legitech portable speakers, but my brother has the bose sound dock. I had considered asking him to bring it, although I think it would be somewhat of an inconvenience for him! The portable speakers are really easy to travel with!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"anitaperry@eastlink.ca","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1262707803,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-224334.jpg?_r=0","PhotoWidth":200,"PhotoHeight":136,"PhotoType":"custom"},"FormattedName":"barbiegirl_27","Id":224334,"Name":"barbiegirl_27","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50551,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1581e3808da944f3fde3daf5c476cbb5","RawContent":"We plan on using our portable Bose sound dock also. I&#039;m glad to hear someone has used it and it worked well! We used it last year at a birthday party held outdoors in a tent and it was amazing how much sound it puts out. You should also make sure the volume on your Ipod is up all the way, and that the volume is equalized from song to song.","Attachments":[],"Id":1158594,"PostDate":1274462237,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                We plan on using our portable Bose sound dock also. I'm glad to hear someone has used it and it worked well! We used it last year at a birthday party held outdoors in a tent and it was amazing how much sound it puts out. You should also make sure the volume on your Ipod is up all the way, and that the volume is equalized from song to song.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"shelley.schroeder@cox.net","IpAddress":"68.102.38.201","GroupId":40,"GroupName":"Jr. Member","JoinDate":1272494502,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-227734.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"greysgirl","Id":227734,"Name":"greysgirl","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50551,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a7a0d295ba44eacc77857fd0ef57a9a3","RawContent":"thanks so much for posting ladies, I only have a few months to go and am really thinking of getting the bose sound dock. The rental will be at least 2 or 300, so I might as well spend 400 and have speakers I can keep after, or sell after the wedding. I&#039;m worried they might be hard to carry, are they huge? I&#039;ll have to stop in at Bestbuy and check &#039;em out.","Attachments":[],"Id":1158643,"PostDate":1274463614,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                thanks so much for posting ladies, I only have a few months to go and am really thinking of getting the bose sound dock. The rental will be at least 2 or 300, so I might as well spend 400 and have speakers I can keep after, or sell after the wedding. I'm worried they might be hard to carry, are they huge? I'll have to stop in at Bestbuy and check 'em out.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jackie_cepcion@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1269030731,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-226591.jpg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"jackie_c","Id":226591,"Name":"jackie_c","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":50551,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9073611f740745d69148fb545d8e473f","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;jackie_c&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;thanks so much for posting ladies, I only have a few months to go and am really thinking of getting the bose sound dock. The rental will be at least 2 or 300, so I might as well spend 400 and have speakers I can keep after, or sell after the wedding. I&#039;m worried they might be hard to carry, are they huge? I&#039;ll have to stop in at Bestbuy and check &#039;em out.&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;It wasnt big at all, fit right in one of our carry on suite cases and just wrap a towel around it.","Attachments":[],"Id":1158739,"PostDate":1274466603,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>jackie_c<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">thanks so much for posting ladies, I only have a few months to go and am really thinking of getting the bose sound dock. The rental will be at least 2 or 300, so I might as well spend 400 and have speakers I can keep after, or sell after the wedding. I'm worried they might be hard to carry, are they huge? I'll have to stop in at Bestbuy and check 'em out.<\/div> <\/td> <\/tr> <\/table> <\/div>It wasnt big at all, fit right in one of our carry on suite cases and just wrap a towel around it.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"hahawryluk@hotmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1221055369,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-211661.JPG?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"dolfinluck","Id":211661,"Name":"dolfinluck","IsOnline":false}}],"Pages":{"TotalItems":33,"Tota