> Time: 1437473269 / Tue, 21 Jul 2015 10:07:49 +0000
> URL: /index.php?/REST/Forums/topic?startFromPostId=1899597&SessionId=c4b3ce90cf66f075d773a59273a156ae
> User jacquewedding (283943)
Request Time: 1 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":6,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":200,"MovedTo":null,"MovedOn":0,"FirstPostId":1899597,"Rating":0,"RatingHits":0,"Starter":{"Id":279902,"Name":"RivieraBride15","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1435740469,"LastPoster":{"Id":280992,"Name":"MissFrench","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280992.jpg?_r=1421507914","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":45,"Preview":{"Id":1899597,"PostDate":1435740469,"PostContent":"Good morning ladies!\u00a0  \u00a0 Was looking for your opinion on something.\u00a0 My hotel offers a mariachi b...","Author":{"Signature":"","Email":"erind285@gmail.com","IpAddress":"63.86.124.4","GroupId":39,"GroupName":"Newbie","JoinDate":1411109203,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"RivieraBride15","Id":279902,"Name":"RivieraBride15","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"63.86.124.4","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79336,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"af1c0eb45aa986c47e88de95d2b559b5","RawContent":"&lt;p&gt;&lt;span style=\"font-size:medium;\"&gt;&lt;span style=\"font-family:calibri;\"&gt;Good morning ladies!&amp;nbsp; &lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:medium;\"&gt;&lt;span style=\"font-family:calibri;\"&gt;Was looking for your opinion on something.&amp;nbsp; My hotel offers a mariachi band for 45 minutes and I think the cost was about $350.&amp;nbsp; I would love to include this in my wedding, which is going to be very small, &amp;nbsp;7-10 people.&amp;nbsp; Because of the small group, we are having a \u201csemi-private\u201d dinner; I think having the band there would be a little too overwhelming.&amp;nbsp; &lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-size:medium;\"&gt;&lt;span style=\"font-family:calibri;\"&gt;Do you think it would be odd, to have them play for a bit before I walk down the beach and then as my fianc\u00e9e and I are walking away after we are married?&amp;nbsp; I have my heart set on walking down the beach to one song, but didn\u2019t know if it would be weird to go from the band to that one song.&amp;nbsp; Maybe I am putting too much thought into it?&amp;nbsp; What do you guys think? &lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1899597,"PostDate":1435740469,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span  style=\"font-size:medium\"><span  style=\"font-family:calibri\">Good morning ladies!\u00a0 <\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-size:medium\"><span  style=\"font-family:calibri\">Was looking for your opinion on something.\u00a0 My hotel offers a mariachi band for 45 minutes and I think the cost was about $350.\u00a0 I would love to include this in my wedding, which is going to be very small, \u00a07-10 people.\u00a0 Because of the small group, we are having a \u201csemi-private\u201d dinner; I think having the band there would be a little too overwhelming.\u00a0 <\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-size:medium\"><span  style=\"font-family:calibri\">Do you think it would be odd, to have them play for a bit before I walk down the beach and then as my fianc\u00e9e and I are walking away after we are married?\u00a0 I have my heart set on walking down the beach to one song, but didn\u2019t know if it would be weird to go from the band to that one song.\u00a0 Maybe I am putting too much thought into it?\u00a0 What do you guys think? <\/span><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"erind285@gmail.com","IpAddress":"63.86.124.4","GroupId":39,"GroupName":"Newbie","JoinDate":1411109203,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"RivieraBride15","Id":279902,"Name":"RivieraBride15","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.146.146.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79336,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"dc20dc64ab1fb3a6e4d65cc42654ba4c","RawContent":"Congrats!\n\n\nMy only thought is that you get 45 mins in one shot, they may not break it up so as to be there before and after your ceremony. I&#039;d suggest they play after your ceremony. Maybe have a quick toast (depending what your resort package includes) and have them play. Is it possible to have them play over a cocktail hour? That&#039;s what we did, we had them play as people enjoyed some drinks.  That said I don&#039;t think it&#039;d be too overwhelming at your dinner either. Although you&#039;d have to double check at a semi private dinner they&#039;d be allowed. Just some ideas. Hope it helps some. \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1899622,"PostDate":1435751774,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Congrats!<br><br>\nMy only thought is that you get 45 mins in one shot, they may not break it up so as to be there before and after your ceremony. I'd suggest they play after your ceremony. Maybe have a quick toast (depending what your resort package includes) and have them play. Is it possible to have them play over a cocktail hour? That's what we did, we had them play as people enjoyed some drinks.  That said I don't think it'd be too overwhelming at your dinner either. Although you'd have to double check at a semi private dinner they'd be allowed. Just some ideas. Hope it helps some. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.85.127.174","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79336,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4af2398211cdf5a74c3957c28d5d79ff","RawContent":"&lt;p&gt;This reminds me... I get 45 minutes with my choice of a guitarist, violinist or saxophonist (included with my package). I haven&#039;t thought about what to do with this yet or which one I should choose. I guess it would make the most sense to use it at the cocktail hour. Any other suggestions? And I suppose choice of instrument is a just a personal thing. I don&#039;t know if I would go with the sax. I have a friend coming who is a professional sax player, so he might be offended ;) Sorry, that doesn&#039;t really help with your question... but I&#039;ll be watching to see if there are other suggestions.&lt;\/p&gt;","Attachments":[],"Id":1899624,"PostDate":1435754237,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>This reminds me... I get 45 minutes with my choice of a guitarist, violinist or saxophonist (included with my package). I haven't thought about what to do with this yet or which one I should choose. I guess it would make the most sense to use it at the cocktail hour. Any other suggestions? And I suppose choice of instrument is a just a personal thing. I don't know if I would go with the sax. I have a friend coming who is a professional sax player, so he might be offended <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/> Sorry, that doesn't really help with your question... but I'll be watching to see if there are other suggestions.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>- Erin<\/p>\n<p>\u00a0<\/p>\n<p>My planning thread:\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268'>http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268<\/a>","Email":"ekjzwedding@gmail.com","IpAddress":"24.85.127.174","GroupId":40,"GroupName":"Jr. Member","JoinDate":1417435045,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281283.jpg?_r=1428779369","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"vancouverpetunia","Id":281283,"Name":"vancouverpetunia","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"63.86.124.4","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79336,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"c0d7f0de2ab59bde960b256507c3d223","RawContent":"&lt;p&gt;@vancouverpetunia&amp;nbsp; Those are my options too.&amp;nbsp; I will have to see if they will split the time - All together I won&#039;t need them more than 45 minutes.&amp;nbsp; Next month, we start the actual planning with them, I would hate to bug them with questions this early.&amp;nbsp; But waiting until&amp;nbsp;3 months before is driving me crazy LOL&lt;\/p&gt;\n\n&lt;p&gt;Well, it was driving me crazy so I had to email them lol.  &amp;nbsp;They will split up my time as long as I don&#039;t go over the 45 minutes.&amp;nbsp; Which I won&#039;t do. :)&lt;\/p&gt;","Attachments":[],"Id":1899625,"PostDate":1435755361,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@vancouverpetunia\u00a0 Those are my options too.\u00a0 I will have to see if they will split the time - All together I won't need them more than 45 minutes.\u00a0 Next month, we start the actual planning with them, I would hate to bug them with questions this early.\u00a0 But waiting until\u00a03 months before is driving me crazy LOL<\/p>\n<br \/><p>Well, it was driving me crazy so I had to email them lol.\u00a0\u00a0\u00a0They will split up my time as long as I don't go over the 45 minutes.\u00a0 Which I won't do. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"erind285@gmail.com","IpAddress":"63.86.124.4","GroupId":39,"GroupName":"Newbie","JoinDate":1411109203,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"RivieraBride15","Id":279902,"Name":"RivieraBride15","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.146.146.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79336,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"25044af0056245a3f7e79a47c38f9461","RawContent":"[quote name=\"RivieraBride15\" post=\"1899625\" timestamp=\"1435769761\"]\n@[member=\"vancouverpetunia\"]  Those are my options too.  I will have to see if they will split the time - All together I won&#039;t need them more than 45 minutes.  Next month, we start the actual planning with them, I would hate to bug them with questions this early.  But waiting until 3 months before is driving me crazy LOL\n\nWell, it was driving me crazy so I had to email them lol.   They will split up my time as long as I don&#039;t go over the 45 minutes.  Which I won&#039;t do. :)[\/quote]Don&#039;t feel bad emailing them!! Just lump your questions together so you have less emails you are sending. That is what they are there for.  I&#039;m so glad they will split your time as most resorts seem pretty inflexible lol. So it all worked out, yay!!\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1899628,"PostDate":1435755580,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>RivieraBride15, on 01 July 2015 - 12:56 PM, said:<\/p><div class='blockquote'><div class='quote'><p>@<a hovercard-ref=\"member\" hovercard-id=\"281283\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281283-vancouverpetunia\/' title='Member profile'><span itemprop=\"name\">vancouverpetunia<\/span><\/a>  Those are my options too.  I will have to see if they will split the time - All together I won't need them more than 45 minutes.  Next month, we start the actual planning with them, I would hate to bug them with questions this early.  But waiting until 3 months before is driving me crazy LOL<br><br>\nWell, it was driving me crazy so I had to email them lol.   They will split up my time as long as I don't go over the 45 minutes.  Which I won't do. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p><\/div><\/div>\n<br>\nDon't feel bad emailing them!! Just lump your questions together so you have less emails you are sending. That is what they are there for.  I'm so glad they will split your time as most resorts seem pretty inflexible lol. So it all worked out, yay!!<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"76.119.165.154","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79336,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ec61706afb507bf553d7d606c871ef42","RawContent":"&lt;p&gt;Does your resort have a champagne toast on the beach after the ceremony?&amp;nbsp; This could be a fun way to incorporate the Mariachi and also make for some fun pictures!&amp;nbsp; It would almost be like a little cocktail hour and you could ask if the resort could keep the bubbly flowing while the Mariachi played for their 45 minutes.&amp;nbsp; Just a thought!&amp;nbsp; Good luck with the rest of your planning!!!&lt;\/p&gt;","Attachments":[],"Id":1900077,"PostDate":1436412242,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Does your resort have a champagne toast on the beach after the ceremony?\u00a0 This could be a fun way to incorporate the Mariachi and also make for some fun pictures!\u00a0 It would almost be like a little cocktail hour and you could ask if the resort could keep the bubbly flowing while the Mariachi played for their 45 minutes.\u00a0 Just a thought!\u00a0 Good luck with the rest of your planning!!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"candice.french@gmail.com","IpAddress":"24.62.169.169","GroupId":39,"GroupName":"Newbie","JoinDate":1415106695,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280992.jpg?_r=1421507914","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"MissFrench","Id":280992,"Name":"MissFrench","IsOnline":false}}],"Id":"79336","Title":"Use Of The Mariachi Band Question","LastPostDate":1436412242},"Pages":{"TotalItems":6,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
