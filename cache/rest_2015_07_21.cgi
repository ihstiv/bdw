ding.com\/topic\/79242-dj-app\/' class='bbc_url' title=''>http:\/\/www.bestdesti...c\/79242-dj-app\/<\/a><br><br>\nI haven't been able to get the app yet . Waiting to see if I can locate a used I pod just to use for the day! Hope that helps!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>57 Guest","Email":"racht33@yahoo.com","IpAddress":"192.249.47.212","GroupId":3,"GroupName":"Member","JoinDate":1422618588,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281952.jpg?_r=1424197509","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"racht33","Id":281952,"Name":"racht33","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.233.132.193","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79407,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5b0ca24263c600cd761c5c553c7a04fc","RawContent":"&lt;p&gt;Thanks @[member=\"racht33\"] !&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Keep me posted :)&lt;\/p&gt;","Attachments":[],"Id":1900762,"PostDate":1437389817,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thanks @<a hovercard-ref=\"member\" hovercard-id=\"281952\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281952-racht33\/' title='Member profile'><span itemprop=\"name\">racht33<\/span><\/a> !<\/p>\n<p>\u00a0<\/p>\n<p>Keep me posted <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"deannaproteau@hotmail.com","IpAddress":"207.134.141.162","GroupId":39,"GroupName":"Newbie","JoinDate":1421428169,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281751.jpg?_r=1435939613","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"deecol","Id":281751,"Name":"deecol","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79407,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"952c83be1d295c67c5101e44bc01fd00","RawContent":"&lt;p&gt;I&#039;ve also heard great things about the wedding DJ app. I don&#039;t have an iPhone myself, but I do have an iPad, so I think we are going to load that up with all the music and try it out! We aren&#039;t hiring a DJ so this is pretty much our only option at this point.&lt;\/p&gt;","Attachments":[],"Id":1900779,"PostDate":1437401910,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I've also heard great things about the wedding DJ app. I don't have an iPhone myself, but I do have an iPad, so I think we are going to load that up with all the music and try it out! We aren't hiring a DJ so this is pretty much our only option at this point.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":3,"GroupName":"Member","JoinDate":1419423414,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1436293677","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":false}}],"Id":"79407","Title":"Wedding Dj Apps?","LastPostDate":1437401910},"Pages":{"TotalItems":8,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
