":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279107.jpg?_r=1408932832","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"projecttwayne2015","Id":279107,"Name":"projecttwayne2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.112.200.126","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77915,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4983290d8988de07d2d2a4e7c0d6009c","RawContent":"&lt;p&gt;besides sparklers or fireworks I am not sure what else you can do.....&lt;\/p&gt;","Attachments":[],"Id":1870023,"PostDate":1409572817,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>besides sparklers or fireworks I am not sure what else you can do.....<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nadia.bozanich@gmail.com","IpAddress":"75.112.200.126","GroupId":40,"GroupName":"Jr. Member","JoinDate":1406722272,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"nadiakat17","Id":279229,"Name":"nadiakat17","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"69.253.224.84","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77915,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4857af6e4697dfc688d7e4453209c463","RawContent":"Something strategic I did was some if the resorts offer free fireworks on 4th of July, it usually costs $1500 a minute for them with a min of 3 minutes which is a lot, but having my wedding on that date allows us to get it for free!","Attachments":[],"Id":1870031,"PostDate":1409576394,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Something strategic I did was some if the resorts offer free fireworks on 4th of July, it usually costs $1500 a minute for them with a min of 3 minutes which is a lot, but having my wedding on that date allows us to get it for free! \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nicolechin4@yahoo.com","IpAddress":"68.87.42.110","GroupId":39,"GroupName":"Newbie","JoinDate":1407422509,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"JamaicaNicole","Id":279353,"Name":"JamaicaNicole","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"75.158.192.149","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77915,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"dd26743607b928ef14927cc6643c31cd","RawContent":"[quote name=\"JamaicaNicole\" post=\"1870031\" timestamp=\"1409590794\"]\nSomething strategic I did was some if the resorts offer free fireworks on 4th of July, it usually costs $1500 a minute for them with a min of 3 minutes which is a lot, but having my wedding on that date allows us to get it for free![\/quote]Smart!! [emoji1]","Attachments":[],"Id":1870032,"PostDate":1409576437,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>JamaicaNicole, on 01 September 2014 - 12:59 PM, said:<\/p><div class='blockquote'><div class='quote'><p>Something strategic I did was some if the resorts offer free fireworks on 4th of July, it usually costs $1500 a minute for them with a min of 3 minutes which is a lot, but having my wedding on that date allows us to get it for free!<\/p><\/div><\/div>\nSmart!! [emoji1]\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rsfortin@telus.net","IpAddress":"75.158.192.149","GroupId":40,"GroupName":"Jr. Member","JoinDate":1401786265,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Sara1603","Id":278220,"Name":"Sara1603","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"2.127.204.17","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77915,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,