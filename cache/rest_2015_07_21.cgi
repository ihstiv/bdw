b='nomediaparse' href=\"http:\/\/www.bestdestinationwedding.com\/t\/81510\/kaelas-rivieria-maya-planning-thread-3-1-13\">http:\/\/www.bestdestinationwedding.com\/t\/81510\/kaelas-rivieria-maya-planning-thread-3-1-13<\/a><\/div><\/div>","Email":"kaelahopkins1b@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1340298614,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-256983.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":269,"PhotoType":"custom"},"FormattedName":"mrsnova","Id":256983,"Name":"mrsnova","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":67667,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"48263e2e5bbd39448df0137d51d50eb7","RawContent":"[quote]\nOriginally Posted by [b]MsKenyaF[\/b] \/img\/forum\/go_quote.gif\n \n \n Absolutely beautiful!! I&#039;m getting tons of inspiration from your passport. Making me excited to start mines!! \n Did you print everything yourself? Also the passport cover, did you use a palm tree stamp? If so, where did you purchase it? Thx![\/quote] \n Thank you so much! To answer your questions I did print everything myself on just a regular printer.  The palm tree on the cover of our passports is actually our wedding monogram.  I ordered it from Creative Montage on Etsy for around $20 for the digital files of 5 monograms.  I&#039;ve attached it below :)  \n [img]http:\/\/www.bestdestinationwedding.com\/content\/type\/61\/id\/163645\/width\/350\/height\/700[\/img]","Attachments":[],"Id":1665036,"PostDate":1348142625,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verda