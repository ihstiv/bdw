Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":5,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":731,"MovedTo":null,"MovedOn":0,"FirstPostId":1898946,"Rating":0,"RatingHits":0,"Starter":{"Id":283625,"Name":"rebecca2122","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1434824615,"LastPoster":{"Id":258213,"Name":"LasCaletas","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-258213.jpeg?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":25,"Preview":{"Id":1898946,"PostDate":1434824615,"PostContent":"Hi: \u00a0 My fiance and I got engaged in October and we are planning a July 2016 destination wedding....","Author":{"Signature":"","Email":"becky2285@aol.com","IpAddress":"104.162.221.122","GroupId":39,"GroupName":"Newbie","JoinDate":1434823581,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"rebecca2122","Id":283625,"Name":"rebecca2122","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"104.162.221.122","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79297,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"54819d76744c9f3f5c68a3bfdf505ff4","RawContent":"&lt;p&gt;Hi:&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;My fiance and I got engaged in October and we are planning a July 2016 destination wedding. &amp;nbsp;I am new to this and have no experience with event planning, let alone destination planning. &amp;nbsp;My primary concern is finding a venue. &amp;nbsp;We are planning on having approximately 30 guests and I would greatly appreciate any suggestions. &amp;nbsp;Below is what I&#039;m looking for:&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;- anywhere in Mexico or the Carribbean (in reasonable distance from both NY and CA)&lt;\/p&gt;\n&lt;p&gt;- small, boutique resort with 100 rooms or less&lt;\/p&gt;\n&lt;p&gt;- non-touristy location (I&#039;m not interested in hotels located among strips of other hotels)&lt;\/p&gt;\n&lt;p&gt;- beach-front hotel&lt;\/p&gt;\n&lt;p&gt;- preferably with villas for some guests (i.e., beachfront standalone villa with direct access to the beach from the room)&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Any suggestions greatly appreciated.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;My secondary concern is finding a travel agent. &amp;nbsp;I&#039;ve read that I should have all guests book through one travel agent. &amp;nbsp;But, I have no idea how to find one or where to even begin my search. &amp;nbsp;I am in NYC, if that matters. &amp;nbsp;Again, any suggestions or places to start are most welcome.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thanks everyone.&lt;\/p&gt;","Attachments":[],"Id":1898946,"PostDate":1434824615,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi:<\/p>\n<p>\u00a0<\/p>\n<p>My fiance and I got engaged in October and we are planning a July 2016 destination wedding. \u00a0I am new to this and have no experience with event planning, let alone destination planning. \u00a0My primary concern is finding a venue. \u00a0We are planning on having approximately 30 guests and I would greatly appreciate any suggestions. \u00a0Below is what I'm looking for:<\/p>\n<p>\u00a0<\/p>\n<p>- anywhere in Mexico or the Carribbean (in reasonable distance from both NY and CA)<\/p>\n<p>- small, boutique resort with 100 rooms or less<\/p>\n<p>- non-touristy location (I'm not interested in hotels located among strips of other hotels)<\/p>\n<p>- beach-front hotel<\/p>\n<p>- preferably with villas for some guests (i.e., beachfront standalone villa with direct access to the beach from the room)<\/p>\n<p>\u00a0<\/p>\n<p>Any suggestions greatly appreciated.<\/p>\n<p>\u00a0<\/p>\n<p>My secondary concern is finding a travel agent. \u00a0I've read that I should have all guests book through one travel agent. \u00a0But, I have no idea how to find one or where to even begin my search. \u00a0I am in NYC, if that matters. \u00a0Again, any suggestions or places to start are most welcome.<\/p>\n<p>\u00a0<\/p>\n<p>Thanks everyone.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"becky2285@aol.com","IpAddress":"104.162.221.122","GroupId":39,"GroupName":"Newbie","JoinDate":1434823581,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"rebecca2122","Id":283625,"Name":"rebecca2122","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.15.187","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79297,"EditedBy":"","EditDate":1434839496,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0b6f89d46788fb7c824183e3b267f251","RawContent":"&lt;p&gt;Hi Rebecca,\n\n\nFirst of all congratulations and welcome to BDW!! You&#039;ve definitely come to the right place for planning information. I can almost guarantee that as far as experience I don&#039;t think there are very many of the brides to be here that have done wedding planning. I think we&#039;ve had a couple with some event planning experience but the majority are first timers just like yourself.\n\n\nThe best piece of advice I can give you is to contact the administrators of this site. They are destination wedding experts and I&#039;m sure they would be able to help you with suggestions or ideas with the criteria your looking for and they&#039;re CA based!! You can read reviews of their services here and see what other brides have had to say.\n\n\nYou can contact them through this site and I&#039;ve tried to past the link:\n\n&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;https:\/\/www.wrighttravelagency.com\/go\/destination-wedding?lp-variation-id=0&amp;amp;title=Planning%20a%20Destination%20Wedding?&amp;amp;source=BDW&amp;amp;creative=WTA%20TB&#039;&gt;https:\/\/www.wrighttravelagency.com\/go\/destination-wedding?lp-variation-id=0&amp;amp;title=Planning%20a%20Destination%20Wedding?&amp;amp;source=BDW&amp;amp;creative=WTA%20TB&lt;\/a&gt;\n\n\nGood luck!&lt;\/p&gt;","Attachments":[],"Id":1898949,"PostDate":1434831661,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Rebecca,<br><br>\nFirst of all congratulations and welcome to BDW!! You've definitely come to the right place for planning information. I can almost guarantee that as far as experience I don't think there are very many of the brides to be here that have done wedding planning. I think we've had a couple with some event planning experience but the majority are first timers just like yourself.<br><br>\nThe best piece of advice I can give you is to contact the administrators of this site. They are destination wedding experts and I'm sure they would be able to help you with suggestions or ideas with the criteria your looking for and they're CA based!! You can read reviews of their services here and see what other brides have had to say.<br><br>\nYou can contact them through this site and I've tried to past the link:<br><br><a href='https:\/\/www.wrighttravelagency.com\/go\/destination-wedding?lp-variation-id=0&title=Planning%20a%20Destination%20Wedding?&source=BDW&creative=WTA%20TB' class='bbc_url' title='External link' rel='nofollow external'>https:\/\/www.wrighttr...creative=WTA TB<\/a><br><br>\nGood luck!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><em><span style=\"color:rgb(51,153,255);\">I'm lucky enough to\u00a0tell my husband how much I love him and say yes again\u00a0on October 20, 2015 at Grand Coral Beach Club!\u00a0<\/span><\/em>","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283444599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.85.127.174","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79297,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"773e543b11d02432a41b3ba1da6e0cf8","RawContent":"@[member=\"rebecca2122\"] I would definitely contact a travel agent (or even a few) to have them help you narrow down the resorts based on your criteria. Also having a budget for your guests (i.e. how much per night, etc.) may help. Are you thinking all inclusive? It&#039;s important to clarify that as well (or realize that the options can be quite different if you want to consider both). Unfortunately I don&#039;t have any TA recommendations for you, but certainly the ladies here seem to be happy working with Wright Travel. There should be other TA reviews for you to check out as well. Good luck!\n\n\n\nSent from my iPhone using Tapatalk\nP.S. Personally I don&#039;t think it matters where your TA is located (other than the same country). Although mine is fairly local to me, we&#039;ve never met in person and I don&#039;t think it&#039;s been an issue. \n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1898954,"PostDate":1434839129,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @<a hovercard-ref=\"member\" hovercard-id=\"283625\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/283625-rebecca2122\/' title='Member profile'><span itemprop=\"name\">rebecca2122<\/span><\/a> I would definitely contact a travel agent (or even a few) to have them help you narrow down the resorts based on your criteria. Also having a budget for your guests (i.e. how much per night, etc.) may help. Are you thinking all inclusive? It's important to clarify that as well (or realize that the options can be quite different if you want to consider both). Unfortunately I don't have any TA recommendations for you, but certainly the ladies here seem to be happy working with Wright Travel. There should be other TA reviews for you to check out as well. Good luck!<br><br><br>\nSent from my iPhone using Tapatalk<br \/>P.S. Personally I don't think it matters where your TA is located (other than the same country). Although mine is fairly local to me, we've never met in person and I don't think it's been an issue. <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>- Erin<\/p>\n<p>\u00a0<\/p>\n<p>My planning thread:\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268'>http:\/\/www.bestdestinationwedding.com\/topic\/79068-vancouverpetunia-now-sapphire-april-7-2016\/?p=1893268<\/a>","Email":"ekjzwedding@gmail.com","IpAddress":"24.85.127.174","GroupId":40,"GroupName":"Jr. Member","JoinDate":1417435045,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281283.jpg?_r=1428779369","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"vancouverpetunia","Id":281283,"Name":"vancouverpetunia","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.179.187.201","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79297,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"8ebf7a9a8419f2059d9a35616857c8c2","RawContent":"Check out the cliffs area of Negri in Jamaica! There are some amazing boutique hotels with villa options that we looked at, they just weren&#039;t quite right die what we needed but I want to go back and vacation there!","Attachments":[],"Id":1899017,"PostDate":1434934509,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Check out the cliffs area of Negri in Jamaica! There are some amazing boutique hotels with villa options that we looked at, they just weren't quite right die what we needed but I want to go back and vacation there! \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"rebecca.shaffer@gmail.com","IpAddress":"159.53.174.144","GroupId":3,"GroupName":"Member","JoinDate":1403101687,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"beckys98","Id":278581,"Name":"beckys98","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"201.116.201.71","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79297,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d0bf2a8742c0128409d8cbf444e9dab9","RawContent":"&lt;p&gt;&lt;span style=\"font-family:tahoma, geneva, sans-serif;\"&gt;&lt;span style=\"font-size:12px;\"&gt;Hi @[member=\"rebecca2122\"]&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-family:tahoma, geneva, sans-serif;\"&gt;&lt;span style=\"font-size:12px;\"&gt;&lt;span style=\"color:#282828;\"&gt;Congratulations on your engagement!!\n\n\nWelcome you to the best destination wedding site, you will find lots of information regarding wedding venues , details, etc... And as you will see girls really do share a lot of advice.&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-family:tahoma, geneva, sans-serif;\"&gt;&lt;span style=\"font-size:12px;\"&gt;&lt;span style=\"color:#282828;\"&gt;If you&#039;d like to you can visit our website&amp;nbsp;www.adventureweddingsvallarta.com&amp;nbsp;and check out our wedding packages, we have a beautiful private beach called Las Caletas in Puerto Vallarta, Mexico, where we make the magic happen with an amazing view and an awesome setting for your ceremony.\n\n\nIf you want to speak with a sales agent for further assistance feel free to contact us at toll free 1.866.731.8152 or e-mail us to info@adventureweddingsvallarta.com&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;div&gt;[sharedmedia=gallery:images:79041]&lt;\/div&gt;\n&lt;div&gt;&amp;nbsp;&lt;\/div&gt;\n&lt;p&gt;&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.adventureweddingsvallarta.com\/&#039;&gt;&lt;strong&gt;&lt;span style=\"color:#548dd4;\"&gt;&lt;span style=\"font-family:garamond, serif;\"&gt;&lt;span style=\"font-size:10.5pt;\"&gt;www.adventureweddingsvallarta.com&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;&lt;span style=\"color:#548dd4;\"&gt;&lt;span style=\"font-family:garamond, serif;\"&gt;&lt;span style=\"font-size:10.5pt;\"&gt;Toll Free: 1 866.731.8152&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;&lt;span style=\"color:#548dd4;\"&gt;&lt;span style=\"font-family:garamond, serif;\"&gt;&lt;span style=\"font-size:10.5pt;\"&gt;Phone: +52 (322) 297.1212 ext. 1468&lt;\/span&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/strong&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"font-family:arial, sans-serif;\"&gt;&lt;span style=\"font-size:9.5pt;\"&gt;&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt;","Attachments":[],"Id":1899038,"PostDate":1434976615,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span  style=\"font-family:tahoma, geneva, sans-serif\"><span  style=\"font-size:12px\">Hi @<a hovercard-ref=\"member\" hovercard-id=\"283625\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/index.phpuser\/283625-rebecca2122\/' title='Member profile'><span itemprop=\"name\">rebecca2122<\/span><\/a><\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<p><span  style=\"font-family:tahoma, geneva, sans-serif\"><span  style=\"font-size:12px\"><span  style=\"color:#282828\">Congratulations on your engagement!!<br><br>\nWelcome you to the best destination wedding site, you will find lots of information regarding wedding venues , details, etc... And as you will see girls really do share a lot of advice.<\/span><\/span><\/span><\/p>\n<p><span  style=\"font-family:tahoma, geneva, sans-serif\"><span  style=\"font-size:12px\"><span  style=\"color:#282828\">If you'd like to you can visit our website\u00a0www.adventureweddingsvallarta.com\u00a0and check out our wedding packages, we have a beautiful private beach called Las Caletas in Puerto Vallarta, Mexico, where we make the magic happen with an amazing view and an awesome setting for your ceremony.<br><br>\nIf you want to speak with a sales agent for further assistance feel free to contact us at toll free 1.866.731.8152 or e-mail us to info@adventureweddingsvallarta.com<\/span><\/span><\/span><\/p>\n<p>\u00a0<\/p>\n<div><!-- bbcodeImage-js (do not remove or edit this tag) -->\n<a href='http:\/\/www.bestdestinationwedding.com\/index.phpgallery\/image\/79041-veil\/' class='bbc_url' title=''><img src='http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/gallery\/album_17896\/sml_gallery_258213_17896_4476.jpg' class='galattach galimageview sharedmedia_screenshot' title='veil'  width='200' height='134'  alt='veil' id='sml_image_view_79041' \/><\/a>\n<br \/><\/div>\n<div>\u00a0<\/div>\n<p><a href='http:\/\/www.adventureweddingsvallarta.com\/' class='bbc_url' title='External link' rel='nofollow external'><strong><span  style=\"color:#548dd4\"><span  style=\"font-family:garamond, serif\"><span  style=\"font-size:10.5pt\">www.adventureweddingsvallarta.com<\/span><\/span><\/span><\/strong><\/a><\/p>\n<p><strong><span  style=\"color:#548dd4\"><span  style=\"font-family:garamond, serif\"><span  style=\"font-size:10.5pt\">Toll Free: 1 866.731.8152<\/span><\/span><\/span><\/strong><\/p>\n<p><strong><span  style=\"color:#548dd4\"><span  style=\"font-family:garamond, serif\"><span  style=\"font-size:10.5pt\">Phone: +52 (322) 297.1212 ext. 1468<\/span><\/span><\/span><\/strong><\/p>\n<p><span  style=\"font-family:arial, sans-serif\"><span  style=\"font-size:9.5pt\"><\/span><\/span><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"dennise@adventureweddingsvallarta.com","IpAddress":"187.146.166.254","GroupId":49,"GroupName":"Insiders","JoinDate":1343044403,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-258213.jpeg?_r=0","PhotoWidth":100,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"LasCaletas","Id":258213,"Name":"LasCaletas","IsOnline":false}}],"Id":"79297","Title":"Destination Wedding Help","LastPostDate":1434976615},"Pages":{"TotalItems":5,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
