Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":1,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":354,"MovedTo":null,"MovedOn":0,"FirstPostId":1890210,"Rating":0,"RatingHits":0,"Starter":{"Id":281796,"Name":"Sandraco8","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1426882852,"LastPoster":{"Id":281796,"Name":"Sandraco8","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":23,"Preview":{"Id":1890210,"PostDate":1426882852,"PostContent":"Hello - I am getting married at the Hilton Rose hall on Ocober 9, 2015.  We are taking our 1st tr...","Author":{"Signature":"","Email":"sandra_co8@icloud.com","IpAddress":"50.162.188.193","GroupId":39,"GroupName":"Newbie","JoinDate":1421707270,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Sandraco8","Id":281796,"Name":"Sandraco8","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.196.44.37","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":78962,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"30710d272525eec2453fcfa6b93408e1","RawContent":"Hello - I am getting married at the Hilton Rose hall on Ocober 9, 2015.  We are taking our 1st trip to Jamaica next month.  Yes we committed before seeing it :)\n\n\nHas anyone toured the Hilton, seen a wedding there or planned one?  Based on what I am reading there may be many surprise costs once we start planning the reception.\n\n\nFor the sake of being proactive I&#039;ve been in contact with Day O Plantation and their communication and pricing seem excellent.  Has anyone been there or held a reception there?  Also, any thoughts on having your ceremony in one place then busing everyone to a 2nd location for the dinner and party?\n\n\nCan&#039;t wait to finally see these locations in a few weeks but definitely want to be prepared to make decisions!  Thanks ladies!","Attachments":[],"Id":1890210,"PostDate":1426882852,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hello - I am getting married at the Hilton Rose hall on Ocober 9, 2015.  We are taking our 1st trip to Jamaica next month.  Yes we committed before seeing it <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><br><br>\nHas anyone toured the Hilton, seen a wedding there or planned one?  Based on what I am reading there may be many surprise costs once we start planning the reception.<br><br>\nFor the sake of being proactive I've been in contact with Day O Plantation and their communication and pricing seem excellent.  Has anyone been there or held a reception there?  Also, any thoughts on having your ceremony in one place then busing everyone to a 2nd location for the dinner and party?<br><br>\nCan't wait to finally see these locations in a few weeks but definitely want to be prepared to make decisions!  Thanks ladies!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sandra_co8@icloud.com","IpAddress":"50.162.188.193","GroupId":39,"GroupName":"Newbie","JoinDate":1421707270,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Sandraco8","Id":281796,"Name":"Sandraco8","IsOnline":false}}],"Id":"78962","Title":"Hilton Rose Hall Or Day O Plantation Feedback","LastPostDate":1426882852},"Pages":{"TotalItems":1,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
