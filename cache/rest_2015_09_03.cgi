        width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I sent a PM re: the tumblers but not sure if it went through. \u00a0Please let me know if you didn't get it. \u00a0<img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/> \u00a0Thanks!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cassie@goforthtech.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1330185539,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-251921.jpeg?_r=0","PhotoWidth":141,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"cascole","Id":251921,"Name":"cascole","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":66283,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"105d410f624133be98967f36fc5458d0","RawContent":"I would like 11OOT bags and 7 tumblers. Can you quite me a price and contact me at eboniealexander@yahoo.com","Attachments":[],"Id":1607655,"PostDate":1334452163,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I would like 11OOT bags and 7 tumblers. Can you quite me a price and contact me at eboniealexander@yahoo.com\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Emai