{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":13,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":1238,"MovedTo":null,"MovedOn":0,"FirstPostId":1591684,"Rating":0,"RatingHits":0,"Starter":{"Id":251596,"Name":"kenzarella","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-251596.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"StartDate":1331139670,"LastPoster":{"Id":283939,"Name":"sadiekirby93","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283939.jpg?_r=1438893746","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":98,"Preview":{"Id":1591684,"PostDate":1331139670,"PostContent":"I originally planned my wedding for June 2012 in Mexico.\u00a0 After putting a lot of thought and wor...","Author":{"Signature":"","Email":"kenzi.pullin@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1329604476,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-251596.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"kenzarella","Id":251596,"Name":"kenzarella","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":66283,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"4119ffb2df7287781c1cfe7a5820feb8","RawContent":"&lt;p&gt; &lt;span style=\"font-family:calibri;\"&gt;I originally planned my wedding for June 2012 in Mexico.&amp;nbsp; After putting a lot of thought and work into the wedding, we decided to push it back a year.&amp;nbsp; My colors were coral, black, and grey.&amp;nbsp; I have tulle and ribbon, Adirondack chair cake toppers, out of town bags, two kinds of favor cups, and hangover kit containers for sale.&amp;nbsp; I can\u00e2\u20ac\u2122t split up any of the items into smaller quantities.&amp;nbsp; Shipping is from Northwest Indiana.&amp;nbsp; Please PM me if interested!&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;strong&gt;&lt;span style=\"font-family:calibri;\"&gt;Bouquet Brooch Accessories-&lt;\/span&gt;&lt;\/strong&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-family:calibri;\"&gt;I started collecting brooches and earrings to use in my bouquet.&amp;nbsp; All of the pieces are really sparkly!&amp;nbsp; I have 2 pairs of earrings and three brooches.&amp;nbsp; Wire can be wrapped around the pieces to attach to a bouquet.&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-family:calibri;\"&gt;I paid $30 for the pieces individually.&amp;nbsp; I will sell for $20.&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;strong&gt;&lt;span style=\"font-family:calibri;\"&gt;Tulle and Ribbon-&lt;\/span&gt;&lt;\/strong&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-family:calibri;\"&gt;Brand new spools of tulle and ribbon! &amp;nbsp;The tulle is coral and 6\" wide and 25 yards long. &amp;nbsp;It would be great tied to chairs during an outdoor ceremony. &amp;nbsp;The ribbon is 1 spool of black and 1 spool of coral. &amp;nbsp;It measures 5\/8\" by 100 yards.&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-family:calibri;\"&gt;Tulle is $1.00 per roll.&amp;nbsp; Ribbon is $4.00 per roll.&amp;nbsp; I originally paid $25.00.&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;strong&gt;&lt;span style=\"font-family:calibri;\"&gt;Cake Topper-&lt;\/span&gt;&lt;\/strong&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-family:calibri;\"&gt;I bought two white Adriondack chairs to use as cake toppers.&amp;nbsp; They are approximately 4 inches tall.&amp;nbsp; I also have 2\u00e2\u20ac\u009d x 18\u00e2\u20ac\u009d fence to be used as cake decoration.&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-family:calibri;\"&gt;I paid $25.&amp;nbsp; I will accept $15.&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;strong&gt;&lt;span style=\"font-family:calibri;\"&gt;OOT Bags-&lt;\/span&gt;&lt;\/strong&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-family:calibri;\"&gt;I have 31 really nice bags that I bought to use as out of town bags for our guests.&amp;nbsp; They are made of thick canvas material and have sturdy straps and an outside pocket.&amp;nbsp; The bags measure 16.5\u00e2\u20ac\u009d tall x 13.25\u00e2\u20ac\u009d wide x 5.25\u00e2\u20ac\u009d deep.&amp;nbsp; They have clear tags attached to them for customization.&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-family:calibri;\"&gt;I paid $250 dollars for the bags.&amp;nbsp; I am willing to sell them for $100.&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;strong&gt;&lt;span style=\"font-family:calibri;\"&gt;Hangover Kit Tins-&lt;\/span&gt;&lt;\/strong&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-family:calibri;\"&gt;I also have hinged metal containers that I planned to use as hangover kits.&amp;nbsp; They are 4.25\u00e2\u20ac\u009d x 3.1\u00e2\u20ac\u009d x 1\u00e2\u20ac\u009d.&amp;nbsp; They will fit individual packs of gum, aspirin, antacids, and bandages.&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-family:calibri;\"&gt;I paid $50 for the containers.&amp;nbsp; I will accept $30.&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;strong&gt;&lt;span style=\"font-family:calibri;\"&gt;Cups and Mugs-&lt;\/span&gt;&lt;\/strong&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"font-family:calibri;\"&gt;I also purchased clear plastic insulated tumbler cups.&amp;nbsp; They have straws and will hold 16 oz. of fluids.&amp;nbsp; They measure &lt;\/span&gt;&lt;span style=\"color:#262626;\"&gt;&lt;span style=\"font-family:calibri;\"&gt;6 1\/4\" tall x 4\" at the top and 2 1\/2\" at the base.&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"color:#262626;\"&gt;&lt;span style=\"font-family:calibri;\"&gt;Originally bought them for $120.&amp;nbsp; I have 22 for sale and will take $44.&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"color:#262626;\"&gt;&lt;span style=\"font-family:calibri;\"&gt;I also have 15 travel mugs for sale.&amp;nbsp; They can be customized by inserting paper between the outer shell and inner lining.&amp;nbsp; These mugs have handles and will hold 16 oz. of fluid.&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;p&gt; &lt;span style=\"color:#262626;\"&gt;&lt;span style=\"font-family:calibri;\"&gt;Originally bought them for $120.&amp;nbsp; I will sell for $30.&lt;\/span&gt;&lt;\/span&gt;&lt;\/p&gt; &lt;div id=\"CLSCRIPT_communicationDiv\"&gt; &amp;nbsp;&lt;\/div&gt; &lt;div id=\"myEventWatcherDiv\" style=\"display:none;\"&gt; &amp;nbsp;&lt;\/div&gt;","Attachments":[],"Id":1591684,"PostDate":1331139670,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <span  style=\"font-family:calibri\">I originally planned my wedding for June 2012 in Mexico.\u00a0 After putting a lot of thought and work into the wedding, we decided to push it back a year.\u00a0 My colors were coral, black, and grey.\u00a0 I have tulle and ribbon, Adirondack chair cake toppers, out of town bags, two kinds of favor cups, and hangover kit containers for sale.\u00a0 I can\u00e2\u20ac\u2122t split up any of the items into smaller quantities.\u00a0 Shipping is from Northwest Indiana.\u00a0 Please PM me if interested!<\/span><\/p> <p> \u00a0<\/p> <p> <strong><span  style=\"font-family:calibri\">Bouquet Brooch Accessories-<\/span><\/strong><\/p> <p> <span  style=\"font-family:calibri\">I started collecting brooches and earrings to use in my bouquet.\u00a0 All of the pieces are really sparkly!\u00a0 I have 2 pairs of earrings and three brooches.\u00a0 Wire can be wrapped around the pieces to attach to a bouquet.<\/span><\/p> <p> <span  style=\"font-family:calibri\">I paid $30 for the pieces individually.\u00a0 I will sell for $20.<\/span><\/p> <p> \u00a0<\/p> <p> <strong><span  style=\"font-family:calibri\">Tulle and Ribbon-<\/span><\/strong><\/p> <p> <span  style=\"font-family:calibri\">Brand new spools of tulle and ribbon! \u00a0The tulle is coral and 6\" wide and 25 yards long. \u00a0It would be great tied to chairs during an outdoor ceremony. \u00a0The ribbon is 1 spool of black and 1 spool of coral. \u00a0It measures 5\/8\" by 100 yards.<\/span><\/p> <p> <span  style=\"font-family:calibri\">Tulle is $1.00 per roll.\u00a0 Ribbon is $4.00 per roll.\u00a0 I originally paid $25.00.<\/span><\/p> <p> \u00a0<\/p> <p> <strong><span  style=\"font-family:calibri\">Cake Topper-<\/span><\/strong><\/p> <p> <span  style=\"font-family:calibri\">I bought two white Adriondack chairs to use as cake toppers.\u00a0 They are approximately 4 inches tall.\u00a0 I also have 2\u00e2\u20ac\u009d x 18\u00e2\u20ac\u009d fence to be used as cake decoration.<\/span><\/p> <p> <span  style=\"font-family:calibri\">I paid $25.\u00a0 I will accept $15.<\/span><\/p> <p> \u00a0<\/p> <p> <strong><span  style=\"font-family:calibri\">OOT Bags-<\/span><\/strong><\/p> <p> <span  style=\"font-family:calibri\">I have 31 really nice bags that I bought to use as out of town bags for our guests.\u00a0 They are made of thick canvas material and have sturdy straps and an outside pocket.\u00a0 The bags measure 16.5\u00e2\u20ac\u009d tall x 13.25\u00e2\u20ac\u009d wide x 5.25\u00e2\u20ac\u009d deep.\u00a0 They have clear tags attached to them for customization.<\/span><\/p> <p> <span  style=\"font-family:calibri\">I paid $250 dollars for the bags.\u00a0 I am willing to sell them for $100.<\/span><\/p> <p> \u00a0<\/p> <p> <strong><span  style=\"font-family:calibri\">Hangover Kit Tins-<\/span><\/strong><\/p> <p> <span  style=\"font-family:calibri\">I also have hinged metal containers that I planned to use as hangover kits.\u00a0 They are 4.25\u00e2\u20ac\u009d x 3.1\u00e2\u20ac\u009d x 1\u00e2\u20ac\u009d.\u00a0 They will fit individual packs of gum, aspirin, antacids, and bandages.<\/span><\/p> <p> <span  style=\"font-family:calibri\">I paid $50 for the containers.\u00a0 I will accept $30.<\/span><\/p> <p> \u00a0<\/p> <p> <strong><span  style=\"font-family:calibri\">Cups and Mugs-<\/span><\/strong><\/p> <p> <span  style=\"font-family:calibri\">I also purchased clear plastic insulated tumbler cups.\u00a0 They have straws and will hold 16 oz. of fluids.\u00a0 They measure <\/span><span  style=\"color:#262626\"><span  style=\"font-family:calibri\">6 1\/4\" tall x 4\" at the top and 2 1\/2\" at the base.<\/span><\/span><\/p> <p> <span  style=\"color:#262626\"><span  style=\"font-family:calibri\">Originally bought them for $120.\u00a0 I have 22 for sale and will take $44.<\/span><\/span><\/p> <p> \u00a0<\/p> <p> <span  style=\"color:#262626\"><span  style=\"font-family:calibri\">I also have 15 travel mugs for sale.\u00a0 They can be customized by inserting paper between the outer shell and inner lining.\u00a0 These mugs have handles and will hold 16 oz. of fluid.<\/span><\/span><\/p> <p> <span  style=\"color:#262626\"><span  style=\"font-family:calibri\">Originally bought them for $120.\u00a0 I will sell for $30.<\/span><\/span><\/p> <div id=\"CLSCRIPT_communicationDiv\"> \u00a0<\/div> <div id=\"myEventWatcherDiv\"  style=\"display:none\"> \u00a0<\/div>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kenzi.pullin@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1329604476,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-251596.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"kenzarella","Id":251596,"Name":"kenzarella","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":66283,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a599937f7a8e28b4571edb18b24ca191","RawContent":"&lt;p&gt; I am interested in the 15 travel mugs and maybe the brooches as well. I can get it shipped to Vancouver, Canada or Blaine Washington. PM me!&lt;\/p&gt;","Attachments":[],"Id":1594144,"PostDate":1331646198,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I am interested in the 15 travel mugs and maybe the brooches as well. I can get it shipped to Vancouver, Canada or Blaine Washington. PM me!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"bethellen.webster@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1312396598,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-243199.jpg?_r=0","PhotoWidth