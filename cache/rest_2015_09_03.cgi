\"color:rgb(40,40,40);font-family:'Bitstream Vera Serif', 'Times New Roman', serif;font-size:medium;\">6 - 20 inch lavender ($1)<\/span><br><span  style=\"color:rgb(40,40,40);font-family:'Bitstream Vera Serif', 'Times New Roman', serif;font-size:medium;\">7 - 20 inch fuschia ($1)<\/span><br><span  style=\"color:rgb(40,40,40);font-family:'Bitstream Vera Serif', 'Times New Roman', serif;font-size:medium;\">5 - 24 inch dark purple ($1.5)<\/span><br><span  style=\"color:rgb(40,40,40);font-family:'Bitstream Vera Serif', 'Times New Roman', serif;font-size:medium;\">6 - 24 inch grass green ($1.5)<\/span><\/p>\n<div><a class='resized_img' rel='lightbox[1879204]' id='ipb-attach-url-30101-0-97582700-1441015534' href=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_11_2014\/post-252756-0-81810900-1417046755.jpg\" title=\"lanterns4-large.jpg - Size: 74.22KB\"><span rel='lightbox'><img class='bbc_img' itemprop=\"image\" src=\"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_11_2014\/post-252756-0-81810900-1417046755_thumb.jpg\" id='ipb-attach-img-30101-0-97582700-1441015534' style='width:150;height:113' class='attach' width=\"150\" height=\"113\" alt=\"lanterns4-large.jpg\" \/><\/span><\/a>\n<\/div>\n<p>\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"shellaswain@hotmail.com","IpAddress":"75.151.125.92","GroupId":39,"GroupName":"Newbie","JoinDate":1331765076,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-252756.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Sheesh19","Id":252756,"Name":"Sheesh19","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.87.237.180","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79212,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"