toHeight":200,"PhotoType":"custom"},"FormattedName":"deecol","Id":281751,"Name":"deecol","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.146.146.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79551,"EditedBy":"<strong>Edited by calgarybride2015, 31 August 2015 - 01:14 PM.<\/strong>","EditDate":1441055677,"EditReason":"","DeleteDate":0,"TotalLikes":3,"IsLiked":false,"PostKey":"1087970ad2cae09adfffa899ddb0fceb","RawContent":"Congrats on 4 years!! Love the idea you ladies came up with.  \n\n\nEdit - I had to edit out my idea because I don&#039;t know your humor well enough yet hehehe. \n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1903802,"PostDate":1441055639,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Congrats on 4 years!! Love the idea you ladies came up with.  <br><br>\nEdit - I had to edit out my idea because I don't know your humor well enough yet hehehe. <br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399428602,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"209.171.88.5","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79551,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"4bbcae735cce83a0167bb80011345865","RawContent":"Thank you :)  Hahaha I think I know what you were leaning towards and I&#039;m def on the same wavelength haha\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1903808,"PostDate":1441063150,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Thank you <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>  Hahaha I think I know what you were leaning towards and I'm def on the same wavelength haha<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div><img src=\"http:\/\/\" alt=\"\"><\/div>\n<p>\u00a0","Email":"deannaproteau@hotmail.com","IpAddress":"207.134.141.162","GroupId":40,"GroupName":"Jr. Member","JoinDate":1421442569,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281751.jpg?_r=1439851759","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"deecol","Id":281751,"Name":"deecol","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.12.21","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79551,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":3,"IsLiked":false,"PostKey":"5c9eba5a21c1eb4681caf4dc4ff85b92","RawContent":"&lt;p&gt;A little whipped cream to dip would be..... nice too!! Oh and Godiva makes scrumptious chocolate covered strawberries, fresh every day! Both white and dark. Delice!!&lt;\/p&gt;","Attachments":[],"Id":1903811,"PostDate":1441067294,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>A little whipped cream to dip would be..... nice too!! Oh and Godiva makes scrumptious chocolate covered strawberries, fresh every day! Both white and dark. Delice!!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283458999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"200.79.251.123","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79551,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"52919369ae0f03b0efdccb33267c2680","RawContent":"[quote name=\"deecol\" post=\"1903778\" timestamp=\"1441040562\"]\nHi Ladies,\n\nI&#039;ve left it a bit late... too much going on.\n\nOur 4 year dating anniversary is [u][b]tomorrow[\/b][\/u] (Sept 1st) and it&#039;s our last anniversary before we are married  :)\n\nWe&#039;re going to go for dinner in a couple of weeks when our schedules clear up a bit but I&#039;d like to do a little something for him on the day.  Did anyone do anything special or have any ideas on something last minute I can do?  He works the late shift and won&#039;t be home until around 8.30pm tomorrow - so maybe make a dessert and have some candles around or something?  Something nice for him to come home to?  eeee HELP![\/quote]@[member=\"deecol\"] congrats on your anniversary,  hmm love all the ideas.  you could also add some cute note for him to find in his lunch \/dinner at work.  \n\nor a 30 min relaxing massage that you could give him at home, once he is back from work. then the strawberry dipped in choc and champagne . candle light.\n\nHappy Anniversary ;)","Attachments":[],"Id":1903826,"PostDate":1441076352,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>deecol, on 31 August 2015 - 09:02 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hi Ladies,<\/p>\n<p>\u00a0<\/p>\n<p>I've left it a bit late... too much going on.<\/p>\n<p>\u00a0<\/p>\n<p>Our 4 year dating anniversary is <u><strong>tomorrow<\/strong><\/u>\u00a0(Sept 1st) and it's our last anniversary before we are married\u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>We're going to go for dinner in a couple of weeks when our schedules clear up a bit but I'd like to do a little something for him on the day. \u00a0Did anyone do anything special or have any ideas on something last minute I can do? \u00a0He works the late shift and won't be home until around 8.30pm tomorrow - so maybe make a dessert and have some candles around or something? \u00a0Something nice for him to come home to? \u00a0eeee HELP!<\/p>\n<\/div>\n<\/div><\/div>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"281751\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281751-deecol\/' title='Member profile'><span itemprop=\"name\">deecol<\/span><\/a> congrats on your anniversary, \u00a0hmm love all the ideas. \u00a0you could also add some cute note for him to find in his lunch \/dinner at work. \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>or a 30 min relaxing massage that you could give him at home, once he is back from work. then the strawberry dipped in choc and champagne . candle light.<\/p>\n<p>\u00a0<\/p>\n<p>Happy Anniversary <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/wink.png' class='bbc_emoticon' alt=';)' \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Dream Weddings Riviera Maya- We pay attention to your wishes and coordinate closely with you to ensure your wedding or event is planned to perfection!<\/p>\n<p>\u00a0<\/p>\n<p><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Dream Weddings Riviera Maya<\/span><\/span><\/span><br><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">weddingsinplayadelcarmen@gmail.com<\/span><\/span><\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html'>http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html<\/a><\/p>\n<p>\u00a0<\/p>\n<p><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Happy Planning!<\/span><\/span><\/span><br><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Joyce<\/span><\/span><\/span><br>\n\u00a0","Email":"weddingsinplayadelcarmen@gmail.com","IpAddress":"187.252.44.28","GroupId":49,"GroupName":"Insiders","JoinDate":1326854387,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250090.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"dreamweddings","Id":250090,"Name":"dreamweddings","IsOnline":false}}],"Id":"79551","Title":"Last Anniversary Before Saying I Do","LastPostDate":1441290821},"Pages":{"TotalItems":30,"TotalPages":3,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":20},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
