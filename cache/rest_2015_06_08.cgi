ture":"","Email":"limaldo96@gmail.com","IpAddress":"68.196.202.228","GroupId":40,"GroupName":"Jr. Member","JoinDate":1406480117,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279182.jpg?_r=1406769983","PhotoWidth":200,"PhotoHeight":168,"PhotoType":"custom"},"FormattedName":"Lia33","Id":279182,"Name":"Lia33","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.118.27.209","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77073,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c458852de0f7e42b6e3e6d69aa94a0bc","RawContent":"&lt;p&gt;maybe try ebay ??&lt;\/p&gt;","Attachments":[],"Id":1884911,"PostDate":1422874182,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>maybe try ebay ??<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"svasdani@gmail.com","IpAddress":"174.118.27.209","GroupId":39,"GroupName":"Newbie","JoinDate":1420663861,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"babykuki","Id":281633,"Name":"babykuki","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.62.169.169","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77073,"EditedBy":"","EditDate":1423412977,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"ab82ce32ab175a1f41c12f80484f3e38","RawContent":"&lt;p&gt;We&#039;re doing custom leather luggage tags that I found on ebay. &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.ebay.com\/itm\/25-WHITE-Genuine-leather-wedding-escort-luggage-tags-2-00-each-\/151419037361?pt=LH_DefaultDomain_0&amp;amp;hash=item23414726b1&#039;&gt;http:\/\/www.ebay.com\/itm\/25-WHITE-Genuine-leather-wedding-escort-luggage-tags-2-00-each-\/151419037361?pt=LH_DefaultDomain_0&amp;amp;hash=item23414726b1&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;\/p&gt;","Attachments":[],"Id":1885621,"PostDate":1423412569,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>We're doing custom leather luggage tags that I found on ebay. <a href='http:\/\/www.ebay.com\/itm\/25-WHITE-Genuine-leather-wedding-escort-luggage-tags-2-00-each-\/151419037361?pt=LH_DefaultDomain_0&hash=item23414726b1' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.ebay.com\/...=item23414726b1<\/a><\/p>\n<p><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"candice.french@gmail.com","IpAddress":"24.62.169.169","GroupId":39,"GroupName":"Newbie","JoinDate":1415124695,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-280992.jpg?_r=1421507914","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"FormattedName":"MissFrench","Id":280992,"Name":"MissFrench","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"117.247.211.186","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77073,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e532561a2d33f2190860273a93985f9b","RawContent":"&lt;p&gt;This is very interesting as you make your guests happy with good wedding favors and now a days personalised gifts are popular and also it is cherished well by your guests. So selecting personalised gifts depends upon your creativity. Choose something that makes your guests feel SPECIAL!&lt;\/p&gt;","Attachments":[],"Id":1887034,"PostDate":1424513941,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>This is very interesting as you make your guests happy with good wedding favors and now a days personalised gifts are popular and also it is cherished well by your guests. So selecting personalised gifts depends upon your creativity. Choose something that makes your guests feel SPECIAL!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"skashish033@gmail.com","IpAddress":"111.93.186.158","GroupId":39,"GroupName":"Newbie","JoinDate":1407235968,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"custom"},"FormattedName":"MillerK","Id":279306,"Name":"MillerK","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"122.15.103.61","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77073,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6196956ad37bcae6c9c59fe3c77be100","RawContent":"&lt;p&gt;Ideas are plenty, but execution matter who would manage it efficiently and effectively.&amp;nbsp;\n\nHere are few creative wedding reception favors:&lt;\/p&gt;\n&lt;p&gt;1.)&amp;nbsp;&lt;span style=\"color:rgb(0,0,0);font-family:Tahoma, Verdana, sans-serif;\"&gt;Homemade Granola&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"color:rgb(0,0,0);font-family:Tahoma, Verdana, sans-serif;\"&gt;2.)&amp;nbsp;&lt;\/span&gt;&lt;span style=\"color:rgb(0,0,0);font-family:Tahoma, Verdana, sans-serif;\"&gt;Signature Soda Pop&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\"color:rgb(0,0,0);font-family:Tahoma, Verdana, sans-serif;\"&gt;3.)&amp;nbsp;&lt;\/span&gt;&lt;span style=\"color:rgb(0,0,0);font-family:Tahoma, Verdana, sans-serif;\"&gt;Regional Treat&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/lh6.googleusercontent.com\/-x7uL16qanJY\/VMiQA46StFI\/AAAAAAAAAMs\/dORa0sQYfo0\/w2400-h1200\/BKB%2BFB%2BPost%2B28-01-2015.png\" alt=\"BKB%2BFB%2BPost%2B28-01-2015.png\"&gt;&lt;\/p&gt;","Attachments":[],"Id":1887784,"PostDate":1425107313,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Ideas are plenty, but execution matter who would manage it efficiently and effectively.\u00a0<br>\nHere are few creative wedding reception favors:<\/p>\n<p>1.)\u00a0<span  style=\"color:rgb(0,0,0);font-family:Tahoma, Verdana, sans-serif\">Homemade Granola<\/span><\/p>\n<p><span  style=\"color:rgb(0,0,0);font-family:Tahoma, Verdana, sans-serif\">2.)\u00a0<\/span><span  style=\"color:rgb(0,0,0);font-family:Tahoma, Verdana, sans-serif\">Signature Soda Pop<\/span><\/p>\n<p><span  style=\"color:rgb(0,0,0);font-family:Tahoma, Verdana, sans-serif\">3.)\u00a0<\/span><span  style=\"color:rgb(0,0,0);font-family:Tahoma, Verdana, sans-serif\">Regional Treat<\/span><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/lh6.googleusercontent.com\/-x7uL16qanJY\/VMiQA46StFI\/AAAAAAAAAMs\/dORa0sQYfo0\/w2400-h1200\/BKB%2BFB%2BPost%2B28-01-2015.png\" alt=\"BKB%2BFB%2BPost%2B28-01-2015.png\"><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"katherineriverace@gmail.com","IpAddress":"122.15.103.61","GroupId":39,"GroupName":"Newbie","JoinDate":1425104317,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282278.png?_r=1425103909","PhotoWidth":200,"PhotoHeight":242,"PhotoType":"custom"},"FormattedName":"RitvikSehgal","Id":282278,"Name":"RitvikSehgal","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"99.236.130.168","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77073,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fbb41f1718bba4b646ec6cbb5de9506c","RawContent":"Hello @[member=\"dclodge\"] [emoji4]\n\n\nFor our wedding favours we are doing personalized cup cozies!! Since the theme of our wedding is \"The hunt is over\" (my FI and I are both compound bow hunters so made sense!) I wanted to originally do personalized sunglasses but we have over 40 people coming and that just gets too expensive! We figured on spending about 1$ per person for favours [emoji4] I&#039;ll post a picture of the actual product soon!\n\n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1890981,"PostDate":1427463541,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hello @<a hovercard-ref=\"member\" hovercard-id=\"277979\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277979-dclodge\/' title='Member profile'><span itemprop=\"name\">dclodge<\/span><\/a> [emoji4]<br><br>\nFor our wedding favours we are doing personalized cup cozies!! Since the theme of our wedding is \"The hunt is over\" (my FI and I are both compound bow hunters so made sense!) I wanted to originally do personalized sunglasses but we have over 40 people coming and that just gets too expensive! We figured on spending about 1$ per person for favours [emoji4] I'll post a picture of the actual product soon!<br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"izabella.david@gmail.com","IpAddress":"99.237.26.51","GroupId":40,"GroupName":"Jr. Member","JoinDate":1426465978,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282430.jpg?_r=1426462827","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"IzzyDeee","Id":282430,"Name":"IzzyDeee","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"122.15.103.61","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77073,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"431f3b8dc6035e180db50b6eb2f309ae","RawContent":"&lt;p&gt;You can throw a party on theme like mystical peacock palette , Eternal pink and gold link.&amp;nbsp;&lt;span style=\"color:rgb(40,40,40);font-family:Helvetica, Arial, sans-serif;font-size:16px;\"&gt;This is the most sophisticated, as well as, the most beautiful combination, which would make&amp;nbsp;your wedding look divine. The subtleness of this theme makes it perfect for both evening, as well as, morning wedding ceremonies.&amp;nbsp;&lt;\/span&gt;&lt;\/p&gt;\n\n\t&amp;nbsp;","Attachments":[],"Id":1892750,"PostDate":1428733901,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>You can throw a party on theme like mystical peacock palette , Eternal pink and gold link.\u00a0<span  style=\"color:rgb(40,40,40);font-family:Helvetica, Arial, sans-serif;font-size:16px\">This is the most sophisticated, as well as, the most beautiful combination, which would make\u00a0your wedding look divine. The subtleness of this theme makes it perfect for both evening, as well as, morning wedding ceremonies.\u00a0<\/span><\/p>\n\n\t\u00a0\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"katherineriverace@gmail.com","IpAddress":"122.15.103.61","GroupId":39,"GroupName":"Newbie","JoinDate":1425104317,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282278.png?_r=1425103909","PhotoWidth":200,"PhotoHeight":242,"PhotoType":"custom"},"FormattedName":"RitvikSehgal","Id":282278,"Name":"RitvikSehgal","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"98.158.93.162","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":77073,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f87cca290703c53102f66e1e346887e2","RawContent":"[quote name=\"IzzyDeee\" post=\"1890981\" timestamp=\"1427459941\"]\nHello @[member=\"dclodge\"] [emoji4]\n\nFor our wedding favours we are doing personalized cup cozies!! Since the theme of our wedding is \"The hunt is over\" (my FI and I are both compound bow hunters so made sense!) I wanted to originally do personalized sunglasses but we have over 40 people coming and that just gets too expensive! We figured on spending about 1$ per person for favours [emoji4] I&#039;ll post a picture of the actual product soon!\n\n\nSent from my iPhone using Tapatalk[\/quote]Did you find sunglasses? If so where from and were they expensive? \n\n\nSent from my iPhone using Tapatalk","Attachments":[],"Id":1897676,"PostDate":1433196712,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>IzzyDeee, on 27 March 2015 - 05:39 AM, said:<\/p><div class='blockquote'><div class='quote'><p>Hello @<a hovercard-ref=\"member\" hovercard-id=\"277979\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277979-dclodge\/' title='Member profile'><span itemprop=\"name\">dclodge<\/span><\/a> [emoji4]<br><br>\nFor our wedding favours we are doing personalized cup cozies!! Since the theme of our wedding is \"The hunt is over\" (my FI and I are both compound bow hunters so made sense!) I wanted to originally do personalized sunglasses but we have over 40 people coming and that just gets too expensive! We figured on spending about 1$ per person for favours [emoji4] I'll post a picture of the actual product soon!<br><br><br>\nSent from my iPhone using Tapatalk<\/p><\/div><\/div>\nDid you find sunglasses? If so where from and were they expensive? <br><br><br>\nSent from my iPhone using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>~*~YYCBRIDE2016~*~<\/p><p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79227-yycbride2016-grand-sirenis-planning-thread-february-2016\/'>My planning thread\u00a0<\/a><\/p><p>\u00a0<\/p><p><a class='bbc_url' href='http:\/\/www.TickerFactory.com\/'><br><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10730;484\/st\/20160223\/e\/Our+Wedding\/dt\/-1\/k\/4bd8\/event.png\" alt=\"event.png\"><br><\/a><br>\u00a0","Email":"janellepaquin@hotmail.com","IpAddress":"162.157.216.37","GroupId":39,"GroupName":"Newbie","JoinDate":1432104904,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-283167.jpg?_r=1432133572","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"yycbride2016","Id":283167,"Name":"yycbride2016","IsOnline":false}}],"Pages":{"TotalItems":34,"TotalPages":4,"CurrentPage":20,"NextPage":30,"PreviousPage":10,"LastPage":30},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
