00a0<\/p>\n<p>\u00a0<\/p>\n<p>I think we are going to do the hand washing ceremony. It looks simple, beautiful and meaningful. Thanks for the ideas ladies\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"shaunte.henry@gmail.com","IpAddress":"108.48.71.112","GroupId":39,"GroupName":"Newbie","JoinDate":1405608230,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"shevette925","Id":279050,"Name":"shevette925","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"108.225.204.185","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79214,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"dd29f43c5db4a89bbccdbf5f631b439a","RawContent":"Im doing a lasso ceremony. Google it and what it means. You may love it!","Attachments":[],"Id":1897316,"PostDate":1432703376,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Im doing a lasso ceremony. Google it and what it means. You may love it! \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"keredondo@gmail.com","IpAddress":"108.225.204.185","GroupId":39,"GroupName":"Newbie","JoinDate":1403649619,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278682.jpg?_r=1414954781","PhotoWidth":187,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"BecomingaRiggio","Id":278682,"Name":"BecomingaRiggio","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"137.122.64.11","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79214,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"197dce8e854db52dc66128f177f00137","RawContent":"&lt;p&gt;Some cultures do a hand blessing ceremony (&lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/bridalmusings.com\/2011\/06\/ceremony-reading-blessing-of-the-hands\/&#039;&gt;http:\/\/bridalmusings.com\/2011\/06\/ceremony-reading-blessing-of-the-hands\/&lt;\/a&gt;), or pass the rings around for guests to warm with their love\/thoughts. &lt;\/p&gt;","Attachments":[],"Id":1897349,"PostDate":1432745565,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Some cultures do a hand blessing ceremony (<a href='http:\/\/bridalmusings.com\/2011\/06\/ceremony-reading-blessing-of-the-hands\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/bridalmusings...g-of-the-hands\/<\/a>), or pass the rings around for guests to warm with their love\/thoughts. <\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kerrierf@gmail.com","IpAddress":"69.165.209.118","GroupId":39,"GroupName":"Newbie","JoinDate":1391398823,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-276456.jpg?_r=1410147109","PhotoWidth":199,"PhotoHeight":300,"PhotoType":"custom"},"FormattedName":"Kerrierf","Id":276456,"Name":"Kerrierf","IsOnline":false}}],"Id":"79214","Title":"Alternatives To Sand Ceremony","LastPostDate":1432745565},"Pages":{"TotalItems":6,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
