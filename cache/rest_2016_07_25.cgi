{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":2,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":true,"Views":100,"MovedTo":null,"MovedOn":0,"FirstPostId":1914993,"Rating":0,"RatingHits":0,"Starter":{"Id":287430,"Name":"christine89","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1469227678,"LastPoster":{"Id":287136,"Name":"Venessa26","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":33,"Preview":{"Id":1914993,"PostDate":1469227678,"PostContent":"Dear fellow users. I want to tell you that dressilyme sent me my dream wedding gown. I hope more...","Author":{"Signature":"","Email":"mou32sumi@yahoo.com","IpAddress":"202.142.101.157","GroupId":39,"GroupName":"Newbie","JoinDate":1469226813,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"christine89","Id":287430,"Name":"christine89","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"202.142.101.157","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80209,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5b8baec66c67c4f7c0ab66c1270bc839","RawContent":"&lt;p&gt;&lt;span style=\"font-family:calibri, sans-serif;\"&gt;Dear fellow users. I want to tell you that dressilyme sent me my dream wedding gown. I hope more brides will feel the way I did at my wedding day. The quality and craftsmanship of wedding gown is AMAZING. &amp;nbsp;My process included providing pictures of the dress I wished for (as it was not within the standard selection profile), and Dressilyme was able to create the dress perfectly.&amp;nbsp; Dressilyme was able to 1) match the exact design of the dress 2) use the correct quality material i.e. silk bodice, silk organza train etc... 3) measurements\/dress size was accurate 4) send within the exact timeline and 5) had wonderful customer service to answer questions and provide status updates.&amp;nbsp; The original dress would have cost me $1800 from the bridal store (plus at least $500 in tailoring), Dressilyme charged $189 plus $30 for custom measurements.   I can&#039;t express my gratitude to be able to have a dream dress for a fraction of the price.&amp;nbsp; Weddings are expensive and Dresssilyme helps to manage the cos of a wedding dress.&lt;\/span&gt;&lt;span style=\"font-family:calibri, sans-serif;\"&gt;A very happy wife, Christine&lt;\/span&gt;&lt;\/p&gt;","Attachments":[{"Id":36271,"Name":"7e57f5d4-ed65-45e8-9ce7-4ee0be4fdf8e-115-160.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2016\/post-287430-0-84002100-1469241928.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2016\/post-287430-0-84002100-1469241928_thumb.jpg","Width":115,"Height":160},{"Id":36272,"Name":"37dbdb73-e800-455e-9aa3-fc8e38b9acd7-115-160.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2016\/post-287430-0-11313600-1469241930.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2016\/post-287430-0-11313600-1469241930_thumb.jpg","Width":115,"Height":160},{"Id":36273,"Name":"237758d8-a2eb-4773-882f-0c428f4abe0e-115-160.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2016\/post-287430-0-15261900-1469241931.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2016\/post-287430-0-15261900-1469241931_thumb.jpg","Width":115,"Height":160},{"Id":36274,"Name":"e95ac773-949e-4c39-a52f-a59c8b57ac07-115-160.jpg","Url":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2016\/post-287430-0-45687400-1469241932.jpg","ScaledUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/monthly_07_2016\/post-287430-0-45687400-1469241932_thumb.jpg","Width":115,"Height":160}],"Id":1914993,"PostDate":1469227678,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p><span  style=\"font-family:calibri, sans-serif\">Dear fellow users. I want to tell you that dressilyme sent me my dream wedding gown. I hope more brides will feel the way I did at my wedding day. The quality and craftsmanship of wedding gown is AMAZING. \u00a0My process included providing pictures of the dress I wished for (as it was not within the standard selection profile), and Dressilyme was able to create the dress perfectly.\u00a0 Dressilyme was able to 1) match the exact design of the dress 2) use the correct quality material i.e. silk bodice, silk organza train etc... 3) measurements\/dress size was accurate 4) send within the exact timeline and 5) had wonderful customer service to answer questions and provide status updates.\u00a0 The original dress would have cost me $1800 from the bridal store (plus at least $500 in tailoring), Dressilyme charged $189 plus $30 for custom measurements.\u00a0\u00a0 I can't express my gratitude to be able to have a dream dress for a fraction of the price.\u00a0 Weddings are expensive and Dresssilyme helps to manage the cos of a wedding dress.<\/span><span  style=\"font-family:calibri, sans-serif\">A very happy wife, Christine<\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"mou32sumi@yahoo.com","IpAddress":"202.142.101.157","GroupId":39,"GroupName":"Newbie","JoinDate":1469226813,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"christine89","Id":287430,"Name":"christine89","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"117.247.211.156","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80209,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1c8b9abc039d76cd52e582d32ff6a34a","RawContent":"&lt;p&gt;Congratulations! I am glad to see to you happy. Now, your wedding decoration should match with your look. I would like to see your wedding venue, wedding decorations. Would you please share the pictures with me.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1914995,"PostDate":1469240959,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congratulations! I am glad to see to you happy. Now, your wedding decoration should match with your look. I would like to see your wedding venue, wedding decorations. Would you please share the pictures with me.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"vanessahodge26@gmail.com","IpAddress":"117.247.211.216","GroupId":39,"GroupName":"Newbie","JoinDate":1465793553,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Venessa26","Id":287136,"Name":"Venessa26","IsOnline":false}}],"Id":"80209","Title":"I Felt Like A Queen On My Wedding Day, Thanks To Dressilyme","LastPostDate":1469240959},"Pages":{"TotalItems":2,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
