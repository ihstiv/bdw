/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419423414,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1453235488","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"pjay","Id":281478,"Name":"pjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"207.134.141.162","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79202,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":2,"IsLiked":false,"PostKey":"7be331a0a7746c8a0dff132cf1412050","RawContent":"&lt;p&gt;@[member=\"perianjay\"] Absolutely.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;m still good for most of August - weekend is probably better but I&#039;m not far from downtown, I&#039;m happy to meet up one weeknight as well.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;ll throw a couple dates out and we can get the ball rolling?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Aug 22 or 23&lt;\/p&gt;\n&lt;p&gt;Aug 28 (evening)&lt;\/p&gt;\n&lt;p&gt;Aug 30&lt;\/p&gt;","Attachments":[],"Id":1898152,"PostDate":1433840836,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@perianjay Absolutely.<\/p>\n<p>\u00a0<\/p>\n<p>I'm still good for most of August - weekend is probably better but I'm not far from downtown, I'm happy to meet up one weeknight as well.<\/p>\n<p>\u00a0<\/p>\n<p>I'll throw a couple dates out and we can get the ball rolling?<\/p>\n<p>\u00a0<\/p>\n<p>Aug 22 or 23<\/p>\n<p>Aug 28 (evening)<\/p>\n<p>Aug 30<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div><img src=\"http:\/\/\" alt=\"\"><\/div>\n<div><br><div>\u00a0<a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;32;116\/st\/20160430\/e\/we+say+I+do%21\/k\/8afc\/event.png\" alt=\"event.png\"><\/a><\/div>\n<div>\u00a0<\/div>\n<\/div>\n<p>\u00a0<\/p>\n<p>My Planning Thread:<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/79580-deecols-planning-thread-gbp-april-30th-2016\/#entry1904529'>http:\/\/www.bestdestinationwedding.com\/topic\/79580-deecols-planning-thread-gbp-april-30th-2016\/#entry1904529<\/a>","Email":"deannaproteau@hotmail.com","IpAddress":"207.134.141.162","GroupId":3,"GroupName":"Member","JoinDate":1421428169,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281751.jpg?_r=1463440164","PhotoWidth":200,"PhotoHeight":136,"PhotoType":"custom"},"FormattedName":"deecol","Id":281751,"Name":"deecol","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79202,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"fce3dcba504465ed9ddccb4ce3890451","RawContent":"&lt;p&gt;@[member=\"deecol\"] I think i&#039;m good for any of those dates. I know my bachelorette is happening in the end of summer, but I think it&#039;s September so I should be ok with these dates.&lt;\/p&gt;","Attachments":[],"Id":1898162,"PostDate":1433842690,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"281751\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281751-deecol\/' title='Member profile'><span itemprop=\"name\">deecol<\/span><\/a> I think i'm good for any of those dates. I know my bachelorette is happening in the end of summer, but I think it's September so I should be ok with these dates.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419423414,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1453235488","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"pjay","Id":281478,"Name":"pjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"38.112.94.76","IsFirstPost":false