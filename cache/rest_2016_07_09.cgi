Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":4,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":687,"MovedTo":null,"MovedOn":0,"FirstPostId":1914334,"Rating":0,"RatingHits":0,"Starter":{"Id":287128,"Name":"Kcespedes","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-287128.jpeg?_r=1465754948","PhotoWidth":200,"PhotoHeight":138,"PhotoType":"custom"},"IsOnline":false},"StartDate":1465754877,"LastPoster":{"Id":279411,"Name":"Mangosong","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279411.jpg?_r=1408152053","PhotoWidth":200,"PhotoHeight":180,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":14,"Preview":{"Id":1914334,"PostDate":1465754877,"PostContent":"Hi Everyone.\u00a0 I recently got engaged and am looking to get married in the Dominican Republic. Bot...","Author":{"Signature":"","Email":"cespedeskathy@gmail.com","IpAddress":"98.217.118.62","GroupId":39,"GroupName":"Newbie","JoinDate":1465622917,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-287128.jpeg?_r=1465754948","PhotoWidth":200,"PhotoHeight":138,"PhotoType":"custom"},"FormattedName":"Kcespedes","Id":287128,"Name":"Kcespedes","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"98.217.118.62","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80131,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"6579dd668001adec055df95496b61d21","RawContent":"&lt;p&gt;Hi Everyone.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I recently got engaged and am looking to get married in the Dominican Republic. Both my fiance and I are of Dominican background and having the wedding there would just be amazing since our families living in the Dominican would be able to attend.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I have been looking at Now and Dreams resorts in Punta Cana. I also have looked at JellyFish and Huracan restaurants. I am so lost! I have no idea where to start.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I was wondering if anyone here is using any of these venues? Maybe you can help me go in the right direction. We plan on getting married August 2017.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;also, Is anyone here a UVC member? My fiance and I got a membership and were wondering if they offer any further discounts for any of the AM resorts.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Any information from anyone would be extremely helpful!&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thanks in advance and happy planning!&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1914334,"PostDate":1465754877,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Everyone.\u00a0<\/p>\n<p>I recently got engaged and am looking to get married in the Dominican Republic. Both my fiance and I are of Dominican background and having the wedding there would just be amazing since our families living in the Dominican would be able to attend.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I have been looking at Now and Dreams resorts in Punta Cana. I also have looked at JellyFish and Huracan restaurants. I am so lost! I have no idea where to start.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I was wondering if anyone here is using any of these venues? Maybe you can help me go in the right direction. We plan on getting married August 2017.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>also, Is anyone here a UVC member? My fiance and I got a membership and were wondering if they offer any further discounts for any of the AM resorts.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Any information from anyone would be extremely helpful!\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Thanks in advance and happy planning!\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cespedeskathy@gmail.com","IpAddress":"98.217.118.62","GroupId":39,"GroupName":"Newbie","JoinDate":1465622917,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-287128.jpeg?_r=1465754948","PhotoWidth":200,"PhotoHeight":138,"PhotoType":"custom"},"FormattedName":"Kcespedes","Id":287128,"Name":"Kcespedes","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"24.66.4.22","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80131,"EditedBy":"<strong>Edited by Moments That Matter, 12 June 2016 - 10:59 AM.<\/strong>","EditDate":1465757951,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"fbc3e5a903bb27cf3b3af5f95f7de249","RawContent":"&lt;p&gt;Hola Kcespedes, welcome to our forum community, and Congrats on your recent engagement and planning a destination wedding in the DR next year!!!&lt;\/p&gt;\n&lt;p&gt;You&#039;ll find lots of wonderful info here that&#039;s sure to help with your questions, so well done on a good start already! You&#039;ll see lots of newbies start off feeling confused and overwhelmed, so you&#039;re in good company :)&amp;nbsp; You&#039;ll also see brides suggesting a good starting point is with a TA who can help narrow down your choices, with info on options and packages.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Wishing you happy research, and that you ENJOY the journey ahead - cheers!!!&lt;\/p&gt;\n&lt;p&gt;Moments That Matter Photography&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;.....we&#039;ll leave you with some beautiful beach wedding scenes of those magical \"moments that matter\" we&#039;ve captured in our romantic &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.momentsthatmatterphotography.com\/#!riviera-maya-resorts\/lwgjq&#039;&gt;Riviera Maya Resorts&lt;\/a&gt; - enjoy!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;from the beautiful &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.momentsthatmatterphotography.com\/#!riviera-maya-resorts\/lwgjq\/tag\/Beloved-Hotel-Wedding&#039;&gt;Beloved Hotel Wedding Story: &lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/static.wixstatic.com\/media\/e89d55_1c8fdc4b237c49529e5aea1f36dbc247.jpg\/v1\/fill\/w_1200,h_800,al_c,q_90\/e89d55_1c8fdc4b237c49529e5aea1f36dbc247.jpg\" alt=\"e89d55_1c8fdc4b237c49529e5aea1f36dbc247.\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;from the exceptional &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.momentsthatmatterphotography.com\/#!Excellence-Riviera-Cancun-Wedding-Bliss\/k7mfu\/56c0d8690cf2ccb6be47e775&#039;&gt;Excellence Riviera Cancun Wedding Story Album: &lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/static.wixstatic.com\/media\/e89d55_2f11e451351848e8b0870c58285986a9.jpg\/v1\/fill\/w_1200,h_800,al_c,q_90\/e89d55_2f11e451351848e8b0870c58285986a9.jpg\" alt=\"e89d55_2f11e451351848e8b0870c58285986a9.\"&gt;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;from a magical &lt;a data-ipb=&#039;nomediaparse&#039; href=&#039;http:\/\/www.momentsthatmatterphotography.com\/#!Cenote-Trash-the-Dress-Lindsay-Michael\/k7mfu\/56b0afdf0cf2062bd4140e4b&#039;&gt;Cenote Trash The Dress Session:&lt;\/a&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;img src=\"https:\/\/static.wixstatic.com\/media\/e89d55_b7092ec973f7490da78c089896185941.jpg\/v1\/fill\/w_1200,h_800,al_c,q_90\/e89d55_b7092ec973f7490da78c089896185941.jpg\" alt=\"e89d55_b7092ec973f7490da78c089896185941.\"&gt;&lt;\/p&gt;","Attachments":[],"Id":1914337,"PostDate":1465757594,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hola Kcespedes, welcome to our forum community, and Congrats on your recent engagement and planning a destination wedding in the DR next year!!!<\/p>\n<p>You'll find lots of wonderful info here that's sure to help with your questions, so well done on a good start already! You'll see lots of newbies start off feeling confused and overwhelmed, so you're in good company <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0 You'll also see brides suggesting a good starting point is with a TA who can help narrow down your choices, with info on options and packages.<\/p>\n<p>\u00a0<\/p>\n<p>Wishing you happy research, and that you ENJOY the journey ahead - cheers!!!<\/p>\n<p>Moments That Matter Photography<\/p>\n<p>\u00a0<\/p>\n<p>.....we'll leave you with some beautiful beach wedding scenes of those magical \"moments that matter\" we've captured in our romantic <a href='http:\/\/www.momentsthatmatterphotography.com\/#!riviera-maya-resorts\/lwgjq' class='bbc_url' title='External link' rel='nofollow external'>Riviera Maya Resorts<\/a> - enjoy!<\/p>\n<p>\u00a0<\/p>\n<p>from the beautiful <a href='http:\/\/www.momentsthatmatterphotography.com\/#!riviera-maya-resorts\/lwgjq\/tag\/Beloved-Hotel-Wedding' class='bbc_url' title='External link' rel='nofollow external'>Beloved Hotel Wedding Story: <\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/static.wixstatic.com\/media\/e89d55_1c8fdc4b237c49529e5aea1f36dbc247.jpg\/v1\/fill\/w_1200,h_800,al_c,q_90\/e89d55_1c8fdc4b237c49529e5aea1f36dbc247.jpg\" alt=\"e89d55_1c8fdc4b237c49529e5aea1f36dbc247.\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>from the exceptional <a href='http:\/\/www.momentsthatmatterphotography.com\/#!Excellence-Riviera-Cancun-Wedding-Bliss\/k7mfu\/56c0d8690cf2ccb6be47e775' class='bbc_url' title='External link' rel='nofollow external'>Excellence Riviera Cancun Wedding Story Album: <\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/static.wixstatic.com\/media\/e89d55_2f11e451351848e8b0870c58285986a9.jpg\/v1\/fill\/w_1200,h_800,al_c,q_90\/e89d55_2f11e451351848e8b0870c58285986a9.jpg\" alt=\"e89d55_2f11e451351848e8b0870c58285986a9.\"><\/span><\/p>\n<p>\u00a0<\/p>\n<p>from a magical <a href='http:\/\/www.momentsthatmatterphotography.com\/#!Cenote-Trash-the-Dress-Lindsay-Michael\/k7mfu\/56b0afdf0cf2062bd4140e4b' class='bbc_url' title='External link' rel='nofollow external'>Cenote Trash The Dress Session:<\/a><\/p>\n<p><span rel='lightbox'><img class='bbc_img' src=\"https:\/\/static.wixstatic.com\/media\/e89d55_b7092ec973f7490da78c089896185941.jpg\/v1\/fill\/w_1200,h_800,al_c,q_90\/e89d55_b7092ec973f7490da78c089896185941.jpg\" alt=\"e89d55_b7092ec973f7490da78c089896185941.\"><\/span><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><img src=\"http:\/\/i1378.photobucket.com\/albums\/ah106\/ContactIDoMexico\/MTM%20Logo%202016_zps4tzm05my.png\" alt=\"MTM%20Logo%202016_zps4tzm05my.png\"><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.momentsthatmatterphotography.com'><strong><span style=\"font-size:18px;\">Moments That Matter Photography , Cancun, Playa del Carmen, Mexico<\/span><\/strong><\/a><\/p>\n<p>Canadian Award Winning Photojournalist serving the Riviera Maya<\/p>\n<p>\u00a0<\/p>\n<p>Email: <a data-ipb='nomediaparse' href='mailto:contact@momentsthatmatterphotography.com'>contact@momentsthatmatterphotography.com<\/a><\/p>\n<p><span style=\"color:#0000cd;\"><strong>Why we're Ranked #1<\/strong><\/span> ~ Scoop on what we do:\u00a0 <a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21512-moments-that-matter-photography\/'>MTM Reviews<\/a><\/p>\n<p>Meet Lincoln & Team MTM: <a data-ipb='nomediaparse' href='http:\/\/vimeo.com\/51032621'>\"Meet Lincoln\" Video + see his Passion!!!<\/a><\/p>\n<p>\u00a0<\/p>\n<p><strong><span style=\"color:#0000cd;\"><span style=\"font-family:'comic sans ms', cursive;\">We Offer<\/span><\/span><\/strong>: <strong><em><u>100% Vendor Fee Discount<\/u><br>\n\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 <u>100% Deposit Guarantee<\/u><\/em><\/strong><\/p>\n<p><strong><em>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 \u00a0 <u>100% Satisfaction Guarantee<\/u><\/em><\/strong>","Email":"momentsthatmatterphotography@gmail.com","IpAddress":"189.221.252.187","GroupId":49,"GroupName":"Insiders","JoinDate":1280210660,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230711.png?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"Moments That Matter","Id":230711,"Name":"Moments That Matter","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"189.221.38.183","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80131,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"ac6c176f92ee184aff4e157065a64557","RawContent":"[quote name=\"Kcespedes\" post=\"1914334\" timestamp=\"1465754877\"]\nHi Everyone. \nI recently got engaged and am looking to get married in the Dominican Republic. Both my fiance and I are of Dominican background and having the wedding there would just be amazing since our families living in the Dominican would be able to attend. \n\nI have been looking at Now and Dreams resorts in Punta Cana. I also have looked at JellyFish and Huracan restaurants. I am so lost! I have no idea where to start. \n\nI was wondering if anyone here is using any of these venues? Maybe you can help me go in the right direction. We plan on getting married August 2017. \n\nalso, Is anyone here a UVC member? My fiance and I got a membership and were wondering if they offer any further discounts for any of the AM resorts. \n\n\nAny information from anyone would be extremely helpful! \n\n\nThanks in advance and happy planning![\/quote]@[member=\"Kcespedes\"] Congrats on your engagement,\n\nThe best place to start is to get a professional involved . If you ended up with the resort wedding. then contact a TA. So they can assist you with group logistics.  If your wedding is at the private location then look for a wedding planner.  \n\nYou already have one thing figured out the destination.   have you decided on your budget yet? also what is the estimation on the guests number?\n\nHappy Planning!\nJoyce","Attachments":[],"Id":1914353,"PostDate":1465829330,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p class='citation' style='color:#324F85;margin:15px;font-weight:bold;font-style:italic;'>Kcespedes, on 12 June 2016 - 10:07 AM, said:<\/p><div class='blockquote'><div class='quote'>\n<div>\n<p>Hi Everyone.\u00a0<\/p>\n<p>I recently got engaged and am looking to get married in the Dominican Republic. Both my fiance and I are of Dominican background and having the wedding there would just be amazing since our families living in the Dominican would be able to attend.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I have been looking at Now and Dreams resorts in Punta Cana. I also have looked at JellyFish and Huracan restaurants. I am so lost! I have no idea where to start.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I was wondering if anyone here is using any of these venues? Maybe you can help me go in the right direction. We plan on getting married August 2017.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>also, Is anyone here a UVC member? My fiance and I got a membership and were wondering if they offer any further discounts for any of the AM resorts.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Any information from anyone would be extremely helpful!\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Thanks in advance and happy planning!\u00a0<\/p>\n<\/div>\n<\/div><\/div>\n<p>@<a hovercard-ref=\"member\" hovercard-id=\"287128\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/287128-kcespedes\/' title='Member profile'><span itemprop=\"name\">Kcespedes<\/span><\/a> Congrats on your engagement,<\/p>\n<p>\u00a0<\/p>\n<p>The best place to start is to get a professional involved . If you ended up with the resort wedding. then contact a TA. So they can assist you with group logistics. \u00a0If your wedding is at the private location then look for a wedding planner. \u00a0<\/p>\n<p>\u00a0<\/p>\n<p>You already have one thing figured out the destination. \u00a0 have you decided on your budget yet? also what is the estimation on the guests number?<\/p>\n<p>\u00a0<\/p>\n<p>Happy Planning!<\/p>\n<p>Joyce<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>Dream Weddings Riviera Maya- We pay attention to your wishes and coordinate closely with you to ensure your wedding or event is planned to perfection! Supporting you brides and help you feel less overwhelmed during the wedding planning process.<\/p>\n<p>Have fun the best is yet to come!<\/p>\n<p>\u00a0<\/p>\n<p>This is where I will be posting all videos about most common question about Destination wedding<\/p>\n<p> <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\u00a0\u00a0<a data-ipb='nomediaparse' href='https:\/\/www.facebook.com\/groups\/1664036763874450\/'>https:\/\/www.facebook.com\/groups\/1664036763874450\/<\/a><br><br><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Dream Weddings Riviera Maya<\/span><\/span><\/span><br><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">weddingsinplayadelcarmen@gmail.com<\/span><\/span><br><a  class=\"bbc_url\" href=\"http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html\">http:\/\/www.dreamweddingsrivieramaya.com\/Home_Page.html<\/a><br><br><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Happy Planning!<\/span><\/span><\/span><br><span style=\"color:rgb(40,40,40);\"><span style=\"font-family:arial;\"><span style=\"font-size:12px;\">Joyce<\/span><\/span><\/span>","Email":"weddingsinplayadelcarmen@gmail.com","IpAddress":"187.252.44.28","GroupId":84,"GroupName":"Insiders w\/ Articles","JoinDate":1326854387,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-250090.jpg?_r=1451923195","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"dreamweddings","Id":250090,"Name":"dreamweddings","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.127.211.91","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80131,"EditedBy":"<strong>Edited by Mangosong, 04 July 2016 - 05:11 PM.<\/strong>","EditDate":1467681106,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5427c9f7863e4cdb5a11fda724f6f599","RawContent":"&lt;p&gt;@[member=\"Kcespedes\"] Hi! Welcome and congrats! The first thing I would suggest is a budget and a guest list!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;After deciding on a budget and guest list, deciding on location, I contacted the hotel directly and got in contact with the wedding coordinator. Fi and I had already decided on a date, so after locking down our date\/deposit, I got my travel agent, and she the one to negotiate my room block.&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1914665,"PostDate":1467681038,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"287128\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/287128-kcespedes\/' title='Member profile'><span itemprop=\"name\">Kcespedes<\/span><\/a> Hi! Welcome and congrats! The first thing I would suggest is a budget and a guest list!<\/p>\n<p>\u00a0<\/p>\n<p>After deciding on a budget and guest list, deciding on location, I contacted the hotel directly and got in contact with the wedding coordinator. Fi and I had already decided on a date, so after locking down our date\/deposit, I got my travel agent, and she the one to negotiate my room block.\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"wonderlandgrl3@yahoo.com","IpAddress":"75.99.50.82","GroupId":40,"GroupName":"Jr. Member","JoinDate":1407874186,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-279411.jpg?_r=1408152053","PhotoWidth":200,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Mangosong","Id":279411,"Name":"Mangosong","IsOnline":false}}],"Id":"80131","Title":"New And Confused","LastPostDate":1467681038},"Pages":{"TotalItems":4,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
