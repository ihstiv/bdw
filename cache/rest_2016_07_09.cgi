{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":11,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":729,"MovedTo":null,"MovedOn":0,"FirstPostId":1913224,"Rating":0,"RatingHits":0,"Starter":{"Id":286853,"Name":"2017weddingguy","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1462126191,"LastPoster":{"Id":286637,"Name":"DDW","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286637.png?_r=1459645234","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":22,"Preview":{"Id":1913224,"PostDate":1462126191,"PostContent":"Hi Everyone, \u00a0 I'm trying to find places in DR similar to Sky Terraces Azul or Royal Royalton in...","Author":{"Signature":"","Email":"06dixon@gmail.com","IpAddress":"98.248.183.177","GroupId":39,"GroupName":"Newbie","JoinDate":1462121802,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"2017weddingguy","Id":286853,"Name":"2017weddingguy","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"98.248.183.177","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80069,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"babb32691454e6fa96e1b3b94adecd3a","RawContent":"&lt;p&gt;Hi Everyone,&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;m trying to find places in DR similar to Sky Terraces Azul or Royal Royalton in Mexico but in DR. Anyone have any leads? Thanks so much!&lt;\/p&gt;","Attachments":[],"Id":1913224,"PostDate":1462126191,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Everyone,<\/p>\n<p>\u00a0<\/p>\n<p>I'm trying to find places in DR similar to Sky Terraces Azul or Royal Royalton in Mexico but in DR. Anyone have any leads? Thanks so much!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"06dixon@gmail.com","IpAddress":"98.248.183.177","GroupId":39,"GroupName":"Newbie","JoinDate":1462121802,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"2017weddingguy","Id":286853,"Name":"2017weddingguy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"76.95.180.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80069,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"2de96961774e78138dc5188dab78c46a","RawContent":"&lt;p&gt;Hi there - Congratulations on your upcoming wedding! Royalton Punta Cana has a private area, it&#039;s called the Ecologic Spa. I have a photo if you&#039;d like to see it, but I can&#039;t seem to attach it. We have stayed at Royalton PC and it&#039;s a great resort. Please feel free to email me at patty@wrighttravelagency.com. Thanks! Patty&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1913228,"PostDate":1462133657,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi there - Congratulations on your upcoming wedding! Royalton Punta Cana has a private area, it's called the Ecologic Spa. I have a photo if you'd like to see it, but I can't seem to attach it. We have stayed at Royalton PC and it's a great resort. Please feel free to email me at patty@wrighttravelagency.com. Thanks! Patty\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><a class='bbc_url' href='http:\/\/wrighttravelagency.com\/inquiry\/'><span style='color: rgb(0,128,128)'>Looking for a travel agency that specializes in Destination Weddings<\/span><\/a><span style='color: rgb(0,128,128)'>? We are an award winning travel agency and you can read our reviews <\/span><a class='bbc_url' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style='color: rgb(0,128,128)'><strong class='bbc'>HERE.<\/strong><\/span><\/a><\/span><\/span><br \/>\n<br \/>\n<span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'><strong class='bbc'>Awards and recognition: <\/strong><\/span><\/span><\/span><\/span><br \/>\n<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'>Palace Resorts Top PRO Agency <\/span><\/span><\/span><\/span><br \/>\n<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'>Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator <\/span><\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>AMResorts Master Agent & Top Agency<\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>Travel Impressions Best of the Best Globe Winner<\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>Apple Vacations Golden Apple Winner<\/span><\/span><\/span><span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='font-size: 12px;'><span style='color: rgb(0,128,128)'>5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | AMResorts Master Agent & Top Agency | <\/span><span style='color: rgb(0,128,128)'>Travel Impressions Best of the Best Globe Winner | Apple Vacations Golden Apple Winner <\/span><\/span><\/span><\/span>","Email":"patty@wrighttravelagency.com","IpAddress":"76.95.92.213","GroupId":49,"GroupName":"Insiders","JoinDate":1278657480,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230028.jpg?_r=1398727965","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"TA Patty","Id":230028,"Name":"TA Patty","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"98.248.183.177","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80069,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4662b95d20c16440c832af3cd2728469","RawContent":"&lt;p&gt;Hi Patty,&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thanks for the help! I just sent you an email. Is that really the only place in DR? Does Jamaica have any options?&lt;\/p&gt;","Attachments":[],"Id":1913232,"PostDate":1462134767,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hi Patty,<\/p>\n<p>\u00a0<\/p>\n<p>Thanks for the help! I just sent you an email. Is that really the only place in DR? Does Jamaica have any options?<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"06dixon@gmail.com","IpAddress":"98.248.183.177","GroupId":39,"GroupName":"Newbie","JoinDate":1462121802,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"2017weddingguy","Id":286853,"Name":"2017weddingguy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.13.219","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80069,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bbf79feb476e7bdacdf37de1b98974f1","RawContent":"&lt;p&gt;@[member=\"2017weddingguy\"] There are lots of ceremony location options. When you say private, what are you looking for? I got married in Jamaica and it&#039;s a very popular place with brides to be here, and we had a gazebo that was on the beach but down a path so the only people there are your guests. We also just renewed our vows and had a very private location at a private beach club up on a terrace but that&#039;s in Mexico. I don&#039;t think you&#039;re interested in Mexico, are you? There are a lot of resorts in Jamaica and generally all of them have a location that isn&#039;t beach - either a garden or waterfall location. It does look like Azul Sensatori in Jamaica also has that sky terrace location, so that could be an option.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Are you working with a travel agent? That&#039;s your best first step. Contacting Wright Travel will definitely give you a great start. They&#039;ll help you with your budget and your wants and don&#039;t wants, and also help you with your budget for your guests.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck and happy planning!&lt;\/p&gt;","Attachments":[],"Id":1913234,"PostDate":1462137997,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"286853\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/286853-2017weddingguy\/' title='Member profile'><span itemprop=\"name\">2017weddingguy<\/span><\/a> There are lots of ceremony location options. When you say private, what are you looking for? I got married in Jamaica and it's a very popular place with brides to be here, and we had a gazebo that was on the beach but down a path so the only people there are your guests. We also just renewed our vows and had a very private location at a private beach club up on a terrace but that's in Mexico. I don't think you're interested in Mexico, are you? There are a lot of resorts in Jamaica and generally all of them have a location that isn't beach - either a garden or waterfall location. It does look like Azul Sensatori in Jamaica also has that sky terrace location, so that could be an option.<\/p>\n<p>\u00a0<\/p>\n<p>Are you working with a travel agent? That's your best first step. Contacting Wright Travel will definitely give you a great start. They'll help you with your budget and your wants and don't wants, and also help you with your budget for your guests.<\/p>\n<p>\u00a0<\/p>\n<p>Good luck and happy planning!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/'><span style=\"color:#ff0099;\"><em>http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283458999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"144.9.40.131","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80069,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"2531b674c1c7e056b3a27c3152da7601","RawContent":"&lt;p&gt;I know Dreams Resort and Spa Punta Cana. Has a gazebo&amp;nbsp; that looks really nice. Not for sure where it is located. But&amp;nbsp;we are going down there next weekend to check it all out. So If you have not decided on a place yet I can send you a photo of it and tell you&amp;nbsp;where it is if you like just send me a message.&lt;\/p&gt;","Attachments":[],"Id":1913798,"PostDate":1463505841,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I know Dreams Resort and Spa Punta Cana. Has a gazebo\u00a0 that looks really nice. Not for sure where it is located. But\u00a0we are going down there next weekend to check it all out. So If you have not decided on a place yet I can send you a photo of it and tell you\u00a0where it is if you like just send me a message.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"lori.yepez@aa.com","IpAddress":"173.74.136.107","GroupId":39,"GroupName":"Newbie","JoinDate":1440294410,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"lorishultz2016","Id":284536,"Name":"lorishultz2016","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"50.193.1.13","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80069,"EditedBy":"","EditDate":0,"Edit