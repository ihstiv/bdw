{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":3,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":623,"MovedTo":null,"MovedOn":0,"FirstPostId":1914335,"Rating":0,"RatingHits":0,"Starter":{"Id":287128,"Name":"Kcespedes","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-287128.jpeg?_r=1465754948","PhotoWidth":200,"PhotoHeight":138,"PhotoType":"custom"},"IsOnline":false},"StartDate":1465755935,"LastPoster":{"Id":245258,"Name":"YS Studios","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-245258.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":22,"Preview":{"Id":1914335,"PostDate":1465755935,"PostContent":"Hi Everyone.\u00a0 I recently got engaged and am looking to get married in the Dominican Republic. Bot...","Author":{"Signature":"","Email":"cespedeskathy@gmail.com","IpAddress":"98.217.118.62","GroupId":39,"GroupName":"Newbie","JoinDate":1465622917,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-287128.jpeg?_r=1465754948","PhotoWidth":200,"PhotoHeight":138,"PhotoType":"custom"},"FormattedName":"Kcespedes","Id":287128,"Name":"Kcespedes","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"98.217.118.62","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80132,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3c156c4872adf3e6b3fd6c772f6866e1","RawContent":"&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;Hi Everyone.&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;I recently got engaged and am looking to get married in the Dominican Republic. Both my fiance and I are of Dominican background and having the wedding there would just be amazing since our families living in the Dominican would be able to attend.&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;I have been looking at Now and Dreams resorts in Punta Cana. I also have looked at JellyFish and Huracan restaurants. I am so lost! I have no idea where to start.&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;I was wondering if anyone here is using any of these venues? Maybe you can help me go in the right direction. We plan on getting married August 2017.&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;also, Is anyone here a UVC member? My fiance and I got a membership and were wondering if they offer any further discounts for any of the AM resorts.&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;Any information from anyone would be extremely helpful!&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40);\"&gt;Thanks in advance and happy planning!&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1914335,"PostDate":1465755935,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">Hi Everyone.\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">I recently got engaged and am looking to get married in the Dominican Republic. Both my fiance and I are of Dominican background and having the wedding there would just be amazing since our families living in the Dominican would be able to attend.\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">I have been looking at Now and Dreams resorts in Punta Cana. I also have looked at JellyFish and Huracan restaurants. I am so lost! I have no idea where to start.\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">I was wondering if anyone here is using any of these venues? Maybe you can help me go in the right direction. We plan on getting married August 2017.\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">also, Is anyone here a UVC member? My fiance and I got a membership and were wondering if they offer any further discounts for any of the AM resorts.\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">Any information from anyone would be extremely helpful!\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">\u00a0<\/p>\n<p  style=\"font-family:arial, helvetica, sans-serif;color:rgb(40,40,40)\">Thanks in advance and happy planning!\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cespedeskathy@gmail.com","IpAddress":"98.217.118.62","GroupId":39,"GroupName":"Newbie","JoinDate":1465622917,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-287128.jpeg?_r=1465754948","PhotoWidth":200,"PhotoHeight":138,"PhotoType":"custom"},"FormattedName":"Kcespedes","Id":287128,"Name":"Kcespedes","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"76.95.180.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80132,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"7f8417f815a142f651f1a51b8f8fafbf","RawContent":"&lt;p&gt;Congratulations on your engagement! We have stayed at Now Larimar and all three Dreams properties in Punta Cana and have also been to jellyfish and Hurican. I am not familair with how the vacation club works with groups, if you can book a block of rooms and if you would receive any of the group amenties offered by the resorts when booking a traditional group block.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;We&#039;re happy to answer any questions you may have. Just click the link below to have a Wright Travel agent contact you. Thanks! TA Patty&lt;\/p&gt;","Attachments":[],"Id":1914341,"PostDate":1465770056,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Congratulations on your engagement! We have stayed at Now Larimar and all three Dreams properties in Punta Cana and have also been to jellyfish and Hurican. I am not familair with how the vacation club works with groups, if you can book a block of rooms and if you would receive any of the group amenties offered by the resorts when booking a traditional group block.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>We're happy to answer any questions you may have. Just click the link below to have a Wright Travel agent contact you. Thanks! TA Patty<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><a class='bbc_url' href='http:\/\/wrighttravelagency.com\/inquiry\/'><span style='color: rgb(0,128,128)'>Looking for a travel agency that specializes in Destination Weddings<\/span><\/a><span style='color: rgb(0,128,128)'>? We are an award winning travel agency and you can read our reviews <\/span><a class='bbc_url' href='http:\/\/www.bestdestinationwedding.com\/reviews\/p\/21494-wright-travel-agency-destination-wedding-and-honeymoon-specialists\/'><span style='color: rgb(0,128,128)'><strong class='bbc'>HERE.<\/strong><\/span><\/a><\/span><\/span><br \/>\n<br \/>\n<span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'><strong class='bbc'>Awards and recognition: <\/strong><\/span><\/span><\/span><\/span><br \/>\n<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'>Palace Resorts Top PRO Agency <\/span><\/span><\/span><\/span><br \/>\n<span style='font-size: 14px;'><span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='color: rgb(0,128,128)'>Karisma Hotels Diamond Level 5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator <\/span><\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>AMResorts Master Agent & Top Agency<\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>Travel Impressions Best of the Best Globe Winner<\/span><\/span><\/span><br \/>\n<span style='color: rgb(0,128,128)'><span style='font-family: arial'><span style='font-size: 14px;'>Apple Vacations Golden Apple Winner<\/span><\/span><\/span><span style='color: rgb(164,164,164)'><span style='font-family: arial'><span style='font-size: 12px;'><span style='color: rgb(0,128,128)'>5 (highest production), Top 10 Azul Weddings, Top Wedding Coordinator | AMResorts Master Agent & Top Agency | <\/span><span style='color: rgb(0,128,128)'>Travel Impressions Best of the Best Globe Winner | Apple Vacations Golden Apple Winner <\/span><\/span><\/span><\/span>","Email":"patty@wrighttravelagency.com","IpAddress":"76.95.92.213","GroupId":49,"GroupName":"Insiders","JoinDate":1278657480,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230028.jpg?_r=1398727965","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"TA Patty","Id":230028,"Name":"TA Patty","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"71.14.72.31","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":80132,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"50e742523aa18f2910af58153a14c764","RawContent":"&lt;p&gt;Jill Bowen the owner \/ operator of www.travelshoppeltd.com&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;217-753-0255&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;She has been a long time Wedding Professional I know personally. She has a genuine heart to serve Wedding couples in the area of booking Destination Weddings! We always say she has Fairy Dust in her Keyboard!&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good Luck ~&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1914647,"PostDate":1467660027,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Jill Bowen the owner \/ operator of www.travelshoppeltd.com\u00a0<\/p>\n<p>217-753-0255\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>She has been a long time Wedding Professional I know personally. She has a genuine heart to serve Wedding couples in the area of booking Destination Weddings! We always say she has Fairy Dust in her Keyboard!\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Good Luck ~\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"melisakeltner@gmail.com","IpAddress":"71.14.72.31","GroupId":39,"GroupName":"Newbie","JoinDate":1315929984,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-245258.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"YS Studios","Id":245258,"Name":"YS Studios","IsOnline":false}}],"Id":"80132","Title":"Punta Cana - August 2017","LastPostDate":1467660027},"Pages":{"TotalItems":3,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
