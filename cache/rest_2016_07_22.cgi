Request Time: 0 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":8,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":1975,"MovedTo":null,"MovedOn":0,"FirstPostId":1344428,"Rating":0,"RatingHits":0,"Starter":{"Id":234102,"Name":"drea50","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-234102.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"StartDate":1290301771,"LastPoster":{"Id":285389,"Name":"Peggyswee","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":35,"Preview":{"Id":1907983,"PostDate":1448985405,"PostContent":"How did everything go for everyone? And what did you decide???","Author":{"Signature":"","Email":"peggygiarrusso@gmail.com","IpAddress":"73.10.35.253","GroupId":39,"GroupName":"Newbie","JoinDate":1447990529,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Peggyswee","Id":285389,"Name":"Peggyswee","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":58204,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ed3b6470f8763fbfb85a0005bbfa761b","RawContent":"&lt;p&gt; So I live in Texas and want to plan a destination wedding at a beach resort in Florida. Was thinking somewhere along the west coast of FL. My dream is to find a beach resort where all my quests can stay, where we can have our ceremony overlooking the ocean, have our reception, and then have everything else done through them (cake, dj, flower, hair\/makeup, ec)...... We are looking to keep the budget very reasonable and wasn&#039;t sure if anyone had any suggestions???&lt;\/p&gt; &lt;p&gt; &lt;input id=\"gwProxy\" type=\"hidden\" \/&gt;&lt;!--Session data--&gt;&lt;input id=\"jsProxy\" onclick=\"jsCall();\" type=\"hidden\" \/&gt;&lt;\/p&gt;","Attachments":[],"Id":1344428,"PostDate":1290301771,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> So I live in Texas and want to plan a destination wedding at a beach resort in Florida. Was thinking somewhere along the west coast of FL. My dream is to find a beach resort where all my quests can stay, where we can have our ceremony overlooking the ocean, have our reception, and then have everything else done through them (cake, dj, flower, hair\/makeup, ec)...... We are looking to keep the budget very reasonable and wasn't sure if anyone had any suggestions???<\/p> <p> <input id=\"gwProxy\" type=\"hidden\" \/><!--Session data--><input id=\"jsProxy\" onclick=\"jsCall();\" type=\"hidden\" \/><\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"drea50@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1290300066,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-234102.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"drea50","Id":234102,"Name":"drea50","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":58204,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"eba5908ea9e36a03512ff9a9424dcd5e","RawContent":"&lt;p&gt; You can check out the Sandpearl resort or the Sheraton Sandkey - both are in Clearwater.&amp;nbsp; Their websites look nice, although you need to submit an RFP to get a price quote so I have no idea on budget.&lt;\/p&gt;","Attachments":[],"Id":1346131,"PostDate":1290545332,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> You can check out the Sandpearl resort or the Sheraton Sandkey - both are in Clearwater.\u00a0 Their websites look nice, although you need to submit an RFP to get a price quote so I have no idea on budget.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"knitgirl13@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1275412907,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-228743.gif?_r=0","PhotoWidth":100,"PhotoHeight":65,"PhotoType":"custom"},"FormattedName":"knitgirl13","Id":228743,"Name":"knitgirl13","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":58204,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5653ff1b7d4ff65af59610bd933adab1","RawContent":"&lt;p&gt; I got married in Islamorada at the Islander Resort in July and was really happy with it.&amp;nbsp; It was affordable (well if you can call anything wedding related affordable! haha!)&amp;nbsp; The Islander is right on the beach and has plenty of space for guests.&amp;nbsp; We had the ceremony and reception on their beach.&amp;nbsp; Right across the street is a restaurant\/bar called Lor-e-lei that has amazing sunset views and had my rehearsal dinner there.&amp;nbsp; My guests were happy that they didn&#039;t have to drive anywhere once they got there (it&#039;s about an hour and half drive from Miami.) &amp;nbsp; I rented a party bus for about 20 friends that wanted to see Key West.&amp;nbsp; It was a blast!&lt;\/p&gt;","Attachments":[],"Id":1358668,"PostDate":1292291321,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I got married in Islamorada at the Islander Resort in July and was really happy with it.\u00a0 It was affordable (well if you can call anything wedding related affordable! haha!)\u00a0 The Islander is right on the beach and has plenty of space for guests.\u00a0 We had the ceremony and reception on their beach.\u00a0 Right across the street is a restaurant\/bar called Lor-e-lei that has amazing sunset views and had my rehearsal dinner there.\u00a0 My guests were happy that they didn't have to drive anywhere once they got there (it's about an hour and half drive from Miami.) \u00a0 I rented a party bus for about 20 friends that wanted to see Key West.\u00a0 It was a blast!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"chrissys76@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1249368393,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-220143.jpg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"stina76","Id":220143,"Name":"stina76","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":58204,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"289f10da06451888b0ccbb231f14d8e8","RawContent":"I&#039;m also getting married at the Islander in Islamorada florida. So far Casey has been great and was willing to work with us on prices since we are having a small wedding, about 30 people. They don&#039;t supply a cake, DJ, flowers and such but they do send you a booklet with recommendations and that helps A LOT! We are having the ceremony and reception there and rhey supply table decorations, tiki torches, ect. I make it to the Keys about once a month and researched a lot before deciding the Islander was the best place for the price. Hope this helps!","Attachments":[],"Id":1548675,"PostDate":1321808342,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I'm also getting married at the Islander in Islamorada florida. So far Casey has been great and was willing to work with us on prices since we are having a small wedding, about 30 people. They don't supply a cake, DJ, flowers and such but they do send you a booklet with recommendations and that helps A LOT! We are having the ceremony and reception there and rhey supply table decorations, tiki torches, ect. I make it to the Keys about once a month and researched a lot before deciding the Islander was the best place for the price. Hope this helps!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><p><span><span style=\"font-size:12px;\"><strong>Jen<\/strong><\/span><\/span><\/p><span><\/span><\/div><\/div>","Email":"07stanggirl@comcast.net","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1321538383,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-247782.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Jber713","Id":247782,"Name":"Jber713","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":58204,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"33739947e09c7a2989db6acea9d84e40","RawContent":"I LOVE the party bus to Key West idea!","Attachments":[],"Id":1548676,"PostDate":1321808396,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I LOVE the party bus to Key West idea!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><p><span><span style=\"font-size:12px;\"><strong>Jen<\/strong><\/span><\/span><\/p><span><\/span><\/div><\/div>","Email":"07stanggirl@comcast.net","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1321538383,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-247782.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Jber713","Id":247782,"Name":"Jber713","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":58204,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"21d25b7c83338ea3b8cc1bb7bfeeb0fb","RawContent":"I am looking for the EXACT same thing and the best deal that i have found has been the club med sandpiper. They offer a free wedding package if you have 20 adults stay for a minimum of three nights (at $170 per person per night). It is an all inclusive resort so you do not have to host your own private reception if you want to save money (since all of your food and alcohol are included with your stay you can ask them to reserve a section of one of their restaurants for your reception, but that means no private dance floor\/music) but we want to do our own private reception and for an open bar for four hours, cocktail\/appetizer hour, and 3 course meal i was quoted $106 per person and DJ for four hours for about $1200. I am not sure about decorations\/centerpieces and such, but it does include the tables, chairs, plates silverware, bartender, servers, ect. Dont know if this is what you are looking for, but thought i would share! Let me know if you want any more information about this option!","Attachments":[],"Id":1651848,"PostDate":1344830234,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I am looking for the EXACT same thing and the best deal that i have found has been the club med sandpiper. They offer a free wedding package if you have 20 adults stay for a minimum of three nights (at $170 per person per night). It is an all inclusive resort so you do not have to host your own private reception if you want to save money (since all of your food and alcohol are included with your stay you can ask them to reserve a section of one of their restaurants for your reception, but that means no private dance floor\/music) but we want to do our own private reception and for an open bar for four hours, cocktail\/appetizer hour, and 3 course meal i was quoted $106 per person and DJ for four hours for about $1200. I am not sure about decorations\/centerpieces and such, but it does include the tables, chairs, plates silverware, bartender, servers, ect. Dont know if this is what you are looking for, but thought i would share! Let me know if you want any more information about this option!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Lmickwee766@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1343256940,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-258350.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"Lmickwee","Id":258350,"Name":"Lmickwee","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":58204,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"026dddb31f76a77d9dc857d9bd486a0e","RawContent":"&lt;p&gt; Im looking to have my wedding in Clearwater Beach at The Sandpearl Resort in 2014. Long ways away! LOL!&lt;\/p&gt;","Attachments":[],"Id":1688793,"PostDate":1353624837,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Im looking to have my wedding in Clearwater Beach at The Sandpearl Resort in 2014. Long ways away! LOL!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"reginanero@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1353607261,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-262599.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"britt1913","Id":262599,"Name":"britt1913","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"73.10.35.253","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":58204,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"320be26a162bf1be4c758547d34a7205","RawContent":"How did everything go for everyone? And what did you decide???","Attachments":[],"Id":1907983,"PostDate":1448985405,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                How did everything go for everyone? And what did you decide???\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"peggygiarrusso@gmail.com","IpAddress":"73.10.35.253","GroupId":39,"GroupName":"Newbie","JoinDate":1447990529,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"Peggyswee","Id":285389,"Name":"Peggyswee","IsOnline":false}}],"Id":"58204","Title":"Any Ideas for A One Stop Shop Beach Resort?","LastPostDate":1448985405},"Pages":{"TotalItems":8,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
