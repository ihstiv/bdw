{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":2,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":481,"MovedTo":null,"MovedOn":0,"FirstPostId":1909353,"Rating":0,"RatingHits":0,"Starter":{"Id":285869,"Name":"cporitz","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1452636878,"LastPoster":{"Id":232000,"Name":"acw271011","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":35,"Preview":{"Id":1909416,"PostDate":1452743814,"PostContent":"@cporitz Congrats on your upcoming destination wedding! \u00a0 I'm a Jamaica bride from 2011 but I'll...","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/'><span style=\"color:#ff0099;\"><em>http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283462599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.92.136.114","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79857,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"f194d6ed1e398a9a24d1015c7b92f44f","RawContent":"&lt;p&gt;We are looking to host our destination wedding in the Florida Keys. I have been reading MANY reviews, but that doesn&#039;t weed out guests who actually had their wedding at the resorts. I&#039;d like to know if anyone had their wedding at a resort in the Florida Keys and recommendations as to a great accommodating (preferably all-inclusive)resorts. Any information would be helpful! Thank-you in advance!&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1909353,"PostDate":1452636878,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>We are looking to host our destination wedding in the Florida Keys. I have been reading MANY reviews, but that doesn't weed out guests who actually had their wedding at the resorts. I'd like to know if anyone had their wedding at a resort in the Florida Keys and recommendations as to a great accommodating (preferably all-inclusive)resorts. Any information would be helpful! Thank-you in advance!\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"cporitz@gmail.com","IpAddress":"70.92.136.114","GroupId":39,"GroupName":"Newbie","JoinDate":1452636646,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"cporitz","Id":285869,"Name":"cporitz","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"70.50.15.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79857,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"230a4e734fc794ef8c2c4ed9a4ea6fc0","RawContent":"&lt;p&gt;@[member=\"cporitz\"] Congrats on your upcoming destination wedding!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I&#039;m a Jamaica bride from 2011 but I&#039;ll admit that when we were looking at group travel, we thought the US would be a better location for us so I looked at Florida, the Keys and also Charleston South Carolina. The one thing I didn&#039;t find was an all inclusive resort. Everything was either breakfast only or no meals at all. I&#039;m not sure why.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I would definitely get in touch with a travel agent. They&#039;re the best ones to recommend resorts while working with your budget and what you want and don&#039;t want. Everyone&#039;s idea of a destination wedding is different. The owners of this site are destination wedding specialists who I&#039;m sure would have access to information that would help you make an informed decision. You can contact them through this site - Wright Travel - and you can check out their reviews as well in the Vendor Review section.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck and enjoy your planning!&lt;\/p&gt;","Attachments":[],"Id":1909416,"PostDate":1452743814,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"285869\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/285869-cporitz\/' title='Member profile'><span itemprop=\"name\">cporitz<\/span><\/a> Congrats on your upcoming destination wedding!<\/p>\n<p>\u00a0<\/p>\n<p>I'm a Jamaica bride from 2011 but I'll admit that when we were looking at group travel, we thought the US would be a better location for us so I looked at Florida, the Keys and also Charleston South Carolina. The one thing I didn't find was an all inclusive resort. Everything was either breakfast only or no meals at all. I'm not sure why.<\/p>\n<p>\u00a0<\/p>\n<p>I would definitely get in touch with a travel agent. They're the best ones to recommend resorts while working with your budget and what you want and don't want. Everyone's idea of a destination wedding is different. The owners of this site are destination wedding specialists who I'm sure would have access to information that would help you make an informed decision. You can contact them through this site - Wright Travel - and you can check out their reviews as well in the Vendor Review section.<\/p>\n<p>\u00a0<\/p>\n<p>Good luck and enjoy your planning!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p><span style=\"color:#ff0099;\"><em>I said \"yes\" again to the love of my life at Grand Coral Beach Club, Playa del Carmen, Mexico on our 4th anniversary - October 20, 2015<\/em><\/span><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/'><span style=\"color:#ff0099;\"><em>http:\/\/www.bestdestinationwedding.com\/topic\/78874-acw271011-so-this-is-not-a-planning-thread-but\/<\/em><\/span><\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283462599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}}],"Id":"79857","Title":"Florida Keys Best Wedding Resort","LastPostDate":1452743814},"Pages":{"TotalItems":2,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
