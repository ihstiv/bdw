{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":46,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":20757,"MovedTo":null,"MovedOn":0,"FirstPostId":996757,"Rating":0,"RatingHits":0,"Starter":{"Id":224476,"Name":"jcarvale","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-224476.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"IsOnline":false},"StartDate":1263504050,"LastPoster":{"Id":255161,"Name":"tynee","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-255161.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":113,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":35,"Preview":{"Id":1808090,"PostDate":1382120038,"PostContent":"Cakes!\u00a0 I did forget. \u00a0 Cakes:\u00a0 http:\/\/www.bobsbunz.com\/ Bob's Bunz, Gloria and Bob are OUTSTANDI...","Author":{"Signature":"","Email":"ayoungou@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1336589389,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-255161.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"tynee","Id":255161,"Name":"tynee","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":false,"TopicId":47087,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8cc04e04ea3e5da8756074c8ddbd45ad","RawContent":"&lt;p&gt; Hi Ladies,&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;For all you Brides looking to get married in Islamorada, there are so many amazing locations in town that you will never find on-line. I see a lot of the big resorts listed but if you are interested in renting a private house or a boutique resort there are tons of options that leave you being able to personalize your wedding more so than what a resort has to offer.&amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; &amp;nbsp;I&#039;m a local wedding planner here in Islamorada and have tons of resources to help you ladies find all the right vendors and locations. Please take a look at my FB page to see pictures of past weddings.&lt;\/p&gt; &lt;p&gt; www.facebook.com\/bluewaterweddings&lt;\/p&gt; &lt;p&gt; and my website&lt;\/p&gt; &lt;p&gt; www.Blue-Water-Weddings.com&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I can save you tons on using local vendors that don&#039;t charge to drive from miami.&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; I also own an event design store at mm80 and rent out all of the decor you could imagine, not just tables and chairs, but centerpieces, napkin rings, colored\/printed linens, card boxes,lounge furniture,&amp;nbsp;custom made signs, seating charts, menus, programs, all the cool stuff on Etsy you want we have at a huge discount !&lt;\/p&gt; &lt;p&gt; It saves you a ton to rent items, as well as convienece of not having to ship and lug it all down &amp;nbsp;with you&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; We do design meetings via Skype as well for all you brides who can&#039;t make it down in person!&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Blue Water Weddings is a must for all Florida Keys Brides&lt;\/p&gt; &lt;p&gt; &amp;nbsp;&lt;\/p&gt; &lt;p&gt; Danielle Smith&lt;\/p&gt; &lt;p&gt; 305-240-0646&lt;\/p&gt; &lt;p&gt; Danielle@blue-water-weddings.com&lt;\/p&gt;","Attachments":[],"Id":1742092,"PostDate":1365100592,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Hi Ladies,<\/p> <p> \u00a0<\/p> <p> \u00a0For all you Brides looking to get married in Islamorada, there are so many amazing locations in town that you will never find on-line. I see a lot of the big resorts listed but if you are interested in renting a private house or a boutique resort there are tons of options that leave you being able to personalize your wedding more so than what a resort has to offer.\u00a0<\/p> <p> \u00a0<\/p> <p> \u00a0I'm a local wedding planner here in Islamorada and have tons of resources to help you ladies find all the right vendors and locations. Please take a look at my FB page to see pictures of past weddings.<\/p> <p> www.facebook.com\/bluewaterweddings<\/p> <p> and my website<\/p> <p> www.Blue-Water-Weddings.com<\/p> <p> \u00a0<\/p> <p> I can save you tons on using local vendors that don't charge to drive from miami.<\/p> <p> \u00a0<\/p> <p> I also own an event design store at mm80 and rent out all of the decor you could imagine, not just tables and chairs, but centerpieces, napkin rings, colored\/printed linens, card boxes,lounge furniture,\u00a0custom made signs, seating charts, menus, programs, all the cool stuff on Etsy you want we have at a huge discount !<\/p> <p> It saves you a ton to rent items, as well as convienece of not having to ship and lug it all down \u00a0with you<\/p> <p> \u00a0<\/p> <p> We do design meetings via Skype as well for all you brides who can't make it down in person!<\/p> <p> \u00a0<\/p> <p> Blue Water Weddings is a must for all Florida Keys Brides<\/p> <p> \u00a0<\/p> <p> Danielle Smith<\/p> <p> 305-240-0646<\/p> <p> Danielle@blue-water-weddings.com<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"danielle@blue-water-weddings.com","IpAddress":"","GroupId":5,"GroupName":"Banned","JoinDate":1365099841,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"BlueWaterWed","Id":268177,"Name":"BlueWaterWed","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":47087,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"819992f7db995ea84277a1209ba845e3","RawContent":"I am also getting married at the post card inn! October 3rd:) I am also researching all of these kinds of vendors too. Please let me know what you find as well! Congrats&lt;3","Attachments":[],"Id":1756015,"PostDate":1368082327,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I am also getting married at the post card inn! October 3rd:) I am also researching all of these kinds of vendors too. Please let me know what you find as well! Congrats<3\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"fettersjessica@gmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1368082198,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-269426.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"fettersjessica","Id":269426,"Name":"fettersjessica","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":47087,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"646d175acddd8f2af8b259d3f6302377","RawContent":"Sorry for the delayed response. i was out of the country the last few weeks. We are using dillon photography. They are based out of palm beach. I tried to use bob care because the hotel highly recommended him, but he was already booked for our date. I found most of the photographers in the area to be very expensive. We are having a steel drum player on the beach for the ceremony and a dj during the reception upstairs in the horizon room. Reel ting is providing both services. They are a band, but also offer just a one man show and other types of musicians as well. The steel drum player also djs so it worked out to be better for our needs. Hotel highly recommended and we were able to hear him play at another wedding and loved him which was why we booked. Hope this helps! My problem has been finding a florist. Any suggestions?","Attachments":[],"Id":1760528,"PostDate":1369333756,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Sorry for the delayed response. i was out of the country the last few weeks. We are using dillon photography. They are based out of palm beach. I tried to use bob care because the hotel highly recommended him, but he was already booked for our date. I found most of the photographers in the area to be very expensive. We are having a steel drum player on the beach for the ceremony and a dj during the reception upstairs in the horizon room. Reel ting is providing both services. They are a band, but also offer just a one man show and other types of musicians as well. The steel drum player also djs so it worked out to be better for our needs. Hotel highly recommended and we were able to hear him play at another wedding and loved him which was why we booked. Hope this helps! My problem has been finding a florist. Any suggestions?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"jemichna@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1363014662,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-267188.jpeg?_r=0","PhotoWidth":200,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"julikam","Id":267188,"Name":"julikam","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":47087,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ae6a0825c88703876be5cdb10b5ab7b0","RawContent":"Hi! I am planning my wedding for March 2015 in Islamorada. Pretty sure we are going with The Islander. Just was wondering how your wedding turned out there? Also, you said your were able to negotiate price with them and I am just curious in what ways were you able to? Thanks for any info!!","Attachments":[],"Id":1807676,"PostDate":1381986455,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hi! I am planning my wedding for March 2015 in Islamorada. Pretty sure we are going with The Islander. Just was wondering how your wedding turned out there? Also, you said your were able to negotiate price with them and I am just curious in what ways were you able to? Thanks for any info!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"Alegnabea@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1381986027,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-274314.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Alegnabea","Id":274314,"Name":"Alegnabea","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":47087,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"db5786c28bfff4d7177492f0901ea5ab","RawContent":"&lt;p&gt;&amp;nbsp;We just got married in Islamorada, loved it.&amp;nbsp; All of our vendors were recommended locally and were awesome.&amp;nbsp; Here&#039;s a list of those we used, great group of people:&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;&lt;strong&gt;&lt;u&gt;Day-of-Coordinator&lt;\/u&gt;&lt;\/strong&gt;:  &amp;nbsp;&lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.blue-water-weddings.com\/\"&gt;http:\/\/www.blue-water-weddings.com\/&lt;\/a&gt;&lt;\/p&gt; &lt;p&gt;Julia with Blue Water Weddings was worth her weight in gold.&amp;nbsp; She listed her service as a day-of-coordinator, but she worked for many days, relentlessly bringing up, covering, and taking care of every little detail, many of which we had not even considered.&amp;nbsp; We didn&#039;t even know how much we needed her until the day came, and she handled all the craziness like a pro, never breaking a sweat.&amp;nbsp; Best wedding idea ever.&amp;nbsp; Unending patience.&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;&lt;u&gt;Caterer&lt;\/u&gt;:&amp;nbsp; &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.alittletasteofthekeys.com\/\"&gt;http:\/\/www.alittletasteofthekeys.com\/&lt;\/a&gt;&lt;\/p&gt; &lt;p&gt;Cheryl with A little Taste of the Keys&amp;nbsp;was awesome.&amp;nbsp; Very efficient, flexible, and customized her menu to fit us.&amp;nbsp; Great price too.&amp;nbsp; She catered the rehearsal dinner and reception, delicious&amp;nbsp;fresh food, some of it made on site.&amp;nbsp; Stellar job.&amp;nbsp; She has a preferred bartender too she can recommend.&amp;nbsp; He was the life of the party.&amp;nbsp; I believe his name was Richmond?&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;&lt;u&gt;Flowers:&lt;\/u&gt;   &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.floralfantasyweddings.com\/\"&gt;http:\/\/www.floralfantasyweddings.com\/&lt;\/a&gt;&lt;\/p&gt; &lt;p&gt;Floral Fantasy is a&amp;nbsp;very cozy&amp;nbsp;shop, seemed to be a mom and daughter business, but they nailed it.&amp;nbsp; Very good value, perfect arrangements, and all we showed them was a few photos of what we liked and they ran with it and offered great suggestions.&amp;nbsp; the flowers are still alive days later.&amp;nbsp; Surprising value as well.&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;&lt;u&gt;Photographer:&lt;\/u&gt;  &amp;nbsp; &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.bobcareweddings.com\/\"&gt;http:\/\/www.bobcareweddings.com\/&lt;\/a&gt;&lt;\/p&gt; &lt;p&gt;Bob Care had a two photographer team, plus the videographer.&amp;nbsp; He was very easy to deal with, open to new suggestions and unique ideas, had valuable recommendations on schedule, and from what he showed us during the night, a great knack for catching the \"feel\" of the event.&amp;nbsp; His team was unobtrusive, and typically melted into the background.&amp;nbsp; Very excited for the results.&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;&lt;u&gt;DJ:&lt;\/u&gt;   &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.weddingwire.com\/reviews\/russ-ginsberg-djmchost-plantation\/de6a1b2ea0311cee.html\"&gt;http:\/\/www.weddingwire.com\/reviews\/russ-ginsberg-djmchost-plantation\/de6a1b2ea0311cee.html&lt;\/a&gt;&lt;\/p&gt; &lt;p&gt;Russ Ginsberg&amp;nbsp;was another lucky find.&amp;nbsp; Effortless to work with, very organized, excellent value, and knew how to play the right music at the right time.&amp;nbsp; We were worried since we&#039;d never seen him perform and handle a crowd, but he brought great energy to the night.&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;&lt;u&gt;Steel Drummer:&lt;\/u&gt;  &amp;nbsp; &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/21stcenturysteelband.com\/home.htm\"&gt;http:\/\/21stcenturysteelband.com\/home.htm&lt;\/a&gt;&lt;\/p&gt; &lt;p&gt;Michael Kernahan delivered a two-man team, hassle free, very island-like feel, and just rolled with any request or schedule change we had.&amp;nbsp; Both our families loved this touch.&amp;nbsp; And the value was unbeatable.&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;&lt;u&gt;Cigar Roller&lt;\/u&gt;:   Magic City Cigars&lt;\/p&gt; &lt;p&gt;Waldo, brought another man, Oswald I believe.&amp;nbsp; Can&#039;t list the website, but not hard to find.&amp;nbsp; Very authentic, very nice, our guests loved this touch.&amp;nbsp; Perfect for cocktail hour.&amp;nbsp; Highly recommended.&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;Ok, that&#039;s all I can think of for now.  I&#039;m probably leaving others off, and I apologize.&amp;nbsp; Hopefully this will help anyone with planning needs or recommendations.&amp;nbsp; Good luck all.&lt;\/p&gt; &lt;p&gt;-Happy Groom&lt;\/p&gt;","Attachments":[],"Id":1808085,"PostDate":1382119621,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>\u00a0We just got married in Islamorada, loved it.\u00a0 All of our vendors were recommended locally and were awesome.\u00a0 Here's a list of those we used, great group of people:<\/p> <p>\u00a0<\/p> <p><strong><u>Day-of-Coordinator<\/u><\/strong>:\u00a0\u00a0\u00a0<a href='http:\/\/www.blue-water-weddings.com\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.blue-water-weddings.com\/<\/a><\/p> <p>Julia with Blue Water Weddings was worth her weight in gold.\u00a0 She listed her service as a day-of-coordinator, but she worked for many days, relentlessly bringing up, covering, and taking care of every little detail, many of which we had not even considered.\u00a0 We didn't even know how much we needed her until the day came, and she handled all the craziness like a pro, never breaking a sweat.\u00a0 Best wedding idea ever.\u00a0 Unending patience.<\/p> <p>\u00a0<\/p> <p><u>Caterer<\/u>:\u00a0 <a href='http:\/\/www.alittletasteofthekeys.com\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.alittletasteofthekeys.com\/<\/a><\/p> <p>Cheryl with A little Taste of the Keys\u00a0was awesome.\u00a0 Very efficient, flexible, and customized her menu to fit us.\u00a0 Great price too.\u00a0 She catered the rehearsal dinner and reception, delicious\u00a0fresh food, some of it made on site.\u00a0 Stellar job.\u00a0 She has a preferred bartender too she can recommend.\u00a0 He was the life of the party.\u00a0 I believe his name was Richmond?<\/p> <p>\u00a0<\/p> <p><u>Flowers:<\/u>\u00a0\u00a0 <a href='http:\/\/www.floralfantasyweddings.com\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.floralfantasyweddings.com\/<\/a><\/p> <p>Floral Fantasy is a\u00a0very cozy\u00a0shop, seemed to be a mom and daughter business, but they nailed it.\u00a0 Very good value, perfect arrangements, and all we showed them was a few photos of what we liked and they ran with it and offered great suggestions.\u00a0 the flowers are still alive days later.\u00a0 Surprising value as well.<\/p> <p>\u00a0<\/p> <p><u>Photographer:<\/u>\u00a0\u00a0\u00a0 <a href='http:\/\/www.bobcareweddings.com\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.bobcareweddings.com\/<\/a><\/p> <p>Bob Care had a two photographer team, plus the videographer.\u00a0 He was very easy to deal with, open to new suggestions and unique ideas, had valuable recommendations on schedule, and from what he showed us during the night, a great knack for catching the \"feel\" of the event.\u00a0 His team was unobtrusive, and typically melted into the background.\u00a0 Very excited for the results.<\/p> <p>\u00a0<\/p> <p><u>DJ:<\/u>\u00a0\u00a0 <a href='http:\/\/www.weddingwire.com\/reviews\/russ-ginsberg-djmchost-plantation\/de6a1b2ea0311cee.html' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.weddingwi...2ea0311cee.html<\/a><\/p> <p>Russ Ginsberg\u00a0was another lucky find.\u00a0 Effortless to work with, very organized, excellent value, and knew how to play the right music at the right time.\u00a0 We were worried since we'd never seen him perform and handle a crowd, but he brought great energy to the night.<\/p> <p>\u00a0<\/p> <p><u>Steel Drummer:<\/u>\u00a0\u00a0\u00a0 <a href='http:\/\/21stcenturysteelband.com\/home.htm' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/21stcenturyst...nd.com\/home.htm<\/a><\/p> <p>Michael Kernahan delivered a two-man team, hassle free, very island-like feel, and just rolled with any request or schedule change we had.\u00a0 Both our families loved this touch.\u00a0 And the value was unbeatable.<\/p> <p>\u00a0<\/p> <p><u>Cigar Roller<\/u>:\u00a0\u00a0 Magic City Cigars<\/p> <p>Waldo, brought another man, Oswald I believe.\u00a0 Can't list the website, but not hard to find.\u00a0 Very authentic, very nice, our guests loved this touch.\u00a0 Perfect for cocktail hour.\u00a0 Highly recommended.<\/p> <p>\u00a0<\/p> <p>Ok, that's all I can think of for now.\u00a0\u00a0I'm probably leaving others off, and I apologize.\u00a0 Hopefully this will help anyone with planning needs or recommendations.\u00a0 Good luck all.<\/p> <p>-Happy Groom<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ayoungou@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1336589389,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-255161.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"tynee","Id":255161,"Name":"tynee","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":47087,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d3654b4e88022196be9e59aa057e756b","RawContent":"&lt;p&gt;Cakes!&amp;nbsp; I did forget.&lt;\/p&gt; &lt;p&gt;&amp;nbsp;&lt;\/p&gt; &lt;p&gt;&lt;u&gt;Cakes:&amp;nbsp;&lt;\/u&gt; &lt;a data-ipb=&#039;nomediaparse&#039; href=\"http:\/\/www.bobsbunz.com\/\"&gt;http:\/\/www.bobsbunz.com\/&lt;\/a&gt;&lt;\/p&gt; &lt;p&gt;Bob&#039;s Bunz, Gloria and Bob are OUTSTANDING.&amp;nbsp; We had a tower of personal mini key lime bunt cakes.&amp;nbsp; They also provided an amazing key lime cheesecake for the grooms cake (bride insisted on this, I relented).&amp;nbsp; And a small topper cake for us to cut.&amp;nbsp; Bob worked some magic into those pastries, and Gloria was&amp;nbsp;one of those happy people you never forget.&amp;nbsp; They also provided key lime cookies for the hotel favors.&amp;nbsp; Don&#039;t pass them up.&lt;\/p&gt;","Attachments":[],"Id":1808090,"PostDate":1382120038,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Cakes!\u00a0 I did forget.<\/p> <p>\u00a0<\/p> <p><u>Cakes:\u00a0<\/u> <a href='http:\/\/www.bobsbunz.com\/' class='bbc_url' title='External link' rel='nofollow external'>http:\/\/www.bobsbunz.com\/<\/a><\/p> <p>Bob's Bunz, Gloria and Bob are OUTSTANDING.\u00a0 We had a tower of personal mini key lime bunt cakes.\u00a0 They also provided an amazing key lime cheesecake for the grooms cake (bride insisted on this, I relented).\u00a0 And a small topper cake for us to cut.\u00a0 Bob worked some magic into those pastries, and Gloria was\u00a0one of those happy people you never forget.\u00a0 They also provided key lime cookies for the hotel favors.\u00a0 Don't pass them up.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ayoungou@hotmail.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1336589389,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-255161.jpeg?_r=0","PhotoWidth":150,"PhotoHeight":113,"PhotoType":"custom"},"FormattedName":"tynee","Id":255161,"Name":"tynee","IsOnline":false}}],"Id":"47087","Title":"Islamorada, Florida","LastPostDate":1382120038},"Pages":{"TotalItems":46,"TotalPages":5,"CurrentPage":40,"NextPage":-1,"PreviousPage":30,"LastPage":40},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
