 know if their salon will be good and I am worried about the make-up and hairdo. Are other brides to be going to do your own makeup and hair? I am thinking of flying someone to the resort, but it&#039;s just soooooooooo expensive to pay for their fee, hotel, and airefare.","Attachments":[],"Id":360231,"PostDate":1214649191,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Congradulations !!!<br \/> I am waiting on my confirmation as well.<br \/> It's a new resort so don't know if their salon will be good and I am worried about the make-up and hairdo. Are other brides to be going to do your own makeup and hair? I am thinking of flying someone to the resort, but it's just soooooooooo expensive to pay for their fee, hotel, and airefare.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tsefang-wang@yahoo.ca","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1214268425,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-210118.gif?_r=0","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"FormattedName":"rtswan","Id":210118,"Name":"rtswan","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":18414,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"c01352d5b401aba3e1556d7495cb6746","RawContent":"I think this was originally going to be the Azul Blue, correct? The photos look the same as the stock ones they provided me. I visited the hotel when it was still a construction site back in Nov &#039;07. Can&#039;t wait to hear all your reviews!","Attachments":[],"Id":360237,"PostDate":1214653724,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I think this was originally going to be the Azul Blue, correct? The photos look the same as the stock ones they provided me. I visited the hotel when it was still a construction site back in Nov '07. Can't wait to hear all your reviews!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Happily married since May 4, 2008!!!<\/span><br><br><a data-ipb='nomediaparse' href=\"http:\/\/www.elizabethmedinaphotography.com\/SC\/\"><strong>Al Cielo Wedding Slideshow - Elizabeth Medina<\/strong><\/a><span> <\/span><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t22339\">bdw thread<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t22093\">Grand Riviera Princess Resort Stay & Pre-Wedding Events Review<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t22120\">Wedding Day Stuff<\/a><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t22155\"><strong>Al Cielo Wedding & Vendor Review<\/strong><\/a><a data-ipb='nomediaparse' href=\"http:\/\/bestdestinationwedding.com\/forum\/t22175\">Group Outing to Hidden Worlds & Tulum Review<\/a><\/div><\/div>","Email":"nyla373@yahoo.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1188630472,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-207692.gif?_r=0","PhotoWidth":75,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"nylalany","Id":207692,"Name":"nylalany","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":18414,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"1ffcd4bc04329c4a485b62a7faff36ee","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;nylalany&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;I think this was originally going to be the Azul Blue, correct? The photos look the same as the stock ones they provided me. I visited the hotel when it was still a construction site back in Nov &#039;07. Can&#039;t wait to hear all your reviews!&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;Azul Blue is now Eurostars Blue Tulum. So confusing! I&#039;m not sure when construction started on Azul View (Sensatori) or Azul Fives.","Attachments":[],"Id":360686,"PostDate":1214698063,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>nylalany<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">I think this was originally going to be the Azul Blue, correct? The photos look the same as the stock ones they provided me. I visited the hotel when it was still a construction site back in Nov '07. Can't wait to hear all your reviews!<\/div> <\/td> <\/tr> <\/table> <\/div>Azul Blue is now Eurostars Blue Tulum. So confusing! I'm not sure when construction started on Azul View (Sensatori) or Azul Fives.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>Photography by Tamm's Photos<\/span><br><a data-ipb='nomediaparse' href=\"http:\/\/www.ezticker.com\/ticker\/466\/192\/20090425\/Our+Wedding+in+Riviera+Maya\/ticker.png\">http:\/\/www.ezticker.com\/ticker\/466\/1...aya\/ticker.png<\/a><\/div><\/div>","Email":"behm.11@osu.edu","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1200485158,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-208250.gif?_r=0","PhotoWidth":67,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"JHarwood2Be","Id":208250,"Name":"JHarwood2Be","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":18414,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"295a8b3286833206864706afce01cafe","RawContent":"&lt;div style=\"margin:20px; margin-top:5px; \"&gt; &lt;div class=\"smallfont\"&gt;Quote:&lt;\/div&gt; &lt;table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"&gt; &lt;tr&gt; &lt;td class=\"alt2\" style=\"border:1px inset\"&gt;  Originally Posted by &lt;strong&gt;JHarwood2Be&lt;\/strong&gt; &lt;img class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"&gt;  &lt;div style=\"font-style:italic\"&gt;I think if you bring a few pictures for your hair, they should be able to replicate it. I plan on bringing my own make-up and maybe have a friend do it for me. I&#039;ll probably go to a dept store\/Sephora to see how to do it first.&lt;\/div&gt; &lt;\/td&gt; &lt;\/tr&gt; &lt;\/table&gt; &lt;\/div&gt;That&#039;s what a friend of mine told me as well. Go to a department store and ask their makeup artist\/consultant to do my make-up and then just buy the products and colours used on me and do my own makeup on the wedding date. I hope I have the talent.","Attachments":[],"Id":361046,"PostDate":1214733222,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <div  style=\"margin:20px\"> <div class=\"smallfont\">Quote:<\/div> <table cellpadding=\"6\" cellspacing=\"0\" border=\"0\" width=\"99%\"> <tr> <td class=\"alt2\" style=\"border:1px inset\">  Originally Posted by <strong>JHarwood2Be<\/strong> <span rel='lightbox'><img class='bbc_img' class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" border=\"0\" alt=\"View Post\"><\/span>  <div  style=\"font-style:italic\">I think if you bring a few pictures for your hair, they should be able to replicate it. I plan on bringing my own make-up and maybe have a friend do it for me. I'll probably go to a dept store\/Sephora to see how to do it first.<\/div> <\/td> <\/tr> <\/table> <\/div>That's what a friend of mine told me as well. Go to a department store and ask their makeup artist\/consultant to do my make-up and then just buy the products and colours used on me and do my own makeup on the wedding date. I hope I have the talent.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"tsefang-wang@yahoo.ca","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1214268425,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-210118.gif?_r=0","PhotoWidth":200,"PhotoHeight":151,"PhotoType":"custom"},"FormattedName":"rtswan","Id":210118,"Name":"rtswan","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":18414,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"8672ea7f70e29320c7bf7dc9a1a340eb","RawContent":"I am also waiting for my confirmation from Azul Sensatori. &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/popcorn.gif\" border=\"0\" alt=\"\" title=\"Popcorn\" class=\"inlineimg\" \/&gt; Do any of you know which photographer you&#039;ll be using? I really love the work of Sol Tamargo and Matt Adcock but they&#039;re banned from Karisma hotels &lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/crybaby2.gif\" border=\"0\" alt=\"\" title=\"Crybaby2\" class=\"inlineimg\" \/&gt;","Attachments":[],"Id":362375,"PostDate":1214853239,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I am also waiting for my confirmation from Azul Sensatori. <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/popcorn.gif\" border=\"0\" alt=\"\" title=\"Popcorn\" class=\"inlineimg\" \/><\/span> Do any of you know which photographer you'll be using? I really love the work of Sol Tamargo and Matt Adcock but they're banned from Karisma hotels <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/crybaby2.gif\" border=\"0\" alt=\"\" title=\"Crybaby2\" class=\"inlineimg\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i485.photobucket.com\/albums\/rr213\/lenka144\/i6A4434A9-3306-4049-B196-5E7D486-1.jpg\">http:\/\/i485.photobucket.com\/albums\/r...-5E7D486-1.jpg<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10716;405\/st\/20091114\/e\/Our+Wedding+Day\/k\/4a07\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...4a07\/event.png<\/a><\/div><\/div>","Email":"lenka14@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1208995373,"Photo":{"HasPhoto":true,"PhotoUrl":"https:\/\/bdw-stevewright.netdna-ssl.com\/cdn\/profile\/photo-209168.gif?_r=0","PhotoWidth":91,"PhotoHeight":100,"PhotoType":"custom"},"FormattedName":"lenka14","Id":209168,"Name":"lenka14","IsOnline":false}}],"Pages":{"TotalItems":19275,"TotalPages":1928,"CurrentPage":10,"NextPage":20,"PreviousPage":0,"LastPage":19270},"PushNotifications":[{"Key":"notifications","Valu