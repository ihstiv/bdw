":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":1700,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"433663bb0eb1fa59fb30a9e3eb05dca6","RawContent":"I cannot find one of mine on a model because my dress is an last seasons davids bridal-oh but I always think things look better on real people. Did you all hear there is a congress man from NY who wants to set up weight guidelines for models!!! Yeah","Attachments":[],"Id":22927,"PostDate":1170385087,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I cannot find one of mine on a model because my dress is an last seasons davids bridal-oh but I always think things look better on real people. Did you all hear there is a congress man from NY who wants to set up weight guidelines for models!!! Yeah\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<strong>Christine + Will (married 7\/20\/07) + Ainsleigh (born 6\/25\/08) + Nolan (born 11\/9\/10) + Delaney (born 12\/31\/13) = One Very Happy Family!<\/strong>","Email":"christine@dc-hulls.com","IpAddress":"167.154.70.240","GroupId":46,"GroupName":"VIP Member","JoinDate":1165971180,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-206965.gif?_r=0","PhotoWidth":100,"PhotoHeight":67,"PhotoType":"custom"},"FormattedName":"Christine","Id":206965,"Name":"Christine","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","I