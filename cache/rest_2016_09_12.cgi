{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":14,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":1945,"MovedTo":null,"MovedOn":0,"FirstPostId":1256779,"Rating":0,"RatingHits":0,"Starter":{"Id":231387,"Name":"dai69","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-231387.JPG?_r=0","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"IsOnline":false},"StartDate":1282064918,"LastPoster":{"Id":278719,"Name":"BarbaraBusybee","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-278719.jpg?_r=1404077494","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":88,"Preview":{"Id":1256779,"PostDate":1282064918,"PostContent":"We are planning our cruise wedding on embarkment day.  I've heard that this can be a rushed situ...","Author":{"Signature":"","Email":"det1969@aol.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1281894408,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-231387.JPG?_r=0","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"dai69","Id":231387,"Name":"dai69","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":56094,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"68c0489bfa3871ef824b1c6058d48e64","RawContent":"&lt;p&gt; We are planning our cruise wedding on embarkment day.&lt;\/p&gt; &lt;p&gt; I&#039;ve heard that this can be a rushed situation because you have to get to the ship hours before your wedding takes place.&lt;\/p&gt; &lt;p&gt; At the same time, I&#039;ve heard this is the best way to include your non-sailing guest. That is the #1 reason we are doing ours this way. At any rate, I would like to hear from those who have done embarkment day weddings, as well as anyone else who had their wedding on the ship. What was YOUR experience?&lt;\/p&gt;","Attachments":[],"Id":1256779,"PostDate":1282064918,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> We are planning our cruise wedding on embarkment day.<\/p> <p> I've heard that this can be a rushed situation because you have to get to the ship hours before your wedding takes place.<\/p> <p> At the same time, I've heard this is the best way to include your non-sailing guest. That is the #1 reason we are doing ours this way. At any rate, I would like to hear from those who have done embarkment day weddings, as well as anyone else who had their wedding on the ship. What was YOUR experience?<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"det1969@aol.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1281894408,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-231387.JPG?_r=0","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"dai69","Id":231387,"Name":"dai69","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":56094,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"567aae596a6cb230f8092c44db6221d9","RawContent":"&lt;p&gt; I&#039;m curious to hear about this too as we&#039;re doing the same thing!&lt;\/p&gt;","Attachments":[],"Id":1257039,"PostDate":1282079621,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I'm curious to hear about this too as we're doing the same thing!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><span>~*~*~Emily & Chuck~*~*~ January 10, 2011~*~*~ Carnival Inspiration~*~*~<\/span><\/div><\/div>","Email":"emilypark78@gmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1265900025,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-225521.jpg?_r=0","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"emilyk78","Id":225521,"Name":"emilyk78","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":56094,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"f3e5a7234ec25bced92ed8a2dee3a1bc","RawContent":"&lt;p&gt; I&#039;m having an embarkation day wedding....TOMORROW! &lt;img alt=\"\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/pinkie.gif\" title=\"\" \/&gt;  &amp;nbsp; Our wedding will be at 1 p.m. but we have to be at the port at 11.&amp;nbsp; I think the only thing that feels rushed is the reception because it can only be an hour or an hour and a half depending on which package you choose....because your non-sailing guests have to get off the ship before it leaves.&amp;nbsp; We&#039;ll be back on the 27th, so I&#039;ll come back and let you know how it went!&lt;\/p&gt;","Attachments":[],"Id":1257593,"PostDate":1282128599,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I'm having an embarkation day wedding....TOMORROW! <span rel='lightbox'><img class='bbc_img' alt=\"\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/pinkie.gif\" title=\"\" \/><\/span>\u00a0\u00a0\u00a0 Our wedding will be at 1 p.m. but we have to be at the port at 11.\u00a0 I think the only thing that feels rushed is the reception because it can only be an hour or an hour and a half depending on which package you choose....because your non-sailing guests have to get off the ship before it leaves.\u00a0 We'll be back on the 27th, so I'll come back and let you know how it went!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/img.weddingcountdown.com\/ticker\/4p0r2jk.png\">http:\/\/img.weddingcountdown.com\/ticker\/4p0r2jk.png<\/a><\/div><\/div>","Email":"hunniebee724@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1244305672,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-218181.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"hunniebee724","Id":218181,"Name":"hunniebee724","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":56094,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"276094d2fa7319b899a2136876ec59e1","RawContent":"[quote]\nOriginally Posted by [b]hunniebee724[\/b] \/img\/forum\/go_quote.gif\n \n \n I&#039;m having an embarkation day wedding....TOMORROW! [img]http:\/\/files.bestdestinationwedding.com\/images\/smilies\/pinkie.gif[\/img]    Our wedding will be at 1 p.m. but we have to be at the port at 11.  I think the only thing that feels rushed is the reception because it can only be an hour or an hour and a half depending on which package you choose....because your non-sailing guests have to get off the ship before it leaves.  We&#039;ll be back on the 27th, so I&#039;ll come back and let you know how it went![\/quote] \n \n \n How exciting!  Happy almost wedding day!! \n   \n I did my wedding in port during the cruise.  I think either way there will be stress.  Embarkation day weddings are really rushed.  In port weddings come with lots of stress regarding the ship making it to port, being on time, etc. \n   \n Oh my, I really need to start planning another cruise!  They are so much fun!","Attachments":[],"Id":1257606,"PostDate":1282129008,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <br \/> <br \/> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>hunniebee724<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" style=\"border-right: 0px solid; border-top: 0px solid; border-left: 0px solid; border-bottom: 0px solid\" \/><\/span><br \/> <br \/> <p> I'm having an embarkation day wedding....TOMORROW! <span rel='lightbox'><img class='bbc_img' alt=\"\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/pinkie.gif\" title=\"\" \/><\/span>\u00a0\u00a0\u00a0 Our wedding will be at 1 p.m. but we have to be at the port at 11.\u00a0 I think the only thing that feels rushed is the reception because it can only be an hour or an hour and a half depending on which package you choose....because your non-sailing guests have to get off the ship before it leaves.\u00a0 We'll be back on the 27th, so I'll come back and let you know how it went!<\/p> <\/blockquote> <p> <br \/> <br \/> How exciting!\u00a0 Happy almost wedding day!!<\/p> <p> \u00a0<\/p> <p> I did my wedding in port during the cruise.\u00a0 I think either way there will be stress.\u00a0 Embarkation day weddings are really rushed.\u00a0 In port weddings come with lots of stress regarding the ship making it to port, being on time, etc.<\/p> <p> \u00a0<\/p> <p> Oh my, I really need to start planning another cruise!\u00a0 They are so much fun!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"andreajphillips@gmail.com","IpAddress":"172.56.10.56","GroupId":46,"GroupName":"VIP Member","JoinDate":1213805820,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":"none"},"FormattedName":"Banana11","Id":210029,"Name":"Banana11","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":56094,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3b67442d231d651141f1329b13096f71","RawContent":"[quote]\nOriginally Posted by [b]hunniebee724[\/b] \/img\/forum\/go_quote.gif\n \n \n I&#039;m having an embarkation day wedding....TOMORROW! [img]http:\/\/files.bestdestinationwedding.com\/images\/smilies\/pinkie.gif[\/img]    Our wedding will be at 1 p.m. but we have to be at the port at 11.  I think the only thing that feels rushed is the reception because it can only be an hour or an hour and a half depending on which package you choose....because your non-sailing guests have to get off the ship before it leaves.  We&#039;ll be back on the 27th, so I&#039;ll come back and let you know how it went![\/quote] \n \n Wow! Excitement is in the air. I can&#039;t wait to hear your details. Have a great time.","Attachments":[],"Id":1257836,"PostDate":1282136181,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <br \/> <br \/> \u00a0<\/p> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>hunniebee724<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" style=\"border-bottom: 0px solid; border-left: 0px solid; border-top: 0px solid; border-right: 0px solid\" \/><\/span><br \/> <br \/> <p> I'm having an embarkation day wedding....TOMORROW! <span rel='lightbox'><img class='bbc_img' alt=\"\" src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/pinkie.gif\" title=\"\" \/><\/span>\u00a0\u00a0\u00a0 Our wedding will be at 1 p.m. but we have to be at the port at 11.\u00a0 I think the only thing that feels rushed is the reception because it can only be an hour or an hour and a half depending on which package you choose....because your non-sailing guests have to get off the ship before it leaves.\u00a0 We'll be back on the 27th, so I'll come back and let you know how it went!<\/p> <\/blockquote> <p> <br \/> Wow! Excitement is in the air. I can't wait to hear your details. Have a great time.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"det1969@aol.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1281894408,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-231387.JPG?_r=0","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"dai69","Id":231387,"Name":"dai69","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":56094,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3d41d3a5cdf32bacda63840e4c377afa","RawContent":"[quote]\nOriginally Posted by [b]~Andrea~[\/b] \/img\/forum\/go_quote.gif\n \n \n \n \n \n \n How exciting!  Happy almost wedding day!! \n   \n I did my wedding in port during the cruise.  I think either way there will be stress.  Embarkation day weddings are really rushed.  In port weddings come with lots of stress regarding the ship making it to port, being on time, etc. \n   \n Oh my, I really need to start planning another cruise!  They are so much fun![\/quote] \n \n I actually saw your review on my 1st day on this site which was just the other day. You guys look like you had a great time. On our very first cruise we went to Cozumel and also did Paradise Beach. Loved it!!\n   \n Thanks for sharing your review.","Attachments":[],"Id":1257871,"PostDate":1282137657,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <br \/> <br \/> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>~Andrea~<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" style=\"border-bottom: 0px solid; border-left: 0px solid; border-top: 0px solid; border-right: 0px solid\" \/><\/span><br \/> <br \/> <br \/> <br \/> <p> <br \/> <br \/> How exciting!\u00a0 Happy almost wedding day!!<\/p> <p> \u00a0<\/p> <p> I did my wedding in port during the cruise.\u00a0 I think either way there will be stress.\u00a0 Embarkation day weddings are really rushed.\u00a0 In port weddings come with lots of stress regarding the ship making it to port, being on time, etc.<\/p> <p> \u00a0<\/p> <p> Oh my, I really need to start planning another cruise!\u00a0 They are so much fun!<\/p> <\/blockquote> <p> <br \/> I actually saw your review on my 1st day on this site which was just the other day. You guys look like you had a great time. On our very first cruise we went to Cozumel and also did Paradise Beach. Loved it!!<br \/> \u00a0<\/p> <p> Thanks for sharing your review.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"det1969@aol.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1281894408,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-231387.JPG?_r=0","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"dai69","Id":231387,"Name":"dai69","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":56094,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"1b9cb6a995a24de1265042f1e8a7428c","RawContent":"[quote]\nOriginally Posted by [b]~Andrea~[\/b] \/img\/forum\/go_quote.gif\n \n \n \n \n \n \n How exciting!  Happy almost wedding day!! \n   \n I did my wedding in port during the cruise.  I think either way there will be stress.  Embarkation day weddings are really rushed.  In port weddings come with lots of stress regarding the ship making it to port, being on time, etc. \n   \n Oh my, I really need to start planning another cruise!  They are so much fun![\/quote] \n \n It wasn&#039;t rushed at all!  Everything went smoothly and we were able to enjoy the ceremony and reception without feeling like we had to cram everything in.  We got to do our dances, the garter\/bouquet tosses, best man\/maid of honor speeches, cake cutting, champagne toast, eat....everything we wanted to do.","Attachments":[],"Id":1278859,"PostDate":1283645408,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> <br \/> \u00a0<\/p> <blockquote class=\"ipsBlockquote\">Originally Posted by <strong>~Andrea~<\/strong>\u00a0<span rel='lightbox'><img class='bbc_img' alt=\"View Post\" class=\"inlineimg\" src=\"\/img\/forum\/go_quote.gif\" style=\"border: 0px solid;\" \/><\/span><br \/> <br \/> <br \/> <br \/> <p> <br \/> <br \/> How exciting!\u00a0 Happy almost wedding day!!<\/p> <p> \u00a0<\/p> <p> I did my wedding in port during the cruise.\u00a0 I think either way there will be stress.\u00a0 Embarkation day weddings are really rushed.\u00a0 In port weddings come with lots of stress regarding the ship making it to port, being on time, etc.<\/p> <p> \u00a0<\/p> <p> Oh my, I really need to start planning another cruise!\u00a0 They are so much fun!<\/p> <\/blockquote> <p> <br \/> It wasn't rushed at all!\u00a0 Everything went smoothly and we were able to enjoy the ceremony and reception without feeling like we had to cram everything in.\u00a0 We got to do our dances, the garter\/bouquet tosses, best man\/maid of honor speeches, cake cutting, champagne toast, eat....everything we wanted to do.\u00a0<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/img.weddingcountdown.com\/ticker\/4p0r2jk.png\">http:\/\/img.weddingcountdown.com\/ticker\/4p0r2jk.png<\/a><\/div><\/div>","Email":"hunniebee724@yahoo.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1244305672,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-218181.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"hunniebee724","Id":218181,"Name":"hunniebee724","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":56094,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"599f26e09af979785c85ff878dfd8c48","RawContent":"&lt;p&gt; Yeah!!!!&lt;\/p&gt; &lt;p&gt;  &lt;\/p&gt; &lt;p&gt; Can&#039;t wait to read the details!&lt;\/p&gt;","Attachments":[],"Id":1279130,"PostDate":1283717196,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Yeah!!!!<\/p> <p> \u00a0<\/p> <p> Can't wait to read the details!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"det1969@aol.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1281894408,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-231387.JPG?_r=0","PhotoWidth":200,"PhotoHeight":267,"PhotoType":"custom"},"FormattedName":"dai69","Id":231387,"Name":"dai69","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":false,"TopicId":56094,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"54d84e6d7cc68fd781f5588b6dec7311","RawContent":"&lt;p&gt; Morning,&lt;\/p&gt; &lt;p&gt;  &lt;\/p&gt; &lt;p&gt; I assist with cruise ship weddings in Grand Cayman.&amp;nbsp; I find that most weddings are not rushed at all.&amp;nbsp;&lt;\/p&gt; &lt;p&gt;  &lt;\/p&gt; &lt;p&gt; Usually with the ship docking at 7am, i would meet the couple at the port, fill out paper work and then go and submit the legal documents while they are getting ready.&amp;nbsp; The wedding would take place around 10-11am which usually takes an hour (photography included) then off to a reception lunch and departure about 3pm.&lt;\/p&gt; &lt;p&gt;  &lt;\/p&gt; &lt;p&gt; As long as you have someone on island to assist then you can relax and know everything is taken care of.&lt;\/p&gt; &lt;p&gt;  &lt;\/p&gt; &lt;p&gt; Hope this helps.&lt;\/p&gt; &lt;p&gt;  &lt;\/p&gt; &lt;p&gt; Rebecca&lt;\/p&gt;","Attachments":[],"Id":1297524,"PostDate":1285582723,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> Morning,<\/p> <p> \u00a0<\/p> <p> I assist with cruise ship weddings in Grand Cayman.\u00a0 I find that most weddings are not rushed at all.\u00a0<\/p> <p> \u00a0<\/p> <p> Usually with the ship docking at 7am, i would meet the couple at the port, fill out paper work and then go and submit the legal documents while they are getting ready.\u00a0 The wedding would take place around 10-11am which usually takes an hour (photography included) then off to a reception lunch and departure about 3pm.<\/p> <p> \u00a0<\/p> <p> As long as you have someone on island to assist then you can relax and know everything is taken care of.<\/p> <p> \u00a0<\/p> <p> Hope this helps.<\/p> <p> \u00a0<\/p> <p> Rebecca<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"planner@parfaitcayman.com","IpAddress":"","GroupId":5,"GroupName":"Banned","JoinDate":1280701399,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-230930.jpg?_r=0","PhotoWidth":150,"PhotoHeight":150,"PhotoType":"custom"},"FormattedName":"Parfait","Id":230930,"Name":"Parfait","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":56094,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a1ae13265447f52d6d013ff76c85aba0","RawContent":"&lt;p&gt; I am going with an embarkation day wedding on the Carnival Fantasy in August 2011 mainly to accommodate people who may not want to cruise and also to go ahead and get the &amp;quot;wedding jitters&amp;quot; out of the way so that I can enjoy and celebrate during the entire cruise without worrying about getting sick, hung over, arriving late to a port, etc. I would love to hear about anyone else&#039;s experiences with the Carnival weddings. I have a while to go, but I&#039;m already excited and nervous!!&lt;\/p&gt;","Attachments":[],"Id":1315079,"PostDate":1287414203,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p> I am going with an embarkation day wedding on the Carnival Fantasy in August 2011 mainly to accommodate people who may not want to cruise and also to go ahead and get the \"wedding jitters\" out of the way so that I can enjoy and celebrate during the entire cruise without worrying about getting sick, hung over, arriving late to a port, etc. I would love to hear about anyone else's experiences with the Carnival weddings. I have a while to go, but I'm already excited and nervous!!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"sherribritt@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1281892484,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-231385.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"sherribritt","Id":231385,"Name":"sherribritt","IsOnline":false}}],"Id":"56094","Title":"Embarkment Day and\/or Shipboard Brides","LastPostDate":1403826123},"Pages":{"TotalItems":14,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
