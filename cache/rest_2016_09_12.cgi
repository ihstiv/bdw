{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":12,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":1504,"MovedTo":null,"MovedOn":0,"FirstPostId":1910021,"Rating":0,"RatingHits":0,"Starter":{"Id":284307,"Name":"Kirsteen","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284307.jpg?_r=1446946143","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"IsOnline":false},"StartDate":1453754622,"LastPoster":{"Id":286883,"Name":"StylingTrio","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286883.jpg?_r=1469141104","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"custom"},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":33,"Preview":{"Id":1910021,"PostDate":1453754622,"PostContent":"Hey Brides!  I'm trying to figure out whether I should get a spray tan and lash extensions before...","Author":{"Signature":"","Email":"kirsteenjones@gmail.com","IpAddress":"184.71.207.50","GroupId":39,"GroupName":"Newbie","JoinDate":1438856353,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284307.jpg?_r=1446946143","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"Kirsteen","Id":284307,"Name":"Kirsteen","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"172.219.159.183","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79891,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"45a4cfef4a52aa8bf7e261f3bde224a9","RawContent":"Hey Brides! \n\n\nI&#039;m trying to figure out whether I should get a spray tan and lash extensions before our trip. We fly out may 3rd in the morning so I would have to get the tan done on the 2nd. The wedding isn&#039;t until the 6th. I&#039;d hate for the fan to be splotchy on our wedding day and memorialized in our photos! \n\n\nDoes anyone have any experience with this? Or experience with lash extensions on vacation? I want to be able to enjoy my time, not be thinking about whether or not the pool is going to fade my tan or my mascara running. \n\n\nThanks in advance for humoring my uber superficial post :)","Attachments":[],"Id":1910021,"PostDate":1453754622,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Hey Brides! <br><br>\nI'm trying to figure out whether I should get a spray tan and lash extensions before our trip. We fly out may 3rd in the morning so I would have to get the tan done on the 2nd. The wedding isn't until the 6th. I'd hate for the fan to be splotchy on our wedding day and memorialized in our photos! <br><br>\nDoes anyone have any experience with this? Or experience with lash extensions on vacation? I want to be able to enjoy my time, not be thinking about whether or not the pool is going to fade my tan or my mascara running. <br><br>\nThanks in advance for humoring my uber superficial post <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kirsteenjones@gmail.com","IpAddress":"184.71.207.50","GroupId":39,"GroupName":"Newbie","JoinDate":1438856353,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-284307.jpg?_r=1446946143","PhotoWidth":200,"PhotoHeight":200,"PhotoType":"facebook"},"FormattedName":"Kirsteen","Id":284307,"Name":"Kirsteen","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.88.49.88","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79891,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"8a1c25def9b341522064624ffd264644","RawContent":"&lt;p&gt;@[member=\"Kirsteen\"] I plan on starting to tan for my June 7th wedding fairly soon. I am going to do beds though, not a spray tan. The issue with the spray tan is the more showers you take and the more you swim, the more quickly you will lose that tan.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I have had spray tans for $40 that turn out blotchy (hands and toes) and spray tans for $75 that have done the same. The cream they provide for those &#039;creasey&#039; areas helps but its not fool proof.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;If you aren&#039;t against tanning beds, I would suggest you do that instead of a spray tan. Don&#039;t get me wrong, I have had spray tans I&#039;ve loved and that photographed nicely (friends weddings) but in my opinion it may not be the best alternative for a DW where you&#039;ll likely be in and out of the pool (and sweating a lot!)&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I can&#039;t comment on lash extensions other than the fact that I too want them. Badly. A lot of the ladies on here have gotten them and will likely chime in. Where do you live? You may get lucky and get some suggestions on where to go as well.&lt;\/p&gt;","Attachments":[],"Id":1910030,"PostDate":1453757664,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"284307\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/284307-kirsteen\/' title='Member profile'><span itemprop=\"name\">Kirsteen<\/span><\/a> I plan on starting to tan for my June 7th wedding fairly soon. I am going to do beds though, not a spray tan. The issue with the spray tan is the more showers you take and the more you swim, the more quickly you will lose that tan.<\/p>\n<p>\u00a0<\/p>\n<p>I have had spray tans for $40 that turn out blotchy (hands and toes) and spray tans for $75 that have done the same. The cream they provide for those 'creasey' areas helps but its not fool proof.<\/p>\n<p>\u00a0<\/p>\n<p>If you aren't against tanning beds, I would suggest you do that instead of a spray tan. Don't get me wrong, I have had spray tans I've loved and that photographed nicely (friends weddings) but in my opinion it may not be the best alternative for a DW where you'll likely be in and out of the pool (and sweating a lot!)\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I can't comment on lash extensions other than the fact that I too want them. Badly. A lot of the ladies on here have gotten them and will likely chime in. Where do you live? You may get lucky and get some suggestions on where to go as well.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ashley.taylor@live.ca","IpAddress":"184.147.135.4","GroupId":3,"GroupName":"Member","JoinDate":1423090661,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282006.jpg?_r=1468890791","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"ashhtayy","Id":282006,"Name":"ashhtayy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"198.103.153.7","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79891,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"ae12519078c4864e0da615686dc99691","RawContent":"&lt;p&gt;I second @[member=\"ashhtayy\"] &#039;s comment about the spray tan. Yes spray tan has come along way since the days of Jessica Simpson&#039;s famous orange skin&amp;nbsp;tan but the spray tan does still&amp;nbsp;come off in the water; especially salt water. Everybody&#039;s skin reacts differently to&amp;nbsp;spray tan but I know for me it always wore off unevenly so I ended up with a blotchy look after a few days. Not sure I would take the chance on that for my wedding I&#039;d be afraid of the tan rubbing off on my dress.&amp;nbsp;I did the tanning beds but I already had a good base (I spend the entire summer in the sun on my boat) so I only needed a few sessions.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;As for lash extensions&amp;nbsp;- I&amp;nbsp; HIGHLY RECOMMEND! I got them this past Saturday and so far I love them. I feels great to roll out of bed in the morning and already look like you&#039;ve got makeup on. One thing I would recommend is to get them about a week before your wedding. They only last for about 4 to 6 weeks and some people have reactions to the glue used to bond the falsies to your natural lash so a week will give you time to adjust to having them without having to worry about them starting to fall out.&lt;\/p&gt;","Attachments":[],"Id":1910068,"PostDate":1453810228,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I second @<a hovercard-ref=\"member\" hovercard-id=\"282006\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282006-ashhtayy\/' title='Member profile'><span itemprop=\"name\">ashhtayy<\/span><\/a> 's comment about the spray tan. Yes spray tan has come along way since the days of Jessica Simpson's famous orange skin\u00a0tan but the spray tan does still\u00a0come off in the water; especially salt water. Everybody's skin reacts differently to\u00a0spray tan but I know for me it always wore off unevenly so I ended up with a blotchy look after a few days. Not sure I would take the chance on that for my wedding I'd be afraid of the tan rubbing off on my dress.\u00a0I did the tanning beds but I already had a good base (I spend the entire summer in the sun on my boat) so I only needed a few sessions.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>As for lash extensions\u00a0- I\u00a0 HIGHLY RECOMMEND! I got them this past Saturday and so far I love them. I feels great to roll out of bed in the morning and already look like you've got makeup on. One thing I would recommend is to get them about a week before your wedding. They only last for about 4 to 6 weeks and some people have reactions to the glue used to bond the falsies to your natural lash so a week will give you time to adjust to having them without having to worry about them starting to fall out.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"webgrl74@gmail.com","IpAddress":"99.224.73.70","GroupId":39,"GroupName":"Newbie","JoinDate":1437422585,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"2ndTimeMrs","Id":284050,"Name":"2ndTimeMrs","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.142.4.206","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79891,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"e8b10aeb31b440ba751eb54b7f6fc12c","RawContent":"&lt;p&gt;@[member=\"ashhtayy\"] You will definitely be dark if you start now!&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I started tanning about 3 weeks before I left and I got a really solid base (people were asking me if I already went on my vacation.. before I went haha) I think it also really depends on your skin tone as well.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I tan very easily and quickly. When I got to Mexico I limited my sun exposure and I wore really strong sunscreen the entire time. I ended up having no tan lines at the end of the trip which worked out well because I really didn&#039;t want any in my dress.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I wore eyelash extensions and I would highly recommend getting them. I asked my lady to make sure mine were really full since I would be wearing them swimming etc and she did a great job. I got them done 2 days before we left.&lt;\/p&gt;","Attachments":[],"Id":1910069,"PostDate":1453811199,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"282006\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282006-ashhtayy\/' title='Member profile'><span itemprop=\"name\">ashhtayy<\/span><\/a> You will definitely be dark if you start now!\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>I started tanning about 3 weeks before I left and I got a really solid base (people were asking me if I already went on my vacation.. before I went haha) I think it also really depends on your skin tone as well.\u00a0<\/p>\n<p>I tan very easily and quickly. When I got to Mexico I limited my sun exposure and I wore really strong sunscreen the entire time. I ended up having no tan lines at the end of the trip which worked out well because I really didn't want any in my dress.<\/p>\n<p>\u00a0<\/p>\n<p>I wore eyelash extensions and I would highly recommend getting them. I asked my lady to make sure mine were really full since I would be wearing them swimming etc and she did a great job. I got them done 2 days before we left.<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419423414,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1453235488","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"pjay","Id":281478,"Name":"pjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"174.88.49.88","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79891,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a2549dbed746f739d428ebe4306160f3","RawContent":"@[member=\"perianjay\"] I tan well and quickly and don&#039;t normally burn in natural sunlight but the beds are a different story. I burn very quickly and it takes some time to see the glow (after the burn subsides). Not sure if that makes sense but that&#039;s always been the story with my skin. I&#039;ll be careful not to go TOO much before before though because I don&#039;t want it to look too fake lol\n\n\nI also strategically placed our wedding at the beginning or the trip so that we could enjoy the sun as much as possible and not worry about tan lines. Fingers crossed this pans out.","Attachments":[],"Id":1910090,"PostDate":1453834118,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                @perianjay I tan well and quickly and don't normally burn in natural sunlight but the beds are a different story. I burn very quickly and it takes some time to see the glow (after the burn subsides). Not sure if that makes sense but that's always been the story with my skin. I'll be careful not to go TOO much before before though because I don't want it to look too fake lol<br><br>\nI also strategically placed our wedding at the beginning or the trip so that we could enjoy the sun as much as possible and not worry about tan lines. Fingers crossed this pans out. \r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"ashley.taylor@live.ca","IpAddress":"184.147.135.4","GroupId":3,"GroupName":"Member","JoinDate":1423090661,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282006.jpg?_r=1468890791","PhotoWidth":200,"PhotoHeight":133,"PhotoType":"custom"},"FormattedName":"ashhtayy","Id":282006,"Name":"ashhtayy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"204.4.182.17","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79891,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"5eaf33b0299a5023eb36477b49d238af","RawContent":"&lt;p&gt;I was planning on getting lash extensions but the salon said that sweating, sunscreen (oils), and swimming will make them come off. did no one else get that feedback?&amp;nbsp;&lt;\/p&gt;","Attachments":[],"Id":1910110,"PostDate":1453887207,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I was planning on getting lash extensions but the salon said that sweating, sunscreen (oils), and swimming will make them come off. did no one else get that feedback?\u00a0<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"maria.anisimova88@gmail.com","IpAddress":"199.29.247.15","GroupId":39,"GroupName":"Newbie","JoinDate":1420710599,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281640.jpg?_r=1446819439","PhotoWidth":200,"PhotoHeight":268,"PhotoType":"custom"},"FormattedName":"maria1488","Id":281640,"Name":"maria1488","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.142.4.206","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79891,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"75e41334f8697264c358c8292d294e42","RawContent":"&lt;p&gt;@[member=\"maria1488\"] I never had an issue, but i&#039;m not much of a sweater so i&#039;m not sure how that impacts the lashes. I swam everyday, put sunscreen on my face.. etc and never had issues.&lt;\/p&gt;\n\n&lt;p&gt;@[member=\"ashhtayy\"] haha yea.. three weeks was more than enough for me. I would have been way too brown if I went any longer. Plus there&#039;s areas that tanning beds never get properly lol.. I was trying to even out my &#039;under arm&#039; area when I got to Mexico because the tanning bed didn&#039;t tan that area. It bothers me because I notice it in my wedding pics lol&lt;\/p&gt;","Attachments":[],"Id":1910111,"PostDate":1453887746,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"281640\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/281640-maria1488\/' title='Member profile'><span itemprop=\"name\">maria1488<\/span><\/a> I never had an issue, but i'm not much of a sweater so i'm not sure how that impacts the lashes. I swam everyday, put sunscreen on my face.. etc and never had issues.<\/p>\n<br \/><p>@<a hovercard-ref=\"member\" hovercard-id=\"282006\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/282006-ashhtayy\/' title='Member profile'><span itemprop=\"name\">ashhtayy<\/span><\/a> haha yea.. three weeks was more than enough for me. I would have been way too brown if I went any longer. Plus there's areas that tanning beds never get properly lol.. I was trying to even out my 'under arm' area when I got to Mexico because the tanning bed didn't tan that area. It bothers me because I notice it in my wedding pics lol<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419423414,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1453235488","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"pjay","Id":281478,"Name":"pjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"68.146.146.173","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79891,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"a4095556340f1662f8d6d3993b3cae6a","RawContent":"You guys rawk. I&#039;m so pale that I can go in for 5 mins a couple times a week and may still burn. 3 weeks would have done nothing for me. Well a month didn&#039;t even -- I tried to tan for mine and just didn&#039;t start soon enough lol. I didn&#039;t commit that much either though. \n\n\n\nSent from my iPad using Tapatalk","Attachments":[],"Id":1910112,"PostDate":1453888776,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                You guys rawk. I'm so pale that I can go in for 5 mins a couple times a week and may still burn. 3 weeks would have done nothing for me. Well a month didn't even -- I tried to tan for mine and just didn't start soon enough lol. I didn't commit that much either though. <br><br><br>\nSent from my iPad using Tapatalk\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>-Kim<\/p>\n<p>Married on 2015\/01\/21 at the Grand Sirenis Riviera Maya with 43 guests in attendance \u00a0 <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n<p>\u00a0<\/p>\n<p>Planning Thread -\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Pictures\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36'>http:\/\/www.bestdestinationwedding.com\/topic\/78209-calgarybride2015s-planning-thread-15121-grand-sirenis-riviera-maya\/page-36<\/a><\/p>\n<p>\u00a0<\/p>\n<p>Wedding Review\u00a0<a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600'>http:\/\/www.bestdestinationwedding.com\/topic\/38741-grand-sirenis-riviera-maya-brides\/page-131#entry1885600<\/a><\/p>\n<p>\u00a0<\/p>\n<p>\u00a0","Email":"kdeakin@hotmail.com","IpAddress":"68.145.235.0","GroupId":42,"GroupName":"Sr. Member","JoinDate":1399414202,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-277873.jpg?_r=1422218225","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"calgarybride2015","Id":277873,"Name":"calgarybride2015","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"72.142.4.206","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79891,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"092944378473b36e3b8894167e7b324b","RawContent":"&lt;p&gt;@[member=\"calgarybride2015\"] haha. It&#039;s definitely my Eastern European genes. If I took after my dad and his English side, i&#039;d definitely burn easily. Him and my brother burn instantly.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Oddly enough I have really freckly skin, but we think it&#039;s because I grew up in Florida with a lot of sun exposure.&lt;\/p&gt;","Attachments":[],"Id":1910114,"PostDate":1453889114,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"277873\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/277873-calgarybride2015\/' title='Member profile'><span itemprop=\"name\">calgarybride2015<\/span><\/a> haha. It's definitely my Eastern European genes. If I took after my dad and his English side, i'd definitely burn easily. Him and my brother burn instantly.<\/p>\n<p>\u00a0<\/p>\n<p>Oddly enough I have really freckly skin, but we think it's because I grew up in Florida with a lot of sun exposure.<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419423414,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1453235488","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"pjay","Id":281478,"Name":"pjay","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"97.101.156.249","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79891,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"d22bcfce295954b61406883a207e842b","RawContent":"Eye lash extensions? How fun! How long do they last?","Attachments":[],"Id":1910266,"PostDate":1454109470,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Eye lash extensions? How fun! How long do they last?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"brandiereavis@gmail.com","IpAddress":"97.101.156.249","GroupId":39,"GroupName":"Newbie","JoinDate":1453735428,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-286035.jpg?_r=1469539586","PhotoWidth":200,"PhotoHeight":266,"PhotoType":"facebook"},"FormattedName":"Brandie","Id":286035,"Name":"Brandie","IsOnline":false}}],"Id":"79891","Title":"Spray Tan And Lash Extensions?","LastPostDate":1462996943},"Pages":{"TotalItems":12,"TotalPages":2,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":10},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
