border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><br \/> <br \/> And me & my sister (MOH) in our dresses!<br \/> <span rel='lightbox'><img class='bbc_img' src=\"http:\/\/i74.photobucket.com\/albums\/i280\/hln321\/dress2.jpg\" border=\"0\" alt=\"Click the image to open in full size.\" class=\"tcattdimgresizer\" \/><\/span><\/div> <\/td> <\/tr> <\/table> <\/div><br \/> You look great. Was that David's bridal? I think I tried it on but it wouldnt go over the twins.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"nurturedbynature312@gmail.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1173470820,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207248.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"LadyP","Id":207248,"Name":"LadyP","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":1700,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a40ac737eb5149a7026cd895a754747c","RawContent":"Heidi beautiful, is your dress blush or am I seeing things?","Attachments":[],"Id":140415,"PostDate":1195364572,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Heidi beautiful, is your dress blush or am I seeing things?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature