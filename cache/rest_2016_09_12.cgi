{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":true,"CanFollow":true,"TotalPosts":93,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":false,"HasAttachments":false,"Views":31688,"MovedTo":null,"MovedOn":0,"FirstPostId":625420,"Rating":0,"RatingHits":0,"Starter":{"Id":213287,"Name":"Prettyhazardous","Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213287.jpg?_r=0","PhotoWidth":96,"PhotoHeight":63,"PhotoType":"custom"},"IsOnline":false},"StartDate":1237424144,"LastPoster":{"Id":281378,"Name":"cruisebride2016","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":88,"Preview":{"Id":625420,"PostDate":1237424144,"PostContent":"Hey Ladies  I thought I'd start a thread to find out what items we cruise brides are putting in o...","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><i><strong>Be Blessed,<br>Mrs. Willis<br><br><a data-ipb='nomediaparse' href=\"http:\/\/MrandMrsWillis.shutterfly.com\">MrandMrsWillis.shutterfly.com<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/www.mywedding.com\/ashleyandbrian09\">http:\/\/www.mywedding.com\/ashleyandbrian09<\/a><a data-ipb='nomediaparse' href=\"http:\/\/i815.photobucket.com\/albums\/zz72\/Prettyhazardous\/087WillisWedding.jpg\">http:\/\/i815.photobucket.com\/albums\/z...lisWedding.jpg<\/a><\/strong><\/i><\/div><\/div>","Email":"ashleyfleming05@gmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1229832699,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213287.jpg?_r=0","PhotoWidth":96,"PhotoHeight":63,"PhotoType":"custom"},"FormattedName":"Prettyhazardous","Id":213287,"Name":"Prettyhazardous","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":33175,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9f768c28af21a1e239d5fa4298be821c","RawContent":"&lt;font color=\"Orange\"&gt;&lt;font size=\"3\"&gt;&lt;font face=\"Georgia\"&gt;Hey Ladies \n I thought I&#039;d start a thread to find out what items we cruise brides are putting in our OOT Bags. I searched this forum to see if there is a thread like this and I cant find one, but if there is I apologize. I&#039;ve been working really hard on my OOT bags trying to figure out what I want to put in them. I think as a cruise bride I don&#039;t need as many items as the reg DW brides bc the ship basically has everything on it. So I&#039;m going to put my list below and I&#039;ll put a &amp;quot; * &amp;quot; by the things I&#039;ve already purchased and a &amp;quot;?&amp;quot; by the things that may be coming off based on my budget bc we have a group of at least 40 ppl. Can you all lemme know if you think I should scratch any of these items or am I missing anything really important Thanks in advance.\n \n -Bags (hibiscus ones from OTC for females and drawstring backpacks males)\n -Puzzle books (sudoku, crossword word search one per bag)?\n -Coloring books (kids duh)\n -Hand sanitizer\n -Room key holders\n -Travel mugs* (DIY ones from Dollar tree)\n -Pens\n -Note cards\n -Highlighters\n -Snacks\n -Gum*\n -First aid kits ?\n -postcards to send home* (free with vistaprints)\n -travel tissue packs*\n -homemade soaps* (I&#039;m almost finished making them all)\n \n OK what do you think and can you tell what you&#039;re putting in your bags.\n Thanks&lt;\/font&gt;&lt;\/font&gt;&lt;\/font&gt;","Attachments":[],"Id":625420,"PostDate":1237424144,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <font color=\"Orange\"><font size=\"3\"><font face=\"Georgia\">Hey Ladies <br \/> I thought I'd start a thread to find out what items we cruise brides are putting in our OOT Bags. I searched this forum to see if there is a thread like this and I cant find one, but if there is I apologize. I've been working really hard on my OOT bags trying to figure out what I want to put in them. I think as a cruise bride I don't need as many items as the reg DW brides bc the ship basically has everything on it. So I'm going to put my list below and I'll put a \" * \" by the things I've already purchased and a \"?\" by the things that may be coming off based on my budget bc we have a group of at least 40 ppl. Can you all lemme know if you think I should scratch any of these items or am I missing anything really important Thanks in advance.<br \/> <br \/> -Bags (hibiscus ones from OTC for females and drawstring backpacks males)<br \/> -Puzzle books (sudoku, crossword word search one per bag)?<br \/> -Coloring books (kids duh)<br \/> -Hand sanitizer<br \/> -Room key holders<br \/> -Travel mugs* (DIY ones from Dollar tree)<br \/> -Pens<br \/> -Note cards<br \/> -Highlighters<br \/> -Snacks<br \/> -Gum*<br \/> -First aid kits ?<br \/> -postcards to send home* (free with vistaprints)<br \/> -travel tissue packs*<br \/> -homemade soaps* (I'm almost finished making them all)<br \/> <br \/> OK what do you think and can you tell what you're putting in your bags.<br \/> Thanks<\/font><\/font><\/font>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><i><strong>Be Blessed,<br>Mrs. Willis<br><br><a data-ipb='nomediaparse' href=\"http:\/\/MrandMrsWillis.shutterfly.com\">MrandMrsWillis.shutterfly.com<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/www.mywedding.com\/ashleyandbrian09\">http:\/\/www.mywedding.com\/ashleyandbrian09<\/a><a data-ipb='nomediaparse' href=\"http:\/\/i815.photobucket.com\/albums\/zz72\/Prettyhazardous\/087WillisWedding.jpg\">http:\/\/i815.photobucket.com\/albums\/z...lisWedding.jpg<\/a><\/strong><\/i><\/div><\/div>","Email":"ashleyfleming05@gmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1229832699,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213287.jpg?_r=0","PhotoWidth":96,"PhotoHeight":63,"PhotoType":"custom"},"FormattedName":"Prettyhazardous","Id":213287,"Name":"Prettyhazardous","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":33175,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"0d1366fc6d1cbf0c38a0b0280e5e08af","RawContent":"Oh lord lets see!\n \n -Beach Bag for ladies, pull string bag for the men\n -Share your photo post cards from Vistaprint\n -FA kits with rolaids, chapstick, zantac, tylenol, immodium\n -Booboo kits with bandaids, alcohol wipes\n -Hangover kits with gatorade single packets\n -organza bags with pack of tissues, tic tacs, crystal light packets for the non drinkers, and shout wipes\n -organza bags with avon body wash and lotion and B&amp;amp;BW hand sanitizer\n -OTC palm tree pens\n -OTC hibiscus coin purses for room keys\n -single packets of woolight to wash out the swim suits!!\n -small aloe bottles\n -note pads and post it notes\n -travel coffee mugs with personalized stickers\n -puzzle books\n \n \n Thats about all I can think of atm! I am going to go to Sams club and get some munchies I think. I haven&#039;t decided yet.","Attachments":[],"Id":626503,"PostDate":1237492717,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Oh lord lets see!<br \/> <br \/> -Beach Bag for ladies, pull string bag for the men<br \/> -Share your photo post cards from Vistaprint<br \/> -FA kits with rolaids, chapstick, zantac, tylenol, immodium<br \/> -Booboo kits with bandaids, alcohol wipes<br \/> -Hangover kits with gatorade single packets<br \/> -organza bags with pack of tissues, tic tacs, crystal light packets for the non drinkers, and shout wipes<br \/> -organza bags with avon body wash and lotion and B&BW hand sanitizer<br \/> -OTC palm tree pens<br \/> -OTC hibiscus coin purses for room keys<br \/> -single packets of woolight to wash out the swim suits!!<br \/> -small aloe bottles<br \/> -note pads and post it notes<br \/> -travel coffee mugs with personalized stickers<br \/> -puzzle books<br \/> <br \/> <br \/> Thats about all I can think of atm! I am going to go to Sams club and get some munchies I think. I haven't decided yet.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><strong><i>~Kathy~<\/i><\/strong><br><br><a data-ipb='nomediaparse' href=\"http:\/\/www.ezticker.com\/ticker\/1267\/106\/20090511\/Since+we+said+I+DO%21\/ticker.png\">http:\/\/www.ezticker.com\/ticker\/1267\/...%21\/ticker.png<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/i84.photobucket.com\/albums\/k1\/Cattiebri13\/05_5-1-1.jpg\">http:\/\/i84.photobucket.com\/albums\/k1...3\/05_5-1-1.jpg<\/a><\/div><\/div>","Email":"KCarder3@comcast.net","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1214687467,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-210208.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Cattie","Id":210208,"Name":"Cattie","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":33175,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"066765d44fd318d479bc1935a4284934","RawContent":"-Beach bag (very simple in various colors)\n -personalized water bottles\n -snacks (chex mix, granola bars, dried fruit, soft peppermints)\n -sunscreen\n -tissue packs\n -tylenol\n -shout wipes\n \n I put the snacks in it because everyone is coming the day before. I am going to give them out the night before at the &amp;quot;Welcome Dinner&amp;quot; so I don&#039;t have to worry about getting them on board.","Attachments":[],"Id":626632,"PostDate":1237496944,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                -Beach bag (very simple in various colors)<br \/> -personalized water bottles<br \/> -snacks (chex mix, granola bars, dried fruit, soft peppermints)<br \/> -sunscreen<br \/> -tissue packs<br \/> -tylenol<br \/> -shout wipes<br \/> <br \/> I put the snacks in it because everyone is coming the day before. I am going to give them out the night before at the \"Welcome Dinner\" so I don't have to worry about getting them on board.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i302.photobucket.com\/albums\/nn105\/tamster808\/P1010407-1.jpg\">http:\/\/i302.photobucket.com\/albums\/n...P1010407-1.jpg<\/a><br><br><span>My Baby-Newman!<\/span><br><br><a data-ipb='nomediaparse' href=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10732;128\/st\/20090417\/e\/Our+Wedding\/k\/a751\/event.png\">http:\/\/tickers.TickerFactory.com\/ezt...a751\/event.png<\/a><span>49 Booked!!!<\/span><\/div><\/div>","Email":"Tamster808@hotmail.com","IpAddress":"","GroupId":40,"GroupName":"Jr. Member","JoinDate":1203872069,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-208631.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Tamster808","Id":208631,"Name":"Tamster808","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":33175,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"9e263828f938580dbcbc86ab627ad95f","RawContent":"I went on a cruise vow renewal for a couple and their bags were very simple, but totally unexpected as I didn&#039;t even know what an OOT bag was then LOL\n \n So we got \n \n *personalized t-shirts\n *a wine stopper and pourer which we still use\n *a nice note thanking us for being there\n *a timeline of what the couple would be doing, when the vow renewal was, etc.\n \n They also had arranged for us to each get our own Royal Carribean beach towel which I thought was super awesome!!","Attachments":[],"Id":626645,"PostDate":1237497548,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I went on a cruise vow renewal for a couple and their bags were very simple, but totally unexpected as I didn't even know what an OOT bag was then LOL<br \/> <br \/> So we got <br \/> <br \/> *personalized t-shirts<br \/> *a wine stopper and pourer which we still use<br \/> *a nice note thanking us for being there<br \/> *a timeline of what the couple would be doing, when the vow renewal was, etc.<br \/> <br \/> They also had arranged for us to each get our own Royal Carribean beach towel which I thought was super awesome!!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"betsyrohr@gmail.com","IpAddress":"68.103.44.199","GroupId":46,"GroupName":"VIP Member","JoinDate":1193703120,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-207887.gif?_r=0","PhotoWidth":100,"PhotoHeight":75,"PhotoType":"custom"},"FormattedName":"Betsy","Id":207887,"Name":"Betsy","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":33175,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"bb3c5dde48800e9ca12b401957e44318","RawContent":"-tote bags, probably reusable ones (Dunwoodybooth.com)\n -timeline, welcome letter, list of events we&#039;ll be attending throughout the week (excursions and whatnot)\n -maps of miami\n -vistaprint postcards\n -photoshare cards (vistaprint)\n -doortags (vistaprint)\n -DIY puzzle book\n -DIY coloring books\n -Playing cards (Michaels)\n -First Aide Kit: alcohol wipes, alka seltzer, chapstick w visaprint labels, bandaides, tylenol, some sort of antinausea pill, sunscreen pack, aloe\n -Hand Sanitizer (from Staples penny deal) with Vistaprint label &amp;quot;share your love, not your germs&amp;quot;\n -For the women, a ladies prep kit: mini nail polish (target), nail polish remover (work), lip balm ($ tree), makeup wedge (target), bobby pins (xmas tree shop), Bath fizz &amp;amp; floating flower (xmas tree shop), nail files, cello heart bags to put them in (Michaels)\n -For the men sample size Nautica Cologne\n -Eye glass cleaner (Target) with vistaprint label &amp;quot;to keep your shades clean&amp;quot;\n -Tissue packets (dollar tree)\n -Highlighters (office depot going out of business sale)\n -Sign and Sail pouch (office depot), will get carabeaner clips from OTC\n -Vistaprint pen, sticky note, hat for the men\n -Water bottle with DIY water bottle holder (haven&#039;t done yet), and\/or Travel mugs (dollar tree)\n -Maybe Downy wrinkle releaser\n -Snacks\n My list keeps growing, we&#039;ll see what actually ends up in the bags!","Attachments":[],"Id":626982,"PostDate":1237517265,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                -tote bags, probably reusable ones (Dunwoodybooth.com)<br \/> -timeline, welcome letter, list of events we'll be attending throughout the week (excursions and whatnot)<br \/> -maps of miami<br \/> -vistaprint postcards<br \/> -photoshare cards (vistaprint)<br \/> -doortags (vistaprint)<br \/> -DIY puzzle book<br \/> -DIY coloring books<br \/> -Playing cards (Michaels)<br \/> -First Aide Kit: alcohol wipes, alka seltzer, chapstick w visaprint labels, bandaides, tylenol, some sort of antinausea pill, sunscreen pack, aloe<br \/> -Hand Sanitizer (from Staples penny deal) with Vistaprint label \"share your love, not your germs\"<br \/> -For the women, a ladies prep kit: mini nail polish (target), nail polish remover (work), lip balm ($ tree), makeup wedge (target), bobby pins (xmas tree shop), Bath fizz & floating flower (xmas tree shop), nail files, cello heart bags to put them in (Michaels)<br \/> -For the men sample size Nautica Cologne<br \/> -Eye glass cleaner (Target) with vistaprint label \"to keep your shades clean\"<br \/> -Tissue packets (dollar tree)<br \/> -Highlighters (office depot going out of business sale)<br \/> -Sign and Sail pouch (office depot), will get carabeaner clips from OTC<br \/> -Vistaprint pen, sticky note, hat for the men<br \/> -Water bottle with DIY water bottle holder (haven't done yet), and\/or Travel mugs (dollar tree)<br \/> -Maybe Downy wrinkle releaser<br \/> -Snacks<br \/> My list keeps growing, we'll see what actually ends up in the bags!\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i348.photobucket.com\/albums\/q351\/merocket59\/logo4small.png\">http:\/\/i348.photobucket.com\/albums\/q...logo4small.png<\/a><\/div><\/div>","Email":"merocket59@aol.com","IpAddress":"75.69.58.113","GroupId":3,"GroupName":"Member","JoinDate":1211574456,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209559.gif?_r=0","PhotoWidth":160,"PhotoHeight":120,"PhotoType":"custom"},"FormattedName":"merocket59","Id":209559,"Name":"merocket59","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":33175,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"4a52f65998e173684fcd2a4200a37ed1","RawContent":"So far, I plan on...\n \n \n OTC hibiscus bags\n Welcome brochure and &amp;quot;meet the guests&amp;quot; info (free through Vistaprint)\n OTC hibiscus room card holders\n mini bottles hand sanitizer (Clearance sale at Bath and Body)\n Spanish phrase books ($1 bin at Target)\n Sudoku puzzle books ($1 bin at Target)\n Playing Cards\n mini cruise-aid kit (advil, bandaids, sunscreen, lib balm, anti-nausea med, gatorade packet, aloe...possibly in organza bag...)\n gum\/mints\n personalized water bottles (might get labels from OTC)\n Postcards to send home(from Vistaprint)\n &amp;quot;Share your photos&amp;quot; card\n personalized cabin door sign","Attachments":[],"Id":629449,"PostDate":1237816173,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                So far, I plan on...<br \/> <br \/> <br \/> OTC hibiscus bags<br \/> Welcome brochure and \"meet the guests\" info (free through Vistaprint)<br \/> OTC hibiscus room card holders<br \/> mini bottles hand sanitizer (Clearance sale at Bath and Body)<br \/> Spanish phrase books ($1 bin at Target)<br \/> Sudoku puzzle books ($1 bin at Target)<br \/> Playing Cards<br \/> mini cruise-aid kit (advil, bandaids, sunscreen, lib balm, anti-nausea med, gatorade packet, aloe...possibly in organza bag...)<br \/> gum\/mints<br \/> personalized water bottles (might get labels from OTC)<br \/> Postcards to send home(from Vistaprint)<br \/> \"Share your photos\" card<br \/> personalized cabin door sign\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kimberht@yahoo.com","IpAddress":"","GroupId":39,"GroupName":"Newbie","JoinDate":1231973520,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213957.gif?_r=0","PhotoWidth":200,"PhotoHeight":202,"PhotoType":"custom"},"FormattedName":"InspiredBride","Id":213957,"Name":"InspiredBride","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":33175,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"dd684884e46dbaa3311544c734785ef6","RawContent":"Just thougt I would chime in on the OOT bags for your guest. \n My FI and I decided to give everyone passport covers, they are fairly inexpesive, I searched on the net wedding passport covers, But we did not give them in their OOT bags we sent out a newsletter as our STD&#039;s and then well all signed up and payed their money we sent out &amp;quot;passport&amp;quot; invitation with the covers. Also we are playing to do our favorite things in our OOT bags, along with some of the other ideas I&#039;ve seen on line.\n \n Good Luck&lt;img src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/shots.gif\" border=\"0\" alt=\"\" title=\"Shots\" class=\"inlineimg\" \/&gt;","Attachments":[],"Id":632873,"PostDate":1238076708,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Just thougt I would chime in on the OOT bags for your guest. <br \/> My FI and I decided to give everyone passport covers, they are fairly inexpesive, I searched on the net wedding passport covers, But we did not give them in their OOT bags we sent out a newsletter as our STD's and then well all signed up and payed their money we sent out \"passport\" invitation with the covers. Also we are playing to do our favorite things in our OOT bags, along with some of the other ideas I've seen on line.<br \/> <br \/> Good Luck<span rel='lightbox'><img class='bbc_img' src=\"http:\/\/files.bestdestinationwedding.com\/images\/smilies\/shots.gif\" border=\"0\" alt=\"\" title=\"Shots\" class=\"inlineimg\" \/><\/span>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"march132010@yahoo.com","IpAddress":"","GroupId":42,"GroupName":"Sr. Member","JoinDate":1238008800,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-216144.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"march132010","Id":216144,"Name":"march132010","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":33175,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"a3e83e9dae084c8eeef1dd088cc43371","RawContent":"Megan Why&#039;d you change your logo?","Attachments":[],"Id":633650,"PostDate":1238114064,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Megan Why'd you change your logo?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><i><strong>Be Blessed,<br>Mrs. Willis<br><br><a data-ipb='nomediaparse' href=\"http:\/\/MrandMrsWillis.shutterfly.com\">MrandMrsWillis.shutterfly.com<\/a><br><a data-ipb='nomediaparse' href=\"http:\/\/www.mywedding.com\/ashleyandbrian09\">http:\/\/www.mywedding.com\/ashleyandbrian09<\/a><a data-ipb='nomediaparse' href=\"http:\/\/i815.photobucket.com\/albums\/zz72\/Prettyhazardous\/087WillisWedding.jpg\">http:\/\/i815.photobucket.com\/albums\/z...lisWedding.jpg<\/a><\/strong><\/i><\/div><\/div>","Email":"ashleyfleming05@gmail.com","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1229832699,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-213287.jpg?_r=0","PhotoWidth":96,"PhotoHeight":63,"PhotoType":"custom"},"FormattedName":"Prettyhazardous","Id":213287,"Name":"Prettyhazardous","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":33175,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"ac4b69b86f012de802fdf5f387ef899f","RawContent":"I was bored of the other one, but this one is too small.. which do you like better?","Attachments":[],"Id":634503,"PostDate":1238189315,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                I was bored of the other one, but this one is too small.. which do you like better?\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><a data-ipb='nomediaparse' href=\"http:\/\/i348.photobucket.com\/albums\/q351\/merocket59\/logo4small.png\">http:\/\/i348.photobucket.com\/albums\/q...logo4small.png<\/a><\/div><\/div>","Email":"merocket59@aol.com","IpAddress":"75.69.58.113","GroupId":3,"GroupName":"Member","JoinDate":1211574456,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-209559.gif?_r=0","PhotoWidth":160,"PhotoHeight":120,"PhotoType":"custom"},"FormattedName":"merocket59","Id":209559,"Name":"merocket59","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"0.0.0.0","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":33175,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"b72391cf98f876737a3431f3a45a6b3c","RawContent":"Meg, I like the old one better!\n \n FYI. If there are RCCL Brides, make sure you don&#039;t put candles in your OOT&#039;s. They aren&#039;t allowed.","Attachments":[],"Id":634534,"PostDate":1238191537,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                Meg, I like the old one better!<br \/> <br \/> FYI. If there are RCCL Brides, make sure you don't put candles in your OOT's. They aren't allowed.\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<div class=\"post-sig post-sig-limit shazam usersig-click\"><div class=\"reparse-sig-lineheight\"><strong><i>~Kathy~<\/i><\/strong><br><br><a data-ipb='nomediaparse' href=\"http:\/\/www.ezticker.com\/ticker\/1267\/106\/20090511\/Since+we+said+I+DO%21\/ticker.png\">http:\/\/www.ezticker.com\/ticker\/1267\/...%21\/ticker.png<\/a><br><br><a data-ipb='nomediaparse' href=\"http:\/\/i84.photobucket.com\/albums\/k1\/Cattiebri13\/05_5-1-1.jpg\">http:\/\/i84.photobucket.com\/albums\/k1...3\/05_5-1-1.jpg<\/a><\/div><\/div>","Email":"KCarder3@comcast.net","IpAddress":"","GroupId":3,"GroupName":"Member","JoinDate":1214687467,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-210208.jpg?_r=0","PhotoWidth":180,"PhotoHeight":180,"PhotoType":"custom"},"FormattedName":"Cattie","Id":210208,"Name":"Cattie","IsOnline":false}}],"Id":"33175","Title":"Cruise Wedding OOT Bags","LastPostDate":1424398191},"Pages":{"TotalItems":93,"TotalPages":10,"CurrentPage":0,"NextPage":10,"PreviousPage":-1,"LastPage":90},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":1,"Type":"int"}]}
