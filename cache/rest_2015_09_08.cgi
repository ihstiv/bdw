Request Time: 1 seconds
{"Success":true,"Data":{"State":"open","OpenTime":0,"CloseTime":0,"IsApproved":true,"IsPinned":false,"IsDeleted":false,"IsHidden":false,"IsArchived":false,"IsFollowing":false,"CanEdit":false,"CanReply":false,"CanFollow":true,"TotalPosts":5,"QueuedPosts":0,"DeletedPosts":0,"HasUnreadPosts":true,"HasAttachments":false,"Views":220,"MovedTo":null,"MovedOn":0,"FirstPostId":1903460,"Rating":0,"RatingHits":0,"Starter":{"Id":284575,"Name":"kimberlyc","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"StartDate":1440616399,"LastPoster":{"Id":284575,"Name":"kimberlyc","Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"IsOnline":false},"PollState":"0","LastVote":0,"ForumId":3,"Preview":{"Id":1903460,"PostDate":1440616399,"PostContent":"Hello, \u00a0 I am in the very early stages of planning a destination wedding. I was hoping to use the...","Author":{"Signature":"","Email":"kimc0486@msn.com","IpAddress":"66.235.46.71","GroupId":39,"GroupName":"Newbie","JoinDate":1440615676,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kimberlyc","Id":284575,"Name":"kimberlyc","IsOnline":false}},"Posts":[{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.235.46.71","IsFirstPost":true,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79534,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"64504951cc43bcc0f5d26e156500f7b5","RawContent":"&lt;p&gt;Hello,&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I am in the very early stages of planning a destination wedding. I was hoping to use the Riu Palace Pacifico in Nuevo Vallarta, but I just found out that a private reception and dancing isn&#039;t possible for less than 40 people, even with a fee. I don&#039;t yet know how many people I will have, but likely more in the 30-35 range.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I really would like a venue that allows for a fun reception. My sister married a few years ago at the Riu Palace in Playa del Carmen, but she had a private reception due to having over 40 people, but it was so fun!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Any suggestions?&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Also, my Mom will be in an electric wheelchair as she has ALS, so it is imperative that the property be wheelchair accessible (elevators and\/or ramps, doors wide enough to get the wheelchair through).&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Hoping for a resort in the $200-250\/night range to not make my guests pay a fortune.&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Does anyone know if what I have been told is accurate? They won&#039;t \"let me\" talk to the onsite coordinator or give me the price list with all of the \"extra\" costs.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Any help is very appreciated!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Thanks,&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Kimberly&lt;\/p&gt;","Attachments":[],"Id":1903460,"PostDate":1440616399,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Hello,<\/p>\n<p>\u00a0<\/p>\n<p>I am in the very early stages of planning a destination wedding. I was hoping to use the Riu Palace Pacifico in Nuevo Vallarta, but I just found out that a private reception and dancing isn't possible for less than 40 people, even with a fee. I don't yet know how many people I will have, but likely more in the 30-35 range.<\/p>\n<p>\u00a0<\/p>\n<p>I really would like a venue that allows for a fun reception. My sister married a few years ago at the Riu Palace in Playa del Carmen, but she had a private reception due to having over 40 people, but it was so fun!<\/p>\n<p>\u00a0<\/p>\n<p>Any suggestions?<\/p>\n<p>\u00a0<\/p>\n<p>Also, my Mom will be in an electric wheelchair as she has ALS, so it is imperative that the property be wheelchair accessible (elevators and\/or ramps, doors wide enough to get the wheelchair through).<\/p>\n<p>\u00a0<\/p>\n<p>Hoping for a resort in the $200-250\/night range to not make my guests pay a fortune.\u00a0<\/p>\n<p>\u00a0<\/p>\n<p>Does anyone know if what I have been told is accurate? They won't \"let me\" talk to the onsite coordinator or give me the price list with all of the \"extra\" costs.<\/p>\n<p>\u00a0<\/p>\n<p>Any help is very appreciated!<\/p>\n<p>\u00a0<\/p>\n<p>Thanks,<\/p>\n<p>\u00a0<\/p>\n<p>Kimberly<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kimc0486@msn.com","IpAddress":"66.235.46.71","GroupId":39,"GroupName":"Newbie","JoinDate":1440615676,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kimberlyc","Id":284575,"Name":"kimberlyc","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.241.131.23","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79534,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"df1dc38df0957913cb86dc3bfc91d8b7","RawContent":"&lt;p&gt;Welcome to the forum! Have you spoken to a travel agent yet? I&#039;d recommend that as they will be able to assist you in finding a resort that meets your specific requirements. Good luck in your search! :)&lt;\/p&gt;","Attachments":[],"Id":1903474,"PostDate":1440618842,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Welcome to the forum! Have you spoken to a travel agent yet? I'd recommend that as they will be able to assist you in finding a resort that meets your specific requirements. Good luck in your search! <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"<p>\u00a0<br><br><span style=\"color:#808080;\"><span style=\"font-size:14px;\">My planning thread :<\/span><\/span><br><a data-ipb='nomediaparse' href='http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631'>http:\/\/www.bestdestinationwedding.com\/topic\/78755-perianjay-planning-thread-december-15-2015-beach-palace\/#entry1885631<\/a><\/p>\n<p>\u00a0<\/p>\n<p><a  class=\"bbc_url\" href=\"http:\/\/www.TickerFactory.com\/\"><img src=\"http:\/\/tickers.TickerFactory.com\/ezt\/d\/4;10731;1\/st\/20151215\/e\/Our+Wedding\/k\/ec4b\/event.png\" alt=\"event.png\"><\/a><br><br><br><br>\n\u00a0","Email":"perianjohnson@gmail.com","IpAddress":"66.241.131.23","GroupId":42,"GroupName":"Sr. Member","JoinDate":1419437814,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-281478.jpg?_r=1436293677","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"perianjay","Id":281478,"Name":"perianjay","IsOnline":true}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"64.180.69.208","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79534,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":1,"IsLiked":false,"PostKey":"3e22333f9207da3aee73b525432bd994","RawContent":"&lt;p&gt;I&#039;m having my wedding at Now Amber\/Secrets in Puerto Vallarta this November. Their wedding packages include 25 guests (including bride &amp;amp; groom) and then of course you can add more guests for an extra cost per person. The resort is new (opened in 2012 I think) and from what I remember is very wheel chair accessible (elevators to every room, restaurant, and to the pool).&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;They have different options for where you want to have your ceremony (beach, poolside, gazebo, lobby) as well as you are able to choose different locations for your cocktail hour and reception. They have indoor and outdoor options (some outdoor options better for smaller groups). I am having only about 20 people at my wedding and we are having the ceremony on the beach and the cocktail hour and reception on a private outdoor terrace on the resort. There are options for renting a mariachi band, DJ, or just microphone and speakers for dancing, and they also have a club on the resort which opens at 10pm which is really fun! We are planning on having our after party and the majority of our dancing at the club after our reception. That way we can avoid the expensive cost of the DJ.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Now Amber\/Secrets is a 5 start resort and is more on the expensive side, but totally worth it! We did our group booking in Jan\/Feb of this year and were able to get a really good deal (about $1550-$1650 for double occupancy room for seven nights with direct flights). The prices increased almost $1000 throughout the year and are now actually sold out! So the group booking early really worked out for us (this was through Westjet and departing from BC Canada). &amp;nbsp;We had visited this resort previously to being engaged, and once we got engaged, I knew that is where we had to have our wedding! The resort is amazing!&amp;nbsp;Anyways, I hope that gives &amp;nbsp;you an idea about the resort, but like Perianjay said, its always helpful to talk to a travel agent as well because they know other options in the area and can maybe compare different resorts for you. :)&lt;\/p&gt;","Attachments":[],"Id":1903486,"PostDate":1440622214,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>I'm having my wedding at Now Amber\/Secrets in Puerto Vallarta this November. Their wedding packages include 25 guests (including bride & groom) and then of course you can add more guests for an extra cost per person. The resort is new (opened in 2012 I think) and from what I remember is very wheel chair accessible (elevators to every room, restaurant, and to the pool).<\/p>\n<p>\u00a0<\/p>\n<p>They have different options for where you want to have your ceremony (beach, poolside, gazebo, lobby) as well as you are able to choose different locations for your cocktail hour and reception. They have indoor and outdoor options (some outdoor options better for smaller groups). I am having only about 20 people at my wedding and we are having the ceremony on the beach and the cocktail hour and reception on a private outdoor terrace on the resort. There are options for renting a mariachi band, DJ, or just microphone and speakers for dancing, and they also have a club on the resort which opens at 10pm which is really fun! We are planning on having our after party and the majority of our dancing at the club after our reception. That way we can avoid the expensive cost of the DJ.<\/p>\n<p>\u00a0<\/p>\n<p>Now Amber\/Secrets is a 5 start resort and is more on the expensive side, but totally worth it! We did our group booking in Jan\/Feb of this year and were able to get a really good deal (about $1550-$1650 for double occupancy room for seven nights with direct flights). The prices increased almost $1000 throughout the year and are now actually sold out! So the group booking early really worked out for us (this was through Westjet and departing from BC Canada). \u00a0We had visited this resort previously to being engaged, and once we got engaged, I knew that is where we had to have our wedding! The resort is amazing!\u00a0Anyways, I hope that gives \u00a0you an idea about the resort, but like Perianjay said, its always helpful to talk to a travel agent as well because they know other options in the area and can maybe compare different resorts for you. <img src='http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_emoticons\/default\/smile.png' class='bbc_emoticon' alt=':)' \/><\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"amber_cover@hotmail.com","IpAddress":"64.180.69.208","GroupId":39,"GroupName":"Newbie","JoinDate":1428857311,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-282716.jpg?_r=1428872610","PhotoWidth":200,"PhotoHeight":134,"PhotoType":"custom"},"FormattedName":"amberc","Id":282716,"Name":"amberc","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"208.87.237.201","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79534,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"3d95dad20b33da40fc0b53b23cf3fa55","RawContent":"&lt;p&gt;@[member=\"kimberlyc\"] Congrats and welcome! It sounds like you&#039;re in the US, in which case the administrators of this site, Wright Travel, are destination wedding specialists! You can contact them through this website. I would completely second what the other two ladies have said in that a travel agent will give you the ins and outs of the various resorts and work with your must haves and \"don&#039;t wants\". They will also be the buffer for you between you and your guests, which will allow you to concentrate on your planning but still have your guests taken care of.&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Packages from Canada are structed a bit differently in that they include flights, transfers and hotel stay. It&#039;s rare here to pick a hotel only stay. Nuevo Vallarta is a beautiful area so i&#039;m sure you&#039;ll find something that works for you but absolutely, speaking with a travel agent will make the selection much easier!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Good luck and happy planning!&lt;\/p&gt;","Attachments":[],"Id":1903493,"PostDate":1440623316,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>@<a hovercard-ref=\"member\" hovercard-id=\"284575\" data-ipb=\"noparse\" class=\"_hovertrigger url fn name  bbc_member\" href='http:\/\/www.bestdestinationwedding.com\/user\/284575-kimberlyc\/' title='Member profile'><span itemprop=\"name\">kimberlyc<\/span><\/a> Congrats and welcome! It sounds like you're in the US, in which case the administrators of this site, Wright Travel, are destination wedding specialists! You can contact them through this website. I would completely second what the other two ladies have said in that a travel agent will give you the ins and outs of the various resorts and work with your must haves and \"don't wants\". They will also be the buffer for you between you and your guests, which will allow you to concentrate on your planning but still have your guests taken care of.<\/p>\n<p>\u00a0<\/p>\n<p>Packages from Canada are structed a bit differently in that they include flights, transfers and hotel stay. It's rare here to pick a hotel only stay. Nuevo Vallarta is a beautiful area so i'm sure you'll find something that works for you but absolutely, speaking with a travel agent will make the selection much easier!<\/p>\n<p>\u00a0<\/p>\n<p>Good luck and happy planning!<\/p>\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"achadwick9@yahoo.ca","IpAddress":"206.223.185.220","GroupId":38,"GroupName":"Moderators","JoinDate":1283458999,"Photo":{"HasPhoto":true,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/cdn\/profile\/photo-232000.jpg?_r=1434318164","PhotoWidth":570,"PhotoHeight":541,"PhotoType":"custom"},"FormattedName":"acw271011","Id":232000,"Name":"acw271011","IsOnline":false}},{"Title":null,"ShowSignature":true,"ShowEmoticons":true,"IpAddress":"66.235.46.71","IsFirstPost":false,"IsQueued":false,"IsVisible":true,"IsDeleted":false,"CanEdit":false,"CanDelete":false,"CanLike":true,"TopicId":79534,"EditedBy":"","EditDate":0,"EditReason":"","DeleteDate":0,"TotalLikes":0,"IsLiked":false,"PostKey":"caf757e2430165bc8c4e1eaafb4f58a9","RawContent":"&lt;p&gt;Thanks for the feedback and welcome, everyone!&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;Now Amber is unfortunately a bit out of most of my guest&#039;s price range at $350-600\/night ; (&lt;\/p&gt;\n&lt;p&gt;&amp;nbsp;&lt;\/p&gt;\n&lt;p&gt;I guess I will contact a travel agent, thanks for the suggestions!&lt;\/p&gt;","Attachments":[],"Id":1903498,"PostDate":1440626464,"PostContent":"            <html>\r\n              <head>\r\n                <style type=\"\"text\/css\"\">\r\n                  body {\r\n                    font-size: 16px;\r\n                    font-family: Helvetica, Verdana;\r\n                  }\r\n                  img .bbc_img {\r\n                    width: 100%;\r\n                  }\r\n                <\/style>\r\n              <\/head>\r\n              <body>\r\n                <p>Thanks for the feedback and welcome, everyone!<\/p>\n<p>\u00a0<\/p>\n<p>Now Amber is unfortunately a bit out of most of my guest's price range at $350-600\/night ; (<\/p>\n<p>\u00a0<\/p>\n<p>I guess I will contact a travel agent, thanks for the suggestions!<\/p>\n\r\n              <\/body>\r\n            <\/html>","Author":{"Signature":"","Email":"kimc0486@msn.com","IpAddress":"66.235.46.71","GroupId":39,"GroupName":"Newbie","JoinDate":1440615676,"Photo":{"HasPhoto":false,"PhotoUrl":"http:\/\/bdw.stevewright.netdna-cdn.com\/public\/style_images\/destination\/profile\/default_large.png","PhotoWidth":125,"PhotoHeight":125,"PhotoType":""},"FormattedName":"kimberlyc","Id":284575,"Name":"kimberlyc","IsOnline":false}}],"Id":"79534","Title":"All Inclusive Resort In Pv Area With Dancing For Less Than 40 People?","LastPostDate":1440626464},"Pages":{"TotalItems":5,"TotalPages":1,"CurrentPage":0,"NextPage":-1,"PreviousPage":-1,"LastPage":0},"PushNotifications":[{"Key":"notifications","Value":0,"Type":"int"},{"Key":"messages","Value":0,"Type":"int"}]}
